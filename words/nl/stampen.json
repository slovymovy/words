    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ca56119-d2f0-3c53-ad37-777b7317fc36",
                    "sense_definition": "met kracht de voet op de grond zetten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lopen-en-bewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het boze kind begon hard op de houten vloer te <w>stampen</w>.",
                            "target_lang_translations": {
                                "en": "The angry child began to <w>stomp</w> loudly on the wooden floor."
                            }
                        },
                        {
                            "text": "De soldaten moesten luidruchtig op de grond <w>stampen</w> tijdens de parade.",
                            "target_lang_translations": {
                                "en": "The soldiers had to <w>stamp</w> noisily on the ground during the parade."
                            }
                        }
                    ],
                    "synonyms": [
                        "stampvoeten"
                    ],
                    "common_phrases": [
                        "op de grond stampen"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring down one's foot heavily and noisily onto the ground."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stamp",
                                "target_lang_sense_clarification": "to bring down the foot with force"
                            },
                            {
                                "target_lang_word": "stomp",
                                "target_lang_sense_clarification": "to tread heavily or angrily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da5218a-9f87-361f-addc-bc3aa167eaae",
                    "sense_definition": "iets fijnmaken of pletten door er met kracht op te drukken of te slaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fijnmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun jij de gekookte aardappelen fijn <w>stampen</w> voor de stamppot?",
                            "target_lang_translations": {
                                "en": "Can you <w>mash</w> the boiled potatoes for the hotchpotch?"
                            }
                        },
                        {
                            "text": "We moeten de kruiden eerst goed <w>stampen</w> in de vijzel.",
                            "target_lang_translations": {
                                "en": "We must first <w>crush</w> the herbs well in the mortar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aardappelen stampen"
                    ],
                    "target_lang_definitions": {
                        "en": "To crush, mash, or pulverize something by pressing or striking it with force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mash",
                                "target_lang_sense_clarification": "to crush food into a soft mass"
                            },
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to press or squeeze to alter shape or integrity"
                            },
                            {
                                "target_lang_word": "pound",
                                "target_lang_sense_clarification": "to pulverize or crush by beating repeatedly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5287a7b-de1f-34ab-959c-4d00e197072c",
                    "sense_definition": "in korte tijd heel hard studeren door informatie herhaaldelijk in het geheugen te prenten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "studeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij moest de hele nacht woordjes <w>stampen</w> voor haar examen Frans.",
                            "target_lang_translations": {
                                "en": "She had to <w>cram</w> vocabulary words all night for her French exam."
                            }
                        },
                        {
                            "text": "In plaats van de logica te begrijpen, ging hij de formules gewoon <w>stampen</w>.",
                            "target_lang_translations": {
                                "en": "Instead of understanding the logic, he just started to <w>memorize</w> the formulas by rote."
                            }
                        }
                    ],
                    "synonyms": [
                        "blokken",
                        "herhalen",
                        "repeteren"
                    ],
                    "common_phrases": [
                        "woordjes stampen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruikt voor hard studeren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To study hard in a short period of time by repeatedly committing information to memory."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cram",
                                "target_lang_sense_clarification": "to study intensively before an exam"
                            },
                            {
                                "target_lang_word": "memorize",
                                "target_lang_sense_clarification": "to commit to memory by rote"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1a1032-0010-39e8-ac60-f77b20544e7f",
                    "sense_definition": "het maken van een op-en-neergaande beweging van de boeg en het hek van een schip of vliegtuig",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging-voertuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de hoge golven begon het schip hevig te <w>stampen</w> en te slingeren.",
                            "target_lang_translations": {
                                "en": "Due to the high waves, the ship began to <w>pitch</w> and roll heavily."
                            }
                        },
                        {
                            "text": "Tijdens de storm bleef de boot urenlang op de wilde zee <w>stampen</w>.",
                            "target_lang_translations": {
                                "en": "During the storm, the boat kept <w>pounding</w> on the wild sea for hours."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stampen en slingeren"
                    ],
                    "target_lang_definitions": {
                        "en": "The pitching or up-and-down movement of the bow and stern of a ship or aircraft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pitch",
                                "target_lang_sense_clarification": "the up-and-down motion of a vessel"
                            },
                            {
                                "target_lang_word": "pound",
                                "target_lang_sense_clarification": "to strike heavily against waves"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9a199ca-8006-35f5-8aac-a0ce9cdf6071",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>stamp</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf een paar harde <w>stampen</w> tegen de gesloten deur.",
                            "target_lang_translations": {
                                "en": "He gave a few hard <w>kicks</w> against the closed door."
                            }
                        },
                        {
                            "text": "Met enkele stevige <w>stampen</w> kreeg hij het zand goed aangedrukt.",
                            "target_lang_translations": {
                                "en": "With a few firm <w>stomps</w>, he managed to pack the sand down well."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'stamp', referring to heavy blows or stomps with the foot."
                    },
                    "translations": {
