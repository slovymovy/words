                "senses": [
                    {
                        "sense_id": "d639f04f-765d-302e-b24b-ee524aa12e94",
                        "entry_id": "878cdea7-cf44-3178-8f33-41cdb0410bf3",
                        "glosses": [
                            "Winter, in dem ein Krieg stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b0c345-1209-4701-b6ad-a52143154562",
                                "sense_id": "d639f04f-765d-302e-b24b-ee524aa12e94",
                                "text": "„Doch irgendwo hielten sie sich im letzten Kriegswinter versteckt.“"
                            },
                            {
                                "example_id": "5f6b854b-0cdb-40e4-8f02-038ecc75107b",
                                "sense_id": "d639f04f-765d-302e-b24b-ee524aa12e94",
                                "text": "„Vor dem zweiten Kriegswinter waren die Folgen der Kämpfe in der gesamten Heimat so massiv zu spüren wie noch nie zuvor in der deutschen Geschichte:...“"
                            },
                            {
                                "example_id": "679abe5d-eedc-48a6-8d76-7a48e1d8f94d",
                                "sense_id": "d639f04f-765d-302e-b24b-ee524aa12e94",
                                "text": "„Im Kriegswinter 1920 durchlebte Südrussland eine galoppierende Inflation.“"
                            },
                            {
                                "example_id": "78768cbe-2e8a-4304-86eb-12b13c9181b8",
                                "sense_id": "d639f04f-765d-302e-b24b-ee524aa12e94",
                                "text": "„Ich habe nie wieder einen so heiteren Weihnachtsabend erlebt wie damals im Kratovice jenes Kriegswinters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
