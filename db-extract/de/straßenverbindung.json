                "senses": [
                    {
                        "sense_id": "0aea4657-39bb-36cf-9768-89080883feaf",
                        "entry_id": "8b7c1440-658f-32ea-883f-e0521d165d41",
                        "glosses": [
                            "wechselseitige Erreichbarkeit von Orten mittels Straße/Straßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94acea91-f3b7-46e5-8683-295bf059e5e8",
                                "sense_id": "0aea4657-39bb-36cf-9768-89080883feaf",
                                "text": "„Bei meiner Fahrt durchs Eichsfelder Land fiel mir, dem Berliner, bald auf, daß bereits alle alten Straßenverbindungen wiederhergestellt sind.“"
                            },
                            {
                                "example_id": "95788b3b-a942-4cf2-9b2e-18fecd829227",
                                "sense_id": "0aea4657-39bb-36cf-9768-89080883feaf",
                                "text": "„Doch die Straßenverbindungen waren sehr schlecht, und bedingt durch die zwei Regenzeiten kam es immer wieder zum beinahe kompletten Stillstand des Warentransports.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
