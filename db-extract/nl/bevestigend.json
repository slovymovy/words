                "senses": [
                    {
                        "sense_id": "728937fb-e57a-389f-b113-a2e0dbef2022",
                        "entry_id": "f9754929-851b-38ac-ad0c-4a04043abf8e",
                        "glosses": [
                            "op een manier die aangeeft dat het zo is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97815952-5a16-4e3f-8cda-c3ea0580ec3a",
                                "sense_id": "728937fb-e57a-389f-b113-a2e0dbef2022",
                                "text": "Ze schetste dat verschillende landen afstand houden tot dit probleem, Nederland doet dat niet. ,,Iedereen moet zichzelf de vraag stellen of je terroristische onderdanen elders wilt berechten.’’ Hennis wees erop dat bij een bevestigend antwoord veroordeelden kunnen worden opgehangen."
                            },
                            {
                                "example_id": "688f5324-8a5c-44c7-b4ce-9a4537e068e1",
                                "sense_id": "728937fb-e57a-389f-b113-a2e0dbef2022",
                                "text": "Kort voor het opmerkelijke incident hadden Hamilton en Button, de nummers een en twee van het veld, de opdracht van de teamleiding gekregen om de race rustig uit te rijden naar de finish om brandstof te sparen. Daarop vroeg Hamilton aan Prew voor de zekerheid of Button hetzelfde zou doen. Kort na het bevestigende antwoord van Prew kwam Button evenwel alsnog voorbij. Daarna gaf ook de getergde Hamilton gas waarna hij alsnog zijn eerste zege van het seizoen kon behalen."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e8fbaf-43c0-3cb1-80f2-192858f445a8",
                        "entry_id": "f9754929-851b-38ac-ad0c-4a04043abf8e",
                        "glosses": [
                            "beamend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ccc4e7-a410-477d-a8ce-0de45cf73744",
                                "sense_id": "83e8fbaf-43c0-3cb1-80f2-192858f445a8",
                                "text": "Hij wachtte niet op een bevestigend gemompel, maar raasde door."
                            }
                        ]
                    }
                ],
