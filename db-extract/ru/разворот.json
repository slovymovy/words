                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb67bdd7-286c-4980-8122-ffdf2b1ef6b4",
                        "source_entry_id": "3e155b07-bd7b-3dd4-994d-4d7775867475",
                        "source_sense_description": "действие",
                        "target_lang_word": "demi-tour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-tour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f87446b-7a4a-3d34-9a9a-47e14afefc3b",
                                        "entry_id": "2f03362f-f9f0-3e42-ace0-6a5d3afa2b49",
                                        "glosses": [
                                            "Moitié d’un tour sur soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb929f9-e826-46b9-809f-3d7aacf5088b",
                                                "sense_id": "7f87446b-7a4a-3d34-9a9a-47e14afefc3b",
                                                "text": "Demi-tour à droite… droite !…"
                                            },
                                            {
                                                "example_id": "f2369d3f-042e-4325-9dca-3ae5ebc256e3",
                                                "sense_id": "7f87446b-7a4a-3d34-9a9a-47e14afefc3b",
                                                "text": "Nous sommes pareils, mais nos choix vont en sens inverse, un peu comme dans les anciens manuels militaires où l’on nous apprenait que faire sur place demi-tour à gauche est exactement la même chose que faire demi-tour à droite, seulement c’est le contraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bdbe0fe-e2be-35ec-a25e-6a6f5b6aea3a",
                                        "entry_id": "2f03362f-f9f0-3e42-ace0-6a5d3afa2b49",
                                        "glosses": [
                                            "Virage ou angle à 180 degrés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9cac36-bd0a-4cdd-a4b6-f0ee548facc5",
                                                "sense_id": "3bdbe0fe-e2be-35ec-a25e-6a6f5b6aea3a",
                                                "text": "Mais le taxi terminait son demi-tour et Dieuble eut un sursaut d’estomaquement en lisant la marque de l'automobile, plaquée-or sur l'aile arrière : « Ouzbek »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76f6720c-4dbf-49c5-bd3b-ac21fd17ed0f",
                        "source_entry_id": "3e155b07-bd7b-3dd4-994d-4d7775867475",
                        "source_sense_description": "действие",
                        "target_lang_word": "retournement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retournement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "392d3aa5-4780-3db4-b7d4-389a4682521c",
                                        "entry_id": "08755132-5371-358c-a79f-a39a3cf35d8b",
                                        "glosses": [
                                            "Action de retourner ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc12e65e-31f0-47e9-8a2a-e266f5eb9b4d",
                                                "sense_id": "392d3aa5-4780-3db4-b7d4-389a4682521c",
                                                "text": "La hauteur de l'ensemble de l’attinage peut encore être diminuée par le retournement de la pièce supérieure ; […]."
                                            },
                                            {
                                                "example_id": "050a7767-90cc-42fe-9965-a1667d75f2ff",
                                                "sense_id": "392d3aa5-4780-3db4-b7d4-389a4682521c",
                                                "text": "Des bâtiments soulevés par le retournement d'un ice-berg ont été rejetés à la mer brisés comme une noix."
                                            },
                                            {
                                                "example_id": "b94c48b9-96fc-4e6f-a0e3-863f66c0db7b",
                                                "sense_id": "392d3aa5-4780-3db4-b7d4-389a4682521c",
                                                "text": "Mais on les a surveillés pendant dix ans et s’ils sont aujourd’hui tolérés, c’est grâce à un curieux retournement des choses : on leur sait gré du sacrifice qui leur a fait préférer leurs origines à leurs sentiments."
                                            },
                                            {
                                                "example_id": "8eb950ed-7cee-4d4d-99e5-5559bdd7e30c",
                                                "sense_id": "392d3aa5-4780-3db4-b7d4-389a4682521c",
                                                "text": "Jean Borie, en accord avec Sartre aussi bien qu'avec Foucault, souligne qu'un retournement s'était, à ce propos, opéré depuis le XVIIIᵉ siècle; le désir et la jouissance, que l'on cesse d'exalter en les associant à la génération, se trouvent relégués au nouveau statut d'instinct génésique; dès lors, le coït conjugal se trouve plus étroitement associé à la notion de devoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6165acf3-ef7b-4a79-9ea1-230a056af1f7",
                        "source_entry_id": "3e155b07-bd7b-3dd4-994d-4d7775867475",
                        "source_sense_description": "действие",
                        "target_lang_word": "virage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37f178a8-c24e-3e0e-92ac-0d9b719f0243",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Action de faire tourner un véhicule, un avion, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88763f7-5f8c-4d24-b7a7-1a9d5d322fe0",
                                                "sense_id": "37f178a8-c24e-3e0e-92ac-0d9b719f0243",
                                                "text": "Prendre un bon, un mauvais virage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689356ca-f942-3217-bd58-11fd3a55c524",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Endroit où l’on tourne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf0dd0a-39ea-4172-81f7-3602e92c72df",
                                                "sense_id": "689356ca-f942-3217-bd58-11fd3a55c524",
                                                "text": "Le gamin de 15 ans qui m’a renversé m’a dit qu’il ne l’avait pas fait exprès mais, lorsqu’on manie ce genre d’engin, on évite de rouler sur la voie de gauche dans un virage."
                                            },
                                            {
                                                "example_id": "73edce4d-2202-413e-abe8-b984d90d5514",
                                                "sense_id": "689356ca-f942-3217-bd58-11fd3a55c524",
                                                "text": "Entre Rouvroy-sur-Audry et l'embranchement de Rémilly-les-Pothées, la route a été rectifiée à la fin de 1979, mais elle faisait auparavant un virage brusque, qui dominait l'abrupt d'un ravin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4622514c-e9e6-302a-9ea5-b69a3fcbfe12",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Changement de politique, de dessein, de ligne de pensée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "825a3ce7-4814-4a5e-870d-1223119105b1",
                                                "sense_id": "4622514c-e9e6-302a-9ea5-b69a3fcbfe12",
                                                "text": "Elle amorce toutefois un virage pour le PLQ, notamment sur la langue. Son ton est juste, et elle trouve ses marques en tant que cheffe de l’opposition officielle."
                                            }
                                        ]
                                    },
                                    {
