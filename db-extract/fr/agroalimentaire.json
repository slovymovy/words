                    {
                        "sense_id": "05f0abdd-f72c-36e6-af19-750d1986a8c9",
                        "entry_id": "f0eaf0b1-b43d-35dc-8878-abe82287f55b",
                        "glosses": [
                            "Qualifie l'ensemble des activités de transformation des produits alimentaires."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "e072e7b4-4b27-42ab-a4e6-e28eb2d7335a",
                                "sense_id": "05f0abdd-f72c-36e6-af19-750d1986a8c9",
                                "text": "Lorsqu'une grande marque de produits agroalimentaires souhaite lancer un nouveau yahourt 0 % de matière grasse dédié à une clientèle féminine, elle recourt au marketing opérationnel."
                            },
                            {
                                "example_id": "ae586b16-fefb-47e3-8b47-221aa38372e6",
                                "sense_id": "05f0abdd-f72c-36e6-af19-750d1986a8c9",
                                "text": "Au ministère de l’Agriculture de l’Ontario, on souligne que les secteurs agroalimentaires du Québec et de l’Ontario sont très intégrés."
                            },
                            {
                                "example_id": "6c11737d-6522-4fd0-a523-df44c5b15db2",
                                "sense_id": "05f0abdd-f72c-36e6-af19-750d1986a8c9",
                                "text": "Le géant agroalimentaire Nestlé a annoncé, jeudi, qu’il visait le redémarrage, en novembre, sous réserve du feu vert des autorités, d’une des deux lignes de production de son usine de Caudry (Nord)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "236685f9-6aa0-4bcb-9704-17cd85356ff1",
                        "source_entry_id": "f0eaf0b1-b43d-35dc-8878-abe82287f55b",
                        "source_sense_id": "05f0abdd-f72c-36e6-af19-750d1986a8c9",
