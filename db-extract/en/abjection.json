                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624d3932-7a5b-4e72-b20c-f5379fb5e574",
                                                "sense_id": "7e113d45-e063-3310-a3a2-28ae3f90aa77",
