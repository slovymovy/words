                "senses": [
                    {
                        "sense_id": "56a23e50-f7a8-330a-ba3b-f60f6eaa1505",
                        "entry_id": "7eb73172-e2d1-325f-8272-5067e330d756",
                        "glosses": [
                            "een zeer harde windvlaag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b051dff5-ebbe-4038-9352-8b6459df4d2b",
                                "sense_id": "56a23e50-f7a8-330a-ba3b-f60f6eaa1505",
                                "text": "Eén van de Valken, behorende bij een zeilkamp nabij de Dode Hond op het Eemmeer, is vrijdagmiddag door een rukwind tijdens zware buien gekapseisd en gezonken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea0b8c61-eeb3-4d17-9ff5-11595b54f399",
                        "source_entry_id": "7eb73172-e2d1-325f-8272-5067e330d756",
                        "source_sense_id": "56a23e50-f7a8-330a-ba3b-f60f6eaa1505",
                        "source_sense_description": "een zeer harde windvlaag",
                        "target_lang_word": "Windstoß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windstoß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11b3de04-9320-387c-a21b-5552ec58001d",
                                        "entry_id": "37c3c119-4ccb-309c-b2a9-e06414a9d736",
                                        "glosses": [
                                            "plötzlich auftretende, nur kurz dauernde, heftige Luftbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4dba034-38b1-43e3-ab4d-cba070f2446c",
                                                "sense_id": "11b3de04-9320-387c-a21b-5552ec58001d",
                                                "text": "„Bei den heftigen Windstößen glaubte John deutlich zu spüren, wie sich die Behausung vom Erdboden löste und jeden Augenblick mit dem Hurrikan davonzufliegen drohte.“"
                                            },
                                            {
                                                "example_id": "aec8d4e8-4ad5-4a11-b1a3-559ac5e04276",
                                                "sense_id": "11b3de04-9320-387c-a21b-5552ec58001d",
                                                "text": "„Ein Windstoß fegte Staubwolken über die Fläche.“"
                                            },
                                            {
                                                "example_id": "01e8eb60-2353-4c82-9da1-f6d349f3e79a",
                                                "sense_id": "11b3de04-9320-387c-a21b-5552ec58001d",
                                                "text": "„Das Grollen wurde begleitet von Windstößen, die auf dem Platz den Staub hochwirbelten.“"
                                            },
                                            {
                                                "example_id": "fd2fa4cb-c0a0-4e0f-a484-227e274a93d1",
                                                "sense_id": "11b3de04-9320-387c-a21b-5552ec58001d",
                                                "text": "„Sie hatte eine Frisur, die so aussah, als hätte ihr ein Windstoß von rückwärts ins Haar geblasen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58457c3f-eaf0-4adb-9aed-903196245f6b",
                        "source_entry_id": "7eb73172-e2d1-325f-8272-5067e330d756",
                        "source_sense_id": "56a23e50-f7a8-330a-ba3b-f60f6eaa1505",
                        "source_sense_description": "een zeer harde windvlaag",
                        "target_lang_word": "squall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc984fc2-e447-333c-aea2-569db982fa79",
                                        "entry_id": "f2f3f77c-80c4-334c-a355-496e0b92bcc6",
                                        "glosses": [
                                            "To cry or wail loudly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460294f2-6a20-48f5-a79d-6e3f98cab6ee",
                                                "sense_id": "bc984fc2-e447-333c-aea2-569db982fa79",
                                                "text": "Squalling was the word for it, Pew's anger rose so high at these objections; till at last, his passion completely taking the upper hand, he struck at them right and left in his blindness, and his stick sounded heavily on more than one."
                                            },
                                            {
                                                "example_id": "b6c872a5-bbc9-4233-92a3-05ee570d201d",
                                                "sense_id": "bc984fc2-e447-333c-aea2-569db982fa79",
                                                "text": "Squalling like an infuriated cat, the shadow crashed down"
                                            },
                                            {
                                                "example_id": "8c437d71-18f5-4cc7-bf27-62137943aa20",
                                                "sense_id": "bc984fc2-e447-333c-aea2-569db982fa79",
                                                "text": "The orchestra burst into a sudden loud squalling."
                                            },
                                            {
                                                "example_id": "aa418c2c-9549-4a27-b5db-db7a2354f256",
                                                "sense_id": "bc984fc2-e447-333c-aea2-569db982fa79",
                                                "text": "Some night-bird, belike, or a sea-gull squalling below the headland."
                                            },
                                            {
                                                "example_id": "4a14aa43-6037-475d-b4b7-12f6db6592d4",
                                                "sense_id": "bc984fc2-e447-333c-aea2-569db982fa79",
                                                "text": "she wrapped the squalling, wriggling baby tightly into the fine cotton sheet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1810b5bf-241b-3674-8d5c-4de656db4dde",
                                        "entry_id": "f2f3f77c-80c4-334c-a355-496e0b92bcc6",
                                        "glosses": [
                                            "To fall suddenly and forcefully, as if a squall."
                                        ],
                                        "tags": [
                                            "of rain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "764aa354-0c64-4025-866d-72ea069d0137",
                                                "sense_id": "1810b5bf-241b-3674-8d5c-4de656db4dde",
                                                "text": "Rain squalled sudden against the window. The Old Writer cursed and shouldered out the door."
                                            },
                                            {
                                                "example_id": "5081e666-bcda-4f1a-b891-f6b70141f744",
                                                "sense_id": "1810b5bf-241b-3674-8d5c-4de656db4dde",
                                                "text": "[…] of squalling rain and a blustering westerly wind."
                                            },
                                            {
                                                "example_id": "e0a32377-174c-4c4b-9cca-7407e1332964",
                                                "sense_id": "1810b5bf-241b-3674-8d5c-4de656db4dde",
                                                "text": "[…] rain squalled fretfully against the schoolhouse roof. Although it had stopped by the time the afternoon recess was due, Miss Willie decided that it was too cold and raw for the children to be out a full half hour, so she sent them[…]"
                                            },
                                            {
                                                "example_id": "83c3eaf3-f167-4d56-98d5-15b770b2ba2c",
                                                "sense_id": "1810b5bf-241b-3674-8d5c-4de656db4dde",
                                                "text": "Rain squalled in heavy sheets across the street."
                                            },
                                            {
                                                "example_id": "6a2aaa3c-53d6-4589-a9fd-81ead1a24fee",
                                                "sense_id": "1810b5bf-241b-3674-8d5c-4de656db4dde",
                                                "text": "[…] the sky opened up into a cloud-burst of squalling rain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc89395-ba4d-3be4-9289-d1e8e205d51b",
                                        "entry_id": "b36f5422-8c7f-3123-aae9-af4ca9fcceed",
                                        "glosses": [
                                            "A sudden storm, as found in a squall line."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e806d0d-7987-4781-a6ce-4a9887b8874d",
                                                "sense_id": "2cc89395-ba4d-3be4-9289-d1e8e205d51b",
                                                "text": "Luckily she wasn’t there any more, no one was, when he returned from the Caribbean carnival damp-hatted and soaked through after being caught unprepared by a squall of hard, hot rain."
                                            },
                                            {
                                                "example_id": "de58c0db-d9cd-400a-894c-2ebf533336fa",
                                                "sense_id": "2cc89395-ba4d-3be4-9289-d1e8e205d51b",
                                                "text": "With reports of the Japanese forces bearing down on them confirmed, Rear Admiral Sprague orders his ships east, heading towards a series of rain squalls, hoping for concealment. This will hopefully delay the Japanese closing the range, and also draw them away from the much-more-vulnerable landing ships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af9cd9bd-baf5-358b-82c9-c5557a81565b",
                                        "entry_id": "b36f5422-8c7f-3123-aae9-af4ca9fcceed",
                                        "glosses": [
                                            "A squall line, multicell line, or part of a squall line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cb730bf-3ec3-32da-90b7-0c3f27f29e9b",
                                        "entry_id": "b36f5422-8c7f-3123-aae9-af4ca9fcceed",
                                        "glosses": [
                                            "A loud cry or wail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b0a634-f7e5-4bdb-baf4-f15f6c120e20",
                                                "sense_id": "1cb730bf-3ec3-32da-90b7-0c3f27f29e9b",
                                                "text": "But the third Emir, now seeing himself all alone on the quarter-deck, seems to feel relieved from some curious restraint; for, tipping all sorts of knowing winks in all sorts of directions, and kicking off his shoes, he strikes into a sharp but noiseless squall of a hornpipe right over the Grand Turk’s head; and then, by a dexterous sleight, pitching his cap up into the mizentop for a shelf, he goes down rollicking so far at least as he remains visible from the deck, reversing all other processions, by bringing up the rear with music."
                                            },
                                            {
                                                "example_id": "5786e7f4-349a-4654-b19f-1dc2a338a9de",
                                                "sense_id": "1cb730bf-3ec3-32da-90b7-0c3f27f29e9b",
                                                "text": "The media present rising prices as a passing squall for the middle class, brought on by Vlad ’n’ Liz and resulting in spiking mortgage rates and fewer trips to Waitrose. But beneath those headlines are millions of others for whom the problem isn’t rising prices, but falling incomes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f65a067-72c3-4581-b96e-2e2ad1440229",
                        "source_entry_id": "7eb73172-e2d1-325f-8272-5067e330d756",
                        "source_sense_id": "56a23e50-f7a8-330a-ba3b-f60f6eaa1505",
                        "source_sense_description": "een zeer harde windvlaag",
                        "target_lang_word": "coup de vent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coup de vent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b69e2e3-2b99-3f65-8e45-8ae5cf299970",
                                        "entry_id": "4aa31149-e03b-38da-a0f3-d033a3e13f4d",
                                        "glosses": [
                                            "Vent qui devient plus fort que ce qu'il était."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc17a044-81ae-48d1-b609-aacf7fec4a11",
                                                "sense_id": "4b69e2e3-2b99-3f65-8e45-8ae5cf299970",
                                                "text": "Des mois, des années, s'écouleront, sans qu'il soit payé de son labeur, et peut-être qu'au moment de jouir de ses peines passées, un coup de vent, une ondée de grêle, suffiront pour détruire ses justes espérances."
                                            },
                                            {
                                                "example_id": "38cfdecf-c3d3-4b6f-8b91-b1d27717a98e",
                                                "sense_id": "4b69e2e3-2b99-3f65-8e45-8ae5cf299970",
                                                "text": "Le Baltimore, trois-mâts-barque venant de la Havane, essuya de très-forts coups de vent de l’Ouest."
                                            },
                                            {
                                                "example_id": "6e373534-65ca-4694-8b1c-aec81a2a3392",
                                                "sense_id": "4b69e2e3-2b99-3f65-8e45-8ae5cf299970",
                                                "text": "Vers le soir je remarque que l'étai de foc s'use beaucoup et je me dispose à le réparer lorsqu'un coup de vent arrive si furieux et si sec que l'étai de foc et la bastaque bâbord, cèdent en même temps."
                                            },
                                            {
                                                "example_id": "35113118-8943-4e42-811d-5aeee32bbb78",
                                                "sense_id": "4b69e2e3-2b99-3f65-8e45-8ae5cf299970",
                                                "text": "Malgré un système racinaire assez superficiel, le douglas résiste plutôt bien aux coups de vent à l'âge adulte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
