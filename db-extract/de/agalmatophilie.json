                        "sense_id": "f76e83f8-302a-3d07-9080-5ce6a5ea44c8",
                        "entry_id": "1cc29a94-530d-3f71-b6dc-498d0e6c9903",
                        "glosses": [
                            "starke Zuneigung/sexuelle Präferenz gegenüber (nackten) Statuen, Puppen und Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c821c4f2-edf0-4178-90a0-7eb120d07b91",
                                "sense_id": "f76e83f8-302a-3d07-9080-5ce6a5ea44c8",
                                "text": "„Oh, und da fällt mir noch was besonders Schönes ein: Agalmatophilie bedeutet, dass man sich sexuell zu Statuen oder Schaufensterpuppen hingezogen fühlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
