                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b481a2-fcbf-43c0-8d48-324544a27b43",
                                "sense_id": "b8b92a79-2f16-31fd-924e-eef57f5986b6",
                                "text": "Du bois liant."
                            },
                            {
                                "example_id": "6dc3e8d3-d704-44ee-b134-c9fcf87335a6",
                                "sense_id": "b8b92a79-2f16-31fd-924e-eef57f5986b6",
                                "text": "Du fer liant."
                            },
                            {
                                "example_id": "092a25de-6b62-4411-9c0c-9bbe881c16f4",
                                "sense_id": "b8b92a79-2f16-31fd-924e-eef57f5986b6",
                                "text": "Des ressorts liants."
                            }
                        ]
                    },
                    {
                        "sense_id": "093a8c15-fbb3-3c80-8767-f73d5ff53b20",
                        "entry_id": "96581620-f5f9-37d3-bf44-df0c92b37521",
                        "glosses": [
                            "Qui est doux, complaisant, affable, propre à former des liaisons."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
