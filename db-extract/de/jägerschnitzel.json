                ],
                "senses": [
                    {
                        "sense_id": "48fb9805-41e5-3089-8109-33eec95707af",
                        "entry_id": "cc08fa1b-0ab1-30af-8c2b-a3002fcaf2e5",
                        "glosses": [
                            "Schnitzel natur vom Kalb oder Schwein mit einer Pilzsoße"
                        ],
                        "tags": [
                            "klassische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "e7573fbf-17c6-479c-b8a7-e63d419a6a99",
                                "sense_id": "48fb9805-41e5-3089-8109-33eec95707af",
                                "text": "„Wenn ein Koch die Sympathien der Berliner auf seiner Seite haben will, muss er Wiener Schnitzel braten. Woran das liegt, ist völlig unklar, zumal dieses Traditionsgericht parallel zum Aufkommen des deutschen Küchenwunders als megaspießig auf dem Index gelandet war, dort, wo sonst nur noch Jägerschnitzel und Sülzkotelett ein vergessenes Dasein fristen.“"
                            },
                            {
                                "example_id": "f8c64c0c-4daf-4ce8-af6e-70bffdc0c3a5",
                                "sense_id": "48fb9805-41e5-3089-8109-33eec95707af",
                                "text": "„Da kann man auch ein Wildschwein im Restaurant sitzen sehen, über ihm die Sprechblase: ‚Herr Ober, bitte ein Jägerschnitzel!‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5086c4b9-11df-33de-96b8-04374403d20d",
                        "entry_id": "cc08fa1b-0ab1-30af-8c2b-a3002fcaf2e5",
                        "glosses": [
                            "dicke Scheibe einer Jagdwurst, die paniert, gebraten und mit einer Tomatensoße serviert wird"
                        ],
                        "tags": [
                            "ostdeutsche Variante"
                        ],
                        "examples": [
                            {
                                "example_id": "a9d087ba-47ce-4f73-a211-6c669b449ae9",
                                "sense_id": "5086c4b9-11df-33de-96b8-04374403d20d",
                                "text": "„Der Ostdeutsche im Westen ist enttäuscht, wenn er ein gebratenes Stück Fleisch statt des erhofften Lieblingsessens aus Kindertagen vorgesetzt bekommt: Jägerschnitzel - also Jagdwurst - mit Nudeln und Tomatensoße.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
