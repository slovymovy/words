                        "translation_id": "ee2b2c7a-17b1-4891-bb47-b12b52d5355f",
                        "source_entry_id": "677f8942-c3c2-367f-b477-817310445e92",
                        "source_sense_id": "6919d930-f4ef-36f1-a63b-44071ea997d6",
                        "source_sense_description": "branch of horticulture concerned with the planting and growth of trees",
                        "target_lang_word": "arboriculture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arboriculture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "384a015e-1fec-3517-bb4a-56fa8ec64fcc",
                                        "entry_id": "5e6fc3a7-d668-32ec-a690-33540436cd1b",
                                        "glosses": [
                                            "Culture des arbres."
                                        ],
                                        "tags": [
                                            "Agronomie",
                                            "Ethnobiologie",
                                            "Art du jardin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2836c658-c6e7-440e-b7b5-85069147425b",
                                                "sense_id": "384a015e-1fec-3517-bb4a-56fa8ec64fcc",
                                                "text": "M. Nallet est un de ces hommes entièrement dévoués à l’arboriculture fruitière et qui met son jardin et les résultats de ses expériences à la disposition de tout le monde."
                                            },
                                            {
                                                "example_id": "f6476cf2-79d8-4082-b3d1-24b4e3ad88df",
                                                "sense_id": "384a015e-1fec-3517-bb4a-56fa8ec64fcc",
                                                "text": "L’arboriculture se distingue de la sylviculture par le fait que la sylviculture est une production de masse : le sylviculteur gère un peuplement alors que l’arboriculteur gère chaque arbre individuellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4339ae24-9b84-378d-8180-7f69470cb8de",
                                        "entry_id": "5e6fc3a7-d668-32ec-a690-33540436cd1b",
                                        "glosses": [
                                            "Arboriculture fruitière."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96248d04-796c-4f1b-a8b7-85e68af4f7c6",
                                                "sense_id": "4339ae24-9b84-378d-8180-7f69470cb8de",
                                                "text": "Comme pour les plantes à graines néolithiques, mais considérablement plus tard, les premiers arbres fruitiers indigènes ont été domestiqués dans la région du Croissant fertile. En comparaison de l’agriculture à graines, l’arboriculture est apparue beaucoup plus tard dans l’histoire de la production alimentaire en Europe et en Asie du Sud-Ouest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
