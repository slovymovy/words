                "senses": [
                    {
                        "sense_id": "4790e5f4-ae5a-3e1b-9c16-bc9c318db1c1",
                        "entry_id": "fafb9050-b942-3051-b1e7-443cd6d826a9",
                        "glosses": [
                            "Doter d’un socle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da61ad25-945e-442d-bb58-bcddc5386069",
                                "sense_id": "4790e5f4-ae5a-3e1b-9c16-bc9c318db1c1",
                                "text": "Faire socler différents objets manufacturés : serrure, balise de signalisation rouge et blanche taguée, nounours usagé, porte de réfrigérateur, bidon en aluminium."
                            },
                            {
                                "example_id": "fd9163d0-9c7f-43e8-8f70-5c421ba57fae",
                                "sense_id": "4790e5f4-ae5a-3e1b-9c16-bc9c318db1c1",
                                "text": "Je repère ce qui est soclé. Car s’il l’a fait socler, c’est que lui considère que c’est déjà un objet important."
                            }
                        ]
                    }
                ],
