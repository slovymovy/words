                    {
                        "translation_id": "81439052-7058-4e07-a676-6e661330efc4",
                        "source_entry_id": "3c08fc90-9532-3a35-b728-8ec9e7d745e6",
                        "source_sense_description": "person who compiles, interprets, or studies statistics",
                        "target_lang_word": "Statistiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Statistiker",
