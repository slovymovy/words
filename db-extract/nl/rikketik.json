        "nl-extract.jsonl": [
            {
                "entry_id": "232c128f-ad91-347f-9666-c1e96dcbe030",
                "word": "rikketik",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "252857fc-47ea-4a9e-8e10-06f4e6c7bfab",
                        "entry_id": "232c128f-ad91-347f-9666-c1e96dcbe030",
                        "tags": [
                            "plural"
                        ],
                        "form": "rikketikken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a626a6cc-6f5f-3202-91cb-ba50d8241ed7",
                        "entry_id": "232c128f-ad91-347f-9666-c1e96dcbe030",
                        "glosses": [
                            "het hart, vaak eufemistisch gebruikt om aan te geven dat er sprake is van een hartziekte"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "5f27ebb4-a48d-4950-b8e0-b110db823778",
                                "sense_id": "a626a6cc-6f5f-3202-91cb-ba50d8241ed7",
                                "text": "Enkele jaren geleden was hij huisarts in de Hengelose wijk Klein Driene. Hartproblemen dwongen hem zeer tegen zijn zin te stoppen. Het was niet eens het feit dat zijn ‘rikketik’ hem parten speelde - dat euvel was met enkele bypasses redelijk snel opgelost - nee, het was vooral zijn verzekeraar, die voorschreef dat hij niet verder mocht."
                            },
                            {
                                "example_id": "7e7d6f52-458f-4d07-8e3f-643f83a14b83",
                                "sense_id": "a626a6cc-6f5f-3202-91cb-ba50d8241ed7",
                                "text": "'Ik keek eens goed naar de spreker. Hij zag er gezond uit, niet het type dat het aan de rikketik had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aedad13-ea67-4b6e-a6be-bfb18e0a52bb",
                        "source_entry_id": "232c128f-ad91-347f-9666-c1e96dcbe030",
                        "source_sense_id": "a626a6cc-6f5f-3202-91cb-ba50d8241ed7",
                        "source_sense_description": "(informeel) het hart",
                        "target_lang_word": "heart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f157d964-a8b3-3297-9de0-7e34f7722ea3",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "A muscular organ that pumps blood through the body, traditionally thought to be the seat of emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "779301be-eb12-4aff-a715-ed3f08d8462e",
                                                "sense_id": "f157d964-a8b3-3297-9de0-7e34f7722ea3",
                                                "text": "[…] I did almoſt beleeve, that the motion of the Heart vvas knovvn to God alone: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b067e5b-f969-300a-994f-da9f270d3d9a",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "One's feelings and emotions, especially considered as part of one's character."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d373630c-315e-45ea-85d2-a235d841b583",
                                                "sense_id": "2b067e5b-f969-300a-994f-da9f270d3d9a",
                                                "text": "She has a cold heart."
                                            },
                                            {
                                                "example_id": "89b36ac4-2baf-4e09-a778-f3a146a3b276",
                                                "sense_id": "2b067e5b-f969-300a-994f-da9f270d3d9a",
                                                "text": "In the lightness of my heart I sang catches of songs as my horse gayly bore me along the well-remembered road."
                                            },
                                            {
                                                "example_id": "41b714a5-a522-43e3-bb48-c2de37b7a769",
                                                "sense_id": "2b067e5b-f969-300a-994f-da9f270d3d9a",
                                                "text": "Here is my secret. It is very simple: It is only with the heart that one can see rightly; what is essential is invisible to the eye."
                                            },
                                            {
                                                "example_id": "da757de7-5d71-4044-b266-25373293b6e3",
                                                "sense_id": "2b067e5b-f969-300a-994f-da9f270d3d9a",
                                                "text": "\"Do what the heart commands,\" Tothero says. \"The heart is our only guide.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f815633-7883-3714-8f09-bebab81b6a66",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "The seat of the affections or sensibilities, collectively or separately, as love, hate, joy, grief, courage, etc.; rarely, the seat of the understanding or will; usually in a good sense; personality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03bb800f-5ae2-461e-8b2b-f42b76c12bff",
                                                "sense_id": "2f815633-7883-3714-8f09-bebab81b6a66",
                                                "text": "a good, tender, loving, bad, hard, or selfish heart"
                                            },
                                            {
                                                "example_id": "cea7a033-9f67-45bb-a19a-1ec96297b8cb",
                                                "sense_id": "2f815633-7883-3714-8f09-bebab81b6a66",
                                                "text": "Upon his browes was pourtraid vgly death, / And in his eies the furies of his heart, / That ſhine as Comets, menacing reueng, / And caſts a pale complexion on his cheeks."
                                            },
                                            {
                                                "example_id": "e89dffbd-ca54-4a22-8f46-554a23fbbc7f",
                                                "sense_id": "2f815633-7883-3714-8f09-bebab81b6a66",
                                                "text": "Calm and deep peace in this wide air,\n⁠These leaves that redden to the fall;\n⁠And in my heart, if calm at all,\nIf any calm, a calm despair: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b6d6a8-70ff-3e6f-bb73-56e194d8361d",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "Emotional strength that allows one to continue in difficult situations; courage; spirit; a will to compete."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef7dce15-b17c-4fa0-a222-f9fc65a717ff",
                                                "sense_id": "76b6d6a8-70ff-3e6f-bb73-56e194d8361d",
                                                "text": "The expelled nations take heart, and when they fled from one country, invaded another."
                                            },
                                            {
                                                "example_id": "87139fff-ec13-4f65-a890-c737c00c8de4",
                                                "sense_id": "76b6d6a8-70ff-3e6f-bb73-56e194d8361d",
                                                "text": "\"We provided a lot of brains and a lot of heart to the response when it was needed,\" says Sandra Sanchez, director of AFSC's Immigrants' Voice Program in Des Moines."
                                            },
                                            {
                                                "example_id": "e94575fe-3fc5-4dd5-8bbd-4df1887a08a4",
                                                "sense_id": "76b6d6a8-70ff-3e6f-bb73-56e194d8361d",
                                                "text": "The result still leaves Wales bottom of the group but in better heart for Tuesday night's trip to face England at Wembley, who are now outright leaders after their 3-0 win in Bulgaria."
                                            },
                                            {
                                                "example_id": "242c59f6-b7e1-4f8d-aa5b-058d6982a97b",
                                                "sense_id": "76b6d6a8-70ff-3e6f-bb73-56e194d8361d",
                                                "text": "The heart from the home team was immense. Some of them were out on their feet before the end, but they dug in, throwing themselves in front of shots and crosses, surviving."
                                            },
                                            {
                                                "example_id": "efd28bb0-aff4-4c5e-a06e-a87989ec9608",
                                                "sense_id": "76b6d6a8-70ff-3e6f-bb73-56e194d8361d",
                                                "text": "The team lost, but they showed a lot of heart."
                                            },
                                            {
                                                "example_id": "941f1f1d-cd92-4157-af2f-dd0c0bc9231d",
                                                "sense_id": "76b6d6a8-70ff-3e6f-bb73-56e194d8361d",
                                                "text": "Eve, recovering heart, replied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536ed237-d709-3aec-b08a-72f6873773c4",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "Vigorous and efficient activity; power of fertile production; condition of the soil, whether good or bad."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49c318c9-d91b-4f5b-8ae5-c762cf36f1c6",
                                                "sense_id": "536ed237-d709-3aec-b08a-72f6873773c4",
                                                "text": "Both theſe unhappy Soils the Swain forbears, / And keeps a Sabbath of alternate Years: / That the ſpent Earth may gather heart again; / And, better'd by Ceſſation, bear the Grain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128b4b4c-3ed1-3107-bd13-e548c91ad9e1",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "A term of affectionate or kindly and familiar address."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab7a48b-3a0d-4c14-9472-52155a807117",
                                                "sense_id": "128b4b4c-3ed1-3107-bd13-e548c91ad9e1",
                                                "text": "Listen, dear heart, we must go now."
                                            },
                                            {
                                                "example_id": "6129d840-5202-4762-ba33-7b1e8f121031",
                                                "sense_id": "128b4b4c-3ed1-3107-bd13-e548c91ad9e1",
                                                "text": "My King, my Jove, I speak to thee, my heart!"
                                            },
                                            {
                                                "example_id": "951c55ae-fc33-4add-a399-32020771d072",
                                                "sense_id": "128b4b4c-3ed1-3107-bd13-e548c91ad9e1",
                                                "text": "Awake, dear heart, awake. Thou hast slept well./Awake."
                                            },
                                            {
                                                "example_id": "2da0be42-1dee-43c9-8493-0a729b5eb7b9",
                                                "sense_id": "128b4b4c-3ed1-3107-bd13-e548c91ad9e1",
                                                "text": "Certain unscrupulous men may call upon you here in your dressing-room. They will lavish you with flowers, with compliments, with phials of Hungary water and methuselahs of the costliest champagne. You must be wary of such men, my hearts, they are not to be trusted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63f44fa7-96f1-3e34-8800-07492cd2f080",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "Memory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c66a6e0-ffa4-44fe-9c7e-4d2a9a15a9a9",
                                                "sense_id": "63f44fa7-96f1-3e34-8800-07492cd2f080",
                                                "text": "I know almost every Beatles song by heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "967b69f3-734d-3139-98ab-b6934513e728",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "A wight or being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1489a2-7c6d-47ce-bdcb-5f795a706f04",
                                                "sense_id": "967b69f3-734d-3139-98ab-b6934513e728",
                                                "text": "[…] I would outstare the sternest eyes that look, / Outbrave the heart most daring on earth, / Pluck the young sucking cubs from the she-bear, / Yea, mock the lion when he roars for prey,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0dd4c4b-d330-31fc-a635-325c709a4d22",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "A conventional shape or symbol used to represent the heart, love, or emotion: ♥."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7bf06d6-773e-4a53-9987-9e0b79e3c102",
                                                "sense_id": "c0dd4c4b-d330-31fc-a635-325c709a4d22",
                                                "text": "\"Aw. Thank you.\" The Cherub kissed the air between them and sent a small cluster of tiny red hearts at her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80bb830-729d-36aa-a4fb-ad12f7f12c00",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "A playing card of the suit hearts featuring one or more heart-shaped symbols."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd6f5e48-8974-3678-b2a5-680116641906",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "The twenty-fourth Lenormand card."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "The centre, essence, or core."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b92cc3c-39f8-4951-a2b8-5f2abc51b60f",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "That is the heart of the matter"
                                            },
                                            {
                                                "example_id": "2babab98-affa-48b4-9235-80ff9ec98aaf",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "The wood at the heart of a tree is the oldest."
                                            },
                                            {
                                                "example_id": "afa8034f-6261-4824-a274-5575b0c20dcf",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "Buddhists believe that suffering is right at the heart of all life."
                                            },
                                            {
                                                "example_id": "9a2de8dd-1e4e-4a9d-a1bf-e34155aa7d75",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "At last she spoke in a low voice, hesitating slightly, nevertheless going with incisive directness into the very heart of the problem."
                                            },
                                            {
                                                "example_id": "c3faa475-70c5-44b1-9bc6-dc6c63cb741d",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "The narrow streets that twist and turn through the compact heart of Dent are surfaced with cobbles which, in the absence of pavements, spread right across from doorstep to doorstep."
                                            },
                                            {
                                                "example_id": "422865c7-a0d3-4ec7-8c22-4374ec12ee2d",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "The heart of the modern city is T’ien-an-men Square, one of the largest — if not the largest — square in the world, created expressly in the Fifties on the ashes of the old “Tartar city,” an agglomeration of small and unassuming low grey houses, inhabited by the populace that was once excluded from the “Forbidden City.”"
                                            },
                                            {
                                                "example_id": "cedc3097-ee59-4a07-ad28-a0616d205ba1",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "Arcelia Silva Martinez: Watch out!/Arcelia Silva Martinez: We've got geth in the tower./Fai Dan: Protect the heart of the colony!"
                                            },
                                            {
                                                "example_id": "5107e952-6cad-4ad3-869e-6b941c6b257d",
                                                "sense_id": "932ededb-1933-3757-8a4e-1ea452a6691d",
                                                "text": "Norwich's attack centred on a front pair of Steve Morison and Grant Holt, but Younes Kaboul at the heart of the Tottenham defence dominated in the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fcc1873-7fdc-3456-8632-c0b4f0317f7e",
                                        "entry_id": "f7d70326-b040-35e9-9f14-affe90b4f550",
                                        "glosses": [
                                            "The centre, essence, or core.",
                                            "The main fraction or product of a distillation run."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "heart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0246dd3-3278-3e67-951c-0ac6a3776307",
                                        "entry_id": "5f0c0cd3-2e3f-31e5-abfe-74536cac847f",
                                        "glosses": [
                                            "To be fond of. Often bracketed or abbreviated with a heart symbol."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9004512c-a062-4397-8694-67d90e9f0d0c",
                                                "sense_id": "f0246dd3-3278-3e67-951c-0ac6a3776307",
                                                "text": "We're but the sum of all our terrors until we heart the dove."
                                            },
                                            {
                                                "example_id": "e96058df-7787-4692-a3b5-ae9c3b05ef25",
                                                "sense_id": "f0246dd3-3278-3e67-951c-0ac6a3776307",
                                                "text": "2006, Susan Reinhardt, Bulldog doesn't have to rely on the kindness of strangers to draw attention, Citizen-Times.com\nI guess at this point we were supposed to feel elated she'd come to her senses and decided she hearts dogs after all."
                                            },
                                            {
                                                "example_id": "2fa761cd-9b39-46e7-9c9f-b44dcf216f5f",
                                                "sense_id": "f0246dd3-3278-3e67-951c-0ac6a3776307",
                                                "text": "The further we delve into this \"story\", the more convinced we become of one thing: We heart the Goss."
                                            },
                                            {
                                                "example_id": "107cc2ef-1e58-4b0d-9cc2-fd3297de4f80",
                                                "sense_id": "f0246dd3-3278-3e67-951c-0ac6a3776307",
                                                "text": "2008 July 25, \"The Media Hearts Obama?\", On The Media, National Public Radio"
                                            },
                                            {
                                                "example_id": "fdb0dc60-213c-4097-91a2-8fd38205dfd3",
                                                "sense_id": "f0246dd3-3278-3e67-951c-0ac6a3776307",
                                                "text": "Lots of people say they love their hometown, but no one hearts NY quite like Milton Glaser."
                                            }
                                        ]
                                    },
                                    {
