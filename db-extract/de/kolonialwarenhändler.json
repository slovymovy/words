                        "glosses": [
                            "Person oder Firma, die mit Kolonialwaren handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d4a5cd1-c171-4330-8b05-af88aa8212ae",
                                "sense_id": "5cffff2c-6adf-32ca-b962-46d6bb916649",
                                "text": "„Aber das Blut wäre das Blut von Tausenden von Schreinern, Bankangestellten, Kleinbauern oder Kolonialwarenhändlern gewesen, natürlich auch von Frauen und Kindern, weil Kriege immer viel mehr zivile Opfer fordern, als die Kriegsführenden zugeben.“"
                            },
                            {
                                "example_id": "f2d533d7-7a3d-42de-82ef-dce140a6cfbc",
                                "sense_id": "5cffff2c-6adf-32ca-b962-46d6bb916649",
                                "text": "„Der Kolonialwarenhändler mit dem Schnurrbart schoß mit giftigen Blicken aus seinem Laden und kroch wie eine fette Made über die Trümmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
