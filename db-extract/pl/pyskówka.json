                "translations": [
                    {
                        "translation_id": "90be3f3d-0573-481e-aa9c-68b55100551b",
                        "source_entry_id": "8f93af17-0bc7-3b46-93a7-352bb104986d",
                        "source_sense_id": "ef1d079f-7dda-33fb-8a15-48b558cd2748",
                        "target_lang_word": "prise de bec",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prise de bec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bef0243-0eb1-3732-a0bf-691a68532a11",
                                        "entry_id": "52e11122-2104-3f50-a177-09d0782b5d17",
                                        "glosses": [
                                            "Dispute."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90ba3c1-ef75-41e9-b587-72684ccad3a2",
                                                "sense_id": "2bef0243-0eb1-3732-a0bf-691a68532a11",
                                                "text": "Le soir on ne savait pas quoi foutre sans télé, toutes les occasions étaient bonnes pour des prises de bec."
                                            },
                                            {
                                                "example_id": "9754ef27-56e4-4218-8802-d94e5bbfb930",
                                                "sense_id": "2bef0243-0eb1-3732-a0bf-691a68532a11",
                                                "text": "Une petite prise de bec qui avait fait s'enfuir Jane à minuit, en plein orage, persuadée que leur histoire était finie ! Une petite prise de bec qui l'avait précipitée dans les bras d'un autre homme ! Dans son lit !"
                                            },
                                            {
                                                "example_id": "6437bb97-e4a4-4a45-8fe3-235b39606a2d",
                                                "sense_id": "2bef0243-0eb1-3732-a0bf-691a68532a11",
                                                "text": "Une mémorable prise de bec avec Muti lors d'une répétition de Paillasse à Ravenne illustre d'ailleurs son tempérament fougueux : « Je n'accepte de leçon de personne ! » lança-t-elle au chef d'orchestre interloqué."
                                            },
                                            {
                                                "example_id": "9ddb1109-deec-4d0b-98bb-a652cd291644",
                                                "sense_id": "2bef0243-0eb1-3732-a0bf-691a68532a11",
                                                "text": "Tout en songeant à la permission que venait de lui accorder son sup, en dépit de la prise de bec qu'il avait eue le matin même avec lui, Sylvain se rendait parfaitement compte que celui-ci n'allait pas en rester là et qu'il ruminait sa vengeance, mais de cela, il n'en avait rien à cirer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
