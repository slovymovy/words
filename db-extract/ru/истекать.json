                            },
                            {
                                "example_id": "68774a67-93a9-4001-bf4a-07169d03597f",
                                "sense_id": "f5d09bcd-bdf4-348b-82f9-090d07933264",
                                "text": "истека́ть потом",
                                "translation": "to drip with sweat",
                                "english": "to drip with sweat"
                            }
                        ]
                    },
                    {
                        "sense_id": "8a8b267d-e5b0-38b4-90a7-85eb31df716f",
                        "entry_id": "a21f2166-5524-3e24-aafa-d3e23c17ff33",
                        "glosses": [
                            "to elapse, to run out, to expire, to fall due"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714d2ee2-6532-46fb-8c27-e27f800dabf4",
                                "sense_id": "8a8b267d-e5b0-38b4-90a7-85eb31df716f",
                                "text": "вре́мя истека́ет",
                                "translation": "time is short;time is running out",
                                "english": "time is short;time is running out"
                            },
                            {
                                "example_id": "7decf6d0-bd03-468e-a094-85a998ab7cb9",
                                "sense_id": "8a8b267d-e5b0-38b4-90a7-85eb31df716f",
                                "text": "срок хране́ния проду́кта истека́ет за́втра",
                                "translation": "this product is good until tomorrow",
                                "english": "this product is good until tomorrow"
                            },
                            {
                                "example_id": "9aa3672f-bf27-4325-91ad-9b03e9e66335",
                                "sense_id": "8a8b267d-e5b0-38b4-90a7-85eb31df716f",
                                "text": "срок хране́ния лека́рства истека́ет за́втра",
                                "translation": "this medicine expires tomorrow; the expiry term of this medicine ends tomorrow",
                                "english": "this medicine expires tomorrow; the expiry term of this medicine ends tomorrow"
                            }
                        ]
                    }
