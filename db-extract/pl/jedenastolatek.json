                        "source_entry_id": "ffb484d5-f294-36f2-97ac-b93ac394d991",
                        "source_sense_id": "89405c94-54eb-324a-a998-e3831d71d146",
                        "target_lang_word": "Elfjähriger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elfjähriger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f11ece2-721d-3a2d-b83a-b51fe8d2f3c8",
                                        "entry_id": "e5a8b2ca-4237-3cef-b131-3a439e3a3060",
                                        "glosses": [
                                            "Kind im Alter von elf Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6849fd8a-5974-4dc7-9e63-c8c2aafc68f5",
                                                "sense_id": "9f11ece2-721d-3a2d-b83a-b51fe8d2f3c8",
                                                "text": "Ein Elfjähriger geht in der Regel nicht mehr in die Grundschule."
                                            },
                                            {
                                                "example_id": "78b548cf-0511-4e58-91e3-1ca5623e73e0",
                                                "sense_id": "9f11ece2-721d-3a2d-b83a-b51fe8d2f3c8",
                                                "text": "Der Elfjährige kennt bereits den Satz des Pythagoras."
                                            },
                                            {
                                                "example_id": "fb3c1d85-ad68-43de-a2ff-40e4020c5e5b",
                                                "sense_id": "9f11ece2-721d-3a2d-b83a-b51fe8d2f3c8",
                                                "text": "In der 5B sind fast nur Elfjährige und Zwölfjährige."
                                            },
                                            {
                                                "example_id": "eb75aa73-601d-46db-aee2-e0e26942fce3",
                                                "sense_id": "9f11ece2-721d-3a2d-b83a-b51fe8d2f3c8",
                                                "text": "Die beiden Elfjährigen vertrauen sich blind."
                                            },
                                            {
                                                "example_id": "fbbe1242-6412-4898-bbaf-007e0f7e4189",
                                                "sense_id": "9f11ece2-721d-3a2d-b83a-b51fe8d2f3c8",
                                                "text": "„Als Elfjähriger dichtete er Fabeln.“"
                                            },
                                            {
                                                "example_id": "5b8ba8b0-a941-4310-9f49-a2c10823b0d2",
                                                "sense_id": "9f11ece2-721d-3a2d-b83a-b51fe8d2f3c8",
                                                "text": "„Sie verfolgen eine fast zweiwöchige Wanderung, die ich als Elfjähriger im Sommer 1963 zusammen mit meinem Vater entlang der Mosel gemacht habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
