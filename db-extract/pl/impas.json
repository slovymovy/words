                "translations": [
                    {
                        "translation_id": "81a23c0c-557a-4973-bf12-607cf2d03871",
                        "source_entry_id": "5c2f8b5c-6cf2-3534-bfc9-5301358a2a09",
                        "source_sense_id": "08c6028b-c4b0-32c7-9751-bc5c8cfaed3d",
                        "target_lang_word": "impasse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impasse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa257a0-518c-3364-be48-153864ef80f9",
                                        "entry_id": "ed8359a7-ab4a-3b99-8d41-7c5cc5af9e72",
                                        "glosses": [
                                            "A road with no exit; a cul-de-sac."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9d37ec1-c697-37a8-8435-4c252e8751ac",
                                        "entry_id": "ed8359a7-ab4a-3b99-8d41-7c5cc5af9e72",
                                        "glosses": [
                                            "A deadlock or stalemate situation in which no progress can be made."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf1b52cd-992f-4e9c-aa3b-ceb435d7fa3c",
                                                "sense_id": "e9d37ec1-c697-37a8-8435-4c252e8751ac",
                                                "text": "“It seems to me the thing's an impasse. French expression,” I explained, “meaning that we're stymied good and proper with no hope of finding a formula.”"
                                            },
                                            {
                                                "example_id": "c5b5e06d-2ade-4829-8c21-d2923a21d513",
                                                "sense_id": "e9d37ec1-c697-37a8-8435-4c252e8751ac",
                                                "text": "\"Young man, this town is at a bit of an impasse. If you have any suggestion that might help, now would be the time to voice it.\""
                                            },
                                            {
                                                "example_id": "0bbcf308-6495-4f0f-aab1-f50d72ead33a",
                                                "sense_id": "e9d37ec1-c697-37a8-8435-4c252e8751ac",
                                                "text": "The agreement, which falls short of the sprawling changes championed by Democrats, is a significant step toward ending a yearslong impasse over gun reform legislation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f6f3fb2-1da2-4533-915e-d216903c2655",
                        "source_entry_id": "5c2f8b5c-6cf2-3534-bfc9-5301358a2a09",
                        "source_sense_id": "08c6028b-c4b0-32c7-9751-bc5c8cfaed3d",
                        "target_lang_word": "impasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f4a6f5-9b54-396f-87f3-c0cbbd4cc3d2",
                                        "entry_id": "7ff5af71-e32f-3905-bed7-4e120ad9fa86",
                                        "glosses": [
                                            "Voie sans issue, cul-de-sac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad40f9a3-87cc-4265-87ff-2a4c7a765bd0",
                                                "sense_id": "c6f4a6f5-9b54-396f-87f3-c0cbbd4cc3d2",
                                                "text": "Peut-être le chauffeur allait-il m'entraîner au fond d'une impasse et m'assommer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2f5669-6a50-3f52-9f16-572615631307",
                                        "entry_id": "7ff5af71-e32f-3905-bed7-4e120ad9fa86",
                                        "glosses": [
                                            "Situation bloquée ou sans issue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "378f4111-f7ec-4137-b71e-e481795c99f1",
                                                "sense_id": "6a2f5669-6a50-3f52-9f16-572615631307",
                                                "text": "L’inspecteur vous aura dit que j’étais une fille de rien, est-ce vrai ? Que je courais les hommes comme une chienne ? Oui ? que je vous empaumais sans doute ? consciente de l’impasse où je vous acculais ?"
                                            },
                                            {
                                                "example_id": "befe5e00-8098-4b73-a43e-f4e6202a6715",
                                                "sense_id": "6a2f5669-6a50-3f52-9f16-572615631307",
                                                "text": "La mondialisation concrète, c’est d’abord une forme nouvelle du règne agressif de la marchandise et de l’argent, qui mène le monde à de profondes impasses économiques, sociales, écologiques et politiques."
                                            },
                                            {
                                                "example_id": "adf63cb6-33b7-4c40-85c7-f5df3ae4dd63",
                                                "sense_id": "6a2f5669-6a50-3f52-9f16-572615631307",
                                                "text": "Le premier essai – Le social et la politique : une articulation stratégique – s'ouvre sur une réflexion concernant les dangers et les impasses de l’électoralisation de la vie politique, laquelle, en éconduisant discrètement la question sociale au profit des logiques d'appareil, contribue à noyer la contestation populaire dans les eaux lénifiantes du consentement (Chomsky)."
                                            },
                                            {
                                                "example_id": "bd9de343-8d37-458d-b82d-5da9a7093b6a",
                                                "sense_id": "6a2f5669-6a50-3f52-9f16-572615631307",
                                                "text": "Donald Trump, qui refuse toujours d’accepter sa défaite face à Joe Biden, a poursuivi vendredi sa croisade, suscitant des interrogations sur la façon dont il compte sortir de ce qui ressemble chaque jour un peu plus à une impasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df4a4422-500d-3bca-8c22-f3569d5f9fab",
                                        "entry_id": "7ff5af71-e32f-3905-bed7-4e120ad9fa86",
                                        "glosses": [
                                            "Manœuvre consistant à prendre une carte à un adversaire en posant une carte intermédiaire, souvent utilisée au jeu de bridge."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e3be2e1-0c28-4636-8ef9-58892f380fba",
                                                "sense_id": "df4a4422-500d-3bca-8c22-f3569d5f9fab",
                                                "text": "Avant même qu’Ouest n’ait pu rien dire l'Ogre Obèse avait mené à bien son impasse et ramassé sa levée sans histoire."
                                            }
                                        ]
                                    }
                                ]
                            },
