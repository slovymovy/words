{
    "word_family": [
        "fragility",
        "fragilely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1495066c-fb0d-31f2-aeb1-94279ddb1ba8",
                    "sense_definition": "Easily broken, not sturdy; of delicate material.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_fragility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She caught the <w>fragile</w> vase before it could shatter on the floor.",
                            "target_lang_translations": {
                                "ru": "Она поймала <w>хрупкую</w> вазу, прежде чем та успела разбиться об пол.",
                                "pl": "Złapała <w>kruchą</w> wazę, zanim zdążyła rozbić się o podłogę."
                            }
                        },
                        {
                            "text": "Please be careful with this box, as it contains <w>fragile</w> items.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, будьте осторожны с этой коробкой, так как в ней находятся <w>хрупкие</w> предметы.",
                                "pl": "Proszę uważać z tym pudełkiem, ponieważ zawiera <w>kruche przedmioty</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "breakable",
                        "delicate",
                        "flimsy",
                        "frangible"
                    ],
                    "antonyms": [
                        "durable",
                        "indestructible",
                        "unbreakable"
                    ],
                    "common_phrases": [
                        "fragile items",
                        "fragile glass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко ломающийся, непрочный; сделанный из деликатного материала.",
                        "pl": "Łatwo pękający, nietrwały; wykonany z delikatnego materiału."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "ломкий",
                                "target_lang_sense_clarification": "легко ломающийся"
                            },
                            {
                                "target_lang_word": "бьющийся",
                                "target_lang_sense_clarification": "о стекле или посуде"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kruchy",
                                "target_lang_sense_clarification": "podstawowe znaczenie, łatwo łamiący się"
                            },
                            {
                                "target_lang_word": "delikatny",
                                "target_lang_sense_clarification": "wymagający ostrożnego traktowania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f1677d5-0cb2-3daa-ba00-870d5d25c821",
                    "sense_definition": "Readily disrupted or destroyed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_fragility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The UN tries to maintain the <w>fragile</w> peace process in the region.",
                            "target_lang_translations": {
                                "ru": "ООН пытается поддерживать <w>хрупкий</w> мирный процесс в регионе.",
                                "pl": "ONZ stara się utrzymać <w>kruchy</w> proces pokojowy w regionie."
                            }
                        },
                        {
                            "text": "The country's <w>fragile</w> economy collapsed after the sudden crisis.",
                            "target_lang_translations": {
                                "ru": "<w>Хрупкая</w> экономика страны рухнула после внезапного кризиса.",
                                "pl": "<w>Nietrwała</w> gospodarka kraju załamała się po nagłym kryzysie."
                            }
                        }
                    ],
                    "synonyms": [
                        "delicate",
                        "tenuous"
                    ],
                    "antonyms": [
                        "durable"
                    ],
                    "common_phrases": [
                        "fragile peace",
                        "fragile economy",
                        "fragile ecosystem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко нарушаемый или разрушаемый (о нематериальных вещах).",
                        "pl": "Łatwy do zakłócenia lub zniszczenia (o rzeczach niematerialnych)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "о мире, отношениях"
                            },
                            {
                                "target_lang_word": "непрочный",
                                "target_lang_sense_clarification": "ненадежный"
                            },
                            {
                                "target_lang_word": "шаткий",
                                "target_lang_sense_clarification": "неустойчивый"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kruchy",
                                "target_lang_sense_clarification": "metaforycznie o pokoju, relacjach"
                            },
                            {
                                "target_lang_word": "nietrwały",
                                "target_lang_sense_clarification": "niepewny, mogący łatwo przestać istnieć"
                            },
                            {
                                "target_lang_word": "chwiejny",
                                "target_lang_sense_clarification": "niestabilny, np. o gospodarce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c7cf58a-dfe8-3918-8d10-754c98472c8d",
                    "sense_definition": "Feeling weak or easily disturbed as a result of illness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the flu, she felt very <w>fragile</w> and needed rest.",
                            "target_lang_translations": {
                                "ru": "После гриппа она чувствовала себя очень <w>слабой</w> и нуждалась в отдыхе.",
                                "pl": "Po grypie czuła się bardzo <w>słaba</w> i potrzebowała odpoczynku."
                            }
                        },
                        {
                            "text": "He looked pale and <w>fragile</w> sitting in the hospital bed.",
                            "target_lang_translations": {
                                "ru": "Он выглядел бледным и <w>хрупким</w>, сидя на больничной койке.",
                                "pl": "Wyglądał blado i <w>wątle</w>, siedząc na szpitalnym łóżku."
                            }
                        }
                    ],
                    "synonyms": [
                        "frail"
                    ],
                    "common_phrases": [
                        "feel fragile",
                        "look fragile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий слабость или недомогание в результате болезни.",
                        "pl": "Odczuwający słabość lub niedyspozycję w wyniku choroby."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "физически"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "о внешнем виде"
                            },
                            {
                                "target_lang_word": "немощный",
                                "target_lang_sense_clarification": "хилый"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "słaby",
                                "target_lang_sense_clarification": "fizycznie osłabiony"
                            },
                            {
                                "target_lang_word": "wątły",
                                "target_lang_sense_clarification": "o delikatnej budowie ciała lub osłabionym wyglądzie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "511488ba-9bf4-3df3-8a57-9f945578c6c9",
                    "sense_definition": "Thin-skinned or oversensitive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a very <w>fragile</w> person and gets easily depressed.",
                            "target_lang_translations": {
                                "ru": "Он очень <w>ранимый</w> человек и легко впадает в депрессию.",
                                "pl": "Jest bardzo <w>wrażliwą</w> osobą i łatwo wpada w depresję."
                            }
                        },
                        {
                            "text": "Her <w>fragile</w> ego was easily bruised by the slightest criticism.",
                            "target_lang_translations": {
                                "ru": "Её <w>хрупкое</w> эго было легко уязвлено малейшей критикой.",
                                "pl": "Jej <w>kruche</w> ego łatwo było zranić najmniejszą krytyką."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fragile ego",
                        "emotionally fragile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обидчивый или чрезмерно чувствительный.",
                        "pl": "Obrażalski lub nadmiernie wrażliwy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ранимый",
                                "target_lang_sense_clarification": "эмоционально"
                            },
                            {
                                "target_lang_word": "уязвимый",
                                "target_lang_sense_clarification": "чувствительный"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "метафорически об эго"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wrażliwy",
                                "target_lang_sense_clarification": "emocjonalnie podatny na zranienie"
                            },
                            {
                                "target_lang_word": "podatny na zranienie",
                                "target_lang_sense_clarification": "o emocjach lub ego"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aad88ae5-d34e-3221-afc1-554808df2346",
                    "sense_definition": "Something that is fragile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pack the <w>fragiles</w> separately to avoid damage.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, упакуйте <w>хрупкие предметы</w> отдельно, чтобы избежать повреждений.",
                                "pl": "Proszę zapakować <w>kruche przedmioty</w> oddzielnie, aby uniknąć uszkodzeń."
                            }
                        },
                        {
                            "text": "The movers labeled the box containing <w>fragiles</w> with a red sticker.",
                            "target_lang_translations": {
                                "ru": "Грузчики наклеили красный стикер на коробку с <w>хрупким грузом</w>.",
                                "pl": "Pracownicy firmy przeprowadzkowej oznaczyli pudełko z <w>kruchymi przedmiotami</w> czerwoną naklejką."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pack fragiles"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что является хрупким (обычно во множественном числе).",
                        "pl": "Przedmioty, które łatwo ulegają uszkodzeniu (zazwyczaj w liczbie mnogiej)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкие предметы",
                                "target_lang_sense_clarification": "вещи"
                            },
                            {
                                "target_lang_word": "хрупкий груз",
                                "target_lang_sense_clarification": "при перевозке"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przedmioty kruche",
                                "target_lang_sense_clarification": "rzeczy wymagające ostrożności"
                            },
                            {
                                "target_lang_word": "delikatesy",
                                "target_lang_sense_clarification": "w kontekście transportu towarów"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}