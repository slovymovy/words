                                "target_senses": [
                                    {
                                        "sense_id": "8179ccb5-a6ab-3b91-8e5d-09fe3213ef6c",
                                        "entry_id": "f841c493-b9b5-3497-b318-4514ce26a806",
                                        "glosses": [
                                            "Pertaining to an increment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33cc38a4-4bff-3f44-ad89-269312fafc61",
                                        "entry_id": "f841c493-b9b5-3497-b318-4514ce26a806",
                                        "glosses": [
                                            "Occurring over a series of gradual increments, or small steps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4130a01-10f6-4f01-9174-14bc719ca304",
                                                "sense_id": "33cc38a4-4bff-3f44-ad89-269312fafc61",
                                                "text": "The replies to questions indicate that the technology provided noncontractually is generally more routine and incremental than that protected by contracts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74c88958-bef9-4656-89b7-b02b9f9d58dd",
                        "source_entry_id": "d9414268-0ec9-36cc-a482-5b8f5df1f575",
                        "source_sense_id": "6453d23c-e552-3869-9d76-ceb7dd757d8e",
                        "target_lang_word": "Inkremental-",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c6266e08-928e-4c11-b01d-039f21b89ca9",
                        "source_entry_id": "d9414268-0ec9-36cc-a482-5b8f5df1f575",
                        "source_sense_id": "6453d23c-e552-3869-9d76-ceb7dd757d8e",
                        "target_lang_word": "inkremental",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inkremental",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f47c7d60-a932-3818-b049-2a239ba46396",
                                        "entry_id": "b26922d3-4c40-34ce-ba56-0eeeb21c8469",
                                        "glosses": [
                                            "schrittweise Erhöhung einer Größe um einen bestimmten Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "412afecf-d140-4530-aaa5-09aa71173b13",
                                                "sense_id": "f47c7d60-a932-3818-b049-2a239ba46396",
                                                "text": "Die Spieler zählen abwechselnd inkremental, wobei jede durch drei teilbare Zahl durch das Wort „Fizz“ und jede durch fünf teilbare Zahl durch das Wort „Buzz“ ersetzt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03a426bf-32e3-39ce-9d6a-fc4b79c7c137",
                                        "entry_id": "b26922d3-4c40-34ce-ba56-0eeeb21c8469",
                                        "glosses": [
                                            "schrittweise Erhöhung einer Variablen um einen festen Betrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3936c04-ceb3-4288-9eba-32c5429253a4",
                                                "sense_id": "03a426bf-32e3-39ce-9d6a-fc4b79c7c137",
                                                "text": "Es gibt in der Computerprogrammierung inkrementale Befehle, die die Zielvariable nur um den Wert eins erhöhen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9b6d4e82-926b-3449-9aed-941b8d6575af",
                                        "entry_id": "b26922d3-4c40-34ce-ba56-0eeeb21c8469",
                                        "glosses": [
                                            "Art der Datensicherung, die nur die veränderten Daten im Vergleich zur letzten Differenz- oder Gesamtsicherung auf das Sicherungsmedium schreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854c1885-8962-48d1-9fd9-7ebe7a953a53",
                                                "sense_id": "9b6d4e82-926b-3449-9aed-941b8d6575af",
                                                "text": "Die inkrementale Methode der Datensicherung verkürzt die Sicherungszeiten, erhöht jedoch die Wiederherstellungszeiten."
                                            },
                                            {
                                                "example_id": "041a00a8-4600-4e19-998f-d9efd71e76e1",
                                                "sense_id": "9b6d4e82-926b-3449-9aed-941b8d6575af",
                                                "text": "Redundante Datensicherung auf 2 physikalisch getrennten Festplatten, einem 40GB Bandlaufwerk und inkrementale Datensicherung auf einem online Server."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e3a27b42-2472-36bc-a942-926e8800343d",
                                        "entry_id": "b26922d3-4c40-34ce-ba56-0eeeb21c8469",
                                        "glosses": [
                                            "schrittweise ausgeführte Messungen oder Bewegungen (z.B. Robotertechnik)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450d15a7-d531-4a7a-9834-9e7147f8d6cd",
                                                "sense_id": "e3a27b42-2472-36bc-a942-926e8800343d",
                                                "text": "Eine inkrementale Messung liegt vor, wenn von einem Bezugspunkt aus durch Addition oder Subtraktion in Inkrementen (= kleinster Zuwachs einer veränderlichen Größe) die momentane Größe ermittelt wird, z.B. zur Winkelmessung oder Wegmessung an Werkzeugmaschinen. Dazu werden in gleichmäßigen Abständen auf einem Träger aufgebrachte Markierungen optisch oder elektrisch abgetastet."
                                            },
                                            {
                                                "example_id": "dc0bc31d-23ca-4314-8622-675652ad4dbf",
                                                "sense_id": "e3a27b42-2472-36bc-a942-926e8800343d",
                                                "text": "Unter der inkrementalen Wegmessung versteht man ein Messgerät, das bei jeder Bewegung den (positiven oder negativen) Zuwachs des zurückgelegten Weges misst."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d90a7bed-2fdf-306a-98a3-783e2b630405",
                                        "entry_id": "b26922d3-4c40-34ce-ba56-0eeeb21c8469",
                                        "glosses": [
                                            "schrittweise durchgeführte Analysen von Kosten, Effekten und Nutzen nach Innovationen oder neuen Maßnahmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5a1ae8-2bf7-4f01-a7c9-35972f1ee636",
                                                "sense_id": "d90a7bed-2fdf-306a-98a3-783e2b630405",
                                                "text": "Man bezeichnet diese Differenzen als inkrementale Kosten respektive inkrementale Effekte, QALYs oder Nutzen."
                                            },
                                            {
                                                "example_id": "2f630fb5-e6d8-4f71-8ba8-a658602ef6eb",
                                                "sense_id": "d90a7bed-2fdf-306a-98a3-783e2b630405",
                                                "text": "In ihrem Windschatten konnten jedoch vom Arbeitsministerium inkrementale Reformen innerhalb der ANPE umgesetzt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
