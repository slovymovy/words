            "senses": [
                {
                    "sense_id": "bb955ad5-ca94-3dff-bd5d-c4baac4a92fa",
                    "sense_definition": "het initiatief nemen; een leidende rol op zich nemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "initiatief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand wilde in die moeilijke situatie het <w>voortouw</w> nemen.",
                            "target_lang_translations": {
                                "en": "Nobody wanted to take the <w>lead</w> in that difficult situation."
                            }
                        },
                        {
                            "text": "Onze organisatie besloot het <w>voortouw</w> te nemen bij het opzetten van het nieuwe project.",
                            "target_lang_translations": {
                                "en": "Our organization decided to take the <w>initiative</w> in setting up the new project."
                            }
                        }
                    ],
                    "synonyms": [
                        "initiatief",
                        "leiding"
                    ],
                    "common_phrases": [
                        "het voortouw nemen"
                    ],
                    "target_lang_definitions": {
                        "en": "taking the initiative; assuming a leading role in an activity or project"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "as in 'to take the lead'"
                            },
                            {
                                "target_lang_word": "initiative",
                                "target_lang_sense_clarification": "as in 'to take the initiative'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71c67c9c-afed-3cfd-83a9-6b6af82dd6a9",
                    "sense_definition": "een touw dat aan de voorkant van een object (zoals een boot of voertuig) is bevestigd om het te trekken",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "touwwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte het <w>voortouw</w> van de boot stevig vast aan de kade.",
                            "target_lang_translations": {
                                "en": "He securely fastened the boat's <w>painter</w> to the quay."
                            }
                        },
                        {
                            "text": "Tijdens het slepen knapte het <w>voortouw</w> plotseling door de sterke spanning.",
                            "target_lang_translations": {
                                "en": "During towing, the <w>towline</w> suddenly snapped due to the heavy tension."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleeptouw"
                    ],
                    "target_lang_definitions": {
                        "en": "a rope attached to the front of an object (such as a boat or vehicle) used for towing or securing it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "painter",
                                "target_lang_sense_clarification": "rope attached to the bow of a boat for tying it up"
                            },
                            {
                                "target_lang_word": "towline",
                                "target_lang_sense_clarification": "rope used for towing a vessel or vehicle"
                            },
                            {
                                "target_lang_word": "bowline",
                                "target_lang_sense_clarification": "rope secured at the bow of a vessel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
