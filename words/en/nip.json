{
    "word_family": [
        "nipper",
        "nippy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2980143-c789-3f4c-9aca-f9d642d8551b",
                    "sense_definition": "A quick, sharp pinch or bite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy gave his owner’s finger a playful <w>nip</w>.",
                            "target_lang_translations": {
                                "tr": "Yavru köpek, sahibinin parmağına oyunbaz bir <w>ısırık</w> attı."
                            }
                        },
                        {
                            "text": "She felt a sharp <w>nip</w> on her arm from the insect.",
                            "target_lang_translations": {
                                "tr": "Böceğin kolunu <w>ısırdığını</w> hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinch"
                    ],
                    "common_phrases": [
                        "sharp nip"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hızlı ve keskin bir çimdik veya ısırık."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çimdik",
                                "target_lang_sense_clarification": "Elle yapılan ani ve acı verici sıkıştırma."
                            },
                            {
                                "target_lang_word": "ısırık",
                                "target_lang_sense_clarification": "Dişle yapılan hafif ve hızlı yaralama."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63a3a050-e08a-3e3c-94e1-672054cf88ea",
                    "sense_definition": "A feeling of sharp, biting cold in the air.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a <w>nip</w> in the air this morning, so wear a coat.",
                            "target_lang_translations": {
                                "tr": "Bu sabah havada bir <w>ayaz</w> var, bu yüzden palto giy."
                            }
                        },
                        {
                            "text": "I felt a <w>nip</w> in the air as soon as I stepped outside.",
                            "target_lang_translations": {
                                "tr": "Dışarı adım atar atmaz havanın <w>ayazını</w> hissettim."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nip in the air"
                    ],
                    "target_lang_definitions": {
                        "tr": "Havada hissedilen keskin, dondurucu soğuk."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayaz",
                                "target_lang_sense_clarification": "Havanın keskin ve dondurucu soğukluğu."
                            },
                            {
                                "target_lang_word": "soğuk",
                                "target_lang_sense_clarification": "Havanın genel olarak üşütücü olması."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de547fce-c09e-39b7-8cb8-5aa4a6674fcb",
                    "sense_definition": "A small amount of an alcoholic drink.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He enjoyed a small <w>nip</w> of whiskey before going to bed.",
                            "target_lang_translations": {
                                "tr": "Yatmadan önce bir <w>yudum</w> viskinin tadını çıkardı."
                            }
                        },
                        {
                            "text": "She poured a <w>nip</w> of brandy to warm herself up.",
                            "target_lang_translations": {
                                "tr": "Isınmak için bir <w>yudum</w> konyak koydu."
                            }
                        }
                    ],
                    "synonyms": [
                        "dram",
                        "shot"
                    ],
                    "common_phrases": [
                        "nip of whiskey"
                    ],
                    "target_lang_definitions": {
                        "tr": "Az miktarda alkollü içki."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bir yudum",
                                "target_lang_sense_clarification": "Az miktarda içilen içki."
                            },
                            {
                                "target_lang_word": "kadeh",
                                "target_lang_sense_clarification": "Küçük bir miktar içki porsiyonu."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d970c0f-e139-388b-9b83-5cf31f0d6c7d",
                    "sense_definition": "To go somewhere quickly and briefly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Why don’t you <w>nip</w> down to the shop for some milk?",
                            "target_lang_translations": {
                                "tr": "Süt almak için markete <w>uğrayıp</w> gelmeye ne dersin?"
                            }
                        },
                        {
                            "text": "I will <w>nip</w> over to the office and be back in ten minutes.",
                            "target_lang_translations": {
                                "tr": "Ofise <w>uğrayıp</w> on dakika içinde döneceğim."
                            }
                        }
                    ],
                    "synonyms": [
                        "pop"
                    ],
                    "common_phrases": [
                        "nip down",
                        "nip over"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yere hızlıca ve kısa süreliğine gitmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uğramak",
                                "target_lang_sense_clarification": "Kısa süreliğine bir yere gitmek."
                            },
                            {
                                "target_lang_word": "fırlamak",
                                "target_lang_sense_clarification": "Hızlıca bir yere gidip gelmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b132affd-8657-34c6-b590-b2f9671cbf58",
                    "sense_definition": "To pinch or squeeze something tightly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>nip</w> your finger in the door hinge.",
                            "target_lang_translations": {
                                "tr": "Parmağını kapı menteşesine <w>sıkıştırmamaya</w> dikkat et."
                            }
                        },
                        {
                            "text": "The crab tried to <w>nip</w> my toe while I was swimming.",
                            "target_lang_translations": {
                                "tr": "Ben yüzerken yengeç ayak parmağımı <w>çimdiklemeye</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinch",
                        "squeeze"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi sıkıca çimdiklemek veya sıkıştırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çimdiklemek",
                                "target_lang_sense_clarification": "Bir şeyi parmaklarla sıkıştırmak."
                            },
                            {
                                "target_lang_word": "sıkıştırmak",
                                "target_lang_sense_clarification": "Bir şeyi iki yüzey arasında ezmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}