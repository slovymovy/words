                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На дне старого песчаного <w>карьера</w> образовалось глубокое озеро.",
                            "target_lang_translations": {
                                "en": "A deep lake formed at the bottom of the old sand <w>quarry</w>.",
                                "zh": "在旧沙石<w>矿坑</w>的底部形成了一个深湖。"
                            }
