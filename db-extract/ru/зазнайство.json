                        "source_sense_id": "e4e2839d-4ee1-3731-a89b-bedfd9bb4222",
                        "target_lang_word": "arrogance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15adb772-1a82-35b9-b92b-c7b6a4daa842",
                                        "entry_id": "1e449aa8-6227-3db6-ad6d-710058739ebc",
                                        "glosses": [
                                            "The state of being arrogant; a type of extreme or foolish pride in which someone feels much superior to another."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a31e13a-6140-4dc3-9e42-877b1cf5e0a8",
                        "source_entry_id": "1159663b-6e62-3fbc-bd09-7f4bee9d5846",
                        "source_sense_id": "e4e2839d-4ee1-3731-a89b-bedfd9bb4222",
                        "target_lang_word": "Arroganz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arroganz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1a8cf4-3e86-349b-ab4e-be84b935215a",
                                        "entry_id": "82c0b577-97ef-3564-a652-eab2ec8b3c0e",
                                        "glosses": [
                                            "anmaßende, überhebliche Haltung gegenüber anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87a0db9-0c8c-438d-b3ad-1861cd42fd8f",
                                                "sense_id": "dc1a8cf4-3e86-349b-ab4e-be84b935215a",
                                                "text": "Sein ganzes Verhalten uns gegenüber war von unübersehbarer Arroganz geprägt."
                                            },
                                            {
                                                "example_id": "2611e4b1-85f0-4bee-8e27-daa74e6a9378",
                                                "sense_id": "dc1a8cf4-3e86-349b-ab4e-be84b935215a",
                                                "text": "„Sie beschreiben die Arroganz einer Partei, die zu lange mit absoluter Mehrheit regiert hat.“"
                                            },
                                            {
                                                "example_id": "7f4c0552-5a7f-4842-a58a-7279688cf145",
                                                "sense_id": "dc1a8cf4-3e86-349b-ab4e-be84b935215a",
                                                "text": "„Leider werten noch heute Außenstehende diesen Wesenszug entweder als Arroganz oder als grenzenlose Borniertheit.“."
                                            },
                                            {
                                                "example_id": "4495a90b-a6c0-40ed-b945-9ae1262870cd",
                                                "sense_id": "dc1a8cf4-3e86-349b-ab4e-be84b935215a",
                                                "text": "„Es zeugt von hoher Arroganz, anderen eine bestimmte (meist die eigene) Wertehierarchie oder Sinngebung zuteilen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15011e06-fa8a-47d9-8fb8-86772cc662bb",
                        "source_entry_id": "1159663b-6e62-3fbc-bd09-7f4bee9d5846",
                        "source_sense_id": "e4e2839d-4ee1-3731-a89b-bedfd9bb4222",
                        "target_lang_word": "arrogance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d4befe-2b4f-3575-9ff7-e17e540de473",
                                        "entry_id": "6e872747-9858-3410-a581-374ac13e0635",
                                        "glosses": [
                                            "Attitude hautaine et présomptueuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a8dde4f-15d4-4a21-b05f-e196df5e9956",
                                                "sense_id": "d9d4befe-2b4f-3575-9ff7-e17e540de473",
                                                "text": "Le prétentieux-joueur ne met pas longtemps pour piger que son arrogance inconvenante est gâteusement stupide, ici, entre ces murs, au vu de sa situation."
                                            },
                                            {
                                                "example_id": "5fad8f4a-bfac-4ff5-aeef-d2b6e4abd57e",
                                                "sense_id": "d9d4befe-2b4f-3575-9ff7-e17e540de473",
                                                "text": "Le corps d’officiers, respirant l’orgueil et l’arrogance, étalait à l’épreuve sa nullité professionnelle (à peu d’exceptions près) et sa pourriture morale."
                                            },
                                            {
                                                "example_id": "151baad7-a62f-40d6-b1d4-0c265c33e1ea",
                                                "sense_id": "d9d4befe-2b4f-3575-9ff7-e17e540de473",
                                                "text": "[…] vous avez humilié l’orgueil de vos ennemis et de ceux de votre roi quand leur arrogance était à son comble."
                                            },
                                            {
                                                "example_id": "027ffeca-d7ba-4440-ac07-26c1abf23b6f",
                                                "sense_id": "d9d4befe-2b4f-3575-9ff7-e17e540de473",
                                                "text": "Choyé par les siens, protégé par ses aînés, il avait conquis l’assurance, l’arrogance presque de ceux qui se sentent forts, […]."
                                            },
                                            {
                                                "example_id": "9d1fd0ef-e8a5-4a39-bc0b-3f1f1311f19a",
                                                "sense_id": "d9d4befe-2b4f-3575-9ff7-e17e540de473",
                                                "text": "Son monocle a l’air de ne servir qu’à maintenir son arrogance."
                                            },
                                            {
                                                "example_id": "82b92bdc-a360-4984-b274-12b7c892e23e",
                                                "sense_id": "d9d4befe-2b4f-3575-9ff7-e17e540de473",
                                                "text": "Ils [les Américains] nous énervaient de plus en plus avec leur discours moral, leurs actionnaires et leurs fonds de pension, leur pollution de la planète et leur dégoût de nos fromages. Pour signifler la pauvreté foncière de leur supériorité, fondée sur les armes et l’économie, un mot les définissait usuellement : « arrogance ». Des conquérants sans idéal sinon le pétrole et le dollars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
