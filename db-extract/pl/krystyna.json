                                    {
                                        "sense_id": "19fcc48f-ba69-39af-8fcc-4d23e6cd56bd",
                                        "entry_id": "60351b32-4531-3886-afd8-57e0023fb21b",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae1acb1-2b93-406b-9b27-b576ff8ca2a1",
                                                "sense_id": "19fcc48f-ba69-39af-8fcc-4d23e6cd56bd",
                                                "text": "Le problème avec Christine, ce sont ses enfants qui, loin de se contenter de lui avoir déformé le ventre à jamais, la suivent partout, tout le temps, meute pleurnicharde, gavée de sucreries et de gagatisme infantile."
                                            },
                                            {
                                                "example_id": "c9e6fcce-5efc-4aa2-8d21-507815e52b80",
                                                "sense_id": "19fcc48f-ba69-39af-8fcc-4d23e6cd56bd",
                                                "text": "Yves Betiso, adjoint à la culture, s’y caféinait en compagnie de Christine Saubiette, adjointe à la fibre sociale."
                                            }
                                        ]
