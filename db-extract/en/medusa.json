                                    {
                                        "sense_id": "b1764bf2-9a2e-3281-9ed5-f9c1388365d2",
                                        "entry_id": "a60048cd-a305-31f2-8e40-960844b003d5",
                                        "glosses": [
                                            "benaming voor neteldieren Cnidaria in het kwalstadium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea499c0f-d26c-49a6-ba2b-89032ef523eb",
                                                "sense_id": "b1764bf2-9a2e-3281-9ed5-f9c1388365d2",
                                                "text": "Een medusa produceert eitjes of sperma en werpt deze in zee. Ze smelten samen en vormen de aseksuele poliep."
                                            }
                                        ]
                                    },
                                    {
