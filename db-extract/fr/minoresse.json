                        "glosses": [
                            "Religieuse de l’Ordre des Pauvres Dames."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9c18779f-7cc9-4d2a-911c-e30ab3aff1bd",
                                "sense_id": "34fb5893-46c9-3761-8fc8-0b7f3f4ef469",
                                "text": "Il y a donc, reprit-elle avec volubilité en s’arrêtant, le pied sur la première marche de l’échelle qu’on appelait « l’escalier », il y a donc que la pauvre minoresse, mademoiselle Pola, le cher cœur, va être bien malheureuse."
                            }
                        ]
                    }
