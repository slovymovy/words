                "senses": [
                    {
                        "sense_id": "a36acbc7-ae5b-3e8c-acb7-9e260a6e28bd",
                        "entry_id": "72237257-f6c5-3873-8db5-c2af1dc353d2",
                        "glosses": [
                            "das Risiko, dass ein Garantiefonds komplett in Rentenpapiere umschichten muss und somit keinen liquiden Mittel mehr zur Verfügung hat um in wertsteigernde Fonds zu investieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280f6a3d-47e6-44bd-bd83-4f7dffddf9c2",
                                "sense_id": "a36acbc7-ae5b-3e8c-acb7-9e260a6e28bd",
                                "text": "Der Mathematiker Ruß erklärt weiter, dass das so genannte Monetarisierungsrisiko von derzeit üblichen (dynamisch abgesicherten) Garantiefonds immer mehr in den Fokus der Kritik gerate: \"Folglich brauchen Versicherer neue Produkte, die Garantien mit einer Beteiligung an den Aktienmärkten kombinieren.\""
                            },
                            {
                                "example_id": "5a7704ca-db0d-49bd-a573-4988b6796adf",
                                "sense_id": "a36acbc7-ae5b-3e8c-acb7-9e260a6e28bd",
                                "text": "Zusätzlich wird das Monetarisierungsrisiko, d.h. die schwache Performance am Geldmarkt, durch ausgefeilte Handelsstrategien begrenzt."
                            }
                        ],
