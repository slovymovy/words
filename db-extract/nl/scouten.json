                        "glosses": [
                            "zoeken naar talentvolle kandidaten voor een functie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d41314d-d553-4e05-bb28-e063fe4bff2a",
                                "sense_id": "6439cc3c-2c26-3117-9045-cffec7d72a81",
                                "text": "Standard heeft zijn oog laten vallen op de 19-jarige middenvelder Ianis Hagi - zoon van legende Gheorghe - van het Roemeense Viitorul Constanta. De tegenstander van Ajax is hem gaan scouten in de Europa League-wedstrijd tegen Vitesse."
                            },
                            {
                                "example_id": "308ffbed-c9b1-4cd5-8064-d41b4c9c63b3",
                                "sense_id": "6439cc3c-2c26-3117-9045-cffec7d72a81",
                                "text": "Voetbalclub Huddersfield Town uit de Engelse Premier League gaat een Twentse databank gebruiken voor het scouten van nieuwe spelers. De club heeft een contract afgesloten met SciSports uit Enschede, dat gegevens over 90.000 voetballers heeft verzameld en inzichtelijk maakt voor abonnees."
                            },
                            {
                                "example_id": "b8eb854b-877f-4aff-8c17-1467c525bd5d",
                                "sense_id": "6439cc3c-2c26-3117-9045-cffec7d72a81",
                                "text": "Interessant is dat de man die Nézet-Séguin scoutte en aanstelde, Jan Raes heet, toen nog directeur in Rotterdam. Hij zou bij zijn zoektocht dus op zijn fingerspitzengefühl kunnen vertrouwen."
                            },
                            {
                                "example_id": "2f235adb-441d-4ac4-ae62-e71dad275f73",
                                "sense_id": "6439cc3c-2c26-3117-9045-cffec7d72a81",
                                "text": "Voer een actief en strategisch personeelsbeleid voor de hele breedte van het christelijk en reformatorisch onderwijs. Denk daarbij aan scouten, opleiden en begeleiden."
                            }
                        ]
                    }
