                        "examples": [
                            {
                                "example_id": "dfefb8ac-3246-4b9c-b1e6-506604a8be2d",
                                "sense_id": "5770363e-95be-38e0-8410-2a8317618ca5",
                                "text": "Bruno ist ja Herberts legitimer Sohn, Sieglinde ist nur sein Afterkind."
