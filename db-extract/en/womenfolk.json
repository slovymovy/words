                    },
                    {
                        "sense_id": "6af8bf34-7abe-34db-8565-0ff737e2e483",
                        "entry_id": "dedba33c-098b-39b7-8124-7659c197089a",
                        "glosses": [
                            "The adult female members of a community."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "65164b76-4ec6-4910-9de5-09c5cced73c6",
                                "sense_id": "6af8bf34-7abe-34db-8565-0ff737e2e483",
                                "text": "“Ain’t she a splendid specimen of Southern womanhood?” Rufus asked. “Down yonder, they teach their womenfolks to serve.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e888123b-e512-4e7b-9d1c-3af6feed532b",
                        "source_entry_id": "dedba33c-098b-39b7-8124-7659c197089a",
                        "source_sense_description": "women collectively",
                        "target_lang_word": "Frauensleute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frauensleute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                                        "entry_id": "e9c5b9ee-c99c-3021-ba1d-603e5b6ed950",
                                        "glosses": [
                                            "umgangssprachlich, veraltend: Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7c03f7-0f0c-446a-ae82-9d7f3226fc69",
                                                "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                                                "text": "„Ein Mann, der sagt, was er denkt, ist lächerlich, jedenfalls in den Augen von uns Frauensleuten.“"
                                            },
                                            {
                                                "example_id": "ddb91988-cf48-495f-9db4-7620fe515ee4",
                                                "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                                                "text": "„In Indien, als ich mehr zufrieden war und keinen Groll fürder hegte, gab es zwar viel Frauensleute, sowohl indischen Geblütes, als auch eine Menge englischer, da viele Kaufleute, Offiziere und Soldaten ihre Familie bei sich hatten. Doch …“"
                                            },
                                            {
                                                "example_id": "292eca10-b9c6-4e5a-9bef-0fdd3ac8492d",
                                                "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                                                "text": "„Da das Auspressen und Plündern und das Quälen und Martern kein Ende nahm, hatten die Bauern rund um das Bruch miteinander abgemacht, sich gegenseitig Bescheid zu geben, damit das Vieh und die Frauensleute geborgen werden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6613ccba-9589-4c79-bf26-511d013a2daf",
                        "source_entry_id": "dedba33c-098b-39b7-8124-7659c197089a",
                        "source_sense_description": "women collectively",
                        "target_lang_word": "Weibervolk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weibervolk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54a039e2-0a03-3325-84d4-0f565d156ccb",
                                        "entry_id": "9a04a3ed-ddbc-3b66-94f5-372149d6255b",
                                        "glosses": [
                                            "abwertend: Menge/Gruppe/Gesamtheit der Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24610d9e-f0bd-4652-8d3b-7669b94d2f8a",
                                                "sense_id": "54a039e2-0a03-3325-84d4-0f565d156ccb",
                                                "text": "„Wenn dieses Weibervolk sich doch wenigstens besser vertragen würde.“"
                                            },
                                            {
                                                "example_id": "ce0bbbcd-c79a-493a-b2e1-7c310a81a734",
                                                "sense_id": "54a039e2-0a03-3325-84d4-0f565d156ccb",
                                                "text": "„Dem Weibervolk, das täglich aus- und einging, um dem Liebesgott zu opfern, schenkte er fürder keine Beachtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70dd00df-bfe8-48d1-aebc-28e051a0c09e",
                        "source_entry_id": "dedba33c-098b-39b7-8124-7659c197089a",
                        "source_sense_description": "women collectively",
