                        "glosses": [
                            "Personne qui collectionne les moulins à café."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc1f8e7-8ce6-46d3-a5bf-e412da56c2da",
                                "sense_id": "2de461de-f0be-3a26-9122-27af1f5b4d90",
                                "text": "Bernard Prioux, qui possède 1 200 moulins tous répertoriés et rangés dans son grenier, est donc mylokaphéphile."
                            },
                            {
                                "example_id": "f6100ff7-9daa-4b0b-9048-fc5d16764577",
                                "sense_id": "2de461de-f0be-3a26-9122-27af1f5b4d90",
                                "text": "Tous deux sont mylokaphéphiles. C’est-à-dire qu'ils collectionnent les moulins à café."
                            },
                            {
                                "example_id": "09a04538-8f2b-46f8-b9e0-00db9b85076d",
                                "sense_id": "2de461de-f0be-3a26-9122-27af1f5b4d90",
                                "text": "Ce week-end, les collectionneurs de moulins à café avaient rendez-vous à la salle des fêtes. L’association internationale de ces mylokaphéphiles y tenait son assemblée générale."
                            }
                        ]
                    }
