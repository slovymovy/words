                    {
                        "sense_id": "af0a4c1e-86c7-3194-a31d-01a8fef574af",
                        "entry_id": "7ffc0c36-225c-3001-a864-66c3d2e2c33f",
                        "glosses": [
                            "stad in het zuidwesten van de Belgische provincie West-Vlaanderen die in de Eerste Wereldoorlog na vier slagen uiteindelijk geheel werd verwoest."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "395caee4-4688-49ff-b0b0-38415250a715",
                                "sense_id": "af0a4c1e-86c7-3194-a31d-01a8fef574af",
                                "text": "In Ieper wordt de 'last post' elke dag om 20 uur gespeeld, als eerbetoon aan hen die sneuvelden in de Eerste Wereldoorlog. Dit ritueel doet men al sinds 1928, met enige onderbreking tijdens de bezetting door de Duitsers tussen mei 1940 en 6 september 1944"
                            }
                        ]
                    }
                ],
