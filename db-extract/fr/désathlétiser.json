                "senses": [
                    {
                        "sense_id": "21e6f2aa-6cb1-3f8a-9842-61ebb327b81c",
                        "entry_id": "9ac61380-a78f-3784-8500-fe7331fa4929",
                        "glosses": [
                            "Faire perdre son caractère athlétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3fd5311-3efd-4219-90d1-418771a33a9a",
                                "sense_id": "21e6f2aa-6cb1-3f8a-9842-61ebb327b81c",
                                "text": "La coupure est trop courte pour « désathlétiser » les joueurs, et le temps de travail avant Sochaux sera suffisant pour effectuer une bonne préparation."
                            },
                            {
                                "example_id": "6b9a8f0f-b76a-4918-98e0-d913db59477b",
                                "sense_id": "21e6f2aa-6cb1-3f8a-9842-61ebb327b81c",
                                "text": "Nous vous suggérons néanmoins de garder une activité physique afin de ne pas vous désathlétiser."
                            },
                            {
                                "example_id": "5566b8ed-0281-44b6-a1d6-a0011282104f",
                                "sense_id": "21e6f2aa-6cb1-3f8a-9842-61ebb327b81c",
                                "text": "24 millions de dispos, certes, mais Rabiot peut partir de manière anticipée pour 15-20 millions, surtout s'il veut éviter de passer 6 mois au frais et se désathlétiser (\"jurisprudence Ben Arfa\")."
                            }
                        ]
                    }
