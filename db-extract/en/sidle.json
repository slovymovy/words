                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa3897d4-1da5-38f7-8c93-1fe2916b6d65",
                        "entry_id": "e9325e7f-8327-3e58-928c-f3b2a61900de",
                        "glosses": [
                            "An act of sidling.",
                            "A sideways movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88753690-36a9-4641-91c9-0f0cc37890ab",
                                "sense_id": "aa3897d4-1da5-38f7-8c93-1fe2916b6d65",
                                "text": "[I]n this mythic America, we fly along in the fast lane, placing bets against flashing lights in the rearview mirror, against the dreaded sidle into the gravel and the voice at the window demanding our license."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ef4f7ad-0a92-33cb-bbe6-ba82f1a13ffb",
                        "entry_id": "e9325e7f-8327-3e58-928c-f3b2a61900de",
                        "glosses": [
                            "An act of sidling.",
                            "A furtive advance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cef7b11-fb2c-4ea8-b984-b6a3a683fd89",
                                "sense_id": "4ef4f7ad-0a92-33cb-bbe6-ba82f1a13ffb",
                                "text": "Listener up there! Here you … what have you to confide in me? / Look in my face while I snuff the sidle of evening, / Talk honestly, for no one else hears you, and I stay only a minute longer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
