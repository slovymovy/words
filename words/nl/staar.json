                },
                {
                    "sense_id": "a93d7f12-141c-38c0-a01e-661ae6fdd573",
                    "sense_definition": "Gebiedende wijs van <w>staren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "staren_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Staar</w> niet zo onbeleefd naar die mensen aan de overkant.",
                            "target_lang_translations": {
                                "en": "Don't <w>stare</w> so rudely at those people across the street."
                            }
                        },
                        {
                            "text": "Kom op, <w>staar</w> niet in de ruimte maar ga snel weer aan het werk.",
                            "target_lang_translations": {
                                "en": "Come on, don't <w>stare</w> into space but get back to work quickly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "staar niet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
