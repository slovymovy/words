                        "glosses": [
                            "Visionner une nouvelle fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceb15ab0-fc83-42a4-938b-375e5ffdec0e",
                                "sense_id": "597cd538-04ad-34f1-a95d-04e31852a9e5",
                                "text": "Nous enregistrons nos discussions les plus importantes et les formations que nous nous donnons les uns aux autres et nous les archivons dans cette plateforme, ce qui permet à tous de revisionner d'anciennes formations ou encore de savoir ce qui s'est passé et dit si une réunion a été manquée."
                            }
                        ]
                    }
