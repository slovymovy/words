                        "examples": [
                            {
                                "example_id": "154537d4-a9d6-4fd0-ba9f-bbfed4e540f4",
                                "sense_id": "fd405a09-f405-3efb-bc06-0e8570c9ab27",
                                "text": "Les conducteurs utilisés doivent être choisis parmi les types dont le revêtement extérieur ne propage pas la flamme ou être posés sous conduit métallique blindé (rigide, cintrable ou souple)."
                            },
                            {
                                "example_id": "c0ae08c6-8ae2-4278-90c1-9fb53732b31c",
                                "sense_id": "fd405a09-f405-3efb-bc06-0e8570c9ab27",
                                "text": "On avait réussi la mise au point efficace d'une multiplication souple, peu pesante, peu encombrante d'abord, et, ensuite, avec le temps, flexible et aisément cintrable."
                            },
                            {
                                "example_id": "aca91477-9a7a-403f-a43e-c45724277b0d",
                                "sense_id": "fd405a09-f405-3efb-bc06-0e8570c9ab27",
                                "text": "La première concerne les gaines électriques. Il en existe deux modèles, qui sont appelés gaine ICTA (isolant cintrable transversalement annelé) et gaine GTL (gaine technique logement)."
                            }
                        ]
                    }
