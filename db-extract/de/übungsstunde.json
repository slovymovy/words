                        "examples": [
                            {
                                "example_id": "497aba13-20be-485d-83ac-d0ab48ca505f",
                                "sense_id": "989ce434-a543-3ca1-982e-4115e637856b",
                                "text": "„Allerdings lege ich manchmal, wenn ich an einem bestimmten Stück arbeite, später noch einmal eine Übungsstunde ein.“"
                            },
                            {
                                "example_id": "194458a9-f716-46a0-b783-20b6a3fa1213",
                                "sense_id": "989ce434-a543-3ca1-982e-4115e637856b",
                                "text": "„Wenige Übungsstunden bei Dieter genügten.“"
                            },
                            {
                                "example_id": "b7b0f9ca-46d9-475b-95ce-794eae4d2560",
                                "sense_id": "989ce434-a543-3ca1-982e-4115e637856b",
                                "text": "„Vermutlih war er von diesen verschiedenartigen Übungsstunden, aus denen der Alltag für die meisten hier zu bestehen schien, durch seine Eigenschaft als Beamter der Stadtpräfekur befreit.“"
                            }
                        ],
