                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volumineux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4ff89c4-9ad0-3c1f-8f82-f47d49c23cee",
                                        "entry_id": "96ecc2e8-653f-3f65-b503-c03d069906c7",
                                        "glosses": [
                                            "Qui est fort étendu en tous sens, qui occupe beaucoup de place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43e3481-6147-4504-9058-bc3b36d3d4f2",
                                                "sense_id": "a4ff89c4-9ad0-3c1f-8f82-f47d49c23cee",
                                                "text": "Trois mois après le malade pissa un calcul d’acide urique qu'on jugea le noyau d'une pierre plus volumineuse qui avait été usée et dissoute."
                                            },
                                            {
                                                "example_id": "236d39c8-d6ad-4188-9f36-ea474c3993e6",
                                                "sense_id": "a4ff89c4-9ad0-3c1f-8f82-f47d49c23cee",
                                                "text": "Nos dragages pratiqués suivant une technique un peu nouvelle avec de vieilles dragues réformées, nous permirent de rapporter de nombreux et très volumineux échantillons géologiques."
                                            },
                                            {
                                                "example_id": "6cb9c02b-345d-439e-9289-14508c8ba636",
                                                "sense_id": "a4ff89c4-9ad0-3c1f-8f82-f47d49c23cee",
                                                "text": "De volumineux autobus arrivent, chargés à craquer : leur toit est même garni de paysans hilares assis en rang, à la place des marchandises, comme sur une impériale."
                                            },
                                            {
                                                "example_id": "70c16968-7ee7-4bfd-b9fe-ecef784dc428",
                                                "sense_id": "a4ff89c4-9ad0-3c1f-8f82-f47d49c23cee",
                                                "text": "L’actinobacillose pharyngienne se traduit par des tumeurs plus ou moins volumineuses provoquant de la dysphagie et des difficultés respiratoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d25ff4aa-d5ab-39e9-adee-af912d7edee9",
                                        "entry_id": "96ecc2e8-653f-3f65-b503-c03d069906c7",
                                        "glosses": [
                                            "Qualifie un ouvrage de l’esprit, une collection qui contient un grand nombre de volumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99b53797-be0a-4059-beb1-52e9ba9f4514",
                                                "sense_id": "d25ff4aa-d5ab-39e9-adee-af912d7edee9",
                                                "text": "Un ouvrage volumineux."
                                            },
                                            {
                                                "example_id": "c694c036-06f7-4525-b5d6-50c45fa58c0a",
                                                "sense_id": "d25ff4aa-d5ab-39e9-adee-af912d7edee9",
                                                "text": "Une compilation volumineuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
