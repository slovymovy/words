                "senses": [
                    {
                        "sense_id": "ee6e8bfb-cfab-359f-8aa0-0a23ae13aebf",
                        "entry_id": "6d58ab2a-ffe5-37cf-8281-6202660b62ef",
                        "glosses": [
                            "A gully, gulch, or ravine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ff2e21-e2d1-4f21-8af6-512f2769aa08",
                                "sense_id": "ee6e8bfb-cfab-359f-8aa0-0a23ae13aebf",
                                "text": "We remounted at 3 p.m., and for three hours and a half we rode down a goat-track which resembled the depths of a barranco. It was the dry bed of a river, with rocks balanced upon each other […]"
                            },
                            {
                                "example_id": "bd43cd45-1542-4836-8011-dd5d3418fbd7",
                                "sense_id": "ee6e8bfb-cfab-359f-8aa0-0a23ae13aebf",
                                "text": "A little fire burned in the hollow of the dusty barranco, a clear red fire of the kind that gives little light and makes no smoke, and its pale glow showed but feebly against the rock behind."
                            }
                        ]
                    }
                ],
