                                        "entry_id": "d819c6aa-b29c-3889-b149-de9ca22f446d",
                                        "glosses": [
                                            "ein Staat, der nicht an einen Ozean beziehungsweise ein Meer grenzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad68d6ee-80f9-4ec3-8a6e-6ac3a135fa9a",
                                                "sense_id": "fc5d068e-23f0-31ff-8652-78d9a2ee00a7",
                                                "text": "Allen Binnenstaaten ist gemein, dass sie keinen freien Zugang zum Ozean haben."
                                            },
                                            {
                                                "example_id": "0fef7f57-9ec9-4792-8dce-c85deadadb93",
                                                "sense_id": "fc5d068e-23f0-31ff-8652-78d9a2ee00a7",
                                                "text": "Die Volksrepublik Laos ist mit ihren 6 Millionen Einwohnern der einzige Binnenstaat in ganz Südostasien."
                                            },
                                            {
                                                "example_id": "7016d4bc-c493-42b6-a715-223d608df707",
                                                "sense_id": "fc5d068e-23f0-31ff-8652-78d9a2ee00a7",
                                                "text": "Die etwa 3,5 Millionen Einwohner zählende Republik Moldau liegt als Binnenstaat zwischen der Ukraine und Rumänien."
                                            },
                                            {
                                                "example_id": "90704086-8d54-4b86-8083-0b3a1be662f8",
                                                "sense_id": "fc5d068e-23f0-31ff-8652-78d9a2ee00a7",
                                                "text": "Die Republik Mali erhielt 1960 ihre Unabhängigkeit. Der riesige Binnenstaat im Inneren Westafrikas zählt zu den ärmsten Ländern der Erde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
