{
    "word_family": [
        "omweggetje",
        "omweggetjes",
        "omwegen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7aa17676-cd5d-37a9-a90f-872a1e611f6d",
                    "sense_definition": "Een route die langer is dan de normale of kortste verbinding tussen twee plaatsen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "route",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Omdat de weg door een ongeluk was afgesloten, moest men een <w>omweg</w> maken om op de bestemming te komen.",
                            "target_lang_translations": {
                                "en": "Because the road was closed due to an accident, people had to take a <w>detour</w> to reach their destination."
                            }
                        },
                        {
                            "text": "We moesten een flinke <w>omweg</w> maken omdat de brug over de rivier kapot was.",
                            "target_lang_translations": {
                                "en": "We had to take a significant <w>detour</w> because the bridge over the river was broken."
                            }
                        }
                    ],
                    "synonyms": [
                        "detour",
                        "omloop"
                    ],
                    "antonyms": [
                        "afsteekweg",
                        "doorsteek"
                    ],
                    "common_phrases": [
                        "een omweg maken",
                        "flinke omweg"
                    ],
                    "target_lang_definitions": {
                        "en": "A route that is longer than the normal or shortest connection between two places."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detour",
                                "target_lang_sense_clarification": "a deviation from the direct route"
                            },
                            {
                                "target_lang_word": "roundabout way",
                                "target_lang_sense_clarification": "a path that is not direct"
                            },
                            {
                                "target_lang_word": "diversion",
                                "target_lang_sense_clarification": "a temporary route due to road closure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f85f87b9-ac03-3968-be38-d6bdecf68395",
                    "sense_definition": "Een weg die specifiek om een fysiek obstakel of hindernis heen gaat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "route",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soms moeten we een stuk teruglopen om een <w>omweg</w> te vinden rond de gevallen bomen.",
                            "target_lang_translations": {
                                "en": "Sometimes we have to walk back a bit to find a <w>way around</w> the fallen trees."
                            }
                        },
                        {
                            "text": "De wandelaars zochten een <w>omweg</w> om het overstroomde pad te vermijden.",
                            "target_lang_translations": {
                                "en": "The hikers looked for a <w>detour</w> to avoid the flooded path."
                            }
                        }
                    ],
                    "synonyms": [
                        "omloop"
                    ],
                    "common_phrases": [
                        "omweg vinden"
                    ],
                    "target_lang_definitions": {
                        "en": "A path specifically taken to go around a physical obstacle or hindrance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detour",
                                "target_lang_sense_clarification": "going around an obstacle"
                            },
                            {
                                "target_lang_word": "bypass",
                                "target_lang_sense_clarification": "a way to avoid a specific area or blockage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94d68bbc-97a4-3933-a7c7-db1f5e713875",
                    "sense_definition": "Het gebruik van onnodig veel woorden of een indirecte manier om iets duidelijk te maken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met veel <w>omwegen</w> trachtte de man zijn ingewikkelde plannen eindelijk duidelijk te maken.",
                            "target_lang_translations": {
                                "en": "With many <w>roundabout ways</w> of speaking, the man finally tried to make his complicated plans clear."
                            }
                        },
                        {
                            "text": "Zeg het nu maar gewoon direct zonder al die <w>omwegen</w>.",
                            "target_lang_translations": {
                                "en": "Just say it directly now without all that <w>beating around the bush</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhaal",
                        "omsingeling"
                    ],
                    "antonyms": [
                        "directheid"
                    ],
                    "common_phrases": [
                        "zonder omwegen",
                        "met veel omwegen"
                    ],
                    "target_lang_definitions": {
                        "en": "The use of unnecessarily many words or an indirect way to make something clear."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beating around the bush",
                                "target_lang_sense_clarification": "avoiding the main topic"
                            },
                            {
                                "target_lang_word": "indirectness",
                                "target_lang_sense_clarification": "not being straightforward in communication"
                            },
                            {
                                "target_lang_word": "circumlocution",
                                "target_lang_sense_clarification": "using many words where fewer would do"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}