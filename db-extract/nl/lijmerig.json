                        "source_sense_id": "ec9e5b43-3895-3afc-afaa-c9dbc3a261b5",
                        "source_sense_description": "op een onaangename manier eigenschappen van lijm hebbend",
                        "target_lang_word": "glutinous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glutinous",
