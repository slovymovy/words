                    },
                    {
                        "translation_id": "e5dc9a16-5951-47af-8405-940e028204aa",
                        "source_entry_id": "02b82bf3-3bd0-3bef-bd4e-09ee5a3be3ae",
                        "source_sense_id": "23293332-7f77-3798-9e93-b9a237b8ed97",
                        "target_lang_word": "Emmanuel",
