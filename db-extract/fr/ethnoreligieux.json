                        "examples": [
                            {
                                "example_id": "c3efd423-9a00-4ef8-b6c3-a14252df5456",
                                "sense_id": "cd25e43d-cc94-3bc7-9624-a3769be02763",
                                "text": "Trois années plus tôt, en 2001, ce sont plus de 1000 personnes qui ont été tuées dans des violences ethnoreligieuses."
                            },
                            {
                                "example_id": "898f4cb9-d38c-4ec9-bced-f71770e606b5",
                                "sense_id": "cd25e43d-cc94-3bc7-9624-a3769be02763",
                                "text": "En légitimant leur projet de séparation ethnoreligieuse et acceptant de facto les ravages laissés par le statu quo, le camp palestinien semble en effet bien signer ici un véritable acte de reddition."
                            }
                        ]
                    }
