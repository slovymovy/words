                    },
                    {
                        "form_id": "8d9547db-48f2-475e-962a-858a19b461bc",
                        "entry_id": "667d2f0c-cab0-3854-97da-30838f40d723",
                        "tags": [
                            "comparative"
                        ],
                        "form": "структури́рованнее"
                    },
                    {
                        "form_id": "ac6effee-7160-4f4b-88a0-5f8949cf174d",
                        "entry_id": "667d2f0c-cab0-3854-97da-30838f40d723",
                        "tags": [
                            "comparative"
                        ],
                        "form": "структури́рованней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "904f0624-733f-3844-acfe-30f9a7603d95",
                        "entry_id": "667d2f0c-cab0-3854-97da-30838f40d723",
                        "glosses": [
                            "книжн. имеющий чёткую структуру"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd5ce52f-a6fd-4c32-aa5f-d65a1078b7e1",
                                "sense_id": "904f0624-733f-3844-acfe-30f9a7603d95",
                                "text": "Это задачи, в которых анализируемые фразы относятся к весьма ограниченной и полностью структурированной предметной области."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96a49421-0b6b-492d-8d51-0ff16783b802",
                        "source_entry_id": "667d2f0c-cab0-3854-97da-30838f40d723",
                        "source_sense_id": "904f0624-733f-3844-acfe-30f9a7603d95",
                        "target_lang_word": "structured",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "structured",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07761a41-f2ec-358a-a948-741e02da1d30",
                                        "entry_id": "cf107ad9-690d-32d5-a774-ed87206be6cf",
                                        "glosses": [
                                            "Having structure; organized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1320c61d-f589-4f7a-b949-0be4bdb2a11f",
                                                "sense_id": "07761a41-f2ec-358a-a948-741e02da1d30",
                                                "text": "Over the centuries the movement of clans and tribes of people has provided the kind of crop that would emerge if a blind god had sprinkled seeds at random on a field - a vast array of diverse patterns, usually not even interlocking or decussated, but crossed and intersected by every kind of structured diversity."
                                            },
                                            {
                                                "example_id": "7a9050db-30ae-4569-941e-5a2e2854002d",
                                                "sense_id": "07761a41-f2ec-358a-a948-741e02da1d30",
                                                "text": "Dr. Jessie Voigts, a homeschooler and founder of Wandering Educators, a global community of educators sharing travel experiences, said it doesn’t matter if this time is structured or unstructured, so long as the kids get outside."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "structured",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a02b8ae6-8139-312a-8fcf-3e5483b97627",
                                        "entry_id": "73abfe84-2df2-35ed-8ca0-93939f0acb9c",
                                        "glosses": [
                                            "simple past and past participle of structure"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95947e7e-08a1-42a9-8302-abc29fa3af0d",
                                                "sense_id": "a02b8ae6-8139-312a-8fcf-3e5483b97627",
                                                "text": "He structured the loan with a twenty-year term."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
