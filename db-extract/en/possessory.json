                                                "sense_id": "dc3cc347-2f95-3727-8394-51f6ba384993",
                                                "text": "Nous avons même entendu un jeune stagiaire, qui a parlé trois heures… sur l’action en revendication au possessoire… Charmante question, pleine d’intérêt."
                                            },
                                            {
                                                "example_id": "4c37b092-634e-4946-8bc6-05ab092b0a3b",
                                                "sense_id": "dc3cc347-2f95-3727-8394-51f6ba384993",
                                                "text": "Contester le possessoire d’un bien."
                                            },
                                            {
                                                "example_id": "d17f0f4c-61f7-472e-a234-11edfdb47a1e",
                                                "sense_id": "dc3cc347-2f95-3727-8394-51f6ba384993",
                                                "text": "Plaider, juger le possessoire."
                                            },
                                            {
                                                "example_id": "231428e9-657d-481e-bc1d-e6d23a3f4c17",
                                                "sense_id": "dc3cc347-2f95-3727-8394-51f6ba384993",
                                                "text": "Se pourvoir au possessoire."
                                            },
                                            {
                                                "example_id": "36ad1540-99cd-4b41-b4fe-c8229aaa292c",
                                                "sense_id": "dc3cc347-2f95-3727-8394-51f6ba384993",
                                                "text": "Il a gagné au possessoire."
                                            },
                                            {
                                                "example_id": "2e94f6fa-983d-47c8-a310-16f1ee39df45",
                                                "sense_id": "dc3cc347-2f95-3727-8394-51f6ba384993",
                                                "text": "Il a gagné le possessoire, et il poursuit pour faire juger le pétitoire."
