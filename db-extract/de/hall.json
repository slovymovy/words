                ],
                "senses": [
                    {
                        "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                        "entry_id": "8e9c3551-1ae3-37b6-a2a1-0a5f759be166",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "083cbd9e-0e94-412a-93e4-8f4f0688ee56",
                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                "text": "Frau Hall ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d6ac41d3-9523-48b2-b84c-96e37239b928",
                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                "text": "Herr Hall wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6dd3971b-1a22-4673-bcbb-f4e9c304606a",
                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                "text": "Die Halls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e886bfec-e1d7-46de-8543-d16b450256ca",
                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                "text": "Der Hall trägt nie die Schals, die die Hall ihm strickt."
                            },
                            {
                                "example_id": "4642233c-57df-4850-bb09-b18401ba22ed",
                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hall kommt, geht der Herr Hall.“"
                            },
                            {
                                "example_id": "e289d5fb-9cec-44de-9ad4-6aa19972f4e2",
                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                "text": "Hall kommt und geht."
                            },
                            {
                                "example_id": "602e17be-5ca5-47d7-900f-7d4777457f0b",
                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                "text": "Halls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
