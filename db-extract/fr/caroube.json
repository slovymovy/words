            {
                "entry_id": "dcea6212-5a42-3339-a10d-ba8c840cd12e",
                "word": "caroube",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "64dfbcc0-0eae-4a30-acf7-28006351fd6e",
                        "entry_id": "dcea6212-5a42-3339-a10d-ba8c840cd12e",
                        "tags": [
                            "plural"
                        ],
                        "form": "caroubes"
