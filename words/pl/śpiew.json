    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae953da7-1dee-359d-ae62-6851173f8828",
                    "sense_definition": "Wydawanie z siebie melodyjnych dźwięków za pomocą głosu; sztuka wokalna.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej piękny <w>śpiew</w> zachwycił wszystkich zgromadzonych w sali koncertowej.",
                            "target_lang_translations": {
                                "ru": "Её прекрасное <w>пение</w> восхитило всех собравшихся в концертном зале.",
                                "en": "Her beautiful <w>singing</w> delighted everyone gathered in the concert hall."
                            }
                        },
                        {
                            "text": "Zapisałem się na profesjonalną naukę <w>śpiewu</w>, aby poprawić swój głos.",
                            "target_lang_translations": {
                                "ru": "Я записался на профессиональные уроки <w>пения</w>, чтобы улучшить свой голос.",
                                "en": "I signed up for professional <w>singing</w> lessons to improve my voice."
                            }
                        }
                    ],
                    "synonyms": [
                        "wokalistyka"
                    ],
                    "common_phrases": [
                        "nauka śpiewu",
                        "śpiew chóralny",
                        "lekcja śpiewu",
                        "czysty śpiew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавание мелодичных звуков голосом; вокальное искусство.",
                        "en": "Producing musical sounds with the voice; the vocal art."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пение",
                                "target_lang_sense_clarification": "процесс или искусство"
                            },
                            {
                                "target_lang_word": "вокал",
                                "target_lang_sense_clarification": "техника владения голосом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "singing",
                                "target_lang_sense_clarification": "the activity or art of using one's voice musically"
                            },
                            {
                                "target_lang_word": "vocals",
                                "target_lang_sense_clarification": "singing voice or vocal technique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49313835-0be7-3733-9ed7-934a20659490",
                    "sense_definition": "Melodyjne, przyjemne dla ucha dźwięki wydawane przez ptaki.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdego ranka budzi mnie głośny <w>śpiew</w> ptaków za oknem.",
                            "target_lang_translations": {
                                "ru": "Каждое утро меня будит громкое <w>пение</w> птиц за окном.",
                                "en": "Every morning I am woken up by the loud <w>singing</w> of birds outside the window."
                            }
                        },
                        {
                            "text": "Podczas spaceru po lesie słyszeliśmy wyraźny <w>śpiew</w> słowika.",
                            "target_lang_translations": {
                                "ru": "Во время прогулки по лесу мы слышали отчётливое <w>пение</w> соловья.",
                                "en": "During our walk in the woods, we heard the distinct <w>song</w> of a nightingale."
                            }
                        }
                    ],
                    "synonyms": [
                        "trele"
                    ],
                    "common_phrases": [
                        "śpiew ptaków",
                        "poranny śpiew",
                        "śpiew słowika"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелодичные, приятные на слух звуки, издаваемые птицами.",
                        "en": "Melodic, pleasant sounds made by birds."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пение",
                                "target_lang_sense_clarification": "звуки птиц"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "song",
                                "target_lang_sense_clarification": "musical sound made by birds"
                            },
                            {
                                "target_lang_word": "singing",
                                "target_lang_sense_clarification": "sounds made by birds"
                            },
                            {
                                "target_lang_word": "warble",
                                "target_lang_sense_clarification": "melodic bird trill"
                            }
                        ]
