        "de-extract.jsonl": [
            {
                "entry_id": "6de79fdc-1e28-346d-b7c2-7b90bd88fb59",
                "word": "Iceland",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d393c71e-39fb-3da7-b8db-afb19a677254",
                        "entry_id": "6de79fdc-1e28-346d-b7c2-7b90bd88fb59",
                        "glosses": [
                            "Island"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3746d3c-595b-460f-aefa-0936fbac01f5",
                        "source_entry_id": "6de79fdc-1e28-346d-b7c2-7b90bd88fb59",
                        "source_sense_id": "d393c71e-39fb-3da7-b8db-afb19a677254",
                        "source_sense_description": "Island",
                        "target_lang_word": "Island",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Island",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                        "entry_id": "ac1136f9-4ef8-3154-a26b-f8e3f9d10c74",
                                        "glosses": [
                                            "Inselstaat im Nordatlantik"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1441a1-4de8-4af1-8e76-98837dd619fe",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "Ich habe im Urlaub auf Island über 1000 Fotos geschossen."
                                            },
                                            {
                                                "example_id": "3baebdf9-5a37-4c5c-95dd-ea673fd25ecc",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Sie haben ganz richtig gelesen: In Island gibt es ein Phallusmuseum.“"
                                            },
                                            {
                                                "example_id": "a2c52e61-89b9-424a-80ce-b7995d9f53a8",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Island und Grönland haben eines gemeinsam: Beide waren Kolonien Dänemarks.“"
                                            },
                                            {
                                                "example_id": "4aab29af-2c2c-4f36-99a0-fce0ee2ed49b",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Roland hatte mir zugeflüstert, auf den Färöern wohnten jene, die die Wikingerschiffe wegen Seekrankheit verlassen mussten, als sie auf dem Weg nach Island waren.“"
                                            },
                                            {
                                                "example_id": "83f2226b-f5b3-4cc8-9acb-143d5c478402",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Bald kennen die Steuermänner die Strömungen und Gefahren auf der Fahrt zwischen Nordeuropa und Island besser, ist die Route weniger risikoreich als zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e23da702-2692-43bf-9a20-737a6a2e0e8e",
                        "source_entry_id": "6de79fdc-1e28-346d-b7c2-7b90bd88fb59",
                        "source_sense_id": "d393c71e-39fb-3da7-b8db-afb19a677254",
                        "source_sense_description": "Island",
                        "target_lang_word": "Islande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Islande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1eb87bee-fa4d-3a57-b29e-c436d280f903",
                                        "entry_id": "5df705fe-e315-395c-b9ac-9a08075090f8",
                                        "glosses": [
                                            "Grande île volcanique de l’Atlantique Nord, bordant l’océan Arctique au nord et située au sud-est du Groenland, au nord-nord-ouest de la Grande-Bretagne et au nord-ouest des îles Féroé."
                                        ],
                                        "tags": [
                                            "Moins courant",
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ebf683-e1cd-4e1d-95cc-ca67bf4c509d",
                                                "sense_id": "1eb87bee-fa4d-3a57-b29e-c436d280f903",
                                                "text": "La Terre de glace ! la Terre des geysers et des volcans ! On a deviné l’Islande, car quelle autre contrée offre le surprenant spectacle d’une lutte éternelle entre le feu et le froid?"
                                            },
                                            {
                                                "example_id": "9754d523-e1e7-4685-a8f9-49f4664ef032",
                                                "sense_id": "1eb87bee-fa4d-3a57-b29e-c436d280f903",
                                                "text": "– La réponse, dit-il, fait allusion à l’île où gronde l’Hékla. N’y a-t-il pas confusion avec l’Islande ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f61f39b5-81cc-3a91-b9aa-123a4e4cf8fd",
                                        "entry_id": "5df705fe-e315-395c-b9ac-9a08075090f8",
                                        "glosses": [
                                            "État dont le territoire occupe la totalité de cette île ainsi que les îlots environnants, et dont la capitale est Reykjavik."
                                        ],
                                        "tags": [
                                            "Plus courant",
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb7c246-9a9c-4897-8b85-b02588b2c08e",
                                                "sense_id": "f61f39b5-81cc-3a91-b9aa-123a4e4cf8fd",
                                                "text": "Depuis son départ de Rejkjavik en Islande, le 9 août, on en est sans nouvelles, et malgré ma grande confiance en lui, je suis fort inquiet."
                                            },
                                            {
                                                "example_id": "7219e4da-e0d3-4c7e-99b2-d6ed5ae26f5b",
                                                "sense_id": "f61f39b5-81cc-3a91-b9aa-123a4e4cf8fd",
                                                "text": "Cette semaine avait justement lieu en Islande le grand sommet annuel des pays arctiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4346682-6c77-4c20-8d17-388f4b250b9e",
                        "source_entry_id": "6de79fdc-1e28-346d-b7c2-7b90bd88fb59",
                        "source_sense_id": "d393c71e-39fb-3da7-b8db-afb19a677254",
