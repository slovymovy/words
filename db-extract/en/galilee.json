                        "target_lang_word": "Galilée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galilée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9464d088-4389-308d-8d96-472de17c61cf",
                                        "entry_id": "98826fb1-24a4-3a3d-ab40-b002db391aca",
                                        "glosses": [
                                            "Région de Palestine."
                                        ],
                                        "tags": [
                                            "Biblical",
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7317788-cbd3-4410-8bd6-c98ab955cd37",
                                                "sense_id": "9464d088-4389-308d-8d96-472de17c61cf",
                                                "text": "La charpente des montagnes de la Syrie est en général formée d’un calcaire dur, disposé par lits diversement inclinés. Cette pierre se reproduit dans toute l’étendue du territoire, d’Alep à Hama , dans la masse du Liban et de l’Anti-Liban , dans les montagnes de la Galilée et du Carmel jusqu’au lac Asphaltite."
                                            },
                                            {
                                                "example_id": "e27b53eb-9a9c-4e1e-b658-5062b6e7884e",
                                                "sense_id": "9464d088-4389-308d-8d96-472de17c61cf",
                                                "text": "Je me dis que bien avant notre naissance — pour parler le Langage humain — Notre-Seigneur nous a rencontrés quelque part , à Bethléem, à Nazareth, sur les routes de Galilée, que sais-je?"
                                            },
                                            {
                                                "example_id": "e1d1119f-17f4-4cd1-8e0e-8316aa34e799",
                                                "sense_id": "9464d088-4389-308d-8d96-472de17c61cf",
                                                "text": "André, Syméon et moi, nous parcourions la Galilée verte, fraîche, fruitée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Galilée",
                                "target_lang_code": "fr",
                                "target_senses": [
