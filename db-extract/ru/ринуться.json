                                    {
                                        "sense_id": "fbc7e9b9-7a74-34d5-aec7-e16678fd5ceb",
                                        "entry_id": "e0add927-3f89-36d0-ae4d-efcce39496a9",
                                        "glosses": [
                                            "Forme pronominale de ruer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded3b2ee-60b1-4d97-b110-94729c08e489",
                                                "sense_id": "fbc7e9b9-7a74-34d5-aec7-e16678fd5ceb",
                                                "text": "On se ruait au plaisir, comme si la fin du monde eût été proche, et pourtant nul n'avait le pressentiment des malheurs qui allaient fondre sur la France."
                                            }
                                        ]
                                    }
                                ]
