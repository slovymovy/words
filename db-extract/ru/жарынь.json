                "senses": [
                    {
                        "sense_id": "23936fc0-44f9-3790-9070-f1a9ab1a68b8",
                        "entry_id": "f4fcb43f-0e29-32a1-995d-0ff2dde58a64",
                        "glosses": [
                            "прост. (в некоторых источниках — разг.) то же, что жара; сильный жар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6118958-c048-4fec-a9ca-7cabee10252d",
                                "sense_id": "23936fc0-44f9-3790-9070-f1a9ab1a68b8",
                                "text": "— Берегла к бане, да ладно, ноне жарынь такая — кажный день баня."
                            },
                            {
                                "example_id": "1bf84c3a-f005-495a-a99a-7a3b8504d241",
                                "sense_id": "23936fc0-44f9-3790-9070-f1a9ab1a68b8",
                                "text": "Стояла такая жарынь, что даже по ночам, через толстые подошвы сапог, ноги чувствовали теплоту земли."
                            }
                        ]
                    }
