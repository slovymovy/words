                    {
                        "translation_id": "933a7de2-d680-419b-8ac4-bc8edfe1d05e",
                        "source_entry_id": "7c4e038f-6947-3276-8ac2-6713c673c6f4",
                        "source_sense_id": "7a910020-98a6-3187-b904-414c7f4b8b63",
                        "source_sense_description": "Qui a perdu l’équilibre.",
                        "target_lang_word": "unausgewogen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unausgewogen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baf714f2-0d8c-3daa-b370-494aa61e1968",
                                        "entry_id": "25c35c49-b609-3422-b872-ab017246fa86",
                                        "glosses": [
                                            "im Ungleichgewicht befindlich; an Ausgeglichenheit zwischen zwei oder mehr Dingen, Aspekten mangelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f2bcb4-fdc6-4e1e-aaf8-0ecf59a169a8",
                                                "sense_id": "baf714f2-0d8c-3daa-b370-494aa61e1968",
                                                "text": "„Übergewicht durch unausgewogene Ernährung und Bewegungsmangel sind die Hauptgründe für die Volkskrankheit Diabetes, auch für junge Menschen.“"
                                            },
                                            {
                                                "example_id": "481506f2-c795-4bac-8e55-b8c009d06de2",
                                                "sense_id": "baf714f2-0d8c-3daa-b370-494aa61e1968",
                                                "text": "„Zur Erklärung dieser unausgewogenen Topographie wurde früh die Möglichkeit eines oder mehrerer gewaltiger Asteroidentreffer erwogen.“"
                                            },
                                            {
                                                "example_id": "8a168712-06b3-4383-9df5-4f2b6dcbc1ab",
                                                "sense_id": "baf714f2-0d8c-3daa-b370-494aa61e1968",
                                                "text": "„Zwar gibt es auch in Indien ein unausgewogenes Verhältnis zwischen Männern und Frauen, aber nicht ganz so schlimm.“"
                                            },
                                            {
                                                "example_id": "e6ade3d1-8dca-4faa-a607-bb4d22815fbd",
                                                "sense_id": "baf714f2-0d8c-3daa-b370-494aa61e1968",
                                                "text": "„Der Rasen dürfte für eine größere Anzahl von Arten günstige Lebensbedingungen bieten, die Besiedlung erfolgt aber in einem unausgewogeneren Verhältnis von häufig zu selten gefangenen Arten als auf der Wiese.“"
                                            },
                                            {
                                                "example_id": "9debd079-762f-4198-a636-fe911c46bba2",
                                                "sense_id": "baf714f2-0d8c-3daa-b370-494aa61e1968",
                                                "text": "„Umgekehrt dürfte es selbst. 25 Am unausgewogensten ist die Geschlechterrelation im Landkreis Ücker-Randow: Dort kommen auf 100 Männer im Alter zwischen 18 und 29 Jahren nur 76,1 Frauen (Kröhnert/van Olst/Klingholz 2004: 7).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
