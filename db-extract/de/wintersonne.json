                ],
                "senses": [
                    {
                        "sense_id": "2c37b7bd-f72e-3e91-975b-19435f6ec5a6",
                        "entry_id": "d5221a92-aae2-3c07-942d-4373a8b4b6c0",
                        "glosses": [
                            "die Sonne in der Art, wie sie im Winter scheint"
                        ],
                        "tags": [
                            "Wetter"
                        ],
                        "examples": [
                            {
                                "example_id": "2e49eb66-96dd-418d-b89a-9e2c412b9abc",
                                "sense_id": "2c37b7bd-f72e-3e91-975b-19435f6ec5a6",
                                "text": "„Eine kalte Wintersonne schien durch zerbrochene Fensterscheiben auf die aufgerissenen Fundamente.“"
                            },
                            {
                                "example_id": "2cb6a9f7-d7cd-430f-982d-9262918e80e7",
                                "sense_id": "2c37b7bd-f72e-3e91-975b-19435f6ec5a6",
                                "text": "„Eine blasse Wintersonne brach durch die Wolken.“"
                            },
                            {
                                "example_id": "f5e39b1c-a074-4afd-ace8-72353565e170",
                                "sense_id": "2c37b7bd-f72e-3e91-975b-19435f6ec5a6",
                                "text": "„Die Wintersonne schien, kam aber kaum gegen den kalten Nordwind an.“"
                            },
                            {
                                "example_id": "a1e9a8a6-68af-4f84-a973-25a8d95089e0",
                                "sense_id": "2c37b7bd-f72e-3e91-975b-19435f6ec5a6",
                                "text": "„Ari wusste, dass er rangehen musste, doch er zögerte es einen Moment hinaus, blickte über den Fjord, der in der Wintersonne flimmerte, atmete tief ein und genoss die friedliche Stimmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
