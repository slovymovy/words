                        "examples": [
                            {
                                "example_id": "d9e8ea39-e3de-4faa-8d73-ee7d1d83631a",
                                "sense_id": "382f414f-2fc5-3ef8-bbdb-30805e081b4e",
                                "text": "„In Deutschland sind die Länder für die Lebensmittelkontrolle zuständig.“"
                            },
                            {
                                "example_id": "b5bcde02-1552-421f-9905-079cab1a4c03",
                                "sense_id": "382f414f-2fc5-3ef8-bbdb-30805e081b4e",
                                "text": "„Die Lebensmittelkontrolle legte außerdem offen, dass jeder dritte Kühltransport mit Fleisch oder Fisch nicht hinreichend kalt ist, um die Kühlkette der Lebensmittel aufrechtzuerhalten.“"
                            }
