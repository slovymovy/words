                "senses": [
                    {
                        "sense_id": "5c8115b5-6dde-32c6-beaf-18f325f61e22",
                        "entry_id": "1a0a18b1-68ee-3f76-a846-573105b206f8",
                        "glosses": [
                            "osoba zajmująca się złotnictwem; rzemieślnik artystyczny wyrabiający przedmioty z metali szlachetnych (m.in. złota, srebra, platyny, palladu)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf8ae5f-5df5-43a0-8aff-b6156fd4a450",
                                "sense_id": "5c8115b5-6dde-32c6-beaf-18f325f61e22",
                                "text": "Święty Eligiusz jest patronem złotników i jubilerów."
                            },
                            {
                                "example_id": "90dd334b-58c5-447b-8ab2-318a6a81b020",
                                "sense_id": "5c8115b5-6dde-32c6-beaf-18f325f61e22",
                                "text": "Cech Złotników z Lubeki ogłosił konkurs złotniczy, do udziału w którym zaproszeni są wszyscy twórcy biżuterii z krajów nadbałtyckich: Litwy, Łotwy, Estonii, Polski, Norwegii, Finlandii, Szwecji, Danii, Rosji (Kaliningrad i Petersburg) i Niemiec (Meklemburgii-Pomorza, Szlezwik-Holsztynu i Hamburga)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
