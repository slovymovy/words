                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dramatiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                        "entry_id": "c3c9b982-05b2-30f1-8b56-8e89705214b8",
                                        "glosses": [
                                            "Person, die Dramen verfasst"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6932778-260e-481e-90ef-d8b3613f9cb4",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "Manche Dramatiker haben nur Komödien verfasst."
                                            },
                                            {
                                                "example_id": "320b27ee-aa7d-4a4e-b950-69ee8a462fc5",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "„Ruth Albu ist zu diesem Zeitpunkt noch mit Heinrich Schnitzler, dem Sohn des großen Wiener Dramatikers, verheiratet.“"
                                            },
                                            {
                                                "example_id": "ead9a367-e791-489a-8409-9748be34e4d2",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "„Was der Geschichtsschreiber als ungelöstes Problem stehen lassen muss, stellt der Dramatiker in einer Form hin, die ebenfalls keine Auflösung suggeriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e30dfa6-5cac-4714-8f82-aae912067f5b",
                        "source_entry_id": "74f8ebca-7b46-3080-8919-f43fb9f23451",
                        "source_sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
                        "target_lang_word": "Schauspieldichter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "09ac16a4-9ce3-49c8-b16a-53c86ca8cec7",
                        "source_entry_id": "74f8ebca-7b46-3080-8919-f43fb9f23451",
                        "source_sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
                        "target_lang_word": "Bühnenautor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bühnenautor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e159e122-bb65-3c24-909f-727909ffa67f",
                                        "entry_id": "2a674e98-faff-307a-9771-64b4411d9529",
                                        "glosses": [
                                            "Schriftsteller, der Stücke für das Theater verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a479febd-755d-4f70-ba90-b6a57264f816",
                                                "sense_id": "e159e122-bb65-3c24-909f-727909ffa67f",
                                                "text": "„Am 20. Januar 1772 wurde de Sades erstes Schauspiel hier aufgeführt, und wenn es auch noch geraume Zeit dauern sollte, bevor die Comédie-Française ein Stück von ihm herausbrachte, hielt er sich seit 1772 für einen großen Bühnenautor und hat sich auch die erdenklichste Mühe gegeben, als solcher Anerkennung bei seinen Zeitgenossen zu finden.“"
                                            },
                                            {
                                                "example_id": "51d98ffd-7a37-4bab-a92e-353325786ad2",
                                                "sense_id": "e159e122-bb65-3c24-909f-727909ffa67f",
                                                "text": "„Denn abgesehen von einer Handvoll Unterschriften haben wir an substanziellen Urschriften Shakespeares lediglich drei verschmierte Seiten eines Theaterstücks, das er gemeinsam mit fünf weiteren Bühnenautoren verfasst hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
