                    "sense_id": "fee6b5f5-48dc-3ffa-8d29-77c275ba82e5",
                    "sense_definition": "cecha tego, co dzieje się niespodziewanie, gwałtownie i w krótkim czasie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nagłość_czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zaskoczyła nas całkowita <w>nagłość</w> tej gwałtownej letniej burzy.",
                            "target_lang_translations": {
                                "ru": "Нас поразила полная <w>внезапность</w> этой сильной летней грозы."
                            }
                        },
                        {
                            "text": "Szybka reakcja kierowcy zapobiegła wypadkowi mimo dużej <w>nagłości</w> całego zdarzenia.",
                            "target_lang_translations": {
                                "ru": "Быстрая реакция водителя предотвратила аварию, несмотря на крайнюю <w>внезапность</w> происшествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "gwałtowność",
                        "raptowność"
                    ],
                    "antonyms": [
                        "stopniowość"
                    ],
                    "common_phrases": [
                        "nagłość zdarzenia",
                        "nagłość sytuacji"
                    ],
                    "target_lang_definitions": {
