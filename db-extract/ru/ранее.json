                                                "sense_id": "c70f15ba-98b2-3fbc-bfa5-dea9b44f35d5",
                                                "text": "Früher war alles besser."
                                            },
                                            {
                                                "example_id": "50d22c92-23e3-4de4-bc4c-1ae30e39462b",
