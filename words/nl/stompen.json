                            {
                                "target_lang_word": "souches",
                                "target_lang_sense_clarification": "d'arbres coupés"
                            },
                            {
                                "target_lang_word": "moignons",
                                "target_lang_sense_clarification": "de membres coupés ou amputés"
                            },
                            {
                                "target_lang_word": "trognons",
                                "target_lang_sense_clarification": "bouts restants, restes"
                            }
                        ]
                    }
                }
