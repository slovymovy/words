                "forms": [
                    {
                        "form_id": "7c25de07-593c-4b2e-b640-583d5c602d85",
                        "entry_id": "eac76272-d444-3144-8e1b-d2f7e69e09eb",
                        "tags": [
                            "plural"
                        ],
                        "form": "ariettes"
