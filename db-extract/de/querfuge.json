                "senses": [
                    {
                        "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                        "entry_id": "e26563be-1e92-377e-8ef4-541e1af09b3a",
                        "glosses": [
                            "in Querrichtung verlaufender Zwischenraum, Lücke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9781755b-4f40-4fa3-9490-0dcc1d08eff9",
                                "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                                "text": "„Die Reifen des Jaguars ratterten über die Querfugen im Beton, als hätte er eine harte, aber ordentliche Landung hingelegt.“"
                            },
                            {
                                "example_id": "714ef66a-b371-48e2-8b4f-ba720b8e8771",
                                "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                                "text": "„Die Blöcke selbst sind wie üblich untereinander weder verdübelt noch verklammert, die Längs- und Querfugen mit Mörtel ausgefüllt.“"
                            },
                            {
                                "example_id": "44a69306-2997-4635-94ba-1ae907fd94c9",
                                "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                                "text": "„Jede Straßenunebenheit, jede Querfuge auf der Autobahn hätte mich fast zum Aufschreien gebracht (aber ich bin ‚Indianer‘ und habe mich zusammengerissen).“"
                            },
                            {
                                "example_id": "a605aabc-3636-47e8-9e15-9a07faa90563",
                                "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                                "text": "„Die Querkraftübertragung erfolgt im Wesentlichen in den Querfugen mittels Einlage von Dübeln.“"
                            },
                            {
                                "example_id": "2e7962d9-d484-4ca5-8e24-5c9844fd698f",
                                "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                                "text": "„Querfugen von Gipskartonplatten sind nach DIN 18181 zu verspachteln; dies gilt sinngemäß auch für dicht gestoßene Holzwolle-Leichtbauplatten.“"
                            },
                            {
                                "example_id": "ecd6d395-e6e0-4f7a-8153-e6894abdc784",
                                "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                                "text": "„Die Querfugen zwischen den Elementen brauchen nur etwa 2 bis 3 cm breit zu sein.“"
                            },
                            {
                                "example_id": "74f0e98f-fbe9-4cb9-b835-a6408f256019",
                                "sense_id": "df0f8a1b-14cf-37b8-ac0c-1b3e8d57f2bd",
                                "text": "„Große Abstände zwischen den Querfugen bewirken in der Schwingungsanregung der Fahrzeugreifen tiefere Grundfrequenzen (Bild 2).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
