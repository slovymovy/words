                        "examples": [
                            {
                                "example_id": "1bbec62b-ce22-407d-97c1-050db23c6160",
                                "sense_id": "d583a487-8919-33ad-bdae-68f506a0d87f",
                                "text": "'Het is niet waar. Wij willen niet betrokken worden bij het omvergooien van regimes - door goedkeuring van acties via de VN-Veiligheidsraad noch door mee te doen aan welke politieke samenzwering dan ook', aldus Lavrov."
                            },
                            {
                                "example_id": "adb26cbe-4805-4c19-8085-6c846a5ab61f",
                                "sense_id": "d583a487-8919-33ad-bdae-68f506a0d87f",
                                "text": "De inmiddels opgedoekte radicale islamitische groepering Sharia4Belgium indoctrineerde en hersenspoelde jongeren, met maar één doel: het omvergooien van de democratie en het oprichten van een islamitische staat."
                            }
                        ]
