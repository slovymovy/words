                            },
                            {
                                "target_lang_word": "намек",
                                "target_lang_sense_clarification": "косвенное указание на что-либо"
                            },
                            {
                                "target_lang_word": "недосказанность",
                                "target_lang_sense_clarification": "создание образа через отсутствие деталей"
