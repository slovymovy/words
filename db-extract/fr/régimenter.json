                "senses": [
                    {
                        "sense_id": "8b975883-3387-3a90-b8da-de01c3da5298",
                        "entry_id": "2deb50eb-a17c-34e9-b905-50a69c5d240c",
                        "glosses": [
                            "Réglementer comme dans un régiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8118e0ec-9416-43e3-a036-d29c71c33f78",
                                "sense_id": "8b975883-3387-3a90-b8da-de01c3da5298",
                                "text": "Ce n’est que par un détour que l’autre versant de la pensée moderne (la pensée du négatif des Marx, Freud, Nietzsche) a posé la question de l’origine en tant que telle et a cherché à se l’approprier, à la régler, à la régimenter."
                            },
                            {
                                "example_id": "9c460b5b-b3f9-46b2-af1a-bb708abbd1ff",
                                "sense_id": "8b975883-3387-3a90-b8da-de01c3da5298",
                                "text": "Il va régimenter tout ce monde et faire rimer, comme on ne l’apprend pas à Polytechnique, idéologie, passions et intérêts divergents avec la nouvelle arithmétique présidentielle."
                            }
                        ]
                    }
                ],
