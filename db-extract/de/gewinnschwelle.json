                ],
                "senses": [
                    {
                        "sense_id": "150aa225-0e3f-3e7b-b136-e5f58e273216",
                        "entry_id": "b1f01e71-f290-36cc-8c12-e9a84d76a246",
                        "glosses": [
                            "die Stückzahl, bei der die Kosten zur Herstellung und der Erlös aus dem Verkauf eines Produktes gleich sind, so dass weder ein Gewinn noch ein Verlust erwirtschaftet wird"
                        ],
                        "tags": [
                            "Betriebswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "343a712b-4f2e-46a5-bf67-23e516d07d15",
                                "sense_id": "150aa225-0e3f-3e7b-b136-e5f58e273216",
                                "text": "Ein Produkt mit fixen Kosten von 500,-€ sowie variablen Kosten von 10,-€ und einem Verkaufserlös von 20,-€ pro Stück erreicht seine Gewinnschwelle bei einer Absatzmenge von 50 Stück."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0735d61-80f5-3d13-a24b-0d2b991483dc",
                        "entry_id": "b1f01e71-f290-36cc-8c12-e9a84d76a246",
                        "glosses": [
                            "diejenige der beiden Nullstellen der Gewinnfunktion bzw. der beiden Schnittpunkte der Kosten- mit der Erlösfunktion, nach deren Erreichen Gewinn erzielt wird"
                        ],
                        "tags": [
                            "Wirtschaftsmathematik"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb46fa5-76b2-432b-91be-5f05f1c9b666",
                                "sense_id": "a0735d61-80f5-3d13-a24b-0d2b991483dc",
                                "text": "Nach dem Erreichen seiner Gewinnschwelle erzielt ein Produkt Gewinne, nach dem Erreichen der Gewinngrenze Verluste."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1bea5eb1-9456-36a2-84be-4d8a894cdf29",
                        "entry_id": "b1f01e71-f290-36cc-8c12-e9a84d76a246",
                        "glosses": [
                            "der Zeitpunkt, ab dem ein Unternehmen oder wirtschaftliches Projekt seine Gewinnzone erreicht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0b69220c-cef9-4567-99c8-279fe541af1a",
                                "sense_id": "1bea5eb1-9456-36a2-84be-4d8a894cdf29",
                                "text": "Bei der derzeitigen Wirtschaftslage wird das neue Unternehmen wohl frühestens in zwei Jahren seine Gewinnschwelle überschreiten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f29eb58-02db-4be5-9170-fd6b576d1a3f",
                        "source_entry_id": "b1f01e71-f290-36cc-8c12-e9a84d76a246",
