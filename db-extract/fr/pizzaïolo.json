                                "target_senses": [
                                    {
                                        "sense_id": "82992e16-f95a-3cd1-b44e-b0f43d9f27be",
                                        "entry_id": "27b22c22-ecbd-374f-a8fe-c76c59842393",
                                        "glosses": [
                                            "A person who makes pizzas in a pizzeria; a pizzamaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed09815-2fae-4584-ad39-b88071eee328",
                                                "sense_id": "82992e16-f95a-3cd1-b44e-b0f43d9f27be",
                                                "text": "The wood-burning ovens and rock-star pizzaioli that seemed exotic not long ago are becoming familiar."
                                            },
                                            {
                                                "example_id": "9b176acf-3894-4c9b-8619-895f7b7b508e",
                                                "sense_id": "82992e16-f95a-3cd1-b44e-b0f43d9f27be",
                                                "text": "Mr. Arena routinely travels to pizzerias, and also responds to questions from pizzaiolos from around the world, including Brazil and China. […] Evel Pie, where Mr. Rotolo was once the head pizzaiolo, has a punk-rock-meets-Evel-Knievel aesthetic, replete with a Knievel-themed pinball machine, ’70s-era bunting and music, and the words “Live Hard, Ride Fast, Eat Pizza” in lights above the bar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7156f24a-3f95-4e06-b84c-0d4c874a218e",
                        "source_entry_id": "02e666ff-1934-3008-9ae6-bd326c2d0762",
                        "target_lang_word": "pizzamaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pizzamaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d29b62b-ad87-3f76-8ecc-1da8cadd02e8",
                                        "entry_id": "3cea31c6-dca2-35ba-bc02-bb123397ed75",
                                        "glosses": [
                                            "One who makes pizza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af31e369-42df-4bcc-8ddc-ef675e4fea0e",
                                                "sense_id": "6d29b62b-ad87-3f76-8ecc-1da8cadd02e8",
                                                "text": "Pizzaiolos can be fussy, and Jim McGown, a real estate developer and self-taught pizzamaker, is no different."
                                            },
                                            {
                                                "example_id": "e2a6776a-a5ac-490c-8c2c-75a2877f37a9",
                                                "sense_id": "6d29b62b-ad87-3f76-8ecc-1da8cadd02e8",
                                                "text": "Popping open a stack of dough proofing containers in their walk-in refrigerator, Mr. Federighi revealed an overlapping stack of pizza skins — what pizzamakers call dough that’s been stretched but not yet topped — that were dry to the touch, with the texture of cured leather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
