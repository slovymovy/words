                                    {
                                        "sense_id": "2348f672-855c-306a-a86e-282ef17abe09",
                                        "entry_id": "444cc874-b064-3bec-89ee-2dfcbebfe8aa",
                                        "glosses": [
                                            "Of, pertaining to, or deriving from illocution, the performance of acts by speaking."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f67a6474-bf61-4183-961a-9c16d85b955f",
                                                "sense_id": "2348f672-855c-306a-a86e-282ef17abe09",
                                                "text": "\"I pronounce you man and wife\" is a descriptive statement, but also has illocutionary force."
                                            },
                                            {
                                                "example_id": "affe53a5-95b3-4ae2-9f56-fb2a8dc23379",
                                                "sense_id": "2348f672-855c-306a-a86e-282ef17abe09",
                                                "text": "Derridean \"messianicity without messianism\" that marks so much of post-modernist educational theorizing today, and that makes use of esotericism, sigetics, acroamatics, proleptics, and illocutionary and perlocutionary acts in the disguise of a new pedagogy of the unknowable, wasn't the answer ten years ago."
                                            }
                                        ]
                                    }
                                ]
                            }
