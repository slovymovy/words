                        "source_sense_id": "2b33ba4b-d388-38b0-8553-6a2fbcdd1537",
                        "source_sense_description": "Betrag, um den die errechnete Steuer vermindert wird",
                        "target_lang_word": "tax credit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tax credit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cac2fdf-60eb-3f1d-a780-f1d8f2363ec7",
                                        "entry_id": "0725c6fd-9c78-34ef-b795-af068eeb9f70",
                                        "glosses": [
                                            "A tax incentive which allows certain taxpayers to subtract the amount of the credit they have accrued from the total they owe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590a0ebd-610c-490d-a5f3-e6081793fed7",
                                                "sense_id": "5cac2fdf-60eb-3f1d-a780-f1d8f2363ec7",
                                                "text": "A tax credit—it just doesn’t feel like a benefit in the same way that getting your Social Security check does. It doesn’t register with people in the same way, and that has a real impact on support for the program."
                                            },
                                            {
                                                "example_id": "cf888d06-02e7-40a3-9ad9-9eedda0a48c9",
                                                "sense_id": "5cac2fdf-60eb-3f1d-a780-f1d8f2363ec7",
                                                "text": "The bill extends Trump’s 2017 tax cuts and includes new spending for border security and the military. Republicans aimed to offset these costs with cuts to programmmes^([sic]) such as Medicaid, food stamps and green-energy tax credits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
