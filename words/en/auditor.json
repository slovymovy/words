{
    "word_family": [
        "audit",
        "audition",
        "auditory",
        "auditorship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf34d04d-f8e9-3b86-a33d-432fbe86ed96",
                    "sense_definition": "A person who examines and verifies the accuracy of financial records and bookkeeping accounts.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired an external <w>auditor</w> to review their annual financial statements.",
                            "target_lang_translations": {
                                "ru": "Компания наняла внешнего <w>аудитора</w> для проверки своей годовой финансовой отчетности."
                            }
                        },
                        {
                            "text": "A certified <w>auditor</w> must sign off on the report before it is submitted to the board.",
                            "target_lang_translations": {
                                "ru": "Сертифицированный <w>аудитор</w> должен утвердить отчет перед его представлением совету директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "accountant",
                        "examiner"
                    ],
                    "common_phrases": [
                        "external auditor",
                        "certified auditor",
                        "independent auditor",
                        "tax auditor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "professional title"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, проверяющее и подтверждающее точность финансовых отчетов и бухгалтерских счетов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аудитор",
                                "target_lang_sense_clarification": "специалист по финансовой проверке"
                            },
                            {
                                "target_lang_word": "ревизор",
                                "target_lang_sense_clarification": "лицо, осуществляющее проверку деятельности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2c56729-8ff7-3d6e-84b7-238dea63c2e5",
                    "sense_definition": "A public official, either elected or appointed, who is responsible for overseeing public accounts and government spending.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "government",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The state <w>auditor</w> released a report detailing the misuse of public funds.",
                            "target_lang_translations": {
                                "ru": "Государственный <w>аудитор</w> опубликовал отчет, в котором подробно описывается нецелевое использование государственных средств."
                            }
                        },
                        {
                            "text": "As a public <w>auditor</w>, her job is to ensure transparency in how taxes are spent.",
                            "target_lang_translations": {
                                "ru": "Как общественный <w>аудитор</w>, ее работа заключается в обеспечении прозрачности расходования налогов."
                            }
                        }
                    ],
                    "synonyms": [
                        "comptroller",
                        "controller"
                    ],
                    "common_phrases": [
                        "state auditor",
                        "public auditor",
                        "county auditor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственный чиновник, ответственный за надзор за государственными счетами и расходами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "государственный аудитор",
                                "target_lang_sense_clarification": "в сфере госфинансов"
                            },
                            {
                                "target_lang_word": "контролёр",
                                "target_lang_sense_clarification": "лицо, осуществляющее надзор"
                            },
                            {
                                "target_lang_word": "инспектор",
                                "target_lang_sense_clarification": "должностное лицо по надзору"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "828b2cee-e927-35e9-8bef-6ee6176d3a80",
                    "sense_definition": "A student who attends a university course to listen and learn but does not receive a grade or academic credit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to join the philosophy class as an <w>auditor</w> because he was interested in the topic but didn't need the credits.",
                            "target_lang_translations": {
                                "ru": "Он решил посещать занятия по философии в качестве <w>вольнослушателя</w>, так как интересовался темой, но ему не нужны были зачетные единицы."
                            }
                        },
                        {
                            "text": "The professor welcomed every course <w>auditor</w> to participate in the group discussions.",
                            "target_lang_translations": {
                                "ru": "Профессор пригласил каждого <w>вольнослушателя</w> курса принять участие в групповых дискуссиях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "course auditor",
                        "registered auditor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Студент, посещающий университетский курс для получения знаний, но не получающий оценку или академические баллы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вольнослушатель",
                                "target_lang_sense_clarification": "студент без зачисления в штат"
                            },
                            {
                                "target_lang_word": "аудитор",
                                "target_lang_sense_clarification": "в контексте посещения лекций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "893a38b2-a047-349c-9b91-22ff5b4ab859",
                    "sense_definition": "A person who listens to something, such as a speech or a performance; a member of an audience.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "listening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker addressed his <w>auditors</w> with great passion and clarity.",
                            "target_lang_translations": {
                                "ru": "Оратор обратился к своим <w>слушателям</w> с большой страстью и ясностью."
                            }
                        },
                        {
                            "text": "They were the involuntary <w>auditors</w> of a private conversation happening in the next room.",
                            "target_lang_translations": {
                                "ru": "Они стали невольными <w>слушателями</w> частного разговора, происходившего в соседней комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "listener",
                        "hearer"
                    ],
                    "common_phrases": [
                        "involuntary auditor",
                        "silent auditor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который слушает что-либо, например, речь или выступление; слушатель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушатель",
                                "target_lang_sense_clarification": "тот, кто воспринимает на слух"
                            },
                            {
                                "target_lang_word": "аудитор",
                                "target_lang_sense_clarification": "лингвистический термин или книжный стиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7191255f-270b-3438-b69a-90b4ceeacc5b",
                    "sense_definition": "A person trained to perform specific spiritual guidance or counseling procedures, particularly within Scientology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>auditor</w> guided the individual through a series of questions during the session.",
                            "target_lang_translations": {
                                "ru": "<w>Одитор</w> вел человека через серию вопросов во время сессии."
                            }
                        },
                        {
                            "text": "Becoming a trained <w>auditor</w> requires years of study and practice within the organization.",
                            "target_lang_translations": {
                                "ru": "Чтобы стать обученным <w>одитором</w>, требуются годы учебы и практики внутри организации."
                            }
                        }
                    ],
                    "synonyms": [
                        "counselor"
                    ],
                    "common_phrases": [
                        "trained auditor",
                        "spiritual auditor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specific religious context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обученный проводить специальные процедуры духовного руководства или консультирования, в частности в саентологии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одитор",
                                "target_lang_sense_clarification": "специфический термин в саентологии"
                            },
                            {
                                "target_lang_word": "аудитор",
                                "target_lang_sense_clarification": "религиозный консультант"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}