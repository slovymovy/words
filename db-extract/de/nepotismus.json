                        ],
                        "form": "der Nepotismus"
                    },
                    {
                        "form_id": "65ae74b3-a1ff-4922-8fec-4d6203e07bdd",
                        "entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Nepotismus"
                    },
                    {
                        "form_id": "a59a3a4b-7aed-4673-95da-d60611c2305f",
                        "entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Nepotismus"
                    },
                    {
                        "form_id": "0a60ba86-6024-423d-a036-7deaa6d721bf",
                        "entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Nepotismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                        "entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "glosses": [
                            "Vetternwirtschaft, ungerechtfertigte Begünstigung von Verwandten (z. B. bei Stellenbesetzungen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94343582-12a6-4c46-8a6d-43884e37c585",
                                "sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                                "text": "Luther gefiel der Nepotismus, den der Staat betrieb, nicht."
                            },
                            {
                                "example_id": "512e2670-83f5-4fcc-87db-b657fad1d7cd",
                                "sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                                "text": "„Wie gesagt waren damals Simonie (nach dem aus der Apostelgeschichte bekannten Magier Simon benannte Sünde des „geistlichen Wuchers“, Kauf und Verkauf von geistlichen Gütern und Stellen für Geld oder Geldeswert) und Nepotismus (Verwandtenbegünstigung) verbreitete Erscheinungen.“"
                            },
                            {
                                "example_id": "6c15b46d-5334-4969-a2af-bb222278c37e",
                                "sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                                "text": "„Der Schluss, der in dem Artikel aus der Kaufsumme gezogen wurde, lautete, derart grober Nepotismus sei eine Bedrohung für die Demokratie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42e1bcdf-c389-4b50-ac9b-69884d92de06",
                        "source_entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "source_sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                        "target_lang_word": "nepotism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nepotism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1cfba0f-2c4e-387d-92e9-ddf36d21d401",
                                        "entry_id": "930f1f97-dfea-3d1d-a8d9-1afba38ba028",
                                        "glosses": [
                                            "The favoring of relatives (most strictly) or also personal friends (more broadly) because of their relationship rather than because of their abilities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e094eec8-c7f5-469a-a1e3-ead8b9017385",
                                                "sense_id": "a1cfba0f-2c4e-387d-92e9-ddf36d21d401",
                                                "text": "Nepotism can get you very far in the world if you've got the right connections."
                                            },
                                            {
                                                "example_id": "120bc3b3-847c-4ef3-b8f9-a56f779ddc95",
                                                "sense_id": "a1cfba0f-2c4e-387d-92e9-ddf36d21d401",
                                                "text": "Now retailers even demand deslotting or failure fees, a penalty for trial products that fail to meet their sales objectives. The struggle over display space heavily favors the incumbents and encourages what might be called brand nepotism."
                                            },
                                            {
                                                "example_id": "db72ffa2-7704-447a-a943-add4d2b6c037",
                                                "sense_id": "a1cfba0f-2c4e-387d-92e9-ddf36d21d401",
                                                "text": "Mr Chen - a member of the national politburo as well as the Shanghai boss - is accused of nepotism and corruption on a grand scale: protecting political allies, granting preferment to his family and looting Shanghai's pension fund."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1477fec4-b7f7-48a7-83a6-53a49961d2cf",
                        "source_entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "source_sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                        "target_lang_word": "népotisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "népotisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb42033-6c1a-336a-baf6-4ff1f74de617",
                                        "entry_id": "09eee45b-f940-3e3f-8a7d-3c90c86066e9",
                                        "glosses": [
                                            "Autorité, faveur dont ont joui, auprès de certains papes, leurs neveux, leurs parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38494fb7-2c02-47d8-ad54-5ff02ad4b30e",
                                                "sense_id": "fcb42033-6c1a-336a-baf6-4ff1f74de617",
                                                "text": "Le cas bien connu du népotisme pourrait sembler infirmer ceci – mais bien au contraire, le fait même que la faveur passe d’oncle à neveu (nepos en latin) signale la marginalisation de la filiation, et le fait que le terme soit toujours utilisé de façon négative, pour parler d’un excès et d’un abus, montre à quel point c’est l’absence de népotisme qui est devenue normale (c’est-à-dire la norme). Bref, l’existence même du népotisme est l’exception qui confirme la règle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8c695a5-f3f5-3cb6-a24a-8b871b6051b8",
                                        "entry_id": "09eee45b-f940-3e3f-8a7d-3c90c86066e9",
                                        "glosses": [
                                            "Favoritisme envers un parent, un protégé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5f5ed6-cc10-4165-a0f6-684f8830ba8d",
                                                "sense_id": "d8c695a5-f3f5-3cb6-a24a-8b871b6051b8",
                                                "text": "Obstinément derrière ses petites magouilles, ses trafics d’influence et ses putains. Il avait compris qu’au sultanat des truands et du népotisme, un miracle, ça se négocie."
                                            },
                                            {
                                                "example_id": "82821e3e-9388-4629-9253-39c057577c26",
                                                "sense_id": "d8c695a5-f3f5-3cb6-a24a-8b871b6051b8",
                                                "text": "Qu'ils [les ministres] aient placé quelques amis, quelques créatures, des électeurs influents, je le veux bien ; le reste est de la calomnie pure. On a fait, il y a quelques années, du népotisme en grand ; aujourd'hui on ne l'oserait plus."
                                            },
                                            {
                                                "example_id": "4f56a5e5-1a46-4f50-b1ff-5c3186c15002",
                                                "sense_id": "d8c695a5-f3f5-3cb6-a24a-8b871b6051b8",
                                                "text": "Le népotisme se développe, encouragé par Brejnev lui-même, qui pratique le don et le contre-don (...)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70bc0c8c-6b3a-4692-880c-5d83732082cd",
                        "source_entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "source_sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                        "target_lang_word": "favoritisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favoritisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9df8baa7-f9fb-3351-ab8a-74a10b5863c9",
                                        "entry_id": "5d44f20c-713d-3477-8c16-e306c114d7ec",
                                        "glosses": [
                                            "Tendance habituelle d’un supérieur ou d’un gouvernement à accorder des faveurs injustes ou illégales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2bda4a-e817-4584-ae9b-ed2ae409d111",
                                                "sense_id": "9df8baa7-f9fb-3351-ab8a-74a10b5863c9",
                                                "text": "On lui offre un poste de conseiller de préfecture, qu’il accepte, et sa nomination, quand elle paraît à L’Officiel, fait crier les libéraux au favoritisme."
                                            },
                                            {
                                                "example_id": "14545014-efe6-4fe2-8071-b548f3089170",
                                                "sense_id": "9df8baa7-f9fb-3351-ab8a-74a10b5863c9",
                                                "text": "À l’article L. 131-20 (ancien L. 313-6), est ajoutée l’incrimination de l’avantage injustifié à soi-même, en plus de celle de l’avantage injustifié à autrui, ainsi que celle du favoritisme non intentionnel dans le cadre de l’accès à la commande publique."
                                            },
                                            {
                                                "example_id": "4e00c95e-c371-4762-8f25-f977a4ba2bf9",
                                                "sense_id": "9df8baa7-f9fb-3351-ab8a-74a10b5863c9",
                                                "text": "Après l’ex-patron de France Télés Patrick de Carolis, condamné en janvier pour favoritisme, le pédégé de Radio France, Mathieu Gallet, est à son tour renvoyé devant le tribunal correctionnel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8870ca93-73b1-4113-bb7c-65236687071a",
                        "source_entry_id": "ed222c4f-9fa8-382f-bb56-1a1223f06ae4",
                        "source_sense_id": "4ef809a2-b416-3cc7-8542-68a1eb592fbd",
                        "target_lang_word": "copinage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copinage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39737f4d-bbb5-3e11-bd3f-a0fbe371ca02",
                                        "entry_id": "e83a4512-50a3-3c47-b012-496b7f6c496c",
                                        "glosses": [
                                            "Complicité, fait d’être copains."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "184d7184-48bb-4642-8991-fc93b8e4e67a",
                                                "sense_id": "39737f4d-bbb5-3e11-bd3f-a0fbe371ca02",
                                                "text": "Lors de vos achat, vous serez reçue dans une charmante ambiance et vous bénéficierez d'un accueil des plus chaleureux. Vous vous sentirez comme chez vous, entourée de vos amies. Cette atmosphère de copinage, Nathalie et Joanna l’ont mise en place pour vous, pour que votre passage soit un plaisir et un moment d’évasion, que vous veniez seule ou accompagnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c168f0e-cd76-3dc1-acf5-0b58e6dba7a0",
                                        "entry_id": "e83a4512-50a3-3c47-b012-496b7f6c496c",
                                        "glosses": [
                                            "Pratique qui consiste à procurer des avantages ou des positions à ses amis ou à en obtenir d'eux."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1582ed6b-3509-41e9-aa32-485fad68004f",
                                                "sense_id": "5c168f0e-cd76-3dc1-acf5-0b58e6dba7a0",
                                                "text": "Il a repoussé du pied, face à Mourousi, l’accusation selon laquelle la nomination de son médecin personnel au poste d’inspecteur général de la Santé publique serait un acte de bon copinage."
                                            },
                                            {
                                                "example_id": "9cc3a553-7555-4426-9c3b-48ff2f6adc0b",
                                                "sense_id": "5c168f0e-cd76-3dc1-acf5-0b58e6dba7a0",
                                                "text": "…ses commissions, corruptions, copinages et contre-dénonciations."
                                            },
                                            {
                                                "example_id": "123c2c92-265a-4363-a975-9ea81293aa87",
                                                "sense_id": "5c168f0e-cd76-3dc1-acf5-0b58e6dba7a0",
                                                "text": "Et puis, le Front, ce sont les identitaires, la soupe au goret, les pro-crucifix et les anti-avortement de la nièce Maréchal-Le Pen, les thés dansants en Australie, les banques amies russes, les copinages syriens, la chasse aux fonctionnaires, l’apologie du revolver (très en vogue chez Ménard Robert), et tout le reste…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "790f3674-2ae7-35e9-8147-9ec5df967a6d",
                                        "entry_id": "e83a4512-50a3-3c47-b012-496b7f6c496c",
                                        "glosses": [
                                            "Relations amoureuses entre adolescents."
                                        ],
                                        "tags": [
                                            "Afrique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87bed7ed-d270-4f96-a883-a42cd652b3e3",
                                                "sense_id": "790f3674-2ae7-35e9-8147-9ec5df967a6d",
                                                "text": "Une étude en 2006 avait mis en évidence les situations qui exposent particulièrement les filles-élèves aux grossesses (...) « (...) la dégradation des mœurs et le phénomène de copinage (...) »"
                                            },
                                            {
                                                "example_id": "6c50dd25-1454-4f68-be71-c1c021a9aaea",
                                                "sense_id": "790f3674-2ae7-35e9-8147-9ec5df967a6d",
                                                "text": "L’adolescence constitue un âge critique du développement de la personnalité. (...) Le copinage entre adolescents du même sexe ou de sexes différents peuvent aboutir à des pratiques sexuelles déviantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
