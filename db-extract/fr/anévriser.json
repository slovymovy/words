                ],
                "senses": [
                    {
                        "sense_id": "248250dc-a599-3e26-b458-fd40a905929f",
                        "entry_id": "da70c059-c646-3fc2-b47e-bd22aa2431d1",
                        "glosses": [
                            "Devenir victime d’un anévrisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06daa517-409d-4076-a334-1cf9a91a4b5e",
                                "sense_id": "248250dc-a599-3e26-b458-fd40a905929f",
                                "text": "Le tronc de la céliaque, l’aorte ventrale, peut être la mésentérique, peuvent s’anévriser."
                            },
                            {
                                "example_id": "097cd909-b8a1-4d1f-aa70-fb82864cf50d",
                                "sense_id": "248250dc-a599-3e26-b458-fd40a905929f",
                                "text": "Mais il existe des femmes dont le coeur trop fortement dilaté s’anévrise dans ces terribles péripéties; d’autres, chez lesquelles le sang se tourne, et qui font de graves maladies."
                            },
                            {
                                "example_id": "5abfc72f-4f96-43ac-bc9a-e64fa5c8536a",
                                "sense_id": "248250dc-a599-3e26-b458-fd40a905929f",
                                "text": "Sézig Picoulet, quand on lui a montré ça, on a cru qu’il allait s’en anévriser une amygdale."
                            }
                        ]
                    }
                ],
