                    {
                        "translation_id": "060a5751-9cb1-41ef-9f30-b26ec134a4ea",
                        "source_entry_id": "1a9ffdf9-2adb-3be6-b3de-9229ffb6916e",
                        "source_sense_description": "belief in existence of at least one deity",
                        "target_lang_word": "теи́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "теи́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cc638de8-8f17-355b-b8e6-388bb4dfcba7",
                                        "entry_id": "50b85c64-54d6-322f-af77-1a845ad07729",
                                        "glosses": [
                                            "мед. болезненное пристрастие к крепкому чаю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b660731-93ce-4a18-81b0-7bdaffac31f8",
                                                "sense_id": "cc638de8-8f17-355b-b8e6-388bb4dfcba7",
                                                "text": "Увлечение очень крепким чаем (чифирь) вызывает теизм ― одну из форм наркомании, которая ведёт к поражению сердечной мышцы, а пристрастие к кофе ― кофеинизм, вызывающий нарушение мыслительных способностей."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "теи́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "729e658a-e34d-3daa-81e1-faac357b1edc",
                                        "entry_id": "ccd24579-8d45-330b-b7ea-7ce8552e1bd1",
                                        "glosses": [
                                            "филос. религиозно-философское учение, считающее бога абсолютной бесконечной личностью, обладающей разумом и волей, создавшей мир и управляющей им"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68ab1fa-0852-47ee-a55d-28ea95f5abb8",
                                                "sense_id": "729e658a-e34d-3daa-81e1-faac357b1edc",
                                                "text": "Если понимать религию в нашем европейском смысле, как теизм, утверждение Бога, ― а так именно понимает религию Горький, ― то большая часть Востока ― буддийская ― нерелигиозна, атеистична, потому что буддизм ― чистейший атеизм; только приближаясь к Западу, Восток становится религиозным в нашем, европейском, смысле ― теистичным (зороастризм, иудаизм, ислам); а чем дальше от Запада, чем восточнее, тем атеистичнее."
                                            },
                                            {
                                                "example_id": "99c7003c-4080-4b5a-844e-5c1fb33d1a38",
                                                "sense_id": "729e658a-e34d-3daa-81e1-faac357b1edc",
                                                "text": "Приходится констатировать, что в споре пантеистов, деистов и теистов XVII в. хотя и вырабатывались, оттачивались основные философско-религиозные категории, но проблема «личный Бог — безличное Божество» до конца так и осталась непрояснённой. Потому и у родоначальников термина «теизм» трудно найти эталонное понимание личностного бытия, в этом состоит один из парадоксов генезиса и последующей истории теизма на Западе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
