                "translations": [
                    {
                        "translation_id": "416db147-dcd2-4008-ab9d-c1062f164f40",
                        "source_entry_id": "b1daa509-d707-32df-bd55-48d13f19e0c5",
                        "source_sense_id": "63ee7b49-e9f5-312b-bdf9-e94533b6aef7",
                        "target_lang_word": "pastiche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pastiche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "471a0940-e6ee-31f6-9315-15b6a4086df9",
                                        "entry_id": "ea89c9d5-7461-3584-aea5-4ac9b5ce7933",
                                        "glosses": [
                                            "A work of art, drama, literature, music, or architecture that imitates the work of a previous artist, usually in a positive or neutral way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2e42f5-4f44-4a7d-a3a7-05b42dcf6b23",
                                                "sense_id": "471a0940-e6ee-31f6-9315-15b6a4086df9",
                                                "text": "He argued that the failure of the future was constitutive of a postmodern cultural scene which, as he correctly prophesied, would become dominated by pastiche and revivalism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c99c4630-0500-3ac6-95ad-2eec035eb26b",
                                        "entry_id": "ea89c9d5-7461-3584-aea5-4ac9b5ce7933",
                                        "glosses": [
                                            "A musical medley, typically quoting other works."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f680414-4525-3914-a98c-ace0c4f98274",
                                        "entry_id": "ea89c9d5-7461-3584-aea5-4ac9b5ce7933",
                                        "glosses": [
                                            "An incongruous mixture; a hodgepodge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e044c405-95d0-4249-82be-e86e1a1b18d6",
                                                "sense_id": "0f680414-4525-3914-a98c-ace0c4f98274",
                                                "text": "This supposed research paper is a pastiche of passages from unrelated sources."
                                            },
                                            {
                                                "example_id": "4c42903c-e0fa-421b-a4b6-8dd8baf5d5e6",
                                                "sense_id": "0f680414-4525-3914-a98c-ace0c4f98274",
                                                "text": "The house failed to attract a buyer because the decor was a pastiche of Bohemian and Scandinavian styles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a4152a-3100-3cd7-8395-5e8aececc2a8",
                                        "entry_id": "ea89c9d5-7461-3584-aea5-4ac9b5ce7933",
                                        "glosses": [
                                            "A postmodern playwriting technique that fuses a variety of styles, genres, and story lines to create a new form."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pastiche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d398678f-83ad-3d04-9d9b-01fbba4fb584",
                                        "entry_id": "7fa042d0-de81-31f7-aae9-acca946d7b23",
                                        "glosses": [
                                            "To create or compose in a mixture of styles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443bd09f-3e45-4ecb-8117-771e9ce6cdd6",
                                                "sense_id": "d398678f-83ad-3d04-9d9b-01fbba4fb584",
                                                "text": "That the genetic code of the platypus proved to be as bizarrely pastiched as its anatomy enhanced the popular appeal of the report, published in the journal Nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
