                                        "sense_id": "a826cadd-d953-3441-a95a-797777ca5328",
                                        "entry_id": "80f74680-8b9e-3a77-b2c4-291258101eb5",
                                        "glosses": [
                                            "To make corrupt; to change from good to bad; to draw away from the right path; to deprave; to pervert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049fbc83-43db-49d3-998a-021f8150a958",
                                                "sense_id": "a826cadd-d953-3441-a95a-797777ca5328",
                                                "text": "Don't you dare corrupt my son with those disgusting pictures!"
                                            },
                                            {
                                                "example_id": "68006a34-b6b2-4ae6-b6f7-292a4d68b58f",
                                                "sense_id": "a826cadd-d953-3441-a95a-797777ca5328",
                                                "text": "And God looked upon the earth, and, behold, it was corrupt; for all flesh had corrupted his way upon the earth."
                                            },
                                            {
                                                "example_id": "f068b19a-0a41-41f9-9387-05457b335ebc",
                                                "sense_id": "a826cadd-d953-3441-a95a-797777ca5328",
                                                "text": "I think that there is a bad idea around in our world, and that idea is that 'power corrupts, and absolute power corrupts absolutely'. I think what really happens is that power attracts the corruptible."
                                            },
                                            {
                                                "example_id": "2605b0d6-c711-43ae-90b4-b6aa323d8092",
                                                "sense_id": "a826cadd-d953-3441-a95a-797777ca5328",
                                                "text": "George Soros remains a favorite target of conservative conspiracy theorists, seeing his corrupting influence behind every liberal movement and within every nook and cranny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63700273-6fe8-3c17-9e4a-e419708f5be5",
                                        "entry_id": "80f74680-8b9e-3a77-b2c4-291258101eb5",
                                        "glosses": [
                                            "To become putrid, tainted, or otherwise impure; to putrefy; to rot."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2220b18-a517-452d-b79e-7f27a6c0c50c",
                                                "sense_id": "63700273-6fe8-3c17-9e4a-e419708f5be5",
                                                "text": "he entrails, which are the parts aptest to corrupt"
                                            },
                                            {
                                                "example_id": "f6385742-115d-46ad-9ec9-ad9342596868",
                                                "sense_id": "63700273-6fe8-3c17-9e4a-e419708f5be5",
                                                "text": "[…] Lanfrank takes Notice of Tract. 3. Doct. 3. cap. 18. ſaying, \"I have ſeen many who being full of Humours, have made an Iſſue under the Knee, before due Purgation had been premis'd; whence, by reaſon of the too great Defluxion of Humours, the Legs tumified, ſo that the cauterized Place corrupted, and a Cancer (or rather cacoethic Ulcer) was thereby made, with which great Difficulty was cur'd.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687416fd-73b8-3fe6-b221-1af91cc41929",
                                        "entry_id": "80f74680-8b9e-3a77-b2c4-291258101eb5",
                                        "glosses": [
                                            "To introduce errors; to place into an invalid state."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "782597ac-9ad8-4750-9d4d-2fef8e9cfb82",
                                                "sense_id": "687416fd-73b8-3fe6-b221-1af91cc41929",
                                                "text": "Unplugging a flash drive without dismounting it first can corrupt the data stored on the drive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cf90c9-a1f0-3275-8d42-98be50b3cf6f",
                                        "entry_id": "80f74680-8b9e-3a77-b2c4-291258101eb5",
                                        "glosses": [
                                            "To debase or make impure by alterations or additions; to falsify."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "432ccf84-7057-4fc4-b2ab-bde800ae669f",
                                                "sense_id": "f2cf90c9-a1f0-3275-8d42-98be50b3cf6f",
                                                "text": "to corrupt language, or a holy text"
                                            },
                                            {
                                                "example_id": "6e9b7d29-4c29-4686-ab39-db590b3b9a22",
                                                "sense_id": "f2cf90c9-a1f0-3275-8d42-98be50b3cf6f",
                                                "text": "to corrupt a book"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d83d8b4-d857-3a90-8686-8f891787c48e",
                                        "entry_id": "80f74680-8b9e-3a77-b2c4-291258101eb5",
                                        "glosses": [
                                            "To waste, spoil, or consume; to make worthless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40445daa-c753-4a87-b701-df1f8c73a76c",
                                                "sense_id": "0d83d8b4-d857-3a90-8686-8f891787c48e",
                                                "text": "Lay not up for yourselves treasures upon earth, where moth and rust doth corrupt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc521be4-a04d-45d1-9249-db3f3414c22f",
                        "source_entry_id": "394349f9-8e38-3145-9a03-8f883a9bc331",
                        "source_sense_description": "добиться полового контакта, соблазнить",
                        "target_lang_word": "seduce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seduce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "964be464-2230-3a1e-98df-e895d75121fc",
                                        "entry_id": "97733c6b-b5dd-3e8a-9b76-6ccca3a62e58",
                                        "glosses": [
                                            "To beguile or lure (someone) away from duty, accepted principles, or proper conduct; to lead astray."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0877a349-42d3-4323-8d3f-ef31d8c75622",
                                                "sense_id": "964be464-2230-3a1e-98df-e895d75121fc",
                                                "text": "[…] they alledged, That becauſe I had ſome Rudiments of Reaſon, added to the natural pravity of thoſe Animals, it was to be feared, I might be able to ſeduce them into the woody and mountainous parts of the Country, and bring them in Troops by night to deſtroy the Houyhnhnms Cattle, as being naturally of the ravenous kind, and averſe from Labour."
                                            },
                                            {
                                                "example_id": "f8e6b0b8-373c-4924-8049-38e1359c5ca8",
                                                "sense_id": "964be464-2230-3a1e-98df-e895d75121fc",
                                                "text": "Your father was seduced by the dark side of The Force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d24c2e0d-b107-3439-b23f-9e0694cc3847",
                                        "entry_id": "97733c6b-b5dd-3e8a-9b76-6ccca3a62e58",
                                        "glosses": [
                                            "To entice or induce (someone) to engage in a sexual relationship."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94c49325-77b5-4630-9dfc-fe8bbaba2be9",
                                                "sense_id": "d24c2e0d-b107-3439-b23f-9e0694cc3847",
                                                "text": "\"Mrs. Robinson, are you trying to seduce me?\"\n\"Do you want me to seduce you?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed6eb47-4436-3e1f-96ca-4664eb4fa8ee",
                                        "entry_id": "97733c6b-b5dd-3e8a-9b76-6ccca3a62e58",
                                        "glosses": [
                                            "To have sexual intercourse with."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "euphemistic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a09ee55d-182e-44f6-8257-61e8daf245be",
                                                "sense_id": "1ed6eb47-4436-3e1f-96ca-4664eb4fa8ee",
                                                "text": "He had repeatedly seduced the girl in his car, hotels and his home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a98f85f-988d-3409-baf0-50740fdefa6d",
                                        "entry_id": "97733c6b-b5dd-3e8a-9b76-6ccca3a62e58",
                                        "glosses": [
                                            "To win over or attract."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e701a73-2787-48a0-8575-642198b029b2",
                                                "sense_id": "8a98f85f-988d-3409-baf0-50740fdefa6d",
                                                "text": "He was seduced by the bright lights and glamour of the city."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
