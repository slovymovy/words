                "senses": [
                    {
                        "sense_id": "f32ce2f7-e715-3ebb-b72b-fac129b6e786",
                        "entry_id": "057937f6-3576-3728-abdb-2866b369ef8f",
                        "glosses": [
                            "ein von der Struktur her eigenständiger Teil einer Gesamtgemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef257b10-fdd2-4c34-bd2b-c1ba0b6b9c43",
                                "sense_id": "f32ce2f7-e715-3ebb-b72b-fac129b6e786",
                                "text": "„Attaching hat 1.000 Einwohner, ein Teilort der Bischofsstadt Freising und liegt direkt am Münchner Flughafen. Käme die neue Startbahn, ‚würde das Dorf sterben‘, sagt Michael Buchberger von der Bürgerinitiative, die den Bau seit Jahren bekämpft.“"
                            },
                            {
                                "example_id": "749ded42-dd9f-4400-9c58-03864acd89bb",
                                "sense_id": "f32ce2f7-e715-3ebb-b72b-fac129b6e786",
                                "text": "„Während sie beispielsweise ‚Schmutzengel‘, ‚Dachziegen‘ und ‚Nordmanntonnen‘, ‚Fötenkonzerte‘, ‚Grippenspiele‘ und ‚Nusskacker‘ großzügig tolerieren, dulden sie den Reutlinger Teilort Degerschlacht nicht, wollen ihn beharrlich in ‚Redeschlacht‘ umtaufen und ‚Ofenringer‘, sowie ‚Bezwinger‘ im Norden und Westen der Achalmstadt ansiedeln.“"
                            },
                            {
                                "example_id": "40888527-62c0-4e4f-8fc4-cdb4fc9f52b3",
                                "sense_id": "f32ce2f7-e715-3ebb-b72b-fac129b6e786",
                                "text": "„Insbesondere die Teilorte wie Taisersdorf hätten im Verlauf dieser Zeit ihren Charakter und ihre besonderen Traditionen bestens bewahren können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
