                "senses": [
                    {
                        "sense_id": "a7a38f19-3baf-39c3-a37f-4f72b5d34a92",
                        "entry_id": "27e62bfa-ae4c-3336-9d4e-fad75323ebea",
                        "glosses": [
                            "met gecombineerd gebruik van tekst, geluid en video of andere uitingsvormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea45ed8e-86e9-46f3-8408-226c35666af1",
                                "sense_id": "a7a38f19-3baf-39c3-a37f-4f72b5d34a92",
                                "text": "Op een intelligente manier weeft regisseur Wayn Traub in de Wayn Wash-cyclus disciplines als film, theater en muziek tot een naadloos geheel, zodat we zelfs van een nieuw multimediaal totaaltheater kunnen spreken: de cinema-opera, zoals hij het zelf aanduidt. Beeld, geluid, video en live acteurs interfereren voortdurend in een caleidoscopische constructie. Eén verhaallijn voltrekt zich op de speelvloer, terwijl een tweede filmisch wordt uitgewerkt."
                            },
                            {
                                "example_id": "620dcd5d-a171-4895-95dc-8f71f9c18a9c",
                                "sense_id": "a7a38f19-3baf-39c3-a37f-4f72b5d34a92",
                                "text": "Dr. Frese was van mening, dat nu nog scholen met klassikale indeling bouwen verspilling van gemeenschapsgeld is, als men serieus aan permanente educatie in de toekomst denkt. Hij pleitte voor een beter gebruik van radio en televisie dan tot nu toe gebeurt ten dienste van het onderwijs. Hii gaf wel als zijn mening dat dit multimediaal onderwijs begrotingstechnisch en juridisch los zal moeten staan van de NOS."
                            }
                        ]
                    }
