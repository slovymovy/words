                                "sense_id": "567fd6b0-8514-3dfe-8ac7-a83c55fa055b",
                                "text": "Ieder betaalt naar gelang (van) zijn vermogen.",
                                "translation": "Chacun paie en proportion de sa fortune."
                            },
                            {
                                "example_id": "40abb844-1456-4b18-953a-09957d827dcd",
                                "sense_id": "567fd6b0-8514-3dfe-8ac7-a83c55fa055b",
                                "text": "Geld uitgeven naargelang de behoefte.",
                                "translation": "Dépenser de l’argent au fur et à mesure des besoins."
                            }
