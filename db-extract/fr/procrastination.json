                    {
                        "translation_id": "2af59693-8028-498b-9cbb-0b2037f34825",
                        "source_entry_id": "3bcb7aeb-09d8-33e3-89e4-de015af2aa8f",
                        "target_lang_word": "Prokrastination",
                        "target_lang_code": "de",
