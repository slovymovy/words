                                "target_senses": [
                                    {
                                        "sense_id": "1fe97ed5-1951-3095-b1c9-032e3f331638",
                                        "entry_id": "2cbe83be-06d0-36ea-afa0-0fe50a30c3dc",
                                        "glosses": [
                                            "Flatter quelqu’un avec excès par bassesse ou par intérêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f24e9481-0ac3-4dc2-a18b-4b7a5d41361a",
                                                "sense_id": "1fe97ed5-1951-3095-b1c9-032e3f331638",
                                                "text": "Pendant deux heures, le prince de Condé connut l’humiliation, et, parmi les plus empressés à l’accabler, il reconnut ceux qui, la veille, avaient été les plus âpres à l’aduler."
                                            },
                                            {
                                                "example_id": "91f7d16f-b495-4040-aaaa-9b182da6101e",
                                                "sense_id": "1fe97ed5-1951-3095-b1c9-032e3f331638",
                                                "text": "Je suis citoyen français, j’ai le droit d’aduler qui je veux !"
                                            },
                                            {
                                                "example_id": "c75ad361-ddd2-4e4e-ba27-24caca5ecc35",
                                                "sense_id": "1fe97ed5-1951-3095-b1c9-032e3f331638",
                                                "text": "Enfin, je m’aperçois peu à peu, et avec une sorte de honte, que les jeunes femmes qui papillonnent autour de Michel non seulement l’adorent, mais l’adulent."
                                            },
                                            {
                                                "example_id": "5aad4e3b-6f2b-4e5f-afcc-64463fb9cff8",
                                                "sense_id": "1fe97ed5-1951-3095-b1c9-032e3f331638",
                                                "text": "Il était adulé et a marqué la vie des gens qui ont croisé sa route."
                                            },
                                            {
                                                "example_id": "5b4d88d8-7d67-4b6a-8b2e-3f42d56ac15d",
                                                "sense_id": "1fe97ed5-1951-3095-b1c9-032e3f331638",
                                                "text": "Aduler la puissance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
