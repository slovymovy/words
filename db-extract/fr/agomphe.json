                "senses": [
                    {
                        "sense_id": "1910f1dc-28e2-36e5-ab18-2be0299cec14",
                        "entry_id": "f1da341b-e872-30b9-97b6-5e06baef243b",
                        "glosses": [
                            "Édenté, dépourvu de dents."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5b031a21-11f1-447b-a9b8-1903f82d5871",
                                "sense_id": "1910f1dc-28e2-36e5-ab18-2be0299cec14",
                                "text": "Agomphe, adj., agomphius (α priv., γομϕίος, dent). Épithète appliquée par C.-G. Ehrenberg aux infusoires rotifères dont les mâchoires sont dépourvues de dents. Ex. Ichthydium."
                            },
                            {
                                "example_id": "6efc2de1-58be-4ca4-abe9-08c914ffbb31",
                                "sense_id": "1910f1dc-28e2-36e5-ab18-2be0299cec14",
                                "text": "Agomphe, a. (zoo.) Without teeth."
                            },
                            {
                                "example_id": "4f46401f-9670-4585-b5e8-59116e31801c",
                                "sense_id": "1910f1dc-28e2-36e5-ab18-2be0299cec14",
                                "text": "Cœurs piqués au sang noir de vampires agomphes."
                            },
                            {
                                "example_id": "cef483c1-ac6c-404a-ad4a-94f4e8147fa0",
                                "sense_id": "1910f1dc-28e2-36e5-ab18-2be0299cec14",
                                "text": "Pour prêcher la vertu, pour désigner le cœur,\nComme organe vivant dont l’ordre n’est agomphe,\nMais il faut regretter, si même l’on est pour,\nTant d’ombre, de regret, et d’inhumain détour,\nPour tarir les élans des vices sans contour."
                            }
                        ]
                    }
                ],
