            "senses": [
                {
                    "sense_id": "dd1f6574-09e5-3fb7-b57f-2f9bd046bd6d",
                    "sense_definition": "Sentiment de gratitude envers une personne dont on a reçu un bienfait ou de l'aide.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tenu à lui exprimer toute sa <w>reconnaissance</w> pour son aide précieuse."
                        },
                        {
                            "text": "Elle accepta ce cadeau avec <w>reconnaissance</w> et remercia chaleureusement ses amis."
                        }
                    ],
                    "synonyms": [
                        "gratitude"
                    ],
                    "common_phrases": [
                        "témoigner sa reconnaissance",
                        "avec reconnaissance"
                    ]
                },
                {
                    "sense_id": "59655e7e-7937-3cc7-a803-c3e313b75116",
                    "sense_definition": "Fait d'identifier ou de se rappeler quelqu'un ou quelque chose qu'on a déjà vu ou connu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>reconnaissance</w> du suspect par la victime a eu lieu au commissariat."
                        },
                        {
                            "text": "Son visage a provoqué une vive lueur de <w>reconnaissance</w> chez sa grand-mère."
                        }
                    ],
                    "common_phrases": [
