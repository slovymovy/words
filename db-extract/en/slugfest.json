                "senses": [
                    {
                        "sense_id": "af874b4a-e8d1-3cac-845c-086abc98a789",
                        "entry_id": "a3e8e115-6648-3328-b9ca-659f76960f50",
                        "glosses": [
                            "A baseball game in which many runs are scored, especially by home runs."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "eabf8204-fbe3-4774-8a2a-a30f56e70d4b",
                                "sense_id": "af874b4a-e8d1-3cac-845c-086abc98a789",
                                "text": "The game turned into a 15-9 slugfest."
                            },
                            {
                                "example_id": "f3cc3d27-8dbf-4e28-8fc5-bee47ccb237f",
                                "sense_id": "af874b4a-e8d1-3cac-845c-086abc98a789",
                                "text": "In a World Series that has come to be defined by the unpredictable and unexpected, it was only fitting that one night, after a lights-out pitchers’ duel between the heretofore unremarkable Alex Wood and Charlie Morton, a slugfest would unfold that sent the Cy Young Award winners Clayton Kershaw and Dallas Keuchel to early exits."
                            }
                        ]
                    },
                    {
                        "sense_id": "11256af7-8ed9-3333-95bf-9b73f6beca74",
                        "entry_id": "a3e8e115-6648-3328-b9ca-659f76960f50",
                        "glosses": [
                            "A game or match in which heavy blows are exchanged."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6b6bc517-6842-4819-a5ef-7e69b10a09cb",
                                "sense_id": "11256af7-8ed9-3333-95bf-9b73f6beca74",
                                "text": "Nadal is supposedly the alpha male in any slugfest. But Rosol's forehand shots were being sent towards the Majorcan at 93mph plus, and his was the fastest serve at 134mph."
                            },
                            {
                                "example_id": "a2a1cdbf-3fce-430d-80b3-3ebcb6399c50",
                                "sense_id": "11256af7-8ed9-3333-95bf-9b73f6beca74",
                                "text": "The championship bout was a slugfest; both boxers were bloodied."
                            },
                            {
                                "example_id": "d005f031-dcbc-4962-80c9-6785136dd520",
                                "sense_id": "11256af7-8ed9-3333-95bf-9b73f6beca74",
                                "text": "But while Roger Federer and Serena Williams were bludgeoning their opponents off the main court in a combined 126 minutes, the fans looking for a fantastic match stuffed into Armstrong Stadium next door to watch a mesmerizing slugfest between seventh-seeded Gaël Monfils of France and Juan Carlos Ferrero of Spain."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ae65cbb-a7e6-3ab8-99d9-61798e2440e8",
                        "entry_id": "a3e8e115-6648-3328-b9ca-659f76960f50",
                        "glosses": [
                            "A tough, heated contest."
                        ],
                        "tags": [
                            "figuratively",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a70014e5-8bf2-4922-8b29-11c253b4c034",
                                "sense_id": "8ae65cbb-a7e6-3ab8-99d9-61798e2440e8",
                                "text": "Lakers win slugfest over Clippers"
                            },
                            {
                                "example_id": "c6e12d26-9f94-4077-bc0f-ed3edd33092e",
                                "sense_id": "8ae65cbb-a7e6-3ab8-99d9-61798e2440e8",
                                "text": "There isn’t much reason to be optimistic about thoughtful dialogue in this general election. Both sides are girded for a negative, no-holds-barred slugfest."
                            },
                            {
                                "example_id": "68b64bea-8b44-4b20-895d-43fb8704a436",
                                "sense_id": "8ae65cbb-a7e6-3ab8-99d9-61798e2440e8",
                                "text": "The race descended into a brutal slugfest as the leading candidates, the author-turned-venture capitalist J.D. Vance, the former state treasurer Josh Mandel and a self-funded businessman, Mike Gibbons, entered the final weekend before Tuesday’s primaries accusing one another of being insufficiently right-wing or disloyal to the man in Mar-a-Lago."
                            },
                            {
                                "example_id": "7fe5ab17-a798-47ea-9d6e-f22f447deef8",
                                "sense_id": "8ae65cbb-a7e6-3ab8-99d9-61798e2440e8",
                                "text": "The possible reversal of fortunes comes as Ukraine is preparing to mount a broader counteroffensive, aiming for a dramatic breakthrough in a war that has settled into a grueling slugfest, with much blood spilled but little ground gained."
                            }
                        ]
                    }
                ],
