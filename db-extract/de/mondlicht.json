                        ],
                        "form": "dem Mondlichte"
                    },
                    {
                        "form_id": "1fa3421e-3513-4baf-b908-4b724f067d8a",
                        "entry_id": "86b81dac-2552-31b6-8547-5db3261c2cbc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Mondlicht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                        "entry_id": "86b81dac-2552-31b6-8547-5db3261c2cbc",
                        "glosses": [
                            "das vom Mond reflektierte Sonnenlicht bei Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863f6c1f-83bf-4328-ba2e-94938774b5f3",
                                "sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                                "text": "„Er ritt ohne anzuhalten fünfzig Meilen, bei Tageslicht, Mondlicht, Sternenlicht oder in pechschwarzer Nacht, wie es gerade kam.“"
                            },
                            {
                                "example_id": "1ae1fa77-c0fa-4ce6-a314-d33b4602e0fb",
                                "sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                                "text": "„Nachdem John sein Frühstück wortlos verzehrt hatte, ging er, den Frost und das bläulich flimmernde Mondlicht verfluchend, fort.“"
                            },
                            {
                                "example_id": "0d5e061e-35b9-49f0-96ea-d187b37a2998",
                                "sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                                "text": "„Mondlicht fiel durch das einzige Fenster hoch oben an der Wand.“"
                            },
                            {
                                "example_id": "f5d39c77-bd89-4a18-81ea-5ca010336a4d",
                                "sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                                "text": "„Durch das offene Fenster konnte er im Mondlicht die ausgeprägte Kurve ihres nach vorn geneigten Rückens sehen.“"
                            },
                            {
                                "example_id": "b8888545-9936-4b95-831d-3016291f6e4f",
                                "sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                                "text": "„Fünf Minuten später betrachtete er kritisch den Erfolg seiner Handarbeit, füllte sein Zigarettenetui auf, verschloss die Tür, ging in die Halle hinunter, durchquerte sie und trat in das Mondlicht hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a509b8f5-390b-4afb-b2d6-bf9e9fec625e",
                        "source_entry_id": "86b81dac-2552-31b6-8547-5db3261c2cbc",
                        "source_sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                        "source_sense_description": "das vom Mond reflektierte Sonnenlicht bei Nacht",
                        "target_lang_word": "moonlight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moonlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                        "entry_id": "f5fc65b4-2f06-39e1-b097-6256a1fedeb0",
                                        "glosses": [
                                            "The light reflected from the Moon."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "407db1cb-4e85-46c9-8242-88e951f77798",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "If you will patiently dance in our round / And see our moonlight revels, go with us; / If not, shun me, and I will spare your haunts."
                                            },
                                            {
                                                "example_id": "f8b77519-66aa-47d3-9826-b31d0322d385",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "How sweet the moonlight sleeps upon this bank! / Here will we sit and let the sounds of music / Creep in our ears: soft stillness and the night / Become the touches of sweet harmony."
                                            },
                                            {
                                                "example_id": "94fc4d7b-0761-4873-a100-54859b192d96",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "[…] the sight of the blade which glistened by moonlight in his face, checked, in some sort, the ardour of his assailant […]"
                                            },
                                            {
                                                "example_id": "4c19a32d-5014-4d7f-b817-2abbded822c7",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "’Tis eight o’clock,—a clear March night, / The moon is up,—the sky is blue, / The owlet, in the moonlight air, / Shouts from nobody knows where;"
                                            },
                                            {
                                                "example_id": "73595654-a3eb-492d-89a9-5d22ab210607",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "It was the pensive oysterman that saw a lovely maid, / Upon a moonlight evening, a-sitting in the shade;"
                                            },
                                            {
                                                "example_id": "6f7d6ead-5f64-4012-aed2-ae8d60b7480e",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "[S]he passed away noiselessly, and the moonlight kissed the wall which her shadow had dimmed."
                                            },
                                            {
                                                "example_id": "50019ceb-f58c-4ac6-a8a3-b1b1a405abd1",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "What say you, gentlemen, shall we have a moonlight hunt?"
                                            },
                                            {
                                                "example_id": "fd2349a0-adfc-456c-8d52-623af1475389",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "The windows were curtainless, and the yellow moonlight, flooding in through the diamond panes, enabled one to see even colours, whilst it softened the wealth of dust which lay over all and disguised in some measure the ravages of time and the moth."
                                            },
                                            {
                                                "example_id": "39420950-82ef-480b-9605-52209da0eafa",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "They were still under the white plum tree and their faces were touching except for a pale thin ray of moonlight between."
                                            },
                                            {
                                                "example_id": "41d29f0b-e5d0-4daa-9b8e-89a313848d0f",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "It [the Arkenstone] was as if a globe had been filled with moonlight and hung before them in a net woven of the glint of frosty stars."
                                            },
                                            {
                                                "example_id": "ae4c4381-13ff-421e-badb-3f77c444fa26",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "1957, Sylvia Dee, “Moonlight Swim” (song recorded by Nick Noble and Elvis Presley),\nLet’s go on a moonlight swim / Far away from the crowd / All alone upon the beach / Our lips and our arms / Close within each other’s reach / Will be on a moonlight swim"
                                            },
                                            {
                                                "example_id": "09041c21-e9c3-437b-ab7c-d695a5a432a7",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "On a moonlight night it would be different. The happy voices of children playing in open fields would then be heard. And perhaps those not so young would be playing in pairs in less open places, and old men and women would remember their youth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moonlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                        "entry_id": "3e00be22-6403-323f-9b2a-e8e5b66fcddc",
                                        "glosses": [
                                            "To work on the side (at a secondary job), often in the evening or during the night."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "888f310b-3649-4e11-a8fd-91fb9425f59c",
                                                "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                                "text": "There are three individual rear seats. They all slide, they all fold, or they can all be removed completely, so that you can moonlight as a van."
                                            },
                                            {
                                                "example_id": "c4a0a75d-c182-4ef9-b97d-6c313025e955",
                                                "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                                "text": "Investigators discover that Captain Ospina was forced to take a second job, moonlighting in a bar, in order to make ends meet for his family."
                                            },
                                            {
                                                "example_id": "7080cbc3-55c2-452a-bd33-faef0eb1a836",
                                                "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                                "text": "Believing the bones to belong to a cave bear, the quarry owner passed them on to a local schoolteacher, Johann Carl Fuhlrott, who moonlighted as a fossilist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f7c9330-558b-315a-b77a-1de656f8368d",
                                        "entry_id": "3e00be22-6403-323f-9b2a-e8e5b66fcddc",
                                        "glosses": [
                                            "To engage in an activity other than what one is known for."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d3157f5-82dc-4348-a85c-c5a8d1e0e7fa",
                                                "sense_id": "3f7c9330-558b-315a-b77a-1de656f8368d",
                                                "text": "Mr. Katzenberg, who moonlights as a top Biden official and has worked with Mr. Clooney on philanthropy for decades, reached out to him to see if there was an off-ramp, according to three people familiar with the matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8934053e-3154-37c0-997d-2aeafb4809e1",
                                        "entry_id": "3e00be22-6403-323f-9b2a-e8e5b66fcddc",
                                        "glosses": [
                                            "To perform a secondary function substantially different from its supposed primary function, as in protein moonlighting."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a37fe72c-90fb-325c-b978-039872d947dc",
                                        "entry_id": "3e00be22-6403-323f-9b2a-e8e5b66fcddc",
                                        "glosses": [
                                            "To carry out undeclared work."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f840282f-21ae-4205-810a-d22152c8a8e2",
                        "source_entry_id": "86b81dac-2552-31b6-8547-5db3261c2cbc",
                        "source_sense_id": "4a8e1e2f-148f-33fe-a08b-ab2da3315bc0",
                        "source_sense_description": "das vom Mond reflektierte Sonnenlicht bei Nacht",
                        "target_lang_word": "clair de lune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clair de lune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                        "entry_id": "a53bd8d2-539c-3ab7-948f-0322e8f0580a",
                                        "glosses": [
                                            "Clarté de la lune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3d061d-abaf-4e0a-ae01-94fcf7968990",
                                                "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                                "text": "Hervé ne croyait pas aux fées, et du reste si, comme l’affirment les Cornouaillais, les fées se promènent au clair de lune sur les bruyères désertes, personne ne les a jamais vues naviguer."
                                            },
                                            {
                                                "example_id": "83632bdc-73fc-4616-9edf-fc3a2f9a5a4d",
                                                "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                                "text": "Et plus haut, joyeusement gueulards, les chromos de M. Hugo d’Alési groupent quelques mules aux pieds légers dans des montagnes évidemment thermales, installent sur les routes auverpines de grands bœufs blancs tachés de ce que vous savez, et, sous d’obligeants clairs de lune, agenouillent des Bretons échappés du Pardon de Ploërmel aux seuils d'églises dont le roman-gothique tire sur la Renaissance…"
                                            },
                                            {
                                                "example_id": "0d07a61a-73a3-48c1-aa93-39e771f53339",
                                                "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                                "text": "Souvent, la nuit, par les beaux clairs de lune, il se levait et restait à l’affût jusqu’à l’aube."
                                            },
                                            {
                                                "example_id": "92105708-66d7-405e-b87d-801e32a272ce",
                                                "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                                "text": "Le vieux Jean-Claude avait eu son enfance bercée au récit des légendes de la Vouivre […] Sa grand’mère lui avait affirmé […] l’avoir vue de ses propre yeux, les soirs de clair de lune et les nuits d'étoiles, promener par les prés humides de la Moraie sa sveltesse robuste de serpent ailé."
                                            },
                                            {
                                                "example_id": "e5e8b038-6de2-4bc3-870b-ccd41169277e",
                                                "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                                "text": "Était-ce à cause du voisinage de l’hôpital Saint-Louis, dont les cheminées trapues se détachaient sur le clair de lune ?"
                                            },
                                            {
                                                "example_id": "e0004eab-685c-4e78-9f95-66ba96542be7",
                                                "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                                "text": "— Le 26 octobre, une dépêche annonça que les Anglais avaient pris Bois-le-Duc après une attaque de nuit exécutée par des chars lance-flammes « au clair de lune artificiel »."
                                            },
                                            {
                                                "example_id": "a5cedcda-0563-4da6-b95a-dd68db1bedf4",
                                                "sense_id": "629a29a7-3679-388e-becc-48e11aec7cdf",
                                                "text": "D’autres fois, la lune est immense, blanche et glacée, elle éclaire tout comme en plein jour et les ombres sont noires comme de l’encre de Chine. C’est ce qu’on appelle le clair de lune. Il a été chanté par une foule de poètes, français, belges, latins ou grecs, tels que Chyme l’Environnaire, Phorcypeute le Microchire et Hermogène le Guttural."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb2cbea-12d9-312c-8243-e2504d008ca4",
                                        "entry_id": "a53bd8d2-539c-3ab7-948f-0322e8f0580a",
                                        "glosses": [
                                            "Tableau qui représente une vue prise au clair de la lune."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
