                    {
                        "sense_id": "fe42d10f-7ad6-3823-95d1-64db2a3efc8a",
                        "entry_id": "75139744-1047-3dad-b186-f55a03112e9e",
                        "glosses": [
                            "an einem kleinen Stäbchen gefrorenes Speiseeis"
                        ],
                        "tags": [
                            "bayrisch"
                        ],
                        "examples": [
                            {
                                "example_id": "064b12ba-4f15-4c53-a601-0b273be01019",
                                "sense_id": "fe42d10f-7ad6-3823-95d1-64db2a3efc8a",
                                "text": "„Autofahrer, die während der Fahrt zum Mobiltelefon greifen, begehen eine Ordnungswidrigkeit. Zum Thema Essen, Trinken oder Rauchen hat der Gesetzgeber allerdings nichts formuliert – Steckerleis schlecken auf der Autobahn ist also erlaubt.“"
                            },
                            {
                                "example_id": "8db9fdd4-c388-4c99-b796-6f816ae66af6",
                                "sense_id": "fe42d10f-7ad6-3823-95d1-64db2a3efc8a",
                                "text": "„Margot Schunk lehnt sich weit nach vorne und reicht einem kleinen Jungen ein Steckerleis. ‚Das ist sicher für dich‘, sagt sie, […].“"
                            },
                            {
                                "example_id": "a5263df4-b1e1-4b92-8695-56203e4fb5bf",
                                "sense_id": "fe42d10f-7ad6-3823-95d1-64db2a3efc8a",
                                "text": "„Geblieben sind auch die Erinnerungen an originelle Ladenbesitzer wie den 1969 verstorbenen Sandner-Hias, Viktualienhändler aus Eichstätt, der sein Steckerleis stets weithin schallend anpries: ‚Jopa aus Europa, wer einmal schleckt, der weiß, wie's schmeckt.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
