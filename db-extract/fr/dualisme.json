        "fr-extract.jsonl": [
            {
                "entry_id": "6f04c8d1-30bc-3f11-98ee-61e0dc369ef2",
                "word": "dualisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32098f5f-fd66-47ae-8ff0-5f03d7f264cd",
                        "entry_id": "6f04c8d1-30bc-3f11-98ee-61e0dc369ef2",
                        "tags": [
                            "plural"
                        ],
                        "form": "dualismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81da4d42-29f4-3bbd-a311-16c46d6c27da",
                        "entry_id": "6f04c8d1-30bc-3f11-98ee-61e0dc369ef2",
                        "glosses": [
                            "Système qui suppose la coexistence, dans l’univers, dans l’homme ou dans les choses, de deux principes, de deux parties, de deux éléments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ec720d-10f6-43fa-a457-5371b2b31806",
                                "sense_id": "81da4d42-29f4-3bbd-a311-16c46d6c27da",
                                "text": "Le dualisme manichéen expliquait le monde par le concours et l’antagonisme de deux principes divins, le principe du Bien et le principe du Mal."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1650ad5-ef30-3766-af90-5f2e68ef10cc",
                        "entry_id": "6f04c8d1-30bc-3f11-98ee-61e0dc369ef2",
                        "glosses": [
                            "État politique ou social, dans lequel deux éléments différents coexistent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c387999f-a7cb-4147-b9e7-beac9abf3cd5",
                                "sense_id": "a1650ad5-ef30-3766-af90-5f2e68ef10cc",
                                "text": "La guerre de 1914 a mis fin au dualisme de l’Autriche-Hongrie."
                            }
                        ]
                    },
                    {
                        "sense_id": "5662361a-21a0-3b6f-b637-b84700d78569",
                        "entry_id": "6f04c8d1-30bc-3f11-98ee-61e0dc369ef2",
                        "glosses": [
                            "Régime parlementaire où le gouvernement est responsable politiquement à la fois devant le Parlement et devant le chef de l’État."
                        ],
                        "tags": [
                            "Droit constitutionnel"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "375b8b0a-8237-3f65-8d9b-7156f7220d42",
                        "entry_id": "6f04c8d1-30bc-3f11-98ee-61e0dc369ef2",
                        "glosses": [
                            "Position qui se situe entre deux éléments opposés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e4e24276-9468-4885-b96b-475f5638b50c",
                                "sense_id": "375b8b0a-8237-3f65-8d9b-7156f7220d42",
                                "text": "Ce dualisme de Freud ne se construit pas sur une opposition entre la matière et le mental, mais entre la réalité objective, dont il ne conteste pas un instant l’existence, et la réalité fictionnelle […] — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 420)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6336fa71-5435-4f19-bccf-d8ee5c8574f8",
                        "source_entry_id": "6f04c8d1-30bc-3f11-98ee-61e0dc369ef2",
                        "target_lang_word": "dualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c6cdc15-ee12-39ac-b7d8-f1a9f2013c05",
                                        "entry_id": "2f8d8259-78ce-3dd8-a07b-ca939e8f9080",
                                        "glosses": [
                                            "Duality; the condition of being double."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d66dff0-c0c6-4928-8739-d7802675fbd2",
                                                "sense_id": "8c6cdc15-ee12-39ac-b7d8-f1a9f2013c05",
                                                "text": "By breaking free of it, historians could shed the dualisms that now entrap them, and escape the declensionism - the longing for the lost alternative"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7150a73-932c-315d-9482-5ed5117bef9a",
                                        "entry_id": "2f8d8259-78ce-3dd8-a07b-ca939e8f9080",
                                        "glosses": [
                                            "The view that the world consists of, or is explicable in terms of, two fundamental principles, such as mind and matter or good and evil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb278ea5-83b4-39cc-8cf7-537a4789985d",
                                        "entry_id": "2f8d8259-78ce-3dd8-a07b-ca939e8f9080",
                                        "glosses": [
                                            "The belief that the world is ruled by a pair of antagonistic forces, such as good and evil; the belief that man has two basic natures, the physical and the spiritual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d91d6456-1ce4-43b1-bd1a-58ccd38635d5",
                                                "sense_id": "fb278ea5-83b4-39cc-8cf7-537a4789985d",
                                                "text": "The same conflict between the monism of temporal theorists and the dualism of ecclesiastical thinkers—the same opposition of organic to symbiotic union—occurred in the ninth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38b54e65-d128-31cd-9256-58dab078f48f",
                                        "entry_id": "2f8d8259-78ce-3dd8-a07b-ca939e8f9080",
                                        "glosses": [
                                            "The legal doctrine that international law must be transposed into domestic law to have effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cc9e606-46c6-33de-a383-67dbeff16284",
                                        "entry_id": "2f8d8259-78ce-3dd8-a07b-ca939e8f9080",
                                        "glosses": [
                                            "The theory, originated by Lavoisier and developed by Berzelius, that all definite compounds are binary in their nature, and consist of two distinct constituents, themselves simple or complex, and having opposite chemical or electrical affinities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ef658d3-1aa9-4096-b01f-12cccd9ccd93",
