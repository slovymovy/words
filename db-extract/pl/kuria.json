                    }
                ],
                "senses": [
                    {
                        "sense_id": "22779043-b91e-3b9f-b8b1-6ef554956ea2",
                        "entry_id": "b3bf18e9-8a28-3511-8d93-041686b94e8e",
                        "glosses": [
                            "jednostka podziału obywateli w starożytnym Rzymie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb3fabb-8cf9-4029-9b8f-6939c7ae2199",
                                "sense_id": "22779043-b91e-3b9f-b8b1-6ef554956ea2",
                                "text": "W skład kurii wchodziły rody patrycjuszowskie i plebejskie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3c459d39-a0b9-3968-aba9-61605fed4267",
                        "entry_id": "b3bf18e9-8a28-3511-8d93-041686b94e8e",
                        "glosses": [
                            "budynek posiedzeń senatu w starożytnym Rzymie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0cc9bfe-a9b1-4eb0-8bcb-21218d60d17a",
                                "sense_id": "3c459d39-a0b9-3968-aba9-61605fed4267",
                                "text": "Drzwi kurii zostały przeniesione i zainstalowane w bazylice św. Jana na Lateranie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5216b385-f96e-3fb8-b0ee-cf916c6c0bd5",
                        "entry_id": "b3bf18e9-8a28-3511-8d93-041686b94e8e",
                        "glosses": [
                            "instytucja administracyjna zarządzająca diecezją, na której czele stoi ordynariusz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1caeb14-9c57-4457-9b9f-4a0648b68812",
                                "sense_id": "5216b385-f96e-3fb8-b0ee-cf916c6c0bd5",
                                "text": "Pracownicy kurii biskupiej nazywani są kurialistami."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "3c48b87a-0348-347c-8671-4c0440cb4267",
                        "entry_id": "b3bf18e9-8a28-3511-8d93-041686b94e8e",
                        "glosses": [
                            "instytucja administracyjna zarządzająca prowincją zakonną, na której czele stoi przełożony prowincjalny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129246bd-b834-47e4-bf1a-082fba7bb8d9",
                                "sense_id": "3c48b87a-0348-347c-8671-4c0440cb4267",
                                "text": "Ojciec Bonawentura od lat pracuje w kurii prowincjalnej, jest sekretarzem prowincjała."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "4a857c63-f898-3a21-b5d5-78b8de8d7409",
                        "entry_id": "b3bf18e9-8a28-3511-8d93-041686b94e8e",
                        "glosses": [
                            "siedziba kurii (1.3) lub kurii (1.4)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d70a1b-7fc6-4250-8154-abd024910d35",
                                "sense_id": "4a857c63-f898-3a21-b5d5-78b8de8d7409",
                                "text": "Kurię wybudowano według projektu Zygmunta Gawlika."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
                ],
