                    "sense_definition": "A constellation in the Southern Hemisphere near Caelum and Puppis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Astronomers observed a new star within the constellation <w>Dove</w>.",
                            "target_lang_translations": {
                                "ru": "Астрономы наблюдали новую звезду в созвездии <w>Голубь</w>.",
                                "de": "Astronomen beobachteten einen neuen Stern im Sternbild <w>Taube</w>.",
                                "zh": "天文学家在<w>天鸽座</w>内观测到了一颗新星。"
                            }
                        },
                        {
                            "text": "You can see the <w>Dove</w> low in the southern sky during winter.",
                            "target_lang_translations": {
                                "ru": "Вы можете увидеть <w>Голубя</w> низко в южном небе зимой.",
                                "de": "Man kann die <w>Taube</w> im Winter tief am südlichen Himmel sehen.",
                                "zh": "冬天时，你可以看到<w>天鸽座</w>位于南方低空。"
                            }
                        }
