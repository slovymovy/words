                "senses": [
                    {
                        "sense_id": "c16614ba-bd18-3966-b6e5-3eb69b272c41",
                        "entry_id": "65aa2b6d-f84f-3dfd-8b38-c3495fe2cc2e",
                        "glosses": [
                            "Attitude hostile à l'égard de l'Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c40d68-6241-4c8f-aea4-9e6d771636d1",
                                "sense_id": "c16614ba-bd18-3966-b6e5-3eb69b272c41",
                                "text": "Si certains voient dans cet antigermanisme un risque que les Allemands finissent par renoncer aux plans de renflouement de leurs partenaires européens, Josef Joffe, rédacteur en chef du quotidien libéral Die Zeit, estime de son côté qu'il est temps pour l'Allemagne de vaincre ses susceptibilités."
                            },
                            {
                                "example_id": "9c894851-f35e-4e71-ac11-e8489a34587c",
                                "sense_id": "c16614ba-bd18-3966-b6e5-3eb69b272c41",
                                "text": "Il ne s'agit pas de pratiquer un antigermanisme qui serait parfaitement déplacé puisque dans de nombreux domaines la coopération entre la France et l'Allemagne est indispensable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd74500d-938b-4f2c-b202-90b7ff814916",
                        "source_entry_id": "65aa2b6d-f84f-3dfd-8b38-c3495fe2cc2e",
                        "source_sense_id": "c16614ba-bd18-3966-b6e5-3eb69b272c41",
                        "target_lang_word": "Germanophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Germanophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df3bbf8c-02ae-3749-94ea-405f0de164d9",
                                        "entry_id": "3c32066a-dab9-3183-b339-83e7edd80036",
                                        "glosses": [
                                            "The hatred or fear of Germany, its people and culture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebd2aae1-01ae-4a4b-a79a-de802fac2ed8",
                                                "sense_id": "df3bbf8c-02ae-3749-94ea-405f0de164d9",
                                                "text": "If we deal with state Germanophobia, the first observation concerns the uniqueness of war in the sense that it means that the government became overtly rather than covertly xenophobic in order to create a level of support on the home front necessary for victory on the battlefield, especially before conscription was introduced at the beginning of 1916. In Britain during the First World War, the government established various agencies for the propagation of Germanophobia."
                                            },
                                            {
                                                "example_id": "b16ceb27-a547-46f5-a185-60324765d4bc",
                                                "sense_id": "df3bbf8c-02ae-3749-94ea-405f0de164d9",
                                                "text": "\"Van,\" as he was known to friend and foe alike, has been accused of Germanophobia, criticized for being indifferent to events outside of his Eurocentric perspective, and castigated for possessing an inflexible mind."
                                            },
                                            {
                                                "example_id": "5f1a054b-9cc7-4abe-b01f-a0d2331cfbca",
                                                "sense_id": "df3bbf8c-02ae-3749-94ea-405f0de164d9",
                                                "text": "In the mid-1860s, Russia also experienced an outbreak of Germanophobia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6bedd9-352f-39e8-94e6-35027c17eda2",
                                        "entry_id": "3c32066a-dab9-3183-b339-83e7edd80036",
                                        "glosses": [
                                            "The hatred or fear of the presence of the German language and its native speakers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
