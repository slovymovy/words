                        "sense_id": "f8448fdb-189b-3e52-ba9a-6aaf6a0c4b1f",
                        "entry_id": "493110c6-25f1-3924-ad74-cd43fc6b2713",
                        "glosses": [
                            "Action de plier, résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b7664c3-c04e-4d42-ae64-13d1b84dc6e7",
                                "sense_id": "f8448fdb-189b-3e52-ba9a-6aaf6a0c4b1f",
                                "text": "En imprimerie, la pliure est le stade du façonnage qui consiste à plier la feuille pour obtenir des cahiers afin de restituer la mise en pages, avant le massicotage."
                            },
                            {
                                "example_id": "30c5a957-ab90-46bc-83a7-75e256168f72",
                                "sense_id": "f8448fdb-189b-3e52-ba9a-6aaf6a0c4b1f",
                                "text": "Avec un pinceau ombreur biseauté, appliquez une ombre fonçée sur la pliure de la paupière."
                            }
                        ]
                    }
                ],
