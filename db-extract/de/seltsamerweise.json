                        "entry_id": "8b805d22-ce3d-36a4-afe5-75c3ff813843",
                        "glosses": [
                            "seltsam, eigenartig erscheinend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7ea6d08-062a-46ee-9d35-acc7e2f96af9",
                                "sense_id": "db735d6a-d3f0-3e59-9216-a2b4597bb297",
                                "text": "Seltsamerweise hat er sich nicht mehr gemeldet."
                            },
                            {
                                "example_id": "bf07815e-863d-4a2e-9aec-38ca0fe712ee",
                                "sense_id": "db735d6a-d3f0-3e59-9216-a2b4597bb297",
