                ],
                "senses": [
                    {
                        "sense_id": "3dc36fc7-7c18-3b74-9a06-5d25440ae46f",
                        "entry_id": "bee23232-f9ce-3b99-99a9-3843a641618a",
                        "glosses": [
                            "Speiseeis, meist auf Milchbasis, mit Pistaziengeschmack"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b90c810d-81b7-43a4-b4d0-56e71b43368c",
                                "sense_id": "3dc36fc7-7c18-3b74-9a06-5d25440ae46f",
                                "text": "„Auch die Menschen, die nicht da gewohnt hatten, schwärmten vom Pistazieneis, das sie als Kinder auf der Insel bekommen hatten, und den Feigen, die auf ihr wuchsen.“"
                            },
                            {
                                "example_id": "4b25da22-6b43-4a2f-b8e3-2b0736ea7954",
                                "sense_id": "3dc36fc7-7c18-3b74-9a06-5d25440ae46f",
                                "text": "„Während sie sich für Gianduja mit Erdbeere entscheidet, holt er das frische Pistazieneis aus der Eismaschine, für das sie ausgewählte Nüsse selbst rösten und mahlen.“"
                            },
                            {
                                "example_id": "ade63b35-3f2e-40bd-92f4-1f5a91b245cb",
                                "sense_id": "3dc36fc7-7c18-3b74-9a06-5d25440ae46f",
                                "text": "„Ich stehe nachts in einer Gasse in Rom und halte eine Waffel mit einer riesigen Portion Pistazieneis in meiner Hand.“"
                            },
                            {
                                "example_id": "1e36aab7-348e-463d-9c3e-6c852b2c96ae",
                                "sense_id": "3dc36fc7-7c18-3b74-9a06-5d25440ae46f",
                                "text": "„Auf den ersten Platz kam der Italiener Alessandro Crispini aus Spoleto in Umbrien, der sich mit einem schlichten Pistazieneis durchsetzte.“"
                            },
                            {
                                "example_id": "7cbbd331-d5b5-4cde-8b26-696eb2da1618",
                                "sense_id": "3dc36fc7-7c18-3b74-9a06-5d25440ae46f",
                                "text": "„Es mag etwas altmodisch erscheinen, aber die Kombination aus Pfirsich, Champagner (Sabayon, Anm.) und Pistazieneis ist noch immer hochaktuell.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
