                                    {
                                        "sense_id": "bf7f15d4-5a21-3f00-9f4f-64459bd0448a",
                                        "entry_id": "51c3ca04-61ec-3f62-ad4b-0689d9481cda",
                                        "glosses": [
                                            "leicht zu biegen, elastisch; von Personen: beweglich, gelenkig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff75093-53e2-4170-b439-4629e8ca356f",
                                                "sense_id": "bf7f15d4-5a21-3f00-9f4f-64459bd0448a",
                                                "text": "Zweige und Äste von Weiden sind sehr biegsam."
                                            },
                                            {
                                                "example_id": "15995a80-0795-4577-8d85-cd0c560e451c",
                                                "sense_id": "bf7f15d4-5a21-3f00-9f4f-64459bd0448a",
                                                "text": "Wer Yoga oder Gymnastik lang genug macht, wird sehr biegsam."
                                            },
                                            {
                                                "example_id": "77ba766c-08d6-48ee-ba3b-92e8e4921cee",
                                                "sense_id": "bf7f15d4-5a21-3f00-9f4f-64459bd0448a",
                                                "text": "Der Name [des Baumes] Linde leitet sich vom althochdeutschen lindi ab, was so viel bedeutet wie \"biegsam\"."
                                            },
                                            {
                                                "example_id": "43876aa4-6fa9-4ac4-91b6-57731ce0b71a",
                                                "sense_id": "bf7f15d4-5a21-3f00-9f4f-64459bd0448a",
                                                "text": "Die [kermaischen] Fasern widerstehen sehr hohen Temperaturen, sind rund, stark, biegsam, durchscheinend, können verwebt werden und sind gegen chemischen Angriff beständig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
