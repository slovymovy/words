                "senses": [
                    {
                        "sense_id": "f1bda528-0e56-3c93-bb5f-eaf5c748946c",
                        "entry_id": "996cbb5c-e0a1-329f-9d05-d3f836b65f73",
                        "glosses": [
                            "Région du Péloponnèse, canton de la Cynurie, située entre l’Argolide et la Laconie, dont la capitale est Thyrée."
                        ],
                        "tags": [
                            "Ancient",
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "324fc721-37cb-488d-be13-d42283565843",
                                "sense_id": "f1bda528-0e56-3c93-bb5f-eaf5c748946c",
                                "text": "La Thyréatide confine à l’Argie et à la Laconie, et aboutit à la mer. Une partie des Éginètes s’y établit : les autres se dispersèrent dans le reste de l’Hellade."
                            },
                            {
                                "example_id": "4e728fd8-0a63-46c7-a7a9-669b4f3bf47e",
                                "sense_id": "f1bda528-0e56-3c93-bb5f-eaf5c748946c",
                                "text": "Lorsque Danaüs, débarqué sur leurs terres [aux Argiens], s’avançait vers Argos, il vit, près de Pyramies en Thyréatide, un loup qui se battait contre un taureau."
                            }
                        ]
                    }
                ],
