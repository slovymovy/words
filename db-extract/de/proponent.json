                                "sense_id": "cd679bde-2fcb-327e-a908-79b58f89d0e0",
                                "text": "Viele Proponenten der Umweltbewegung traten oft gar zu missionarisch und asketisch auf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7511c9e0-9d79-30ba-94bc-cb6a9194dd43",
                        "entry_id": "fd4022a5-dbc2-3937-9c31-e014017464af",
