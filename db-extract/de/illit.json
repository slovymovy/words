                "senses": [
                    {
                        "sense_id": "74ac4531-2a60-3678-8728-c2099a629df7",
                        "entry_id": "a2713ccc-58bc-304f-a355-29c2c3198ab4",
                        "glosses": [
                            "dem Glimmer strukturell ähnliches Tonmineral"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "1a1a6972-fbc2-4dd1-b99b-1c8ded76081c",
                                "sense_id": "74ac4531-2a60-3678-8728-c2099a629df7",
                                "text": "„Dies führte dazu, dass die am Caldera-Grund abgelagerten Smektite – Schichtsilikate mit eingelagertem Magnesium – sich in Illit umwandelten.“"
                            },
                            {
                                "example_id": "31fad5b0-1143-426d-b50b-cd0667bc756b",
                                "sense_id": "74ac4531-2a60-3678-8728-c2099a629df7",
                                "text": "„Trioktaedrische Dreischichtminerale ohne Quellfähigkeit sind Talk, Biotit und trioktaedrischer Illit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
