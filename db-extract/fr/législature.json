                        ]
                    },
                    {
                        "translation_id": "0c7d5bff-b0db-41f5-85d7-95b72e58e0b5",
                        "source_entry_id": "b0ff4c10-855a-3689-b5de-b43160c98a00",
                        "source_sense_description": "Session d'une assemblée législative",
                        "target_lang_word": "parliament",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parliament",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88c614a0-936b-3374-9cde-00d403f7ef8e",
                                        "entry_id": "ac77b2ce-a1b9-3d54-b62a-ca8b92eb4737",
                                        "glosses": [
                                            "A formal council summoned (especially by a monarch) to discuss important issues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea296787-2429-42fb-97e7-a65765485df3",
                                                "sense_id": "88c614a0-936b-3374-9cde-00d403f7ef8e",
                                                "text": "By the 13th Century, a parliament was when kings met up with English barons to raise cash for fighting wars - mostly against Scotland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48bca385-be6d-3874-bb76-7be996604567",
                                        "entry_id": "ac77b2ce-a1b9-3d54-b62a-ca8b92eb4737",
                                        "glosses": [
                                            "In many countries, the legislative branch of government, a deliberative assembly or set of assemblies whose elected or appointed members meet to debate the major political issues of the day, make, amend, and repeal laws, authorize the executive branch of government to collect and spend money, and in some cases exercise judicial powers; a legislature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7ad976-d556-4e01-87c8-2e5004bdb170",
                                                "sense_id": "48bca385-be6d-3874-bb76-7be996604567",
                                                "text": "The row started over who will run for parliament in a wealthy rightwing constituency on the left bank in Paris, a safe seat for Sarkozy's ruling UMP."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e56f9076-236c-349e-a2ef-f5f44c5aaf70",
                                        "entry_id": "ac77b2ce-a1b9-3d54-b62a-ca8b92eb4737",
                                        "glosses": [
                                            "A particular assembly of the members of such a legislature, as convened for a specific purpose or period of time (commonly designated with an ordinal number – for example, first parliament or 12th parliament – or a descriptive adjective – for example, Long Parliament, Short Parliament and Rump Parliament)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f80082e-8dd8-4987-b1fb-984317985c41",
                                                "sense_id": "e56f9076-236c-349e-a2ef-f5f44c5aaf70",
                                                "text": "Following the general election, Jane Doe took her oath of office as a member of the nation's fifth parliament."
                                            },
                                            {
                                                "example_id": "630eca86-a7b3-4e61-b3ce-025a1f2806b0",
                                                "sense_id": "e56f9076-236c-349e-a2ef-f5f44c5aaf70",
                                                "text": "The acts made in the first Parliament of our most high and dread soveraigne Charles, by the grace of God, King of Great Britaine, France, and Ireland, defender of the faith, &c. […]"
                                            },
                                            {
                                                "example_id": "deed93ea-a475-4d56-8fce-03ae0fa2fe78",
                                                "sense_id": "e56f9076-236c-349e-a2ef-f5f44c5aaf70",
                                                "text": "[T]he army under Lambert again thrust the Rump Parliament out of doors, and commenced a new military government, by means of a committee of officers, called the Council of Safety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8c6c99-cc59-3593-b46c-df922b5e29d4",
                                        "entry_id": "ac77b2ce-a1b9-3d54-b62a-ca8b92eb4737",
                                        "glosses": [
                                            "A gathering of birds, especially rooks or owls."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7305b3ad-51b0-4073-9179-59512cf4dfb0",
                                                "sense_id": "1b8c6c99-cc59-3593-b46c-df922b5e29d4",
                                                "text": "\"The people at home call it a rook's parliament when a whole crowd of rooks settle on some bare, wide common, and sit there as if they were consulting, not feeding, only stalking about with drooping wings, and solemn black cloaks.\""
                                            },
                                            {
                                                "example_id": "9e36d9ab-4891-4a42-b35d-8fcede35b2ed",
                                                "sense_id": "1b8c6c99-cc59-3593-b46c-df922b5e29d4",
                                                "text": "Man is not the random collection of atoms with no opportunity for redemption. A mere school of fish, a gaggle of geese, a pride of lions, and a congress of baboons—am I to believe these lower primates are my ancestors? And if I should ask a parliament of owls, what might they say?"
                                            },
                                            {
                                                "example_id": "e53480c1-6fae-47b2-9dec-c1baa408b635",
                                                "sense_id": "1b8c6c99-cc59-3593-b46c-df922b5e29d4",
                                                "text": "He'd seen a parliament of rooks a hundred strong fall on and kill one of their number amongst the nodding barley rows, and had been shown a yew that had the face of Jesus in its bark."
                                            },
                                            {
                                                "example_id": "eb0eb680-b47c-46a8-9ff8-dd4eb78fa245",
                                                "sense_id": "1b8c6c99-cc59-3593-b46c-df922b5e29d4",
                                                "text": "A group of owls is called a parliament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb48182b-dcb4-339e-9930-cde43b98a774",
                                        "entry_id": "ac77b2ce-a1b9-3d54-b62a-ca8b92eb4737",
                                        "glosses": [
                                            "Parliament cake, a type of gingerbread."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2bb9d2-0a40-49af-9160-cd9db66f25e4",
                                                "sense_id": "cb48182b-dcb4-339e-9930-cde43b98a774",
                                                "text": "He […] was disposed to spoil little Georgy, sadly gorging the boy with apples and parliament, to the detriment of his health—until Amelia declared that George should never go out with his grandpapa unless the latter promised solemnly, and on his honour, not to give the child any cakes, lollipops, or stall produce whatever."
                                            },
                                            {
                                                "example_id": "15ae114f-0e19-4226-b9dc-67e05bc9e4e5",
                                                "sense_id": "cb48182b-dcb4-339e-9930-cde43b98a774",
                                                "text": "A certain boy leaning up against me would not allow my elbow room, and struck me very sadly in the stomach part, though his own was full of my parliament."
                                            },
                                            {
                                                "example_id": "e0b3ab2c-7f3b-40c8-9717-af9d70ddd048",
                                                "sense_id": "cb48182b-dcb4-339e-9930-cde43b98a774",
                                                "text": "The children had long ago found out that the kites and shuttlecocks were failures; and popular rumour spoke in deprecating terms of the parliament and gingerbread in general, comparing it to petrified sponge, or slices of pumice stone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
