                        "examples": [
                            {
                                "example_id": "672da6cb-2599-4383-aaaa-18da1e101ba8",
                                "sense_id": "031046ff-e900-30c5-92a5-1e6175241783",
                                "text": "Textielconcern TenCate gaat de kunstgrasvelden aanleggen voor de eerste divisie voetbal. De kunstgrasproducent is uit een aantal bedrijven uitgekozen door de Coöperatie Eerste Divisie (CED). Deze zomer worden de eerste voetbalvelden aangelegd."
                            },
                            {
                                "example_id": "0dcbbeec-6a98-4bb9-953f-c84a3d33667c",
                                "sense_id": "031046ff-e900-30c5-92a5-1e6175241783",
                                "text": "Het ROC is ondergebracht in twee gebouwen in Leiden. Een prestigieus pand in Leiden Lammenschans werd in 2011 opgeleverd. Het gebouw dat 75 miljoen euro had gekost werd verkocht aan investeerder Green Real Estate van het textielconcern Zeeman, die het vervolgens terug verhuurde aan het ROC voor 3,1 miljoen euro per jaar."
                            }
                        ]
                    }
