                    },
                    {
                        "translation_id": "6b59f47b-a40e-4059-bc40-7bcb0f02ea19",
                        "source_entry_id": "ffeb43b7-65c8-3652-9354-0b042679b2f9",
                        "source_sense_id": "559e16c2-c9b2-3f63-9c0b-a4033b350b40",
                        "target_lang_word": "Krakelee",
