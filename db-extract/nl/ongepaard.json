                    {
                        "sense_id": "9901f388-941b-38ac-a487-7e46b8d95ff6",
                        "entry_id": "8e6690bd-7a4a-3dca-826d-3e75af182799",
                        "glosses": [
                            "van iets dat het vrij en ongebonden is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f20b0a-2c04-4bb8-848f-392c850b8f73",
                                "sense_id": "9901f388-941b-38ac-a487-7e46b8d95ff6",
                                "text": "Alcohol wordt in het lichaam omgezet in het giftige aceetaldehyde. ALDH2 breekt deze stof af. Het enzym breekt echter ook andere schadelijke aldehyden af. Deze ontstaan onder andere als vetten worden blootgesteld aan zuurstofradicalen. Zuurstofradicalen zijn moleculen met een ongepaard elektron die weefselschade veroorzaken. Doordat de activiteit van ALDH2 door de alcoholconsumptie is verhoogd, kan het enzym dus ook sneller die andere aldehyden aanpakken."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d5dd1e7-ee60-38c0-ba38-d267e2d792e3",
                        "entry_id": "8e6690bd-7a4a-3dca-826d-3e75af182799",
                        "glosses": [
                            "zonder partner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bee6b98-9318-48ce-9ad7-ac1f0cc5c3c8",
                                "sense_id": "3d5dd1e7-ee60-38c0-ba38-d267e2d792e3",
                                "text": "Elke ‘ongepaarde’ DNA-keten weet feilloos zijn complementaire partner uit een zee van DNA-strengen te vinden."
                            },
                            {
                                "example_id": "697e10f7-41a2-4d35-8480-15a21d450f10",
                                "sense_id": "3d5dd1e7-ee60-38c0-ba38-d267e2d792e3",
                                "text": "Raven, die in Nederland zeldzaam zijn, leven van kadavers. Een ravenpaar heeft een groot, stabiel territorium. Daarnaast zijn er groepen ongepaarde raven die geen territorium hebben en concurreren om dezelfde kadavers."
                            }
                        ]
                    }
