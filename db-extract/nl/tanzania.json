                                        "sense_id": "2c54216a-92a4-3658-b8ed-0c4070b16304",
                                        "entry_id": "4b218454-5cb4-3d30-8613-5de07c741383",
                                        "glosses": [
                                            "A country in East Africa. Official name: United Republic of Tanzania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb90b31-4efb-46c4-9aa7-e655d8f15e99",
                                                "sense_id": "2c54216a-92a4-3658-b8ed-0c4070b16304",
                                                "text": "A normally bustling border crossing between Tanzania and Malawi was noticeably quieter than usual on Thursday as a result of an escalating regional trade row."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ea47cb2-a084-4c6e-a63d-fc262cca203b",
                        "source_entry_id": "0dca3497-5ba4-3194-b125-33ebe880a5e8",
                        "source_sense_id": "48bf7efc-6d51-392b-9ec9-2793dc8b9c5b",
                        "source_sense_description": "een land in Oost-Afrika",
                        "target_lang_word": "Tanzanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
