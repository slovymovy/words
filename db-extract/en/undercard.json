                        "entry_id": "4bbb9166-53f2-36e4-828d-6c7858406cad",
                        "glosses": [
                            "A list of minor or supporting contests printed on the same bill as the main event (primarily fighting or racing, such as the main fight at a boxing match or wrestling, horse or car racing, etc.), occurring before or after the main event."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f8b6c33-acdb-45e9-91be-8015f110411c",
                                "sense_id": "5b334b54-5381-3248-882e-32d141cf3fec",
                                "text": "Phil Foden can hardly be called a member of Manchester City's undercard given his consistent brilliance, but his precious value was underlined again with a show of dazzling brilliance against Aston Villa."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b112a53-1da7-312a-81b0-4e36f4b4b12e",
                        "entry_id": "4bbb9166-53f2-36e4-828d-6c7858406cad",
                        "glosses": [
                            "The events so listed."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ef729d62-ec63-39f3-99e1-81380d460a59",
                        "entry_id": "4bbb9166-53f2-36e4-828d-6c7858406cad",
                        "glosses": [
                            "A card lower than another given card or pair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe351fc-521a-4b6f-beb9-88a36656b540",
                                "sense_id": "ef729d62-ec63-39f3-99e1-81380d460a59",
                                "text": "The eight on the turn was another undercard to her pair of nines"
                            }
                        ]
                    },
