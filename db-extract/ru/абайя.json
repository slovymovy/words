                            {
                                "example_id": "5563771e-ccf9-4898-a7d8-b42c5c475ed9",
                                "sense_id": "e450d4da-3033-3c35-843e-b610d64be2fb",
                                "text": "На ней была абайя, одолженная у служанки, но она являлась единственной женщиной в группе людей, пришедших на приём к эмиру."
                            }
                        ]
                    }
                ],
