{
    "word_family": [
        "gluipen",
        "gluiperd",
        "gluiperigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e682ad2-3f35-3722-b538-89a85e40fc70",
                    "sense_definition": "Op een stiekeme, onbetrouwbare manier handelend of karakteriserend; achterbaks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gluiperige</w> jongen kun je absoluut niet vertrouwen.",
                            "target_lang_translations": {
                                "en": "You absolutely cannot trust that <w>sneaky</w> boy."
                            }
                        },
                        {
                            "text": "Hij deed dat met een <w>gluiperige</w> lach op zijn gezicht.",
                            "target_lang_translations": {
                                "en": "He did that with a <w>sly</w> smile on his face."
                            }
                        }
                    ],
                    "synonyms": [
                        "huichelachtig",
                        "onoprecht",
                        "doortrapt"
                    ],
                    "antonyms": [
                        "oprecht",
                        "eerlijk"
                    ],
                    "common_phrases": [
                        "gluiperige lach",
                        "gluiperige streek"
                    ],
                    "target_lang_definitions": {
                        "en": "Acting or characterizing in a sneaky, untrustworthy, or underhanded manner; deceitful."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sneaky",
                                "target_lang_sense_clarification": "acting in a secretive and dishonest way"
                            },
                            {
                                "target_lang_word": "underhanded",
                                "target_lang_sense_clarification": "done in a secret or dishonest way"
                            },
                            {
                                "target_lang_word": "deceitful",
                                "target_lang_sense_clarification": "guilty of or involving deceit; untrustworthy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "835b2e01-b9bc-3bb6-9c02-04acb688b082",
                    "sense_definition": "Op een bedekte, schijnbaar vriendelijke of onderdanige manier gemene of achterbakse dingen doend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>gluiperige</w> gedrag zorgde voor veel wantrouwen op de werkvloer.",
                            "target_lang_translations": {
                                "en": "His <w>underhanded</w> behavior caused a lot of distrust in the workplace."
                            }
                        },
                        {
                            "text": "Het was een <w>gluiperige</w> actie om achter mijn rug om met de baas te praten.",
                            "target_lang_translations": {
                                "en": "It was a <w>sneaky</w> move to talk to the boss behind my back."
                            }
                        }
                    ],
                    "synonyms": [
                        "listig",
                        "gemeen",
                        "gehaaid"
                    ],
                    "antonyms": [
                        "recht door zee"
                    ],
                    "common_phrases": [
                        "gluiperig gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "Doing mean or underhanded things in a covert, seemingly friendly, or submissive manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sly",
                                "target_lang_sense_clarification": "having or showing a cunning and deceitful nature"
                            },
                            {
                                "target_lang_word": "insidious",
                                "target_lang_sense_clarification": "proceeding in a gradual, subtle way, but with harmful effects"
                            },
                            {
                                "target_lang_word": "crafty",
                                "target_lang_sense_clarification": "clever at achieving one's aims by deceitful or evasive methods"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}