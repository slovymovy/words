    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2230335-cd35-333d-9c61-3d24431b620c",
                    "sense_definition": "Personne née après une autre dans une même famille, ou personne plus jeune qu'une autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>cadet</w> de la famille a toujours été passionné par le dessin et la peinture."
                        },
                        {
                            "text": "Elle a épousé un collègue qui a cinq ans de moins qu'elle et reste son <w>cadet</w>."
                        }
                    ],
                    "synonyms": [
                        "puîné",
                        "benjamin"
                    ],
                    "antonyms": [
                        "aîné"
                    ],
                    "common_phrases": [
                        "le cadet de la famille"
                    ]
                },
                {
                    "sense_id": "cb4a619e-dc89-3579-b7a2-8f0510a51a16",
                    "sense_definition": "Élève d'une école militaire, policière ou aéronautique se préparant à devenir officier ou pilote.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "formation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque jeune <w>cadet</w> doit respecter une discipline très stricte pendant toute sa formation militaire."
                        },
                        {
                            "text": "La compagnie aérienne a sélectionné une trentaine de <w>cadets</w> pour piloter ses nouveaux appareils."
                        }
                    ],
                    "common_phrases": [
                        "école de cadets"
                    ]
                },
                {
                    "sense_id": "f3ddcc29-23f7-3b78-ac65-243dd410b9f0",
                    "sense_definition": "Jeune sportif appartenant à une catégorie d'âge comprise généralement entre minime et junior.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre club de football compte cette saison une équipe de <w>cadets</w> particulièrement performante."
                        },
                        {
                            "text": "Les meilleurs <w>cadets</w> de la région se réuniront ce week-end pour disputer la finale nationale."
                        }
                    ],
                    "common_phrases": [
                        "championnat des cadets"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d111864-c0b7-3fc4-a7f9-2c433c9e92e2",
                    "sense_definition": "Qui est né après l'aîné dans une même fratrie, qui est plus jeune.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère <w>cadet</w> a commencé ses études universitaires à Paris l'année dernière."
                        },
                        {
                            "text": "Elle prend souvent le temps d'aider sa sœur <w>cadette</w> à faire ses devoirs scolaires."
                        }
                    ],
                    "synonyms": [
                        "puîné",
                        "benjamin"
                    ],
                    "antonyms": [
                        "aîné",
                        "premier-né"
                    ],
                    "common_phrases": [
                        "frère cadet",
                        "fils cadet",
                        "soeur cadette",
                        "branche cadette"
                    ]
                },
                {
                    "sense_id": "96a87117-af1b-36b1-b1ba-4d79579d52ce",
                    "sense_definition": "Le moindre ou le tout dernier dans l'ordre d'importance, principalement dans l'expression figurée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les remarques désobligeantes de ses voisins sont bien le <w>cadet</w> de ses soucis quotidiens."
                        },
                        {
                            "text": "Le coût de cette réparation imprévue était le <w>cadet</w> de mes soucis à ce moment-là."
                        }
                    ],
                    "common_phrases": [
                        "le cadet de mes soucis",
                        "le cadet de ses soucis"
                    ]
                }
            ]
        }
    ]
}