                ],
                "senses": [
                    {
                        "sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                        "entry_id": "817f8a07-0b84-3476-88af-9c51c4d4aba4",
                        "glosses": [
                            "erstes sprachliches Element eines Satzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82dbc440-8940-4168-b57a-a967adf6b56b",
                                "sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                                "text": "Den Satzanfang kann man unterschiedlich bestimmen als der erste Laut oder Buchstabe, das erste Phonem, das erste Wort, das erste Satzglied undsoweiter eines Satzes."
                            },
                            {
                                "example_id": "0defb5d2-94bc-4a1c-84c8-6053d5f36b3f",
                                "sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                                "text": "Ein Stirnsatz ist dadurch definiert, dass in ihm das Prädikat am Satzanfang erscheint."
                            },
                            {
                                "example_id": "4c4eb785-d512-4fd5-b459-fa780db9a8a2",
                                "sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                                "text": "„Wir schreiben nicht nur Namen und Wörter am Satzanfang groß, sondern auch alle Substantive.“"
                            },
                            {
                                "example_id": "1033a09a-ddd4-4e1d-934b-64da96ddf718",
                                "sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                                "text": "„Abkürzungen, die für mehr als ein Wort stehen, sollten am Satzanfang ausgeschrieben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db6ae127-49a5-40db-8470-e963e02f0eb0",
                        "source_entry_id": "817f8a07-0b84-3476-88af-9c51c4d4aba4",
                        "source_sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                        "source_sense_description": "Linguistik: erstes sprachliches Element eines Satzes",
                        "target_lang_word": "beginning of a sentence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d6851bea-9c6b-4f1c-8d63-57a92de2ad43",
                        "source_entry_id": "817f8a07-0b84-3476-88af-9c51c4d4aba4",
                        "source_sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                        "source_sense_description": "Linguistik: erstes sprachliches Element eines Satzes",
                        "target_lang_word": "début",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "début",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Commencement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e06834d-2260-4e17-a435-255e61c0b737",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "Le café noir très fort qu’il a pris au début de la veille, empêche Arsène André de s’endormir."
                                            },
                                            {
                                                "example_id": "1aef38a6-7cad-4a7d-a068-3a1b0d0d0158",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "Après des débuts réussis, le FC Nantes s’est sèchement incliné, jeudi, (3-0) sur la pelouse du FC Qarabag, à Bakou (Azerbaïdjan)."
                                            },
                                            {
                                                "example_id": "1d836899-fbed-46a5-8f28-d927eee2cfd5",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "C’est après avoir su nous remettre complètement dans le bain que Peter Jakcson nous ramène là où il nous avait laissé, autrement dit dans la Comté. En créant de manière subtile le lien entre ce film et le début de La Communauté de l’anneau, il nous prouve une fois encore qu’il a tout compris au principe d’adaptation."
                                            },
                                            {
                                                "example_id": "d095bc69-40af-428e-b563-19cc023da2f5",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "Accroche-cœur –\nAux larmes de cendre,\nelle regarda\nla rouflaquette de l’écrin,\nsouvenir\nd’une époque crépusculaire,\npeu avant le début\n…\nde sa chimiothérapie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Premiers essais sur les planches, au théâtre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63c32846-d0a9-4ed2-846c-d4b15abdacd3",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Un rôle de début."
                                            },
                                            {
                                                "example_id": "ae6ba40c-db7c-4ef7-a7b4-38da01d70a48",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Premier, second début."
                                            },
                                            {
                                                "example_id": "07122021-91fb-43b9-8183-c7c22d69de6a",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Il a obtenu un ordre de début."
                                            },
                                            {
                                                "example_id": "c982e4ed-a21c-4f37-b078-e4de196ab8ba",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Cet acteur a terminé ses débuts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "398990d4-a567-3674-b214-09d1e2d2bf92",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Premier ouvrage d’un auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13a6aa9-ded2-442e-ba50-daba9249edba",
                                                "sense_id": "398990d4-a567-3674-b214-09d1e2d2bf92",
                                                "text": "Mélite fut le début de Corneille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "107f5879-0558-30cb-9513-940571056b8d",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Départ dans la vie, dans une profession ou dans une entreprise."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a1703e9-baa2-4377-86f0-1c190bc3d03b",
                                                "sense_id": "107f5879-0558-30cb-9513-940571056b8d",
                                                "text": "Vraiment, par expérience, je plains le jeune prêtre que l’on envoie, pour ses débuts, évangéliser la Beauce."
                                            },
                                            {
                                                "example_id": "f58e1593-7eb4-4ed6-8081-1b510dcba57d",
                                                "sense_id": "107f5879-0558-30cb-9513-940571056b8d",
                                                "text": "Cet avocat n’a pas réalisé les espérances que son début avait fait concevoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e2a233a-085e-483c-b967-7dab73a6e22b",
                        "source_entry_id": "817f8a07-0b84-3476-88af-9c51c4d4aba4",
                        "source_sense_id": "4d6076b2-6d16-3ae1-9153-48360cb288fc",
                        "source_sense_description": "Linguistik: erstes sprachliches Element eines Satzes",
                        "target_lang_word": "phrase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phrase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                        "entry_id": "896af903-6abb-37c4-b9bb-504ddb29f245",
                                        "glosses": [
                                            "Séquence de propositions ordonnées en fonction des règles de la grammaire, permettant de décrire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ecdb4e0-4c83-4b1e-a3c2-1313a727bd2f",
                                                "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                                "text": "On n'est jamais captivé par des phrases où il y a trop de mots."
                                            },
                                            {
                                                "example_id": "d8c88284-2e1f-4e34-85cd-ac7a8f5f332a",
                                                "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                                "text": "Puis, en grosses lettres, cette phrase : « Plus il y aura d'acheteurs de blé, meuniers ou négociants, plus les agriculteurs vendront le leur facilement et cher. »\nIl est hors de contestation que, si des éléments de concurrence nouveaux devaient surgir, le cultivateur y trouverait son compte."
                                            },
                                            {
                                                "example_id": "e4950276-23c6-47dc-a5c5-2a3de83be66e",
                                                "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                                "text": "Lui qui, d’habitude, d’une plume sûre, attaquait méthodiquement le papier, s’exténuait sur ses phrases. Il peinait, raturait."
                                            },
                                            {
                                                "example_id": "0e809855-d9fd-41c1-9cdd-ace28b9296b6",
                                                "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                                "text": "Elle parlait intarissablement, mêlant quelques mots de français dans chacune de ses phrases : sur Louxor […] sur Alexandrie."
                                            },
                                            {
                                                "example_id": "eab96c16-5776-4de5-9663-42a6d351a132",
                                                "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                                "text": "Je n’y ai guère trouvé de phrases qui n’aient au moins une demi-page de longueur et il y en a beaucoup qui couvrent une page et demie."
                                            },
                                            {
                                                "example_id": "d71396a0-3f74-4665-aac1-2f40ce1a6cb9",
                                                "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                                "text": "Il a lancé l'idée comme ça, un jour, un journaliste a sorti la phrase de son contexte, et un tas d’escrocs et de faux médiums se sont mis à prétendre en posséder un, pour que les imbéciles croient parler à leurs proches décédés."
                                            },
                                            {
                                                "example_id": "7fd60ac6-5b2f-4a06-bb06-d0469ad74504",
                                                "sense_id": "358af59d-a4b9-39b0-b464-10f8f2b9a036",
                                                "text": "Karl Kraus « démasque la société à l’aide de la langue », écrit le philosophe et sociologue Max Horkheimer, car « c’est le massacre des mots et des phrases qui lui révèle la déshumanisation des hommes et des relations entre eux, la destruction de l’esprit par la valeur marchande »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7170eae-72ac-34ab-a0ec-53855ed77214",
                                        "entry_id": "896af903-6abb-37c4-b9bb-504ddb29f245",
                                        "glosses": [
                                            "Ensemble de quelques mots prononcés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4924ac44-5d69-4c98-bb28-7b6a9922627f",
                                                "sense_id": "b7170eae-72ac-34ab-a0ec-53855ed77214",
                                                "text": "Et on entend encore résonner la phrase banale du mari, la phrase étrangère à elle, la phrase blasphématoire dans cette chambre où elle apporte sa nudité."
                                            },
                                            {
                                                "example_id": "c52c1dd2-14f6-4fc6-9fdd-8f97e96124fe",
                                                "sense_id": "b7170eae-72ac-34ab-a0ec-53855ed77214",
                                                "text": "[…] il leur faut des électeurs ouvriers assez naïfs pour se laisser duper par des phrases ronflantes sur le collectivisme futur."
                                            },
                                            {
                                                "example_id": "d882ff93-5041-46ca-b6af-6446677d1abe",
                                                "sense_id": "b7170eae-72ac-34ab-a0ec-53855ed77214",
                                                "text": "Personne ne pouvait prononcer une phrase, dire un mot, apprécier un argument, juger un fait sans qu’aussitôt les autres ne demandassent : « la conclusion » ?"
                                            },
                                            {
                                                "example_id": "387df6d9-8076-4ce6-842f-43c90ce234ad",
                                                "sense_id": "b7170eae-72ac-34ab-a0ec-53855ed77214",
                                                "text": "Il eût fallu hurler pour échanger la moindre phrase."
                                            },
                                            {
                                                "example_id": "84f552c6-12cb-4bd1-84c0-b234202cb49c",
                                                "sense_id": "b7170eae-72ac-34ab-a0ec-53855ed77214",
                                                "text": "C'est cette rupture dans le savoir - […] - qui a fait de Galilée le symbole même du scientifique, et comme toute figure emblématique, une part de mythe lui est rattachée (on lui attribue notamment cette fameuse phrase – qui précisément n'aurait pas été murmurée – juste après sa condamnation « Et pourtant elle tourne » comme preuve de sa ténacité scientifique)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e56a6e7c-2857-39a3-9cab-347e9ee946c5",
                                        "entry_id": "896af903-6abb-37c4-b9bb-504ddb29f245",
                                        "glosses": [
                                            "Suite non interrompue de sons simples ou d’accords, qui forme un sens plus ou moins achevé et qui se termine sur un repos."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9cf52ae-2106-4129-afaf-b65367a6aa77",
                                                "sense_id": "e56a6e7c-2857-39a3-9cab-347e9ee946c5",
                                                "text": "Le roulier lui mit du foin sur le corps, et, pour ne pas s'endormir lui-même, il se prit à siffler à satiété une phrase de chanson lente et monotone ; […]. Cette sifflerie m'impatientait."
                                            }
                                        ]
                                    }
                                ]
