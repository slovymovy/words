{
    "word_family": [
        "личность",
        "личный",
        "лицевой"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "55ca3389-8e2c-3d89-86d5-7f9c8479891e",
                    "sense_definition": "Сам, непосредственно, без посредников или участия третьих лиц.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор хочет <лично> проверить все документы перед их отправкой.",
                            "target_lang_translations": {
                                "en": "The director wants to check all documents <personally> before sending them.",
                                "zh": "经理在发送文件前想<w>亲自</w>检查一遍。"
                            }
                        },
                        {
                            "text": "Мы с ним <лично> знакомы уже много лет и часто общаемся.",
                            "target_lang_translations": {
                                "en": "We have known him <personally> for many years and talk often.",
                                "zh": "我们<w>亲自</w>认识很多年了，经常联系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "персонально",
                        "сам"
                    ],
                    "common_phrases": [
                        "лично знаком",
                        "встретиться лично",
                        "убедиться лично"
                    ],
                    "target_lang_definitions": {
                        "en": "Done directly by the person themselves, without intermediaries or third parties.",
                        "zh": "指某人亲自去做某事，不通过他人或中介。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "personally",
                                "target_lang_sense_clarification": "by oneself"
                            },
                            {
                                "target_lang_word": "in person",
                                "target_lang_sense_clarification": "face-to-face"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲自",
                                "target_lang_sense_clarification": "指本人直接参与"
                            },
                            {
                                "target_lang_word": "当面",
                                "target_lang_sense_clarification": "指面对面地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfb46b6c-5b00-3d5b-82d0-943838b242d6",
                    "sense_definition": "Что касается конкретно данного человека (употребляется для выделения субъекта, часто с местоимениями я, ты, он).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне <лично> этот фильм показался слишком затянутым и скучным.",
                            "target_lang_translations": {
                                "en": "<Personally>, I found this film too long and boring.",
                                "zh": "<w>个人</w>觉得这部电影太拖沓、太无聊了。"
                            }
                        },
                        {
                            "text": "Что <лично> вы думаете по поводу сложившейся ситуации?",
                            "target_lang_translations": {
                                "en": "What do you <personally> think about the current situation?",
                                "zh": "关于目前的情况，您<w>个人</w>怎么看？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "я лично",
                        "мне лично",
                        "лично для меня"
                    ],
                    "target_lang_definitions": {
                        "en": "As regards a specific person (used to emphasize the subject's specific opinion or stance).",
                        "zh": "用于强调某人对某事物的个人观点或立场。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "personally",
                                "target_lang_sense_clarification": "speaking for oneself"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "个人",
                                "target_lang_sense_clarification": "指就自己而言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beed3ada-ce15-339a-847e-16a4891f79cc",
                    "sense_definition": "В индивидуальном порядке; касаясь частной жизни, чувств или отдельных свойств человека.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, не воспринимайте эту критику <лично>, речь идёт только о работе.",
                            "target_lang_translations": {
                                "en": "Please do not take this criticism <personally>, it is only about work.",
                                "zh": "请不要把这些批评<w>个人</w>化，这只是针对工作。"
                            }
                        },
                        {
                            "text": "К каждому клиенту мы подходим <лично>, учитывая все его пожелания.",
                            "target_lang_translations": {
                                "en": "We approach every client <personally>, taking into account all their wishes.",
                                "zh": "我们针对每位客户提供<w>个人</w>化服务，充分考虑他们的需求。"
                            }
                        }
                    ],
                    "synonyms": [
                        "индивидуально"
                    ],
                    "common_phrases": [
                        "воспринимать лично",
                        "принимать лично"
                    ],
                    "target_lang_definitions": {
                        "en": "In an individual manner; concerning one's private life, feelings, or specific character.",
                        "zh": "以个体方式处理，或涉及个人的私生活、情感及特质。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "personally",
                                "target_lang_sense_clarification": "taking offense or individually"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "个人",
                                "target_lang_sense_clarification": "指针对个体"
                            },
                            {
                                "target_lang_word": "私下",
                                "target_lang_sense_clarification": "指非公开的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36f6d129-c318-31a8-987b-4ebc07ca5684",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>личный</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это письмо слишком <лично>, чтобы читать его вслух перед всеми.",
                            "target_lang_translations": {
                                "en": "This letter is too <personal> to read aloud in front of everyone.",
                                "zh": "这封信太<w>私密</w>了，不适合当众朗读。"
                            }
                        },
                        {
                            "text": "Всё сказанное здесь сугубо <лично> и не должно выйти за пределы комнаты.",
                            "target_lang_translations": {
                                "en": "Everything said here is strictly <personal> and must not leave the room.",
                                "zh": "这里所说的一切都属于<w>个人</w>隐私，不得传出这个房间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "сугубо лично"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to private matters or a specific individual (short form adjective).",
                        "zh": "与私人事务或特定个人有关的（形容词短尾形式）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "personal",
                                "target_lang_sense_clarification": "private"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "私密",
                                "target_lang_sense_clarification": "指涉及隐私"
                            },
                            {
                                "target_lang_word": "个人",
                                "target_lang_sense_clarification": "指属于个人的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}