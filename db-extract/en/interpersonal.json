                                "target_senses": [
                                    {
                                        "sense_id": "a1e57e1a-3307-3d22-8b80-491ab0e55261",
                                        "entry_id": "c9dbdb77-92a4-3575-87b1-0beddd535f51",
                                        "glosses": [
                                            "das Verhältnis zwischen zwei Personen betreffend, zwischen zwei Personen bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2ce1fd-36ff-4438-9d5b-19dbfcf39fa4",
                                                "sense_id": "a1e57e1a-3307-3d22-8b80-491ab0e55261",
                                                "text": "„Es handelt sich um einen leidenschaftlichen Segelflieger, der sich wegen zwischenmenschlicher Probleme in die Behandlung begeben hat.“"
                                            },
                                            {
                                                "example_id": "84229361-af49-4f8c-ad13-e164f6a75c13",
                                                "sense_id": "a1e57e1a-3307-3d22-8b80-491ab0e55261",
                                                "text": "„Als das Vokabular der Experimentalpsychologie schließlich auf zwischenmenschliche Kontexte ausgedehnt wurde, blieb die Sprache der Psychologie dennoch eine rein monadische.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
