                                        "glosses": [
                                            "sich nicht bewegen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05dc8043-a31b-466f-aebf-b3f5bad7a93d",
                                                "sense_id": "1655a9c0-5825-3a30-b1e5-56c22ed3e8f1",
                                                "text": "„Daß sich das Kampfbündnis im Laufe der Zeit als immer effektiver erwies, hat wohl auch damit zu tun, daß man den immobilen Teil der Kriegsbeute, also erobertes Territorium, regelmäßig zur Gründung oder Verstärkung von Siedlungen nutze, die sich gegen neue Angriffe auch einmal selbstständig verteidigen konnten.“"
                                            },
                                            {
                                                "example_id": "512bcecd-d0af-4fe2-b96a-e25a7aa9ecde",
                                                "sense_id": "1655a9c0-5825-3a30-b1e5-56c22ed3e8f1",
                                                "text": "Nach einem Oberschenkelhalsbruch ist sie immobil und zieht sich aus der Öffentlichkeit zurück."
                                            },
                                            {
                                                "example_id": "a6361146-61b7-4cfc-a9f8-a93b6b20241d",
                                                "sense_id": "1655a9c0-5825-3a30-b1e5-56c22ed3e8f1",
                                                "text": "Dass ich kein eigenes Auto habe, bedeutet nicht, dass ich immobil bin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2bf9af44-5413-31ed-8976-ff93a6f5caf3",
                                        "entry_id": "6d3f9c1e-c644-3abf-a451-fba452568ffc",
                                        "glosses": [
                                            "von Truppen, die nicht für den Kriegseinsatz bereit ist, oder nicht für diesen geeignet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1afa746-6f4b-46d3-a3de-fd03ed8103a8",
                                                "sense_id": "2bf9af44-5413-31ed-8976-ff93a6f5caf3",
                                                "text": "„Für Belagerungen wird man überhaupt weniger Feldtruppen als wie immobile Truppen verwenden und auch hier wird die Anwesenheit der Mineure erst in der letzten Periode erforderlich.“"
                                            }
                                        ],
