                "senses": [
                    {
                        "sense_id": "7f15ed58-4231-3d01-9189-11a2b8b22ee7",
                        "entry_id": "734cb75f-57b7-3762-acee-11845e1fbb01",
                        "glosses": [
                            "Behältnis zum Einpflanzen von Blumen, welches zumeist auf Fensterbrettern, an Balkonbrüstungen oder Ähnlichem angebracht wird"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "9fccaf09-8eab-49a7-97b9-bad8624b68f5",
                                "sense_id": "7f15ed58-4231-3d01-9189-11a2b8b22ee7",
                                "text": "„Der Briefträger verwendet offensichtlich bereits seit vielen Tagen ein Blumenkisterl neben der Eingangstüre als zweite Aufbewahrungseinheit für Postsendungen aller Art.“"
                            },
                            {
                                "example_id": "b8b52f23-7c73-47ad-837d-cc43fca6115a",
                                "sense_id": "7f15ed58-4231-3d01-9189-11a2b8b22ee7",
                                "text": "„So rückten sie mit großem Feuerwehrzelt, liebevoll gebastelten Ortstaferln samt Blumenkisterl und zwei Köchen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
