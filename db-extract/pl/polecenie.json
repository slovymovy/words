                "senses": [
                    {
                        "sense_id": "ca2365ca-3345-3e65-9db8-04614737e774",
                        "entry_id": "4b2807cd-1941-3584-90d0-80891b6efbba",
                        "glosses": [
                            "nakazanie komuś zrobienia czegoś, także wypowiedź o takiej intencji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2829db4e-262b-46cc-9461-17e58c2fee8c",
                                "sense_id": "ca2365ca-3345-3e65-9db8-04614737e774",
                                "text": "Polecenie się wykonuje, a nie analizuje."
                            },
                            {
                                "example_id": "759ef36d-ab46-4180-86ec-eb24fc0268e7",
                                "sense_id": "ca2365ca-3345-3e65-9db8-04614737e774",
                                "text": "Odmowa wykonania polecenia przełożonego o odsunięciu lub niedopuszczeniu do pełnienia służby pociąga za sobą odpowiedzialność dyscyplinarną, wyjątkami są tu przypadki podyktowane charakterem służby lub względami bezpieczeństwa."
                            }
                        ],
