                        "examples": [
                            {
                                "example_id": "4c7dc893-63c7-4bac-aee7-e1dfe0ba5f5f",
                                "sense_id": "2e82724c-89cb-35a2-aad8-50c1c9aa4621",
                                "text": "Et l’hurluberluesque directeur d'orchestre s'esquivait sans laisser de trace."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c428ce0-c2c6-342f-a7d6-fdcae77e5744",
                        "entry_id": "b6cb28be-89d6-30d5-86bd-492f52e718ae",
                        "glosses": [
                            "Qui est digne d'un hurluberlu."
                        ],
                        "tags": [
                            "ironic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8ff026f5-443f-4e8e-beac-c1ebbcca20c6",
                                "sense_id": "3c428ce0-c2c6-342f-a7d6-fdcae77e5744",
                                "text": "Sa transcription, […] ào lín pĭ kè, aligne quatre idéogrammes dont la prononciation s'approche tant que faire se peut de l'original et dont la succession hurluberluesque atteste que leur sens usuel est ici secondaire."
                            },
                            {
                                "example_id": "fffdcbeb-39e1-49a2-91c4-432a37fcc1bb",
                                "sense_id": "3c428ce0-c2c6-342f-a7d6-fdcae77e5744",
                                "text": "Ses mimiques, son intonation de voix ainsi que les situations hurluberluesques dans lesquelles il se retrouvait faisaient se tordre de rire les deux néo-tourtereaux."
                            },
                            {
                                "example_id": "d53521c0-88a2-477f-8dea-f8dbd7bf7b5a",
                                "sense_id": "3c428ce0-c2c6-342f-a7d6-fdcae77e5744",
                                "text": "Finalement certaines entreprises ne sont-elles pas davantage esclavagistes que des groupes d'illuminés aux croyances certes hurluberluesques, mais réunificateurs d'esprits en errance se trouvant ainsi protégés du monde […]."
                            }
                        ]
                    }
