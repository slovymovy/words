                "senses": [
                    {
                        "sense_id": "3b79fea1-68fc-39d3-aa07-c094b3b0946e",
                        "entry_id": "327a7026-a22a-3f3f-bfce-5316511d7380",
                        "glosses": [
                            "Espèce de poissons osseux marins avec piquants et qui peuvent se gonfler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71401689-27cf-42bf-b6f6-bce0fe601eb7",
                                "sense_id": "3b79fea1-68fc-39d3-aa07-c094b3b0946e",
                                "text": "Me voici amené à un rapprochement entre le diodon et le tétrodon me permettant d’étayer ma supposition que le premier se défend de ses ennemis en exsudant son poison."
                            },
                            {
                                "example_id": "20b56758-c22e-48e7-9570-390b3af25991",
                                "sense_id": "3b79fea1-68fc-39d3-aa07-c094b3b0946e",
                                "text": "Suspendue par une cordelette de soie, un diodon séché, de bonne taille, arrondissait la bouche devant une cuirasse en écailles de tortue."
                            }
                        ]
                    }
