                                        "glosses": [
                                            "wirre, dichte Masse"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ccc5067-7da3-444d-96f6-f44d69f1c354",
                                                "sense_id": "017a9097-02c2-3c64-827b-5c34896eb1e7",
                                                "text": "Sein Haupthaar ist durch Schweiß und Harz zu einem unlöslichen Filz verworren gewesen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "95dfe1d2-7d21-3e88-8c17-08e7b400cae4",
                                        "entry_id": "d0dcd5e0-cf93-3fed-8ef1-3b884f99906b",
                                        "glosses": [
                                            "politischer Klüngel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19f38e1-9e31-4f53-98e6-556ff48a7f9a",
                                                "sense_id": "95dfe1d2-7d21-3e88-8c17-08e7b400cae4",
                                                "text": "Der neue Stadtrat hat es sich auf die Fahnen geschrieben, den Filz zu bekämpfen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a57160f3-67e8-3368-8984-9bf73e3caab0",
                                        "entry_id": "d0dcd5e0-cf93-3fed-8ef1-3b884f99906b",
                                        "glosses": [
                                            "Bauchfilz, ein Teil des Fettgewebes des Schweines"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea945c5-33dc-43a7-a101-4a7155df3b5d",
                                                "sense_id": "a57160f3-67e8-3368-8984-9bf73e3caab0",
                                                "text": "„Schmer ist das Fettgewebe der Schweine in der Bauchhöhle (auch Filz oder Bauchfilz genannt), in der Nähe der Rippen und der Nieren.“"
                                            },
                                            {
                                                "example_id": "f71fb6fa-59c1-47e2-b35f-94ac728f8f90",
                                                "sense_id": "a57160f3-67e8-3368-8984-9bf73e3caab0",
                                                "text": "„Als Schmer oder Filz bezeichnet man das Fett vom Bauchfilz des Schweins […]“"
                                            },
                                            {
                                                "example_id": "6fb50998-d9a8-4583-9410-066c32e7a724",
                                                "sense_id": "a57160f3-67e8-3368-8984-9bf73e3caab0",
                                                "text": "„Filz ist fettreicheres Gewebe und gibt das grießlige Schmalz.“"
                                            },
                                            {
                                                "example_id": "72b7af23-99e4-4972-9e98-ce34355840cd",
                                                "sense_id": "a57160f3-67e8-3368-8984-9bf73e3caab0",
                                                "text": "„In einigen von uns mit Filz behandelten Fällen trat bereits nach 3 bis 5 Tagen deutliche und andauernde Besserung ein.“"
                                            }
                                        ],
