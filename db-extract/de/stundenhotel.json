                "senses": [
                    {
                        "sense_id": "2cb3b86d-7be8-39b8-ba4b-7a0152ab18bf",
                        "entry_id": "0f18bfbf-7a74-31f0-bec8-0f83e585b8ac",
                        "glosses": [
                            "Hotelbetrieb, der stundenweise Zimmer an Liebespärchen oder Prostituierte vermietet, damit sie darin Geschlechtsverkehr ausüben können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d9e3350-7528-4877-9d45-380012ab7673",
                                "sense_id": "2cb3b86d-7be8-39b8-ba4b-7a0152ab18bf",
                                "text": "„Er war Mitarbeiter des Roten Kreuzes, Seemann und Portier in einem Stundenhotel.“"
                            },
                            {
                                "example_id": "201a9dfd-3b75-4b0f-928c-af17eac29931",
                                "sense_id": "2cb3b86d-7be8-39b8-ba4b-7a0152ab18bf",
                                "text": "„Ein Zuhälter war auf sie aufmerksam geworden und hatte sie mit Geschenken überhäuft, bis sie nachgab und die Vormittage in einem Stundenhotel verbrachte.“"
                            },
                            {
                                "example_id": "49ee3c03-15c7-4e72-8ea7-b21016304bff",
                                "sense_id": "2cb3b86d-7be8-39b8-ba4b-7a0152ab18bf",
                                "text": "„Und er kennt alle Absteigequartiere, alle hochherrschaftlichen Pensionen mit Nachtglocken, alle Stundenhotels der Gegend.“"
                            },
                            {
                                "example_id": "b2c4feb5-d68c-4dd6-9ed0-fe4f8ca2d958",
                                "sense_id": "2cb3b86d-7be8-39b8-ba4b-7a0152ab18bf",
                                "text": "„Außer in solchen Gaunereien, auf die er sich viel zugute tat, besaß er eine umfassende Erfahrung in Dingen, wie sie die Stubenmädchen treiben oder wie sie in schlecht beleuchteten Hinterzimmern von kleinen Stundenhotels vor sich gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ce911d6-4ff1-418c-964e-52c6d74250bc",
                        "source_entry_id": "0f18bfbf-7a74-31f0-bec8-0f83e585b8ac",
                        "source_sense_id": "2cb3b86d-7be8-39b8-ba4b-7a0152ab18bf",
