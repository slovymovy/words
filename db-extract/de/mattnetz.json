                "senses": [
                    {
                        "sense_id": "4ad1bafc-8022-3e30-85e4-ee166bb908f0",
                        "entry_id": "5c891d75-d686-3126-91b3-c0abc09cb5a7",
                        "glosses": [
                            "Spielsituation, in der eine Partei so aufgestellt ist, dass sie dem gegnerischen König mit einer Vielzahl von Zügen oder Kombinationen Matt droht und die Rettungsaussichten Zug für Zug geringer werden"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "47a62b0b-9922-4ef7-ae94-d330b9a54d9d",
                                "sense_id": "4ad1bafc-8022-3e30-85e4-ee166bb908f0",
                                "text": "„Das Gewinnen von Zeit ist notwendig, um den schwarzen König an der Flucht aus dem Mattnetz zu hindern.“"
                            },
                            {
                                "example_id": "a990c891-be50-4a90-9050-43106e7fe37a",
                                "sense_id": "4ad1bafc-8022-3e30-85e4-ee166bb908f0",
                                "text": "„Der zweite Sieg des Tages gelang Hikaru Nakamura in einer langen und dramatischen Partie gegen Viktor Bologan, in der erst Nakamura und dann Bologan auf Gewinn spielte, der dann jedoch bei knapper werdender Zeit in ein Mattnetz Nakamuras lief.“"
                            },
                            {
                                "example_id": "052e4f6e-4305-45be-ba74-05fb75ccf12e",
                                "sense_id": "4ad1bafc-8022-3e30-85e4-ee166bb908f0",
                                "text": "„Doch wie spann Kortschnoj nach vielen Stunden Kampf ein Mattnetz um den schwarzen König?“"
                            },
                            {
                                "example_id": "1a26853e-5f16-4515-839c-763d1b696762",
                                "sense_id": "4ad1bafc-8022-3e30-85e4-ee166bb908f0",
                                "text": "„Handelt es sich bei der hingelenkten Figur um den König, der in ein Mattnetz hineingelockt wird, dann spricht man von einem Hineinziehungsopfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
