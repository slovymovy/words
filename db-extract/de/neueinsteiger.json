                "senses": [
                    {
                        "sense_id": "41a8eade-6b1f-38f2-8b6d-3d787be726c2",
                        "entry_id": "630fb434-3979-3e63-8ab0-ac391cd42577",
                        "glosses": [
                            "Person, die mit etwas neu beginnt; Person, die in einem neuen Beruf anfängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e985217e-60b2-472b-8f2a-834b78e4a9ec",
                                "sense_id": "41a8eade-6b1f-38f2-8b6d-3d787be726c2",
                                "text": "„Die Älteren müssen nicht nur die Arbeit für die fehlenden Kollegen machen, sondern gleichzeitig die Neueinsteiger einarbeiten.“"
                            },
                            {
                                "example_id": "61dbc274-9467-4841-bdd2-7ca6eca6d1f8",
                                "sense_id": "41a8eade-6b1f-38f2-8b6d-3d787be726c2",
                                "text": "„Die Neueinsteiger unter den Lehrerkollegen, die so genannten Neulehrer, haben es nicht leicht, die zum Teil verlodderte Nachkriegsjugend zu bändigen, geschweige denn zu unterrichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17bc3dc6-7e63-48d1-8e4c-d4f9645675a0",
                        "source_entry_id": "630fb434-3979-3e63-8ab0-ac391cd42577",
                        "source_sense_id": "41a8eade-6b1f-38f2-8b6d-3d787be726c2",
                        "source_sense_description": "Person, die mit etwas neu beginnt; Person, die in einem neuen Beruf anfängt",
                        "target_lang_word": "newcomer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "newcomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e95bf882-c189-3b0d-b750-d69f880c9de3",
                                        "entry_id": "32ab7118-4cd3-3fd5-b7f8-e5ec8827d7ea",
                                        "glosses": [
                                            "One who has recently come to a community; a recent arrival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3a4816-bd1b-4bbc-a527-e9f4c9d178e9",
                                                "sense_id": "e95bf882-c189-3b0d-b750-d69f880c9de3",
                                                "text": "Welcome, we²l'ku²m. a.\n Received with gladneſs, admitted willingly, grateful[…]\nWelcome, we²l'ku²m. interj.\n A form of ſalutation uſed to a new comer."
                                            },
                                            {
                                                "example_id": "823f98c9-336b-4c97-9c52-6f66b9e14d6b",
                                                "sense_id": "e95bf882-c189-3b0d-b750-d69f880c9de3",
                                                "text": "This new-comer was a man who in any company would have seemed striking. In complexion fair, and with blue or gray eyes, he was tall as any Viking, as broad in the shoulder."
                                            },
                                            {
                                                "example_id": "410bf2d5-e73f-47a7-ab0f-fbd2bfe73dab",
                                                "sense_id": "e95bf882-c189-3b0d-b750-d69f880c9de3",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            },
                                            {
                                                "example_id": "035b5524-6597-4a2a-a295-95a53cd4d271",
                                                "sense_id": "e95bf882-c189-3b0d-b750-d69f880c9de3",
                                                "text": "Americans, for example, call newcomers to Antarctica “fingies”, which comes from FNGs – a borrowed military abbreviation that means “Fucking New Guy”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1fe83e4-e914-32fe-b066-398a61b19be7",
                                        "entry_id": "32ab7118-4cd3-3fd5-b7f8-e5ec8827d7ea",
                                        "glosses": [
                                            "A new participant in some activity; a neophyte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
