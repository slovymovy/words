                            {
                                "target_word": "willow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4406e0d1-c15d-3005-bce9-dfbea67ccbbf",
                                        "entry_id": "eeb16f57-86e7-34fc-acad-71194ebb75d0",
                                        "glosses": [
                                            "To open and cleanse (cotton, flax, wool, etc.) by means of a willow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cebbb950-10d0-39be-a6bd-ecc5ceec0398",
                                        "entry_id": "eeb16f57-86e7-34fc-acad-71194ebb75d0",
                                        "glosses": [
                                            "To form a shape or move in a way similar to the long, slender branches of a willow."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e57fcf-d0e8-447e-b34a-a1ad35e87be1",
                                                "sense_id": "cebbb950-10d0-39be-a6bd-ecc5ceec0398",
                                                "text": "Willowing over the rough cobbles of the little pier stepped a thin, bent figure, adorned with a silver nanny-goat's beard and bobbling eyes interrupted by the rim of a pair of pince-nez."
                                            },
                                            {
                                                "example_id": "0efe361b-28ef-43bb-adad-956a9ca5b64e",
                                                "sense_id": "cebbb950-10d0-39be-a6bd-ecc5ceec0398",
                                                "text": "Joe’s impulse was to sketch her, with her shadow willowing beyond her on the mouse-gray paving-stone; but his left fist, obeying instinct, remained clenched behind his back […]"
                                            },
                                            {
                                                "example_id": "33d74321-d34f-41b8-8113-946abf2bea9a",
                                                "sense_id": "cebbb950-10d0-39be-a6bd-ecc5ceec0398",
                                                "text": "It was floating a foot under the surface. The eyes were holes. The mouth was a slit cavern of darkness. The hair willowed around the scalp."
                                            },
                                            {
                                                "example_id": "c34118ea-2e2d-43b7-94c8-650f4b8d391b",
                                                "sense_id": "cebbb950-10d0-39be-a6bd-ecc5ceec0398",
                                                "text": "The draft-drawn smoke willowed down through the hole and across my face, but I didn’t worry about coughing or sneezing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1df5967d-2a66-42f9-979b-1be4493dc9c5",
                        "source_entry_id": "34264c4f-9af5-3b96-9157-0158f4313911",
                        "source_sense_id": "830d9a05-2c81-322f-9bd1-92101e3c41e1",
                        "source_sense_description": "Salix sp.",
                        "target_lang_word": "saule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bae8fe1e-e36b-3e96-9103-02922c684476",
                                        "entry_id": "2274bec5-b43f-38d5-bf55-84a3e79f79d1",
                                        "glosses": [
                                            "Genre d’arbres ou d’arbustes, à feuilles caduques, alternes, ovales ou lancéolées, aux fleurs réunies en chatons, mâles ou femelles, portés par des pieds différents (plantes dioïques) et qui croissent ordinairement dans les prés et le long des ruisseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8838c5e-3126-4b24-b54d-21941256ce13",
                                                "sense_id": "bae8fe1e-e36b-3e96-9103-02922c684476",
                                                "text": "Mais voilà-t-il pas que le saule, qui était creux et pourri dans le cœur, craque sous son poids et se brise avec un fracas épouvantable !"
                                            },
                                            {
                                                "example_id": "20d1958e-f5f9-43c1-93f6-a5ac8a325f16",
                                                "sense_id": "bae8fe1e-e36b-3e96-9103-02922c684476",
                                                "text": "Les odeurs forestières, senteurs adorées par les âmes friandes de poésie à qui plaisent les mousses les plus innocentes, les cryptogames les plus vénéneux, les terres mouillées, les saules, les baumes, le serpolet, les eaux vertes d’une mare, l’étoile arrondie des nénuphars jaunes ; toutes ces vigoureuses fécondations se livrent à vos narines en vous livrant toute une pensée, leur âme peut-être."
                                            },
                                            {
                                                "example_id": "003fba1e-7e65-4c48-a42b-343fe88c1039",
                                                "sense_id": "bae8fe1e-e36b-3e96-9103-02922c684476",
                                                "text": "Les bourgeons des saules avaient éclaté en projetant sur les branches rousses la poudre vert amande du feuillage naissant."
                                            },
                                            {
                                                "example_id": "ac4ab375-29c7-4f0a-a547-9dedd36368d5",
                                                "sense_id": "bae8fe1e-e36b-3e96-9103-02922c684476",
                                                "text": "Le long des rivières se développe une végétation de Cannes de Provence qui s’encombre de Saules et de Peupliers jusqu’à donner des bois de ces arbres qui sont un autre climax."
                                            },
                                            {
                                                "example_id": "c52b1dd4-88a6-46cf-9095-40f3a9e459a2",
                                                "sense_id": "bae8fe1e-e36b-3e96-9103-02922c684476",
                                                "text": "Dressé sur l’échelle légère et tremblante, en saule de marais, il cueillait sans relâche, leste comme un écureuil, promptement quoique sans se hâter."
                                            },
                                            {
                                                "example_id": "24e2d489-b9ec-4d3f-9c04-190e7665063c",
                                                "sense_id": "bae8fe1e-e36b-3e96-9103-02922c684476",
                                                "text": "Les lentilles d’eau font de la roubine un chemin vert tendre entre saules et frênes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d6fc987-6c5f-372a-a285-6a0b94738789",
                                        "entry_id": "2274bec5-b43f-38d5-bf55-84a3e79f79d1",
                                        "glosses": [
                                            "Bois du saule, utilisé en menuiserie, vannerie, ébénisterie, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
