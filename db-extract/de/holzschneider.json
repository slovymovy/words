                "senses": [
                    {
                        "sense_id": "786ff459-ff05-3708-91c1-9e478ea26cc7",
                        "entry_id": "f13ac609-fc39-3eb3-a017-bc27c34f1158",
                        "glosses": [
                            "jemand, der Holzschnitte anfertigt, die Holzschneidekunst ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c61c9c8c-e406-4de4-b688-5f6360a609cc",
                                "sense_id": "786ff459-ff05-3708-91c1-9e478ea26cc7",
                                "text": "„Zum Zwecke der Reproduktion und Verfielfältigung durch Holzstiche musste [Wilhelm] Busch die Bleistift- und Federzeichnungen seitenverkehrt auf einen Holzstock übertragen, ein Holzschneider führte dann die Arbeit zu Ende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ad3256e-463b-3585-8f36-1302e38e5d37",
                        "entry_id": "f13ac609-fc39-3eb3-a017-bc27c34f1158",
                        "glosses": [
                            "jemand, dessen Beruf es ist, (in einem Sägewerk, einer Tischlerei/Schreinerei) Holz in bestimmte Formen und Größen zu zersägen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5dca2c8d-b822-43e1-9054-5eed84d95eeb",
                                "sense_id": "6ad3256e-463b-3585-8f36-1302e38e5d37",
                                "text": "„Wir haben gemeinsam das Sägewerk ausgebaut und vergrößert, ich habe eine Möbelschreinerei eröffnet für die Leute in der Region, wir haben Zimmermänner angestellt, Tischler, Holzschneider, andere Menschen in Lohn und Brot gebracht, die mit ihrer Arbeit bei uns ihre Familien ernähren konnten.“"
                            },
                            {
                                "example_id": "3c26fc1a-50a2-483f-8e8a-5d7c56d6108e",
                                "sense_id": "6ad3256e-463b-3585-8f36-1302e38e5d37",
                                "text": "„Der ältere der beiden Holzschneider fragt Heribert, wie die Eichen geschnitten werden sollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
