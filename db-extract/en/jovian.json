                    },
                    {
                        "sense_id": "063a3413-7fa5-3ee8-9241-a0bc17ae8e2d",
                        "entry_id": "49d51865-0006-3dec-a5e9-dbd71151df0c",
                        "glosses": [
                            "Pertaining to the Roman god Jove or Jupiter (the counterpart of the Greek god Zeus); Jove-like; befitting Jupiter."
                        ],
                        "tags": [
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "1ad39a95-1844-4548-8cbb-8fcf89b281c2",
                                "sense_id": "063a3413-7fa5-3ee8-9241-a0bc17ae8e2d",
                                "text": "Near-synonym: Zeusian"
                            },
                            {
                                "example_id": "4568f22f-3864-48d0-b327-84cfef7edd13",
                                "sense_id": "063a3413-7fa5-3ee8-9241-a0bc17ae8e2d",
                                "text": "He did not admit of equals. But as a patron he was superb. With his Jovian air, his colossal condescension, his amused smile, his general suggestion of the god descending to the mortal, he could be quite overpowering in his amiability."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
