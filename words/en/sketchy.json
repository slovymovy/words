{
    "word_family": [
        "sketch",
        "sketcher",
        "sketchbook",
        "sketchily",
        "sketchiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49bb752f-44b7-3e1e-a8cd-6129628e813b",
                    "sense_definition": "Lacking in detail, completeness, or thoroughness.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "incomplete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness could only provide a <w>sketchy</w> description of the suspect's vehicle.",
                            "target_lang_translations": {
                                "ru": "Свидетель смог дать лишь <w>поверхностное</w> описание автомобиля подозреваемого."
                            }
                        },
                        {
                            "text": "Because the project is in the early stages, the current plans are still very <w>sketchy</w>.",
                            "target_lang_translations": {
                                "ru": "Поскольку проект находится на ранней стадии, текущие планы все еще очень <w>неполные</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "detailed",
                        "thorough",
                        "comprehensive"
                    ],
                    "common_phrases": [
                        "sketchy details",
                        "sketchy description",
                        "sketchy information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаточно подробный, неполный или поверхностный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поверхностный",
                                "target_lang_sense_clarification": "не содержащий деталей"
                            },
                            {
                                "target_lang_word": "неполный",
                                "target_lang_sense_clarification": "недостаточный"
                            },
                            {
                                "target_lang_word": "отрывочный",
                                "target_lang_sense_clarification": "состоящий из отдельных фрагментов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fc7948d-03bd-36e1-ad88-45b0c8eee2ac",
                    "sense_definition": "Potentially dangerous, unreliable, or of questionable safety.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided not to cross the <w>sketchy</w> bridge because the wood looked rotten.",
                            "target_lang_translations": {
                                "ru": "Мы решили не переходить через этот <w>ненадежный</w> мост, потому что дерево выглядело гнилым."
                            }
                        },
                        {
                            "text": "Walking through that <w>sketchy</w> neighborhood alone at night is not a good idea.",
                            "target_lang_translations": {
                                "ru": "Гулять по этому <w>сомнительному</w> району в одиночку ночью — не лучшая идея."
                            }
                        }
                    ],
                    "synonyms": [
                        "dicey",
                        "dodgy"
                    ],
                    "antonyms": [
                        "safe",
                        "secure"
                    ],
                    "common_phrases": [
                        "sketchy neighborhood",
                        "sketchy situation",
                        "look sketchy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal speech to describe risky situations."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потенциально опасный, ненадежный или вызывающий сомнения в безопасности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "вызывающий опасения"
                            },
                            {
                                "target_lang_word": "ненадежный",
                                "target_lang_sense_clarification": "небезопасный"
                            },
                            {
                                "target_lang_word": "стремный",
                                "target_lang_sense_clarification": "сленг: пугающий или опасный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba7e32b7-13b2-3be2-a6a1-3a32511e5590",
                    "sense_definition": "Dishonest, suspicious, or appearing to be involved in illegal activities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suspicious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I didn't buy the phone because the seller seemed like a <w>sketchy</w> character.",
                            "target_lang_translations": {
                                "ru": "Я не купил телефон, потому что продавец показался мне <w>подозрительным</w> типом."
                            }
                        },
                        {
                            "text": "He has been hanging out with some <w>sketchy</w> people lately, which worries his parents.",
                            "target_lang_translations": {
                                "ru": "В последнее время он общается с какими-то <w>мутными</w> личностями, что беспокоит его родителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "dubious",
                        "seedy",
                        "shady"
                    ],
                    "antonyms": [
                        "trustworthy",
                        "reputable",
                        "honest"
                    ],
                    "common_phrases": [
                        "sketchy character",
                        "sketchy guy",
                        "sketchy business"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for suspicious behavior or people."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный, подозрительный или кажущийся вовлеченным в незаконную деятельность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий недоверие"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "сленг: неясный, подозрительный"
                            },
                            {
                                "target_lang_word": "темный",
                                "target_lang_sense_clarification": "о человеке или делах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e93e3a81-321c-30d8-8746-c3797e404839",
                    "sense_definition": "Roughly or hastily drawn or planned, often as a preliminary version.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incomplete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect presented a <w>sketchy</w> design during the first meeting to get feedback.",
                            "target_lang_translations": {
                                "ru": "Архитектор представил <w>схематичный</w> проект на первой встрече, чтобы получить отзывы."
                            }
                        },
                        {
                            "text": "She made a <w>sketchy</w> outline of the novel before starting the actual writing.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>черновой</w> набросок романа, прежде чем приступить к самому написанию."
                            }
                        }
                    ],
                    "antonyms": [
                        "polished",
                        "finished"
                    ],
                    "common_phrases": [
                        "sketchy design",
                        "sketchy outline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набросанный в общих чертах или поспешно спланированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схематичный",
                                "target_lang_sense_clarification": "в виде наброска"
                            },
                            {
                                "target_lang_word": "черновой",
                                "target_lang_sense_clarification": "предварительный"
                            },
                            {
                                "target_lang_word": "приблизительный",
                                "target_lang_sense_clarification": "не точный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ce7ee01-e19d-3708-babf-f31dd04c2d31",
                    "sense_definition": "Giving a strong impression of being creepy or likely to cause harm or harassment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "suspicious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The way he was staring at everyone in the park felt really <w>sketchy</w>.",
                            "target_lang_translations": {
                                "ru": "То, как он пялился на всех в парке, выглядело очень <w>стремно</w>."
                            }
                        },
                        {
                            "text": "She left the party early because a <w>sketchy</w> man wouldn't stop following her.",
                            "target_lang_translations": {
                                "ru": "Она ушла с вечеринки пораньше, потому что какой-то <w>подозрительный</w> мужчина не переставал ходить за ней по пятам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "really sketchy",
                        "act sketchy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used by younger speakers to describe creepy behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Производящий неприятное впечатление, пугающий или намекающий на домогательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремный",
                                "target_lang_sense_clarification": "сленг: пугающий, неприятный"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "о пугающем поведении"
                            },
                            {
                                "target_lang_word": "странный",
                                "target_lang_sense_clarification": "в пугающем смысле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}