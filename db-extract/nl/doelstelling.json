                        "sense_id": "652469d0-02d0-34ec-ac68-88a40b1f1b40",
                        "entry_id": "a6beee45-9fc6-3441-9f29-07a29fc51de8",
                        "glosses": [
                            "een gewenste situatie die van te voren is vastgesteld waar naar toe gewerkt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "401f4fad-2156-4008-addd-b6e618cd6fbd",
                                "sense_id": "652469d0-02d0-34ec-ac68-88a40b1f1b40",
                                "text": "Het ministerie zegt de doelstelling van de klimaatverdragen te gaan halen."
                            },
                            {
                                "example_id": "29ce6341-37f3-43cd-a395-8c60749fb005",
                                "sense_id": "652469d0-02d0-34ec-ac68-88a40b1f1b40",
                                "text": "Ik zocht naar een manier om mijn nieuw verworven houding thuis vast te houden en bedacht vijf doelen met concrete, meetbare doelstellingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28cdeb19-5fdf-48d6-ab0e-41668bebe569",
                        "source_entry_id": "a6beee45-9fc6-3441-9f29-07a29fc51de8",
                        "source_sense_id": "652469d0-02d0-34ec-ac68-88a40b1f1b40",
                        "source_sense_description": "een gewenste situatie waar naar toe gewerkt wordt",
                        "target_lang_word": "Zielsetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zielsetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4632845a-43c7-30ba-ab53-5613c8c4c92e",
                                        "entry_id": "648e6049-c358-33ee-8626-625481791903",
                                        "glosses": [
                                            "Tätigkeit des Festlegens dessen, was zu erreichen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae1ab510-0680-4330-a7d6-a3cdf3913c76",
                                                "sense_id": "4632845a-43c7-30ba-ab53-5613c8c4c92e",
                                                "text": "Ist die Zielsetzung geschafft, das Ziel gesetzt, kann die Arbeit am Erreichen des Ziels beginnen."
                                            },
                                            {
                                                "example_id": "49b6fc9f-6ebf-4eb6-8363-b2b8c5d841c8",
                                                "sense_id": "4632845a-43c7-30ba-ab53-5613c8c4c92e",
                                                "text": "„Spielfähigkeit, mehrperspektivisch verstanden und als Leitidee der Vermittlung von Sportspielen interpretiert, beinhaltet eine doppelte Zielsetzung: Während es zum einen um eine allgemeine und spezifische Perspektive der Qualifikation geht, zielen entsprechende Vermittlungsprozesse zum anderen auf persönlichkeitsbildende Aspekte ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4047a418-08ae-36e3-bdc6-0fb27fbabc2c",
                                        "entry_id": "648e6049-c358-33ee-8626-625481791903",
                                        "glosses": [
                                            "anzustrebender oder angestrebter Zustand oder Sachverhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "229cb0bf-eb79-4d5e-b38a-9d6159582900",
                                                "sense_id": "4047a418-08ae-36e3-bdc6-0fb27fbabc2c",
                                                "text": "„Spielfähigkeit, mehrperspektivisch verstanden und als Leitidee der Vermittlung von Sportspielen interpretiert, beinhaltet eine doppelte Zielsetzung: Während es zum einen um eine allgemeine und spezifische Perspektive der Qualifikation geht, zielen entsprechende Vermittlungsprozesse zum anderen auf persönlichkeitsbildende Aspekte ab.“"
                                            },
                                            {
                                                "example_id": "a9997771-df50-49cc-b14c-97fd1f2d8c3d",
                                                "sense_id": "4047a418-08ae-36e3-bdc6-0fb27fbabc2c",
                                                "text": "Ist die Zielsetzung unklar, dann kann viel Aufwand zum Erreichen des Gewünschten vergeblich sein."
                                            },
                                            {
                                                "example_id": "03e5f8e3-598c-41fb-9bdb-93a1f0b79d22",
                                                "sense_id": "4047a418-08ae-36e3-bdc6-0fb27fbabc2c",
                                                "text": "„Spirituell begründete Techniken unterscheiden sich etwa durch die Zielsetzung.“"
                                            },
                                            {
                                                "example_id": "e9cd2c2e-d545-49d4-b707-0e87067c514e",
                                                "sense_id": "4047a418-08ae-36e3-bdc6-0fb27fbabc2c",
                                                "text": "„Diese Zielsetzung findet man vor allem in Arbeiten, die ihr theoretisches Vorbild in den verschiedenen Modellen der generativen Transformationsgrammatik haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25b41312-78b9-45d2-9373-974bb15f012e",
