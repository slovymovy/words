                        ],
                        "form": "speelstukjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d700686d-94a7-3483-b725-d1b75679892e",
                        "entry_id": "c8019a91-54e2-3072-af97-3057bb6e6e20",
                        "glosses": [
                            "figuren waarmee je speelt op een bordspel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642cfbdf-50ab-4732-a108-e94b8c3c5316",
                                "sense_id": "d700686d-94a7-3483-b725-d1b75679892e",
                                "text": "De andere games vereisen de eerder genoemde kartonnen lagen. Deze hebben allemaal een Ganzenbord-formule waarbij je met de bijgeleverde speelstukken het einde moet behalen."
                            },
                            {
                                "example_id": "f0b125d6-e5b6-4e93-9753-7c0315cd68fe",
                                "sense_id": "d700686d-94a7-3483-b725-d1b75679892e",
                                "text": "Jumbo zet een trend voort die gestart is met de populaire iPawn-spellen als Ganzenbord. Hierin gebruikte je fysieke speelstukken en je tablet of smartphone als interactieve speelkaart. AppCards kent een soortgelijke insteek, maar dan met kaartspellen."
                            },
                            {
                                "example_id": "58c4cd87-1063-48f5-a88e-ab55a4f9029a",
                                "sense_id": "d700686d-94a7-3483-b725-d1b75679892e",
                                "text": "Bezoekers die graag de Stratego uitdaging aangaan met hun eigen familie of vrienden kunnen hun strijd leveren op een levensgroot Strategospeelbord met reusachtige speelstukken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c263c325-d756-4270-a600-f6dcfdb496be",
                        "source_entry_id": "c8019a91-54e2-3072-af97-3057bb6e6e20",
                        "source_sense_id": "d700686d-94a7-3483-b725-d1b75679892e",
                        "target_lang_word": "gaming piece",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "955598a0-5a9e-49de-a163-c4b9696e00ec",
                        "source_entry_id": "c8019a91-54e2-3072-af97-3057bb6e6e20",
                        "source_sense_id": "d700686d-94a7-3483-b725-d1b75679892e",
                        "target_lang_word": "piece",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e08e1a29-282c-3b75-b936-9df66b30b5d5",
                                        "entry_id": "2aa11d3b-49f1-3e10-a1d6-d00299581ca0",
                                        "glosses": [
                                            "To assemble (something real or figurative)."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69613d79-23ab-4656-a680-1ede49adb5bb",
                                                "sense_id": "e08e1a29-282c-3b75-b936-9df66b30b5d5",
                                                "text": "These clues allowed us to piece together the solution to the mystery."
                                            },
                                            {
                                                "example_id": "3763c103-fd78-4d6c-a92c-75a8b60c93d4",
                                                "sense_id": "e08e1a29-282c-3b75-b936-9df66b30b5d5",
                                                "text": "His adversaries […] pieced themselves together in a joint opposition against him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf43e80-ff13-3c42-bd50-f98606a28c81",
                                        "entry_id": "2aa11d3b-49f1-3e10-a1d6-d00299581ca0",
                                        "glosses": [
                                            "To make, enlarge, or repair, by the addition of a piece or pieces; to patch; often with out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b587e8b6-29dc-46fb-8475-4e12f54fa975",
                                                "sense_id": "0bf43e80-ff13-3c42-bd50-f98606a28c81",
                                                "text": "to piece a garment"
                                            },
                                            {
                                                "example_id": "a0b71938-6c0e-40bd-b523-6418d2bb932e",
                                                "sense_id": "0bf43e80-ff13-3c42-bd50-f98606a28c81",
                                                "text": "You have broke it, cousin: and , by my life , you shall make it whole again ; you shall piece it out with a piece of your performance"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c071c776-f3d7-322b-91ca-9209f964e356",
                                        "entry_id": "2aa11d3b-49f1-3e10-a1d6-d00299581ca0",
                                        "glosses": [
                                            "To produce a work of graffiti more complex than a tag."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "104b1451-09d8-4b22-a07c-3d113529d22d",
                                                "sense_id": "c071c776-f3d7-322b-91ca-9209f964e356",
                                                "text": "“It didn't rain, so I decided to come piece with you.[…]” We never finished that piece."
                                            },
                                            {
                                                "example_id": "d4393418-14be-47eb-8157-4c2d933f380f",
                                                "sense_id": "c071c776-f3d7-322b-91ca-9209f964e356",
                                                "text": "It is incorrect to say that toys tag and masters piece; toys just do bad tags, bad throw-ups, and bad pieces."
                                            },
                                            {
                                                "example_id": "cac8ab9a-ac58-478c-9bea-0b6b40171d3f",
                                                "sense_id": "c071c776-f3d7-322b-91ca-9209f964e356",
                                                "text": "It is often used to collect other writer's tags, and future plans for bombing and piecing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55e24496-2f36-3aeb-b237-203209beaebc",
                                        "entry_id": "2aa11d3b-49f1-3e10-a1d6-d00299581ca0",
                                        "glosses": [
                                            "To eat small quantities of food between meals; to snack; to take small or intermittent bites at a food item."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal",
                                            "intransitive",
                                            "often",
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "064fef0f-0aec-4a00-8052-b453f12f4433",
                                                "sense_id": "55e24496-2f36-3aeb-b237-203209beaebc",
                                                "text": "There he was, piecing on the ham."
                                            },
                                            {
                                                "example_id": "f9297dd5-99e4-48b8-9c3b-59e3aa2b5ca9",
                                                "sense_id": "55e24496-2f36-3aeb-b237-203209beaebc",
                                                "text": "Do not piece between meals."
                                            },
                                            {
                                                "example_id": "c429dfed-185b-4871-baf0-17c99b2eae96",
                                                "sense_id": "55e24496-2f36-3aeb-b237-203209beaebc",
                                                "text": "“Piecing” between meals often means eating sweet crackers, candy, or sweet beverages at almost any hour. These taste good but spoil the appetite for more desirable foods. What's eaten between meals should make a real contribution to daily food intake: fruit, or tomato juice, or a small glass of milk, a small peanut butter or cheese sandwich and the like are good choices. And a mid-morning or mid-afternoon pick-up does not interfere with appetite as irregular nibbling or piecing does."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db7bf0d6-6a67-3705-afe4-a1af19892a67",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A part of a larger whole, usually in such a form that it is able to be separated from other parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8df182-df15-4702-a5c7-6dbac8d0ebef",
                                                "sense_id": "db7bf0d6-6a67-3705-afe4-a1af19892a67",
                                                "text": "Near-synonyms: aspect, portion"
                                            },
                                            {
                                                "example_id": "8298828b-4c1c-4878-bb30-1a3fb7f52df6",
                                                "sense_id": "db7bf0d6-6a67-3705-afe4-a1af19892a67",
                                                "text": "I’d like another piece of pie."
                                            },
                                            {
                                                "example_id": "d1f48dd0-3165-4caf-892e-69bc2cb7d004",
                                                "sense_id": "db7bf0d6-6a67-3705-afe4-a1af19892a67",
                                                "text": "I've lost a piece of this jigsaw puzzle."
                                            },
                                            {
                                                "example_id": "f1c64f5a-d9be-40f5-b4d9-36630aa3f85c",
                                                "sense_id": "db7bf0d6-6a67-3705-afe4-a1af19892a67",
                                                "text": "No man is an Iland, intire of it ſelfe; euery man is a peece of the Continent, a part of the maine; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2d23e37-2ed0-3840-998e-043f47f54889",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A single item belonging to a class of similar items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a6275e-0f49-4977-9360-a3b81c761d41",
                                                "sense_id": "e2d23e37-2ed0-3840-998e-043f47f54889",
                                                "text": "a piece of machinery"
                                            },
                                            {
                                                "example_id": "10f420bd-9126-4e9c-8490-b214bb366635",
                                                "sense_id": "e2d23e37-2ed0-3840-998e-043f47f54889",
                                                "text": "a piece of software"
                                            },
                                            {
                                                "example_id": "53f524ac-35c2-455d-b7b2-c2fd772f909c",
                                                "sense_id": "e2d23e37-2ed0-3840-998e-043f47f54889",
                                                "text": "a useful piece of advice"
                                            },
                                            {
                                                "example_id": "9f3a81c1-82f0-4c38-839c-54d39a2af9c3",
                                                "sense_id": "e2d23e37-2ed0-3840-998e-043f47f54889",
                                                "text": "\"Squalled at me that she owned the business and that she wouldn't take any back talk from me and that the piece wasn't for sale. What could I do?\""
                                            },
                                            {
                                                "example_id": "b8f3c98d-4677-486b-99ec-9a1f98ad4b10",
                                                "sense_id": "e2d23e37-2ed0-3840-998e-043f47f54889",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec7f643-94da-3714-a068-39f76686c34e",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "One of the figures used in playing chess, specifically a higher-value figure as distinguished from a pawn; (by extension) those with which draughts, backgammon, and other similar board games are played."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12121f15-5c5c-477b-918a-08720b5e6b43",
                                                "sense_id": "5ec7f643-94da-3714-a068-39f76686c34e",
                                                "text": "Pawns, unlike pieces, move only in one direction: forward."
                                            },
                                            {
                                                "example_id": "efec9f7a-e19f-406f-9767-58e5b08407ee",
                                                "sense_id": "5ec7f643-94da-3714-a068-39f76686c34e",
                                                "text": "It is not permitted to move a piece to a square occupied by a piece of the same colour. […] Consequently, in the initial position the white pieces and pawns are placed on the first and second ranks; the black pieces and pawns on the eighth and seventh ranks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e577984b-d408-3b5a-9ce7-49359f67e4c2",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A coin, especially one valued at less than the principal unit of currency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb35dd86-0746-45df-b751-70b9a2c2732b",
                                                "sense_id": "e577984b-d408-3b5a-9ce7-49359f67e4c2",
                                                "text": "a sixpenny piece"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "405e9918-2eb9-380e-b72f-66be1124e517",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "An artistic creation, such as a painting, sculpture, musical composition, literary work, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2db4ae-a048-459f-9236-08c0fb532fbd",
                                                "sense_id": "405e9918-2eb9-380e-b72f-66be1124e517",
                                                "text": "She played two beautiful pieces on the piano."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90cf5696-e694-32d4-a1ed-44c34a2be2b6",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "An article published in the press."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b58a5a6-a858-4757-8257-f6f32256ecf0",
                                                "sense_id": "90cf5696-e694-32d4-a1ed-44c34a2be2b6",
                                                "text": "Today's paper has an interesting piece on medical research."
                                            },
                                            {
                                                "example_id": "070389a1-8827-4919-a583-f60cdeea0318",
                                                "sense_id": "90cf5696-e694-32d4-a1ed-44c34a2be2b6",
                                                "text": "No, I didn't read the piece on China's faceless masses, I was, I was checking out the lingerie ads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32355b17-04fa-3edf-b80c-5e0adca29bef",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "An artillery gun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c85c666-89af-4e0e-b393-3cb289d1607d",
                                                "sense_id": "32355b17-04fa-3edf-b80c-5e0adca29bef",
                                                "text": "[…] all our Ammunition was spent. Those of us who had Money made Slugs of it; their next Shift was to take the middle Screws out of their Guns, and charge their Pieces with them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30394c56-2529-313c-94f6-c4d027ab001c",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A gun."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "724dc7f7-c77d-440e-b0a2-d2f1fa9c4fc5",
                                                "sense_id": "30394c56-2529-313c-94f6-c4d027ab001c",
                                                "text": "He's packin' a piece!"
                                            },
                                            {
                                                "example_id": "31fca030-b767-467e-b880-af09a5a25b3b",
                                                "sense_id": "30394c56-2529-313c-94f6-c4d027ab001c",
                                                "text": "I wanted peace, but now my piece is clearing out the block."
                                            },
                                            {
                                                "example_id": "b87f2913-cd6f-41b4-b42c-787912d54aaa",
                                                "sense_id": "30394c56-2529-313c-94f6-c4d027ab001c",
                                                "text": "It was do or be done. Get or get gotten. It was self-preservation like I'd never felt before, and when Rome passed me his piece I didn't even hesitate as I raised that bitch in the air and aimed it at Vyreen."
                                            },
                                            {
                                                "example_id": "ea5f80f9-e4ff-494e-83ba-73863678d091",
                                                "sense_id": "30394c56-2529-313c-94f6-c4d027ab001c",
                                                "text": "\"This is just a cover story,\" Clay says to O5-8, not taking his eyes off Marion. \"It's a good one, but she's had it worked out in advance.\"\n\"Clay, lose the piece,\" says the O5.\nGrudgingly, Clay does so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a096d0f-fa6b-303d-afad-2371ec2e98a4",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A toupee or wig, especially when worn by a man."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a40ce013-24fd-4837-9b51-f3cf4da415f9",
                                                "sense_id": "4a096d0f-fa6b-303d-afad-2371ec2e98a4",
                                                "text": "The announcer is wearing a new piece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48b73a61-e1e8-3062-b758-4d9d41710ef1",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A slice or other quantity of bread, eaten on its own; a sandwich or light snack."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Scotland",
                                            "UK",
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b68d35-8c8a-43b6-ac22-569e64361225",
                                                "sense_id": "48b73a61-e1e8-3062-b758-4d9d41710ef1",
                                                "text": "My grannie came and gived them all a piece and jam and cups of water then I was to bring them back out to the street and play a game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "829c40b4-a222-3876-b923-aac3bff01d24",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A sexual encounter; from piece of ass or piece of tail."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6cc3dd-2b22-45c5-8164-703cc7fdefc3",
                                                "sense_id": "829c40b4-a222-3876-b923-aac3bff01d24",
                                                "text": "I got a piece at lunchtime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8059098f-c6da-3dc3-b2d8-c4a993a17012",
                                        "entry_id": "81ef7b35-82a1-304f-9321-7928c0308a0f",
                                        "glosses": [
                                            "A shoddy or worthless object (usually applied to consumer products like vehicles or appliances)."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f87ae8-42ed-475b-bdf4-f1f4ea2828c9",
