                                        "sense_id": "b6fc1195-d80a-37fe-987e-06a37b39e86e",
                                        "entry_id": "3e1a82e9-4d3b-315e-a903-e9410ec2b28f",
                                        "glosses": [
                                            "Personne ou animal s’adonnant à la chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6136d794-ac90-487b-bb4f-e4ca405345b7",
                                                "sense_id": "b6fc1195-d80a-37fe-987e-06a37b39e86e",
                                                "text": "Quand mon appétit fut un peu apaisé, j’entamai avec ma chasseuse d’insectes un dialogue que mon ignorance de la langue espagnole bornait nécessairement beaucoup."
                                            },
                                            {
                                                "example_id": "289fc8c8-05f8-4f5c-aa04-3b68dc891158",
                                                "sense_id": "b6fc1195-d80a-37fe-987e-06a37b39e86e",
                                                "text": "Linnea Lindeman – une forte femme, chasseuse de phoques et accoucheuse un peu chamane …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9849a60d-8463-3ec7-9d74-f8d4b5e27518",
                                        "entry_id": "3e1a82e9-4d3b-315e-a903-e9410ec2b28f",
                                        "glosses": [
                                            "Celle cherchant passionnément une chose ou une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50aaa9e0-c9dd-46fb-b77e-cd97b69c5105",
                                                "sense_id": "9849a60d-8463-3ec7-9d74-f8d4b5e27518",
                                                "text": "Durant quelques années, j’ai été chasseuse de têtes : j’étais censée évaluer des candidats expérimentés qui occupaient des fonctions complexes et techniques, auxquelles je ne pouvais, du haut de mes vingt-deux ans, rien comprendre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chasseuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b40c3d11-0261-38e6-955f-d4d507d7c897",
                                        "entry_id": "da64e083-4814-3f70-b245-9bb195e12e79",
                                        "glosses": [
                                            "Cordelette dont les cochers et les charretiers se servaient pour mettre au bout de leurs fouets."
                                        ],
                                        "tags": [
                                            "Lorraine"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chasseuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0746e35a-a223-3de6-80a4-3f7564412f83",
                                        "entry_id": "1ec3b7b1-1358-3e1b-9ebc-5cb9185153b0",
                                        "glosses": [
                                            "Féminin singulier de chasseur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7600ca29-2566-4afd-bca2-c39bc57e6942",
                                                "sense_id": "0746e35a-a223-3de6-80a4-3f7564412f83",
                                                "text": "Également surnommées « araignées chasseuses » par les anglophones, les Sparassidae sont des arachnides très communs en Australie et sont fréquemment retrouvés dans les foyers où ils viennent chasser directement leurs proies, le plus souvent des grillons et des blattes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
