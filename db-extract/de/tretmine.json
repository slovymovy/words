                ],
                "senses": [
                    {
                        "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                        "entry_id": "4a561d29-da3b-314a-973d-d831b37e13bb",
                        "glosses": [
                            "Mine, die durch Drauftreten oder Befahren sofort oder verzögert gezündet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc5ef9ac-2993-4208-b8e3-47b933195b90",
                                "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                                "text": "Tretminen sind für spielende Kinder sehr gefährlich."
                            },
                            {
                                "example_id": "cbab1d0c-399c-4bc7-80b1-5bcaa54fb3d5",
                                "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                                "text": "Die weitaus meisten Tretminen verletzen oder töten Zivilisten."
                            },
                            {
                                "example_id": "7c77f1b2-8ad1-4105-ad24-382959a1bd43",
                                "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                                "text": "Tretminen gehören zu den grausamsten Waffen, die Menschen je erfunden haben."
                            },
                            {
                                "example_id": "fb8104ac-0fa5-4e96-93dc-67e06df9676b",
                                "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                                "text": "„Ein Team der Vereinten Nationen hat eine im Boden verborgene Tretmine nahe der südsudanesischen Hauptstadt Juba aufgespürt, dann Sandsäcke um sie herum gestapelt und die Mine schließlich gezündet.“"
                            },
                            {
                                "example_id": "459a2f4c-7f6b-41cf-9d8d-98c255e409a0",
                                "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                                "text": "„[…] mehr als 20 Jahre nach dem Verbot von Tretminen werden sie immer noch hergestellt, und die Zahl der Opfer steigt.“"
                            },
                            {
                                "example_id": "25cf7b0d-40a1-4d35-9a7c-4a0ece37b96e",
                                "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                                "text": "„Für [die meisten Terrorgruppen] zählt, dass Tretminen zu den billigsten und zugleich furchterregendsten Waffen überhaupt gehören. Zwischen drei und fünf Dollar kostet ein solcher Sprengsatz in der Herstellung.“"
                            },
                            {
                                "example_id": "da961d63-c9f0-40fd-9dcc-d580b596d306",
                                "sense_id": "4b39daac-1194-315f-a4e5-21bdd0af93ec",
                                "text": "„Vor Aushandlung der Ottawa-Konvention gingen die Vereinten Nationen davon aus, dass in den Böden von mehr als 70 Ländern 110 Millionen Tretminen lagen. Das US-Außenministerium schätzte die Zahl dagegen auf 70 Millionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9c139f53-90c3-3b26-878c-0498a8f3db8e",
                        "entry_id": "4a561d29-da3b-314a-973d-d831b37e13bb",
                        "glosses": [
                            "Kot im öffentlichen Raum"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "e0291d86-7e84-49ca-926e-ef34ff5c4f00",
                                "sense_id": "9c139f53-90c3-3b26-878c-0498a8f3db8e",
                                "text": "Es ist eine Beleidigung der Opfer einer Tretmine, den an sich harmlosen Hundehaufen Tretmine zu nennen."
                            },
                            {
                                "example_id": "4fc17543-0275-4fbc-a18d-e8edae4c7fbb",
                                "sense_id": "9c139f53-90c3-3b26-878c-0498a8f3db8e",
                                "text": "„Tretminen, haben wir sie getauft, die oft tellergroßen Haufen, die die Hunde der Römer ungeniert mitten auf den Gehsteigen hinterlassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
