                        "sense_id": "c4aa5f49-d2b6-387d-b63f-39aef6a10538",
                        "entry_id": "e405dc45-ea27-3a72-b48f-4e49d6b0aeaf",
                        "glosses": [
                            "Alternative form of hathi (“an elephant”)."
                        ],
                        "tags": [
                            "India",
                            "alt-of",
                            "alternative",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fd908932-c199-404a-8a25-421f4d7834f1",
                                "sense_id": "c4aa5f49-d2b6-387d-b63f-39aef6a10538",
                                "text": "[…] the credit of it, if any there be, must be given to old Purdey, the maker of your rifle; for never do I think that grooved bore threw lead so true, and I now do not wonder at your luck in bringing down the hatties (elephants) right and left."
                            },
                            {
                                "example_id": "4b4f3efc-4e38-4d12-96a8-d2298f8566e1",
                                "sense_id": "c4aa5f49-d2b6-387d-b63f-39aef6a10538",
                                "text": "Several herds of wild buffaloes were met on our way , but as our hatties, as well as the drivers, were too done up, we allowed them to pass unmolested."
                            }
                        ]
                    }
                ],
