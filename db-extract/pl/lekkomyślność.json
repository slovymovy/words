                        ]
                    },
                    {
                        "translation_id": "e2692a45-222f-440d-8b77-7133116be4ab",
                        "source_entry_id": "92e4817d-d2be-3038-9ef6-784eedc05f94",
                        "source_sense_id": "ccc8754c-c0dd-37ee-bbf4-e67606eca973",
                        "target_lang_word": "recklessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recklessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                                        "entry_id": "4e9ba22e-5c89-36bd-8767-f635b38ee539",
                                        "glosses": [
                                            "The state or quality of being reckless or heedless, of taking unnecessary risks."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d70bf0-b3b5-4d92-b80d-e653ab342be5",
                                                "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                                                "text": "His recklessness repeatedly put him in danger."
                                            },
                                            {
                                                "example_id": "55e8fe8e-76b6-46e7-aa8d-73af6f8302f4",
                                                "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                                                "text": "At such times, how we marvel at our usual recklessness, and pause, as it were, shrinking from the busy and inevitable current which is hurrying us on to eternity!"
                                            },
                                            {
                                                "example_id": "5d032659-b287-40e0-8a39-6f3581246fb9",
                                                "sense_id": "772d793e-2349-3084-aaeb-d30e456745ec",
                                                "text": "Partly because of the heavy burden of government debt built up during his stewardship, and the uncurbed recklessness of the country’s banks, Britain’s recession is already the harshest in Western Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85acfc6d-cfa5-4a74-bf3b-d35e077873ab",
                        "source_entry_id": "92e4817d-d2be-3038-9ef6-784eedc05f94",
                        "source_sense_id": "ccc8754c-c0dd-37ee-bbf4-e67606eca973",
                        "target_lang_word": "Leichtsinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichtsinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                        "entry_id": "8e4a3488-b732-384a-af21-c6ccec03346d",
                                        "glosses": [
                                            "Mangel an Vorsicht und Überlegung beim Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f6d732-d8a4-41dc-8a85-3eddf4d357c7",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "Wahrscheinlich war es tödlicher Leichtsinn beim Überholen, der am Sonntagabend einen 31-jährigen Heidelberger das Leben kostete."
                                            },
                                            {
                                                "example_id": "ea07347b-1659-43e5-bb70-b26b7a74cb37",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "Der Leichtsinn ist ein Schwimmgürtel für den Strom des Lebens. (Ludwig Börne)"
                                            },
                                            {
                                                "example_id": "e9b0731e-088c-4926-ab54-ecca946a64eb",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Bei mir war es Leichtsinn und das wohlige Gefühl, meinem Körper etwas Gutes getan und somit etwas Nützliches geleistet zu haben.“"
                                            },
                                            {
                                                "example_id": "ce027ee3-2ad3-421c-97fe-b122506baa94",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Es ist weniger Galgenhumor als Leichtsinn und vielleicht Unkenntnis der Sachlage.“"
                                            },
                                            {
                                                "example_id": "8715f2b0-f4ec-4397-8ae2-27b93dee9d72",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Man möge mich nicht des Leichtsinns im Studium meines Tagebuches beschuldigen, mit Gewissenhaftigkeit entziffere ich die dunklen Stellen und freue mich wie jeder andere Gelehrte, wenn ich das Richtige herausfinde.“"
                                            },
                                            {
                                                "example_id": "eab4ad4e-7158-4fd0-ae27-2068f96a02d7",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Wenn unerfahrene Bergsportler die falsche Route wählen oder dem sicheren Weg das steile Gelände vorziehen, arbeitet der Leichtsinn der Technik entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8b83201-1545-4062-9b06-3aaa36564c52",
                        "source_entry_id": "92e4817d-d2be-3038-9ef6-784eedc05f94",
