                ],
                "senses": [
                    {
                        "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                        "entry_id": "19c8eccb-76ae-3ce9-85f7-320004d09505",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6e1a420-c14f-4401-9d39-f22f6f99699a",
                                "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                                "text": "Frau Lohmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "afec5bdd-5d4b-42e3-bc3b-58ef33d2bbd1",
                                "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                                "text": "Herr Lohmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4343848e-dc65-4fc0-8316-bf05a2a5ea34",
                                "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                                "text": "Die Lohmanns fahren heute nach Kopenhagen."
                            },
                            {
                                "example_id": "4364bc63-02fd-436c-88a2-0fd09cbe6239",
                                "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                                "text": "Der Lohmann trägt nie die Schals, die die Lohmann ihm strickt."
                            },
                            {
                                "example_id": "24072c5c-2396-4ba9-8646-b94be753f313",
                                "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lohmann kommt, geht der Herr Lohmann.“"
                            },
                            {
                                "example_id": "cf233132-30c0-4baf-b4fc-500995de7f84",
                                "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                                "text": "Lohmann kommt und geht."
                            },
                            {
                                "example_id": "24f25ffa-a038-4049-a38a-01487c4f2f96",
                                "sense_id": "c35cf9b0-e92c-3f86-9ed0-fb6198ecd2d5",
                                "text": "Lohmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
