                "senses": [
                    {
                        "sense_id": "b1b0b7c5-1360-328b-900a-09d846f4e2a7",
                        "entry_id": "c774c6a8-819d-3530-8f68-3b3f62dbac96",
                        "glosses": [
                            "Rendre proche du syndicaliste Laurent Berger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc87911c-a593-4864-aa08-c4924a649688",
                                "sense_id": "b1b0b7c5-1360-328b-900a-09d846f4e2a7",
                                "text": "De quoi alimenter la réflexion des militants pour en finir avec l’ostracisme à l’égard de la FSM, la subordination à un syndicalisme européen bergérisé et retisser les fils d’un syndicalisme international sur un véritable contenu de classe et de solidarité."
                            },
                            {
                                "example_id": "a71843eb-8b80-4b6b-a999-439e231cfcd5",
                                "sense_id": "b1b0b7c5-1360-328b-900a-09d846f4e2a7",
                                "text": "De journal de référence c’est devenu un torchon \"bergérisé\" (RIP si tu peux),"
                            }
                        ]
                    },
                    {
                        "sense_id": "a206b6dc-43e7-3316-92cc-0d14c17cbf15",
                        "entry_id": "c774c6a8-819d-3530-8f68-3b3f62dbac96",
                        "glosses": [
                            "Se mettre à pratiquer l’activité de berger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8562c12-6bea-441c-a741-48b14c9f9a65",
                                "sense_id": "a206b6dc-43e7-3316-92cc-0d14c17cbf15",
                                "text": "Quant à Sissa, j’ai répondu trop vite à segalas, autrement je me serais \"bergérisé\" et quelques-uns de mes problèmes aurait été réglés."
                            }
                        ]
                    }
                ],
