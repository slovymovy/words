                                        "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "A sticky, black to brown and highly viscous liquid or semi-solid, composed almost entirely of bitumen with small mineral particles, that is present in most crude petroleums and in some natural deposits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3384066d-357a-4d53-822d-b0ea8704ec4b",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "The mining of asphalt was big business in this area in the early twentieth century."
                                            },
                                            {
                                                "example_id": "8c6190b2-5f40-4cdc-9ef6-f630d3ba8c03",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "Felltham wrote in the beginning of the 17th century of the “Bitumated walls of Babylon;” the source of its supply, the fountains of Is, on a tributary of the Euphrates, still yields asphalt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "Ellipsis of asphalt concrete, a hard ground covering used for roads and walkways."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
