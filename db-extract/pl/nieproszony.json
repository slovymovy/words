                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e61a86c1-6e20-4d5a-9bdb-b7f22b5e7354",
                        "source_entry_id": "55634bc4-39de-3247-8260-e8bc54ac1def",
                        "source_sense_id": "aafb274c-ff62-382a-abbb-3ecb5dd13079",
                        "target_lang_word": "непрошеный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "непрошеный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "35999330-cb61-3287-a96f-37c3ca742ff8",
                                        "entry_id": "6717b678-c23f-3fb1-9cb1-f9b50b4efa82",
                                        "glosses": [
                                            "явившийся, делающий, предлагающий что-либо или предлагаемый кем-либо без приглашения, навязывающий своё присутствие, действие кому-либо; незваный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c462d7-521c-43d9-8960-f4448e7ee46c",
                                                "sense_id": "35999330-cb61-3287-a96f-37c3ca742ff8",
                                                "text": "Шиллеру показалось очень досадно, что вдруг незнакомое, непрошеное лицо так некстати ему помешало."
                                            },
                                            {
                                                "example_id": "43c46634-60d8-4f2b-b915-405c70cafa0f",
                                                "sense_id": "35999330-cb61-3287-a96f-37c3ca742ff8",
                                                "text": "Не позволил бы Анатолий Андреевич лезть к нему с непрошеными советами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec459f9-c546-3903-94b1-ecfa3f9ff773",
                                        "entry_id": "6717b678-c23f-3fb1-9cb1-f9b50b4efa82",
                                        "glosses": [
                                            "невольный, появляющийся у кого-либо против его воли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "562b6ffb-c733-4898-b539-795a120386fe",
                                                "sense_id": "5ec459f9-c546-3903-94b1-ecfa3f9ff773",
                                                "text": "Прост он был, как дитя, и уже непрошеная жалость к этим малюткам покинутым вползала в сердце."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
