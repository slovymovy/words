                "senses": [
                    {
                        "sense_id": "6609b558-3410-3a01-a07c-90f05b7669fd",
                        "entry_id": "8462a108-c147-3f3d-b220-70b37bd938ee",
                        "glosses": [
                            "oral entleerter Magen- und/oder Speiseröhreninhalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b620b281-d6da-4088-b268-c645d57e8597",
                                "sense_id": "6609b558-3410-3a01-a07c-90f05b7669fd",
                                "text": "„Die Erreger werden über den Stuhl des Menschen oder über Erbrochenes ausgeschieden.“"
                            },
                            {
                                "example_id": "74cd5577-4649-452f-a4a8-caf2f9c88ec4",
                                "sense_id": "6609b558-3410-3a01-a07c-90f05b7669fd",
                                "text": "„Die innig miteinander verbundenen Gerüche nach Urin und Erbrochenem hängen schwer in der Luft.“"
                            },
                            {
                                "example_id": "bbbad24c-e243-4967-b707-dc3ff2d74b5f",
                                "sense_id": "6609b558-3410-3a01-a07c-90f05b7669fd",
                                "text": "„Ein erster Geschmack von Erbrochenem kroch meine Speiseröhre hoch.“"
                            },
                            {
                                "example_id": "8c49093f-db9a-4f38-9ef8-98c4ecc5cafb",
                                "sense_id": "6609b558-3410-3a01-a07c-90f05b7669fd",
                                "text": "„Er war auf der Suche nach einer anderen Welt am Nachthimmel am eigenen Erbrochenen erstickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a758718-68a4-44f2-9262-efa795a4f9d2",
                        "source_entry_id": "8462a108-c147-3f3d-b220-70b37bd938ee",
                        "source_sense_id": "6609b558-3410-3a01-a07c-90f05b7669fd",
