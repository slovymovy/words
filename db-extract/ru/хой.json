        "ru-extract.jsonl": [
            {
                "entry_id": "c7bbcc47-dd3a-3667-81d1-ef1156d91754",
                "word": "хой",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c565795c-6910-3aa1-be3e-f8c9b7cf52d5",
                        "entry_id": "c7bbcc47-dd3a-3667-81d1-ef1156d91754",
                        "glosses": [
                            "жарг. слово, используемое советскими и постсоветскими панками в качестве приветствия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72d6293-75e4-4495-ae5e-012e17d4329d",
                                "sense_id": "c565795c-6910-3aa1-be3e-f8c9b7cf52d5",
                                "text": "Андрей расплатился с таксистом, вошёл в подъезд, поднялся по лестнице на свой этаж, с неодобрением читая надписи на стенах, все эти «АС/ DС», «Панки ― хой!», «Люблю „Скутер“», «Толян ― козел» и тому подобное."
                            },
                            {
                                "example_id": "bb93b000-482d-4731-9dd6-8e0e12a6ae7e",
                                "sense_id": "c565795c-6910-3aa1-be3e-f8c9b7cf52d5",
                                "text": "Пятнадцатилетние волосатики сидели на траве и бренчали на гитаре с надписью «Панки, хой!»"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
