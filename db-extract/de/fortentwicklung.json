                                                "sense_id": "ed2791ab-14e1-35bf-8c09-f63315264663",
                                                "text": "Of more significance in the nature of branch development; in the Jubulaceae, as in the Porellaceae, branches are acroscopic and normally replace a ventral leaf lobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c9b9e36-fea5-3111-b943-9ae6ddc22ddf",
                                        "entry_id": "47c87bd3-5b8f-3949-aa71-fbf867e216ab",
                                        "glosses": [
                                            "Something which has developed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa98ac3-6331-4ae2-b601-c5cfdd18cd10",
                                                "sense_id": "6c9b9e36-fea5-3111-b943-9ae6ddc22ddf",
                                                "text": "Our news team brings you the latest developments."
                                            }
