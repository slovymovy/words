                        "examples": [
                            {
                                "example_id": "a92f4f76-34bd-4f10-ae74-489120300146",
                                "sense_id": "97e77bb2-57b5-31d8-a05d-8b7ec26204e2",
                                "text": "„Schweißperlen standen auf Lottie Maes Gesicht wie Öltropfen.“"
                            },
                            {
                                "example_id": "e9acc953-7500-4f8d-9793-1b432888f50e",
                                "sense_id": "97e77bb2-57b5-31d8-a05d-8b7ec26204e2",
                                "text": "„Die Trugbilder glänzten schillernd wie Öltropfen in Wasser.“"
                            },
                            {
                                "example_id": "13b11a82-1256-42a7-8e60-4d5287da61cc",
                                "sense_id": "97e77bb2-57b5-31d8-a05d-8b7ec26204e2",
                                "text": "„Ihre Öltropfen gleichenden Augen glänzen im gelblichen Widerschein der nächsten Straßenlaterne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
