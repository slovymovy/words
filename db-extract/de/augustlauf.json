                "senses": [
                    {
                        "sense_id": "e5a391c3-ce85-3dd7-8f6a-03974ba3b60d",
                        "entry_id": "7ef700e6-f3e6-3f76-9904-5b6b3a8308ec",
                        "glosses": [
                            "Laufen/Joggen oder Laufveranstaltung im Monat August"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "3c990498-03e8-40a1-a7f5-faf7f7fbee1f",
                                "sense_id": "e5a391c3-ce85-3dd7-8f6a-03974ba3b60d",
                                "text": "„Wir freuen uns, den Bleienbacher Augustlauf bereits zum 43. Mal durchführen zu dürfen.“"
                            },
                            {
                                "example_id": "102f74e0-bb29-41bb-a330-4edb7551a0c7",
                                "sense_id": "e5a391c3-ce85-3dd7-8f6a-03974ba3b60d",
                                "text": "„Auf der Seite von SwissRunning findest du weitere Detail-Informationen zu unserem Augustlauf: Link“"
                            },
                            {
                                "example_id": "44832150-f8bc-4bce-aac6-50c0caf4605d",
                                "sense_id": "e5a391c3-ce85-3dd7-8f6a-03974ba3b60d",
                                "text": "„Der Bleienbacher Augustlauf ist für Einsteigerinnen und Einsteiger mit der flachen Laufstrecke von einer Länge von 4 km ebenso geeignet wie für Walkerinnen und Walker mit einer Strecke von 8 km und natürlich für Läuferinnen und Läufer mit der Hauptstrecke von 10.2 km.“"
                            },
                            {
                                "example_id": "00bea95b-256e-42fc-9e7f-42ddb8ec524c",
                                "sense_id": "e5a391c3-ce85-3dd7-8f6a-03974ba3b60d",
                                "text": "„Auch der Augustlauf von unserem Turnverein ist mittlerweile ein fester Bestandteil unseres Trainings.“"
                            },
                            {
                                "example_id": "0e143ef9-1364-4232-9863-f843a0769422",
                                "sense_id": "e5a391c3-ce85-3dd7-8f6a-03974ba3b60d",
                                "text": "„Mit ingesamt 45 Läuferinnen, Läufern und einer Rollstuhlfahrerin gab es für den Augustlauf eine gute Beteiligung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
