                                                "example_id": "ba216591-ae90-4561-aca5-de656ff90724",
                                                "sense_id": "bbc25c00-c72d-331b-af74-f727615e4371",
                                                "text": "Der Statist spielte einen Passanten, der sich im Hintergrund in der Nase bohrte."
                                            },
                                            {
                                                "example_id": "7e480888-5be9-420b-a45c-9a8e0a47eefd",
                                                "sense_id": "bbc25c00-c72d-331b-af74-f727615e4371",
                                                "text": "„Ein anderer Statist musste die ganze Zeit auf einer Tragbahre mit dem Katheter in der Hand liegen und laut stöhnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
