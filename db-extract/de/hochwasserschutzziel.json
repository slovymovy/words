                "senses": [
                    {
                        "sense_id": "e716ace9-42b2-3d87-93e0-f0d787fc5392",
                        "entry_id": "26c30ce8-8c16-3346-a2b5-04b33b19e0fb",
                        "glosses": [
                            "klar umrissene Ausrichtung oder gedanklicher Endpunkt einer hochwassertechnischen Bestrebung, etwas oder jemanden im Hochwasserfall zu sichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7f93e4-fac2-48bd-9ffd-bbe6e6584d82",
                                "sense_id": "e716ace9-42b2-3d87-93e0-f0d787fc5392",
                                "text": "„Dieses Hochwasserschutzziel konnte durch Maßnahmen des technischen Hochwasserschutzes und durch eine Verbesserung des natürlichen Wasserrückhaltes nahezu flächenhaft erreicht werden.“"
                            },
                            {
                                "example_id": "8d1f270f-f81e-4951-a69d-3cbb29a9db0a",
                                "sense_id": "e716ace9-42b2-3d87-93e0-f0d787fc5392",
                                "text": "„Im Rahmen des Werkstattgespräches Transnationale Zusammenarbeit in der Praxis möchten wir Ihnen Partnerschaften, Produkte, und Pilotprojekte sowie Ideen für die weitere gemeinsame Arbeit am Hochwasserschutzziel vorstellen.“"
                            },
                            {
                                "example_id": "f30caf88-816a-4200-bdde-e7cf72e51706",
                                "sense_id": "e716ace9-42b2-3d87-93e0-f0d787fc5392",
                                "text": "„Bei Maßnahmen zur Habitatverbesserung und zur Geschiebebewirtschaftung sollen Hochwasserschutzziele beachtet und in die Planungen mit einbezogen werden.“"
                            },
                            {
                                "example_id": "7050c949-f3ab-451f-801d-ea8cbe90c852",
                                "sense_id": "e716ace9-42b2-3d87-93e0-f0d787fc5392",
                                "text": "„Das Leben und Objekte in unmittelbarer Nähe der Alten Aare werden geschützt und die Hochwasserschutzziele nachhaltig und zukunftsgerichtet erfüllt.“"
                            },
                            {
                                "example_id": "153c5dcc-68b4-43c5-9a74-72d4d70ecd18",
                                "sense_id": "e716ace9-42b2-3d87-93e0-f0d787fc5392",
                                "text": "„Mit Hilfe eines Flussgebietsmodells wurde für verschiedene Hochwasserereignisse die Wirkung einzelner Becken und Beckenkombinationen untersucht und deren optimale Betriebsreglements mit festen Schiebestellungen für verschiedene Hochwasserschutzziele abgeleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
