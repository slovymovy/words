                "senses": [
                    {
                        "sense_id": "a59a10f5-6f93-3bf3-ac93-0483aabc8549",
                        "entry_id": "c28cd146-dd58-338a-bbe4-4d1fe38f2b9c",
                        "glosses": [
                            "относящийся к разделу математики, который занимается изучением операций с логическими значениями истинности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58a33caa-dcf2-4a9a-8d11-e2b30de78ef9",
                                "sense_id": "a59a10f5-6f93-3bf3-ac93-0483aabc8549",
                                "text": "Отметим здесь, что метод булевого поиска несколько шире ― он предполагает нахождение документов, для которых истинна некоторая булева функция, связывающая слова запроса."
                            }
                        ]
                    }
