                                        "sense_id": "cbc5cfd0-dc9f-3afa-856d-8c8bb19c39f5",
                                        "entry_id": "9e6634db-90c7-373a-acf3-e044d42ca2be",
                                        "glosses": [
                                            "A word (such as because) that expresses a reason or a cause."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
