                ],
                "senses": [
                    {
                        "sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
                        "entry_id": "f2c829da-e1a9-3a50-83ae-cf3512b5564c",
                        "glosses": [
                            "pracownik służb państwowych, zwykle mundurowych np. policji lub służby więziennej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c51976-ad37-4672-9136-c8b2f2bce4ba",
                                "sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
                                "text": "Znajomy mojego brata jest funkcjonariuszem Policji."
                            },
                            {
                                "example_id": "c0cebe85-a8b2-4a3b-9fe6-5c741d9e410f",
                                "sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
                                "text": "(…) funkcjonariusze z Bogatyni (woj. dolnośląskie) dorabiali, handlując narkotykami we Wrocławiu, Wałbrzychu, Jeleniej Górze"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cf6fa976-62be-31f8-bbef-822b091de167",
                        "entry_id": "f2c829da-e1a9-3a50-83ae-cf3512b5564c",
                        "glosses": [
                            "działacz partii rządzącej piastujący wysokie stanowisko"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a38c26fd-2054-445d-89da-db85dba37af1",
                        "source_entry_id": "f2c829da-e1a9-3a50-83ae-cf3512b5564c",
                        "source_sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
                        "target_lang_word": "functionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "functionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a89a1dd-b5d5-325c-ab73-024a7df6858a",
                                        "entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
                                        "glosses": [
                                            "A person employed as an official in a bureaucracy (usually corporate or governmental) who holds limited authority and primarily serves to carry out a simple function for which discretion is minimal or not required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3689da1a-a876-4d25-82a8-222d411781ca",
                                                "sense_id": "1a89a1dd-b5d5-325c-ab73-024a7df6858a",
                                                "text": "Near-synonyms: bureaucrat; official; officer; administrator; apparatchik"
                                            },
                                            {
                                                "example_id": "1a574453-bf54-43e7-b64f-d23b5f0356f1",
                                                "sense_id": "1a89a1dd-b5d5-325c-ab73-024a7df6858a",
                                                "text": "Consciences are for politicians, Bernard! We are humble functionaries whose duty it is to implement the commands of our democratically elected representatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "591b5356-3e74-3693-83c2-17c4cb9b1e73",
                                        "entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
                                        "glosses": [
                                            "Such a person who is petty, pedantic, short-sighted, uncaring, or counterproductive; sometimes also with implication of being amoral or corrupt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f4923fa-3ea5-4e34-b3c2-03ef96bcca42",
                                                "sense_id": "591b5356-3e74-3693-83c2-17c4cb9b1e73",
                                                "text": "Near-synonyms: bureaucrat, apparatchik; paper-pusher; bean counter"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fdc045d-5ba8-4064-807e-96dbbac280ca",
                        "source_entry_id": "f2c829da-e1a9-3a50-83ae-cf3512b5564c",
                        "source_sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
                        "target_lang_word": "officer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "officer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f64d50a2-8942-3bd8-8fe1-ec37378169b5",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "One who has a position of authority in a hierarchical organization, especially in military, police or government organizations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aadc738-c2e7-40ba-8f9a-d41b83a3fb17",
                                                "sense_id": "f64d50a2-8942-3bd8-8fe1-ec37378169b5",
                                                "text": "Huerta was arrested while law enforcement officers were executing a federal search warrant at a Los Angeles business suspected of hiring illegal immigrants and falsifying employment papers, a special agent for Homeland Security Investigations, which is part of Immigration and Customs Enforcement, wrote in a federal court filing. […] A law enforcement officer approached Huerta and told him to leave, then put his hands on Huerta to move him out of the way of a vehicle, the agent wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd200d3a-5328-3eb5-80de-594d6dead8ab",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "A respectful term of address for an officer, especially a police officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffe08ca-6018-458e-938f-05c23dd7b30b",
                                                "sense_id": "dd200d3a-5328-3eb5-80de-594d6dead8ab",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d290c2-c22d-3095-bc78-0054df4555da",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "One who holds a public office."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfbe0503-98c5-37cf-809a-cd00e56ec3ad",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "An agent or servant imparted with the ability, to some degree, to act on initiative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adad8a56-d33d-350a-8353-269bc3c0daa0",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "A commissioned officer."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "officer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1b59cb4-f07e-36d1-b953-c58d08f29115",
                                        "entry_id": "f429cb25-6674-3f3f-84ce-37ec8a504758",
                                        "glosses": [
                                            "To supply with officers."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
                                        "entry_id": "f429cb25-6674-3f3f-84ce-37ec8a504758",
                                        "glosses": [
                                            "To command as or like an officer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cabb891-9d49-4758-af9c-ebcd7071f1b3",
                                                "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
                                                "text": "Many of our journals are officered by Irish gentlemen, and their gallant brigade does the penning among us, as their ancestors used to transact the fighting in Europe; and engage under many a flag, to be good friends when the battle is over."
                                            },
                                            {
                                                "example_id": "c8ce4fa4-cd70-485b-aa9c-14254b8993ec",
                                                "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
                                                "text": "The regular battalions of the regiment, though officered mainly by Anglo-Welshmen of county families, did not normally contain more than about one Welshman in fifty in the ranks."
                                            },
                                            {
                                                "example_id": "d6579792-5756-4a46-91a1-6125d144cc81",
                                                "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
                                                "text": "[A]t least a quarter of those who fought and died in the Great War were prosperous with spacious homes, and to this class belonged nearly all who had ordered and officered the carnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52bd0189-9c75-4d16-82ae-16186f52e64e",
                        "source_entry_id": "f2c829da-e1a9-3a50-83ae-cf3512b5564c",
                        "source_sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
                        "target_lang_word": "fonctionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fonctionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                        "entry_id": "e5df9337-531f-347f-bc26-f21578e37951",
                                        "glosses": [
                                            "Celui, celle qui remplit une fonction de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd6a698-bd1b-46b9-809f-d86170dbb7ca",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Qu’est-ce que la vertu ? Au sens où l’entend son restaurateur, c’est sans doute la probité et le désintéressement, c’est ce genre d’intégrité qui rend un fonctionnaire ou un mandataire inaccessible à toutes les tentations, à toutes les corruptions […]."
                                            },
                                            {
                                                "example_id": "fe7b753e-9e64-4f8f-8c96-2949441a4352",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Mais en lui-même, il savait bien qu’il suffit de quelques fonctionnaires ignorants et brutaux pour rendre la France haïssable aux yeux de pauvres villageois illettrés et obscurs."
                                            },
                                            {
                                                "example_id": "b9e0387f-92fd-405f-8fc8-bc472d507f39",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Les anciens impôts basés sur le Koran sont supprimés et remplacés par des contributions nouvelles qui seront recueillies par des fonctionnaires spéciaux, au lieu de l’être par les caïds."
                                            },
                                            {
                                                "example_id": "b3d59d22-6a9f-457d-976a-30f902e3bc13",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Les paroles trébuchèrent, et il eut l’air étrangement déplacé, presque risible, cet appel aux sentiments d’un fonctionnaire, quand les fonctions ne peuvent être remplies qu’objectivement."
                                            },
                                            {
                                                "example_id": "13aa8cb1-a811-4b7d-bbdc-4e74b9312076",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Un polytechnicien, à leurs yeux, c’était quelqu’un. Mais mon sexe leur interdisait de si hautes ambitions et mon père me destina prudemment à l’administration : cependant il détestait les fonctionnaires, ces budgétivores, et c’est avec ressentiment qu’il me disait : « Toi au moins, tu auras une retraite ! »"
                                            },
                                            {
                                                "example_id": "d7826348-c571-4964-909d-19e4f5b020d8",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Le fonctionnaire de la police nationale est loyal envers les institutions républicaines. Il est intègre et impartial ; il ne se départit de sa dignité en aucune circonstance."
                                            },
                                            {
                                                "example_id": "3a65e13d-d0fa-4f44-8161-34209eaf3fc7",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Quelques très rares Annamites frayaient avec les Français. Un fonctionnaire annamitophile était en principe condamné à ne jamais « avancer ». Nous étions, du fait de la condition de ma mère, au dernier échelon de l'échelle des fonctionnaires."
                                            },
                                            {
                                                "example_id": "308994c9-0ee2-4927-8fa6-735c9a3a3cde",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Le moyen classique pour inciter à l’augmentation des salaires, c’est de toucher au smic et au point d’indice des fonctionnaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c9b820-551f-3ac8-b6ed-a4a6baf2da5b",
                                        "entry_id": "e5df9337-531f-347f-bc26-f21578e37951",
                                        "glosses": [
                                            "Personne lente à l’ouvrage, fainéante, rechignant au travail ; employé d’administration rêche et peu avenant."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d49bd9-11a7-4af1-8ec3-80b483be0713",
                                                "sense_id": "32c9b820-551f-3ac8-b6ed-a4a6baf2da5b",
                                                "text": "Celui-là ? Un vrai fonctionnaire, il n’avance que quand je le regarde !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22d658f0-f7b1-4654-b353-868c17294e03",
                        "source_entry_id": "f2c829da-e1a9-3a50-83ae-cf3512b5564c",
                        "source_sense_id": "120a98a5-a9ea-3ee6-b81f-664f0da1f018",
