                        "examples": [
                            {
                                "example_id": "9f57903e-20e4-4288-8275-f7122977cdeb",
                                "sense_id": "2716c59f-1318-3d83-a66e-fc4d00538e53",
                                "text": "Den Haag heeft geregeld contact met de andere grote steden, die hetzelfde beleid zijn gaan voeren. Ook daar hebben ze goede ervaringen met het strengere meldsysteem, zegt Van Engelshoven."
                            },
                            {
                                "example_id": "3be17978-9eda-4e97-bea0-7e3910195714",
                                "sense_id": "2716c59f-1318-3d83-a66e-fc4d00538e53",
                                "text": "Rijkswaterstaat heeft daarvoor geen verklaring. Er wordt met een nieuw meldsysteem gewerkt, waardoor eerder een toename van het aantal meldingen te verwachten valt dan een afname."
                            }
                        ]
