                ],
                "senses": [
                    {
                        "sense_id": "076d0867-e87c-3c53-b3d0-0ae8f3734f6f",
                        "entry_id": "51e41550-a1f7-3862-bb7d-9d5c11d2de29",
                        "glosses": [
                            "Bier oder bierhaltiges Getränk, das durch Einwohner und Touristen auf dem Weg zur oder von der Arbeit, zu einer Feier oder zwischen Aufenthaltsorten konsumiert wird"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "87f719e4-2a40-4adf-9f3d-843a83e16e3f",
                                "sense_id": "076d0867-e87c-3c53-b3d0-0ae8f3734f6f",
                                "text": "„Da waren die Trinker, die schon am Morgen mit ihrem Wegbier die Straße runter schlenderten, oder waren es doch übriggebliebene Partygänger?“"
                            },
                            {
                                "example_id": "95e884ee-39bc-4ccd-b794-e72d21f2ee82",
                                "sense_id": "076d0867-e87c-3c53-b3d0-0ae8f3734f6f",
                                "text": "„Kurz vor zwölf informierten wir uns dann endlich nach Bahnen, schnappten uns jeder noch ein kühles Wegbier und zogen in die Nacht hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
