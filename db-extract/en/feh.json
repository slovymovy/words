                "entry_id": "8dc10d24-1044-3432-a6f1-fa42438d3144",
                "word": "feh",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1187f534-59bf-31e6-84ca-8696c8a83c14",
                        "entry_id": "8dc10d24-1044-3432-a6f1-fa42438d3144",
                        "glosses": [
                            "An expression of disgust or contempt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4ca204a-63cf-4f6c-805e-26e46037e2a4",
                                "sense_id": "1187f534-59bf-31e6-84ca-8696c8a83c14",
                                "text": "Kvola made a face. \"It’s worse than an outhouse.\" She covered her nose. \"Uh!\" \"It is\" \"Feh!\" We all agreed and covered our noses. But Ma wasn't interested in our complaints.\n...\nIt smelled like rotten food, stinking bodies, and stale air. Feh!"
                            },
                            {
                                "example_id": "a601e64c-8c80-45fa-a0c4-809bf02d26ca",
                                "sense_id": "1187f534-59bf-31e6-84ca-8696c8a83c14",
                                "text": "\"A gangster. Feh! Disgusting” she said roughly grabbing Marty by the arm. \"We go across the street.\""
                            },
                            {
                                "example_id": "ce2fd093-1674-4b47-b0f2-8a0520bd1db8",
                                "sense_id": "1187f534-59bf-31e6-84ca-8696c8a83c14",
                                "text": "\"Look at it, how its pale skin blotches — and that evil-smelling thatch on top. Feh! The smell!"
                            }
                        ]
                    }
                ],
