                    "semantic_group_id": "rede_und_vortrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Politiker zog es vor, frei zu sprechen und nicht vom vorbereiteten <w>Manuskript</w> abzulesen."
