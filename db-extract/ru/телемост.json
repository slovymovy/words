                "senses": [
                    {
                        "sense_id": "050a2cd3-dab4-3077-a9d2-948e08c370de",
                        "entry_id": "72d6bd70-4d0f-356d-8446-35300fcbbdd6",
                        "glosses": [
                            "videoconference, remote telecast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d600f32a-e80f-40ec-b044-b086223778c3",
                                "sense_id": "050a2cd3-dab4-3077-a9d2-948e08c370de",
                                "text": "Обща́вшиеся с су́дьям посре́дством телемоста́ мать и дочь Го́фман (они́ находи́лись в специа́льно обору́дованной сту́дии в же́нском СИЗО́ № 6 в Печа́тниках) говори́ли, что жела́ют сотру́дничать со сле́дствием и про́сят у зако́на защи́ты свои́х конституцио́нных прав.",
                                "translation": "The Gofman mother and daughter, communicating with the judges by videoconference (from a specially equipped studio in the No. 6 women's detainment facility in Pechatniki) stated that they wish to cooperate with the prosecution and requested for the justice system to protect their constitutional rights.",
                                "english": "The Gofman mother and daughter, communicating with the judges by videoconference (from a specially equipped studio in the No. 6 women's detainment facility in Pechatniki) stated that they wish to cooperate with the prosecution and requested for the justice system to protect their constitutional rights."
                            }
                        ]
                    },
                    {
                        "sense_id": "e521c7ee-cc99-30b6-a408-e86ff0412eec",
                        "entry_id": "72d6bd70-4d0f-356d-8446-35300fcbbdd6",
                        "glosses": [
                            "space bridge (one of a series of Cold War-era remote telecasts connecting Soviet Bloc and Western nations)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "923b93f6-9c7d-445b-956d-1f78e65138b9",
                                "sense_id": "e521c7ee-cc99-30b6-a408-e86ff0412eec",
                                "text": "Посмотре́ла телемо́ст Москва́ ― Нью-Йо́рк. Горбачёв и Е́льцин отвеча́ли на вопро́сы в прямо́м эфи́ре.",
                                "translation": "I watched the Moscow–New York space bridge. Gorbachev and Yeltsin answered questions live.",
                                "english": "I watched the Moscow–New York space bridge. Gorbachev and Yeltsin answered questions live."
                            }
                        ]
                    }
                ],
