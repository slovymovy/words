                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>woedende</w> vader gaf hem een week huisarrest na het incident.",
                            "target_lang_translations": {
                                "en": "His <w>furious</w> father gave him a week of house arrest after the incident.",
                                "ru": "Его <w>разгневанный</w> отец посадил его под домашний арест на неделю после этого инцидента.",
                                "pl": "Jego <w>wściekły</w> ojciec nałożył na niego tydzień aresztu domowego po tym incydencie.",
                                "de": "Sein <w>wütender</w> Vater erteilte ihm nach dem Vorfall eine Woche Hausarrest.",
                                "fr": "Son père <w>furieux</w> l'a mis aux arrêts domiciliaires pendant une semaine après l'incident.",
                                "it": "Il suo <w>furioso</w> padre gli ha dato una settimana di arresti domiciliari dopo l'incidente.",
                                "cs": "Jeho <w>rozzuřený</w> otec mu po tom incidentu udělil týden domácího vězení.",
                                "tr": "<w>Öfkeli</w> babası, olaydan sonra ona bir hafta ev hapsi verdi.",
                                "es": "Su <w>furioso</w> padre le impuso una semana de arresto domiciliario tras el incidente.",
                                "zh": "事件发生后，他<w>愤怒</w>的父亲罚他禁足一周。"
                            }
                        },
                        {
                            "text": "De klant werd <w>woedend</w> toen hij hoorde dat het product niet leverbaar was.",
                            "target_lang_translations": {
                                "en": "The customer became <w>enraged</w> when he heard that the product was not available.",
                                "ru": "Клиент пришел <w>в бешенство</w>, когда услышал, что товара нет в наличии.",
                                "pl": "Klient <w>wpadł w szał</w>, gdy usłyszał, że produkt nie jest dostępny.",
                                "de": "Der Kunde wurde <w>wütend</w>, als er hörte, dass das Produkt nicht lieferbar war.",
                                "fr": "Le client est devenu <w>furieux</w> lorsqu'il a appris que le produit n'était pas disponible.",
                                "it": "Il cliente si è <w>infuriato</w> quando ha saputo che il prodotto non era disponibile.",
                                "cs": "Zákazník <w>zuřil</w>, když se dozvěděl, že produkt není dostupný.",
                                "tr": "Müşteri, ürünün temin edilemeyeceğini duyduğunda <w>küplere bindi</w>.",
                                "es": "El cliente se puso <w>furioso</w> cuando se enteró de que el producto no estaba disponible.",
                                "zh": "当得知产品缺货时，顾客变得<w>暴怒</w>。"
                            }
                        }
