                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d571315b-4729-4118-9256-b62c40407755",
                                "sense_id": "71463b1e-e10a-3a5f-a892-03df4adc9e3f",
                                "text": "Приятели троекратно облобызались и устремили друг на друга глаза́, полные слёз. Оба были приятно ошеломлены."
                            },
                            {
                                "example_id": "e531105a-a371-4f2d-85ab-6db78166930a",
                                "sense_id": "71463b1e-e10a-3a5f-a892-03df4adc9e3f",
                                "text": "Мы обрадовались этой встрече, обнялись и облобызались."
                            }
                        ]
                    }
