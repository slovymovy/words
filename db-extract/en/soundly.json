                "senses": [
                    {
                        "sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
                        "entry_id": "83d202df-edb4-336e-b737-76e9f0b52f56",
                        "glosses": [
                            "In a thorough manner; in manner free of defect or deficiency."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7090ab9-545f-4429-b4fe-b48b048312c5",
                                "sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
                                "text": "He was soundly thrashed by the semi-professional boxer."
                            },
                            {
                                "example_id": "eb023864-6ba1-47f4-8175-a55c64e041f8",
                                "sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
                                "text": "Pro. Let them be hunted ſoundly : At this houre / Lies at my mercy all mine enemies :[…]"
                            },
                            {
                                "example_id": "6848f3c2-728b-4b97-a878-75658543b38f",
                                "sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
                                "text": "Mrs. Reed soon rallied her spirits: she shook me most soundly, she boxed both my ears, and then left me without a word."
                            },
                            {
                                "example_id": "c26d3c37-97ba-4865-917e-90f1e23a4cef",
                                "sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
                                "text": "The wedding company, fatigued with their enjoyment of the previous night, slept soundly late into the next morning."
                            },
                            {
                                "example_id": "e3ea08b4-49ab-4782-bce6-3628443be9d5",
                                "sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
                                "text": "My gold carried little weight with him, he was sincerely fond of me and consequently rated me soundly for all indiscretions, declaring I would regret wasting the best years of my life and deadening my vast talents […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbd9c943-0d66-4d32-b7d8-cd3864558024",
                        "source_entry_id": "83d202df-edb4-336e-b737-76e9f0b52f56",
                        "source_sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
