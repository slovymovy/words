{
    "word_family": [
        "cardinality",
        "cardinally",
        "cardinalship"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b03e6a6-9446-311d-bc9d-07a2880223fd",
                    "sense_definition": "Of fundamental importance; crucial, pivotal, or serving as a basis.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Respect for others is a <w>cardinal</w> principle in our society.",
                            "target_lang_translations": {
                                "ru": "Уважение к другим — это <w>основополага́ющий</w> принцип нашего общества.",
                                "zh": "尊重他人是我们社会的一项<w>基本</w>原则。"
                            }
                        },
                        {
                            "text": "He committed the <w>cardinal</w> sin of forgetting his wife's birthday.",
                            "target_lang_translations": {
                                "ru": "Он совершил <w>смерте́льный</w> грех, забыв о дне рождения жены.",
                                "zh": "他犯下了忘记妻子生日这一<w>大</w>忌。"
                            }
                        }
                    ],
                    "antonyms": [
                        "minor",
                        "secondary"
                    ],
                    "common_phrases": [
                        "cardinal rule",
                        "cardinal sin",
                        "cardinal virtue",
                        "cardinal error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий первостепенное значение; главный, основной или служащий основой.",
                        "zh": "具有根本性的重要意义；关键的、起基础作用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гла́вный",
                                "target_lang_sense_clarification": "важнейший, основной"
                            },
                            {
                                "target_lang_word": "кардина́льный",
                                "target_lang_sense_clarification": "коренной, самый существенный"
                            },
                            {
                                "target_lang_word": "основополага́ющий",
                                "target_lang_sense_clarification": "служащий основой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基本",
                                "target_lang_sense_clarification": "重要的，起基础作用的"
                            },
                            {
                                "target_lang_word": "根本",
                                "target_lang_sense_clarification": "最重要的，关键的"
                            },
                            {
                                "target_lang_word": "至关重要",
                                "target_lang_sense_clarification": "极其重要的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccb857dd-2a9b-354f-80f6-766cd1a4ad95",
                    "sense_definition": "Describing a number used to indicate quantity (e.g., one, two, three) rather than order or position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "numbers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the phrase 'three apples', 'three' is a <w>cardinal</w> number.",
                            "target_lang_translations": {
                                "ru": "В словосочетании «три яблока» слово «три» — это <w>коли́чественное</w> числительное.",
                                "zh": "在短语“三个苹果”中，“三”是<w>基数</w>词。"
                            }
                        },
                        {
                            "text": "The teacher explained the difference between <w>cardinal</w> and ordinal numbers to the class.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил классу разницу между <w>коли́чественными</w> и порядковыми числительными.",
                                "zh": "老师向全班讲解了<w>基数</w>词和序数词之间的区别。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ordinal"
                    ],
                    "common_phrases": [
                        "cardinal number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к числу, обозначающему количество (в отличие от порядкового).",
                        "zh": "指表示数量而不是顺序或位置的数词，如“一、二、三”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коли́чественный",
                                "target_lang_sense_clarification": "обозначающий количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基数",
                                "target_lang_sense_clarification": "表示数量的"
                            },
                            {
                                "target_lang_word": "基数词",
                                "target_lang_sense_clarification": "语法上指表示数量的词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edee992e-0564-38a2-9b2f-2c6984c63afa",
                    "sense_definition": "Relating to the four main directions: north, south, east, and west.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The four <w>cardinal</w> points of the compass help sailors navigate the open sea.",
                            "target_lang_translations": {
                                "ru": "Четыре <w>гла́вные</w> стороны света на компасе помогают морякам ориентироваться в открытом море.",
                                "zh": "罗盘上的四个<w>基本</w>方位帮助水手在公海上辨别方向。"
                            }
                        },
                        {
                            "text": "We learned that north and south are opposite <w>cardinal</w> directions.",
                            "target_lang_translations": {
                                "ru": "Мы узнали, что север и юг — это противоположные <w>гла́вные</w> направления.",
                                "zh": "我们了解到，北和南是相对的<w>基本</w>方位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cardinal points",
                        "cardinal directions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к четырём главным сторонам света: северу, югу, востоку и западу.",
                        "zh": "与四个主要方向有关的，即东、南、西、北。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гла́вный",
                                "target_lang_sense_clarification": "о сторонах света"
                            },
                            {
                                "target_lang_word": "основно́й",
                                "target_lang_sense_clarification": "о направлениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基本",
                                "target_lang_sense_clarification": "指东南西北四个方向"
                            },
                            {
                                "target_lang_word": "主要",
                                "target_lang_sense_clarification": "用于“基本方位”一类说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44a7dd44-2502-311d-8d70-381ce4c23489",
                    "sense_definition": "Having a deep, vivid red color.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer wore a dress of <w>cardinal</w> silk that caught everyone's eye.",
                            "target_lang_translations": {
                                "ru": "Танцовщица была в платье из <w>я́рко-кра́сного</w> шёлка, которое приковывало всеобщие взгляды.",
                                "zh": "那位舞者穿着一条<w>鲜红色</w>丝绸连衣裙，吸引了所有人的目光。"
                            }
                        },
                        {
                            "text": "The sunset painted the sky in shades of gold and <w>cardinal</w> red.",
                            "target_lang_translations": {
                                "ru": "Закат окрасил небо в оттенки золотого и <w>пунцо́во</w>-красного.",
                                "zh": "晚霞把天空染成了金色和<w>深红色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cardinal red"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий глубокий, ярко-красный цвет.",
                        "zh": "呈深而鲜明的红色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я́рко-кра́сный",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "пунцо́вый",
                                "target_lang_sense_clarification": "насыщенно-красный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鲜红色",
                                "target_lang_sense_clarification": "颜色鲜明的红色"
                            },
                            {
                                "target_lang_word": "深红色",
                                "target_lang_sense_clarification": "较深、浓烈的红色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77c768bb-37a7-30eb-8006-a292fc8e23da",
                    "sense_definition": "A high-ranking official of the Roman Catholic Church, appointed by the pope and forming the college that elects new popes.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cardinal</w> stepped out onto the balcony to address the crowd.",
                            "target_lang_translations": {
                                "ru": "<w>Кардина́л</w> вышел на балкон, чтобы обратиться к толпе.",
                                "zh": "那位<w>红衣主教</w>走到阳台上向人群发表讲话。"
                            }
                        },
                        {
                            "text": "Several <w>cardinals</w> gathered in the Vatican to discuss the future of the church.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>кардина́лов</w> собрались в Ватикане, чтобы обсудить будущее церкви.",
                                "zh": "几位<w>红衣主教</w>聚集在梵蒂冈，讨论教会的未来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "College of Cardinals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высшее духовное лицо в католической церкви, назначаемое Папой Римским.",
                        "zh": "天主教会中的高级神职人员，由教宗任命，组成选举新教宗的枢机团。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кардина́л",
                                "target_lang_sense_clarification": "духовный сан"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "红衣主教",
                                "target_lang_sense_clarification": "天主教会中的高级神职人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aef91039-760c-3d0d-b9ab-cd2f782198df",
                    "sense_definition": "A North American songbird (Cardinalis cardinalis) characterized by a crest on the head and, in the male, bright red plumage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bright red <w>cardinal</w> landed on the branch of the snowy pine tree.",
                            "target_lang_translations": {
                                "ru": "Ярко-красный <w>кардина́л</w> сел на ветку заснеженной сосны.",
                                "zh": "一只鲜红色的<w>北美红雀</w>落在覆雪的松树枝头。"
                            }
                        },
                        {
                            "text": "We enjoy watching the <w>cardinals</w> visit our bird feeder every morning.",
                            "target_lang_translations": {
                                "ru": "Нам нравится наблюдать, как <w>кардина́лы</w> прилетают к нашей кормушке каждое утро.",
                                "zh": "我们喜欢看<w>北美红雀</w>每天早晨飞到我们的喂鸟器旁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "northern cardinal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Североамериканская певчая птица с хохолком и ярко-красным оперением (у самцов).",
                        "zh": "一种北美鸣禽，头顶有羽冠，雄鸟羽毛鲜红。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кардина́л",
                                "target_lang_sense_clarification": "птица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北美红雀",
                                "target_lang_sense_clarification": "一种头顶有羽冠的北美鸣禽"
                            },
                            {
                                "target_lang_word": "红雀",
                                "target_lang_sense_clarification": "较宽泛的常见叫法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8429465-6903-3b82-b0fa-87ffe369a5d8",
                    "sense_definition": "A number that indicates quantity or the size of a set (e.g., 0, 1, 2), as opposed to position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "numbers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In mathematics, <w>cardinals</w> are used to count how many items are in a group.",
                            "target_lang_translations": {
                                "ru": "В математике <w>кардина́льные чи́сла</w> используются для подсчета количества предметов в группе.",
                                "zh": "在数学中，<w>基数</w>用来表示一个集合中有多少个元素。"
                            }
                        },
                        {
                            "text": "The student learned to distinguish between ordinals like 'first' and <w>cardinals</w> like 'one'.",
                            "target_lang_translations": {
                                "ru": "Студент научился различать порядковые числительные, такие как «первый», и <w>коли́чественные</w>, такие как «один».",
                                "zh": "这名学生学会了区分像“第一”这样的序数词和像“一”这样的<w>基数</w>词。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ordinal"
                    ],
                    "common_phrases": [
                        "cardinal number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Число, указывающее на количество предметов в множестве.",
                        "zh": "表示数量或集合大小的数，如0、1、2，与表示顺序的位置数相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коли́чественное числи́тельное",
                                "target_lang_sense_clarification": "часть речи"
                            },
                            {
                                "target_lang_word": "кардина́льное число́",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基数",
                                "target_lang_sense_clarification": "数学上表示数量的数"
                            },
                            {
                                "target_lang_word": "基数词",
                                "target_lang_sense_clarification": "作为语法术语时常用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b32d7079-71c7-338c-96e2-8c45c298ceb4",
