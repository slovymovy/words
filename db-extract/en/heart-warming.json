                                "target_senses": [
                                    {
                                        "sense_id": "7a0a4cae-6ef8-38b6-a7d3-49c052231a44",
                                        "entry_id": "4c7a2cc3-c25e-3267-a472-1eb0e51d704b",
                                        "glosses": [
                                            "sehr bewegende, beglückende Gefühle hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15318372-8e48-4149-a945-e7913fc93f71",
                                                "sense_id": "7a0a4cae-6ef8-38b6-a7d3-49c052231a44",
                                                "text": "„Die meisten Leute sahen fröhlich, befreit und herzerwärmend aus, wenn sie lachten.“"
                                            },
                                            {
                                                "example_id": "7fa39ea1-53f9-4c61-9541-68d73efdf617",
                                                "sense_id": "7a0a4cae-6ef8-38b6-a7d3-49c052231a44",
                                                "text": "„Die Liebe, die mir von dort entgegengebracht wurde, ist im wahrsten Sinne des Wortes herzerwärmend.“"
                                            },
                                            {
                                                "example_id": "bac7cb0b-0693-4a16-bf69-6628205b7ed1",
                                                "sense_id": "7a0a4cae-6ef8-38b6-a7d3-49c052231a44",
                                                "text": "„Und das Geräusch, das sie gehört hatten – dieses wunderbare, herzerwärmende Tosen –, war donnernder Applaus.“"
                                            },
                                            {
                                                "example_id": "17f43bb5-f85c-4700-af13-b1114659005c",
                                                "sense_id": "7a0a4cae-6ef8-38b6-a7d3-49c052231a44",
                                                "text": "„Die eisige Kälte in seiner Stimme und die Wut in seinem Blick hatte sie sich wohl bloß eingebildet, denn jetzt schenkte er ihr das vertraute, herzerwärmende Lächeln und gab ihr einen flüchtigen Kuss, der ihr verriet, dass alles gut war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36fed396-c522-47c5-ac4b-bbed91972e1b",
                        "source_entry_id": "62639dc4-7fd0-3a14-87b4-11f6e368f3d6",
