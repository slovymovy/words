                                            {
                                                "example_id": "bcd3847e-c171-44c2-88e5-0f7d08e20b81",
                                                "sense_id": "c614dbf7-0815-37d5-83c6-7a6ea2b4fa94",
                                                "text": "gestatory surrogacy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a506dca-8744-37e7-abac-1496b9c3421b",
                                        "entry_id": "37a7f1a3-8914-33ae-90a8-9e07d14607df",
                                        "glosses": [
                                            "Capable of being carried or worn."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae7fc7aa-e826-405c-a920-c88779f24cfc",
                                                "sense_id": "8a506dca-8744-37e7-abac-1496b9c3421b",
                                                "text": "The Crowns and Garlands of the Ancients were either Gestatory, such as they wore about their Heads or Necks; Portatory, such as they carried at solemn Festivals; Pensile or Suspensory, such as they hanged about the Posts of their Houses in honour of their Gods, as of Jupiter Thyræus or Limeneus; or else they were Depository, such as they laid upon the Graves and Monuments of the dead."
                                            },
                                            {
                                                "example_id": "0dc97adc-5fd5-4c72-b526-2aa1b5f0fba9",
                                                "sense_id": "8a506dca-8744-37e7-abac-1496b9c3421b",
                                                "text": "In its secondary sense feretrum signified a portable shrine, containing the relics of saints, and carried in processions on a frame similar to the ordinary bier; and also stationary shrines of similar fashion, but which it was not customary to display as gestatory ornaments, such as those of St. Cuthbert at Durham, or St. Thomas of Hereford, in the cathedral there."
                                            },
                                            {
                                                "example_id": "cfe2e6dd-00a7-48c3-bae6-8e3022501147",
                                                "sense_id": "8a506dca-8744-37e7-abac-1496b9c3421b",
                                                "text": "Garlands, it is needless to say, played an important part in the festivals of antiquity, gestatory garlands worn round the neck (like those just mentioned), postilory for feasts, pensile hung on the posts of the doors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
