    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ba61b185-f94e-3f86-84ca-44bbea37c9dd",
                "word": "Ganymede",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d62425c-2783-3581-8e91-3ad5983c69f8",
                        "entry_id": "ba61b185-f94e-3f86-84ca-44bbea37c9dd",
                        "glosses": [
                            "A Trojan boy who was abducted (either by Zeus or Eos), and ultimately became immortal in order to be Zeus' cupbearer."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "483ecf76-ddb2-3785-ae1d-9681f06fd4c5",
                        "entry_id": "ba61b185-f94e-3f86-84ca-44bbea37c9dd",
                        "glosses": [
                            "A moon of Jupiter."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f82dbb9-924e-4285-bc34-af0004f0d9c9",
                        "source_entry_id": "ba61b185-f94e-3f86-84ca-44bbea37c9dd",
                        "source_sense_description": "in Greek mythology",
                        "target_lang_word": "Ganymède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ganymède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d88ca029-bc0f-3dac-9d43-bb6f4a877596",
                                        "entry_id": "f2c2667a-faea-3855-808f-c4e7d503e8c5",
                                        "glosses": [
                                            "Prince troyen, fils de Tros et de la nymphe Callirrhoé (fille de Scamandre), aimé de Zeus, qui après s’être transformé en aigle l’a enlevé pour servir d’échanson à la place d’Hébé."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3a8966-7496-49f6-a7f1-af282c3abe96",
                                                "sense_id": "d88ca029-bc0f-3dac-9d43-bb6f4a877596",
                                                "text": "Notons que, dans la version grecque, Ganymède a également été séduit par Jupiter, mais que les Romains, plutôt puritains, n’en parlèrent presque pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909d9ace-e67d-3aa5-88d2-cafb24833664",
                                        "entry_id": "f2c2667a-faea-3855-808f-c4e7d503e8c5",
                                        "glosses": [
                                            "(1036) Ganymède, internationalement (1036) Ganymede, planète mineure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f319ab07-3eb9-45b8-b4e4-3f55fa6c423f",
                                                "sense_id": "909d9ace-e67d-3aa5-88d2-cafb24833664",
                                                "text": "(1036) Ganymède est le plus grand des astéroïdes Amor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f32da9-c089-399b-803d-5230ab891c95",
                                        "entry_id": "f2c2667a-faea-3855-808f-c4e7d503e8c5",
                                        "glosses": [
                                            "Général égyptien qui se battit contre Jules César en 48 avant J-C."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Ganymède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a310751-64df-37a0-b9ae-e31b44749ed1",
                                        "entry_id": "b7843acb-281e-3b11-931f-a30f3161e11b",
                                        "glosses": [
                                            "Satellite naturel de la planète Jupiter, une des quatre lunes galiléennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b02f7a-20ac-46d0-8e9f-873706de5042",
                                                "sense_id": "0a310751-64df-37a0-b9ae-e31b44749ed1",
                                                "text": "Les satellites des planètes géantes peuvent se classer en différents groupes. Jupiter possède quatre gros satellites découverts par Galilée au début du XVIIᵉ siècle : Io, Europe, Ganymède et Callisto, appelés satellites galiléens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0be2d828-8d6e-4ca9-9764-899131d3c6e5",
                        "source_entry_id": "ba61b185-f94e-3f86-84ca-44bbea37c9dd",
                        "source_sense_description": "in Greek mythology",
                        "target_lang_word": "Ganymed",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ganymed",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c54f44af-f65f-3c6c-a028-74dff6306551",
                                        "entry_id": "b2007272-f9bb-3002-8a9a-e6ea1c763ea7",
                                        "glosses": [
                                            "junger Diener, Kellner"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11628123-13c8-409e-9b3e-2bd169472390",
                                                "sense_id": "c54f44af-f65f-3c6c-a028-74dff6306551",
                                                "text": "Ihm steht kein Garzone zur Seite; er selbst ist Koch und Kellner, kaum, dass noch ein Ganymed als dienstthuender Ragazzo mit Essbesteck und Tellern, Gläsern und Broden flink genug zu hantiren weiss."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ganymed",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72b56712-b755-31d5-99c4-b65881cc11c0",
                                        "entry_id": "2b17dada-4b93-33f3-b616-5931c6149100",
                                        "glosses": [
                                            "dritter Mond des Planeten Jupiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d2d96e-d97a-45ce-bd61-096fa4d60db0",
                                                "sense_id": "72b56712-b755-31d5-99c4-b65881cc11c0",
                                                "text": "Ganymed ist unbestritten der größte Mond des Sonnensystems."
                                            },
                                            {
                                                "example_id": "98ba08de-619d-4ee4-85b7-705f3e9a8bb4",
                                                "sense_id": "72b56712-b755-31d5-99c4-b65881cc11c0",
                                                "text": "Um Jupiter ganz zu umrunden, benötigt Ganymed 7,2 Tage."
                                            },
                                            {
                                                "example_id": "da39016c-24dd-4813-bc71-37dceb3542ca",
                                                "sense_id": "72b56712-b755-31d5-99c4-b65881cc11c0",
                                                "text": "Die Jupitersonde Juno zeichnete beim Vorbeiflug an Ganymed elektromagnetische Wellen der Magnetosphäre auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
