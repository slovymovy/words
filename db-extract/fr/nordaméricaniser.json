                ],
                "senses": [
                    {
                        "sense_id": "328ed46f-4d74-355c-bcbd-f2f95cc66126",
                        "entry_id": "fb90962f-7b0b-3d2b-9e3d-768c5972d0fd",
                        "glosses": [
                            "Donner un caractère nordaméricain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2b9b48-5a58-41c7-b870-4b84da364a1d",
                                "sense_id": "328ed46f-4d74-355c-bcbd-f2f95cc66126",
                                "text": "Ca doit couter moins cher “volkswageniser” un Chrysler que “nordaméricaniser” un Routan."
                            },
                            {
                                "example_id": "251f2b88-cd8c-4bfe-90ec-7650d3ba2760",
                                "sense_id": "328ed46f-4d74-355c-bcbd-f2f95cc66126",
                                "text": "L'Argentine enfin offre une exemple de dépendance d'une télévision commerciale fragile par rapport à un puissant voisin lui-même « nordaméricanisé »."
                            },
                            {
                                "example_id": "34924d10-230e-4613-8ae5-b6a02928e748",
                                "sense_id": "328ed46f-4d74-355c-bcbd-f2f95cc66126",
                                "text": "En fait, là où le mode de vie se « nordaméricanise », les individus deviennent de plus en plus anxieux, stressés, névrosés, épuisés."
                            }
                        ]
                    }
