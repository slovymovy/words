                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05fba47a-d6c8-4266-8dc3-2c0ec06cc0bb",
                                "sense_id": "dc27a708-10df-3c72-9fdc-cc15a6079350",
                                "text": "Кто, на стихе моём повиснув, // Вскарабкавшись, с поэмой всплыл; // Кого, живой водою спрыснув, // Я от угара протрезвил."
                            }
                        ]
                    }
                ],
