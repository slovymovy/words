                ],
                "senses": [
                    {
                        "sense_id": "52e764c5-ead8-3e23-b6f6-d3f7d79d384a",
                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                        "glosses": [
                            "Exploitation de la houille."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                        "glosses": [
                            "Les mines de houille en exploitation."
                        ],
                        "tags": [
                            "broadly",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "942f2b9b-91b9-4317-80f9-4d639dc99246",
                                "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                                "text": "Et pourtant il serait difficile de ne pas même dire un seul mot de ces petits charbonnages que j'ai visités dans le département : mines de Brassac, au sud, comprenant La Combelle et Charbonnier; mines de Messeix, au sud-ouest, près de Bourg-Lastic; mines de Saint-Éloy, au nord."
                            },
                            {
                                "example_id": "8eb6a43d-7b56-4251-a16f-4a0d17c2813d",
                                "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                                "text": "En cette fin d'année 1937, des ateliers de flottage sont en projet ou en cours d'installation dans plusieurs charbonnages français."
                            },
                            {
                                "example_id": "6352785d-e76c-4779-aa24-dad9edec1890",
                                "sense_id": "0ce45030-7416-32f3-ae76-69c0ea010923",
                                "text": "On appelait « Indes noires « les charbonnages d’Écosse en raison de la source de richesses qu’ils représentaient pour la Grande-Bretagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "f58cafae-a8ee-33d4-a3dd-b30eefdf10b5",
                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                        "glosses": [
                            "Société d'exploitation d'une mine de charbon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da67417a-1532-4f6f-97fc-a02182e63df7",
                                "sense_id": "f58cafae-a8ee-33d4-a3dd-b30eefdf10b5",
                                "text": "La pauvreté toutefois, si déterminante pour Alexis, n’entrait pas en ligne de compte pour le jeune Belge dont la mère avait hérité d’un charbonnage."
                            }
                        ]
                    },
                    {
                        "sense_id": "7add9b5c-0316-3117-9835-e652e02785c8",
                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                        "glosses": [
                            "Action de s’approvisionner en charbon pour les machines."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "056f2802-510b-4e9e-9859-64834cdded57",
                                "sense_id": "7add9b5c-0316-3117-9835-e652e02785c8",
                                "text": "Notre première escale après charbonnage à Stornoway en Écosse fut donc Sudéroë, l'île la plus au Sud de l'archipel des Féroë."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbf1b033-00e3-3553-b04f-a9cca5e1ce0e",
                        "entry_id": "88553c51-2052-371f-a05f-7c841bd768e6",
                        "glosses": [
                            "Droit concédé par un noble à un roturier pour lui permettre l'exploitation d'une mine de charbon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "15ca879b-c5dd-35fa-b19d-3a242c9a124c",
