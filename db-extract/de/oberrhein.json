                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2521bd8-ac47-3222-99e1-4ddcd75bc8ed",
                        "entry_id": "6c28c1a5-9c6e-3d42-bc1e-97a0c246a620",
                        "glosses": [
                            "etwa 350 km langer Flussabschnitt des Rheins, der am Baseler Rheinknie aus dem Hochrhein hervorgeht und bei Bingen in den Mittelrhein übergeht"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "0a8d4dd9-0a13-4a35-9969-6851cde4a6cb",
                                "sense_id": "c2521bd8-ac47-3222-99e1-4ddcd75bc8ed",
                                "text": "„Im Vergleich zum Mittelrhein ist der Oberrhein ein eher unromantischer und darum beinahe unbekannter Fluß.“"
                            },
                            {
                                "example_id": "9d1982db-4d2d-462e-b93e-4a83c71b3db4",
                                "sense_id": "c2521bd8-ac47-3222-99e1-4ddcd75bc8ed",
                                "text": "„1817 wurde der Oberrhein, der sich serpentinenartig schlängelte, umgeben von einem Hochufer, begradigt, um ihn für die Schifffahrt passierbarer zu machen.“"
                            },
                            {
                                "example_id": "3875b41f-e1ba-45e0-a8db-f81d6ebce2da",
                                "sense_id": "c2521bd8-ac47-3222-99e1-4ddcd75bc8ed",
                                "text": "Wir überquerten den Oberrhein."
                            },
                            {
                                "example_id": "eb3dfd0d-156d-4156-998c-00717fa30549",
                                "sense_id": "c2521bd8-ac47-3222-99e1-4ddcd75bc8ed",
                                "text": "Die Kinder versuchten, in dem Oberrhein zu baden."
                            },
                            {
                                "example_id": "66f99905-e7ec-4f9a-a7bc-1e93a9ed5463",
                                "sense_id": "c2521bd8-ac47-3222-99e1-4ddcd75bc8ed",
                                "text": "„An Mittel- und Oberrhein und in Süddeutschland waren die Kelten zu jener Zeit die unmittelbaren Nachbarn der Germanen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
