{
    "word_family": [
        "inhabitant",
        "inhabitation",
        "inhabitable",
        "uninhabited"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "840e7f9f-5c5c-3a26-8529-ef958e93bcd4",
                    "sense_definition": "To live or reside in a place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many different species <w>inhabit</w> the dense tropical rainforest.",
                            "target_lang_translations": {
                                "ru": "Многие различные виды <w>населяют</w> густые тропические леса."
                            }
                        },
                        {
                            "text": "The local tribes <w>inhabit</w> the remote valley throughout the year.",
                            "target_lang_translations": {
                                "ru": "Местные племена <w>обитают</w> в отдаленной долине круглый год."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwell",
                        "live",
                        "reside"
                    ],
                    "common_phrases": [
                        "inhabit the region",
                        "inhabit the area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить или постоянно находиться в каком-либо месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "населя́ть",
                                "target_lang_sense_clarification": "быть жителями или обитателями какой-либо территории"
                            },
                            {
                                "target_lang_word": "обита́ть",
                                "target_lang_sense_clarification": "постоянно жить в каком-либо месте (часто о животных или в контексте среды)"
                            },
                            {
                                "target_lang_word": "прожива́ть",
                                "target_lang_sense_clarification": "официально или фактически жить в определённом месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa7b265d-ae47-306b-bdf8-f85d344dd579",
                    "sense_definition": "To be present in a place or mind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark memories <w>inhabit</w> his mind after the tragic accident.",
                            "target_lang_translations": {
                                "ru": "Мрачные воспоминания <w>занимают</w> его мысли после трагического происшествия."
                            }
                        },
                        {
                            "text": "A sense of peace seems to <w>inhabit</w> this quiet garden.",
                            "target_lang_translations": {
                                "ru": "Кажется, что чувство покоя <w>наполняет</w> этот тихий сад."
                            }
                        }
                    ],
                    "synonyms": [
                        "haunt",
                        "occupy"
                    ],
                    "common_phrases": [
                        "inhabit the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присутствовать, находиться внутри чего-либо (например, в мыслях, в пространстве или в атмосфере)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполня́ть",
                                "target_lang_sense_clarification": "занимать собой пространство, насыщать атмосферу"
                            },
                            {
                                "target_lang_word": "занима́ть",
                                "target_lang_sense_clarification": "заполнять собой какое-либо пространство или сознание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}