                        "glosses": [
                            "État de ce qui est classique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe253a4-df1d-4a81-9326-26013b321bfe",
                                "sense_id": "604e9017-f2fa-3376-8da6-5c93d54c1123",
                                "text": "Le classicisme s’engendre là où l’architecture dépend toujours des motifs préexistants : la classicité, au contraire, naît d’une maîtrise de la fonction."
                            },
                            {
                                "example_id": "7b1e9509-068a-4aea-bfd2-ff1fc1ac98a3",
                                "sense_id": "604e9017-f2fa-3376-8da6-5c93d54c1123",
                                "text": "Si l’auteur salue dans l’œuvre l’alliance de la modernité et de la classicité, il délaisse rapidement les considérations esthétiques et le discours critique pour adopter un ton nettement plus personnel."
                            }
                        ]
                    }
