                        "examples": [
                            {
                                "example_id": "74683fb4-1152-4d87-bf17-1883ae4a421b",
                                "sense_id": "813c0030-443e-3272-80c8-7d5945877a92",
                                "text": "Vastgoedwethouder Victor Everhardt ziet de aanbouw van woon- en werkruimte boven het spoor als een uitgelezen kans het woningtekort in de stad terug te dringen."
                            },
                            {
                                "example_id": "15f7919c-b774-4547-b97c-63f872bb3bd7",
                                "sense_id": "813c0030-443e-3272-80c8-7d5945877a92",
                                "text": "Een deel daarvan is besteed aan werkruimte voor de 450 journalisten uit binnen- en buitenland die verslag zullen doen van het proces. Van hen passen er maar vijftien in de zittingszaal. De rest kan de zaak volgen in een speciaal gebouwd perscentrum naast de extra beveiligde rechtbank bij Schiphol."
                            }
                        ]
                    }
