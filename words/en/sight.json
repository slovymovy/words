{
    "word_family": [
        "sightless",
        "sighted",
        "insight",
        "eyesight",
        "foresight",
        "hindsight",
        "oversight",
        "sightseeing",
        "sightseer",
        "unsightly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b5a0361-1071-3fc8-bfb7-f11e213f9a72",
                    "sense_definition": "The physical ability to see using the eyes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vision_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost his <w>sight</w> in an accident when he was a child.",
                            "target_lang_translations": {
                                "ru": "Он потерял <w>зрение</w> в результате несчастного случая, когда был ребёнком.",
                                "zh": "他小时候因事故失去了<w>视力</w>。"
                            }
                        },
                        {
                            "text": "Regular checkups are important to maintain good <w>sight</w>.",
                            "target_lang_translations": {
                                "ru": "Регулярные осмотры важны для поддержания хорошего <w>зрения</w>.",
                                "zh": "定期检查对保持良好的<w>视力</w>很重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vision",
                        "sense of sight",
                        "eyesight"
                    ],
                    "common_phrases": [
                        "lose one's sight",
                        "restore sight",
                        "poor sight",
                        "keen sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая способность видеть с помощью глаз.",
                        "zh": "指眼睛看东西的生理能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зрение",
                                "target_lang_sense_clarification": "способность видеть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视力",
                                "target_lang_sense_clarification": "眼睛看东西的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69fb3b7d-5ef5-3137-b085-251987c4fd9b",
                    "sense_definition": "The act of seeing something, or the area within which things can be seen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vision_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We caught <w>sight</w> of the rare bird before it flew away.",
                            "target_lang_translations": {
                                "ru": "Мы <w>заметили</w> редкую птицу, прежде чем она улетела.",
                                "zh": "在那只稀有鸟儿飞走前，我们<w>看见</w>了它。"
                            }
                        },
                        {
                            "text": "The ship slowly sailed out of <w>sight</w> over the horizon.",
                            "target_lang_translations": {
                                "ru": "Корабль медленно скрылся из <w>виду</w> за горизонтом.",
                                "zh": "船只缓缓驶过地平线，消失在我们的<w>视线</w>之外。"
                            }
                        }
                    ],
                    "synonyms": [
                        "view",
                        "visibility",
                        "range"
                    ],
                    "common_phrases": [
                        "catch sight of",
                        "out of sight",
                        "in sight",
                        "at first sight",
                        "love at first sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт видения или область, в пределах которой можно видеть предметы.",
                        "zh": "看见某物的动作，或指视野范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "в фразах \"из виду\", \"на виду\""
                            },
                            {
                                "target_lang_word": "поле зрения",
                                "target_lang_sense_clarification": "область видимости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视线",
                                "target_lang_sense_clarification": "视野范围"
                            },
                            {
                                "target_lang_word": "看见",
                                "target_lang_sense_clarification": "看见某物的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "633bd489-63ff-33c0-867e-17475dfc7ecd",
                    "sense_definition": "Something interesting or worth seeing; a spectacle or place of interest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "thing_seen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole day walking around London to see the <w>sights</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, гуляя по Лондону и осматривая <w>достопримечательности</w>.",
                                "zh": "我们花了一整天在伦敦四处游览，参观各种<w>景点</w>。"
                            }
                        },
                        {
                            "text": "The sunset over the mountains was truly a beautiful <w>sight</w>.",
                            "target_lang_translations": {
                                "ru": "Закат над горами был поистине прекрасным <w>зрелищем</w>.",
                                "zh": "山间的日落真是一道美丽的<w>景象</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "view",
                        "attraction",
                        "spectacle"
                    ],
                    "common_phrases": [
                        "see the sights",
                        "beautiful sight",
                        "familiar sight",
                        "look a sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то интересное или стоящее внимания; зрелище или достопримечательность.",
                        "zh": "有趣或值得一看的事物；景观或名胜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достопримечательность",
                                "target_lang_sense_clarification": "место, заслуживающее внимания"
                            },
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "то, что привлекает взор"
                            },
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "пейзаж, картина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "景点",
                                "target_lang_sense_clarification": "值得参观的地方"
                            },
                            {
                                "target_lang_word": "景象",
                                "target_lang_sense_clarification": "所看到的景象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1137306a-ecd8-35f1-8565-ce8127a3229d",
                    "sense_definition": "A person's judgment, opinion, or mental view.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All people should be treated equally in the <w>sight</w> of the law.",
                            "target_lang_translations": {
                                "ru": "Все люди должны быть равны в <w>глазах</w> закона.",
                                "zh": "在法律的<w>眼中</w>，所有人都应该被平等对待。"
                            }
                        },
                        {
                            "text": "He committed a grave sin in the <w>sight</w> of God.",
                            "target_lang_translations": {
                                "ru": "Он совершил тяжкий грех в <w>глазах</w> Бога.",
                                "zh": "在上帝的<w>眼中</w>，他犯下了严重的罪行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the sight of",
                        "in God's sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суждение, мнение или мысленный взгляд человека.",
                        "zh": "个人的判断、观点或看法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глаза",
                                "target_lang_sense_clarification": "перен. мнение (в глазах кого-то)"
                            },
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "суждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "眼中",
                                "target_lang_sense_clarification": "在某人的观点或看法中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27dedb3b-e93a-3a78-b2dc-19fdd109fdef",
                    "sense_definition": "A device on a gun or optical instrument used for aiming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier looked through the <w>sight</w> to aim at the target.",
                            "target_lang_translations": {
                                "ru": "Солдат посмотрел в <w>прицел</w>, чтобы навести оружие на цель.",
                                "zh": "士兵通过<w>瞄准器</w>锁定目标。"
                            }
                        },
                        {
                            "text": "He adjusted the laser <w>sight</w> on his rifle for better accuracy.",
                            "target_lang_translations": {
                                "ru": "Он отрегулировал лазерный <w>прицел</w> на своей винтовке для лучшей точности.",
                                "zh": "他调整了步枪上的激光<w>瞄准器</w>以提高精度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scope"
                    ],
                    "common_phrases": [
                        "laser sight",
                        "telescopic sight",
                        "front sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство на оружии или оптическом приборе, используемое для прицеливания.",
                        "zh": "枪支或光学仪器上用于瞄准的装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прицел",
                                "target_lang_sense_clarification": "устройство для наведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞄准器",
                                "target_lang_sense_clarification": "用于瞄准的装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ac6f565-f69a-317e-bbfc-4668f5b1b805",
                    "sense_definition": "A large amount or degree; often used to emphasize a comparison.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new car is a darn <w>sight</w> faster than my old one.",
                            "target_lang_translations": {
                                "ru": "Эта новая машина <w>гораздо</w> быстрее моей старой.",
                                "zh": "这辆新车比我那辆旧车快<w>得多</w>。"
                            }
                        },
                        {
                            "text": "It will cost a <w>sight</w> more money than we originally planned.",
                            "target_lang_translations": {
                                "ru": "Это будет стоить <w>намного</w> больше денег, чем мы изначально планировали.",
                                "zh": "这比我们最初计划的要贵<w>得多</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a darn sight",
                        "a sight better"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или степень; часто используется для усиления сравнения.",
                        "zh": "很大程度或数量；常用于强调比较。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гораздо",
                                "target_lang_sense_clarification": "разг. (в сравнениях)"
                            },
                            {
                                "target_lang_word": "намного",
                                "target_lang_sense_clarification": "разг. значительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "得多",
                                "target_lang_sense_clarification": "用于比较，表示程度大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8b3d9b5-ae64-38eb-8010-1c0d4dc68d22",
                    "sense_definition": "To manage to see or observe something, especially after looking for it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vision_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After weeks at sea, the sailors were relieved to <w>sight</w> land.",
                            "target_lang_translations": {
                                "ru": "После недель в море моряки с облегчением <w>увидели</w> землю.",
                                "zh": "在海上航行数周后，水手们终于<w>望见</w>了陆地，感到如释重负。"
                            }
                        },
                        {
                            "text": "We were lucky enough to <w>sight</w> a whale during our boat trip.",
                            "target_lang_translations": {
                                "ru": "Нам посчастливилось <w>заметить</w> кита во время нашей лодочной прогулки.",
                                "zh": "我们很幸运，在乘船旅行时<w>发现</w>了一头鲸鱼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spot",
                        "glimpse",
                        "espy"
                    ],
                    "common_phrases": [
                        "sight land",
                        "sight the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суметь увидеть или наблюдать что-то, особенно после поисков.",
                        "zh": "设法看见或观察到某物，尤指在寻找之后。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увидеть",
                                "target_lang_sense_clarification": "воспринять зрением"
                            },
                            {
                                "target_lang_word": "заметить",
                                "target_lang_sense_clarification": "обнаружить"
                            },
                            {
                                "target_lang_word": "обнаружить",
                                "target_lang_sense_clarification": "найти взглядом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发现",
                                "target_lang_sense_clarification": "找到并看见"
                            },
                            {
                                "target_lang_word": "望见",
                                "target_lang_sense_clarification": "从远处看见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48c9fbd7-b7f8-32e6-b79f-8a74cedfa8cd",
                    "sense_definition": "To aim a weapon or instrument at a target using a sight.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter <w>sighted</w> the deer carefully through his scope.",
                            "target_lang_translations": {
                                "ru": "Охотник тщательно <w>прицелился</w> в оленя через оптический прицел.",
                                "zh": "猎人通过瞄准镜仔细地<w>瞄准</w>了那头鹿。"
                            }
                        },
                        {
                            "text": "He raised the rifle and <w>sighted</w> along the barrel.",
                            "target_lang_translations": {
                                "ru": "Он поднял винтовку и <w>прицелился</w> вдоль ствола.",
                                "zh": "他举起步枪，顺着枪管<w>瞄准</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aim at",
                        "take aim at"
                    ],
                    "common_phrases": [
                        "sight a gun",
                        "sight the target"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наводить оружие или инструмент на цель, используя прицел.",
                        "zh": "使用瞄准器将武器或仪器对准目标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целиться",
                                "target_lang_sense_clarification": "наводить оружие"
                            },
                            {
                                "target_lang_word": "взять на прицел",
                                "target_lang_sense_clarification": "навести оружие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞄准",
                                "target_lang_sense_clarification": "对准目标"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}