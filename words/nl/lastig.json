                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "moeilijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een <w>lastige</w> opgave om dit probleem binnen een uur op te lossen.",
                            "target_lang_translations": {
                                "en": "It is a <w>difficult</w> task to solve this problem within an hour.",
                                "ru": "Это <w>трудная</w> задача — решить эту проблему в течение часа.",
                                "fr": "C'est une tâche <w>difficile</w> de résoudre ce problème en une heure."
