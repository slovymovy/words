                "senses": [
                    {
                        "sense_id": "897df39e-f89e-343c-bd66-5eefeeebb517",
                        "entry_id": "63097ff2-9ee4-306f-8e93-64777e1e0a5b",
                        "glosses": [
                            "jemand, der ein Fahrzeug der Marke Ferrari fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "469252ad-f509-47a0-885b-5e1f785b30dc",
                                "sense_id": "897df39e-f89e-343c-bd66-5eefeeebb517",
                                "text": "„Ein Ferrarifahrer biegt in Bülach falsch ab und wird dabei von zwei Stadtpolizisten beobachtet.“"
                            },
                            {
                                "example_id": "c012ba2a-ecf8-4ec7-949d-a7d928feff1a",
                                "sense_id": "897df39e-f89e-343c-bd66-5eefeeebb517",
                                "text": "„Und weil jeder Ferrarifahrer auch seinen Motor hören will, macht sich dieser auch im Innenraum deutlich bemerkbar.“"
                            },
                            {
                                "example_id": "e3603291-e344-4856-981e-7709abb99f1c",
                                "sense_id": "897df39e-f89e-343c-bd66-5eefeeebb517",
                                "text": "„Einem Ferrarifahrer fehlt an einer Raststätte das nötige Geld, um die Tankrechnung zu begleichen – also fährt er ohne zu bezahlen fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
