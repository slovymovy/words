                            }
                        },
                        {
                            "text": "The quiet town of <w>Waite</w> has a very small population.",
                            "target_lang_translations": {
                                "tr": "Sakin bir kasaba olan <w>Waite</w> çok küçük bir nüfusa sahiptir."
                            }
                        }
                    ],
                    "target_lang_definitions": {
