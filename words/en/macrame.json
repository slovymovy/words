                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绳结编织",
                                "target_lang_sense_clarification": "指通过绳索打结形成的装饰性工艺品。"
                            },
                            {
                                "target_lang_word": "花边结",
                                "target_lang_sense_clarification": "指macrame工艺中常用的结艺形式。"
                            }
