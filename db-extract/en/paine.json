                "senses": [
                    {
                        "sense_id": "ec1690a4-5364-3c70-84b2-13b0bd3042d9",
                        "entry_id": "0922d501-382a-3c6a-8fb7-b139e34cfbcd",
                        "glosses": [
                            "An English surname, of Norman derivation, meaning someone who lived outside of a city (see Latin pagus)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f4a487-e45e-4c6e-99ce-919dd5a798cd",
                                "sense_id": "ec1690a4-5364-3c70-84b2-13b0bd3042d9",
                                "text": "Albert Bigelow Paine, his biographer to be and literary executor, who has been constantly with him, said that for the last year at least Mr. Clemens had been weary of life. When Richard Watson Gilder died, he said: \"How fortunate he is. No good fortune of that kind ever comes to me.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
