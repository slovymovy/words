{
    "word_family": [
        "treachery",
        "treacherously",
        "treacherousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a32d7078-2940-3be0-a69a-5f9a1ff7cce5",
                    "sense_definition": "Deceitful and inclined to betray others",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "betrayal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>treacherous</w> spy sold secret information to the enemy government.",
                            "target_lang_translations": {
                                "de": "Der <w>verräterische</w> Spion verkaufte geheime Informationen an die feindliche Regierung."
                            }
                        },
                        {
                            "text": "He felt hurt by his <w>treacherous</w> friend who lied about him to everyone.",
                            "target_lang_translations": {
                                "de": "Er fühlte sich von seinem <w>hinterlistigen</w> Freund verletzt, der ihn bei jedem verleumdete."
                            }
                        }
                    ],
                    "synonyms": [
                        "disloyal",
                        "deceitful",
                        "unfaithful"
                    ],
                    "antonyms": [
                        "loyal"
                    ],
                    "target_lang_definitions": {
                        "de": "Täuschend und dazu neigend, andere zu verraten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verräterisch",
                                "target_lang_sense_clarification": "Bezieht sich auf jemanden, der illoyal ist oder Verrat begeht."
                            },
                            {
                                "target_lang_word": "hinterlistig",
                                "target_lang_sense_clarification": "Bezieht sich auf eine Person, die heimtückisch oder falsch handelt."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                    "sense_definition": "Unreliable and potentially dangerous",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to navigate a <w>treacherous</w> mountain trail during the storm.",
                            "target_lang_translations": {
                                "de": "Die Wanderer mussten während des Sturms einen <w>tückischen</w> Bergpfad bewältigen."
                            }
                        },
                        {
                            "text": "Driving on the <w>treacherous</w> icy roads requires extreme caution and slow speeds.",
                            "target_lang_translations": {
                                "de": "Das Fahren auf den <w>tückisch</w> vereisten Straßen erfordert äußerste Vorsicht und eine langsame Geschwindigkeit."
                            }
                        }
                    ],
                    "synonyms": [
                        "hazardous",
                        "perilous",
                        "dangerous"
                    ],
                    "common_phrases": [
                        "treacherous conditions",
                        "treacherous terrain"
                    ],
                    "target_lang_definitions": {
                        "de": "Unzuverlässig und potenziell gefährlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "tückisch",
                                "target_lang_sense_clarification": "Bezieht sich auf eine Gefahr, die unvorhersehbar oder nicht sofort erkennbar ist."
                            },
                            {
                                "target_lang_word": "gefährlich",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für eine Situation oder einen Ort, der ein Risiko birgt."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}