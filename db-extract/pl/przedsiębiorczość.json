                                        "sense_id": "76caecff-0f05-32fb-b9f9-535d12c38767",
                                        "entry_id": "3c9fe2f3-86fc-30a3-bd99-562b556b693d",
                                        "glosses": [
                                            "A company, business, organization, or other purposeful endeavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "940dec31-fbe5-4f76-acc7-da3ca621778a",
                                                "sense_id": "76caecff-0f05-32fb-b9f9-535d12c38767",
                                                "text": "The government sponsored enterprises (GSEs) are a group of financial services corporations which have been created by the United States Congress."
                                            },
                                            {
                                                "example_id": "93d4d85f-1a6f-4976-b312-a519820f9e60",
                                                "sense_id": "76caecff-0f05-32fb-b9f9-535d12c38767",
                                                "text": "A micro-enterprise is defined as a company or business having 5 or fewer employees and a low seed capital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d9dbdb6-edde-3b81-81a4-5bae4919a134",
                                        "entry_id": "3c9fe2f3-86fc-30a3-bd99-562b556b693d",
                                        "glosses": [
                                            "An undertaking, venture, or project, especially a daring and courageous one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fde959c-7163-4718-8672-e5268d352258",
                                                "sense_id": "5d9dbdb6-edde-3b81-81a4-5bae4919a134",
                                                "text": "Biosphere 2 was a scientific enterprise aimed at the exploration of the complex web of interactions within life systems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35723ddd-34f9-3ebe-bf9d-c853fbc62441",
                                        "entry_id": "3c9fe2f3-86fc-30a3-bd99-562b556b693d",
                                        "glosses": [
                                            "A willingness to undertake new or risky projects; energy and initiative."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a6cbb8e-dd94-4149-893f-3a7b00d8c7d8",
                                                "sense_id": "35723ddd-34f9-3ebe-bf9d-c853fbc62441",
                                                "text": "He has shown great enterprise throughout his early career."
                                            },
                                            {
                                                "example_id": "1d172de4-1d20-46ea-86a6-5e191b354638",
                                                "sense_id": "35723ddd-34f9-3ebe-bf9d-c853fbc62441",
                                                "text": "This loss of interest, hair, and enterprise — / Ah, if the game were poker, yes, / You might discard them, draw a full house! / But it's chess."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "845bb883-f6f9-3390-88c0-811efffb4d6a",
                                        "entry_id": "3c9fe2f3-86fc-30a3-bd99-562b556b693d",
                                        "glosses": [
                                            "Active participation in projects."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "enterprise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "317044b0-184d-3af2-a001-55f31d72d10f",
                                        "entry_id": "7a2a6e81-282b-3437-9293-77ba838fdf12",
                                        "glosses": [
                                            "To undertake an enterprise, or something hazardous or difficult."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1f83a84-ce59-411c-a1b6-7ff8806bb3e5",
                                                "sense_id": "317044b0-184d-3af2-a001-55f31d72d10f",
                                                "text": "Charles Mordaunt Earl of Peterborow[…], with only 280 horse and 950 foot , enterprised and accomplished the Conquest of Valentia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea2ce4ed-5b3f-3878-a86e-fb313f196bfb",
                                        "entry_id": "7a2a6e81-282b-3437-9293-77ba838fdf12",
                                        "glosses": [
                                            "To undertake; to begin and attempt to perform; to venture upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "713506a5-0a56-4e31-8dc8-d4e2a52efeae",
                                                "sense_id": "ea2ce4ed-5b3f-3878-a86e-fb313f196bfb",
                                                "text": "The business must be enterprised this night."
                                            },
                                            {
                                                "example_id": "491a97a7-0c1f-4f7c-9461-169d17c57ceb",
                                                "sense_id": "ea2ce4ed-5b3f-3878-a86e-fb313f196bfb",
                                                "text": "c. 1680, Thomas Otway, letter to Elizabeth Barry\nWhat would I not renounce or enterprise for you!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f4b9c1-45bc-30f1-98cf-930b80bfb3f8",
                                        "entry_id": "7a2a6e81-282b-3437-9293-77ba838fdf12",
                                        "glosses": [
                                            "To put up or house; to entertain."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e390a2-844f-4ff5-aabd-84615ded838a",
                                                "sense_id": "17f4b9c1-45bc-30f1-98cf-930b80bfb3f8",
                                                "text": "Him at the threshold met, and well did enterprize."
                                            }
                                        ]
                                    }
                                ]
                            }
