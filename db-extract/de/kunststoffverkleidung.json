                "senses": [
                    {
                        "sense_id": "cb393611-d206-3b2c-a2ee-2f704b30b96c",
                        "entry_id": "66a9770b-a17c-3b11-b85b-ebc1a978d872",
                        "glosses": [
                            "Umhüllung aus Kunststoff, zum Schutz vor Außeneinflüssen oder Inneneinflüssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698f1fad-efa2-43e0-a90f-79aaf057b50a",
                                "sense_id": "cb393611-d206-3b2c-a2ee-2f704b30b96c",
                                "text": "„Die Innenwände wurden mit einer 2355 m² großen, Kunststoffverkleidung mit aufgebrachten geometrischen Figuren ausgekleidet.“"
                            },
                            {
                                "example_id": "a3ff5c52-608f-4bef-a314-5303b49fbe73",
                                "sense_id": "cb393611-d206-3b2c-a2ee-2f704b30b96c",
                                "text": "„Die lange Lebensdauer, die Dauerhaftigkeit und die einfache Pflege sind die drei wesentlichen Vorteile, die Sie mit Kunststoffverkleidungen für Ihren Balkon haben.“"
                            },
                            {
                                "example_id": "60df421e-670c-47f1-839f-42abc133e594",
                                "sense_id": "cb393611-d206-3b2c-a2ee-2f704b30b96c",
                                "text": "„Die Kunststoffverkleidung besteht entweder aus PVC (Polyvinylchlorid), GUP (glasverstärkte,ungesättigte Polyesterharze) oder PMMA (Polymethylmetacrylat).“"
                            },
                            {
                                "example_id": "5210c62a-0fbc-444a-880c-8eece54a93f8",
                                "sense_id": "cb393611-d206-3b2c-a2ee-2f704b30b96c",
                                "text": "„Das Türschloss eines Modells seiner gehobenen Mittelklasse wird in die Kunststoffverkleidung der Autotür eingeschraubt, die Schraube ist jedoch von aussen erreichbar – ließe sich also von \"Langfingern\" auch wieder herausschrauben.“"
                            },
                            {
                                "example_id": "821628dc-754a-45a3-962e-c98c3b9cc583",
                                "sense_id": "cb393611-d206-3b2c-a2ee-2f704b30b96c",
                                "text": "„Das Golden-Oak Profil verbindet klassische Holzoptik mit allen Vorteilen einer Kunststoffverkleidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
