                "senses": [
                    {
                        "sense_id": "22bf5f68-2e14-3dff-8876-0b4bf73f9a43",
                        "entry_id": "657ac267-4bbd-3909-99ea-10c7cd3d2b1a",
                        "glosses": [
                            "Variante de désoucher."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e8683292-7a28-448b-ad62-1c9314bd0efc",
                                "sense_id": "22bf5f68-2e14-3dff-8876-0b4bf73f9a43",
                                "text": "La première opération qu'exige l'établissement d'une caféyère, est de faire disparoître les arbres qui couvrent le terrain ; […]. S'il est uni, ou s'il n'a que des pente douces, on doit dessoucher soigneusement, après avoir brûlé tout ce que la hache avoit pu atteindre."
                            },
                            {
                                "example_id": "472b82f1-7d46-4855-a6fb-0935f25a3e1a",
                                "sense_id": "22bf5f68-2e14-3dff-8876-0b4bf73f9a43",
                                "text": "Rien ne lui semblait plus beau que le maître qui distribue les tâches et qui pousse la charrue, qui dessouche, qui défriche, qui essarte."
                            }
                        ]
                    }
