                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b476b21e-a358-4f3c-8e64-4cee72d466fb",
                                                "sense_id": "109b289e-ec4d-3e39-86ef-5af51dcc45bd",
                                                "text": "The boxbed opened like a cupboard."
                                            },
                                            {
                                                "example_id": "fe35fed1-28f7-4f6d-a9b8-ecedf5e7087a",
                                                "sense_id": "109b289e-ec4d-3e39-86ef-5af51dcc45bd",
                                                "text": "The boxbed was there in which Grace had been born, and on it she was laid to die."
                                            },
                                            {
                                                "example_id": "adfb9855-7746-4e4d-a5a1-9470571ee2a3",
                                                "sense_id": "109b289e-ec4d-3e39-86ef-5af51dcc45bd",
                                                "text": "Relieved there 'd be no awkward questions to answer, she went to draw the curtains of her boxbed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
