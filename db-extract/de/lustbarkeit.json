                ],
                "senses": [
                    {
                        "sense_id": "75ea434c-cf6a-3e53-8908-61b6febb623b",
                        "entry_id": "8b23ad8c-258b-3e6b-8027-1e3e1d41c4bf",
                        "glosses": [
                            "Veranstaltung, die jemand zur Unterhaltung, zur Vergnügung besucht; etwas, was Freude bereiten soll"
                        ],
                        "tags": [
                            "gehoben",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "cc8ef6c2-8766-4725-891b-57e92fd8c2e3",
                                "sense_id": "75ea434c-cf6a-3e53-8908-61b6febb623b",
                                "text": "„Durch Erhebung von Eintrittsgeld wird eine nicht öffentliche Lustbarkeit nicht zu einer öffentlichen.“"
                            },
                            {
                                "example_id": "9bc29d2e-bbfd-462b-bc48-0d56932613a1",
                                "sense_id": "75ea434c-cf6a-3e53-8908-61b6febb623b",
                                "text": "„Für manchen Partygänger ist es schwer zu ertragen, dass die Lustbarkeit nach Mitternacht gesetzlich beendet werden muss.“"
                            },
                            {
                                "example_id": "4cdc761e-8e20-4ba1-8478-50e1bc0a2a31",
                                "sense_id": "75ea434c-cf6a-3e53-8908-61b6febb623b",
                                "text": "„In Begleitung dieses Buches wird das Essen und Trinken für den Italienreisenden zu einer Lustbarkeit, das Lesen von Menükarten und Speisezetteln im Restaurant zum appetitanregenden Vergnügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
