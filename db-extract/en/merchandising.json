                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6c801392-00c5-4918-8f2b-fd4aa0c7f5c2",
                        "entry_id": "1da94637-102c-3de8-81a4-b40ed706fa27",
                        "tags": [
