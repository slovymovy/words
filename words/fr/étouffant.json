                    "frequency": "Middle",
                    "semantic_group_id": "climat_chaleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'été, la chaleur devient parfois <w>étouffante</w> dans les grandes villes sans espaces verts."
                        },
                        {
                            "text": "Ouvre la fenêtre, s'il te plaît, l'air est devenu complètement <w>étouffant</w> dans ce bureau fermé."
                        }
                    ],
