                    {
                        "sense_id": "4c586584-0f48-3e21-bb1d-9b2ced233cfa",
                        "entry_id": "d9e90ecc-af0c-3bdf-8a9c-adc640b253d7",
                        "glosses": [
                            "A lawspeaker: a declarer of the law."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d5b2d3d4-b6ed-338d-8bf3-965e0d711745",
                        "entry_id": "d9e90ecc-af0c-3bdf-8a9c-adc640b253d7",
                        "glosses": [
                            "One of 12 magistrates in certain Danish boroughs of England empowered with soc and sac over their own households."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3a90f72d-8c3e-389e-a15c-11fa80ce669d",
                        "entry_id": "d9e90ecc-af0c-3bdf-8a9c-adc640b253d7",
                        "glosses": [
                            "The presiding justice of the supreme court."
                        ],
                        "tags": [
                            "Orkney",
                            "Shetland"
                        ],
                        "examples": [
                            {
                                "example_id": "ebffbf51-87b2-4c87-bdb0-2c372e030f9c",
                                "sense_id": "3a90f72d-8c3e-389e-a15c-11fa80ce669d",
                                "text": "From the twelfth century Shetland had been administered directly by the Norwegian crown through the 'foud', rather than forming part of the patrimony of a great aristocratic estate. The foud appointed 'underfouds' and the Shetlands evolved their own elected officers, a 'lawman' and parish 'lawrightmen', who adjudicated and negotiated the collection of customary taxes and fines on behalf of the local population."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ae8bb2e-af67-3701-bcc9-5523a71aff42",
                        "entry_id": "d9e90ecc-af0c-3bdf-8a9c-adc640b253d7",
                        "glosses": [
                            "A man of the law: a lawyer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "89daeb7f-de6a-31ae-880a-4c3407252d44",
                        "entry_id": "d9e90ecc-af0c-3bdf-8a9c-adc640b253d7",
                        "glosses": [
                            "An officer of the law: a law-enforcement officer."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "5968d2bf-3a64-4064-86ec-00b9b0a9095c",
                                "sense_id": "89daeb7f-de6a-31ae-880a-4c3407252d44",
                                "text": "\"Fill your hand, you sonuvabitch,\" the old lawman cries, clamping the reins of his horse between his teeth and filling his own hands with six-gun and repeater."
                            },
                            {
                                "example_id": "2be339c5-d02b-4827-8ded-e62c211bfad4",
                                "sense_id": "89daeb7f-de6a-31ae-880a-4c3407252d44",
                                "text": "The two lawmen punched his ticket with four well-aimed rifle shots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac7cb2a8-bafb-437c-9d24-3111c94c38cc",
                        "source_entry_id": "d9e90ecc-af0c-3bdf-8a9c-adc640b253d7",
                        "source_sense_description": "an officer of the law",
                        "target_lang_word": "homme de loi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme de loi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "015197cb-cac8-320a-9272-0f029324a053",
                                        "entry_id": "baddd6be-b46d-3eb6-8fa8-ab0ea6cc039a",
                                        "glosses": [
                                            "Magistrat de justice."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a87e879f-c306-4320-88d6-36603f3cae4c",
                                                "sense_id": "015197cb-cac8-320a-9272-0f029324a053",
                                                "text": "[…] un homme de loi qui, derrière l’accusateur enturbanné de saint Georges, montrait sa face haineuse dans son capuchon de « chat-fourré », reparaît derrière le juge qui assiste à l’égorgement des saints médecins."
                                            },
                                            {
                                                "example_id": "537e0f82-5581-4d17-9874-60fd31951408",
                                                "sense_id": "015197cb-cac8-320a-9272-0f029324a053",
                                                "text": "Madeleine avait alors consulté un homme de loi qui l’avait informée que, selon la réglementation, Joseph Lory lui devait dix-neuf ans d’indemnités - \"des arrérages\", selon son expression - pour avoir été maintenue en esclavage alors qu’elle était libre depuis 1789."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bf9b1b1-4380-37d6-aadf-1573aed1f649",
                                        "entry_id": "baddd6be-b46d-3eb6-8fa8-ab0ea6cc039a",
                                        "glosses": [
                                            "Avocat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d47d730-1733-40ab-a4cd-0c5a5133dccd",
                                                "sense_id": "4bf9b1b1-4380-37d6-aadf-1573aed1f649",
                                                "text": "Avec un entêtement dont rien ne vint à bout, il obligea Grubb à redresser sa roue d’avant tordue, et son homme de loi harcela les malheureux mécaniciens de lettres rédigées en un style biscornu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
