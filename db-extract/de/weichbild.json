                ],
                "senses": [
                    {
                        "sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                        "entry_id": "8324b4fc-f3d3-39e8-a06d-f2c5c748087b",
                        "glosses": [
                            "innerhalb der Ortsgrenzen liegendes Gebiet, wobei der Ort eine eigene Gerichtsbarkeit hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6312c69a-68c8-4f69-b934-36dfe293ab3e",
                                "sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                                "text": "Der Kaiser schenkte dem Ort das Magdeburger Weichbild."
                            },
                            {
                                "example_id": "b1d74569-742a-4fdf-a878-cd96f5571408",
                                "sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                                "text": "Der Neroberg liegt innerhalb des Weichbildes der hessischen Landeshauptstadt Wiesbaden."
                            },
                            {
                                "example_id": "1383c2c8-2407-41b6-aa55-1d1867903c19",
                                "sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                                "text": "Der Angeklagte untersteht der Gerichtsbarkeit des Nachbarortes, weil die Tat außerhalb unseres Weichbildes geschah."
                            },
                            {
                                "example_id": "ed348b25-0732-4b9f-92c1-858408c81360",
                                "sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                                "text": "Vom Hochzeitsturm in Darmstadt aus hat man einen herrlichen Blick auf das Weichbild der Stadt Frankfurt."
                            },
                            {
                                "example_id": "c39b9252-8ab5-401a-a0ba-e519702aeb80",
                                "sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                                "text": "„Sie kannten das Weichbild von der südlichen Seite, die unsymmetrische Front von roten Bauernhäusern, von Dächern und Schornsteinen, darunter der hohe der Molkerei und der niedrige der Bäckerei.“"
                            },
                            {
                                "example_id": "119e9495-f86e-469d-b9d1-12a8649dc571",
                                "sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                                "text": "„Längst lag die Region der Kunststeinfabrik hinter ihnen, sie hatten das Weichbild der Katakombenstadt durchquert und waren schließlich in das Gebiet gelangt, wo die städtische Gegenfabrik ihre Niederlassung unterhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0753520e-2d20-4377-b292-105da981fed6",
                        "source_entry_id": "8324b4fc-f3d3-39e8-a06d-f2c5c748087b",
                        "source_sense_id": "1550d5f3-8106-363a-94a6-239f57cf49a4",
                        "source_sense_description": "innerhalb der Ortsgrenzen liegendes Gebiet, wobei der Ort eine eigene Gerichtsbarkeit hat",
                        "target_lang_word": "purlieu",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purlieu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17324d91-5d67-3e22-a311-27272ea5d319",
                                        "entry_id": "f90c861a-c10c-381a-a525-fdfd8ea95381",
                                        "glosses": [
                                            "The ground on the edges of a forest, especially when partly subject to the same forest laws concerning game hunting etc."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46d29c8e-63a0-3956-a9b5-d7e3a0daf39f",
                                        "entry_id": "f90c861a-c10c-381a-a525-fdfd8ea95381",
                                        "glosses": [
                                            "The outskirts of any place; an adjacent district; the environs or neighborhood; milieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3feb01ee-009a-4d77-b242-6ce498e3b915",
                                                "sense_id": "46d29c8e-63a0-3956-a9b5-d7e3a0daf39f",
                                                "text": "Whether Lady Anne knew or suspected who it was that drew his steps from the purlieus of fashion he knew not, nor held himself bound to explain."
                                            },
                                            {
                                                "example_id": "14349f53-a053-481b-a017-57398dd4b7fb",
                                                "sense_id": "46d29c8e-63a0-3956-a9b5-d7e3a0daf39f",
                                                "text": "Bred up, like a bailiff or a shabby attorney, about the purlieus of the Inns of Court, Shepherd’s Inn is always to be found in the close neighbourhood of Lincoln’s-Inn Fields, and the Temple."
                                            },
                                            {
                                                "example_id": "f04c7747-6a8f-4788-8bde-3a0cd621a08a",
                                                "sense_id": "46d29c8e-63a0-3956-a9b5-d7e3a0daf39f",
                                                "text": "He seemed to wish to keep hold of him, and looked at him strangely, over his spectacles... when he learned that Hyacinth had taken a lodging not in their old familiar quarter but in the unexplored purlieus of Westminster."
                                            },
                                            {
                                                "example_id": "21e3bb6d-8555-46a2-8f21-637d4fb4a4c0",
                                                "sense_id": "46d29c8e-63a0-3956-a9b5-d7e3a0daf39f",
                                                "text": "Wide blank courtyards surround the walls of this marvel, a little town hangs respectfully about its purlieus, and from far away across the plain, even from the streets of Madrid herself, you can see it brooding there on the edge of the mountains, looking at once holy, menacing and obsessed."
                                            },
                                            {
                                                "example_id": "52556f12-7f00-4cff-8a02-cb66d58c4c88",
                                                "sense_id": "46d29c8e-63a0-3956-a9b5-d7e3a0daf39f",
                                                "text": "The mission occupied eight or ten ares of land, a barren purlieu that held a few goats and burros."
                                            },
                                            {
                                                "example_id": "75b86bf7-bdcf-4f16-be06-6d78a130c160",
                                                "sense_id": "46d29c8e-63a0-3956-a9b5-d7e3a0daf39f",
                                                "text": "I wanted a beer, but coffee was undeniably easier to be had in the purlieus of the University, so we went into a cafe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
