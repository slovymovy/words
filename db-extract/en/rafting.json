                                        "entry_id": "46aa7d6d-ffd0-3715-a467-68b69141c8f2",
                                        "glosses": [
                                            "Sport nautique qui consiste à descendre des cours d’eau comportant des rapides à bord d’un raft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b18c226-fe05-4d27-892c-485df5fc4c2e",
                                                "sense_id": "91ddc00f-c9e6-3619-a1a1-6a64debaea0e",
                                                "text": "Sillonnées de somptueuses rivières aux eaux vertes – et froides ! –, les montagnes Rocheuses recèlent des centaines de sites pour la pratique des sports nautiques, et du rafting en particulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9e15b98-9a77-38c4-a3bc-906d812a45b4",
                                        "entry_id": "46aa7d6d-ffd0-3715-a467-68b69141c8f2",
                                        "glosses": [
                                            "Synonyme de raft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d2f055-a5fa-4d2f-9473-74430c686bbb",
                                                "sense_id": "c9e15b98-9a77-38c4-a3bc-906d812a45b4",
                                                "text": "Accompagnés des cris des novices et des ordres des moniteurs, canoës, kayaks et autres raftings passaient à ses pieds, défiant l’écume et les courants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
