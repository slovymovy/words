                        "examples": [
                            {
                                "example_id": "7924027f-5b8e-4a80-95e0-d85b594b4c6c",
                                "sense_id": "5afffd56-2ebd-3aaf-aa17-8d839d2aa46d",
                                "text": "Londen 2012 is het nieuwe project. \"Het is ontzettend moeilijk om een verzekering af te sluiten voor wat ik doe. Ik kreeg te horen dat het risicogehalte van de polis te vergelijken is met dat van een Formule1-coureur.\""
                            },
                            {
                                "example_id": "ec0fb93f-87eb-48b4-aef3-449a8468fcb0",
                                "sense_id": "5afffd56-2ebd-3aaf-aa17-8d839d2aa46d",
                                "text": "Zijn taak was heel eenvoudig: wat er ook voor crisis was, zodra hij oordeelde dat het risicogehalte een zekere drempel had overschreden zou hij op de knop drukken en het controlemechanisme vernietigen, zodat de zwaartekrachtgolfzender onbruikbaar werd."
                            }
                        ]
                    }
