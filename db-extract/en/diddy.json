                        "entry_id": "0307a2ac-2a65-3588-ab4f-cb93a8a98046",
                        "glosses": [
                            "Very small, tiny."
                        ],
                        "tags": [
                            "UK",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "298d7dd6-9581-4d7b-b695-06350898a0e3",
                                "sense_id": "e8400b6a-14b5-3f1d-93c4-51c52038b9bc",
                                "text": "Me mither mend't me auld breeks, / But ay! but they were diddy;"
                            },
                            {
                                "example_id": "4782d564-3c48-44a5-873c-c0b702ee3804",
                                "sense_id": "e8400b6a-14b5-3f1d-93c4-51c52038b9bc",
                                "text": "There's a pear orchard, and a knot garden, and a diddy little lake that's just big enough to swim in . . . hey, if the weather stays like this, we can have a dip tomorrow."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "be6c099b-d6be-32d6-ad11-08a0eb09a1be",
                "word": "diddy",
