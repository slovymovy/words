                        "form": "réparties"
                    },
                    {
                        "form_id": "3f9d74f6-3d4e-43fd-a446-f572e235bf1f",
                        "entry_id": "fffdc5b5-c5ad-3020-b678-efb332585742",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "repartie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2251a786-5635-3f71-9399-3b23d0f7b6d7",
                        "entry_id": "fffdc5b5-c5ad-3020-b678-efb332585742",
                        "glosses": [
                            "Réplique ou réponse faite de vive voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05fb9082-2b16-4572-a4ab-37a707332853",
                                "sense_id": "2251a786-5635-3f71-9399-3b23d0f7b6d7",
                                "text": "[…], il s'est réveillé et m'a demandé de lui passer le bassin. Histoire d'être un peu gentille, je lui ai dit : « C'est bien la première fois que je vois un nouveau-né réclamer le bassin. » Il m'a répondu : « C'est le cerveau qui commande le cul. Avec un cerveau comme le mien, vous ne voudriez pas que je me conchiasse !... »\nIl a de ces réparties !... J'en suis restée bouche bée — mon bassin à la main."
                            },
                            {
                                "example_id": "542d34a3-633b-4ee3-9a3a-65e653364887",
                                "sense_id": "2251a786-5635-3f71-9399-3b23d0f7b6d7",
                                "text": "Oui, le timide n’a jamais osé danser, du coup, il a eu le temps d’affûter son sens de la répartie pendant que ses petits camarades galochaient des nanas au look douteux et au maquillage ringard."
                            },
                            {
                                "example_id": "dd905809-0851-406c-b7e9-09704dd2af89",
                                "sense_id": "2251a786-5635-3f71-9399-3b23d0f7b6d7",
                                "text": "Parler, ça s’apprend, j’ai une répartie qui est assez rapide, sur le vif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68678ae8-92dc-4cc3-a690-21acef987dd8",
                        "source_entry_id": "fffdc5b5-c5ad-3020-b678-efb332585742",
                        "source_sense_id": "2251a786-5635-3f71-9399-3b23d0f7b6d7",
                        "target_lang_word": "repartee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repartee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                        "entry_id": "4ea5b384-95fe-32b9-a147-fe54c19a13c2",
                                        "glosses": [
                                            "A swift, witty reply, especially one that is amusing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe5410c0-fdb6-4833-883e-c57d93c63090",
                                                "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                                "text": "Many persons must laugh when a great person or an acknowledged wit says a clever thing, such as a smart repartee, or a really good pun."
                                            },
                                            {
                                                "example_id": "c916c7e7-2035-4b6a-830a-f37016830b2b",
                                                "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                                "text": "Yet habit—strange thing! what cannot habit accomplish?—Gayer sallies, more merry mirth, better jokes, and brighter repartees, you never heard over your mahogany[…]"
                                            },
                                            {
                                                "example_id": "a3faef20-5cd5-43ed-a658-bc67db426207",
                                                "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                                "text": "A slight smile broke on his lips. ¶ \"You are always prepared to sacrifice your principles for a repartee,\" he answered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46c5d07-9d98-3cbd-96d0-1bb494b43095",
                                        "entry_id": "4ea5b384-95fe-32b9-a147-fe54c19a13c2",
                                        "glosses": [
                                            "A conversation marked by a series of witty retorts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b45b1db-12f3-30df-8273-77c4f1e807ce",
                                        "entry_id": "4ea5b384-95fe-32b9-a147-fe54c19a13c2",
                                        "glosses": [
                                            "A skill in replying swiftly and wittily."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d69cfa8-3182-4ef3-bd08-09a603a37557",
                                                "sense_id": "3b45b1db-12f3-30df-8273-77c4f1e807ce",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            },
                                            {
                                                "example_id": "ba023e39-cafa-4da2-92a4-14d25102c063",
                                                "sense_id": "3b45b1db-12f3-30df-8273-77c4f1e807ce",
                                                "text": "Another millstone around the NDP’s neck was the relative lack of seasoned parliamentarians in the government front bench who were skilled enough at repartee to take on the Tory veterans across the floor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repartee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "079dab39-77c4-38db-996b-c6d6efbd1926",
                                        "entry_id": "bc3b5f05-aaa7-36e8-a82c-a2cae2610a19",
                                        "glosses": [
                                            "To reply with a repartee."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff22d98-78d1-49ad-ba1a-d240e2f3c4ee",
                                                "sense_id": "079dab39-77c4-38db-996b-c6d6efbd1926",
                                                "text": "Aubrey speaks of him as 'incomparable at reparteeing, the bull that was bayted, his witt beinge most sparkling, when most set on and provoked.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68cb5b92-6730-3fee-8713-bb59311589dd",
                                        "entry_id": "bc3b5f05-aaa7-36e8-a82c-a2cae2610a19",
                                        "glosses": [
                                            "To have a repartee (a conversation marked by witty retorts or replies)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ed8918-46c7-4109-922c-f4315add58e1",
                                                "sense_id": "68cb5b92-6730-3fee-8713-bb59311589dd",
                                                "text": "To see them together, friendly, reparteeing, chummy, would turn your stomach--Barbara so exquisite and high-born, and the man, his eyes full of evil fires, sitting like a great toad on the model's chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
