                                        "glosses": [
                                            "spółdzielcze gospodarstwo rolne w Związku Socjalistycznych Republik Radzieckich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619f2f35-1377-45de-a1aa-8f8b84d4e847",
                                                "sense_id": "ff860213-4417-3d99-9870-a80f9d9f5923",
                                                "text": "Kołchozy powstawały w wyniku przymusowego przejęcia ziemi od indywidualnych rolników na rzecz państwa"
                                            },
                                            {
                                                "example_id": "0c3f27c9-9b72-4b2d-a326-05830da9f905",
                                                "sense_id": "ff860213-4417-3d99-9870-a80f9d9f5923",
                                                "text": "Kołchozy wciąż istnieją na Białorusi"
                                            },
                                            {
                                                "example_id": "d15a7daf-807f-42b9-b4e6-b3cf30dfc4d6",
                                                "sense_id": "ff860213-4417-3d99-9870-a80f9d9f5923",
                                                "text": "Mój dziadek był kierownikiem kołchozu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "442c17c5-5eb4-34e7-ac9a-27f29ecb6c1a",
                                        "entry_id": "5991611c-de4b-3229-9ac3-5c17800fc6e0",
                                        "glosses": [
                                            "przeludnione miejsce pobytu o niskim komforcie"
