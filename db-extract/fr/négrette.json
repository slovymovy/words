                "senses": [
                    {
                        "sense_id": "c98cd8fb-cf60-31e2-8d5d-8e2408b75f73",
                        "entry_id": "641fd7b4-6b9b-30c9-89a6-5e8c6700a56e",
                        "glosses": [
                            "Cépage d'origine française donnant des raisins à petits grains noirs. En 2006 on en cultivait environ 1500 hectares en France."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "93e2f8fc-61da-4825-8257-1924c6343d0b",
                                "sense_id": "c98cd8fb-cf60-31e2-8d5d-8e2408b75f73",
                                "text": "Montpellier. Sur ces deux plants les habitants greffent des plants français. Les principaux cépages adoptés sont : la négrette, le valdiguier, le grand noir de la Calmette et la mérille du Bordelais. Quant aux plants blancs, on a conservé le mauzac et la Chalosse ou Grèce. Quelques propriétaires joignent à ces divers cépages le petit Gamais du Beaujolais."
                            },
                            {
                                "example_id": "d7b03188-ae3f-4e0c-a15d-978decf5fcda",
                                "sense_id": "c98cd8fb-cf60-31e2-8d5d-8e2408b75f73",
                                "text": "Ce vin [est] un pur négrette typé par le fruit et les épices, une « Forêt royale », partagée entre négrette et syrah, parfaitement structuré, bâti pour dormir de longues années en cave."
                            },
                            {
                                "example_id": "39f1927e-6d32-4da5-9019-3ebe47c9e538",
                                "sense_id": "c98cd8fb-cf60-31e2-8d5d-8e2408b75f73",
                                "text": "On retrouve la négrette dans les Charentes, en Vendée et à l’Île de Ré sous le vocable de « ragoûtant », « folle noire » ou « petit noir »."
                            }
                        ]
                    },
                    {
                        "sense_id": "a866b4a1-3ade-3510-a06f-027d3a0ce267",
                        "entry_id": "641fd7b4-6b9b-30c9-89a6-5e8c6700a56e",
                        "glosses": [
                            "Variété d’olive noire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1bb718-dab5-49e2-b3e2-df69367592b6",
                                "sense_id": "a866b4a1-3ade-3510-a06f-027d3a0ce267",
                                "text": "L’oliveraie, composée de 1200 arbres de variétés blanche de Payzac, rougette et négrette de l’Ardèche mais aussi aglandau et frantoio, est située dans un paysage en coteaux, exposé plein sud."
                            },
                            {
                                "example_id": "daf7deba-178b-4fa0-8432-5c2c0567e84a",
                                "sense_id": "a866b4a1-3ade-3510-a06f-027d3a0ce267",
                                "text": "La négrette de l’Hérault a des origines en Tunisie et en Turquie."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4ba6f28-b4a5-3fba-b4df-913de4074ed9",
