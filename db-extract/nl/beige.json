        "nl-extract.jsonl": [
            {
                "entry_id": "52af75f1-fca7-3e33-9e0d-11fd17582d4a",
                "word": "beige",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60fc9afd-6ed6-3863-95e9-8158cabad6ae",
                        "entry_id": "52af75f1-fca7-3e33-9e0d-11fd17582d4a",
                        "glosses": [
                            "met een grijsachtig geelbruine kleur, zoals die van onbewerkt linnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4e3f69-973a-468f-8698-5d01a07e5e44",
                                "sense_id": "60fc9afd-6ed6-3863-95e9-8158cabad6ae",
                                "text": "Chantal droeg een beige broekpak dat nogal vreemdsoortig op hem overkwam."
                            },
                            {
                                "example_id": "0e4057f3-b754-498b-8338-c08609e1469e",
                                "sense_id": "60fc9afd-6ed6-3863-95e9-8158cabad6ae",
                                "text": "Hij verscheen in een mooi beige pak, met daaronder een blauw overhemd, dat afstak bij zijn donkere haar en hem een ongelooflijk elegante uitstraling gaf."
                            }
                        ]
                    },
                    {
                        "sense_id": "320d01bd-f125-35e8-b8b9-1e8e31593db4",
                        "entry_id": "52af75f1-fca7-3e33-9e0d-11fd17582d4a",
                        "glosses": [
                            "in een tint geel met RAL-nummer 1001 ( )"
                        ],
                        "tags": [
                            "RAL-kleur"
                        ],
                        "examples": [
                            {
                                "example_id": "9e23826f-5b3a-4b9c-a014-2db976cdc26a",
                                "sense_id": "320d01bd-f125-35e8-b8b9-1e8e31593db4",
                                "text": "Hij rijdt in een beige auto."
                            },
                            {
                                "example_id": "0f5c9a88-566d-4537-aef9-268319e487c9",
                                "sense_id": "320d01bd-f125-35e8-b8b9-1e8e31593db4",
                                "text": "De zijkant was een egaal beige vlak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8977823-9233-400c-a594-26b727604d45",
                        "source_entry_id": "52af75f1-fca7-3e33-9e0d-11fd17582d4a",
                        "target_lang_word": "Beige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5264d4a1-6fb0-3bbe-8c41-7a8edacc6dcc",
                                        "entry_id": "7ecd81fe-e5a7-33fc-b019-2fa975fa03f5",
                                        "glosses": [
                                            "heller, gelbbrauner Farbton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e8eec02-9492-482f-9837-6e006fbfffaf",
                                                "sense_id": "5264d4a1-6fb0-3bbe-8c41-7a8edacc6dcc",
                                                "text": "Das Beige gefällt mir besser als das Graubraun."
                                            },
                                            {
                                                "example_id": "7216388a-2b25-4774-b8ac-bb135ba99929",
                                                "sense_id": "5264d4a1-6fb0-3bbe-8c41-7a8edacc6dcc",
                                                "text": "„Er trug ein Tweedjackett und eine Weste in Beige, seine dunklen Haare waren kurz und grau meliert, die Haut ein wenig dunkler als die seiner Frau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Beige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e2f4498-8ab9-37a5-bcaf-c53462e7e24c",
                                        "entry_id": "40f65ea9-5ebc-3da2-abc9-9b7380b7a69b",
                                        "glosses": [
                                            "übereinanderliegende, häufig gleichartige Gegenstände, aufgeschichteter Haufen beispielsweise von Holz, Papier oder Wäsche"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7dc6d09-92c3-4d4c-9ecc-382452a9528b",
                                                "sense_id": "7e2f4498-8ab9-37a5-bcaf-c53462e7e24c",
                                                "text": "„Auf dem Sofa, auf dem Schreibtisch, auf der Schreibmaschine, überall liegen kleine Beigen.“"
                                            },
                                            {
                                                "example_id": "b514fce6-b0e5-484b-a12a-3de41172e6a3",
                                                "sense_id": "7e2f4498-8ab9-37a5-bcaf-c53462e7e24c",
                                                "text": "„Wovon ich träume? Von einem Sofa in dämmrigem Raume. Links daneben Flaschen und Tabak, rechts Beigen von Reisebüchern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c94758e8-e3c6-40ef-a172-4ea5c4c1b8d9",
                        "source_entry_id": "52af75f1-fca7-3e33-9e0d-11fd17582d4a",
                        "target_lang_word": "beige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                        "entry_id": "684051d6-6af3-3e18-b209-bb23da8c4d99",
                                        "glosses": [
                                            "eine hellgelbbraune Farbe (RAL 1001) aufweisend, die der ungefärbter Wolle beziehungsweise der des Dünensandes gleicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7f2c58-0037-4225-b8ea-37e60483f1ff",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "Sie trug ein beiges Kleid, welches nicht dunkel genug war, um es als ockerfarben zu bezeichnen."
                                            },
                                            {
                                                "example_id": "98a37fd1-1892-4819-a38c-46c8d0fffdf7",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "Hast du ein beiges Näpfchen in deinem Farbkasten?"
                                            },
                                            {
                                                "example_id": "662d0bad-0116-483c-bc43-ab2553b2360f",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "„Sie trug also ein einfaches weißes Kleid und beige Schuhe, als sie im Kreis von Freunden und Journalisten auf eine gelöste und muntere Weise Gedanken äußerte.“"
                                            },
                                            {
                                                "example_id": "748050a6-7571-4fb7-be83-9cdbb46969bb",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "„Sie hatte nach der Schule ihre Feriengarderobe eingekauft, einen Rock aus beiger Baumwolle, Shorts aus dem gleichen Material, zwei weiße Blusen, drei Tops, zwei Sarongs und den besagten Bikini.“"
                                            },
                                            {
                                                "example_id": "e4ea396a-96f9-47a9-a811-73178237af86",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "„Sie ist etwas kleiner, hat blond gefärbte Haare und trägt ein beiges Kostüm und schwarze Stöckelschuhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
