                "translations": [
                    {
                        "translation_id": "3e84dd59-b276-41f6-aee1-0b98587379bf",
                        "source_entry_id": "a8fb9ea6-992c-34ff-9dfa-bece7e45c5cc",
                        "source_sense_id": "582c92fb-3f5d-3890-8c41-aa97d767daa3",
                        "source_sense_description": "Frucht aus der Familie der Strahlengriffelgewächse",
                        "target_lang_word": "kiwi fruit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiwi fruit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9344dd79-3f2c-3217-a5b4-8d0d962f304b",
                                        "entry_id": "2ce7da5c-a15d-3b84-b4fa-2136360695ae",
                                        "glosses": [
                                            "A Chinese gooseberry vine fruit, having a hairy brown skin and dark green (or in the case of the kiwi fruit gold, yellow) flesh with fine black seeds, almost always varieties of Actinidia deliciosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84defdcd-1cdd-4bcf-baf6-4420e176e900",
                                                "sense_id": "9344dd79-3f2c-3217-a5b4-8d0d962f304b",
                                                "text": "LOOKING FOR SOMETHING DIFFERENT? Unusual! Exotic! KIWI FRUITS · PRICKLY PEARS · POMEGRANATES"
                                            },
                                            {
                                                "example_id": "d6ff9741-de57-4afd-a794-7a8c67d24757",
                                                "sense_id": "9344dd79-3f2c-3217-a5b4-8d0d962f304b",
                                                "text": "Kiwi: Kiwi fruits are imported from New Zealand. Sometimes called Chinese gooseberries, these brown fuzzy-skinned fruits will be soft to the touch, like an avocado, when ripe. To serve this fruit, peel and slice."
                                            },
                                            {
                                                "example_id": "30612973-c871-48b4-9712-6982fd2e7fc1",
                                                "sense_id": "9344dd79-3f2c-3217-a5b4-8d0d962f304b",
                                                "text": "This particular program, he [Graham Kerr] told us, would be about the finest dish in the world—which turned out to be called Veal Cutlets Yerex. Natch. For this you apparently needed three kiwi fruits, but the idea infuriated him. “It’s not a kiwi fruit,” he told us. “That’s just the stupid, vulgar, idiotic, irresponsible name the New Zealand government has given it. It’s a Chinese gooseberry—obviously.”"
                                            },
                                            {
                                                "example_id": "6e68d168-50f1-4c5d-975f-e650d0692d3d",
                                                "sense_id": "9344dd79-3f2c-3217-a5b4-8d0d962f304b",
                                                "text": "Like you? You want me to see the world as you do? Pricks as bananas, twats as tacos, and tits as mangoes, kiwi fruits, and ten different kinds of melon?! At the aquarium, do you see fish? At the funhouse, do you have fun? Making love?—fruit salad!"
                                            },
                                            {
                                                "example_id": "78d39219-f1d7-4f15-8a57-1862cae21872",
                                                "sense_id": "9344dd79-3f2c-3217-a5b4-8d0d962f304b",
                                                "text": "A small bottle of sparkling Rhineland wine was the centrepiece; beside it was a large marzipan pastry topped with strawberries. Kiwi fruits, grapes and pears were set around it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
