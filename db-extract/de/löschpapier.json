                                    }
                                ]
                            },
                            {
                                "target_word": "bibuła",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "3bdcd933-3fcf-392a-841b-e62fe8cf6861",
                                        "entry_id": "bb6b5abc-14e3-3c0f-8151-9e637acd8a66",
