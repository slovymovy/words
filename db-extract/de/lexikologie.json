                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78bf4e57-280c-4bb4-8259-133e6cfb424a",
                                "sense_id": "e621e0c2-b7c3-3975-b297-9309fce93350",
                                "text": "Die Lexikologie ist eine eigene Disziplin der Linguistik, die sich mit der Erforschung des Wortschatzes der Sprache befasst. — La lexicologie est une discipline propre de la linguistique qui s’occupe de l’étude du vocabulaire de la langue."
                            }
                        ]
                    }
                ],
