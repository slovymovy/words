{
    "word_family": [
        "shriveling",
        "shrivelled"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54ef2115-f8ee-398e-b642-ec143e3723ef",
                    "sense_definition": "To become wrinkled or shrunken, often due to loss of moisture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His fingers began to <w>shrivel</w> after being in the bath for too long.",
                            "target_lang_translations": {
                                "zh": "他在浴缸里泡得太久，手指开始<w>起皱</w>了。"
                            }
                        },
                        {
                            "text": "The old apple started to <w>shrivel</w> on the kitchen counter.",
                            "target_lang_translations": {
                                "zh": "那颗老苹果在厨房台面上开始<w>起皱</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "wrinkle"
                    ],
                    "antonyms": [
                        "expand",
                        "swell"
                    ],
                    "common_phrases": [
                        "shrivel up"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因失去水分而变得皱缩或干瘪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "起皱",
                                "target_lang_sense_clarification": "指表面因失去水分而产生褶皱。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8510c73f-bbae-37d6-ba2b-b18cc9641dff",
                    "sense_definition": "To collapse inward or lose vitality, often due to heat or lack of water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neglected plant began to <w>shrivel</w> from a lack of water.",
                            "target_lang_translations": {
                                "zh": "那株被忽视的植物因缺水而开始<w>向内卷曲</w>。"
                            }
                        },
                        {
                            "text": "Extreme heat caused the delicate leaves to <w>shrivel</w> and turn brown.",
                            "target_lang_translations": {
                                "zh": "极端高温导致娇嫩的叶子<w>向内卷曲</w>并变褐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "droop"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因受热或缺水而枯萎、失去活力或向内收缩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "向内卷曲",
                                "target_lang_sense_clarification": "指物体因失去水分而向内收缩变形。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba70408e-267a-3692-8df7-cdc7060b6cbb",
                    "sense_definition": "To cause something to draw into wrinkles or shrink.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense summer sun <w>shrivelled</w> the garden leaves.",
                            "target_lang_translations": {
                                "zh": "强烈的夏日阳光把花园里的叶子晒得<w>弄皱</w>了。"
                            }
                        },
                        {
                            "text": "High temperatures can <w>shrivel</w> sensitive fabrics if not washed carefully.",
                            "target_lang_translations": {
                                "zh": "如果洗涤不当，高温会使敏感的织物<w>弄皱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wither"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物产生褶皱或收缩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄皱",
                                "target_lang_sense_clarification": "指人为或因外部因素导致某物表面产生褶皱。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}