                                        "glosses": [
                                            "Of, or pertaining to, Descartes, his mathematical methods, or his philosophy, especially with regard to its emphasis on logical analysis and its mechanistic interpretation of physical nature."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
