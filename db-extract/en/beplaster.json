                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba5510f-85ff-4ec4-a56c-465bbec42879",
                                                "sense_id": "96473e6c-42ee-363b-a2ee-23f9c94a6f19",
                                                "text": "„Die Artillerie bepflasterte die Musketierstellungen im Wäldchen unaufhörlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fddc3396-6d9e-329c-be78-abf1c9a3691a",
                                        "entry_id": "f6856ec2-e77e-3b7a-a4f8-e33f0a7fd80c",
                                        "glosses": [
                                            "eine Fläche, zum Beispiel eine Wand oder einen Tisch, mit gleichartigen Dingen bedecken"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac86fe64-8d66-454c-ba11-9e9c385f8d11",
                                                "sense_id": "fddc3396-6d9e-329c-be78-abf1c9a3691a",
                                                "text": "„»Auf die Presse kann ich verzichten«, sage ich mit einem Blick auf die mit Zeitungsausschnitten bepflasterte Wand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
