                "senses": [
                    {
                        "sense_id": "a6b92429-98c0-3e20-a78e-d6b4eb53bc83",
                        "entry_id": "2cbb0f0d-eed4-37ba-b01f-d3e7084da664",
                        "glosses": [
                            "Wiedergabe (auch auszugsweise) eines noch nicht veröffentlichten Textes in einem anderen Medium, zum Beispiel in einer Zeitung, einer Zeitschrift, einem anderen Buch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4216a2b-77d3-485b-ab7a-d849e99c0506",
                                "sense_id": "a6b92429-98c0-3e20-a78e-d6b4eb53bc83",
                                "text": "Der Spiegel bringt in mehreren Folgen einen Vorabdruck der demnächst erscheinenden Memoiren des Herrn X."
                            },
                            {
                                "example_id": "0abfffd7-c27a-4470-a31c-c3a7df83682d",
                                "sense_id": "a6b92429-98c0-3e20-a78e-d6b4eb53bc83",
                                "text": "„Der Vorabdruck erscheint vom 7. Dezember 1930 bis zum 29. Januar 1931 wiederum in der »Vossischen Zeitung«.“"
                            },
                            {
                                "example_id": "6e7d6adf-1609-42af-ae6f-d8df79ba1670",
                                "sense_id": "a6b92429-98c0-3e20-a78e-d6b4eb53bc83",
                                "text": "„Wieland wollte kein Periodikum für seine eigenen Belange und Interessen, seine literarischen und politischen Ansichten, einen Platz zum Vorabdruck seiner eigenen Werke etwa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
