                "senses": [
                    {
                        "sense_id": "618febb1-8987-3291-a952-2b26a0a34430",
                        "entry_id": "dc9be82e-a2b0-34e8-b229-bcc576de26dc",
                        "glosses": [
                            "Variante orthographique francisée de interviewer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "88d363d8-c6f2-4548-8b6e-e9e4d792f4f2",
                                "sense_id": "618febb1-8987-3291-a952-2b26a0a34430",
                                "text": "Il me dit que peut-être il m'interviouvrait [sic] ce soir, s'il avait le temps, que son style direct et imagé me serait une révélation."
                            },
                            {
                                "example_id": "a58d9cc7-78f3-438b-bcc4-f5a67acef83e",
                                "sense_id": "618febb1-8987-3291-a952-2b26a0a34430",
                                "text": "Guillaume Hanoteau m’avait envoyé l’interviouver pour Marie-Match, à l’hôtel Meurice, où elle était descendue avec son fiancé, de vingt ans son cadet, […]"
                            },
                            {
                                "example_id": "874e2084-550b-40fe-adb6-2b2bb626c92e",
                                "sense_id": "618febb1-8987-3291-a952-2b26a0a34430",
                                "text": "Afin de vous faire connaître d'un peu plus près les horlogers qui, demain, vont fabriquer nos merveilleux garde-temps, j'ai décidé d'interviouver un élève horloger."
                            }
                        ]
                    }
