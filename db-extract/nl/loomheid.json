        "nl-extract.jsonl": [
            {
                "entry_id": "b3578f37-04e3-3430-af2a-626fdaac54df",
                "word": "loomheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                        "entry_id": "b3578f37-04e3-3430-af2a-626fdaac54df",
                        "glosses": [
                            "het vermoeid, lui en loom zijn zowel geestelijk als lichamelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ec2852-96c0-4f62-9af7-2d5ffb2f89d7",
                                "sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                                "text": "De zon laat de loomheid indalen in elke vezel en porie; alle stress en spanning glijden uit mijn systeem. Zon, zee, wijn en tapas, meer heeft een mens blijkbaar niet nodig om te ontspannen."
                            },
                            {
                                "example_id": "9b438446-1cb6-41f0-a86e-18f377eec01f",
                                "sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                                "text": "Zorg dat je mee gaat met het seizoen: kruip uit je winterslaap, schud de loomheid van je af en zorg dat je in de volgende versnelling komt. Hoe eerder je dat doet, hoe meer je al gaat genieten. Zo ben jij straks helemaal klaar voor de zomer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b04e8eac-aa7c-4069-837f-a758d303ae4f",
                        "source_entry_id": "b3578f37-04e3-3430-af2a-626fdaac54df",
                        "source_sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                        "target_lang_word": "drowsiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drowsiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee0c17c-0755-3c16-8f79-ec04d380ba9f",
                                        "entry_id": "ce784192-b80b-38f0-be3f-2320b92cd441",
                                        "glosses": [
                                            "The state of being drowsy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e52b57-8a38-47c2-9d43-74e503e14351",
                                                "sense_id": "2ee0c17c-0755-3c16-8f79-ec04d380ba9f",
                                                "text": "And most neurologists are in the habit of prescribing antispasticity drugs like tizanidine and baclofen, which are oral and inexpensive, but which cause drowsiness and weaken every muscle in the body, not just the target ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28551b3d-8242-4d4d-9684-01ddba9c3730",
                        "source_entry_id": "b3578f37-04e3-3430-af2a-626fdaac54df",
                        "source_sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                        "target_lang_word": "lack of energy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4bc1db93-829a-418d-ad5b-5fbbbc83fa53",
                        "source_entry_id": "b3578f37-04e3-3430-af2a-626fdaac54df",
                        "source_sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                        "target_lang_word": "lethargy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lethargy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                        "entry_id": "83a913a1-ea0c-3ca8-b51f-94bcecfc1e37",
                                        "glosses": [
                                            "A state of extreme torpor, sopor or apathy, especially with lack of emotion, energy or enthusiasm; (loosely) sluggishness, laziness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09847e9d-5310-4c32-be3c-998f46402335",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "Europe lay then under a deep lethargy."
                                            },
                                            {
                                                "example_id": "0bddc281-e7dd-4bdd-b135-0939f5bad8bd",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "Gradually the darkened room seems to emerge from its shadows; familiar objects strike upon the senses—and memory is never so terribly distinct as on its first reviving from such momentary lethargy."
                                            },
                                            {
                                                "example_id": "d5a92cf5-106f-47c5-a3be-33801b2f6c57",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "As already indicated, timekeeping is very poor. Point-to-point times are not kept, even with a clear road, and whilst fast running has never been a feature of the route because of the large number of junctions and speed restrictions, this Sunday night lethargy is hard to explain."
                                            },
                                            {
                                                "example_id": "7913f083-46c4-4c3c-87a7-74e2190b5416",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "Yakovlev, one of the architects of the reforms put in place by Mikhail Gorbachev, says he too is \"amazed\" at the government's lethargy."
                                            },
                                            {
                                                "example_id": "8d9caa7d-d7df-41a5-8803-aad50f016181",
                                                "sense_id": "1669a976-17a4-3177-8afd-78720796edad",
                                                "text": "The increase in mining stocks helped the FTSE 100 shake off some earlier lethargy and close 9.8 points higher at 6270.8, despite the disappointment of unchanged UK interest rates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b890b37-b7aa-3c1b-a515-e4697c477c12",
                                        "entry_id": "83a913a1-ea0c-3ca8-b51f-94bcecfc1e37",
                                        "glosses": [
                                            "A condition characterized by extreme fatigue or drowsiness, deep unresponsiveness, or prolonged sleep patterns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb0b3d7-68bf-43a2-b6a5-84bc605dafb6",
                                                "sense_id": "1b890b37-b7aa-3c1b-a515-e4697c477c12",
                                                "text": "This Apoplexie is (as I take it) a kind of Lethargie, a sleeping of the blood, a horson Tingling."
                                            },
                                            {
                                                "example_id": "9a5e6113-f4d7-4ab4-b56c-0e6d87525d01",
                                                "sense_id": "1b890b37-b7aa-3c1b-a515-e4697c477c12",
                                                "text": "So in order to avoid unpleasant side effects like lethargy and sexual dysfunction, most recent trials also gave men testosterone supplements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
