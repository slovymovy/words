                "senses": [
                    {
                        "sense_id": "c2566de2-13d9-3cec-ac5c-faca028e1c12",
                        "entry_id": "753de2fa-658c-3db8-abe4-7018218dd7d6",
                        "glosses": [
                            "ehemalige Hauptstadt der Haute-Auvergne im Département Cantal in Südfrankreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de74cc20-293c-429b-8a9d-2fc01b592a2a",
                                "sense_id": "c2566de2-13d9-3cec-ac5c-faca028e1c12",
                                "text": "„Die 7. Etappe der Tour de France 2008 am 11. Juli war 159 Kilometer lang und verlief von Brioude nach Aurillac.“"
                            },
                            {
                                "example_id": "c89e3a56-85d1-4e8b-8326-539abd68a418",
                                "sense_id": "c2566de2-13d9-3cec-ac5c-faca028e1c12",
                                "text": "„Eine Linie der TER Auvergne-Rhône-Alpes, einer Regionalbahn der staatlichen SNCF, bedient die Strecke von Brive-la-Gaillarde nach Aurillac, die auch das Gebiet der Gemeinde ohne Haltepunkt durchquert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7ac2e29-00f0-473e-a3ef-f4b0992a2f1a",
                        "source_entry_id": "753de2fa-658c-3db8-abe4-7018218dd7d6",
