                    {
                        "sense_id": "cf7c444a-4fd3-3585-898b-5f2abd24219d",
                        "entry_id": "b16d6225-8256-3c45-9545-7f6cfad55c4a",
                        "glosses": [
                            "Type de filet fixe passif posé le soir au fond et retiré le lendemain."
                        ],
