                        "examples": [
                            {
                                "example_id": "b4db04ae-cfbf-42f7-a2b3-ce7ad21ea520",
                                "sense_id": "e3dce2ca-cad3-34e6-82a9-d1a135e917d5",
                                "text": "L'objet autorisé de la jouissance est ainsi rabaissé, « prostitutionnalisé », si j'ose ce néologisme, en opposition à l'objet aimé."
                            },
                            {
                                "example_id": "63b53f30-1214-4af2-8004-7d5993f4ddfa",
                                "sense_id": "e3dce2ca-cad3-34e6-82a9-d1a135e917d5",
                                "text": "Mais ici, chaque tableau pourrait être une chambre d'ébats très privés, qui “prostitutionnalise” la figure."
                            },
                            {
                                "example_id": "66a51d2a-f403-40c7-abfa-42cc08b0d881",
                                "sense_id": "e3dce2ca-cad3-34e6-82a9-d1a135e917d5",
                                "text": "La Journée internationale de la femme a pris les allures d'un business ces dernières années en Rdc. A en croire notre source, cette journée a été « dénaturalisée, commercialisée, voire prostitutionnalisée »."
                            }
                        ]
