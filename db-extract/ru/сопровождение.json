                                            "zusätzliche unterstützende Stimme in einer Melodie"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be223b60-7c4d-4806-9a67-8674a11b7ce0",
                                                "sense_id": "48062bae-930c-336d-980a-ed4997370f9e",
                                                "text": "Hätte Klaus Erika auf der Gitarre nicht begleitet, hätte sie ohne Begleitung singen müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5c313b3-7b86-3d1d-85e8-3ce47a53d82d",
                                        "entry_id": "a41076d8-e830-323d-a296-48e2e8ae48e1",
                                        "glosses": [
                                            "ein oder mehrere Personen, die mit jemandem mitgehen oder verreisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7602c8-3cdb-499c-a527-18808c7ace18",
                                                "sense_id": "f5c313b3-7b86-3d1d-85e8-3ce47a53d82d",
                                                "text": "Großvater reist am liebsten in Begleitung."
                                            },
                                            {
                                                "example_id": "82600800-d972-4676-9d8a-465efe0e0e42",
                                                "sense_id": "f5c313b3-7b86-3d1d-85e8-3ce47a53d82d",
                                                "text": "„Als Pierre den Kaiser sah, verliess er gerade in Begleitung zweier Kaufleute den Saal.“"
                                            },
                                            {
                                                "example_id": "4cd61190-e7c0-4945-853d-c686a316207c",
                                                "sense_id": "f5c313b3-7b86-3d1d-85e8-3ce47a53d82d",
                                                "text": "„Acht Tage später erschien er eine Stunde vor Mitternacht in Begleitung eines Abate wieder bei mir.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "03fcde14-943b-313b-89ab-f148cac3de6e",
                                        "entry_id": "a41076d8-e830-323d-a296-48e2e8ae48e1",
                                        "glosses": [
                                            "ein oder mehrere Personen, die auf jemanden aufpassen oder beschützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d03ad9-42d3-47fd-8ff8-ecfba355906e",
                                                "sense_id": "03fcde14-943b-313b-89ab-f148cac3de6e",
                                                "text": "„Lisa ist eine Begleitung und will nach Gomera und Müller ist allein, das schweißt uns zusammen.“"
                                            },
                                            {
                                                "example_id": "bb8614d5-b58b-4a47-a2fc-a8240f24d085",
                                                "sense_id": "03fcde14-943b-313b-89ab-f148cac3de6e",
                                                "text": "„Indem trat ein Sergeant ein, dem die Indianer in Begleitung zweier Milizen folgten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4be5c73e-0c65-4137-b775-eaafc682631e",
                        "source_entry_id": "20547845-0b61-3450-830f-138a9bb3860d",
                        "target_lang_word": "accompagnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accompagnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2dad32dd-5066-382c-a94a-8b31cbfc772a",
                                        "entry_id": "b50f4170-b745-3ed4-8300-67a200e21d76",
                                        "glosses": [
                                            "Action d’accompagner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e49bad83-8bff-4c05-9230-30fa2b12fb6b",
                                                "sense_id": "2dad32dd-5066-382c-a94a-8b31cbfc772a",
                                                "text": "En revanche, la définition de critères de complexité d’un parcours de soins interdit à une partie des usagers de bénéficier de l’accompagnement d’un case manager (mais pas du suivi de l’équipe de réhabilitation)."
                                            },
                                            {
                                                "example_id": "a60d0990-97fe-4223-8a1b-b31c9b32947a",
                                                "sense_id": "2dad32dd-5066-382c-a94a-8b31cbfc772a",
                                                "text": "On porta ce souverain au tombeau de ses ancêtres, et plusieurs princes furent désignés pour l’accompagnement du corps."
                                            },
                                            {
                                                "example_id": "0e46561d-14db-460c-b341-863a872a79dd",
                                                "sense_id": "2dad32dd-5066-382c-a94a-8b31cbfc772a",
                                                "text": "Le maréchal de France qui était nommé pour l’accompagnement de l’ambassadeur, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                                        "entry_id": "b50f4170-b745-3ed4-8300-67a200e21d76",
                                        "glosses": [
                                            "Mélodies ou parties secondaires qui servent à accompagner la mélodie principale d’un morceau de musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fe11e57-7b31-4bc1-a7b8-afc001966483",
                                                "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                                                "text": "L’accompagnement soutient la voix."
                                            },
                                            {
                                                "example_id": "b3408431-eb9e-41fb-8a79-c52606fda402",
                                                "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                                                "text": "Accompagnement de flûte, de violon."
                                            },
                                            {
                                                "example_id": "aa541203-f48f-483a-a423-7790f498a663",
                                                "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                                                "text": "Sonate pour le piano avec accompagnement de basse, de violon et d’alto."
                                            },
                                            {
                                                "example_id": "80685cf3-453d-4d4f-9d3c-72f8a694c7e4",
                                                "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                                                "text": "Cet accompagnement est bien écrit, est brillant, trop chargé, sans effet, insignifiant."
                                            },
                                            {
                                                "example_id": "29ed3094-a82f-4bf1-a73a-337b1f1ff1af",
                                                "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                                                "text": "Ces accompagnements sont d’une riche facture, d’une grande pauvreté."
                                            },
                                            {
                                                "example_id": "91630dfd-61c6-4557-a236-a8fd1d6476b2",
                                                "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                                                "text": "En ce qui concerne spécialement l'accompagnement, le piano, en raison du pouvoir qu'il a de faire entendre simultanément l'harmonie et la mélodie, rend de précieux services."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0402a79d-f8f2-3798-a53b-859549580a4f",
                                        "entry_id": "b50f4170-b745-3ed4-8300-67a200e21d76",
                                        "glosses": [
                                            "Ce qui accompagne : accessoire nécessaire de certaines choses, soit pour la commodité, soit pour l’ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457bbbd9-c06d-48af-a7d8-fec37fd2763e",
                                                "sense_id": "0402a79d-f8f2-3798-a53b-859549580a4f",
                                                "text": "La figure principale de ce tableau aurait besoin de quelques accompagnements."
                                            },
                                            {
                                                "example_id": "2a3b9d1b-9f50-4d2c-b1e1-2967580507b4",
                                                "sense_id": "0402a79d-f8f2-3798-a53b-859549580a4f",
                                                "text": "Le bonheur n’est pas toujours l’accompagnement de la vertu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f0348d3-71c3-3775-9c02-5e77b660192d",
                                        "entry_id": "b50f4170-b745-3ed4-8300-67a200e21d76",
                                        "glosses": [
                                            "Aliment qui accompagne le plat principal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28bc3563-deaa-4767-9878-e90dd7772f64",
                                                "sense_id": "2f0348d3-71c3-3775-9c02-5e77b660192d",
                                                "text": "Et en accompagnement du rôti, frites ou purée?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc3275a6-8749-38d7-9361-acc2b50b6092",
                                        "entry_id": "b50f4170-b745-3ed4-8300-67a200e21d76",
                                        "glosses": [
                                            "Ce qui est hors de l’écu, comme les supports, le cimier, les lambrequins, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9d830ef-beca-4e5d-b3c0-9b29538d3829",
                                                "sense_id": "dc3275a6-8749-38d7-9361-acc2b50b6092",
                                                "text": "Porter des armoiries sans aucun accompagnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da926bc-5b4a-3591-bdbd-9a90520c00fa",
                                        "entry_id": "b50f4170-b745-3ed4-8300-67a200e21d76",
                                        "glosses": [
                                            "Végétation ou arbres qui ne sont pas destinés à la production de bois, mais conservés pour leur effet sylvicole : aide à l’éducation des perches, ombrage, compression…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c836b0bd-0204-4135-8a4c-42f05476255c",
                                                "sense_id": "8da926bc-5b4a-3591-bdbd-9a90520c00fa",
                                                "text": "Des régénérations moins denses en chêne peuvent toutefois être suffisantes pour constituer un peuplement de qualité à condition que les semis soient régulièrement répartis dans une matrice d’essences d’accompagnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
