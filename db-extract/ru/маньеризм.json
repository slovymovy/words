                    },
                    {
                        "translation_id": "82fcd495-5dcb-4aab-a441-430d2fa581bf",
                        "source_entry_id": "2b46ce7b-66fb-3d02-a572-ab5ce66a1fef",
                        "source_sense_id": "6826049d-36ca-3561-93b8-c8b6619d369c",
                        "target_lang_word": "Manierismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manierismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "190ea4da-9d47-3067-a6bf-d83ac1b2d74e",
                                        "entry_id": "a2882b79-4dcd-3fa1-bfc5-206616cbe3c0",
                                        "glosses": [
                                            "Ein Stilbegriff für die Übergangszeit (ca. 1520 – 1600 n.Chr.) von der Renaissance zum Barock"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd0f7e9-afdf-41c2-89b2-006e618a15ff",
                                                "sense_id": "190ea4da-9d47-3067-a6bf-d83ac1b2d74e",
                                                "text": "Viele Kunsthistoriker verstehen den Manierismus als notwendige Zwischenphase im Übergang zum Barock."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2289098-b63e-3fc5-9727-e7720785b957",
                                        "entry_id": "a2882b79-4dcd-3fa1-bfc5-206616cbe3c0",
                                        "glosses": [
                                            "Endphase einer Kunstepoche, Kunst des Niedergangs, Niedergangskunst"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte allgemein"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1b7a5481-32b4-35a5-bf10-31842ad87843",
                                        "entry_id": "a2882b79-4dcd-3fa1-bfc5-206616cbe3c0",
                                        "glosses": [
                                            "gekünsteltes Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d87647ef-f201-4a46-bfd2-c8d35d2a6cfa",
                                                "sense_id": "1b7a5481-32b4-35a5-bf10-31842ad87843",
                                                "text": "„Luciens Manierismus nervte.“"
                                            },
                                            {
                                                "example_id": "4c09e403-206d-4086-8846-5c94bfc7b84c",
                                                "sense_id": "1b7a5481-32b4-35a5-bf10-31842ad87843",
                                                "text": "„Das mag zum Teil stimmen; aber manches ist doch, wie ich gestehen muß, bewußte Imitation und Übertreibung der stilkritischen Manierismen.“"
                                            },
                                            {
                                                "example_id": "0ec23876-3ba5-45ff-b253-e62774ffa1ca",
                                                "sense_id": "1b7a5481-32b4-35a5-bf10-31842ad87843",
                                                "text": "„Die Idee dazu hatte Oskar Jancke, geboren 1898, wohnhaft in Ammerland am Starnberger See, 1924 mit einer Arbeit über Thomas Mann promoviert, Spezialist für amüsante und treffsichere Glossen, in denen er sprachliche Manierismen aufs Korn nimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c49de7d-ddd5-4d2f-98d6-3acd86d3aecc",
                        "source_entry_id": "2b46ce7b-66fb-3d02-a572-ab5ce66a1fef",
                        "source_sense_id": "6826049d-36ca-3561-93b8-c8b6619d369c",
                        "target_lang_word": "maniërisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maniërisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "66fcca03-8c4e-3b58-aedc-9c716c5ba75b",
                                        "entry_id": "75e9bf43-1e99-3ef5-8916-30cf41e97e33",
                                        "glosses": [
                                            "stijlperiode in de Europese kunstgeschiedenis in vooral de tweede helft van de 16e eeuw, met als belangrijke voorbeelden Michelangelo en Rafaël in de schilderkunst en Petrarca en Dante in de dichtkunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09af77d-4436-46d3-9682-84d02a60a1b1",
                                                "sense_id": "66fcca03-8c4e-3b58-aedc-9c716c5ba75b",
                                                "text": "Het maniërisme kwam tot stand in de latere jaren van de Italiaanse Hoogrenaissance rond 1520, tot ongeveer 1580 in Italië. Later werd het vervangen door de barok."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f31bc7c-e8e5-3b21-96c9-295c49d76dff",
                                        "entry_id": "75e9bf43-1e99-3ef5-8916-30cf41e97e33",
                                        "glosses": [
                                            "gekunsteldheid (in een bep. kunststijl)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
