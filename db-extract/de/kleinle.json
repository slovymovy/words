                "senses": [
                    {
                        "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                        "entry_id": "af77051c-3595-319c-a14b-7de4dea081cb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9614a07b-5631-4a62-9d86-2e7892fd69c1",
                                "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                                "text": "Frau Kleinle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4f506e61-aa6d-4ef5-be79-60c97cbd14f7",
                                "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                                "text": "Herr Kleinle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "73bf55cd-76af-4f5b-b58d-f9f71d1bb9ea",
                                "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                                "text": "Die Kleinles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "27fcc154-cc4c-4770-97a8-208352dc730e",
                                "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                                "text": "Der Kleinle trägt nie die Schals, die die Kleinle ihm strickt."
                            },
                            {
                                "example_id": "bd2b9904-37a2-4997-b08c-3fc1129050cf",
                                "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kleinle kommt, geht der Herr Kleinle.“"
                            },
                            {
                                "example_id": "9666bd4a-373a-45fd-9a28-78b93d239f1a",
                                "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                                "text": "Kleinle kommt und geht."
                            },
                            {
                                "example_id": "cb371986-d8c9-42cc-a671-eaee00374ce4",
                                "sense_id": "371959c5-864a-3dea-a73d-06f75cd35f8d",
                                "text": "Kleinles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
