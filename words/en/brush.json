{
    "word_family": [
        "brushstroke",
        "brushwood",
        "brushwork",
        "hairbrush",
        "paintbrush",
        "toothbrush",
        "underbrush"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1ef999e-4b53-32fd-8670-169492b1f260",
                    "sense_definition": "To clean something using a brush.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>brush</w> your shoes to remove the dried mud before coming inside.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>почистить</w> обувь, чтобы удалить засохшую грязь перед тем, как зайти внутрь."
                            }
                        },
                        {
                            "text": "He used a small tool to <w>brush</w> the dust off the old book cover.",
                            "target_lang_translations": {
                                "ru": "Он использовал небольшой инструмент, чтобы <w>счистить</w> пыль со старой обложки книги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brush the dirt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистить что-либо с помощью щетки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "удалять грязь щеткой"
                            },
                            {
                                "target_lang_word": "почистить",
                                "target_lang_sense_clarification": "завершить процесс чистки"
                            },
                            {
                                "target_lang_word": "счищать",
                                "target_lang_sense_clarification": "удалять что-то с поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6bb259e-3e81-3f48-99d3-79601af731a3",
                    "sense_definition": "To clean one's teeth by brushing them.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't forget to <w>brush</w> your teeth for two minutes every morning and night.",
                            "target_lang_translations": {
                                "ru": "Не забывай <w>чистить</w> зубы по две минуты каждое утро и вечер."
                            }
                        },
                        {
                            "text": "The dentist told me that I need to <w>brush</w> more thoroughly to prevent cavities.",
                            "target_lang_translations": {
                                "ru": "Стоматолог сказал мне, что мне нужно <w>чистить</w> зубы более тщательно, чтобы предотвратить кариес."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brush your teeth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистить зубы щеткой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "о зубах"
                            },
                            {
                                "target_lang_word": "почистить",
                                "target_lang_sense_clarification": "о зубах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc51815-d9d6-39be-92bf-2fd23abf703a",
                    "sense_definition": "To untangle or arrange hair using a brush.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat in front of the mirror to <w>brush</w> her long hair before the party.",
                            "target_lang_translations": {
                                "ru": "Она села перед зеркалом, чтобы <w>причесать</w> свои длинные волосы перед вечеринкой."
                            }
                        },
                        {
                            "text": "It is much easier to <w>brush</w> your hair when it is completely dry.",
                            "target_lang_translations": {
                                "ru": "Намного проще <w>расчесывать</w> волосы, когда они полностью сухие."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brush your hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расчесывать или укладывать волосы с помощью щетки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причесывать",
                                "target_lang_sense_clarification": "волосы"
                            },
                            {
                                "target_lang_word": "расчесывать",
                                "target_lang_sense_clarification": "волосы щеткой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c42fc519-c80c-3406-ba0e-2fe288613807",
                    "sense_definition": "To apply a substance, such as paint or oil, onto a surface using a brush.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef began to <w>brush</w> the pastry with egg wash to make it golden.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар начал <w>смазывать</w> выпечку яичной смесью, чтобы она стала золотистой."
                            }
                        },
                        {
                            "text": "I am <w>brushing</w> the paint onto the walls to give the room a fresh look.",
                            "target_lang_translations": {
                                "ru": "Я <w>наношу</w> краску на стены, чтобы придать комнате свежий вид."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brush the paint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить вещество (краску, масло) на поверхность кистью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "наносить слой кистью"
                            },
                            {
                                "target_lang_word": "красить",
                                "target_lang_sense_clarification": "наносить краску кистью"
                            },
                            {
                                "target_lang_word": "наносить",
                                "target_lang_sense_clarification": "кистью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5c1b750-f9ef-3f66-ae08-8866a485c19c",
                    "sense_definition": "To remove something from a surface with a quick, sweeping motion of the hand or a brush.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>brushed</w> the flour off her clothes after she finished baking the bread.",
                            "target_lang_translations": {
                                "ru": "Она <w>смахнула</w> муку со своей одежды после того, как закончила печь хлеб."
                            }
                        },
                        {
                            "text": "He quickly <w>brushed</w> the crumbs from the table onto the floor.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>сметнул</w> крошки со стола на пол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brush it off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять что-либо с поверхности быстрым смахивающим движением руки или щетки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смахивать",
                                "target_lang_sense_clarification": "быстрым движением"
                            },
                            {
                                "target_lang_word": "стряхивать",
                                "target_lang_sense_clarification": "удалять крошки или пыль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8210d61-3d68-3a43-b0a0-f7d3b7ab0d2d",
                    "sense_definition": "To touch something lightly or move past it with a sweeping motion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall grass <w>brushed</w> against his legs as he walked through the field.",
                            "target_lang_translations": {
                                "ru": "Высокая трава <w>касалась</w> его ног, когда он шел по полю."
                            }
                        },
                        {
                            "text": "Her silk scarf <w>brushed</w> his skin as she walked past him in the hallway.",
                            "target_lang_translations": {
                                "ru": "Ее шелковый шарф <w>задел</w> его кожу, когда она прошла мимо него в коридоре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brush against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко касаться чего-либо или проходить мимо, задевая поверхность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задевать",
                                "target_lang_sense_clarification": "слегка касаться"
                            },
                            {
                                "target_lang_word": "касаться",
                                "target_lang_sense_clarification": "проходя мимо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "962f2508-87be-3061-b56d-a5f590073d7b",
                    "sense_definition": "An implement with bristles attached to a handle, used for cleaning, painting, or grooming.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a new <w>brush</w> because the bristles on this one are falling out.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новую <w>щетку</w>, потому что у этой выпадает щетина."
                            }
                        },
                        {
                            "text": "She dipped the <w>brush</w> into the blue paint and started her masterpiece.",
                            "target_lang_translations": {
                                "ru": "Она окунула <w>кисть</w> в синюю краску и начала свой шедевр."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hair brush",
                        "paint brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент со щетиной и ручкой для чистки, рисования или ухода за собой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щетка",
                                "target_lang_sense_clarification": "для чистки или волос"
                            },
                            {
                                "target_lang_word": "кисть",
                                "target_lang_sense_clarification": "для рисования"
                            },
                            {
                                "target_lang_word": "кисточка",
                                "target_lang_sense_clarification": "маленькая кисть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "407c1fb6-b90c-3ee1-8a3f-e08e837619e4",
                    "sense_definition": "The act of cleaning or smoothing something with a brush.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave her hair a quick <w>brush</w> before heading out the door.",
                            "target_lang_translations": {
                                "ru": "Она быстро <w>причесалась</w> перед тем, как выйти за дверь."
                            }
                        },
                        {
                            "text": "The jacket just needs a light <w>brush</w> to get rid of the lint.",
                            "target_lang_translations": {
                                "ru": "Куртку нужно просто слегка <w>почистить</w> щеткой, чтобы избавиться от ворса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по чистке или разглаживанию чего-либо щеткой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистка",
                                "target_lang_sense_clarification": "процесс использования щетки"
                            },
                            {
                                "target_lang_word": "расчесывание",
                                "target_lang_sense_clarification": "волос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0597fef4-1a02-34f0-adda-63b339a66b35",
                    "sense_definition": "Wild vegetation or shrubs, typically larger than grass but smaller than trees.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit disappeared into the thick <w>brush</w> to hide from the fox.",
                            "target_lang_translations": {
                                "ru": "Кролик исчез в густом <w>кустарнике</w>, чтобы спрятаться от лисы."
                            }
                        },
                        {
                            "text": "We had to clear away the dry <w>brush</w> around the house to prevent fires.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось убрать сухой <w>кустарник</w> вокруг дома, чтобы предотвратить пожары."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thick brush",
                        "dry brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дикая растительность, кустарники или подлесок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кустарник",
                                "target_lang_sense_clarification": "заросли"
                            },
                            {
                                "target_lang_word": "подлесок",
                                "target_lang_sense_clarification": "мелкая растительность в лесу"
                            },
                            {
                                "target_lang_word": "кусты",
                                "target_lang_sense_clarification": "дикая поросль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05778153-0fb1-3696-963d-dbf1aca1fe8d",
                    "sense_definition": "A brief and often unpleasant encounter or experience with something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain climber had a terrifying <w>brush</w> with death during the storm.",
                            "target_lang_translations": {
                                "ru": "У альпиниста было ужасающее <w>столкновение</w> со смертью во время шторма."
                            }
                        },
                        {
                            "text": "He has had several <w>brushes</w> with the law due to his reckless driving.",
                            "target_lang_translations": {
                                "ru": "У него было несколько <w>столкновений</w> с законом из-за его неосторожного вождения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brush with death",
                        "brush with the law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратковременное и часто неприятное столкновение или опыт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столкновение",
                                "target_lang_sense_clarification": "с законом или опасностью"
                            },
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "краткий конфликт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03b11550-e8fe-390f-a81c-49fcd6f854f4",
                    "sense_definition": "A digital tool in software that mimics the effect of a physical brush for drawing or painting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can download a new set of <w>brushes</w> for Photoshop to create watercolor effects.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать новый набор <w>кистей</w> для Photoshop, чтобы создавать акварельные эффекты."
                            }
                        },
                        {
                            "text": "I used a soft <w>brush</w> in the app to blend the colors of the sunset.",
                            "target_lang_translations": {
                                "ru": "Я использовал мягкую <w>кисть</w> в приложении, чтобы смешать цвета заката."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровой инструмент в ПО, имитирующий физическую кисть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кисть",
                                "target_lang_sense_clarification": "в графических редакторах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7112809c-3977-324a-bebf-5afb58daa8a6",
                    "sense_definition": "A conductive part, often made of carbon, that maintains electrical contact in a rotating machine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electric motor stopped working because the carbon <w>brush</w> had worn down.",
                            "target_lang_translations": {
                                "ru": "Электродвигатель перестал работать, потому что угольная <w>щетка</w> износилась."
                            }
                        },
                        {
                            "text": "He had to replace the <w>brushes</w> in the alternator to get the car started.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось заменить <w>щетки</w> в генераторе, чтобы завести машину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводящая деталь, обычно из углерода, обеспечивающая контакт в электрических машинах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щетка",
                                "target_lang_sense_clarification": "электротехническая деталь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f766db68-4cfd-30ce-8ab0-de0fe26cd554",
                    "sense_definition": "The thick, furry tail of certain animals, especially a fox.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter proudly displayed the fox's <w>brush</w> as a trophy of the hunt.",
                            "target_lang_translations": {
                                "ru": "Охотник с гордостью выставил лисий <w>хвост</w> как трофей охоты."
                            }
                        },
                        {
                            "text": "The fox waved its magnificent <w>brush</w> as it ran across the snowy field.",
                            "target_lang_translations": {
                                "ru": "Лиса махнула своей великолепной <w>трубой</w>, пробегая по заснеженному полю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fox brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Густой пушистый хвост некоторых животных, особенно лисы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "труба",
                                "target_lang_sense_clarification": "хвост лисы на охотничьем жаргоне"
                            },
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "пушистый хвост"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03036e06-9f97-332a-9a39-77d3a38bb521",
                    "sense_definition": "A luminous electrical discharge that resembles the bristles of a brush.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A faint <w>brush</w> of light appeared at the tip of the conductor during the experiment.",
                            "target_lang_translations": {
                                "ru": "Слабая <w>кисть</w> света появилась на кончике проводника во время эксперимента."
                            }
                        },
                        {
                            "text": "The sailor observed a glowing <w>brush</w> on the mast, known as a corposant.",
                            "target_lang_translations": {
                                "ru": "Моряк заметил светящийся <w>разряд</w> на мачте, известный как огни святого Эльма."
                            }
                        }
                    ],
                    "synonyms": [
                        "corposant"
                    ],
                    "common_phrases": [
                        "luminous brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светящийся электрический разряд, напоминающий щетину щетки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кисть",
                                "target_lang_sense_clarification": "электрический разряд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bd66e378-3622-3886-a775-21723b178124",
                    "sense_definition": "A common English surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Brush</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Браш</w>, которая пожертвовала землю."
                            }
                        },
                        {
                            "text": "Mr. <w>Brush</w> has been living in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Браш</w> живет в этом районе уже более сорока лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
