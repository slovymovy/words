                "senses": [
                    {
                        "sense_id": "7b505a23-ccc9-3e39-b3e2-2788f4c9e72d",
                        "entry_id": "a9542de4-38c2-38ad-a9dd-da3af36aed39",
                        "glosses": [
                            "Séparer ce qui était aggloméré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfb1728a-1fe4-4b1d-9daa-477616848cf5",
                                "sense_id": "7b505a23-ccc9-3e39-b3e2-2788f4c9e72d",
                                "text": "C’est à l’expérience de la guerre à dire s’il n’y a pas lieu de désagglomérer les canons et leurs équipages sur nos cuirassés."
                            },
                            {
                                "example_id": "8336308f-0dc8-4618-aa4e-0747907e1ab9",
                                "sense_id": "7b505a23-ccc9-3e39-b3e2-2788f4c9e72d",
                                "text": "Enfin, si l’écume stationnant ne se maintient pas tout à fait au centre, elle indique un temps variable, et si elle se rend vers un seul point au bord de la tasse sans se désagglomérer, ce sera une indication de pluie."
                            }
                        ]
                    }
