                        ],
                        "examples": [
                            {
                                "example_id": "c633ca39-9230-486a-852d-04336e085698",
                                "sense_id": "31d5130a-b85c-31e7-9304-b71a6291dc2d",
                                "text": "Comment admettre que Jouvet soit un haut fonctionnaire tsariste et que la gouille parisienne de Gabin s’apparente à l’inquiétude de l’âme russe ?"
                            },
                            {
                                "example_id": "74fccf85-4c01-444e-ada3-6111a4000522",
                                "sense_id": "31d5130a-b85c-31e7-9304-b71a6291dc2d",
                                "text": "Un concept qui a de la gouille. Ou bien plutôt de la gueule."
                            }
                        ]
                    }
