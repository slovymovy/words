                    "semantic_group_id": "group_smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hangt een vreemde <w>lucht</w> in de keuken sinds gisteren.",
                            "target_lang_translations": {
                                "en": "There has been a strange <w>smell</w> in the kitchen since yesterday.",
                                "ru": "Со вчерашнего дня в кухне стоит странный <w>запах</w>.",
                                "pl": "Od wczoraj w kuchni unosi się dziwny <w>zapach</w>.",
                                "de": "Seit gestern liegt ein seltsamer <w>Geruch</w> in der Küche.",
                                "fr": "Il y a une drôle d'<w>odeur</w> dans la cuisine depuis hier.",
                                "it": "C'è uno strano <w>odore</w> in cucina da ieri.",
                                "cs": "Od včerejška je v kuchyni cítit zvláštní <w>zápach</w>.",
                                "tr": "Dünden beri mutfakta garip bir <w>koku</w> var.",
                                "es": "Hay un <w>olor</w> extraño en la cocina desde ayer."
