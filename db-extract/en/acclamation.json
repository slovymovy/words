{
    "word": "acclamation",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                "word": "acclamation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6d752a51-d7c8-4220-96f2-b14d926fd39c",
                        "entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "acclamations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0596952d-da80-3e7e-86a8-97b37b5101c1",
                        "entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "glosses": [
                            "A shout of approbation, favor, or assent; eager expression of approval; loud applause."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "83e3c7d6-c474-4de3-b7c6-b19a21b2ce17",
                                "sense_id": "0596952d-da80-3e7e-86a8-97b37b5101c1",
                                "text": "Sometimes a member nominates a chairman and no vote is taken, the assembly signifying their approval by acclamation."
                            },
                            {
                                "example_id": "6f30a5e3-1678-41f1-ad52-39c2faf2627f",
                                "sense_id": "0596952d-da80-3e7e-86a8-97b37b5101c1",
                                "text": "On such a day, a holyday having been voted by acclamation, an ordinary walk would not satisfy the children:..it must be a scramble among the mountains, and I must accompany them; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "eded027f-4d49-36b3-8e1a-2622352cac9c",
                        "entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "glosses": [
                            "The act of winning an election to a post because there were no other candidates."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fccd6e3f-9ab7-4dce-9db3-01f717f6ee81",
                                "sense_id": "eded027f-4d49-36b3-8e1a-2622352cac9c",
                                "text": "See also: uncontested, by default"
                            },
                            {
                                "example_id": "6993e718-fe38-451f-b543-a560619c329b",
                                "sense_id": "eded027f-4d49-36b3-8e1a-2622352cac9c",
                                "text": "With no one running against her, she won by acclamation."
                            }
                        ]
                    },
                    {
                        "sense_id": "6355453a-a653-3828-8294-62af7140b837",
                        "entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "glosses": [
                            "A representation, in sculpture or on medals, of people expressing joy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8eb06f95-23c8-4656-9eb9-9d391afbd4ec",
                                "sense_id": "6355453a-a653-3828-8294-62af7140b837",
                                "text": "The medals on which laudatory acclamations are recorded are called by antiquaries acclamation medals."
                            }
                        ]
                    },
                    {
                        "sense_id": "d486879d-8475-3327-9d68-02d9ebb23382",
                        "entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "glosses": [
                            "An oral vote taken without formal ballot and with much fanfare; typically an overwhelmingly affirmative vote."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a20a54ef-9f25-4acd-b348-8d00f51fc2fc",
                        "source_entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "source_sense_description": "applause",
                        "target_lang_word": "gejuich",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gejuich",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "48aa6b6e-2c43-36aa-8792-2b0429a0d89b",
                                        "entry_id": "24f02a72-3c6b-3889-8b3c-2d6b90bacc71",
                                        "glosses": [
                                            "het aanhoudend juichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21db30ac-4b41-4e85-8121-78030eabd61c",
                                                "sense_id": "48aa6b6e-2c43-36aa-8792-2b0429a0d89b",
                                                "text": "Het gejuich van de supporters was werkelijk overweldigend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddcb181c-b867-4d26-b4d8-b1fda4e775ea",
                        "source_entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "source_sense_description": "applause",
                        "target_lang_word": "acclamatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acclamatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b01aa759-3266-3286-a7ef-93db88d6924f",
                                        "entry_id": "aa54ac00-76da-3bd0-bf6f-0871f81e62e4",
                                        "glosses": [
                                            "goedkeuring door applaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d62aef-a804-4042-a697-1c73facff1cd",
                                                "sense_id": "b01aa759-3266-3286-a7ef-93db88d6924f",
                                                "text": "Asscher was 31 en de veelbelovende PvdA-fractieleider in de Amsterdamse gemeenteraad. Iedereen ging ervan uit dat hij bij acclamatie gekozen zou worden tot lijsttrekker. Tot een kwartier voor de deadline, toen zich plots Miep van Diggelen meldde, oud-voorzitter van stadsdeel Geuzenveld en directeur van het Amsterdams Centrum Buitenlanders. „Ik vond dat de Amsterdamse PvdA te veel geloofde in één kandidaat”, vertelt Van Diggelen elf jaar later in haar appartement in Amsterdam Nieuw West, terwijl ze een shaggie draait. Grinnikend: ,,Het bestuur was niet verheugd over mijn kandidatuur.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a818965d-bea2-300f-92de-ee03b7860933",
                                        "entry_id": "aa54ac00-76da-3bd0-bf6f-0871f81e62e4",
                                        "glosses": [
                                            "in de liturgie: korte bevestiging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e79f5dde-cd8c-4761-9221-e33f0fa50158",
                                                "sense_id": "a818965d-bea2-300f-92de-ee03b7860933",
                                                "text": "Amen zeggen is een veel voorkomende liturgische acclamatie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1817b796-8dbb-4887-b4da-7ed549d4f9a4",
                        "source_entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "source_sense_description": "applause",
                        "target_lang_word": "acclamation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acclamation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efd53e86-16d7-3b1e-9887-57dc640b2fd5",
                                        "entry_id": "f49db4ae-b24a-37ae-9f0d-bca75ed43a07",
                                        "glosses": [
                                            "Cris de joie ou d’enthousiasme qu’excite une action ou une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a9869e6-def1-4bbc-a2fe-231de9d1219f",
                                                "sense_id": "efd53e86-16d7-3b1e-9887-57dc640b2fd5",
                                                "text": "De longues acclamations accueillirent le roi et la reine de la fête au moment où ils montèrent sur l’estrade qui leur était préparée."
                                            },
                                            {
                                                "example_id": "82103d78-7867-471f-8e6a-1e2abeaef501",
                                                "sense_id": "efd53e86-16d7-3b1e-9887-57dc640b2fd5",
                                                "text": "Et, vivement impressionné par la noblesse réelle du spectacle, je ne pus m’empêcher de mêler ma voix aux acclamations enthousiastes des croyants prosternés."
                                            },
                                            {
                                                "example_id": "fee971ab-15f8-4432-96df-69902907ecb0",
                                                "sense_id": "efd53e86-16d7-3b1e-9887-57dc640b2fd5",
                                                "text": "Hier les ovations des mineurs du Nord, aujourd’hui les acclamations des cultivateurs du Midi et des citoyens d’une ville, grande par son passé, […]."
                                            },
                                            {
                                                "example_id": "71835a23-6d84-418d-b116-3463cd7de8b3",
                                                "sense_id": "efd53e86-16d7-3b1e-9887-57dc640b2fd5",
                                                "text": "Et, tandis que la foule transportée hurlait ses acclamations, Ahmed Abdou entraîna Zariffa loin de cette bousculade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a88f47a-5115-3f9c-a301-a16bd1042dbb",
                                        "entry_id": "f49db4ae-b24a-37ae-9f0d-bca75ed43a07",
                                        "glosses": [
                                            "Cri unanime des membres d’une assemblée pour approuver, pour montrer leur choix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f816af53-f2aa-4d22-9dde-03c8039d57a8",
                                                "sense_id": "3a88f47a-5115-3f9c-a301-a16bd1042dbb",
                                                "text": "[…] : c’est ce qui explique le grand prestige qu’acquirent immédiatement sur de jeunes troupes, tant de sous-officiers de l’Ancien Régime que l’acclamation unanime des soldats porta aux premiers rangs, au début de la guerre."
                                            },
                                            {
                                                "example_id": "ad54f9be-92cb-4b53-9ddd-2bc28b4fc4c2",
                                                "sense_id": "3a88f47a-5115-3f9c-a301-a16bd1042dbb",
                                                "text": "De toutes parts s’élevaient les acclamations et les cris : « A Paris! » Ces vivats, ces enthousiasmes faisaient contraste avec la froideur, les réserves, les critiques, les refus d’obéissance des maréchaux comme Ney, Lefebvre, Oudinot, Mac-Donald qui, la veille, avaient déclaré à Napoléon qu’un projet de retour sur Paris était une folie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65fcd478-bd88-4b15-8eab-8466082c48ab",
                        "source_entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "source_sense_description": "applause",
                        "target_lang_word": "Zuruf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuruf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95e7072c-23d6-3b8c-a794-aed17bb68798",
                                        "entry_id": "2d8ec24b-263c-34ac-a698-2e42ced1f8b3",
                                        "glosses": [
                                            "Ruf, mit dem sich jemand an jemanden richtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d78b866e-b495-4f7c-8d8d-20e685203735",
                                                "sense_id": "95e7072c-23d6-3b8c-a794-aed17bb68798",
                                                "text": "„Immer heftiger wurden die anfeuernden Zurufe aus der Menge, die in leidenschaftliche Bewegung geraten war.“"
                                            },
                                            {
                                                "example_id": "e2ff8143-b5c2-4067-af14-1ddb3f2dc84e",
                                                "sense_id": "95e7072c-23d6-3b8c-a794-aed17bb68798",
                                                "text": "„Es ist Lampe, der diesen Zuruf halb an Hamann, der inzwischen wieder leidlich bei Kräften ist, und halb an sich selber richtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b23508a8-adac-40f7-b6c7-18b8d9be6233",
                        "source_entry_id": "353d1309-af2c-3b7e-aae9-a2535595a9ab",
                        "source_sense_description": "applause",
                        "target_lang_word": "Akklamation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akklamation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d77f995-6c8f-3c30-bc58-21a51383e7d2",
                                        "entry_id": "df096c77-3c10-3a20-bbe2-9084c8fcdf97",
                                        "glosses": [
                                            "Ausdruck für Applaus, Beifall, Dank"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfe9a052-6f8d-4d14-8e56-fc63a6c2902a",
                                                "sense_id": "9d77f995-6c8f-3c30-bc58-21a51383e7d2",
                                                "text": "Durch Akklamation zeigten sie ihre Zustimmung."
                                            },
                                            {
                                                "example_id": "df2258a9-8b8c-4386-b5cd-2d929318f9d1",
                                                "sense_id": "9d77f995-6c8f-3c30-bc58-21a51383e7d2",
                                                "text": "Bei Akademikern erfolgt Akklamation meist durch Klopfen auf den Tisch."
                                            },
                                            {
                                                "example_id": "9185b250-b712-42a7-8689-cd5d0d432e4c",
                                                "sense_id": "9d77f995-6c8f-3c30-bc58-21a51383e7d2",
                                                "text": "„Mein Bruder war durch Akklamation in die Akademie aufgenommen worden, nachdem er eines seiner Schlachtengemälde dort ausgestellt hatte, das den Beifall aller Kenner fand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e04a0d82-330c-3087-933d-023d89ac49bd",
                                        "entry_id": "df096c77-3c10-3a20-bbe2-9084c8fcdf97",
                                        "glosses": [
                                            "eine Form der Wahl, bei der per Zuruf oder Handzeichen angenommen oder abgelehnt wird"
                                        ],
                                        "tags": [
                                            "Politik und Recht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb53335-5b02-4d0d-8fd4-551f0fd2a674",
                                                "sense_id": "e04a0d82-330c-3087-933d-023d89ac49bd",
                                                "text": "Es gab nur einen Kandidaten; die Wahl erfolgte einfachheitshalber per Akklamation."
                                            },
                                            {
                                                "example_id": "90127c1a-80a8-47e6-91cd-e71a765c6128",
                                                "sense_id": "e04a0d82-330c-3087-933d-023d89ac49bd",
                                                "text": "„Schäfer, per Akklamation neuer Versammlungsleiter, stimmt dem zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
