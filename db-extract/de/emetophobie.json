                "senses": [
                    {
                        "sense_id": "2e4b73a2-7cb8-357f-8470-d3fd3395b141",
                        "entry_id": "7f89c63d-714c-347f-b413-836828f69e3c",
                        "glosses": [
                            "Angst vor dem Erbrechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e58c162-3ee8-48e9-9ed2-c73202b22603",
                                "sense_id": "2e4b73a2-7cb8-357f-8470-d3fd3395b141",
                                "text": "„Bei Laura löst ein traumatisches Erlebnis im Kindesalter die Emetophobie aus.“"
                            },
                            {
                                "example_id": "860894bc-fcd1-4601-86dc-3cf5f57a1a18",
                                "sense_id": "2e4b73a2-7cb8-357f-8470-d3fd3395b141",
                                "text": "„Zwar ekelt sich wohl jeder vorm Erbrechen, bei der Emetophobie sind Abscheu und Angst jedoch so groß, dass sie das Leben der Betroffenen beeinträchtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c10c580a-cadd-474f-bc28-642841ec1672",
                        "source_entry_id": "7f89c63d-714c-347f-b413-836828f69e3c",
                        "source_sense_id": "2e4b73a2-7cb8-357f-8470-d3fd3395b141",
                        "source_sense_description": "Psychologie: Angst vor dem Erbrechen",
                        "target_lang_word": "emetophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emetophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d9ba7f8-ef69-3177-a219-79bf0d73330d",
                                        "entry_id": "eb7a172c-1701-3562-b857-7556c68ba71b",
                                        "glosses": [
                                            "An inordinate fear of vomit or vomiting, especially in public."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5a4194f-d82b-4ce3-8b8a-8327abc4c754",
                                                "sense_id": "1d9ba7f8-ef69-3177-a219-79bf0d73330d",
                                                "text": "Faryl Zaklin, 38, of San Diego, California, is still overcoming a lifelong phobia that has given her numerous panic attacks; part of her recovery involved watching episodes of \"Jackass\" and \"Family Guy.\" She has emetophobia: fear of vomit."
                                            },
                                            {
                                                "example_id": "c80cfb88-6414-4f76-8a3d-22d756fc10a9",
                                                "sense_id": "1d9ba7f8-ef69-3177-a219-79bf0d73330d",
                                                "text": "Ignorant about vomiting before the incident, I was now terrified of it. I self-diagnosed myself with emetophobia – fear of vomiting."
                                            },
                                            {
                                                "example_id": "d50aea54-65a2-4109-b98e-9c66c6fcc2e5",
                                                "sense_id": "1d9ba7f8-ef69-3177-a219-79bf0d73330d",
                                                "text": "Not many people have heard of the condition emetophobia but I’ve lived with it for over 30 years and it was a worry when I was pregnant with my son, Hunter, last year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86c4982a-c105-4f13-ab4e-0e03d140b96c",
                        "source_entry_id": "7f89c63d-714c-347f-b413-836828f69e3c",
                        "source_sense_id": "2e4b73a2-7cb8-357f-8470-d3fd3395b141",
                        "source_sense_description": "Psychologie: Angst vor dem Erbrechen",
                        "target_lang_word": "émétophobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "émétophobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aeaa6652-f7f8-328e-80ac-f93b01f2b64c",
                                        "entry_id": "e1c4e95c-0050-38af-ac59-6dbc45ae86f3",
                                        "glosses": [
                                            "Phobie liée à la peur maladive et irraisonnée de vomir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c59f2e5-66a5-486a-b361-bbb2ff43d1da",
                                                "sense_id": "aeaa6652-f7f8-328e-80ac-f93b01f2b64c",
                                                "text": "On recense de très nombreux types de phobies dont l’agoraphobie, l’arachnophobie, la nosophobie, la phasmophobie, l’apiphobie, la cheimophobie, l’émétophobie, l’éreutophobie, l’hylophobie..."
                                            },
                                            {
                                                "example_id": "8eb24ee1-73e9-4d48-a248-ae4aae189781",
                                                "sense_id": "aeaa6652-f7f8-328e-80ac-f93b01f2b64c",
                                                "text": "Le terme émétophobie (vient du grec emein, vomir) il s’agit d’une phobie liée au dégoût maladif, incontrôlable et irraisonné du vomissement."
                                            },
                                            {
                                                "example_id": "3181ebc7-eafa-4a90-b173-aa9cd4fb48bb",
                                                "sense_id": "aeaa6652-f7f8-328e-80ac-f93b01f2b64c",
                                                "text": "D'après l'Institut national de la santé mentale (NIMH), 8,7% des Américains (19 millions de personnes, dont 2 fois plus de femmes que d'hommes) sont atteints en 2018 de « phobies spécifiques » comme la germophobie ou l’émétophobie, qui se manifestent par des crises d'anxiété incontrôlables […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
