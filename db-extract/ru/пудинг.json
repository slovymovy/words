                    }
                ],
                "translations": [
                    {
                        "translation_id": "f32960a6-51cd-4273-bc36-9265d0bc3f88",
                        "source_entry_id": "17931ef2-e328-37e0-972f-cadf859ecc9c",
                        "source_sense_id": "0197e69a-0a5c-3003-b15e-2a0bbcefcf6f",
                        "target_lang_word": "pudding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pudding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90205eef-1493-3902-9274-5b91c3a5208f",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "Any of various dishes, sweet or savoury, prepared by boiling or steaming, or from batter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da3ea48f-1b48-45c2-82ac-44c2cee32b29",
                                                "sense_id": "90205eef-1493-3902-9274-5b91c3a5208f",
                                                "text": "The dishes in this chapter represent a range of multiethnic savory custards and steamed puddings, including a few surprises like a chèvre popover pudding and a bread pudding with lettuce and cheese."
                                            },
                                            {
                                                "example_id": "87e5c3f9-1f1a-443c-94b6-d311b910ae8e",
                                                "sense_id": "90205eef-1493-3902-9274-5b91c3a5208f",
                                                "text": "Steamed and boiled puddings have formed the basic diet of country people in northern Europe for centuries. Early puddings consisted of the scoured stomach of a sheep or pig, stuffed with its own suet and offal, which has been thickened with oatmeal, and boiled in water or baked in the ashes of a fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae75be97-63dd-35bd-8a4b-c01c8ebaaff8",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "A type of cake or dessert cooked usually by boiling or steaming."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e4bc09-bed7-41ca-b138-6d898b049f45",
                                                "sense_id": "ae75be97-63dd-35bd-8a4b-c01c8ebaaff8",
                                                "text": "Steamed puddings, a favourite for winter, are both easy to make and delicious. Served with one of the sweet sauces (recipes 497 to 506) they make a filling and satisfying end to a meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b7597c-2089-3123-8a76-9a23822bec09",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "A type of dessert that has a texture similar to custard or mousse but using some kind of starch as the thickening agent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8685066-d19b-399e-9ccc-1f95291d2524",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "Dessert; the dessert course of a meal."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885073f7-8c55-49bf-8a42-13053002f673",
                                                "sense_id": "d8685066-d19b-399e-9ccc-1f95291d2524",
                                                "text": "We have apple pie for pudding today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e994c9cd-93b4-3746-8bc0-2d6b4c375fb8",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "A sausage made primarily from blood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b109ed52-617c-3a6c-aa74-6f9ff17999bc",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "An overweight person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dae6df57-1fb2-3189-96f4-04371c8ec9b9",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "A term of endearment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "endearing",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99dd1ad2-e2da-42cf-8caa-6067c61cc606",
                                                "sense_id": "dae6df57-1fb2-3189-96f4-04371c8ec9b9",
                                                "text": "\"How is my little pudding?\" Jehan nuzzles up to me and rests his little head on my shoulder, still chuckling […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1a08ae-008c-3eec-a455-dc0d53285fdf",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "Entrails."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4946f66-0cca-4a43-874e-de95a44e8a8a",
                                                "sense_id": "4b1a08ae-008c-3eec-a455-dc0d53285fdf",
                                                "text": "I pray God he may recover, though there is little hopes; as there is of Coll Halley, being shott throw the body; and of Capt. Urquhart of Burdyeyeards, being wounded in the belly, after being made prisoner, soe that his puddings hang out."
                                            },
                                            {
                                                "example_id": "6929ed0b-1680-4034-b084-0d7461e874d4",
                                                "sense_id": "4b1a08ae-008c-3eec-a455-dc0d53285fdf",
                                                "text": "PUDDINGS, the guts; I'll let out your puddings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecfe8e41-0daa-3891-8869-a15b776b62da",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
                                            "Any food or victuals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93ec1029-7b04-4c4c-b1f4-0ea0444663ef",
                                                "sense_id": "ecfe8e41-0daa-3891-8869-a15b776b62da",
                                                "text": "Eat your pudding, slave, and hold your tongue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a814204f-53e7-33cd-b8c1-9b318d666fec",
                                        "entry_id": "dffa51c1-61bc-3920-bc6c-767c92844c62",
                                        "glosses": [
