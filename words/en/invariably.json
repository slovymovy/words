                    "sense_definition": "In every instance or case; always without any change or exception.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>invariably</w> late for meetings.",
                            "target_lang_translations": {
                                "zh": "他开会<w>总是</w>迟到。",
                                "de": "Er kommt zu Besprechungen <w>ausnahmslos</w> zu spät."
                            }
                        },
                        {
                            "text": "The train is <w>invariably</w> on time, which makes it very reliable for commuters.",
                            "target_lang_translations": {
                                "zh": "这趟火车<w>总是</w>准时，这对通勤者来说非常可靠。",
                                "de": "Der Zug ist <w>stets</w> pünktlich, was ihn für Pendler sehr verlässlich macht."
                            }
                        }
                    ],
                    "synonyms": [
                        "invariously",
                        "uniformly"
                    ],
                    "common_phrases": [
                        "invariably late",
                        "invariably clean"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在任何情况下都如此，从无例外；总是。",
                        "de": "In jedem Fall oder bei jeder Gelegenheit; immer und ohne jede Ausnahme oder Veränderung."
                    },
                    "translations": {
