                        "entry_id": "6b4e947c-be3e-371b-928e-bb99f2c3dd5e",
                        "glosses": [
                            "Aggression, die gegen die eigene Person gerichtet ist und sich durch Verletzung des eigenen Körpers oder durch Selbstmord beziehungsweise Selbstmordversuche äußert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667b9938-01e2-4d7b-948f-4ae4b34506fb",
                                "sense_id": "360c13ee-5218-37cc-9119-545f6c920b80",
                                "text": "„In Sachen Autoaggression halten Frauen, besonders junge Mädchen, den traurigen Rekord. Sie verstümmeln sich wesentlich häufiger als Jungen und Männer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
