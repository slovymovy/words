                                "target_senses": [
                                    {
                                        "sense_id": "9f9a3616-8473-3cfe-b301-6581ae9c189b",
                                        "entry_id": "a03abbaa-b0a1-3e3b-89a3-02264a068885",
                                        "glosses": [
                                            "germanischer (meist böser) Naturgeist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486a2968-7f6d-48a4-a19b-8ba3ab6d0f7e",
                                                "sense_id": "9f9a3616-8473-3cfe-b301-6581ae9c189b",
                                                "text": "Jenseits dies Orts voll Zorn und Tränen ragt auf der Alb der Schattenwelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb620153-897e-3d5e-b20e-682381b6a112",
                                        "entry_id": "a03abbaa-b0a1-3e3b-89a3-02264a068885",
                                        "glosses": [
                                            "psychische Qual"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6afc3218-c55c-40e0-9371-0730346cab00",
                                                "sense_id": "bb620153-897e-3d5e-b20e-682381b6a112",
                                                "text": "„Am nächsten Tag ist der Alb von mir gewichen.“"
                                            },
                                            {
                                                "example_id": "4a214c5d-c86f-45ec-aa30-de7e5197691f",
                                                "sense_id": "bb620153-897e-3d5e-b20e-682381b6a112",
                                                "text": "„Ein Alb war es nicht, der sie so zittern ließ – sie hätte sich gewünscht, es wäre nur ein Traum gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8b53bd-db6d-3f30-a48d-39e59f60ae0b",
                                        "entry_id": "5adb51a4-4988-3122-b9ca-634a98b6f510",
                                        "glosses": [
                                            "Mittelgebirge aus der Jura-Formation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97521cea-6b0e-494e-a91b-1488ad2de906",
                                                "sense_id": "8c8b53bd-db6d-3f30-a48d-39e59f60ae0b",
                                                "text": "Kommt ein Bauer von der Alb in die Stadt …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77d9a96b-077f-30ff-bced-a6e52ac2c673",
                                        "entry_id": "5adb51a4-4988-3122-b9ca-634a98b6f510",
                                        "glosses": [
                                            "zwei Nebenflüsse des Rheins im Schwarzwald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e11bbbe-0e23-4f4d-9796-518a581abc97",
                                                "sense_id": "77d9a96b-077f-30ff-bced-a6e52ac2c673",
                                                "text": "Fahr mit mir die Alb hinunter!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
