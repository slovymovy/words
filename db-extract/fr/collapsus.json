        "fr-extract.jsonl": [
            {
                "entry_id": "afaf0589-f1df-30fe-b4d8-cea2834ac06d",
                "word": "collapsus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2dd764b5-f495-3dbc-ae5b-15d943dccbb4",
                        "entry_id": "afaf0589-f1df-30fe-b4d8-cea2834ac06d",
                        "glosses": [
                            "Malaise, chute rapide des forces, avec un affaiblissement du pouls, sans toutefois être une syncope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1cf346b-1a40-4781-b45a-1600f4b33e81",
                                "sense_id": "2dd764b5-f495-3dbc-ae5b-15d943dccbb4",
                                "text": "Un jour que j'étais chez eux, j'avais lu une lettre en cachette, il s'agissait d'une affaire où mon père, victime d'un collapsus, avait été transporté à l'hôpital en ambulance avec des douleurs aiguës dans la poitrine."
                            }
                        ]
                    },
                    {
                        "sense_id": "b63b51b7-28db-3edb-874a-d36933c661c0",
                        "entry_id": "afaf0589-f1df-30fe-b4d8-cea2834ac06d",
                        "glosses": [
                            "Affaissement d'un organe, par exemple le poumon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1744d744-9d18-4512-afdd-f179d8f88550",
                                "sense_id": "b63b51b7-28db-3edb-874a-d36933c661c0",
                                "text": "Le collapsus peut exister partout où les bronches capillaires sont obstruées, mais il a pour siège de prédilection la moitié postérieure du poumon."
                            },
                            {
                                "example_id": "8b60d6cb-b31d-4f93-93d9-b1e9733449b6",
                                "sense_id": "b63b51b7-28db-3edb-874a-d36933c661c0",
                                "text": "En effet, les anatomopathologistes décrivent dans les yeux glaucomateux de longue date un collapsus des espaces intertrabéculaires et du canal de Schelmm."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0bad085-16f6-32ef-8636-bec18b9dbfa8",
                        "entry_id": "afaf0589-f1df-30fe-b4d8-cea2834ac06d",
                        "glosses": [
                            "Effondrement de quelque chose de matériel ou d'immatériel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f37dddcb-4eec-4f21-888a-6ed41ad7f092",
                                "sense_id": "e0bad085-16f6-32ef-8636-bec18b9dbfa8",
                                "text": "Dans ce sens on peut considérer le collapsus boursier comme le premier signal de la crise et la cause immédiate de la dépression."
                            },
                            {
                                "example_id": "a29ce9a5-898d-4332-8b85-dc298846bdde",
                                "sense_id": "e0bad085-16f6-32ef-8636-bec18b9dbfa8",
                                "text": "… de la dernière partie du plancher-terrasse d'un bâtiment à usage d'école R.C. + E , il s'est produit le collapsus de cette partie dû à l'emploi d'un béton partiellement durci."
                            },
                            {
                                "example_id": "0a2c0242-4264-4a4b-b256-ed0e8ea9a7c7",
                                "sense_id": "e0bad085-16f6-32ef-8636-bec18b9dbfa8",
                                "text": "… il paraissait évident à Paul que l’ensemble du système allait s’effondrer dans un gigantesque collapsus, sans qu’on puisse jusqu’à présent en prévoir la date, ni les modalités — mais cette date pouvait être rapprochée, et les modalités violentes."
                            },
                            {
                                "example_id": "69b466fd-0592-4ebc-b1bd-b041362b0a71",
                                "sense_id": "e0bad085-16f6-32ef-8636-bec18b9dbfa8",
                                "text": "Symbole du grand collapsus moral du XXᵉ siècle, Auschwitz engloutissait 10 000 vies chaque jour."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
