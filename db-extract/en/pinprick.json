                                    {
                                        "sense_id": "0ad2db88-5ac7-3d45-849a-d5d80043898f",
                                        "entry_id": "1c06c0e3-2089-3280-b4e3-f9e0aec13b2b",
                                        "glosses": [
                                            "das Durchstoßen von Textil oder Haut mit einer Nadel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20efd509-4ac4-4411-810d-22b78ac2690b",
                                                "sense_id": "0ad2db88-5ac7-3d45-849a-d5d80043898f",
                                                "text": "Ein kleiner Nadelstich schützt vor Krankheiten wie Masern oder Röteln."
                                            },
                                            {
                                                "example_id": "445f2b54-adc1-4956-be9f-d941dc4503ec",
                                                "sense_id": "0ad2db88-5ac7-3d45-849a-d5d80043898f",
                                                "text": "Nur wenige Nadelstiche sind nötig, um einfache Nähte anzufertigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d8e303b-3e4e-3581-b9b9-0d4a5a9dc438",
                                        "entry_id": "1c06c0e3-2089-3280-b4e3-f9e0aec13b2b",
                                        "glosses": [
                                            "kleine Lufteinschlüsse unter Lack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37e96aa-a501-4327-a1fa-a9b6e462108f",
                                                "sense_id": "6d8e303b-3e4e-3581-b9b9-0d4a5a9dc438",
                                                "text": "Die Motorhaube war voller Nadelstiche, also musste der Azubi die Lackierung wiederholen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5f01d68a-da98-3b08-be03-378b43299ec8",
                                        "entry_id": "1c06c0e3-2089-3280-b4e3-f9e0aec13b2b",
                                        "glosses": [
                                            "eine Boshaftigkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299f35af-0246-44ff-8776-c9e4aea399e6",
                                                "sense_id": "5f01d68a-da98-3b08-be03-378b43299ec8",
                                                "text": "Immer wenn du den Toilettensitz absichtlich oben lässt, ist das ein kleiner Nadelstich für mich!"
                                            },
                                            {
                                                "example_id": "5b2a2b8e-5969-4dcd-8038-20a7778d1484",
                                                "sense_id": "5f01d68a-da98-3b08-be03-378b43299ec8",
                                                "text": "„Die Nadelstiche gegen die Nazibesatzer gingen weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9317a8ea-1ec0-4a78-9d39-65e1a3adfb9d",
                        "source_entry_id": "8c4b9d7b-8562-35c3-b24b-0a95895b0763",
