    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76e1a192-269b-30ac-b0c0-9939258691eb",
                    "sense_definition": "État d'un animal sauvage privé de liberté et maintenu dans un enclos, un zoo ou un refuge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "privation_liberte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet ours blanc a beaucoup de mal à s'adapter à la vie en <w>captivité</w>."
                        },
                        {
                            "text": "L'association cherche à relâcher les perroquets nés en <w>captivité</w> dans leur milieu naturel."
                        }
                    ],
                    "synonyms": [
                        "enfermement"
                    ],
                    "antonyms": [
                        "liberté"
                    ],
                    "common_phrases": [
                        "né en captivité",
                        "vivre en captivité"
                    ]
                },
                {
                    "sense_id": "b3aa2e36-f50e-33e4-9102-3eb3e3a47796",
                    "sense_definition": "Condition d'une personne privée de sa liberté d'aller et venir, retenue prisonnière ou asservie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "privation_liberte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'otage a enfin été libéré après trois longues années de <w>captivité</w> dans la jungle."
                        },
                        {
                            "text": "Les ravisseurs ont décidé de garder le diplomate en <w>captivité</w> jusqu'au versement de la rançon."
                        }
                    ],
                    "synonyms": [
                        "détention",
                        "emprisonnement",
                        "séquestration"
                    ],
                    "antonyms": [
                        "liberté"
                    ],
                    "common_phrases": [
                        "tenir en captivité",
                        "années de captivité"
                    ]
                },
                {
                    "sense_id": "de67cf28-d63c-3a54-ba90-c7be32b0daa8",
                    "sense_definition": "Situation d'un combattant retenu comme prisonnier de guerre pendant ou après un conflit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "privation_liberte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soldat a raconté les dures épreuves subies pendant sa <w>captivité</w> dans un camp ennemi."
                        },
                        {
                            "text": "Après la capitulation de l'armée, des milliers d'hommes ont connu une rude <w>captivité</w> loin de chez eux."
                        }
                    ],
                    "synonyms": [
                        "internement"
                    ],
                    "common_phrases": [
                        "camp de captivité"
                    ]
                },
                {
                    "sense_id": "c3abcda0-29de-39f8-b076-059593e349f6",
                    "sense_definition": "État d'une personne entièrement subjuguée, sous le charme ou sous l'emprise morale de quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il vivait dans une douce <w>captivité</w>, envoûté par le regard de la comédienne."
                        },
                        {
                            "text": "L'écrivain décrivait avec mélancolie la <w>captivité</w> amoureuse dans laquelle cette liaison passionnée l'enfermait."
                        }
                    ],
                    "synonyms": [
                        "asservissement",
                        "sujétion"
                    ],
                    "antonyms": [
                        "émancipation"
                    ]
                }
            ]
        }
    ]
