                ],
                "senses": [
                    {
                        "sense_id": "b069a7b5-16e7-3c2c-873d-38380b360a41",
                        "entry_id": "fa4bf967-6b1c-38a2-88df-314a81614a57",
                        "glosses": [
                            "Person oder Firma, die Leute als Arbeiter oder Angestellte einstellt, beschäftigt und ihnen dafür Geld bezahlt; Arbeitgeber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5b5dd2-c687-46d3-8796-870a419be84a",
                                "sense_id": "b069a7b5-16e7-3c2c-873d-38380b360a41",
                                "text": "„Rückmeldungen an den Dienstnehmer gibt es höchstens, wenn der Dienstgeber selbst einen Fehler oder Störungen bei der Aufgabenlösung festgestellt hat.“"
                            },
                            {
                                "example_id": "9a6e7682-84de-4c53-a867-b28299f03fd7",
                                "sense_id": "b069a7b5-16e7-3c2c-873d-38380b360a41",
                                "text": "„Ich schließe das auch daraus, dass es bei jeder Krankmeldung eines Beamten nicht vorgesehen ist, dem Dienstgeber eine Diagnose mitteilen zu müssen.“"
                            },
                            {
                                "example_id": "09c03df5-ec20-4630-b21f-45e2943cfbc4",
                                "sense_id": "b069a7b5-16e7-3c2c-873d-38380b360a41",
                                "text": "„Aus Angst vor Konsequenzen durch den Dienstgeber oder Kollegen hatte sich aber niemand getraut, etwas zu melden.“"
                            },
                            {
                                "example_id": "65ca0efa-024c-4543-95cb-0a1e34fbc680",
                                "sense_id": "b069a7b5-16e7-3c2c-873d-38380b360a41",
                                "text": "„Er war ein vierzigjähriger Mann, der zum Dank dafür, daß er sich um die Finanzen des Hauses kümmerte, hier wohnte und mit seinen Dienstgebern aß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
