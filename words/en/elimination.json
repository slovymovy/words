                },
                {
                    "sense_id": "afe84bf3-336c-3373-8063-29eb6b70dfb5",
                    "sense_definition": "The biological process of discharging waste products from the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kidneys play a vital role in the <w>elimination</w> of toxins from the blood.",
                            "target_lang_translations": {
                                "ru": "Почки играют жизненно важную роль в <w>выведении</w> токсинов из крови.",
                                "zh": "肾脏在从血液中<w>排出</w>毒素方面起着至关重要的作用。"
                            }
                        },
                        {
                            "text": "A balanced diet supports healthy digestion and bodily <w>elimination</w>.",
                            "target_lang_translations": {
                                "ru": "Сбалансированная диета способствует здоровому пищеварению и <w>очищению</w> организма.",
                                "zh": "均衡的饮食有助于健康的消化和身体的<w>排泄</w>。"
                            }
                        }
                    ],
                    "synonyms": [
