                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96efd4d4-a1df-45ea-91a1-4b942bad6226",
                                                "sense_id": "2185dbb5-f738-3914-be1d-c4094a81ca40",
                                                "text": "I wonder if she has the faintest idea of what an anointed scoundrel he is?"
                                            }
                                        ]
