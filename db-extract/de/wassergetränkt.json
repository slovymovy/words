                ],
                "senses": [
                    {
                        "sense_id": "6066d0ec-82ec-3946-9eec-fc04c4f3ae8a",
                        "entry_id": "aa20f460-b9b3-3cab-af1c-1c9fda7ef434",
                        "glosses": [
                            "mit Wasser vollgesogen, in Wasser getränkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5c9fd65-5fe1-4a1d-badc-c48f5d581037",
                                "sense_id": "6066d0ec-82ec-3946-9eec-fc04c4f3ae8a",
                                "text": "„So konnte ich Fallen aufbauen, wo er nicht rankam: auf schmalen Baumstämmen, in dichten Nessel- und Distelbüschen, auf kleinen wassergetränkten Inseln im Sumpf und in den Marschen.“"
                            },
                            {
                                "example_id": "d11d2bdf-fc97-4191-afc5-99bb055e869c",
                                "sense_id": "6066d0ec-82ec-3946-9eec-fc04c4f3ae8a",
                                "text": "„Nachmittags lag er, angefesselt wie ein Tobsüchtiger, im Bett; der Richter saß bei ihm, kühlte ihm mit einem wassergetränkten Lappen die Stirn und sprach leise auf ihn ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
