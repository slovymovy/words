                    "examples": [
                        {
                            "text": "Z jego wypowiedzi <w>wieje</w> pesymizmem i brakiem nadziei.",
                            "target_lang_translations": {
                                "en": "His statement <w>emanates</w> pessimism and a lack of hope.",
                                "ru": "От его высказываний <w>веет</w> пессимизмом и безнадёжностью.",
                                "nl": "Zijn uitspraken <w>ademen</w> pessimisme en hopeloosheid.",
                                "de": "Seine Aussagen <w>strahlen</w> Pessimismus und Hoffnungslosigkeit <w>aus</w>.",
                                "fr": "De ses propos <w>se dégage</w> du pessimisme et un manque d'espoir.",
                                "it": "Dalle sue parole <w>trasuda</w> pessimismo e disperazione.",
                                "cs": "Z jeho vyjádření <w>čiší</w> pesimismus a beznaděj.",
                                "tr": "Açıklamalarından karamsarlık ve umutsuzluk <w>esiyor</w>.",
                                "es": "Sus palabras <w>destilan</w> pesimismo y falta de esperanza.",
                                "zh": "他的言辞中<w>透露</w>着悲观与绝望。"
                            }
                        },
                        {
                            "text": "W starym zamku <w>wiało</w> grozą i tajemnicą.",
                            "target_lang_translations": {
                                "en": "The old castle <w>breathed</w> dread and mystery.",
                                "ru": "В старом замке <w>веяло</w> ужасом и тайной.",
                                "nl": "In het oude kasteel <w>hing</w> een sfeer van dreiging en mysterie.",
                                "de": "Im alten Schloss <w>herrschte</w> eine Atmosphäre des Grauens und Geheimnisses.",
                                "fr": "Dans le vieux château, il <w>régnait</w> une atmosphère d'effroi et de mystère.",
                                "it": "Nel vecchio castello <w>si respirava</w> terrore e mistero.",
                                "cs": "Ve starém hradě <w>dýchala</w> hrůza a tajemství.",
                                "tr": "Eski kalede korku ve gizem <w>kol geziyordu</w>.",
                                "es": "En el viejo castillo se <w>respiraba</w> terror y misterio.",
                                "zh": "古堡中<w>弥漫</w>着恐怖与神秘的气息。"
                            }
                        }
