                {
                    "sense_id": "c15dca40-e4df-3f03-82fe-10528912eb59",
                    "sense_definition": "Initialism of Immigration and Naturalization Service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organizations",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "He had an appointment with the <w>INS</w> regarding his visa status.",
                            "target_lang_translations": {
                                "ru": "У него была встреча в <w>Службе иммиграции и натурализации</w> по поводу его визового статуса.",
                                "tr": "Vize durumuyla ilgili olarak <w>Göç ve Vatandaşlık Hizmetleri</w> ile bir randevusu vardı."
                            }
                        },
                        {
                            "text": "The functions of the <w>INS</w> were transferred to the Department of Homeland Security in 2003.",
                            "target_lang_translations": {
                                "ru": "Функции <w>Службы иммиграции и натурализации</w> были переданы Министерству внутренней безопасности в 2003 году.",
                                "tr": "<w>INS</w>'in görevleri 2003 yılında İç Güvenlik Bakanlığına devredildi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "former agency"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"Immigration and Naturalization Service\" (Служба иммиграции и натурализации США).",
                        "tr": "ABD Göç ve Vatandaşlık Hizmetleri (\"Immigration and Naturalization Service\") kurumunun kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Служба иммиграции и натурализации",
                                "target_lang_sense_clarification": "организация США"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Göç ve Vatandaşlık Hizmetleri",
                                "target_lang_sense_clarification": "eski ABD kurumu"
                            },
                            {
                                "target_lang_word": "INS",
                                "target_lang_sense_clarification": "kurum kısaltması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25aaf7e7-b4be-3cc2-80b6-c349d514ee7d",
                    "sense_definition": "Initialism of Indian Naval Ship.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "titles",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "The <w>INS</w> Vikramaditya is a major aircraft carrier in the fleet.",
                            "target_lang_translations": {
                                "ru": "<w>Корабль ВМС Индии</w> \"Викрамадитья\" является основным авианосцем флота.",
                                "tr": "<w>INS</w> Vikramaditya, filodaki önemli bir uçak gemisidir."
                            }
                        },
                        {
                            "text": "They served aboard the <w>INS</w> Mysore for three years.",
                            "target_lang_translations": {
                                "ru": "Они прослужили на борту <w>корабля ВМС Индии</w> \"Майсур\" три года.",
