                                        "examples": [
                                            {
                                                "example_id": "41c6ac16-bdca-4990-9ebf-1e1d7425ee18",
                                                "sense_id": "bec02368-c85c-367d-af7c-65d9371eb614",
                                                "text": "All the foreigners who had served therein were entitled to homesteads, many lands were open to preëmption by foreigners…"
                                            },
                                            {
                                                "example_id": "92dbe096-41a9-45b4-827c-56617b82da8a",
                                                "sense_id": "bec02368-c85c-367d-af7c-65d9371eb614",
                                                "text": "No person can exercise the preëmption right who is already the owner of 320 acres of land."
                                            },
                                            {
                                                "example_id": "71ec889b-a137-48e5-9954-32d7ee4dad25",
                                                "sense_id": "bec02368-c85c-367d-af7c-65d9371eb614",
                                                "text": "“If you had two hundred dollars to pay on your preëmption you could borrow some.”"
                                            },
                                            {
                                                "example_id": "8e93c4c6-3c07-4bb6-978d-17a02208953e",
                                                "sense_id": "bec02368-c85c-367d-af7c-65d9371eb614",
                                                "text": "The hope was to preëmpt the preëmption of laws like Orange County’s."
                                            }
                                        ]
