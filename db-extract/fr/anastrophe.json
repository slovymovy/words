            {
                "entry_id": "17593349-1b1c-3f7d-a9d7-ac9467712763",
                "word": "anastrophe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c5c202c-8b8e-44f5-a7c9-a51281440627",
                        "entry_id": "17593349-1b1c-3f7d-a9d7-ac9467712763",
                        "tags": [
