                ],
                "translations": [
                    {
                        "translation_id": "4ab633c0-306e-4a3a-a4be-83d0ac60a40a",
                        "source_entry_id": "cb4895d2-dec5-3056-aa3d-9468351fad61",
                        "source_sense_id": "5819e7a3-440f-3393-8190-7a422260b317",
                        "target_lang_word": "depredator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depredator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2f748b-adaa-3012-a021-b56068599493",
                                        "entry_id": "1d60d829-e7f1-39c4-a2d5-5d7699b6d1c8",
                                        "glosses": [
                                            "One who depredates, or commits depredation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730e1f8c-f3c4-41e6-82af-b3fec4657566",
                                                "sense_id": "bb2f748b-adaa-3012-a021-b56068599493",
                                                "text": "An open heath, a close plantation, were alike subjects of his apprehension; and the whistle of a shepherd lad was instantly converted into the signal of a depredator."
                                            },
                                            {
                                                "example_id": "ecfbdf43-33f4-4ff1-8262-393b12c5c6ae",
                                                "sense_id": "bb2f748b-adaa-3012-a021-b56068599493",
                                                "text": "Orders were now given to fire on all depredators, royal or plebeian; and after a few shots had been discharged without producing any fatal effects, the thieves hid themselves amongst the rocks, and were merely seen peeping through the crevices."
                                            },
                                            {
                                                "example_id": "4871eb37-aefa-42c9-8d12-a87959ffbf0c",
                                                "sense_id": "bb2f748b-adaa-3012-a021-b56068599493",
                                                "text": "The sight of her old neighbourly depredator shivering at the door in tatters, the very oddity of his appeal, touched a soft spot in the spinster's heart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8da4eb2-7a48-4f41-9365-ea30684ec66e",
                        "source_entry_id": "cb4895d2-dec5-3056-aa3d-9468351fad61",
                        "source_sense_id": "5819e7a3-440f-3393-8190-7a422260b317",
                        "target_lang_word": "destroyer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destroyer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e3f3bda-d1e2-3853-aae5-1722f0fa0ebf",
                                        "entry_id": "136c4a48-05ba-32c7-be60-8dd21992ddf8",
                                        "glosses": [
                                            "That which destroys something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e755707a-7126-481e-96b5-5b94e3bed962",
                                                "sense_id": "4e3f3bda-d1e2-3853-aae5-1722f0fa0ebf",
                                                "text": "But it is as a destroyer of grasshoppers that the dickcissel excels."
                                            },
                                            {
                                                "example_id": "7a33d618-351f-4cc8-aaae-870e50a350ee",
                                                "sense_id": "4e3f3bda-d1e2-3853-aae5-1722f0fa0ebf",
                                                "text": "These temple destroyers, devotees of ravaging commercialism, seem to have a perfect contempt for Nature, and, instead of lifting their eyes to the God of the mountains, lift them to the Almighty Dollar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d33d782a-2dde-3109-8dc8-54df8203422a",
                                        "entry_id": "136c4a48-05ba-32c7-be60-8dd21992ddf8",
                                        "glosses": [
                                            "A small, fast warship with light gun armament, smaller than a cruiser, but bigger than a frigate."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ec855cc-5c42-3e4d-b51c-d86da9bfdb6e",
                                        "entry_id": "136c4a48-05ba-32c7-be60-8dd21992ddf8",
                                        "glosses": [
                                            "A larger warship with guided missile armament, usually intended for air defence or anti-ship roles. Often, but not always, larger than a frigate and smaller than a cruiser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc54b7cd-d98c-3abe-b208-065bff82c012",
                                        "entry_id": "136c4a48-05ba-32c7-be60-8dd21992ddf8",
                                        "glosses": [
                                            "A larger warship with guided missile armament, usually intended for air defence or anti-ship roles. Often, but not always, larger than a frigate and smaller than a cruiser.",
                                            "A starship of comparable role."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
