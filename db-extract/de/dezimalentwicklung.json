                "senses": [
                    {
                        "sense_id": "fae82aca-38a3-3229-bc5c-bbddb5ff6a94",
                        "entry_id": "f348c246-3c83-3a0d-ba9a-d9b8e2068da3",
                        "glosses": [
                            "Darstellung einer Zahl im Dezimalsystem, betrachtet als Resultat der schrittweisen Berechnung der endlich oder unendlich vielen Stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34f1e3c7-e854-4ebb-aa97-ce3e70cb3355",
                                "sense_id": "fae82aca-38a3-3229-bc5c-bbddb5ff6a94",
                                "text": "„Damit ist die Dezimalentwicklung reeller Zahlen nicht eindeutig.“"
                            },
                            {
                                "example_id": "e754eddf-25f5-428d-9687-2b3f1ed9364d",
                                "sense_id": "fae82aca-38a3-3229-bc5c-bbddb5ff6a94",
                                "text": "„Ganz so unerheblich ist die Frage nicht, ob endlich oder unendlich viele Nullen in der Dezimalentwicklung von π auftauchen.“"
                            },
                            {
                                "example_id": "35c314ba-d56f-4d2c-bfab-81e01a6b3268",
                                "sense_id": "fae82aca-38a3-3229-bc5c-bbddb5ff6a94",
                                "text": "„Dazu müsste man aber entweder die Stelle der Ziffernfolge 7777…7 der Länge k in der Dezimalentwicklung von π finden oder aber beweisen, dass es diese Folge von Ziffern nicht gibt.“"
                            },
                            {
                                "example_id": "7bf2d5b3-0c62-4eb1-b344-8b1028c32395",
                                "sense_id": "fae82aca-38a3-3229-bc5c-bbddb5ff6a94",
                                "text": "„Man kann sich jedoch leicht Dezimalentwicklungen ohne eine dieser Eigenschaften vorstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
