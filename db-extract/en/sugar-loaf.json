                        ]
                    },
                    {
                        "translation_id": "849e3b02-c48a-4bcf-ac72-e2ed5e7b9e50",
                        "source_entry_id": "892d828f-a6ed-3c23-9f7c-e43cf56b27c0",
                        "source_sense_description": "conical block of sugar",
                        "target_lang_word": "Zuckerhut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuckerhut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ac8be1-dbdb-3a89-80f2-b51a663e78c8",
                                        "entry_id": "a1eb4536-1c06-3ab4-b509-a607059129bf",
                                        "glosses": [
                                            "ein Klumpen Zucker, der in Kegelform gepresst wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7013e2a0-5daa-415f-be90-9c374a6e769d",
                                                "sense_id": "c9ac8be1-dbdb-3a89-80f2-b51a663e78c8",
                                                "text": "Für eine Feuerzangenbowle wird ein mit Alkohol getränkter Zuckerhut auf eine Feuerzange über einen Topf mit Rotwein und Gewürzen gelegt und angezündet."
                                            },
                                            {
                                                "example_id": "49fce51d-2443-44f6-9053-1d639ca50297",
                                                "sense_id": "c9ac8be1-dbdb-3a89-80f2-b51a663e78c8",
                                                "text": "bildlich: „Sogar die Tannenbäume im Wald sahen aus wie Zuckerhüte.“"
                                            },
                                            {
                                                "example_id": "9bb6d606-a737-47d5-b3b4-3edbe8a47775",
                                                "sense_id": "c9ac8be1-dbdb-3a89-80f2-b51a663e78c8",
                                                "text": "„Auf das Gefäß ist ein Siebboden – Feuerzange – zu legen und darauf ein Zuckerhut von ungefähr 250 Gramm zu setzen ([…]). […] Mit der Kelle wird der brennende Alkohol nach und nach über den Zuckerhut gegossen. Dieser schmilzt, karamelisiert und tropft in den erhitzten Rotwein. Ist mehr als die Hälfte des Zuckerhutes geschmolzen, muß das Getränk gut umgerührt und verkostet werden.“"
                                            },
                                            {
                                                "example_id": "1a97045f-76ec-44ea-a0af-cd0106af55d7",
                                                "sense_id": "c9ac8be1-dbdb-3a89-80f2-b51a663e78c8",
                                                "text": "„Als der Frost nahte, schützte er die Heckenrosen durch Tüten aus starkem, talggetränktem Papier, die mit Wachslicht verklebt waren; sie sahen aus, als schwebten Zuckerhüte auf Stäben in der Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zuckerhut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a6ef985-aa85-31f1-8117-8b6d2e4527f4",
                                        "entry_id": "98e8c024-6b59-3451-8dbf-37b23b594e05",
                                        "glosses": [
                                            "396 Meter hoher, steilwandiger, felsiger Berg auf der zur Guanabara-Bucht gehörenden Halbinsel Urca der brasilianischen Stadt Rio de Janeiro und eines ihrer bekanntesten Wahrzeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e11570b-3510-499c-9c42-a6c01afef252",
                                                "sense_id": "2a6ef985-aa85-31f1-8117-8b6d2e4527f4",
                                                "text": "Der Zuckerhut ist ein Wahrzeichen von Rio de Janeiro."
                                            },
                                            {
                                                "example_id": "3b49e945-6435-4274-884e-793d1fdde840",
                                                "sense_id": "2a6ef985-aa85-31f1-8117-8b6d2e4527f4",
                                                "text": "„Morgens waren wir endlich ſo glücklich, die vor Rio de Janeiro gelegenen Gebirge zu erblicken, unter welchen wir auch ſogleich den Zuckerhut herausfanden. […] Gleich am Eingange dieſer Bucht liegen mehrere Bergkegel, die ſich theils, gleich dem Zuckerhute, einzeln aus der See erheben, theils am Fuße mit andern zusammenhängen und beinah’ unbeſteigbar ſind^([…]).“"
                                            },
                                            {
                                                "example_id": "8cdb770a-554b-4884-90d4-bf42fd2880ca",
                                                "sense_id": "2a6ef985-aa85-31f1-8117-8b6d2e4527f4",
                                                "text": "„Die Guanabara-Bucht, in der sich auch ein Naturschutzgebiet mit Mangrovenwäldern und Brut- und Laichplätzen für Vögel und Fische befindet, mündet am Fuss des Zuckerhuts durch einen Flaschenhals in den Atlantik.“"
                                            },
                                            {
                                                "example_id": "7b7a33ca-9595-4891-a5e3-aced9a5ab7da",
                                                "sense_id": "2a6ef985-aa85-31f1-8117-8b6d2e4527f4",
                                                "text": "„Vom Zuckerhut bis zu unserer Insel blieb das Wetter drei Wochen mild und wurde vor Tristan da Cunha sogar vollkommen windstill; sie segelten unter einer nie aufreißenden Wolkenschicht, die gleichsam getragen schien vom Plateau des Inselberges, der wie eine Säule aus dem Meer ragte, mehr breit als hoch.“"
                                            },
                                            {
                                                "example_id": "2e59eac6-a28f-40fd-9ae0-db91c67e6489",
                                                "sense_id": "2a6ef985-aa85-31f1-8117-8b6d2e4527f4",
                                                "text": "„Als Kevin Kuranyi vor 18 Jahren beim FC Serrano Metropolis in Brasilien mit dem Fußballspielen begann, da ahnte er mit Sicherheit noch nicht, daß er im Halbfinale des Konföderationen-Pokals 2005 gegen sein Geburtsland antreten würde. Weil seine aus Panama stammende Mutter und sein deutscher Vater aus beruflichen Gründen in Rio de Janeiro lebten, verbrachte er die ersten 15 Lebensjahre am Fuße des Zuckerhutes.“"
                                            },
                                            {
                                                "example_id": "a87e007c-5797-4b0c-8751-98b1d83193af",
                                                "sense_id": "2a6ef985-aa85-31f1-8117-8b6d2e4527f4",
                                                "text": "„Um die touristischen Muss-Orte Copacabana und Ipanema, den Zuckerhut und die Christus-Statue auf dem Corcovado kommt kein Rio-Novize herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
