                "senses": [
                    {
                        "sense_id": "59707a52-7c8b-3d6d-a215-9c35049bc898",
                        "entry_id": "e6a39349-bda9-3a30-9693-3a68b3177e77",
                        "glosses": [
                            "Rendre baba."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "db819fa4-88f0-49fc-accb-2de3df571217",
                                "sense_id": "59707a52-7c8b-3d6d-a215-9c35049bc898",
                                "text": "La foule était si babafiée par l’exploit de l'épouse du pharmacien que chacun la regarda, médusé."
                            },
                            {
                                "example_id": "b64cb12f-15b6-4cee-80d6-0aa2804a35f9",
                                "sense_id": "59707a52-7c8b-3d6d-a215-9c35049bc898",
                                "text": "Au vu de ces courts extraits, difficile de dire si l'Atlas 5 lance tout le vaisseau (ce qui pourrait effectivement babafier le public américain s'il est plus au fait du spatial que les européens) ou bien si on ne lance que l'équipage qui rejoint le vaisseau déjà en orbite."
                            },
                            {
                                "example_id": "068f0259-d72b-4f14-8656-ce4aaa1e1a87",
                                "sense_id": "59707a52-7c8b-3d6d-a215-9c35049bc898",
                                "text": "En tout cas, quand mon homme est rentré du travail hier soir, il a été babafié !"
                            }
                        ]
                    }
