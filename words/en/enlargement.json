{
    "word_family": [
        "enlarge",
        "enlarger",
        "large"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "890e8a75-bcd3-3199-93a9-57985bd4b027",
                    "sense_definition": "The act or process of making something larger in size, scope, or scale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company announced a significant <w>enlargement</w> of its production facilities to meet the growing demand.",
                            "target_lang_translations": {
                                "ru": "Компания объявила о значительном <w>расширении</w> своих производственных мощностей, чтобы удовлетворить растущий спрос."
                            }
                        },
                        {
                            "text": "The <w>enlargement</w> of the European Union has brought many economic benefits to the member states.",
                            "target_lang_translations": {
                                "ru": "<w>Расширение</w> Европейского Союза принесло много экономических выгод государствам-членам."
                            }
                        }
                    ],
                    "synonyms": [
                        "expansion",
                        "extension",
                        "increase",
                        "growth"
                    ],
                    "antonyms": [
                        "reduction",
                        "contraction",
                        "shrinkage"
                    ],
                    "common_phrases": [
                        "enlargement of the heart",
                        "further enlargement",
                        "proposed enlargement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс увеличения чего-либо в размере, масштабе или объеме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличение",
                                "target_lang_sense_clarification": "общий термин для роста размера или объема"
                            },
                            {
                                "target_lang_word": "расширение",
                                "target_lang_sense_clarification": "увеличение площади, охвата или состава"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a368e524-a47f-3628-be31-4d47100cc2a4",
                    "sense_definition": "A photograph or image that has been printed in a larger size than the original negative or digital file.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a high-quality <w>enlargement</w> of the family portrait to hang above the fireplace.",
                            "target_lang_translations": {
                                "ru": "Она заказала качественное <w>увеличение</w> семейного портрета, чтобы повесить его над камином."
                            }
                        },
                        {
                            "text": "The photographer made a photo <w>enlargement</w> so that the fine details of the landscape were visible.",
                            "target_lang_translations": {
                                "ru": "Фотограф сделал <w>увеличенный снимок</w>, чтобы были видны мельчайшие детали пейзажа."
                            }
                        }
                    ],
                    "synonyms": [
                        "blowup",
                        "print"
                    ],
                    "common_phrases": [
                        "photo enlargement",
                        "digital enlargement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фотография или изображение, напечатанное в большем размере, чем оригинал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличенный снимок",
                                "target_lang_sense_clarification": "фотография большего формата"
                            },
                            {
                                "target_lang_word": "увеличение",
                                "target_lang_sense_clarification": "процесс или результат создания крупного фото"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c03dc28-89bc-360d-832c-679ed77303bd",
                    "sense_definition": "The act of making a situation, feeling, or problem more serious or obvious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant arguing led to an <w>enlargement</w> of the tension between the two business partners.",
                            "target_lang_translations": {
                                "ru": "Постоянные споры привели к <w>усилению</w> напряженности между двумя деловыми партнерами."
                            }
                        },
                        {
                            "text": "The <w>enlargement</w> of her husband's absence from hours to days caused her a slight feeling of surprise.",
                            "target_lang_translations": {
                                "ru": "То, что отсутствие мужа <w>растянулось</w> с часов до нескольких дней, вызвало у нее легкое чувство удивления."
                            }
                        }
                    ],
                    "synonyms": [
                        "exacerbation",
                        "intensification",
                        "aggravation"
                    ],
                    "antonyms": [
                        "alleviation",
                        "mitigation"
                    ],
                    "common_phrases": [
                        "enlargement of the problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, делающее ситуацию, чувство или проблему более серьезной или очевидной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиление",
                                "target_lang_sense_clarification": "рост интенсивности чувства или проблемы"
                            },
                            {
                                "target_lang_word": "обострение",
                                "target_lang_sense_clarification": "ухудшение ситуации или конфликта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b9d621-f628-3681-8646-b8736d3db862",
                    "sense_definition": "The quality of being long-winded or detailed in speech or writing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor's <w>enlargement</w> on the topic made the lecture much longer than originally planned.",
                            "target_lang_translations": {
                                "ru": "<w>Пространные рассуждения</w> профессора по теме сделали лекцию гораздо длиннее, чем планировалось изначально."
                            }
                        },
                        {
                            "text": "A discourse generally consists of prefatory remarks followed by an <w>enlargement</w> upon the main subject.",
                            "target_lang_translations": {
                                "ru": "Рассуждение обычно состоит из вступительных замечаний, за которыми следует <w>подробное изложение</w> основной темы."
                            }
                        }
                    ],
                    "synonyms": [
                        "diffuseness",
                        "elaboration",
                        "expatiation"
                    ],
                    "antonyms": [
                        "brevity",
                        "conciseness"
                    ],
                    "common_phrases": [
                        "enlargement upon a subject"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть многословным или детальным в речи или письме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пространность",
                                "target_lang_sense_clarification": "подробное и долгое изложение"
                            },
                            {
                                "target_lang_word": "детализация",
                                "target_lang_sense_clarification": "подробное развитие темы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a9093e6-6d4d-3f93-87d0-0eda2555ddee",
                    "sense_definition": "The state of being set free from confinement or imprisonment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner waited anxiously for the day of his <w>enlargement</w> from the dark cell.",
                            "target_lang_translations": {
                                "ru": "Узник с тревогой ждал дня своего <w>освобождения</w> из темной камеры."
                            }
                        },
                        {
                            "text": "Take this key and give <w>enlargement</w> to the prisoner immediately.",
                            "target_lang_translations": {
                                "ru": "Возьми этот ключ и немедленно <w>даруй свободу</w> узнику."
                            }
                        }
                    ],
                    "synonyms": [
                        "liberation",
                        "release",
                        "freedom"
                    ],
                    "antonyms": [
                        "confinement",
                        "imprisonment",
                        "incarceration"
                    ],
                    "common_phrases": [
                        "give enlargement"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние освобождения из-под стражи или заключения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "выход на свободу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}