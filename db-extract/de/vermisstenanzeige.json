                "senses": [
                    {
                        "sense_id": "e0232673-7ccd-3f33-86be-57daad0c0419",
                        "entry_id": "6fe822b8-f2e2-3463-af7a-4177f7cd4e0f",
                        "glosses": [
                            "Meldung bei der Polizei, dass eine Person vermisst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41654011-be96-4df4-8984-201f58b33c8d",
                                "sense_id": "e0232673-7ccd-3f33-86be-57daad0c0419",
                                "text": "Obwohl ihre Tochter schon seit einer Woche verschwunden war, gaben die Eltern keine Vermisstenanzeige bei der Polizei auf."
                            },
                            {
                                "example_id": "ed4a1779-a732-4231-9e05-8d2ee517858f",
                                "sense_id": "e0232673-7ccd-3f33-86be-57daad0c0419",
                                "text": "Auch wenn viele Vermisste oft schnell zurückkehren, muss die Polizei jede Vermisstenanzeige ernst nehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
