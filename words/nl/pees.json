                },
                {
                    "sense_id": "2a478a8d-4656-3058-a8bf-acac1cb8a25b",
                    "sense_definition": "Gebiedende wijs van <w>pezen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pees</w> eens even door, we hebben haast!",
                            "target_lang_translations": {
                                "en": "<w>Hustle</w> a bit, we are in a hurry!"
                            }
                        },
                        {
                            "text": "<w>Pees</w> wat harder als je dit op tijd wilt afmaken.",
                            "target_lang_translations": {
                                "en": "<w>Hustle</w> a bit harder if you want to finish this on time."
                            }
