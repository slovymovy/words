                        "entry_id": "bc25dbd1-aa8d-3589-a9c7-fac43df6a082",
                        "glosses": [
                            "An extragalactic object, starlike in appearance, that is among the most luminous and (putatively) the most distant objects in the universe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
