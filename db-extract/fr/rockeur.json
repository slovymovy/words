                ],
                "senses": [
                    {
                        "sense_id": "2bf6d88d-49a0-34fe-ae44-96808e53b020",
                        "entry_id": "41ee4494-347f-3e17-9ba9-71783b7d60ce",
                        "glosses": [
                            "Musicien qui joue ou chante du rock and roll (né dans les années 1950), le plus souvent appelé simplement rock depuis les années 1960."
                        ],
                        "tags": [
                            "Rock"
                        ],
                        "examples": [
                            {
                                "example_id": "3bbcc5ed-3c5e-4198-a809-19f09c02ba28",
                                "sense_id": "2bf6d88d-49a0-34fe-ae44-96808e53b020",
                                "text": "La fille du rockeur avait la télécommande du portail et elle se gara dans le parking intérieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3577354-3477-4d1f-8b80-93c9289b7f0b",
                        "source_entry_id": "41ee4494-347f-3e17-9ba9-71783b7d60ce",
                        "source_sense_id": "2bf6d88d-49a0-34fe-ae44-96808e53b020",
                        "target_lang_word": "rocker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rocker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf0639d-bdc0-3e5e-a713-9ad0359ac696",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "A curved piece of wood attached to the bottom of a rocking chair or cradle that enables it to rock back and forth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6b05707-6bc6-4230-b2d8-ebba14dd311b",
                                                "sense_id": "bdf0639d-bdc0-3e5e-a713-9ad0359ac696",
                                                "text": "The cradle-rockers had done hard duty for so many years, under the weight of so many children, on that flagstone floor, that they were worn nearly flat, in consequence of which a huge jerk accompanied each swing of the cot, flinging the baby from side to side like a weaver's shuttle, as Mrs Durbeyfield, excited by her song, trod the rocker with all the spring that was left in her after a long day's seething in the suds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76bd028d-eaae-3968-af92-6fbff82af8e5",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "A rocking chair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5c026b-26cc-48e0-b6f0-58266998bd2a",
                                                "sense_id": "76bd028d-eaae-3968-af92-6fbff82af8e5",
                                                "text": "A few days before he turned 80\nHe was sittin' out back in a rocker"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9ad4d6c-d3f0-385b-bad8-2dab384231c6",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "The lengthwise curvature of a surfboard. (More rocker is a more curved board.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9e0f91-140f-4d80-a126-e99f3b59cb50",
                                                "sense_id": "a9ad4d6c-d3f0-385b-bad8-2dab384231c6",
                                                "text": "All modern surfboards share a similar rocker design — Bruce Jones https://web.archive.org/web/20051212041317/http://www.brucejones.com/longboar.htm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a70ae8f-7302-3136-94c5-f85745e8d023",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "The breve below as in ḫ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3299a866-d15a-475e-a37d-87ad33bc7bc0",
                                                "sense_id": "7a70ae8f-7302-3136-94c5-f85745e8d023",
                                                "text": "Like the editors of other Elamite texts, I omit the diacritic rocker from h in Elamite and from H in logograms in Elamite texts. I retain the rocker in ḫ and Ḫ in Sumerian and Akkadian."
                                            },
                                            {
                                                "example_id": "916aea52-b44f-4728-88e0-800015709bd0",
                                                "sense_id": "7a70ae8f-7302-3136-94c5-f85745e8d023",
                                                "text": "Although the exact sound value of s remains uncertain, and there is only one such sibiliant in Hittite, it is traditionally transliterated with a so-called haček: š. This should not be taken, however, as evidence that it was a palatal sound (as sh in show). The same is true for the traditional “rocker” under the laryngeal ḫ: there is no other h-sign, and the diacritic is not strictly necessary."
                                            },
                                            {
                                                "example_id": "3d242e72-d1b4-4f3f-9270-21f265da1f8e",
                                                "sense_id": "7a70ae8f-7302-3136-94c5-f85745e8d023",
                                                "text": "Semitistic transliteration systems […] a number of features are common to most of them: […] ḫ (“h” with a “rocker,” conventionally called “hooked h”) for the voiceless velar/uvular fricative, IPA [x]/[χ], […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6932090c-3cc7-31f3-b0ee-b530f8918566",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "Someone passionate about rock music."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78371080-e52d-3910-8898-20d5be7bc008",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "A musician who plays rock music."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f62db57e-dd05-3366-b4b0-c4232537792a",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "A rock music song."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "690d408b-9333-4ed3-9d0b-5003b4195063",
                                                "sense_id": "f62db57e-dd05-3366-b4b0-c4232537792a",
                                                "text": "\"Girls & Boys\" is […] also a tart, sneering rocker, full of ingenious musical gestures […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb4f95ce-04d3-3710-a923-37aac2e614e1",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "One who rocks something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6a7afe-e041-4cd6-bd7d-0b099a6044fd",
                                                "sense_id": "eb4f95ce-04d3-3710-a923-37aac2e614e1",
                                                "text": "It was I Sir (ſaid the Rocker) who had the honour (ſome thirty years ſince) to attend on your Highneſs in your Infancie, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27215100-5da1-3aa1-a512-70f6c4e0f3f1",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "A member of a British subculture of the 1960s, opposed to the mods, who dressed in black leather and were interested in 1950s music."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4632151-69cb-38e1-b361-8b7347ee48cf",
                                        "entry_id": "ffb72d82-778d-381e-9cf9-48a5a6df895a",
                                        "glosses": [
                                            "Any implement or machine working with a rocking motion, such as a trough mounted on rockers for separating gold dust from gravel, etc., by agitation in water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f33d7b0-271c-373f-9c32-eb4e4b536799",
