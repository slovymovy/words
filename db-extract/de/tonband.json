                ],
                "senses": [
                    {
                        "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                        "entry_id": "fff8dbf4-4c35-3ca6-976a-6e9527c29865",
                        "glosses": [
                            "langes, schmales, mit magnetisierbarem Material beschichtetes Kunststoffband zur Speicherung von Geräuschen, Musik oder Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0433ae93-7bbf-4d35-9085-70fbb1db42e5",
                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                "text": "„Der große Stapel von Tonbändern, den Claire säuberlich aufgeschichtet hatte, brannte lichterloh, und die Flammen drohten soeben auf die Vorhänge überzugreifen.“"
                            },
                            {
                                "example_id": "24b6895f-1850-44cd-a3e7-311a10b39166",
                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                "text": "„Das gesamte Tonband war abgelaufen.“"
                            },
                            {
                                "example_id": "822f170a-a61b-4389-89c4-d6dd21b6e546",
                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                "text": "„Tonbänder und Kassetten gab es damals noch nicht; aber das wäre heute eine Möglichkeit und wird auch ab und zu angewandt.“"
                            },
                            {
                                "example_id": "a6249558-317a-4428-9fad-7290e96914cf",
                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                "text": "„Die letzten Meter des letzten Tonbandes liegen auf dem Tonbandgerät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17fdd247-5a9e-4f1f-bc93-c67b182a9bb7",
                        "source_entry_id": "fff8dbf4-4c35-3ca6-976a-6e9527c29865",
                        "source_sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                        "target_lang_word": "tape",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e49be5c3-5be0-37d9-8e94-3b50af9b5ccd",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "Flexible material in a roll with a sticky surface on one or both sides; adhesive tape."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5617d224-3d1b-4890-b412-74bcfd728732",
                                                "sense_id": "e49be5c3-5be0-37d9-8e94-3b50af9b5ccd",
                                                "text": "Hand me some tape. I need to fix a tear in this paper."
                                            },
                                            {
                                                "example_id": "22cebb41-a960-4e7f-93bc-ae1bcbff1e52",
                                                "sense_id": "e49be5c3-5be0-37d9-8e94-3b50af9b5ccd",
                                                "text": "I sealed up the box with clear shipping tape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72e03e47-e13e-3a96-bbff-b4b639217c12",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "Thin and flat paper, plastic or similar flexible material, usually produced in the form of a roll."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7999eabd-3042-471b-9721-743b5b65bb96",
                                                "sense_id": "72e03e47-e13e-3a96-bbff-b4b639217c12",
                                                "text": "We made some decorative flowers out of the tape we bought."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe14952-f210-3f55-911f-33dc648ab22f",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "Finishing tape, stretched across a track to mark the end of a race."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c1f305-822a-4376-bfbc-4d701f12a411",
                                                "sense_id": "1fe14952-f210-3f55-911f-33dc648ab22f",
                                                "text": "Jones broke the tape in 47.77 seconds, a new world record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a175179d-94fe-3c43-8b4d-8d60afeb8ab9",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "Magnetic or optical recording media in a roll; videotape or audio tape."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fa43d65-f38b-436b-a3e7-b1872c2742fc",
                                                "sense_id": "a175179d-94fe-3c43-8b4d-8d60afeb8ab9",
                                                "text": "Did you get that on tape?"
                                            },
                                            {
                                                "example_id": "f728b792-8ea2-4ca8-89c7-800406aac01a",
                                                "sense_id": "a175179d-94fe-3c43-8b4d-8d60afeb8ab9",
                                                "text": "So we went around the corner, looked in the garbage, and, boom, there's about 16 of the tapes he didn't like!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9425cfc-b083-36c7-8ef4-759d714c9e2d",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "Any video or audio recording, regardless of the method used to produce it."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef33fc4-3412-4355-8aa1-9a5bf7364cdf",
                                                "sense_id": "f9425cfc-b083-36c7-8ef4-759d714c9e2d",
                                                "text": "“It was one of the most severe beatings they’ve seen on tape,” an FDNY insider said, recalling the reaction by brass who viewed video of the bloody fisticuffs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d4ba9e-314c-3c8a-8341-6590aab0b7aa",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "An unthinking, patterned response triggered by a particular stimulus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3273544f-5444-48c5-8e92-5674ab021789",
                                                "sense_id": "77d4ba9e-314c-3c8a-8341-6590aab0b7aa",
                                                "text": "Old couples will sometimes play tapes at each other during a fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce2b9038-2ea4-37c8-b6c6-816b528b40f1",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "The series of prices at which a financial instrument trades."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff91f89-9358-4504-ba04-b163e0cbfabc",
                                                "sense_id": "ce2b9038-2ea4-37c8-b6c6-816b528b40f1",
                                                "text": "Don’t fight the tape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fec47f5-d574-383c-8e6b-d5eae0db6dc7",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "The wrapping of the primary puck-handling surface of a hockey stick"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8242eca6-67f8-40a8-8361-28ceec7a7b56",
                                                "sense_id": "3fec47f5-d574-383c-8e6b-d5eae0db6dc7",
                                                "text": "His pass was right on the tape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e20f83-e2aa-376f-975f-fdb0cab4a09f",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "A strong flexible band rotating on pulleys for directing the sheets in a printing machine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3aeb98f7-ea69-30bf-9b81-7f6a66545792",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "Liquor, alcoholic drink, especially gin or brandy. (Especially in prison slang or among domestic servants and women.)"
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a26f8359-791f-4f2e-9fde-31c971b24ecc",
                                                "sense_id": "3aeb98f7-ea69-30bf-9b81-7f6a66545792",
                                                "text": "white tape, Holland tape, blue tape (gin); red tape (brandy or wine)"
                                            },
                                            {
                                                "example_id": "1f8a9947-e9ee-48bf-a9a2-2609814f838a",
                                                "sense_id": "3aeb98f7-ea69-30bf-9b81-7f6a66545792",
                                                "text": "Madam Gin has been christened by as many names as a German princess : every petty chandler's shop will sell you Sky-blue, and every night-cellar furnish you with Holland tape, three yards a penny. Nor can I see the difference […]"
                                            },
                                            {
                                                "example_id": "62bc0469-7ba1-4f2d-abf1-c71055f3d284",
                                                "sense_id": "3aeb98f7-ea69-30bf-9b81-7f6a66545792",
                                                "text": "[…] who is now puffing his pipe and sipping his grog, as unconcerned as a Dutch fiddler at a merry-making, has no business here selling his cheese and candles in the day-time, and his yards of tape in the evening: […] and now then for the tape-shop. […]"
                                            },
                                            {
                                                "example_id": "9d163b8c-5ede-4405-898f-99b1a44f0488",
                                                "sense_id": "3aeb98f7-ea69-30bf-9b81-7f6a66545792",
                                                "text": "A tumbler of blue ruin fill, fill for me! / Red tape those as likes it may drain, / But whatever the lush, it a bumper must be. / […] / Oh! those jovial days are ne'er forgot! But the tape lags—When I be's dead, you'll drink one put To poor old Bags!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22d76791-2986-363b-bdca-488670e4c67b",
                                        "entry_id": "5156283f-0085-36a8-876e-139b1b83a563",
                                        "glosses": [
                                            "Clipping of red tape (“time-consuming bureaucratic procedures”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "782891ff-0978-443e-824a-7e2620e7d739",
                                                "sense_id": "22d76791-2986-363b-bdca-488670e4c67b",
                                                "text": "[When dealing with the] Federal Government, \"red tape\" is unavoidable. Perseverance, good humor and thoroughness will almost invariably cut through the \"tape” or lead to the proper official where courteous and attentive treatment will be received."
                                            },
                                            {
                                                "example_id": "0b44c854-241e-4dcb-8a92-9894c089a290",
                                                "sense_id": "22d76791-2986-363b-bdca-488670e4c67b",
                                                "text": "He was going to cut through the tape and ship this Army stuff straight to France."
                                            },
                                            {
                                                "example_id": "8d40bfa9-93b1-4957-b44d-6edc9141980d",
                                                "sense_id": "22d76791-2986-363b-bdca-488670e4c67b",
                                                "text": "Mr. Cheney: […] to move in the direction of deciding that the only way to get anything done, to cut through the red tape, to be able to move aggressively, is to have it done, in effect, inside the boundary of the White House. […] Mr. North: […] there are certainly times when one has to cut through the tape."
                                            },
                                            {
                                                "example_id": "73e42e95-49ae-4a1f-83e7-d438b5ac2e19",
                                                "sense_id": "22d76791-2986-363b-bdca-488670e4c67b",
                                                "text": "As Treasurer and Governor of Texas, she had an ability to cut through the tape and conventions to get stuff done and make things better. She modernized systems, made government more transparent and accountable and[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "904649c2-bffa-3f72-92ef-484944c63f7f",
                                        "entry_id": "fd484ba0-5a08-3f70-b1a3-154228e83089",
                                        "glosses": [
                                            "To bind with adhesive tape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "965413f3-5ecc-4490-b978-29ad93ec298c",
                                                "sense_id": "904649c2-bffa-3f72-92ef-484944c63f7f",
                                                "text": "Be sure to tape your parcel securely before posting it."
                                            },
                                            {
                                                "example_id": "ab385db5-e637-4603-b455-482f00f3d77a",
                                                "sense_id": "904649c2-bffa-3f72-92ef-484944c63f7f",
                                                "text": "The agent had to dead-drop the locker key to the PGU by some simple means, such as by taping it underneath a predesignated park bench, where it could be retrieved unobtrusively, usually by an officer under illegal cover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cdbc5d3-6db0-3003-88e1-8a4bef706114",
                                        "entry_id": "fd484ba0-5a08-3f70-b1a3-154228e83089",
                                        "glosses": [
                                            "To record, originally onto magnetic tape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b19e8b-043f-4d24-a4f0-6a8675004215",
                                                "sense_id": "0cdbc5d3-6db0-3003-88e1-8a4bef706114",
                                                "text": "You shouldn’t have said that. The microphone was on and we were taping."
                                            },
                                            {
                                                "example_id": "853a5471-2cc4-4c61-9b33-9448579add81",
                                                "sense_id": "0cdbc5d3-6db0-3003-88e1-8a4bef706114",
                                                "text": "The warmup guy — as I now know is common for live audiences in taped television performances — kept fluffing the crowd like they were preschoolers.\n“Now what are you going to do when we introduce the first comedian?”\nWild cheers.\n“C'mon, that's not good enough! Let's try it again! What are you going to do???”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786bc5b7-621e-3379-b113-cec6f1d0af97",
                                        "entry_id": "fd484ba0-5a08-3f70-b1a3-154228e83089",
                                        "glosses": [
                                            "To understand, figure out."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baef6c0f-5fb4-45b7-9a6a-d5a62ccb2e6e",
                                                "sense_id": "786bc5b7-621e-3379-b113-cec6f1d0af97",
                                                "text": "I've finally got this thing taped."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a47043cd-b02f-4761-a220-df565942a9a7",
                        "source_entry_id": "fff8dbf4-4c35-3ca6-976a-6e9527c29865",
                        "source_sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                        "target_lang_word": "bande magnétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bande magnétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b08ec677-2786-3ce6-b82c-93170f6d84dc",
                                        "entry_id": "de705077-c29e-3fb4-a309-3b268d7dd350",
                                        "glosses": [
                                            "Support permettant l’enregistrement d’informations analogiques ou numériques à l’aide d’un magnétophone ou d’un magnétoscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ac97f2-71c0-473a-8e86-68cb9357834b",
                                                "sense_id": "b08ec677-2786-3ce6-b82c-93170f6d84dc",
                                                "text": "Puis, peu à peu, sa mémoire s’est éclaircie et j’avais l’impression qu’elle me restituait une très ancienne bande magnétique qu’elle avait oubliée au fond d’un tiroir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
