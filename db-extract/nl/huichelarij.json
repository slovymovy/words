                ],
                "translations": [
                    {
                        "translation_id": "ba9bba4d-a701-465e-b2bd-a48200d0ca6d",
                        "source_entry_id": "1454dc1f-4b1a-347b-a806-8e02f59ed557",
                        "source_sense_id": "152ab8c1-ef3c-33fb-9388-d6b376721bf4",
                        "source_sense_description": "het huichelen",
                        "target_lang_word": "Heuchelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heuchelei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b05db1-2f76-3998-9704-499f7176f918",
                                        "entry_id": "88bb8372-ea94-3fd9-b4ca-4ef82fea59bc",
                                        "glosses": [
                                            "Vortäuschen von Unwahrheiten; eine Form von Lügen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14d53056-2bb9-43cc-a06e-606350668c15",
                                                "sense_id": "b8b05db1-2f76-3998-9704-499f7176f918",
                                                "text": "Wenn ich sagen würde, Schule gefiele mir, wäre das Heuchelei."
                                            },
                                            {
                                                "example_id": "f6715153-f25c-41c1-b323-d9830d2dc5c7",
                                                "sense_id": "b8b05db1-2f76-3998-9704-499f7176f918",
                                                "text": "„Von den Betroffenen wird das nicht als Heuchelei empfunden.“"
                                            },
                                            {
                                                "example_id": "770c9930-3ef1-49b7-a997-b661d10813a7",
                                                "sense_id": "b8b05db1-2f76-3998-9704-499f7176f918",
                                                "text": "„Jene, die das ganze Jahr über die Maske der Heuchelei tragen, zu entlarven, ist eine große Versuchung.“"
                                            },
                                            {
                                                "example_id": "37bcdf81-24ce-43a4-814e-b2379d9f8da5",
                                                "sense_id": "b8b05db1-2f76-3998-9704-499f7176f918",
                                                "text": "„Auch diejenigen, die ihre Weisheit gern von sich gaben und ihre Gefühle gern aussprachen und die Lage Russlands tiefgründig erörterten, brachten in alles, was sie sagten, unwillkürlich einen Zug von Heuchelei und Lüge oder von unfruchtbarer Kritikasterei und Gehässigkeit gegen irgendwelche anderen Menschen, denen sie die Schuld an Dingen beimassen, an denen niemand schuld sein konnte.“"
                                            },
                                            {
                                                "example_id": "ad47bbc1-8654-467b-b92c-9d22d8e87b22",
                                                "sense_id": "b8b05db1-2f76-3998-9704-499f7176f918",
                                                "text": "„Weiberlist oder Heuchelei können eine solche Antwort geben; in diesem Augenblick jedoch konnte sie nur der Aufrichtigkeit entspringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0262c7ad-4214-4b96-8905-1b5e390e9a9b",
                        "source_entry_id": "1454dc1f-4b1a-347b-a806-8e02f59ed557",
                        "source_sense_id": "152ab8c1-ef3c-33fb-9388-d6b376721bf4",
                        "source_sense_description": "het huichelen",
                        "target_lang_word": "hypocrisy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypocrisy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The contrivance of a false appearance of virtue or goodness, while concealing real character or inclinations, especially with respect to religious and moral beliefs; hence in general sense, dissimulation, pretence, sham."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31075058-ad03-47b9-bf62-ebdd0313c7ac",
                                                "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                                "text": "political hypocrisy"
                                            },
                                            {
                                                "example_id": "770d7719-4297-40be-a0cc-0d5f835fa782",
                                                "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                                "text": "He condemned the hypocrisy of politicians who broke their own laws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The claim or pretense of having beliefs, standards, qualities, behaviours, virtues, motivations, etc. which one does not really have."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87329f87-8458-49d3-8097-9349bee93b90",
                                                "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                                "text": "rank hypocrisy"
                                            },
                                            {
                                                "example_id": "267a85cc-f06c-4cdc-963e-c273013969db",
                                                "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                                "text": "charge of hypocrisy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45dffe3d-9f1a-3719-a1a1-baf07453151f",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The practice of engaging in the same behaviour or activity for which one criticises another; moral self-contradiction whereby the behavior of one or more people belies their own claimed or implied possession of certain beliefs, standards or virtues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cfb1c5a-b232-3aa9-acec-bf5edd0241cf",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "An instance of hypocrisy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35c0dde3-8671-4528-ba4c-834bcc5a28e7",
                        "source_entry_id": "1454dc1f-4b1a-347b-a806-8e02f59ed557",
                        "source_sense_id": "152ab8c1-ef3c-33fb-9388-d6b376721bf4",
                        "source_sense_description": "het huichelen",
                        "target_lang_word": "hypocrisie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypocrisie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                        "entry_id": "e1de1451-125e-37c2-bc23-56a9bb147691",
                                        "glosses": [
                                            "Vice consistant à s'attribuer une vertu, une croyance ou une opinion, une piété ou un sentiment noble que l'on n'a pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c208782-28a5-42dd-97e1-75db5227c6ba",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "L’hypocrisie est un hommage que le vice rend à la vertu."
                                            },
                                            {
                                                "example_id": "a6a973c8-2e31-400e-a438-b4f6b91199da",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "Une pareille entreprise est une insanité ; aussi aboutit-elle à des équivoques, quand elle n'oblige pas les députés à des attitudes d'une déplorable hypocrisie."
                                            },
                                            {
                                                "example_id": "b111cee5-7269-498c-ac99-3597c4500bd9",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "Arsène André perçait enfin la brume de ce préambule. Ah ! ah ! l'hypocrisie hargneuse le circonvenait comme un filet de chasse ; […]."
                                            },
                                            {
                                                "example_id": "890bbe5e-00ed-4ec4-8e60-b5bd649ed715",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "Il fait l’homme de bien, mais toute sa conduite n’est qu’hypocrisie."
                                            },
                                            {
                                                "example_id": "99dff370-965e-419a-91e3-268350cd8a17",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "En politique l’hypocrisie est un art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0d564d-fcea-366f-b9e5-29b520eb8c00",
                                        "entry_id": "e1de1451-125e-37c2-bc23-56a9bb147691",
                                        "glosses": [
                                            "Vice consistant à s'attribuer une vertu, une croyance ou une opinion, une piété ou un sentiment noble que l'on n'a pas.",
                                            "(sens large) Fait de s'attribuer faussement des valeurs ou pratiques morales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7caaff77-cb44-30cd-a557-43139356d111",
                                        "entry_id": "e1de1451-125e-37c2-bc23-56a9bb147691",
                                        "glosses": [
                                            "Vice consistant à s'attribuer une vertu, une croyance ou une opinion, une piété ou un sentiment noble que l'on n'a pas.",
                                            "Critique d'autrui fondée sur une valeur que l'on contredit soi-même."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2038a25e-7748-3303-8237-74a203d81a9f",
                                        "entry_id": "e1de1451-125e-37c2-bc23-56a9bb147691",
                                        "glosses": [
                                            "Vice consistant à s'attribuer une vertu, une croyance ou une opinion, une piété ou un sentiment noble que l'on n'a pas.",
