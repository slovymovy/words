                    "frequency": "Middle",
                    "semantic_group_id": "shipping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company received a large <w>consignment</w> of fresh fruit from the local farm this morning."
                        },
                        {
                            "text": "The shipping department is preparing a new <w>consignment</w> for international delivery."
                        }
                    ],
                    "synonyms": [
                        "shipment",
                        "delivery",
                        "cargo"
                    ],
                    "common_phrases": [
