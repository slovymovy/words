                                                "sense_id": "b8e2653d-2b7a-3359-8b80-64f6f0eb7596",
                                                "text": "„Das Zöfchen wartete, bis sich unser Jüngling angekleidet hatte, dann nahm es ihn bei der Hand und zog ihn mit sich hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
