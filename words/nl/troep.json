                            }
                        },
                        {
                            "text": "Gooi die oude <w>troep</w> toch gewoon in de vuilnisbak.",
                            "target_lang_translations": {
                                "ru": "Просто выброси этот старый <w>хлам</w> в мусорное ведро.",
                                "en": "Just throw that old <w>trash</w> in the garbage bin.",
                                "pl": "Po prostu wyrzuć te stare <w>śmieci</w> do kosza.",
                                "de": "Wirf doch einfach diesen alten <w>Krempel</w> in den Mülleimer.",
                                "fr": "Jette donc simplement ces vieilles <w>ordures</w> à la poubelle.",
                                "it": "Butta via quella vecchia <w>spazzatura</w> nel cestino.",
                                "cs": "Prostě vyhoď to staré <w>harampádí</w> do koše.",
                                "tr": "Şu eski <w>ıvır zıvırı</w> artık çöpe at gitsin.",
