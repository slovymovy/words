                        "sense_id": "e9262c54-1a59-3540-862a-3be3ce618461",
                        "entry_id": "4c71a8de-53ad-316c-9cf3-586ca794899b",
                        "glosses": [
                            "Orgel, deren Luftdruck durch Wasser geregelt wurde"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1f3da4ce-3148-4cfe-a4fe-cc35bebc5d80",
                                "sense_id": "e9262c54-1a59-3540-862a-3be3ce618461",
                                "text": "„Dank der Arbeit von Paolo Lombardi, dem weltweit einzigen Fachmann für Wasserorgeln, erklingen nun auch wieder zwei Meisterwerke, die seit Jahrhunderten schweigen mussten.“"
                            }
                        ],
