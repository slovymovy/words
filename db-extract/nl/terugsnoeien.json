                                            {
                                                "example_id": "f1a1590a-ffeb-42b5-bf8d-303816e3c66c",
                                                "sense_id": "b60a9d01-c97e-3b9f-a5e7-fab69d90f1bf",
                                                "text": "The organization has slimmed down and cut back on its education programming, but the Jazz Market remains a critical gathering place in Central City, and the orchestra is more tightly bonded than before."
                                            },
                                            {
                                                "example_id": "61b323c3-9d73-46cb-9b13-09a9a4b1a700",
                                                "sense_id": "b60a9d01-c97e-3b9f-a5e7-fab69d90f1bf",
                                                "text": "The £3bn held by NR as a contingency fund to cover the impact of events brought about by extreme weather, which enables repairs following flooding and embankment failures, is also to be cut back."
