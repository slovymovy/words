                        "propos diffus"
                    ]
                },
                {
                    "sense_id": "89b9fab5-9626-36dc-9066-ef5fe5d3a841",
                    "sense_definition": "Qualifie une onde ou une radiation renvoyée dans toutes les directions par une réflexion irrégulière.",
