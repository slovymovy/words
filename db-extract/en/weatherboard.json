                        "entry_id": "8aa2ab92-0989-3005-b555-1fd233296af1",
                        "glosses": [
                            "Any of a series of horizontal boards used to cover the exterior of a timber-framed building; clapboard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e953b34-e62b-4f72-803e-385ded67b258",
                                "sense_id": "41dc93f9-2de6-3bcf-9130-3190fa26615e",
                                "text": "The homestead lies half a mile from the road, a small bungalow built of weatherboard with an iron roof and with verandas on three sides […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76f055fe-61ad-4467-982e-dc58d0b62541",
                        "source_entry_id": "8aa2ab92-0989-3005-b555-1fd233296af1",
