                "senses": [
                    {
                        "sense_id": "0354047d-090a-34eb-959c-aac361a03c43",
                        "entry_id": "902e4681-55a1-347b-adba-55503d557051",
                        "glosses": [
                            "wyraz oznaczający część pewnej całości, np. „dywizja” w stosunku do słowa „armia”"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a604ccc1-a585-47d5-abf6-8d19b2634651",
                                "sense_id": "0354047d-090a-34eb-959c-aac361a03c43",
                                "text": "Palec jest meronimem ręki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a6ce953-762e-497c-b5a1-d85fc5ce7c64",
                        "source_entry_id": "902e4681-55a1-347b-adba-55503d557051",
                        "source_sense_id": "0354047d-090a-34eb-959c-aac361a03c43",
                        "target_lang_word": "meronym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meronym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ce108c7-644d-3e29-b18e-cdd54f4741e7",
                                        "entry_id": "34e4240b-96d0-3c70-b1fb-9fdcdef85f6e",
                                        "glosses": [
                                            "A term used to denote a thing that is a part of something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11cdfe3-3096-45c1-9292-a501577d86b5",
                                                "sense_id": "9ce108c7-644d-3e29-b18e-cdd54f4741e7",
                                                "text": "The word \"leaf\" is a meronym of the word \"tree\"."
                                            },
                                            {
                                                "example_id": "132df03a-fea2-4518-9da6-cf73f21466ee",
                                                "sense_id": "9ce108c7-644d-3e29-b18e-cdd54f4741e7",
                                                "text": "If one starts with some complex whole, like {automobile} or {human_body}, it can be broken down into several levels of meronyms, but many of those meronyms will also be meronyms of other wholes. That is to say, some components serve as parts of many different things: think of all the different mechanisms that have gears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "720f9705-5328-4420-87b1-980fa4bafeb4",
                        "source_entry_id": "902e4681-55a1-347b-adba-55503d557051",
                        "source_sense_id": "0354047d-090a-34eb-959c-aac361a03c43",
                        "target_lang_word": "merónimo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merónimo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "675f6d86-e9b7-34da-ae68-a782e2999592",
                                        "entry_id": "ed0db116-c578-3643-8c31-26d383ccc6c8",
                                        "glosses": [
                                            "Palabra cuya relación de significado es igual a otra u otras con respecto a una, denominada holónimo, cuyo significado las engloba."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba30dc9-5bb7-486c-a74f-5360b81f33cb",
                                                "sense_id": "675f6d86-e9b7-34da-ae68-a782e2999592",
                                                "text": "Las palabras \"tigre\", \"lince\", \"león\" y \"guepardo\" son merónimos entre sí del holónimo \"felino\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e078fa62-9060-469b-b4f3-f4d221dc94a0",
                        "source_entry_id": "902e4681-55a1-347b-adba-55503d557051",
                        "source_sense_id": "0354047d-090a-34eb-959c-aac361a03c43",
                        "target_lang_word": "Meronym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meronym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31cd5528-14df-3dc0-b160-16f1c6e808ad",
                                        "entry_id": "7b76221e-01c9-3a33-8ca4-b8cfb03fb4dd",
                                        "glosses": [
                                            "Ausdruck, der zu einem anderen Ausdruck in der Relation \\\"ist Teil von\\\" steht, der also einen Teil bezeichnet, von dem der andere das Ganze bezeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b9c3817-f33a-4735-afb3-343d7bacae89",
                                                "sense_id": "31cd5528-14df-3dc0-b160-16f1c6e808ad",
                                                "text": "Die Ausdrücke Augen, Nase, Mund, Stirn, Kinn und Wangen sind Meronyme zum Ausdruck Gesicht."
                                            },
                                            {
                                                "example_id": "7c7c939b-3320-49a0-a3c3-3ac1ffb5427b",
                                                "sense_id": "31cd5528-14df-3dc0-b160-16f1c6e808ad",
                                                "text": "Der Begriff Karosserie ist ein Meronym zum Begriff Auto."
                                            },
                                            {
                                                "example_id": "2cfb8ee4-1d4b-4bcc-bdc3-0191e8ed5f51",
                                                "sense_id": "31cd5528-14df-3dc0-b160-16f1c6e808ad",
                                                "text": "Dativ ist ein Meronym des deutschen Kasussystems."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "667fac76-2903-44d0-b7e6-c6af41319e50",
                        "source_entry_id": "902e4681-55a1-347b-adba-55503d557051",
                        "source_sense_id": "0354047d-090a-34eb-959c-aac361a03c43",
