                "translations": [
                    {
                        "translation_id": "f666cd92-656b-4cf9-9840-1c8ed05586bc",
                        "source_entry_id": "290a339a-cb02-301d-8de8-356a2f0fe504",
                        "source_sense_id": "43c9bb02-6a10-3504-8e09-3b4927ca4be0",
                        "target_lang_word": "chiaroscuro",
