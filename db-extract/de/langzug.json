                "senses": [
                    {
                        "sense_id": "6135e10d-bb94-3af7-a708-29162acd3db3",
                        "entry_id": "cd418276-8198-3c30-84a1-4bb721d7d39a",
                        "glosses": [
                            "(U- oder S-)Bahn-Garnitur, welche mehr als die übliche Länge aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6136b2c7-2240-4949-bee5-762f51016d57",
                                "sense_id": "6135e10d-bb94-3af7-a708-29162acd3db3",
                                "text": "„Langzüge haben vorn drei Loks, dann 100 Waggons, in der Mitte eine Lok, noch mal 100 Waggons, hinten wieder eine Lok.“"
                            },
                            {
                                "example_id": "74051e43-4558-419e-a42b-e80979d332da",
                                "sense_id": "6135e10d-bb94-3af7-a708-29162acd3db3",
                                "text": "„Die Frage, ob die S-Bahn Voll- oder Langzüge einsetze, bleibe freilich dem Unternehmen selbst überlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
