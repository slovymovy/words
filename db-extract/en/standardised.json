        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5c14f139-2652-35ce-ba5e-709b2d70e5f8",
                "word": "standardised",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da04cd1e-f57f-375e-8dd1-852244a3a79b",
                        "entry_id": "5c14f139-2652-35ce-ba5e-709b2d70e5f8",
                        "glosses": [
                            "Designed in a standard manner or according to an official or accepted standard."
                        ],
                        "tags": [
                            "UK",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "24a4dead-e157-456a-b8d4-13e950db76cf",
                                "sense_id": "da04cd1e-f57f-375e-8dd1-852244a3a79b",
                                "text": "But the outstanding feature of the new timetable arrangement, additional to the standardised departure times, is the number of intermediate points, in addition to such principal cities as Bristol, Plymouth, Cardiff and Birmingham, that now have departures for Paddington at the same minutes past the hour throughout the day."
                            },
                            {
                                "example_id": "faa54861-eab0-4223-a757-c5d5510a56af",
                                "sense_id": "da04cd1e-f57f-375e-8dd1-852244a3a79b",
                                "text": "The connection between dictionaries and standardised forms of language is undeniable, yet, at the same time, not well understood."
                            },
                            {
                                "example_id": "39449850-54d5-48ae-bfc4-f9ed8f102382",
                                "sense_id": "da04cd1e-f57f-375e-8dd1-852244a3a79b",
                                "text": "Internationally, the shipping container had already proven its worth, and by the early 1960s battles were being fought over what their standardised dimensions would be (their expected proliferation was not in question)."
                            }
                        ]
                    }
                ],
