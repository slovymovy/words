                    {
                        "translation_id": "6caffc54-b08e-42bc-a74e-92a0779f3841",
                        "source_entry_id": "9187bfb6-b7bc-39e1-ba56-4007522465ee",
                        "source_sense_id": "4ed3bccb-8cd6-3e4d-912b-7f4b4f40f12f",
                        "source_sense_description": "wood of the apple tree",
                        "target_lang_word": "pommier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pommier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b86d5d7-91e6-307e-86cc-595f2704c335",
                                        "entry_id": "d3edd363-f3b1-3c6e-80d4-b78ea7095a52",
                                        "glosses": [
                                            "Arbre de la famille des Rosacées, du genre Malus, qui produit les pommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3058dba-0fbe-4319-a7f3-c89a3173c2c4",
                                                "sense_id": "0b86d5d7-91e6-307e-86cc-595f2704c335",
                                                "text": "Dans les vergers ou les terrains vagues, où l’on ne compte pas sur la récolte du sol, on plante en général 200 pommiers ou poiriers par hectare."
                                            },
                                            {
                                                "example_id": "0311f247-9756-4cb8-b1d1-cced5df0327f",
                                                "sense_id": "0b86d5d7-91e6-307e-86cc-595f2704c335",
                                                "text": "[…] puis, ayant longé un champ d’avoine, étoilé de bluets et de coquelicots, nous arrivâmes en un verger où des vaches, à la robe bringelée, dormaient couchées à l’ombre des pommiers."
                                            },
                                            {
                                                "example_id": "52aba344-0441-4af6-bc83-2f07c1f828f1",
                                                "sense_id": "0b86d5d7-91e6-307e-86cc-595f2704c335",
                                                "text": "Je vais m’étendre dans la prairie, sous un pommier aux pommes vertes et dures. Je peux dormir au-dessous d’elles, je peux les contempler sans crainte, et même sans l’appréhension d’avoir à inventer, l’une tombant, les lois du monde."
                                            },
                                            {
                                                "example_id": "16d2c098-edee-4384-be6e-3a5a509b4daf",
                                                "sense_id": "0b86d5d7-91e6-307e-86cc-595f2704c335",
                                                "text": "Le chien, logé dans un baril, au pied d’un pommier penchant, jappait avec fureur en tirant sur sa chaîne."
                                            },
                                            {
                                                "example_id": "d8e6c125-2383-4aa4-be51-65e570f9ddfe",
                                                "sense_id": "0b86d5d7-91e6-307e-86cc-595f2704c335",
                                                "text": "Puis on se remit en route sous les pommiers déjà lourds de fruits."
                                            },
                                            {
                                                "example_id": "553e7950-2151-43d6-89a2-8a26c2d498ce",
                                                "sense_id": "0b86d5d7-91e6-307e-86cc-595f2704c335",
                                                "text": "Moins difficile que le poirier, le pommier vient à peu près partout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6baa7e17-d188-3a5f-9c29-2c1e5ed655d1",
                                        "entry_id": "d3edd363-f3b1-3c6e-80d4-b78ea7095a52",
                                        "glosses": [
                                            "Synonyme de cuit-pommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6712af4-2b78-4b76-832b-d68656bca731",
                                                "sense_id": "6baa7e17-d188-3a5f-9c29-2c1e5ed655d1",
                                                "text": "Il vaut infiniment mieux avoir un grille-pain et un pommier en tôle. Ils ressemblent assez, pour la forme, à la coquille à rôtir avant qu’on l’ait appliquée contre la cuisinière. […] Quant au pommier, il présente plusieurs étages formés par deux lames de tôle d’une largeur convenable pour maintenir les pommes. Ces deux lames se croisent et se tournent au moyen d’une petite manivelle. Quand la pomme est cuite d’un côté, on tourne la manivelle, la lame s’avance, et la pomme se retourne facilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee881d2b-60fa-3947-81d8-12504e42a645",
                                        "entry_id": "d3edd363-f3b1-3c6e-80d4-b78ea7095a52",
                                        "glosses": [
                                            "Arbre au fût court et au houppier très développé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ae8449-2d48-4ad6-bc77-79824dfa69ad",
                                                "sense_id": "ee881d2b-60fa-3947-81d8-12504e42a645",
                                                "text": "L’aspect du cormier est fort variable : le houppier d’un individu solitaire est large, de type pommier, alors qu’en peuplement, la stature est élancée, l’axe du tronc continu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
