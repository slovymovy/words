                "senses": [
                    {
                        "sense_id": "5be191d0-0f31-32d7-9173-f4621c3d86d7",
                        "entry_id": "98e973db-0157-3a57-98e5-48bfef07a8bd",
                        "glosses": [
                            "schwanzloses Amphibium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0336a092-1ab6-4e2b-9a83-76c3a972fef5",
                                "sense_id": "5be191d0-0f31-32d7-9173-f4621c3d86d7",
                                "text": "Die Unken gehören zu den Froschlurchen."
                            },
                            {
                                "example_id": "24adc63e-9dcf-48e8-acf2-b8b17e4b8888",
                                "sense_id": "5be191d0-0f31-32d7-9173-f4621c3d86d7",
                                "text": "„Vor kurzem verbreitete sich in Fachkreisen die Nachricht, dass auf der Insel Haiti ein in Bernstein eingeschlossener, gut erhaltener Froschlurch entdeckt worden ist, dessen Alter auf 35 bis 40 Millionen Jahre geschätzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4317616-b6ab-47f7-9b85-c15003da4ae8",
                        "source_entry_id": "98e973db-0157-3a57-98e5-48bfef07a8bd",
                        "source_sense_id": "5be191d0-0f31-32d7-9173-f4621c3d86d7",
                        "source_sense_description": "schwanzloses Amphibium",
                        "target_lang_word": "batrachian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "batrachian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e83de98a-d617-372c-8b97-ad70a0735185",
                                        "entry_id": "65358ff0-415b-3bc4-98f4-d3307cf5fe26",
                                        "glosses": [
                                            "A frog or toad."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9214d29-2f41-4b96-9a7b-42daca15ce82",
                                                "sense_id": "e83de98a-d617-372c-8b97-ad70a0735185",
                                                "text": "The warmth of his defence of the toad led me to suspect uneasily that a close search of his quarters would pretty certainly reveal a comfortable vivarium somewhere, bursting with the little batrachians."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "batrachian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7263a7f1-2a08-3b56-8ea0-32a7cab65301",
                                        "entry_id": "32d3c865-c1e3-33ed-9988-fd54925aafd8",
                                        "glosses": [
                                            "Pertaining to or resembling a frog or toad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57ffe5a-6f60-495f-b30a-74dc6a90aec2",
                                                "sense_id": "7263a7f1-2a08-3b56-8ea0-32a7cab65301",
                                                "text": "Anon the minnow-bucket will emit '\"batrachian\"' sobs."
                                            },
                                            {
                                                "example_id": "9b65db32-c4c2-42b6-aab0-fede53381f53",
                                                "sense_id": "7263a7f1-2a08-3b56-8ea0-32a7cab65301",
                                                "text": "At this Lena smiled again with that mirthless batrachian grin."
                                            },
                                            {
                                                "example_id": "5d551e08-fc86-4c83-9824-77fd7378c0b4",
                                                "sense_id": "7263a7f1-2a08-3b56-8ea0-32a7cab65301",
                                                "text": "His batrachian lips pursed into a smile, and he dug again into the honey."
                                            },
                                            {
                                                "example_id": "22645629-0ff5-4cad-853f-e513dced2bdd",
                                                "sense_id": "7263a7f1-2a08-3b56-8ea0-32a7cab65301",
                                                "text": "2000 The Darkest of the Hillside Thickets, \"The Innsmouth Look\"\nI dig her batrachian lips / Her bulbous eyes and scaly hips"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5502e3e-7479-4f9c-8255-a0daf9df2c9c",
                        "source_entry_id": "98e973db-0157-3a57-98e5-48bfef07a8bd",
                        "source_sense_id": "5be191d0-0f31-32d7-9173-f4621c3d86d7",
                        "source_sense_description": "schwanzloses Amphibium",
                        "target_lang_word": "anoure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anoure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c54f6c60-9d30-3900-ace5-d046f4c7aa2d",
                                        "entry_id": "ec1faa4c-cff4-363a-8614-337daae50d3f",
                                        "glosses": [
                                            "Dépourvu de queue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd780b90-6843-44ef-bda9-c2af935f32a7",
                                                "sense_id": "c54f6c60-9d30-3900-ace5-d046f4c7aa2d",
                                                "text": "La grenouille et le crapaud sont des amphibiens anoures, contrairement à la salamandre."
                                            },
                                            {
                                                "example_id": "ab5097b2-f08e-45c8-8fb0-4c84ac3f8316",
                                                "sense_id": "c54f6c60-9d30-3900-ace5-d046f4c7aa2d",
                                                "text": "Ceux-ci n’ont d’ailleurs pas donné de descendance entre eux; la forme complètement anoure paraît donc stérile et rarement viable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anoure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea34d2fa-509c-314e-82fd-cccf99695325",
                                        "entry_id": "a7df63f7-e3e7-37fc-9405-2ad4d0e2aba1",
                                        "glosses": [
                                            "Animal sans queue. Se dit en particulier des amphibiens dépourvus de queue à l'âge adulte et possédant des membres postérieurs adaptés au saut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e6be66-cc74-4a16-83be-08ff641d9e73",
                                                "sense_id": "ea34d2fa-509c-314e-82fd-cccf99695325",
                                                "text": "Salamandres et tritons ne sont pas des anoures mais des urodèles : les adultes conservent leur queue !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
