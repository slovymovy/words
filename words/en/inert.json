{
    "word_family": [
        "inertia",
        "inertly",
        "inertness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99ebd70c-fe7e-3c22-8908-b35a6a3b82ae",
                    "sense_definition": "Unable to move or act; motionless and inanimate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient lay <w>inert</w> on the bed after the long surgery.",
                            "target_lang_translations": {
                                "tr": "Hasta, uzun ameliyatın ardından yatakta <w>hareketsiz</w> yattı."
                            }
                        },
                        {
                            "text": "After falling down the stairs, he remained <w>inert</w> until the paramedics arrived.",
                            "target_lang_translations": {
                                "tr": "Merdivenlerden düştükten sonra, sağlık görevlileri gelene kadar <w>hareketsiz</w> kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "immobile",
                        "inanimate",
                        "motionless",
                        "lifeless"
                    ],
                    "antonyms": [
                        "active",
                        "mobile"
                    ],
                    "common_phrases": [
                        "remain inert",
                        "lay inert"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hareket edemeyen veya eyleme geçemeyen; hareketsiz ve cansız."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hareketsiz",
                                "target_lang_sense_clarification": "fiziksel olarak kımıldamayan"
                            },
                            {
                                "target_lang_word": "durgun",
                                "target_lang_sense_clarification": "cansız veya eylemsiz duran"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "362dae5e-12ac-3680-821e-be2b1e79bed1",
                    "sense_definition": "Lacking energy, vigor, or the desire to move or act; sluggish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot afternoon weather left everyone feeling lazy and <w>inert</w>.",
                            "target_lang_translations": {
                                "tr": "Sıcak öğleden sonra havası herkesin tembel ve <w>uyuşuk</w> hissetmesine neden oldu."
                            }
                        },
                        {
                            "text": "Critics accused the government of being <w>inert</w> in the face of the economic crisis.",
                            "target_lang_translations": {
                                "tr": "Eleştirmenler, hükümeti ekonomik kriz karşısında <w>eylemsiz</w> kalmakla suçladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluggish",
                        "lethargic",
                        "torpid",
                        "indolent"
                    ],
                    "antonyms": [
                        "energetic",
                        "lively"
                    ],
                    "common_phrases": [
                        "feel inert"
                    ],
                    "target_lang_definitions": {
                        "tr": "Enerjisi, canlılığı veya hareket etme isteği olmayan; uyuşuk, eylemsiz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "eylemsiz",
                                "target_lang_sense_clarification": "tepki vermeyen veya çaba göstermeyen"
                            },
                            {
                                "target_lang_word": "uyuşuk",
                                "target_lang_sense_clarification": "hantal ve isteksiz"
                            },
                            {
                                "target_lang_word": "atıl",
                                "target_lang_sense_clarification": "pasif, işlevsiz kalan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69b3c864-2f2b-394b-b661-5f55f54f460b",
                    "sense_definition": "Not readily reacting chemically with other substances.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "chemical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Helium is an <w>inert</w> gas that does not react easily with other elements.",
                            "target_lang_translations": {
                                "tr": "Helyum, diğer elementlerle kolayca tepkimeye girmeyen <w>asal</w> bir gazdır."
                            }
                        },
                        {
                            "text": "Noble gases are considered chemically <w>inert</w> under standard conditions.",
                            "target_lang_translations": {
                                "tr": "Soy gazlar, standart koşullar altında kimyasal olarak <w>tepkimesiz</w> kabul edilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "unreactive",
                        "nonreactive"
                    ],
                    "antonyms": [
                        "reactive"
                    ],
                    "common_phrases": [
                        "inert gas",
                        "chemically inert"
                    ],
                    "target_lang_definitions": {
                        "tr": "Diğer maddelerle kolayca kimyasal tepkimeye girmeyen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "asallık gösteren",
                                "target_lang_sense_clarification": "kimyasal tepkimeye girmeyen (asal)"
                            },
                            {
                                "target_lang_word": "tepkimesiz",
                                "target_lang_sense_clarification": "reaksiyon vermeyen"
                            },
                            {
                                "target_lang_word": "inert",
                                "target_lang_sense_clarification": "kimyada reaktif olmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d922557b-0fd3-3048-bde4-3754cb13e381",
                    "sense_definition": "Having no pharmacological or therapeutic action.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The placebo contained only an <w>inert</w> ingredient like sugar.",
                            "target_lang_translations": {
                                "tr": "Plasebo, yalnızca şeker gibi <w>etkisiz</w> bir madde içeriyordu."
                            }
                        },
                        {
                            "text": "Researchers tested the new drug against an <w>inert</w> substance in the clinical trial.",
                            "target_lang_translations": {
                                "tr": "Araştırmacılar, klinik deneyde yeni ilacı <w>etkisiz</w> bir maddeye karşı test etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "inactive"
                    ],
                    "antonyms": [
                        "active"
                    ],
                    "common_phrases": [
                        "inert ingredient",
                        "inert substance"
                    ],
                    "target_lang_definitions": {
                        "tr": "Farmakolojik veya tedavi edici bir etkisi olmayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "etkisiz",
                                "target_lang_sense_clarification": "tıbbi etkisi olmayan"
                            },
                            {
                                "target_lang_word": "pasif",
                                "target_lang_sense_clarification": "biyolojik olarak aktif olmayan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d487117-29af-3d7d-98d9-db4162b22b7e",
                    "sense_definition": "A substance or component that does not react chemically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mixture consists of active chemicals mixed with various <w>inerts</w>.",
                            "target_lang_translations": {
                                "tr": "Karışım, çeşitli <w>etkisiz maddelerle</w> karıştırılmış aktif kimyasallardan oluşmaktadır."
                            }
                        },
                        {
                            "text": "Chemical waste processors must separate the reactive materials from the <w>inerts</w>.",
                            "target_lang_translations": {
                                "tr": "Kimyasal atık işleyicileri, reaktif maddeleri <w>inert maddelerden</w> ayırmalıdır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kimyasal olarak tepkimeye girmeyen madde veya bileşen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "inert madde",
                                "target_lang_sense_clarification": "tepkimesiz bileşen"
                            },
                            {
                                "target_lang_word": "etkisiz madde",
                                "target_lang_sense_clarification": "reaktif olmayan bileşen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d385eaa9-b5f2-3c87-8944-f9f2e9a3c2f7",
                    "sense_definition": "To fill a container or space with an unreactive gas to prevent fire or explosion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "safety_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers decided to <w>inert</w> the fuel tank before beginning repairs.",
                            "target_lang_translations": {
                                "tr": "Mühendisler, onarıma başlamadan önce yakıt deposunu <w>asal gazla doldurmaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "Technicians will <w>inert</w> the chamber with nitrogen gas to prevent combustion.",
                            "target_lang_translations": {
                                "tr": "Teknisyenler, yanmayı önlemek için odayı azot gazıyla <w>inertleştirecekler</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inert the tank"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yangın veya patlamayı önlemek amacıyla bir kap veya alanı tepkimesiz gazla doldurmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "asal gazla doldurmak",
                                "target_lang_sense_clarification": "patlamayı önlemek için inert gaz basmak"
                            },
                            {
                                "target_lang_word": "inertleştirmek",
                                "target_lang_sense_clarification": "gazla etkisiz hale getirmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}