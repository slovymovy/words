                        ],
                        "form": "icoontje"
                    },
                    {
                        "form_id": "865ee35a-0064-43be-908f-52f0218ab6dd",
                        "entry_id": "3985f253-13d8-392f-9102-dcb43f15f71c",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "icoontjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e5a4251-bc01-32e1-9b1a-f428b2da27c5",
                        "entry_id": "3985f253-13d8-392f-9102-dcb43f15f71c",
                        "glosses": [
                            "een heiligenafbeelding zoals deze in de kerken van het oosten vereerd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "372c49eb-b6af-42d2-b17f-e2c89b822f2e",
                                "sense_id": "2e5a4251-bc01-32e1-9b1a-f428b2da27c5",
                                "text": "In het Byzantijnse rijk van Constantijn V werd de verering van iconen vervolgd."
                            }
                        ]
                    },
                    {
                        "sense_id": "90c3207a-b131-3a5b-9874-0cf756f651c7",
                        "entry_id": "3985f253-13d8-392f-9102-dcb43f15f71c",
                        "glosses": [
                            "pictogram, een meestal aanklikbare kleine afbeelding op een computerscherm die een bestand of programma activeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1b0b92b-3c59-449e-8303-1da38ef14e71",
                                "sense_id": "90c3207a-b131-3a5b-9874-0cf756f651c7",
                                "text": "Dubbelklik rechtsonderaan op het icoon om het antivirusprogramma te openen."
                            }
                        ]
                    },
                    {
                        "sense_id": "758bd45b-430b-3189-afa8-20ce03382803",
                        "entry_id": "3985f253-13d8-392f-9102-dcb43f15f71c",
                        "glosses": [
                            "iemand die een kenmerkend voorbeeld is voor een bepaalde categorie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0944fb3-bdc9-4541-9e0f-69447284da5e",
                                "sense_id": "758bd45b-430b-3189-afa8-20ce03382803",
                                "text": "Natuurlijk zijn ze in Assen onverminderd trots op 'hun' Harry. Gastconservator Albert Haar noemt hem graag een icoon voor Drenthe, een voorbeeld voor de provinciale jeugd. Maar Muskee was natuurlijk meer dan dat. Met zijn muziek en zijn dwarsheid was hij een exponent van de anarchie van de jaren zestig. Die levenshouding bracht hem fans in heel Nederland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "557e0f6d-363e-4978-ba44-31cff5db7be4",
                        "source_entry_id": "3985f253-13d8-392f-9102-dcb43f15f71c",
                        "source_sense_id": "2e5a4251-bc01-32e1-9b1a-f428b2da27c5",
                        "source_sense_description": "heiligenafbeelding, zoals vereerd in de kerken van het oosten",
                        "target_lang_word": "icon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89a4adca-fcc4-396c-8742-89c9461f589c",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "An image, symbol, picture, portrait, or other representation usually as an object of religious devotion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8164ce4a-f168-3997-93b8-551bab83ebcb",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A type of religious painting portraying a saint or scene from Scripture, often done on wooden panels."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2d35b1-3368-4950-b70c-db15b4a7a5cf",
                                                "sense_id": "8164ce4a-f168-3997-93b8-551bab83ebcb",
                                                "text": "Last week the Archdiocese sent emmissaries to investigate the icon and decided that the tears were not a hoax, Father Koufos said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A person or thing that is the best example of a certain profession or some doing."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "297e0326-6307-4220-992d-d96b3085a05f",
                                                "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                                "text": "That man is an icon in the business; he personifies loyalty and good business sense."
                                            },
                                            {
                                                "example_id": "a3aba1af-87b2-4578-9bb6-868333c0ac1a",
                                                "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                                "text": "Only a handful of rock musicians have become genuine icons - larger-than-life symbolic figures whose personal triumphs and vicissitudes seem to mirror the ups and downs of rock as a whole, and sometimes of the society that nurtures it. Often, rock icons become the objects of personality cults that tend to overshadow their musical accomplishments."
                                            },
                                            {
                                                "example_id": "22781430-9dd8-4c59-81fc-ed80a49d4319",
                                                "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                                "text": "Barbie is viewed as an icon of American culture in her new biography, Barbie: Her Life and Times (Crown, $25), written by Billy Boy, a clothing and jewelry designer in Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48a83ca1-3675-3ee2-9565-7787134fddde",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A small picture that represents something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85a3c17-624a-4790-b75b-19a35ad1e5f4",
                                                "sense_id": "48a83ca1-3675-3ee2-9565-7787134fddde",
                                                "text": "Click the loudspeaker icon to configure audio settings."
                                            },
                                            {
                                                "example_id": "ad5ef221-8897-48d6-b5e7-d91348f1fc83",
                                                "sense_id": "48a83ca1-3675-3ee2-9565-7787134fddde",
                                                "text": "The program's most quintessentially Macintoshian feature, one as yet unique among spreadsheets, is its icon bar, which resides at the top of the screen just below the standard menu bar. It contains 21 icons, each of which allows the user to perform a specified function with but a few clicks of the mouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1f2c81-c51b-327c-94a7-5eaacdf4cead",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A small picture that represents something.",
                                            "An image used to represent a user; an avatar or profile picture."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba7be6dc-7159-4809-b68a-2339259dd3f2",
                                                "sense_id": "2d1f2c81-c51b-327c-94a7-5eaacdf4cead",
                                                "text": "Is it okay if I use your drawing as my icon?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0c84fc5-4629-3746-a7f1-1322abe115a8",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A word, character, or sign whose form reflects and is determined by the referent; onomatopoeic words are necessarily all icons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba55517-e2bb-49e5-b4eb-03d52b1ed24d",
                                                "sense_id": "d0c84fc5-4629-3746-a7f1-1322abe115a8",
                                                "text": "."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "626cfd7b-c35a-4890-96b2-3001d0a3c33b",
                        "source_entry_id": "3985f253-13d8-392f-9102-dcb43f15f71c",
                        "source_sense_id": "2e5a4251-bc01-32e1-9b1a-f428b2da27c5",
                        "source_sense_description": "heiligenafbeelding, zoals vereerd in de kerken van het oosten",
                        "target_lang_word": "icône",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icône",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e3da95-2202-33d3-8bec-d558a4a2c45b",
                                        "entry_id": "3fe8ac69-c6af-3778-a4ed-09e27a1ca698",
                                        "glosses": [
                                            "Image sainte, le plus souvent peinte sur bois, qui est vénérée dans l'Église d'Orient."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0725b05a-b727-497a-b8b3-c8c7ee7347a8",
                                                "sense_id": "c6e3da95-2202-33d3-8bec-d558a4a2c45b",
                                                "text": "Les saintes icônes."
                                            },
                                            {
                                                "example_id": "ec8e0bf5-9381-48d8-b4c9-b6d2e63aae34",
                                                "sense_id": "c6e3da95-2202-33d3-8bec-d558a4a2c45b",
                                                "text": "Andreï Roublev fut un célèbre peintre d'icônes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdfb1d49-01c2-3c65-9efa-79197d6f9e25",
                                        "entry_id": "3fe8ac69-c6af-3778-a4ed-09e27a1ca698",
                                        "glosses": [
                                            "Archétype."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c78ef792-dada-408a-9648-dc92452abb5a",
                                                "sense_id": "cdfb1d49-01c2-3c65-9efa-79197d6f9e25",
                                                "text": "[Titre] Du rififi sur « Sesame Street » : Ernest et Bert sont-ils des icônes gays ?"
                                            },
                                            {
                                                "example_id": "eac2a2ee-50f8-4d04-b97d-c12fd653e889",
                                                "sense_id": "cdfb1d49-01c2-3c65-9efa-79197d6f9e25",
                                                "text": "La jeune femme, qui travaillait dans une épicerie, est la première victime confirmée de la répression des généraux birmans.\n Elle est déjà une icône pour les manifestants. Certains défilent avec sa photo et une banderole à son image a été déployée sur un pont."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "icône",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a369258-71be-399a-be1d-40a89b080452",
                                        "entry_id": "4bb84d2c-70bc-3ba7-9114-8851b492055f",
                                        "glosses": [
                                            "Type de signe se caractérisant par le fait qu’il y a une similitude de fait avec l’objet qu’il dénote en vertu de ses caractères propres."
                                        ],
                                        "tags": [
                                            "Sémiotique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1acc38f-2f3a-4fd8-a2d4-3acde8c7cfec",
                                                "sense_id": "7a369258-71be-399a-be1d-40a89b080452",
                                                "text": "C’est la fonction de signe de l’icône qui doit être interrogée et non pas sa fonction d’image. Ce concept abstrait vise à mieux rendre compte du fonctionnement du signe et du signifiant."
                                            },
                                            {
                                                "example_id": "616a9ec0-cbe5-4492-b633-fc27809fa594",
                                                "sense_id": "7a369258-71be-399a-be1d-40a89b080452",
                                                "text": "Le plan d’une maison (représentant) est une icône de cette demeure (représenté) au sens de Peirce parce qu’il y a une similitude de fait entre le plan et la maison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "icône",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cf67cd-32f3-3a9c-b8b3-b097452511b0",
                                        "entry_id": "4c1eee31-6476-3cd1-8977-b47d1969b8b6",
                                        "glosses": [
                                            "Symbole graphique apparaissant sur un écran et représentant une fonction ou une application logicielle particulière que l’on peut sélectionner et activer, généralement via le curseur d’une souris."
                                        ],
                                        "tags": [
                                            "Interface graphique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a7498df-beca-4f49-9e80-1487bab9eac2",
                                                "sense_id": "c7cf67cd-32f3-3a9c-b8b3-b097452511b0",
                                                "text": "Lorsque vous branchez un disque externe, une icône apparaît automatiquement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
