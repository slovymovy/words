                        "target_lang_word": "Zimmerfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmerfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e85359-08f1-3246-9f03-d7a91a94a1e0",
                                        "entry_id": "cb43eee5-940b-3aa1-9d55-d1a05175e593",
                                        "glosses": [
                                            "Frau, die für die Pflege von Hotelzimmern beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e295f33-b9d4-4020-8f60-9975967f3029",
                                                "sense_id": "c8e85359-08f1-3246-9f03-d7a91a94a1e0",
                                                "text": "Die Zimmerfrau war mit unserem Hotelzimmer noch nicht fertig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cde9f475-8416-3cd5-9f0d-1c247bec771f",
                                        "entry_id": "cb43eee5-940b-3aa1-9d55-d1a05175e593",
                                        "glosses": [
                                            "Frau, die ein Zimmer vermietet"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd185c36-995d-4364-9914-61df4fde419c",
                                                "sense_id": "cde9f475-8416-3cd5-9f0d-1c247bec771f",
                                                "text": "Der Gasthof war schön, aber die Zimmerfrau gar nicht freundlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                        "entry_id": "cb43eee5-940b-3aa1-9d55-d1a05175e593",
                                        "glosses": [
                                            "Bauhandwerkerin, die mit Holz arbeitet"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9b5137-7617-44f7-b0be-2c0579e93588",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Im zweiten Ausbildungsjahr lernt Sarah Griese aus Damendorf bei der Zimmerei Christian Schäfer in Eckernförde den Beruf der Zimmerfrau.“"
                                            },
                                            {
                                                "example_id": "52e17c0c-333b-4298-914b-4061a5e962bb",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Gerade mal 23 Jahre alt ist Andrea Weisrock, sie kommt aus Mainz und arbeitet seit acht Jahren als Zimmerfrau.“"
                                            },
                                            {
                                                "example_id": "92720b6f-b269-41fd-a4f6-9fff5622bae8",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Beim Rundgang auf der Baustelle in Oberwinterthur treffen wir eine Zimmerfrau, sie ist allein unter Männern.“"
                                            },
                                            {
                                                "example_id": "a38b99d3-d5d9-403b-8307-1dd091e9ce6a",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Für die Ausbildung des Zimmermannes und der Zimmerfrau wird verstärkt die Werbetrommel gerührt.“"
                                            },
                                            {
                                                "example_id": "8f482b35-279e-4df3-9365-27d91979afca",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„So ist der Beruf vom Zimmermann EFZ / Zimmerfrau EFZ der erste handwerkliche Beruf an der GIBM, welcher im Unterricht hauptsächlich mit elektronischen Hilfsmitteln arbeitet.“"
                                            },
                                            {
                                                "example_id": "5b6205b4-b24e-4487-b1cc-e9e492957619",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Erfahren Sie in einem persönlichen Gespräch mit unseren Fach- und Lehrkräften mehr über die Ausbildung und Arbeit als Zimmerfrau/-mann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
