                "senses": [
                    {
                        "sense_id": "1977fa64-b5ca-3f5c-acb2-c2082e58823c",
                        "entry_id": "6c505623-a872-3097-a55c-c001e1e8d274",
                        "glosses": [
                            "Hefe in getrockneter Form, die zum Backen verwendet wird und die länger haltbar ist als frische Hefe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654848b9-40c2-47a7-9ade-a84c19ba604a",
                                "sense_id": "1977fa64-b5ca-3f5c-acb2-c2082e58823c",
                                "text": "Daniel backt seine Mehrkornbrötchen stets mit Trockenhefe."
                            },
                            {
                                "example_id": "be3189f7-f40e-4489-8220-b01c7ec29c3d",
                                "sense_id": "1977fa64-b5ca-3f5c-acb2-c2082e58823c",
                                "text": "Die Trockenhefe muss vor dem Zugeben des warmen Wassers gut mit dem Mehl und den anderen Zutaten vermischt werden."
                            },
                            {
                                "example_id": "2f08dddb-9e95-4376-bdfd-745135f1c744",
                                "sense_id": "1977fa64-b5ca-3f5c-acb2-c2082e58823c",
                                "text": "Angesichts der vielfältigen Trockenhefen, die Anselm im Supermarkt vorfand, fiel ihm die Entscheidung für ein Produkt schwer."
                            }
                        ],
                        "sense_index_json": "\"1\""
