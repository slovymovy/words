                "senses": [
                    {
                        "sense_id": "c7ca7eac-af49-352b-9e6e-e652af2a88a0",
                        "entry_id": "f180ca45-307b-3257-a93c-30265a72d1c0",
                        "glosses": [
                            "jemand, der in einem Bereich sehr erfahren / routiniert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d1c650-7b19-479b-8478-2e7525878a72",
                                "sense_id": "c7ca7eac-af49-352b-9e6e-e652af2a88a0",
                                "text": "„Sich in den früheren, nicht mehr existenten dramatischen Routinier für eine Minute zurückzuversetzen, würde jedenfalls lehrreich sein.“"
                            },
                            {
                                "example_id": "b7139252-b830-49cd-9c3d-7ea128c06781",
                                "sense_id": "c7ca7eac-af49-352b-9e6e-e652af2a88a0",
                                "text": "„Der zuletzt zum Bankdrücker degradierte Routinier hätte gegen Barcelona wohl von Beginn an gespielt.“"
                            },
                            {
                                "example_id": "c0a41a4f-4022-424e-b0cb-008a5aa7b2d6",
                                "sense_id": "c7ca7eac-af49-352b-9e6e-e652af2a88a0",
                                "text": "Es war die erste öffentliche Wahl eines deutschen Fahnenträgers [zu einer Olympiade] und die Fans und die Sportler entschieden sich für den Tischtennis-Routinier Timo Boll. „Das macht mich stolz, dass mich sowohl die Leute als auch die Sportler sehen wollten. […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
