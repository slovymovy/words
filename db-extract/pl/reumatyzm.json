                    },
                    {
                        "translation_id": "bb082e7e-ccfe-49b7-ac9d-08eed453b664",
                        "source_entry_id": "4f87331c-3691-3b9b-a855-5cf307d40713",
                        "source_sense_id": "7fa090e3-8eed-3e6a-ace2-756d8bc0b23b",
                        "target_lang_word": "Rheumatismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rheumatismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1171193a-f283-3cd9-bf48-1c9027b0c9b7",
                                        "entry_id": "fbdc6669-4730-30ff-abab-672284f92a3c",
                                        "glosses": [
                                            "Erkrankung durch Entzündung von Gelenken, Muskeln und/oder anderen Körperteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ea3da50-242b-4817-ace9-d1a5aae21368",
                                                "sense_id": "1171193a-f283-3cd9-bf48-1c9027b0c9b7",
                                                "text": "„Auch von seinem Rheumatismus erzählt Großvater, als der ausgeheilt ist, wie von einem Beruf, in dem er sich versucht hat.“"
                                            },
                                            {
                                                "example_id": "cc56e105-fcae-44a1-84d4-60f5bb298497",
                                                "sense_id": "1171193a-f283-3cd9-bf48-1c9027b0c9b7",
                                                "text": "„Von Rheumatismen gequält, die ihre Ursache zum Teil in den Proben in einem selbst während der kältesten Februartage nicht geheizten Theater haben, ist Hoffmann ans Haus gefesselt und empfängt häufig Billetts oder Besuche von Seconda, mit dem die Zwistigkeiten zunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93d3be00-79c9-41b5-81f5-ba0ff7176384",
                        "source_entry_id": "4f87331c-3691-3b9b-a855-5cf307d40713",
                        "source_sense_id": "7fa090e3-8eed-3e6a-ace2-756d8bc0b23b",
                        "target_lang_word": "Rheuma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rheuma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11a20c2c-ff17-37f4-a84f-ea147c77d088",
                                        "entry_id": "a0a92977-abf0-344e-9246-1d20cc9f7e12",
                                        "glosses": [
                                            "allgemeine Beschwerden am Stütz- und Bewegungsapparat mit fließenden, reißenden und ziehenden Schmerzen, die oft mit funktioneller Einschränkung einhergehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e5b5b7-1471-451c-9abf-789a5e5176a9",
                                                "sense_id": "11a20c2c-ff17-37f4-a84f-ea147c77d088",
                                                "text": "„Außerdem hat Uwe schmerzhaftes Rheuma und bereits mehrere Herzoperationen hinter sich.“"
                                            },
                                            {
                                                "example_id": "4ffc491d-580d-49f2-862a-57b509dc7e71",
                                                "sense_id": "11a20c2c-ff17-37f4-a84f-ea147c77d088",
                                                "text": "„Rheuma war ihm auf den linken Arm samt Schultergelenk geschlagen, wohl eine Erinnerung an den Grabenkrieg, so daß er zu Freiübungen angehalten war.“"
                                            },
                                            {
                                                "example_id": "fa0c2f7e-0bcb-4a4e-8fab-a71e0f59c805",
                                                "sense_id": "11a20c2c-ff17-37f4-a84f-ea147c77d088",
                                                "text": "„Der Pressechef machte ihr die Anwendung von Ameisenspiritus gegen Rheuma klar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f582d902-7884-4ee0-b368-329a9803dd06",
                        "source_entry_id": "4f87331c-3691-3b9b-a855-5cf307d40713",
                        "source_sense_id": "7fa090e3-8eed-3e6a-ace2-756d8bc0b23b",
                        "target_lang_word": "ревматизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ревматизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c749226a-b4a6-3b75-bd5a-4ff12abadf02",
                                        "entry_id": "167f364b-054c-3179-8ddb-3d2816a0aae9",
                                        "glosses": [
                                            "мед. системное воспалительное заболевание соединительной ткани с преимущественным поражением сердечно-сосудистой системы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc434c6e-a729-4c36-9c3f-6676a47d9336",
                                                "sense_id": "c749226a-b4a6-3b75-bd5a-4ff12abadf02",
                                                "text": "Если перевести монолог Гертруды Борисовны на строгий язык фактов, то получилось бы, что Монька в недавнем времени переболела ревматизмом, осложнённым тяжёлым пороком сердца."
                                            },
                                            {
                                                "example_id": "e0bd1b64-03a3-48df-b6ca-538db189063d",
                                                "sense_id": "c749226a-b4a6-3b75-bd5a-4ff12abadf02",
                                                "text": "Ревматоидный артрит, вопреки тому, что принято о нем думать, никак не связан с ревматизмом, поражающим сердце (с толку сбивает латинский корень «ревма», означающий «длительное течение»)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                        "entry_id": "167f364b-054c-3179-8ddb-3d2816a0aae9",
                                        "glosses": [
                                            "разг. то же, что ревматоидный артрит; заболевание опорно-двигательного аппарата, обычно сопровождающаяся острыми болями и ломотой в суставах, возникающие с возрастом или в результате простуды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380f8048-08aa-43a7-9046-243554817c0b",
                                                "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                                "text": "Я несколько дней не выходил из дому от сильного ревматизма в правой руке."
                                            },
                                            {
                                                "example_id": "1457e127-c328-440b-a291-a15410b52063",
                                                "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                                "text": "Он богат и страдает ревматизмами."
                                            },
                                            {
                                                "example_id": "8c14bfe8-d613-439a-9ed1-1879660f56d8",
                                                "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                                "text": "Да и руки тоже болели у старика ― сказывался старческий ревматизм."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
