                "senses": [
                    {
                        "sense_id": "b906ac2e-8568-3b73-8399-3f681a7a4dce",
                        "entry_id": "e8262c39-db29-3250-ac9c-56b9f298beed",
                        "glosses": [
                            "jemand, der sich aus Feiern nichts macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518c1773-1226-4dd3-86f7-be3d6a8e41bd",
                                "sense_id": "b906ac2e-8568-3b73-8399-3f681a7a4dce",
                                "text": "„Mein Vater war ein solcher Feiermuffel, dass er noch nicht einmal den türkischen Nationalfeiertag begangen hat.“"
                            },
                            {
                                "example_id": "053a358a-015a-4419-956b-cc4a96137a58",
                                "sense_id": "b906ac2e-8568-3b73-8399-3f681a7a4dce",
                                "text": "„Und wer ein Feiermuffel ist, könne sich und seine Liebsten mit einer schönen Reise zum Geburtstag beschenken.“"
                            },
                            {
                                "example_id": "add1e177-d0db-4294-8f08-85f15f019e74",
                                "sense_id": "b906ac2e-8568-3b73-8399-3f681a7a4dce",
                                "text": "„Hartnäckig hält sich das Gerücht, dass die Evangelischen erklärte Feiermuffel sind.“"
                            },
                            {
                                "example_id": "078ec0d7-c9f3-49a9-9fbf-915ea58dd711",
                                "sense_id": "b906ac2e-8568-3b73-8399-3f681a7a4dce",
                                "text": "„Auch im Alltag beobachten wir, dass Männer Feiermuffel sind, gerade was Jahrestage angeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
