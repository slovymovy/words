                ],
                "senses": [
                    {
                        "sense_id": "9bda59c2-7bb3-3bae-89fa-9f0eafc0aa43",
                        "entry_id": "efd1d47d-b27f-37df-96a6-fe18819b219c",
                        "glosses": [
                            "Plattform, Medium für Spiele, etwa für Brettspiele"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b1dde02f-8dd2-398c-972c-c6ec93a28a4a",
                        "entry_id": "efd1d47d-b27f-37df-96a6-fe18819b219c",
                        "glosses": [
                            "Konzeption einer Veranstaltungsreihe in Spiel, Sport, Film oder Theater, Abfolge, nach der Veranstaltungen stattfinden sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052e326d-27e4-4ea5-aed2-05225e817b0d",
                                "sense_id": "b1dde02f-8dd2-398c-972c-c6ec93a28a4a",
                                "text": "„Ein eifriger Journalist zählte in den Spielplänen des vergangenen Jahres elf Antigone -Inszenierungen und erklärte die sophokleische Tragödie zum Stück der Stunde.“"
                            },
                            {
                                "example_id": "3240d2d0-9aa3-4146-aabe-08e725a2c59f",
                                "sense_id": "b1dde02f-8dd2-398c-972c-c6ec93a28a4a",
                                "text": "„Nun stehen seit einiger Zeit an deutschsprachigen Bühnen erstaunlich viele zeitgenössische amerikanische Theaterstücke auf dem Spielplan.“"
                            },
                            {
                                "example_id": "bf44b98c-642b-41d4-9f7b-e766f5be2cfe",
                                "sense_id": "b1dde02f-8dd2-398c-972c-c6ec93a28a4a",
                                "text": "„Asarenka gewann die Partie gegen Cici Bellis noch nach frühem Rückstand in drei Sätzen, doch der Ärger über den Spielplan saß tief.“"
                            },
                            {
                                "example_id": "e8d06c7b-15f3-4693-9fe9-aa7b4e6f3a01",
                                "sense_id": "b1dde02f-8dd2-398c-972c-c6ec93a28a4a",
                                "text": "„Bei der Uraufführung des Stückes in der Inszenierung von Bertold Brecht und Arnoldt Bronnen war die Empörung so groß, dass Jahnns Werk vom Spielplan abgesetzt werden musste.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d04a3a3-b0af-4c3d-9389-ab62c3782c26",
                        "source_entry_id": "efd1d47d-b27f-37df-96a6-fe18819b219c",
                        "source_sense_id": "b1dde02f-8dd2-398c-972c-c6ec93a28a4a",
                        "target_lang_word": "programme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "programme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "552692c8-92e3-3b41-9c87-9cb6db8c0117",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Écrit donnant le détail d’un événement ou d'une succession d'événements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec55448-ac2c-4c22-b202-6d4fbd330854",
                                                "sense_id": "552692c8-92e3-3b41-9c87-9cb6db8c0117",
                                                "text": "Pour compenser l’aggravation de la dette publique, la nouvelle loi réduira le programme fédéral d’aide alimentaire et imposera d’importantes coupes à Medicaid, régime d’assurance-santé pour les Américains aux revenus modestes, les plus importantes depuis son lancement dans les années 1960."
                                            },
                                            {
                                                "example_id": "36f38805-0054-4d91-ba91-f2193cc59ccb",
                                                "sense_id": "552692c8-92e3-3b41-9c87-9cb6db8c0117",
                                                "text": "Certaines communes, écrivait le préfet, à l'occasion des fêtes patronales, ou de manifestations agricoles, ont, à leur programme de réjouissances, des concours de buveurs de cidre ou autres boissons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a566e36-8afd-3eac-8131-2ca78534a827",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Suite des numéros d'artiste ou des œuvres représentées lors d’un spectacle, d’un concert, d’une fête, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d84e360-6bf3-4a9b-80bc-39c66b5a03d4",
                                                "sense_id": "3a566e36-8afd-3eac-8131-2ca78534a827",
                                                "text": "Les magnifiques music-halls terminaient chaque numéro du programme par un couplet chauvin qui soulevait des scènes d’enthousiasme éperdu ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e35aa6ea-fbb0-3a42-a193-b6243c664b1f",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Livret ou recueil où est détaillée une telle suite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dee1ad89-a036-3253-b31e-347572c1c6c4",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Groupe d'émissions radio ou télévisées, cadencées dans le temps pour une chaîne déterminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9636df-4c0e-442d-ad47-90291f447819",
                                                "sense_id": "dee1ad89-a036-3253-b31e-347572c1c6c4",
                                                "text": "[…], les chaînes de télévision ont l'ambition de fidéliser les téléspectateurs le plus tôt possible. J'ai moi-même été contacté par des « téléastes » qui voulaient me faire participer à l’élaboration et à la mise en place de programmes pour les moins d'un an !"
                                            },
                                            {
                                                "example_id": "a1721fc7-bbe5-4b9e-bd92-d288998c4355",
                                                "sense_id": "dee1ad89-a036-3253-b31e-347572c1c6c4",
                                                "text": "Le but de ces programmes, évidemment, est d'être si nazes et inregardables que les enfants préféreraient être encore en classe. Ainsi, quand ils doivent se lever le lendemain matin et se coltiner des divisions complexes, ils se diront : Au moins, je ne suis pas entrain de regarder ces affreux films à la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22b0b0c-441c-3e08-bbf0-9f58f6a1bc39",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Exposé de principes ou d’idées, de l’énumération des réformes, des mesures projetées par une personne ou une organisation politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba1f50ca-5d71-4fb7-a9ba-4c71afb54ef5",
                                                "sense_id": "d22b0b0c-441c-3e08-bbf0-9f58f6a1bc39",
                                                "text": "L’opposition a fait connaître son programme."
                                            },
                                            {
                                                "example_id": "fb224778-3d30-4a88-b2af-9f6764ddf569",
                                                "sense_id": "d22b0b0c-441c-3e08-bbf0-9f58f6a1bc39",
                                                "text": "Le programme du ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8901c7d2-ef74-3fce-baa9-3ce1f80ecb25",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Programme informatique ; ensemble d’instructions, souvent contenu dans un fichier, écrit dans un langage machine exécutable par un ordinateur."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b99c3b4-aa7a-4710-ab11-3fb21ea0d0ed",
                                                "sense_id": "8901c7d2-ef74-3fce-baa9-3ce1f80ecb25",
                                                "text": "L’ordinateur refuse d’ouvrir ce programme."
                                            },
                                            {
                                                "example_id": "276f9d91-7307-40ff-903d-c39f22bdcace",
                                                "sense_id": "8901c7d2-ef74-3fce-baa9-3ce1f80ecb25",
                                                "text": "Ce programme résout tous mes problèmes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c46235b9-e867-3823-94d5-691b3bc601a6",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Programme scolaire."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e01e511-23d0-4404-a4af-b03686c4e18c",
                                                "sense_id": "c46235b9-e867-3823-94d5-691b3bc601a6",
                                                "text": "Tenir, remplir son programme : tenir, faire exactement ce qu’on avait promis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5bccb62-703d-3d0f-8aa6-98afaf5836f4",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Thématique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b8ddd3-1d35-436b-9e4a-88399b10efec",
                                                "sense_id": "c5bccb62-703d-3d0f-8aa6-98afaf5836f4",
                                                "text": "Le programme iconographique de la chapelle Sixtine est l’histoire de l'humanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615c4b13-b979-3058-8a03-a558887d850e",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Architecture à programme : architecture imposée pour l'extérieur d'un ensemble de bâtiments, pour conserver son harmonie générale, tandis que l'architecture intérieure des édifices est libre de contraintes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b69ea33-7429-42a9-9259-23beb56b32d7",
                                                "sense_id": "615c4b13-b979-3058-8a03-a558887d850e",
                                                "text": "Le maître d’œuvre de la façade à programme tournée vers la Garonne est l’architecte Victor Louis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "881058e3-201b-357c-939b-24ff1f08bdbe",
                                        "entry_id": "469d9a90-2100-36b3-9c1c-85d2f75a8e35",
                                        "glosses": [
                                            "Document recueillant les besoins du maître d’ouvrage, les contraintes et le contexte d’une opération immobilière ou urbaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e248609c-46c9-478f-a14d-db32496ccef1",
                                                "sense_id": "881058e3-201b-357c-939b-24ff1f08bdbe",
                                                "text": "L’idée de programme comme document donnant des prescriptions relatives à un ouvrage à réaliser trouve sa concrétisation dès l’Antiquité, dans les civilisations grécoromaines."
                                            }
                                        ]
                                    }
                                ]
                            },
