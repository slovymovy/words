                        "translation_id": "16f99d20-5791-41b0-81a2-015f3cba682e",
                        "source_entry_id": "bf7edcba-4034-32ac-b990-b85d38fcccd6",
                        "source_sense_id": "1de81fc3-088b-322e-966e-23367446d702",
                        "target_lang_word": "Volksrepublik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volksrepublik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50d00c83-a6b1-392a-ac86-bfd887aac852",
                                        "entry_id": "f692ea57-b097-3abe-9f0a-0c802d866f7f",
                                        "glosses": [
                                            "Selbstbezeichnung einiger Staaten mit sozialistischer oder kommunistischer Regierung (oft strenggenommen keine tatsächliche Republik)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e2b1f82-3c8a-4319-a0c2-b7eaea3d11c5",
                                                "sense_id": "50d00c83-a6b1-392a-ac86-bfd887aac852",
                                                "text": "Die Volksrepublik China trug 2008 die Olympischen Spiele aus."
                                            },
                                            {
                                                "example_id": "60e5c86e-a609-4003-8709-c5e8633cd0b3",
                                                "sense_id": "50d00c83-a6b1-392a-ac86-bfd887aac852",
                                                "text": "„Bei seinem Besuch in der Volksrepublik Polen im November 1989 bestand Bundeskanzler Kohl auf einer Begegnung mit den ehemaligen Deutschen in Schlesien.“"
                                            },
                                            {
                                                "example_id": "54e1e876-5d77-4774-9e6d-a9a1a0c4cec3",
                                                "sense_id": "50d00c83-a6b1-392a-ac86-bfd887aac852",
                                                "text": "„Im November 1975 rief Agostinho Neto in der Hauptstadt vor tanzenden Menschen die Unabhängigkeit der Volksrepublik Angola aus.“"
                                            },
                                            {
                                                "example_id": "26543ef7-4e06-4856-a0ba-a1b50ef3dfee",
                                                "sense_id": "50d00c83-a6b1-392a-ac86-bfd887aac852",
                                                "text": "„Sie waren die ersten von vielen Einwanderern aus der Volksrepublik, die ich auf der Reise traf.“"
                                            },
                                            {
                                                "example_id": "11cec93c-90c5-4c67-b401-491562f41d68",
                                                "sense_id": "50d00c83-a6b1-392a-ac86-bfd887aac852",
                                                "text": "„Bis 1990, als sich die Volksrepublik mit dem Nordjemen wiedervereinigte, hatte die Ideologie an Kraft verloren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2401f49b-a835-4247-beb8-f1e97da0ab71",
                        "source_entry_id": "bf7edcba-4034-32ac-b990-b85d38fcccd6",
                        "source_sense_id": "1de81fc3-088b-322e-966e-23367446d702",
                        "target_lang_word": "people's republic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "people's republic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f1a234b-4c5b-3d90-a500-71f8115092ff",
                                        "entry_id": "b118ffe2-0d0e-3bec-ac79-c2e6f1c03a21",
                                        "glosses": [
                                            "A self-designation of states with Marxist–Leninist governments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f11326-ddc6-4c9f-b64f-0b3df84901ab",
                                                "sense_id": "4f1a234b-4c5b-3d90-a500-71f8115092ff",
                                                "text": "The Front’s aim is to create a new republic, a true people’s republic."
                                            },
                                            {
                                                "example_id": "d2e19931-0c65-46be-8613-801bb7b60e89",
                                                "sense_id": "4f1a234b-4c5b-3d90-a500-71f8115092ff",
                                                "text": "The Ukrainian People’s Republic brings the following to the knowledge of all belligerents: The Central Rada, on Nov. 20, proclaimed a People’s Republic"
                                            },
                                            {
                                                "example_id": "3eced8f0-2a3a-4471-8eb2-54e38f95d47e",
                                                "sense_id": "4f1a234b-4c5b-3d90-a500-71f8115092ff",
                                                "text": "Some China experts argue that the internal difficulties of the People’s Republic in the foreseeable future would prevent it from taking military attack against Taiwan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dbe799f-173f-30ef-b8c9-17e9782b87bb",
                                        "entry_id": "b118ffe2-0d0e-3bec-ac79-c2e6f1c03a21",
                                        "glosses": [
                                            "A particular area with strong, left-leaning tendencies, especially one with a certain level of autonomy."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "humorous",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b01eaebf-3e10-4a2a-a2d3-bfa73bd5b19e",
                                                "sense_id": "2dbe799f-173f-30ef-b8c9-17e9782b87bb",
                                                "text": "Remember, this study was conducted in Massachusetts, in the politically liberal climate of the “People's Republic of Cambridge,” where parents strive almost as hard to create racially nonbiased behavior in their children as they do to get them into the proper school."
                                            },
                                            {
                                                "example_id": "83cf3af2-18d1-4869-94e8-54f333929028",
                                                "sense_id": "2dbe799f-173f-30ef-b8c9-17e9782b87bb",
                                                "text": "Boulder is one of the few places in the country where you don’t pull weeds out of your garden — you mix them into your brownies. You gotta love a city that everyone refers to as, “The People’s Republic of Boulder.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1371757-934d-365e-840a-0904f05eee04",
                                        "entry_id": "b118ffe2-0d0e-3bec-ac79-c2e6f1c03a21",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see people, 's, republic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
