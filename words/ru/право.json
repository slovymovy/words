{
    "word_family": [
        "правый",
        "правда",
        "правило",
        "управлять",
        "справедливый",
        "правовой",
        "бесправие",
        "правосудие",
        "оправдание",
        "исправить"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cdc6ee7-ec09-33bf-9627-0b636fcc2204",
                    "sense_definition": "Охраняемая законом возможность что-либо делать, осуществлять или пользоваться чем-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "legal_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый человек имеет <w>право</w> на образование и медицинскую помощь.",
                            "target_lang_translations": {
                                "en": "Every person has the <w>right</w> to education and medical care.",
                                "zh": "每个人都有接受教育和医疗救助的<w>权利</w>。"
                            }
                        },
                        {
                            "text": "У вас нет никакого <w>права</w> так со мной разговаривать.",
                            "target_lang_translations": {
                                "en": "You have no <w>right</w> whatsoever to talk to me like that.",
                                "zh": "你没有<w>权利</w>这样跟我说话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "разрешение",
                        "возможность"
                    ],
                    "antonyms": [
                        "бесправие"
                    ],
                    "common_phrases": [
                        "иметь право",
                        "право на труд",
                        "авторское право",
                        "защищать свои права"
                    ],
                    "target_lang_definitions": {
                        "en": "A moral or legal entitlement to have or obtain something or to act in a certain way.",
                        "zh": "法律赋予的做某事、获得某物或以某种方式行事的资格。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "entitlement"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "权利",
                                "target_lang_sense_clarification": "法律或道德上的资格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b140e46c-0a8b-39f8-b2ec-6d3bc8ec3ccd",
                    "sense_definition": "Документ, дающий разрешение на управление транспортным средством (обычно используется во множественном числе).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я наконец-то сдал экзамен и получил водительские <w>права</w>.",
                            "target_lang_translations": {
                                "en": "I finally passed the exam and got my driver's <w>license</w>.",
                                "zh": "我终于通过了考试，拿到了<w>驾照</w>。"
                            }
                        },
                        {
                            "text": "Если ты забудешь <w>права</w> дома, тебя могут оштрафовать.",
                            "target_lang_translations": {
                                "en": "If you leave your <w>license</w> at home, you might get fined.",
                                "zh": "如果你把<w>驾照</w>忘在家里，你可能会被罚款。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "получить права",
                        "водительские права",
                        "лишить прав",
                        "сдать на права"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "в значении водительского удостоверения"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An official document authorizing a person to drive a motor vehicle.",
                        "zh": "准许个人驾驶机动车的官方证件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "license",
                                "target_lang_sense_clarification": "driving permit"
                            },
                            {
                                "target_lang_word": "driver's license",
                                "target_lang_sense_clarification": "document"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驾照",
                                "target_lang_sense_clarification": "驾驶执照"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2129e4de-ec23-3c63-b6d5-0cc91012bcd6",
                    "sense_definition": "Совокупность установленных государством общеобязательных правил и норм, регулирующих общественные отношения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты юридического факультета изучают гражданское <w>право</w>.",
                            "target_lang_translations": {
                                "en": "Law faculty students study civil <w>law</w>.",
                                "zh": "法学院的学生学习民事<w>法律</w>。"
                            }
                        },
                        {
                            "text": "Римское <w>право</w> послужило основой для многих современных законов.",
                            "target_lang_translations": {
                                "en": "Roman <w>law</w> served as the basis for many modern laws.",
                                "zh": "罗马<w>法律</w>是许多现代法律的基础。"
                            }
                        }
                    ],
                    "synonyms": [
                        "закон",
                        "юриспруденция",
                        "объективное право"
                    ],
                    "antonyms": [
                        "беззаконие"
                    ],
                    "common_phrases": [
                        "уголовное право",
                        "международное право",
                        "гражданское право"
                    ],
                    "target_lang_definitions": {
                        "en": "The system of rules which a particular country or community recognizes as regulating the actions of its members.",
                        "zh": "由国家制定并认可的，用以规范社会成员行为的规则体系。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "law",
                                "target_lang_sense_clarification": "legal system"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "法律",
                                "target_lang_sense_clarification": "法律体系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f525129-70ef-3fa0-80ae-f74647ed7b31",
                    "sense_definition": "Правая сторона, направление в правую сторону.",
                    "learner_level": "A1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребёнок ещё путает, где <w>право</w>, а где лево.",
                            "target_lang_translations": {
                                "en": "The child still confuses where <w>right</w> is and where left is.",
                                "zh": "孩子还分不清哪边是<w>右</w>，哪边是左。"
                            }
                        },
                        {
                            "text": "Посмотри на <w>право</w>, там должен быть магазин.",
                            "target_lang_translations": {
                                "en": "Look to the <w>right</w>, there should be a shop there.",
                                "zh": "往<w>右</w>看，那里应该有个商店。"
                            }
                        }
                    ],
                    "antonyms": [
                        "лево"
                    ],
                    "target_lang_definitions": {
                        "en": "The direction or side that is on the east when one faces north; opposite of left.",
                        "zh": "与左相对的方向或方位。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "direction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "右",
                                "target_lang_sense_clarification": "方位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1604ef18-5d5a-3a38-90f9-ad4ff8d1dd5b",
                    "sense_definition": "Вводное слово, выражающее уверенность, подтверждение или удивление; честное слово.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я, <w>право</w>, не знаю, как вам помочь в этой ситуации.",
                            "target_lang_translations": {
                                "en": "I, <w>really</w>, don't know how to help you in this situation.",
                                "zh": "我<w>实在</w>不知道在这种情况下该怎么帮你。"
                            }
                        },
                        {
                            "text": "Это было, <w>право</w>, самое весёлое приключение за всё лето.",
                            "target_lang_translations": {
                                "en": "It was, <w>indeed</w>, the most fun adventure of the whole summer.",
                                "zh": "这<w>确实</w>是整个夏天最有趣的冒险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "честное слово",
                        "право слово"
                    ],
                    "common_phrases": [
                        "да право же"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "или книжное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize a statement or express surprise; honestly or truly.",
                        "zh": "用于强调陈述或表达惊讶，意为“确实”、“真的”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "intensifier"
                            },
                            {
                                "target_lang_word": "indeed",
                                "target_lang_sense_clarification": "confirmation"
                            },
                            {
                                "target_lang_word": "truly",
                                "target_lang_sense_clarification": "honestly"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实在",
                                "target_lang_sense_clarification": "强调真实性"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "表示确认"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "595528a9-ba3e-3adf-bbf6-d8d3722074c8",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>правый</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наше дело <w>право</w>, мы обязательно победим.",
                            "target_lang_translations": {
                                "en": "Our cause is <w>right</w>, we will definitely win.",
                                "zh": "我们的事业是<w>正义</w>的，我们一定会胜利。"
                            }
                        },
                        {
                            "text": "Твоё решение абсолютно <w>право</w> и справедливо.",
                            "target_lang_translations": {
                                "en": "Your decision is absolutely <w>right</w> and fair.",
                                "zh": "你的决定绝对是<w>正确</w>且公正的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткое прилагательное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Being in accordance with fact, reason, or truth; correct or just.",
                        "zh": "符合事实、道理或真理；正确的或公正的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "correct/just"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正确",
                                "target_lang_sense_clarification": "符合事实"
                            },
                            {
                                "target_lang_word": "正义",
                                "target_lang_sense_clarification": "公正"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}