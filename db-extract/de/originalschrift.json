                ],
                "senses": [
                    {
                        "sense_id": "a197a5cd-191e-3555-bcaa-46d2884d03f1",
                        "entry_id": "410fccb1-a176-3620-a177-3d2d2edb7e2d",
                        "glosses": [
                            "ursprüngliche Fassung eines Textes, oft eines Manuskripts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674215a6-9a30-4060-bd92-c64d7b67c0bd",
                                "sense_id": "a197a5cd-191e-3555-bcaa-46d2884d03f1",
                                "text": "„So überlebte auch ein Großteil der Originalschriften, die sogenannten Veden, die mittlerweile aus dem Sanskrit in viele moderne Sprachen übersetzt worden sind.“"
                            },
                            {
                                "example_id": "54d5cb3c-bf58-46bb-bed8-1955b65e3ef9",
                                "sense_id": "a197a5cd-191e-3555-bcaa-46d2884d03f1",
                                "text": "„Etwas problematisch ist bei dieser philosophischen Strömung, dass sie, wie erwähnt, keinerlei Originalschriften hinterlassen hat, sondern sich das historische Bild insbesondere aus Überlieferungen und Legenden manifestiert.“"
                            },
                            {
                                "example_id": "4c37edef-928d-4286-b688-4ba884df26c6",
                                "sense_id": "a197a5cd-191e-3555-bcaa-46d2884d03f1",
                                "text": "„Die Originalschriften enthalten sowohl Anleitungen zur Herstellung von Heilmitteln, u.a. von Elixieren (Kräuterwein-Zubereitungen) und Salben, als auch Anweisungen zur Anwendung dieser Zubereitungen.“"
                            },
                            {
                                "example_id": "9f12c485-fd7c-483e-aef8-8a540a451501",
                                "sense_id": "a197a5cd-191e-3555-bcaa-46d2884d03f1",
                                "text": "„Sicher ist jedenfalls, dass in seinen Originalschriften Crowley nie einen klaren Hinweis auf direkte Negativität gegeben hat.“"
                            },
                            {
                                "example_id": "b2dd3eda-c8f1-4833-97db-3ae87600d156",
                                "sense_id": "a197a5cd-191e-3555-bcaa-46d2884d03f1",
                                "text": "„Diesen Absatz habe ich als Teil 2 aus der Originalschrift kopiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
