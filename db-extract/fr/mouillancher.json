                            {
                                "example_id": "decf8e55-d6f4-4387-a609-7f65265d72c0",
                                "sense_id": "b8e8104c-6655-3766-9f8f-49673abefdf9",
                                "text": "Effectivement la pluie a un endroit du circuit et de de l'autre du sec, juste une pluie pour mouillancher de quoi nous offrir des rebondissements un grand prix de belgique comme celui de 1991 avec Senna qui reste en slick et qui perd le grand prix tout comme les Williams-Renault et qui couronne pour la première fois un certain Michael Schumacher."
                            },
                            {
                                "example_id": "05564876-fda6-436d-8f4c-7f97a1e866b2",
                                "sense_id": "b8e8104c-6655-3766-9f8f-49673abefdf9",
                                "text": "Passé le péage de Reims, ca commençait à mouillancher."
                            },
                            {
                                "example_id": "65de2e42-ffcc-440b-9e7d-ff8d488efe3b",
                                "sense_id": "b8e8104c-6655-3766-9f8f-49673abefdf9",
                                "text": "Localisation: Le \"pays\" où ça \"mouillanche\"."
