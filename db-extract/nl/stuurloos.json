                    {
                        "translation_id": "42070391-3ed5-48d9-891b-4fb401e21aa2",
                        "source_entry_id": "fa655e6a-9281-3d99-bafc-dff78eeede76",
                        "source_sense_id": "cc85f22f-7bb6-380c-86e1-a441a8474ab1",
                        "source_sense_description": "zonder sturing in mechanisch opzicht",
                        "target_lang_word": "out of control",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "out of control",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b192be44-222d-311b-9fbe-3c79db81bc86",
                                        "entry_id": "01e034c9-e9ee-3a8f-83bd-3d054ca8937e",
                                        "glosses": [
                                            "Not under control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee59d45-600e-41b0-9098-b1a0e1e7677b",
                                                "sense_id": "b192be44-222d-311b-9fbe-3c79db81bc86",
                                                "text": "The economy is out of control and is headed for a crash."
                                            },
                                            {
                                                "example_id": "7a4bfa14-768a-4d02-a9d7-ab4026e8bf15",
                                                "sense_id": "b192be44-222d-311b-9fbe-3c79db81bc86",
                                                "text": "The correspondence in these columns about locomotive slipping, which has been proceeding for some months past, is tending to get out of control, and it is necessary, despite the interest of the subject, to bring it to a close."
                                            },
                                            {
                                                "example_id": "2d76f2b2-9477-495d-be5a-5f102c3860a7",
                                                "sense_id": "b192be44-222d-311b-9fbe-3c79db81bc86",
                                                "text": "The UN secretary general has said that “climate change is out of control”, as an unofficial analysis of data showed that average world temperatures in the seven days to Wednesday were the hottest week on record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbaf93b9-23d7-3573-90f6-7bc90072f1ec",
                                        "entry_id": "01e034c9-e9ee-3a8f-83bd-3d054ca8937e",
                                        "glosses": [
                                            "Not controllable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "048e35b1-7da0-4d8d-823b-7659fdacd2e0",
                                                "sense_id": "cbaf93b9-23d7-3573-90f6-7bc90072f1ec",
                                                "text": "The airplane went out of control after its flight-control system failed."
                                            },
                                            {
                                                "example_id": "7fa6f122-8eb9-4ec4-8b39-f68e2086d310",
                                                "sense_id": "cbaf93b9-23d7-3573-90f6-7bc90072f1ec",
                                                "text": "A coal train running into Bangor got out of control, with the result that the engine crashed through the buffers, and the leading bogie and driving wheels mounted the platform beyond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4779e4eb-0e6a-3b44-a3c7-5e8c2e55e140",
                                        "entry_id": "01e034c9-e9ee-3a8f-83bd-3d054ca8937e",
                                        "glosses": [
                                            "Not in control of one's actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7af9392-11f2-4e89-a204-89ab4caa1b1e",
                                                "sense_id": "4779e4eb-0e6a-3b44-a3c7-5e8c2e55e140",
                                                "text": "Your children are completely out of control. Can you stop them running around like that?"
                                            },
                                            {
                                                "example_id": "ac3b733a-427e-4040-a625-c23167b4a2b9",
                                                "sense_id": "4779e4eb-0e6a-3b44-a3c7-5e8c2e55e140",
                                                "text": "“The time is now for the United Nations and the rest of the world to jointly stand up against China and its lawless and out-of-control bullying of Taiwan,” they said, adding: “Enough is Enough.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0a47050-31a1-4e73-be4c-311a2527cef0",
                        "source_entry_id": "fa655e6a-9281-3d99-bafc-dff78eeede76",
                        "source_sense_id": "cc85f22f-7bb6-380c-86e1-a441a8474ab1",
