                                    {
                                        "sense_id": "5c08863d-b2b6-38cc-91df-33009a305f47",
                                        "entry_id": "0d8fe518-c4ee-311a-aea4-79388880b05a",
                                        "glosses": [
                                            "das Verneinen oder die Tatsache, dass man zu einem Sachverhalt „nein“ gesagt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3237f2ef-e04f-40c5-b223-44a0be75adef",
                                                "sense_id": "5c08863d-b2b6-38cc-91df-33009a305f47",
                                                "text": "War das nun eine Verneinung oder nicht?"
                                            },
                                            {
                                                "example_id": "d895bb63-4a7e-48c0-9076-de68f8bc7f47",
                                                "sense_id": "5c08863d-b2b6-38cc-91df-33009a305f47",
                                                "text": "Die Verneinung der Frage klang mir nicht überzeugend."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fdbf93e0-d606-306c-b262-14d8483b2f23",
                                        "entry_id": "0d8fe518-c4ee-311a-aea4-79388880b05a",
                                        "glosses": [
                                            "das Negieren einer Frage oder eines Satzes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d01f947-4312-4137-96c6-af17906300a0",
                                                "sense_id": "fdbf93e0-d606-306c-b262-14d8483b2f23",
                                                "text": "Die Negationspartikel nein drückt eine Verneinung aus."
                                            },
                                            {
                                                "example_id": "722ad346-f49d-4fcc-a17d-edfd7ff35275",
                                                "sense_id": "fdbf93e0-d606-306c-b262-14d8483b2f23",
                                                "text": "„Regelwidrig sind nach den aktuell gültigen Vorschriften nicht nur Genitiv und Konjunktiv, sondern auch Synonyme und Sonderzeichen, Verneinungen und Passivkonstruktionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdd9597a-72a3-422a-ad8d-11c96ac0678d",
                        "source_entry_id": "74857e94-f269-33ae-ab07-a042147bcf4f",
                        "source_sense_id": "2b0dbed8-201d-3ac6-8d3a-ea952165d215",
                        "source_sense_description": "handeling of uiting waarmee iemand kan laten weten dat iets niet waar is",
                        "target_lang_word": "Leugnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leugnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23714774-26d6-34f7-979f-dcdd689ae44e",
                                        "entry_id": "72d12cd9-5771-317c-8951-9a1d7d611b1a",
                                        "glosses": [
                                            "Abstreitung von etwas; keine Eingestehung der Wahrheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddbe888a-4ae7-40da-ab19-c64aca5f31f6",
                                                "sense_id": "23714774-26d6-34f7-979f-dcdd689ae44e",
                                                "text": "Solange die Leugnung von ihrer Seite besteht, dass sie ihn umgebracht hat, können wir sie nicht festnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38fe36c2-d5cc-30f9-a21f-22c6ef1781ed",
                                        "entry_id": "72d12cd9-5771-317c-8951-9a1d7d611b1a",
                                        "glosses": [
                                            "Nicht-Anerkennung von etwas Allgemeingültigem oder einer Weltanschauung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6edc09ef-68c2-43e6-9876-70908e03ed0a",
                                                "sense_id": "38fe36c2-d5cc-30f9-a21f-22c6ef1781ed",
                                                "text": "Er hat seine Leugnung der Evolutionstheorie nicht zurückgenommen."
                                            },
                                            {
                                                "example_id": "9ed65d69-7853-42f5-a5dc-1e0808742162",
                                                "sense_id": "38fe36c2-d5cc-30f9-a21f-22c6ef1781ed",
                                                "text": "„Die Erderwärmung ist global – und deren Leugnung ebenso.“"
                                            },
                                            {
                                                "example_id": "021ff02c-0684-41fb-b0de-2eba39879365",
                                                "sense_id": "38fe36c2-d5cc-30f9-a21f-22c6ef1781ed",
                                                "text": "[Was geschah am 26. Januar 2007?] „Die UN-Vollversammlung in New York verabschiedet eine Resolution, die eine Leugnung des Holocaust verurteilt.“"
                                            },
                                            {
                                                "example_id": "679f3188-7d0c-4eae-9580-4c39614179fd",
                                                "sense_id": "38fe36c2-d5cc-30f9-a21f-22c6ef1781ed",
                                                "text": "„Ihm wird die systematische Leugnung bzw. Verharmlosung des NS-Völkermords an den Juden in Schriften und Internet-Auftritten zur Last gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bc35e4a-54a7-45e2-9970-a782d157b3a2",
                        "source_entry_id": "74857e94-f269-33ae-ab07-a042147bcf4f",
                        "source_sense_id": "2b0dbed8-201d-3ac6-8d3a-ea952165d215",
                        "source_sense_description": "handeling of uiting waarmee iemand kan laten weten dat iets niet waar is",
                        "target_lang_word": "abnegation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnegation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                        "entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                                        "glosses": [
                                            "A denial; a renunciation; denial of desire or self-interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19308f5a-e2d3-4761-9a5f-78af699e4eb4",
                                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                                "text": "With abnegation of God, of his honor, and of religion, they may retain the friendship of the court."
                                            },
                                            {
                                                "example_id": "b9afd4d4-d9d6-49ba-977d-46a492fad771",
                                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                                "text": "Tony's face expressed relief, and Nettie sat silent for a moment until the vicar said “It was a generous impulse, but it may have been a momentary one, while in the case of monk and crusader there must have been a sustaining purpose, and possibly a great abnegation, a leaving of lands and possessions.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb127304-b950-4aba-ad54-cce272e4e4ad",
                        "source_entry_id": "74857e94-f269-33ae-ab07-a042147bcf4f",
                        "source_sense_id": "2b0dbed8-201d-3ac6-8d3a-ea952165d215",
                        "source_sense_description": "handeling of uiting waarmee iemand kan laten weten dat iets niet waar is",
                        "target_lang_word": "denial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5655792-40fc-3a38-bc7c-616ade3d4b96",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "An assertion of untruth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d960000-6a55-4e4b-af12-c2238c2dcb65",
                                                "sense_id": "c5655792-40fc-3a38-bc7c-616ade3d4b96",
                                                "text": "The singer has issued a sweeping denial of all the rumors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b59c881-ecec-3d96-8edf-4b0ef7d90a36",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "The negation in logic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "effae584-9acc-447b-b8b2-8a593b4f495b",
                                                "sense_id": "4b59c881-ecec-3d96-8edf-4b0ef7d90a36",
                                                "text": "The denial of \"There might be X\" is the null, \"False, there is no X.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "A refusal or failure to provide or grant something that is requested or desired."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9c4c4b-bf05-45c8-afa4-62ab79bae3dd",
                                                "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                                "text": "The denial of medical treatment to those who cannot afford to pay is scandalous."
                                            },
                                            {
                                                "example_id": "e895fc30-e00c-48cd-ae30-759fdae735fe",
                                                "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                                "text": "I cannot understand the bank's denial of my loan application."
                                            },
                                            {
                                                "example_id": "4848e4de-69c5-4149-b129-c765d0c553cf",
                                                "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                                "text": "Every time we asked for an interview we got a denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26fa6cf-7d1f-31c9-9fad-1eec8682af6c",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "Refusal to believe that a problem exists."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e31feb7-f07e-45b5-9847-958edd9789d2",
                                                "sense_id": "f26fa6cf-7d1f-31c9-9fad-1eec8682af6c",
                                                "text": "We couldn't break through his denial about being alcoholic."
                                            },
                                            {
                                                "example_id": "253ca942-1ebd-4259-8b69-2ca39649c1a7",
                                                "sense_id": "f26fa6cf-7d1f-31c9-9fad-1eec8682af6c",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. When a series of bank failures made this impossible, there was widespread anger, leading to the public humiliation of symbolic figures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c3a5a2-f856-383f-b35b-612e1b5c3826",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "Refusal to admit responsibility for wrongdoing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80fedd95-65c9-4d8b-9f34-9419e8c75d17",
                                                "sense_id": "44c3a5a2-f856-383f-b35b-612e1b5c3826",
                                                "text": "Denial is the first act when the perpetrator refutes the very nature of the planned measures, explaining the steps as justified and legitimate actions to cope with the identified problem. The denial then lives on during the different stages of the genocide and is invoked continuously by the perpetrator whenever its actions are criticized or labeled as atrocities and unlawful. At the end, once the practical stages have had their course, all that remains and thrives is the denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0ce3708-e398-3d73-8968-34452aed4419",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "Negationism, denialism of historical facts or accepted interpretation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe43ce8d-d090-4703-8ed0-e412047b226e",
                                                "sense_id": "a0ce3708-e398-3d73-8968-34452aed4419",
                                                "text": "However, just as genocide is understood by some—including Raphael Lemkin—as a kind of radical, perverse act of creation, so too, denial does not aim only at a negation of reality but also at the creation of a new reality."
                                            },
                                            {
                                                "example_id": "a0ef3812-2b64-4ab9-9676-cc314a738523",
                                                "sense_id": "a0ce3708-e398-3d73-8968-34452aed4419",
                                                "text": "The sheer length of the list demonstrates the hold denial wields over states and societies, a power that may be best understood empirically by delving further into the two best-documented cases of Holocaust and Armenian [genocide] denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "481b4f7e-2b15-3cf2-a555-9a6984891b52",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "A defense mechanism involving a refusal to accept the truth of a phenomenon or prospect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31c422ad-5bbc-4e3f-b0e4-efda297adc3a",
                                                "sense_id": "481b4f7e-2b15-3cf2-a555-9a6984891b52",
                                                "text": "He is in denial that he has a drinking problem."
                                            },
                                            {
                                                "example_id": "f18fdbdb-8c55-4edb-b271-67b16a46c35f",
                                                "sense_id": "481b4f7e-2b15-3cf2-a555-9a6984891b52",
                                                "text": "\"Denial\" came out of the therapyspeak prevalent in the middle of the 20th century, especially as it was applied to confronting the reality of mortality. It was popularized as the first stage of grief, and quickly expanded to include refusal to confront any bad news or disturbing ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c167f6-d0e9-395e-a1d9-f5947971e418",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "A disownment or disavowal"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d8a697-0ec4-4a4c-8d97-34b66aee9b87",
                                                "sense_id": "20c167f6-d0e9-395e-a1d9-f5947971e418",
                                                "text": "The denial of Jesus by Peter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fe5c3d2-8b8b-4104-9623-22d98d7152f0",
                        "source_entry_id": "74857e94-f269-33ae-ab07-a042147bcf4f",
