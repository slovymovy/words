                "senses": [
                    {
                        "sense_id": "4c1bac74-5769-3990-8d37-efcbc9cfe50e",
                        "entry_id": "d03f5659-8b19-3a8b-8236-7c7e9fa994d9",
                        "glosses": [
                            "Pferd, das einen Schlitten zieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1efd4e63-d871-4263-aa48-c7a8e9bfbbcb",
                                "sense_id": "4c1bac74-5769-3990-8d37-efcbc9cfe50e",
                                "text": "„Mit drei Siegen und fünf zweiten Plätzen bei Winterrennen in ganz Tirol erkämpfte sich die junge Stute den Titel ‚Schlittenpferd des Jahres 2016‘ in der Kategorie Norikerfahrer.“"
                            },
                            {
                                "example_id": "7b316cc8-90f3-4e59-ac65-389c6a62fcc7",
                                "sense_id": "4c1bac74-5769-3990-8d37-efcbc9cfe50e",
                                "text": "„Er erlebt das haarsträubende Abenteuer mit dem Wolf, der ein Schlittenpferd bei lebendigem Leib frisst und dem der Baron im rasenden Lauf das Geschirr überstülpt, so dass der Wolf ihn bis nach St. Petersburg zieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
