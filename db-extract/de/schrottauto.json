                "senses": [
                    {
                        "sense_id": "55d58a23-d92d-33e0-8d96-1e29c950d9c2",
                        "entry_id": "d5f08c9e-0ef6-320d-b668-f4bdfb41aad2",
                        "glosses": [
                            "Kraftfahrzeug (für Personen), das sich in einem sehr schlechten allgemeinen Zustand befindet (und nicht mehr fahrtüchtig, sondern schrottreif ist)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b0647072-506e-4296-84ac-3ba788e4b798",
                                "sense_id": "55d58a23-d92d-33e0-8d96-1e29c950d9c2",
                                "text": "„In Bremerhaven wird gerade die nächste Fähre nach Westafrika beladen. Schrottauto auf Schrottauto schieben die Ladearbeiter mit ihren Buggys auf die Fähre.“"
                            },
                            {
                                "example_id": "4a55f18c-930b-46c2-ba25-e6463e097372",
                                "sense_id": "55d58a23-d92d-33e0-8d96-1e29c950d9c2",
                                "text": "„Wurden ägyptische Mumien zu Forschungszwecken früher wie Schrottautos auseinander genommen, betrachtet man heute vor Jahrtausenden verblichene menschliche Körper als Patienten, die es zu pflegen gilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0099340b-eeed-42f7-b6c5-a2aa498ebeaa",
                        "source_entry_id": "d5f08c9e-0ef6-320d-b668-f4bdfb41aad2",
                        "source_sense_id": "55d58a23-d92d-33e0-8d96-1e29c950d9c2",
                        "target_lang_word": "épave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a545ebea-dfe6-3ec7-b7ca-762baf0f9e02",
                                        "entry_id": "63f718e1-273f-3f28-a874-1a32b71dcc14",
                                        "glosses": [
                                            "Qui est égaré et dont on ne connaît pas le propriétaire. S’utilise surtout pour les animaux d’élevage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5ecffe-cf85-4674-973e-1d1a924b423a",
                                                "sense_id": "a545ebea-dfe6-3ec7-b7ca-762baf0f9e02",
                                                "text": "Un cheval épave."
                                            },
                                            {
                                                "example_id": "46897782-ffdf-4984-8644-5f3d77215db3",
                                                "sense_id": "a545ebea-dfe6-3ec7-b7ca-762baf0f9e02",
                                                "text": "Des biens épaves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e888e4d-2775-3914-8950-c110ae376ef8",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Objet flottant rejeté par la mer sur la terre ferme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab4732a8-a93c-44f1-9d21-8b3899fbe637",
                                                "sense_id": "6e888e4d-2775-3914-8950-c110ae376ef8",
                                                "text": "Mais une épave, un reste de carcasse, le tronçon d’un mât, une hune brisée, quelques planches, cela résiste, cela surnage, cela ne peut fondre!"
                                            },
                                            {
                                                "example_id": "4f508577-3eee-4388-884a-f1c4b55be932",
                                                "sense_id": "6e888e4d-2775-3914-8950-c110ae376ef8",
                                                "text": "Il est possible que des épaves ou des embarcations aient été drossées à terre, et que des baleiniers survivants aient vécu avec les indigènes il y a cent-cinquante ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "195f20d8-84e4-345b-acb3-65864b0a1e55",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Embarcation qui a sombré."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "999f8a5b-5637-3ede-8ef1-bb1907ada1ab",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Véhicule rendu inutilisable suite à un accident, ou par la corrosion ou le pourrissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849cdad5-a2ae-4d30-a4b8-79f4828b74f5",
                                                "sense_id": "999f8a5b-5637-3ede-8ef1-bb1907ada1ab",
                                                "text": "En théorie il retape ces épaves : passage au marbre, tôlerie, mécanique, toujours réglo ; puis il revend les épaves remises à neuf, enfin, c'est ce qui apparaît au grand jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b959e5e5-c5bc-3f8e-8e42-038a55d524ef",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Débris qui restent après un cataclysme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5eb87296-8fed-316f-aa8b-402fc1037b02",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Personne tombée dans un état de détresse et d'impuissance physique et morale extrême."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf34c04b-6a46-493b-91c6-d32d7c009cac",
                                                "sense_id": "5eb87296-8fed-316f-aa8b-402fc1037b02",
                                                "text": "Je l’avoue honteusement, comme beaucoup d’automobilistes qui passent par là tous les jours, parfois je me dis : « Encore eux. Saouls comme ils l’étaient hier. Des épaves. »"
                                            },
                                            {
                                                "example_id": "286b074c-873c-4c88-bd28-53ab5e77fcb9",
                                                "sense_id": "5eb87296-8fed-316f-aa8b-402fc1037b02",
                                                "text": "Et si tu avais fait ça, Myron, ai-je poursuivi, impitoyable, ma mère ne serait pas devenue une épave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Ce qui subsiste d’une fortune ruinée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64afc337-fb54-4b63-90bd-dd2ba99846bc",
                                                "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                                "text": "Il eut bien de la peine à recueillir quelques épaves de sa fortune."
                                            },
                                            {
                                                "example_id": "f7c9ca12-1104-47b6-ae0e-e0a28de41a12",
                                                "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                                "text": "Toute cette fortune est perdue ; il sera bien heureux s’il en recueille quelques épaves."
                                            },
                                            {
                                                "example_id": "446e1e8e-ec95-4d23-97b0-87384b832dcf",
                                                "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                                "text": "Aurélien, Dioclétien, Maxence font exception ; de ceux-là il reste des monuments et des monuments considérables, épaves de ce grand naufrage de l’empire romain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0f108d4-cd9c-337b-949a-e8b17368a8eb",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Chose perdue et non réclamée dont la propriété revient à l’État."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab1fc47-6b0c-448d-a9ff-e8f69bd70ca5",
                                                "sense_id": "d0f108d4-cd9c-337b-949a-e8b17368a8eb",
                                                "text": "Les animaux à pied fourchu appartiennent au pacha dans les épaves."
                                            },
                                            {
                                                "example_id": "32cf685b-1fdf-4efa-badb-5f62746deaac",
                                                "sense_id": "d0f108d4-cd9c-337b-949a-e8b17368a8eb",
                                                "text": "— Dans ce document, il n'est même pas fait mention de bois mort et de mort-bois, tellement ces épaves appartenaient de droit aux pauvres gens, comme espèce de part à Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
