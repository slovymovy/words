    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                "word": "Inquisition",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02b6de3f-12f2-32ab-9587-83b64b21a480",
                        "entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                        "glosses": [
                            "A tribunal of the Roman Catholic Church set up to investigate and suppress heresy."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9969d83d-b2fb-4c3e-8c9e-60967b5cc9f1",
                                "sense_id": "02b6de3f-12f2-32ab-9587-83b64b21a480",
                                "text": "We know from history that the Catholic Church has historically murdered, mutilated, castrated, maimed, imprisoned and flogged homosexuals. Catholic atrocities during the Inquisition are well documented and cannot be denied. The Church no longer does those things to homosexuals, but it violates their human rights in other ways."
                            }
                        ]
                    },
                    {
                        "sense_id": "554741d1-fc02-31a9-9a89-b9e6e616202d",
                        "entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                        "glosses": [
                            "A harsh or rigorous interrogation that violates one’s rights."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7098f07-991e-4e31-9e2a-dc85333bfc6c",
                        "source_entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                        "source_sense_description": "tribunal of the Roman Catholic Church",
                        "target_lang_word": "inkvizice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b54921b0-d3bb-460d-af1b-4756913b9834",
                        "source_entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                        "source_sense_description": "tribunal of the Roman Catholic Church",
                        "target_lang_word": "Inquisition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "952ce3df-cc7d-4b2a-ba7b-4d24b0cfe46e",
                        "source_entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                        "source_sense_description": "tribunal of the Roman Catholic Church",
                        "target_lang_word": "Inquisition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inquisition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                        "entry_id": "efc6103c-ee54-39da-ad1e-dfb6fc7bbe06",
                                        "glosses": [
                                            "Gericht der Kirche gegen Abtrünnige und solche, die Glaubenslehren ablehnten"
                                        ],
                                        "tags": [
                                            "zwischen dem 12. und dem 18. Jahrhundert"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cc4acc-b459-4602-a22d-426ba73b8a9b",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Anna Schwegelin wurde nicht durch die Inquisition, sondern durch ein weltliches Gericht zum Tode verurteilt."
                                            },
                                            {
                                                "example_id": "035b0f31-15e2-4cac-98ad-de2aff91c338",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Giordano Bruno entging der Inquisition nicht."
                                            },
                                            {
                                                "example_id": "98329778-2ae6-4218-87db-b59d33847f08",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„In manchen Kreisen hält sich hartnäckig das Gerücht, dies sei die moderne Variante der Inquisition.“"
                                            },
                                            {
                                                "example_id": "69a2836c-29f4-4773-9e22-412dd3034ea5",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Aber die Inquisition hatte zumindest keinen Hehl aus ihrem Tun gemacht.“"
                                            },
                                            {
                                                "example_id": "4a53ef48-b7e1-4ebf-956e-7973210e5fd3",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Ich wurde ein gewisses Angstgefühl der Inquisition gegenüber nicht los, und mir schien, als seien mir bereits einige Spitzel auf den Fersen.“"
                                            },
                                            {
                                                "example_id": "cb3474b3-0fd6-4336-ad67-3f1c57b72514",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Durch nichts hat das Christentum sich selbst, seiner eigenen Substanz nach so verraten und geschädigt wie mit den von der Inquisition entfesselten Verfolgungen, Folterungen und grausamen Hinrichtungen von Tausenden christlicher Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e076140-ce2c-4617-995e-5804864d4299",
                        "source_entry_id": "536b5884-fec6-349f-b8b4-47e056601bbf",
                        "source_sense_description": "tribunal of the Roman Catholic Church",
                        "target_lang_word": "Glaubensgericht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
