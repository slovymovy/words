                        "glosses": [
                            "tentoonstelling waar nieuwe elektronische apparatuur wordt getoond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92296a12-1ebd-4547-9fb4-54bda6856de6",
                                "sense_id": "26f91d57-70f6-3486-ba61-d664375cf760",
                                "text": "...en verlang je terug naar toen? Sony heeft tijdens de elektronicabeurs CES een Walkman gepresenteerd die 1200 euro kost. De Walkman ZX2 speelt allerlei audioformaten af, schrijft techwebsite Tweakers. De walkman lijkt qua uiterlijk best op een smartphone en draait op Android. Voor al die honderden euro's krijg je dan wel een touchscreen en kun je apps downloaden."
                            },
                            {
                                "example_id": "1c7454e5-57ed-48c2-afd2-28a767274b62",
                                "sense_id": "26f91d57-70f6-3486-ba61-d664375cf760",
                                "text": "Vorige week heeft Samsung ook zijn nieuwe versie van de tablet, de Galaxy Tab 7.7 van de grootste elektronicabeurs in Berlijn, IFA, moeten halen."
                            },
                            {
                                "example_id": "36909464-5827-4ee1-80a4-5e31b443584a",
                                "sense_id": "26f91d57-70f6-3486-ba61-d664375cf760",
                                "text": "Het toestel dat Samsung op de CES-elektronicabeurs presenteerde heeft een schermdiagonaal van 216 cm. Als de tv niet wordt gebruikt is het scherm recht, maar ingeschakeld kan hij met een afstandbediening worden gekromd."
                            }
                        ]
                    }
