                                "target_senses": [
                                    {
                                        "sense_id": "a4fb42ed-b916-3dff-a574-8f68f02019c0",
                                        "entry_id": "b37c5730-56e0-39b0-b45c-75631b2fe087",
                                        "glosses": [
                                            "The amount of time between the initiation of some process and its completion, e.g. the time required to manufacture or procure a product; the time required before something can be provided or delivered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ee90cb9-4380-41c0-a249-c37cb07a2835",
                                                "sense_id": "a4fb42ed-b916-3dff-a574-8f68f02019c0",
                                                "text": "It's an excellent device, but it has a 10-week lead time, so be sure to order it in advance."
                                            },
                                            {
                                                "example_id": "1965556d-9a38-4253-b6d2-51d84be04dd1",
                                                "sense_id": "a4fb42ed-b916-3dff-a574-8f68f02019c0",
                                                "text": "With long lead times in timetable planning WMT [West Midlands Trains] has stated that the earliest it can recast the timetable will be May 2020."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
