                "senses": [
                    {
                        "sense_id": "f41d9b3b-284f-3b8d-a738-4521f9680f29",
                        "entry_id": "8a58e230-9c81-31a7-b0b9-9e722d98e70e",
                        "glosses": [
                            "Globule blanc (leucocyte) issu de la différenciation des lymphocytes B, présent normalement dans les tissus lymphoïdes et producteur d’anticorps."
                        ],
                        "tags": [
                            "Biologie cellulaire"
                        ],
                        "examples": [
                            {
                                "example_id": "c9756aa1-be3e-436f-b8a7-16630177ac0b",
                                "sense_id": "f41d9b3b-284f-3b8d-a738-4521f9680f29",
                                "text": "Lors d’une infection, chaque plasmocyte produit environ 2000 copies d’un même anticorps par seconde."
                            },
                            {
                                "example_id": "76034ff5-b6b0-4828-b93f-a96a4d531e2e",
                                "sense_id": "f41d9b3b-284f-3b8d-a738-4521f9680f29",
                                "text": "[…] des lymphocytes B. Ces derniers, face à des éléments étrangers, se multiplient rapidement pour former des cellules plus grandes, les plasmocytes, qui sécrètent des anticorps dans le sang et les autres fluides corporels."
                            }
                        ]
                    }
                ],
