                "senses": [
                    {
                        "sense_id": "ba5e9958-e6d2-3133-a31c-21bd80a4bf40",
                        "entry_id": "99433a2b-203f-323a-93fc-3382944e858e",
                        "glosses": [
                            "Qui a été cousu à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda22b12-98ff-4947-b250-148bbad863c4",
                                "sense_id": "ba5e9958-e6d2-3133-a31c-21bd80a4bf40",
                                "text": "Et lorsqu’il la recouvrait d’un bandeau, afin de préserver sa peau fraîchement recousue de la noircissure que grave le soleil, il semblait un hippy ou un Indien de cinéma."
                            },
                            {
                                "example_id": "c4cf138a-38f2-4758-89d3-5df2e0c01293",
                                "sense_id": "ba5e9958-e6d2-3133-a31c-21bd80a4bf40",
                                "text": "Son bec-de-lièvre, mal recousu, laissait voir ses incisives, et des linges embobelinaient sa joue, tuméfiée par une énorme fluxion."
                            }
                        ]
                    }
                ],
