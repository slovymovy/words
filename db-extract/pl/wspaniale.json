                                "target_word": "великолепно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f40f6736-bf2f-3c4d-b462-5ab79d16e1bf",
                                        "entry_id": "abb0b13a-8b74-345f-9c1b-2b731c98a270",
                                        "glosses": [
                                            "наречие к великолепный; в высшей степени хорошо"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "521c1591-4feb-4d00-b5fc-8044e173ee0f",
                                                "sense_id": "f40f6736-bf2f-3c4d-b462-5ab79d16e1bf",
                                                "text": "Ты выглядишь великолепно."
                                            },
                                            {
                                                "example_id": "a7e7a622-2bea-4935-8335-0827e51755a2",
                                                "sense_id": "f40f6736-bf2f-3c4d-b462-5ab79d16e1bf",
                                                "text": "Чело-век! Это — великолепно! Это звучит... гордо! Че-ло-век!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52dea515-a758-4015-8cfb-3c4bfc5007c3",
                        "source_entry_id": "560f2e77-d620-3274-89b8-1aa75174a0c4",
