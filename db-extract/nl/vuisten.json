                        ],
                        "examples": [
                            {
                                "example_id": "0265bfab-147c-4155-a01d-63adddb69489",
                                "sense_id": "f538194c-2eef-3ecb-92ec-68df00c71352",
                                "text": "Ze zat zo roerloos, ze had zo'n meditatieve blik in haar ogen, dat ze bijna een medeplichtige aan het spektakel leek, tot je haar gebalde vuisten zag, met de knokkels die wit door de huid heen schemerden."
                            },
                            {
                                "example_id": "96b03dd3-ad44-45eb-bafc-0b91621792a5",
                                "sense_id": "f538194c-2eef-3ecb-92ec-68df00c71352",
                                "text": "Vincenzo heeft zijn vuisten gebald, hoog boven zijn hoofd."
                            }
                        ]
                    }
