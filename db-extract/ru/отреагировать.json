                                        "entry_id": "e66b859a-6cfd-3779-bd5e-6ef3c2ae9ac3",
                                        "glosses": [
                                            "sich als von etwas beeinflusst erweisen; sich auf einen Anreiz hin in bestimmter Weise verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f266e35-2507-40a6-a2d5-6f236dfab929",
                                                "sense_id": "92daaa82-b9ec-3f88-a6f3-aafeed3ff43e",
                                                "text": "Ich bin gespannt, wie er reagieren wird."
                                            },
                                            {
                                                "example_id": "87f1d780-0d3e-4d1f-8d06-deb10aa9d1b1",
                                                "sense_id": "92daaa82-b9ec-3f88-a6f3-aafeed3ff43e",
                                                "text": "„Das soziale Netzwerk TikTok, wo die meisten der Videos hochgeladen werden, reagiert ebenfalls auf die gefährliche Challenge.“"
                                            },
                                            {
                                                "example_id": "24df715f-90fc-434e-8fa1-38f7e8ae6e83",
                                                "sense_id": "92daaa82-b9ec-3f88-a6f3-aafeed3ff43e",
                                                "text": "„Die Staatsanwaltschaft Innsbruck reagierte wenige Stunden nach der Pressekonferenz auf die Anwürfe von Heiss und Kapferer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3efbe40-6e77-3a6b-b34f-9d066a840751",
                                        "entry_id": "e66b859a-6cfd-3779-bd5e-6ef3c2ae9ac3",
                                        "glosses": [
                                            "eine chemische Reaktion eingehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b83b9e-4ee9-4604-a461-a10274a3bc7a",
                                                "sense_id": "a3efbe40-6e77-3a6b-b34f-9d066a840751",
                                                "text": "Chemische Verbindungen entstehen dadurch, dass Stoffe miteinander reagieren."
                                            },
                                            {
                                                "example_id": "8a3abd6a-2911-44d1-83b5-8cab1359a836",
                                                "sense_id": "a3efbe40-6e77-3a6b-b34f-9d066a840751",
                                                "text": "„Durch die enorme Hitzeentwicklung brannten Leichtmetallteile im Motorraum, die heftig mit dem Löschwasser reagierten.“"
                                            }
                                        ],
