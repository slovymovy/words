                                        "sense_id": "246b1bc2-9a12-306f-b995-3eec109c22be",
                                        "entry_id": "c02d1ca7-46a6-3cee-97d7-2f7e72d259f0",
                                        "glosses": [
                                            "Affecter à nouveau ; faire changer d’affectation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "597c4c54-389b-4011-b5a6-11dcda33f223",
                                                "sense_id": "246b1bc2-9a12-306f-b995-3eec109c22be",
                                                "text": "En fait, les règles et procédures en vigueur obligent parfois les ministères dépensiers à réaffecter des fonds."
                                            },
                                            {
                                                "example_id": "47a9d27a-2b01-4ba8-9649-84c3af7262f5",
                                                "sense_id": "246b1bc2-9a12-306f-b995-3eec109c22be",
                                                "text": "Puis, à partir de mars 1974, appliquant « la tactique du salami » il commença à se débarrasser l’un après l’autre de la plupart de ses ministres parchamis, soit en les réaffectant à des postes de moindre importance, soit en les démettant carrément."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dd7879c-6b64-45ea-9c6a-a3535cc714d8",
                        "source_entry_id": "7804b014-20de-3276-a15a-0fc4ddb07835",
                        "source_sense_id": "0a834399-5731-379b-8db0-032ff4eee7ca",
                        "source_sense_description": "reuse with or without alteration — see also alter, convert, transform",
                        "target_lang_word": "réutiliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réutiliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca963d85-2771-3b62-a697-e9a576e4e092",
                                        "entry_id": "954aa5f0-cb01-3baa-bc1a-492fb3d3c3cb",
                                        "glosses": [
                                            "Utiliser de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d25ed2d-2a5c-4435-be4d-bef371dc0f39",
                                                "sense_id": "ca963d85-2771-3b62-a697-e9a576e4e092",
                                                "text": "Cette interprétation n'empêche pas pour autant d'envisager que ce chemin soit datable aussi de l’époque romaine et qu'il ait été réutilisé à l’époque médiévale."
                                            },
                                            {
                                                "example_id": "3e1bf1e5-59e2-45ba-a889-b0b4f2ff2c7e",
                                                "sense_id": "ca963d85-2771-3b62-a697-e9a576e4e092",
                                                "text": "Nous n’avons toujours pas le droit de réutiliser nos eaux alors que nous avons nos stations d’épuration, nous filtrons et nous avons investi dans des systèmes très perfectionnés (osmose inverse à Lamballe par exemple)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c0af28-a128-415b-ac1f-4cee81ff5e15",
                        "source_entry_id": "7804b014-20de-3276-a15a-0fc4ddb07835",
