                            },
                            {
                                "target_word": "uphill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d14dd382-aa90-375d-96cc-d8e86c079b5d",
                                        "entry_id": "6f603287-fef9-3ab4-a0a3-6219bd2d3b38",
                                        "glosses": [
                                            "Located up a slope or on a hill."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8bfb9f3-c9fc-3f71-a29d-617ebab48c2a",
                                        "entry_id": "6f603287-fef9-3ab4-a0a3-6219bd2d3b38",
                                        "glosses": [
                                            "Going up a slope or a hill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ecc4cce-6d9a-4d33-b0c4-bbe84bca8bd7",
                                                "sense_id": "e8bfb9f3-c9fc-3f71-a29d-617ebab48c2a",
                                                "text": "“There’s a lot of uphill about a bicycle tour,” said he, “and the wind is against you.”\n“So there is downhill, and the wind behind you,” said Harris."
                                            },
                                            {
                                                "example_id": "fac78913-1356-46ce-8204-43ed8db156a0",
                                                "sense_id": "e8bfb9f3-c9fc-3f71-a29d-617ebab48c2a",
                                                "text": "The engine seemed a little sensitive to wet rails, and in consequence the uphill work was not so good north of Dundee as it had been earlier. But I have noted this same \"touchiness\" on the part of the \"A4s\", and other modern British 4-6-2s, so that in this respect No. 2006 proved no exception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f398b4-f341-3228-a0bf-22420f7ce3d6",
                                        "entry_id": "6f603287-fef9-3ab4-a0a3-6219bd2d3b38",
                                        "glosses": [
                                            "Difficult or laborious."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc690e00-c8ca-4b46-acdd-1497c6b839e0",
                                                "sense_id": "06f398b4-f341-3228-a0bf-22420f7ce3d6",
                                                "text": "For a large part of this game, England once again looked like a team suffering from the rigours of a long season and faced an uphill task when Hofmann put Germany in front."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uphill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5afe439-5b7a-3dca-a778-c3747b422d5d",
                                        "entry_id": "40378f99-b8a9-36ed-8ca5-c073b5489e7a",
                                        "glosses": [
                                            "An uphill route."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
