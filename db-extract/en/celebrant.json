                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de80a44f-9602-49a0-8a44-264f8155a2e2",
                                                "sense_id": "f17daeed-ae8c-3aa9-aa61-68ee05d992d4",
                                                "text": "„Sodann gab er den Befehl zum Angriff aud die wehrlosen Feiernden.“"
                                            },
                                            {
                                                "example_id": "638eb3f9-90c1-4bd0-b703-bdf0537c2738",
                                                "sense_id": "f17daeed-ae8c-3aa9-aa61-68ee05d992d4",
                                                "text": "„Die Göttin und ihr Opfer bleiben drei Tage in der Höhle; man sagt, die Göttin mache von ihrem Opfer auf jede Weise Gebrauch, nach der ihr der Sinn steht; Essen und Getränke werden am Eingang zur Höhle abgestellt, und die außerhalb Feiernden geben sich jeder Lust und Perversion hin, zu der ihre Raserei sie verführt.“"
                                            }
                                        ],
