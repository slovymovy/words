                    "frequency": "Middle",
                    "semantic_group_id": "physical_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor put a bandage on the open <w>sore</w> to prevent infection.",
                            "target_lang_translations": {
