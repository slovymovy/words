                        "cross_references": [
                            {
                                "target_word": "Hérode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c66bc8a-7774-3635-b94e-1e2949fa9dc0",
                                        "entry_id": "3dfb4318-e966-3521-98fa-108ade87f1ee",
                                        "glosses": [
                                            "Nom de plusieurs rois de Judée."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638c607d-db9b-4aff-9331-6f018c940073",
                                                "sense_id": "9c66bc8a-7774-3635-b94e-1e2949fa9dc0",
                                                "text": "Pourtant, avant de rentrer à Alexandrie, il lui faut encore aller à Damas, à Jérusalem et aussi à Gaza, et enfin à Jéricho ! Il lui faut, elle reine d'Égypte, rencontrer Hérode."
                                            },
                                            {
                                                "example_id": "76a85a89-826c-4761-b2f8-ee8b81f5c3d8",
                                                "sense_id": "9c66bc8a-7774-3635-b94e-1e2949fa9dc0",
                                                "text": "C’est au cours de cette guerre que les légions de Titus ont détruit Jérusalem et le temple d’Hérode avant d’exterminer la dernière poche de résistance juive dans la place forte de Massada…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d5f9031-c865-4ed0-a2dc-16085b498019",
                        "source_entry_id": "22368188-1f28-349e-951a-1d3e4450cd2d",
                        "source_sense_id": "315ecc55-be22-3eb3-bb05-23d9a475e96b",
                        "source_sense_description": "king",
                        "target_lang_word": "Herodes",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herodes",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "214414c8-fa93-3f9e-abdd-eb994990e820",
                                        "entry_id": "b7ff0697-dcce-3c00-914e-b53653d1bc11",
                                        "glosses": [
                                            "jüdischer Klientelkönig Roms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "201c516e-3c5c-45b6-9bb9-34b6889c06d0",
                                                "sense_id": "214414c8-fa93-3f9e-abdd-eb994990e820",
                                                "text": "„Möglicherweise war entscheidend, dass ich nominell Jude, aber auch Philosoph und kein Fanatiker bin und dass mein Vater eine bescheidene Geschäftsverbindung zum Hof von König Herodes unterhielt, den Marcus Antonius vor kurzem als König von ganz Judäa bestätigte und mit dem er in Frieden leben möchte.“"
                                            },
                                            {
                                                "example_id": "6deb177e-db18-4bc0-9077-ec73b9ef7175",
                                                "sense_id": "214414c8-fa93-3f9e-abdd-eb994990e820",
                                                "text": "„Entsprechend wurde auch Herodes’ Bautätigkeit ignoriert und die ‹untere Mauer› - Teil der von ihm errichteten Umfassungsmauer des Tempelbergplateaus - schlicht den Römern zugeschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
