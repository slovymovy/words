                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdc069e-a4de-4b59-94d9-c5ba66a8cb13",
                                                "sense_id": "b1a40a2d-7971-3022-9292-ecbfa9914371",
                                                "text": "Arracheurs de lin, fileuses, tisserands, lavandières - tous en « costumes d’époque » - ouvriront la voie aux calèches et au char fleuri de la reine du lin 2022, Zoé Rault."
                                            },
                                            {
                                                "example_id": "c3ad1850-ee0c-4538-b9b9-fc48c9f680de",
                                                "sense_id": "b1a40a2d-7971-3022-9292-ecbfa9914371",
                                                "text": "Noémie est très jolie\n Moins que Zoé, mais plus que Nathalie\n Anatole il est frivole\n Monsieur Gaston s'occupe du téléfon."
                                            },
                                            {
                                                "example_id": "4507c840-959c-4bbd-b8b7-81862bfdd2de",
                                                "sense_id": "b1a40a2d-7971-3022-9292-ecbfa9914371",
                                                "text": "La première provient de l’avocate Zoé Villain."
                                            }
