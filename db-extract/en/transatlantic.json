                        ]
                    },
                    {
                        "translation_id": "a21293d9-cd38-4523-be59-7c05b04fbf86",
                        "source_entry_id": "c1d5725e-f06d-3fd3-a2ae-98b9dca57e5f",
                        "source_sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                        "source_sense_description": "spanning or crossing the Atlantic",
                        "target_lang_word": "transatlantique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transatlantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                        "entry_id": "71e63419-6556-37cb-88ed-f298a942620c",
                                        "glosses": [
                                            "Qui traverse l’Atlantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3c14f44-1b49-45c6-bcfc-a521d984d8cc",
                                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                                "text": "Pour que le vol transatlantique soit un succès commercial, il faudra développer à la fois la vitesse et la sécurité. Seul l’avenir pourra résoudre ce problème."
                                            },
                                            {
                                                "example_id": "f07690d8-9722-468a-991c-5fd973b35342",
                                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                                "text": "Le Concorde peut effectuer un aller-retour transatlantique en un peu plus de six heures."
                                            },
                                            {
                                                "example_id": "f66cebc4-b734-46c0-91f8-0bf3ba9d0e24",
                                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                                "text": "[…], je m'installais devant mon PC. Il devait être environ 20h. Lorsqu'il se connecta quelques minutes plus tard, je le bipais. Nous eûmes du mal au début. En effet, les liaisons transatlantiques ne sont pas toujours des meilleures avec Skype."
                                            },
                                            {
                                                "example_id": "130d34bb-385f-413f-83bc-2e3aae1cf495",
                                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                                "text": "Un câble transatlantique. — Un paquebot transatlantique. — La Compagnie transatlantique."
                                            },
                                            {
                                                "example_id": "49e49f25-4e99-4aa9-9e3b-5e9386834ffc",
                                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                                "text": "« Ils ne peuvent pas avoir le beurre et l'argent du beurre », a martelé celui qui s'est vu remettre à Berlin le prix Eric Warburg, récompensant une personnalité ayant particulièrement oeuvré pour les relations transatlantiques"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transatlantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                                        "entry_id": "a2ffa336-ebd7-3eec-98cd-7d6fe1fd8175",
                                        "glosses": [
                                            "Paquebot qui fait le service entre l’Europe et l’Amérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "689fb39d-8835-4287-8288-79f46091ead9",
                                                "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                                                "text": "La ville était détruite et deux grands transatlantiques avaient sombré dans le port encore plein de cadavres."
                                            },
                                            {
                                                "example_id": "eb345143-728b-4df8-bf17-682e45a01265",
                                                "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                                                "text": "Bellonte rangea à la hâte ses cartes et le tableau de position des transatlantiques croisant entre l’Europe et l’Amérique."
                                            },
                                            {
                                                "example_id": "2e8abfcc-c0ee-4afd-a33d-7207e47e357d",
                                                "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                                                "text": "Il saisit rageusement sa perruque, qui lui redonnait pour un soir la chevelure bananoïde de ses chères sixties, et la jette dans le lavabo où elle se met à sombrer comme un transatlantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e53cb90-4c61-3998-acef-b95143b40970",
                                        "entry_id": "a2ffa336-ebd7-3eec-98cd-7d6fe1fd8175",
                                        "glosses": [
                                            "Fauteuil pliant à siège en toile, qu’on trouvait sur les ponts des paquebots transatlantiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc6834b-ba67-4d18-bcbb-df5776e394a2",
                                                "sense_id": "4e53cb90-4c61-3998-acef-b95143b40970",
                                                "text": "Maman de se baignait pas, elle restait sur son transatlantique et faisait de grands gestes pour nous faire revenir."
                                            },
                                            {
                                                "example_id": "f9bdad96-b357-456f-a868-f39438b89f1a",
                                                "sense_id": "4e53cb90-4c61-3998-acef-b95143b40970",
                                                "text": "Après le déjeuner, lorsque le soleil africain tombe en pluie de feu sur l'herbe mourante, on nous forçait à nous « reposer » une heure, à l'ombre du figuier, sur ces fauteuils pliants nommés « transatlantiques » qu'il est difficile d'ouvrir correctement, qui pincent cruellement les doigts, et qui s'effondrent parfois sous le dormeur stupéfait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "811ceedd-6024-45a2-97b7-4fb8f3fb90d4",
                        "source_entry_id": "c1d5725e-f06d-3fd3-a2ae-98b9dca57e5f",
