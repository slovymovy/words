                },
                {
                    "sense_id": "834faf36-d7aa-3df9-855f-bea08dd274ff",
                    "sense_definition": "The throat or jaws of a dangerous or hungry creature.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mouth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle snatched the lamb into its sharp <w>maw</w>.",
                            "target_lang_translations": {
                                "de": "Der Adler packte das Lamm mit seinem scharfen <w>Schnabel</w>."
                            }
                        },
                        {
                            "text": "He felt like he was plunging into the dark <w>maw</w> of the cave.",
                            "target_lang_translations": {
                                "de": "Er hatte das Gefühl, in den dunklen <w>Schlund</w> der Höhle zu stürzen."
                            }
