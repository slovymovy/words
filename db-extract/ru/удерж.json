                        "examples": [
                            {
                                "example_id": "0c524e69-791b-4a74-bbb3-31bb42a2560b",
                                "sense_id": "e8c61f4e-163c-37ae-869a-bb0f5ad2720f",
                                "text": "Такой понос у меня открылся ― удержу нет!"
                            },
                            {
                                "example_id": "71e557ac-a852-449c-9961-e43fb7182570",
                                "sense_id": "e8c61f4e-163c-37ae-869a-bb0f5ad2720f",
                                "text": "Уж он покажет рыси: чуть застоится ― ему и удержу нет."
                            }
                        ]
                    }
