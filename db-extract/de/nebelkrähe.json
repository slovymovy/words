                "senses": [
                    {
                        "sense_id": "f9e77922-fdab-3694-8ebf-164effcdf541",
                        "entry_id": "c136de2b-5fe9-3dc8-988b-4edc989e4532",
                        "glosses": [
                            "Singvogel der Familie der Rabenvögel, der aus der Rabenkrähe hervorging und im nördlichen Europa beheimatet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70be1db-fca6-45f6-bda0-51da303b1fef",
                                "sense_id": "f9e77922-fdab-3694-8ebf-164effcdf541",
                                "text": "Das Feld war voller Nebelkrähen."
                            },
                            {
                                "example_id": "c2a34731-f30f-4c87-8677-89c265ce7628",
                                "sense_id": "f9e77922-fdab-3694-8ebf-164effcdf541",
                                "text": "„Vorhin habe ich gelernt, dass die Saaatkrähe im Unterschied zur Nebelkrähe zerzauste Hosen, einen nackten Schnabelansatz und erzfarbenes Gefieder hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8cfb0a4-7931-3479-9844-631f9a394376",
                        "entry_id": "c136de2b-5fe9-3dc8-988b-4edc989e4532",
                        "glosses": [
                            "weibliche Person, die als unattraktiv empfunden wird"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "4b1707e7-1311-429c-bbbd-5db903a92914",
                                "sense_id": "c8cfb0a4-7931-3479-9844-631f9a394376",
                                "text": "Wer ist denn diese hässliche Nebelkrähe?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
