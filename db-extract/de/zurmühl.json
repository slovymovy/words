                ],
                "senses": [
                    {
                        "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                        "entry_id": "19cae9ca-d5eb-37a6-bfcc-104f730c0e3e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb3cfc7-800a-46e8-84f5-4de6e03ecdc3",
                                "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                                "text": "Frau Zurmühl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7473aa4c-1fa6-435b-8cd4-f10add27cc0e",
                                "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                                "text": "Herr Zurmühl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "09bfb330-ff6e-4c58-b31c-de6595ecd67c",
                                "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                                "text": "Die Zurmühls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b19c42b6-8a4b-4b54-ad80-5bf5b18f27ff",
                                "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                                "text": "Der Zurmühl trägt nie die Schals, die die Zurmühl ihm strickt."
                            },
                            {
                                "example_id": "a3b4e430-fca0-4580-80ad-581502764079",
                                "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zurmühl kommt, geht der Herr Zurmühl.“"
                            },
                            {
                                "example_id": "da602465-5446-4117-b966-31df2cd5b122",
                                "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                                "text": "Zurmühl kommt und geht."
                            },
                            {
                                "example_id": "82c79bcb-dfbd-482e-8aa3-34a723ad4cd5",
                                "sense_id": "31c23e21-2587-39e4-b3e2-2f044b32114d",
                                "text": "Zurmühls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
