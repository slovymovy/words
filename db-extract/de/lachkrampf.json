                    },
                    {
                        "translation_id": "6c5331e0-be85-4397-b208-dfe955b0c2d1",
                        "source_entry_id": "bdbd9629-ef8d-374b-bdf3-f26694f395ef",
                        "source_sense_id": "688e6217-97e2-3b3d-8b49-e4ece384aecd",
                        "source_sense_description": "kaum beherrschbarer Lachanfall",
                        "target_lang_word": "lachbui",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lachbui",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ed039cbe-2ba0-3c88-860b-f0c10679cd83",
                                        "entry_id": "e597ada3-6f27-3d4c-8e9f-d3f56a506c92",
                                        "glosses": [
                                            "aanval van aanhoudend gelach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674b8897-b95e-4ba9-9ef9-0c0fa633f1b6",
                                                "sense_id": "ed039cbe-2ba0-3c88-860b-f0c10679cd83",
                                                "text": "Toen de leraar uitgleed over de bananenschil kregen de leerlingen een lachbui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e695807-0146-41f4-8224-45c5b49af6fb",
                        "source_entry_id": "bdbd9629-ef8d-374b-bdf3-f26694f395ef",
                        "source_sense_id": "688e6217-97e2-3b3d-8b49-e4ece384aecd",
                        "source_sense_description": "kaum beherrschbarer Lachanfall",
                        "target_lang_word": "lachkramp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lachkramp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc23056-6818-300b-962b-c7a3abb44c98",
                                        "entry_id": "11ab0efd-624f-3b5f-998d-41c480678413",
                                        "glosses": [
                                            "pijnlijke, niet te stoppen lachbui"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e8b79c9-1653-41f8-835a-b22ea095e57c",
                                                "sense_id": "6cc23056-6818-300b-962b-c7a3abb44c98",
                                                "text": "Natuurlijk. Niemand is echt veilig voor de venijnige tong, de pijlsnelle associaties en de kameleontische imitaties van Baron Cohen. Je kunt in deze milde variant op zijn controversiële humor zelfs beter zien hoe goed hij is dan als hij maar door dendert. Al levert dat laatste natuurlijk wel de betere lachkrampenoals in de scène waarin Baron Cohen met kernfysicus Nadal een helikoptertochtje boven New York maakt en ze met een Midden Oostenachtig brabbeltaaltje, gekruid met de nodige ‘9/11’s’ (ze hebben het over het Porsche model 911) en ‘Empire State Buildings’ twee toeristen de stuipen op het lijf jagen, ook al omdat ze ook nog een rugkorset onthullen dat veel op een bomgordel lijkt."
                                            },
                                            {
                                                "example_id": "4983ddb7-6a2f-4edb-9b51-6a382b460e96",
                                                "sense_id": "6cc23056-6818-300b-962b-c7a3abb44c98",
                                                "text": "Mijn alibi is waterdicht: ik had die avond een optreden. Voor een zaaltje met tweehonderd man potentiële getuigen. Net als ik een lachkramp onderdruk bij het beeld dat de politie alle bezoekers verhoort, komt het verlossende woord: „U bent slachtoffer van pinpasfraude.” Een dag later een brief: ik krijg de ‘frauduleuze transacties’ vergoed en hoef „zelf geen actie te ondernemen”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f62eff65-e282-4575-90f9-e22c9972c53c",
                        "source_entry_id": "bdbd9629-ef8d-374b-bdf3-f26694f395ef",
                        "source_sense_id": "688e6217-97e2-3b3d-8b49-e4ece384aecd",
                        "source_sense_description": "kaum beherrschbarer Lachanfall",
                        "target_lang_word": "lachstuip",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lachstuip",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee63b79-2388-30b2-9181-fc56b88eb97a",
                                        "entry_id": "0b9da5ce-2418-367e-bfa4-265444bfbb34",
                                        "glosses": [
                                            "heel heftige, niet te stoppen lachbui die gepaard gaat met ongecontroleerde bewegingen en soms ook met urineverlies"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa32cb6e-dd8d-41ab-9199-f06f430f872c",
                                                "sense_id": "8ee63b79-2388-30b2-9181-fc56b88eb97a",
                                                "text": "Sjaak heeft in zijn carrière als theatermaker wel eens twee mensen zien weghalen uit een zaal. \"Die bleven in een extreme lachstuip hangen en werden uiteindelijk niet goed. Zo erg zelfs dat medisch personeel zich over die bulderaars moest ontfermen. Van mij hadden ze mogen blijven, maar het lot besliste anders ze.\""
                                            },
                                            {
                                                "example_id": "371d1c50-4c41-49d3-9eba-eb8bec50d57d",
                                                "sense_id": "8ee63b79-2388-30b2-9181-fc56b88eb97a",
                                                "text": "Songfestivalzanger Douwe Bob kreeg woensdag een lachstuip toen hij op de weg achter een opvallend felblauw busje reed. 'Slow Down', staat er in roze letters opgeschreven, naar het liedje waarmee Douwe de elfde plaats bereikte op het Eurovisie Songfestival in het Zweedse Stockholm."
                                            },
                                            {
                                                "example_id": "ceb38cc0-cbaf-46d7-ae4b-7f141faaec30",
                                                "sense_id": "8ee63b79-2388-30b2-9181-fc56b88eb97a",
                                                "text": "Humberto doet het ook niet slecht, vooral als er een serieuze gast zit. Maar voor je het weet, zit daar Gerard Joling weer in een lachstuip. Het is te veel make-up. Dat het programma onder druk staat, is duidelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
