                        "entry_id": "f2365d93-8912-3aee-a4dd-a322121dd415",
                        "glosses": [
                            "hoch gelegene Landschaft, in der Sträucher, Moose, Gräser und Flechten, aber fast keine Bäume wachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e91bd31c-31bf-4c98-b970-46145ea7ec5d",
                                "sense_id": "b4123da9-07dd-3b70-904d-099eeffb211e",
                                "text": "„Von einigen der höchsten Gipfel reichen Gletscher bis auf das Fjell herab.“"
                            },
                            {
                                "example_id": "e29b0e54-8df5-457c-8d4e-e378e0be7525",
                                "sense_id": "b4123da9-07dd-3b70-904d-099eeffb211e",
                                "text": "„Drinnen im Lande schlossen ferne blaue Fjelle einen Ring um dunkle niedrige Berge mit grünen Abhängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
