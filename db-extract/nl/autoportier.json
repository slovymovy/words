                        "examples": [
                            {
                                "example_id": "5ba2520c-03a3-4713-a11b-a50152ea1238",
                                "sense_id": "b4116845-2a6a-3786-b065-14edea19fc08",
                                "text": "Het mooie geluid dat je autoportier maakt als je het dichtslaat, is nep. Het is zorgvuldig gecomponeerd door de fabrikanten, die daarmee de perceptie van kwaliteit willen oproepen. Dat stelt althans de Amerikaanse website Mel, die diep in het onderwerp dook."
                            },
                            {
                                "example_id": "0966694f-750b-4a0a-a641-1e11c08ddcc6",
                                "sense_id": "b4116845-2a6a-3786-b065-14edea19fc08",
                                "text": "Een getuige zag hoe een witte Fiat 500 twee keer stopte, zonder dat daar een echte reden voor leek te zijn. Bij de tweede keer werd het autoportier van de bestuurder geopend en gesloten en reed de Fiat weg."
                            }
                        ]
                    }
