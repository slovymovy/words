                                    {
                                        "sense_id": "f4fb57ad-68af-3f67-bb87-28ee566b3225",
                                        "entry_id": "7c31409d-6f46-3a33-8de1-eb5194d245c5",
                                        "glosses": [
                                            "Celui, celle qui est préposé à la garde d’une consignation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad29c7d-52fb-4049-8994-2fc5dffea34b",
                                                "sense_id": "f4fb57ad-68af-3f67-bb87-28ee566b3225",
                                                "text": "Le consignataire délivra les fonds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1f159aa-be28-30ce-a175-02f0fef93245",
                                        "entry_id": "7c31409d-6f46-3a33-8de1-eb5194d245c5",
                                        "glosses": [
                                            "Négociant ou commissionnaire auquel on adresse soit un navire, pour qu’il en opère le désarmement et le réarmement, soit les marchandises chargées sur un bâtiment, pour qu’il les reçoive en dépôt ou se charge de les vendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40be8029-d7ad-436c-ab65-b1742edb1ffb",
                                                "sense_id": "d1f159aa-be28-30ce-a175-02f0fef93245",
                                                "text": "Le consignataire du navire, substitué aux obligations du capitaine pour la délivrance de la cargaison, est tenu de délivrer les marchandises qu’il a reçues et telles qu’il les a reçues, à moins de prouver le cas fortuit ou la force majeure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d505edd0-5bcb-4d1e-99fe-6175c7b572a6",
                        "source_entry_id": "f12a1365-6bc2-372f-b061-b2c4d0fe0494",
                        "source_sense_description": "The person to whom a shipment is to be delivered",
                        "target_lang_word": "Empfänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                        "entry_id": "57c9d099-d87e-3969-9945-0afed7766f35",
                                        "glosses": [
                                            "Person, die etwas empfängt, bekommt, erhält, entgegennimmt; jemand, der etwas in Empfang nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34f6999-3493-49cc-896f-71d36a69d963",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "Der Empfänger des Briefes muss für den unfrankierten Brief Strafporto zahlen."
                                            },
                                            {
                                                "example_id": "5b5839da-4df0-4d5e-a859-dbfa6ac7b91f",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "„Es ist undenkbar, daß sich in einem solchen Augenblick der Empfänger einer Wohltat nicht ebenfalls entschlossen fühlt, alles in seinen Kräften Stehende zu tun, um den zu beglücken, der so bereitwillig zu seinem Glück beigetragen hat.“"
                                            },
                                            {
                                                "example_id": "c7c3af37-6467-4c01-96a9-7ba64ff5b5da",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "„Empfänger seiner Mitteilung ist Johannes Kagelmacher, Bauer aus Guderitz auf Rügen, bei dem er in seiner Zeit als Drogenabhängiger oft untergekrochen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "315ca416-df38-316b-9097-4780aaa4a42b",
                                        "entry_id": "57c9d099-d87e-3969-9945-0afed7766f35",
                                        "glosses": [
                                            "Gerät, das Signale empfängt"
                                        ],
                                        "tags": [
                                            "Funktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69cf1cef-c31c-4f53-ba67-0fe0a089d52b",
                                                "sense_id": "315ca416-df38-316b-9097-4780aaa4a42b",
                                                "text": "Der Empfänger ist defekt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4de3bf4f-2755-4300-a086-64aec3670d85",
                        "source_entry_id": "f12a1365-6bc2-372f-b061-b2c4d0fe0494",
                        "source_sense_description": "The person to whom a shipment is to be delivered",
                        "target_lang_word": "Adressat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adressat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                        "entry_id": "b3f0fe5b-b2e9-3544-a8b0-bcd211d5219a",
                                        "glosses": [
                                            "Empfänger einer Nachricht, insbesondere im Postwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5228fd-1bbf-4848-a59e-80a13538cb31",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "Der Adressat dieses Briefs ist Herr Peter Drünschick."
                                            },
                                            {
                                                "example_id": "74a2843a-502c-421c-ab6e-50051f57e82a",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "Alle Briefe an unsere Firma landen erst in der Poststelle. Von dort aus werden sie an die Adressaten weitergeleitet."
                                            },
                                            {
                                                "example_id": "f1335188-e8a6-43c1-a630-85942894e05c",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "„Roms Widerstandskraft war nach Cannae durchaus nicht gebrochen. Dem Adressaten dieser Botschaft soll der römische Großmut sowie die Solidarität der Römer in einer Notlage vorgeführt werden und im Gegensatz dazu die karthagische Kleinmütigkeit.“"
                                            },
                                            {
                                                "example_id": "f46fa173-d0b6-4b3b-a3f3-8480e39dbaec",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "„Er schreibt dem jeweiligen Adressaten, wie entzückt der von ihr wäre, wenn er sie kennte, und wenn er ihr eine Liebeserklärung machen möchte, liest er ihr das vor.“"
                                            },
                                            {
                                                "example_id": "5aaf5dec-aedb-427a-bb4c-b2de747fd2a6",
                                                "sense_id": "bc914451-b523-378a-854d-c6aa1bda22e1",
                                                "text": "„Die Karte aus Gotenhafen, die immerhin in Prenzlau angekommen war, hatte den Adressaten nicht mehr viel Hoffnung gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
