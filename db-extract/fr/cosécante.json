                        "entry_id": "46dd975e-20c0-3213-a6a2-e45ba3e758c8",
                        "glosses": [
                            "La cosécante est l'inverse du sinus d'un angle. Elle est équivalente à la sécante du complément de cet angle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2afb6ffc-3e5d-4f7d-8c20-7eca6dc7aa51",
                                "sense_id": "25e192f8-e497-339d-bd92-1ca888348d9a",
                                "text": "La cosécante de l’angle de 30 degrés est la sécante de 60 degrés."
                            },
                            {
                                "example_id": "728ba967-f3c0-4f86-9f03-937f406c3387",
                                "sense_id": "25e192f8-e497-339d-bd92-1ca888348d9a",
                                "text": "Pour les signes de la sécante et de la cosécante, on a fait une autre convention."
                            }
                        ]
                    }
                ],
