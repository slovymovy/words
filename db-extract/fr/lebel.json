                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ceac790-208e-3f5d-99cb-7581aec25ecb",
                        "entry_id": "4eae8c47-384d-31fa-b86d-9001d3018f96",
                        "glosses": [
