                "senses": [
                    {
                        "sense_id": "3882263b-7caa-39e5-a8a7-3e8a9938dcc7",
                        "entry_id": "6c4a1d27-bbf3-3343-a3b8-c6a028dad2a8",
                        "glosses": [
                            "den Menschen belästigende Insekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c65a0e-f79b-4f44-b0be-68738ed8bacd",
                                "sense_id": "3882263b-7caa-39e5-a8a7-3e8a9938dcc7",
                                "text": "Das Geschmeiß machte die Reise durch den Urwald zu einer Tortur."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "452d9503-b2fa-3d41-9a52-4452e21bf1ca",
                        "entry_id": "6c4a1d27-bbf3-3343-a3b8-c6a028dad2a8",
                        "glosses": [
                            "für der Pöbel, das Gesindel"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "00160653-d564-4d9f-be90-1af8d3d1d80c",
                                "sense_id": "452d9503-b2fa-3d41-9a52-4452e21bf1ca",
                                "text": "Halte mir dieses Geschmeiß vom Hals."
                            },
                            {
                                "example_id": "03a6d60f-f2c1-4244-a03a-f273b1a8f191",
                                "sense_id": "452d9503-b2fa-3d41-9a52-4452e21bf1ca",
                                "text": "„Schon einmal war ich diesem Geschmeiß in die Hände gefallen, in Liverpool, doch Kapitän Johnston konnte mich mithilfe meiner Verträge befreien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c11d4abb-53db-381e-b458-795ee8a2f68d",
                        "entry_id": "6c4a1d27-bbf3-3343-a3b8-c6a028dad2a8",
                        "glosses": [
                            "der Kot von Raubvögeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f349524-3e7d-4379-a049-4edab366bcc6",
                                "sense_id": "c11d4abb-53db-381e-b458-795ee8a2f68d",
                                "text": "Das Geschmeiß der Singvögel erlaubt vielen Pflanzen sich über weite Distanzen zu verbreiten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f6e4af0-0a10-4961-aeeb-d5bfabcf272e",
                        "source_entry_id": "6c4a1d27-bbf3-3343-a3b8-c6a028dad2a8",
                        "source_sense_id": "3882263b-7caa-39e5-a8a7-3e8a9938dcc7",
                        "source_sense_description": "den Menschen belästigende Insekten",
                        "target_lang_word": "vermin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f88d3c-f547-301c-8c57-b7a959159565",
                                        "entry_id": "89c2753c-6208-3842-af86-4a0083cbbad2",
                                        "glosses": [
                                            "Any of various common types of small insects or other animals which cause harm and annoyance."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fbd62d3-d636-468c-a71c-24a9e4b47509",
                                                "sense_id": "11f88d3c-f547-301c-8c57-b7a959159565",
                                                "text": "The area was crawling with all sorts of vermin: fleas, lice, mice, and rats to name a few. Thus, we felt as if vermin were crawling over us."
                                            },
                                            {
                                                "example_id": "30e8b11f-10fe-4eea-84eb-57cf475aae7c",
                                                "sense_id": "11f88d3c-f547-301c-8c57-b7a959159565",
                                                "text": "Vermin was everywhere; night and day it crawled gaily over the walls and ceiling, about our bodies, and into our very food, and, although the subject did not interest us, a naturalist would have delighted in the ever-changing varieties of insect life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354360d8-397a-36d4-9dc1-779cf0e40caa",
                                        "entry_id": "89c2753c-6208-3842-af86-4a0083cbbad2",
                                        "glosses": [
                                            "An animal that preys on game, such as a fox or a weasel."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ad4dc78-633b-33a1-8c65-e193d261b2ed",
                                        "entry_id": "89c2753c-6208-3842-af86-4a0083cbbad2",
                                        "glosses": [
                                            "An obnoxious or mean and offensive person."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80e72c75-1e92-42a9-a0bc-3d13e8cbc90d",
                                                "sense_id": "6ad4dc78-633b-33a1-8c65-e193d261b2ed",
                                                "text": "Bring these vermin to the Palace of Justice."
                                            }
                                        ]
                                    }
                                ]
                            }
