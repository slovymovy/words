                                "sense_id": "b4b6fcfa-59dc-3530-97cb-8a4ed2007820",
                                "text": "De zaadballen zijn niet in de balzakken te voelen.",
                                "translation": "The testicles cannot be felt in the scrota.",
                                "english": "The testicles cannot be felt in the scrota."
                            },
