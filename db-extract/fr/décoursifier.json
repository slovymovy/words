                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8065eda-e27c-431c-b6f2-228fc86dcd4d",
                                "sense_id": "93b5414f-e59a-3d7d-bf28-657ce56e14a1",
                                "text": "Donc j'ai décidé de décoursifier la CS et j'avais pas envie d'acheter une 6e auto alors que 4 ne roulaient pas assez."
                            },
                            {
                                "example_id": "3eb9f7e4-afd2-480e-a2c2-524a80d82cb4",
                                "sense_id": "93b5414f-e59a-3d7d-bf28-657ce56e14a1",
                                "text": "Les puristes sont sans doute chagrins des transformations mais pour la \" décoursifier \" va falloir investir sérieusement"
                            },
