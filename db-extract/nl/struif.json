                    {
                        "translation_id": "87f403ca-275b-49ea-80fc-abee0136894d",
                        "source_entry_id": "ccf41f40-5b22-3c88-8cb0-99fea6793304",
                        "target_lang_word": "omelette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omelette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d9cd800-7e15-3f37-9654-94a696c1ef7f",
                                        "entry_id": "66d87e51-82fd-3556-b925-a2c49c1ef5f4",
                                        "glosses": [
                                            "A dish made with beaten eggs cooked in a frying pan without stirring, flipped over to cook on both sides, and sometimes filled or topped with other foodstuffs, for example cheese or chives."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e341e4-eba0-47f4-a646-7593f92ce599",
                                                "sense_id": "0d9cd800-7e15-3f37-9654-94a696c1ef7f",
                                                "text": "He crossed to the window, which looked on to a herb garden, and seated himself on the chintz-covered window-seat and delicately watched the two, who were engaged in eating omelette and salad at a round table near the fire-place."
                                            },
                                            {
                                                "example_id": "b45ade44-b817-4f95-81fb-49be6a46d624",
                                                "sense_id": "0d9cd800-7e15-3f37-9654-94a696c1ef7f",
                                                "text": "She had never meant to confide in him — certainly not here, eating omelette and cheese sauce — but that look seemed to demand a confidence."
                                            },
                                            {
                                                "example_id": "5f2dbd7c-a5c1-4853-af77-a1e429bdbcfa",
                                                "sense_id": "0d9cd800-7e15-3f37-9654-94a696c1ef7f",
                                                "text": "She stayed to lunch that day, eating omelette and peas in the kitchen, followed by treacle tart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae5aa603-8f2f-3f89-a1f8-e77aec022739",
                                        "entry_id": "66d87e51-82fd-3556-b925-a2c49c1ef5f4",
                                        "glosses": [
                                            "A form of shellcode that searches the address space for multiple small blocks of data (\\\"eggs\\\") and recombines them into a larger block to be executed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e55ba5-ac36-4613-9d99-b287d38db96c",
                                                "sense_id": "ae5aa603-8f2f-3f89-a1f8-e77aec022739",
                                                "text": "This approach would be altered for an optimal omelette based exploit. One would spray the heap with the omelette code solely, then load a single copy of the additional shellcode eggs into memory outside the target region for the spray."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "omelette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c216ab-711e-390c-afe7-6ab53eb4383c",
                                        "entry_id": "86049879-154c-32e3-a340-d168870a0e56",
                                        "glosses": [
                                            "To make into an omelette"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb40ebd-50b6-4e12-af12-bb3f1eb0c114",
                                                "sense_id": "c1c216ab-711e-390c-afe7-6ab53eb4383c",
                                                "text": "This recipe may be adapted for scrambled eggs, i.e., instead of omeletting the eggs, simply scramble them."
                                            },
                                            {
                                                "example_id": "bb0045eb-b338-4065-846e-809ff66c1595",
                                                "sense_id": "c1c216ab-711e-390c-afe7-6ab53eb4383c",
                                                "text": "'Your main concern should not be practical ethics, but to dissuade me from omeletting you.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0d143e3-4232-42af-87a2-3f5175c5f094",
                        "source_entry_id": "ccf41f40-5b22-3c88-8cb0-99fea6793304",
                        "target_lang_word": "tortilla",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Plato a base de huevo batido, al que se incorporan otros ingredientes; el conjunto se frie en una sola pieza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95de3943-4055-42ce-9e46-1687f3796db9",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "¡Ay, huevo mío de dos yemas, que para echar vos guardava yo! ¡Que de uno o de dos hazía yo una tortilla tan dorada que complía mis vergüenças!"
                                            },
                                            {
                                                "example_id": "260514b4-7f78-4e78-85f3-f09fe740a5ed",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "Luego pasé a un gallinero de más alante, levantó una gallina clueca que estaba empollando dieciocho huevos de raza e hizo una tortilla como pa un banquete."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Porción de masa de harina de maíz o trigo, redonda, plana y muy delgada que se cocina sobre una superficie caliente, habitualmente un comal; forma parte de la gastronomía tradicional de México y América Central."
                                        ],
                                        "tags": [
                                            "Mexico"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2faed898-fde1-4fa7-9c24-9e1ecbb2a01f",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "El principal y de mayor dignidad, poder y autoridad, sacerdote, ayunaba ochenta días antes; los cuatro días primeros no comía ni bebía más de una tortilla de maíz, que no pesaba una onza, y un poquillo de agua."
                                            },
                                            {
                                                "example_id": "0639f1dd-6158-44ea-bb47-60b646ef9de0",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "La tortilla mexicana no tiene nada que ver con las tortillas francesa o española. Ya lo dije en otro capítulo. Es un disco de masa de maíz que se lamina y sutiliza a palmetazos maestros."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3819f62e-3dad-351e-ba5a-a2af02e0afbd",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Pan aplanado de masa muy compacta, sin levadura y habitualmente con algo de manteca."
                                        ],
                                        "tags": [
                                            "Bolivia",
                                            "Chile",
                                            "Río-de-la-Plata"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a86180-3cb8-4552-9824-4cf31f40568a",
                                                "sense_id": "3819f62e-3dad-351e-ba5a-a2af02e0afbd",
                                                "text": "\"Pase, no más, mozo."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
