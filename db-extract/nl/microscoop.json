                        ]
                    },
                    {
                        "translation_id": "ec93f931-dd9a-4858-9019-c3fae90de74b",
                        "source_entry_id": "1a8b9280-ab06-3935-98b9-752b9f917764",
                        "source_sense_id": "82e0f933-a236-31bf-b0f0-c80393a9cb22",
                        "source_sense_description": "instrument dat het beeld van heel kleine dingen sterk vergroot",
                        "target_lang_word": "Mikroskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mikroskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                        "entry_id": "5eb00eae-b5ce-3120-9180-c88534692f2a",
                                        "glosses": [
                                            "Instrument zur vergrößerten Betrachtung kleiner Objekte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61247884-762b-4dbb-99e8-bda83fe101d3",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "Wir betrachteten die geschnittenen Zwiebelschale unter dem Mikroskop."
                                            },
                                            {
                                                "example_id": "27d781cd-e62f-4175-b94c-9597f8a83820",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Volker hatte ein Mikroskop gekriegt, als Trostpflaster, weil er nachher doch lieber mit uns in Jever gewesen wäre.“"
                                            },
                                            {
                                                "example_id": "4048e6bb-1cc1-48b0-9b00-0d46f2e83b77",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Unter dem Mikroskop zeigen sich dabei sogar kleine Gefäße, durch die Saurierherzen einst das Blut pumpten.“"
                                            },
                                            {
                                                "example_id": "17d1c2d5-e167-4b20-a23c-9eb3ae2e6361",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Er packte das Mikroskop beiseite.“"
                                            },
                                            {
                                                "example_id": "5baf8327-8450-49bf-b640-c2fb7d872728",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Den ganzen Tag verbrachte er nun, über das Mikroskop gebeugt, in den großen aus Daressalam entliehenen Landvermesserzelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43ce610d-1ef2-458c-9487-18c47b88666b",
                        "source_entry_id": "1a8b9280-ab06-3935-98b9-752b9f917764",
                        "source_sense_id": "82e0f933-a236-31bf-b0f0-c80393a9cb22",
                        "source_sense_description": "instrument dat het beeld van heel kleine dingen sterk vergroot",
                        "target_lang_word": "microscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4236bde-13fc-3db0-957a-256b883b1fd5",
                                        "entry_id": "02980d77-a8f5-31b9-a306-14cedbfcd823",
                                        "glosses": [
                                            "An optical instrument used for observing small objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba06e09-bbb3-446f-9bce-e474fae47046",
                                                "sense_id": "e4236bde-13fc-3db0-957a-256b883b1fd5",
                                                "text": "That he might ascertain whether any of the cloths of ancient Egypt were made of hemp, M. Dutrochet has examined with the microscope the weavable filaments of this last vegetable."
                                            },
                                            {
                                                "example_id": "f8e6e85b-3a9f-4b66-b707-bcd8a85cade6",
                                                "sense_id": "e4236bde-13fc-3db0-957a-256b883b1fd5",
                                                "text": "Elsewhere, professionals could enthuse over new precision instruments capable, for instance, of measuring weights down to a tenth of a milligram, or over a host of self-registering thermometers and barometers, microscopes, typewriters, calculators and all sorts of technical and musical devices, including automatic concertinas, edeophones, auto-harps, bigophones and other long-forgotten objects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1368e42-46e2-3dbc-b23e-d32c30cd1680",
                                        "entry_id": "02980d77-a8f5-31b9-a306-14cedbfcd823",
                                        "glosses": [
                                            "Any instrument for imaging very small objects (such as an electron microscope)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "microscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                        "entry_id": "3222fb2a-7b08-3dee-be7b-b46b8e20f60a",
                                        "glosses": [
                                            "To examine with a microscope, to put under a microscope (literally or figuratively)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dee191b-7ca8-416b-87a5-9a1d19712c2c",
                                                "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                                "text": "It has a strong germicidal action, as can be verified by staining and microscoping the pus, the characteristic micro-organisms disappearing rapidly under its use."
                                            },
                                            {
                                                "example_id": "d10c47b7-3d4a-4db2-b57d-2b999ced9a49",
                                                "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                                "text": "Wright (1959), using the standard and less laborious technique of microscoping the centrifuged deposit of a sample of urine, found that 21.6% of males attending life insurance examinations had more than 10 red blood cells per high power field (rbc/hpf)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74fcbfe0-ffec-4e4c-a4f2-c136e53a5ef5",
                        "source_entry_id": "1a8b9280-ab06-3935-98b9-752b9f917764",
                        "source_sense_id": "82e0f933-a236-31bf-b0f0-c80393a9cb22",
                        "source_sense_description": "instrument dat het beeld van heel kleine dingen sterk vergroot",
                        "target_lang_word": "microscope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microscope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f4a3fb9-92de-38b3-8282-6cc94602ff2d",
                                        "entry_id": "3cfdb2bf-a584-3dae-abe9-f3aeedaaf7e6",
                                        "glosses": [
                                            "Instrument d'optique qui a la propriété de faire paraître les petits objets plus gros qu’ils ne paraissent à l’œil nu, essentiellement composé d’un objectif et d’un oculaire qui sont renfermés dans un tube."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "509b84b1-d413-4f9a-b3a7-ec7d8a03c343",
                                                "sense_id": "7f4a3fb9-92de-38b3-8282-6cc94602ff2d",
                                                "text": "Le diamètre a été mesuré à l’aide d’un microscope muni d’un micromètre oculaire qui avait été comparé préalablement à un micromètre étalon placé dans l’objectif."
                                            },
                                            {
                                                "example_id": "cfd9c093-2ac1-496d-8980-5fc0e7a5046c",
                                                "sense_id": "7f4a3fb9-92de-38b3-8282-6cc94602ff2d",
                                                "text": "Seize jours après l’injection, les ganglions prépectoraux sont encore les seuls où le carmin soit visible à l’œil nu, mais on le retrouve, au microscope, dans les ganglions œsophagiens et bronchiques."
                                            },
                                            {
                                                "example_id": "2e430017-7aee-4e7d-93df-1da9580a88aa",
                                                "sense_id": "7f4a3fb9-92de-38b3-8282-6cc94602ff2d",
                                                "text": "De par sa petite taille, un virus filtrant n’était pas visible au microscope optique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26d0e1c1-b1a7-3e71-af3b-e212a3f1fe23",
                                        "entry_id": "3cfdb2bf-a584-3dae-abe9-f3aeedaaf7e6",
                                        "glosses": [
                                            "Ce qui grossit les choses abstraites, intellectuelles ou morales, comme le microscope grossit les petits objets."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f1e0a3-bbc5-4a8d-b1f1-35596c35a0e5",
                                                "sense_id": "26d0e1c1-b1a7-3e71-af3b-e212a3f1fe23",
                                                "text": "Il voit tout avec un microscope, son imagination lui grossit tous les objets ; il exagère tout."
                                            },
                                            {
                                                "example_id": "64b0c014-1b98-43f4-a352-6254aee44920",
                                                "sense_id": "26d0e1c1-b1a7-3e71-af3b-e212a3f1fe23",
                                                "text": "Nous [les poètes] nous sommes tellement appliqués à sophistiquer notre cœur, nous avons tant abusé du microscope pour étudier les hideuses excroissances et les honteuses verrues dont il est couvert, et que nous grossissons à plaisir, qu’il est impossible que nous parlions le langage des autres hommes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f790d589-919b-455c-a215-d585e669badd",
                        "source_entry_id": "1a8b9280-ab06-3935-98b9-752b9f917764",
