                                        "entry_id": "8deaced5-6453-3eaa-9622-0371940c5ce7",
                                        "glosses": [
                                            "A vote made remotely, especially a postal vote, cast by a voter unable to be present in person."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c79d7bf-24bf-49b7-a4de-a4c485d17a64",
                                                "sense_id": "48a2262a-4f2e-3cac-81d5-e1b66fc549d4",
                                                "text": "Studies also show that absentee ballots cast by voters who are younger or from racial and ethnic minority groups are rejected at higher rates than other absentee ballots."
                                            },
                                            {
                                                "example_id": "37d08bd1-d126-4c14-926c-501a4089a0d4",
                                                "sense_id": "48a2262a-4f2e-3cac-81d5-e1b66fc549d4",
                                                "text": "In Wyoming, a GOP state senator forwarded an FGA draft bill to Secretary of State Chuck Gray that would prohibit sending out unsolicited absentee ballot request forms."
                                            }
                                        ]
                                    }
                                ]
                            }
