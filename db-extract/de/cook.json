                    }
                ],
                "senses": [
                    {
                        "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                        "entry_id": "09b1cbbd-26a8-3c6a-aabc-461f0e8fafb7",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00be5412-6d8b-413a-983b-9bd429c2af74",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cook kommt, geht der Herr Cook.“"
                            },
                            {
                                "example_id": "ec35ac9d-e6c2-4bf4-9cae-3c42ccb92064",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "Cook kommt und geht."
                            },
                            {
                                "example_id": "bcaf88c8-3ef6-40bc-92ef-913f309c1d16",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "Cooks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "190d5a2e-c76a-4369-ad5e-731b6aec2201",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "Frau Cook ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "674be99c-b0de-4dcd-8a4c-eeb7f51420c0",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "Herr Cook wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3dd8bc04-c870-4bde-aded-ac0d224fb024",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "Die Cooks kommen heute von Sylt."
                            },
                            {
                                "example_id": "7b006fb8-a6d5-45b8-b4bc-597126adf223",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "Der Cook trägt nie die Schals, die die Cook ihm strickt."
                            },
                            {
                                "example_id": "22ac31e2-4fac-4fb5-b868-dd9f415eaf61",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "An verregneten Herbsttagen ist Familie Cooks liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "82593a16-abcf-421d-87dd-24f8aec2fb37",
                                "sense_id": "59925e30-0a12-397e-a237-7e43c720c9a4",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Cook das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
