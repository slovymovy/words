                "senses": [
                    {
                        "sense_id": "c603e257-1589-38ef-89ef-c281e4f28c89",
                        "entry_id": "79670bea-90d9-3741-a197-e1abee53073e",
                        "glosses": [
                            "Éditorial, article de journal reflétant la position de l’éditeur ou de l’éditrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a90ca4b8-b152-46f2-9618-8c3fe6f1c69f",
                                "sense_id": "c603e257-1589-38ef-89ef-c281e4f28c89",
                                "text": "L’édito fait partie des genres davantage affectés par la particularité d’une opinion, qui en l’occurrence obéit à une ligne collective, soit l’orientation du journal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9bfd00d-7e82-42a1-9366-9920001ac29b",
                        "source_entry_id": "79670bea-90d9-3741-a197-e1abee53073e",
                        "source_sense_id": "c603e257-1589-38ef-89ef-c281e4f28c89",
                        "target_lang_word": "editorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "editorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21c15d44-f5fc-3463-9333-ec89f26ac14c",
                                        "entry_id": "4555494f-145e-3ee2-aff5-2f95cbf43400",
                                        "glosses": [
                                            "Of or relating to an editor, editing or an editorial."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b35ef4d-43ba-4e92-8ad6-e497467738dd",
                                                "sense_id": "21c15d44-f5fc-3463-9333-ec89f26ac14c",
                                                "text": "editorial labours; editorial remarks"
                                            },
                                            {
                                                "example_id": "39ee5851-3114-407a-a412-ebdea9480864",
                                                "sense_id": "21c15d44-f5fc-3463-9333-ec89f26ac14c",
                                                "text": "In stark opposition to what CBS editorial leadership told staff on Monday, Redstone said that she did not believe Dokoupil had violated the network’s editorial standards when he grilled Coates over the contents of his new book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d686e41-d090-3587-99a6-96e833405bb8",
                                        "entry_id": "4555494f-145e-3ee2-aff5-2f95cbf43400",
                                        "glosses": [
                                            "Appropriate for high fashion magazines."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "editorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef93a465-00d2-3e67-ab10-d78a06b51f35",
                                        "entry_id": "b4348c3e-7a60-373d-92fc-03cee2035cb5",
                                        "glosses": [
                                            "An article in a publication giving the opinion of its editors on a given topic or current event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b47bbad-19ac-4c2e-adc4-547f7cfb2445",
                                                "sense_id": "ef93a465-00d2-3e67-ab10-d78a06b51f35",
                                                "text": "Gratifying as it is to read such editorials even in the press which supports Mr. Marples' party—and to learn that the G.N. Line's London suburban electrification is at last being given a cost-benefit analysis of the kind which overwhelmingly justified the L.T. Victoria Line [...] but years later than need have been—[...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bf473e2-4381-3d16-b243-7e1aaee61271",
                                        "entry_id": "b4348c3e-7a60-373d-92fc-03cee2035cb5",
                                        "glosses": [
                                            "A similar commentary on radio or television."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90d9d833-2d19-4d24-8384-9ae4e50ac5d2",
                        "source_entry_id": "79670bea-90d9-3741-a197-e1abee53073e",
                        "source_sense_id": "c603e257-1589-38ef-89ef-c281e4f28c89",
                        "target_lang_word": "leader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b3fbaa5-4047-3612-b785-969fcb6cf02a",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Any person who leads or directs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df78d566-7da5-47d3-b6a5-16d547896792",
                                                "sense_id": "1b3fbaa5-4047-3612-b785-969fcb6cf02a",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3304206-9964-3bd5-bca0-37bfc3faa6d3",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Any person who leads or directs.",
                                            "One who goes first."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df17e311-dbcd-4986-8418-24e0625c6d0d",
                                                "sense_id": "a3304206-9964-3bd5-bca0-37bfc3faa6d3",
                                                "text": "Follow the leader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1e3e0b-a401-316c-b6d3-093db6682c8b",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Any person who leads or directs.",
                                            "One having authority to direct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361d7221-a287-4642-88a9-ef5a146e3066",
                                                "sense_id": "ca1e3e0b-a401-316c-b6d3-093db6682c8b",
                                                "text": "We elected her team leader."
                                            },
                                            {
                                                "example_id": "09768616-cb82-48dd-a4b2-410b415a2468",
                                                "sense_id": "ca1e3e0b-a401-316c-b6d3-093db6682c8b",
                                                "text": "America needs not only an administrator, but a leader - a pathfinder, a blazer of the trail to the high road that will avoid the bottomless morass of crass materialism that has engulfed so many of the great civilizations of the past."
                                            },
                                            {
                                                "example_id": "ee3afd71-3605-42eb-9bcd-68b323612414",
                                                "sense_id": "ca1e3e0b-a401-316c-b6d3-093db6682c8b",
                                                "text": "On the other hand, I must think of Korea and, particularly, of the three million enslaved Koreans in the North. My obligation as a leader of the Korean people is to achieve unification of our country by peaceful means if possible but by force if necessary."
                                            },
                                            {
                                                "example_id": "b4c13bd3-7091-4b79-802c-c0c80c037485",
                                                "sense_id": "ca1e3e0b-a401-316c-b6d3-093db6682c8b",
                                                "text": "The leader is the man who knows the way of the overlords but identifies with the life of the oppressed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749b9f9e-37f5-3aa0-a051-354cb45190a1",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Any person who leads or directs.",
                                            "One who leads a political party or group of elected party members; sometimes used in titles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4457a4fb-de70-49de-91c5-4a9fde6c97a1",
                                                "sense_id": "749b9f9e-37f5-3aa0-a051-354cb45190a1",
                                                "text": "Leader of the House of Commons"
                                            },
                                            {
                                                "example_id": "44e2241c-b90a-4654-b07a-8f7f4fbdbf3b",
                                                "sense_id": "749b9f9e-37f5-3aa0-a051-354cb45190a1",
                                                "text": "Senate Majority Leader"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e05e022d-0d6c-34fa-b78b-9904574cb64c",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Any person who leads or directs.",
                                            "A person or organization that leads in a certain field in terms of excellence, success, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59c518a-407a-4ed9-9807-f580e064da2d",
                                                "sense_id": "e05e022d-0d6c-34fa-b78b-9904574cb64c",
                                                "text": "The company is the leader in home remodeling in the county."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efde2834-cce6-3fe1-b932-a5d1e435c7ba",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Any person who leads or directs.",
                                            "A performer who leads a band, choir, or a section of an orchestra."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f15239d-b523-3d73-a12f-1f826e35c28e",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Any person who leads or directs.",
                                            "The first violin in a symphony orchestra; the concertmaster."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8e77b6c-2090-396c-9bfd-8b5f5bb73f8a",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "An animal that leads.",
                                            "The dominant animal in a pack of animals, such as wolves or lions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "591fa31e-a488-44a4-87e1-3f345a9c8776",
                                                "sense_id": "f8e77b6c-2090-396c-9bfd-8b5f5bb73f8a",
                                                "text": "The gesture of licking and nipping a leader's muzzle is similar to the food-begging behavior of wolf pups and may be related to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73a69d72-97fa-3a5b-8e7a-392e690dcf57",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "An animal that leads.",
                                            "An animal placed in advance of others, especially on a team of horse, oxen, or dogs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31988fc-dde0-47e3-be7b-60df7e29bd9a",
                                                "sense_id": "73a69d72-97fa-3a5b-8e7a-392e690dcf57",
                                                "text": "Still there are many passages in his [Donne's] writings, where it is plain that he forgot to pull in his leaders; and they gallop away with him at times over hill and dale, over ploughed land and waste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6140fca-ffc4-3eca-b9db-1cd39be6c654",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "An animal that leads.",
                                            "Either of the two front horses of a team of four in front of a carriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b64dfc-04fb-475d-b4ad-991afe14eae0",
                                                "sense_id": "b6140fca-ffc4-3eca-b9db-1cd39be6c654",
                                                "text": "How proud felt Pierre: In fancy’s eye, he saw the horse-ghosts a-tandem in the van; “These are but wheelers”—cried young Pierre—“the leaders are the generations.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d653c708-6430-3dcb-a0bd-63628eb19acc",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Someone or something that leads or conducts.",
                                            "A fast-growing terminal shoot of a woody plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1fd6ec1-91ec-4f33-b909-336597ba58e4",
                                                "sense_id": "d653c708-6430-3dcb-a0bd-63628eb19acc",
                                                "text": "A strong central leader may result in essentially horizontal branches resembling a \"telephone pole.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25630e24-99bd-3d41-bea0-3fa65b57a40a",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
                                            "Someone or something that leads or conducts.",
                                            "A pipe for conducting rain water from a roof to a cistern or to the ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a1b0b14-9136-3447-b3f7-7b5b008dcbc8",
                                        "entry_id": "e6b8c3e2-b4be-3731-9da6-83b0a0248a95",
                                        "glosses": [
