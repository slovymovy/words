                                        "entry_id": "cd0c0dff-58c7-3fd2-b817-f3e20cf44c94",
                                        "glosses": [
                                            "Temper; anger, passion."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9edc2752-09b8-42b0-8456-eacff89b3594",
                                                "sense_id": "3ace22e6-9389-3912-8b6c-b3fb6d6f20cb",
                                                "text": "But her Irish was up too high to do any thing with her, and so I quit trying."
                                            },
                                            {
                                                "example_id": "a8c33470-d2ff-49f1-96e8-11ffcb2ecd5d",
                                                "sense_id": "3ace22e6-9389-3912-8b6c-b3fb6d6f20cb",
                                                "text": "Whenever he got his Irish up, Clancy lowered the boom."
                                            },
                                            {
                                                "example_id": "16290f30-c018-490f-8ecb-bffe68976a8b",
                                                "sense_id": "3ace22e6-9389-3912-8b6c-b3fb6d6f20cb",
                                                "text": "The Priest is as fierce a fighter as I am when he gets his Irish up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44dbf07f-4866-3144-86ec-a8dcba1f2bcf",
                                        "entry_id": "cd0c0dff-58c7-3fd2-b817-f3e20cf44c94",
                                        "glosses": [
                                            "Whiskey, or whisky, elaborated in Ireland."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877bcf8a-fbde-4166-9a79-ae82aa1a1836",
                                                "sense_id": "44dbf07f-4866-3144-86ec-a8dcba1f2bcf",
                                                "text": "Harris said he'd had enough oratory for one night, and proposed that we should go out and have a smile, saying that he had found a place, round by the square, where you could really get a drop of Irish worth drinking."
                                            }
                                        ]
                                    }
                                ]
                            },
