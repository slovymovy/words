                "senses": [
                    {
                        "sense_id": "d16314f2-7601-3d3b-901e-3b54cc735470",
                        "entry_id": "09298e5d-81a3-3fc0-8ec3-5fc2224c49f4",
                        "glosses": [
                            "ciemny razowy chleb przydzielany dawniej żołnierzom"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6336be-b8cd-4e46-b551-0a4f38be4183",
                                "sense_id": "d16314f2-7601-3d3b-901e-3b54cc735470",
                                "text": "Pewnego razu żołnierze zameldowali mu, że komiśniaka, który właśnie fasowali – żreć niepodobna"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
