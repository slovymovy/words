                "senses": [
                    {
                        "sense_id": "d909f39f-9feb-337e-8e70-e44a08f0d8e2",
                        "entry_id": "1fb68da5-e71f-3bc3-a07e-f54591784639",
                        "glosses": [
                            "jemand, der mit einer Stoppuhr die Zeit nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80781b3-0de7-4e26-b979-cef08cad2a4b",
                                "sense_id": "d909f39f-9feb-337e-8e70-e44a08f0d8e2",
                                "text": "Der Stopper hat gepennt, die Messung war sowas von ungenau."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aace5dba-2769-3a3b-9d79-4402dc4660da",
                        "entry_id": "1fb68da5-e71f-3bc3-a07e-f54591784639",
                        "glosses": [
                            "Abwehrspieler, der meist für torgefährliche gegnerische Spieler zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa803a6-4be0-4b16-9d57-e7b72b362a4d",
                                "sense_id": "aace5dba-2769-3a3b-9d79-4402dc4660da",
                                "text": "Er erfüllt die Aufgabe als Stopper gar nicht mal so schlecht."
                            },
                            {
                                "example_id": "2da11317-ed22-4a67-ad3f-d649b45ce105",
                                "sense_id": "aace5dba-2769-3a3b-9d79-4402dc4660da",
                                "text": "„Gerhard Marotzke ist ein zuverlässiger Abwehrspieler, der sowohl als Verteidiger als auch als Stopper seine Leistung bringt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5f2e4925-421f-3099-9c54-5349f5a36e0a",
                        "entry_id": "1fb68da5-e71f-3bc3-a07e-f54591784639",
                        "glosses": [
                            "Haltevorrichtung für ein Tau oder eine Ankerkette"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "4c15dc8f-8271-4500-b877-710ef3880f0b",
                                "sense_id": "5f2e4925-421f-3099-9c54-5349f5a36e0a",
                                "text": "„Soll der Stopper längere Zeit die Ankerkette tragen, so schließt man ihn dadurch, daß man durch einen ihn oben deckenden Eisenbügel einen Querbolzen steckt, welcher die Ankerkette herunterdrückt und verhindert, daß sie nach oben aus ihrem Lager springt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "97f0f0dd-7bb6-3345-9feb-6e3f311f3377",
                        "entry_id": "1fb68da5-e71f-3bc3-a07e-f54591784639",
                        "glosses": [
                            "vorn am Rollschuh angebrachter Klotz zum Bremsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502b9aad-1da1-4ddf-bf88-cd5f073a080d",
                                "sense_id": "97f0f0dd-7bb6-3345-9feb-6e3f311f3377",
                                "text": "Sie ging leicht in die Knie und berührte nur kurz mit den Stoppern das blanke Parkett, bevor sie zum Stehen kam."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
