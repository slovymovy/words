                "senses": [
                    {
                        "sense_id": "83c53917-a11a-3d6f-9812-45f219a16365",
                        "entry_id": "d0273372-577f-3ab1-9677-2f0ca6a3ec6c",
                        "glosses": [
                            "Angestellter eines Krankenhauses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "895fc354-53f1-46b5-9a05-e2cc9f159e0e",
                                "sense_id": "83c53917-a11a-3d6f-9812-45f219a16365",
                                "text": "„Krankenhausangestellte umringten uns voll gespannter Neugier, darauf erpicht, unserem Gedächtnis auf die Sprünge zu helfen, indem sie uns erzählten, wie wir hierhergelangt waren.“"
                            },
                            {
                                "example_id": "998a19be-7389-48b7-9167-e27c2da364df",
                                "sense_id": "83c53917-a11a-3d6f-9812-45f219a16365",
                                "text": "„Im Fall Pierce unterrichteten glücklicherweise misstrauische Krankenhausangestellte unverzüglich die Strafverfolgungsbehörden, obgleich ihnen keinerlei Beweise für ein Verbrechen vorlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
