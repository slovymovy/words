            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59b056a6-323e-3a36-b68a-9819102d2356",
                    "sense_definition": "Член религиозной общины, давший обет вести аскетическую жизнь в соответствии с церковным уставом.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "религия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый <w>монах</w> тихо молился в своей келье ранним утром.",
                            "target_lang_translations": {
                                "fr": "Le vieux <w>moine</w> priait silencieusement dans sa cellule au petit matin."
                            }
                        },
                        {
                            "text": "После долгих странствий он решил уйти в монастырь и стать <w>монахом</w>.",
                            "target_lang_translations": {
                                "fr": "Après de longues pérégrinations, il décida d'entrer au monastère et de se faire <w>moine</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "чернец"
                    ],
                    "antonyms": [
                        "мирянин"
                    ],
                    "common_phrases": [
                        "православный монах",
                        "буддийский монах",
                        "постричься в монахи",
                        "келья монаха"
                    ],
                    "target_lang_definitions": {
                        "fr": "Membre d'une communauté religieuse ayant fait des vœux et menant une vie ascétique selon une règle commune."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "moine",
                                "target_lang_sense_clarification": "religieux membre d'un ordre"
                            },
                            {
                                "target_lang_word": "religieux",
                                "target_lang_sense_clarification": "membre d'un ordre religieux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c24b7d75-eef0-35cf-93a6-4f7e39b1b160",
                    "sense_definition": "Человек, ведущий замкнутый, суровый образ жизни и избегающий мирских и плотских удовольствий.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "поведение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он совсем перестал встречаться с друзьями и последние годы живёт настоящим <w>монахом</w>.",
                            "target_lang_translations": {
                                "fr": "Il a complètement cessé de voir ses amis et vit ces dernières années comme un véritable <w>moine</w>."
                            }
                        },
                        {
                            "text": "Не стоит вести себя как <w>монах</w>, когда вокруг столько интересных возможностей.",
                            "target_lang_translations": {
                                "fr": "Il ne faut pas se comporter comme un <w>moine</w> alors qu'il y a tant d'opportunités intéressantes autour de toi."
                            }
                        }
                    ],
                    "synonyms": [
                        "аскет"
                    ],
                    "antonyms": [
                        "жизнелюб",
                        "развратник"
                    ],
                    "common_phrases": [
                        "жить монахом"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne menant une existence recluse, austère et évitant les plaisirs mondains ou charnels."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "moine",
                                "target_lang_sense_clarification": "figuré, personne menant une vie austère et recluse"
                            },
                            {
                                "target_lang_word": "ascète",
                                "target_lang_sense_clarification": "personne s'imposant des privations rigoureuses"
                            },
                            {
                                "target_lang_word": "anachorète",
                                "target_lang_sense_clarification": "personne vivant retirée du monde"
                            }
                        ]
                    }
                }
            ]
        }
    ]
