                                        "entry_id": "8e534fd5-b2f2-32b8-b260-2e26f6104384",
                                        "glosses": [
                                            "A fishing lure made to resemble a prey fish and that wobbles in the water; plug, minnow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "643a5d62-5fed-37b6-b007-c3ece19c8fbd",
