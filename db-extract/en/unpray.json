                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae22613-5ade-49d5-b9f2-45d6a0745cf2",
                                "sense_id": "a052a83c-d840-379a-8f8b-662682859504",
                                "text": "he found himselfe overwhelmed in the injoying of his desire, and being enrich't with an intolerable commoditie, he must now unpray his prayers[…]."
                            },
                            {
                                "example_id": "b100d20e-f2c4-40eb-ac57-faf76636d960",
                                "sense_id": "a052a83c-d840-379a-8f8b-662682859504",
                                "text": "That even vvhiles the infirmity of his [Jesus's] humane nature ſtarted at the apprehenſion of vvhat he vvas to ſuffer, and prayed againſt it, yet the freeneſs and purity of his obedience carried [him] on to it, and made him, as it vvere, un-pray vvhat he had before prayed: […]"
                            }
                        ]
                    }
