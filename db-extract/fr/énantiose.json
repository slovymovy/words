                        "sense_id": "ef582358-f9d5-3faa-93ab-71f3a67bb3b1",
                        "entry_id": "e0aeeb83-4264-3239-a1c6-83ea5c585a2a",
                        "glosses": [
                            "Antithèse, opposition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ba38c4-a902-4c00-8094-da92edaf8819",
                                "sense_id": "ef582358-f9d5-3faa-93ab-71f3a67bb3b1",
                                "text": "L’énantiose décrit chacune des dix oppositions fondamentales des pythagoriciens comme « le bien et le mal » par exemple."
                            },
                            {
                                "example_id": "0287e603-2bf3-44a9-9203-512f288ead16",
                                "sense_id": "ef582358-f9d5-3faa-93ab-71f3a67bb3b1",
                                "text": "En rhétorique, on distingue l’objection, l’opposition, l’énantiose (antithèse spéculative), la concession et la contre-attaque (rétorsion)."
                            },
                            {
                                "example_id": "d92f877b-39a8-4811-8aef-f94775a41eb3",
                                "sense_id": "ef582358-f9d5-3faa-93ab-71f3a67bb3b1",
                                "text": "L’énantiose est une opposition essentielle qui se distingue de l’antithèse - forme rhétorique traduisant un certain procédé d’expression qui évolue par l’opposition de termes contradictoires."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d67ac0e-8cc0-3600-b416-6ca98030aebb",
                        "entry_id": "e0aeeb83-4264-3239-a1c6-83ea5c585a2a",
                        "glosses": [
                            "Traitement d’une maladie, d’une douleur par son opposé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33ad49a4-c817-43fb-933c-3838b23a5333",
                                "sense_id": "3d67ac0e-8cc0-3600-b416-6ca98030aebb",
                                "text": "Traiter une brûlure par l’eau glacée, c’est de l’énantiose."
                            }
                        ]
                    }
