                    },
                    {
                        "translation_id": "278b683b-5c72-4a9f-bc39-b9ad181cbd97",
                        "source_entry_id": "849c0b7d-eee5-3edf-b0ab-375bf17af22b",
                        "source_sense_id": "2e192b81-db60-3d41-a275-ab5790a483d0",
