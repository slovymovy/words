                                        "entry_id": "b8449a8b-2568-3bf1-8430-5a47da837bdd",
                                        "glosses": [
                                            "meist manuelle Stimulation der eigenen Geschlechtsorgane für sexuellen Lustgewinn"
                                        ],
                                        "tags": [],
