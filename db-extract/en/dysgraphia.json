                            {
                                "target_word": "dysgraphie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04f602fa-66ee-304f-b487-3900b66e8e5c",
                                        "entry_id": "58fb4272-06e8-3c46-8e54-3966ea125b50",
                                        "glosses": [
                                            "Trouble de l’apprentissage de l’écriture manuscrite qui relève de la compétence orthophonique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3beb51d-5254-47c3-9daa-a4200b941b1a",
                                                "sense_id": "04f602fa-66ee-304f-b487-3900b66e8e5c",
                                                "text": "Le trouble visuo-attentionnel ou visuo-spatial peut être responsable d’une dysgraphie."
                                            },
                                            {
                                                "example_id": "25c63508-a95c-4d80-82a4-c98f43eb6ccf",
                                                "sense_id": "04f602fa-66ee-304f-b487-3900b66e8e5c",
                                                "text": "L’orthophoniste peut alors établir un diagnostic concernant les domaines d’intervention prévus dans sa nomenclature (dyslexie, dysorthographie, dysgraphie, dysphasie, etc.)."
                                            },
                                            {
                                                "example_id": "8b5f91a6-df43-4559-bcd8-bdd47eca9aca",
                                                "sense_id": "04f602fa-66ee-304f-b487-3900b66e8e5c",
                                                "text": "Extradys organise une journée sur les difficultés d’enfants, d’adolescents souffrant de Troubles spécifiques du langage et des Apprentissages (TSLA) appelés communément « Troubles DYS » (dyslexie, dysorthographie, dysgraphie, dyscalculie, dyspraxie, dysphasie), dimanche 18 juin à la salle en dessous du dojo à Malemort de 9h30 à 13h."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63db4c1c-55dc-42be-b8dc-1616e972844e",
                        "source_entry_id": "4af54b23-ef00-3a13-ac27-a812936c749d",
                        "source_sense_id": "9a573ec5-35ba-3a59-b211-17163ac33fbc",
                        "source_sense_description": "language disorder",
                        "target_lang_word": "Dysgraphie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dysgraphie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                                        "entry_id": "2c7ad22f-2b3d-33fd-a554-93b40f1740c6",
                                        "glosses": [
                                            "Störung der Schreibfähigkeit, leichte Form der Agraphie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ab0876-ce9f-4363-8576-aaf745efe029",
                                                "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                                                "text": "„Der Begriff Dysgraphie (lat. dys = etwas schlecht können; graphia = auf den Schreibpromss bezogen) beschreibt die durch Probleme bei der neurologischen Verarbeitung bedingte Schwierigkeit, Buchstaben, Wörter oder Zahlen mit Leichtigkeit zu schreiben.“"
                                            },
                                            {
                                                "example_id": "89a9f9bc-f86d-4cba-8a6f-e8688aa5343e",
                                                "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                                                "text": "„Eine Dysgraphie bezeichnet die Unfähigkeit, Wörter und Texte zu schreiben, obgleich die dafür notwendige Handmotorik und die dafür notwendige Intelligenz vorhanden sind.“"
                                            },
                                            {
                                                "example_id": "72a96c64-c0e7-47af-9413-f410cfa371bf",
                                                "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                                                "text": "„Die Übungsbehandlung der Dysgraphie erfolgt meist zusammen mit der Dyslexietherapie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
