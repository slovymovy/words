{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "d2f583a9-ec63-39c2-89ef-8fa59c1e6749",
                    "sense_definition": "wskazujący na cechy lub rodzaj czegoś, o czym była mowa",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wskazanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie lubię <w>takich</w> filmów.",
                            "target_lang_translations": {
                                "en": "I don't like <w>such</w> movies."
                            }
                        },
                        {
                            "text": "Dlaczego kupiłeś <w>taką</w> drogą kurtkę?",
                            "target_lang_translations": {
                                "en": "Why did you buy <w>such</w> an expensive jacket?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "taki sam",
                        "taki sobie"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate the qualities or type of something previously mentioned."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "Used to refer to a type or quality of something previously mentioned."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb0ae8cc-b16d-3812-9b9b-e21debf12421",
                    "sense_definition": "używany do wzmocnienia znaczenia przymiotnika",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wzmocnienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Andrzej jest <w>taki</w> przystojny!",
                            "target_lang_translations": {
                                "en": "Andrzej is <w>so</w> handsome!"
                            }
                        },
                        {
                            "text": "To zadanie jest <w>takie</w> trudne.",
                            "target_lang_translations": {
                                "en": "This task is <w>so</w> difficult."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize the meaning of an adjective."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "Used as an intensifier before an adjective."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dded0cf-f6d5-392f-9690-79617502758f",
                    "sense_definition": "używany w porównaniach do wyrażenia identyczności cech",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "porównanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nigdy nie miałem <w>takiej</w> dziewczyny jak ty.",
                            "target_lang_translations": {
                                "en": "I've never had <w>such</w> a girlfriend as you."
                            }
                        },
                        {
                            "text": "Chcę mieć <w>taki</w> dom jak moi rodzice.",
                            "target_lang_translations": {
                                "en": "I want to have <w>such</w> a house as my parents."
                            }
                        }
                    ],
                    "synonyms": [
                        "identyczny",
                        "jednakowy"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in comparisons to express identity of qualities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "Used to compare qualities or types."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8478ade5-3b75-3080-bf9f-0b14d9ec9f19",
                    "sense_definition": "używany jako zastępnik przymiotnika znanego z kontekstu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zastępnik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ale jesteś skąpy! Nie wiedziałam, że <w>taki</w> jesteś!",
                            "target_lang_translations": {
                                "en": "You are so stingy! I didn't know you were <w>such</w>!"
                            }
                        },
                        {
                            "text": "Mówili, że jest miły, ale on wcale nie jest <w>taki</w>.",
                            "target_lang_translations": {
                                "en": "They said he was nice, but he isn't <w>such</w> at all."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a substitute for an adjective known from context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "Used to refer back to a previously mentioned quality."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "b3ff0f17-0ad1-38cf-87be-443f64f7a2a7",
                    "sense_definition": "spójnik oznaczający to samo co jednak",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spójnik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałem iść do kina, <w>taki</w> nie miałem czasu.",
                            "target_lang_translations": {
                                "en": "I wanted to go to the cinema, <w>but</w> I didn't have time."
                            }
                        },
                        {
                            "text": "Było zimno, <w>taki</w> poszliśmy na spacer.",
                            "target_lang_translations": {
                                "en": "It was cold, <w>however</w> we went for a walk."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Kresy"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction meaning the same as 'however' or 'but'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "however",
                                "target_lang_sense_clarification": "Used to introduce a contrasting statement."
                            },
                            {
                                "target_lang_word": "but",
                                "target_lang_sense_clarification": "Used to introduce a contrast."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}