                "senses": [
                    {
                        "sense_id": "91be9f1f-fa5e-3a6b-9203-69800a559ed3",
                        "entry_id": "a0f4df7d-76d7-33f2-9601-0edae61e5618",
                        "glosses": [
                            "To remove the garter or garters from."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b7192a8-d0dd-46d9-81ea-322696410aef",
                                "sense_id": "91be9f1f-fa5e-3a6b-9203-69800a559ed3",
                                "text": "Unbend, my dear dean, mon cher doyen — unlace, ungarter yourself!"
                            },
                            {
                                "example_id": "56145f08-ecc6-4e99-85ef-56544161886d",
                                "sense_id": "91be9f1f-fa5e-3a6b-9203-69800a559ed3",
                                "text": "She looks down at her other stocking and starts to ungarter that."
                            },
                            {
                                "example_id": "cc011c67-5eeb-43f6-a8c4-e3f1d18b49f1",
                                "sense_id": "91be9f1f-fa5e-3a6b-9203-69800a559ed3",
                                "text": "He pulls off his tie, and puts it, knotted, into his jacket pocket, ungarters his stockings and rolls them to just above his ankles, and pulls off and puts on his knitted nooby five or six times, until the brittle surface of his hair is somewhat softer."
                            },
                            {
                                "example_id": "f8ea89b2-4c30-44be-90bd-6bb9db5d1785",
                                "sense_id": "91be9f1f-fa5e-3a6b-9203-69800a559ed3",
                                "text": "Presently up she whips her coats and ungarters her stockings, contemplates her legs, turns them this way, and that way, and in short practised a thousand manoeuvers, which I have not at present leisure to expatiate upon; suffice it to say not a single movement was lost upon me, and from that hour to the present moment, I never see a pretty leg but I feel certain unutterable emotions within me, which seem to realize the observations of the poet:"
                            }
                        ]
                    }
