                "senses": [
                    {
                        "sense_id": "6c087cc1-d2a9-3cfa-b687-6dbb70a684a3",
                        "entry_id": "34f302a9-2e0f-3843-9318-35b452bff5f7",
                        "glosses": [
                            "geschlossener Raum, der zu einem Grab gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b54d741-4e97-4216-9cc9-bdc94688f63a",
                                "sense_id": "6c087cc1-d2a9-3cfa-b687-6dbb70a684a3",
                                "text": "„Der Brauch, bedeutende Krieger oder Fürsten mit ihren Waffen und Geräten auf einem Wagen zu verbrennen und mit Beigaben aus Gold und Gefäßen aus Ton und Bronze in einer Grabkammer beizusetzen, war in der früheren Hallstattzeit weit verbreitet, wie andere Wagengräber belegen.“"
                            },
                            {
                                "example_id": "55d14945-de22-4ae1-8e2f-10c0193a4667",
                                "sense_id": "6c087cc1-d2a9-3cfa-b687-6dbb70a684a3",
                                "text": "„Unter dem Viereck gewaltiger Steinblöcke sollen sich einige Grabkammern befinden, in denen angeblich reich verzierte Tongefäße wie auch menschliche Knochen und Schädel entdeckt wurden.“"
                            },
                            {
                                "example_id": "c296ac0c-de56-4e62-87f8-cc1eef074f53",
                                "sense_id": "6c087cc1-d2a9-3cfa-b687-6dbb70a684a3",
                                "text": "„Die Grabkammer besteht aus seitlichen Erweiterungen des Schachts, der Stufen besitzt.“"
                            },
                            {
                                "example_id": "ffe0ae84-2e80-4160-9f0c-6247c68b9972",
                                "sense_id": "6c087cc1-d2a9-3cfa-b687-6dbb70a684a3",
                                "text": "„Häufiger als aus Mauerwerk oder Steinbrocken bestand eine Grabkammer allerdings aus Balken und Baumstämmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "726fd9ee-c005-484a-a9c7-b54a50791f15",
