                "senses": [
                    {
                        "sense_id": "784b87c1-24e9-3353-b9fb-1357121d8d01",
                        "entry_id": "31736557-f0bb-385b-991a-f9ea9647b4d8",
                        "glosses": [
                            "Vehikel, in der Regel mit Rädern, unabhängig von Antriebsart und Dimension der Bewegung (auch senkrecht)"
                        ],
                        "tags": [
                            "Fortbewegung",
                            "Oberbegriff"
                        ],
                        "examples": [
                            {
                                "example_id": "6c7566f7-ef8e-45b4-86c0-6e837e6c94e5",
                                "sense_id": "784b87c1-24e9-3353-b9fb-1357121d8d01",
                                "text": "„Schon am Ende des ersten Unterrichts ist die allgemeine Handhabung des Fahrgeräts erworben.“"
                            },
                            {
                                "example_id": "5dc478fc-5f70-44db-a9b9-8335acf3cc04",
                                "sense_id": "784b87c1-24e9-3353-b9fb-1357121d8d01",
                                "text": "„Eine Gasdruckfeder unterstützt Sie beim Anheben des Fahrgerätes.“"
                            },
                            {
                                "example_id": "f4b78eae-cd08-442f-8d0a-6ed540755ac9",
                                "sense_id": "784b87c1-24e9-3353-b9fb-1357121d8d01",
                                "text": "„1880 führte Werner von Siemens mit […] Johann Georg Halske […] einen neuartigen Senkrechtfahrer vor. Bei dem Fahrgerät wurde die Plattform aber weder von einem Kolben hydraulisch geschoben, noch wurde die Kabine hochgezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
