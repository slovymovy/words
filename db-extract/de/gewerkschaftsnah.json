                ],
                "senses": [
                    {
                        "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                        "entry_id": "5f685fd2-68ed-390e-b674-fea2d21cfeee",
                        "glosses": [
                            "eine Nähe zu einer oder mehreren Gewerkschaften habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0e6283-8b91-4899-8bf4-6269381177d8",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Welche Gefahren der Demokratie durch die Konzentration von Medienmacht entstehen koennen, untersucht ein Seminar, das die gewerkschaftsnahe Landesarbeitsgemeinschaft Arbeit und Leben von 28.“"
                            },
                            {
                                "example_id": "8f613208-2271-4523-b0db-e19b19aecb80",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„In einigen Kantonen spalteten sich gewerkschaftsnahe Flügel der SP ab und bildeten eigene Parteien.“"
                            },
                            {
                                "example_id": "1560d9f1-fef1-428e-b521-948d23ed52d9",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Im Bundeswirtschaftsministerium will man den Vorschlägen des Wirtschaftsweisen Franz, der einst als gewerkschaftsnah und mittlerweile eher als Marktliberaler gilt, ebenfalls nicht folgen.“"
                            },
                            {
                                "example_id": "366a9ef7-aeea-4800-8648-8bc02bc836a2",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Kein Verständnis hat SPD-Politiker Eisold dafür, dass die gewerkschaftsnahe Hans-Böckler-Stiftung den Druck des ‚Camp-Readers‘ mit 1500 Euro finanziell unterstützt hat.“"
                            },
                            {
                                "example_id": "9c23c26c-1d06-49ab-8131-bad0ee4b53aa",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„In der Tat, die Programm-Passage zur automatischen Lohnanpassung ist sehr gewerkschaftsnah ausgefallen: ‚Nicht die Löhne treiben die Preise in die Höhe, vielmehr hinkt die Lohnentwicklung der Preisentwicklung weit hinterher.‘“"
                            },
                            {
                                "example_id": "a2aac7da-26fc-4ff0-97c9-4acfd18f14af",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Obwohl China nicht Teil der Abmachung sein wird, fürchten gewerkschaftsnahe Demokraten ein Lohndumping, ein Aufweichen von Standards auf Kosten von US-Arbeitsplätzen, wenn sämtliche Schranken im Handel mit Asien fallen.“"
                            },
                            {
                                "example_id": "66c20bd9-4a5d-43e2-a1a1-ebfdddd03f0a",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Die Experten der Institute, sagt Küppersbusch, sind in der Regel politisch verortet, etwa ‚gewerkschaftsnah‘, ‚Unternehmerverband‘ oder ‚kirchlich‘.“"
                            },
                            {
                                "example_id": "4197938a-5ee9-4260-9a76-80caa60d05f8",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Nach Untersuchungen der gewerkschaftsnahen Hans-Böckler-Stiftung profitieren davon auch die Firmen.“"
                            },
                            {
                                "example_id": "884bb9ed-25b5-428c-83c2-cf4efec7936d",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Viele Haushalte hätten der Pandemie ‚große Ersparnisse gebildet‘, sagte Sebastian Dullien, Direktor des gewerkschaftsnahen Wirtschaftsforschungsinstituts IMK, dem RedaktionsNetzwerk Deutschland.“"
                            },
                            {
                                "example_id": "4ed6f8a2-67ed-4b24-a017-6427ce69eae2",
                                "sense_id": "18c77ee1-5eb9-3a65-b486-b579dda866c4",
                                "text": "„Das zeigen aktuelle Daten, die die Gewerkschaft Nahrung-Genuss-Gaststätten (NGG) zusammen mit der gewerkschaftsnahen Hans-Böckler-Stiftung im neuen Bäckerei-Monitor vorlegt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
