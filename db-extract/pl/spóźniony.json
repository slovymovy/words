                                            {
                                                "example_id": "a7f94b5d-06ff-4d8e-9aca-283dcd25f924",
                                                "sense_id": "5f45e38b-1551-3e93-a477-631ea5e7f085",
                                                "text": "Gerne wird der Schmetterlingseffekt anhand eines verspäteten Busses veranschaulicht, durch den der anschließende Zug nicht erreicht wird, schließlich der anschließende Flug auch nicht, wodurch sich aus einer kleinen Verspätung immer größere ergeben."
                                            },
                                            {
                                                "example_id": "3ee45638-85c9-46f0-9ebe-22e352455afe",
                                                "sense_id": "5f45e38b-1551-3e93-a477-631ea5e7f085",
                                                "text": "Ich schiffte mich nach London ein, um das Thier zu mustern, erreichte aber mein Ziel, in Folge einer höchst unerquicklichen Verzögerung durch Sturm und Wetter, sehr verspätet."
                                            }
                                        ],
