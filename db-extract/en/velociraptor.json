                "senses": [
                    {
                        "sense_id": "dc20af49-0643-3a07-9e47-c6f60892749e",
                        "entry_id": "53b9cfde-2c6a-31ff-90e9-0aa3a5fcba36",
                        "glosses": [
                            "A small agile dinosaur, of the genus Velociraptor, having sickle-shaped claws. It is also thought to have had a feathered coat. Fossils have been found in Late Cretaceous deposits Mongolia and China (around 75-71 mya)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50869738-6d68-419e-be8e-dd83384c114c",
                                "sense_id": "dc20af49-0643-3a07-9e47-c6f60892749e",
                                "text": "Bipedal hadrosaurs, great hulking lambeosaurs, certain rhino-like ceratopsians and relatives of the velociraptors - all large and probably able swimmers - had the greatest success."
                            }
                        ]
                    },
                    {
                        "sense_id": "7300272a-6492-3b40-93d5-e92d10b51fde",
                        "entry_id": "53b9cfde-2c6a-31ff-90e9-0aa3a5fcba36",
                        "glosses": [
                            "Also Deinonychus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a3d1ff-ae02-4808-b3c0-fac9faa1a75d",
                                "sense_id": "7300272a-6492-3b40-93d5-e92d10b51fde",
                                "text": "This is my favorite velociraptor, and that is saying a lot....That this species is sunk into Velociraptor is rather unfortunate, because the name Deinonychus Ostrom 1969a is a fine one."
                            }
                        ]
                    }
                ],
