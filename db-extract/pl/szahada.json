                    {
                        "translation_id": "cc12d496-c342-4d44-8c63-1a9f6498b7ce",
                        "source_entry_id": "fc7baeff-48ec-36e5-8ec6-bff530a29ebf",
                        "source_sense_id": "4b29bd3e-a06b-3627-b7e7-2e61c5e5dd50",
