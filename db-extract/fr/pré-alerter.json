                        "glosses": [
                            "Alerter de façon préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6074a451-bcdf-4d7b-97e1-83deb012eef7",
                                "sense_id": "f40cc091-aa7b-3fe3-bde7-d01875c2028b",
                                "text": "Il est bien entendu que pour pouvoir pré-alerter les membres de l’équipe de crise, la situation ne doit pas nécessiter une activation d’urgence de la cellule de crise, auquel cas il faut basculer immédiatement sur la procédure d’alerte."
                            },
                            {
                                "example_id": "25184084-bf81-4c0e-8f82-3fb4e6b977b6",
                                "sense_id": "f40cc091-aa7b-3fe3-bde7-d01875c2028b",
                                "text": "Prudent, il s’était volontairement écarté de l’exploitation forestière afin de ne pas pré-alerter les bûcherons."
                            }
                        ]
                    }
