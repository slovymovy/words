                "senses": [
                    {
                        "sense_id": "9da3d418-48bc-3671-b476-597e3debae9a",
                        "entry_id": "b607023a-ead1-34b2-8084-0647cff5bb37",
                        "glosses": [
                            "Qui a le caractère d'une rosserie ; qui contient des rosseries."
                        ],
                        "tags": [
                            "familiar",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1945eeee-c6fd-4d11-ba16-9585838c68fb",
                                "sense_id": "9da3d418-48bc-3671-b476-597e3debae9a",
                                "text": "Ces femmes avaient une trentaine d'années. J'enviais leur aisance, leurs rires, leurs plaisanteries rossardes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9002b24b-d21c-4ed6-a8e2-cdc89302e5f2",
                        "source_entry_id": "b607023a-ead1-34b2-8084-0647cff5bb37",
                        "source_sense_id": "9da3d418-48bc-3671-b476-597e3debae9a",
                        "target_lang_word": "Klepper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klepper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                        "entry_id": "453d28b2-8a06-3ee2-baff-fdf64a13f9a6",
                                        "glosses": [
                                            "minderwertiges, heruntergewirtschaftetes Pferd"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd0a58c4-2816-435a-9ec8-07c53ed59f50",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Der Klepper war völlig von Sinnen - das war er, und das ist die lautere Wahrheit, und er wußte ganz und gar nicht mehr, was er tat.“"
                                            },
                                            {
                                                "example_id": "74bd78f8-718a-400e-91b4-412d8d4c7742",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Wie ist es möglich, daß die Zeit so rasch verrinnt; denn sie dauerte weniger als einen Augenblick, und dabei waren die Pferde alte Klepper.“"
                                            },
                                            {
                                                "example_id": "037b4582-cd70-4254-ab70-307778c2dcc8",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Noch einmal warf er einen Blick über die liebliche Gegend, als wollte er seine Erbitterung kräftigen, und gab dann seinem Klepper den Sporn.“"
                                            },
                                            {
                                                "example_id": "f5ad8307-ec15-418c-b0ad-ea69e37f7cb7",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Und blickt man dem Alten auf dem Klepper im Vordergrund ins irre Auge, beginnt einem das Herz schneller zu schlagen, als wolle es, wenn schon nicht dem letzten Tag der Welt, dann doch dem eigenen letzten Schlag entgegenpochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44798002-42e7-3582-9106-776e84ee5628",
                                        "entry_id": "453d28b2-8a06-3ee2-baff-fdf64a13f9a6",
                                        "glosses": [
                                            "wasserdichter Mantel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "311d660d-21b0-4fde-9e2a-733b976e76f9",
                                                "sense_id": "44798002-42e7-3582-9106-776e84ee5628",
                                                "text": "Bei Regenwetter ist ein Klepper sehr nützlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3772b704-10a4-49dd-b0a2-1b0924f0b6e1",
                        "source_entry_id": "b607023a-ead1-34b2-8084-0647cff5bb37",
                        "source_sense_id": "9da3d418-48bc-3671-b476-597e3debae9a",
                        "target_lang_word": "Mähre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mähre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6451f8fa-e7c3-3a31-af37-c19249e4f10c",
                                        "entry_id": "ea1886cc-a8d6-3917-8c7c-0b970f1bd1fc",
                                        "glosses": [
                                            "schlechtes (heruntergekommenes, unbrauchbares) Pferd"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927d359e-fa7b-4547-9a26-f6dbd846afda",
                                                "sense_id": "6451f8fa-e7c3-3a31-af37-c19249e4f10c",
                                                "text": "Da ist die alte Mähre, kaum, dass sie noch gehen kann."
                                            },
                                            {
                                                "example_id": "36e37a9a-08ff-42dd-a75b-8e2a7f1f01ed",
                                                "sense_id": "6451f8fa-e7c3-3a31-af37-c19249e4f10c",
                                                "text": "„Aber war es nicht seine eigene, sondern des Squire Rotschimmel, den er für seine Mähre hielt…“"
                                            },
                                            {
                                                "example_id": "5ee3130a-b768-4184-a5a1-5b02eb64cfb8",
                                                "sense_id": "6451f8fa-e7c3-3a31-af37-c19249e4f10c",
                                                "text": "„Der Kutscher erhebt sich und gibt seiner Mähre die Peitsche, freihändig auf dem bockenden Karren balancierend wie ein Kampfwagenlenker im alten Rom.“"
                                            },
                                            {
                                                "example_id": "eb1eba35-3ddd-425c-b6f0-224a88f94402",
                                                "sense_id": "6451f8fa-e7c3-3a31-af37-c19249e4f10c",
                                                "text": "„Als der Bulle dann auf uns losging, ließ die Mähre sich auf alle viere fallen, und das Theater ging von neuem los…“"
                                            },
                                            {
                                                "example_id": "854bf17f-33fd-4ea8-9968-eab013a4d365",
                                                "sense_id": "6451f8fa-e7c3-3a31-af37-c19249e4f10c",
                                                "text": "„Andrew hatte unterwegs gelesen und gar nicht bemerkt, dass die alte Mähre einen falschen Weg einschlug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mähre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2dfc71-0f84-31aa-ad17-e4adddc2e888",
                                        "entry_id": "ab3c7598-600c-3ac3-9f5f-07b19002d6e3",
                                        "glosses": [
                                            "Person, die in Mähren lebt oder dort geboren wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
