                "senses": [
                    {
                        "sense_id": "cd7f3e82-b958-374c-a2f9-0d828362f78f",
                        "entry_id": "48b3bc05-b722-360b-9898-63a2041b8bb1",
                        "glosses": [
                            "een sluiting van een fles die je door draaien open en dicht kunt maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "078cde41-6632-4f9f-b0c5-99e88ae0f92e",
                                "sense_id": "cd7f3e82-b958-374c-a2f9-0d828362f78f",
                                "text": "Heineken roept klanten die recent een kartonnen doos met statiegeldloze flesjes bier (25 cl) hebben gekocht op deze terug te brengen naar de winkel, omdat het glas van de biertjes met een draaidop bij bepaalde partijen kan breken."
                            },
                            {
                                "example_id": "23b13efd-50e7-44c4-ba84-5668f9e8d0c4",
                                "sense_id": "cd7f3e82-b958-374c-a2f9-0d828362f78f",
                                "text": "Luxe tube (in een piramidevormig doosje) met draaidop die lekker in de hand ligt en een mooie vorm heeft. De tube past prima in de handtas en is dankzij de spitse doseerdop ook zuinig en hygiënisch: er blijven geen resten achter op de dop."
                            },
                            {
                                "example_id": "c39b71b6-e1cd-4adf-b923-260bf7ff9814",
                                "sense_id": "cd7f3e82-b958-374c-a2f9-0d828362f78f",
                                "text": "De kurk wordt steeds vaker vervangen door een draaidop en dat is natuurlijk niet voor niets. De kurk, die vaak is gemaakt van hout, is namelijk gevoelig voor bacteriën die vervolgens in de wijn terecht kunnen komen. Hij tast dan niet alleen de geur, maar ook de smaak aan."
                            }
                        ]
                    }
