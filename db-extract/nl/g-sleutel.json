                        "sense_id": "177840b1-0429-38aa-9be6-587f985f542a",
                        "entry_id": "f717ef64-0467-35b5-adec-7596231c5e44",
                        "glosses": [
                            "één van drie, bij de voortekening van een notenbalk behorende aanwijzers, die een lijn voor een bepaalde toon markeren, in dit geval de toon 'g'. De overige lijnen zijn daardoor tevens bepaald. De aanwijzing geldt tot de laatste maatstreep, tenzij voordien anders aangegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1473a9f-e562-4775-91d9-08d58062c016",
                                "sense_id": "177840b1-0429-38aa-9be6-587f985f542a",
                                "text": "De g-sleutel kent iedereen wel, hij staat in de voortekening van menig muziekstuk."
                            }
                        ]
                    }
                ],
