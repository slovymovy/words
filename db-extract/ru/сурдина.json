                        ]
                    },
                    {
                        "translation_id": "c07ec5d7-1a61-43b3-9428-7c7905914e62",
                        "source_entry_id": "fafee18b-d3a2-33d3-a021-fa297e6e2d29",
                        "source_sense_id": "933f2ae7-0c49-39fd-a7ad-35340d00d585",
                        "target_lang_word": "mute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "352a91c9-90f8-3eb4-a208-e907d933b6a5",
                                        "entry_id": "ae8faeb2-6690-32d5-b930-2dad23d567f0",
                                        "glosses": [
                                            "Not having the power of speech; dumb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d59d4f32-817b-4ebb-a5f0-a248893d82ce",
                                                "sense_id": "352a91c9-90f8-3eb4-a208-e907d933b6a5",
                                                "text": "Thus, while the mute Creation downward bend / Their sight, and to their Earthy Mother tend, / Man looks aloft; and with erected Eyes / Beholds his own hereditary Skies. / From ſuch rude Principles our Form began; / And Earth was Metamorphos'd into Man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8746dc2b-c521-39cb-8015-bb2843f19225",
                                        "entry_id": "ae8faeb2-6690-32d5-b930-2dad23d567f0",
                                        "glosses": [
                                            "Silent; not making a sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96a61b2e-a7a7-4db6-8012-fadaff739928",
                                                "sense_id": "8746dc2b-c521-39cb-8015-bb2843f19225",
                                                "text": "He ask’d, but all the Heav’nly Quire ſtood mute, / And ſilence was in Heav’n: […]"
                                            },
                                            {
                                                "example_id": "076974bb-ded8-4a45-ba6b-632f108d8729",
                                                "sense_id": "8746dc2b-c521-39cb-8015-bb2843f19225",
                                                "text": "[…] The heathens have broken into Thy Temple, and Thou art silent! Esau mocks Thy Children, and Thou remainest mute! Show thyself, arise, and let Thy Voice resound, Thou mutest among all the mute!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0945d1-1152-32ad-bb7a-4d0545538fd0",
                                        "entry_id": "ae8faeb2-6690-32d5-b930-2dad23d567f0",
                                        "glosses": [
                                            "Not uttered; unpronounced; silent; also, produced by complete closure of the mouth organs which interrupt the passage of breath; said of certain letters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0a893e0-37b5-3048-a3a4-f27eae33466d",
                                        "entry_id": "ae8faeb2-6690-32d5-b930-2dad23d567f0",
                                        "glosses": [
                                            "Not giving a ringing sound when struck; said of a metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "918c6488-27fa-37fb-89ee-8483126854f6",
                                        "entry_id": "753d3b49-3e71-321b-b915-feba2fc60c37",
                                        "glosses": [
                                            "A stopped consonant; a stop."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1d7537c-94ce-37dd-ac04-ac00fe70b089",
                                        "entry_id": "753d3b49-3e71-321b-b915-feba2fc60c37",
                                        "glosses": [
                                            "An actor who does not speak; a mime performer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2b9060-7307-450f-a2f3-875165310d9c",
                                                "sense_id": "a1d7537c-94ce-37dd-ac04-ac00fe70b089",
                                                "text": "As for the poor honest Maid, whom all the Story is built upon, and who ought to be one of the principal Actors in the Play, she is commonly a Mute in it:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45939b57-bb07-37ab-89f9-9250b8d07d45",
                                        "entry_id": "753d3b49-3e71-321b-b915-feba2fc60c37",
                                        "glosses": [
                                            "A person who does not have the power of speech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d59ec556-ab29-47af-8dc6-167927b0aa41",
                                                "sense_id": "45939b57-bb07-37ab-89f9-9250b8d07d45",
                                                "text": "The girl left, and presently returned, followed by two male mutes, to whom the Queen made another sign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b40bda94-cbe8-32d0-a173-913c068f26c6",
                                        "entry_id": "753d3b49-3e71-321b-b915-feba2fc60c37",
                                        "glosses": [
                                            "A hired mourner at a funeral; an undertaker's assistant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "023231ed-48e9-4f35-ad88-dd2ffb934657",
                                                "sense_id": "b40bda94-cbe8-32d0-a173-913c068f26c6",
                                                "text": "He asked about the undertaking business, and how many mutes went down with Lady Estrich’s remains […]"
                                            },
                                            {
                                                "example_id": "8c414691-a8c2-4e4e-8a4e-e555e09790d6",
                                                "sense_id": "b40bda94-cbe8-32d0-a173-913c068f26c6",
                                                "text": "The little box was eventually carried in one hand by the leading mute, while his colleague, with a finger placed on the lid, to prevent it from swaying, walked to one side and a little to the rear."
                                            },
                                            {
                                                "example_id": "94f69f1d-54df-4944-a1ac-a77fa08221e8",
                                                "sense_id": "b40bda94-cbe8-32d0-a173-913c068f26c6",
                                                "text": "Then followed a long silence during which the mute turned to them and said, ‘Of course you'll be wanting an urn, sir?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b033f58a-ca77-3743-b915-91c02946f784",
                                        "entry_id": "753d3b49-3e71-321b-b915-feba2fc60c37",
                                        "glosses": [
                                            "An object for dulling the sound of an instrument, especially a brass instrument, or damper for pianoforte; a sordine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b406eef9-7934-3353-a5c2-0cc5c150ad37",
                                        "entry_id": "753d3b49-3e71-321b-b915-feba2fc60c37",
                                        "glosses": [
                                            "An electronic switch or control that mutes the sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4bd7b85-97d2-4906-ba62-a784770c9558",
                                                "sense_id": "b406eef9-7934-3353-a5c2-0cc5c150ad37",
                                                "text": "Another related primary control is called a mute, which is simply a switch that kills the signal altogether, allowing for a speedier turn-off than turning the fader all the way down rapidly. Mutes are probably more commonly used during multitrack music recording than during film mixing because in music all tracks are on practically all of the time, whereas workstations produce silence when there is no desired signal […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aeb5bb3-3225-3c59-918d-e09b5745e9e8",
                                        "entry_id": "753d3b49-3e71-321b-b915-feba2fc60c37",
                                        "glosses": [
                                            "A mute swan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed9b568-62e8-4641-b810-4db28dfe2eb2",
                                                "sense_id": "0aeb5bb3-3225-3c59-918d-e09b5745e9e8",
                                                "text": "The trumpeters' fate seems likely to get tangled with that of the mute swan. Currently there's enough habitat for both species, but that may change if trumpeters flourish and mutes aren't controlled. Right now mutes are thriving."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dbda138-8863-3afd-b780-027ea912c8ef",
                                        "entry_id": "33b771f9-730f-3a83-a532-5bf9d42c8629",
                                        "glosses": [
                                            "To silence, to make quiet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bdd5537-5d4d-3609-ae31-dca13c5ad14b",
                                        "entry_id": "33b771f9-730f-3a83-a532-5bf9d42c8629",
                                        "glosses": [
                                            "To turn off the sound of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d454fde9-5873-495d-a947-84756033b8a1",
                                                "sense_id": "7bdd5537-5d4d-3609-ae31-dca13c5ad14b",
                                                "text": "Please mute the music while I make a call."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccf2b717-3527-380f-889f-fc7927deac38",
                                        "entry_id": "cfc53457-9d31-3c61-9cf1-f6732da5849f",
                                        "glosses": [
                                            "Of a bird: to defecate."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c672a29e-b1a3-4712-a37b-759b9338cfd1",
                                                "sense_id": "ccf2b717-3527-380f-889f-fc7927deac38",
                                                "text": "And I knewe not that there were Sparrowes in the wall, and mine eyes being open, the Sparrowes muted warme doung into mine eyes, […]"
                                            },
                                            {
                                                "example_id": "10e90c30-2176-423f-a921-0bf01d8dc97a",
                                                "sense_id": "ccf2b717-3527-380f-889f-fc7927deac38",
                                                "text": "I Mute as a hauke dothe whan ſhe hath endued her gorge."
                                            },
                                            {
                                                "example_id": "5d5411ac-b694-4f5a-a113-309e78ed5f32",
                                                "sense_id": "ccf2b717-3527-380f-889f-fc7927deac38",
                                                "text": "The Birds were large, fine, and neat accordingly; looking as like the Men in my Country, as one Pea do's like another; for they eat and drank like Men, muted like Men, endued or digested like Men, farted like Men, but stunk like Devils, […]"
                                            },
                                            {
                                                "example_id": "4fb67a23-38d1-4914-b430-eee5fdf2a94a",
                                                "sense_id": "ccf2b717-3527-380f-889f-fc7927deac38",
                                                "text": "All the pigeons, to the number of thirty-five, flew to and fro over the men's heads and muted upon them from mid-air; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c434f92d-b65c-3204-87e5-815f3c6cc45f",
                                        "entry_id": "6d348e54-2818-33b8-82b0-524c379845d3",
                                        "glosses": [
                                            "The faeces of a hawk or falcon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ed2329-379b-4e69-a25e-c96921c67cc7",
                                                "sense_id": "c434f92d-b65c-3204-87e5-815f3c6cc45f",
                                                "text": "On which was written not in words,\nBut hieroglyphic mute of birds"
                                            },
                                            {
                                                "example_id": "72b2a504-0abe-402e-aeb7-e1054bf1fdbb",
                                                "sense_id": "c434f92d-b65c-3204-87e5-815f3c6cc45f",
                                                "text": "The Wart was familiar with the nests of Spar-hawk and Gos, the crazy conglomerations of sticks and oddments which had been taken over from squirrels or crows, and he knew how the twigs and the tree foot were splashed with white mutes, old bones, muddy feathers and castings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6cbfbb4-d5af-30b1-9ca6-b2b8560e4eb0",
                                        "entry_id": "bcdc6360-23f9-32c1-862b-5e5fac077d8e",
                                        "glosses": [
                                            "To cast off; to moult."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01545263-fd8b-460c-a920-f0dc287224ef",
                                                "sense_id": "f6cbfbb4-d5af-30b1-9ca6-b2b8560e4eb0",
                                                "text": "Have I muted all my feathers?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
