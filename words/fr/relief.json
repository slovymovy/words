                {
                    "sense_id": "7672481c-199a-3fb6-bccf-7574fe10b011",
                    "sense_definition": "Ensemble des inégalités et des élévations de la surface de la terre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "topographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette région montagneuse présente un <w>relief</w> très accidenté qui rend les déplacements difficiles."
                        },
                        {
                            "text": "La plaine s'étend à perte de vue sans aucun <w>relief</w> pour arrêter le regard."
                        }
                    ],
                    "common_phrases": [
                        "relief accidenté",
                        "relief montagneux"
                    ]
                },
                {
                    "sense_id": "2597e664-663a-30c6-b81d-3b8e81f12d7e",
                    "sense_definition": "Caractère d'un élément qui fait saillie sur une surface plane.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art_et_forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le système Braille utilise des points en <w>relief</w> pour permettre aux personnes aveugles de lire."
                        },
                        {
                            "text": "Le sculpteur a gravé des lettres en <w>relief</w> sur la pierre tombale du monument."
                        }
                    ],
                    "common_phrases": [
                        "lettres en relief",
                        "motifs en relief",
                        "effet de relief"
                    ]
                },
                {
