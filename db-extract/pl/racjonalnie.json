                    {
                        "sense_id": "653782aa-01e1-36b3-ac2d-bd269800acb2",
                        "entry_id": "1da0b834-1f68-3f40-8e9e-317a964e5acf",
                        "glosses": [
                            "rationally, reasonably, logically (in a manner based on reason and logic)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "399340b6-ab4e-4e4a-92f5-0f1495741976",
                                "sense_id": "653782aa-01e1-36b3-ac2d-bd269800acb2",
                                "text": "Kierowca ciężarówki, siwowłosy mężczyzna, jedyny racjonalnie działający i nie poddający się emocjom samozwańczy kierownik akcji ratunkowej (ileż wypadków musiał już widzieć w swej długiej karierze zawodowego szofera?), z pomocą dwóch innych mężczyzn odgiął powykręcaną maskę mercedesa.",
                                "translation": "The lorry driver, a gray-haired man, the only one rationally acting and not submitting to emotions, self-proclaimed head of the rescue (how many accidents must had been in his long career of professional chauffeur?), with a help of two other men bent away the twisted hood of the Mercedes car.",
                                "english": "The lorry driver, a gray-haired man, the only one rationally acting and not submitting to emotions, self-proclaimed head of the rescue (how many accidents must had been in his long career of professional chauffeur?), with a help of two other men bent away the twisted hood of the Mercedes car."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d317796-f2d4-3bdd-aedc-9970004f13b7",
                        "entry_id": "1da0b834-1f68-3f40-8e9e-317a964e5acf",
                        "glosses": [
                            "rationally (in a manner based on science and planned for best results)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fb4009-7b81-4677-a24e-269a4c1a1b9f",
                                "sense_id": "8d317796-f2d4-3bdd-aedc-9970004f13b7",
                                "text": "Anorektyczki zmuszają się do niejedzenia. Ja jem, tyle że racjonalnie.",
                                "translation": "The anorectics force themselves not to eat. I eat, but rationally.",
                                "english": "The anorectics force themselves not to eat. I eat, but rationally."
                            }
                        ]
                    }
