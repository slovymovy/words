                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorer found a small <w>rive</w> in the rock face where water seeped through.",
                            "target_lang_translations": {
                                "ru": "Исследователь нашел небольшую <w>трещину</w> в скале, через которую просачивалась вода."
