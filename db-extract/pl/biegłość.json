                                        "examples": [
                                            {
                                                "example_id": "b869cc4f-5a2f-4dec-9330-a55f2710e232",
                                                "sense_id": "8318fcb0-4d4d-3389-a2bb-69a6bde7d5ae",
                                                "text": "As for the virginals I have none here that skill of them, except the young lord."
                                            },
                                            {
                                                "example_id": "4583a2b2-bed4-4643-bae6-a5577a6bdf4d",
                                                "sense_id": "8318fcb0-4d4d-3389-a2bb-69a6bde7d5ae",
                                                "text": "17th century, Isaac Barrow, “On Industry in Our Particular Calling as Scholars,”\n[…] to skill the arts of expressing our mind and imparting our conceptions with advantage, so as to instruct or persuade others […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e4adc1-2a71-37b2-804d-0017d5f934b3",
                                        "entry_id": "d0d8c267-e755-3c11-8751-a69c78af7ab8",
                                        "glosses": [
                                            "To have knowledge or comprehension; discern."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c39b0a6-4c5c-33a4-a259-aa57f76cfe2f",
                                        "entry_id": "d0d8c267-e755-3c11-8751-a69c78af7ab8",
                                        "glosses": [
                                            "To have personal or practical knowledge; be versed or practised; be expert or dextrous."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                        "entry_id": "d0d8c267-e755-3c11-8751-a69c78af7ab8",
                                        "glosses": [
                                            "To make a difference; signify; matter."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05eb4665-d6fb-4f61-b268-8659c25ae1a7",
                                                "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                                "text": "So then the whole scripture of God, being true, whence soever this be delivered and gathered, it skilleth not […]"
                                            },
                                            {
                                                "example_id": "e5bd937f-63bc-45b9-9738-e52c467def77",
                                                "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                                "text": "[…] I should have given’t you to-day morning, but as a madman’s epistles are no gospels, so it skills not much when they are delivered."
                                            },
                                            {
                                                "example_id": "176b93b8-8e4b-42fa-a8fe-a189c3c5034e",
                                                "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                                "text": "What skills it, if a bag of stones or gold\nAbout thy neck do drown thee?"
                                            },
                                            {
                                                "example_id": "7d700183-3216-4b3d-a398-a7b1e4fe9bfd",
                                                "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                                "text": "But it skills not talking of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa26b661-bbba-3c34-8f22-00c9b542b8c2",
                                        "entry_id": "d0d8c267-e755-3c11-8751-a69c78af7ab8",
                                        "glosses": [
                                            "To spend acquired points in exchange for skills."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c7d21c7-66c2-457a-b306-158e6f1dd8e3",
                        "source_entry_id": "746a3860-7e1d-30c6-926e-141d8ce70bab",
                        "source_sense_id": "b2498908-ca1f-31e6-8033-ef8706cdc38d",
                        "target_lang_word": "навык",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "навык",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6bcad275-20ce-3f87-a68d-eb2038993ea1",
                                        "entry_id": "ca6722fa-5fa4-3882-8f58-8302d2895a4c",
                                        "glosses": [
                                            "умение, приобретенное упражнениями, созданное привычкой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "581e5598-1b1a-4af1-90ec-ea2e2f2c25bc",
                                                "sense_id": "6bcad275-20ce-3f87-a68d-eb2038993ea1",
                                                "text": "Умение есть из ложки — очень важный для детского развития навык, и отработать его младенец должен в положенный срок."
                                            },
                                            {
                                                "example_id": "7d68dd52-7d3c-44e8-b523-d31dd10a1c67",
                                                "sense_id": "6bcad275-20ce-3f87-a68d-eb2038993ea1",
                                                "text": "В столицах женщины получают, может быть, лучшее образование; но навык света скоро сглаживает характер и делает души столь же однообразными, как и головные уборы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
