    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "034fbb13-030e-3c2f-be5b-9bc11f2f00dc",
                    "sense_definition": "Eau, sous forme liquide ou solide, issue de la condensation atmosphérique qui tombe sur le sol, telle que la pluie, la neige ou la grêle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fortes <w>précipitations</w> ont provoqué des inondations importantes dans le sud du pays."
                        },
                        {
                            "text": "Cette région aride ne reçoit presque aucune <w>précipitation</w> pendant la période estivale."
                        }
                    ],
                    "antonyms": [
                        "sécheresse"
                    ],
                    "common_phrases": [
                        "fortes précipitations",
                        "précipitations abondantes",
                        "précipitations annuelles"
                    ]
                },
                {
                    "sense_id": "41070b56-01ca-3be3-a075-a2ec6864d26c",
                    "sense_definition": "Grande hâte ou empressement excessif et imprudent dans les actes ou les décisions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a quitté son appartement dans la <w>précipitation</w> et a oublié ses clés sur la table."
                        },
                        {
                            "text": "Agir avec <w>précipitation</w> conduit souvent à commettre des erreurs regrettables."
                        }
                    ],
                    "synonyms": [
                        "hâte",
                        "empressement"
                    ],
                    "antonyms": [
                        "calme",
                        "lenteur",
                        "patience"
                    ],
                    "common_phrases": [
                        "dans la précipitation",
                        "avec précipitation"
                    ]
                },
                {
                    "sense_id": "21739285-5c76-3479-a58b-81db24494519",
                    "sense_definition": "Formation et dépôt d'un corps solide insoluble au sein d'une solution liquide à la suite d'une réaction chimique ou physique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ajout de ce réactif provoque la <w>précipitation</w> immédiate d'un composé blanc au fond du tube."
                        },
                        {
                            "text": "Le chimiste surveille la <w>précipitation</w> des cristaux au fur et à mesure que la solution refroidit."
