                    {
                        "translation_id": "a686a5b5-ea23-46d0-b0af-5c73501b401f",
                        "source_entry_id": "41dae8eb-cd27-3975-8c23-f257a268c827",
                        "source_sense_description": "of or pertaining to a utopia",
