                "senses": [
                    {
                        "sense_id": "49b174b7-890e-3066-bafd-245cbb08361c",
                        "entry_id": "983a03b1-21cc-3d59-98f5-0e16b3bce6bc",
                        "glosses": [
                            "quadrilateral"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c56e6fdc-0f04-4a2b-9779-06784b30dcef",
                                "sense_id": "49b174b7-890e-3066-bafd-245cbb08361c",
                                "text": "czworokątny dziedziniec",
                                "translation": "quadrilateral courtyard",
                                "english": "quadrilateral courtyard"
                            },
                            {
                                "example_id": "5d2561e0-077a-490a-93e0-708e2948c1f8",
                                "sense_id": "49b174b7-890e-3066-bafd-245cbb08361c",
                                "text": "czworokątna baszta",
                                "translation": "quadrilateral wall tower",
                                "english": "quadrilateral wall tower"
                            },
                            {
                                "example_id": "632ba5b6-9610-4894-a3fe-e18c36806d4c",
                                "sense_id": "49b174b7-890e-3066-bafd-245cbb08361c",
                                "text": "czworokątna wieża",
                                "translation": "quadrilateral tower",
                                "english": "quadrilateral tower"
                            },
                            {
                                "example_id": "1b9a1ed7-368b-4d1a-ba61-1f3a50a30f50",
                                "sense_id": "49b174b7-890e-3066-bafd-245cbb08361c",
                                "text": "Zlecając zaś wykonanie projektu domu architektowi, należy dążyć do tego, aby dom i pomieszczenia miały regularny, czworokątny kształt.",
                                "translation": "Commissioning making a house plan with an architect, one needs to seek a house and its rooms having a regular, quadrilateral shape.",
                                "english": "Commissioning making a house plan with an architect, one needs to seek a house and its rooms having a regular, quadrilateral shape."
                            },
                            {
                                "example_id": "9a809421-a5bb-4bb7-b7a8-fb3486f621eb",
                                "sense_id": "49b174b7-890e-3066-bafd-245cbb08361c",
                                "text": "Klinika medyczna to czworokątny obdrapany budynek z tłumem chorych siedzących na piaszczystym placu przed wejściem.",
                                "translation": "The medical clinic is a quadrilateral dilapidated building with a crowd of the sick sitting on a sandy yard in front of the entrance.",
                                "english": "The medical clinic is a quadrilateral dilapidated building with a crowd of the sick sitting on a sandy yard in front of the entrance."
                            }
                        ]
                    }
