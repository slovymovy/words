                    {
                        "sense_id": "b8eaf28c-87f4-3cf3-a3cd-1518b2777308",
                        "entry_id": "01126e13-db3d-363d-b055-059d725fbc9f",
                        "glosses": [
                            "Vertrag zwischen zwei oder mehreren Staaten, die sich verpflichten, im Falle eines Angriffs auf einen der Staaten diesen militärisch zu unterstützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd83dac-ea18-4409-b7c5-9157651227ba",
                                "sense_id": "b8eaf28c-87f4-3cf3-a3cd-1518b2777308",
                                "text": "„Der Verteidigungspakt zwischen Jordanien und Ägypten vom 30. Mai veranlasste die israelischen Streitkräfte dazu, eine Besetzung des Westjordanlandes vorzubereiten und die Prioritäten anders zu setzen: Statt der Rangfolge Ägypten, dann Syrien, dann Jordanien galt nun Ägypten, dann Jordanien, dann Syrien.“"
                            }
                        ],
