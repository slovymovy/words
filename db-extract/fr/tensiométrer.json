                "senses": [
                    {
                        "sense_id": "4fdd83fd-94dd-33ad-9454-1782320f8eaa",
                        "entry_id": "0bd0cdef-fb03-3c9a-be3e-6556272ec4df",
                        "glosses": [
                            "Mesurer la tension artérielle de quelqu’un en utilisant un tensiomètre."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1493e817-5b7e-4b04-aa10-f5492086c95e",
                                "sense_id": "4fdd83fd-94dd-33ad-9454-1782320f8eaa",
                                "text": "Je suis pesée, auscultée, tensiométrée, réflexotestée, palpée…"
                            },
                            {
                                "example_id": "b52ff3c8-c5fc-408e-a666-5fb42190ac8c",
                                "sense_id": "4fdd83fd-94dd-33ad-9454-1782320f8eaa",
                                "text": "Après avoir fourni tout un tas de papiers (au passage, c'est drôle de voir comme la personne qui vous reçoit peut être heureuse quand vous n'avez rien oublié), après avoir subi un questionnaire sur ma santé, celle de mon père, de ma mère, de mes frères et soeurs, après qu'on m'a pesée, piquée, tensiométrée (bon ok ca n'existe pas mais c'est pour le rythme du texte)."
                            },
                            {
                                "example_id": "3084c402-ad88-42c6-8988-599c9a63d428",
                                "sense_id": "4fdd83fd-94dd-33ad-9454-1782320f8eaa",
                                "text": "ça m'amuse bien de les voir s'agiter, s'époumoner, s'éponger, se tensiométrer, s'étirer, se plaindre… et pour la plupart éviter de croiser mon regard…"
                            }
                        ]
                    }
