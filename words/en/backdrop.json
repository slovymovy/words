{
    "word_family": [
        "back",
        "drop",
        "background"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8519dd4e-5a84-3117-8240-3ea41c190dad",
                    "sense_definition": "A visual background or scenery, especially one that is striking or provides a setting for a photograph or event.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_background",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snow-capped mountains provided a <w>backdrop</w> for the wedding photos.",
                            "target_lang_translations": {
                                "ru": "Заснеженные горы послужили <w>фоном</w> для свадебных фотографий."
                            }
                        },
                        {
                            "text": "The historic castle served as a stunning <w>backdrop</w> for the outdoor music festival.",
                            "target_lang_translations": {
                                "ru": "Старинный замок стал потрясающим <w>фоном</w> для музыкального фестиваля под открытым небом."
                            }
                        }
                    ],
                    "synonyms": [
                        "background",
                        "scenery",
                        "setting"
                    ],
                    "antonyms": [
                        "foreground"
                    ],
                    "common_phrases": [
                        "stunning backdrop",
                        "scenic backdrop",
                        "perfect backdrop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Визуальный фон или декорации, особенно впечатляющие или служащие местом для фотографии или события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фон",
                                "target_lang_sense_clarification": "общий визуальный план"
                            },
                            {
                                "target_lang_word": "декорация",
                                "target_lang_sense_clarification": "окружающая обстановка"
                            },
                            {
                                "target_lang_word": "задний план",
                                "target_lang_sense_clarification": "пространство позади объекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f51a9cd5-723c-3743-ad59-fe383cd39928",
                    "sense_definition": "The general situation or set of conditions in which an event or activity happens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contextual_background",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peace talks took place against a <w>backdrop</w> of increasing political tension.",
                            "target_lang_translations": {
                                "ru": "Мирные переговоры проходили на <w>фоне</w> растущей политической напряженности."
                            }
                        },
                        {
                            "text": "The company launched its new product against a <w>backdrop</w> of falling interest rates.",
                            "target_lang_translations": {
                                "ru": "Компания выпустила новый продукт на <w>фоне</w> снижения процентных ставок."
                            }
                        }
                    ],
                    "synonyms": [
                        "context",
                        "milieu",
                        "environment"
                    ],
                    "common_phrases": [
                        "against a backdrop",
                        "economic backdrop",
                        "political backdrop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая ситуация или набор условий, в которых происходит событие или деятельность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фон",
                                "target_lang_sense_clarification": "контекст происходящего"
                            },
                            {
                                "target_lang_word": "обстановка",
                                "target_lang_sense_clarification": "условия или ситуация"
                            },
                            {
                                "target_lang_word": "контекст",
                                "target_lang_sense_clarification": "совокупность обстоятельств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4803c22-48f7-3dbd-8610-090f2b5cd440",
                    "sense_definition": "A large painted cloth hung at the back of a stage as part of the scenery for a theatrical performance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatre_scenery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stage crew lowered the painted <w>backdrop</w> depicting a dense forest.",
                            "target_lang_translations": {
                                "ru": "Сценическая группа опустила расписной <w>задник</w> с изображением густого леса."
                            }
                        },
                        {
                            "text": "The actors stood in front of a theatrical <w>backdrop</w> that represented a busy city street.",
                            "target_lang_translations": {
                                "ru": "Актеры стояли перед театральным <w>задником</w>, изображавшим оживленную городскую улицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "backcloth",
                        "drop",
                        "scenery"
                    ],
                    "common_phrases": [
                        "theatrical backdrop",
                        "painted backdrop",
                        "stage backdrop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое расписное полотно, подвешенное в глубине сцены как часть декорации для театрального представления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задник",
                                "target_lang_sense_clarification": "театральная декорация"
                            },
                            {
                                "target_lang_word": "фон",
                                "target_lang_sense_clarification": "сценический занавес"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51c42506-f113-3bff-89e7-2e42fb76ae70",
                    "sense_definition": "To provide a background for something or to be situated behind it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_background",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city lights were <w>backdropped</w> by the dark silhouette of the hills.",
                            "target_lang_translations": {
                                "ru": "Огни города <w>виднелись на фоне</w> темного силуэта холмов."
                            }
                        },
                        {
                            "text": "A brilliant sunset was <w>backdropping</w> the famous skyline as we arrived.",
                            "target_lang_translations": {
                                "ru": "Когда мы приехали, великолепный закат <w>служил фоном</w> для знаменитого очертания города."
                            }
                        }
                    ],
                    "synonyms": [
                        "background",
                        "frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить фоном для чего-либо или располагаться позади объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить фоном",
                                "target_lang_sense_clarification": "находиться на заднем плане"
                            },
                            {
                                "target_lang_word": "обрамлять",
                                "target_lang_sense_clarification": "создавать визуальную рамку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}