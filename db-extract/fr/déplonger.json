                ],
                "senses": [
                    {
                        "sense_id": "336c0ce2-524e-3459-b31c-ee87cfb8bad4",
                        "entry_id": "52fa1c31-a911-382e-842e-3ef9155991a7",
                        "glosses": [
                            "Revenir à la surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a32a82-0882-453d-b7ce-815e836a2688",
                                "sense_id": "336c0ce2-524e-3459-b31c-ee87cfb8bad4",
                                "text": "Il aimait ouvrir les yeux sous l’eau, et déplongeant, repiquer entre deux eaux, comme un dauphin."
                            },
                            {
                                "example_id": "e066b500-0ec8-43e4-8ddc-9bec7e69d1ec",
                                "sense_id": "336c0ce2-524e-3459-b31c-ee87cfb8bad4",
                                "text": "Déplonger, c’est, dans une symbolique presque baptismale, refaire en sens contraire le chemin du vertige, de l'accélération dans le vide."
                            },
                            {
                                "example_id": "b429fc85-e462-43a6-ade0-6728730f71cc",
                                "sense_id": "336c0ce2-524e-3459-b31c-ee87cfb8bad4",
                                "text": "A lire les « récits » d’E. Hocquard, j’ai cette sensation de rôder sur les abords du rêve, à ce moment où l’on va plonger ou déplonger du sommeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "81b205f7-38df-3f6c-b72d-7d7b730194ff",
                        "entry_id": "52fa1c31-a911-382e-842e-3ef9155991a7",
                        "glosses": [
                            "Faire revenir à la surface."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fe38fda8-3d88-4b92-bae0-f3314d3f903a",
                                "sense_id": "81b205f7-38df-3f6c-b72d-7d7b730194ff",
                                "text": "Elle déplaça la tête, le forçant à déplonger la sienne, et ils s’embrassèrent, à en perdre le souffle."
                            }
                        ]
                    }
                ],
