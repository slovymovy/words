                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5e1db2b-409b-4a4d-9c04-179929f333bf",
                        "source_entry_id": "3f50cbde-8956-3db6-920e-6199a21650fb",
                        "source_sense_id": "8fde5c7d-8257-3321-afdc-a36ec40e8a89",
                        "target_lang_word": "incarceration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incarceration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a92be9c6-615a-3788-8155-caceb0cb0748",
                                        "entry_id": "71ad0dff-c8bb-3611-8617-0859d8a21c85",
                                        "glosses": [
                                            "The act of confining, or the state of being confined; imprisonment."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d02e2e1-a830-42b5-b9e3-66ec45be9809",
                                                "sense_id": "a92be9c6-615a-3788-8155-caceb0cb0748",
                                                "text": "Perpetrated over time, better walk the narrow line / Never challenge what we say / In the darkness of our mind, never thought we'd be so blind / Let the nightmare get away / Isolation cannot be / The best, the best that we can do / Build a cage full of rage, inner demons call your name / Suicide, your only friend / Extermination of ourselves, mass incarceration / Termination of ourselves, mass incarcerate / In the cage, in the cage / You will remain"
                                            },
                                            {
                                                "example_id": "4f2ed2fa-c4e7-4996-8819-a51578dfdca7",
                                                "sense_id": "a92be9c6-615a-3788-8155-caceb0cb0748",
                                                "text": "[…]Syria reemerged indirectly, through Turkey's incarceration of Pastor Andrew Brunson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb11e0d1-b021-32c1-a9cc-d387858b9cfc",
                                        "entry_id": "71ad0dff-c8bb-3611-8617-0859d8a21c85",
                                        "glosses": [
                                            "A strangulation, as in a hernia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e6ed2c3-47a5-32c0-8e54-e500b4954e9f",
                                        "entry_id": "71ad0dff-c8bb-3611-8617-0859d8a21c85",
                                        "glosses": [
                                            "A constriction of the hernial sac, rendering it irreducible, but not great enough to cause strangulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39f2d9bf-cccf-4731-966f-501ec55984f0",
                        "source_entry_id": "3f50cbde-8956-3db6-920e-6199a21650fb",
                        "source_sense_id": "8fde5c7d-8257-3321-afdc-a36ec40e8a89",
                        "target_lang_word": "imprisonment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprisonment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                        "entry_id": "fe5aedf6-b95e-3f90-8902-576163ce428b",
                                        "glosses": [
                                            "A confinement in a place, especially a prison or a jail, especially as punishment for a crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703723e8-a699-43b7-b7e0-5522de697c08",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "His sinews woxen weake and raw / Through long emprisonment and hard constraint."
                                            },
                                            {
                                                "example_id": "3ac79ea7-a2c2-47f0-8141-7d1d309527b4",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Every confinement of the person is an imprisonment, whether it be in a common prison, or in a private house, or even by forcibly detaining one in the public streets."
                                            },
                                            {
                                                "example_id": "567f1ae2-8bd0-4bd3-9da4-3a7859e2107d",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b28ec0b-9b31-438d-ac74-2f887ca861ac",
                        "source_entry_id": "3f50cbde-8956-3db6-920e-6199a21650fb",
                        "source_sense_id": "8fde5c7d-8257-3321-afdc-a36ec40e8a89",
                        "target_lang_word": "incarcération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incarcération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                        "entry_id": "d7111942-0cfc-3436-917f-2dbbcedf6c68",
                                        "glosses": [
                                            "Action d’incarcérer ou état de celui qui est incarcéré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa006ef-6aa8-436d-8958-7e884919ff2e",
                                                "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                                "text": "Ordonner l’incarcération d’une personne. — Son incarcération dura dix jours."
                                            },
                                            {
                                                "example_id": "709b42ef-7b46-4650-994d-99db9565d3fd",
                                                "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                                "text": "Aujourd'hui, chacun calé dans sa bulle électromagnétique de Wi-Fi, c'est une autre vie qui commence. Une incarcération chez soi, dans laquelle il sera possible d'avoir accès à tout sans jamais voir personne - pas même son facteur."
                                            },
                                            {
                                                "example_id": "712ca40b-8b63-4ad7-a957-63d9dc91a036",
                                                "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                                "text": "Même les plus timides réformateurs se heurtent à cette évidence, adoucir les cruautés de l’incarcération s’oppose forcément à son principe : elle est une peine, elle est faite et uniquement faite pour punir le coupable, pour lui être pénible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d344b6c-125d-3bae-9bcc-bb54c6be493a",
                                        "entry_id": "d7111942-0cfc-3436-917f-2dbbcedf6c68",
                                        "glosses": [
                                            "Privation de liberté."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "615bd59b-c08c-49ff-8f04-9df324226e1b",
                                                "sense_id": "2d344b6c-125d-3bae-9bcc-bb54c6be493a",
                                                "text": "Sa liberté, son quant à soi, le plus grand bien, après l’incarcération de six années d'internat scolaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
