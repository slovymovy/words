                "senses": [
                    {
                        "sense_id": "2e33c2bc-c3aa-3c81-9792-50ef8bb2d139",
                        "entry_id": "89e3f5cf-ff15-3443-85ad-f71c07ef6f56",
                        "glosses": [
                            "Vorgang, jemanden bewusst in die Irre zu führen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "fb7b6e1d-7bdb-4ab1-8a40-293261863b48",
                                "sense_id": "2e33c2bc-c3aa-3c81-9792-50ef8bb2d139",
                                "text": "„Mystifikation war so sehr zu seiner zweiten Natur geworden wie die Pedanterie für Burch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c223acd9-6e9e-32cf-93ed-71bbbfcbf83a",
                        "entry_id": "89e3f5cf-ff15-3443-85ad-f71c07ef6f56",
                        "glosses": [
                            "Vorgang oder Handlung mit dem Ergebnis, dass etwas hinter einem Schleier des Geheimnisvollen verborgen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b25e3a-6aae-47ca-90b6-ea807b8613d9",
                                "sense_id": "c223acd9-6e9e-32cf-93ed-71bbbfcbf83a",
                                "text": "„Es war die Evolutionstheorie, die all diese religiösen Mystifikationen zu eliminieren begonnen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6981c24-8a8c-4666-968e-603137abae0d",
                        "source_entry_id": "89e3f5cf-ff15-3443-85ad-f71c07ef6f56",
                        "source_sense_id": "2e33c2bc-c3aa-3c81-9792-50ef8bb2d139",
                        "source_sense_description": "veraltet: Vorgang, jemanden bewusst in die Irre zu führen",
                        "target_lang_word": "mystification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f824972-7de7-3d44-b20f-a99d1934ad98",
                                        "entry_id": "875d336d-01ae-3f17-9510-4ebe0d266b85",
                                        "glosses": [
                                            "The act of mystifying or the condition of being mystified."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fafe9527-bcd3-40be-9f97-937cf62595f8",
                                                "sense_id": "7f824972-7de7-3d44-b20f-a99d1934ad98",
                                                "text": "But soon one notices, first in ones and twos, and then in larger groups, men who are very much alive at this hour in the morning, the sorters for the Caledonian, and Edinburgh sections of the \"Down Special\"; mail is piled high on the platforms, and the postal men glance occasionally towards the platform intermediate signals. By this time the calling-on arm is pulled off, and a few minutes later in comes the train, unannounced by the loud-speakers, to the mystification of many travellers."
                                            },
                                            {
                                                "example_id": "6d9a2e0c-0223-4eb9-990b-e844b6a6830d",
                                                "sense_id": "7f824972-7de7-3d44-b20f-a99d1934ad98",
                                                "text": "For a structuralist like Edmund Leach, the structure is the meaning. Genesis, for example, is about incest taboos; all the rest is noise and mystification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93cfc641-bd9b-3979-989d-99380caa01f6",
                                        "entry_id": "875d336d-01ae-3f17-9510-4ebe0d266b85",
                                        "glosses": [
                                            "A mystifying thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1040fa61-a071-40d6-a5fa-31592a960a68",
                        "source_entry_id": "89e3f5cf-ff15-3443-85ad-f71c07ef6f56",
                        "source_sense_id": "2e33c2bc-c3aa-3c81-9792-50ef8bb2d139",
                        "source_sense_description": "veraltet: Vorgang, jemanden bewusst in die Irre zu führen",
                        "target_lang_word": "mystification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                        "entry_id": "c03f5acb-0eb3-32f3-86a9-713139bdf691",
                                        "glosses": [
                                            "Action de mystifier, de berner, de duper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75665053-a567-480b-a096-a4adc14133f5",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "La mystification est la ressource des petits esprits. Depuis quelque temps, je ne réponds plus aux masques..."
                                            },
                                            {
                                                "example_id": "0dd4c70b-6b81-4093-a77f-4e77e88afd6e",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "Le sophisme que je combats dans cet écrit est d’autant plus dangereux, appliqué aux travaux publics, qu’il sert à justifier les entreprises et les prodigalités les plus folles. Quand un chemin de fer ou un pont ont une utilité réelle, il suffit d’invoquer cette utilité. Mais si on ne le peut, que fait-on ? On a recours à cette mystification : « Il faut procurer de l’ouvrage aux ouvriers. »"
                                            },
                                            {
                                                "example_id": "a9419d93-f280-4ccd-8899-305862852db9",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "Sir Walter-Scott avait honte de son métier. Il a passé une partie de son existence à donner le change sur la nature de ses occupations. C'était le secret de la comédie ; mais tout le monde se fit le complice volontaire de cette innocente mystification."
                                            },
                                            {
                                                "example_id": "c3ec5d5d-4ed4-4d6f-8709-d738ee906c38",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "Il se considérait, non sans raison, comme un mystifié de la nature, et il ne pardonnerait jamais à la nature une pareille mystification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
