{
    "word_family": [
        "homogeneity",
        "homogeneous",
        "homogenization"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50b2b476-e366-3613-9d7b-f619c08458b6",
                    "sense_definition": "To make something uniform or similar in nature throughout.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uniformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The global market tends to <w>homogenize</w> local cultures by promoting the same products everywhere.",
                            "target_lang_translations": {
                                "zh": "全球市场通过在各地推广相同的产品，往往会<w>同质化</w>当地文化。"
                            }
                        },
                        {
                            "text": "Modern architecture often <w>homogenizes</w> city landscapes, making them look identical across different countries.",
                            "target_lang_translations": {
                                "zh": "现代建筑往往使城市景观<w>同质化</w>，导致不同国家的城市看起来一模一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uniformize"
                    ],
                    "antonyms": [
                        "diversify"
                    ],
                    "common_phrases": [
                        "homogenize culture",
                        "homogenize society"
                    ],
                    "target_lang_definitions": {
                        "zh": "使事物在性质上变得统一或相似。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同质化",
                                "target_lang_sense_clarification": "指使事物变得相同或相似，常用于文化、社会等抽象概念。"
                            },
                            {
                                "target_lang_word": "使统一",
                                "target_lang_sense_clarification": "指使事物变得一致。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d31e6a49-91de-37d8-a17d-fdb7f8472d53",
                    "sense_definition": "To blend or mix ingredients until they have a smooth, consistent texture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uniformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a high-speed blender to <w>homogenize</w> the soup until it is perfectly creamy.",
                            "target_lang_translations": {
                                "zh": "用高速搅拌机将汤<w>搅匀</w>，直到它变得非常细腻顺滑。"
                            }
                        },
                        {
                            "text": "The chef had to <w>homogenize</w> the sauce to ensure there were no lumps remaining.",
                            "target_lang_translations": {
                                "zh": "厨师必须将酱汁<w>搅匀</w>，以确保里面没有残留的块状物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blend",
                        "fuse"
                    ],
                    "common_phrases": [
                        "homogenize ingredients",
                        "homogenize mixture"
                    ],
                    "target_lang_definitions": {
                        "zh": "将配料混合搅拌，使其质地均匀细腻。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使均匀",
                                "target_lang_sense_clarification": "指通过搅拌或混合使物质分布一致。"
                            },
                            {
                                "target_lang_word": "匀质化",
                                "target_lang_sense_clarification": "指将混合物处理成均匀的质地。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aa878c4-43d9-3dd9-b30e-20f07a2a930d",
                    "sense_definition": "To process milk so that the cream remains evenly distributed and does not separate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "uniformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most commercial dairies <w>homogenize</w> milk to prevent a layer of cream from forming on top.",
                            "target_lang_translations": {
                                "zh": "大多数商业乳制品厂会对牛奶进行<w>均质</w>处理，以防止顶部形成奶油层。"
                            }
                        },
                        {
                            "text": "The factory uses specialized equipment to <w>homogenize</w> the milk before it is bottled.",
                            "target_lang_translations": {
                                "zh": "工厂在装瓶前会使用专业设备对牛奶进行<w>均质</w>处理。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "homogenize milk"
                    ],
                    "target_lang_definitions": {
                        "zh": "对牛奶进行处理，使脂肪球破碎并均匀分布，防止分层。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "均质",
                                "target_lang_sense_clarification": "食品工业术语，特指对牛奶等液体进行均质处理。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}