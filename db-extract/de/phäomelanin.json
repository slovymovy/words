                "senses": [
                    {
                        "sense_id": "cfa48ede-ad79-32c6-84f0-1e2a9516345c",
                        "entry_id": "cd15ba4a-665c-3182-ae97-7ec8e46fc34b",
                        "glosses": [
                            "gelb-rotes Pigment aus der Gruppe der Melanine, das zusammen mit Eumelanin, die Haut- und Haarfarbe bestimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8afc9346-c92f-4e47-b73a-39096b5621e9",
                                "sense_id": "cfa48ede-ad79-32c6-84f0-1e2a9516345c",
                                "text": "„Phäomelanin dominiert in rotem Haar, während der zweite Melanintyp, das Eumelanin, als Braun-Schwarz-Pigment für braune und schwarze Haare verantwortlich ist.“"
                            },
                            {
                                "example_id": "a323f8db-0e3b-4a17-9fe7-d44532e4a7f0",
                                "sense_id": "cfa48ede-ad79-32c6-84f0-1e2a9516345c",
                                "text": "„[Die Mutation] hat keine oder fast keine Auswirkung auf Phäomelanin, so dass die fuchsrote Farbe vollständig brauner Pferde davon nicht aufgehellt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
