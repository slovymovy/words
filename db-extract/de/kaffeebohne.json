                "senses": [
                    {
                        "sense_id": "5f613916-6b82-3922-9fc7-2f835aa8c8fc",
                        "entry_id": "6428ab76-87c2-31a4-9bc7-1127113a5581",
                        "glosses": [
                            "Grain de café"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "334f10d1-b30a-49d7-bf5d-621cceec5d36",
                                "sense_id": "5f613916-6b82-3922-9fc7-2f835aa8c8fc",
                                "text": "Die Kaffebohnen werden durch das Rösten veredelt. — Les grains de café sont traitées par toréfaction."
                            },
                            {
                                "example_id": "2fd0d65f-fc10-4de8-8bf0-ac2eca6c4c78",
                                "sense_id": "5f613916-6b82-3922-9fc7-2f835aa8c8fc",
                                "text": "Ich stehe in der Küche, höre Nina und fülle eine Handvoll Kaffeebohnen in meine altmodische kleine Mühle.",
                                "translation": "Dans la cuisine, j’écoute Nina et mets une poignée de grains de café dans mon petit moulin à l’ancienne."
                            }
                        ]
                    }
                ],
