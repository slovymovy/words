        "fr-extract.jsonl": [
            {
                "entry_id": "f1b213f1-2019-3e12-9f0b-3bcb9e04976e",
                "word": "surligneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "35e6c457-e81b-4da7-bb30-68f5beaac8a4",
                        "entry_id": "f1b213f1-2019-3e12-9f0b-3bcb9e04976e",
                        "tags": [
                            "plural"
                        ],
                        "form": "surligneurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "414123df-594f-34ac-98f9-2766a59e3a30",
                        "entry_id": "f1b213f1-2019-3e12-9f0b-3bcb9e04976e",
                        "glosses": [
                            "Stylo dont l’encre fluorescente permet de mettre en évidence un mot, un passage dans un texte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763a0324-4943-41a6-9aba-11adbd1ee021",
                                "sense_id": "414123df-594f-34ac-98f9-2766a59e3a30",
                                "text": "Je l'observe travailler ses textes au surligneur et prendre des notes sur une petite tablette de papier à côté d'elle, comme si elle se préparait à un examen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2e53d8e-e405-4727-ad21-ad58601440b6",
                        "source_entry_id": "f1b213f1-2019-3e12-9f0b-3bcb9e04976e",
                        "source_sense_id": "414123df-594f-34ac-98f9-2766a59e3a30",
                        "target_lang_word": "Marker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48a5f899-fa15-3ad6-bf5e-67186fb89e98",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "durchsichtig breit schreibender farbiger Stift, mit dem man Text hervorhebt"
                                        ],
                                        "tags": [
                                            "kurz für Textmarker"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae90a49-43ef-48b2-9604-e5145e1da6ef",
                                                "sense_id": "48a5f899-fa15-3ad6-bf5e-67186fb89e98",
                                                "text": "Aktiv lesen können Sie zum Beispiel, indem Sie die wichtigsten Textstellen unterstreichen oder mit einem Marker kennzeichnen."
                                            },
                                            {
                                                "example_id": "056108c2-e63e-46f9-8500-544deea3c51b",
                                                "sense_id": "48a5f899-fa15-3ad6-bf5e-67186fb89e98",
                                                "text": "„Übertragen Sie die Kontur des Motivs mit einem Marker auf das Transparentpapier, drehen Sie das Papier dann um, legen Sie es auf den Stoff und ziehen Sie die Konturlinien mit etwas Druck nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b58df0ad-b4f4-35ea-a2ae-f227dac64468",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "Protein/Hormon, das ein Kennzeichen bedeutet, etwas markiert, auf etwas hinweist/verweist"
                                        ],
                                        "tags": [
                                            "kurz für Biomarker"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "938bc0a6-aca2-4c36-b881-a3477de17f5b",
                                                "sense_id": "b58df0ad-b4f4-35ea-a2ae-f227dac64468",
                                                "text": "Für einige der häufigsten Krebserkrankungen gibt es aussagekräftige Marker. CEA ist solch ein Marker. Ein erhöhter CEA-Wert im Blut deutet auf einen Tumor hin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bfd067f8-2ec8-35c7-a76b-4c04b1307403",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "Mittel zum Ausdruck einer grammatischen Bedeutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727c5f81-7136-49ef-bd12-1f7d1f39116c",
                                                "sense_id": "bfd067f8-2ec8-35c7-a76b-4c04b1307403",
                                                "text": "„Diese somatischen Marker erlauben es, die Informationsmenge, die zur Entscheidungsfindung durchforstet werden muss, sofort emotional zu bewerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c4553d42-3b2e-3399-8a3b-335e62157434",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "genetisches Merkmal eines Virus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e37577c-426f-425a-a52e-7d208d35a723",
                                                "sense_id": "c4553d42-3b2e-3399-8a3b-335e62157434",
                                                "text": "„Die verschiedenen Marker des Virus sind im dynamischen Wechsel und reflektieren die virale Replikation und die Immunantwort des Patienten (Abb. 3).“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec86c3f9-bbf2-4e7c-bafd-13cb9d6d7cd5",
                        "source_entry_id": "f1b213f1-2019-3e12-9f0b-3bcb9e04976e",
                        "source_sense_id": "414123df-594f-34ac-98f9-2766a59e3a30",
                        "target_lang_word": "highlighter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highlighter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74c80366-0b79-3acb-b37d-0b53bebf5440",
                                        "entry_id": "cea9feb0-db8c-3233-b098-c39f133942e3",
                                        "glosses": [
                                            "A marker pen used to highlight text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "deaa9fe4-8bc7-31d6-84ea-2d5d0bbdc306",
                                        "entry_id": "cea9feb0-db8c-3233-b098-c39f133942e3",
                                        "glosses": [
                                            "A cosmetic product that reflects light, used to emphasize the contours of the face etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffa1cca0-cc58-3a2f-9185-c4a275a71a75",
                                        "entry_id": "cea9feb0-db8c-3233-b098-c39f133942e3",
                                        "glosses": [
                                            "That which highlights or emphasizes something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd40f52-38ad-4ac2-977d-68b3ac489181",
                                                "sense_id": "ffa1cca0-cc58-3a2f-9185-c4a275a71a75",
                                                "text": "The IPL was supposed to be a symbol of an ever-more influential, dynamic and prosperous India, a highlighter of its organizational skills and wealth."
                                            },
                                            {
                                                "example_id": "c19ae4f9-eebf-4b01-9d36-8a83d99cb33b",
                                                "sense_id": "ffa1cca0-cc58-3a2f-9185-c4a275a71a75",
                                                "text": "At the same time, art rooted in nature is eminently ephemeral, as human life itself is, and fairy lore again operates as a highlighter of this essential condition through its own distinctive world picture[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8777322-599a-4cdb-9439-d46865b07724",
                        "source_entry_id": "f1b213f1-2019-3e12-9f0b-3bcb9e04976e",
                        "source_sense_id": "414123df-594f-34ac-98f9-2766a59e3a30",
