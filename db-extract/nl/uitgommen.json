                "entry_id": "a8f57efa-82a6-3e35-9edc-293639c4377d",
                "word": "uitgommen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac8c3bfe-db70-31ae-8794-9474b5550d38",
                        "entry_id": "a8f57efa-82a6-3e35-9edc-293639c4377d",
                        "glosses": [
                            "iets wat geschreven is met een vlakgom van het papier verwijderen zodat het niet meer zichtbaar of leesbaar is"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5dd4a7c2-4de9-3e4e-8abb-b407e004dbdb",
                        "entry_id": "a8f57efa-82a6-3e35-9edc-293639c4377d",
                        "glosses": [
                            "iets verwijderen of ongedaan maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6f50e8-3137-49c6-90e8-da42ade4cde8",
                                "sense_id": "5dd4a7c2-4de9-3e4e-8abb-b407e004dbdb",
                                "text": "Stel je voor dat Bpost zou mogen twijfelen of je wel je echte naam gebruikt als afzender en je adres zou mogen blokkeren omdat je een zedige foto van kussende vrouwen rondstuurde – zoals een Italiaanse vrouw enkele maanden geleden op Facebook overkwam. Hopelijk doet de toekomstige minister van Consumentenzaken iets aan die willekeur. Om te beletten dat één bedrijf mensen digitaal kan uitgommen."
                            },
                            {
                                "example_id": "8379f6b7-4266-4713-9040-e588a9ce3cbe",
                                "sense_id": "5dd4a7c2-4de9-3e4e-8abb-b407e004dbdb",
                                "text": "Paul Scheffer stelt dat Europa tot nog toe draaide om binnengrenzen (het uitgommen daarvan), maar voortaan om buitengrenzen zal draaien."
                            },
                            {
                                "example_id": "c0d44403-033a-43b4-a3b0-ba200ed10b34",
                                "sense_id": "5dd4a7c2-4de9-3e4e-8abb-b407e004dbdb",
                                "text": "Maar de Stalinverering – die minder politiek dan nationalistisch of zelfs religieus lijkt te zijn geïnspireerd – kon de president niet uitgommen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c69b92c0-0455-495e-874e-3b7cf90d6591",
                        "source_entry_id": "a8f57efa-82a6-3e35-9edc-293639c4377d",
                        "source_sense_id": "ac8c3bfe-db70-31ae-8794-9474b5550d38",
                        "source_sense_description": "met een vlakgom verwijderen",
                        "target_lang_word": "rub out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rub out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88a87930-37b9-3919-8f72-0c49ffb2f3e3",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "To delete or erase or remove (something) by rubbing, especially with a rubber (eraser)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41250726-1fe2-4e28-91bb-8327a2f39359",
                                                "sense_id": "88a87930-37b9-3919-8f72-0c49ffb2f3e3",
                                                "text": "The teacher wanted to rub out the chalk marks on the blackboard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88ad7754-bd84-3ff7-bf6a-6695de552e20",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "To get by; to live."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7c7a19-a1a5-48d2-bbaf-0741145cd831",
                                                "sense_id": "88ad7754-bd84-3ff7-bf6a-6695de552e20",
                                                "text": "The first will understand but little of them, the latter over much; they might perhaps live and rub out in the middle region."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed170306-7253-34f6-a0d5-cf352c51ed2d",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "To kill, especially to murder."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495e9ee8-525f-493a-bc41-f0b6a802c5c1",
                                                "sense_id": "ed170306-7253-34f6-a0d5-cf352c51ed2d",
                                                "text": "It was just a week to the day since Mr. Martin had decided to rub out Mrs. Ulgine Barrows."
                                            },
                                            {
                                                "example_id": "bb7e5d32-7bac-44f9-bb37-35dfa8b89a0a",
                                                "sense_id": "ed170306-7253-34f6-a0d5-cf352c51ed2d",
                                                "text": "'Mr Grimaldi,' fills in Smoke, 'what I believe Fay has too much tact to spit out and say is this: the Rey woman might be imagining we rubbed out Dr Sixsmith.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd51512-f6a5-38de-837c-b22ac890b8d4",
                                        "entry_id": "4eced2ed-9d70-3729-8421-56bd91763aea",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see rub, out."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c03556d6-4186-4eb9-8e76-bbb5eac6de9a",
                        "source_entry_id": "a8f57efa-82a6-3e35-9edc-293639c4377d",
                        "source_sense_id": "5dd4a7c2-4de9-3e4e-8abb-b407e004dbdb",
                        "source_sense_description": "ongedaan maken",
                        "target_lang_word": "wipe out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wipe out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8702e05e-728c-394c-b4ad-2572447dd684",
                                        "entry_id": "5aed015e-a81d-35d4-86a2-2cc86ddb0997",
                                        "glosses": [
                                            "To destroy (especially, a large number or complete set of people or things); to obliterate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea315973-7a29-4b98-a3cc-5cda4a1d10cc",
                                                "sense_id": "8702e05e-728c-394c-b4ad-2572447dd684",
                                                "text": "a tornado that nearly wiped out an entire town"
                                            },
                                            {
                                                "example_id": "4dc5b276-1cd7-485a-b8e4-019b6b6c96ab",
                                                "sense_id": "8702e05e-728c-394c-b4ad-2572447dd684",
                                                "text": "Yasser Arafat (Katz): You do not go far enough General Amin. We must rip their entrails out and drag them from here to Damascus until they include us in the peace process.\nMuammar Gaddafi (LuJane): No! Nonsense! This solution is not bold enough for Libya. I say wipe out Washington and New York."
                                            },
                                            {
                                                "example_id": "9c3f8b57-dd99-408d-859d-81db94167642",
                                                "sense_id": "8702e05e-728c-394c-b4ad-2572447dd684",
                                                "text": "Darth Sidious: Wipe them out. All of them."
                                            },
                                            {
                                                "example_id": "d9769e3b-c57a-4163-b6a0-d7ab5ad92f04",
                                                "sense_id": "8702e05e-728c-394c-b4ad-2572447dd684",
                                                "text": "Now, that, admittedly, did do an awful lot more damage (the 5th and 6th were almost completely wiped out), but the High Seas Fleet was, in turn, almost completely wiped out (in fact, basically was wiped out, to a man) by the oncoming rest of the British Grand Fleet, and it was decided by everybody that this kind of, like, suicidal, completely suicidal, charge was probably a bit out of character for Hipper, and so we didn't take that particular one into account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd4f8ee-30de-328a-ab5f-799f11b5e46a",
                                        "entry_id": "5aed015e-a81d-35d4-86a2-2cc86ddb0997",
                                        "glosses": [
                                            "To physically erase (writing, computer data, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714eca7b-73c7-437b-9ece-685501030864",
                                                "sense_id": "edd4f8ee-30de-328a-ab5f-799f11b5e46a",
                                                "text": "nearly a year's worth of database records wiped out by disk failure coupled with lack of backups"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2608492-146a-3d7d-9ec2-23f04c1e118c",
                                        "entry_id": "5aed015e-a81d-35d4-86a2-2cc86ddb0997",
                                        "glosses": [
                                            "To do away with; to cause to disappear."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50212dc0-2267-44d7-a8b8-93ecc33b6425",
                                                "sense_id": "e2608492-146a-3d7d-9ec2-23f04c1e118c",
                                                "text": "trying to wipe out hunger and alleviate despair"
                                            },
                                            {
                                                "example_id": "4d17186c-e1ad-408a-b449-a8528f419505",
                                                "sense_id": "e2608492-146a-3d7d-9ec2-23f04c1e118c",
                                                "text": "The leftist Jean-Luc Mélenchon, who had dominated headlines in recent weeks with rousing open-air rallies against capitalism, took about 11% and failed in his ultimate aim of beating Le Pen and wiping out the extreme right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d21b796d-fb6c-3900-bbef-2220be13aae6",
                                        "entry_id": "5aed015e-a81d-35d4-86a2-2cc86ddb0997",
                                        "glosses": [
                                            "To exhaust (someone); to tire (them) out."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd9f6f07-cd77-4901-a94d-288b0e985b5b",
                                                "sense_id": "d21b796d-fb6c-3900-bbef-2220be13aae6",
                                                "text": "An hour of snow shoveling kind of wiped me out more than I expected."
                                            },
                                            {
                                                "example_id": "aa99f86e-c43c-4407-a71d-fd7b7d1784a9",
                                                "sense_id": "d21b796d-fb6c-3900-bbef-2220be13aae6",
                                                "text": "I tried to force myself to sound happy even though I was exhausted. Four solid days of finals and studying for them had wiped me out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8435d940-f6bd-33f6-b9b5-e46606902357",
                                        "entry_id": "5aed015e-a81d-35d4-86a2-2cc86ddb0997",
                                        "glosses": [
                                            "To bankrupt (a person or company); to empty (a bank account); to erase (a bank balance)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8b055e-6950-45ee-b53a-3bb19a71156b",
                                                "sense_id": "8435d940-f6bd-33f6-b9b5-e46606902357",
                                                "text": "They tried hard to hang on, but the Great Depression wiped them out."
                                            },
                                            {
                                                "example_id": "4a96f3dd-a1cd-417a-a8f6-1fd34af115f7",
                                                "sense_id": "8435d940-f6bd-33f6-b9b5-e46606902357",
                                                "text": "Unexpected big-ticket expenses wiped out his bank balance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca549e8-a86c-3806-b941-5bb96b92b9af",
                                        "entry_id": "5aed015e-a81d-35d4-86a2-2cc86ddb0997",
                                        "glosses": [
                                            "To crash; to fall over or fall off (especially in board sports such as surfing, skateboarding, etc.)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53487566-bceb-4d7f-8c3b-f475054b793b",
                                                "sense_id": "3ca549e8-a86c-3806-b941-5bb96b92b9af",
                                                "text": "shot into the half-pipe but then wiped out"
                                            },
                                            {
                                                "example_id": "a80ee038-f722-4e1b-a00a-6d283b9b3d7d",
                                                "sense_id": "3ca549e8-a86c-3806-b941-5bb96b92b9af",
                                                "text": "A massive wave caused him to wipe out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5be5493-06b0-3ddc-8ce7-bb75bfbce3cd",
                                        "entry_id": "5aed015e-a81d-35d4-86a2-2cc86ddb0997",
                                        "glosses": [
                                            "To knock (a surfer) off their board."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c18232-d2b0-44a0-a97a-394ec67b767f",
                                                "sense_id": "f5be5493-06b0-3ddc-8ce7-bb75bfbce3cd",
                                                "text": "A massive wave wiped him out."
                                            },
                                            {
                                                "example_id": "999c25e3-9d49-47d0-ad3a-b37cfbc26c7e",
                                                "sense_id": "f5be5493-06b0-3ddc-8ce7-bb75bfbce3cd",
                                                "text": "I'd like to show you what a wipeout looks like from the board. I'm pretty good at getting wiped out, so I'll be the stooge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wipe out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "703501f5-2e43-3b36-a9c0-eebfac5af641",
                                        "entry_id": "26d9d5e2-980d-3cff-96e1-1d584d857476",
                                        "glosses": [
                                            "Nonstandard form of wipeout; nonstandard but widespread."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e85d5f55-c6b2-4773-a10a-8f0dfdb8b533",
                        "source_entry_id": "a8f57efa-82a6-3e35-9edc-293639c4377d",
                        "source_sense_id": "5dd4a7c2-4de9-3e4e-8abb-b407e004dbdb",
                        "source_sense_description": "ongedaan maken",
                        "target_lang_word": "erase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87e13008-3c71-3bfb-8cdd-657c4f366af2",
                                        "entry_id": "a641d104-38f7-3f37-aeec-56acd569f3a8",
                                        "glosses": [
                                            "To remove (markings or information)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4126d7a9-adf7-4e10-b55a-de8668febf88",
                                                "sense_id": "87e13008-3c71-3bfb-8cdd-657c4f366af2",
                                                "text": "I erased that word from the page because it was wrong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf51899-e832-36f7-a2e8-5cfc574491ce",
                                        "entry_id": "a641d104-38f7-3f37-aeec-56acd569f3a8",
                                        "glosses": [
                                            "To obliterate information from (a storage medium), such as to clear or (with magnetic storage) to demagnetize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a0b27a-d723-4f86-8b31-1d19e67a3fbe",
                                                "sense_id": "fdf51899-e832-36f7-a2e8-5cfc574491ce",
                                                "text": "I'm going to erase this tape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb30fc9-67c6-3dcd-9b9b-5ff0a4048848",
                                        "entry_id": "a641d104-38f7-3f37-aeec-56acd569f3a8",
                                        "glosses": [
                                            "To obliterate (information) from a storage medium, such as to clear or to overwrite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eef8768-9ac9-4c6a-ae5e-f4860d6f9069",
                                                "sense_id": "5eb30fc9-67c6-3dcd-9b9b-5ff0a4048848",
                                                "text": "I'm going to erase those files."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49df599-a822-31dc-bab1-674f72f7a6dd",
                                        "entry_id": "a641d104-38f7-3f37-aeec-56acd569f3a8",
                                        "glosses": [
                                            "To remove a runner from the bases via a double play or pick off play"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b1dd95-bf7b-4aa5-9d13-accb938d9c69",
                                                "sense_id": "e49df599-a822-31dc-bab1-674f72f7a6dd",
                                                "text": "Jones was erased by a 6-4-3 double play."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76044eb0-1a3c-357a-bd48-c95084a3c9ea",
                                        "entry_id": "a641d104-38f7-3f37-aeec-56acd569f3a8",
                                        "glosses": [
                                            "To be erased (have markings removed, have information removed, or be cleared of information)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3dc7d13-d2b9-402f-bc03-708c12c11712",
                                                "sense_id": "76044eb0-1a3c-357a-bd48-c95084a3c9ea",
                                                "text": "The chalkboard erased easily."
                                            },
                                            {
                                                "example_id": "5e0ef77a-a8d6-4610-8dd6-83bffe0828aa",
                                                "sense_id": "76044eb0-1a3c-357a-bd48-c95084a3c9ea",
                                                "text": "The files will erase quickly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49d52c42-15c9-3516-a42b-5c51f864713c",
                                        "entry_id": "a641d104-38f7-3f37-aeec-56acd569f3a8",
                                        "glosses": [
                                            "To disregard (a group, an orientation, etc.); to prevent from having an active role in society."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66e10d4-e0d7-4d6a-a767-19bc2441106b",
                                                "sense_id": "49d52c42-15c9-3516-a42b-5c51f864713c",
                                                "text": "I suggest, then, that counterdiscourses, when reductive, tend to emulate the screen discourse that erases gay sociality."
                                            },
                                            {
                                                "example_id": "a3a23ccc-e2be-432b-bf3c-14c01f087202",
                                                "sense_id": "49d52c42-15c9-3516-a42b-5c51f864713c",
                                                "text": "As a result, Palestinians are hyperpresent in Israeli media, while Mizrahim are erased from public discourse."
                                            },
                                            {
                                                "example_id": "20a52071-921a-4b86-bf65-bd08943cd6fc",
                                                "sense_id": "49d52c42-15c9-3516-a42b-5c51f864713c",
                                                "text": "Silence around Native sexuality benefits the colonizers and erases queer Native people from their communities."
                                            },
                                            {
                                                "example_id": "877e48cf-441e-4a22-9d8d-f28bf52465f3",
                                                "sense_id": "49d52c42-15c9-3516-a42b-5c51f864713c",
                                                "text": "C.J. Henderson has the speed and anticipation to erase receivers all over the field, and his athleticism is absurd; according to Bruce Feldman of The Athletic, Henderson bench presses 380 pounds and squats 545."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab767412-b167-39ce-a18c-6d9b804b579f",
                                        "entry_id": "a641d104-38f7-3f37-aeec-56acd569f3a8",
                                        "glosses": [
                                            "To kill; assassinate."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "erase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85f8e35a-9572-3168-bec2-e77f76270905",
                                        "entry_id": "8543ad72-f218-3d4f-9427-50cef096e214",
                                        "glosses": [
                                            "The operation of deleting data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9247356-22e6-4e5e-9ef3-5b750ac5e7a5",
                                                "sense_id": "85f8e35a-9572-3168-bec2-e77f76270905",
                                                "text": "This subsystem is waiting to become Exclusive after having issued an erase."
                                            }
                                        ]
                                    }
                                ]
