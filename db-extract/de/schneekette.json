                    {
                        "translation_id": "8d12ee73-4e77-4201-807e-d6014a938625",
                        "source_entry_id": "041acc8f-d1b2-3ce9-b08b-ac6bb9d66ade",
                        "source_sense_id": "a5e24be6-27c9-3145-abc8-e06e6806863d",
                        "source_sense_description": "Kette für Reifen von Fahrzeugen, für das Fortbewegen auf schneebedeckten Straßen",
                        "target_lang_word": "chaîne à neige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaîne à neige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07f7857c-22bd-3e20-9434-a18b53a58171",
                                        "entry_id": "c0a79fb7-3f1a-3bff-a615-fcb16412a9f9",
                                        "glosses": [
                                            "Dispositif constitué de chaînes assemblées autour d’un pneu pour renforcer l’adhérence sur la neige ou le verglas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3ac404-0001-4aff-937b-f1d5ca0f55ca",
                                                "sense_id": "07f7857c-22bd-3e20-9434-a18b53a58171",
                                                "text": "Sachant que nous devions aller à plus de 2 000 mètres d’altitude je préfère m’arrêter chez un garagiste afin de faire monter des chaînes à neige."
                                            },
                                            {
                                                "example_id": "f35e657b-d070-4c1d-bfb8-14593c2affbc",
                                                "sense_id": "07f7857c-22bd-3e20-9434-a18b53a58171",
                                                "text": "Il n’existe pas de limitations de vitesse spécifiques pour les véhicules équipés de chaînes à neige."
                                            },
                                            {
                                                "example_id": "b83bb71f-e62e-423c-a327-bdd54a0f5c0d",
                                                "sense_id": "07f7857c-22bd-3e20-9434-a18b53a58171",
                                                "text": "Pour conduire sur neige et sur verglas, il faut des pneus hiver, des chaînes à neige ou des chaussettes à neige (mais ces dernières durent moins longtemps)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
