                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed58b426-e29b-4419-9ebd-4259727ba52f",
                                "sense_id": "4dce5406-8036-3a93-8162-6228fb31f37e",
                                "text": "La prochaine séance est prévue au mois de novembre 2006 et espère rassembler des doctorants slavisants de toute la France.",
                                "translation": "The next session is planned for the month of November 2006 and it hopes to gather Slavic doctoral students from all over France.",
