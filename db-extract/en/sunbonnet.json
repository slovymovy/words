                        "glosses": [
                            "A hat (bonnet) worn for protection from bright sunlight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514e08fc-8fed-4f38-922a-9c91147dc29f",
                                "sense_id": "81907c9c-fdbc-33bb-af33-586467d446e4",
                                "text": "“Put on your sunbonnet,” she ordered.\n“Oh, please, Aunt Elizabeth, don’t make me wear that horrid thing.”\nAunt Elizabeth, wasting no further words, picked up the bonnet and tied it on Emily’s head. Emily had to yield. But from the depths of the sunbonnet issued a voice, defiant though tremulous."
                            },
                            {
                                "example_id": "f03a609e-179e-4636-9eb7-c4ecfc8e174e",
                                "sense_id": "81907c9c-fdbc-33bb-af33-586467d446e4",
                                "text": "She saw a square picture framed in the window, two whitewashed cottages each with a little winding path, a bed of red and yellow cockscomb, a sloping field, a row of gum-trees, a child in a blue sunbonnet carrying a basket."
                            }
                        ]
