                        "sense_id": "143c2213-4ab1-305a-a8ec-0a830ccfe933",
                        "entry_id": "0a92418f-e6c0-3b1b-b6d5-1ac4a9fe3bc6",
                        "glosses": [
                            "langer, stabiler Stock, dessen unteres Ende man in die Erde rammte, um sich über ein Hindernis (zum Beispiel einen Bach) zu schwingen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7bbc4dd9-36e7-4ccd-9ef5-0611a6985523",
                                "sense_id": "143c2213-4ab1-305a-a8ec-0a830ccfe933",
                                "text": "Der Springstock, den man in der Marsch zum Überspringen von Gräben nutzte, war am unteren Ende zur Gabel geformt."
                            },
                            {
                                "example_id": "8656db0e-6a08-49a5-b9f4-85c1d674fff7",
                                "sense_id": "143c2213-4ab1-305a-a8ec-0a830ccfe933",
                                "text": "Kein Marschbewohner ging ohne seinen Springstock aus dem Hause."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
