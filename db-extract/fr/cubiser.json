                "senses": [
                    {
                        "sense_id": "1aba11f9-a857-3af1-80d7-7d9e3a902613",
                        "entry_id": "e49596e3-b340-3fb7-bf37-132c7725cffc",
                        "glosses": [
                            "Donner un caractère cubiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f987dfe-1263-43e6-87d7-45c3041b10af",
                                "sense_id": "1aba11f9-a857-3af1-80d7-7d9e3a902613",
                                "text": "Jusque là on n’est pas sorti de la caricature, mais quand Rigadin, emporté par la furia cubiste – et adoptant la logique caractéristique du cinéma comique français d'alors (que les burlesques américains reprendront) –, se met à « cubiser » sa vie quotidienne, son appartement, ses meubles, sa concierge, il développe alors une application du cubisme que celui-ci n’a pas encore frayée."
                            },
                            {
                                "example_id": "c7c07fbf-43f1-44ce-9938-8bc4d396c612",
                                "sense_id": "1aba11f9-a857-3af1-80d7-7d9e3a902613",
                                "text": "Voici la nouvelle appli pour \"cubiser\" vos photos !"
                            },
                            {
                                "example_id": "d8de6c3a-f65e-4b41-aad6-14a14708c95c",
                                "sense_id": "1aba11f9-a857-3af1-80d7-7d9e3a902613",
                                "text": "N'oubliez pas de cubiser le monde ce week-end"
                            }
                        ]
                    }
