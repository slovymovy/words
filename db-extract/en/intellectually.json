                                    {
                                        "sense_id": "9d3b4b07-e5bf-3cca-ae94-2af7fa08f2e6",
                                        "entry_id": "8560c373-1c05-30db-a1bb-0d28c969ae4f",
                                        "glosses": [
                                            "D'une manière intellectuelle ; dans l'intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bb5ea1-8d5b-4c56-a10b-fc3a9145025a",
                                                "sense_id": "9d3b4b07-e5bf-3cca-ae94-2af7fa08f2e6",
                                                "text": "L’adjoint à la construction et élu communiste, Jacques Baudrier, a suivi tout le programme et peste contre « des bobos qui considèrent que c’est bien de laisser des pauvres dix ans de plus dans leur merde pour se faire plaisir intellectuellement »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b2878b-c82b-343e-be09-d83e57e58320",
                                        "entry_id": "8560c373-1c05-30db-a1bb-0d28c969ae4f",
                                        "glosses": [
                                            "En ce qui regarde l’intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1811d5bd-382c-4fac-8e57-db36b9836626",
                                                "sense_id": "58b2878b-c82b-343e-be09-d83e57e58320",
                                                "text": "Cet enfant n’est pas fort développé intellectuellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99ab6a4c-06f0-4c5c-8ca7-16f345ffb65c",
                        "source_entry_id": "2b2d0375-c3c7-34ef-86da-2f1c643ed613",
                        "source_sense_id": "1b243cab-0251-347b-8941-807c29f9fb21",
                        "source_sense_description": "in an intellectual manner",
                        "target_lang_word": "intellektuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intellektuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                        "entry_id": "6bdd9573-024e-3fcf-857d-f7e48e790241",
                                        "glosses": [
                                            "den Geist/Intellekt/Verstand betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1070d982-341b-44c9-b140-33067f4ab334",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "Das ist ein intellektuelles Spiel."
                                            },
                                            {
                                                "example_id": "bb0b837d-ff2a-4a99-bf3e-767bd13621e4",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Zu den Schülern dieses intellektuellen Zentrums zählte auch Paulus.“"
                                            },
                                            {
                                                "example_id": "64eca3b1-ef31-49ef-8354-30df56f58b93",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Sobald wir mit dem Begriff Zeit zu experimentieren beginnen, und sei es auch nur als Gedankenexperiment oder zum rein intellektuellen Zeitvertreib, müssen wir feststellen, daß unsere Sprache und mit ihr unsere Denkprozesse uns sehr bald im Stich lassen.“"
                                            },
                                            {
                                                "example_id": "09a253ea-6f4f-4081-bcca-95179a8ad5d2",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Der Glaube, dass es einen Gott gibt, bleibt jedoch trotz der Versuche des menschlichen Geistes, sich über sogenannte Gottesbeweise, über intellektuelle Erkenntnisse und logische Schlüsse, Sicherheit zu verschaffen, ein Wagnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
