                        "sense_id": "41472ec9-dda0-3b31-8d5d-38f3fe2a3012",
                        "entry_id": "71bdca76-6e0c-3970-8d9c-2b9a77bce989",
                        "glosses": [
                            "(detaillierte schriftliche) Darstellung, Beschreibung"
