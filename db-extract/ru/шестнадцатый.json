                                                "sense_id": "cbd905e6-35ce-323f-a3f2-571f148bd8f1",
                                                "text": "„Sowilō … ist die sechzehnte Rune des älteren Futhark (die achte Rune im zweiten Ætt) und die zwölfte Rune des altnordischen Runenalphabets mit dem Lautwert s.“"
                                            },
                                            {
                                                "example_id": "5d88abb3-3104-4576-81bb-def13ef1b311",
                                                "sense_id": "cbd905e6-35ce-323f-a3f2-571f148bd8f1",
                                                "text": "„Diese Hieronymusschule galt am Anfang des sechzehnten Jahrhunderts als die beste aller Brüderschulen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
