                                                "sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
                                                "text": "„Als Fluchtpunkt angelegt, steht der alte Brunnentempel in der Mitte des Parks.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                                        "entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                                        "glosses": [
