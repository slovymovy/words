                            {
                                "example_id": "a8df7bb5-889f-4002-b3bb-801b8e59166b",
                                "sense_id": "d4fbd1ee-6c1f-33e7-9a72-5dadf4597430",
                                "text": "I have\n(Together with my practice) made familiar\nTo me and to my aid, the blest infusions\nThat dwell in vegetives, in metals, stones"
                            },
                            {
                                "example_id": "84d6025c-e20e-491e-b9ef-67ec1e478096",
                                "sense_id": "d4fbd1ee-6c1f-33e7-9a72-5dadf4597430",
                                "text": "Hence vegetives receive their fragrant birth, / And clothe the naked bosom of the earth."
                            }
                        ]
                    }
