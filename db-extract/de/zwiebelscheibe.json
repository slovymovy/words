                "senses": [
                    {
                        "sense_id": "c14d4a12-854c-38e7-9d28-0ccf2b416f60",
                        "entry_id": "330ed468-10e2-3cb8-80d4-de36ead5f37d",
                        "glosses": [
                            "Scheibe einer Zwiebel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d17f3d-9237-4857-acd6-6f16d9a5ae03",
                                "sense_id": "c14d4a12-854c-38e7-9d28-0ccf2b416f60",
                                "text": "„Als Spezialität gilt in der österreichischen Steiermark der Käferbohnensalat aus den gekochten Samen mit frischen Zwiebelscheiben, Essig und steirischem Kürbiskernöl.“"
                            },
                            {
                                "example_id": "d4ae828a-074a-47bb-8a1c-e1821bd33204",
                                "sense_id": "c14d4a12-854c-38e7-9d28-0ccf2b416f60",
                                "text": "„Oskar, der früher mit rohen Zwiebelscheiben gearbeitet hat, bevor er die Trauerhäuser betrat, behauptet jetzt, die Tränen frei wie ein großer Schauspieler erzeugen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
