                        "source_sense_id": "f9fc6470-595c-3fde-8ea3-827ee769e14e",
                        "source_sense_description": "een aangename stemming waarin men veel lacht, zich goed voelt en het leven optimistisch bekijkt",
                        "target_lang_word": "Fröhlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fröhlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                        "entry_id": "bf264646-eeca-3a4e-b1ad-37f1c4f8bd9d",
                                        "glosses": [
                                            "Zustand, Stimmung einer Person oder Gruppe voller erkennbarer Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17cf35cf-c8d0-4521-a5ea-40d01854e1f3",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "Ihre Fröhlichkeit wirkte auf alle anderen ansteckend."
                                            },
                                            {
                                                "example_id": "e08ccdd2-c7b1-4e28-8ce5-ffb261643579",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "„In diesem Augenblick trat die Sonne völlig aus den Wolken heraus, und der kraftvolle Schall des einzelnen Schusses und der Glanz der hellen Sonne flossen für alle zu einem einzigen Eindruck von Kühnheit und Fröhlichkeit zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee801161-b081-4717-98d1-9c2e3c36c020",
                        "source_entry_id": "adeb0407-1ee8-3be6-b387-a7225d3c924f",
                        "source_sense_id": "f9fc6470-595c-3fde-8ea3-827ee769e14e",
                        "source_sense_description": "een aangename stemming waarin men veel lacht, zich goed voelt en het leven optimistisch bekijkt",
                        "target_lang_word": "cheerfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                        "entry_id": "22992355-ca5c-36ce-8567-edbb80c94af2",
                                        "glosses": [
                                            "The state of being cheerful; joy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50aa49d1-e64f-4ddc-8391-7d8377c3d509",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "Or he that exhorteth, on exhortation: he that giueth, let him doe it with simplicitie: hee that ruleth, with diligence: hee that sheweth mercy, with cheerefulnesse."
                                            },
                                            {
                                                "example_id": "1d546bda-b067-418d-8b73-1f63d0495500",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "The banded ones were all dressed in white gowns - a gay survival from Old Style days, when cheerfulness and May-time were synonyms - days before the habit of taking long views had reduced emotions to a monotonous average."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60af7d18-3eed-482b-b94d-7b97be884435",
                        "source_entry_id": "adeb0407-1ee8-3be6-b387-a7225d3c924f",
                        "source_sense_id": "f9fc6470-595c-3fde-8ea3-827ee769e14e",
                        "source_sense_description": "een aangename stemming waarin men veel lacht, zich goed voelt en het leven optimistisch bekijkt",
                        "target_lang_word": "glee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b58af887-43f5-33e4-b4ce-77589c9c5570",
                                        "entry_id": "dc9ff924-c3d0-3472-8ef8-86a8da3094d0",
                                        "glosses": [
                                            "Joy; happiness; great delight, especially from one's own good fortune or from another's misfortune."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5c5df9d-9abd-499e-81e2-ae1fb0b60b8f",
                                                "sense_id": "b58af887-43f5-33e4-b4ce-77589c9c5570",
                                                "text": "I watched with glee while your kings and queens fought for ten decades for the gods they made."
                                            },
                                            {
                                                "example_id": "0aa0dca9-b677-44e5-a48f-bdd1b714b1e6",
                                                "sense_id": "b58af887-43f5-33e4-b4ce-77589c9c5570",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d16670-6f11-34d0-9aa2-26bf27519a9f",
                                        "entry_id": "dc9ff924-c3d0-3472-8ef8-86a8da3094d0",
                                        "glosses": [
                                            "Music; minstrelsy; entertainment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "342797d2-83a8-3e85-972a-0d80c671391d",
                                        "entry_id": "dc9ff924-c3d0-3472-8ef8-86a8da3094d0",
                                        "glosses": [
                                            "An unaccompanied part song for three or more solo voices, not necessarily merry."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee89a861-e1e9-40ad-a657-5fa8114bacbc",
                                                "sense_id": "342797d2-83a8-3e85-972a-0d80c671391d",
                                                "text": "Sometimes they had glees, when Captain Strong’s chest was of vast service, and he boomed out in a prodigious bass, of which he was not a little proud."
                                            }
                                        ]
                                    }
                                ]
                            },
