                        "target_lang_word": "vertrekken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vertrekken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8315bcb6-326e-347a-8480-f8da7084c798",
                                        "entry_id": "016dc0d2-cfb4-3e51-9e6a-9d21bb592bf4",
                                        "glosses": [
                                            "weggaan."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50db8673-124b-4c2f-8015-fbb73cce095b",
                                                "sense_id": "8315bcb6-326e-347a-8480-f8da7084c798",
                                                "text": "We waren de dag daarvoor vertrokken."
                                            },
                                            {
                                                "example_id": "fa410caa-291b-458a-bd03-69766d4d0f75",
                                                "sense_id": "8315bcb6-326e-347a-8480-f8da7084c798",
                                                "text": "Maar de slang maakte geen aanstalten om te vertrekken."
                                            },
                                            {
                                                "example_id": "49f492fc-c988-4194-a4ab-e0dad9e9a027",
                                                "sense_id": "8315bcb6-326e-347a-8480-f8da7084c798",
                                                "text": "\"Haal ze snel binnen\": Uit onderzoek van wetenschappelijk tijdschrift Nature bleek dat 75 procent van de Amerikaanse onderzoekers nadenkt over vertrekken naar het buitenland in reactie op Trumps beleid en bezuinigingen. Canada en de Europese Unie zijn favoriete bestemmingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0d0fe1-5973-382a-a759-399fd4f8de40",
                                        "entry_id": "016dc0d2-cfb4-3e51-9e6a-9d21bb592bf4",
                                        "glosses": [
                                            "van gelaatstrekken van uitdrukking veranderen"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad14e0b8-066d-45c6-8154-b7b7ea25b001",
                                                "sense_id": "1b0d0fe1-5973-382a-a759-399fd4f8de40",
                                                "text": "Zijn gezicht vertrok van woede."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b3cc3b-baff-3b07-ab7d-d299e86ae991",
                                        "entry_id": "016dc0d2-cfb4-3e51-9e6a-9d21bb592bf4",
                                        "glosses": [
                                            "stoppen met het vervullen van een functie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ada352a-074b-4a34-9d2f-2a1f2d283c6c",
                                                "sense_id": "e9b3cc3b-baff-3b07-ab7d-d299e86ae991",
                                                "text": "De meeste mensen zijn vriendelijk in hun oordeel over u. En toch draait uw maag zich half om als u uw vertrekkende directeur mag toespreken of de familie met een tafelspeech mag onderhouden op de bruiloft van uw dochter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vertrekken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "224abde4-2be8-37af-9a82-feb4c486ad04",
