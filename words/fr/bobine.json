                {
                    "sense_id": "8d4f72f8-6d7b-3c27-8002-f4210bdb6821",
                    "sense_definition": "Composant électrique constitué d'un enroulement de fil conducteur conducteur produisant une inductance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "electricite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien a remplacé la <w>bobine</w> d'allumage défectueuse de la voiture.",
                            "target_lang_translations": {
                                "en": "The mechanic replaced the faulty ignition <w>coil</w> in the car.",
                                "ru": "Механик заменил неисправную <w>катушку</w> зажигания в машине.",
                                "de": "Der Mechaniker hat die defekte <w>Zündspule</w> des Autos ausgetauscht.",
                                "es": "El mecánico reemplazó la <w>bobina</w> de encendido defectuosa del coche.",
                                "zh": "技师换掉了汽车上那个有故障的点火<w>线圈</w>。"
                            }
                        },
                        {
                            "text": "Cette <w>bobine</w> produit un champ magnétique lorsqu'un courant électrique la traverse.",
                            "target_lang_translations": {
                                "en": "This <w>coil</w> produces a magnetic field when an electric current flows through it.",
                                "ru": "Эта <w>катушка</w> создаёт магнитное поле, когда через неё проходит электрический ток.",
                                "de": "Diese <w>Spule</w> erzeugt ein Magnetfeld, wenn ein elektrischer Strom durch sie fließt.",
                                "es": "Esta <w>bobina</w> produce un campo magnético cuando una corriente eléctrica la atraviesa.",
                                "zh": "当有电流通过时，这个<w>线圈</w>就会产生磁场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inductance",
                        "self",
                        "solénoïde"
                    ],
                    "common_phrases": [
                        "bobine d'allumage",
                        "bobine d'inductance"
                    ],
                    "target_lang_definitions": {
                        "en": "An electrical component made of coiled conducting wire that produces inductance.",
                        "ru": "Электрический элемент из проволочной обмотки, создающий индуктивность.",
                        "de": "Elektrisches Bauelement aus gewickeltem Draht, das eine Induktivität erzeugt.",
                        "es": "Componente eléctrico formado por un devanado de hilo conductor que produce inductancia.",
                        "zh": "由绕制的导线构成、能产生电感的电气元件。"
                    },
