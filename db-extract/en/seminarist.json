                                            {
                                                "example_id": "ce07c36f-58f6-4d33-9a41-c7a6c40e1e07",
                                                "sense_id": "319cd72a-31b5-3d5a-8f57-959d755cab42",
                                                "text": "„Zwei Seminaristen in weißer Kutte verlassen gemessenen Schrittes die Kirche Nuestra Señora del Carmen im Zentrum von Havanna.“"
                                            },
                                            {
                                                "example_id": "0bf87d3b-0be8-499b-98a9-087760ef4e7b",
                                                "sense_id": "319cd72a-31b5-3d5a-8f57-959d755cab42",
                                                "text": "„Der Pfarrer ließ mich als Seminaristen einkleiden und führte mich dann nach San Cipriano auf der Insel Murano, um mich dem Rektor vorzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
