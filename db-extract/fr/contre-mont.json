                        "glosses": [
                            "En allant vers l’amont."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcca7b2b-5568-49da-900a-3cacbe2d9561",
                                "sense_id": "a4d6426f-01b8-31e8-8bff-d54ae584c3f5",
                                "text": "« Il se faisait tirer, dit un journal manuscrit de cette année, contre-mont la rivière du Rhône, dans un bateau où l’on avait bâti une chambre de bois, tapissée de velours rouge cramoisi à feuillages, le fond étant d’or. »"
                            },
                            {
                                "example_id": "7fe82317-970b-4874-90c1-db6e5d35495b",
                                "sense_id": "a4d6426f-01b8-31e8-8bff-d54ae584c3f5",
                                "text": "Puis, de fil en aiguille, voilà que l’on babille, de-ci, de-çà, à gauche, à dextre, contre-mont, contre-bas, pour la joie de jaser, sans savoir où l’on va."
                            }
                        ]
                    }
