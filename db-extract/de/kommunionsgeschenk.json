                "senses": [
                    {
                        "sense_id": "5e7e2f7a-ba0a-3eb1-9413-331c1f0a0a02",
                        "entry_id": "b36f67f4-4cef-3a2c-85fb-1d61a95854d3",
                        "glosses": [
                            "Geschenk, das einem Kommunionkind traditionell anlässlich seiner ersten heiligen Kommunion überreicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30abedb7-4978-4fc2-8178-b5cd880bc8a2",
                                "sense_id": "5e7e2f7a-ba0a-3eb1-9413-331c1f0a0a02",
                                "text": "„Ein neuer Satz Stifte passt beispielsweise auch in jedes Osternest oder ist ein sinnvolles Konfirmations- oder Kommunionsgeschenk.“"
                            },
                            {
                                "example_id": "55e6a477-5a96-4d1f-8294-2496facb64c7",
                                "sense_id": "5e7e2f7a-ba0a-3eb1-9413-331c1f0a0a02",
                                "text": "„Als Kommunionsgeschenk bekam Horst eine Armbanduhr, eine Schachtel Pralinen und insgesamt neunzig Reichsmark.“"
                            },
                            {
                                "example_id": "2520bba3-3574-4aad-bb20-24b1a4bfef93",
                                "sense_id": "5e7e2f7a-ba0a-3eb1-9413-331c1f0a0a02",
                                "text": "„Als Pate, aber auch als Eltern, Verwandte oder Nachbarn ist es nicht immer einfach, ein passendes Kommunionsgeschenk zu finden.“"
                            },
                            {
                                "example_id": "a0106938-3a7f-4fc7-b9af-147806feb447",
                                "sense_id": "5e7e2f7a-ba0a-3eb1-9413-331c1f0a0a02",
                                "text": "„Die Eltern kennen ihre Sprösslinge am besten und sie entscheiden auch, welchen Wert das Kommunionsgeschenk haben soll.“"
                            },
                            {
                                "example_id": "e716dba0-eb76-4383-b2f2-969b59b060b3",
                                "sense_id": "5e7e2f7a-ba0a-3eb1-9413-331c1f0a0a02",
                                "text": "„Denn diese mussten ebenso nochmal die Kleider im Schrank überprüfen und das Kommunionsgeschenk besorgen und verpacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
