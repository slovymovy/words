                "senses": [
                    {
                        "sense_id": "76a2ad1e-6ddc-3bd6-9b19-4d8330489df0",
                        "entry_id": "6f37a570-90ee-39d9-8248-57334b361209",
                        "glosses": [
                            "распространённое сокращённое название Гарвардского университета, расположенного в городе Кембридж, Массачусетс, США"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00fe5df7-ee88-4a4f-ad1e-187afdefd2f6",
                                "sense_id": "76a2ad1e-6ddc-3bd6-9b19-4d8330489df0",
                                "text": "Совсем недавно Дж. Редвайн из компании «Нейром» в калифорнийском городе Ла-Джолла с коллегами из Гарварда обнаружил уменьшение объёма зубчатой извилины у мышей, у которых экспериментально была воспроизведена модель болезни Альцгеймера."
                            }
                        ]
                    }
