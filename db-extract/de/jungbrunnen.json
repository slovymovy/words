                        "form": "die Jungbrunnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58982f20-db32-31da-8a95-783a83ad1085",
                        "entry_id": "42c82501-53ca-3329-b578-1ebf792c90aa",
                        "glosses": [
                            "Quelle, deren Wasser dem, der es trinkt oder der darin badet, Heilung und Verjüngung verheißt"
                        ],
                        "tags": [
                            "Volkskunde"
                        ],
                        "examples": [
                            {
                                "example_id": "09656056-86f7-4d7a-a6e6-d006c6b76502",
                                "sense_id": "58982f20-db32-31da-8a95-783a83ad1085",
                                "text": "„Der spanische Konquistador Juan Ponce de León suchte auf seiner Expedition nach Florida 1513 vergeblich nach dem verheißenen Jungbrunnen.“"
                            },
                            {
                                "example_id": "dbd52bcf-f34c-4b76-8311-f5d536ca0284",
                                "sense_id": "58982f20-db32-31da-8a95-783a83ad1085",
                                "text": "„Selbst aus dem Jungbrunnen kommen Cranachs ohnehin schablonenhafte Mädchenfrauen etwas anämisch, verglichen mit der überquellenden, nahezu erdrückenden Opulenz der »Zwei Hexen« des Dürer-Schülers Hans Baldung, genannt Grien, von 1523.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33a96a23-276c-36b5-be6d-008e594b5277",
                        "entry_id": "42c82501-53ca-3329-b578-1ebf792c90aa",
                        "glosses": [
                            "Erlebnis, das einen sich wieder jung fühlen lässt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6d276f5c-d217-4748-bb7b-569d3eaa71a6",
                                "sense_id": "33a96a23-276c-36b5-be6d-008e594b5277",
                                "text": "„Jungbrunnen im übertragenen Sinn sind Erlebnisse, Gegenstände oder Verhaltensweisen, die einen Menschen sich jugendlich oder jung fühlen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
