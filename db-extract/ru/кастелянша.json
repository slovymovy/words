                            {
                                "example_id": "883c583b-f241-49ef-9b52-91230a8184e0",
                                "sense_id": "9bdb2a99-56c9-3b41-ba60-f8dba575a1cd",
                                "text": "После работы Лукьяныч идёт в детский сад и вместе с заведующей и кастеляншей производит выбраковку одеял."
                            }
                        ]
                    }
