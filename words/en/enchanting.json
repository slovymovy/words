{
    "word_family": [
        "enchant",
        "enchanter",
        "enchantment",
        "enchantress"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13ddf048-78c1-392e-9a1c-c8c54bbcf1f2",
                    "sense_definition": "Having the ability to enchant; charming, delightful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with <w>enchanting</w> flowers that smelled wonderful.",
                            "target_lang_translations": {
                                "ru": "Сад был полон <w>очаровательных</w> цветов, которые чудесно пахли."
                            }
                        },
                        {
                            "text": "She sang an <w>enchanting</w> melody that captivated the entire audience.",
                            "target_lang_translations": {
                                "ru": "Она спела <w>обворожительную</w> мелодию, которая покорила всю аудиторию."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewitching"
                    ],
                    "common_phrases": [
                        "enchanting smile",
                        "enchanting voice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью очаровывать; прелестный, восхитительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровательный",
                                "target_lang_sense_clarification": "вызывающий восхищение, обаятельный"
                            },
                            {
                                "target_lang_word": "обворожительный",
                                "target_lang_sense_clarification": "обладающий сильным притягательным действием"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "febf3267-04d6-39e9-b5f6-cc81288e4c4b",
                    "sense_definition": "Present participle and gerund of <w>enchant</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician was <w>enchanting</w> the audience with his incredible card tricks.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>завораживал</w> публику своими невероятными карточными трюками."
                            }
                        },
                        {
                            "text": "He spent the whole evening <w>enchanting</w> his guests with stories of his travels.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, <w>очаровывая</w> своих гостей историями о своих путешествиях."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «очаровывать» (enchant)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровывающий",
                                "target_lang_sense_clarification": "процесс воздействия на кого-либо"
                            },
                            {
                                "target_lang_word": "завораживающий",
                                "target_lang_sense_clarification": "приковывающий внимание, магически воздействующий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "593b9160-193e-3582-b2cf-707c4b89c04f",
                    "sense_definition": "An act of enchantment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old book described various <w>enchantings</w> used by ancient sorcerers.",
                            "target_lang_translations": {
                                "ru": "В старой книге описывались различные <w>чародейства</w>, используемые древними колдунами."
                            }
                        },
                        {
                            "text": "Legends tell of mysterious <w>enchantings</w> that could change the weather.",
                            "target_lang_translations": {
                                "ru": "Легенды рассказывают о таинственных <w>колдовствах</w>, способных изменить погоду."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс наложения чар, колдовство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колдовство",
                                "target_lang_sense_clarification": "магическое действие"
                            },
                            {
                                "target_lang_word": "чародейство",
                                "target_lang_sense_clarification": "устаревшее или литературное обозначение магии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}