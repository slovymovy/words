        "fr-extract.jsonl": [
            {
                "entry_id": "d59deda9-30c9-3f51-810a-d7a1cab47142",
                "word": "Yukon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db4b7d38-a377-3690-ad53-21df012bb466",
                        "entry_id": "d59deda9-30c9-3f51-810a-d7a1cab47142",
                        "glosses": [
                            "Fleuve d’Amérique du Nord qui prend sa source en Colombie-Britannique puis traverse le Yukon (2) et l’Alaska et se jette dans la mer de Béring."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "53232a5d-356c-463b-96d9-f478bd85e2e6",
                                "sense_id": "db4b7d38-a377-3690-ad53-21df012bb466",
                                "text": "Et la rumeur se répandit, dans tout le Northland, que la récolte du jaune métal était plus abondante encore que sur les rive du Yukon. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, page 212)"
                            }
                        ]
                    },
                    {
                        "sense_id": "670324cd-edca-3daa-9806-9a2bef07bd17",
                        "entry_id": "d59deda9-30c9-3f51-810a-d7a1cab47142",
                        "glosses": [
                            "Territoire du Canada (symbole postal YT), bordé par l’océan Arctique (mer de Beaufort) au nord, les Territoires du Nord-Ouest à l’est, la Colombie-Britannique au sud, et l’Alaska à l’ouest, et dont la capitale est Whitehorse. Son symbole postal est YT."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "418e44f7-2ed8-491e-83b3-e3044a5aa1e5",
                                "sense_id": "670324cd-edca-3daa-9806-9a2bef07bd17",
                                "text": "J’habite au Yukon."
                            },
                            {
                                "example_id": "2147047b-5caf-4d88-8c7e-c48f17ca579f",
                                "sense_id": "670324cd-edca-3daa-9806-9a2bef07bd17",
                                "text": "On reculera l'heure de 2 h à 1 h dans la nuit de dimanche au Canada, sauf en Saskatchewan et au Yukon."
                            }
                        ]
                    }
                ],
