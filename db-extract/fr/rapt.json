            {
                "entry_id": "c438fa71-6c13-38bd-8f36-8cf2bbf99787",
                "word": "rapt",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1e16e0e8-0f2d-43ec-ad37-3b0016fa328b",
                        "entry_id": "c438fa71-6c13-38bd-8f36-8cf2bbf99787",
                        "tags": [
                            "plural"
                        ],
                        "form": "rapts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f084ec6-43b4-375b-a3e1-321288390195",
                        "entry_id": "c438fa71-6c13-38bd-8f36-8cf2bbf99787",
                        "glosses": [
                            "Enlèvement, par violence ou par séduction, d’une personne, et spécialement d’une jeune fille, d’une femme mariée, d’une religieuse, ou encore d’un enfant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eef8632-15f8-49dd-8280-6aefba10267b",
                                "sense_id": "7f084ec6-43b4-375b-a3e1-321288390195",
                                "text": "On vous l’a enlevée ! reprit le commissaire, et savez-vous quel est l’homme qui a commis ce rapt ?"
                            },
                            {
                                "example_id": "bdfeb102-87d6-49a1-98b6-c8abca6b1f44",
                                "sense_id": "7f084ec6-43b4-375b-a3e1-321288390195",
                                "text": "Le législateur canonique intervient aussi pour réprimer le rapt ; le Concile de Chalcédoine de 451 (canon 27) dépose les clercs coupables de complicité de rapt et excommunie les laïques dans ces cas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a1743b1-9b73-4cea-ae21-99bd8a5eeed6",
                        "source_entry_id": "c438fa71-6c13-38bd-8f36-8cf2bbf99787",
                        "source_sense_id": "7f084ec6-43b4-375b-a3e1-321288390195",
                        "target_lang_word": "Entführung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entführung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13b0b6d0-3b3f-3c2d-bb69-a6cf2c31623c",
                                        "entry_id": "9a3e224f-16df-322b-aca8-15945f56ba9f",
                                        "glosses": [
                                            "Entfernung einer Person (oder auch Sache) gegen ihren Willen mit Gewalt/Androhung von Gewalt aus ihrem eigenen Umfeld sowie das Ergebnis einer solchen Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeeedfb9-6f23-42de-b382-d3f7b77a0341",
                                                "sense_id": "13b0b6d0-3b3f-3c2d-bb69-a6cf2c31623c",
                                                "text": "Die Entführung von Kindern zählt zu den schweren Verbrechen."
                                            },
                                            {
                                                "example_id": "bdc6cd01-143c-40c5-9f55-19c061a4491e",
                                                "sense_id": "13b0b6d0-3b3f-3c2d-bb69-a6cf2c31623c",
                                                "text": "„Crowther kann von seiner Entführung berichten, weil er später die Freiheit wiedererlangt und anglikanischer Pfarrer wird – so lernt er schreiben.“"
                                            },
                                            {
                                                "example_id": "0e9f9469-f995-460e-8217-042b17272958",
                                                "sense_id": "13b0b6d0-3b3f-3c2d-bb69-a6cf2c31623c",
                                                "text": "„Requiem gab vor, im Gesundheitssektor zu arbeiten, aber niemand in Stadtland wusste, was er wirklich trieb, einmal abgesehen von Entführungen und Einbrüchen im Polygon.“"
                                            },
                                            {
                                                "example_id": "26d51ff3-214e-4a53-b7cf-5f7043c1e287",
                                                "sense_id": "13b0b6d0-3b3f-3c2d-bb69-a6cf2c31623c",
                                                "text": "„Einen oder zwei Tage später sagte mir Pater Giorgi, das Tagesgespräch in Rom sei die mißlungene Entführung der Tochter des Advokaten Dalacqua; man halte mich für den Anstifter der ganzen Sache, und das mißbillige er sehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98776e5a-b546-4048-87df-e079ec942f80",
                        "source_entry_id": "c438fa71-6c13-38bd-8f36-8cf2bbf99787",
