    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                "word": "pachydermal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "94f6ec8c-5576-4bbb-b3a1-544b30ac358d",
                        "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more pachydermal"
                    },
                    {
                        "form_id": "c08d8f46-380a-4500-8c7d-0a4e0f82dd4a",
                        "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most pachydermal"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f23512b4-d9cd-31c7-aa2c-57654789229f",
                        "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                        "glosses": [
                            "Synonym of pachydermic.",
                            "Characterized by or characteristic of pachydermy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b14136-9b86-4eb3-be96-e8202c042ecd",
                                "sense_id": "f23512b4-d9cd-31c7-aa2c-57654789229f",
                                "text": "At that point of time the skin is macroscopically seen to be slightly thickened and is in course of transition to the pachydermal stage."
                            },
                            {
                                "example_id": "d496cc7b-024d-4500-89e5-bb062b204e13",
                                "sense_id": "f23512b4-d9cd-31c7-aa2c-57654789229f",
                                "text": "Periosteal changes occur in trauma, psoriatic arthritis (above ankle), HPOA, and pachydermal periostitis."
                            },
                            {
                                "example_id": "fb0f379e-3702-4cd3-9695-d09bc4bd666d",
                                "sense_id": "f23512b4-d9cd-31c7-aa2c-57654789229f",
                                "text": "In addition, the stooped posture progresses to the point where ribs rest on the iliac crest, and circumferential pachydermal skin folds develop at the pelvis and ribs."
                            }
                        ]
                    },
                    {
                        "sense_id": "faea9526-9ebb-371d-b52a-f1b3a36feab4",
                        "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                        "glosses": [
                            "Synonym of pachydermic.",
                            "Pertaining to the obsolete taxonomic order Pachydermata."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045e7d80-c3b7-4b2e-b846-8996dcad94cc",
                                "sense_id": "faea9526-9ebb-371d-b52a-f1b3a36feab4",
                                "text": "The anterior teeth are, however, displaced before the posterior ones are developed, although they have no vertical successors, which circumstance is also characteristic of the Elephant : the shape, the structure, and the mode of implantation of the molars of the Manatee quite accord with the pachydermal type, and herein more especially with the Dinotherium and Tapir."
                            },
                            {
                                "example_id": "ecaab720-c321-4ccc-9956-62edc2cae815",
                                "sense_id": "faea9526-9ebb-371d-b52a-f1b3a36feab4",
                                "text": "As far as the teeth, jaws, and other scattered bones enable the comparative anatomist to decide, the nototherium manifests pachydermal modifications of the marsupial type ; hence the inference that' Australia (whose largest native quadruped is now the kangaroo) was, immediately preceding the current era, inhabited by a marsupial vegetable-feeder as large as the rhinoceros."
                            },
                            {
                                "example_id": "a5ef0711-dc35-4bab-8afc-ef2a6c403a7c",
                                "sense_id": "faea9526-9ebb-371d-b52a-f1b3a36feab4",
                                "text": "Though, owing to the size of the bird, the bones of Megalapteryx are somewhat more massive than those of Apteryx, nevertheless they are easily distinguished by their elegant form from those of the Dinornithidae, which, even the most slender forms, have all a more pachydermal type than this new species."
                            }
                        ]
                    },
                    {
                        "sense_id": "13848856-571b-3580-a50b-1dfa2c71206c",
                        "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                        "glosses": [
                            "Synonym of pachydermic.",
                            "Pertaining to or involving elephants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbb414b-4e3d-4b5f-b7f1-22a534e6010a",
                                "sense_id": "13848856-571b-3580-a50b-1dfa2c71206c",
                                "text": "Thai veterinarians interviewed during the course of this research particularly commented on pachydermal aversion to their presence."
                            },
                            {
                                "example_id": "711528fc-c7e8-4d27-a3ef-e903f2c6b52d",
                                "sense_id": "13848856-571b-3580-a50b-1dfa2c71206c",
                                "text": "Elephants will assist you, in ways you can't imagine, to remember the good times. I am there never to forget. They let the good times roll and rumble. They are, as it were, pachydermal rivets, holding fast the compromised fabric of this futile, unbolted, realm."
                            },
                            {
                                "example_id": "a52a3d10-34de-4126-a90f-9c1481649f9e",
                                "sense_id": "13848856-571b-3580-a50b-1dfa2c71206c",
                                "text": "Thus did my landlady see me off into the grey morning, replete with fried bread and the blunt logistics of her pachydermal mania ('Got first twenty-nine years back. Stopped counting at three and half thousand. Clean buggers with hairdryer.')"
                            }
                        ]
                    },
                    {
                        "sense_id": "0517e4f0-1ab7-3b5a-9cb8-111cef703d33",
                        "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                        "glosses": [
                            "Synonym of pachydermic.",
                            "Massive; elephantine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ca7ca20-c2be-45d4-a910-91b82e19fe2b",
                                "sense_id": "0517e4f0-1ab7-3b5a-9cb8-111cef703d33",
                                "text": "[…]which was why I was banished to the backyard while those with verbal-wallets bursting at seams, with pachydermal crock, did a sumptuous roast on the old lady's fears and pains […]"
                            },
                            {
                                "example_id": "69f3d9bc-9901-41b2-972e-6a66b865363f",
                                "sense_id": "0517e4f0-1ab7-3b5a-9cb8-111cef703d33",
                                "text": "The largest kopje bulges organically out of the ground, pachydermal, pregnant, prodigious, a bastion of permanence in a land of restless change."
                            },
                            {
                                "example_id": "f71c0e12-97fe-48c7-9000-242c14f2a46c",
                                "sense_id": "0517e4f0-1ab7-3b5a-9cb8-111cef703d33",
                                "text": "While Epoi has no doubts about his own sanity, there are ten Tropoi or modes of scepticism surrounding pachydermal self-assurance."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa5fd999-6eae-3606-9391-780e725de059",
                        "entry_id": "6f078d84-e6ae-3ba9-af65-dcd80c8d22cc",
                        "glosses": [
                            "Grainy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e2b089-dd73-47e3-8fa5-4f3f5d86e20e",
                                "sense_id": "fa5fd999-6eae-3606-9391-780e725de059",
                                "text": "The pachydermal exothecial cells of the capsule that are prevalent in rheophytes are lacking."
                            },
                            {
                                "example_id": "25abd59a-3b1d-4082-abae-fa63164059f3",
                                "sense_id": "fa5fd999-6eae-3606-9391-780e725de059",
                                "text": "The calyptra, c. 3 mm tall, is rough with grain-like (pachydermal) cells, scattered over the upper half and concentrated into a loose cluster at the apex."
                            },
                            {
                                "example_id": "65d88fe2-473c-47bd-b9dd-ea249e67959b",
                                "sense_id": "fa5fd999-6eae-3606-9391-780e725de059",
                                "text": "The overlying fine-grained to medium-grained sandstone includes the characteristic mottled lithology and is several metres thick, often with pachydermal jointing."
                            }
                        ]
                    }
