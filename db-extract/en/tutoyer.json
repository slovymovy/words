                        "glosses": [
                            "To address (someone) in French using the familiar second-person pronoun tu; to thou."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "146e92e1-403f-41d0-a1a8-6098f9cc7b60",
                                "sense_id": "ab56a366-c85d-355f-834c-5fd75dbbad9d",
                                "text": "As I had begged Goethe to tutoyer me, he sent me a message to say, I must really remain more than the two days I had named, otherwise he should never get into the way of doing so."
                            },
                            {
                                "example_id": "391025b7-9467-4937-91a3-dc8c932531e4",
                                "sense_id": "ab56a366-c85d-355f-834c-5fd75dbbad9d",
                                "text": "[…] Corporal Cornichon, walking straight up to the bar, \"tutoyering\" me all the time in the most horridly familiar manner, clapped me on the back, and asked me to take a glass of cognac with him."
                            }
                        ]
