                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трубы",
                                "target_lang_sense_clarification": "множественное число от 'труба', музыкальный инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f6fc7c2-3391-34cf-9566-1cc0308847f3",
                    "sense_definition": "A plant (Sarracenia flava) with long, hollow leaves.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swamp was filled with yellow <w>trumpets</w> reaching toward the sun.",
                            "target_lang_translations": {
                                "ru": "Болото было заполнено желтыми <w>саррацениями</w>, тянущимися к солнцу."
                            }
                        },
                        {
                            "text": "Botanists often study the unique structure of <w>trumpets</w> in the wild.",
                            "target_lang_translations": {
                                "ru": "Ботаники часто изучают уникальное строение <w>кувшиночников</w> в дикой природе."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitcher plant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хищное растение с длинными полыми листьями в форме воронки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "саррацения",
                                "target_lang_sense_clarification": "название растения"
                            },
                            {
                                "target_lang_word": "кувшиночник",
                                "target_lang_sense_clarification": "общее название насекомоядных растений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20cd9cc8-493b-3bee-8609-83302e3d8655",
                    "sense_definition": "Third-person singular simple present indicative of <w>trumpet</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elephant <w>trumpets</w> loudly when it feels threatened by predators.",
                            "target_lang_translations": {
                                "ru": "Слон громко <w>трубит</w>, когда чувствует угрозу со стороны хищников."
                            }
                        },
                        {
                            "text": "The newspaper <w>trumpets</w> the success of the new policy on its front page.",
                            "target_lang_translations": {
                                "ru": "Газета громко <w>трубит об</w> успехе новой политики на своей первой полосе."
                            }
                        }
                    ],
                    "synonyms": [
                        "proclaims",
                        "announces"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий трубный звук или громко, публично объявлять о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трубит",
                                "target_lang_sense_clarification": "издает звук, характерный для слона"
                            },
                            {
                                "target_lang_word": "трубит о",
                                "target_lang_sense_clarification": "громко и настойчиво объявляет, оповещает"
                            }
                        ]
                    }
                }
            ]
        }
    ]
