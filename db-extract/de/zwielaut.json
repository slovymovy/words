                "senses": [
                    {
                        "sense_id": "3d6a64f9-858e-333d-91b0-4cd4581ecac4",
                        "entry_id": "4d6c86f1-d60a-3a5c-aa81-897ce6dbe02c",
                        "glosses": [
                            "deutscher Ausdruck für Diphthong; Folge von zwei Vokalen in einer Silbe, die phonetisch als Einheit aufgefasst werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2011f2-4b87-4d46-afa0-26c32813d4ff",
                                "sense_id": "3d6a64f9-858e-333d-91b0-4cd4581ecac4",
                                "text": "Im Deutschen gibt es folgende Diphthonge: [aɪ̯] (Hai), [aʊ̯] (Bau), [ɔɪ̯] (Heu) und [ʊɪ̯] (nur in Interjektionen und Fremdwörtern; z.B. hui, pfui, ui; Uigure)."
                            },
                            {
                                "example_id": "7027e06c-ce28-4729-aba5-68c9d8adb063",
                                "sense_id": "3d6a64f9-858e-333d-91b0-4cd4581ecac4",
                                "text": "„Die Bezeichnung der Vokalverbindung als Zwielaut und ihre Bedeutung als Silbenkern sind hier bereits hervorzuheben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
