                "senses": [
                    {
                        "sense_id": "6da27c96-2baa-34c5-be5a-1d5465eac19f",
                        "entry_id": "07d43ff3-e908-3a62-8415-6a945547baec",
                        "glosses": [
                            "Personne qui prescrit, plus particulièrement, conseiller qui recommande, conseille l’achat d’un produit, la prise d’un médicament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea81ed3-2eb1-468f-a8b5-5c06aca8e4de",
                                "sense_id": "6da27c96-2baa-34c5-be5a-1d5465eac19f",
                                "text": "Et moi, pauvre médicastre de quartier, prescripteur de purges et de laxatifs."
                            },
                            {
                                "example_id": "826c01b5-2355-4075-9d22-8422568af46e",
                                "sense_id": "6da27c96-2baa-34c5-be5a-1d5465eac19f",
                                "text": "Les Fonderies Franco-Belges Fabricant de matériel de chauffage, leader sur son marché, cherche : un directeur régional sud-ouest. Il anime une équipe de trois représentants exclusifs (efficaces) qui visitent une clientèle de prescripteurs, d’installateurs et de distributeurs."
                            },
                            {
                                "example_id": "6eabeea4-9a1e-4d4c-bc44-c4dd7a390b79",
                                "sense_id": "6da27c96-2baa-34c5-be5a-1d5465eac19f",
                                "text": "Pour réussir cette transformation relative aux pratiques d’achat gouvernemental, il sera tout aussi important d’accompagner les prescripteurs afin de leur permettre de bien comprendre les différentes variables de durabilité et d’innovation, beaucoup plus complexes à évaluer."
                            }
                        ]
                    }
                ],
