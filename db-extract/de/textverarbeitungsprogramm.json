                                        "sense_id": "446e65f2-7ac4-308f-bbc2-b5cdf787d0b1",
                                        "entry_id": "1dd84314-1919-362c-9b5c-a2e8343370db",
                                        "glosses": [
                                            "A device similar to a simple computer, designed for word processing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6254674-3a51-4e6e-b0da-f8454bfe349c",
                                                "sense_id": "446e65f2-7ac4-308f-bbc2-b5cdf787d0b1",
                                                "text": "Actually that first story, and all of the succeeding ones, were written by archy — a cockroach with such a need for self-expression that he hoisted himself onto the typewriter keys every night and dove headfirst onto key after key, to pound out his stories. (That is why all of the poems are lower case — he might have better luck these days with a word processor.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664f9e7c-5908-34e2-9a3e-f1e36da87b5c",
                                        "entry_id": "1dd84314-1919-362c-9b5c-a2e8343370db",
                                        "glosses": [
                                            "Software that provides word processing functions on a computer, typically including typeface selection, line justification and other formatting, pagination, and numerous other features."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72187cb2-b82f-4853-a069-f7f3d8586822",
                                                "sense_id": "664f9e7c-5908-34e2-9a3e-f1e36da87b5c",
                                                "text": "A smartphone is not the best camera, notebook, word processor, audio recorder, radio, MP3 player, map reader, pedometer and so on, but it is good enough replace numerous separate devices for most people most of the time."
                                            }
                                        ]
                                    }
