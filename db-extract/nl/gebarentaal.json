                "senses": [
                    {
                        "sense_id": "416dffcf-8864-3e3c-8aff-e80318dbb2a3",
                        "entry_id": "f28cf793-4a4e-3cc0-95dc-8a4b32bede27",
                        "glosses": [
                            "taal waarin men door gebaren en gezichtsexpressies communiceert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46e1347d-adc9-4a67-b2a0-f8875a109170",
                                "sense_id": "416dffcf-8864-3e3c-8aff-e80318dbb2a3",
                                "text": "Gebarentaal wordt niet alleen door doven gebruikt."
                            },
                            {
                                "example_id": "6b45c3f7-c7d8-4075-8626-4201c09ded70",
                                "sense_id": "416dffcf-8864-3e3c-8aff-e80318dbb2a3",
                                "text": "Mijn gebarentaal was bijzonder slecht, hoewel men langzaam mijn hints leerde ontcijferen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "601157dd-a95c-44e0-ad15-af3678e456ae",
                        "source_entry_id": "f28cf793-4a4e-3cc0-95dc-8a4b32bede27",
                        "source_sense_id": "416dffcf-8864-3e3c-8aff-e80318dbb2a3",
