                ],
                "senses": [
                    {
                        "sense_id": "41d52fdb-5ca2-37c9-a2c8-38f0724f2e9d",
                        "entry_id": "5b133c09-dd48-3556-a1c9-9fb4b42ea11f",
                        "glosses": [
                            "Schaffung/Entstehung der Welt/Umwelt/einer eigenen Welt/Heimat"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f45ed0-46a2-43ae-ae36-aff36ff987dc",
                                "sense_id": "41d52fdb-5ca2-37c9-a2c8-38f0724f2e9d",
                                "text": "„Kinder bringen ihre Spielsituation gemeinsam mit anderen in Bezug auf eine sozialräumliche und natürliche Umwelt hervor (Oikopoiese).“"
                            },
                            {
                                "example_id": "527ec4ce-b1e8-4eab-93aa-55fe80ba8b99",
                                "sense_id": "41d52fdb-5ca2-37c9-a2c8-38f0724f2e9d",
                                "text": "„An diesem Gedanken nimmt der Begriff der Oikopoiese eine gewisse Korrektur vor.“"
                            },
                            {
                                "example_id": "cc03b920-2c98-4d29-97a7-95340f9e96e0",
                                "sense_id": "41d52fdb-5ca2-37c9-a2c8-38f0724f2e9d",
                                "text": "„Er benutzt zunehmend und in Abgrenzung den Begriff Oikopoiese, da in diesem »die Vertrautheit mit der Umwelt und die normative Orientierung am Prinzip der Humanisierung« ausgedrückt wird (ebd., 267).“"
                            },
                            {
                                "example_id": "5d5cbf43-b1e3-412a-b53b-acaafbcc9344",
                                "sense_id": "41d52fdb-5ca2-37c9-a2c8-38f0724f2e9d",
                                "text": "„Ein ökologisch orientiertes Erziehen orientiert sich sich als «Oikopoiese», d. h. als gestaltendes Tun am Heimischwerden des Menschen in seiner Lebenswelt.“"
                            },
                            {
                                "example_id": "38261d4f-9eec-4394-b8ed-daf01c727eed",
                                "sense_id": "41d52fdb-5ca2-37c9-a2c8-38f0724f2e9d",
                                "text": "„Jedes der sieben Gesichter setzt Grenzen. Infolgedessen kann die Oikopoiese nicht einfältig, sondern nur vielfältig sein, und die Nachhaltigkeit darf sich nicht auf die Maximierung eines Faktors beschränken, hinsichtlich des Waldes etwa auf die Erholung oder auf den Naturschutz oder aber die Holzwirtschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
