                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "75cb3d27-5fb8-409c-be82-411220fcc5b0",
                                "sense_id": "f7e6098b-c932-3e86-a8f4-91ed701a1361",
                                "text": "Ik heb last van hevige hoofdpijn en neem een pijnstiller.",
                                "translation": "I have a severe headache and will take a painkiller.",
                                "english": "I have a severe headache and will take a painkiller."
                            },
                            {
                                "example_id": "d63c625c-1dcb-4f5d-8da6-533c8d5086b8",
                                "sense_id": "f7e6098b-c932-3e86-a8f4-91ed701a1361",
                                "text": "De lange werkdag gaf me een flinke dosis hoofdpijn aan het eind.",
                                "translation": "The long workday gave me a substantial amount of headache by the end.",
                                "english": "The long workday gave me a substantial amount of headache by the end."
                            },
                            {
                                "example_id": "1f905ae3-9925-4495-a140-1d1bdb4a30b6",
                                "sense_id": "f7e6098b-c932-3e86-a8f4-91ed701a1361",
                                "text": "Als je veel water drinkt, kan dat helpen tegen hoofdpijn",
                                "translation": "Drinking plenty of water can help with headache.",
                                "english": "Drinking plenty of water can help with headache."
                            }
                        ]
                    }
                ],
