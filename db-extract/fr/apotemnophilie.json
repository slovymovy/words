                "senses": [
                    {
                        "sense_id": "ae0d78e4-8d2d-31a5-8dfe-9e9f0bda3d5f",
                        "entry_id": "30b29da3-df55-34eb-97d7-56fa54175fdb",
                        "glosses": [
                            "Trouble neurologique dans lequel un individu exprime un fort désir spécifique de subir l’amputation d’un ou plusieurs membres ou parties de son corps en bon état."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3363d26d-8798-413e-801e-2f0a44bb0baa",
                                "sense_id": "ae0d78e4-8d2d-31a5-8dfe-9e9f0bda3d5f",
                                "text": "Saviez-vous que certains obsédés peuvent être excités par la vue... du moignon d’un amputé, et qu’ils souffrent alors d’apotemnophilie ?"
                            },
                            {
                                "example_id": "861c12d3-70d7-4cc1-a2a2-0a48c0bf5317",
                                "sense_id": "ae0d78e4-8d2d-31a5-8dfe-9e9f0bda3d5f",
                                "text": "Connaissez-vous l’apotemnophilie ?\nC’est un « trouble identitaire de l’intégrité corporelle » qui fait qu’une personne qui a tous ses membres se sent « handicapée » en dedans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39245a49-5231-481c-aef9-96c1e1f7db83",
                        "source_entry_id": "30b29da3-df55-34eb-97d7-56fa54175fdb",
                        "source_sense_id": "ae0d78e4-8d2d-31a5-8dfe-9e9f0bda3d5f",
                        "source_sense_description": "Trouble neurologique avec désir d’amputation",
                        "target_lang_word": "apotemnophilia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apotemnophilia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3fd0c9d-c9bf-3ca3-9dec-c0d7967d8f89",
                                        "entry_id": "4797c974-22e5-30ed-b6fe-62d4b56acc03",
                                        "glosses": [
                                            "A psychological disorder characterized by the intense and long-standing desire for amputation of a specific limb."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "100e0079-3fd1-3554-a1cb-5f51151dbf85",
                                        "entry_id": "4797c974-22e5-30ed-b6fe-62d4b56acc03",
                                        "glosses": [
                                            "A compulsion to become, or appear to be, an amputee."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b719567c-f7cf-4289-a6bb-d53089c31870",
                                                "sense_id": "100e0079-3fd1-3554-a1cb-5f51151dbf85",
                                                "text": "This paper seeks to present information on apotemnophilia. It points out the need of a man to have a healthy leg amputated, despite the fact that he cannot find a surgeon who will do so."
                                            },
                                            {
                                                "example_id": "c00ee0bb-780c-4d8d-a529-e1856babe21d",
                                                "sense_id": "100e0079-3fd1-3554-a1cb-5f51151dbf85",
                                                "text": "In most cases of apotemnophilia the desire to be an amputee is linked to a form of sexual arousal, but Mr Smith said there was no suggestion that any of his patients were motivated by sexual urges."
                                            },
                                            {
                                                "example_id": "41c6487d-2eb3-49f6-8a0a-53d079a4f4b0",
                                                "sense_id": "100e0079-3fd1-3554-a1cb-5f51151dbf85",
                                                "text": "News of the Weird has reported several times on people with apotemnophilia, or body integrity identity disorder--the consuming desire to have one or more healthy limbs removed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
