                        "examples": []
                    },
                    {
                        "sense_id": "e733ad00-e152-3d82-a727-2b9da8d66c12",
                        "entry_id": "97d2aec5-0638-3d24-a887-bf23cff1641e",
                        "glosses": [
                            "Having an inset decorative pattern."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2389b051-24d4-4205-8678-c21f996fcf10",
                                "sense_id": "e733ad00-e152-3d82-a727-2b9da8d66c12",
                                "text": "When the Minister of Defense was about to raise an elegantly worded, logical, and tactful objection, the French president slammed down his bottle of Perrier on the antique, polished, inlaid surface of the cabinet table and told him to shut up and have the men at the airfield in two hours."
                            },
                            {
                                "example_id": "e1adfd88-862a-4906-ba26-607c051df7c3",
                                "sense_id": "e733ad00-e152-3d82-a727-2b9da8d66c12",
                                "text": "In 2003, at Neal Auction Company in New Orleans, an 1810s mahogany armoire inlaid with ribbons and vines brought $140,000 (the presale estimate was $30,000 to $50,000)."
                            }
                        ]
                    }
