                                "target_senses": [
                                    {
                                        "sense_id": "39239a0c-c6ff-3b8c-8c0f-b5910291e5f3",
                                        "entry_id": "88adabf1-629c-3bd7-ad2f-8e1c940cb4de",
                                        "glosses": [
                                            "die Kardinalzahl zwischen vierunddreißig und sechsunddreißig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "408368ae-15f6-4993-b848-d5d8250e29ae",
                                                "sense_id": "39239a0c-c6ff-3b8c-8c0f-b5910291e5f3",
                                                "text": "Auf der Weide stehen fünfunddreißig Kühe."
                                            },
                                            {
                                                "example_id": "d5190f2a-f76f-4082-a4db-f93f81cceddd",
                                                "sense_id": "39239a0c-c6ff-3b8c-8c0f-b5910291e5f3",
                                                "text": "„Er hatte eine Fahrt von fünfunddreißig Minuten Dauer vor sich.“"
                                            },
                                            {
                                                "example_id": "09cf61a1-2fd9-48e9-87ba-2cedb6629fb4",
                                                "sense_id": "39239a0c-c6ff-3b8c-8c0f-b5910291e5f3",
                                                "text": "„Felix Leiter war etwa fünfunddreißig Jahre alt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "661a912b-711b-397f-b7d2-f4fae138ae85",
                                        "entry_id": "88adabf1-629c-3bd7-ad2f-8e1c940cb4de",
                                        "glosses": [
                                            "fünfunddreißig Jahre (alt)"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24df7973-af97-4b2f-bccd-016802218ae0",
                                                "sense_id": "661a912b-711b-397f-b7d2-f4fae138ae85",
                                                "text": "Nächstes Jahr werde ich fünfunddreißig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
