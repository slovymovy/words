                                        "sense_id": "0a83fdfc-1e07-3c12-aad5-f1c32470ac0d",
                                        "entry_id": "591a4a3f-b983-3004-a69c-28b08d129ed0",
                                        "glosses": [
                                            "een gebouw verdelen in meerdere goed van elkaar gescheiden ruimten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb7a701-922c-416f-930d-e9f6a3806d2a",
                                                "sense_id": "0a83fdfc-1e07-3c12-aad5-f1c32470ac0d",
                                                "text": "De brandweer wijst verder op het gebrek aan compartimentering in het gebouw. \"De brandbestrijding wordt daardoor fors belemmerd. In het geval van brand zal (een deel van) het complex verloren gaan.\""
                                            },
                                            {
                                                "example_id": "44c504d5-080d-46a0-bdf5-ca12a5e344d2",
                                                "sense_id": "0a83fdfc-1e07-3c12-aad5-f1c32470ac0d",
                                                "text": "Stallen van grote veehouderijen hebben vaak een ruimte met technische installaties of apparaten. Om in geval van brand te voorkomen dat het vuur overslaat naar de dierverblijven, wil de minister deze technische ruimtes van bestaande stallen in de toekomst verplicht omgeven met brandwerend materiaal dat de vlammen minstens een uur tegenhoudt (compartimentering)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d487ce1-8821-33d1-923b-6d935433a81f",
                                        "entry_id": "591a4a3f-b983-3004-a69c-28b08d129ed0",
                                        "glosses": [
                                            "de verbindingen in een landschap doorsnijden met een spoorbaan, weg of kanaal"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fd5cfdc-e8f7-3690-a1b0-452e7beddfe7",
                                        "entry_id": "591a4a3f-b983-3004-a69c-28b08d129ed0",
                                        "glosses": [
                                            "het niet of slecht met elkaar samenwerken van verschillende afdelingen binnen één bedrijf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69de946d-c20c-4d35-bd9b-4ec30b165fc5",
                                                "sense_id": "2fd5cfdc-e8f7-3690-a1b0-452e7beddfe7",
                                                "text": "De gruweldaden kwamen aanvankelijk niet aan het licht door een „cultuur van geheimhouding en compartimentering” waarbij informatie geheim werd gehouden binnen patrouillegroepen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
