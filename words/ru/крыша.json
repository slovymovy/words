{
    "word_family": [
        "крышка",
        "крышечка",
        "крытый",
        "покрышка",
        "покрывало",
        "покрывать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a1075db-c493-3cb2-9ce7-2c1b26f009d3",
                    "sense_definition": "Верхняя ограждающая конструкция здания или транспортного средства, защищающая от осадков.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "roof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой на <w>крыше</w> лежит снег.",
                            "target_lang_translations": {
                                "fr": "En hiver, il y a de la neige sur le <w>toit</w>."
                            }
                        },
                        {
                            "text": "Дождь стучит по <w>крыше</w> машины.",
                            "target_lang_translations": {
                                "fr": "La pluie crépite sur le <w>toit</w> de la voiture."
                            }
                        }
                    ],
                    "synonyms": [
                        "кровля"
                    ],
                    "common_phrases": [
                        "под крышей"
                    ],
                    "target_lang_definitions": {
                        "fr": "Ouvrage qui couvre un bâtiment ou un véhicule pour le protéger des intempéries."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "toit",
                                "target_lang_sense_clarification": "d'un bâtiment ou d'un véhicule"
                            },
                            {
                                "target_lang_word": "toiture",
                                "target_lang_sense_clarification": "ensemble de la couverture d'un bâtiment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e41926f-3bd3-34b9-b20f-ddfd87a55671",
                    "sense_definition": "Жилище или дом как место для проживания.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "home",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я за всю жизнь не заработал ни земли, ни собственной <w>крыши</w> над головой.",
                            "target_lang_translations": {
                                "fr": "De toute ma vie, je n'ai gagné ni terre, ni mon propre <w>toit</w> sur la tête."
                            }
                        },
                        {
                            "text": "После наводнения сотни семей остались без <w>крыши</w> над головой.",
                            "target_lang_translations": {
                                "fr": "Après l'inondation, des centaines de familles se sont retrouvées sans <w>toit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "кров",
                        "дом"
                    ],
                    "common_phrases": [
                        "крыша над головой"
                    ],
                    "target_lang_definitions": {
                        "fr": "Logement, foyer ou abri où l'on réside."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "toit",
                                "target_lang_sense_clarification": "au sens figuré, foyer ou logement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e83ac5-eca4-3977-8fee-904b96fde98a",
                    "sense_definition": "Группировка или структура, обеспечивающая кому-либо защиту и покровительство.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждая преступная группировка стремится стать <w>крышей</w> для коммерческих структур.",
                            "target_lang_translations": {
                                "fr": "Chaque groupe criminel cherche à servir de <w>protection</w> aux structures commerciales."
                            }
                        },
                        {
                            "text": "Бандиты требовали денег за свою <w>крышу</w>.",
                            "target_lang_translations": {
                                "fr": "Les bandits réclamaient de l'argent pour leur <w>protection</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "прикрытие"
                    ],
                    "common_phrases": [
                        "бандитская крыша"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "криминальный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Groupe criminel ou autorité assurant la protection et le parrainage illégal d'une entreprise ou d'une personne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "protection",
                                "target_lang_sense_clarification": "racket de protection ou parrainage mafieux"
                            },
                            {
                                "target_lang_word": "couverture",
                                "target_lang_sense_clarification": "paravent, protection occulte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef0335e7-4807-33a7-9cf3-7552e6befdb7",
                    "sense_definition": "Голова или рассудок человека.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У неё нервы разбиты, <w>крыша</w> совсем не в порядке.",
                            "target_lang_translations": {
                                "fr": "Elle a les nerfs à vif, elle ne tourne pas rond de la <w>tête</w>."
                            }
                        },
                        {
                            "text": "От таких новостей у любого человека может поехать <w>крыша</w>.",
                            "target_lang_translations": {
                                "fr": "Avec de telles nouvelles, n'importe qui pourrait <w>perdre la tête</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "крыша едет",
                        "крыша не в порядке"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "разговорный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Tête, esprit ou équilibre mental d'une personne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tête",
                                "target_lang_sense_clarification": "dans les expressions signifiant perdre la raison"
                            },
                            {
                                "target_lang_word": "boulon",
                                "target_lang_sense_clarification": "dans le sens familier de perdre la raison"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}