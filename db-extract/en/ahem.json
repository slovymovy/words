                        "entry_id": "d3487b2b-6783-3d93-b229-d9bfb6446cff",
                        "glosses": [
                            "Expresses disapproval or annoyance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f575d5ad-72a7-4ac2-87e2-7c42412759da",
                                "sense_id": "ba3e1644-0f63-3cb3-b871-d5a8b16a23e0",
                                "text": "Ahem! In case you didn't notice, I did my share of the work, too."
                            }
                        ]
