                        "sense_id": "93877134-f94b-3598-8e5d-e075b01ae265",
                        "entry_id": "62afb052-cf2b-341c-80f0-1c79e6209087",
                        "glosses": [
                            "Enduring; persistent, resistant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "199136a3-a6bf-44cf-acbe-faead4cc1e4f",
                                "sense_id": "93877134-f94b-3598-8e5d-e075b01ae265",
                                "text": "He was clumsy and struggling but perseverant, determined to accomplish the task he had set himself, and his keenness affronted Crystal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "425d071d-c755-4ff8-9085-2d263cf3a55c",
                        "source_entry_id": "62afb052-cf2b-341c-80f0-1c79e6209087",
                        "source_sense_id": "93877134-f94b-3598-8e5d-e075b01ae265",
                        "source_sense_description": "enduring",
                        "target_lang_word": "beharrlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beharrlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                        "entry_id": "7bb60b0e-cb7f-35ee-9f63-7fb33c1c9888",
                                        "glosses": [
                                            "mit Ausdauer um etwas bemüht oder an etwas festhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69bf6e76-0de5-4fad-8537-9092a1960011",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "Der mutmaßliche Täter schweigt beharrlich."
                                            },
                                            {
                                                "example_id": "20e62fb0-7ad5-484c-a0b4-d0d59a40b026",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "Seid beharrlich im Gebet und wacht in ihm mit Danksagung."
                                            },
                                            {
                                                "example_id": "8d46dbab-38d6-461d-b93d-dcdb379aaea2",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "„Die beharrliche Strategie des Quintus Fabius Maximus, die Siege des Marcus Claudius Marcellus in Sizilien, die Erfolge des Publius Cornelius Scipio in Hispanien und das militärische Geschick des Marcus Livius Salinator und Gaius Claudius Nero in Italien brachten den immer noch unbesiegten Hannibal in Bedrängnis und zwangen ihn, aus Italien abzuziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3bbcb9e-4cb0-4846-9722-29e9acf20074",
                        "source_entry_id": "62afb052-cf2b-341c-80f0-1c79e6209087",
                        "source_sense_id": "93877134-f94b-3598-8e5d-e075b01ae265",
                        "source_sense_description": "enduring",
                        "target_lang_word": "настойчивый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "настойчивый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9360e599-b56f-378d-afec-31c79b1c668b",
                                        "entry_id": "402e9223-d276-3e6b-9cb9-191736d3cdd7",
                                        "glosses": [
                                            "упорный, твёрдый в достижении какой-либо цели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4586aa05-5d5b-4c9f-a688-8083d0f4e21a",
                                                "sense_id": "9360e599-b56f-378d-afec-31c79b1c668b",
                                                "text": "Г-жа Ельцова была женщина очень странная, с характером, настойчивая и сосредоточенная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b29c6ffa-9455-3681-b197-23727a7e4d92",
                                        "entry_id": "402e9223-d276-3e6b-9cb9-191736d3cdd7",
                                        "glosses": [
                                            "перен. неотступный, упорный; назойливый, навязчивый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322e5fa8-f887-4c93-bac1-e79b719f596d",
                                                "sense_id": "b29c6ffa-9455-3681-b197-23727a7e4d92",
                                                "text": "Настойчивая мысль о том, что я сумасшедший, вызывала и сумасшедшие желания, а как только я выполнил их, оказалось, что и желаний-то никаких нет, и я не безумный."
                                            },
                                            {
                                                "example_id": "9f41965a-2ea5-4eb0-876c-5aa1e4fe5153",
                                                "sense_id": "b29c6ffa-9455-3681-b197-23727a7e4d92",
                                                "text": "Щенок как будто не слыхал; он глядел в сторону и дрожал всё той же настойчивой и мучительной дрожью, на которую холодно было смотреть."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
