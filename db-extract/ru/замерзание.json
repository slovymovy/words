                "translations": [
                    {
                        "translation_id": "501c467a-f7cb-4c38-a25c-1fe22ef0e154",
                        "source_entry_id": "68112a49-365c-3727-b411-ed4382cd55a2",
                        "target_lang_word": "congélation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "congélation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                        "entry_id": "a660b510-edde-3c0f-ac7e-2c9e08e45929",
                                        "glosses": [
                                            "Action de congeler ou de se congeler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e231e8-51e7-4b25-ba07-a2bf3dfbf58d",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "On sait que la congélation s'opère par la partie supérieure des liquides; puis, si le froid persévère, l'épaisseur de la carapace solide s'accroît en allant de haut en bas. Du moins, il en est ainsi pour les eaux tranquilles."
                                            },
                                            {
                                                "example_id": "7782fe60-3490-42e1-93c0-c9bbfcdf3323",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "Une conservation prolongée exigera la congélation, qui s'opère à des températures allant jusqu'à - 12 °. C'est une opération qui ne pourra se faire qu'au frigo même."
                                            },
                                            {
                                                "example_id": "bcd4e6ce-bc7f-493e-8e69-f75fa90ab240",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "Jusqu’ici, une femme ne pouvait avoir recours à la congélation de ses propres ovocytes, sauf nécessité médicale."
                                            },
                                            {
                                                "example_id": "80b30590-9923-41fd-86cd-9b248cd49333",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "Pour comprendre la portée de cette découverte, cerner les travaux de Greg Fahy, cryobiologiste issu de l'université de Californie, inventeur de la congélation de tissus sans détérioration et plus grand spécialiste mondial de la vitrification, est essentiel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c120b03-d7ea-3211-838a-c59ecb77d484",
                                        "entry_id": "a660b510-edde-3c0f-ac7e-2c9e08e45929",
                                        "glosses": [
                                            "Mortification des parties vivantes par l’effet du froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "077684db-8258-4969-8689-b2bf416f86da",
                                                "sense_id": "1c120b03-d7ea-3211-838a-c59ecb77d484",
                                                "text": "Plusieurs des hôtes du fort se laissèrent prendre de congélation subite, entre autres Garry, Belcher, Hope; mais, frictionnés à temps, ils échappèrent au danger."
                                            },
                                            {
                                                "example_id": "14485db6-a91b-4f79-98e7-5e2f7997bf88",
                                                "sense_id": "1c120b03-d7ea-3211-838a-c59ecb77d484",
                                                "text": "- Et tout en me faisant ces réflexions qu'entretenait ma congélation croissante, je pensais à un escabeau que j'avais remarqué dans la cheminée de la cuisine, et sur lequel, au moment où j'avais quitté l'auberge, s'épanouissait, à quarante cinq degrés de chaleur, un énorme chat de gouttière dont j'avais admiré l'incombustibilité, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db6cf413-8019-47ac-bc35-bb146944083b",
                        "source_entry_id": "68112a49-365c-3727-b411-ed4382cd55a2",
                        "target_lang_word": "gel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff41eaeb-d9f4-3616-b036-672b88f18a3e",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Solidification de l’eau en glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2487558c-78b8-42e8-86ea-a9c39093e6a5",
                                                "sense_id": "ff41eaeb-d9f4-3616-b036-672b88f18a3e",
                                                "text": "L’ombre et le gel habitent la chambre où les colchiques mauves s’épanouissaient, en automne, dans le vase que tu m’as donné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f380491-fa3d-34e6-b045-1adc9bb424a2",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Température en dessous de zéro degré Celsius."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac2b2daf-cd08-4768-9434-66d2ad283152",
                                                "sense_id": "9f380491-fa3d-34e6-b045-1adc9bb424a2",
                                                "text": "Confirmant les observations déjà réalisées sur la coupe de Ménil-Lépinois, les blocs crayeux, en surface comme sur toute la profondeur de pénétration du gel (10 à 12 cm), sont entourés d'une enveloppe de glace de cryosuccion."
                                            },
                                            {
                                                "example_id": "386f0451-56c4-47b2-b4ea-402266a2ff95",
                                                "sense_id": "9f380491-fa3d-34e6-b045-1adc9bb424a2",
                                                "text": "Le gel a détruit la récolte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e4e7ac-8ee8-36fe-bc5a-a78a4ecfa161",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Solution colloïdale qui est surtout liquide paraissant un solide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2686717e-cd56-454a-8c2c-754c7d8724a7",
                                                "sense_id": "f5e4e7ac-8ee8-36fe-bc5a-a78a4ecfa161",
                                                "text": "La gélatine est un gel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Arrêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ab4bec-ca48-4fc9-9db1-6932b5eef4d9",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Le gel des salaires."
                                            },
                                            {
                                                "example_id": "e2a06cf8-4792-421d-b8ec-f8339eb37454",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Le gel des relations diplomatiques entre l’Iran et les États-Unis."
                                            },
                                            {
                                                "example_id": "de95722e-154d-4e82-8e3f-b543e95c890c",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Au début de juillet, le conseil d’administration a également annoncé dans un courriel interne un gel des adhésions, dénoncé une « action de dénigrement et de déstabilisation » de l’association, et menacé des wikipédiens de poursuites judiciaires."
                                            },
                                            {
                                                "example_id": "4ba91518-0e92-4091-8b2e-35849134b1c4",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Le ministère britannique des Affaires étrangères impose également un gel des avoirs à trois généraux de l’armée birmane, à qui elle interdit également de venir sur son sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9406b9b9-8de1-3ebe-8a87-bf3edf07a97e",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Gel permettant de fixer les cheveux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
