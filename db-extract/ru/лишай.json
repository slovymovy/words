                "senses": [
                    {
                        "sense_id": "ff3e2696-f229-3c3f-972b-d617df52416e",
                        "entry_id": "f86b2642-de03-3fe3-931a-fda42d4aaf2f",
                        "glosses": [
                            "общее название нескольких видов заболевания кожи"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c344cf2b-7f40-3be0-b90b-51532ed8a91c",
                        "entry_id": "f86b2642-de03-3fe3-931a-fda42d4aaf2f",
                        "glosses": [
                            "прост. то же, что лишайник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc1974f-86ab-4f9c-90f7-50a9e0b1dbc4",
                                "sense_id": "c344cf2b-7f40-3be0-b90b-51532ed8a91c",
                                "text": "Таким бывает снег в Хибинах, когда на него к весне ложится плесень лишаёв."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37149c2e-13d1-41b2-98e3-15d149344568",
                        "source_entry_id": "f86b2642-de03-3fe3-931a-fda42d4aaf2f",
                        "source_sense_description": "заболевание кожи",
                        "target_lang_word": "lichen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lichen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a1f07d0-34d2-3471-a92a-5b44e9b45adb",
                                        "entry_id": "8d90b668-cac6-3bd9-861a-8a3696e89046",
                                        "glosses": [
                                            "Any of many symbiotic organisms, being associations of algae and fungi, often found as white or yellow-to-blue–green patches on rocks, old walls, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15afdd01-bdb0-48b6-81ec-ec839a6cdb5e",
                                                "sense_id": "8a1f07d0-34d2-3471-a92a-5b44e9b45adb",
                                                "text": "The Beaches of Lukannon–the winter wheat so tall, / The dripping, crinkled lichens, and the sea-fog drenching all!"
                                            },
                                            {
                                                "example_id": "82f55c00-7650-4a88-899c-eb7a79685614",
                                                "sense_id": "8a1f07d0-34d2-3471-a92a-5b44e9b45adb",
                                                "text": "It was the same rich green that one sees on forest moss or on the lichen in caves: plants which like these grow in a perpetual twilight."
                                            },
                                            {
                                                "example_id": "6d746c00-cb94-4c63-bd65-abf81502211a",
                                                "sense_id": "8a1f07d0-34d2-3471-a92a-5b44e9b45adb",
                                                "text": "The nibble marks of the stone adze were still visible, though crusted over with scale lichens in most places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "673a08f6-6ab7-3f63-a969-21063452b957",
                                        "entry_id": "8d90b668-cac6-3bd9-861a-8a3696e89046",
                                        "glosses": [
                                            "Something which gradually spreads across something else, causing damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83db9c35-17e6-4c64-b8a7-c2403091b640",
                                                "sense_id": "673a08f6-6ab7-3f63-a969-21063452b957",
                                                "text": "Meanwhile, abiding a day of judgment, she fought ceaselessly to deny the bitter drops in her cup, to tear back the slow, the intangibly slow growth of a hot, corrosive lichen eating into her heart."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lichen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4091f4-8d8f-35d4-bb17-1a1f7af9e437",
                                        "entry_id": "6fadbdca-ef16-302a-847d-cd160c05586f",
                                        "glosses": [
                                            "To cover with lichen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb503635-c7c9-475e-bec8-209ff9d3a378",
                                                "sense_id": "9e4091f4-8d8f-35d4-bb17-1a1f7af9e437",
                                                "text": "[…] making the rocks assume the mould of age and lichening the trees with damp beauty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2694bd8d-1c28-4fce-bbc4-816e00316924",
                        "source_entry_id": "f86b2642-de03-3fe3-931a-fda42d4aaf2f",
                        "source_sense_description": "заболевание кожи",
                        "target_lang_word": "tinea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tinea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dad00841-6ccd-301d-9b68-06b36f9dd33f",
                                        "entry_id": "7989d346-4570-31ff-bd37-0706a8b7cc43",
                                        "glosses": [
                                            "A fungal infection of the skin, known generally as ringworm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9fb1ad9-40ea-4417-a53e-516e8a8c7f10",
                                                "sense_id": "dad00841-6ccd-301d-9b68-06b36f9dd33f",
                                                "text": "Her knees were ingrained with dirt, her toes raw with tinea, her fingernails black and broken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "930eea4b-32f9-4ce0-bb84-952c8d6d7532",
                        "source_entry_id": "f86b2642-de03-3fe3-931a-fda42d4aaf2f",
                        "source_sense_description": "заболевание кожи",
                        "target_lang_word": "ringworm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ringworm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0179000e-d89b-36be-9c7f-6e80aaeca2dd",
                                        "entry_id": "735f20f8-4954-3a1a-bc72-d76c436a3b9e",
                                        "glosses": [
                                            "A contagious fungal infection of the skin, characterized by ring-shaped discolored patches, covered by vesicles or scales."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11c38bc-6256-495c-9103-7906e8abc28d",
                                                "sense_id": "0179000e-d89b-36be-9c7f-6e80aaeca2dd",
                                                "text": "In superficial mycoses infection is localised to the skin, the hair, and the nails. An example is ringworm or tinea, an infection of the skin by a dermatophyte."
                                            },
                                            {
                                                "example_id": "e8a8955d-aa06-4d2e-ab9a-10ab710194ca",
                                                "sense_id": "0179000e-d89b-36be-9c7f-6e80aaeca2dd",
                                                "text": "Many of these natives, especially the lower classes, and fishermen, have their skins disfigured in a singular manner, by a sort of scurfy disease, similar to the ring-worm, or rather to a person whose skin was peeling off from the effects of the sun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b47516a9-a37c-46a8-b355-239e85d5e821",
                        "source_entry_id": "f86b2642-de03-3fe3-931a-fda42d4aaf2f",
                        "source_sense_description": "заболевание кожи",
                        "target_lang_word": "herpes",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herpes",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25cb07db-b806-3727-84c6-0d9f59b13a99",
                                        "entry_id": "09622811-41f5-3459-962a-45abe70a5cd4",
                                        "glosses": [
                                            "A viral infection, caused by Human alphaherpesvirus 1 and Human alphaherpesvirus 2, marked by painful, watery blisters in the skin or in the mucous membranes or on the genitals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a35e2a-1bbc-4dc7-9c34-7bb2b81a1637",
                                                "sense_id": "25cb07db-b806-3727-84c6-0d9f59b13a99",
                                                "text": "This, of course, is something only people with that STI would know. For example, herpes is 437737."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
