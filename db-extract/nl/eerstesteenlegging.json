                        "examples": [
                            {
                                "example_id": "1842b002-ad96-49cd-ba26-0dcf74424b03",
                                "sense_id": "91753d24-7439-3b60-9c8b-d6905c698ff3",
                                "text": "Nieuwe hofjesprojecten worden met open armen ontvangen door de gemeente Rijssen-Holten. Dat zei wethouder Erik Wessels vrijdagmiddag bij de eerstesteenlegging voor het complex Noaberhof Op ’n Esch aan de Wilhelminastraat."
                            },
                            {
                                "example_id": "9a363293-7dd0-4d3c-8f13-695d471abf15",
                                "sense_id": "91753d24-7439-3b60-9c8b-d6905c698ff3",
                                "text": "De woontoren is 187 meter hoog en is Spanjes vijfde hoogste bouwwerk. Het Spaanse vakantieoord telt nu 27 flatgebouwen die hoger zijn dan 100 meter. Dat het zo lang geduurd heeft vooraleer het project klaar was, heeft alles te maken met de zware vastgoedcrisis die Spanje in 2008 trof, twee jaar na de eerstesteenlegging."
                            }
                        ]
                    }
