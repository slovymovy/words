                    {
                        "sense_id": "a3464086-8673-3a21-b3fe-f478936d828e",
                        "entry_id": "8835400f-34f8-37b5-926f-6bb61c8695b5",
                        "glosses": [
                            "Zusammenschluss von Menschen zur Förderung der körperlichen Betätigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a8d220-3453-47ae-9b13-bc937c5f2538",
                                "sense_id": "a3464086-8673-3a21-b3fe-f478936d828e",
                                "text": "Unser Sportverein bietet 12 verschiedene Sparten der sportlichen Betätigung."
                            },
                            {
                                "example_id": "276c9165-d150-495b-9f97-711627ab1e35",
                                "sense_id": "a3464086-8673-3a21-b3fe-f478936d828e",
                                "text": "„Zwar mischt sich, etwa mit der ungarischen Schachspielerin Judith Polgar oder Ex-Schwimmvizeweltmeister Maxim Podoprigora, vereinzelt Prominenz unter die Teilnehmer – die überwiegende Mehrheit sind jedoch Hobbysportler, die von jüdischen Sportvereinen in der ganzen Welt entsandt werden (am größten ist die britische Mannschaft, gefolgt von der deutschen und der österreichischen), ein Teilnehmer kommt aus Guinea-Bissau, ein anderer aus Gibraltar.“"
                            },
                            {
                                "example_id": "85f6a700-1e7a-4958-af02-62b08d89beae",
                                "sense_id": "a3464086-8673-3a21-b3fe-f478936d828e",
                                "text": "„Sie trug eine weiße Regenjacke und eine schwarze Mütze mit dem Logo des Sportvereins von Akranes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
