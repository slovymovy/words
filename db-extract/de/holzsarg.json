                "senses": [
                    {
                        "sense_id": "3f2ac7ab-bcc7-358f-98c7-e0ad6cd2dffa",
                        "entry_id": "ef4a5cd1-d0bf-3455-b356-e3b3eee789c8",
                        "glosses": [
                            "längliches, kastenförmiges und hölzernes Behältnis mit Deckel, in das ein Leichnam gelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c632d7ab-ce09-49cf-aa62-f8bd9e520212",
                                "sense_id": "3f2ac7ab-bcc7-358f-98c7-e0ad6cd2dffa",
                                "text": "„Nahezu alle Metallsärge beinhalten einen Holzsarg mit dem jeweiligen Leichnam. Ausnahmen bilden die Särge von Maria Elisabeth und Maria Anna, bei denen die Toten direkt in den Übersarg gebettet wurden. Der innere Holzsarg wurde üblicherweise bei der Bestattung mit zwei unterschiedlichen Schlössern versperrt.“"
                            },
                            {
                                "example_id": "15c67fb6-aad5-4d25-b2da-a31aafa75d96",
                                "sense_id": "3f2ac7ab-bcc7-358f-98c7-e0ad6cd2dffa",
                                "text": "„In der Werkstätte von Restaurator Thomas Frankl geht es nun darum, die Holzsärge von Schimmel zu reinigen, die Substanz zu erhalten und die Bemalungen und Beschläge zu konservieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
