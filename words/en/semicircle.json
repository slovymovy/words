                    "frequency": "Middle",
                    "semantic_group_id": "geometric shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students arranged their chairs in a <w>semicircle</w> around the teacher."
                        },
                        {
                            "text": "She drew a perfect <w>semicircle</w> on the paper using a compass."
                        }
                    ],
                    "common_phrases": [
