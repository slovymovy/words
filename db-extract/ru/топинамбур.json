                                        "glosses": [
                                            "bepaald soort zonnebloem, Helianthus tuberosus, die als vaste plant wordt gekweekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "549c952e-c3dd-4783-bd4c-abe06c1e34cc",
                                                "sense_id": "dff02c4a-8cba-3e83-b6fb-5b65b0f0a09f",
                                                "text": "Ik kijk uit op een van de twee moestuinen. De aardperen staan bijna in bloei, de lathyrus ook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ae3a053-6178-3a38-a0a2-4bf8b2093bb9",
                                        "entry_id": "df13eb15-2e12-31cc-b25c-305cf992c14c",
                                        "glosses": [
                                            "eetbare knol van die plant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80215c2-c2c7-434c-b11b-f7df9af3c7c9",
                                                "sense_id": "3ae3a053-6178-3a38-a0a2-4bf8b2093bb9",
                                                "text": "Wat Mosley zelf eet? Opvallend is dat hij peulvruchten, aardpeer, prei en knoflook bovenaan zijn lijstje darmvriendelijke voedingsvezels (prebiotica) heeft staan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
