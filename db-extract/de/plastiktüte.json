                        ],
                        "form": "die Plastiktüten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcd70e9e-cdc3-3d26-87d9-b804c3de6b84",
                        "entry_id": "fa9850e4-f358-392f-98a2-ccc359a388c4",
                        "glosses": [
                            "dünner Beutel aus Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5558a1e5-844a-46d0-a92d-e6e1f9d9dfcb",
                                "sense_id": "dcd70e9e-cdc3-3d26-87d9-b804c3de6b84",
                                "text": "Plastiktüten sind zwar praktisch, aber auch ein großes Problem für die Umwelt."
                            },
                            {
                                "example_id": "1b08c6f7-ade1-4ec8-acc6-73e45b3d888c",
                                "sense_id": "dcd70e9e-cdc3-3d26-87d9-b804c3de6b84",
                                "text": "„Frau Hings packte den Inhalt einer Plastiktüte wieder aus.“"
                            },
                            {
                                "example_id": "07de77d7-f868-4d0a-9ec6-4cf5545427f4",
                                "sense_id": "dcd70e9e-cdc3-3d26-87d9-b804c3de6b84",
                                "text": "„Er wartete, bis Mrs Pound ihr Büro verlassen hatte, packte dann seine Sachen in eine Plastiktüte und verließ das Gebäude durch die Seitentür des Verwaltungstrakts.“"
                            },
                            {
                                "example_id": "36f31e71-24e9-4643-b950-d6bde972a17e",
                                "sense_id": "dcd70e9e-cdc3-3d26-87d9-b804c3de6b84",
                                "text": "„Er reichte mir die Plastiktüte.“"
                            },
                            {
                                "example_id": "c22670ff-873a-4d29-b51e-f3dfd91f02f9",
                                "sense_id": "dcd70e9e-cdc3-3d26-87d9-b804c3de6b84",
                                "text": "„Er zog seine Jacke zu und legte sich eine Plastiktüte auf den Kopf.“"
                            },
                            {
                                "example_id": "72e28967-481a-43fb-9952-fbd7d384565a",
                                "sense_id": "dcd70e9e-cdc3-3d26-87d9-b804c3de6b84",
                                "text": "„Und es ist auch irgendwie peinlich, wenn man mit einem zappelnden, greinenden Jesuskindlein auf dem Arm aus dem Laden kommt und versucht, ihn in seiner Plastiktüte stillzuhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
