                                        "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                        "entry_id": "6ead9c68-ba3c-3a2f-80f5-af62495bfdc0",
                                        "glosses": [
                                            "das über einen längeren Zeitraum andauernde Einführen von Flüssigkeit in den Körper, dies meist intravenös, aber auch intraossär, intraarteriell, subkutan oder rektal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ea4689-8c0b-44b3-8081-c93192dd243e",
                                                "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                                "text": "Er brauchte eine Infusion."
                                            },
                                            {
                                                "example_id": "91f3fae5-ba71-40f0-b0b4-571fb4a09025",
                                                "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                                "text": "„An einen Metallgalgen wurde eine Infusion eingehängt und mit dem Katheter verbunden.“"
                                            },
                                            {
                                                "example_id": "9f25997c-8e1c-404b-80b4-124426a54229",
                                                "sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                                                "text": "„Im Krankenhaus wurde Roth mithilfe von Sauerstoff und einer Infusion stabilisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
