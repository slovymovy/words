{
    "word_family": [
        "include",
        "inclusion",
        "inclusive",
        "inclusively",
        "inclusiveness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9b9f6c5-52c7-3fe8-9a0f-022bbf05015f",
                    "sense_definition": "Simple past and past participle of <w>include</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tour price <w>included</w> lunch and all entrance fees.",
                            "target_lang_translations": {
                                "ru": "В стоимость тура <w>входили</w> обед и все входные билеты.",
                                "zh": "旅游价格<w>包括</w>午餐和所有门票费用。"
                            }
                        },
                        {
                            "text": "She <w>included</w> a handwritten note with the package.",
                            "target_lang_translations": {
                                "ru": "Она <w>вложила</w> в посылку записку, написанную от руки.",
                                "zh": "她在包裹里<w>放入</w>了一张手写的便条。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contained",
                        "comprised",
                        "involved"
                    ],
                    "antonyms": [
                        "excluded",
                        "omitted"
                    ],
                    "common_phrases": [
                        "included in",
                        "included among"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола include.",
                        "zh": "动词 include 的过去式和过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включал",
                                "target_lang_sense_clarification": "содержал в себе"
                            },
                            {
                                "target_lang_word": "включил",
                                "target_lang_sense_clarification": "добавил в состав"
                            },
                            {
                                "target_lang_word": "включённый",
                                "target_lang_sense_clarification": "добавленный внутрь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包括",
                                "target_lang_sense_clarification": "包含在内"
                            },
                            {
                                "target_lang_word": "包含",
                                "target_lang_sense_clarification": "作为一部分存在"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7c6d297b-1f14-39eb-b8f0-9570b687ee2a",
                    "sense_definition": "Provided as an accompaniment or part of a whole set.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the <w>included</w> leaflet for instructions.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочтите <w>прилагаемую</w> брошюру для получения инструкций.",
                                "zh": "请阅读<w>附带的</w>传单以获取说明。"
                            }
                        },
                        {
                            "text": "Breakfast is <w>included</w> in the room rate.",
                            "target_lang_translations": {
                                "ru": "Завтрак <w>включён</w> в стоимость номера.",
                                "zh": "房费中<w>包含</w>早餐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enclosed",
                        "accompanying",
                        "attached"
                    ],
                    "antonyms": [
                        "excluded",
                        "separate",
                        "missing"
                    ],
                    "common_phrases": [
                        "included in the price",
                        "batteries included",
                        "service included"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставляемый как дополнение или часть целого набора.",
                        "zh": "作为配套或整体的一部分提供。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включённый",
                                "target_lang_sense_clarification": "входящий в состав или стоимость"
                            },
                            {
                                "target_lang_word": "прилагаемый",
                                "target_lang_sense_clarification": "идущий в комплекте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包含在内的",
                                "target_lang_sense_clarification": "作为整体的一部分"
                            },
                            {
                                "target_lang_word": "附带的",
                                "target_lang_sense_clarification": "随同提供的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55b18508-3ac1-35ea-8b0e-bb4b96f17d4f",
                    "sense_definition": "Enclosed within something else and not protruding, often used in botany to describe plant parts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flower is characterized by its <w>included</w> stamens that do not extend beyond the petals.",
                            "target_lang_translations": {
                                "ru": "Этот цветок характеризуется <w>невыступающими</w> тычинками, которые не выходят за пределы лепестков.",
                                "zh": "这种花的特点是其<w>内藏的</w>雄蕊，它们不会伸出花瓣之外。"
                            }
                        },
                        {
                            "text": "This species has <w>included</w> reproductive organs hidden within the tube.",
                            "target_lang_translations": {
                                "ru": "У этого вида имеются <w>скрытые</w> органы размножения, спрятанные внутри трубки.",
                                "zh": "该物种的生殖器官<w>隐藏</w>在管内。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enclosed"
                    ],
                    "antonyms": [
                        "protruding"
                    ],
                    "common_phrases": [
                        "included stamens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключённый внутри чего-либо и не выступающий наружу (часто используется в ботанике).",
                        "zh": "被包裹在某物内部而不突出，常用于植物学描述植物器官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невыступающий",
                                "target_lang_sense_clarification": "находящийся в пределах околоцветника (бот.)"
                            },
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "находящийся внутри"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内藏的",
                                "target_lang_sense_clarification": "植物学中指不伸出花冠的"
                            },
                            {
                                "target_lang_word": "隐蔽的",
                                "target_lang_sense_clarification": "被遮盖在内部的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}