                "entry_id": "6e5c3180-3972-320b-9cdc-62ac985f7450",
                "word": "briquette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a00a870-1450-45ad-a277-07842d2da8d2",
                        "entry_id": "6e5c3180-3972-320b-9cdc-62ac985f7450",
                        "tags": [
                            "plural"
