                                    {
                                        "sense_id": "b9039bee-2472-311c-b3c2-a86df776c277",
                                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                                        "glosses": [
                                            "grobe, ruppige, wenig feinfühlige Art"
