                                    {
                                        "sense_id": "47f7ea31-2c8a-3e0f-8ed7-a271daab6dc5",
                                        "entry_id": "4cde1507-ff54-3a3f-96a6-74b9c87ce05b",
                                        "glosses": [
                                            "Simple, honest speaking."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4c47e7b-a5ef-4e69-87aa-ee0f1b9cf540",
                                                "sense_id": "47f7ea31-2c8a-3e0f-8ed7-a271daab6dc5",
                                                "text": "\"I asked for straight talk, and thou hast given me sweet talk.\""
                                            },
                                            {
                                                "example_id": "a281724c-000b-4595-bda4-94d4c738a057",
                                                "sense_id": "47f7ea31-2c8a-3e0f-8ed7-a271daab6dc5",
                                                "text": "\"Tell him to go back to Durango and forget the foolish girl. […]\"\n\"All right. That is straight talk, like an Indian's."
                                            },
                                            {
                                                "example_id": "80f324ab-a41b-4489-9a94-b26c8b46f98c",
                                                "sense_id": "47f7ea31-2c8a-3e0f-8ed7-a271daab6dc5",
                                                "text": "[H]e told voters in the economically ravaged state that lost auto-industry jobs \"aren't coming back,\" a dose of undiluted straight talk that probably cemented his loss there."
                                            }
                                        ]
                                    }
                                ]
                            }
