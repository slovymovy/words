                    "frequency": "Middle",
                    "semantic_group_id": "gravite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président s'est exprimé avec une grande <w>solennité</w> devant les députés réunis."
                        },
                        {
                            "text": "Un silence respectueux régnait dans la salle, ajoutant à la <w>solennité</w> de l'instant."
                        }
                    ],
                    "synonyms": [
