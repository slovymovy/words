                        "source_sense_id": "1e009124-2391-3e35-a4f2-f4e1e1d19543",
                        "target_lang_word": "sadducéen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadducéen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb25a21-316f-37e8-8c92-44833bd943f2",
                                        "entry_id": "98ba3c79-012c-377c-8b28-b71024f4aca8",
                                        "glosses": [
                                            "Membre d’un des quatre grands courants du judaïsme de l’ancienne Judée avec les pharisiens, les esséniens et les zélotes."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be4c200-8c9d-4432-bc0f-5e46d38a6fa2",
                                                "sense_id": "6bb25a21-316f-37e8-8c92-44833bd943f2",
                                                "text": "Je vis le sadducéen serrer le poing, relever la tête pour tenter une réponse, mais son visage se renfrogna et il garda le silence."
                                            },
                                            {
                                                "example_id": "1fbd8158-bcf2-4bac-9d76-ea783d32026d",
                                                "sense_id": "6bb25a21-316f-37e8-8c92-44833bd943f2",
                                                "text": "C’étaient des Sadducéens et des Pharisiens que la même ambition poussait à Machaerous, les premiers voulant obtenir la sacrificature, et les autres la conserver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sadducéen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b808b9a8-108e-36bd-8a9e-804875acbb6b",
                                        "entry_id": "15bc272c-012a-3a2e-8c35-a6b0bb59dbc2",
                                        "glosses": [
                                            "Relatif à ce courant religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f3af32-b591-46fe-9e24-e48e33b79371",
                                                "sense_id": "b808b9a8-108e-36bd-8a9e-804875acbb6b",
                                                "text": "Ce sont là des illusions, Rébecca, reprit le templier, de vagues rêveries que rejettent même tes sages sadducéens."
                                            },
                                            {
                                                "example_id": "f28abdf0-ae31-41fc-8a79-587000b1a837",
                                                "sense_id": "b808b9a8-108e-36bd-8a9e-804875acbb6b",
                                                "text": "Jésus et les pharisiens, en réalité, s'entendaient bien, parce qu'ils aimaient et observaient la Loi, et leurs ennemis communs, après les Romains, étaient les collaborateurs sadducéens, prêtres arrogants et vendus, traîtres aussi bien à la nation qu'à la religions juives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
