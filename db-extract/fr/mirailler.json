                "senses": [
                    {
                        "sense_id": "0749df55-cea8-32f8-ada0-54f638b13de2",
                        "entry_id": "4808ff04-d725-3f0a-ac34-0b3b1fdd58ce",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c4b1170-f319-412f-901d-cb74fcd98e3c",
                                "sense_id": "0749df55-cea8-32f8-ada0-54f638b13de2",
                                "text": "À Castres, la semaine dernière, j’ai vu, de mes yeux vu, un groupe d’enfants de trente à quarante ans s’amuser follement à « mirailler » un garçon tailleur sur son balcon."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fe5c935-52d5-350a-9e18-374c46d0e1d6",
                        "entry_id": "4808ff04-d725-3f0a-ac34-0b3b1fdd58ce",
                        "glosses": [
                            "Briller, scintiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af0d84c-ef46-43f0-af95-0a18ad46af78",
                                "sense_id": "1fe5c935-52d5-350a-9e18-374c46d0e1d6",
                                "text": "À travers des massifs de trembles, de vergnes, des peupliers en file, entre les taches d’une verdure inégale, on voyait mirailler la rivière au pied des hauteurs et des rocs de Ribes."
                            }
                        ]
                    }
