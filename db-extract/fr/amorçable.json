                "senses": [
                    {
                        "sense_id": "1c72f0d9-48ec-3ec2-8686-bf2d0c620db0",
                        "entry_id": "f2d6a6a2-7bf5-3cf9-a353-ace588c31f46",
                        "glosses": [
                            "Qui peut ou doit être amorcé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad743f7-c47a-4b58-92ac-d23630a5db53",
                                "sense_id": "1c72f0d9-48ec-3ec2-8686-bf2d0c620db0",
                                "text": "Nous pouvons distinguer deux grands types de piles (tableau 3) :\n- les piles amorcées, les piles au sens commun du terme, c’est-à-dire prêtes à l’emploi ;\n- les piles amorçables, réservées à des applications spéciales. Comme leur appellation le laisse comprendre, ces dernières nécessitent une étape d’activation par le déclenchement d’un dispositif adapté."
                            },
                            {
                                "example_id": "d470fa84-cde1-44a7-89ce-3266c3a421dd",
                                "sense_id": "1c72f0d9-48ec-3ec2-8686-bf2d0c620db0",
                                "text": "Puis vient le tour des explosifs gels (1974), qui ne contiennent pas de nitroglycérine et sont amorçables au détonateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "b092d817-431a-30e1-b8e8-8f90c749865b",
                        "entry_id": "f2d6a6a2-7bf5-3cf9-a353-ace588c31f46",
                        "glosses": [
                            "Qui permet de démarrer un ordinateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90536bd3-ebda-4534-8da9-15576ddff4f7",
                                "sense_id": "b092d817-431a-30e1-b8e8-8f90c749865b",
                                "text": "Le fabricant de la carte mère peut fournir plusieurs manières de mettre à jour le BIOS, que ce soit depuis Windows ou sur un support amovible amorçable, comme une clé USB ou une disquette."
                            },
                            {
                                "example_id": "ef118bef-1791-48a2-b553-1fcfd7605214",
                                "sense_id": "b092d817-431a-30e1-b8e8-8f90c749865b",
                                "text": "Dépanner un Mac en le démarrant depuis une sauvegarde stockée sur un disque externe amorçable fera peut-être bientôt partie du passé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a81e8ca2-984c-44b1-b91e-8826ef3b7e91",
                        "source_entry_id": "f2d6a6a2-7bf5-3cf9-a353-ace588c31f46",
                        "source_sense_description": "sens informatique",
                        "target_lang_word": "bootfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bootfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                        "entry_id": "f5465343-cf5f-3da6-b663-854353997674",
                                        "glosses": [
                                            "in der Lage einen Bootvorgang durchzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f394fce6-8ff8-4c92-976f-868460c3bf97",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Greift das Windows-System und damit UltraISO auf den USB-Stick zu, lässt der sich mit diesem Werkzeug recht einfach bootfähig machen: Zuerst mit UltraISO das eben erstellte Speicherabbild der Windows-7-DVD öffnen, dann \"Schreibe Datenträger Abbild\" auswählen.“"
                                            },
                                            {
                                                "example_id": "039f0578-c68e-4637-baac-2ad034edcc6f",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Zu Beginn muss der USB-Stick soweit vorbereitet werden, dass der Computer nachher die Installationsdatei für das Betriebssystem darauf erkennt und ausführt – er muss bootfähig gemacht werden.“"
                                            },
                                            {
                                                "example_id": "0b95d15f-1bb9-4388-8209-21085ed9e777",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Der Standardweg um PC oder Notebook im Notfall, etwa nach einem Virenbefall oder bei einem Hardware-Defekt, zu starten ist es den USB-Stick bootfähig zu machen.“"
                                            },
                                            {
                                                "example_id": "bd2bd088-031d-4d03-8ce3-393f11e33795",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Wer USBs in Installationsdatenträger verwandeln oder zum Systemstart nutzen möchte, muss zuvor den USB Stick bootfähig machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
