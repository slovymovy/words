{
    "word_family": [
        "fluent",
        "fluency",
        "fluid"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a4709357-ad13-3d36-9571-946cc238809b",
                    "sense_definition": "In a smooth and easy manner, especially when speaking or writing a language.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has lived in France for years and now speaks French <w>fluently</w>.",
                            "target_lang_translations": {
                                "ru": "Она прожила во Франции много лет и теперь <w>бегло</w> говорит по-французски."
                            }
                        },
                        {
                            "text": "To get this job, you must be able to write and speak English <w>fluently</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы получить эту работу, вы должны уметь <w>свободно</w> писать и говорить по-английски."
                            }
                        }
                    ],
                    "synonyms": [
                        "effortlessly",
                        "smoothly"
                    ],
                    "antonyms": [
                        "haltingly"
                    ],
                    "common_phrases": [
                        "speak fluently",
                        "read fluently"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гладко и легко, особенно при общении на иностранном языке или при чтении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бе́гло",
                                "target_lang_sense_clarification": "используется для описания быстрой и уверенной речи или чтения"
                            },
                            {
                                "target_lang_word": "свобо́дно",
                                "target_lang_sense_clarification": "используется для описания владения языком без затруднений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5af427ce-9194-3cea-8f41-26fe354e6cfc",
                    "sense_definition": "In a graceful, smooth, or continuous manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer moved <w>fluently</w> across the stage during the performance.",
                            "target_lang_translations": {
                                "ru": "Танцор <w>плавно</w> перемещался по сцене во время выступления."
                            }
                        },
                        {
                            "text": "Her hands moved <w>fluently</w> as she played the piano piece.",
                            "target_lang_translations": {
                                "ru": "Её руки <w>плавно</w> двигались, когда она играла фортепианную пьесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "gracefully",
                        "fluidly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В грациозной, плавной или непрерывной манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пла́вно",
                                "target_lang_sense_clarification": "описывает движение без резких рывков"
                            },
                            {
                                "target_lang_word": "грацио́зно",
                                "target_lang_sense_clarification": "описывает изящные, красивые движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c58dbdfb-1b60-3257-852c-1275dbadbc9f",
                    "sense_definition": "In a manner that flows like a liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water was <w>fluently</w> pouring from the broken pipe into the street.",
                            "target_lang_translations": {
                                "ru": "Вода <w>непрерывно</w> лилась из сломанной трубы на улицу."
                            }
                        },
                        {
                            "text": "The ink was <w>fluently</w> leaking from the pen onto the paper.",
                            "target_lang_translations": {
                                "ru": "Чернила <w>свободно</w> вытекали из ручки на бумагу."
                            }
                        }
                    ],
                    "synonyms": [
                        "freely",
                        "continuously"
                    ],
                    "target_lang_definitions": {
                        "ru": "В манере, напоминающей течение жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непреры́вно",
                                "target_lang_sense_clarification": "описывает постоянный поток чего-либо"
                            },
                            {
                                "target_lang_word": "свобо́дно",
                                "target_lang_sense_clarification": "описывает движение без препятствий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}