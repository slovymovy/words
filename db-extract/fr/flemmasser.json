                "senses": [
                    {
                        "sense_id": "71b5c893-bf11-3a03-bebc-7c31d2642085",
                        "entry_id": "2427a655-f3b1-3818-a8f5-7f75ef023fc1",
                        "glosses": [
                            "Ne rien faire, par flemme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad7eb58-cb10-4008-ad0d-400ae91b0102",
                                "sense_id": "71b5c893-bf11-3a03-bebc-7c31d2642085",
                                "text": "Toujours à flemmasser sous prétexte qu'ils pensent."
                            },
                            {
                                "example_id": "5586e48d-00c6-4b09-950a-6942e2508748",
                                "sense_id": "71b5c893-bf11-3a03-bebc-7c31d2642085",
                                "text": "T'as pas honte de flemmasser comme ça tout le temps ! grommela Irène."
                            },
                            {
                                "example_id": "0ca0f716-e76e-488b-90cc-3101a9d7f280",
                                "sense_id": "71b5c893-bf11-3a03-bebc-7c31d2642085",
                                "text": "Enfin au moins, ils ne venaient pas ce matin, et il allait donc pouvoir tranquillement flemmasser, et rangeoter le salon où commençaient à traîner un peu trop de magazines et de livres."
                            }
                        ]
                    }
                ],
