                ],
                "senses": [
                    {
                        "sense_id": "6ca6a684-43cf-34a8-8590-7bf894d024e3",
                        "entry_id": "0b8d2e45-d920-35f9-9715-3c2d0969aeba",
                        "glosses": [
                            "gebroken wit; wit met een bijmenging van geel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1abe908b-d7b6-4ecc-8655-c59dbe513f6f",
                                "sense_id": "6ca6a684-43cf-34a8-8590-7bf894d024e3",
                                "text": "Hij krijgt zijn zin. In 1962 rijden twaalf roomwitte politie Porsches de snelweg op. De bemanningen gaan weggebruikers opvoeden. Eerst door middel van corrigerende gesprekken. Daarna met bekeuringen."
                            },
                            {
                                "example_id": "916ddd9d-3e40-4614-ac85-9f1c34ef5a70",
                                "sense_id": "6ca6a684-43cf-34a8-8590-7bf894d024e3",
                                "text": "Een leger van advocaten, gevolgd door twee bussen vol Russische en Spaanse bestuurders en commissarissen die zij vertegenwoordigen, arriveert vanmorgen bij het roomwitte gerechtshof aan de rand van het IJ in Amsterdam, waar de Ondernemingskamer zetelt."
                            },
                            {
                                "example_id": "c7557c19-7eae-42dd-91db-44331bbc9a4f",
                                "sense_id": "6ca6a684-43cf-34a8-8590-7bf894d024e3",
                                "text": "Bruiden houden van traditionele trouwjurken. Ook al proberen ontwerpers elk seizoen weer grenzen te verleggen, zijn het de roomwitte wolken die tot de verbeelding blijven spreken. Wie naar zoetsappige films als Bride Wars, 27 Dresses en Bridesmaids kijkt ziet louter prinsessenjurken voorbij komen. Alle vernieuwingen ten spijt, traditie regeert."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ee3400a-18b0-42ef-91d7-3e577bcc2a84",
                        "source_entry_id": "0b8d2e45-d920-35f9-9715-3c2d0969aeba",
                        "source_sense_id": "6ca6a684-43cf-34a8-8590-7bf894d024e3",
                        "target_lang_word": "cream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b8159da-89f8-310b-abdd-ff94ceacc483",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "The butterfat or milkfat part of milk which rises to the top; this part when separated from the remainder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9440e149-5bfa-4317-a59f-e872c48c3a95",
                                                "sense_id": "2b8159da-89f8-310b-abdd-ff94ceacc483",
                                                "text": "Take 100 ml of cream and 50 grams of sugar…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebfeace0-6949-3823-8632-bad601c2ba60",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "The butterfat or milkfat part of milk which rises to the top; this part when separated from the remainder.",
                                            "The liquid separated from milk, possibly with certain other milk products added, and with at least eighteen percent of it milkfat."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19aac56a-6176-48f3-be0f-e29c4b3e151d",
                                                "sense_id": "ebfeace0-6949-3823-8632-bad601c2ba60",
                                                "text": "You may have noticed that any time that filling is mentioned on Oreo packaging, it's called \"creme.\" This is no typo. Technically, the creamy filling inside an Oreo is not cream at all: The recipe used actually contains no dairy; as such, the FDA prohibits Nabisco from labeling the product as \"cream.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c484637-48f6-3e36-b62e-81ec31bffceb",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "The butterfat or milkfat part of milk which rises to the top; this part when separated from the remainder.",
                                            "The liquid separated from milk containing at least 18 percent milkfat (48% for double cream)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c24c46bc-b036-3b3e-8736-04c350f31c9a",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "The butterfat or milkfat part of milk which rises to the top; this part when separated from the remainder.",
                                            "A portion of cream, such as the amount found in a creamer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3bfeb2-1cf6-45a2-a6aa-82bf6586c309",
                                                "sense_id": "c24c46bc-b036-3b3e-8736-04c350f31c9a",
                                                "text": "I take my coffee with two cream and three sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0370d531-9477-3f31-a1c3-cb8b5c252e3e",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "A yellowish white color; the color of cream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1bb758-1fcd-4c97-ad97-0af85ba7e266",
                                                "sense_id": "0370d531-9477-3f31-a1c3-cb8b5c252e3e",
                                                "text": "Hundreds of examples remain, still following the same general pattern—maroon, green or chocolate brown, for example, from ground to waist level, then a stale Cheddar cheese shade of cream above."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf4c919-0d9a-3bdd-adc1-ae3c4b9f77d7",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "Frosting, custard, creamer, or another substance similar to the oily part of milk or to whipped cream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87d4e038-f2de-4190-9429-d7aff202e28b",
                                                "sense_id": "3cf4c919-0d9a-3bdd-adc1-ae3c4b9f77d7",
                                                "text": "Originally the cream filling in Oreo cookies was made with pork lard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00533bb5-73c2-312a-b757-b1cb8c3bc48a",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "A dish prepared through creaming, particularly cream of"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e20bd93b-7df0-3348-9b5c-d92988c06f88",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "The best part of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5682201e-e1b1-48a1-bf23-cc1df8802891",
                                                "sense_id": "e20bd93b-7df0-3348-9b5c-d92988c06f88",
                                                "text": "the cream of the crop"
                                            },
                                            {
                                                "example_id": "d7eff20f-51ff-4f22-8203-8543dc5ae5b1",
                                                "sense_id": "e20bd93b-7df0-3348-9b5c-d92988c06f88",
                                                "text": "the cream of a collection of books or pictures"
                                            },
                                            {
                                                "example_id": "a1aa9fbc-4525-4228-b41a-a42ae90c060e",
                                                "sense_id": "e20bd93b-7df0-3348-9b5c-d92988c06f88",
                                                "text": "Welcome, O flower and cream of Knights-errant."
                                            },
                                            {
                                                "example_id": "8c3c26c4-ad42-4e17-ab92-0826cc5d7376",
                                                "sense_id": "e20bd93b-7df0-3348-9b5c-d92988c06f88",
                                                "text": "“But the cream of it was,\" said Norman, pressing a large tortoiseshell-rimmed monocle into his eye, “you don't mind me telling this, Face, do you?”"
                                            },
                                            {
                                                "example_id": "45c41ae3-93ba-4acf-9c58-f47caaeeebb4",
                                                "sense_id": "e20bd93b-7df0-3348-9b5c-d92988c06f88",
                                                "text": "[…] he can assure the assembled Deans that all this is true, and that the Academy has presently in residence no fewer than a third of the continent’s top thirty juniors, in age brackets all across the board, and that I here, who go by ‘Hal,’ usually, am ‘right up there among the very cream.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ffb50dc-b3c4-3305-84c1-6255c21ef937",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "A viscous aqueous oil or fat emulsion with a medicament added, used to apply that medicament to the skin. (compare with ointment)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "518d10ef-01c0-464a-bc01-b9d5218a5105",
                                                "sense_id": "1ffb50dc-b3c4-3305-84c1-6255c21ef937",
                                                "text": "You look really sunburnt; you should apply some cream."
                                            },
                                            {
                                                "example_id": "a43c3835-7d5d-4f8b-9f09-b30dd6af6d01",
                                                "sense_id": "1ffb50dc-b3c4-3305-84c1-6255c21ef937",
                                                "text": "In vain she tries her paste and creams, / To smooth her skin or hide its seams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e093562-ec10-3505-a9d0-d1e41bb9fda3",
                                        "entry_id": "35eadd24-1de4-3997-8ef3-42c5a67ced6a",
                                        "glosses": [
                                            "Semen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
