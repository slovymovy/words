                ],
                "senses": [
                    {
                        "sense_id": "955d9190-ae31-30fb-98fa-4c4754a86ea0",
                        "entry_id": "bafdf01f-6346-3377-a66d-0281fa90254c",
                        "glosses": [
                            "Celui qui s’occupe de perfectionner la culture des jardins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e521737-be1c-42af-bb15-c1a1b76a833e",
                                "sense_id": "955d9190-ae31-30fb-98fa-4c4754a86ea0",
                                "text": "Dès le lendemain matin nous nous présentons chez l'horticulteur Lemoine, qui […] se fait un plaisir de nous faire visiter ses serres, ses jardins. Que de merveilles! grands dieux!"
                            },
                            {
                                "example_id": "d71b2a6a-2db0-4b5f-85c5-abc0ef974f8d",
                                "sense_id": "955d9190-ae31-30fb-98fa-4c4754a86ea0",
                                "text": "Mais je n’aime pas les fleurs bêtes, car si blasphématoire que cela paraisse, il y a des fleurs bêtes, ou plutôt des fleurs, des pauvres fleurs à qui les horticulteurs ont communiqué leur bêtise contagieuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "617564a2-cb3d-4924-bc5f-a61d5c646df4",
                        "source_entry_id": "bafdf01f-6346-3377-a66d-0281fa90254c",
                        "source_sense_id": "955d9190-ae31-30fb-98fa-4c4754a86ea0",
                        "target_lang_word": "horticulturist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horticulturist",
