                ],
                "senses": [
                    {
                        "sense_id": "0116cd34-6c34-3f41-8ed5-67bf359eb810",
                        "entry_id": "b1835acc-dc7c-39b8-9dca-cc2ed1893063",
                        "glosses": [
                            "Kastenbrot aus grob gemahlenem Mehl, ursprünglich im militärischen Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94965807-c89c-41a1-89f4-fdb91ec57c99",
                                "sense_id": "0116cd34-6c34-3f41-8ed5-67bf359eb810",
                                "text": "„Statt Blumen verehrte er Martchen ein Kommißbrot und einen mordsmäßigen Schinken, den er in einer Papiertüte getragen hatte.“"
                            },
                            {
                                "example_id": "7ec8e102-adb7-44a1-a94d-37dd560e514d",
                                "sense_id": "0116cd34-6c34-3f41-8ed5-67bf359eb810",
                                "text": "„Er läuft ins Haus, holt ein Kommißbrot und hält es hoch.“"
                            },
                            {
                                "example_id": "1ebc1f1e-3b6a-49f4-940d-c5230b504a04",
                                "sense_id": "0116cd34-6c34-3f41-8ed5-67bf359eb810",
                                "text": "„Die Gruppe hatte dem Zugführer Holz geschnitten und dafür ein Kommißbrot bekommen, jeder eine Schnitte.“"
                            },
                            {
                                "example_id": "09412a7e-96b0-423a-a6d7-14edcda7b308",
                                "sense_id": "0116cd34-6c34-3f41-8ed5-67bf359eb810",
                                "text": "„Im Ersten Weltkrieg wurde ein mit Kartoffelmehl gestrecktes Brot produziert. Offiziell »Kriegsbrot« getauft, verleitete es das Publikum, das Kurzwort »K-Brot« als »Kartoffelbrot« aufzulösen (nicht identisch mit dem »Kommissbrot«, das schon seit dem 18. Jahrhundert in der Landsersprache geläufig war).“"
                            },
                            {
                                "example_id": "ec5f2874-2daf-4fe0-a3c0-7df6d15f233b",
                                "sense_id": "0116cd34-6c34-3f41-8ed5-67bf359eb810",
                                "text": "„Am Abend war wieder Appell, bei dem Kommissbrot ausgeteilt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
