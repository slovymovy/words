                "senses": [
                    {
                        "sense_id": "db983a4e-c212-3c40-b5de-b6ab693f0e70",
                        "entry_id": "0368c8d0-6124-31e0-bfea-bec68e452eaf",
                        "glosses": [
                            "das Eliminieren von Geruch; das gezielte Beseitigen von Geruchsstoffen in Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7283698-988a-4f1a-ba81-15361881dd32",
                                "sense_id": "db983a4e-c212-3c40-b5de-b6ab693f0e70",
                                "text": "Die sichere Beseitigung von Geruchsstoffen aus der Luft, also die Geruchseliminierung, kann durch verschiedene Systeme erfolgen und lässt sich olfaktometrisch messen."
                            },
                            {
                                "example_id": "bedc4ced-b7da-4035-8271-9862d33c0122",
                                "sense_id": "db983a4e-c212-3c40-b5de-b6ab693f0e70",
                                "text": "„Die Geruchseliminierung soll dabei über einen Versuchsstand zur kontinuierlichen olfaktometrischen Beprobung quantifiziert werden.“"
                            },
                            {
                                "example_id": "ee33d986-15e3-4c81-ae76-59fea17ffb99",
                                "sense_id": "db983a4e-c212-3c40-b5de-b6ab693f0e70",
                                "text": "„Zur Geruchseliminierung werden ausschließlich probiotische Produkte verwendet.“"
                            },
                            {
                                "example_id": "9e9b72e0-990b-40c6-8b26-93388e5174e6",
                                "sense_id": "db983a4e-c212-3c40-b5de-b6ab693f0e70",
                                "text": "„Vor allem im Wartezimmer ist die gezielte Geruchseliminierung von Nöten.“"
                            },
                            {
                                "example_id": "ffcc1373-3dca-4204-8b04-a1ad338b2987",
                                "sense_id": "db983a4e-c212-3c40-b5de-b6ab693f0e70",
                                "text": "„Die Bandbreite reicht hier von der Geruchseliminierung bei Kläranlagen über den Abbau von Formaldehyd und Methanol in der Holzverarbeitung, NH3 und andere nicht kondensierbare Geruchsstoffe aus der Tierkörperverwertung und Tierzucht bis hin zu VOCs aus der Farben- und Lackindustrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
