                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef63909b-da47-47f5-b1f9-74b0934fc5d8",
                                "sense_id": "b32e24c9-bee1-3768-b591-0c1819c12ea4",
                                "text": "Dla odzysku posiadłości musieliśmy opłacić sowicie kilku prawników."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
