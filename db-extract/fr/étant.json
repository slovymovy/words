        "fr-extract.jsonl": [
            {
                "entry_id": "d8cf52f4-90ba-3dd6-9122-d50706782b53",
                "word": "étant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d1d5c5fa-2788-4c8e-9514-b6a1fee1397d",
                        "entry_id": "d8cf52f4-90ba-3dd6-9122-d50706782b53",
                        "tags": [
                            "plural"
                        ],
                        "form": "étants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                        "entry_id": "d8cf52f4-90ba-3dd6-9122-d50706782b53",
                        "glosses": [
                            "Concept utilisé pour désigner tout ce qui se présente d'une façon déterminée, sur un mode concret, opposé à l’être qui est indéterminé, indifférencié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01445d2b-a1a0-40e8-8ee5-64e8f8b6b424",
                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                "text": "Pour échapper au monisme de Parménide, Aristote eût pu faire remarquer que l’expression « L’Être est » est vide de sens, car aucune expérience vécue ne correspond à la saisie de l’être en soi : nous n’appréhendons que des « étants »."
                            },
                            {
                                "example_id": "cc65b695-1634-471b-ab7d-24618a455b6a",
                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                "text": "Le paradoxe trouve sa justification dans l’analogicité de l’étant et de ses propriétés."
                            },
                            {
                                "example_id": "227c6c07-9cbc-4dc5-970f-ace3993706e2",
                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                "text": "Gilles fait ici une mention assez cocasse de l'erreur légendaire d'Avicenne. Il félicite Averroès d'avoir blâmé Avicenne, qui croyait à tort que l’étant catégorial (l'essence) s'ajoutait comme un accident."
                            },
                            {
                                "example_id": "63683d95-f4b7-453f-81e9-0edf59aed495",
                                "sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                                "text": "Derrière cet être-pour-la-mort se trouve lÊtre, avec une majuscule, une instance néantisant tous les êtres singuliers, les étants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4c4bd3d-1e3c-4a35-b0b5-88aab83f39df",
                        "source_entry_id": "d8cf52f4-90ba-3dd6-9122-d50706782b53",
                        "source_sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
                        "target_lang_word": "Dasein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dasein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                                        "glosses": [
                                            "das Leben eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85bb0262-6335-4b3e-b465-34d01db73d93",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "Sie freuten sich ihres Daseins."
                                            },
                                            {
                                                "example_id": "c27897d6-faed-42a1-b195-55e2757d438d",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„Es sieht also ganz so aus, als ob das Schimpfen essenziell zum menschlichen Dasein dazugehören würde.“"
                                            },
                                            {
                                                "example_id": "b2cfd079-71e2-4d97-be33-1e875902fb87",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„Schon in der Hafenkneipe hatte er erkannt, daß ihm John auf der weiten Fahrt in die Arktis das einsame Dasein unter den Grobianen und den ausgemachten Strolchen seiner Besatzung als guter Kamerad erträglich machen konnte.“"
                                            },
                                            {
                                                "example_id": "14247b74-0608-4e19-ba2a-46c65834c8a6",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„Die Bohémiens gehen jetzt ins Romanische Café, in dessen kuppelförmiger Halle die unter Kettenhändlern von der Rennbahn und Börsenspekulanten ein ziemlich geduldetes Dasein fristen.“"
                                            },
                                            {
                                                "example_id": "531f2bd3-76b6-428a-8ef3-d79f8992da17",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„In diesen drei entscheidenden Jahren meines Daseins verlor man oft die Hoffnung, daß ich weiterleben werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60d5cda7-ad3b-3024-a652-8e41b7ec27a4",
                                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                                        "glosses": [
                                            "Tatsache, anwesend/zugegen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cba55dd-0ffe-4f00-bdb9-37ea9a82d0d8",
                        "source_entry_id": "d8cf52f4-90ba-3dd6-9122-d50706782b53",
                        "source_sense_id": "cfdaeccc-41c3-3852-b28a-f366ae4fba66",
