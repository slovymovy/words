                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f5eb401-03db-3633-a893-0bf85397176d",
                        "entry_id": "821c7c05-52ff-33c5-8962-c4e3f198564d",
                        "glosses": [
                            "действие по значению гл. угощать, угостить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "35029f78-3059-3bd3-a16a-4243c301ed09",
                        "entry_id": "821c7c05-52ff-33c5-8962-c4e3f198564d",
                        "glosses": [
                            "то, чем угощают (еда, питьё)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ed33ef-43e3-4066-975a-78e112cccf96",
                                "sense_id": "35029f78-3059-3bd3-a16a-4243c301ed09",
                                "text": "И сделал для Него Левий в доме своем большое угощение; и там было множество мытарей и других, которые возлежали с ними."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15bb7a7b-c036-44f7-bdb8-c2025247aa39",
                        "source_entry_id": "821c7c05-52ff-33c5-8962-c4e3f198564d",
                        "target_lang_word": "treat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f08840d9-bc4b-3a54-a9c9-f53aacd02357",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To negotiate, discuss terms, bargain (for or with)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eaa4ed0-6e07-4394-b1ab-c69217290c61",
                                                "sense_id": "f08840d9-bc4b-3a54-a9c9-f53aacd02357",
                                                "text": "Now halting a few paces before the Captains of the West he looked them up and down and laughed. 'Is there any in this rout with authority to treat with me?' he asked."
                                            },
                                            {
                                                "example_id": "0e626171-e19e-4b79-80e9-0e1704fc94f9",
                                                "sense_id": "f08840d9-bc4b-3a54-a9c9-f53aacd02357",
                                                "text": "After all, in this hideous war we have just passed through never forget that Halifax would have treated with Hitler: it took Churchill to refuse."
                                            },
                                            {
                                                "example_id": "611a40a8-8a90-4435-a83c-463b8a0ef4e0",
                                                "sense_id": "f08840d9-bc4b-3a54-a9c9-f53aacd02357",
                                                "text": "I wouldn't promote businesses I considered immoral – ambulance-chasing lawyers or online roulette for example – but I've got nothing against computer or software manufacture: they're important and any reputable company in that industry is welcome to treat for my services."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc6b8fcd-41cd-388d-9e80-e8d600c9701d",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To discourse; to handle a subject in writing or speaking; to conduct a discussion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5fbced3-8e92-4a63-9deb-26a1ed5ec4e0",
                                                "sense_id": "dc6b8fcd-41cd-388d-9e80-e8d600c9701d",
                                                "text": "Cicero's writing treats mainly of old age and personal duty."
                                            },
                                            {
                                                "example_id": "a6e8b64b-cd34-46c8-95e0-f078802b4c27",
                                                "sense_id": "dc6b8fcd-41cd-388d-9e80-e8d600c9701d",
                                                "text": "Now of love they treat."
                                            },
                                            {
                                                "example_id": "e476d0fa-262f-48c7-accd-4068eda7af0e",
                                                "sense_id": "dc6b8fcd-41cd-388d-9e80-e8d600c9701d",
                                                "text": "And, indeed, should the excellent Mr Broughton be prevailed on to set fist to paper, and to complete the above-said rudiments, by delivering down the true principles of athletics, I question whether the world will have any cause to lament, that none of the great writers, either antient or modern, have ever treated about that noble and useful art."
                                            },
                                            {
                                                "example_id": "5bb8fc33-1a1b-4f2f-b7a1-ab3eb86fc31d",
                                                "sense_id": "dc6b8fcd-41cd-388d-9e80-e8d600c9701d",
                                                "text": "Rhetoric includes the earliest known theory on the proper use of metaphor; On Poetics treats the role of symbolism in drama and poetry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f8fa195-e478-3864-9bfe-c68306539c1b",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To discourse on; to represent or deal with in a particular way, in writing or speaking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afca21ca-0c4b-4342-be13-710969a93e55",
                                                "sense_id": "0f8fa195-e478-3864-9bfe-c68306539c1b",
                                                "text": "The article treated feminism as a quintessentially modern movement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f153a3-28dc-3c36-b50e-07c900f93f8d",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To entreat or beseech (someone)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dc0561b-3a66-40c1-97c4-90f2dd8b210b",
                                                "sense_id": "70f153a3-28dc-3c36-b50e-07c900f93f8d",
                                                "text": "Only let my family live, I treat thee."
                                            },
                                            {
                                                "example_id": "29c85f23-a0c4-4d24-abd8-876f75afff8f",
                                                "sense_id": "70f153a3-28dc-3c36-b50e-07c900f93f8d",
                                                "text": "To treate a tiran it is but thing in vayne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5580c6ff-f11c-3b2a-8451-4b67dbc5f936",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To handle, deal with or behave towards in a specific way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "140822c5-a514-490b-b668-2ca35b6a7504",
                                                "sense_id": "5580c6ff-f11c-3b2a-8451-4b67dbc5f936",
                                                "text": "You treated me like a fool."
                                            },
                                            {
                                                "example_id": "829098c0-47fe-425b-a8c1-6a64c667bdda",
                                                "sense_id": "5580c6ff-f11c-3b2a-8451-4b67dbc5f936",
                                                "text": "She was tempted to treat the whole affair as a joke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e281e639-ff02-3d0b-9b19-82e775e88218",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To entertain with food or drink, especially at one's own expense; to show hospitality to; to pay for as celebration or reward."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0095938-a8c3-4ce2-8022-2e6790d8c9c0",
                                                "sense_id": "e281e639-ff02-3d0b-9b19-82e775e88218",
                                                "text": "My husband treated me to a Paris holiday for our anniversary."
                                            },
                                            {
                                                "example_id": "91d991ff-14b0-48df-8b84-5f16b604fb51",
                                                "sense_id": "e281e639-ff02-3d0b-9b19-82e775e88218",
                                                "text": "I treated my son to some popcorn in the interval."
                                            },
                                            {
                                                "example_id": "e77ff210-65f3-4c93-9623-5ddbeb81f708",
                                                "sense_id": "e281e639-ff02-3d0b-9b19-82e775e88218",
                                                "text": "I've done so well this month, I'll treat you all to dinner (or Dinner is my treat.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c05e77d-d3b7-3681-8f4c-9769de21e353",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To commit the offence of providing food, drink, entertainment or provision to corruptly influence a voter."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad650156-3826-37dc-86c0-f65e7a661ce4",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To care for medicinally or surgically; to apply medical care to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af69ea52-e792-4099-a92f-19315db8ba08",
                                                "sense_id": "ad650156-3826-37dc-86c0-f65e7a661ce4",
                                                "text": "They treated me for malaria."
                                            },
                                            {
                                                "example_id": "eb18f585-645c-420b-a560-87b4297caa58",
                                                "sense_id": "ad650156-3826-37dc-86c0-f65e7a661ce4",
                                                "text": "We treated firefighters suffering from smoke inhalation, giving them oxygen to breathe and albuterol mist to help open their airways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad9e45a3-c4b9-3ffe-bd7e-fb71b20dcbf4",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To subject to a chemical or other action; to act upon with a specific scientific result in mind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648ac9b4-31ff-4bc5-9eac-dc442dccd380",
                                                "sense_id": "ad9e45a3-c4b9-3ffe-bd7e-fb71b20dcbf4",
                                                "text": "I treated the photo somewhat to make the colours more pronounced."
                                            },
                                            {
                                                "example_id": "deae664c-21c3-49aa-9da6-6464d3fea63f",
                                                "sense_id": "ad9e45a3-c4b9-3ffe-bd7e-fb71b20dcbf4",
                                                "text": "He treated the substance with sulphuric acid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17fbb65e-bbbc-3772-af91-154773f30e7d",
                                        "entry_id": "138e99c8-00e0-30eb-a9ad-926f89273525",
                                        "glosses": [
                                            "To provide (someone) with something special and pleasant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7c40bf9-3cf1-4345-868b-faa49bef01f7",
                                                "sense_id": "17fbb65e-bbbc-3772-af91-154773f30e7d",
                                                "text": "If good acting in movies is appealing and you enjoy live performances of theatre, you may soon be treated by the GMC's own endeavors in the theatrical arts."
                                            },
                                            {
                                                "example_id": "588ecf5c-b586-4e32-84be-85360a2be2e6",
                                                "sense_id": "17fbb65e-bbbc-3772-af91-154773f30e7d",
