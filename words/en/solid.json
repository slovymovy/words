{
    "word_family": [
        "solidify",
        "solidity",
        "solidly",
        "solidness",
        "solidification"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "26775569-8a85-351a-b7c9-fe7902a09ff5",
                    "sense_definition": "Being in a state of matter that is firm and keeps its shape, rather than being a liquid or gas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water becomes <w>solid</w> ice when the temperature drops below freezing.",
                            "target_lang_translations": {
                                "ru": "Вода превращается в <w>твёрдый</w> лёд, когда температура падает ниже нуля.",
                                "tr": "Sıcaklık donma noktasının altına düştüğünde su <w>katı</w> buz haline gelir."
                            }
                        },
                        {
                            "text": "Almost all metals are <w>solid</w> at room temperature.",
                            "target_lang_translations": {
                                "ru": "Почти все металлы являются <w>твёрдыми</w> при комнатной температуре.",
                                "tr": "Neredeyse tüm metaller oda sıcaklığında <w>katı</w> haldedir."
                            }
                        }
                    ],
                    "antonyms": [
                        "liquid",
                        "gaseous"
                    ],
                    "common_phrases": [
                        "solid ice",
                        "solid rock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в агрегатном состоянии, которое является твердым и сохраняет свою форму, а не является жидкостью или газом.",
                        "tr": "Sıvı veya gaz olmak yerine, biçimini koruyan ve sert olan madde hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твёрдый",
                                "target_lang_sense_clarification": "физическое состояние"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "katı",
                                "target_lang_sense_clarification": "maddenin hali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "088b6e0e-350c-3b93-99df-2e35ede9d8f2",
                    "sense_definition": "Made of the same material throughout, without any holes or empty spaces inside.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a necklace made of <w>solid</w> gold.",
                            "target_lang_translations": {
                                "ru": "На ней было ожерелье из <w>чистого</w> золота.",
                                "tr": "<w>Som</w> altından yapılmış bir kolye takıyordu."
                            }
                        },
                        {
                            "text": "The table was heavy because it was made of <w>solid</w> wood.",
                            "target_lang_translations": {
                                "ru": "Стол был тяжелым, потому что был сделан из <w>цельного</w> дерева.",
                                "tr": "Masa ağırdı çünkü <w>masif</w> ahşaptan yapılmıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "massive"
                    ],
                    "antonyms": [
                        "hollow"
                    ],
                    "common_phrases": [
                        "solid gold",
                        "solid wood",
                        "solid silver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготовленный полностью из одного и того же материала, без отверстий или пустых пространств внутри.",
                        "tr": "İçinde boşluk veya delik bulunmayan, tamamen aynı malzemeden yapılmış."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цельный",
                                "target_lang_sense_clarification": "без пустот"
                            },
                            {
                                "target_lang_word": "сплошной",
                                "target_lang_sense_clarification": "однородный"
                            },
                            {
                                "target_lang_word": "массивный",
                                "target_lang_sense_clarification": "о материале"
                            },
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "о драгоценных металлах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "som",
                                "target_lang_sense_clarification": "altın veya gümüş gibi saf maddeler için"
                            },
                            {
                                "target_lang_word": "masif",
                                "target_lang_sense_clarification": "ahşap ve mobilya için"
                            },
                            {
                                "target_lang_word": "dolu",
                                "target_lang_sense_clarification": "içi boş olmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cc5f936-bac5-3b2d-91de-62e658b11eea",
                    "sense_definition": "Of good quality and reliable; something you can trust or depend on.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team has a <w>solid</w> plan to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "У команды есть <w>надёжный</w> план, чтобы завершить проект вовремя.",
                                "tr": "Takımın projeyi zamanında bitirmek için <w>sağlam</w> bir planı var."
                            }
                        },
                        {
                            "text": "He is a <w>solid</w> worker who never misses a day of work.",
                            "target_lang_translations": {
                                "ru": "Он <w>добросовестный</w> работник, который не пропускает ни одного рабочего дня.",
                                "tr": "O, bir gün bile işi aksatmayan <w>güvenilir</w> bir çalışandır."
                            }
                        }
                    ],
                    "synonyms": [
                        "substantial"
                    ],
                    "antonyms": [
                        "unreliable",
                        "weak"
                    ],
                    "common_phrases": [
                        "solid plan",
                        "solid performance",
                        "solid reputation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошего качества и надежный; то, чему можно доверять или на что можно положиться.",
                        "tr": "Kaliteli, güvenilir; güvenilebilecek veya bel bağlanabilecek nitelikte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солидный",
                                "target_lang_sense_clarification": "надежный, серьезный"
                            },
                            {
                                "target_lang_word": "надёжный",
                                "target_lang_sense_clarification": "заслуживающий доверия"
                            },
                            {
                                "target_lang_word": "основательный",
                                "target_lang_sense_clarification": "серьезный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sağlam",
                                "target_lang_sense_clarification": "güvenilir, mantıklı"
                            },
                            {
                                "target_lang_word": "güvenilir",
                                "target_lang_sense_clarification": "itimat edilir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb729df4-f8ea-3ae7-9498-dc1c4447104e",
                    "sense_definition": "Strong and unlikely to break or fail.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house was built on a <w>solid</w> foundation of concrete.",
                            "target_lang_translations": {
                                "ru": "Дом был построен на <w>прочном</w> бетонном фундаменте.",
                                "tr": "Ev, <w>sağlam</w> bir beton temel üzerine inşa edilmişti."
                            }
                        },
                        {
                            "text": "The athlete has a <w>solid</w> build and rarely gets injured.",
                            "target_lang_translations": {
                                "ru": "У этого атлета <w>крепкое</w> телосложение, и он редко получает травмы.",
                                "tr": "Sporcunun <w>güçlü</w> bir yapısı var ve nadiren sakatlanır."
                            }
                        }
