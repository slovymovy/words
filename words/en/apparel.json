            "senses": [
                {
                    "sense_id": "3350742d-34f8-39b2-9cc7-249e47038470",
                    "sense_definition": "Clothing, especially when referred to collectively in a commercial, business, or formal context.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store specializes in high-quality sports <w>apparel</w> for athletes.",
                            "target_lang_translations": {
                                "ru": "Магазин специализируется на высококачественной спортивной <w>одежде</w> для спортсменов.",
                                "de": "Das Geschäft ist auf hochwertige <w>Sportbekleidung</w> für Athleten spezialisiert."
                            }
                        },
                        {
                            "text": "She works as a designer in the women's <w>apparel</w> industry.",
                            "target_lang_translations": {
                                "ru": "Она работает дизайнером в индустрии женской <w>одежды</w>.",
                                "de": "Sie arbeitet als Designerin in der <w>Damenbekleidungsindustrie</w>."
                            }
                        }
