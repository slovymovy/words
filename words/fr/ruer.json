{
    "word_family": [
        "ruade"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64f45879-59da-3e98-bef6-7191dee2574a",
                    "sense_definition": "Lancer vivement ses membres postérieurs en arrière, en parlant d'un cheval ou d'un autre équidé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Effrayé par le bruit soudain, le jeune cheval a commencé à <w>ruer</w> dans son box."
                        },
                        {
                            "text": "Le cavalier a failli perdre l'équilibre lorsque sa jument s'est mise à <w>ruer</w> sans prévenir."
                        }
                    ],
                    "common_phrases": [
                        "commencer à ruer",
                        "cheval qui rue"
                    ]
                },
                {
                    "sense_id": "1a7ed462-14bc-3b7b-addb-ed61ec66c61a",
                    "sense_definition": "Se précipiter avec impétuosité ou violence sur quelqu'un ou vers un lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_humain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'ouverture des portes du magasin, les clients impatients ont commencé à se <w>ruer</w> sur les soldes."
                        },
                        {
                            "text": "À la fin de la séance, la foule s'est mise à se <w>ruer</w> vers les sorties principales."
                        }
                    ],
                    "synonyms": [
                        "foncer",
                        "se précipiter"
                    ],
                    "common_phrases": [
                        "se ruer sur",
                        "se ruer vers"
                    ]
                },
                {
                    "sense_id": "a0430dbd-182a-35bb-b6e9-439ff4fc84c2",
                    "sense_definition": "Agiter violemment ses membres pour tenter d'échapper à une contrainte ; se débattre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_humain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant en colère refusait d'avancer et continuait de <w>ruer</w> dans les bras de son père."
                        },
                        {
                            "text": "Pris au piège par les gardes, le suspect s'est mis à <w>ruer</w> pour tenter de fuir."
                        }
                    ],
                    "synonyms": [
                        "gigoter",
                        "se débattre"
                    ]
                },
                {
                    "sense_id": "062f3d7b-945d-3374-8f51-7075663121ec",
                    "sense_definition": "Jeter ou projeter quelque chose avec une grande violence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "projection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans un excès de fureur, l'homme <w>rua</w> son bâton contre les planches de la porte."
                        },
                        {
                            "text": "Le paysan en colère ramassa une lourde pierre et la <w>rua</w> par-dessus la barrière du champ."
                        }
                    ],
                    "synonyms": [
                        "jeter",
                        "lancer",
                        "projeter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Emploi vieilli et rare dans la langue moderne."
                        }
                    ]
                }
            ]
        }
    ]
}