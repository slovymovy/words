                "senses": [
                    {
                        "sense_id": "21723b10-3b0a-38fd-9f4a-e6bedb7410f7",
                        "entry_id": "2c8bf2e3-a39a-355d-b9c1-82773a989e9d",
                        "glosses": [
                            "beim Aufprall eines Meteoriten auf der Erde entstehender Impaktkrater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d0df52-1d05-4f06-9657-2b564152d24e",
                                "sense_id": "21723b10-3b0a-38fd-9f4a-e6bedb7410f7",
                                "text": "Das Nördlinger Ries ist ein Meteoritenkrater."
                            },
                            {
                                "example_id": "858011fa-7972-4916-81ba-834a63c3a5dc",
                                "sense_id": "21723b10-3b0a-38fd-9f4a-e6bedb7410f7",
                                "text": "„Die erst vor kurzem entdeckte Winneshiek-Lagerstätte ist so etwas wie ein Eldorado für Paläontologen: Es handelt sich um einen 27 Meter dicken sandigen Schiefer, der in einem Meteoritenkrater im Nordosten der USA liegt.“"
                            },
                            {
                                "example_id": "c824593d-1ccb-498e-8b04-2dddbfebde02",
                                "sense_id": "21723b10-3b0a-38fd-9f4a-e6bedb7410f7",
                                "text": "„Dänische Forscher sind überzeugt, an der Südwestküste Grönlands den größten Meteoritenkrater der Welt gefunden zu haben.“"
                            },
                            {
                                "example_id": "2b31117f-8a9c-49cc-9481-0f2bd14bf148",
                                "sense_id": "21723b10-3b0a-38fd-9f4a-e6bedb7410f7",
                                "text": "„Und anders als auf dem Mond gibt es auch keine Meteoritenkrater jener Zeit, denn Erosion und Plattentektonik haben sie längst ausradiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
