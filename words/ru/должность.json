{
    "word_family": [
        "должный",
        "долг"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ef95c1b-1424-318f-aa23-b61d34d15e76",
                    "sense_definition": "Служебное место, связанное с определённым кругом обязанностей и полномочий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "работа",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он получил новую <w>должность</w> в крупной компании.",
                            "target_lang_translations": {
                                "en": "He got a new <w>position</w> at a large company."
                            }
                        },
                        {
                            "text": "Отец исполнял четыре <w>должности</w> в артели одновременно.",
                            "target_lang_translations": {
                                "en": "Father held four <w>positions</w> in the cooperative at the same time."
                            }
                        }
                    ],
                    "synonyms": [
                        "пост",
                        "место",
                        "позиция",
                        "положение"
                    ],
                    "common_phrases": [
                        "занимать должность",
                        "получить должность",
                        "высокая должность"
                    ],
                    "target_lang_definitions": {
                        "en": "A professional role or job title involving specific duties and responsibilities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "position",
                                "target_lang_sense_clarification": "A professional role or job title."
                            },
                            {
                                "target_lang_word": "post",
                                "target_lang_sense_clarification": "An appointed job or office, often in an organization."
                            },
                            {
                                "target_lang_word": "job",
                                "target_lang_sense_clarification": "General term for a place of employment."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fcd30b5-3800-3595-a1c2-81254d14a182",
                    "sense_definition": "Обязанность или долг перед кем-либо или чем-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "обязанность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она понимала все свои семейные <w>должности</w> как мать и жена.",
                            "target_lang_translations": {
                                "en": "She understood all her family <w>duties</w> as a mother and wife."
                            }
                        },
                        {
                            "text": "Выполнение гражданской <w>должности</w> было для него делом чести.",
                            "target_lang_translations": {
                                "en": "Fulfilling his civic <w>duty</w> was a matter of honor for him."
                            }
                        }
                    ],
                    "synonyms": [
                        "долг",
                        "обязанность"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "В значении долг или обязанность слово устарело."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A duty, obligation, or responsibility one has toward someone or something (archaic)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "duty",
                                "target_lang_sense_clarification": "A moral or legal obligation."
                            },
                            {
                                "target_lang_word": "obligation",
                                "target_lang_sense_clarification": "A requirement to perform a specific action."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3c6b218-181b-3aca-a877-b4e62cf199f6",
                    "sense_definition": "Место службы или учреждение, где кто-либо работает.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "работа",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Чиновники встречали его на лестнице, когда он приходил в <w>должность</w>.",
                            "target_lang_translations": {
                                "en": "Officials met him on the stairs when he arrived at his <w>workplace</w>."
                            }
                        },
                        {
                            "text": "Каждый день он спешил в свою <w>должность</w> к восьми часам утра.",
                            "target_lang_translations": {
                                "en": "Every day he hurried to his <w>office</w> by eight in the morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "учреждение",
                        "организация",
                        "место работы"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее употребление в значении места службы."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A place of work or an institution where someone is employed (archaic)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "workplace",
                                "target_lang_sense_clarification": "The physical location or organization where one works."
                            },
                            {
                                "target_lang_word": "office",
                                "target_lang_sense_clarification": "A place of business or professional service."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d97001d2-5fa9-32ab-bee2-24d00a193b2f",
                    "sense_definition": "Необходимость или нужда в чем-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "необходимость",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда возникла <w>должность</w> принимать новые законы, они отправились в путь.",
                            "target_lang_translations": {
                                "en": "When the <w>necessity</w> to pass new laws arose, they set off on their journey."
                            }
                        },
                        {
                            "text": "Всякая <w>должность</w> в помощи заставляла их действовать решительно.",
                            "target_lang_translations": {
                                "en": "Every <w>need</w> for help compelled them to act decisively."
                            }
                        }
                    ],
                    "synonyms": [
                        "необходимость",
                        "нужда"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее употребление в значении необходимости."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A necessity or need for something (archaic)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "necessity",
                                "target_lang_sense_clarification": "The state of being required or essential."
                            },
                            {
                                "target_lang_word": "need",
                                "target_lang_sense_clarification": "A requirement or requirement for something."
                            }
                        ]
                    }
                }
            ]
        }
