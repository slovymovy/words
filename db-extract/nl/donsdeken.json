                                    {
                                        "sense_id": "6ee34776-aa04-3ae6-b446-5a58d9817116",
                                        "entry_id": "98f2313b-70ac-3f1e-8ef0-71aa7e425224",
                                        "glosses": [
                                            "Touffe de cheveux réuni par un lien, sur un côté de la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
