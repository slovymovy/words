                        "glosses": [
                            "Happening many times in a similar way; containing repetition; repeating."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897cf842-58b9-451b-a213-2bb0fe59497a",
                                "sense_id": "e8cc8a41-0041-36ce-960e-a41af6fc3174",
                                "text": "The lecture was too repetitive and lost its impact."
                            },
                            {
                                "example_id": "9560f7ba-5692-4786-b876-6fa0656fb690",
                                "sense_id": "e8cc8a41-0041-36ce-960e-a41af6fc3174",
                                "text": "He kept repeating the same repetitive tasks without making progress."
                            },
                            {
                                "example_id": "55bd5d5d-ec40-4d27-8a1f-35ae7eeaa2a9",
                                "sense_id": "e8cc8a41-0041-36ce-960e-a41af6fc3174",
                                "text": "The movie was criticized for its repetitive scenes and predictable plot."
                            }
                        ]
                    }
                ],
