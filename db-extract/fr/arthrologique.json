                        "entry_id": "ce93f51f-9965-366f-9cad-a21cb3e68bba",
                        "glosses": [
                            "Qui a un rapport avec l’arthrologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f111e3-4de4-4b89-bf07-9eae50f074d4",
                                "sense_id": "1c38859a-1f11-36d8-9f01-925e33cdf0e0",
                                "text": "Elle devient en revanche nécessaire si, adoptant le point de vue arthrologique, on cherche à décrire l’enchaînement des activités."
                            },
                            {
                                "example_id": "54c3b182-39b3-4210-b5f2-1ba67a6b8de4",
                                "sense_id": "1c38859a-1f11-36d8-9f01-925e33cdf0e0",
                                "text": "Au-delà de cette échancrure, dont on apprécie facilement la valeur arthrologique, vient la partie interne, laquelle se montre régulièrement arrondie pour s’unir d’une façon insensible avec la face interne."
                            }
                        ]
                    }
