                "senses": [
                    {
                        "sense_id": "c5cc19a4-023e-3f99-85a8-4a0af16828bf",
                        "entry_id": "8cdf5069-9ef6-3acc-acab-8e896e654394",
                        "glosses": [
                            "zeer groot en indrukwekkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcbd9035-3ec4-4806-9187-38dd30bb58bf",
                                "sense_id": "c5cc19a4-023e-3f99-85a8-4a0af16828bf",
                                "text": "Op de Dam van Amsterdam staat een monumentaal paleis."
                            },
                            {
                                "example_id": "886915a1-0809-4e53-afb2-422155facc19",
                                "sense_id": "c5cc19a4-023e-3f99-85a8-4a0af16828bf",
                                "text": "De ingewikkeldste restauraties vinden in de oudere gedeeltes van het paleis plaats. \"Alles is natuurlijk monumentaal. Maar de vleugels zijn begin negentiende eeuw aangebouwd. Die zijn dus twee eeuwen oud, maar het waren vooral woonvertrekken. Die waren niet gemaakt om bals in te organiseren. Die zijn soberder\", zegt Verfürden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4756bb7d-2785-4f3e-8681-90998922c075",
                        "source_entry_id": "8cdf5069-9ef6-3acc-acab-8e896e654394",
                        "source_sense_id": "c5cc19a4-023e-3f99-85a8-4a0af16828bf",
                        "source_sense_description": "zeer groot en indrukwekkend",
                        "target_lang_word": "monumental",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
