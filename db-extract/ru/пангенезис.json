                                "target_senses": [
                                    {
                                        "sense_id": "a8b92769-5378-30d5-84cf-7a7982f37267",
                                        "entry_id": "83d3de39-a8fd-3781-acaa-306895b41ede",
                                        "glosses": [
                                            "historische (und widerlegte) Hypothese, die davon ausgeht, dass das Erbgut im gesamten Körper entsteht und in den Keimzellen angesammelt wird"
                                        ],
                                        "tags": [
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d05e686-d648-471e-a7ad-0d8d52edf549",
                                                "sense_id": "a8b92769-5378-30d5-84cf-7a7982f37267",
                                                "text": "Die Hypothese der Pangenesis wurde der Sache nach schon im Altertum von Hippokrates vertreten."
                                            },
                                            {
                                                "example_id": "29b29dd5-bfe3-4bf9-ae27-2ebe2c11f09a",
                                                "sense_id": "a8b92769-5378-30d5-84cf-7a7982f37267",
                                                "text": "„Es wird fast allgemein zugegeben, daß die Zellen […] sich durch Theilung […] fortpflanzen […]. Aber ausser dieser Vermehrungsweise nehme ich an, dass die Zellen von ihrer Umwandlung in völlig passive oder gebildete Substanz kleine Körnchen oder Atome abgeben […]. Endlich nehme ich an, dass die Keimchen in ihren schlummernden Zustande eine gegenseitige Verwandtschaft zueinander haben, welche zu ihrer Aggregation entweder zu Knospen oder zu den Sexualelementen führt. Um genauer zu sprechen, so sind es nicht die reproduktiven Elemente, […] welche neue Organismen erzeugen, sondern die Zellen selbst durch den ganzen Körper. […] Diese Annahmen bilden die provisorische Hypothese, welche ich Pangenesis genannt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ad98734-bd31-4e3a-8fc3-579da88c6d5c",
