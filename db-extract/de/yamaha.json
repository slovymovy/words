                "senses": [
                    {
                        "sense_id": "db063b70-7df4-36e2-bad8-2c71edc0b96e",
                        "entry_id": "0bc8ccb4-a26b-3b80-b698-9659e52ba0cc",
                        "glosses": [
                            "japanischer Hersteller von Motorrädern, Quads und Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11538c5f-0e32-44d3-913e-b5ff791868b6",
                                "sense_id": "db063b70-7df4-36e2-bad8-2c71edc0b96e",
                                "text": "„In den achtziger Jahren gewinnt er auf Motocross-Rennen die nationale Meisterschaft und macht damit auch die Brüder Bianchi, italienischer Herkunft wie er, zu Siegern: Denn sie sind es, die in Montería die Motorräder der Marke Yamaha verkaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3cdd30d-8f7a-35b7-b94b-2bee7c5a7add",
                        "entry_id": "0bc8ccb4-a26b-3b80-b698-9659e52ba0cc",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae254c5-3c47-4025-96f7-338fe28a8997",
                                "sense_id": "a3cdd30d-8f7a-35b7-b94b-2bee7c5a7add",
                                "text": "„Der 2. Officer In Command fuhr auf seiner Yamaha an uns vorbei.“"
                            },
                            {
                                "example_id": "79744495-40fb-4172-8288-24f93bad347b",
                                "sense_id": "a3cdd30d-8f7a-35b7-b94b-2bee7c5a7add",
                                "text": "„Falls Shaw aber nicht bei der Arbeit gewesen wäre, hätte er seine Yamaha binnen sechzig Sekunden von ihrer Halterung losgemacht und wäre nach weiteren dreißig Sekunden auf die Pfade eingebogen.“"
                            },
                            {
                                "example_id": "4748d32f-241a-4a8f-8d1a-6535404bae89",
                                "sense_id": "a3cdd30d-8f7a-35b7-b94b-2bee7c5a7add",
                                "text": "„›Eine der neuen Yamahas? Mit der neuen Generation von Smarträdern?‹“"
                            },
                            {
                                "example_id": "a53ebf77-b0ca-42e2-be38-d889eae7ea84",
                                "sense_id": "a3cdd30d-8f7a-35b7-b94b-2bee7c5a7add",
                                "text": "„Er schob seine Yamaha in den Wald hoch, weg vom Bach.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
