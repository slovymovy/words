                                        "sense_id": "4c2f03b8-5278-3fe4-a6f8-b2a4ed96108d",
                                        "entry_id": "63772c55-cea8-3390-aeb4-d0405eaaffdd",
                                        "glosses": [
                                            "Mittel, das die selbständig erfolgende Oxidation von Lebensmitteln, Kunststoffen und Treibstoffen verhindert oder verhindern soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75811867-890b-41f5-b534-82e8e0923585",
                                                "sense_id": "4c2f03b8-5278-3fe4-a6f8-b2a4ed96108d",
                                                "text": "„Man kann durch Lebensmittel mit vielen Vitaminen, Mineralstoffen und Antioxidantien Augenleiden vorbeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea17c048-c1e6-4b87-840a-782eee6042ef",
                        "source_entry_id": "8a97e80a-0be5-3c6d-ac17-725ccf7f1efc",
