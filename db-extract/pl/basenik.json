                "senses": [
                    {
                        "sense_id": "3fc975b9-d753-3884-8d31-8e0f89ab863d",
                        "entry_id": "3c4daf45-9cd6-3024-a456-3797e80551f9",
                        "glosses": [
                            "od basen"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "3df678c0-fb11-4a78-87c8-2266e06ba5b9",
                                "sense_id": "3fc975b9-d753-3884-8d31-8e0f89ab863d",
                                "text": "Michałku, idź jeszcze trochę do baseniku, bo za godzinkę będziemy się zbierali."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0cad385a-f44d-3f93-804e-f59276d6820f",
                        "entry_id": "3c4daf45-9cd6-3024-a456-3797e80551f9",
                        "glosses": [
                            "mały basen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7889290d-83ec-47cd-8853-c7be52bd48d1",
                                "sense_id": "0cad385a-f44d-3f93-804e-f59276d6820f",
                                "text": "Do tej pory w judaizmie praktykowane jest obmycie z rytualnej nieczystości, chasydzi czynią to w specjalnie do tego przeznaczonym baseniku zwanym mykwą"
                            },
                            {
                                "example_id": "a25eeac8-b537-4087-ba54-843c69632a3c",
                                "sense_id": "0cad385a-f44d-3f93-804e-f59276d6820f",
                                "text": "Papuziki błękitne potrzebują również stałego dostępu do baseniku z wodą"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "cc59191a-f499-3d9b-a80a-39aa45bbe70e",
                        "entry_id": "3c4daf45-9cd6-3024-a456-3797e80551f9",
                        "glosses": [
                            "dmuchany brodzik dla dzieci"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97c5048-a9c5-4e73-a0ed-4ff2184fdf29",
                                "sense_id": "cc59191a-f499-3d9b-a80a-39aa45bbe70e",
                                "text": "Produkowane przez nas baseniki przeznaczone są dla dzieci od 3 lat."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
