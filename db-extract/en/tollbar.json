                                        "sense_id": "5c20a96e-ea2d-37f8-8297-aa57c71dd535",
                                        "entry_id": "8a8058b5-259f-387a-ab34-83c9777bed8f",
                                        "glosses": [
                                            "Einrichtung zum Blockieren einer Straße oder eines Weges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc54f492-5b73-4aad-afd4-2f03e676c6b8",
                                                "sense_id": "5c20a96e-ea2d-37f8-8297-aa57c71dd535",
                                                "text": "Am Schlagbaum fand die Grenzkontrolle statt."
                                            },
                                            {
                                                "example_id": "ad8cba2d-ea37-4b92-bb50-e987968f579a",
                                                "sense_id": "5c20a96e-ea2d-37f8-8297-aa57c71dd535",
                                                "text": "„Der Schlagbaum öffnet sich, und wir fahren auf die Brücke.“"
                                            },
                                            {
                                                "example_id": "23426168-1e16-4320-a022-ee44d8fd525c",
                                                "sense_id": "5c20a96e-ea2d-37f8-8297-aa57c71dd535",
                                                "text": "„Die Mauer war gefallen, und man konnte wieder ohne Schlagbaum und Kontrollen kreuz und quer durch Deutschland fahren.“"
                                            },
                                            {
                                                "example_id": "30df1e26-778f-4bad-a7ac-0e5b48bcfbab",
                                                "sense_id": "5c20a96e-ea2d-37f8-8297-aa57c71dd535",
                                                "text": "„Die Quittung kommt, der Schlagbaum hebt sich, und wir rollen drunter durch.“"
                                            },
                                            {
                                                "example_id": "5155e410-7e1c-47fb-a2a6-9f446ba261a1",
                                                "sense_id": "5c20a96e-ea2d-37f8-8297-aa57c71dd535",
                                                "text": "„Er war kaum über den Schlagbaum hinaus, als ein Adjutant des Grafen Rastoptschin auf ihn zukam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
