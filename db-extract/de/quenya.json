                "senses": [
                    {
                        "sense_id": "5d4ecda5-76cd-3aad-b9e2-9ded810b0a5e",
                        "entry_id": "c0e55be9-0453-346a-83e2-8e990f6ec319",
                        "glosses": [
                            "vom Fantasyautor J. R. R. Tolkien geschaffene Sprache, die in seiner Welt ursprünglich von den Elben gesprochen und dann als gesprochene Sprache weitestgehend vom Sindarin verdrängt wurde. Als Schriftsprache war sie, ähnlich dem Latein in Europa, jedoch weiterhin in Gebrauch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11748921-52d1-4cfc-875c-2a3acfae9ccc",
                                "sense_id": "5d4ecda5-76cd-3aad-b9e2-9ded810b0a5e",
                                "text": "„Im Quenya und Sindarin dagegen kann man alltäglich gebräuchliche Sätze formulieren und auch das Übersetzen z.B. vom Deutschen ins Quenya bzw. Sindarin und umgekehrt ist in gewissem Umfang möglich.“"
                            },
                            {
                                "example_id": "6ce5bd6e-2afa-4bba-9f50-2c12df751afc",
                                "sense_id": "5d4ecda5-76cd-3aad-b9e2-9ded810b0a5e",
                                "text": "„Das Elbische, besonders in seiner archaischen Form, dem Quenya, wird vor allen Dingen in Liedern und zu feierlichen Anlässen, aber auch in Momenten außergewöhnlicher emotionaler Spannung gebraucht, die auch für den Gang der Handlung von Bedeutung sind.“"
                            },
                            {
                                "example_id": "2bdc6cd6-a659-4754-879c-dda2184723a9",
                                "sense_id": "5d4ecda5-76cd-3aad-b9e2-9ded810b0a5e",
                                "text": "„Gandalf und Saruman gehören dem Orden der sog. Istari an. Nach der von Tolkien erfundenen (Elben-)Sprache Quenya kann «istar» ebenfalls mit «weise» übersetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
