{
    "word_family": [
        "pianist",
        "pianism",
        "pianistic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc0c2df0-1b70-37a5-b779-36c6c72ca709",
                    "sense_definition": "A large musical instrument with a keyboard, played by pressing black and white keys which cause hammers to strike strings.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat down at the <w>piano</w> and began to play a beautiful melody.",
                            "target_lang_translations": {
                                "ru": "Она села за <w>пианино</w> и начала играть красивую мелодию.",
                                "zh": "她坐在<w>钢琴</w>前，开始弹奏一首优美的旋律。"
                            }
                        },
                        {
                            "text": "The movers struggled to carry the heavy upright <w>piano</w> up the stairs.",
                            "target_lang_translations": {
                                "ru": "Грузчики с трудом тащили тяжелое <w>пианино</w> вверх по лестнице.",
                                "zh": "搬运工费力地把那架沉重的<w>立式钢琴</w>搬上了楼梯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pianoforte"
                    ],
                    "common_phrases": [
                        "play the piano",
                        "grand piano",
                        "upright piano",
                        "piano lesson",
                        "piano keys"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный клавишный музыкальный инструмент, на котором играют, нажимая на черно-белые клавиши, заставляющие молоточки ударять по струнам.",
                        "zh": "一种大型键盘乐器，通过按压黑白琴键带动琴槌敲击琴弦来发声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фортепиано",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "пианино",
                                "target_lang_sense_clarification": "вертикальное"
                            },
                            {
                                "target_lang_word": "рояль",
                                "target_lang_sense_clarification": "горизонтальный, концертный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钢琴",
                                "target_lang_sense_clarification": "通用名称"
                            },
                            {
                                "target_lang_word": "立式钢琴",
                                "target_lang_sense_clarification": "立式"
                            },
                            {
                                "target_lang_word": "三角钢琴",
                                "target_lang_sense_clarification": "卧式/演奏用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "af3a53ad-b9aa-3600-80c4-5c695b46f029",
                    "sense_definition": "Softly; used as a direction in music to indicate that a passage should be played quietly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_dynamic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor signaled the orchestra to play <w>piano</w> during the second verse.",
                            "target_lang_translations": {
                                "ru": "Дирижер дал знак оркестру играть <w>пиано</w> во время второго куплета.",
                                "zh": "指挥示意乐队在第二段时要演奏得<w>弱</w>一些。"
                            }
                        },
                        {
                            "text": "This section is marked <w>piano</w>, so please do not play too loudly.",
                            "target_lang_translations": {
                                "ru": "Эта часть помечена как <w>пиано</w>, поэтому, пожалуйста, не играйте слишком громко.",
                                "zh": "这一段标记为<w>弱</w>，所以请不要演奏得太大声。"
                            }
                        }
                    ],
                    "antonyms": [
                        "forte"
                    ],
                    "common_phrases": [
                        "subito piano",
                        "sempre piano"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихо; используется как указание в музыке играть отрывок негромко.",
                        "zh": "弱音；音乐术语，指示乐段应轻柔地演奏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиано",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弱",
                                "target_lang_sense_clarification": "音乐术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3a19d465-d67e-3765-a557-0f72ffa0c191",
                    "sense_definition": "Soft, quiet, or gentle, especially referring to sound or a person's manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_dynamic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His voice was <w>piano</w> and soothing as he told the story.",
                            "target_lang_translations": {
                                "ru": "Его голос был <w>тихим</w> и успокаивающим, когда он рассказывал историю.",
                                "zh": "他讲故事时，声音<w>轻柔</w>而舒缓。"
                            }
                        },
                        {
                            "text": "The music became <w>piano</w>, creating a calm and peaceful atmosphere.",
                            "target_lang_translations": {
                                "ru": "Музыка стала <w>тихой</w>, создавая спокойную и умиротворенную атмосферу.",
                                "zh": "音乐变得<w>轻柔</w>，营造出一种宁静祥和的氛围。"
                            }
                        }
                    ],
                    "antonyms": [
                        "forte",
                        "loud"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихий, мягкий или нежный (о звуке или манере поведения).",
                        "zh": "轻柔的、安静的，尤指声音或人的举止。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тихий",
                                "target_lang_sense_clarification": "о звуке"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "о голосе или тоне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻柔的",
                                "target_lang_sense_clarification": "形容声音或语气"
                            },
                            {
                                "target_lang_word": "安静的",
                                "target_lang_sense_clarification": "形容声音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2d99874-970c-3288-88ae-c30aa5d6231d",
                    "sense_definition": "To tap one's fingers sequentially on a surface, imitating the motion of playing a piano.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finger_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He leaned back in his chair and <w>pianoed</w> his fingers on the desk while he waited.",
                            "target_lang_translations": {
                                "ru": "Он откинулся на спинку стула и <w>забарабанил</w> пальцами по столу в ожидании.",
                                "zh": "等待时，他靠在椅背上，手指在桌面上<w>敲击</w>着。"
                            }
                        },
                        {
                            "text": "She nervously <w>pianoed</w> the table surface as she thought about the answer.",
                            "target_lang_translations": {
                                "ru": "Она нервно <w>барабанила</w> по поверхности стола, обдумывая ответ.",
                                "zh": "她在思考答案时，紧张地用手指在桌面上<w>敲击</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "piano one's fingers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "descriptive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательно ударять пальцами по поверхности, имитируя игру на пианино.",
                        "zh": "手指在表面依次敲击，模仿弹钢琴的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барабанить пальцами",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用手指敲击",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c831639-d7af-323c-bad3-db39bde99028",
                    "sense_definition": "To play the piano.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "play_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sang songs together while he <w>pianoed</w> a cheerful tune.",
                            "target_lang_translations": {
                                "ru": "Мы пели песни вместе, пока он <w>играл на пианино</w> веселую мелодию.",
                                "zh": "我们一起唱歌，他则在一旁<w>弹钢琴</w>伴奏，曲调欢快。"
                            }
                        },
                        {
                            "text": "She <w>pianoed</w> for the guests late into the evening.",
                            "target_lang_translations": {
                                "ru": "Она <w>играла на пианино</w> для гостей до позднего вечера.",
                                "zh": "她为客人们<w>弹钢琴</w>一直弹到深夜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть на фортепиано.",
                        "zh": "弹奏钢琴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть на пианино",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹钢琴",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1817a12d-2c73-33a2-9658-d96df42034ea",
                    "sense_definition": "To become softer, quieter, or less intense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "become_soft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm finally <w>pianoed</w> into a gentle rain after hours of thunder.",
                            "target_lang_translations": {
                                "ru": "После нескольких часов грома шторм наконец <w>стих</w>, сменившись легким дождем.",
                                "zh": "经过数小时的雷鸣，暴风雨终于<w>减弱</w>成了细雨。"
                            }
                        },
                        {
                            "text": "His anger <w>pianoed</w> when he realized he had made a mistake.",
                            "target_lang_translations": {
                                "ru": "Его гнев <w>утих</w>, когда он понял, что совершил ошибку.",
                                "zh": "当他意识到自己犯了错时，怒气便<w>平息</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться тише, спокойнее или менее интенсивным.",
                        "zh": "变得更柔和、安静或减弱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стихать",
                                "target_lang_sense_clarification": "о звуке или буре"
                            },
                            {
                                "target_lang_word": "утихать",
                                "target_lang_sense_clarification": "об эмоциях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指声音或强度"
                            },
                            {
                                "target_lang_word": "平息",
                                "target_lang_sense_clarification": "指情绪或风暴"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a75dbe8e-3b14-3cee-b963-832aae748f98",
                    "sense_definition": "A surname of Italian origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We met a gentleman named Mr. <w>Piano</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции мы встретили джентльмена по фамилии <w>Пьяно</w>.",
                                "zh": "我们在会议上遇到了一位名叫<w>皮亚诺</w>先生的绅士。"
                            }
                        },
                        {
                            "text": "The <w>Piano</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Пьяно</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>皮亚诺</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Italian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия итальянского происхождения.",
                        "zh": "意大利语源的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пьяно",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮亚诺",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}