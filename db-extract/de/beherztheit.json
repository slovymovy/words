                "senses": [
                    {
                        "sense_id": "44eddd8d-c61a-3616-b34a-6ac1829bb689",
                        "entry_id": "c2c454b3-6b00-30db-b191-6954667222f5",
                        "glosses": [
                            "mutiges und entschlossenes, unerschrockenes Handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9befa42-0b1b-4f8e-85d0-fbe13c277405",
                                "sense_id": "44eddd8d-c61a-3616-b34a-6ac1829bb689",
                                "text": "„Seien Sie unbesorgt, treue Horthense. Wenn ich mich schlage, dann für das Wahre, das Gute und Schöne, damit meine beispiellose Tugendhaftigkeit diese Stadt Antipolis etwas erträglicher macht … auf die Beherztheit, Horthense.“"
                            },
                            {
                                "example_id": "dbf67f5e-9f2d-4fde-8510-77b1f7be2275",
                                "sense_id": "44eddd8d-c61a-3616-b34a-6ac1829bb689",
                                "text": "„Diese Beherztheit konnte man übrigens ebensogut als Schrulle bezeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bc97b3f-5c9a-4e40-965b-fc06df28763c",
                        "source_entry_id": "c2c454b3-6b00-30db-b191-6954667222f5",
                        "source_sense_id": "44eddd8d-c61a-3616-b34a-6ac1829bb689",
                        "source_sense_description": "mutiges und entschlossenes, unerschrockenes Handeln",
                        "target_lang_word": "courage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The quality of being confident, not afraid or easily intimidated, but without being incautious or inconsiderate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b353f3f-4f3a-4761-9749-392d73548b3d",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "A great part of courage is the courage of having done the thing before."
                                            },
                                            {
                                                "example_id": "9a657da2-9fef-4405-9f52-9485ca4e917a",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "There is a stubbornness about me that never can bear to be frightened at the will of others. My courage always rises at every attempt to intimidate me."
                                            },
                                            {
                                                "example_id": "b4be87e1-43eb-44b9-9360-44ded218bd70",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "It takes a lot of courage to be successful in business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The ability to overcome one's fear, do or live things which one finds frightening."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df93de8-46c6-4591-a43d-2cd69a183f44",
                                                "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                                "text": "He plucked up the courage to tell her how he felt."
                                            },
                                            {
                                                "example_id": "afa74805-5552-49f1-8618-b7d3a970bf01",
                                                "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                                "text": "Courage is resistance to fear, mastery of fear—not absence of fear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The ability to maintain one's will or intent despite either the experience of fear, frailty, or frustration; or the occurrence of adversity, difficulty, defeat or reversal. Moral fortitude."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecb03c0-b960-4f81-abae-f078fe64ce20",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "“Courage is not simply one of the virtues but the form of every virtue at the testing point, which means at the point of highest reality.”"
                                            },
                                            {
                                                "example_id": "65b4e4b6-a6b2-4791-9278-cfe48e886ae1",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "I wanted you to see what real courage is, instead of getting the idea that courage is a man with a gun in his hand. It's when you know you're licked before you begin, but you begin anyway and see it through no matter what."
                                            },
                                            {
                                                "example_id": "151d52c3-76a5-4403-9b39-ece09f2f7928",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "Courage isn't having the strength to go on - it is going on when you don't have strength."
                                            },
                                            {
                                                "example_id": "3a40a8b8-d3a3-4d2c-b565-bb77172b4f1b",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "2008, Maya Angelou, address for the 2008 Cornell University commencement\nCourage is the most important of all the virtues because without courage, you can't practice any other virtue consistently."
                                            },
                                            {
                                                "example_id": "49791790-df56-4ddd-acfd-fd8987fdb2bb",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "I hope you live a life you’re proud of. If you find that you’re not, I hope you have the courage to start all over again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                        "entry_id": "8abb55a0-abb8-3084-ad11-f0e20171d040",
                                        "glosses": [
                                            "To encourage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44d4a34c-9ad8-4a9e-9aad-a0d010baf4f8",
                                                "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                                "text": "And wete yow wel sayd kynge Arthur vnto Vrres syster I shalle begynne to handle hym and serche vnto my power not presumyng vpon me that I am soo worthy to hele youre sone by my dedes / but I wille courage other men of worshyp to doo as I wylle doo"
                                            },
                                            {
                                                "example_id": "7caf610b-b4f2-469d-961b-e18b32573b02",
                                                "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                                "text": "Paul writeth unto Timothy, to instruct him, to teach him, to exhort, to courage him, to stir him up,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a093bf60-20e4-42f4-a219-6499f00fc70b",
                        "source_entry_id": "c2c454b3-6b00-30db-b191-6954667222f5",
                        "source_sense_id": "44eddd8d-c61a-3616-b34a-6ac1829bb689",
                        "source_sense_description": "mutiges und entschlossenes, unerschrockenes Handeln",
                        "target_lang_word": "courage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Capacité d'un humain ou un autre animal de vaincre sa peur pour braver le danger, supporter la souffrance, entreprendre des choses effrayantes, douloureuses ou difficiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea1c7d7-3fc3-4774-a987-afc1f2cb20d7",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Le courage, ce n’est pas de laisser aux mains de la force la solution des conflits que la raison peut résoudre ; car le courage est l’exaltation de l’homme et ceci en est l’abdication. Le courage pour vous tous, courage de toutes les heures, c'est de supporter sans fléchir les épreuves de tout ordre, physiques et morales, que prodigue la vie. Le courage, c’est de ne pas livrer sa volonté au hasard des impressions et des forces ; c’est de garder dans les lassitudes inévitables, l’habitude du travail et de l’action."
                                            },
                                            {
                                                "example_id": "a4cdb5a7-e9b0-4134-976b-b3bb056b5622",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Ce ne sont pas des considérations sur l’harmonie de l’Univers (même en personnifiant l’Univers), qui pourront donner aux hommes ce courage que Renan comparait à celui que possède le soldat montant à l’assaut."
                                            },
                                            {
                                                "example_id": "ec4e5ba5-b704-4736-85b1-9ea1414da6e0",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Acceptons que le courage militaire demeure l'apanage d'une caste enfantine et bruyante, et ne se répande pas, comme l'a fait la Légion d’honneur, son insigne, parmi les professeurs, les contrôleurs, les peintres..."
                                            },
                                            {
                                                "example_id": "7f508c04-bd2a-4777-a35d-d7a00fa38f9d",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Le curé de Gross-Aspern nous introduisit dans ce fameux cimetière où Français et Autrichiens se battirent ayant du sang jusqu’à mi-jambe, avec un courage et une persistance également glorieuses de part et d'autre."
                                            },
                                            {
                                                "example_id": "bc295733-b3b3-4f51-904a-85eb6cb2b54d",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Les généraux sont des gens qui manquent le plus complètement de courage qu'il y ait."
                                            },
                                            {
                                                "example_id": "c4b0d5de-cfee-447b-a14e-fd208def26fc",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Moi, j’étais ratatiné au fond de la voiture. Eux, mes compagnons, restaient d’un calme forcené. Ils tiraient par la portière avec une témérité insensée. J’ai compris, là, ce qu’était le courage : cette tranquillité absolue qui te fait vivre de tels instants comme un éblouissement."
                                            },
                                            {
                                                "example_id": "c06822bd-2be2-4c4d-95a7-3c095696ad0d",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Si, comme on le dit, le courage est l'art du commencement, la persévérance, elle, c'est l'art du recommencement."
                                            },
                                            {
                                                "example_id": "aa875763-f035-49e2-b5e5-e9244c3527d6",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Le courage se situe toujours quelque part entre l'audace et la couardise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669806ba-0643-3cd7-9759-9e563eccfa09",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "(Moderne) Capacité de ne pas avoir peur, face à une situation potentiellement effrayante (contraster avec sens nᵒ 1)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66687f1c-f1db-3e16-9763-f4123b319a3f",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Personnes courageuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6419db72-4582-4b25-8d3f-5c68c4fad5d2",
                                                "sense_id": "66687f1c-f1db-3e16-9763-f4123b319a3f",
                                                "text": "Enflammer les courages."
                                            },
                                            {
                                                "example_id": "8fa4de2d-f6e7-4d79-bd85-51114f9f724c",
                                                "sense_id": "66687f1c-f1db-3e16-9763-f4123b319a3f",
                                                "text": "Les grands courages ne se laissent point abattre par l’adversité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "162d5a9b-1e8d-3562-a1ab-f959f042c6b7",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Dureté de cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71c4520-824e-4035-a797-e19372368d20",
                                                "sense_id": "162d5a9b-1e8d-3562-a1ab-f959f042c6b7",
                                                "text": "Elle se dit qu'il fallait montrer aujourd'hui tout son courage, être comme ces femmes de la ville, ces grandes dames qui savent mépriser les hommes peu fidèles et regarder avec hauteur leur légèreté oublieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6f8a53-6902-3ee9-a902-fe71904ef984",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Capacité d'agir, de se donner à ce qu'on fait ou doit faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0c7ed6-d66f-4e4a-b2a4-824c7c20686e",
                                                "sense_id": "2d6f8a53-6902-3ee9-a902-fe71904ef984",
                                                "text": "On entend souvent les personnes fatiguées déclarer : « Je suis sans courage. » Le mot est ici synonyme d'énergie : pour en disposer, il faut que le corps soit en état. Sinon, le courage requis pour l'acte le plus simple devient disproportionné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                        "entry_id": "9c70c90c-4b58-3a0c-a4b7-c2764237131e",
                                        "glosses": [
                                            "Interjection servant à animer, à exciter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610fb0c0-22ef-407e-bfc1-52839197ca5f",
                                                "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                                "text": "Allons, courage !"
                                            },
                                            {
                                                "example_id": "ab4aaee2-951b-41a7-bbe0-826f1aa770b0",
                                                "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                                "text": "Courage, mes amis !"
                                            },
                                            {
                                                "example_id": "d04f134a-81b1-4c4e-b5e6-8687b0bbe054",
                                                "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                                "text": "Bon courage !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
