                "senses": [
                    {
                        "sense_id": "0de1b1a1-c44a-3fde-91e9-bd8d9cd0c036",
                        "entry_id": "87a0a011-a6e1-3d3b-85f1-647083036473",
                        "glosses": [
                            "Donner un caractère fleuri à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8fe519-b065-4168-b3f2-2e946ee1d519",
                                "sense_id": "0de1b1a1-c44a-3fde-91e9-bd8d9cd0c036",
                                "text": "Une singularité en apparence déroutante chez un peintre aussi réservé que Murillo, c’est de voir, à côté des légions d’anges et de madones dont il a enfleuri son œuvre, la troupe déguenillée de pauvres hères qu’il y a disséminée, dans quelques-unes de ses toiles fameuses."
                            },
                            {
                                "example_id": "0906abed-fd1e-446e-826c-853bfb1e2b12",
                                "sense_id": "0de1b1a1-c44a-3fde-91e9-bd8d9cd0c036",
                                "text": "Et les voisins voyaient Anita s’enfleurir d’une manière plaisante."
                            }
                        ]
                    }
                ],
