                    },
                    {
                        "translation_id": "007540b4-cf8c-448d-8bc7-60c85cedff94",
                        "source_entry_id": "7edb9698-4e4a-3712-9175-d955fa7369c1",
                        "source_sense_description": "надевать взамен одной обуви другую или, сняв обувь, надевать её удобнее, иначе",
                        "target_lang_word": "change",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "change",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17525a09-cd79-3f54-9226-5d9c4dbe0a2a",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To become something different."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34603bd2-cbd2-471b-a91e-3cb6f62127a8",
                                                "sense_id": "17525a09-cd79-3f54-9226-5d9c4dbe0a2a",
                                                "text": "The tadpole changed into a frog."
                                            },
                                            {
                                                "example_id": "76eea521-59ea-4c53-9441-cf0a6b11a077",
                                                "sense_id": "17525a09-cd79-3f54-9226-5d9c4dbe0a2a",
                                                "text": "Stock prices are constantly changing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "147a6a62-9baa-340f-a60d-1a2070b4898e",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To make something into something else."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2e4b5e-5bc2-49f3-95d9-9a7fdedacc05",
                                                "sense_id": "147a6a62-9baa-340f-a60d-1a2070b4898e",
                                                "text": "Lo I the man, whoſe Muſe whilome did maske,\nAs time her taught in lowly Shepheards weeds,\nAm now enforſt a far unfitter taske,\nFor trumpets ſterne to chaunge mine oaten reeds,\nAnd ſinge of Knights and Ladies gentle deeds[…]"
                                            },
                                            {
                                                "example_id": "c87821f8-7850-48b6-905f-62b226d4171b",
                                                "sense_id": "147a6a62-9baa-340f-a60d-1a2070b4898e",
                                                "text": "KORRIS: They shunned you. Cursed you. Called you vile names, and you knew not why. Even now do you know why you are driven? Why you cannot relent—or repent—or confess—or abstain? How could you know? There have been no other Klingons to lead you to that knowledge.\nWORF: Yes—yes—those feelings are still a part of me, but I control them. They do not rule me.\nKORRIS: Yes, to fit in, the humans demand you change the one thing that you cannot change. But because you cannot—you do. That too is the mark of the warrior."
                                            },
                                            {
                                                "example_id": "78485adf-0aa7-47f6-b7c7-093e1dccb417",
                                                "sense_id": "147a6a62-9baa-340f-a60d-1a2070b4898e",
                                                "text": "Of all the transitions brought about on the Earth’s surface by temperature change, the melting of ice into water is the starkest. It is binary. And for the land beneath, the air above and the life around, it changes everything."
                                            },
                                            {
                                                "example_id": "fba8e8be-2dd8-4287-a229-aa33d741ebf8",
                                                "sense_id": "147a6a62-9baa-340f-a60d-1a2070b4898e",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            },
                                            {
                                                "example_id": "c1462070-0070-42c9-a551-4afb5a8edc53",
                                                "sense_id": "147a6a62-9baa-340f-a60d-1a2070b4898e",
                                                "text": "The fairy changed the frog into a prince."
                                            },
                                            {
                                                "example_id": "e72ef5a8-5e43-4860-8647-bc0102671e2d",
                                                "sense_id": "147a6a62-9baa-340f-a60d-1a2070b4898e",
                                                "text": "I had to change the wording of the ad so it would fit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ed6867-3fc3-3c58-8f17-8892b09daf47",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To replace."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "415fc428-62ef-4751-9e86-6c6a5da84141",
                                                "sense_id": "e6ed6867-3fc3-3c58-8f17-8892b09daf47",
                                                "text": "Ask the janitor to come and change the lightbulb."
                                            },
                                            {
                                                "example_id": "31909477-3900-4c25-8467-4c8d50408d15",
                                                "sense_id": "e6ed6867-3fc3-3c58-8f17-8892b09daf47",
                                                "text": "After a brisk walk, I washed up and changed my shirt."
                                            },
                                            {
                                                "example_id": "e9b2bf67-68a4-4437-9442-00ec18d7aff1",
                                                "sense_id": "e6ed6867-3fc3-3c58-8f17-8892b09daf47",
                                                "text": "Towards the end of the nineteenth century, boys who had pretended soldiers down through the centuries, now changed their pikes and swords for toy pistols."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45e1689a-e864-3c83-8608-aab03b28f656",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To replace one's clothing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1748b5d-d887-4975-b0c7-4d4a344de193",
                                                "sense_id": "45e1689a-e864-3c83-8608-aab03b28f656",
                                                "text": "You can't go into the dressing room while she’s changing."
                                            },
                                            {
                                                "example_id": "c4c933f6-386a-4711-bcf7-2edfc83107fb",
                                                "sense_id": "45e1689a-e864-3c83-8608-aab03b28f656",
                                                "text": "The clowns changed into their costumes before the circus started."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e8a728-86ef-3e4f-93be-e86783657762",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To replace the clothing of (the one wearing it), especially to put a clean diaper on (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cfef627-b211-415f-89eb-4cbdb152d0ef",
                                                "sense_id": "f7e8a728-86ef-3e4f-93be-e86783657762",
                                                "text": "It’s your turn to change the baby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce41d560-d9bb-3de5-923f-e74b57647123",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To transfer to another vehicle (train, bus, etc.)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73778caf-8a58-471f-af2b-d4cf692a1c93",
                                                "sense_id": "ce41d560-d9bb-3de5-923f-e74b57647123",
                                                "text": "After stopping at these stations, my train has become busy. Returning day-trippers make up a goodly number, along with young people heading for a night out in Bristol, which is where I change once again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1cd63e0-7fa7-34cb-9109-593ddf22f646",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To exchange."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80005752-e2bc-48a1-a9b0-09b11136535e",
                                                "sense_id": "d1cd63e0-7fa7-34cb-9109-593ddf22f646",
                                                "text": "At the first sight / they have changed eyes. (exchanged looks)"
                                            },
                                            {
                                                "example_id": "2a1fa223-4cf7-4982-8f6d-7886cb3db6d8",
                                                "sense_id": "d1cd63e0-7fa7-34cb-9109-593ddf22f646",
                                                "text": "I would give any thing to change a word or two with this person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488e4984-05ea-39d4-a8ff-8a3b68ba2c07",
                                        "entry_id": "c69f3fad-aca5-3d27-a181-1ff4b0015263",
                                        "glosses": [
                                            "To change hand while riding (a horse)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "023774a2-cf18-4183-bfde-2ec26f5276cf",
                                                "sense_id": "488e4984-05ea-39d4-a8ff-8a3b68ba2c07",
                                                "text": "to change a horse"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "change",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6feb4e23-0cd4-3702-bc50-16843ac0fe38",
                                        "entry_id": "0ecbad3e-1a6d-3175-9611-39e38b79f4ab",
                                        "glosses": [
                                            "The process of becoming different."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69ad5bca-2ff0-4db7-b72e-e9c4f47b7fdd",
                                                "sense_id": "6feb4e23-0cd4-3702-bc50-16843ac0fe38",
                                                "text": "The product is undergoing a change in order to improve it."
                                            },
                                            {
                                                "example_id": "974ee676-9176-4781-aa5c-6b8e5693793b",
                                                "sense_id": "6feb4e23-0cd4-3702-bc50-16843ac0fe38",
                                                "text": "Cause people often talk about being scared of change / But for me I'm more afraid of things staying the same"
                                            },
                                            {
                                                "example_id": "b7fb592c-4ad0-4c7a-963d-a3c0af383479",
                                                "sense_id": "6feb4e23-0cd4-3702-bc50-16843ac0fe38",
                                                "text": "Of all the transitions brought about on the Earth’s surface by temperature change, the melting of ice into water is the starkest. It is binary. And for the land beneath, the air above and the life around, it changes everything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d5a018-df9b-3ea3-ada7-ea98f02c0bb0",
                                        "entry_id": "0ecbad3e-1a6d-3175-9611-39e38b79f4ab",
                                        "glosses": [
                                            "Small denominations of money given in exchange for a larger denomination."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecd2070-aeb3-4910-874f-4bca85fa4ce6",
                                                "sense_id": "11d5a018-df9b-3ea3-ada7-ea98f02c0bb0",
                                                "text": "Can I get change for this $100 bill, please?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d252e1a0-2e0a-3f5f-935c-a33a3c2e1c8c",
                                        "entry_id": "0ecbad3e-1a6d-3175-9611-39e38b79f4ab",
                                        "glosses": [
                                            "A replacement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfd07e8-8d6b-4522-9f3d-3b84d0f3186f",
                                                "sense_id": "d252e1a0-2e0a-3f5f-935c-a33a3c2e1c8c",
                                                "text": "a change of clothes"
                                            },
                                            {
                                                "example_id": "f0a004ac-7a35-4d82-bdd6-f976030f2388",
                                                "sense_id": "d252e1a0-2e0a-3f5f-935c-a33a3c2e1c8c",
                                                "text": "After beating champions Chelsea 3-1 on Boxing Day, Arsenal boss Arsene Wenger made eight changes to his starting XI in an effort to freshen things up, with games against Birmingham and Manchester City to come in the next seven days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a4e6afa-49e4-3f5d-ac7b-6e0102f1d7b6",
                                        "entry_id": "0ecbad3e-1a6d-3175-9611-39e38b79f4ab",
                                        "glosses": [
                                            "Balance of money returned from the sum paid after deducting the price of a purchase."
