                "senses": [
                    {
                        "sense_id": "3f843bf0-803d-3868-a0d6-8ee9749414e4",
                        "entry_id": "57f2e996-f2db-3455-a11e-c9372e20cb6c",
                        "glosses": [
                            "anesthetic"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "43fa7184-fff9-466a-9f3f-bf8c33bc1794",
                                "sense_id": "3f843bf0-803d-3868-a0d6-8ee9749414e4",
                                "text": "Die Zuführung des Narkotikums geschieht vorwiegend durch die Atemwege: in geeigneten Masken, welche Mund und Nase bedecken, verdampft das Betäubungsmittel und wird mit der Atemluft aufgenommen.",
                                "translation": "The administration of the anesthetic mainly happens through the respiratory system: in suitable masks, which cover mouth and nose, the narcotic substance evaporates and is absorbed with the breathing air.",
                                "english": "The administration of the anesthetic mainly happens through the respiratory system: in suitable masks, which cover mouth and nose, the narcotic substance evaporates and is absorbed with the breathing air."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ccbce89-e06a-31af-8285-a5afa313e2a3",
                        "entry_id": "57f2e996-f2db-3455-a11e-c9372e20cb6c",
                        "glosses": [
                            "narcotic"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e77f869a-2382-4064-b47b-b108944c8143",
                                "sense_id": "1ccbce89-e06a-31af-8285-a5afa313e2a3",
                                "text": "Doktor Bresser hatte mir ein leichtes Narkotikum eingegeben, damit ein langer und fester Schlaf meine durch die Erlebnisse von Horonewos so erschütterten Nerven wieder einigermaßen beruhige.",
                                "translation": "Doctor Bresser had administered me a light narcotic, such that a long and deep sleep would somewhat calm down my nerves distressed by the experiences at Horonewos.",
                                "english": "Doctor Bresser had administered me a light narcotic, such that a long and deep sleep would somewhat calm down my nerves distressed by the experiences at Horonewos."
                            }
                        ]
                    }
                ],
