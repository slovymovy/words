                "senses": [
                    {
                        "sense_id": "ae1f3981-c5be-3bfb-b833-c529cf41dae4",
                        "entry_id": "f994eaae-f326-30b3-b27d-4c5ac5062580",
                        "glosses": [
                            "Herrschaftsbeziehung, welche durch Zerstörung, Unterbindung und Umformung der ursprünglichen Kultur der Beherrschten bei gleichzeitiger Dominanz der Kultur der allgemein imperialistisch Herrschenden praktiziert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3da735c-b748-42db-950d-aca533095d40",
                                "sense_id": "ae1f3981-c5be-3bfb-b833-c529cf41dae4",
                                "text": "„Von den Briten wurde erwartet, dass sie Palästina kulturell entwickelten, aber im Gegensatz zum Kulturimperialismus Frankreichs strebten sie nicht danach, den Kolonien ihre Werte oder ihre Identität aufzudrängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
