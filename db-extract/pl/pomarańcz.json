                                        "sense_id": "8e92a751-c6d2-327d-9917-07db53ad3efd",
                                        "entry_id": "44548136-a01d-322f-9a3e-304d47b1b8f5",
                                        "glosses": [
                                            "An evergreen tree of the genus Citrus such as Citrus sinensis which yields oranges (the fruit)."
                                        ],
