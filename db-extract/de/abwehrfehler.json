                        "glosses": [
                            "Missgeschick/Fehler, der den Verteidigern unterlaufen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89fc2e5-8ecf-45eb-bf16-c852d4036a64",
                                "sense_id": "aeab8e6b-681a-3210-86ea-b910a103eb1f",
                                "text": "„Panamas einzige Großchance bot sich Michael Murillo, der nach einem Abwehrfehler Belgiens frei vor dem Tor stand, doch an Keeper Thibaut Courtois scheiterte (53.).“"
                            },
                            {
                                "example_id": "8798e6f8-aebe-4b99-b680-8d3c64146571",
                                "sense_id": "aeab8e6b-681a-3210-86ea-b910a103eb1f",
                                "text": "„Julian Nagelsmann hat zu viel gewagt: Nach ganz viel Offensivpower und haarsträubenden Abwehrfehlern hat die deutsche Nationalmannschaft ausgerechnet bei der emotionalen Heimpremiere die erste Niederlage unter dem neuen Bundestrainer kassiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
