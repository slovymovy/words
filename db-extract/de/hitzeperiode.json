                ],
                "senses": [
                    {
                        "sense_id": "1e63ec96-bf68-3d3e-b279-0f214ea45cbb",
                        "entry_id": "aebc1b75-f886-387c-9914-8c76c2035ee8",
                        "glosses": [
                            "langer Zeitraum mit sehr heißen Tagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a77c2747-9d71-4192-83a4-dd084af6c71f",
                                "sense_id": "1e63ec96-bf68-3d3e-b279-0f214ea45cbb",
                                "text": "„Die Hitzeperiode der letzten Tage hat nicht nachgelassen.“"
                            },
                            {
                                "example_id": "c42813d2-36c0-49f1-8115-b1462de24b43",
                                "sense_id": "1e63ec96-bf68-3d3e-b279-0f214ea45cbb",
                                "text": "„Eine Hitzeperiode ist vor allem im städtischen Bereich schlimm: Im Vergleich zum Umland liegen die Temperaturen in der Stadt durchschnittlich um 5-10°C höher.“"
                            },
                            {
                                "example_id": "add03d7f-b7a9-4c80-83a2-ab082bba56bc",
                                "sense_id": "1e63ec96-bf68-3d3e-b279-0f214ea45cbb",
                                "text": "„Nach dem Ende der Hitzeperiode mit Gewittern und sintflutartigem Regen verwandelte die Feuchtigkeit das Gewirr der engen Wege und Gassen abseits der großen Straßen in ein Dampad unter freiem Himmel.“"
                            },
                            {
                                "example_id": "1a86753e-cc57-4f29-9675-87debf59ef9f",
                                "sense_id": "1e63ec96-bf68-3d3e-b279-0f214ea45cbb",
                                "text": "„Wenn die Sonne in einer Hitzeperiode ausdauernd scheint, riechen Nadelwälder besonders intensiv ‚nach Harz‘, wie viele Laien meinen.“"
                            },
                            {
                                "example_id": "3bb5f739-cab3-4d12-aa18-a9dfd8384fae",
                                "sense_id": "1e63ec96-bf68-3d3e-b279-0f214ea45cbb",
                                "text": "„Der in den Sommermonaten einsetzende Monsun beendet dann die Hitzeperiode.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
