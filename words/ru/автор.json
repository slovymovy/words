    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2aead4f-d3d5-3521-be79-7869f800aec9",
                    "sense_definition": "Создатель литературного или иного художественного произведения, научного труда, проекта или изобретения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creator_originator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот писатель — <w>автор</w> многих известных романов.",
                            "target_lang_translations": {
                                "en": "This writer is the <w>author</w> of many famous novels.",
                                "zh": "这位作家是许多著名小说的<w>作者</w>。"
                            }
                        },
                        {
                            "text": "Мы лично встретились с <w>автором</w> этого уникального изобретения.",
                            "target_lang_translations": {
                                "en": "We personally met with the <w>creator</w> of this unique invention.",
                                "zh": "我们亲自见到了这项独特发明的<w>创作者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "создатель",
                        "творец",
                        "сочинитель",
                        "разработчик"
                    ],
                    "antonyms": [
                        "разрушитель"
                    ],
                    "common_phrases": [
                        "автор книги",
                        "автор проекта",
                        "права автора",
                        "известный автор"
                    ],
                    "target_lang_definitions": {
                        "en": "The creator of a literary or artistic work, scientific study, project, or invention.",
                        "zh": "文学、艺术作品、科学研究、项目或发明的创作者。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "author",
                                "target_lang_sense_clarification": "general term for a creator of a work"
                            },
                            {
                                "target_lang_word": "writer",
                                "target_lang_sense_clarification": "specifically for books or articles"
                            },
                            {
                                "target_lang_word": "creator",
                                "target_lang_sense_clarification": "of an invention or project"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作者",
                                "target_lang_sense_clarification": "指文学或艺术作品的创作者"
                            },
                            {
                                "target_lang_word": "创作者",
                                "target_lang_sense_clarification": "指发明或项目的发起者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adfd7064-811b-30ae-a061-bcb8f291bfa4",
                    "sense_definition": "Тот, кто совершил какое-либо действие, придумал или организовал что-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creator_originator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель пытался выяснить, кто <w>автор</w> беспорядка в классе.",
                            "target_lang_translations": {
                                "en": "The teacher tried to find out who was the <w>creator</w> of the mess in the classroom.",
                                "zh": "老师试图查明教室里混乱的<w>始作俑者</w>是谁。"
                            }
                        },
                        {
                            "text": "Кто <w>автор</w> этой замечательной идеи для праздника?",
                            "target_lang_translations": {
                                "en": "Who is the <w>author</w> of this wonderful idea for the party?",
                                "zh": "这个精彩的派对点子的<w>发起人</w>是谁？"
                            }
                        }
                    ],
                    "synonyms": [
                        "организатор",
                        "задумщик"
                    ],
                    "common_phrases": [
                        "автор гола",
                        "автор идеи"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The person who originates an idea, organizes an event, or is responsible for a specific action.",
                        "zh": "提出某种想法、组织某项活动或对某事负有责任的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "author",
                                "target_lang_sense_clarification": "of an idea or plan"
                            },
                            {
