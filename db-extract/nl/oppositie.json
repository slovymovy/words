                        "sense_id": "6e8f20db-3e8c-3b83-8d22-3275924b868f",
                        "entry_id": "3d748c2b-9167-36d7-8ba8-1eb6a9243bea",
                        "glosses": [
                            "parliamentary opposition (non-government factions in parliament)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "7a13bae3-a1fe-4e9c-b6b6-4412ab9de53f",
                                "sense_id": "6e8f20db-3e8c-3b83-8d22-3275924b868f",
                                "text": "De oppositie heeft zich tegen het wetsvoorstel uitgesproken tijdens het debat.",
                                "translation": "The parliamentary opposition voiced their opposition to the bill during the debate.",
                                "english": "The parliamentary opposition voiced their opposition to the bill during the debate."
                            },
                            {
                                "example_id": "97dc5a22-7430-4571-b1d5-5c346ebeb8c2",
                                "sense_id": "6e8f20db-3e8c-3b83-8d22-3275924b868f",
                                "text": "De stemmen van de oppositie waren unaniem tegen het besluit.",
                                "translation": "The votes of the parliamentary opposition were unanimous against the decision.",
                                "english": "The votes of the parliamentary opposition were unanimous against the decision."
                            }
                        ]
                    },
                    {
                        "sense_id": "aaed9fc5-5110-3a43-9443-10f88c3faa5c",
                        "entry_id": "3d748c2b-9167-36d7-8ba8-1eb6a9243bea",
                        "glosses": [
                            "opposition, resistance"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "0ac820b0-0509-4e20-b77e-d4d12d84cd58",
                                "sense_id": "aaed9fc5-5110-3a43-9443-10f88c3faa5c",
                                "text": "De oppositie groeit onder de bevolking vanwege de verslechterende economie.",
                                "translation": "The opposition is growing among the population due to the deteriorating economy.",
                                "english": "The opposition is growing among the population due to the deteriorating economy."
                            },
                            {
                                "example_id": "046e0eea-9670-47dc-b271-d2e9821a0f82",
                                "sense_id": "aaed9fc5-5110-3a43-9443-10f88c3faa5c",
                                "text": "De vakbonden voeren actie om hun oppositie tegen de nieuwe arbeidswet te tonen.",
                                "translation": "The unions are taking action to show their opposition to the new labor law.",
                                "english": "The unions are taking action to show their opposition to the new labor law."
                            },
                            {
                                "example_id": "6df854c1-999a-4e0b-85a1-4095eb3b8c87",
                                "sense_id": "aaed9fc5-5110-3a43-9443-10f88c3faa5c",
                                "text": "Er is veel oppositie vanuit de oppositiepartijen tegen het voorstel.",
                                "translation": "There is a lot of opposition from the opposition parties against the proposal.",
                                "english": "There is a lot of opposition from the opposition parties against the proposal."
                            }
                        ]
                    }
