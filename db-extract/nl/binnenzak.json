                                        "entry_id": "025961be-8cc7-3f56-8b16-ca0e5baa9912",
                                        "glosses": [
                                            "Contenant spécifique inclus dans un plus grand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa2a203-1885-4f7e-912c-3b8af5c78ff6",
                                                "sense_id": "fb1c3a7c-e373-3bfb-af33-46c7d5646da9",
                                                "text": "La hauteur à laquelle le ballon sera parvenu à ce moment où la poche intérieure terminera ainsi l’évacuation de son air […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63475d8-1020-3b9f-87bc-2afc196c4f4b",
                                        "entry_id": "025961be-8cc7-3f56-8b16-ca0e5baa9912",
                                        "glosses": [
                                            "Poche confectionnée à l’intérieur d’une veste ou un blouson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e0e486-531e-491a-aed4-014937689061",
                                                "sense_id": "a63475d8-1020-3b9f-87bc-2afc196c4f4b",
                                                "text": "Pourtant, ces parties de la veste bleue étaient, semble-t-il, intactes, alors que la seule poche intérieure était raide de sang coagulé."
                                            }
                                        ]
                                    }
