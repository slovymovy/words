                    }
                ],
                "senses": [
                    {
                        "sense_id": "319523e9-7cb4-3f65-aede-743b7851a276",
                        "entry_id": "50bc64ec-86b8-3f40-8ae2-c9bd913b9d2c",
                        "glosses": [
                            "книжн. действие по значению гл. призреть; забота о ком-либо, опека кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e88010a8-182b-41de-bbc0-a740a6b4b254",
                                "sense_id": "319523e9-7cb4-3f65-aede-743b7851a276",
                                "text": "Призре́ние бе́дных, не́мощных есть долг прави́тельства: где, ско́лько богаде́лен, воспита́тельных домо́в и́ли для роди́льниц."
                            },
                            {
                                "example_id": "bf2b76c4-89bf-4700-9683-e05f9f22b0df",
                                "sense_id": "319523e9-7cb4-3f65-aede-743b7851a276",
                                "text": "Здесь всё предано огню, повсюду пустота, кучи мёртвых от болезни французов находим на дорогах; больные их оставлены по деревням брошенными, без пищи, без одежды, без призрения."
                            },
                            {
                                "example_id": "428b4ef3-d46d-4596-987c-1ff2571692a7",
                                "sense_id": "319523e9-7cb4-3f65-aede-743b7851a276",
                                "text": "При мне-с не имеется, потому что деньги мои, если изволите знать, положены в приказ общественного призрения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b04087e-44e9-49fa-a558-1d1164ff9422",
                        "source_entry_id": "50bc64ec-86b8-3f40-8ae2-c9bd913b9d2c",
                        "source_sense_id": "319523e9-7cb4-3f65-aede-743b7851a276",
                        "target_lang_word": "assistance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assistance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2737745c-c35d-3118-ba19-94d1ec874b98",
                                        "entry_id": "fbad7b71-9832-3eec-b06e-279f1e7d9abe",
                                        "glosses": [
                                            "Présence."
                                        ],
                                        "tags": [],
                                        "note": "Il est surtout usité en parlant de la présence d’un officier public ou d’un ecclésiastique dans quelqu’une des fonctions de leur ministère",
                                        "examples": [
                                            {
                                                "example_id": "bd6b192c-c2bb-4338-8e9f-e9b928d0115d",
                                                "sense_id": "2737745c-c35d-3118-ba19-94d1ec874b98",
                                                "text": "On lui donne tant pour son droit d’assistance, pour son assistance. Les chanoines ont un droit d’assistance aux enterrements, aux offices, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0aaf41-0d74-3305-80b0-f0fbf2655b1e",
                                        "entry_id": "fbad7b71-9832-3eec-b06e-279f1e7d9abe",
                                        "glosses": [
                                            "Public ou ensemble des personnes assemblées en un lieu."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c5132fa-da19-4120-b14d-c2996a36ddb9",
                                                "sense_id": "ab0aaf41-0d74-3305-80b0-f0fbf2655b1e",
                                                "text": "Les musiciens tirèrent de leurs instruments un air brutal et voluptueux qui, aussitôt, pénétra l'assistance d'une fiévreuse pâmoison."
                                            },
                                            {
                                                "example_id": "75818311-1d1c-4bdd-8ec5-57178f25c33d",
                                                "sense_id": "ab0aaf41-0d74-3305-80b0-f0fbf2655b1e",
                                                "text": "Dans la rue, un son de cor a éclaté, un air de chasse… Apparemment, quelque piqueur de grande maison, debout près d’un comptoir de cabaret, les joues gonflées, la bouche impérieusement serrée, l’air féroce, émerveille et fait taire l’assistance."
                                            },
                                            {
                                                "example_id": "310e16e6-c0f9-47d6-b203-f37c4e74aa03",
                                                "sense_id": "ab0aaf41-0d74-3305-80b0-f0fbf2655b1e",
                                                "text": "S'accompagnant de son gimbri, il nous chante, d'une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70d2d74-fbed-319f-b5d6-79e7381725ed",
                                        "entry_id": "fbad7b71-9832-3eec-b06e-279f1e7d9abe",
                                        "glosses": [
                                            "Aide, secours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a0781b-52d6-460d-bf3a-8a715a60acfb",
                                                "sense_id": "b70d2d74-fbed-319f-b5d6-79e7381725ed",
                                                "text": "Le conseil général du Gard […] est toujours « allé de l’avant ». Il institua l’assistance aux familles nombreuses avant même le vote d’aucune loi en ce sens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bebffb9c-0ad3-3c76-b91a-9043f87b9d4b",
                                        "entry_id": "fbad7b71-9832-3eec-b06e-279f1e7d9abe",
                                        "glosses": [
                                            "Dans quelques ordres religieux, état ou province où se trouve celui qui assiste le général ou le provincial de son ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a8b432-1e89-47b7-84ea-01267b1bb9c3",
                                                "sense_id": "bebffb9c-0ad3-3c76-b91a-9043f87b9d4b",
                                                "text": "L’ordre des jésuites a tant de provinces sous l’assistance d’Italie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
