                                                "example_id": "b7aab97c-d765-44bb-baeb-507697978add",
                                                "sense_id": "21c93272-beea-312b-8536-856d26f6fee3",
                                                "text": "Being on a team is hard: you're always having to go to practice while everyone else is taking it easy."
                                            },
