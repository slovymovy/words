                                        "entry_id": "26b5770e-a12b-35fb-a882-2ac9872f7f93",
                                        "glosses": [
                                            "A female given name from French borrowed from France, in regular use since the twentieth century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15beb6ea-622b-4ebd-a61e-97fb96bc0355",
                                                "sense_id": "516a1bb2-947e-3b81-a91a-156747a573e2",
                                                "text": "In your mother's apple orchard\nWhen the world was left behind:\nYou were shy, so shy, Yvonne!\nBut your eyes were calm and kind."
                                            }
                                        ]
                                    }
                                ]
