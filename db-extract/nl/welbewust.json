                                        "sense_id": "228c8abf-55bc-314c-875a-ad2929bf5913",
                                        "entry_id": "7199e28e-6042-3453-bc31-16bdc1514ebf",
                                        "glosses": [
                                            "The part of the mind that is aware of itself; the consciousness."
                                        ],
