                        "examples": [
                            {
                                "example_id": "d26574c3-2fb2-4eb1-bb85-85fdff604ae3",
                                "sense_id": "305bf396-18cb-34c6-a470-614950904726",
                                "text": "Per jaar komen er 180.000 baby's bij en iets minder dan 160.000 immigranten. Hiertegenover gaan er per jaar circa 140.000 mensen dood en en zijn er ongeveer evenveel emigranten."
                            },
                            {
                                "example_id": "9afd47ba-a798-4ba1-a2ba-afd9b18c7ff2",
                                "sense_id": "305bf396-18cb-34c6-a470-614950904726",
                                "text": "In het artikel van Mark Steyn bespreekt hij de ramp met de Concordia en hoe chaotisch de evacuatie verliep. Hiertegenover moeten we volgens hem het verhaal van de Titanic stellen, waar mannen 'leugenaars en dieven, rijk en machtig, arm en onbekend' allen 'stijlvol ten onder gaan'. Met de mentaliteit van de Titanic komen we door een crisis, niet met die van de Concordia, aldus Steyn."
                            },
                            {
                                "example_id": "4998a74f-b1be-46d6-8536-d119d895e1f2",
                                "sense_id": "305bf396-18cb-34c6-a470-614950904726",
                                "text": "Opvallende constatering is dat het aantal viswinkels met ruim 30 procent steeg tussen 2008 en 2017. Hiertegenover staat dat groentewinkels, slagers, slijters en tabakswinkels minder in trek zijn en deze winkels uit het straatbeeld lijken te verdwijnen."
                            }
                        ]
                    }
