                            {
                                "example_id": "e9906441-cb71-4169-babf-fc9b7e44ae7b",
                                "sense_id": "bed417e5-78c6-3804-992e-333224ba174a",
                                "text": "Gegen die Unregelmäßigkeit im Zahnstand hilft eine Zahnspange."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a20214f2-adc7-38a3-b752-80cc4cf1aa60",
                        "entry_id": "c81bb08c-ea11-3de0-93b9-29d031238ce0",
                        "glosses": [
                            "mangelnde Übereinstimmung mit geltenden Regeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db2f7eda-ba9b-4838-9317-c78c391aa209",
                                "sense_id": "a20214f2-adc7-38a3-b752-80cc4cf1aa60",
                                "text": "„Meine Beobachtungen in natürlicher Umgebung, das heißt außerhalb von Testsituationen, bestätigen die Vermutung, daß Kinder vor fünf vor allem auf semantische Unregelmäßigkeiten reagieren, die sich in der Wortwahl zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "eb2dfa1f-d949-33b4-ac49-06fe110a6a0f",
                        "entry_id": "c81bb08c-ea11-3de0-93b9-29d031238ce0",
                        "glosses": [
                            "Verletzung rechtlicher Normen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97a9934-9276-416a-b123-0ae282431b58",
                                "sense_id": "eb2dfa1f-d949-33b4-ac49-06fe110a6a0f",
                                "text": "Im Vereinsvorstand ist es zu Unregelmäßigkeiten gekommen."
                            }
                        ],
