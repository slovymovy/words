                "senses": [
                    {
                        "sense_id": "9db7206c-be4c-33ef-ba5d-2f09323aaef6",
                        "entry_id": "1e6e0f62-a835-335c-b3e0-ef50f3fcee88",
                        "glosses": [
                            "Donner un caractère hobbesien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f70b6c-7fa5-44b2-9b88-272b0ed2199e",
                                "sense_id": "9db7206c-be4c-33ef-ba5d-2f09323aaef6",
                                "text": "Qu’est-ce que tu appelles hobbesianiser Spinoza ?"
                            },
                            {
                                "example_id": "23562e56-4b5f-4928-8127-ac36fd549517",
                                "sense_id": "9db7206c-be4c-33ef-ba5d-2f09323aaef6",
                                "text": "Cet argument ne peut être une critique de Descartes, mais de ceci qu’il n’a pas usé de toutes les ressources dont disposait sa philosophie contre une lecture hobbesianisée de ses propres thèses —lecture que Boyle ne fait pas, mais dont il identifie le risque."
                            }
                        ]
                    }
