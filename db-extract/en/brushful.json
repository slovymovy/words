                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fabcbb9-3122-4427-badc-247208565833",
                                "sense_id": "58b70db8-9fbd-3e48-af39-483b511e833f",
                                "text": "Fougère Royale (Royal Fern) Shaving Cream absorbs brushesful of water and whips up a close, fine-textured, beard-softening lather with the refreshing odor of Royal Fern."
                            },
                            {
                                "example_id": "2e4e4011-d49c-42a6-91b6-253a707674ce",
                                "sense_id": "58b70db8-9fbd-3e48-af39-483b511e833f",
                                "text": "Dip your brush into the paint and transfer two or three brushesful onto the palette."
                            },
                            {
                                "example_id": "2a00b8e1-71f8-49d1-a026-cbeab5b9a9cb",
                                "sense_id": "58b70db8-9fbd-3e48-af39-483b511e833f",
                                "text": "Finally, remembering their patience with the fenced sycamore, I resolved to give the cottonwood trunk a few brushesful every few months just on principle."
                            },
                            {
                                "example_id": "6bea991b-921a-49b5-aacc-6c599775991e",
                                "sense_id": "58b70db8-9fbd-3e48-af39-483b511e833f",
                                "text": "Legs dangle and pinwheel in the light morning breeze and the head sags over as Dan Bergeron slops a thick, opaque brushful of wheat paste across the chest, pinning it to the ragged brick."
                            }
                        ]
