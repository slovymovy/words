{
    "word_family": [
        "dialogue",
        "dialoguiste"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91066ac1-9c25-3833-aa7f-cbeb32c822d6",
                    "sense_definition": "Converser, discuter ou échanger des idées avec une ou plusieurs personnes afin de trouver un terrain d'entente.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est essentiel de <w>dialoguer</w> calmement pour résoudre ce conflit familial."
                        },
                        {
                            "text": "Les deux délégations ont accepté de <w>dialoguer</w> afin de trouver un accord de paix durable."
                        }
                    ],
                    "synonyms": [
                        "converser",
                        "discuter",
                        "échanger"
                    ],
                    "antonyms": [
                        "monologuer"
                    ],
                    "common_phrases": [
                        "dialoguer avec quelqu'un"
                    ]
                },
                {
                    "sense_id": "f8792267-c40a-389b-b440-a8f155c1744a",
                    "sense_definition": "Échanger des répliques, en parlant des personnages ou des comédiens dans une œuvre théâtrale ou dramatique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur scène, les deux comédiens <w>dialoguent</w> avec beaucoup de justesse et d'émotion."
                        },
                        {
                            "text": "Le dramaturge sait parfaitement faire <w>dialoguer</w> ses personnages tout au long du récit."
                        }
                    ],
                    "synonyms": [
                        "donner la réplique"
                    ],
                    "common_phrases": [
                        "faire dialoguer les personnages"
                    ]
                },
                {
                    "sense_id": "a9fe6190-8bbc-36dd-90aa-c5dc856725ec",
                    "sense_definition": "En musique ou dans les arts, alterner et se répondre harmonieusement, en parlant de voix, d'instruments ou d'éléments visuels.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce concerto, le compositeur fait <w>dialoguer</w> le violon et le piano avec virtuosité."
                        },
                        {
                            "text": "Les deux chanteuses <w>dialoguent</w> tout au long du duo d'opéra."
                        }
                    ],
                    "synonyms": [
                        "se répondre"
                    ],
                    "common_phrases": [
                        "faire dialoguer deux instruments",
                        "faire dialoguer les voix"
                    ]
                },
                {
                    "sense_id": "29bc2a5b-335d-3c75-8751-6134b09145f1",
                    "sense_definition": "Mettre sous forme de dialogues, rédiger les échanges parlés d'un scénario ou d'une œuvre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce célèbre auteur a <w>dialogué</w> de nombreux chefs-d'œuvre du cinéma classique."
                        },
                        {
                            "text": "Il est plus facile d'imaginer une intrigue que de <w>dialoguer</w> convenablement une scène de comédie."
                        }
                    ],
                    "common_phrases": [
                        "dialoguer un film"
                    ]
                }
            ]
        }
    ]
}