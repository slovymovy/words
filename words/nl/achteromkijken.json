{
    "word_family": [
        "kijken",
        "omkijken",
        "achterom"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c972ba18-6f06-3d40-acf2-62ab6c14aa79",
                    "sense_definition": "het hoofd of bovenlijf draaien om naar achteren te kijken",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "visuele_waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ze haar naam hoorde roepen, <w>keek</w> ze even verbaasd <w>achterom</w>.",
                            "target_lang_translations": {
                                "en": "When she heard her name called, she <w>looked back</w> briefly in surprise."
                            }
                        },
                        {
                            "text": "Fietsers moeten altijd goed <w>achteromkijken</w> voordat ze links afslaan.",
                            "target_lang_translations": {
                                "en": "Cyclists should always <w>look behind them</w> carefully before turning left."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkijken"
                    ],
                    "antonyms": [
                        "vooruitkijken"
                    ],
                    "common_phrases": [
                        "even achteromkijken",
                        "angstig achteromkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn one's head or upper body to look behind oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look back",
                                "target_lang_sense_clarification": "physically look behind"
                            },
                            {
                                "target_lang_word": "look behind",
                                "target_lang_sense_clarification": "turn to check behind oneself"
                            },
                            {
                                "target_lang_word": "look over one's shoulder",
                                "target_lang_sense_clarification": "turn head to look backward"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70e6b9ed-d8ce-3488-85a7-4deeb2b5c9ce",
                    "sense_definition": "terugdenken aan het verleden, vaak met spijt, bezorgdheid of weemoed",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_beschouwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten ons richten op de toekomst en niet steeds met spijt <w>achteromkijken</w>.",
                            "target_lang_translations": {
                                "en": "We must focus on the future and not keep <w>looking back</w> with regret."
                            }
                        },
                        {
                            "text": "Hij sloot dat moeilijke hoofdstuk af en <w>keek</w> daarna nooit meer <w>achterom</w>.",
                            "target_lang_translations": {
                                "en": "He closed that difficult chapter and never <w>looked back</w> after that."
                            }
                        }
                    ],
                    "synonyms": [
                        "terugblikken",
                        "terugkijken"
                    ],
                    "antonyms": [
                        "vooruitkijken"
                    ],
                    "common_phrases": [
                        "niet meer achteromkijken",
                        "met weemoed achteromkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to reflect on the past, often with regret, concern, or nostalgia"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look back",
                                "target_lang_sense_clarification": "reflect on the past or reconsider"
                            },
                            {
                                "target_lang_word": "look back with regret",
                                "target_lang_sense_clarification": "dwell on past events regretfully"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}