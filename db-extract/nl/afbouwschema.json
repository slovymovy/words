                    {
                        "sense_id": "f271520a-13f1-3760-ac42-a665a0709509",
                        "entry_id": "9d653efc-e0e0-3903-8269-9beb5f29858b",
                        "glosses": [
                            "een goed uitgewerkt plan om met iets geleidelijk te kunnen stoppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23bd5b60-89d4-4f49-874e-d7ec47a719a0",
                                "sense_id": "f271520a-13f1-3760-ac42-a665a0709509",
                                "text": "Afgelopen jaar onderzocht Het Instituut voor Onderzoek naar Leefwijzen & Verslaving in acht huisartsenpraktijken hoe patiënten hun slaapmedicatie het beste kunnen afbouwen. Ze kregen voorlichtingsmateriaal opgestuurd, gingen op gesprek en hielden in dagboekjes hun afbouwschema bij. Hoewel het onderzoek nog niet afgerond is, constateren de onderzoekers dat weinig mensen lijken te stoppen."
                            },
                            {
                                "example_id": "a8157df8-9f45-4aa5-93c8-2d6dff0db8a1",
                                "sense_id": "f271520a-13f1-3760-ac42-a665a0709509",
                                "text": "Het kabinet grijpt in om het alarmerende gebruik van verslavende pijnstillers in te tomen. Herhaalrecepten mogen niet langer doodnormaal zijn, gebruikers moeten een afbouwschema krijgen en alternatieve pijnbestrijding dient meer in beeld te komen, zo werd in februari bekend."
                            }
                        ]
                    }
