                "senses": [
                    {
                        "sense_id": "bdc682be-7e67-34b5-9889-78e823117b16",
                        "entry_id": "43152511-0380-3e51-83f3-23ea7e0ff358",
                        "glosses": [
                            "Étude de l’addiction, spécialité de l’addictologue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9449be48-125e-422c-ac6a-7074673c05c1",
                                "sense_id": "bdc682be-7e67-34b5-9889-78e823117b16",
                                "text": "Les termes : « capacité de toxicomanies et alcoologie : deux ans » sont remplacés par : « capacité d’addictologie clinique : deux ans »"
                            },
                            {
                                "example_id": "7ce85da8-78c5-442c-8e22-9c68d0efbaeb",
                                "sense_id": "bdc682be-7e67-34b5-9889-78e823117b16",
                                "text": "Entre l'addictologie et Laurent Karila, c'est une histoire d'affect qui dure. Après un internat de psychiatrie, il s’entiche rapidement de la science des dépendances."
                            },
                            {
                                "example_id": "34da178e-a92c-4cdb-82b6-14cc862d7bbb",
                                "sense_id": "bdc682be-7e67-34b5-9889-78e823117b16",
                                "text": "Le professeur François Paille, chef de service au CHU de Nancy, a été président de la Société Française d’Alcoologie, de la Fédération Française d’Addictologie ainsi que du COPAAH (Collège Professionnel des Acteurs de l’Addictologie Hospitalière)."
                            }
                        ]
                    }
