                            "trait_type": "regional",
                            "comment": "Indian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Термин, используемый для обозначения гороха, обычно в контексте индийской кухни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матар",
                                "target_lang_sense_clarification": "горох в индийской кухне"
                            },
                            {
                                "target_lang_word": "горох",
                                "target_lang_sense_clarification": "ингредиент"
                            }
                        ]
                    }
                }
            ]
        },
        {
