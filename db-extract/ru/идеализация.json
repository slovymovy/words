                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idéalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d510fe3-86b2-3d96-93f3-c690d341d455",
                                        "entry_id": "2c8bff01-f260-3838-8ee3-419073d7bae3",
                                        "glosses": [
                                            "Action d’idéaliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0406c2f-4a3f-435c-a9d8-caf5c5fb7962",
                                                "sense_id": "9d510fe3-86b2-3d96-93f3-c690d341d455",
                                                "text": "Pour autant, le fonctionnement de Gabriel n’en est pas moins marqué de la difficulté à se dégager d’un poids particulier de l’idéalisation."
                                            },
                                            {
                                                "example_id": "f18f84d4-5a6a-42d0-bbbf-4246ab0bf72f",
                                                "sense_id": "9d510fe3-86b2-3d96-93f3-c690d341d455",
                                                "text": "Il est alors possible soit de dé-biaiser les derniers en revenant aux modèles standards, soit, et c’est plus plausible, de dé-biaiser les premiers en procédant à des transformations réglées de leurs idéalisations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
