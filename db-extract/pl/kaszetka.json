                                    },
                                    {
                                        "sense_id": "4db99b64-0fb9-3f8b-ae65-bd0de5405e07",
                                        "entry_id": "da4b44e6-b234-3720-8cdb-0f21447f5007",
                                        "glosses": [
                                            "A small container containing a dose of medicine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bc723c1-4415-32f4-bbb2-89091f04e1de",
                                        "entry_id": "da4b44e6-b234-3720-8cdb-0f21447f5007",
                                        "glosses": [
                                            "in a brief, condensed or compact form"
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02098ce-6932-45b1-88e0-36d896580259",
                                                "sense_id": "9bc723c1-4415-32f4-bbb2-89091f04e1de",
                                                "text": "If this capsule history of our progress teaches us anything, it is that man, in his quest for knowledge and progress, is determined and cannot be deterred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fed2ee2f-b3f3-363a-bc27-628557f2f086",
                                        "entry_id": "da4b44e6-b234-3720-8cdb-0f21447f5007",
                                        "glosses": [
                                            "The covering — formerly lead or tin, now often plastic — over the cork at the top of the wine bottle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1015e687-7f9c-33d9-83f3-7fe05fc50669",
