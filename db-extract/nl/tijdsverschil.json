                                        ]
                                    },
                                    {
                                        "sense_id": "c39deebd-2c6b-3496-b632-c8027a7780e0",
                                        "entry_id": "e089020b-082f-37c3-ac30-f3aee1b679ac",
                                        "glosses": [
                                            "Last; long-delayed."
