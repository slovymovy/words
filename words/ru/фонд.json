{
    "word_family": [
        "фондовый"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9dde03cb-930d-3332-bd9e-97cb15763f22",
                    "sense_definition": "Денежные средства, предназначенные для определенной цели.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для строительства новой школы был создан специальный <w>фонд</w>.",
                            "target_lang_translations": {
                                "tr": "Yeni okulun inşası için özel bir <w>fon</w> oluşturuldu."
                            }
                        },
                        {
                            "text": "Компания выделила <w>фонд</w> на развитие новых технологий.",
                            "target_lang_translations": {
                                "tr": "Şirket, yeni teknolojilerin geliştirilmesi için bir <w>fon</w> ayırdı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "резервный фонд",
                        "целевой фонд"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir amaç için ayrılmış para veya kaynaklar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "fon",
                                "target_lang_sense_clarification": "Mali kaynak veya sermaye anlamında."
                            },
                            {
                                "target_lang_word": "kaynak",
                                "target_lang_sense_clarification": "Bir iş için ayrılan maddi imkanlar."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dccaabf-0267-365d-9f1e-3d02aac55d4f",
                    "sense_definition": "Запас или ресурсы чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В библиотеке хранится богатый книжный <w>фонд</w>.",
                            "target_lang_translations": {
                                "tr": "Kütüphanede zengin bir kitap <w>koleksiyonu</w> bulunmaktadır."
                            }
                        },
                        {
                            "text": "Фермеры подготовили качественный семенной <w>фонд</w> для посевной.",
                            "target_lang_translations": {
                                "tr": "Çiftçiler ekim dönemi için kaliteli bir tohum <w>stoku</w> hazırladılar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "книжный фонд",
                        "семенной фонд"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin birikimi, stoku veya mevcut kaynakları."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "koleksiyon",
                                "target_lang_sense_clarification": "Kütüphane veya arşiv gibi yerlerdeki birikim."
                            },
                            {
                                "target_lang_word": "stok",
                                "target_lang_sense_clarification": "Elde bulunan malzeme veya kaynak miktarı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a904999a-253b-34df-aaa9-a327de906384",
                    "sense_definition": "Некоммерческая организация, созданная для благотворительных или социальных целей.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Благотворительный <w>фонд</w> помогает детям с тяжелыми заболеваниями.",
                            "target_lang_translations": {
                                "tr": "Hayırsever bir <w>vakıf</w>, ağır hastalığı olan çocuklara yardım ediyor."
                            }
                        },
                        {
                            "text": "Этот <w>фонд</w> поддерживает молодые таланты в области искусства.",
                            "target_lang_translations": {
                                "tr": "Bu <w>vakıf</w>, sanat alanındaki genç yetenekleri desteklemektedir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "благотворительный фонд"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hayırseverlik veya sosyal amaçlar için kurulmuş kâr amacı gütmeyen kuruluş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "vakıf",
                                "target_lang_sense_clarification": "Sosyal veya hayır amaçlı kurulan kurum."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df6cbe4b-dd55-312e-9f0a-9e2a12b3b958",
                    "sense_definition": "Государственная организация для сбора средств и поддержки граждан.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Жильцы ежемесячно платят взносы в <w>фонд</w> капитального ремонта.",
                            "target_lang_translations": {
                                "tr": "Apartman sakinleri her ay tadilat <w>fonuna</w> aidat öderler."
                            }
                        },
                        {
                            "text": "Пенсионный <w>фонд</w> обеспечивает выплаты пожилым людям.",
                            "target_lang_translations": {
                                "tr": "Emeklilik <w>fonu</w>, yaşlı insanlara ödeme yapılmasını sağlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "государственный фонд"
                    ],
                    "common_phrases": [
                        "пенсионный фонд",
                        "фонд капитального ремонта"
                    ],
                    "target_lang_definitions": {
                        "tr": "Para toplamak ve vatandaşlara destek sağlamak için oluşturulmuş resmi kurum."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "fon",
                                "target_lang_sense_clarification": "Resmi veya kurumsal para havuzu."
                            },
                            {
                                "target_lang_word": "kurum",
                                "target_lang_sense_clarification": "Devlet bünyesindeki idari yapı."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}