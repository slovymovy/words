                "translations": [
                    {
                        "translation_id": "3605b4db-fdf9-49d7-9a34-f9f7a63c913c",
                        "source_entry_id": "5605b9a9-5d6a-3c09-bcaa-3a96f811bdd4",
                        "source_sense_id": "4c6a26eb-9bef-3327-af48-218ce648bb95",
                        "source_sense_description": "Literatur: Poem, Gedicht",
                        "target_lang_word": "Poem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b7a129-9422-3c56-bde2-8e49bcae5fb4",
                                        "entry_id": "01fec084-613e-30bd-8af8-41560a5ac082",
                                        "glosses": [
                                            "leicht abwertend: längere lyrische Dichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dea8da0-7c5e-46b1-8b6c-a7efbcc05327",
                                                "sense_id": "d4b7a129-9422-3c56-bde2-8e49bcae5fb4",
                                                "text": "„In dieser Nacht bewahrte er das Poem sogar unter seinem Kopfkissen auf.“"
                                            },
                                            {
                                                "example_id": "5e51e73c-f110-46e7-88a7-694be9127cd7",
                                                "sense_id": "d4b7a129-9422-3c56-bde2-8e49bcae5fb4",
                                                "text": "„Entschlossen, meinen Wirt gebührend zu entschädigen, indem ich sein Poem aufmerksam anhörte, schickte ich meine trübe Stimmung zum Teufel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffa631e9-a9d5-4c55-911e-aa7460478ef2",
                        "source_entry_id": "5605b9a9-5d6a-3c09-bcaa-3a96f811bdd4",
                        "source_sense_id": "4c6a26eb-9bef-3327-af48-218ce648bb95",
                        "source_sense_description": "Literatur: Poem, Gedicht",
                        "target_lang_word": "Gedicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gedicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                        "entry_id": "5a8ef8e6-473a-3ad0-9a5e-57b73346f890",
                                        "glosses": [
                                            "lyrisches sprachliches Kunstwerk, das meist schriftlich und in Strophen- und Versform vorliegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba0f552-63f8-4de6-8920-ee1c2006a793",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "Manche Menschen finden Trost in Gedichten."
                                            },
                                            {
                                                "example_id": "a879fd35-1972-429b-a615-6d2c7911d7ec",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Die Gedichte waren viel interessanter.“"
                                            },
                                            {
                                                "example_id": "68b345f1-e2a7-46bf-a20b-c1b578ec0f4e",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Farben finden sich immer wieder in seinen Gedichten.“"
                                            },
                                            {
                                                "example_id": "8ed43c43-412d-4c65-b719-be2dd62c284a",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Auf dem Tablett lag ein gedrucktes, zu Ehren des Helden verfasstes Gedicht.“"
                                            },
                                            {
                                                "example_id": "c4ea4037-d5c6-456e-95aa-5ed53002e1c4",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Aber Aufsätze waren keine Gedichte oder Romane.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff231b65-e232-3ce0-8507-a9b95ee1a19c",
                                        "entry_id": "5a8ef8e6-473a-3ad0-9a5e-57b73346f890",
                                        "glosses": [
                                            "etwas außergewöhnlich gut Gelungenes"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ccdd8fb-a5a7-4c36-a640-ee81378e2606",
                                                "sense_id": "ff231b65-e232-3ce0-8507-a9b95ee1a19c",
                                                "text": "Dein Pudding ist mal wieder ein Gedicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b242b83-9487-4edb-9549-2d4ba9c51d91",
                        "source_entry_id": "5605b9a9-5d6a-3c09-bcaa-3a96f811bdd4",
                        "source_sense_id": "cd4d7380-808e-352b-ad5e-788e7eba1214",
                        "source_sense_description": "übertragen: Meisterwerk",
                        "target_lang_word": "Meisterwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meisterwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52465e23-8af0-3cda-bfed-36069e467475",
                                        "entry_id": "761904c2-8b80-39a6-91b1-89883716d6e5",
                                        "glosses": [
                                            "das Meisterstück, eine handwerklich angefertigte, extrem hochwertige Arbeit, welche dafür geschaffen wird, um den Meistertitel in einem Handwerk (beispielsweise als Tischler, Klempner, Uhrmacher) zu bekommen"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5de7f3f-3475-43a9-9139-fb3549ba654d",
                                                "sense_id": "52465e23-8af0-3cda-bfed-36069e467475",
                                                "text": "Sein Meisterwerk war diese Anrichte aus Eiche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a187d502-0f72-35a7-82a3-954482a5c422",
                                        "entry_id": "761904c2-8b80-39a6-91b1-89883716d6e5",
                                        "glosses": [
                                            "ein überragend gutes, künstlerisches Werk"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a532d53-5172-41f8-8b30-e893141087ab",
                                                "sense_id": "a187d502-0f72-35a7-82a3-954482a5c422",
                                                "text": "Dieser Film ist ein wahres Meisterwerk."
                                            },
                                            {
                                                "example_id": "9b7f541d-36ac-471a-b0de-8900338353b9",
                                                "sense_id": "a187d502-0f72-35a7-82a3-954482a5c422",
                                                "text": "Es ist das einzige Kleid, das Jeannette für Jona gemacht hat, und es ist wirklich ein Meisterwerk geworden."
                                            },
                                            {
                                                "example_id": "7bf18f1f-a384-4651-a15f-3fb3093b0dbc",
                                                "sense_id": "a187d502-0f72-35a7-82a3-954482a5c422",
                                                "text": "„Trotz der schwierigen Umstände entstand ein Meisterwerk, das erst Jahre später wirklich verstanden wurde.“"
                                            },
                                            {
                                                "example_id": "bc4e1cda-3840-4c72-bae5-060920f4e550",
                                                "sense_id": "a187d502-0f72-35a7-82a3-954482a5c422",
                                                "text": "„Hier schuf der Reformator sein sprachliches Meisterwerk, das neben der großen theologischen Bedeutung, die ihm zukommt, auch die deutsche Sprache und ihre Entwicklung stark beeinflusst hat: die Übersetzung des Neunen Testaments.“"
                                            },
                                            {
                                                "example_id": "87d95c16-e86e-499e-a6c3-c6c225df7c8b",
                                                "sense_id": "a187d502-0f72-35a7-82a3-954482a5c422",
                                                "text": "„Henry Purcell war der führende englische Komponist des 17. Jahrhunderts. Er schrieb Meisterwerke wie die Oper „Dido and Aeneas“.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf4c2509-485c-3867-813d-274047ea6512",
                                        "entry_id": "761904c2-8b80-39a6-91b1-89883716d6e5",
                                        "glosses": [
                                            "eine Spitzenleistung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd1222e-b71b-4b4d-a197-3c1155cdd1f7",
                                                "sense_id": "cf4c2509-485c-3867-813d-274047ea6512",
                                                "text": "Diese Schweizer Uhr ist ein Meisterwerk an Präzision."
                                            },
                                            {
                                                "example_id": "81ffa3f5-d245-4202-a7f4-8be0282d057b",
                                                "sense_id": "cf4c2509-485c-3867-813d-274047ea6512",
                                                "text": "Mit dieser Nachtischkreation ist dem Spitzenkoch ein Meisterwerk gelungen."
                                            },
                                            {
                                                "example_id": "7326ed27-02ed-488a-a0a0-e0dbe74dcf8e",
                                                "sense_id": "cf4c2509-485c-3867-813d-274047ea6512",
                                                "text": "„Sein Meisterwerk lieferte er erst mit der nächsten Moschee in Jerusalem ab.“"
                                            },
                                            {
                                                "example_id": "3782bf17-a400-4ded-bdfb-8551ed20e6b9",
                                                "sense_id": "cf4c2509-485c-3867-813d-274047ea6512",
                                                "text": "„Zugleich erklärte sie, das kleine Meisterwerk mache mir Ehre; alle Schöngeister Roms seien sich darüber einig, und Donna Lucrezia könne die Ode auswendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
