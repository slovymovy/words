                    {
                        "sense_id": "3fcc45c6-bb8b-3bf9-b8dd-285b2be481bd",
                        "entry_id": "de950930-0357-3456-8cc6-fe817505dafd",
                        "glosses": [
                            "gekleurd in een patroon van witte en blauwe vlakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c71986b-d6eb-436b-a25d-286e40061400",
                                "sense_id": "3fcc45c6-bb8b-3bf9-b8dd-285b2be481bd",
                                "text": "Als je tot in detail gaat ontleden wat we daar eigenlijk staan te doen, kijkend naar een paar uitzendkrachten in een blauw-wit gestreept shirt, kom je zonder twijfel tot de conclusie dat je je tijd beter kunt besteden."
                            },
                            {
                                "example_id": "b64d13b0-02e3-47b3-917e-eb95af69ae82",
                                "sense_id": "3fcc45c6-bb8b-3bf9-b8dd-285b2be481bd",
                                "text": "Een lang blauw-wit zijden schort (de kleuren van de Beierse vlag) en opgestoken haar maken het geheel compleet."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b5a66ea-70e5-3e9c-a719-51ee8b269b86",
                        "entry_id": "de950930-0357-3456-8cc6-fe817505dafd",
                        "glosses": [
                            "betrekking hebbend op sportvereniging, land of andere verband met een vlag, embleem of tenue dat blauw en wit gekleurd is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e41a6bfb-7755-482c-8300-d40431c02a1f",
                                "sense_id": "9b5a66ea-70e5-3e9c-a719-51ee8b269b86",
                                "text": "Liefst negen (oud-)Mercuriusleden gaven gisteren acte de presence bij de Cerbeus Crossduathlon in Groesbeek. 7 kilometer lopen, 20 kilometer fietsen en nog eens 3,5 km lopen, dat alles off-road. Op verschillende onderdelen was er blauw-wit succes!"
                            }
                        ]
                    }
