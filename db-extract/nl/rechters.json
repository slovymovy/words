                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd885db2-4b83-35d8-acd9-2cc4eaca1d47",
                        "entry_id": "3ebb90cb-639d-3848-aea1-8e6276aec8ca",
