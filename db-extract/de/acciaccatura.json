                        "entry_id": "18f74f9d-d36a-385e-9268-7500734121be",
                        "glosses": [
                            "Verzierung in der Musik des 17. und 18. Jahrhunderts mit Tasteninstrumenten, die im kurzen Anschlagen der Nebennote neben der Hauptnote besteht, wobei die Nebennote gleich wieder losgelassen wird"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "dc388841-4ed0-439a-b7de-26144ae2d0e2",
                                "sense_id": "49bb0656-3dd1-3204-8351-7179e741030b",
                                "text": "In der Acciaccatura muss der Hilfston gleichzeitig mit dem Hauptton angeschlagen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
