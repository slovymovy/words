                "senses": [
                    {
                        "sense_id": "077f6f6d-5581-32aa-9016-782b0e3c871e",
                        "entry_id": "fc82cf7a-a0b3-355b-8c5a-d9edcf433af3",
                        "glosses": [
                            "Habitant de Malaysia, couramment appelée Malaisie. → voir Malaisien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d10c13f8-5a01-446d-b593-e582668b9f79",
                                "sense_id": "077f6f6d-5581-32aa-9016-782b0e3c871e",
                                "text": "Selon la compagnie, étaient à bord, outre les trois passagers français, 153 Chinois, 38 Malaysiens, 12 Indonésiens, sept Australiens, quatre Américains, deux Néo-Zélandais, deux Canadiens, un Russe, un Italien, un Taïwanais, un Hollandais et un Autrichien."
                            },
                            {
                                "example_id": "b74f1b8d-dde1-41d8-ab43-b66699bf4e36",
                                "sense_id": "077f6f6d-5581-32aa-9016-782b0e3c871e",
                                "text": "Ainsi, dans les produits alimentaires, les Malaysiens ont des besoins religieux et ethniques spécifiques qui ne peuvent être contournés."
                            },
                            {
                                "example_id": "e1818b2e-2246-4545-a7cf-cb58839c3639",
                                "sense_id": "077f6f6d-5581-32aa-9016-782b0e3c871e",
                                "text": "Ces sols alluviaux furent particulièrement adaptés à la culture du riz, nourriture de base de tous les Malaysiens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
