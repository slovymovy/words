                        "examples": [
                            {
                                "example_id": "7e051913-9ab0-4555-8b06-4f7c2cbd86b2",
                                "sense_id": "5199a327-a552-3b2e-9304-b7463832b687",
                                "text": "Je had ze allen zo gevangen kunnen nemen! Maar wat wil je dat ik zeg? Moed en macht hangen niet van rijkdom en bezit af, maar wel van onversaagdheid en inzicht."
                            },
                            {
                                "example_id": "e6040b8a-6436-409d-a50c-b823973b17b5",
                                "sense_id": "5199a327-a552-3b2e-9304-b7463832b687",
                                "text": "De ridder die dus wijsheid aan onversaagdheid paart, is een voorbeeld van ridderlijkheid, en hem komt dan ook alle eer toe; zijn onverschrokken levenswandel geeft hem het recht een troon te bestijgen."
                            },
                            {
                                "example_id": "820e68a2-1854-4160-83b3-5fc444a1471b",
                                "sense_id": "5199a327-a552-3b2e-9304-b7463832b687",
                                "text": "Huisarts Van Rhijn heeft veel Joodse patiënten. Bij de razzia in het najaar van 1941 wordt een groot aantal opgepakt. Dokter Van Rhijn gaat onversaagd door met zijn werk."
                            }
                        ]
                    }
