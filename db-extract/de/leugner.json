                ],
                "senses": [
                    {
                        "sense_id": "85394e18-fe92-3141-a35d-d8447803081f",
                        "entry_id": "8e1d858e-1668-3040-97fd-56803190b7c9",
                        "glosses": [
                            "jemand, der leugnet, der etwas in Abrede stellt oder verneint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bfea2eb-80e0-49b2-8a03-12fccb360489",
                                "sense_id": "85394e18-fe92-3141-a35d-d8447803081f",
                                "text": "Er war ein Leugner ewiger Wahrheiten, ein Rebell und ein Rationalist."
                            },
                            {
                                "example_id": "f00aa131-160d-44f0-82c7-f66af7337ccd",
                                "sense_id": "85394e18-fe92-3141-a35d-d8447803081f",
                                "text": "Du bist ein Leugner und Heuchler! Natürlich hast du die Tür nicht abgeschlossen, und ich glaube dir nicht, dass dir das, was dann passierte, leid tut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb99ea21-9739-4fc5-8f3f-cf792585d6e2",
                        "source_entry_id": "8e1d858e-1668-3040-97fd-56803190b7c9",
                        "source_sense_id": "85394e18-fe92-3141-a35d-d8447803081f",
                        "source_sense_description": "jemand, der leugnet, der etwas in Abrede stellt oder verneint",
                        "target_lang_word": "denier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f43d1cb-33fd-37eb-a39e-b90d8193be86",
                                        "entry_id": "bb9a5261-8c73-39f3-b38f-dbbbeacde3b6",
                                        "glosses": [
                                            "An old French coin worth one-twelfth of a sou."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a9fa1e-2ce4-4473-8b0c-eca53e831db5",
                                                "sense_id": "1f43d1cb-33fd-37eb-a39e-b90d8193be86",
                                                "text": "A bronze denier bearing the inscription CONRADUS around a central cross, was minted in Lugdunum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e60b80-a03c-33af-8705-0967d5a51584",
                                        "entry_id": "bb9a5261-8c73-39f3-b38f-dbbbeacde3b6",
                                        "glosses": [
                                            "A unit of linear density which indicates the fineness of fiber or yarn, equal to one gram per 9000 meters, used especially to measure or indicate the fineness of hosiery. Originally equal to the weight of a denier coin per 9600 aunes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e8b1223-5132-4794-a704-347f4f854143",
                                                "sense_id": "f8e60b80-a03c-33af-8705-0967d5a51584",
                                                "text": "Upstairs she rummaged through her chest of drawers, finally unearthing an unopened pack of ten denier barely blacks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "denier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f9fcf5e-6efb-3451-8171-798e4ad871d4",
                                        "entry_id": "9689b0e4-d438-3a33-9b11-a7877a1806f4",
                                        "glosses": [
                                            "One who denies or forbids something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e267a6f2-1a21-4bac-81c2-b0d23582345a",
                                                "sense_id": "8f9fcf5e-6efb-3451-8171-798e4ad871d4",
                                                "text": "Also, visitation deniers don't always get off with a slap on the wrist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                        "entry_id": "9689b0e4-d438-3a33-9b11-a7877a1806f4",
                                        "glosses": [
                                            "One who denies the existence of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a68ac1c-4179-4c72-a6c6-a1c3c0a86aa5",
                                                "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                                "text": "Holocaust denier"
                                            },
                                            {
                                                "example_id": "1ba88bfd-473b-46e5-9be7-d2ec6833607e",
                                                "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                                "text": "global warming denier"
                                            },
                                            {
                                                "example_id": "a0cd905c-9083-4a20-8907-5176dabeeed1",
                                                "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                                "text": "AIDS denier"
                                            },
                                            {
                                                "example_id": "9635d10f-043a-4c12-b592-61900680aafd",
                                                "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                                "text": "These are all false and misleading statements taken from a handful of thousands of YouTube videos analyzed by the nonprofit Center for Countering Digital Hate (CCDH), which has identified a stark change in the tactics of climate deniers over the past few years."
                                            },
                                            {
                                                "example_id": "884c7f59-9b03-46c8-bbeb-25cf8b969134",
                                                "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                                "text": "“Robert F. Kennedy, Jr. is not an environmentalist. He is a dangerous conspiracy theorist and science denier whose agenda would be a disaster for our communities and the planet,” the letter reads."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
