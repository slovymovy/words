                                        "sense_id": "0638e236-e2cd-3def-9950-914905813434",
                                        "entry_id": "42ef7761-f76a-3c5e-b8b1-a95a7954b0ce",
                                        "glosses": [
                                            "Obsolete form of alarum."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d248ef1-0d63-48e9-ab13-fe6ee9474565",
                                                "sense_id": "0638e236-e2cd-3def-9950-914905813434",
                                                "text": "[…] and so comes forth, and rings a tedious Larum to the whole House, and then is quiet again for an Hour, but for her Quarters."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "larum",
