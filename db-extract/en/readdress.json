                                    {
                                        "sense_id": "68b537d7-7894-32f8-ae75-de32d1749646",
                                        "entry_id": "146b9414-f29e-3078-8a9e-4a60d50e2b69",
                                        "glosses": [
                                            "einen neuen Empfänger benennen, zum Beispiel auf einen Briefumschlag schreiben"
                                        ],
                                        "tags": [],
