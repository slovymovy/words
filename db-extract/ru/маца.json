                "senses": [
                    {
                        "sense_id": "2eade359-66e6-3299-99ac-2caf67ead7db",
                        "entry_id": "19650520-bd40-370f-8e6f-9c9318795e99",
                        "glosses": [
                            "этногр., религ., : пресный хлеб из пшеничной муки в виде тонких сухих лепёшек, разрешённых к употреблению в течение еврейского праздника Песах"
                        ],
                        "tags": [
                            "в обрядовой еврейской кухне"
                        ],
                        "examples": [
                            {
                                "example_id": "1f193cb5-ce7f-44d8-b41e-e52b0c2f2bc7",
                                "sense_id": "2eade359-66e6-3299-99ac-2caf67ead7db",
                                "text": "Единственный хлеб, разрешённый в Песах — маца, пресные хлебцы из пшеничной муки, которыми порабощённые евреи питались в Египте и во время исхода из Египта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69ecbcde-e4f0-46b1-9c2e-00e20bdd2d6f",
                        "source_entry_id": "19650520-bd40-370f-8e6f-9c9318795e99",
                        "source_sense_id": "2eade359-66e6-3299-99ac-2caf67ead7db",
                        "target_lang_word": "matzo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matzo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                        "entry_id": "6ff0013e-87ce-3627-968e-bc53d43f6502",
                                        "glosses": [
                                            "Thin, unleavened bread in Jewish cuisine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b25585ed-bb65-4b3c-9f47-498177ca2aa1",
                                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                                "text": "Matzo is eaten by Jews on Passover."
                                            },
                                            {
                                                "example_id": "3b9d667e-9da5-4e6f-bd96-208552279f76",
                                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                                "text": "Like the Kopelmans, they have a Christmas tree with dreidel ornaments and a menorah, which they light each night. Pham learned to cook matzo ball soup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9966bc04-b6a8-350b-a8ae-e238d3847118",
                                        "entry_id": "6ff0013e-87ce-3627-968e-bc53d43f6502",
                                        "glosses": [
                                            "A piece of the above bread."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc165574-3cd1-4756-af2a-dec201783dc8",
                                                "sense_id": "9966bc04-b6a8-350b-a8ae-e238d3847118",
                                                "text": "[W]hen a Hamas spokesman recently stood by his statement that Jews used the blood of non-Jewish children for their matzos – one of the oldest anti-Semitic canards around – European elites were largely silent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
