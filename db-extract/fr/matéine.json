                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d69774c6-c8c4-43a4-838d-dd2b7c67f2fd",
                                                "sense_id": "1b140af4-4656-333d-bde5-9639bf9edcec",
                                                "text": "Unlike tea and coffee, however, it does not contain caffeine. Instead, its main active ingredient is a xanthine alkaloid known as mateine."
