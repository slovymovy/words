                                        "entry_id": "bf56cb2a-7e09-3591-97c0-ff7c3ea505e3",
                                        "glosses": [
                                            "Not subject to other people’s shaming or reproach."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6deb1f09-f539-4c5a-b9aa-417b17fd3bd9",
                                                "sense_id": "90afda82-76b2-3c3e-9843-3da5a42b8b79",
                                                "text": "Near-synonyms: blameless, unblameable"
                                            },
                                            {
                                                "example_id": "faffcb70-0a80-4e6b-bad3-164d2c272aed",
                                                "sense_id": "90afda82-76b2-3c3e-9843-3da5a42b8b79",
                                                "text": "He shall be as now nameles,\nBut he shall not be blameles,\nNor he shall not be shameles;\nFor sure he wrought amys, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
