                ],
                "senses": [
                    {
                        "sense_id": "2f837d24-8def-3fc4-ad1d-92a030a5405d",
                        "entry_id": "3f87e93d-baa0-32b3-8388-4eef893d4d34",
                        "glosses": [
                            "traditionelle Verkleidung der Narren in der schwäbisch-alemannischen Fastnacht"
                        ],
                        "tags": [
                            "Alemannic",
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "8a78259a-9c76-4b01-b897-b783ac95c241",
                                "sense_id": "2f837d24-8def-3fc4-ad1d-92a030a5405d",
                                "text": "„Zwei Vormittage lang konnten Narrenhäs und Hexenhemd abgegeben werden.“"
                            },
                            {
                                "example_id": "e1b3d531-d3f9-4226-9f47-1cd40afe2e0f",
                                "sense_id": "2f837d24-8def-3fc4-ad1d-92a030a5405d",
                                "text": "„Vom Gasthaus „Scharfeck“ aus marschierten der „Narrenbolizei“, die Musik und die Narren zum Kirchplatz, wo die diesjährige Fasnet als ein ausgestopftes „Narrenhäs“ aufgebahrt war.“"
                            },
                            {
                                "example_id": "cdc0fe03-a757-44d6-b85e-f4e60ff06101",
                                "sense_id": "2f837d24-8def-3fc4-ad1d-92a030a5405d",
                                "text": "„In den nächsten Wochen werden wohl noch einige im Narrenhäs durch die Gassen schlendern.“"
                            },
                            {
                                "example_id": "4be67c2f-1c44-4148-8112-0d670e621f30",
                                "sense_id": "2f837d24-8def-3fc4-ad1d-92a030a5405d",
                                "text": "„Das Kostüm, das „Narrenhäs“ käme aus der „schwäbisch-alemannischen Fasnet“, erklärt er.“"
                            },
                            {
                                "example_id": "fe1f49a8-26b0-4a0a-b431-4e993a504b27",
                                "sense_id": "2f837d24-8def-3fc4-ad1d-92a030a5405d",
                                "text": "„Sein historisches Narrenhäs auf Ebay verticken – so etwas gehört sich nicht für einen Rottweiler Narren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
