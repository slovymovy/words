    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "360b4cd5-a8c4-309c-9e24-6cb73a97880a",
                    "sense_definition": "verliefd worden op iemand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zal snel op hem <w>verlieven</w>.",
                            "target_lang_translations": {
                                "it": "Lei si <w>innamorerà</w> presto di lui."
                            }
                        },
                        {
                            "text": "Het is makkelijk om op die stad te <w>verlieven</w>.",
                            "target_lang_translations": {
                                "it": "È facile <w>innamorarsi</w> di quella città."
                            }
                        }
                    ],
                    "synonyms": [
                        "houden van"
                    ],
                    "common_phrases": [
                        "op iemand verlieven"
                    ],
                    "target_lang_definitions": {
                        "it": "Provare un sentimento di innamoramento verso qualcuno o qualcosa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "innamorarsi",
                                "target_lang_sense_clarification": "Il verbo riflessivo standard per indicare il processo di innamorarsi di qualcuno o qualcosa."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d70d6e4d-34c8-323e-8f58-df74b7ddcdf1",
                    "sense_definition": "iemand anders laten verliefd worden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde haar op hem te laten <w>verlieven</w>.",
                            "target_lang_translations": {
                                "it": "Lui ha cercato di farla <w>innamorare</w> di sé."
                            }
                        },
                        {
                            "text": "Het is moeilijk om iemand op commando te laten <w>verlieven</w>.",
                            "target_lang_translations": {
                                "it": "È difficile far <w>innamorare</w> qualcuno a comando."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Causare in qualcuno il sentimento dell'innamoramento."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "far innamorare",
                                "target_lang_sense_clarification": "Costruzione causativa utilizzata per indicare l'azione di far nascere l'amore in un'altra persona."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46b76850-9d19-395c-b067-02dd4b32840d",
                    "sense_definition": "iemand liefhebben of houden van iemand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>verlieven</w> elkaar al vele jaren.",
                            "target_lang_translations": {
                                "it": "Si <w>amano</w> già da molti anni."
                            }
                        },
                        {
                            "text": "Mensen kunnen op verschillende manieren <w>verlieven</w>.",
                            "target_lang_translations": {
                                "it": "Le persone possono <w>amare</w> in modi diversi."
                            }
                        }
                    ],
                    "synonyms": [
                        "beminnen",
                        "houden van"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Dit gebruik is verouderd."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Provare amore o affetto profondo per qualcuno (uso arcaico)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "amare",
                                "target_lang_sense_clarification": "Verbo che esprime il sentimento di amore o affetto, usato qui come alternativa moderna al termine arcaico."
                            },
                            {
                                "target_lang_word": "voler bene",
                                "target_lang_sense_clarification": "Espressione comune per indicare affetto profondo, spesso usata in contesti meno formali."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}