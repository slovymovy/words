        "ru-extract.jsonl": [
            {
                "entry_id": "7c8dffab-6269-3058-8ad8-b4ddcb790b7b",
                "word": "персонально",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1a4e5923-8ac3-3967-b727-c34d3bda6f5e",
                        "entry_id": "7c8dffab-6269-3058-8ad8-b4ddcb790b7b",
                        "glosses": [
                            "наречие к персональный; лично"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "0adb4fe0-9c74-4a60-a50d-db7414670b64",
                                "sense_id": "1a4e5923-8ac3-3967-b727-c34d3bda6f5e",
                                "text": "Женька, как ни странно, взгляд мой поймал и теперь его улыбка была предназначена персонально мне."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c9cf415-8d91-459e-aff1-e22ee4eb19c4",
                        "source_entry_id": "7c8dffab-6269-3058-8ad8-b4ddcb790b7b",
                        "source_sense_id": "1a4e5923-8ac3-3967-b727-c34d3bda6f5e",
                        "target_lang_word": "personally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10d2abff-4d68-35c3-88f2-c66ce8c00e39",
                                        "entry_id": "1a83396e-a2ef-3f7a-b22b-6861d6a095ea",
                                        "glosses": [
                                            "In a personal manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac2584b7-5a1c-3607-8e65-42376230f011",
                                        "entry_id": "1a83396e-a2ef-3f7a-b22b-6861d6a095ea",
                                        "glosses": [
                                            "In person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c370fc2-874b-4751-9bf6-318cbc7cf190",
                                                "sense_id": "ac2584b7-5a1c-3607-8e65-42376230f011",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            },
                                            {
                                                "example_id": "2a4cdedc-2ba0-49ba-96bb-40fc9c93f55d",
                                                "sense_id": "ac2584b7-5a1c-3607-8e65-42376230f011",
                                                "text": "'There's a boy here who wants to speak to Miss Clara personally,' he announced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a67b69fb-68dd-3bc6-a7ef-caf0c69c1ef9",
                                        "entry_id": "1a83396e-a2ef-3f7a-b22b-6861d6a095ea",
                                        "glosses": [
                                            "Concerning oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dbce5ac-c36f-49bd-ac02-11a0b1a97c5a",
                                                "sense_id": "a67b69fb-68dd-3bc6-a7ef-caf0c69c1ef9",
                                                "text": "I'm really annoyed with her, personally."
                                            },
                                            {
                                                "example_id": "2f145f9d-7377-414b-993d-6cd04a96e376",
                                                "sense_id": "a67b69fb-68dd-3bc6-a7ef-caf0c69c1ef9",
                                                "text": "Personally I felt shy and uncomfortable at this obsequious adoration, and I read the same feeling in the faces of Roxton and Summerlee, but Challenger expanded like a flower in the sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4d7a55-2077-36dc-8c2a-7875f5f51608",
                                        "entry_id": "1a83396e-a2ef-3f7a-b22b-6861d6a095ea",
                                        "glosses": [
                                            "As a person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4baf737-bc47-44d3-854a-da77ba4ac156",
                                                "sense_id": "ff4d7a55-2077-36dc-8c2a-7875f5f51608",
                                                "text": "I like you personally, but as a colleague you have yet to do well."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
