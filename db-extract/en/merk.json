                "senses": [
                    {
                        "sense_id": "7dcbc2d2-821c-3dc3-8696-c6c40c2b8797",
                        "entry_id": "2ddc56b5-433b-3d01-9204-ca3800e86281",
                        "glosses": [
                            "Alternative spelling of murk (“to murder”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "31db9cfa-93f2-48ba-9056-fde17fcb9041",
                                "sense_id": "7dcbc2d2-821c-3dc3-8696-c6c40c2b8797",
                                "text": "In truth, there are Easter eggs planted in just about every frame of Ready Player One, which never misses an opportunity to insert a recognizable character (hey, is that Jason Voorhees getting merked during the film’s first-person shooter level?) or toss a sop to the faithful."
                            },
                            {
                                "example_id": "b3b27782-e0c0-49b4-85ee-9c21f569fe40",
                                "sense_id": "7dcbc2d2-821c-3dc3-8696-c6c40c2b8797",
                                "text": "But what I realized was, for however much I want to rep the motherland, be bitter towards America for merking 1/20 of Japan's population, I actually know next to nothing about Japan."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8ed78eb-3107-317d-b37d-2e817cad6c9a",
                        "entry_id": "2ddc56b5-433b-3d01-9204-ca3800e86281",
                        "glosses": [
                            "To run."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "00706ff3-b4ab-47fb-af69-ba7ef6ffa4de",
                                "sense_id": "f8ed78eb-3107-317d-b37d-2e817cad6c9a",
                                "text": "If you hear the law coming, you merk on [run away from]^([sic]) them niggas."
                            }
                        ]
                    }
