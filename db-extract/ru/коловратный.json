                    {
                        "translation_id": "30016221-a550-4bb3-ba66-8c95712c93a2",
                        "source_entry_id": "9ade6b3d-ef8d-379a-a036-26c6cfad6cba",
                        "source_sense_description": "изменчивый, непостоянный",
                        "target_lang_word": "fickle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                                        "entry_id": "375f83dc-9db8-31b0-a7a2-65b85e66ebc2",
                                        "glosses": [
                                            "Quick to change one’s opinion or allegiance; insincere; not loyal or reliable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd5941d-8e31-4825-ba5d-32b1a459e4ff",
                                                "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                                                "text": "O Fortune, Fortune, all men call thee fickle, / If thou art fickle, what doſt thou with him / That is renown'd for faith? be fickle Fortune: / For then I hope thou wilt not keepe him long, / But ſend him backe."
                                            },
                                            {
                                                "example_id": "2e2e51c9-8a0a-4e4f-8aa2-eac52c2d75ef",
                                                "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                                                "text": "Still onward winds the dreary way;\n⁠I with it; for I long to prove\n⁠No lapse of moons can canker Love,\nWhatever fickle tongues may say."
                                            },
                                            {
                                                "example_id": "2794d9f0-aff5-45fe-a567-a75ae92e0574",
                                                "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                                                "text": "As night has such a local ring / And love and rock are fickle things"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd66bf55-277d-3fd0-9295-60db8b025292",
                                        "entry_id": "375f83dc-9db8-31b0-a7a2-65b85e66ebc2",
                                        "glosses": [
                                            "Changeable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e8ec05-60c6-4d5a-8639-9ca40e07bb96",
                                                "sense_id": "bd66bf55-277d-3fd0-9295-60db8b025292",
                                                "text": "fickle breeze"
                                            },
                                            {
                                                "example_id": "52cd6a9f-ec3a-4515-9060-0c5d3f2656da",
                                                "sense_id": "bd66bf55-277d-3fd0-9295-60db8b025292",
                                                "text": "fickle stock market"
                                            },
                                            {
                                                "example_id": "95d20e80-d4ba-41db-b9e1-13ee5e58a5c4",
                                                "sense_id": "bd66bf55-277d-3fd0-9295-60db8b025292",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nTo the south, the vast geometrical deserts of Arabian nomads, a redoubt of feral movement, of fickle winds, of open space, of saddle leather—home to the wild Bedouin tribes."
                                            }
                                        ]
                                    }
