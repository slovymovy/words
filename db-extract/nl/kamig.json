                                    {
                                        "sense_id": "c22df386-e8d6-39c3-89d7-53476e3836d7",
                                        "entry_id": "6762a3fe-528e-301c-b110-44dcd1427c96",
                                        "glosses": [
                                            "Worthless; lousy; rotten."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee5fee45-f701-470f-8dd0-b91144d45e48",
                                                "sense_id": "c22df386-e8d6-39c3-89d7-53476e3836d7",
                                                "text": "'Go cuddle up to your mouldy old papers,' she shouted at him. 'See how warm they'll keep you.' She slammed the door and made to walk off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "814a1869-7498-3287-8f2a-0673225f0089",
                                        "entry_id": "6762a3fe-528e-301c-b110-44dcd1427c96",
                                        "glosses": [
                                            "Gray-headed, whether from age or hair powder."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "130b8d35-cb4e-493d-9926-3df08c9d0df4",
                                                "sense_id": "814a1869-7498-3287-8f2a-0673225f0089",
                                                "text": "Let him be great, as e'er he will, / He's rotten at the heart's core still; / Yet counsel from his mouldy pate, / Supports the trembling chair of state, / And scatters with unsparing hand, / A thousand miseries o'er the land; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3a6bff1-f09e-45bd-ba31-c4763ee6a92b",
                        "source_entry_id": "50eca1c7-65c6-38bb-8bbe-f3b61d6c50aa",
                        "source_sense_id": "d88b1787-2844-36dc-a4e2-8fe80eda9d6d",
                        "source_sense_description": "van bier en wijn: bedekt met een vlokkig vlies",
                        "target_lang_word": "fusty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fusty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18a8ccff-a909-3e42-9c78-98577cd321ce",
                                        "entry_id": "b43d6ea5-b817-30ab-9e9f-9e0fa844c834",
                                        "glosses": [
                                            "Moldy or musty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "746d6223-39f6-3300-af97-5b4640f57edf",
                                        "entry_id": "b43d6ea5-b817-30ab-9e9f-9e0fa844c834",
                                        "glosses": [
                                            "Stale-smelling or stuffy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42aa71b-590a-4f8a-8c9f-5e3b74f61fee",
                                                "sense_id": "746d6223-39f6-3300-af97-5b4640f57edf",
                                                "text": "I rather vvonder vvhat Charms a VVoman of any Spirit can fancy in a Nunnery, in vvatching, vvorking, praying, and ſometimes, I am afraid, vviſhing for other Company than that of an old fuſty Friar— […]"
                                            },
                                            {
                                                "example_id": "e0eb5dde-2e3e-40ec-8976-d7ade6521875",
                                                "sense_id": "746d6223-39f6-3300-af97-5b4640f57edf",
                                                "text": "All up the hills that hem the city in, these houses swarm; and the mites inside were lolling out of the windows, and drying their ragged clothes on poles, and crawling in and out at the doors, and coming out to pant and gasp upon the pavement, and creeping in and out among huge piles and bales of fusty, musty, stifling goods; […]"
                                            },
                                            {
                                                "example_id": "f496de79-7539-49c1-8424-3b2bf987b9fc",
                                                "sense_id": "746d6223-39f6-3300-af97-5b4640f57edf",
                                                "text": "You always knew where to find him if he were wanted; he would be in his study with a book. Very likely it would be an old, old book, some fusty old thing that no one else would dream of reading."
                                            },
                                            {
                                                "example_id": "585413e1-22b0-429f-9b3e-215110e1cb96",
                                                "sense_id": "746d6223-39f6-3300-af97-5b4640f57edf",
                                                "text": "A waiter took his box up five flights of stairs, and Philip was shown into a tiny room, fusty from unopened windows, the greater part of which was taken up by a large wooden bed with a canopy over it of red rep; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f15eab-3f38-3db4-a158-8724c2ec6836",
                                        "entry_id": "b43d6ea5-b817-30ab-9e9f-9e0fa844c834",
                                        "glosses": [
                                            "Old-fashioned, refusing to change or update."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3fff98-b36b-4c86-a476-3e1d6773f58d",
                                                "sense_id": "16f15eab-3f38-3db4-a158-8724c2ec6836",
                                                "text": "In contrast to exploitation or suppression or even alienation, involution is presented as part of the natural order of things—like bad weather. You can’t point fingers at an abstraction or rally against a fusty term from an anthropology text."
                                            },
                                            {
                                                "example_id": "b5395ac4-cec8-4440-8292-e67a9762853f",
                                                "sense_id": "16f15eab-3f38-3db4-a158-8724c2ec6836",
                                                "text": "An anonymously sourced report by one of Britain’s freewheeling tabloid newspapers has sparked a debate over both tabloid journalistic ethics and sexism in Parliament, leading some to question whether the institution is capable of shedding its fusty reputation and becoming an inclusive workplace."
                                            },
                                            {
                                                "example_id": "36f85893-219c-4031-b72a-05f55bc10539",
                                                "sense_id": "16f15eab-3f38-3db4-a158-8724c2ec6836",
                                                "text": "Oh sweet surprise - oh dear delight\nTo find it undisputed quite -\nAll musty, fusty rules despite,\nThat Art is wrong and Nature right!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81986c4e-b6bc-3f13-a0e5-17321fc9952f",
                                        "entry_id": "b43d6ea5-b817-30ab-9e9f-9e0fa844c834",
                                        "glosses": [
                                            "Tasting of the cask."
                                        ],
                                        "tags": [
                                            "of wine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14bb06cd-dd49-409b-8218-80a5d63297f9",
                                                "sense_id": "81986c4e-b6bc-3f13-a0e5-17321fc9952f",
                                                "text": "Now consider what happens when that flavor is not fresh lemon but scorched garlic or some fusty wine. Unpleasant flavors are distributed at the same molecular level as good ones."
                                            },
                                            {
                                                "example_id": "58dd0ca1-018c-4b87-9084-c1299ead5f31",
                                                "sense_id": "81986c4e-b6bc-3f13-a0e5-17321fc9952f",
                                                "text": "Alison had a mouthful of warm, rather fusty wine and lay back on the grass, cupping the back of her head in her hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
