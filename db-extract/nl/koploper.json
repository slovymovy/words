                        "entry_id": "e389e886-aa66-31bd-a4fe-8f9fe9d3be7f",
                        "glosses": [
                            "iets dat of iemand die op een bepaald gebied een leidende positie inneemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d5931e-b371-48d3-80ff-5c60bcccf99b",
                                "sense_id": "2fce6a49-f2fd-343b-9fbe-acd735b4f9ee",
                                "text": "Meteen na de start, meldde ze zich vooraan, pal achter Can, en pal voor Grøvdal en de Zwitserse Fabienne Schlumpf. Maar gaandeweg begon ze van vermoeidheid te trekkebekken en kort daarop groeide het gat met de koplopers, Can, Schlumpf en uiteindelijk ook de Noorse."
                            }
                        ]
                    },
                    {
                        "sense_id": "c09448e5-89f6-386e-8f63-235e7c34d7be",
                        "entry_id": "e389e886-aa66-31bd-a4fe-8f9fe9d3be7f",
