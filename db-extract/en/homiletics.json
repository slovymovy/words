                    }
                ],
                "translations": [
                    {
                        "translation_id": "7af93721-1d36-4331-9f56-4b6668705f84",
                        "source_entry_id": "59b255f7-09a7-33ba-88b7-eb0eab5f5a74",
                        "source_sense_id": "832b3d7c-9083-3b65-8824-088048ef2bb8",
