    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "30951cdd-ec0b-30c7-83b7-5065d0ccbc7b",
                "word": "complexification",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b67328c-5a10-406c-aca0-51c039bf9b3a",
                        "entry_id": "30951cdd-ec0b-30c7-83b7-5065d0ccbc7b",
                        "tags": [
                            "plural"
                        ],
                        "form": "complexifications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4aa65535-e2a5-3293-8f88-ad520fc04ea6",
                        "entry_id": "30951cdd-ec0b-30c7-83b7-5065d0ccbc7b",
                        "glosses": [
                            "The act or process of making something more complex."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b81d80e4-34c0-4c32-8bba-5bc32ba7c301",
                                "sense_id": "4aa65535-e2a5-3293-8f88-ad520fc04ea6",
                                "text": "All this represents a change in American society, and a complexification of it."
                            },
                            {
                                "example_id": "80469b0a-6ec2-4214-b983-519db7e29ac0",
                                "sense_id": "4aa65535-e2a5-3293-8f88-ad520fc04ea6",
                                "text": "This fundamental discovery that all bodies owe their origin to arrangements of single initial corpuscular type is the beacon that lights the history of the universe to our eyes. In its own way, matter obeyed from the beginning that great law of biology to which we shall have to recur time and time again, the law of 'complexification'."
                            },
                            {
                                "example_id": "8cf8e67b-a92c-4bcc-81ba-88aefaef2b12",
                                "sense_id": "4aa65535-e2a5-3293-8f88-ad520fc04ea6",
                                "text": "In Elise Boulding's analysis, the conservative qualities of woman's mysteries chose not to keep pace with the complexification of urban life."
                            },
                            {
                                "example_id": "1b25bede-8d5b-466d-b86c-2ad7a1f58be4",
                                "sense_id": "4aa65535-e2a5-3293-8f88-ad520fc04ea6",
                                "text": "For rational beings will of course try simple things first and thereafter be driven step by step towards an ever enhanced complexification"
                            },
                            {
                                "example_id": "90586ddc-2e93-4e16-968f-fd46c4bb71f2",
                                "sense_id": "4aa65535-e2a5-3293-8f88-ad520fc04ea6",
                                "text": "A new complexification occurs when the situation becomes desperate through crashing marginal returns on increasing complicatedness."
                            },
                            {
                                "example_id": "67c802d5-4787-464f-ba57-90a448cbd0d6",
                                "sense_id": "4aa65535-e2a5-3293-8f88-ad520fc04ea6",
                                "text": "The development of protolanguage into modern human language, and the complexification of language more generally, can only occur when language users can successfully communicate even while they maintain different internal representations of language."
                            }
                        ]
                    },
                    {
                        "sense_id": "5716e141-cd12-3752-b53a-d3dc982be12e",
                        "entry_id": "30951cdd-ec0b-30c7-83b7-5065d0ccbc7b",
                        "glosses": [
                            "An extension from a basis on real numbers to a basis on complex numbers."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": []
                    }
