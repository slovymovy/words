                    },
                    {
                        "translation_id": "cb6adb91-0902-4a6b-8305-063f8d0cbf54",
                        "source_entry_id": "8ab2ac55-e446-319a-b9d3-cb1713cfd5d7",
                        "target_lang_word": "weitas",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weitas",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a6425a89-53d6-3c61-b547-6fc497ca5ebf",
                                        "entry_id": "ed472b8e-1b7f-3930-8625-4e2dab263b11",
                                        "glosses": [
                                            "tas waarin een jager zijn buit stopt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dfba4ec-bbb6-4c83-92cc-15e3a40d8340",
                                                "sense_id": "a6425a89-53d6-3c61-b547-6fc497ca5ebf",
                                                "text": "Wanneer Gori zich weer bij mij voegt, constateer ik dat zijn weitas leeg is. Hij heeft drie konijnen gemist. Hij geeft mij omstandig uitleg, maar feit blijft dat hij drie konijnen gemist heeft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02ce8dbe-c9f8-4a7e-8354-632c22cf36b0",
                        "source_entry_id": "8ab2ac55-e446-319a-b9d3-cb1713cfd5d7",
                        "target_lang_word": "ягдташ",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ягдташ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eb09acd9-db84-3438-9154-1804eaa106d0",
                                        "entry_id": "c3635115-ea9a-37a8-931b-5618b871bcb7",
                                        "glosses": [
                                            "охотничья сумка для переноски добычи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "816b07c6-d7cc-4cb0-ace7-35de5db83a14",
                                                "sense_id": "eb09acd9-db84-3438-9154-1804eaa106d0",
                                                "text": "На голове была развалина какой-то шляпы, но ружьё новой системы было игрушечка, и ягдташ и патронташ, хотя истасканные, были наилучшей доброты."
                                            },
                                            {
                                                "example_id": "b059f0f9-0c4d-4ef1-9019-a1157de2d302",
                                                "sense_id": "eb09acd9-db84-3438-9154-1804eaa106d0",
                                                "text": "Усталый, голодный, счастливый, Левин в десятом часу утра, исходив вёрст тридцать, с девятнадцатью штуками красной дичи и одною уткой, которую он привязал за пояс, так как она уже не влезала в ягдташ, вернулся на квартиру."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
