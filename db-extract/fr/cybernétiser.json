                "senses": [
                    {
                        "sense_id": "c2241f33-4088-39e4-bdc6-51954e491f69",
                        "entry_id": "27193a49-fb87-3e72-b5b9-77cf91e93208",
                        "glosses": [
                            "Rendre cybernétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6452ee-5e89-4a16-9fcc-e4062e999302",
                                "sense_id": "c2241f33-4088-39e4-bdc6-51954e491f69",
                                "text": "Une telle attitude serait propre à cybernétiser la pensée et tous les ressorts de l’action, condamnant définitivement nos élites à la carence et à la disqualification."
                            },
                            {
                                "example_id": "dc67fab5-70c7-4943-83b0-7b29034a557d",
                                "sense_id": "c2241f33-4088-39e4-bdc6-51954e491f69",
                                "text": "En matière de moyens et de codes — code de la route ou code civil — on pourrait tout formaliser, mesurer, réguler, cybernétiser."
                            }
                        ]
                    }
