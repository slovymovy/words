                ],
                "senses": [
                    {
                        "sense_id": "9890b249-5078-3cbc-9e6d-c5dd17d1d83a",
                        "entry_id": "05b8903b-1758-3ea1-b02a-1b66ff3be5e5",
                        "glosses": [
                            "Zustand des Körpers, Reaktionsphase, (kurz) nachdem der Mensch einen Schock erlittenen hat"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ebc84914-e9a1-4a09-a790-859d35dd886d",
                                "sense_id": "9890b249-5078-3cbc-9e6d-c5dd17d1d83a",
                                "text": "„An den Schock schließt sich der Gegenschock (klinischer Schock!) an, welcher durch Steigerung der Diurese, der Glykämie, der Chlorämie und der Temperatur gekennzeichnet ist.“"
                            },
                            {
                                "example_id": "d6aae908-94c3-4051-aa3c-77fc5451e1ba",
                                "sense_id": "9890b249-5078-3cbc-9e6d-c5dd17d1d83a",
                                "text": "„Die Reaktion des Organismus auf eine schockartige Veränderung der Homöostase lässt sich in drei Phasen gliedern: 1. Schock 2. Gegenschock 3. Erholungsphase.“"
                            },
                            {
                                "example_id": "bc0ace35-754c-49c4-a0eb-6e459ab1933b",
                                "sense_id": "9890b249-5078-3cbc-9e6d-c5dd17d1d83a",
                                "text": "„Neue Gedankengänge entwickelte Selye, der Schock und Gegenschock unter der Bezeichnung Alarmreaktion zusammenfaßt.“"
                            },
                            {
                                "example_id": "916b400b-8d8a-47ff-aaac-39e5b1281b15",
                                "sense_id": "9890b249-5078-3cbc-9e6d-c5dd17d1d83a",
                                "text": "„Der Gegenschock zeichnet sich durch eine sympathikoton gesteuerte Mobilisation sämtlicher Reserven des Organismus aus (kataboler Stoffwechsel).“"
                            },
                            {
                                "example_id": "43cde795-6801-48ab-81ef-cd5d19c7739a",
                                "sense_id": "9890b249-5078-3cbc-9e6d-c5dd17d1d83a",
                                "text": "„Die Reaktionskurve von Schock/Gegenschock pendelt um die Nulllinie. Der Organismus ist nicht mehr in der Lage, überhaupt zu reagieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0bd8ec87-e137-3f8f-a6d0-f989fea17dff",
                        "entry_id": "05b8903b-1758-3ea1-b02a-1b66ff3be5e5",
                        "glosses": [
                            "Schock, der im Rahmen einer Schockbehandlung bewusst herbeigeführt wird, um einen vorher erlittenen Schock und seine Nachwirkungen zu behandeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "956ad4fd-9349-45ad-93bd-dabf5d98e82a",
                                "sense_id": "0bd8ec87-e137-3f8f-a6d0-f989fea17dff",
                                "text": "„Von einem Defibrillator muß verlangt werden, daß durch ausreichende Stromstärke und Leistung ein Gegenschock das flimmernde Herz vollkommen depolarisiert.“"
                            },
                            {
                                "example_id": "15967cda-7ab4-407c-b8ff-e60bf66670f0",
                                "sense_id": "0bd8ec87-e137-3f8f-a6d0-f989fea17dff",
                                "text": "„Die Herzen mit Schwebungsform ließen sich durch elektrischen Gegenschock allein entflimmern.“"
                            },
                            {
                                "example_id": "c258e833-7f35-42ec-bd6a-95075b5f17bb",
                                "sense_id": "0bd8ec87-e137-3f8f-a6d0-f989fea17dff",
                                "text": "„Wir stehen vor tierexperimentellen Versuchen, bei welchen das normale Herz unter künstlichem, unveränderbarem Schrittmacherrhythmus Gegenschocks ausgesetzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
