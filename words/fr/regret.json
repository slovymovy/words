{
    "word_family": [
        "regrettable",
        "regrettablement",
        "regretter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6863d28c-7e05-3000-8149-1706be98eb96",
                    "sense_definition": "Déplaisir d'avoir fait ou de ne pas avoir fait quelque chose, accompagné d'un sentiment de faute ou d'occasion manquée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "remords_faute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a exprimé un profond <w>regret</w> après avoir blessé son collègue par ses paroles."
                        },
                        {
                            "text": "Elle a pris cette décision difficile sans aucun <w>regret</w> pour son avenir professionnel."
                        }
                    ],
                    "synonyms": [
                        "remords",
                        "repentir"
                    ],
                    "common_phrases": [
                        "sans regret",
                        "avec regret"
                    ]
                },
                {
                    "sense_id": "18228bca-4bbd-3fd4-935f-3f4f771ff929",
                    "sense_definition": "Sentiment de contrariété employé dans des formules de politesse pour annoncer une nouvelle décevante ou décliner une proposition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politesse_contrariete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai le <w>regret</w> de vous informer que votre candidature n'a pas été retenue."
                        },
                        {
                            "text": "Nous sommes au <w>regret</w> de devoir annuler notre voyage à cause de la météo."
                        }
                    ],
                    "common_phrases": [
                        "avoir le regret de",
                        "au regret de"
                    ]
                },
                {
                    "sense_id": "14f7945d-9342-32ae-8209-0add47bf3dca",
                    "sense_definition": "Chagrin causé par la perte, la mort ou l'éloignement d'une personne chère.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deuil_perte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le départ soudain de ce professeur a laissé de sincères <w>regrets</w> parmi ses élèves."
                        },
                        {
                            "text": "La perte cruelle de cet ami cher lui a causé de vifs <w>regrets</w> pendant des années."
                        }
                    ],
                    "synonyms": [
                        "chagrin",
                        "peine"
                    ],
                    "common_phrases": [
                        "laisser des regrets",
                        "vifs regrets"
                    ]
                },
                {
                    "sense_id": "b753f9d7-1e52-3de1-9523-43cc0f6a4ca7",
                    "sense_definition": "Nostalgie ou souvenir mélancolique d'une époque passée ou d'un état antérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nostalgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En revoyant sa maison d'enfance, il a éprouvé un profond <w>regret</w> pour cette époque révolue."
                        },
                        {
                            "text": "Elle évoque toujours avec un doux <w>regret</w> les années insouciantes passées au bord de la mer."
                        }
                    ],
                    "synonyms": [
                        "nostalgie"
                    ],
                    "common_phrases": [
                        "regret du passé"
                    ]
                },
                {
                    "sense_id": "3ea88b48-4dc6-3f0a-bf84-c4eafb590621",
                    "sense_definition": "Lamentations ou plaintes exprimant une vive douleur morale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plaintes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses longs <w>regrets</w> résonnaient dans la nuit silencieuse sans trouver d'écho ni de consolation."
                        },
                        {
                            "text": "Le poète confiait ses éternels <w>regrets</w> au vent d'automne qui balayait les feuilles mortes."
                        }
                    ],
                    "synonyms": [
                        "doléance",
                        "lamentation",
                        "plainte"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "au pluriel dans un registre poétique ou littéraire ancien"
                        }
                    ]
                }
            ]
        }
    ]
}