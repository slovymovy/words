        "fr-extract.jsonl": [
            {
                "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                "word": "gadin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b319d498-7e41-4b85-a355-7b86eb2d3e73",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "tags": [
                            "plural"
                        ],
                        "form": "gadins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f3baa58-d566-3c74-9118-774c7975758a",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "glosses": [
                            "Chute, en particulier chute de cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf5b7911-155a-4117-b5b2-cf16c5e59364",
                                "sense_id": "7f3baa58-d566-3c74-9118-774c7975758a",
                                "text": "Mais, au tournant du Moulin, Saint-Martin ramassa un gadin colossal."
                            },
                            {
                                "example_id": "fff3a850-45fa-44a0-be05-b89e68cb6a73",
                                "sense_id": "7f3baa58-d566-3c74-9118-774c7975758a",
                                "text": "Il s’est pris un beau gadin."
                            },
                            {
                                "example_id": "d88b2695-6e25-4f3d-9dc3-8b7ccd26611d",
                                "sense_id": "7f3baa58-d566-3c74-9118-774c7975758a",
                                "text": "Courtial ! ton sphérique ! C’est la seule chose que tu saches faire ! Ailleurs tu prendras que des gadins ! C’est pas la peine que tu insistes ! Ton blot, c’est les ascensions !"
                            },
                            {
                                "example_id": "fb7b64a7-1b0c-4470-bd2f-87c831aa25a2",
                                "sense_id": "7f3baa58-d566-3c74-9118-774c7975758a",
                                "text": "– […] Chevau-légers !… Chevaux de bride et de remonte !… Chevaux d'artimon ! Chevaux de parade !… Dans tous les cas à la hauteur !… Ils ne pourront rien m'apprendre en Chine sur le cheval, la chevalerie, ses pompes, ses fers, ses avatars ! Je possède le métier dans la viande, j'ai pris des gadins par milliers !…"
                            },
                            {
                                "example_id": "2adc2d2a-a521-4b45-aa98-1c0a0340d7a2",
                                "sense_id": "7f3baa58-d566-3c74-9118-774c7975758a",
                                "text": "Des flics allaient et venaient, débonnaires, surtout attentifs à ne pas poser leurs godasses sur des détritus, ce qui leur auraient fait perdre l’équilibre et ramasser un gadin incompatible avec leur dignité."
                            }
                        ]
                    },
                    {
                        "sense_id": "02b20322-3ebf-3b97-a6c9-7fe7851b558d",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "glosses": [
                            "Cheval, bicyclette."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "58b71b5f-9632-4d83-9e20-0be4d65d0cbb",
                                "sense_id": "02b20322-3ebf-3b97-a6c9-7fe7851b558d",
                                "text": "Quand on parle vélo, je suis toujours là. Au séminaire, la maintenance, huit cents gadins à entretenir!"
                            }
                        ]
                    },
                    {
                        "sense_id": "d57b4274-cfe2-321b-9ec9-478fa1bff1f8",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "glosses": [
                            "Petite sphère fixée à l’extrémité d’un flotteur utilisé pour la pêche à la ligne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4c730aa4-c271-3866-b7e5-35ceeb89afef",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "glosses": [
                            "Caillou."
                        ],
                        "tags": [
                            "Lyonnais",
                            "Parler gaga",
                            "Parler dauphinois"
                        ],
                        "examples": [
                            {
                                "example_id": "2c3e565d-1041-4078-8724-58ab68342750",
                                "sense_id": "4c730aa4-c271-3866-b7e5-35ceeb89afef",
                                "text": "En plein cœur du patrimoine lyonnais, Le Petit Gadin fait un pied de nez au gros cailloux"
                            },
                            {
                                "example_id": "084a25bc-379f-411b-886d-c77ceb565498",
                                "sense_id": "4c730aa4-c271-3866-b7e5-35ceeb89afef",
                                "text": "Arrêtez de jeter des gadins après ces vaches !"
                            },
                            {
                                "example_id": "d98c30d1-03b8-4b7d-9c58-114194bd4d73",
                                "sense_id": "4c730aa4-c271-3866-b7e5-35ceeb89afef",
                                "text": "Non mais c’est au delà de ça, je crois. L’autre jour je revenais de la plage, je suis tombé sur un coin à fraises, alors je m’en suis fait un plein ventre... parce que les fraises, quand on leur fout la paix, en fait, elle sont consommables. Là, c’est aussi des fraises, probablement les mêmes d’ailleurs, mais par un procédé miraculeux que je n’arrive pas à m'imaginer, on dirait des gadins."
                            }
                        ]
                    },
                    {
                        "sense_id": "300c2f8c-042c-3287-94c6-afbc0e08110e",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "glosses": [
                            "Jeu d’adresse."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b03dffac-7a59-3277-aa5b-0fbbd7f45f04",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "glosses": [
                            "Intelligence."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e7c17ff4-de29-4fe6-b1b1-8587c393f164",
                                "sense_id": "b03dffac-7a59-3277-aa5b-0fbbd7f45f04",
                                "text": "Ce type-là, il a l’air de rien, mais c’est tout dans le gadin."
                            }
                        ]
                    },
                    {
                        "sense_id": "159b65b4-c3fe-3b60-ba4f-34f6883cceca",
                        "entry_id": "341343ad-6a9e-3c8f-ae42-48cd2bf18f09",
                        "glosses": [
                            "Nom vernaculaire du cerf de Java (Cervus timorensis ou Rusa timorensis)"
                        ],
                        "tags": [
                            "Nouvelle-Calédonie"
                        ],
                        "examples": [
                            {
                                "example_id": "eac78248-6c35-46a5-a8c1-0bb13926c0ce",
                                "sense_id": "159b65b4-c3fe-3b60-ba4f-34f6883cceca",
                                "text": "Pétez le gadin avec le double narine : invitez vous à un coup’d’chasse avec tonton Marcel pour aller \"péter le gadin\". C’est \"damé\" de cerfs en brousse. \"Quatquat\" et double narine (fusil à deux canons) obligatoires."
                            }
                        ]
                    }
                ],
