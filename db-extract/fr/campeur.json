        "fr-extract.jsonl": [
            {
                "entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
                "word": "campeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "49c2d1b2-8f0e-4f37-a176-05c37c5d570c",
                        "entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
