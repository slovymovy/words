    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cdb81a1d-a8cf-3576-a2c9-7db6a7bbf034",
                    "sense_definition": "Clean and free from pathogens; hygienic.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to keep the kitchen <w>sanitary</w> to prevent the spread of bacteria.",
                            "target_lang_translations": {
                                "zh": "保持厨房<w>卫生</w>对于防止细菌滋生和传播非常重要。"
                            }
                        },
                        {
                            "text": "The restaurant was closed because it failed to maintain <w>sanitary</w> conditions.",
                            "target_lang_translations": {
                                "zh": "这家餐馆因未能达到<w>卫生</w>标准而停业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hygienic",
                        "clean",
                        "sterile"
                    ],
                    "antonyms": [
                        "unsanitary",
                        "dirty"
                    ],
                    "common_phrases": [
                        "sanitary conditions",
                        "sanitary practices"
                    ],
                    "target_lang_definitions": {
                        "zh": "干净的，符合卫生的，无病原体的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卫生的",
                                "target_lang_sense_clarification": "干净、防病"
                            },
                            {
                                "target_lang_word": "清洁的",
                                "target_lang_sense_clarification": "无污垢、洁净"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1e235a8-3a2e-3255-bdbc-68a47a99c6d1",
                    "sense_definition": "Of or relating to health and the maintenance of public hygiene.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council is investing in better <w>sanitary</w> infrastructure for the growing population.",
                            "target_lang_translations": {
                                "zh": "市议会正投资改善<w>环卫</w>基础设施，以满足不断增长的人口需求。"
                            }
                        },
                        {
                            "text": "Public health officials monitor <w>sanitary</w> standards in all local schools.",
                            "target_lang_translations": {
                                "zh": "公共卫生官员负责监督当地所有学校的<w>卫生</w>标准。"
                            }
                        }
                    ],
                    "synonyms": [
                        "health-related"
                    ],
                    "common_phrases": [
                        "sanitary inspector",
                        "sanitary sewer"
                    ],
                    "target_lang_definitions": {
                        "zh": "卫生的，环境卫生或公共卫生方面的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卫生的",
                                "target_lang_sense_clarification": "与公共健康或环卫设施相关的"
                            },
                            {
                                "target_lang_word": "环境卫生的",
                                "target_lang_sense_clarification": "公共或环卫设施的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43111aa0-9399-38c7-adeb-f29ef14a18bd",
                    "sense_definition": "A sanitary towel or pad used for menstrual hygiene.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the store to buy a pack of <w>sanitaries</w>.",
                            "target_lang_translations": {
                                "zh": "她去商店买了一包<w>卫生巾</w>。"
                            }
                        },
                        {
                            "text": "The facility failed to provide adequate <w>sanitaries</w> for the residents.",
                            "target_lang_translations": {
                                "zh": "该机构未能为住户提供充足的<w>卫生巾</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sanitary pad",
                        "sanitary napkin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often considered dated or informal in many English-speaking regions."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "卫生巾，妇女月经期用的吸收垫"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卫生巾",
                                "target_lang_sense_clarification": "月经期间使用的护垫"
