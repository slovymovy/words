                        "examples": [
                            {
                                "example_id": "2acde8e7-2a19-40c8-82de-0d9ca42d6c76",
                                "sense_id": "298f6691-0fac-3e30-8141-f4326dc335ec",
                                "text": "„Es waren ein paar höllische Tage mit der ganzen Kotzerei, der Scheißerei, den aufgeschlagenen Knien, und jetzt hat man mich auch noch angeschossen, und ich liege in einem Rettungswagen, der vermutlich umkippen oder in einen Lastwagen donnern wird.“"
                            },
                            {
                                "example_id": "f1d87ef2-26dd-4a4a-b319-8a1ec9f65083",
                                "sense_id": "298f6691-0fac-3e30-8141-f4326dc335ec",
                                "text": "„›Lasst den Ingeles nur ... Was macht 'ne kleine Kotzerei einem Ketzer schon aus?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
