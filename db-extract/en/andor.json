                "senses": [
                    {
                        "sense_id": "d80ef8fc-8682-3ace-93f2-b2fbaa456a79",
                        "entry_id": "47199f1b-948c-355a-86f5-d995f9272a64",
                        "glosses": [
                            "Synonym of dandy or hammock litter, a strong cloth suspended from a pole or set of poles used as an open sedan chair."
                        ],
                        "tags": [
                            "India",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9353dcc9-842e-4d38-8f0c-0f1da523c2d0",
                                "sense_id": "d80ef8fc-8682-3ace-93f2-b2fbaa456a79",
                                "text": "P. della Valle writes in the same strain: \"And these two, the palankins and the andors [a kind of doli] also differ from one another, for in the andor the cane which sustains it is, as it is in the reti, straight; whereas in the palankin, for the greater convenience of the inmate, and to give more room for raising his head, the cane is arched upwards like this, _∩_...\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b6ffba16-df84-3df2-a247-a2b5230bf3ff",
                        "entry_id": "47199f1b-948c-355a-86f5-d995f9272a64",
                        "glosses": [
                            "Synonym of palanquin, used variously for nearly any kind of Indian litter."
                        ],
                        "tags": [
                            "India",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c9d7e7f8-6184-4751-86fd-e15176e4a79c",
                                "sense_id": "b6ffba16-df84-3df2-a247-a2b5230bf3ff",
                                "text": "1498. — \"After two days had passed he... came to the factory in an andor [i.e. a chowpaul] which men carried on their shoulders, and these... consist of great canes which are bent overhead and arched, and from these are hung certain cloths of a half fathom wide, and a fathom and a half long, and at the ends are pieces of wood to bear the cloth which hangs from the cane; and laid over the cloth there is a great mattrass of the same size, and this all made of silk-stuff wrought with gold-thread, and with many decorations and fringes and tassels; whilst the ends of the cane are mounted with silver, all very gorgeous, and rich, like the lords who travel so.\" — Correa, i. 102."
                            },
                            {
                                "example_id": "0f40c0fd-fcb9-4349-9bfa-404e84776c97",
                                "sense_id": "b6ffba16-df84-3df2-a247-a2b5230bf3ff",
                                "text": "1552. — \"The Moors all were on foot, and their Captain was a valiant Turk, who as being their Captain, for the honour of the thing was carried in an Andor [i.e. a takhtrawan] on the shoulders of 4 men, from which he gave his orders as if he were on horseback.\" — Barros, II. vi. viii."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6bc53dd-167b-3d23-b9fe-35b92026998f",
                        "entry_id": "47199f1b-948c-355a-86f5-d995f9272a64",
                        "glosses": [
                            "Synonym of litter, used in religious processions of saints' figurines."
                        ],
                        "tags": [
                            "Portugal"
                        ],
                        "examples": []
                    }
