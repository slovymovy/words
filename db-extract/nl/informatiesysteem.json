                                        "entry_id": "dab02f83-70c3-34ed-aa71-80077adca4d4",
                                        "glosses": [
                                            "Instrument (auch als Computerprogramm), um Nachrichten (Informationen) zu transportieren und zu verwalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a313d6c2-0268-4124-bb0b-f828a8409f78",
                                                "sense_id": "a272effd-dea3-3990-969c-578f7b6623ad",
                                                "text": "Sie besitzen ein ausgeklügeltes Informationssystem, so dass sie jederzeit wissen, wer sich wo aufhält."
                                            },
                                            {
                                                "example_id": "13fb747b-eff1-4978-91d3-8e55f3ebd060",
                                                "sense_id": "a272effd-dea3-3990-969c-578f7b6623ad",
                                                "text": "Das neue Informationssystem wird in allen 10 inländischen Verkaufsniederlassungen sowie auf dem Großrechner in der Zentrale eingesetzt."
                                            },
                                            {
                                                "example_id": "0d105571-42e6-483d-8119-7064a803f15c",
                                                "sense_id": "a272effd-dea3-3990-969c-578f7b6623ad",
                                                "text": "„Es schien hier eine Art unsichtbares Informationssystem zu geben, über das sich Neuigkeiten in Windeseile verbreiteten und das jegliche moderne Technik überflüssig machte.“"
                                            }
