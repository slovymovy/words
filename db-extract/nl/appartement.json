                    {
                        "sense_id": "02c33cc1-65d0-33ef-a36d-c147da694a9a",
                        "entry_id": "81ab7691-ab92-3f74-bb91-8c2c80c6ad36",
                        "glosses": [
                            "een afzonderlijke woning in een groter gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11a06c6-e0a5-44af-9f6a-95e70404bd3a",
                                "sense_id": "02c33cc1-65d0-33ef-a36d-c147da694a9a",
                                "text": "Al onze studenten hebben beschikking over een appartement."
                            },
                            {
                                "example_id": "2948da46-7709-44d4-ac5b-1d773841cc19",
                                "sense_id": "02c33cc1-65d0-33ef-a36d-c147da694a9a",
                                "text": "Toen ik na aankomst Hostel California in liep, bleek het tot mijn verbazing volgeboekt te zijn. En dit terwijl ik twee uur geleden nog had gereserveerd. Ik drong aan en mocht uiteindelijk de eerste nacht in het appartement van de eigenaar slapen, die blijkbaar de stad uit was."
                            },
                            {
                                "example_id": "93f35e0f-fe63-4a67-b293-4a26ae0fd427",
                                "sense_id": "02c33cc1-65d0-33ef-a36d-c147da694a9a",
                                "text": "We bleven lang in de hal staan en kusten elkaar alleen zonder iets te zeggen. Het was alsof we allebei een beetje bang waren om ermee op te houden, want dan moesten we door het hele appartement naar haar kamer lopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1de6e472-9dae-4786-937b-4739fb028e8c",
                        "source_entry_id": "81ab7691-ab92-3f74-bb91-8c2c80c6ad36",
                        "source_sense_id": "02c33cc1-65d0-33ef-a36d-c147da694a9a",
                        "source_sense_description": "een afzonderlijke woning in een groter gebouw",
                        "target_lang_word": "apartment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apartment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f7f9d83-3a66-36df-87f0-8d22fbfde446",
                                        "entry_id": "1b898a4c-fa73-3c63-a18d-e1df0397ada0",
                                        "glosses": [
                                            "A complete domicile occupying only part of a building, especially one for rent; a flat."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a4069b-b8bc-41e8-9146-b828d4eb3cfe",
                                                "sense_id": "9f7f9d83-3a66-36df-87f0-8d22fbfde446",
                                                "text": "apartment dwellers"
                                            },
                                            {
                                                "example_id": "7858c6a6-f5ae-43dd-9256-bc0e6928bb75",
                                                "sense_id": "9f7f9d83-3a66-36df-87f0-8d22fbfde446",
                                                "text": "I am Jonathan. I am in apartment B4. — I am in apartment C2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f5a138-2326-3b36-b88c-ff4479f57210",
                                        "entry_id": "1b898a4c-fa73-3c63-a18d-e1df0397ada0",
                                        "glosses": [
                                            "A suite of rooms within a domicile, designated for a specific person or persons and including a bedroom."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd988745-483a-40e7-8701-4c1f61232f7c",
                                                "sense_id": "18f5a138-2326-3b36-b88c-ff4479f57210",
                                                "text": "By this contrivance I got into the inmost court; and, lying down upon my side, I applied my face to the windows of the middle stories, which were left open on purpose, and discovered the most splendid apartments that can be imagined. There I saw the empress and the young princes in their several lodgings, with their chief attendants about them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d3b36f1-58cc-33b8-b6e7-25d2904c5a80",
                                        "entry_id": "1b898a4c-fa73-3c63-a18d-e1df0397ada0",
                                        "glosses": [
                                            "A division of an enclosure that is separate from others; a compartment."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722dc53b-d084-448d-a508-eee6d6f9a029",
                                                "sense_id": "6d3b36f1-58cc-33b8-b6e7-25d2904c5a80",
                                                "text": "1883 April 23, Slawson v. Grand Street R. Co., 107 U.S. 649, 2 S.Ct. 663, 664,\nThe specification described the ordinary fare-box used in street cars and omnibuses, consisting of two apartments, the one directly above the other.... [T]he passenger deposited his fare in an aperture in the top of the upper apartment. It fell upon and was arrested by a movable platform.... This platform turned on an axis acted on by a lever. When turned, the fare fell into the lower apartment, which was a receptacle for holding the fares accumulated...."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f606eeff-e88e-3f61-94f9-6d302b08315c",
                                        "entry_id": "1b898a4c-fa73-3c63-a18d-e1df0397ada0",
                                        "glosses": [
                                            "A conceptual space used for separation in the threading architecture. Objects in one apartment cannot directly access those in another, but must use a proxy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66f35cd5-256d-413d-b2b0-e99dccddfdbb",
                        "source_entry_id": "81ab7691-ab92-3f74-bb91-8c2c80c6ad36",
