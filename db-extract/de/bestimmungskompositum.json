                "senses": [
                    {
                        "sense_id": "69738357-a08d-33b8-af42-38b63ba48845",
                        "entry_id": "45ed7a70-802d-3dbf-93ac-78b152d085c8",
                        "glosses": [
                            "(Wort-)Zusammensetzung (Kompositum), bei der der erste Teil, das Bestimmungswort (Determinans), den zweiten, das Grundwort (Determinatum), in seiner Bedeutung näher bestimmt, einschränkt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b48bd3b-1efe-49b4-94da-294da2c7000d",
                                "sense_id": "69738357-a08d-33b8-af42-38b63ba48845",
                                "text": "„Untertypen der Bestimmungskomposita ergeben sich vor allem aus den verschiedenen Möglichkeiten der Wortart bei Grund- und Bestimmungswort; weitere Untergliederungen sind nach den Beziehungen zwischen dem durch Grund- und Bestimmungswort bezeichneten möglich.“"
                            },
                            {
                                "example_id": "333b7b15-5d0a-4bd7-a6db-0fb88da54220",
                                "sense_id": "69738357-a08d-33b8-af42-38b63ba48845",
                                "text": "„Größte Probleme bereiten derzeit noch Fremdwörter (besser ›nicht-native Wörter‹), bestimmte Formen von Bestimmungskomposita und längere Ketten einsilbiger Wörter. Fremdwörter, weil sie oft anders konstruiert sind und anderen prosodischen Regeln folgen [42], und Bestimmungskomposita, da sie oft eine Betonungsverschiebung (stress shift) auslösen, deren Erkennung noch nicht in allen Fällen funktioniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
