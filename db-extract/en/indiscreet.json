                    {
                        "translation_id": "4bce6e62-a9e5-486f-924e-c23511613495",
                        "source_entry_id": "bd94303a-ef02-38b1-b880-fb58faef3926",
                        "source_sense_id": "4293998e-18c3-3395-a2f5-fa7d42b8de42",
