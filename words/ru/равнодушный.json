{
    "word_family": [
        "равнодушие",
        "равнодушно"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "164c7f2b-218d-349a-bd14-31dee02fdd62",
                    "sense_definition": "Безразличный, не испытывающий никаких чувств по отношению к окружающему, происходящему.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "безразличие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он сохранял абсолютно <w>равнодушный</w> вид, хотя внутри у него всё кипело от злости.",
                            "target_lang_translations": {
                                "en": "He maintained an absolutely <w>indifferent</w> look, although inside he was seething with anger."
                            }
                        },
                        {
                            "text": "Нельзя оставаться <w>равнодушным</w> к чужому горю, когда людям нужна помощь.",
                            "target_lang_translations": {
                                "en": "One cannot remain <w>indifferent</w> to other people's grief when they need help."
                            }
                        }
                    ],
                    "synonyms": [
                        "безразличный",
                        "безучастный",
                        "апатичный",
                        "бесстрастный",
                        "индифферентный"
                    ],
                    "antonyms": [
                        "неравноду́шный",
                        "заинтересованный",
                        "озабоченный"
                    ],
                    "common_phrases": [
                        "равнодушный вид",
                        "равнодушный взгляд",
                        "оставаться равнодушным"
                    ],
                    "target_lang_definitions": {
                        "en": "Indifferent, showing no feelings or concern towards one's surroundings or events."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indifferent",
                                "target_lang_sense_clarification": "unconcerned or showing no interest"
                            },
                            {
                                "target_lang_word": "apathetic",
                                "target_lang_sense_clarification": "showing or feeling no interest, enthusiasm, or concern"
                            },
                            {
                                "target_lang_word": "unconcerned",
                                "target_lang_sense_clarification": "not worried or interested"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9881bb14-77ed-3b85-a4ba-81de548edafd",
                    "sense_definition": "Не испытывающий интереса, влечения к кому-либо или чему-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "безразличие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я совершенно <w>равнодушен</w> к сладкому, поэтому редко покупаю торты или конфеты.",
                            "target_lang_translations": {
                                "en": "I am completely <w>indifferent</w> to sweets, so I rarely buy cakes or candies."
                            }
                        },
                        {
                            "text": "Она была абсолютно <w>равнодушна</w> к его ухаживаниям и не отвечала взаимностью.",
                            "target_lang_translations": {
                                "en": "She was absolutely <w>indifferent</w> to his advances and did not reciprocate."
                            }
                        }
                    ],
                    "synonyms": [
                        "безразличный",
                        "индифферентный"
                    ],
                    "antonyms": [
                        "неравноду́шный",
                        "заинтересованный"
                    ],
                    "common_phrases": [
                        "равнодушен к сладкому",
                        "равнодушен к искусству"
                    ],
                    "target_lang_definitions": {
                        "en": "Having no interest, attraction, or liking for someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indifferent",
                                "target_lang_sense_clarification": "having no preference or interest in something"
                            },
                            {
                                "target_lang_word": "uninterested",
                                "target_lang_sense_clarification": "not interested or not caring about something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce911843-2650-3ad7-92bb-e233720a8d80",
                    "sense_definition": "Единодушный, имеющий то же самое состояние души.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старинных текстах встречается обращение к близкому другу как к <w>равнодушному</w> человеку, то есть единомышленнику.",
                            "target_lang_translations": {
                                "en": "In ancient texts, one finds an address to a close friend as a <w>like-minded</w> person, that is, a kindred spirit."
                            }
                        },
                        {
                            "text": "Ты же, человече <w>равнодушне</w>, владыко мой и знаемый мой.",
                            "target_lang_translations": {
                                "en": "But it was thou, a man, mine <w>equal</w>, my guide, and mine acquaintance."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "церковнославянское значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Like-minded, sharing the same state of mind or soul (archaic/Church Slavonic)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like-minded",
                                "target_lang_sense_clarification": "having a similar mind or soul"
                            },
                            {
                                "target_lang_word": "kindred",
                                "target_lang_sense_clarification": "sharing a similar spirit or nature"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}