                        ],
                        "examples": [
                            {
                                "example_id": "4b5ca41e-6ff3-4d67-b3a0-4d4ce9c17240",
                                "sense_id": "fe16d4e5-85d8-3b32-8b21-cf14aaa1b496",
                                "text": "The ISM report came as another worrying sign following last month's surprisingly low number, which ended a 34-month growth streak."
