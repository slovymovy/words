                            {
                                "example_id": "14e02617-7ea1-4a91-9a0e-7b3685e3fa82",
                                "sense_id": "b82178a3-78d5-3d77-be3c-a6c80e4bf202",
                                "text": "À une table voisine, un homme emmitouflé dans sa canadienne, face rougie par l’alcool sous son chapeau enfoncé jusqu’aux oreilles, montrait son verre vide de shôchû (alcool à base de riz, orge, patate douce, à plus forte teneur en alcool que le saké)."
                            },
                            {
                                "example_id": "d49d3e9f-18f5-427e-b517-42eb36405bbe",
                                "sense_id": "b82178a3-78d5-3d77-be3c-a6c80e4bf202",
                                "text": "Seuls des groupes d’îliens, qui en ont vu d’autres, continuent tranquillement de siroter leur shôchû, cet alcool de patate douce."
                            }
                        ]
                    }
