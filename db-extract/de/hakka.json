                "senses": [
                    {
                        "sense_id": "c490da43-47f7-3440-aeec-35f5049152f1",
                        "entry_id": "0e7e28e3-0eed-3109-a399-8a391f5aa974",
                        "glosses": [
                            "unter anderem im Osten Guangdongs gesprochene chinesische Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9950c79-b2f2-40dd-b073-94af2d1294c3",
                                "sense_id": "c490da43-47f7-3440-aeec-35f5049152f1",
                                "text": "„Ähnlich wie das Kantonesische erhält Hakka die ursprünglichen Verschlusslaute -b, -d, -g, und bildet einen Kontrast zum Hochchinesischen welches diese verloren hat.“"
                            },
                            {
                                "example_id": "7263cb3b-9ecc-418f-87f5-fb388255dea9",
                                "sense_id": "c490da43-47f7-3440-aeec-35f5049152f1",
                                "text": "„Ein großer Teil der Bevölkerung [Hainans] spricht auch Hakka.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
