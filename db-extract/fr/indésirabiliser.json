                "senses": [
                    {
                        "sense_id": "e8b70868-1f8c-3ab9-94d9-6f9045e9a07a",
                        "entry_id": "ea73617d-eb1e-3dba-850e-f9fc104e0848",
                        "glosses": [
                            "Attribuer un caractère indésirable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed39d7c-92bd-48dc-9340-f046f3c6370c",
                                "sense_id": "e8b70868-1f8c-3ab9-94d9-6f9045e9a07a",
                                "text": "J'ai beau \"indésirabiliser\" les mails, si ceux-ci reviennent (j'entends par là que l'envoyeur est le même), TB ne les filtre pas..."
                            },
                            {
                                "example_id": "61bcdc85-2fa2-4038-8bc3-1a93342d8c4c",
                                "sense_id": "e8b70868-1f8c-3ab9-94d9-6f9045e9a07a",
                                "text": "Nico ne cautionne pas ses conneries, toi aussi je peux t'indésirabiliser"
                            },
                            {
                                "example_id": "07d2e621-50a3-451a-82bc-a34912656632",
                                "sense_id": "e8b70868-1f8c-3ab9-94d9-6f9045e9a07a",
                                "text": "Un mail classé indésirable revient quand même en boite de réception, je voudrais donc savoir si la capacité de Mail (1,3,11) à indésirabiliser (!) un message n'est pas limitée."
                            }
                        ]
                    }
