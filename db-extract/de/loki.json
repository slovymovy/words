                "senses": [
                    {
                        "sense_id": "aec547d6-3c5a-33b1-9b39-104e882b7745",
                        "entry_id": "56364e80-2a08-31a9-8a5f-c01f92325473",
                        "glosses": [
                            "Figur aus der nordischen Mythologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49dd5706-0837-4efc-8879-d2cdb93c75ca",
                                "sense_id": "aec547d6-3c5a-33b1-9b39-104e882b7745",
                                "text": "„Die meisten seiner Zeitgenossen gingen davon aus, dass sich Holm einem magischen Zirkel des damals gefürchteten Hexenkults angeschlossen hatte und in den zahlreichen Überlieferungen uralter skandinavischer Mythen - etwa den Legenden über den listenreichen Loki und den mit einem Fluch belegten Fenriswolf - bestens auskannte.“"
                            },
                            {
                                "example_id": "c0d7903c-d74e-4dd1-b06d-7e74452e7f87",
                                "sense_id": "aec547d6-3c5a-33b1-9b39-104e882b7745",
                                "text": "„Und gegenwärtig, als er und sein Gefolge sich der stillen Stadt näherten, war der Stammesführer über die Maßen froh, dass er sich den guten Willen Odins und Lokis gesichert hatte.“"
                            },
                            {
                                "example_id": "31bab308-c3f5-4248-ad22-184dc23dfc5c",
                                "sense_id": "aec547d6-3c5a-33b1-9b39-104e882b7745",
                                "text": "„Die Christen vertrieben Pan und Loki und Mars, die jeweiligen Gottheiten der Griechen, Kelten und Römer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b29b6a0c-4817-455e-896f-9357fcad15e8",
                        "source_entry_id": "56364e80-2a08-31a9-8a5f-c01f92325473",
                        "source_sense_id": "aec547d6-3c5a-33b1-9b39-104e882b7745",
