                                        "examples": [
                                            {
                                                "example_id": "df37aa16-7541-4ec2-8419-febd594fa58c",
                                                "sense_id": "26530816-69c2-3d46-8ab5-a251f716085b",
                                                "text": "\"Many passengers will welcome the advice to wear a face covering. In Transport Focus's latest survey, over half of people say they wouldn't be happy using public transport unless passengers are required to wear face masks,\" said Transport Focus Chief Executive Anthony Smith."
