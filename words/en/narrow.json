                },
                {
                    "sense_id": "d717b05f-c55c-3c9d-9209-143274c58dec",
                    "sense_definition": "Lacking tolerance or flexibility; unwilling to accept different ideas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a very <w>narrow</w> view of the world and refuses to travel.",
                            "target_lang_translations": {
                                "ru": "У него очень <w>узкий</w> взгляд на мир, и он отказывается путешествовать.",
                                "nl": "Hij heeft een zeer <w>bekrompen</w> wereldbeeld en weigert te reizen.",
                                "zh": "他的世界观非常<w>狭隘</w>，拒绝去旅行。"
                            }
                        },
                        {
                            "text": "Such <w>narrow</w> opinions can prevent you from learning new things.",
                            "target_lang_translations": {
                                "ru": "Такие <w>узкие</w> взгляды могут помешать вам узнавать новое.",
                                "nl": "Dergelijke <w>bekrompen</w> meningen kunnen je ervan weerhouden nieuwe dingen te leren.",
                                "zh": "这种<w>狭隘</w>的观点会阻碍你学习新事物。"
                            }
                        }
                    ],
                    "antonyms": [
                        "broad"
                    ],
                    "common_phrases": [
                        "narrow mind",
                        "narrow view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный терпимости или гибкости; не желающий принимать иные идеи.",
                        "nl": "Gebrek aan tolerantie of flexibiliteit; onwillig om andere ideeën te accepteren.",
                        "zh": "指思想或观点保守，缺乏包容性，不愿接受新事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́зкий",
                                "target_lang_sense_clarification": "об уме или взглядах"
                            },
                            {
                                "target_lang_word": "недалёкий",
                                "target_lang_sense_clarification": "об умственных способностях"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bekrompen",
                                "target_lang_sense_clarification": "over iemands geest of opvattingen"
                            },
                            {
                                "target_lang_word": "nauwziend",
                                "target_lang_sense_clarification": "streng of beperkt in visie"
