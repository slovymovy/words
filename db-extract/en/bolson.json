                        "entry_id": "3cf84058-8568-3755-ab40-838a8af076f7",
                        "glosses": [
                            "A relatively flat and arid valley that is surrounded by mountains and that drains into a central basin."
                        ],
                        "tags": [
                            "Southwestern",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "03b586a0-0e86-449f-897e-af6e10c474de",
                                "sense_id": "0aeb0a7b-a81b-3b9e-9fc9-98fd1366eadd",
                                "text": "In three separate bolsons in West Texas, electrical-resistivity soundings and seismic-refraction profiles have been used . . . to estimate the alluvium thickness and ground-water quality."
                            },
                            {
                                "example_id": "120cfd55-5fd3-4e44-8fe6-761cd4fcbfdb",
                                "sense_id": "0aeb0a7b-a81b-3b9e-9fc9-98fd1366eadd",
                                "text": "The image of a colossal purse is helpful in envisioning a bolson in the landscape: an extensive, saucer-shaped basin, closed at the bottom and surrounded on all sides by mountain slopes."
                            },
                            {
                                "example_id": "51a0ba1e-52f7-469c-8ad8-fffad0d18334",
                                "sense_id": "0aeb0a7b-a81b-3b9e-9fc9-98fd1366eadd",
                                "text": "The water in the Mesilla Bolson, which is recharged by the river above it, is part of a major lawsuit between Texas and New Mexico. . . . A settlement could impose new restrictions on wells tapping the bolson in both states."
                            }
                        ]
                    }
