                "senses": [
                    {
                        "sense_id": "bda20acf-6689-3325-8a44-ec37ee25bad8",
                        "entry_id": "e639cf54-6aa8-3206-a60b-c77550deb23b",
                        "glosses": [
                            "Entreprise pratiquant l’affacturage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eacf94dc-a1ab-4718-90c5-c1784cb7e998",
                                "sense_id": "bda20acf-6689-3325-8a44-ec37ee25bad8",
                                "text": "C’est notamment le cas pour le contrat de factoring, par lequel l’adhérant prévoit qu’il subroge l’affactureur dans ses droits lorsque celui-ci lui paye le montant convenu pour la facture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9d7917f-5804-4752-8801-4d6a68066ace",
                        "source_entry_id": "e639cf54-6aa8-3206-a60b-c77550deb23b",
                        "source_sense_id": "bda20acf-6689-3325-8a44-ec37ee25bad8",
                        "target_lang_word": "factor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "factor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "182f7674-72c6-3d49-bc76-61e096aa32db",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "A doer, maker; a person who does things for another person or organization."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48792e2f-6058-4af3-90ec-2a8dc4c3a247",
                                                "sense_id": "182f7674-72c6-3d49-bc76-61e096aa32db",
                                                "text": "The factor of the trading post bought the furs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd26ac7-c996-314d-926d-f16668dce9a1",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "An agent or representative; a reseller or distributor (sometimes with a private label); a consignee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97e2cbda-93a0-4a92-b0ce-28d461ab5759",
                                                "sense_id": "3bd26ac7-c996-314d-926d-f16668dce9a1",
                                                "text": "My factor sends me word, a merchant's fled / That owes me for a hundred tun of wine."
                                            },
                                            {
                                                "example_id": "d7163e2e-c0dd-444d-aa4f-ed5010f700e2",
                                                "sense_id": "3bd26ac7-c996-314d-926d-f16668dce9a1",
                                                "text": "And let such as will number the Kings of Castile and Portugall amongst the warlike and magnanimous conquerors, seeke for some other adherent then my selfe, forsomuch as twelve hundred leagues from their idle residence they have made themselves masters of both Indias, onely by the conduct and direction of their factors, of whom it would be knowne whether they durst but goe and enjoy them in person."
                                            },
                                            {
                                                "example_id": "678e2c10-551d-420d-b22c-c271f1ec457f",
                                                "sense_id": "3bd26ac7-c996-314d-926d-f16668dce9a1",
                                                "text": "What does he therefore, but resolvs to give over toyling, and to find himself out som factor, to whose care and credit he may commit the whole managing of his religious affairs; som Divine of note and estimation that must be."
                                            },
                                            {
                                                "example_id": "85de4a13-780b-4f37-984a-8ae78d52497c",
                                                "sense_id": "3bd26ac7-c996-314d-926d-f16668dce9a1",
                                                "text": "Motor factors — Good factors will stock all of the more important components which wear out relatively quickly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f133657c-e18f-3452-a433-a7edb01c0ca3",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "A commission agent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "281c4824-a87b-3fb3-a2dc-7674296d2188",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "A person or business organization that provides money for another's new business venture; one who finances another's business."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d2640c0-d9c4-3594-9265-b4f2f9554b81",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "A business organization that lends money on accounts receivable or buys and collects accounts receivable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7857bc23-dda8-3722-ab52-7b0527000faf",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "One of the elements, circumstances, or influences which contribute to produce a result."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "306bfef1-70c8-4df1-aaa9-f581a3637e4b",
                                                "sense_id": "7857bc23-dda8-3722-ab52-7b0527000faf",
                                                "text": "The UN, for its part, has suggested eating insects as a way of feeding those extra mouths, which may put the frankenmeat ick factor in perspective."
                                            },
                                            {
                                                "example_id": "6e784d87-fde7-4e25-8d5b-aa2c639e13ad",
                                                "sense_id": "7857bc23-dda8-3722-ab52-7b0527000faf",
                                                "text": "The greatest factor in the decision was the need for public transportation."
                                            },
                                            {
                                                "example_id": "90551cdd-011f-4803-8afa-f24046f812f9",
                                                "sense_id": "7857bc23-dda8-3722-ab52-7b0527000faf",
                                                "text": "The economy was a factor in this year's budget figures."
                                            },
                                            {
                                                "example_id": "c213e3f3-9706-492d-b6f5-e09d1c6ff33e",
                                                "sense_id": "7857bc23-dda8-3722-ab52-7b0527000faf",
                                                "text": "1864-1898, Herbert Spencer, Principles of Biology\nthe material and dynamical factors of nutrition"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "320e4e63-1aff-32c1-9d47-8a5c38d6d80f",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "Any of various objects multiplied together to form some whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6d8821-d298-481a-b9dd-df66f19a3e3c",
                                                "sense_id": "320e4e63-1aff-32c1-9d47-8a5c38d6d80f",
                                                "text": "3 is a factor of 12, as are 2, 4 and 6."
                                            },
                                            {
                                                "example_id": "81906e3f-b114-4c12-b1a0-0c5355e903dc",
                                                "sense_id": "320e4e63-1aff-32c1-9d47-8a5c38d6d80f",
                                                "text": "The factors of the Klein four-group are both cyclic of order 2."
                                            },
                                            {
                                                "example_id": "61137847-8472-42cc-a47e-aa6fef16c2d8",
                                                "sense_id": "320e4e63-1aff-32c1-9d47-8a5c38d6d80f",
                                                "text": "The formula adjusts for region and season by multiplying by a prescribed factor for each."
                                            },
                                            {
                                                "example_id": "6fe13953-a8b7-4124-ac25-b9fc359679a6",
                                                "sense_id": "320e4e63-1aff-32c1-9d47-8a5c38d6d80f",
                                                "text": "The first thousand primes[…]marched in order before him[…]the complete sequence of all those numbers that possessed no factors except themselves and unity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c53a92c-52f5-38e6-bff7-c186fedc9a32",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "Influence; a phenomenon that affects the nature, the magnitude, and/or the timing of a consequence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca606ab-1a50-4e09-9859-4beec454cd2b",
                                                "sense_id": "3c53a92c-52f5-38e6-bff7-c186fedc9a32",
                                                "text": "The launch temperature was a factor of the Challenger disaster."
                                            },
                                            {
                                                "example_id": "ea66c68f-41dc-4041-98ae-6bb1b66a13ee",
                                                "sense_id": "3c53a92c-52f5-38e6-bff7-c186fedc9a32",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems— […]. Such a slow-release device containing angiogenic factors could be placed on the pia mater covering the cerebral cortex and tested in persons with senile dementia in long term studies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e1be7d-de74-3b65-b3f9-1fe8eee6b31b",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "A resource used in the production of goods or services, a factor of production."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ff8ca4-a0e6-4ff6-9488-511d0a26ea9e",
                                                "sense_id": "09e1be7d-de74-3b65-b3f9-1fe8eee6b31b",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies.[…]current tax rules make it easy for all sorts of firms to generate[…]“stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "265adf45-e693-3abf-8c81-7a9dd8c9efeb",
                                        "entry_id": "52706235-528d-3d8f-a46e-b140a7cb00ef",
                                        "glosses": [
                                            "A steward or bailiff of an estate."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "432009ce-896d-422e-b077-69908bb05bb5",
                                                "sense_id": "265adf45-e693-3abf-8c81-7a9dd8c9efeb",
                                                "text": "the factor was so scrupulous, as to keep the whole thing from his master, the lord chamberlain"
                                            }
                                        ]
                                    }
                                ]
