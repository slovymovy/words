        "pl-extract.jsonl": [
            {
                "entry_id": "4d41c134-6d86-3d4b-ad43-ecc899cabc42",
                "word": "rozprysk",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e9f6afdd-7fa0-3d1e-8137-48e1200bad6c",
                        "entry_id": "4d41c134-6d86-3d4b-ad43-ecc899cabc42",
                        "glosses": [
                            "strumień cieczy lub jego ślad w postaci rozbryzgniętych, drobniutkich kropel"
                        ],
                        "tags": [],
                        "examples": [],
