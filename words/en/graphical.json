{
    "word_family": [
        "graphic",
        "graphically",
        "graphics",
        "graph"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "106db81d-1622-3c89-81fe-a4e87c5bcced",
                    "sense_definition": "Relating to or using visual art, images, or computer-generated designs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visual_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software features a modern <w>graphical</w> user interface that is very easy to navigate.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение оснащено современным <w>графическим</w> пользовательским интерфейсом, в котором очень легко ориентироваться."
                            }
                        },
                        {
                            "text": "She is looking for a job in <w>graphical</w> design because she loves creating digital art.",
                            "target_lang_translations": {
                                "ru": "Она ищет работу в области <w>графического</w> дизайна, потому что любит создавать цифровое искусство."
                            }
                        }
                    ],
                    "synonyms": [
                        "visual",
                        "pictorial",
                        "illustrative"
                    ],
                    "antonyms": [
                        "textual"
                    ],
                    "common_phrases": [
                        "graphical user interface",
                        "graphical design",
                        "graphical representation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к изобразительному искусству, изображениям или компьютерному дизайну."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "графический",
                                "target_lang_sense_clarification": "связанный с компьютерной графикой или дизайном"
                            },
                            {
                                "target_lang_word": "изобразительный",
                                "target_lang_sense_clarification": "связанный с визуальным представлением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88b7942f-093a-35fe-b2e4-32f44c437039",
                    "sense_definition": "Relating to or shown by means of a graph or diagram.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report provides a <w>graphical</w> analysis of the company's sales growth over the last decade.",
                            "target_lang_translations": {
                                "ru": "В отчете представлен <w>графический</w> анализ роста продаж компании за последнее десятилетие."
                            }
                        },
                        {
                            "text": "We need a <w>graphical</w> display to help the audience understand these complex statistics.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>графическое</w> отображение, чтобы помочь аудитории понять эту сложную статистику."
                            }
                        }
                    ],
                    "synonyms": [
                        "diagrammatic"
                    ],
                    "common_phrases": [
                        "graphical analysis",
                        "graphical display",
                        "graphical method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к графикам или диаграммам или представленный с их помощью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "графический",
                                "target_lang_sense_clarification": "в виде графиков или схем"
                            },
                            {
                                "target_lang_word": "наглядный",
                                "target_lang_sense_clarification": "представленный в виде диаграмм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a41e5ec-3cfb-395f-a645-ee569ae2bfe0",
                    "sense_definition": "Consisting of or relating to writing, letters, or lines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone was covered in <w>graphical</w> symbols that no one could decipher.",
                            "target_lang_translations": {
                                "ru": "Древний камень был покрыт <w>письменными</w> символами, которые никто не мог расшифровать."
                            }
                        },
                        {
                            "text": "The finger of God hath left an inscription upon all his works, not <w>graphical</w> or composed of letters.",
                            "target_lang_translations": {
                                "ru": "Перст Божий оставил надпись на всех своих творениях, не <w>начертанную</w> и не состоящую из букв."
                            }
                        }
                    ],
                    "synonyms": [
                        "written",
                        "inscribed"
                    ],
                    "common_phrases": [
                        "graphical symbols"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to describe the physical nature of writing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из письма, букв или линий или относящийся к ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "письменный",
                                "target_lang_sense_clarification": "состоящий из знаков или букв"
                            },
                            {
                                "target_lang_word": "начертательный",
                                "target_lang_sense_clarification": "относящийся к способу написания или символам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}