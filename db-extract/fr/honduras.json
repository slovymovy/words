                                                "sense_id": "45658ceb-2a38-3d35-9566-cd7e450ae6b6",
                                                "text": "Tegucigalpa ist die Hauptstadt von Honduras."
                                            },
                                            {
                                                "example_id": "238060de-e008-4eed-9974-4d708c5d4e79",
                                                "sense_id": "45658ceb-2a38-3d35-9566-cd7e450ae6b6",
                                                "text": "„Die Kultur von Honduras ist mit Ausnahme einiger abgelegener Indianersiedlungen hauptsächlich spanisch geprägt.“"
                                            },
                                            {
                                                "example_id": "70238a42-ad38-4dae-a81c-8a67429ba741",
                                                "sense_id": "45658ceb-2a38-3d35-9566-cd7e450ae6b6",
                                                "text": "„Hinweise auf Siedlungen der Maya in Honduras gibt es seit mindestens 1000 v. Chr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
