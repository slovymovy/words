                            },
                            {
                                "target_lang_word": "exist",
                                "target_lang_sense_clarification": "to be present in a specific area or situation"
                            },
                            {
                                "target_lang_word": "be found",
                                "target_lang_sense_clarification": "to be located or present"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "о видах растений или животных"
                            },
                            {
                                "target_lang_word": "водиться",
                                "target_lang_sense_clarification": "о животных в среде обитания"
                            },
                            {
                                "target_lang_word": "распространение",
                                "target_lang_sense_clarification": "наличие чего-либо в контексте исследования"
                            }
                        ]
