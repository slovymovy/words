                                        "sense_id": "f521c6c7-8953-35b1-8f3b-6e73daa6ab58",
                                        "entry_id": "a9120988-dca8-36ea-a190-8a9485d47b86",
                                        "glosses": [
                                            "A halogenated hydrocarbon, trichloromethane, CHCl₃; it is a volatile, sweet-smelling liquid, used extensively as a solvent and formerly as an anesthetic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873a5681-67c8-44a3-9e3c-f77905b7211d",
                                                "sense_id": "f521c6c7-8953-35b1-8f3b-6e73daa6ab58",
                                                "text": "Some assume that chloroform is a gas because it was given by inhalation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
