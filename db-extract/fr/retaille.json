                ],
                "senses": [
                    {
                        "sense_id": "14ceb946-978d-3595-96bb-8977e9204cba",
                        "entry_id": "0713bc27-09da-3a5e-bce4-2a49152d528c",
                        "glosses": [
                            "Partie ou morceau qu’on retranche d’une chose en la façonnant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df7b523-fc90-442d-ae80-55bb8be4cf51",
                                "sense_id": "14ceb946-978d-3595-96bb-8977e9204cba",
                                "text": "Retaille d’une étoffe, d’une peau, etc."
                            },
                            {
                                "example_id": "77484d00-2429-4656-b74a-7ae688eafefa",
                                "sense_id": "14ceb946-978d-3595-96bb-8977e9204cba",
                                "text": "Toute l’après-midi, nous avions fait manœuvrer sur la scène des poupées de cinq à six centimètres de long, en porcelaine articulée ; nous avions peint des décors ; nous avions travaillé à Peau-d’Âne, enfin, — mais à Peau-d’Âne première manière — au milieu d’un grand fouillis de couleurs, de pinceaux, de retailles de carton, de papier doré et de morceaux de gaze."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7aa0f5d-263c-3c96-870b-8ba3f9b561e1",
                        "entry_id": "0713bc27-09da-3a5e-bce4-2a49152d528c",
                        "glosses": [
                            "Action de diviser puis humecter un marc de raisin ou de pomme et de le presser de nouveau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ef52622c-edd0-3dbb-a5e0-0966e63a8d4b",
                        "entry_id": "0713bc27-09da-3a5e-bce4-2a49152d528c",
                        "glosses": [
                            "Vin ou cidre issu de ce processus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "848bcbc0-a0c4-4445-8159-85e90b921447",
                                "sense_id": "ef52622c-edd0-3dbb-a5e0-0966e63a8d4b",
                                "text": "Les marcs ou aines, sont souvent retaillés, humectés d’un peu d’eau et repressés ; ils donnent ainsi un cidre léger, dit retaille."
                            }
                        ]
                    },
                    {
                        "sense_id": "26163046-c64f-3480-b728-88754dedf535",
                        "entry_id": "0713bc27-09da-3a5e-bce4-2a49152d528c",
                        "glosses": [
                            "Individu qui résigne à participer à des activités prévues à l’avance, qui abandonne ses amis au dernier moment."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    }
