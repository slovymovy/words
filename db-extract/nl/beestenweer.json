                        "examples": [
                            {
                                "example_id": "497f6f23-e09b-4a29-b085-55a82f4c2a85",
                                "sense_id": "575090dd-0dc5-3d3a-9ab5-d41878657376",
                                "text": "Beestenweer. De regen valt met bakken uit de hemel boven Papendal. Er staan plassen op de blauwe atletiekbaan. Weer om je training naar de sporthal te verplaatsen."
                            },
                            {
                                "example_id": "ca694805-9b12-4627-8a8e-4acda7c8c50e",
                                "sense_id": "575090dd-0dc5-3d3a-9ab5-d41878657376",
                                "text": "Woensdag was het beestenweer in Dwars door Vlaanderen. Liefst 78 renners stapten af. Nummer drie Dylan van Baarle zat een kwartier na de finish nog na te trillen. Achttien van de 22 ploegen hadden te maken met valpartijen en uitvallers. En Quintana? Pas in de finale moest hij passen, op de Oude Kwaremont. Uiteindelijk kwam hij als 78ste, zeven minuten na de winnaar, ogenschijnlijk rustig over de finish."
                            }
                        ]
                    }
