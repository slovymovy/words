                        "form_id": "3151ce7c-12c1-4eeb-a099-41c3a1aab6ac",
                        "entry_id": "dcfd9026-9ce4-33c9-b17e-1f52da7b2afe",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Anziehsachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35b748fa-3577-34c2-8b3f-0376696fe2fe",
                        "entry_id": "dcfd9026-9ce4-33c9-b17e-1f52da7b2afe",
                        "glosses": [
                            "Kleidung; oft die Bekleidung einer Person für einen bestimmten Tag oder Anlass; Bekleidung für Haustiere (Schoßhunde)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9d28a42a-dd14-48ad-a9d8-f4b8b7b7f6ab",
                                "sense_id": "35b748fa-3577-34c2-8b3f-0376696fe2fe",
                                "text": "Meine Mutter hatte mir heute Morgen keine Anziehsachen herausgelegt."
                            },
                            {
                                "example_id": "4aa8feea-d716-4a25-9bf0-112223c4dced",
                                "sense_id": "35b748fa-3577-34c2-8b3f-0376696fe2fe",
                                "text": "Ich wünsche mir neue Anziehsachen für meine Babypuppe."
                            },
                            {
                                "example_id": "80932e99-ef79-4ad8-8364-d6e0b1026f87",
                                "sense_id": "35b748fa-3577-34c2-8b3f-0376696fe2fe",
                                "text": "„Bei der Verteilung der Anziehsachen hatte ich gewaltiges Glück.“"
                            },
                            {
                                "example_id": "cbefe624-2f3c-45a8-be7f-b64a94039a8e",
                                "sense_id": "35b748fa-3577-34c2-8b3f-0376696fe2fe",
                                "text": "„Meine Mutter hatte Anziehsachen und Unterwäsche für mich in eine Tasche gestopft, ich hatte nach dem Schuhkarton gegriffen, der neben meinem Bett stand.“"
                            },
                            {
                                "example_id": "be9ac959-e668-4a5e-8b80-b2677ae63446",
                                "sense_id": "35b748fa-3577-34c2-8b3f-0376696fe2fe",
                                "text": "„Sie kamen mit Anziehsachen und sahen ihr in die Augen, wenn sie mit ihr redeten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfa6acb9-76d2-4aca-8109-f06c8de1e7ce",
