                    {
                        "sense_id": "6174d819-dcdb-3293-b8d2-32e6b4f4544e",
                        "entry_id": "4ce479fc-3420-31a4-b693-845992500224",
                        "glosses": [
                            "Retour des taureaux des arènes vers les pâturages à travers les rues d'une ville (l'abrivado désignant, au contraire, le transfert des pâturages vers les arènes)."
                        ],
                        "tags": [
                            "Occitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7c8787-bc92-4539-bcd2-b30e3728f0b3",
                                "sense_id": "6174d819-dcdb-3293-b8d2-32e6b4f4544e",
                                "text": "La bandido est le retour des taureaux à la manade"
                            },
                            {
                                "example_id": "fec932a8-cec6-4c0e-a681-ec2bc704889f",
                                "sense_id": "6174d819-dcdb-3293-b8d2-32e6b4f4544e",
                                "text": "Le retour s’effectuait dans les mêmes conditions, sauf dans les villages camarguais, proches des près comme Aimargues, le Cailar, Vauvert ou Saint-Laurent d’Aigouze. Dans ce cas le toril était ouvert en fin de course et les taureaux trouvaient naturellement la direction des près, guidés par leur instinct. Il faut voir là l’origine du mot bandido"
                            }
                        ]
                    }
                ],
