                "senses": [
                    {
                        "sense_id": "fcb37d2a-10a8-3bef-a6c9-6fb3f5452c23",
                        "entry_id": "10d24996-3208-35ca-952e-c0b8b1b77ad6",
                        "glosses": [
                            "истор. единица аптекарского веса, равная 20 гранам (1,24 грамма)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a960a2de-7658-413c-ac31-ce618afb86ca",
                                "sense_id": "fcb37d2a-10a8-3bef-a6c9-6fb3f5452c23",
                                "text": "Вываренные десять фунтов воды дали 4 унца и два скрупула обыкновенной поваренной соли."
                            },
                            {
                                "example_id": "3695d6dc-4374-4b06-b6a5-e0311dc45ead",
                                "sense_id": "fcb37d2a-10a8-3bef-a6c9-6fb3f5452c23",
                                "text": "В. М. Грибовский"
                            }
                        ]
                    },
                    {
                        "sense_id": "38db3179-ede8-312f-aa5b-935a0d37798f",
                        "entry_id": "10d24996-3208-35ca-952e-c0b8b1b77ad6",
                        "glosses": [
                            "перен. то же, что малая величина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8cf02f-8030-4209-a583-8b08f550acc4",
                                "sense_id": "38db3179-ede8-312f-aa5b-935a0d37798f",
                                "text": "Великий дух в маленьком и хилом теле одержал победу и торжествовал, но настал час расплаты, и каждый скрупул сил теперь на счету."
                            },
                            {
                                "example_id": "0328f712-a760-4d46-9b65-1e0285994038",
                                "sense_id": "38db3179-ede8-312f-aa5b-935a0d37798f",
                                "text": "Но нигде не оставили ни скрупула своей души, потому что оставить было нечего."
                            }
                        ]
                    }
                ],
