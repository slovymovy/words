                    {
                        "sense_id": "bfe2c4d2-69e7-318a-9f7e-9e9cccbdd7a4",
                        "entry_id": "5d8cf94d-7da9-3cf6-aa91-7118a814ac50",
                        "glosses": [
                            "Pompon, cerise sur le gâteau, nouveau problème après une suite de déconvenues."
