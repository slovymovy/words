                "senses": [
                    {
                        "sense_id": "34a63f28-6f80-3e44-bafb-d89c0d14c5de",
                        "entry_id": "cf5e5ab8-9052-3715-ba19-c2a90b499f5a",
                        "glosses": [
                            "Ramener la terre autour de la tige des pommes de terre, etc. quand la plante lève."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf932d7d-6a01-4198-bc18-dded34e08d07",
                                "sense_id": "34a63f28-6f80-3e44-bafb-d89c0d14c5de",
                                "text": "J'aimerais savoir quand renchausser les pommes de terre?"
                            },
                            {
                                "example_id": "b30c3f24-108b-43a4-9ec1-83258e160d99",
                                "sense_id": "34a63f28-6f80-3e44-bafb-d89c0d14c5de",
                                "text": "Après celui-ci, bien renchausser les plantules pour éviter le vernissage du collet."
                            },
                            {
                                "example_id": "87ddc488-d1ba-409e-9e6d-41569f5bf1c8",
                                "sense_id": "34a63f28-6f80-3e44-bafb-d89c0d14c5de",
                                "text": "Habituellement, on renchausse les patates à l'aide d'un tracteur équipé de deux disques à l'arrière qui poussent la terre sur le rang."
                            }
                        ]
                    }
