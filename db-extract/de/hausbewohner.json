                "senses": [
                    {
                        "sense_id": "29bf8aaa-ee94-3d6a-b06d-d2e0fb70ce39",
                        "entry_id": "9ad8a89a-343a-3624-ad21-dd920b35b375",
                        "glosses": [
                            "jemand, der in einem Haus wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e21c057-60ea-407c-9774-55eddd88c4b5",
                                "sense_id": "29bf8aaa-ee94-3d6a-b06d-d2e0fb70ce39",
                                "text": "„Noch ehe er mehr als zwei Monate in der Lindenallee 113 gewohnt hatte, sahen sich die meisten Hausbewohner von ihm bereits grußlos verachtet.“"
                            },
                            {
                                "example_id": "9d5518bd-1e52-4d3d-9d02-516a6e751044",
                                "sense_id": "29bf8aaa-ee94-3d6a-b06d-d2e0fb70ce39",
                                "text": "„Da die Häuser von der Grubenverwaltung bewirtschaftet wurden, hatten alle Hausbewohner die Pflicht, alle zwei Jahre die Hausflure zu streichen, und zwar in roter Farbe.“"
                            },
                            {
                                "example_id": "2685c65e-5c9d-4434-af2e-a14d54ca1b9f",
                                "sense_id": "29bf8aaa-ee94-3d6a-b06d-d2e0fb70ce39",
                                "text": "„Die Hausbewohner saßen im Dunkeln.“"
                            },
                            {
                                "example_id": "c32529d2-15eb-48f0-bdb3-d0aa6d816a3b",
                                "sense_id": "29bf8aaa-ee94-3d6a-b06d-d2e0fb70ce39",
                                "text": "„Es treten die Hausbewohner und andere Figuren als Hochzeitsgäste auf; sie repräsentieren die durchschnittliche bürgerliche Welt Österreichs oder Deutschlands.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
