                    {
                        "sense_id": "7f514b54-d285-34d2-b1f6-db736199e1fa",
                        "entry_id": "ce13eb32-7736-3fac-a69f-e3e893af0987",
                        "glosses": [
                            "Relatif au chinook, la langue."
