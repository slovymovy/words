            {
                "entry_id": "84bccfd4-1f50-3e0c-94e7-042418565750",
                "word": "surfusion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c4e47da-3b0b-4d75-a24f-3e47c57943c1",
                        "entry_id": "84bccfd4-1f50-3e0c-94e7-042418565750",
                        "tags": [
                            "plural"
                        ],
                        "form": "surfusions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0f87e43-d800-3c0c-8b50-f7e7a652f4c6",
                        "entry_id": "84bccfd4-1f50-3e0c-94e7-042418565750",
                        "glosses": [
                            "État métastable d’une matière qui demeure en phase liquide alors que sa température est plus basse que son point de solidification."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "c46e9fee-d2cc-4588-a5a7-324cd491eff3",
                                "sense_id": "c0f87e43-d800-3c0c-8b50-f7e7a652f4c6",
                                "text": "Tout se passe comme si l’eau qui est à la base de toute la vie végétale, animale, et on peut ajouter minérale de la Terre, se trouvait en état de surfusion et retrouvait brusquement son équilibre au contact de l’eau drue."
                            },
                            {
                                "example_id": "43f5b9f1-a958-4db4-ad3e-30ff560bf9cb",
                                "sense_id": "c0f87e43-d800-3c0c-8b50-f7e7a652f4c6",
                                "text": "Dans un lac en surfusion, il suffit d’une turbulence hasardeuse à un endroit pour que quelques molécules se cristallisent. S’il y en a suffisamment ça forme un germe stable qui se propage ensuite très rapidement dans tout le lac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30da792d-5ba1-4e02-af59-dd4a6e676c63",
                        "source_entry_id": "84bccfd4-1f50-3e0c-94e7-042418565750",
                        "source_sense_id": "c0f87e43-d800-3c0c-8b50-f7e7a652f4c6",
                        "target_lang_word": "Unterkühlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterkühlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb7c0a6-5710-3748-a8c6-4a669d329021",
                                        "entry_id": "f9d97130-9f92-348c-a956-7fce5968fd95",
                                        "glosses": [
                                            "Absenkung der Temperatur einer Flüssigkeit unter den Gefrierpunkt, ohne dass diese erstarrt"
                                        ],
                                        "tags": [
                                            "Thermodynamik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f7da8dd-651e-48d0-9cb3-7b170499fec9",
                                                "sense_id": "bbb7c0a6-5710-3748-a8c6-4a669d329021",
                                                "text": "Bei einer Unterkühlung von Wasser in einem Gefäß kristallisiert das Wasser nach einem Stoß gegen den Behälter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                        "entry_id": "f9d97130-9f92-348c-a956-7fce5968fd95",
                                        "glosses": [
                                            "tiefgehende Wirkung von Kälte auf Menschen und anderer Warmblüter in Verbindung mit einer Verringerung der Körpertemperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4649cd-aa85-4def-8512-6d048b2f208d",
                                                "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                                "text": "Nachdem die Person zu lange der Kälte ausgesetzt war, wurde sie mit einer Unterkühlung ins Krankenhaus eingeliefert."
                                            },
                                            {
                                                "example_id": "d2e04a83-3703-4b73-a5d0-57f1da77b1a2",
                                                "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                                "text": "„Über Monate andauernde Unterkühlung, Frostbeulen und Mangelernährung haben ihre Spuren hinterlassen.“"
                                            },
                                            {
                                                "example_id": "d5b279f6-ca0a-4795-8e51-81f3ec111207",
                                                "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                                "text": "„Um mich vor neuen Unterkühlungen zu schützen, erhalte ich einen blütenweißen Seidenschal, ein Prachtstück seiner Gattung, der früher einmal zu einem Frack gehörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
