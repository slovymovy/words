                "senses": [
                    {
                        "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                        "entry_id": "4a917bb4-b792-3b86-9e1b-48a51d5c245d",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59038f07-fe28-41fe-a8c5-f4743f8f5ecc",
                                "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                                "text": "Frau Ambrozaitis ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "90291ac1-ed31-4fb9-b624-120aa2d31333",
                                "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                                "text": "Herr Ambrozaitis wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bbb58f89-9b92-4b5a-8df0-d61dcb5c7a07",
                                "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                                "text": "Die Ambrozaitis fahren heute nach Bratislava."
                            },
                            {
                                "example_id": "70d1c4ee-c422-4e84-9764-ceca3175791d",
                                "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                                "text": "Der Ambrozaitis trägt nie die Schals, die die Ambrozaitis ihm strickt."
                            },
                            {
                                "example_id": "05b2e226-6b9f-4131-8aee-f1723465612a",
                                "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ambrozaitis kommt, geht der Herr Ambrozaitis.“"
                            },
                            {
                                "example_id": "c21cd4da-f7ab-4e04-b2cf-e4657ca22c7c",
                                "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                                "text": "Ambrozaitis kommt und geht."
                            },
                            {
                                "example_id": "233d0157-9c89-42c4-b0d5-fa391923fe83",
                                "sense_id": "08e8a6c9-8689-363b-9c1e-b5900d82e4f3",
                                "text": "Ambrozaitis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
