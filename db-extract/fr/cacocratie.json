                        "sense_id": "98a8a0a4-75f0-3d84-a254-c4ad783601c8",
                        "entry_id": "58f3545d-72fc-37e7-a6b5-314c8afdd863",
                        "glosses": [
                            "Gouvernement par les plus mauvais, mauvais gouvernement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f961b1b3-f8df-4cc2-a4d1-62db60724239",
                                "sense_id": "98a8a0a4-75f0-3d84-a254-c4ad783601c8",
                                "text": "La confiscation « démocratique » de tous les pouvoirs du Peuple, débouche de nos jours sur la « cacocratie », le gouvernement par les plus mauvais, célébré par les plus crapuleux et dont profitent les plus corrompus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c315935-edf4-4b4f-b528-f8a80bc37530",
                        "source_entry_id": "58f3545d-72fc-37e7-a6b5-314c8afdd863",
                        "source_sense_id": "98a8a0a4-75f0-3d84-a254-c4ad783601c8",
