                                            {
                                                "example_id": "ee824838-c353-4b4f-b27d-e4dadb3eca92",
                                                "sense_id": "a281976c-eab2-3719-8592-012a2df58031",
                                                "text": "Near-synonym: superheavyweight"
                                            },
                                            {
                                                "example_id": "e0dff971-e6aa-4150-bab1-8bad5f838624",
                                                "sense_id": "a281976c-eab2-3719-8592-012a2df58031",
                                                "text": "The superheavy tank weighed 80 tonnes and was said to be indestructible in combat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a28ca04-761b-3ab6-8182-cdbf8866e271",
                                        "entry_id": "dbc3e6ed-ab9a-3d3d-ba58-5cf6fda6c9e1",
                                        "glosses": [
                                            "Much heavier than usual.",
                                            "Describing a transuranic element with an extremely high atomic number; typically taken to mean beyond lawrencium (element 103, the last actinide)."
                                        ],
