                "senses": [
                    {
                        "sense_id": "10667822-6538-36d7-a0ae-9c259bb340f8",
                        "entry_id": "c4c98284-ca35-31f8-bce4-647c506e71a4",
                        "glosses": [
                            "Gonfler excessivement, ou plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2359467-35cf-49a2-92ff-d9b6965f4633",
                                "sense_id": "10667822-6538-36d7-a0ae-9c259bb340f8",
                                "text": "Il est surtout important de ne pas surgonfler le sur-matelas."
                            },
                            {
                                "example_id": "696c2481-30b2-4067-a051-1714d7f5499b",
                                "sense_id": "10667822-6538-36d7-a0ae-9c259bb340f8",
                                "text": "On peut être tenté, nous l'avons dit, de surgonfler pour permettre au pneu de supporter, croit-on, un surcroît de charge."
                            }
                        ]
                    },
                    {
                        "sense_id": "b27e6119-ae15-3ea4-b75c-202996fe5622",
