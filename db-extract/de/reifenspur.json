                ],
                "senses": [
                    {
                        "sense_id": "ea5a3e41-c89d-3837-b302-83443fff207c",
                        "entry_id": "8abdf489-8ee8-34ef-8125-9c051c4e7d24",
                        "glosses": [
                            "Spur, die von einem Reifen auf dem Untergrund hinterlassen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056da896-7ae4-4b22-8f89-ded4a1f8d658",
                                "sense_id": "ea5a3e41-c89d-3837-b302-83443fff207c",
                                "text": "Auf dem Waldweg wurden Reifenspuren sichergestellt."
                            },
                            {
                                "example_id": "eab613a0-2a47-4275-bdcf-01a18acd47d0",
                                "sense_id": "ea5a3e41-c89d-3837-b302-83443fff207c",
                                "text": "„Alle paar Kilometer waren bemalte Ölfässer zur Orientierung aufgestellt, aber trotz dieser Markierungen kam man leicht vom Weg ab, da die kreuz und quer verlaufenden Reifenspuren und die ewig gleiche Landschaft die Orientierung erschwerten.“"
                            },
                            {
                                "example_id": "94bfd2e4-03d2-4936-8a7f-832648ff35c1",
                                "sense_id": "ea5a3e41-c89d-3837-b302-83443fff207c",
                                "text": "„Er ging hinaus auf das Schwemmland und schlug einen weiten Bogen, um festzustellen, wo die Reifenspur im dünnen Gras in der Sonne sichtbar war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
