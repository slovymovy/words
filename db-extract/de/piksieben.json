                ],
                "senses": [
                    {
                        "sense_id": "eb28ba3a-969b-30b6-8615-afaccfe7a695",
                        "entry_id": "a4efc73d-9602-333d-8783-70e5c458ea3f",
                        "glosses": [
                            "Karte mit dem Wert 7 und in der Farbe Pik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2688193-c9a4-4484-aab9-1d8edf266c04",
                                "sense_id": "eb28ba3a-969b-30b6-8615-afaccfe7a695",
                                "text": "„Scholz, kluger Blick und kleiner Bauch unter dem dunkelblauen Pulli, ist der, der vorhin die Piksieben gespielt hat, der, den sie ‚Horsts Ziehsohn‘ nennen und die vielleicht letzte Generation des Skats in Deutschland, wie er selbst sagt.“"
                            },
                            {
                                "example_id": "968a5b31-7971-4b77-8c77-69c92916b6a7",
                                "sense_id": "eb28ba3a-969b-30b6-8615-afaccfe7a695",
                                "text": "„Heinz gewann schließlich nach mehr als sechs Stunden mit dem Ass-König gegen Staszko, der eine Piksieben und -zehn hielt.“"
                            },
                            {
                                "example_id": "5de1c171-5fd9-42af-baa0-d1d1b8268800",
                                "sense_id": "eb28ba3a-969b-30b6-8615-afaccfe7a695",
                                "text": "„Ich spielte die Piksieben aus, die einzige Farbe, die er nicht hatte.“"
                            },
                            {
                                "example_id": "c241626e-5bd7-4bef-ab69-be73fde5d000",
                                "sense_id": "eb28ba3a-969b-30b6-8615-afaccfe7a695",
                                "text": "„Enoch Root zählt den Stapel Karten fertig, wirft einen raschen Blick auf eine Piksieben, schließt für einen Augenblick die Augen und schreibt ein W auf seine Serviette.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
