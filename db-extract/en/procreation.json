                        "source_entry_id": "0c84b03c-6609-3205-9f18-808551b027c4",
                        "source_sense_description": "the process by which an organism produces others of its kind — see also reproduction",
                        "target_lang_word": "Fortpflanzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
