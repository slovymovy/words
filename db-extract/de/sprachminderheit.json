                "senses": [
                    {
                        "sense_id": "d155b49e-5b45-3440-bea8-3e3c39cbe49d",
                        "entry_id": "b17e7ead-87b8-39e2-8abf-73ecc27fe3ae",
                        "glosses": [
                            "Gruppe der Bevölkerung, die eine andere Sprache verwendet als die Mehrheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d580e6d-bea1-4436-aa0a-99fc1a921909",
                                "sense_id": "d155b49e-5b45-3440-bea8-3e3c39cbe49d",
                                "text": "„Unter dem juristischen Gesichtspunkt können die bestehenden Gesetzesbestimmungen betreffend die deutsche Sprachminderheit in Südtirol als eines der besten Modelle Europas zur Wahrung von Sprachminderheiten angesehen werden.“"
                            },
                            {
                                "example_id": "6662743e-e782-41e8-afc0-3819a97abb45",
                                "sense_id": "d155b49e-5b45-3440-bea8-3e3c39cbe49d",
                                "text": "„Für die Organisationen der Sprachminderheiten kann eine Sprachencharta, die eine der wesentlichen Bestimmungen ausklammert - nämlich den Artikeln aus Teil III zu \"Regionalsprachen als Amts- und Gerichtssprachen\" -, die Erosion der Sprachen in den Minderheitenregionen nicht aufhalten.“"
                            },
                            {
                                "example_id": "79b6b82b-9bd8-436f-a530-1d8f7cf75d2a",
                                "sense_id": "d155b49e-5b45-3440-bea8-3e3c39cbe49d",
                                "text": "„Welche sind eigentlich die \"wahren\" Minderheitensprachen Indiens, wer sind die Sprachminderheiten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
