                        "glosses": [
                            "Donner un caractère négroïde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1d407cf-ad90-4e7e-b533-92c8e50eeb79",
                                "sense_id": "fc082197-e438-32f1-90aa-338fcf5fa79b",
                                "text": "Il est reconnu qu’un anthropologue partial peut blanchir un nègre ou \"négroïdiser\" un leucoderme par une interprétation tendancieuse de mensurations et d’analyses partielles bien choisies."
                            },
                            {
                                "example_id": "c80e3298-37f4-4bb0-9fc0-987503e297df",
                                "sense_id": "fc082197-e438-32f1-90aa-338fcf5fa79b",
                                "text": "Thoma (1978) voit quant à lui des cromagnoïdes eurasiatiques envahir l’Afrique et s’y « négroïdiser » ; il ne croit du reste pas."
                            }
                        ]
                    }
