{
    "word_family": [
        "innocence",
        "innocenter",
        "innocemment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a69e0dc4-2957-3732-b9e4-bbbc933db23a",
                    "sense_definition": "Qui n'est pas coupable d'un délit, d'un crime ou d'une faute reprochée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé affirme qu'il est <w>innocent</w> et espère que le tribunal va l'acquitter."
                        },
                        {
                            "text": "Le juge a finalement libéré le suspect après avoir prouvé qu'il était <w>innocent</w>."
                        }
                    ],
                    "antonyms": [
                        "coupable"
                    ],
                    "common_phrases": [
                        "reconnu innocent",
                        "déclaré innocent"
                    ]
                },
                {
                    "sense_id": "71f0001d-6d5f-36e7-8d23-25121091cf9f",
                    "sense_definition": "Qui est pur, naïf, exempt de malice ou de noirceur morale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant a un regard <w>innocent</w> qui touche immédiatement tous ceux qui le rencontrent."
                        },
                        {
                            "text": "Elle croyait toutes leurs histoires avec la confiance d'une jeune fille <w>innocente</w>."
                        }
                    ],
                    "synonyms": [
                        "candide",
                        "pur",
                        "naïf"
                    ],
                    "antonyms": [
                        "malicieux",
                        "pervers"
                    ],
                    "common_phrases": [
                        "âme innocente",
                        "cœur innocent"
                    ]
                },
                {
                    "sense_id": "89cb10b5-eb1d-316c-9fa7-61b9356346ea",
                    "sense_definition": "Qui ne cause aucun dommage, qui ne présente aucun danger ; inoffensif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inoffensif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce qui semblait être une plaisanterie <w>innocente</w> a fini par blesser profondément son camarade."
                        },
                        {
                            "text": "Il s'agissait d'un jeu tout à fait <w>innocent</w> organisé pour divertir les invités de la fête."
                        }
                    ],
                    "synonyms": [
                        "inoffensif",
                        "anodin"
                    ],
                    "antonyms": [
                        "dangereux",
                        "nuisible",
                        "malveillant"
                    ],
                    "common_phrases": [
                        "jeu innocent",
                        "plaisanterie innocente"
                    ]
                },
                {
                    "sense_id": "57d2174b-aae7-3d40-b209-c2c532634930",
                    "sense_definition": "Qui fait preuve d'une crédulité excessive ou d'un manque de discernement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "credule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est bien <w>innocent</w> de penser que cette offre en ligne est totalement gratuite."
                        },
                        {
                            "text": "Tu es trop <w>innocente</w> pour voir que ces personnes profitent souvent de ta gentillesse."
                        }
                    ],
                    "synonyms": [
                        "crédule",
                        "niais"
                    ],
                    "antonyms": [
                        "méfiant",
                        "avisé"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81460456-88c1-3fba-ba8f-52d0054d471f",
                    "sense_definition": "Personne qui n'a commis aucun crime, aucun délit ni aucune faute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers poursuivent leur enquête afin de ne pas enfermer un <w>innocent</w> en prison."
                        },
                        {
                            "text": "La justice doit veiller à protéger chaque <w>innocent</w> contre les fausses accusations."
                        }
                    ],
                    "antonyms": [
                        "coupable"
                    ],
                    "common_phrases": [
                        "condamner un innocent"
                    ]
                },
                {
                    "sense_id": "e905ce2d-5b75-3018-9a02-29dae3d38009",
                    "sense_definition": "Personne naïve, crédule ou qui feint l'ignorance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "credule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne fais pas l'<w>innocent</w>, nous savons tous les deux que tu as cassé ce vase."
                        },
                        {
                            "text": "Ce garçon est un grand <w>innocent</w> qui ne comprend jamais les remarques sarcastiques."
                        }
                    ],
                    "synonyms": [
                        "naïf"
                    ],
                    "common_phrases": [
                        "faire l'innocent"
                    ]
                },
                {
                    "sense_id": "94808aee-883a-3d54-9afb-1e5fcb456d86",
                    "sense_definition": "Personne simple d'esprit ou atteinte de déficience intellectuelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce vieux roman de campagne, le village prenait pitié de l'<w>innocent</w> qui errait seul."
                        },
                        {
                            "text": "La vieille servante nourrissait chaque soir l'<w>innocent</w> de la paroisse, incapable de travailler."
                        }
                    ],
                    "synonyms": [
                        "simple d'esprit"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme vieilli pour désigner une personne simple d'esprit"
                        }
                    ]
                },
                {
                    "sense_id": "38b9a8dd-2d99-36c9-a374-5d01cf66c330",
                    "sense_definition": "Très jeune enfant, considéré comme n'ayant pas la notion du mal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi Hérode ordonna le massacre des <w>innocents</w>, tous les nouveau-nés de Bethléem."
                        },
                        {
                            "text": "La mère berçait doucement le petit <w>innocent</w> qui dormait dans son berceau."
                        }
                    ],
                    "common_phrases": [
                        "massacre des Innocents"
                    ]
                }
            ]
        }
    ]
}