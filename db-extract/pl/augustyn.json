                                    },
                                    {
                                        "sense_id": "ea77fdc8-f9b2-39d0-aace-4f7a991af583",
                                        "entry_id": "0b323f59-0985-37aa-a0bf-831937ecc8c3",
                                        "glosses": [
                                            "Augustin d'Hippone, dit saint Augustin (354-430), un des pères de l'Église."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df8c8e43-d3c2-4169-a5be-55614fe6cb08",
                                                "sense_id": "ea77fdc8-f9b2-39d0-aace-4f7a991af583",
                                                "text": "Né dans une famille honorable mais sans richesse, Augustin vécut comme un moine depuis son retour dans son Afrique natale en 388 jusqu'à sa mort en 430."
                                            },
                                            {
                                                "example_id": "6cc33b21-323a-4bd4-ba0f-7a741c5080c5",
                                                "sense_id": "ea77fdc8-f9b2-39d0-aace-4f7a991af583",
                                                "text": "Elle se disait aussi cette phrase de saint Augustin, qui depuis toujours l’avait soutenue : « Où est l’amour, il n’y a point de labeur. »"
                                            }
                                        ]
                                    }
                                ]
                            },
