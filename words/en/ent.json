{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b522c1e-c6f6-3951-8353-3b87c915d276",
                    "sense_definition": "The medical specialty or department dealing with the ear, nose, and throat (otolaryngology).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_ent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clinic referred her to the hospital's <w>ENT</w> department for further evaluation.",
                            "target_lang_translations": {
                                "ru": "Поликлиника направила её в <w>ЛОР</w>-отделение больницы для дальнейшего обследования."
                            }
                        },
                        {
                            "text": "He specializes in pediatric <w>ENT</w> after completing years of surgical training.",
                            "target_lang_translations": {
                                "ru": "Он специализируется на детской <w>оториноларингологии</w> после долгих лет хирургической подготовки."
                            }
                        }
                    ],
                    "synonyms": [
                        "otolaryngology",
                        "otorhinolaryngology"
                    ],
                    "common_phrases": [
                        "ENT specialist",
                        "ENT clinic",
                        "ENT doctor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская специальность или отделение, занимающееся заболеваниями уха, горла и носа (оториноларингология)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ЛОР",
                                "target_lang_sense_clarification": "отделение или область медицины"
                            },
                            {
                                "target_lang_word": "оториноларингология",
                                "target_lang_sense_clarification": "медицинская дисциплина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79a3ffad-9341-3e50-b8f0-949bf165c223",
                    "sense_definition": "A doctor who specializes in the treatment of ear, nose, and throat disorders.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_ent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After suffering from chronic sinus infections, she decided to consult an <w>ENT</w>.",
                            "target_lang_translations": {
                                "ru": "После длительных мучений с хроническим гайморитом она решила проконсультироваться с <w>ЛОРом</w>."
                            }
                        },
                        {
                            "text": "The local <w>ENT</w> diagnosed the hearing loss as temporary and treatable.",
                            "target_lang_translations": {
                                "ru": "Местный <w>отоларинголог</w> определил, что потеря слуха является временной и поддаётся лечению."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Врач, специализирующийся на лечении заболеваний уха, горла и носа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ЛОР",
                                "target_lang_sense_clarification": "врач"
                            },
                            {
                                "target_lang_word": "отоларинголог",
                                "target_lang_sense_clarification": "врач"
                            },
                            {
                                "target_lang_word": "лор-врач",
                                "target_lang_sense_clarification": "врач"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24b6cf9d-805b-3bc4-b84b-6978d26591f0",
                    "sense_definition": "A fictional, tree-like humanoid being featured in fantasy literature, especially the works of J. R. R. Tolkien.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fantasy_creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the novel, an ancient <w>ent</w> named Treebeard guards the ancient forest.",
                            "target_lang_translations": {
                                "ru": "В романе древний <w>энт</w> по имени Древобород охраняет первозданный лес."
                            }
                        },
                        {
                            "text": "The massive creatures marched toward the fortress like an army of living <w>ents</w>.",
                            "target_lang_translations": {
                                "ru": "Массивные существа маршировали к крепости, словно армия живых <w>энтов</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленное древоподобное гуманоидное существо в фэнтези, преимущественно в произведениях Дж. Р. Р. Толкина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "энт",
                                "target_lang_sense_clarification": "древоподобное существо"
                            },
                            {
                                "target_lang_word": "онт",
                                "target_lang_sense_clarification": "вариант перевода у Толкина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc9ae04b-580d-30bf-91a5-3d07571b7b46",
                    "sense_definition": "Alternative letter-case form of <w>ent</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fantasy_creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The giant <w>Ent</w> spoke very slowly to the astonished travelers.",
                            "target_lang_translations": {
                                "ru": "Исполинский <w>Энт</w> говорил очень медленно с изумлёнными путниками."
                            }
                        },
                        {
                            "text": "Readers often identify Treebeard as the most famous <w>Ent</w> in fantasy fiction.",
                            "target_lang_translations": {
                                "ru": "Читатели часто называют Древоборода самым известным <w>Энтом</w> в жанре фэнтези."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "capitalized form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова «ent» с заглавной буквы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Энт",
                                "target_lang_sense_clarification": "с заглавной буквы"
                            },
                            {
                                "target_lang_word": "энт",
                                "target_lang_sense_clarification": "существо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77480200-a683-38de-b7ba-103a8e812bd5",
                    "sense_definition": "To pour, especially referring to heavy rainfall.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to stay indoors because the sky began to <w>ent</w> down rain.",
                            "target_lang_translations": {
                                "ru": "Мы решили остаться дома, потому что с неба начало <w>лить как из ведра</w>."
                            }
                        },
                        {
                            "text": "The clouds opened up and it started <w>enting</w> down all afternoon.",
                            "target_lang_translations": {
                                "ru": "Небо разверзлось, и весь день <w>лило</w> без остановки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily regional or dialectal British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лить как из ведра, сильно литься (о проливном дожде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лить",
                                "target_lang_sense_clarification": "о сильном дожде"
                            },
                            {
                                "target_lang_word": "лить как из ведра",
                                "target_lang_sense_clarification": "о сильном ливне"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}