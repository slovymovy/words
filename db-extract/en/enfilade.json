                                "target_senses": [
                                    {
                                        "sense_id": "e16d9d12-cf2f-3ec1-bdc4-9d739f9374dc",
                                        "entry_id": "092dffed-8f54-379c-bd7f-e25359af4f2c",
                                        "glosses": [
                                            "geradliniger Verlauf einer Bebauung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde500f9-ffa1-4ff3-84e6-a36dee273e7b",
                                                "sense_id": "e16d9d12-cf2f-3ec1-bdc4-9d739f9374dc",
                                                "text": "Sie werden im Ergebnis von Analysen u. a. in Denkmalbestandskarten erfaßt, die Denkmalschutzgebiete, geschützte Straßen und Platzräume, Blickbeziehungen und Baufluchten, Denkmale u. a. wegen der charakterist. Ensemblewirkung » erhaltenswerte Bauten « ausweisen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
