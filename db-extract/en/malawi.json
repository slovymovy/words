                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "Lilongwe ist die Hauptstadt von Malawi."
                                            },
                                            {
                                                "example_id": "fa0b4575-4640-4043-b2e2-39decdef3195",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "Rund 13 Millionen Menschen leben in Malawi."
                                            },
                                            {
                                                "example_id": "06fe73b8-87a9-4fb0-95d8-8cc066055106",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "Die Kapichira-Wasserfälle im afrikanischen Malawi sind vor allem in der Regenzeit spektakulär."
                                            },
                                            {
                                                "example_id": "e0e45ce8-cfe6-4f07-9cf7-16ca081850b0",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "„Ich wurde Lehrer an einer kleinen Schule in Malawi und danach Dozent an der Universität Makere in Uganda.“"
                                            }
