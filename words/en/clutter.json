{
    "word_family": [
        "cluttered",
        "cluttering",
        "uncluttered"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3992987-acbf-3a19-9237-101ea6c1ca2b",
                    "sense_definition": "to fill a space with a messy or disorganized collection of things",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>clutter</w> the hallway with your shoes and bags.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>загромождайте</w> коридор своей обувью и сумками."
                            }
                        },
                        {
                            "text": "Old newspapers and magazines began to <w>clutter</w> up the small living room.",
                            "target_lang_translations": {
                                "ru": "Старые газеты и журналы начали <w>захламлять</w> маленькую гостиную."
                            }
                        }
                    ],
                    "synonyms": [
                        "litter",
                        "mess up"
                    ],
                    "antonyms": [
                        "tidy",
                        "organize",
                        "clear"
                    ],
                    "common_phrases": [
                        "clutter up"
                    ],
                    "target_lang_definitions": {
                        "ru": "заполнять пространство беспорядочным или неорганизованным набором вещей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захламлять",
                                "target_lang_sense_clarification": "заполнять ненужными вещами"
                            },
                            {
                                "target_lang_word": "загромождать",
                                "target_lang_sense_clarification": "занимать место крупными предметами"
                            },
                            {
                                "target_lang_word": "заваливать",
                                "target_lang_sense_clarification": "покрывать слоем вещей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da250494-66f9-3efa-ba30-51b69f74ca4e",
                    "sense_definition": "to speak very quickly and unclearly, often repeating or omitting syllables",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When he gets nervous, he tends to <w>clutter</w> his words together.",
                            "target_lang_translations": {
                                "ru": "Когда он нервничает, он склонен <w>тараторить</w> и путать слова."
                            }
                        },
                        {
                            "text": "The therapist helped the child who would <w>clutter</w> during stressful conversations.",
                            "target_lang_translations": {
                                "ru": "Терапевт помогал ребенку, который начинал <w>говорить невнятно</w> во время стрессовых разговоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "jabber",
                        "gabble"
                    ],
                    "antonyms": [
                        "enunciate",
                        "articulate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in clinical contexts regarding speech disorders"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "говорить очень быстро и невнятно, часто повторяя или пропуская слоги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тараторить",
                                "target_lang_sense_clarification": "говорить быстро и неразборчиво"
                            },
                            {
                                "target_lang_word": "бормотать",
                                "target_lang_sense_clarification": "говорить невнятно"
                            },
                            {
                                "target_lang_word": "захлёбываться словами",
                                "target_lang_sense_clarification": "говорить слишком быстро от волнения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "857532e2-c227-3016-9c13-dd223931f3be",
                    "sense_definition": "a large number of things that are scattered in a messy or disorganized way",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the whole weekend trying to clear the <w>clutter</w> from her desk.",
                            "target_lang_translations": {
                                "ru": "Она провела все выходные, пытаясь разобрать <w>беспорядок</w> на своем столе."
                            }
                        },
                        {
                            "text": "The room was full of visual <w>clutter</w> that made it hard to focus.",
                            "target_lang_translations": {
                                "ru": "Комната была полна визуального <w>шума</w>, из-за которого было трудно сосредоточиться."
