{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "446a6209-e389-3315-9a25-40e6ad3a6d3e",
                    "sense_definition": "zaimek wskazujący dla rodzaju żeńskiego, wskazujący na osobę lub rzecz znajdującą się blisko lub przed chwilą wspomnianą",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zaimek_wskazujacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ta</w> dziewczyna jest bardzo ładna i sympatyczna.",
                            "target_lang_translations": {
                                "ru": "<w>Эта</w> девушка очень красивая и приятная.",
                                "en": "<w>This</w> girl is very pretty and nice."
                            }
                        },
                        {
                            "text": "Bardzo podoba mi się <w>ta</w> książka, którą teraz czytam.",
                            "target_lang_translations": {
                                "ru": "Мне очень нравится <w>эта</w> книга, которую я сейчас читаю.",
                                "en": "I really like <w>this</w> book that I am reading right now."
                            }
                        }
                    ],
                    "synonyms": [
                        "owa"
                    ],
                    "antonyms": [
                        "tamta"
                    ],
                    "common_phrases": [
                        "ta kobieta",
                        "ta książka",
                        "ta sprawa"
                    ],
                    "target_lang_definitions": {
                        "ru": "указательное местоимение женского рода, указывающее на человека или предмет, находящийся близко или только что упомянутый",
                        "en": "demonstrative pronoun for the feminine gender, indicating a person or thing that is nearby or was mentioned just a moment ago"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эта",
                                "target_lang_sense_clarification": "указывает на близкий предмет или человека"
                            },
                            {
                                "target_lang_word": "та",
                                "target_lang_sense_clarification": "указывает на более отдаленный или ранее упомянутый предмет"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "this",
                                "target_lang_sense_clarification": "referring to a feminine person or thing nearby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a9cf0608-5732-337d-8a60-9ed765d33291",
                    "sense_definition": "potoczne potwierdzenie lub wyrażenie zgody; tak",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "potwierdzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Idziesz jutro do kina? — <w>Ta</w>, pewnie, chętnie pójdę.",
                            "target_lang_translations": {
                                "ru": "— Ты идешь завтра в кино? — <w>Да</w>, конечно, с удовольствием пойду.",
                                "en": "— Are you going to the cinema tomorrow? — <w>Yeah</w>, sure, I'd love to go."
                            }
                        },
                        {
                            "text": "— Czy to twoja zguba? — <w>Ta</w>, dzięki wielkie za pomoc!",
                            "target_lang_translations": {
                                "ru": "— Это твоя потеряшка? — <w>Ага</w>, спасибо огромное за помощь!",
                                "en": "— Is this your lost item? — <w>Yep</w>, thanks a lot for the help!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "no ta"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w języku potocznym zamiast 'tak'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разговорное подтверждение или выражение согласия; да",
                        "en": "colloquial confirmation or expression of agreement; yes, yeah"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "выражение согласия"
                            },
                            {
                                "target_lang_word": "ага",
                                "target_lang_sense_clarification": "разговорное согласие"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "yeah",
                                "target_lang_sense_clarification": "colloquial agreement"
                            },
                            {
                                "target_lang_word": "yep",
                                "target_lang_sense_clarification": "informal confirmation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "81b0a38e-9e53-33d8-9115-8c1c12c862ee",
                    "sense_definition": "spójnik łączący zdania lub ich części; i, a",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spojnik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Siedzieli cicho, <w>ta</w> patrzyli na zachodzące słońce.",
                            "target_lang_translations": {
                                "ru": "Сидели тихо <w>да</w> смотрели на заходящее солнце.",
                                "en": "They sat quietly <w>and</w> looked at the setting sun."
                            }
                        },
                        {
                            "text": "Przyszła jesień, <w>ta</w> liście zaczęły opadać z drzew.",
                            "target_lang_translations": {
                                "ru": "Пришла осень, <w>и</w> листья начали опадать с деревьев.",
                                "en": "Autumn came, <w>and</w> the leaves began to fall from the trees."
                            }
                        }
                    ],
                    "synonyms": [
                        "a",
                        "i",
                        "taj"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "używane głównie w dialektach kresowych"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "союз, соединяющий предложения или их части; и, да",
                        "en": "conjunction linking sentences or their parts; and"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "в значении союза 'и'"
                            },
                            {
                                "target_lang_word": "и",
                                "target_lang_sense_clarification": "соединительный союз"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "and",
                                "target_lang_sense_clarification": "regional or dialectal conjunction"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}