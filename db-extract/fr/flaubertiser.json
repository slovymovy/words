                "senses": [
                    {
                        "sense_id": "7b9ffdb8-9686-3b99-b515-9435ac407b0e",
                        "entry_id": "1771cc3c-4874-32bb-be8e-2efbb6cbb23e",
                        "glosses": [
                            "Écrire à la manière de Gustave Flaubert."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ee958d25-0bc1-3b65-bc93-d1b5077c3c91",
                        "entry_id": "1771cc3c-4874-32bb-be8e-2efbb6cbb23e",
                        "glosses": [
                            "Donner un caractère rappelant Gustave Flaubert à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a27536-3847-45da-a9c5-5cc97b3fcad4",
                                "sense_id": "ee958d25-0bc1-3b65-bc93-d1b5077c3c91",
                                "text": "Sartre n’a pas fait un Proust, il a fait son Proust, étrange narrateur-philosophe racontant sa recherche à travers celle du temps perdu de Flaubert, sartrisant Flaubert ou flaubertisant Sartre, on ne sait même plus, à moins qu’il n’ait passé tout ce temps à se proustianiser, à se rêver narrateur proustien fabriquant « le roman vrai » de la vocation de Flaubert."
                            },
                            {
                                "example_id": "3a1fab63-a9c2-43d9-8a5c-544d1e812576",
                                "sense_id": "ee958d25-0bc1-3b65-bc93-d1b5077c3c91",
                                "text": "J’ai beau sociologiser (les choses), flaubertiser (la vie), dramatiser (le souvenir d’enfance), je mesure l’effet de déception, de délavement, le charme évanoui."
                            }
                        ]
                    }
