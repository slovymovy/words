    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b9689e22-b037-3362-bf92-2e4dae6c70b9",
                "word": "Judea",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1fea7334-4f15-31b8-a64c-19de16c9c1ce",
                        "entry_id": "b9689e22-b037-3362-bf92-2e4dae6c70b9",
                        "glosses": [
                            "Roman rendition of Judah. Used after the fall of the Davidic dynasty and through the period as part of the Roman Empire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1755a217-4320-4b60-943a-2f85160b6f40",
                                "sense_id": "1fea7334-4f15-31b8-a64c-19de16c9c1ce",
                                "text": "In the hundred fourscore and eighth year, the people that were at Jerusalem and in Judea, and the council, and Judas, sent greeting and health unto Aristobulus, king Ptolemeus' master, who was of the stock of the anointed priests, and to the Jews that were in Egypt"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bb743fb-e87e-449e-a03e-5089f4a1105c",
                        "source_entry_id": "b9689e22-b037-3362-bf92-2e4dae6c70b9",
                        "source_sense_id": "1fea7334-4f15-31b8-a64c-19de16c9c1ce",
                        "source_sense_description": "Judea",
                        "target_lang_word": "Judea",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "59478ab4-6ee4-433f-a461-56aa2dadf856",
                        "source_entry_id": "b9689e22-b037-3362-bf92-2e4dae6c70b9",
                        "source_sense_id": "1fea7334-4f15-31b8-a64c-19de16c9c1ce",
