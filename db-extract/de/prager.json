                "senses": [
                    {
                        "sense_id": "2ee8e989-ae63-34a2-8d4b-38c59d09cb10",
                        "entry_id": "2e614198-44e7-3397-9a93-c3c7d493eef3",
                        "glosses": [
                            "zu Prag gehörig, aus Prag stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a562e9f0-be3c-4551-a695-eff8e9fa4462",
                                "sense_id": "2ee8e989-ae63-34a2-8d4b-38c59d09cb10",
                                "text": "Der Prager Straßenverkehr ist zur Mittagszeit bisweilen zähfließend."
                            },
                            {
                                "example_id": "6c2188e8-4c9c-421c-b7ac-d6490bfa7981",
                                "sense_id": "2ee8e989-ae63-34a2-8d4b-38c59d09cb10",
                                "text": "„Der für die Angelegenheit zuständige Prager Verkehrsminister Milan Simonovski gab sich von dem Kanzler-Schreiben unbeeindruckt, sicherte aber ein transparentes, faires Ausschreibungsverfahren nach EU-Normen zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "843139da-1e0f-4660-919e-37f8ec41b3c4",
                        "source_entry_id": "2e614198-44e7-3397-9a93-c3c7d493eef3",
                        "source_sense_id": "2ee8e989-ae63-34a2-8d4b-38c59d09cb10",
                        "source_sense_description": "zu Prag gehörig, aus Prag stammend",
                        "target_lang_word": "praguois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "praguois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "905245fb-3959-3280-ac42-3f7ea8730a5e",
                                        "entry_id": "a1b319a5-271b-37f3-98ca-e1e7b1f755a4",
                                        "glosses": [
                                            "Variante de pragois."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc54fbd5-cafc-43bd-8d28-6a15d2ddcd0b",
                                                "sense_id": "905245fb-3959-3280-ac42-3f7ea8730a5e",
                                                "text": "L’idée du métro praguois n’est pas nouvelle : un premier projet a été présenté en 1898 par le riche commerçant praguois Ladislav Rott."
                                            },
                                            {
                                                "example_id": "b194ebf5-808d-4fb8-9020-fccf5757354e",
                                                "sense_id": "905245fb-3959-3280-ac42-3f7ea8730a5e",
                                                "text": "Onze auteurs de réputation internationale ont apporté leur soutien à l’écrivain tchèque Milan Kundera, accusé par un hebdomadaire praguois d’avoir dénoncé un de ses compatriotes auprès de la police communiste, a annoncé lundi le site BibliObs.com."
                                            },
                                            {
                                                "example_id": "3167a827-2f36-4bfc-966a-13912fe2b2ac",
                                                "sense_id": "905245fb-3959-3280-ac42-3f7ea8730a5e",
                                                "text": "Les mélomanes apprécieront la possibilité de goûter à l’atmosphère de ce palais où Mozart donna plusieurs concerts privés, lors de ses séjours praguois."
                                            },
                                            {
                                                "example_id": "29432413-afb0-4a25-96c6-ebba7f897328",
                                                "sense_id": "905245fb-3959-3280-ac42-3f7ea8730a5e",
                                                "text": "À la moindre action de l’équipe praguoise, en jaune et bleu, les supporteurs, surtout des hommes, lèvent leur bière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dc457a2-b919-478e-8222-2ed5479b8176",
                        "source_entry_id": "2e614198-44e7-3397-9a93-c3c7d493eef3",
