                    {
                        "sense_id": "4aa1ccc2-adc3-311f-86d9-c91362f277d2",
                        "entry_id": "9c750e21-514c-32c7-8631-3c99c389361b",
                        "glosses": [
                            "masseloses Quant des Lichts: Photon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d500bc-830d-4d94-8110-a422c16c071e",
                                "sense_id": "4aa1ccc2-adc3-311f-86d9-c91362f277d2",
                                "text": "“A photon checks into a hotel. ‘Do you have any luggage?’ the receptionist asks. ‘No,’ says the photon. ‘I’m travelling light.’”",
                                "translation": "Wortspiel aufgrund sprachlicher Zweideutigkeit: Ein Photon checkt in einem Hotel ein. „Haben Sie Gepäck?“, fragt die Rezeptionistin. „Nein“, sagt das Photon, „[ich reise leicht/ich bin reisendes Licht].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
