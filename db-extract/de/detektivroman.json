                "senses": [
                    {
                        "sense_id": "e2e3968a-3796-3026-bbd9-7a53ba853967",
                        "entry_id": "5790d2cc-b7a0-3ee9-b463-0036ef2abf68",
                        "glosses": [
                            "Roman, dessen Handlung sich um Detektivarbeit dreht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f528708a-341b-48c0-8628-3219929b54f3",
                                "sense_id": "e2e3968a-3796-3026-bbd9-7a53ba853967",
                                "text": "„Er war einmal Ermittler und Verbrechensbekämpfer. Ein ausgezeichneter - ein Psychologe -, wachsam, gelehrt, schlau - kein bloßer Schnüffler wie aus Detektivromanen.“"
                            },
                            {
                                "example_id": "c83b024d-0729-4b6f-bdba-0dcd0d6664f4",
                                "sense_id": "e2e3968a-3796-3026-bbd9-7a53ba853967",
                                "text": "„Drei Jahre später schrieb Wilkie Collins seinen bahnbrechenden Detektivroman Der Monddiamant und gründete ihn auf den Fall Kent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
