                ],
                "senses": [
                    {
                        "sense_id": "a39d1eb6-76b2-3bf7-a7d7-de06853b22bd",
                        "entry_id": "514ec21c-b57f-3615-b914-391239ad54e5",
                        "glosses": [
                            "osoba, która środkami władzy, takimi jak pozbawianie swobód i nakładanie kar, ogranicza czyjąś wolność"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "d04a1f4e-83c6-43d4-a2c3-2293bd58898d",
                                "sense_id": "a39d1eb6-76b2-3bf7-a7d7-de06853b22bd",
                                "text": "Ale uczucia bledną. Na widok dawnego ciemiężyciela na ławie oskarżonych nawet nic szczególnego nie poczuł"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5609a49b-eea1-403b-a815-2e720366701c",
                        "source_entry_id": "514ec21c-b57f-3615-b914-391239ad54e5",
                        "source_sense_id": "a39d1eb6-76b2-3bf7-a7d7-de06853b22bd",
                        "target_lang_word": "oppressor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppressor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6bde35b-dc75-3b86-b8fc-4d7e59dd9bff",
                                        "entry_id": "7c7f2d13-1d1e-34d1-a1f7-7db794eac9a2",
                                        "glosses": [
                                            "Someone who oppresses another or others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07f49fb-8794-4390-8b6c-385aedbb7f86",
                                                "sense_id": "b6bde35b-dc75-3b86-b8fc-4d7e59dd9bff",
                                                "text": "And in respect of the great necessity there is, my darling, for more employments being within the reach of Woman than our civilisation has as yet assigned to her, don’t fly at the unfortunate men, even those men who are at first sight in your way, as if they were the natural oppressors of your sex […]"
                                            },
                                            {
                                                "example_id": "515e78f6-e71f-499e-93c7-73f67f01c00c",
                                                "sense_id": "b6bde35b-dc75-3b86-b8fc-4d7e59dd9bff",
                                                "text": "All members of society are hurt by the dynamic of oppressor versus oppressed (McIntosh, 1988)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0b9633e-a7ce-4d9b-9ddb-144df6e3535a",
                        "source_entry_id": "514ec21c-b57f-3615-b914-391239ad54e5",
                        "source_sense_id": "a39d1eb6-76b2-3bf7-a7d7-de06853b22bd",
                        "target_lang_word": "oppresseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppresseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bec91fb3-f9b1-3008-ad0f-af3da474fbba",
                                        "entry_id": "6c74c39c-60ce-319c-98de-7192e4fdaca1",
                                        "glosses": [
                                            "Celui qui opprime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceabf005-05ae-4c71-89bb-81de37d2ef1c",
                                                "sense_id": "bec91fb3-f9b1-3008-ad0f-af3da474fbba",
                                                "text": "De tous mes oppresseurs, c’est toi que je regarde comme le plus cruel."
                                            },
                                            {
                                                "example_id": "55d32188-084a-4d90-a4ba-e3bb69accad5",
                                                "sense_id": "bec91fb3-f9b1-3008-ad0f-af3da474fbba",
                                                "text": "L’association des catholiques d’Irlande date de longues années. Elle a souvent changé de nom, jamais de nature; c’était la réunion des hommes dépouillés de leurs droits contre leurs oppresseurs. — (Anonyme, Irlande. - Émancipation des Catholiques, Revue des Deux Mondes, 1829, tome 1)"
                                            },
                                            {
                                                "example_id": "0bfb7450-60e7-49c3-a193-08998be8cc0e",
                                                "sense_id": "bec91fb3-f9b1-3008-ad0f-af3da474fbba",
                                                "text": "Il est scandaleux que les autorités iraniennes la punissent pour son travail en faveur des droits humains. Sa condamnation renforce la réputation de l’Iran en tant qu’oppresseur cruel des droits de la femme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oppresseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e69ec0-3834-380b-b9a3-0dbb85215fc2",
                                        "entry_id": "2fae3eb6-6908-31dc-85db-41630c9b86a0",
                                        "glosses": [
                                            "Oppressant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72878f6a-d595-424e-b419-24dcba5d1189",
                                                "sense_id": "e1e69ec0-3834-380b-b9a3-0dbb85215fc2",
                                                "text": "Un pouvoir oppresseur."
                                            },
                                            {
                                                "example_id": "0da6e384-a39c-4886-a0af-589c67c610fb",
                                                "sense_id": "e1e69ec0-3834-380b-b9a3-0dbb85215fc2",
                                                "text": "La nation française n’est pas la nation du peuple d’Algérie, c’est la nation oppresseuse, c’est la nation de l’impérialisme qui, par le fer et par le feu, s’est annexée l’Algérie et qui courbe sous l’esclavage la nation algérienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "443fff8c-12c9-4f2f-8d85-38efbac57e2e",
                        "source_entry_id": "514ec21c-b57f-3615-b914-391239ad54e5",
                        "source_sense_id": "a39d1eb6-76b2-3bf7-a7d7-de06853b22bd",
                        "target_lang_word": "Unterdrücker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterdrücker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c983ac00-e066-3a88-ab23-46af987fe1d6",
                                        "entry_id": "23315d87-e671-3e90-be31-bf05401f7a8f",
                                        "glosses": [
                                            "Person, die eine andere (oder mehrere) beherrscht/unterdrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02fb4dc8-c4f7-48b6-aa73-21000b41c994",
                                                "sense_id": "c983ac00-e066-3a88-ab23-46af987fe1d6",
                                                "text": "„Tokeah, wie wir gesehen haben, war ein Mann, ergraut in Gefahren und jenem Mißtrauen, das den gedrückten schwächern Indianern gegenüber ihren stärkern weißen Unterrückern natürlich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
