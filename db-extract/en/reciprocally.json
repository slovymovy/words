                    {
                        "translation_id": "c9b8d26e-27bc-409b-be1e-07ca3add5352",
                        "source_entry_id": "e89993a9-d6ed-3f23-be44-0bb5aabf484b",
                        "source_sense_id": "096d3b2d-195b-3bb0-a797-ecf5d39db140",
                        "source_sense_description": "in a reciprocal manner",
                        "target_lang_word": "réciproquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réciproquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                        "entry_id": "b52dc5ba-59af-3acc-a6aa-54ae18767e18",
                                        "glosses": [
                                            "D’une manière inverse, en retour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e727bd1c-31d5-40f5-9301-74f740075f89",
                                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                                "text": "Comme les actions héroïques animent ceux qui écrivent, ceux-ci réciproquement vont remuer, par le désir de la gloire, ce qu’il y a de plus vif dans les grands courages,"
                                            },
                                            {
                                                "example_id": "702fe870-5dc8-46d7-92cd-54d0d4c5e157",
                                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                                "text": "La convoitise l’empêche [le chrétien] de faire tout le bien qu’il voudrait ; réciproquement, il empêche la convoitise de faire tout le mal qu’elle désire,"
                                            },
                                            {
                                                "example_id": "af165713-31b5-4918-bad2-b722a53d0933",
                                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                                "text": "Les enfants peut-être seraient plus chers à leurs pères, et réciproquement les pères à leurs enfants, sans le titre d’héritiers,"
                                            },
                                            {
                                                "example_id": "4e94f7a9-44dd-478e-92dd-e91f6acbe861",
                                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                                "text": "Les animaux des parties méridionales de l’ancien continent ne se trouvent pas dans le nouveau ; et, réciproquement, ceux de l’Amérique méridionale ne se trouvent point dans l’ancien continent,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00532b62-8ab3-3591-bd93-10d38dd65b8d",
                                        "entry_id": "b52dc5ba-59af-3acc-a6aa-54ae18767e18",
                                        "glosses": [
                                            "D’une manière réciproque, mutuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dec08e5-545e-46b5-a271-9f9109de1354",
                                                "sense_id": "00532b62-8ab3-3591-bd93-10d38dd65b8d",
                                                "text": "Les petits se haïssent les uns les autres, lorsqu'ils se nuisent réciproquement,"
                                            },
                                            {
                                                "example_id": "3e3a7f8b-65dc-4d3b-a0b7-d5395b8a029f",
                                                "sense_id": "00532b62-8ab3-3591-bd93-10d38dd65b8d",
                                                "text": "Il arrivait que les moines et la cour se corrompaient réciproquement,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
