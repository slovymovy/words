                "senses": [
                    {
                        "sense_id": "a8a1368a-fc13-3e15-a361-6a7bf12954e8",
                        "entry_id": "a6f29cee-596d-3dd4-a0ac-3f7a3ea837eb",
                        "glosses": [
                            "een dakvorm die bestaat uit vier of meer driehoekige dakschilden die in één punt samenkomen: het nokpunt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c534ad92-371b-35f0-9b96-3e7b240334a6",
                        "entry_id": "a6f29cee-596d-3dd4-a0ac-3f7a3ea837eb",
                        "glosses": [
                            "het dak van een tent; dak gemaakt van doek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d1c0a78-1667-4ec7-b3c6-6635562660aa",
                                "sense_id": "c534ad92-371b-35f0-9b96-3e7b240334a6",
                                "text": "Vooral in de afgelopen warme weken genoten de gasten van de ambiance. Dineren onder een tentdak aan de rand van de vijver in de parkachtige tuin van hotel De Lutt. Eens een keertje weer wat anders."
                            },
                            {
                                "example_id": "8ea79433-30cf-459a-89ef-bce108577758",
                                "sense_id": "c534ad92-371b-35f0-9b96-3e7b240334a6",
                                "text": "Vrijwilligers uit Hengevelde hebben het podium in het dorpshart van een tentdak voorzien. Het is een initiatief van de stichting Hengeveldse Evenementen Tent (HET)."
                            },
                            {
                                "example_id": "2e6e3c4c-5225-4d51-af82-f6bca856f10e",
                                "sense_id": "c534ad92-371b-35f0-9b96-3e7b240334a6",
                                "text": "Het regende zondag tijdens het kapellenfestival Toeten en Bloazen niet alleen buiten. Ook binnen in de feesttent vielen dikke druppels condensvocht vanaf het tentdak op de hoofden van het feestende en hevig transpirerende Boeskoolvolk op de feestvloer."
                            }
                        ]
                    }
                ],
