{
    "word_family": [
        "aanstootgevend",
        "aanstoten",
        "stoot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43ec9e5b-1400-34d1-8c5e-d3cf69b50fc4",
                    "sense_definition": "iets wat morele verontwaardiging, ergernis of wrevel opwekt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ergernis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn ongepaste opmerkingen gaven veel <w>aanstoot</w> bij de aanwezigen.",
                            "target_lang_translations": {
                                "en": "His inappropriate remarks gave great <w>offense</w> to those present."
                            }
                        },
                        {
                            "text": "Veel buurtbewoners namen <w>aanstoot</w> aan de luidruchtige feesten in het park.",
                            "target_lang_translations": {
                                "en": "Many local residents took <w>umbrage</w> at the noisy parties in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "ergernis",
                        "verontwaardiging"
                    ],
                    "common_phrases": [
                        "aanstoot geven",
                        "aanstoot nemen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "something that provokes moral indignation, annoyance, or resentment; offense"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offense",
                                "target_lang_sense_clarification": "annoyance, displeasure, or indignation caused by something improper"
                            },
                            {
                                "target_lang_word": "umbrage",
                                "target_lang_sense_clarification": "feeling of resentment or offense, usually in 'take umbrage'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "648bdfd5-9f44-3e40-8098-d24a34feb1af",
                    "sense_definition": "het botsen of een bruuske duw geven tegen iets",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de plotselinge <w>aanstoot</w> rolde de bal meteen over de tafel.",
                            "target_lang_translations": {
                                "en": "Because of the sudden <w>impact</w>, the ball immediately rolled across the table."
                            }
                        },
                        {
                            "text": "Bij biljart is een beheerste <w>aanstoot</w> van groot belang voor een goed resultaat.",
                            "target_lang_translations": {
                                "en": "In billiards, a controlled <w>stroke</w> is very important for a good result."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoot",
                        "botsing"
                    ],
                    "target_lang_definitions": {
                        "en": "a collision, bump, or abrupt push against something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bump",
                                "target_lang_sense_clarification": "a light collision or jolt"
                            },
                            {
                                "target_lang_word": "impact",
                                "target_lang_sense_clarification": "the action of one object striking into another"
                            },
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "the act of striking a ball in games like billiards"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c1a00b3-0a0b-3358-bb3d-5cdadcb5d7cf",
                    "sense_definition": "eerste aanzet, aanleiding of impuls die iets in beweging brengt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aanleiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn toespraak gaf de <w>aanstoot</w> tot een langdurig maatschappelijk debat.",
                            "target_lang_translations": {
                                "en": "His speech provided the <w>impetus</w> for a prolonged societal debate."
                            }
                        },
                        {
                            "text": "Die ontdekking vormde de eerste <w>aanstoot</w> tot verder wetenschappelijk onderzoek.",
                            "target_lang_translations": {
                                "en": "That discovery was the initial <w>impulse</w> for further scientific research."
                            }
                        }
                    ],
                    "synonyms": [
                        "impuls",
                        "aanzet",
                        "aanleiding"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in deze betekenis verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "initial impetus, trigger, or impulse that sets something in motion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impetus",
                                "target_lang_sense_clarification": "force or stimulus that causes something to happen"
                            },
                            {
                                "target_lang_word": "impulse",
                                "target_lang_sense_clarification": "an instigating factor or initial drive"
                            },
                            {
                                "target_lang_word": "trigger",
                                "target_lang_sense_clarification": "an event or action that causes something else to take place"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4604e1e4-6933-3bea-a805-2c8eb6bdf273",
                    "sense_definition": "enkelvoudige tegenwoordige tijd in de bijzin van <w>aanstoten</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik let niet op als ik per ongeluk het glas <w>aanstoot</w>.",
                            "target_lang_translations": {
                                "en": "I am not paying attention when I accidentally <w>bump into</w> the glass."
                            }
                        },
                        {
                            "text": "Hij schrok toen hij merkte dat zij hem zachtjes <w>aanstoot</w>.",
                            "target_lang_translations": {
                                "en": "He was startled when he noticed that she gently <w>nudges</w> him."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "singular present tense in subordinate clause of 'aanstoten' (to bump into, nudge)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bump into",
                                "target_lang_sense_clarification": "accidentally hit against something"
                            },
                            {
                                "target_lang_word": "nudge",
                                "target_lang_sense_clarification": "push gently, usually with an elbow or foot"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}