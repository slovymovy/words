                        "examples": [
                            {
                                "example_id": "0ecbd14a-ee36-4b60-ab1e-aa4501434cc3",
                                "sense_id": "c6ef0329-afac-3758-905b-b5da0d6c41e4",
                                "text": "„Crawdad Gilmore gestikulierte mit der Post in Richtung seines Hauses, um anzudeuten, dass drinnen mehr Geld auf der Schlafzimmerkommode lag, vierzehn Dollar, um genau zu sein.“"
                            },
                            {
                                "example_id": "9514fadd-f048-462c-b0d0-d48a2b3d1729",
                                "sense_id": "c6ef0329-afac-3758-905b-b5da0d6c41e4",
                                "text": "„Ich zog mehrere Jalousien hoch, überquerte den Flur und suchte im Spiegel der Schlafzimmerkommode nach der sonderbaren Stelle auf dem anderen Spiegel.“"
                            }
                        ],
