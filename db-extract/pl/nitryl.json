                                        "entry_id": "39ac185c-66b7-3574-a7aa-610c562b483a",
                                        "glosses": [
                                            "A type of synthetic rubber formed by the copolymerization of acrylonitrile and butadiene: nitrile rubber."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
