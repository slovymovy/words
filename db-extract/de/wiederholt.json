                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0472c5b2-dd5c-32e2-baa1-2c9629de4519",
                        "entry_id": "8eb25c62-5549-325f-ac05-4f3927530103",
                        "glosses": [
                            "Répété."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "940e7daa-a131-43c6-b760-8d2d9daf6a8e",
                                "sense_id": "0472c5b2-dd5c-32e2-baa1-2c9629de4519",
                                "text": "Trotz wiederholter Anstrengungen gelang es ihm nicht.",
                                "translation": "Malgré ses efforts répétés, il ne réussit toujours pas."
                            },
                            {
                                "example_id": "340e23b1-436c-49b4-824b-b359bfa82082",
                                "sense_id": "0472c5b2-dd5c-32e2-baa1-2c9629de4519",
                                "text": "Er hat sich zum wiederholten Mal die Frage gestellt, ob …",
                                "translation": "Il s’est posé pour la n-ième fois la question de savoir si…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "74fcc3b0-2e26-3911-8b8a-c0e21db74368",
                "word": "wiederholt",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cac8e509-8d27-30f4-a454-8dcd99dc6d7a",
                        "entry_id": "74fcc3b0-2e26-3911-8b8a-c0e21db74368",
                        "glosses": [
                            "De nouveau, à nouveau, encore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91018fd3-19e4-48a5-aa06-75a7b5a48442",
                                "sense_id": "cac8e509-8d27-30f4-a454-8dcd99dc6d7a",
                                "text": "Die Verkehrspolizei weist wiederholt darauf hin, dass Raserei kein Kavaliersdelikt ist. „Festgestellte Übertretungen werden konsequent verfolgt und zur Anzeige gebracht“, heißt es in der Aussendung.",
                                "translation": "La police routière souligne de nouveau que les excès de vitesse ne sont pas des peccadilles. « Les infractions constatées sont poursuivies de manière conséquente et font l’objet d’une plainte », peut-on lire dans le communiqué."
                            }
                        ]
                    },
                    {
                        "sense_id": "6caef318-93b9-3977-bf06-2378330179c3",
                        "entry_id": "74fcc3b0-2e26-3911-8b8a-c0e21db74368",
                        "glosses": [
                            "Continuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd29927-04ac-4da2-ad52-7186b905045f",
                                "sense_id": "6caef318-93b9-3977-bf06-2378330179c3",
                                "text": "Ich schaue wiederholt auf meine Uhr, um ein Zeichen der Ungeduld zu geben.",
                                "translation": "Je regarde continuellement ma montre pour donner un signe d’impatience."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
