                ],
                "senses": [
                    {
                        "sense_id": "456315ae-7b41-38ba-92b4-0513b13f5a27",
                        "entry_id": "6d00218f-8290-3eec-81fc-d1250d8ccef9",
                        "glosses": [
                            "Giving exhortation or advice; encouraging."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed88c81-d84a-4912-a008-fd20db7fd55c",
                                "sense_id": "456315ae-7b41-38ba-92b4-0513b13f5a27",
                                "text": "The words were ordinary enough, and to my mind there was in them something so hortatory that I almost smiled."
                            },
                            {
                                "example_id": "b06deb23-ff29-405e-a2a2-857a4d0e4418",
                                "sense_id": "456315ae-7b41-38ba-92b4-0513b13f5a27",
                                "text": "Some of these books were, on the face of it, frivolous and facetious; but many, on the other hand, were serious and prophetic, moral and hortatory."
                            },
                            {
                                "example_id": "8241296a-388c-4aeb-8a82-c64143b05f2a",
                                "sense_id": "456315ae-7b41-38ba-92b4-0513b13f5a27",
                                "text": "Not in a curse but in a hortatory appeal."
                            },
                            {
                                "example_id": "1d8c0037-ebb8-4056-a378-92d698bce621",
                                "sense_id": "456315ae-7b41-38ba-92b4-0513b13f5a27",
                                "text": "Inextricably from its analyses and polemic, above all, The Communist Manifesto is hortatory, ‘a call to arms in the service of the revolution’."
                            }
                        ]
                    }
                ],
