                                            {
                                                "example_id": "b3664776-7746-45dc-9984-3bef37fc710f",
                                                "sense_id": "7e5dda41-892f-3a30-b6e4-813574d05f4d",
                                                "text": "Aagje Deken en Betje Wolff hebben onterecht het imago van brave schrijvers."
