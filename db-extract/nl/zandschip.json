                "senses": [
                    {
                        "sense_id": "d7b113f2-91d2-3a46-a95b-34d47785e4ef",
                        "entry_id": "8de93e54-8b4f-3713-8c57-8912101c7f3c",
                        "glosses": [
                            "een binnenvaartschip dat zand kan vervoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab99efd-1934-451b-80ee-87b898760284",
                                "sense_id": "d7b113f2-91d2-3a46-a95b-34d47785e4ef",
                                "text": "De instorting in Fenghuang behoort tot de ergste brugongelukken van de afgelopen jaren. Op 15 juni stortte een brug in de zuidelijke provincie Guangdong in nadat er een zandschip tegenaan was gevaren. Negen mensen kwamen daarbij om het leven."
                            },
                            {
                                "example_id": "f49cb075-484b-41d2-9396-1113b1ea57ed",
                                "sense_id": "d7b113f2-91d2-3a46-a95b-34d47785e4ef",
                                "text": "Bij Amerongen gestrand zandschip naar de werf: Een zogeheten beunschip dat maandag strandde op de Nederrijn bij Amerongen is overgedragen aan de berger. Het wordt naar een werf gesleept. Even dreigde het schip te zinken, maar dat wisten Rijkswaterstaat en de brandweer te voorkomen."
                            },
                            {
                                "example_id": "e5bc9919-1c4d-472e-8037-5a84ac279b8e",
                                "sense_id": "d7b113f2-91d2-3a46-a95b-34d47785e4ef",
                                "text": "Uiteindelijk bereikten de dieren zo'n 350 meter verderop de kant en probeerden daar weer op het droge te komen. Volgens omstanders zag een kapitein van een zandschip de koeien in het water liggen en alarmeerde de hulpdiensten."
                            }
                        ]
                    },
                    {
                        "sense_id": "d161bed0-f7c0-3c30-ba7f-e520c62d3551",
                        "entry_id": "8de93e54-8b4f-3713-8c57-8912101c7f3c",
                        "glosses": [
                            "zandsculptuur in de vorm van een schip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7d07f3-1a15-4c6a-aff3-3b1329386bfd",
                                "sense_id": "d161bed0-f7c0-3c30-ba7f-e520c62d3551",
                                "text": "Aan het Redersplein verrijzen, net als afgelopen jaar, zes enorme zandsculpturen, waaronder dus het grootste zandschip. Voor het Zandsculptuur Festival Blauwestad werd ruim 300.000 kilo zand gebruikt."
                            }
                        ]
                    }
