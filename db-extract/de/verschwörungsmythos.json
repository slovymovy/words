                "senses": [
                    {
                        "sense_id": "0cf5ffb1-2642-317f-93e4-f0619805649a",
                        "entry_id": "a7bb220e-a1ad-36f9-a840-df2d1fe1300f",
                        "glosses": [
                            "Ideologie/Idee, bei der eine fiktive Gruppe für heimliche Absprachen zum Schaden anderer verantwortlich gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de3fc42-9d50-422e-af3b-a049f5ac5dbf",
                                "sense_id": "0cf5ffb1-2642-317f-93e4-f0619805649a",
                                "text": "„In der Regel werden Verschwörungsmythen nicht durch Beweise gestützt, die einer Überprüfung standhalten. Das verhindert aber nicht, dass sie sich ausbreiten.“"
                            },
                            {
                                "example_id": "25a88b60-b334-432b-a055-e7236f6332f1",
                                "sense_id": "0cf5ffb1-2642-317f-93e4-f0619805649a",
                                "text": "„Theorien sind wissenschaftliche Erklärungen. Und der Begriff „Verschwörungstheorien“, der taucht im 18., 19. Jahrhundert auf und wird dann von Karl Popper geprägt, der genau davor warnt, dass eben Verschwörungstheorien keine wissenschaftlichen Theorien wären. Aber leider ist es heute so, dass sogar der Verschwörungsmythos unterwegs ist, der Begriff „Verschwörungstheorie“, den habe der CIA entwickelt, um die Leute nach der Ermordung von John F. Kennedy zu unterdrücken.“"
                            },
                            {
                                "example_id": "00616047-9c76-449b-a13d-0603a5af6695",
                                "sense_id": "0cf5ffb1-2642-317f-93e4-f0619805649a",
                                "text": "„In der Corona-Pandemie glauben mehr Menschen an Verschwörungsmythen. Wieso sind die gerade in Krisenzeiten so attraktiv und was hilft, um Betroffene beim Ausstieg zu unterstützen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
