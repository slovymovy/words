                "senses": [
                    {
                        "sense_id": "acc30489-9ce5-3e87-beac-e9d2858a33e0",
                        "entry_id": "0fc57279-d18f-3de4-ab56-3d68ad1e900c",
                        "glosses": [
                            "The final battle between two opponents, in which there can be only one victor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f3be026-c3b6-4b70-8d00-1db22738efe0",
                                "sense_id": "acc30489-9ce5-3e87-beac-e9d2858a33e0",
                                "text": "Pierre-Emerick Aubameyang scored on his first start since recovering from malaria as Arsenal prepared for their Europa League showdown against Villarreal with a confidence-boosting win away to Newcastle at St James' Park."
                            }
                        ]
                    },
                    {
                        "sense_id": "150abb6a-7795-3547-8007-6ab5ebc8b24d",
                        "entry_id": "0fc57279-d18f-3de4-ab56-3d68ad1e900c",
                        "glosses": [
                            "The final round in a poker match, where all of the remaining players' cards have to be put down on the table and shown."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ebd8f2d-b110-4bd5-b955-b419a204a5b8",
                        "source_entry_id": "0fc57279-d18f-3de4-ab56-3d68ad1e900c",
                        "source_sense_description": "the final battle between two nemeses, in which there can be but one victor",
                        "target_lang_word": "krachtmeting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krachtmeting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                                        "entry_id": "ec50be06-a5d7-36c5-9860-be9461d4d18e",
                                        "glosses": [
                                            "de wedstrijd, de strijd, in de natuurkunde kan het ook heel letterlijk het meten van een kracht betekenen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6cff049-e2b7-4ab0-afc3-27c2026a6553",
                                                "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                                                "text": "Schermutselingen, belegeringen, korte krachtmetingen her en der in Lombardije culmineerden tenslotte in de slag bij Pavia."
                                            },
                                            {
                                                "example_id": "5ca8d14d-63ff-4a21-8237-844133600c39",
                                                "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                                                "text": "Ik vraag me af of ook de Anasazi hier sportieve wedstrijden hebben gehouden. En op welk moment treden zulke spontane krachtmetingen in de evolutie van de hominiden voor het eerst op?"
                                            },
                                            {
                                                "example_id": "eebbb55c-f96e-4dd8-9f16-5b0823ea9e0e",
                                                "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                                                "text": "De krachtmetingen toonden aan dat de vliegende vis horizontaal zwevend meer dan vier meter vooruit komt voor elke meter die hij daalt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "631bb1e1-0c17-40e7-b12a-a00cdb6470c6",
                        "source_entry_id": "0fc57279-d18f-3de4-ab56-3d68ad1e900c",
                        "source_sense_description": "the final battle between two nemeses, in which there can be but one victor",
                        "target_lang_word": "confrontation finale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0b0dbae2-738c-491b-9504-0ae37d5f1044",
                        "source_entry_id": "0fc57279-d18f-3de4-ab56-3d68ad1e900c",
                        "source_sense_description": "the final battle between two nemeses, in which there can be but one victor",
                        "target_lang_word": "Showdown",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Showdown",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "515cdf52-c08e-3baa-974c-ca5aa69af663",
                                        "entry_id": "6e328e82-5d1f-3593-b184-147461b39b64",
                                        "glosses": [
                                            "entscheidende Machtprobe, Kraftprobe zwischen zwei Kontrahenten, die zum endgültigen Untergang, zur endgültigen Vernichtung eines der beiden führt"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2119da1-36a6-4614-a9da-6c1957e860ee",
                                                "sense_id": "515cdf52-c08e-3baa-974c-ca5aa69af663",
                                                "text": "„Im Vatikan bahnt sich ein Showdown zwischen dem Bischof von Limburg Franz-Peter Tebartz-van Elst und dem Vorsitzenden der Deutschen Bischofskonferenz Erzbischof Robert Zollitsch an.“"
                                            },
                                            {
                                                "example_id": "a356bcf7-6a98-4f29-9ae1-f760b1742888",
                                                "sense_id": "515cdf52-c08e-3baa-974c-ca5aa69af663",
                                                "text": "„Am 12. Oktober 1999 kam es zum Showdown: Nawaz Sharif verweigerte Musharraf, der sich an Bord einer regulären Passagiermaschine der pakistanischen Fluggesellschaft PIA auf der Rückreise von Sri Lanka befand, die Einreise nach Pakistan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a804577-3d55-3309-8b27-7162ab0097f1",
                                        "entry_id": "6e328e82-5d1f-3593-b184-147461b39b64",
                                        "glosses": [
                                            "Aufdecken der Karten, nachdem zwei oder mehr Spieler den gleichen Betrag gesetzt haben, um den Sieger der Runde zu ermitteln"
                                        ],
                                        "tags": [
                                            "Poker"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f3e827-17c7-440a-afb1-f0b4ac67b7fe",
                                                "sense_id": "7a804577-3d55-3309-8b27-7162ab0097f1",
                                                "text": "„In vier von fünf Spielen steigt der Profi gleich zu Beginn aus, weil ihm die Karten zu schlecht sind. Sehr selten kommt es unter Könnern überhaupt zum Showdown, bei dem am Ende alle ihr Blatt aufdecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4432b60b-c996-3138-970d-bdf883c8d43d",
                                        "entry_id": "6e328e82-5d1f-3593-b184-147461b39b64",
                                        "glosses": [
                                            "letzte, entscheidende Auseinandersetzung zwischen den (beiden) Helden, die meist blutig endet"
                                        ],
                                        "tags": [
                                            "in Filmen",
                                            "besonders Wildwestfilmen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3187a5ce-4a72-4f80-b22f-b702e8d852c1",
                                                "sense_id": "4432b60b-c996-3138-970d-bdf883c8d43d",
                                                "text": "„So behäbig wie der ganze Film verläuft dann auch der Showdown. Quälend, roh und direkt ballern die Männer so lange aufeinander, bis der Gegner tot zusammenbricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
