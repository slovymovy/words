                ],
                "senses": [
                    {
                        "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                        "entry_id": "35631642-6b25-3021-9c11-5e7822b2d33d",
                        "glosses": [
                            "A person who pursues the advancement of their career at the expense of other values."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "efa69441-b8c0-4d99-af92-d1c36013dbe6",
                                "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                                "text": "A careerist is a square-filler, a time-server. His talents and imagination have been circumscribed to perform managerial duties."
                            },
                            {
                                "example_id": "0615bbd7-e902-4d2e-bb9f-669b1d760143",
                                "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                                "text": "Liu Hsin's famous jibe seems to have been directed not against Yang Hsiung but against the intellectual limitations of contemporary careerists. […] Yang's writings and personal character did not appeal to the careerists of his time"
                            },
                            {
                                "example_id": "b4424adf-53eb-4e08-ba21-4a0db1474846",
                                "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                                "text": "You’ve got a lot of elite careerist women in the officer corps who have a certain set of desires usually related to their career."
                            }
                        ]
                    },
                    {
                        "sense_id": "b99f188a-849e-328a-a324-6ba11fa28cef",
                        "entry_id": "35631642-6b25-3021-9c11-5e7822b2d33d",
                        "glosses": [
                            "A person who takes a job, especially in the military, for a long time rather than temporarily."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
