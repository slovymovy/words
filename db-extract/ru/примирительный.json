                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a7fc097-d3bb-3024-ad34-db8c800cc844",
                        "entry_id": "fccb7e76-f1ac-3866-b755-55a9500cb7ee",
                        "glosses": [
                            "относящийся к примирению"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f80b50ea-52a7-3108-827f-570de4ceffa9",
                        "entry_id": "fccb7e76-f1ac-3866-b755-55a9500cb7ee",
                        "glosses": [
                            "свидетельствующий о стремлении к миру, согласию, содействующий установлению мирных, дружественных отношений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aeb3bd6-48e0-4854-b326-5187d20805af",
                                "sense_id": "f80b50ea-52a7-3108-827f-570de4ceffa9",
                                "text": "Сама доброта царя подсказывала ему сделать примирительный жест, который, вне всякого сомнения, достиг бы цели."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a810832-63dd-440c-afd2-7a9a82ea2ad6",
                        "source_entry_id": "fccb7e76-f1ac-3866-b755-55a9500cb7ee",
                        "target_lang_word": "conciliant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conciliant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f87e453-fd3d-3859-a0a0-81d15182eddf",
                                        "entry_id": "adab9182-ce36-366a-aae8-9353106e5fac",
                                        "glosses": [
                                            "Qui est porté à concilier les esprits, les gens d’intérêts opposés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce0a866-e5fd-4b61-bc7b-af1643ead497",
                                                "sense_id": "5f87e453-fd3d-3859-a0a0-81d15182eddf",
                                                "text": "L'auteur de l'explication, Florentin de Thierrat, était né à Mirecourt vers la fin du XVIᵉ siècle ; ce fut un jurisconsulte de grand mérite, tout à la fois habile, conciliant ; on l'appelait l'arbitre de la province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79d0979-7a48-3d9d-863d-33581e5b6682",
                                        "entry_id": "adab9182-ce36-366a-aae8-9353106e5fac",
                                        "glosses": [
                                            "Qui accepte de ne pas tenter d’imposer ses propres opinions afin d’éviter les disputes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f9d14d8-f993-4c0e-84b4-a917ca580f1d",
                                                "sense_id": "c79d0979-7a48-3d9d-863d-33581e5b6682",
                                                "text": "L’Association des joueurs demeure inflexible en ce qui a trait au versement complet des salaires consentis aux joueurs. Ce refus de Donald Fehr est très mal perçu par la Ligue qui s'est montrée conciliante la semaine dernière en faisant des concessions totalisant plus de 200 millions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c12acd-26ef-3f20-9c87-58f82308c82e",
                                        "entry_id": "adab9182-ce36-366a-aae8-9353106e5fac",
                                        "glosses": [
                                            "Se dit d’une attitude, d’une façon de faire, dont l’objectif est de ne pas exacerber les antagonismes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c3ca9c-6be8-42be-8767-aba50af0fdff",
                                                "sense_id": "06c12acd-26ef-3f20-9c87-58f82308c82e",
                                                "text": "Adopter un ton conciliant."
                                            },
                                            {
                                                "example_id": "076f2664-4ee5-4d6e-9753-8b40f1de1a07",
                                                "sense_id": "06c12acd-26ef-3f20-9c87-58f82308c82e",
                                                "text": "Prêt au dialogue, il a envoyé de nombreux signaux conciliants vers le Kremlin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conciliant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d23c266e-f059-3272-a726-b1052249256e",
                                        "entry_id": "64a5398a-f906-3009-a865-3f1bd109074b",
                                        "glosses": [
                                            "Participe présent de concilier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04bd2371-601c-4f3d-b4f1-8ebaa5c5bdf0",
                                                "sense_id": "d23c266e-f059-3272-a726-b1052249256e",
                                                "text": "La recherche de micro-polluants organiques dangereux s’inscrit dans le concept de développement durable conciliant la protection de l’environnement et le développement économique."
                                            }
