                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dbace90-459a-43f3-8f42-be6e5ad0399b",
                                "sense_id": "fde0453b-c5d5-3760-9c74-0e7c082d0ee0",
                                "text": "„Der 58-Jährige hat sich per Berufsaufbauschule, Abendgymnasium, Studium und wissenschaftlicher Mitarbeit in Weihenstephan vom Hauptschüler zum promovierten Agrarwissenschaftler hochgearbeitet.“"
                            },
                            {
                                "example_id": "a28c0a00-5f5a-48e8-a139-723dfb333416",
                                "sense_id": "fde0453b-c5d5-3760-9c74-0e7c082d0ee0",
                                "text": "„Aber die Lese-Rechtschreib-Schwäche wurde erst erkannt, als er mit 19 einen zweiten Anlauf auf der Berufsaufbauschule wagte.“"
                            },
                            {
                                "example_id": "1f2bb01f-a922-4bef-a14b-6b144573937b",
                                "sense_id": "fde0453b-c5d5-3760-9c74-0e7c082d0ee0",
                                "text": "„Erst habe ich junge Männer in einer Berufsaufbauschule unterrichtet.“"
                            },
                            {
                                "example_id": "69b4313a-79e7-42b6-970c-9b2a7f17867d",
                                "sense_id": "fde0453b-c5d5-3760-9c74-0e7c082d0ee0",
                                "text": "„Ebenso wird die Ausbildung an Fach- und Fachoberschulen, Berufsaufbauschulen, Abendschulen, höheren Fachschulen und Akademien gefördert.“"
                            }
                        ],
