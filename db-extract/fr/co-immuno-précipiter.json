                "senses": [
                    {
                        "sense_id": "49395a7a-cff8-32a7-a5e3-eb5e4d4e7d07",
                        "entry_id": "6a6fe2b3-43a7-3c19-9991-38c10b9def55",
                        "glosses": [
                            "Faire subir une co-immuno-précipitation à quelque chose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7cd1a363-e2d2-4e8c-8a79-13a86f64c105",
                                "sense_id": "49395a7a-cff8-32a7-a5e3-eb5e4d4e7d07",
                                "text": "Nous constatons donc que Ha-Fev permet de co-immuno-précipiter Flag-HDAC1 et Flag-HDAC3, indiquant que l'interaction physique spécifique entre Fev et HDAC1 ou HDAC3 observée in vitro est aussi détectée in vivo."
                            },
                            {
                                "example_id": "f3feec1e-d3b1-4d1f-a1db-0f50a61e08ed",
                                "sense_id": "49395a7a-cff8-32a7-a5e3-eb5e4d4e7d07",
                                "text": "En parallèle, des protéines de fusion contenant SERT et un tag YFP en N-ter ont été surexprimées dans des neurones murins, afin de pouvoir co-immuno-précipiter les partenaires de SERT."
                            }
                        ]
                    }
