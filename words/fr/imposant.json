    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b33a674e-7b43-32d1-8565-9d3824770fc0",
                    "sense_definition": "Qui impressionne et suscite le respect par sa grandeur, sa taille ou sa majesté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux château se dressait au sommet de la colline avec une <w>imposante</w> tour de pierre.",
                            "target_lang_translations": {
                                "en": "The old castle stood on the hilltop with an <w>imposing</w> stone tower.",
                                "ru": "Старый замок возвышался на вершине холма с <w>внушительной</w> каменной башней.",
                                "de": "Die alte Burg erhob sich auf dem Gipfel des Hügels mit einem <w>stattlichen</w> Turm aus Stein.",
                                "es": "El viejo castillo se alzaba en la cima de la colina con una <w>imponente</w> torre de piedra.",
                                "zh": "这座古老的城堡矗立在山顶，有一座<w>雄伟</w>的石砌塔楼。"
                            }
                        },
                        {
                            "text": "Cet homme politique possède une carrure particulièrement <w>imposante</w> qui retient immédiatement l'attention.",
                            "target_lang_translations": {
                                "en": "This politician has a particularly <w>imposing</w> build that immediately catches the eye.",
                                "ru": "У этого политика особенно <w>внушительное</w> телосложение, которое сразу бросается в глаза.",
                                "de": "Dieser Politiker hat eine besonders <w>stattliche</w> Statur, die sofort ins Auge fällt.",
                                "es": "Este político tiene una complexión particularmente <w>imponente</w> que llama la atención de inmediato.",
                                "zh": "这位政治家的仪表格外<w>威严</w>，一眼就引人注目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impressionnant",
                        "majestueux",
                        "grandiose"
                    ],
                    "antonyms": [
                        "modeste",
                        "insignifiant",
                        "chétif"
                    ],
                    "common_phrases": [
                        "taille imposante",
                        "édifice imposant",
                        "silhouette imposante"
                    ],
                    "target_lang_definitions": {
                        "en": "Impressive and commanding because of its size, grandeur or majesty.",
                        "ru": "Внушающий уважение и восхищение своими размерами, величием или внешним видом.",
                        "de": "Durch Größe, Pracht oder Würde beeindruckend und Respekt einflößend.",
                        "es": "Que impresiona y causa respeto por su grandeza, tamaño o majestuosidad.",
                        "zh": "因规模、气势或庄严而令人印象深刻、肃然起敬的。"
                    },
                    "translations": {
