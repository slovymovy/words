                "senses": [
                    {
                        "sense_id": "4ff7f00e-2004-300c-a04b-6d6796a3c84a",
                        "entry_id": "b4f8bc11-0a63-3c31-b4a6-4da53744cb51",
                        "glosses": [
                            "Obsolete form of baton."
                        ],
                        "tags": [
                            "alt-of",
