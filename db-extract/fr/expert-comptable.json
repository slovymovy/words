                "senses": [
                    {
                        "sense_id": "314f5fd1-4582-332b-9d7c-bbba720d458b",
                        "entry_id": "7106e0be-6c45-3d25-b6b8-750c3f5938de",
                        "glosses": [
                            "Professionnel de la comptabilité chargé de tenir les comptes des entreprises civiles et commerciales ainsi que d’organisations à but non lucratif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7287dcef-0ad2-4c69-8a9c-3108243323c8",
                                "sense_id": "314f5fd1-4582-332b-9d7c-bbba720d458b",
                                "text": "Autant pour moi monsieur le directeur, autant pour moi. Si ça continue, c'est moi qui vais finir par pleurer ! Mais rassurez-vous, juste des larmes d’expert-comptable, monsieur le directeur."
                            },
                            {
                                "example_id": "59714f53-c471-415d-ae8f-3790109cda39",
                                "sense_id": "314f5fd1-4582-332b-9d7c-bbba720d458b",
                                "text": "L’expertise comptable est une profession réglementée soumise à un code de déontologie. Les experts-comptables sont notamment tenus au secret professionnel. Leur travail est vérifié par un ou une commissaire aux comptes qui, après étude, certifie (ou non) les comptes de l'entreprise et par là-même, le travail de l’expert ou de l'experte-comptable."
                            },
                            {
                                "example_id": "80ad62e1-835f-4b13-92a0-1536ca6c07fe",
                                "sense_id": "314f5fd1-4582-332b-9d7c-bbba720d458b",
                                "text": "Le contrôleur de stage représente également le lien avec l’ordre des experts-comptable, et peut proposer au conseil régional des modulations du stage si cela s’avère nécessaire (suspension, prolongation, invalidation)."
                            }
                        ]
                    }
                ],
