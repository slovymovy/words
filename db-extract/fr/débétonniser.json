                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c26e3f7-9732-46bf-89ca-ae2f2b8912cc",
                                "sense_id": "5613a1c3-0d10-316f-b1ff-7b9c87010ecc",
                                "text": "En cas d'élection, Martine Aubry promet de « débétonniser » la friche Saint-Sauveur, et d'en faire un espace de biodiversité."
                            },
                            {
                                "example_id": "20a96cce-62e7-440a-a2d2-3a4787aafe22",
                                "sense_id": "5613a1c3-0d10-316f-b1ff-7b9c87010ecc",
                                "text": "La mairie assure de son côté que le projet, qui fournira du logement nécessaire pour les Lillois, va débétonniser une friche industrielle : (…)"
                            },
                            {
                                "example_id": "eff8281f-fa7c-473e-913b-33856602b208",
                                "sense_id": "5613a1c3-0d10-316f-b1ff-7b9c87010ecc",
                                "text": "La Ville a aussi lancé une vaste opération pour \"débétonniser\" les cours d'école et donc y faire entrer plus de végétaux."
                            }
                        ]
                    }
