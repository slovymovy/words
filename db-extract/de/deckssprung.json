                "senses": [
                    {
                        "sense_id": "a6175924-5e1a-38d8-8836-9433ec3d1db2",
                        "entry_id": "33f6861c-0608-37ba-8eae-475db8f861e2",
                        "glosses": [
                            "In Seitenansicht der Verlauf der Krümmung des Decks, genauer, der Oberkante des Schandecks, im Vergleich zur Wasserlinie des Bootes. Sind Bug und Heck höher, als das Deck in Schiffsmitte (klassische Bauweise), spricht man von einem positiven Deckssprung"
                        ],
                        "tags": [
                            "Seglersprache",
                            "Bootsbau",
                            "Schiffbau"
                        ],
                        "examples": [
                            {
                                "example_id": "30d8f662-41b5-4ac4-8c37-c589398ed570",
                                "sense_id": "a6175924-5e1a-38d8-8836-9433ec3d1db2",
                                "text": "Mit nur 2,54 m Breite auf knapp 9,60 m Länge wirkt das Boot vor allem von vorne wie ein kleines U-Boot, wenn es auf den Betrachter zufährt. Dazu tragen auch der negativ einfallende Steven und der negative Deckssprung bei."
                            },
                            {
                                "example_id": "0ed360a3-87e5-4183-b02e-1df8c1df0aab",
                                "sense_id": "a6175924-5e1a-38d8-8836-9433ec3d1db2",
                                "text": "Die Typen Kola und Riga sind als „Flushdecker“ gestaltet, besitzen Schrägbug und Spiegelheck und haben einen ausgeprägten Deckssprung."
                            },
                            {
                                "example_id": "ea907334-1bb5-4e9f-b3e3-d4fb533b283d",
                                "sense_id": "a6175924-5e1a-38d8-8836-9433ec3d1db2",
                                "text": "Die traditionellen Linien werden zudem betont durch den ausgeprägten positiven Deckssprung und den klassischen Löffelbug."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e1893e0-6a23-433d-baf7-5291732e86a2",
                        "source_entry_id": "33f6861c-0608-37ba-8eae-475db8f861e2",
                        "source_sense_id": "a6175924-5e1a-38d8-8836-9433ec3d1db2",
                        "source_sense_description": "Verlauf der Krümmung des Decks, genauer, der Oberkante des Schandecks, im Vergleich zur Wasserlinie des Bootes",
                        "target_lang_word": "sheer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sheer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b4a1d7-85ff-3a3e-9c4d-ba820986bfa3",
                                        "entry_id": "dd097ef5-c935-3a84-b880-c8f818752a0e",
                                        "glosses": [
                                            "Very thin or transparent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93a69c4-7477-468b-983b-43dd75565c4e",
                                                "sense_id": "a4b4a1d7-85ff-3a3e-9c4d-ba820986bfa3",
                                                "text": "Her light, sheer dress caught everyone’s attention."
                                            },
                                            {
                                                "example_id": "2c7432b6-3e30-4169-a3e3-90c2d4405015",
                                                "sense_id": "a4b4a1d7-85ff-3a3e-9c4d-ba820986bfa3",
                                                "text": "“She sheathed her legs in the sheerest of the nylons that her father had brought back from the Continent, and slipped her feet into the toeless, high-heeled shoes of black suède.”"
                                            },
                                            {
                                                "example_id": "6480691e-fbcf-42b6-9dff-c217a4dbc6df",
                                                "sense_id": "a4b4a1d7-85ff-3a3e-9c4d-ba820986bfa3",
                                                "text": "She was cunningly dressed in a black, sheer gown with gold ornaments showing her figure to perfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1699e28-361e-34a6-82c2-554c9367c712",
                                        "entry_id": "dd097ef5-c935-3a84-b880-c8f818752a0e",
                                        "glosses": [
                                            "Pure in composition; unmixed; unadulterated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7e2ddee-6136-4d12-af4a-3514a833b740",
                                                "sense_id": "f1699e28-361e-34a6-82c2-554c9367c712",
                                                "text": "If she say I am not fourteen pence on the score for sheer ale, score me up for the lying’st knave in Christendom."
                                            },
                                            {
                                                "example_id": "e21f967b-2e45-4e43-8a3e-6b197a7e1fb1",
                                                "sense_id": "f1699e28-361e-34a6-82c2-554c9367c712",
                                                "text": "Thou sheer, immaculate and silver fountain, / From when this stream through muddy passages / Hath held his current and defiled himself!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c71901c-e1fe-3c92-9aef-a796826c787c",
                                        "entry_id": "dd097ef5-c935-3a84-b880-c8f818752a0e",
                                        "glosses": [
                                            "Downright; complete; pure."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "091235aa-3fa3-41f2-9872-f8fd6c71e32c",
                                                "sense_id": "5c71901c-e1fe-3c92-9aef-a796826c787c",
                                                "text": "I think it is sheer genius to invent such a thing."
                                            },
                                            {
                                                "example_id": "4ec103a4-dff6-4f8b-8c26-df8b68cc5893",
                                                "sense_id": "5c71901c-e1fe-3c92-9aef-a796826c787c",
                                                "text": "This poem is sheer nonsense."
                                            },
                                            {
                                                "example_id": "faadd9db-bcff-45e1-b842-2ff3f0dbb5f9",
                                                "sense_id": "5c71901c-e1fe-3c92-9aef-a796826c787c",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired. And if the arts of humbleness failed him, he overcame you by sheer impudence."
                                            },
                                            {
                                                "example_id": "68f2bd01-49ae-4531-a00f-ef96924e06f4",
                                                "sense_id": "5c71901c-e1fe-3c92-9aef-a796826c787c",
                                                "text": "There is no organized movement of gays or feminists that would support individuals and that would make coming out, at the workplace, anything less than a shear ^([sic]) act of suicide."
                                            },
                                            {
                                                "example_id": "33af8d45-2984-4680-9fa1-a494e3f7ce76",
                                                "sense_id": "5c71901c-e1fe-3c92-9aef-a796826c787c",
                                                "text": "Cycling's complex etiquette contains an unwritten rule that riders in contention for a race win should not be penalised for sheer misfortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa6b217-d4af-32a2-b222-b009ba52a9ac",
                                        "entry_id": "dd097ef5-c935-3a84-b880-c8f818752a0e",
                                        "glosses": [
                                            "Used to emphasize the amount or degree of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca80ba7-3886-4092-b52f-a5017b426680",
                                                "sense_id": "3aa6b217-d4af-32a2-b222-b009ba52a9ac",
                                                "text": "The army's sheer size made it impossible to resist."
                                            },
                                            {
                                                "example_id": "4bb88de0-e4df-4412-99cb-14cd89df05a9",
                                                "sense_id": "3aa6b217-d4af-32a2-b222-b009ba52a9ac",
                                                "text": "Perhaps as startling as the sheer toll was the devastation to some of the state’s well-known locales. Boardwalks along the beach in Seaside Heights, Belmar and other towns on the Jersey Shore were blown away. Amusement parks, arcades and restaurants all but vanished. Bridges to barrier islands buckled, preventing residents from even inspecting the damage to their property."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c595a00-1c6f-33cf-96b8-2e8314cfac17",
                                        "entry_id": "dd097ef5-c935-3a84-b880-c8f818752a0e",
                                        "glosses": [
                                            "Very steep; almost vertical or perpendicular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cac85e3-4e9b-42b5-bf3f-2422b391c572",
                                                "sense_id": "0c595a00-1c6f-33cf-96b8-2e8314cfac17",
                                                "text": "It was a sheer drop of 180 feet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sheer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79ac7b03-88ff-3ce6-a1d2-8835e6366505",
                                        "entry_id": "836856ea-61c8-3e87-8071-cf24098ee9b0",
                                        "glosses": [
                                            "Clean; completely; at once."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dca2f44-14c7-4f3a-922f-d4a0bfc1d7fe",
                                                "sense_id": "79ac7b03-88ff-3ce6-a1d2-8835e6366505",
                                                "text": "Hector the ashen lance of Ajax smote / With his broad faulchion, at the nether end, / And lopp’d it sheer."
                                            },
                                            {
                                                "example_id": "12090080-d4ee-4cab-b424-17998136b37b",
                                                "sense_id": "79ac7b03-88ff-3ce6-a1d2-8835e6366505",
                                                "text": "Swift into the dark stream at once he fell, / As the red star at once falls swift and sheer / From sky to sea"
                                            },
                                            {
                                                "example_id": "6b0bfe7a-1bec-42ef-b3ed-643cdb6b5600",
                                                "sense_id": "79ac7b03-88ff-3ce6-a1d2-8835e6366505",
                                                "text": "Descending , and in half cut sheer"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sheer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e3421a5-0175-3962-b3da-8afc51662ab3",
                                        "entry_id": "c212d135-7b92-333e-9f15-c97156ef4909",
                                        "glosses": [
                                            "A sheer curtain or fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f870f4-c5b7-444a-a020-d9abf05893f2",
                                                "sense_id": "2e3421a5-0175-3962-b3da-8afc51662ab3",
                                                "text": "Use sheers to maximize natural light."
                                            },
                                            {
                                                "example_id": "b28ab0d0-dbfb-40ee-ba7c-88af7ba37ec4",
                                                "sense_id": "2e3421a5-0175-3962-b3da-8afc51662ab3",
                                                "text": "Lightweight, tightly woven silkies, sheers, lingerie"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sheer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94142d2f-005d-34a9-abb3-4d3669894d4d",
                                        "entry_id": "770da3a8-1a3c-3206-996c-ba79efc426d5",
                                        "glosses": [
                                            "The curve of the main deck or gunwale from bow to stern."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "458dc34d-3af4-3026-a5eb-5f3fe4c1032b",
                                        "entry_id": "770da3a8-1a3c-3206-996c-ba79efc426d5",
                                        "glosses": [
                                            "An abrupt swerve from the course of a ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sheer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70193054-a367-3a53-b5f5-a499da821bfa",
                                        "entry_id": "f47851d4-a001-33c1-9d46-e07819a3bc05",
                                        "glosses": [
                                            "To swerve from a course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d14292-1bbc-4b0c-ac27-5ff769785d50",
                                                "sense_id": "70193054-a367-3a53-b5f5-a499da821bfa",
                                                "text": "I sheered her well inshore—the water being deepest near the bank, as the sounding–pole informed me."
                                            },
                                            {
                                                "example_id": "af05c4d9-754f-432b-82dc-17fb79f4c68a",
                                                "sense_id": "70193054-a367-3a53-b5f5-a499da821bfa",
                                                "text": "Seydlitz correctly identifies the larger shell splashes as coming from the two \"large light cruisers\" at the rear, and takes aim. Moments later, Courageous sheers out of line, smoke and steam venting through a massive hole in her side, the shells having blasted right through whatever excuse for armor was present and detonated amidst the boiler rooms. She is doomed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "753b9da0-056f-3712-8e03-c6f8049bab4d",
                                        "entry_id": "f47851d4-a001-33c1-9d46-e07819a3bc05",
                                        "glosses": [
                                            "Obsolete spelling of shear."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ca26511-6c4b-4c01-9a54-bb81ad066f50",
                                                "sense_id": "753b9da0-056f-3712-8e03-c6f8049bab4d",
                                                "text": "So thick, our navy scarce could sheer their way"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
