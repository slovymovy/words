                ],
                "translations": [
                    {
                        "translation_id": "79d18587-8e1a-4247-a9c9-ac4277c8c8b0",
                        "source_entry_id": "782722a2-280a-327a-8924-fd416492ffac",
                        "source_sense_id": "b3280b3f-c4ee-3721-836c-3f168bf4163a",
                        "source_sense_description": "Gastronomie: Wurstware aus Schweinefleisch",
                        "target_lang_word": "brawn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d894a829-3247-3d25-bf47-5b664b3e2ab8",
                                        "entry_id": "ba334ca0-5182-3935-9348-8d9bc0c9584d",
                                        "glosses": [
                                            "Strong muscles or lean flesh, especially of the arm, leg or thumb."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c433b120-fb55-334a-b94f-8b9d3d0effb6",
                                        "entry_id": "ba334ca0-5182-3935-9348-8d9bc0c9584d",
                                        "glosses": [
                                            "Physical strength; muscularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a219dab7-2c6d-413e-9163-e1fd9c4aff32",
                                                "sense_id": "c433b120-fb55-334a-b94f-8b9d3d0effb6",
                                                "text": "The builders at the site had more brawn than brain."
                                            },
                                            {
                                                "example_id": "ef6aa84d-dfa6-4463-91b1-aec6af6b8782",
                                                "sense_id": "c433b120-fb55-334a-b94f-8b9d3d0effb6",
                                                "text": "The man was a bruiser, the sort who'd learned his science in tavern brawls. Given his size and lack of agility, he relied on his brawn to win. In any wrestling match, Crowley would triumph easily."
                                            },
                                            {
                                                "example_id": "26d06fe9-8f36-4b9a-b14a-755a60cd7142",
                                                "sense_id": "c433b120-fb55-334a-b94f-8b9d3d0effb6",
                                                "text": "The two men were husky, picked for their brawn by the little man who sauntered into the room."
                                            },
                                            {
                                                "example_id": "ae1f2197-ca29-43f4-8f31-c2584ac1f791",
                                                "sense_id": "c433b120-fb55-334a-b94f-8b9d3d0effb6",
                                                "text": "The youth agreed to the scheme and used his brawn to begin moving pieces into place, starting by moving the planet Rann into the Thanagarian star system […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbcf566-e005-34f9-8414-d97b69670f40",
                                        "entry_id": "ba334ca0-5182-3935-9348-8d9bc0c9584d",
                                        "glosses": [
                                            "Head cheese; a terrine made from the head of a pig or calf; originally boar's meat."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "724fee8c-defa-49ed-8246-39944d68d629",
                                                "sense_id": "9bbcf566-e005-34f9-8414-d97b69670f40",
                                                "text": "Now if your Majesty would have our bristles\nTo bind your mortar with, or fill our colons\nWith rich blood, or make brawn out of our gristles,\nIn policy—ask else your royal Solons—\nYou ought to give us hog-wash and clean straw,\nAnd sties well thatched; besides it is the law!"
                                            },
                                            {
                                                "example_id": "24542e74-dde5-45e9-a0b8-05ad8381bcbc",
                                                "sense_id": "9bbcf566-e005-34f9-8414-d97b69670f40",
                                                "text": "It was brawn and shape for high tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595685c7-1f0b-37ac-b46e-3823b2872657",
                                        "entry_id": "ba334ca0-5182-3935-9348-8d9bc0c9584d",
                                        "glosses": [
                                            "A boar."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ca08574-77cb-49c8-9fa7-4b913a2b66ac",
                                                "sense_id": "595685c7-1f0b-37ac-b46e-3823b2872657",
                                                "text": "And loud as brawns wer [they] snoring,"
                                            },
                                            {
                                                "example_id": "d8f8ace5-64fa-431d-bcfb-dfe26d58fce2",
                                                "sense_id": "595685c7-1f0b-37ac-b46e-3823b2872657",
                                                "text": "THE village of Brancepath, pleasantly situated at the distance of four miles and three- quarters south-west by west of Durham, is said to have derived its name (a corruption of Brawn's-path) from a brawn of vast size, [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9815ca55-9f01-396a-8e3f-37dbc47390ad",
                                        "entry_id": "8fcd26c0-edcc-3cea-8b73-6c5175c0e22d",
                                        "glosses": [
                                            "Make fat, especially of a boar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa70e4a2-256e-3374-bbbc-a46b66b01197",
                                        "entry_id": "8fcd26c0-edcc-3cea-8b73-6c5175c0e22d",
                                        "glosses": [
                                            "Become fat, especially of a boar."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa320598-ca05-4f7e-b44d-65bad5443968",
                        "source_entry_id": "782722a2-280a-327a-8924-fd416492ffac",
                        "source_sense_id": "b3280b3f-c4ee-3721-836c-3f168bf4163a",
                        "source_sense_description": "Gastronomie: Wurstware aus Schweinefleisch",
                        "target_lang_word": "hure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d389f15-9bf5-39b1-af5e-be35fb05fcdc",
                                        "entry_id": "f7db5b17-a090-3b68-9b0c-edede9b93009",
                                        "glosses": [
                                            "Tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ffb7b4-ff53-400d-b270-ffa9fa1206c5",
                                                "sense_id": "4d389f15-9bf5-39b1-af5e-be35fb05fcdc",
                                                "text": "On trouvera [dans La Nouvelle Librairie] toutes les publications de la Nouvelle Droite […]. Le tout sous les auspices d'une magnifique hure de sanglier, l'animal totémique des Gaulois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e014420-e277-37f0-ac30-bf6463cfa510",
                                        "entry_id": "f7db5b17-a090-3b68-9b0c-edede9b93009",
                                        "glosses": [
                                            "Tête d'animal à l'allure féroce."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa254c6-9a82-4421-be44-c3506326409b",
                                                "sense_id": "3e014420-e277-37f0-ac30-bf6463cfa510",
                                                "text": "Hure « d'un sanglier, d'un ours, d'un loup, et autres bestes mordantes »."
                                            },
                                            {
                                                "example_id": "e0b93b72-5438-408e-81d5-73b7f66663f9",
                                                "sense_id": "3e014420-e277-37f0-ac30-bf6463cfa510",
                                                "text": "Anaxandrides, cité par Athénée, déclare que Nérée seul a pu le premier imaginer de manger la hure de cet excellent poisson."
                                            },
                                            {
                                                "example_id": "cf276976-1d3c-44ff-b9e4-e7b7b57817df",
                                                "sense_id": "3e014420-e277-37f0-ac30-bf6463cfa510",
                                                "text": "Ayant courage, intelligence,\nEt belle hure outre cela.\nVoici comment il en alla.\nUn lion de haut parentage\nEn passant par un certain pré,\nRencontra bergère à son gré :\nIl la demande en mariage."
                                            },
                                            {
                                                "example_id": "e8613abb-e0ea-4cca-bf60-49e96f437ab0",
                                                "sense_id": "3e014420-e277-37f0-ac30-bf6463cfa510",
                                                "text": "Sous l’averse, Simon Chalumot relevait le cou désespérément, et la trogne du capitaine-major, turgescente, difforme, crevassée, lui semblait une hure d’animal monstrueux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbb3209-3c59-3f2c-9977-dd3d5d4ef691",
                                        "entry_id": "f7db5b17-a090-3b68-9b0c-edede9b93009",
                                        "glosses": [
                                            "Tête hérissée, hirsute, mal peignée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0514ef16-1d5c-4715-bfce-daeb4a3fdd61",
                                                "sense_id": "9bbb3209-3c59-3f2c-9977-dd3d5d4ef691",
                                                "text": "Avoir une vilaine hure, avoir une physionomie déplaisante et un air négligé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f84440c6-bee4-395d-b86a-7cabfdbc21de",
                                        "entry_id": "f7db5b17-a090-3b68-9b0c-edede9b93009",
                                        "glosses": [
                                            "Pâté de tête à base de sanglier ou de cochon."
                                        ],
                                        "tags": [
                                            "Charcuterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e170ae7b-043d-4132-ba18-4dc218e97b42",
                                                "sense_id": "f84440c6-bee4-395d-b86a-7cabfdbc21de",
                                                "text": "Mangez donc, lui dit la jeune fille en lui servant un morceau de la hure d’un sanglier."
                                            },
                                            {
                                                "example_id": "fc327d9e-4dd3-4827-b734-7e6a36ecc71e",
                                                "sense_id": "f84440c6-bee4-395d-b86a-7cabfdbc21de",
                                                "text": "Et il y avait encore des plats ronds et ovales, les plats de la langue fourrée, de la galantine truffée, de la hure aux pistaches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2f262c2-fc3a-3282-9cd4-cc602fdbca40",
                                        "entry_id": "f7db5b17-a090-3b68-9b0c-edede9b93009",
                                        "glosses": [
                                            "Espèce de brosse garnie de tous les côtés et adaptée à un manche, nommé aussi tête de loup."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d478d3e6-eab7-3294-bcf5-c22a540074ef",
                                        "entry_id": "f7db5b17-a090-3b68-9b0c-edede9b93009",
                                        "glosses": [
                                            "Meuble représentant une tête de sanglier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33bd1a89-3ab7-44e1-b31b-1d72a6c976d5",
                                                "sense_id": "d478d3e6-eab7-3294-bcf5-c22a540074ef",
                                                "text": "D’argent à une hure de sanglier de sable, allumée et défendue du champ, accompagnée de trois croissants de gueules, qui est de Argœuves de la Somme → voir illustration « armoiries avec une hure »"
                                            }
                                        ]
                                    }
                                ]
                            },
