                                "target_lang_sense_clarification": "main office"
                            },
                            {
                                "target_lang_word": "center",
                                "target_lang_sense_clarification": "central authority"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总部",
                                "target_lang_sense_clarification": "主要办公机构"
                            },
                            {
                                "target_lang_word": "中央",
                                "target_lang_sense_clarification": "最高领导机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36597697-4393-3e6c-8f3d-c97ab2727602",
                    "sense_definition": "Политические партии и группы, занимающие умеренную позицию между левыми и правыми.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Политический <w>центр</w> часто играет решающую роль на выборах.",
                            "target_lang_translations": {
                                "en": "The political <w>center</w> often plays a decisive role in elections.",
                                "zh": "政治<w>中间派</w>往往在选举中起决定性作用。"
                            }
                        },
                        {
                            "text": "Кандидат пытается объединить правых и <w>центр</w> для создания коалиции.",
                            "target_lang_translations": {
                                "en": "The candidate is trying to unite the right and the <w>center</w> to create a coalition.",
                                "zh": "候选人正试图联合右翼和<w>中间派</w>以组建联盟。"
                            }
                        }
                    ],
                    "antonyms": [
                        "радикалы"
                    ],
                    "common_phrases": [
                        "политический центр"
                    ],
                    "target_lang_definitions": {
                        "en": "Political parties and groups holding a moderate position between left and right.",
                        "zh": "在左派和右派之间持温和立场的政治派别或团体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "center",
                                "target_lang_sense_clarification": "political position"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中间派",
                                "target_lang_sense_clarification": "政治立场"
                            }
                        ]
                    }
                }
            ]
        }
    ]
