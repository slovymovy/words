                "senses": [
                    {
                        "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                        "entry_id": "dbf49ea0-a17c-3851-9349-cd5879841341",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf7bea9-b28a-4c7d-86fe-dfd380838e9c",
                                "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                                "text": "Frau Bettziege ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7b7b6d90-8d85-4776-9633-716876043e57",
                                "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                                "text": "Herr Bettziege wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2661219c-4d17-4946-9a1b-01f3402034c6",
                                "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                                "text": "Die Bettzieges fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3d61721e-e146-4870-b6ab-9cbb4a47c19c",
                                "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                                "text": "Der Bettziege trägt nie die Schals, die die Bettziege ihm strickt."
                            },
                            {
                                "example_id": "82943b45-e973-415d-9566-a95af876c357",
                                "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bettziege kommt, geht der Herr Bettziege.“"
                            },
                            {
                                "example_id": "aaabfd40-558d-4b2a-85fe-374e5c8e95e5",
                                "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                                "text": "Bettziege kommt und geht."
                            },
                            {
                                "example_id": "f2de8b0f-3da4-42a0-b326-d05e01001bf3",
                                "sense_id": "f991dd7b-4b3f-3d48-82d2-7a13e53107f4",
                                "text": "Bettzieges kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
