                                "example_id": "74b30537-2d63-4367-9133-4871fd4c93b3",
                                "sense_id": "d6f08fdc-311f-33d8-b164-e142fbc0ba26",
                                "text": "C’est un projet terminé."
                            },
                            {
                                "example_id": "069b40eb-bd69-4298-a564-7c5b0c149b1a",
                                "sense_id": "d6f08fdc-311f-33d8-b164-e142fbc0ba26",
                                "text": "Quand il vit que rien n’était terminé, il respira ; mais il n’eût pu dire si ce qu’il ressentait étai du contentement ou de la douleur."
                            }
                        ]
                    }
                ],
