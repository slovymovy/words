                        "glosses": [
                            "Pratique en conformité avec les rites prescrits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc096472-4863-439d-9a44-23ba1c850f0e",
                                "sense_id": "06110476-d9ce-341f-9d3e-48d002c82f2e",
                                "text": "Dès l'origine du baptisme français, l'importance de l'orthopraxie, d'une vie droite, en conformité avec les exigences évangéliques, est très fortement mise en avant."
                            },
                            {
                                "example_id": "1184f8a0-490e-4bca-9ad0-e4c004882659",
                                "sense_id": "06110476-d9ce-341f-9d3e-48d002c82f2e",
                                "text": "L'engagement public exigé ne relevait pas du croire mais du faire, selon les principes d'orthopraxie qui régissaient la religion romaine."
                            }
                        ]
                    }
