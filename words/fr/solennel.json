            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f72745df-4fcf-322e-999c-294afa6a3dad",
                    "sense_definition": "Qui est célébré avec pompe et marqué par des cérémonies officielles ou publiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ceremonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a prononcé un discours lors de l'ouverture <w>solennelle</w> du festival international."
                        },
                        {
                            "text": "Toute la promotion s'est réunie pour une cérémonie <w>solennelle</w> de remise des diplômes."
                        }
                    ],
                    "synonyms": [
                        "cérémonieux",
                        "pompeux",
                        "protocolaire"
                    ],
                    "antonyms": [
                        "informel",
                        "familier"
                    ],
                    "common_phrases": [
                        "cérémonie solennelle",
                        "séance solennelle",
                        "ouverture solennelle"
                    ]
                },
                {
                    "sense_id": "80cb0526-5f6b-3647-a175-4f1878f0c3b8",
                    "sense_definition": "Qui exprime une gravité imposante, un air très sérieux ou un ton majestueux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a pris un ton <w>solennel</w> pour annoncer les changements importants dans l'entreprise."
                        },
                        {
                            "text": "D'un air <w>solennel</w>, il a regardé ses proches avant de leur révéler la vérité."
                        }
                    ],
                    "synonyms": [
                        "grave",
                        "majestueux",
                        "sentencieux"
                    ],
                    "antonyms": [
                        "badin",
                        "décontracté",
                        "léger"
                    ],
                    "common_phrases": [
                        "air solennel",
                        "ton solennel",
                        "voix solennelle"
                    ]
                },
                {
                    "sense_id": "d9c072d5-0364-3590-8da4-d68b1affea7d",
                    "sense_definition": "Revêtu des formalités requises lui conférant une valeur juridique ou morale contraignante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouveaux magistrats prêtent un serment <w>solennel</w> devant la cour avant d'entrer en fonction."
                        },
                        {
                            "text": "Elle a pris l'engagement <w>solennel</w> de respecter la confidentialité absolue de ces documents sensibles."
