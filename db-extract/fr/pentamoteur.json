                        "examples": [
                            {
                                "example_id": "dec04df2-15f7-434a-a15d-24708c417724",
                                "sense_id": "3a4c3c7a-64b9-3ada-91cc-80afa0b2c16b",
                                "text": "Caudron lança, en 1920, le premier pentamoteur qui, piloté par Duhamel, exécuta pour premier essai Paris-Marseille à une allure de record."
                            },
                            {
                                "example_id": "d65029be-f609-43dd-b293-22f1232bd497",
                                "sense_id": "3a4c3c7a-64b9-3ada-91cc-80afa0b2c16b",
                                "text": "On croit Alksnis fusillé, comme le créateur des pentamoteurs soviétiques, l’ingénieur Tupolev."
                            }
                        ]
                    }
