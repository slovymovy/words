                {
                    "sense_id": "b1e18076-95c1-394c-9f05-c80e3a5f8080",
                    "sense_definition": "To generate an entire space by means of linear combinations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These two vectors <w>span</w> the entire plane.",
                            "target_lang_translations": {
                                "ru": "Эти два вектора <w>порождают</w> всю плоскость.",
                                "zh": "这两个向量<w>张成</w>整个平面。",
                                "nl": "Deze twee vectoren <w>spannen</w> het hele vlak <w>op</w>."
                            }
                        },
                        {
                            "text": "We need to find a set of vectors that <w>span</w> the subspace.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти набор векторов, которые <w>порождают</w> подпространство.",
                                "zh": "我们需要找到一组能够<w>张成</w>该子空间的向量。",
                                "nl": "We moeten een verzameling vectoren vinden die de deelruimte <w>opspannen</w>."
                            }
