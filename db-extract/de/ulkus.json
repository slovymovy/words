                                        "glosses": [
                                            "An open sore of the skin, eyes or mucous membrane, often caused by an initial abrasion and generally maintained by an inflammation and/or an infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64d1fbaf-6561-3290-ab7e-a9e14771e419",
                                        "entry_id": "694f1de1-1dfe-3640-b1f9-c94613c2ecf5",
                                        "glosses": [
                                            "Peptic ulcer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "572c5f74-26bd-4643-8dee-ff7aac57f290",
                                                "sense_id": "64d1fbaf-6561-3290-ab7e-a9e14771e419",
                                                "text": "\"Worry never solved any problems. Only gives you ulcers.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7ddcb7-7bd1-3455-9d0e-094fa89c0ac5",
                                        "entry_id": "694f1de1-1dfe-3640-b1f9-c94613c2ecf5",
                                        "glosses": [
                                            "Anything that festers and corrupts like an open sore; a vice in character."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ulcer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f8b5e1b-ddcd-334b-a11c-cae929d4b560",
                                        "entry_id": "d619b77d-1e3c-39b3-825d-fc138424e692",
                                        "glosses": [
                                            "To ulcerate."
