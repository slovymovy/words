                        "glosses": [
                            "Association pour le maintien à domicile des personnes âgées."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "5b924c5f-c86d-4059-a491-82cf2c77c779",
                                "sense_id": "418b97ea-d5db-3e2c-b443-5c205d790534",
                                "text": "La Maison de l’ADMR du pays d'Aix propose des services d'aide à tous les publics, famille avec jeunes enfants, personnes âgées, personnes atteintes d'un handicap : ménage, repassage, petit bricolage et même jardinage."
                            },
                            {
                                "example_id": "9b61bc87-15fa-4cf2-9cef-462e401d9ada",
                                "sense_id": "418b97ea-d5db-3e2c-b443-5c205d790534",
                                "text": "Les élus orientent majoritairement les personnes en difficulté vers l'assistante sociale du Conseil général, vers le Conseil général placé en première ligne avec ses structures d'action sociale territorialisée (maisons départementales de la solidarité et autres points d'accueil), ainsi que vers les associations caritatives, dont les Restos du Cœur assez bien répartis sur l'ensemble du département et les ADMR pour les campagnes."
                            }
                        ]
                    }
