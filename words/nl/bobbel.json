{
    "word_family": [
        "bobbelen",
        "bobbelig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3590238-5315-37a8-97e8-924374558e5a",
                    "sense_definition": "Een ronde verdikking of verheffing op een anders vlak oppervlak.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oneffenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een vreemde <w>bobbel</w> in het tapijt waar iedereen over struikelt.",
                            "target_lang_translations": {
                                "en": "There is a strange <w>bump</w> in the carpet that everyone trips over."
                            }
                        },
                        {
                            "text": "Na de val had hij een flinke <w>bobbel</w> op zijn voorhoofd.",
                            "target_lang_translations": {
                                "en": "After the fall, he had a large <w>lump</w> on his forehead."
                            }
                        }
                    ],
                    "synonyms": [
                        "bult",
                        "knobbel"
                    ],
                    "common_phrases": [
                        "een bobbel in het tapijt"
                    ],
                    "target_lang_definitions": {
                        "en": "A round swelling or elevation on an otherwise flat surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bump",
                                "target_lang_sense_clarification": "on a surface or skin"
                            },
                            {
                                "target_lang_word": "lump",
                                "target_lang_sense_clarification": "a swelling or small mass"
                            },
                            {
                                "target_lang_word": "bulge",
                                "target_lang_sense_clarification": "a protruding part"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22403d20-cb63-3b65-9b9e-2fa77d30a676",
                    "sense_definition": "Een gasbel die zich in of op een vloeistof bevindt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gasbel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wanneer je grote <w>bobbels</w> ziet opstijgen, begint het water te koken.",
                            "target_lang_translations": {
                                "en": "When you see large <w>bubbles</w> rising, the water is starting to boil."
                            }
                        },
                        {
                            "text": "De kinderen bliezen vrolijk elke <w>bobbel</w> in het water kapot.",
                            "target_lang_translations": {
                                "en": "The children happily popped every <w>bubble</w> in the water."
                            }
                        }
                    ],
                    "synonyms": [
                        "bubbel",
                        "bel",
                        "brobbel"
                    ],
                    "target_lang_definitions": {
                        "en": "A gas bubble located in or on a liquid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bubble",
                                "target_lang_sense_clarification": "in a liquid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c93212f1-ee8b-30ac-848c-06833b4fd500",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>bobbelen</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bobbel</w> de stof op zodat het er golvend uitziet.",
                            "target_lang_translations": {
                                "en": "I <w>pucker</w> the fabric so that it looks wavy."
                            }
                        },
                        {
                            "text": "Als ik de verf niet goed uitstrijk, <w>bobbel</w> ik het hele oppervlak.",
                            "target_lang_translations": {
                                "en": "If I don't smooth out the paint properly, I <w>bubble</w> the entire surface."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'bobbelen' (to bubble, pucker, or bulge)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pucker",
                                "target_lang_sense_clarification": "first-person singular present"
                            },
                            {
                                "target_lang_word": "bubble up",
                                "target_lang_sense_clarification": "first-person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c690a2b-b964-3b79-9509-cec06dc53583",
                    "sense_definition": "Gebiedende wijs van <w>bobbelen</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bobbel</w> dat papier niet zo als je het opplakt!",
                            "target_lang_translations": {
                                "en": "Don't <w>pucker</w> that paper like that when you glue it down!"
                            }
                        },
                        {
                            "text": "Let op en <w>bobbel</w> de folie niet tijdens het aanbrengen.",
                            "target_lang_translations": {
                                "en": "Pay attention and do not <w>bubble</w> the foil during application."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'bobbelen' (to bubble, pucker, or bulge)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pucker",
                                "target_lang_sense_clarification": "imperative"
                            },
                            {
                                "target_lang_word": "bubble",
                                "target_lang_sense_clarification": "imperative"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34045205-ba92-31f1-bf46-cd9f904d7515",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>bobbelen</w> in inversie.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>bobbel</w> je het behang zo erg tijdens het plakken?",
                            "target_lang_translations": {
                                "en": "Why do you <w>pucker</w> the wallpaper so much while hanging it?"
                            }
                        },
                        {
                            "text": "Als je zo hard duwt, <w>bobbel</w> je de dunne plastic plaat.",
                            "target_lang_translations": {
                                "en": "If you push that hard, you will <w>warp</w> the thin plastic sheet."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present inversion"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present tense of 'bobbelen' in inversion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pucker",
                                "target_lang_sense_clarification": "second-person singular present inversion"
                            },
                            {
                                "target_lang_word": "bubble",
                                "target_lang_sense_clarification": "second-person singular present inversion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
