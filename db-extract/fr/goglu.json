                                        "entry_id": "ec9a6d4a-73f0-3948-8b60-a91596e177b2",
                                        "glosses": [
                                            "An American migratory songbird (Dolichonyx oryzivorus), resembling a blackbird with the bill of a finch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35e0c5f1-b2ba-410b-8538-1f1b3804f7f7",
                                                "sense_id": "418df095-5e8b-36d3-8e40-0cd6d0c38d89",
                                                "text": "Lethe in my flower / Of which they who drink / In the fadeless orchards / Hear the bobolink."
                                            },
                                            {
                                                "example_id": "0f39108f-1e40-43e5-94cc-8099a0b2a37e",
                                                "sense_id": "418df095-5e8b-36d3-8e40-0cd6d0c38d89",
                                                "text": "The San's feeders were mobbed with sparrows and jays and the starlings that had just begun to colonize the area, but there was no sign of robin, bobolink or oriole."
                                            }
                                        ]
                                    }
                                ]
