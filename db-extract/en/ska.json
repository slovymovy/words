    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b8740366-7f04-3e1d-8115-cc92d400d7aa",
                "word": "ska",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f5ef236b-7cd8-37dd-bc2b-e5fcd6f3aa45",
                        "entry_id": "b8740366-7f04-3e1d-8115-cc92d400d7aa",
                        "glosses": [
                            "A style of Jamaican dance music originating in the late 1950s, combining elements of Caribbean calypso and mento with American jazz and rhythm and blues; it was the precursor to rocksteady and reggae."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "432e48de-4432-41cf-b7af-cc4bbf994dd0",
                                "sense_id": "f5ef236b-7cd8-37dd-bc2b-e5fcd6f3aa45",
                                "text": "Musical Hairsplitting: The act of classifying music and musicians into pathologically picayune categories: “The Vienna Franks are a good example of urban white acid folk revivalism crossed with ska.”"
                            },
                            {
                                "example_id": "dd408779-0f9e-4862-bb4b-b2e60d7135ae",
                                "sense_id": "f5ef236b-7cd8-37dd-bc2b-e5fcd6f3aa45",
                                "text": "Everyone who loves ska has their own story to tell—the first time they heard the Specials back in the '70s, the first time they danced onstage at a Toasters show in the '80s, the first time they saw the Skatalites perform in the '90s."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dab3d78-d8fb-470f-a6ed-51f690717173",
                        "source_entry_id": "b8740366-7f04-3e1d-8115-cc92d400d7aa",
                        "source_sense_id": "f5ef236b-7cd8-37dd-bc2b-e5fcd6f3aa45",
                        "source_sense_description": "style of Jamaican dance music originating in the late 1950s",
                        "target_lang_word": "ska",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ska",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "16c437c2-0bcc-3128-aa84-b595018c0195",
                                        "entry_id": "96ac00c5-fb51-3ae1-8224-977831c25047",
                                        "glosses": [
                                            "dansmuziek, met elementen van calypso, jazz en rhythm-and-blues en een karakteristieke vierkwartsmaat met nadruk op de tweede en vierde noot\\nDeze voorloper van de reggae ontstond eind jaren 50 van de 20e eeuw op Jamaica en werd in het laatste kwart van de 20e eeuw ook populair in Europa en Noord-Amerika."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c25ff81-c1da-4eef-86a3-13c09df916a4",
                                                "sense_id": "16c437c2-0bcc-3128-aa84-b595018c0195",
                                                "text": "Protoje verwijst in zijn muziek – ook tijdens zijn optreden vrijdag in de Melkweg – voortdurend naar de Jamaicaanse muziekgeschiedenis; van ska en dub tot reggae en dancehall."
                                            },
                                            {
                                                "example_id": "a4fac19b-119e-421b-931e-d33e90e39f31",
                                                "sense_id": "16c437c2-0bcc-3128-aa84-b595018c0195",
                                                "text": "Met deze switch lijkt de feestband een gooi te doen naar een groter publiek. Wie zich niet stoort aan het hoekige accent kan een leuk feest bouwen met deze tracks. (…) In nummers als ‘Like a lion’ en ‘Attention’ zijn reggae, ska en dub te horen. De blazers zorgen voor een verrassende noot."
                                            },
                                            {
                                                "example_id": "32b0838f-2c4a-4bb5-81b9-32bc9cd1a4a0",
                                                "sense_id": "16c437c2-0bcc-3128-aa84-b595018c0195",
                                                "text": "Het is een speciaal soort muziek, dat buiten het normale pop-patroon valt en die uitermate geschikt is om op te dansen — in discotheken wordt de muziek dan ook veel gedraaid. De naam van de muziek? Er zijn er vier: blue-beat, reggae, rock steady en ska."
                                            },
                                            {
                                                "example_id": "c2d4058c-f11d-4790-8c93-a6b4b80cb643",
                                                "sense_id": "16c437c2-0bcc-3128-aa84-b595018c0195",
                                                "text": "Twist, Angel, Swim, Monkey', Ska, Hully Gully, Jerk, Bird; Dog, Mashed Potato, Rifleman, Surf, ze weten do weg in dit doolhof van de moderne dansen, ze spreken de taal en zijn \"hip\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2da6c216-851e-489e-91b0-35df14bb7b1c",
                        "source_entry_id": "b8740366-7f04-3e1d-8115-cc92d400d7aa",
                        "source_sense_id": "f5ef236b-7cd8-37dd-bc2b-e5fcd6f3aa45",
