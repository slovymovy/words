                "translations": [
                    {
                        "translation_id": "7455bdcd-8293-438a-87bd-71ac4bea8e63",
                        "source_entry_id": "1b61f35b-3316-3a59-ba35-efe7b930b045",
                        "target_lang_word": "retrain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retrain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f18b6551-1a40-3738-abb3-726390d01bb5",
                                        "entry_id": "123382bb-4a10-385e-be94-8cf03d2b1a31",
                                        "glosses": [
                                            "To train again; especially, to train or study in a new subject or job"
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff2542c-ef79-45cd-b1f8-af874c97b415",
                                                "sense_id": "f18b6551-1a40-3738-abb3-726390d01bb5",
                                                "text": "New York City's largest hospital has agreed to retrain some unionized employees whose jobs were to be eliminated under an austerity drive, the hospital and its largest labor union said yesterday."
                                            },
                                            {
                                                "example_id": "f96f2d4a-20ab-4f01-989c-8892a2b3b3a4",
                                                "sense_id": "f18b6551-1a40-3738-abb3-726390d01bb5",
                                                "text": "In 1995, Sharon Brown and her husband, Daryck, founded Environmental and Occupational Safety Services at their kitchen table. The company, which retrains workers in the fields of environmental engineering and cleanup, started to grow by winning contracts from the state of New Jersey and later branched out to do work for the federal government as well."
                                            },
                                            {
                                                "example_id": "fd1bf708-4415-4010-b7be-3771f6ccb9cd",
                                                "sense_id": "f18b6551-1a40-3738-abb3-726390d01bb5",
                                                "text": "If we choose to change our diets and consistently eat healthier foods we retrain our brains, and the foods we initially found distasteful will become enjoyable."
                                            },
                                            {
                                                "example_id": "a27f97c0-c230-4673-87cd-b08a264a6706",
                                                "sense_id": "f18b6551-1a40-3738-abb3-726390d01bb5",
                                                "text": "The process of retraining a large volume of pilots, who have been idle for different periods of time over the past year is complex and challenging."
                                            },
                                            {
                                                "example_id": "bdfad724-78c1-488b-8f21-619f35e85559",
                                                "sense_id": "f18b6551-1a40-3738-abb3-726390d01bb5",
                                                "text": "For about $1,000 per student annually, the program retrained teachers and administrators and paid for new classroom materials, better aligned to cognitive research."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retrain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "586c6150-6a70-3c5e-85ae-6444315d433b",
                                        "entry_id": "7b95f483-1635-32ff-bd4a-efaa577b2f3f",
                                        "glosses": [
                                            "An instance of training again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb2b22d-6435-4c2e-9861-e9ce33091b02",
                                                "sense_id": "586c6150-6a70-3c5e-85ae-6444315d433b",
                                                "text": "This adds a bit of complexity as it means that our solution should not retrain for every request coming in but be able to determine whether a retrain is worth it for a given request or whether the model is already up to date."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
