                    {
                        "sense_id": "1ea6c34e-76a1-336f-bc6f-557dd9c6e883",
                        "entry_id": "84a2af9c-d8a7-3d1c-8673-9de702873cf9",
                        "glosses": [
                            "Relatif aux Sans, peuples autochtones d’Afrique australe, et à leur culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe59f8e-fabe-445a-89cc-92b2079f4f63",
                                "sense_id": "1ea6c34e-76a1-336f-bc6f-557dd9c6e883",
                                "text": "Revenant sur ses pas, Solanah croisa un jardinier san, qui ne répondit pas à son anglais, pas plus que la blanchisseuse revenant des bungalows – le faisaient-ils exprès ?"
                            }
                        ]
                    }
                ],
