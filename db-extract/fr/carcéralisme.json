                "entry_id": "99100d49-b455-3a7e-ac49-1540ce38e83f",
                "word": "carcéralisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33d92e2c-3a6c-4799-8921-13d9d7d94ce0",
                        "entry_id": "99100d49-b455-3a7e-ac49-1540ce38e83f",
