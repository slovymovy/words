                        "glosses": [
                            "собир., устар., пренебр. ямщики"
                        ],
                        "tags": [
                            "только ед. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "cd54a25b-9cf5-4467-9560-dbe5b4097fd3",
                                "sense_id": "70c4c6db-633e-35bb-8859-90135dc73e2f",
                                "text": "Выбили тогда ямщину да прасолов с поля. Человек с пяток пришлось им лежачими подобрать."
                            }
                        ]
