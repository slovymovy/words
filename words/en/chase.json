                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <Chase> during their trip to Canada.",
                            "target_lang_translations": {
                                "ru": "Они посетили небольшую деревню <Чейз> во время поездки в Канаду.",
                                "zh": "他们在加拿大旅行期间参观了<w>蔡斯</w>小村庄。"
                            }
                        },
                        {
                            "text": "He grew up in <Chase> City before moving to the coast.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <Чейз>-Сити, прежде чем переехать на побережье.",
                                "zh": "他在搬到沿海地区之前是在<w>蔡斯</w>市长大的。"
                            }
                        }
