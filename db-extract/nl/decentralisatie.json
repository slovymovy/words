                                        "glosses": [
                                            "Action de faire cesser la centralisation ou état de choses contraire à la centralisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b520dc7-d433-40cb-9a98-99200963f296",
                                                "sense_id": "88362068-b66b-3c80-8f67-761b1fd463da",
                                                "text": "La dénazification figurait au même titre que la démilitarisation, la démocratisation et la décentralisation, au cœur des accords de Potsdam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c2230d2-478a-38ee-b763-3c30b2496cba",
                                        "entry_id": "5615ecbc-9813-39b2-a589-bfa067cf60e5",
                                        "glosses": [
                                            "Politique destinée à accorder une plus grande autonomie aux régions vis-à-vis du pouvoir central."
