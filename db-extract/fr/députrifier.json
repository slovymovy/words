                        "glosses": [
                            "Faire perdre son caractère putréfié ou putride à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1579f30-9884-4282-97b3-8b64930cd789",
                                "sense_id": "08b98a73-5081-34bf-927f-03356b8189c2",
                                "text": "Ou alors on attend quelques centaines de milliers d'années qu'ils soient députrifiés/consommés par des bactéries en carburant et hop!"
                            },
                            {
                                "example_id": "fd9fc90c-d89e-4246-9ca3-d6c0fe6418a2",
                                "sense_id": "08b98a73-5081-34bf-927f-03356b8189c2",
                                "text": "Je suis tout étonifié de par la déstructuration structurée de la coloration ébouriffée des tableaux députrifiés par la réalité controversée qu'ils chantent sans simagrée."
                            },
                            {
                                "example_id": "ee7d802e-9b52-430e-87c2-3cfbcc4b2c40",
                                "sense_id": "08b98a73-5081-34bf-927f-03356b8189c2",
                                "text": "Je veux de l’eau, je veux me décroûter, désensanglanter, décailler, députrifier, dépuriner, désinfecter, défècier."
                            }
                        ]
                    }
