                        "examples": [
                            {
                                "example_id": "6906527a-e771-4033-bb82-4601e3335bf3",
                                "sense_id": "adab75b4-3c6d-3ff5-847d-2fcd5121583b",
                                "text": "Der Stabsarzt entspricht dem Hauptmann."
                            },
                            {
                                "example_id": "3b4d9eed-ac77-41fd-b889-3ee255e5123a",
                                "sense_id": "adab75b4-3c6d-3ff5-847d-2fcd5121583b",
                                "text": "„Gottfried Benn, demnächst 49 Jahre alt, hat Aufnahme ins Militär beantragt und ist angenommen worden, zunächst auf Probe als Stabsarzt mit Aussicht auf Beförderung.“"
                            }
                        ],
