                        "zh": [
                            {
                                "target_lang_word": "购物环境",
                                "target_lang_sense_clarification": "指代购物的便利程度和选择"
                            },
                            {
                                "target_lang_word": "商店",
                                "target_lang_sense_clarification": "指代该地区的商业设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e90561c2-6a0a-31f4-896a-db552049bf95",
                    "sense_definition": "The act of placing a vehicle or machine in a workshop for repair or overhaul.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The locomotive is scheduled for <w>shopping</w> to replace worn parts.",
                            "target_lang_translations": {
                                "ru": "Локомотив запланирован на <w>ремонт</w> для замены изношенных деталей.",
                                "zh": "这台机车已安排<w>检修</w>以更换磨损零件。"
                            }
                        },
                        {
                            "text": "Regular <w>shopping</w> ensures the engines remain reliable for long journeys.",
                            "target_lang_translations": {
                                "ru": "Регулярное <w>техобслуживание</w> гарантирует надежность двигателей в дальних поездках.",
                                "zh": "定期的<w>维修</w>能确保引擎在长途旅行中保持可靠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overhaul",
                        "servicing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Постановка транспортного средства или механизма в цех для ремонта или технического обслуживания.",
                        "zh": "将车辆或机器送入车间进行维修或大修的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ремонт",
                                "target_lang_sense_clarification": "техническое обслуживание в депо"
                            },
                            {
                                "target_lang_word": "техобслуживание",
                                "target_lang_sense_clarification": "профилактические работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维修",
                                "target_lang_sense_clarification": "对设备进行修理"
                            },
                            {
                                "target_lang_word": "检修",
                                "target_lang_sense_clarification": "对设备进行检查和修理"
                            }
                        ]
                    }
