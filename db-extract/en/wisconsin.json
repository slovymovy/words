                                    {
                                        "sense_id": "96e7754a-88a3-3d3a-ae07-8896b6ededeb",
                                        "entry_id": "35cc264d-d05f-3023-9a35-b9e29f621802",
                                        "glosses": [
                                            "Bundesstaat im Mittleren Westen der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d14a125-35e3-4033-9f4c-4b0c4e10ba9f",
                                                "sense_id": "96e7754a-88a3-3d3a-ae07-8896b6ededeb",
                                                "text": "Wegen der dort betrieben Milchwirtschaft werden die Bewohner Wisconsins auch ‚Käseköpfe‘ genannt."
                                            },
                                            {
                                                "example_id": "762cd779-e00e-4996-8010-903fdca6d5e4",
                                                "sense_id": "96e7754a-88a3-3d3a-ae07-8896b6ededeb",
                                                "text": "„Vergangene Woche lehnte Wisconsin den Subventionsantrag des Unternehmens ab und stellte fest, dass es Ende 2019 nur 281 vertragsberechtigte Personen beschäftigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wisconsin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d6c825-0fa6-3b7e-86a8-fef9ee8f3ed7",
                                        "entry_id": "3547b5bd-bcc9-3b35-baf8-f086922e1e23",
                                        "glosses": [
                                            "Nebenfluss des Mississippi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba6e2851-65a1-49ad-bf34-af98e6b1d1bc",
                                                "sense_id": "c4d6c825-0fa6-3b7e-86a8-fef9ee8f3ed7",
                                                "text": "Gestern überquerten sie den Wisconsin."
                                            },
                                            {
                                                "example_id": "e350ac09-c519-4604-8d84-24c8e1ddc532",
                                                "sense_id": "c4d6c825-0fa6-3b7e-86a8-fef9ee8f3ed7",
                                                "text": "Wisconsin Rapids liegt am Wisconsin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
