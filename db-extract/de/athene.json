                                        "sense_id": "eac0b357-dd30-397a-af34-14140de44eae",
                                        "entry_id": "9d0488e0-d64e-31f2-bc7c-a98b1b0814cd",
                                        "glosses": [
                                            "A city in Umatilla County, Oregon, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98684847-9d62-3be4-952a-fc91b50d8758",
                                        "entry_id": "9d0488e0-d64e-31f2-bc7c-a98b1b0814cd",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Athena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b23349fd-c460-3e30-b7c9-0b0592c2c090",
                                        "entry_id": "cd01657d-2396-32dc-82cf-bd24d7512188",
                                        "glosses": [
                                            "A woman who colludes with the patriarchy rather than actively opposing it."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b669f178-a841-43ee-85ba-ca1aac3dd6eb",
                                                "sense_id": "b23349fd-c460-3e30-b7c9-0b0592c2c090",
                                                "text": "The last thing feminist Athenas see about corporate structures, government, or academia is that they are run by benevolent and all-protective fathers."
                                            },
                                            {
                                                "example_id": "3f8a7c4a-5ad2-4f6b-b45c-cf702951b44a",
                                                "sense_id": "b23349fd-c460-3e30-b7c9-0b0592c2c090",
                                                "text": "The latter may become either Athenas or feminists. If one gets a certain sort of male sponsorship, becomes a Daddy's girl, one is allowed to function in these vocations of the righteous […]"
                                            },
                                            {
                                                "example_id": "3b58853c-cc51-4012-9794-781000c037a0",
                                                "sense_id": "b23349fd-c460-3e30-b7c9-0b0592c2c090",
                                                "text": "Women who do decide to become scientists find themselves under attack from the self-proclaimed \"echt\" feminists, who call them \"Athenas\" and \"Queen Bees.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
