                ],
                "senses": [
                    {
                        "sense_id": "b58ba916-626b-3e39-90ec-2e6cd1ff524b",
                        "entry_id": "f8041ffa-6265-3ba3-8c0f-fbeaa14f1146",
                        "glosses": [
                            "Action de jongler ; spectacle donné par cette action."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ca787547-a9a8-3875-99e0-f58f933d23f6",
                        "entry_id": "f8041ffa-6265-3ba3-8c0f-fbeaa14f1146",
                        "glosses": [
                            "Chacun des contacts entre le ballon et le joueur ou la joueuse lors de l'exercice d'adresse qui consiste à ne pas laisser le ballon toucher le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bafb5911-3d0b-4fc1-91a2-e1b6032ce838",
                                "sense_id": "ca787547-a9a8-3875-99e0-f58f933d23f6",
                                "text": "Il serait prêt à tout ce soir, entonner le répertoire de Luis Mariano, faire des jongles avec ballon en souvenir de Raymond Kopa, imiter Georges Marchais à la Fête de L’humanité."
                            },
                            {
                                "example_id": "8af1aa5d-8fda-423f-b3be-060ed15de233",
                                "sense_id": "ca787547-a9a8-3875-99e0-f58f933d23f6",
                                "text": "L’autostoppeur a marché vers lui, reçu la balle, fait trois jongles avant de la lui rendre."
                            },
                            {
                                "example_id": "fddd545f-089c-4ae7-9b16-32d2aab918d8",
                                "sense_id": "ca787547-a9a8-3875-99e0-f58f933d23f6",
                                "text": "Il y a un peu la même chose au foot, quand on parvient à relever le ballon du bout du pied, à le faire monter avec un petit jongle."
                            }
                        ]
                    }
                ],
