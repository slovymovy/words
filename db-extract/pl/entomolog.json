                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c44a784-8620-40bb-a10c-4f5664df6fb9",
                        "source_entry_id": "7186c9a9-e0ab-3304-a012-2c14843cf18d",
                        "source_sense_id": "0792cdc5-bd52-33c4-9aaf-8ac1cfd3ad96",
                        "target_lang_word": "entomologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entomologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                        "entry_id": "17c04669-43c0-3ca8-9b61-c594ed6f1f4a",
                                        "glosses": [
                                            "A scientist who studies insects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74274996-6412-41bb-9909-c2c9d759e357",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "DENR entomologists recall that beetle infestation of the agohos is similar to another which killed thousands of pine trees in Benguet in 1981."
                                            },
                                            {
                                                "example_id": "c12ec777-7e90-4311-b049-a9ed57a0e858",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "The noted entomologist Charles W. Woodworth suggested the use of Drosophila melanogaster for genetic studies."
                                            },
                                            {
                                                "example_id": "803026db-5f8b-4192-bfc1-f29a0bdfe606",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "Colorado stood at the brink of an outbreak that another Forest Service entomologist would dub “Beetlegeddon.”"
                                            },
                                            {
                                                "example_id": "6f1dbb95-1ea7-4c52-8aa7-b2165bf90be8",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "An entomologist named a new species of millipede Nannaria swiftae after pop star Taylor Swift."
                                            },
                                            {
                                                "example_id": "ed350c6a-327b-49e7-afa3-8a2a18cf304b",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "The team, made up of entomologists and electrical engineers, attached AprilTags, a kind of QR code that is smaller than the nail on your little finger, to the bees using glue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db2f7399-a1c5-4f2e-9ef6-e7f7a3994fd8",
                        "source_entry_id": "7186c9a9-e0ab-3304-a012-2c14843cf18d",
                        "source_sense_id": "0792cdc5-bd52-33c4-9aaf-8ac1cfd3ad96",
                        "target_lang_word": "entomologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entomologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04bff200-7d81-347b-a9ca-8570bf278b69",
                                        "entry_id": "66c926c1-2393-3a27-870c-2085011ff980",
                                        "glosses": [
                                            "Personne qui s’occupe d’entomologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a4957c-71dd-4b0f-83b2-b012f8352d96",
                                                "sense_id": "04bff200-7d81-347b-a9ca-8570bf278b69",
                                                "text": "De 15 h 30 à 16 h 30, Philippe Fouillet, entomologiste, c’est-à-dire spécialiste des insectes, de leur mode de reproduction et de leur impact sur l’environnement, embarquera avec lui les plus curieux pour étudier ceux-ci à l’aide de filets à papillon ou d’aspirateurs à insectes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a958dd4-bfff-31d1-ae88-9344ac014289",
                                        "entry_id": "66c926c1-2393-3a27-870c-2085011ff980",
                                        "glosses": [
                                            "Personne méticuleuse, qui procède avec beaucoup de rigueur."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e67ae187-95ee-4533-b90b-eafcf4669725",
                                                "sense_id": "9a958dd4-bfff-31d1-ae88-9344ac014289",
                                                "text": "Et c’est tant mieux : il y a dans l’invention de l’esprit une liberté qui se laisse peu prendre au filet stylistique de l’entomologiste du bon mot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "771d1278-969e-46e4-816f-0493d803c905",
                        "source_entry_id": "7186c9a9-e0ab-3304-a012-2c14843cf18d",
                        "source_sense_id": "0792cdc5-bd52-33c4-9aaf-8ac1cfd3ad96",
