                    {
                        "translation_id": "a3e36871-cd46-44fe-8e8f-4de06cb6199f",
                        "source_entry_id": "cd5fa080-ee2b-3f8c-8684-53a57d8631fa",
                        "source_sense_id": "beab48fc-6252-3bd0-a475-88ccf03e65db",
                        "source_sense_description": "being a bigot",
                        "target_lang_word": "intolérant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intolérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2f05e5a-3165-34e8-bd01-21b0294574fb",
                                        "entry_id": "420862f4-a979-30af-bd6e-5e0c8cde4f73",
                                        "glosses": [
                                            "Qui manque de tolérance, qui ne veut souffrir aucune autre opinion que la sienne."
                                        ],
                                        "tags": [],
                                        "note": "— Il se dit surtout en matière de religion et de politique",
                                        "examples": [
                                            {
                                                "example_id": "8c1d8e87-bb37-4c8f-9961-afc79df96ea4",
                                                "sense_id": "f2f05e5a-3165-34e8-bd01-21b0294574fb",
                                                "text": "Affichant non sans panache un athéisme militant, il appelle à en finir avec une certaine tolérance envers les religions monothéistes, intrinsèquement intolérantes et pétries de haine."
                                            },
                                            {
                                                "example_id": "dd0deea2-d4da-4c63-8012-c4a022396466",
                                                "sense_id": "f2f05e5a-3165-34e8-bd01-21b0294574fb",
                                                "text": "Quitte à devenir la cible des extrémistes postfreudiens inféodés et des fanatiques antipsychanalyse, tous si prompts à caricaturer et si intolérants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7284ab13-6fbd-392e-9e21-4e6e4f21010a",
                                        "entry_id": "420862f4-a979-30af-bd6e-5e0c8cde4f73",
                                        "glosses": [
                                            "Qui n'accepte pas de concurrent, de rival."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c1a6d25-4588-410e-811d-a35cd01f7469",
                                                "sense_id": "7284ab13-6fbd-392e-9e21-4e6e4f21010a",
                                                "text": "Dans le Jardin-du-Haut, deux sapins jumeaux, un noyer dont l’ombre intolérante tuait les fleurs, des roses, des gazons négligés, une tonnelle disloquée…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intolérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a769560-e526-318e-bc5b-d741d5e5af86",
                                        "entry_id": "5f6347f3-65fc-3f17-90d6-877bc7f8a73f",
                                        "glosses": [
                                            "Personne qui refuse de tolérer les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f723d7d-2cc4-4dec-a682-1b943eddbc45",
                                                "sense_id": "6a769560-e526-318e-bc5b-d741d5e5af86",
                                                "text": "Les intolérants ne sont pas toujours les plus sincèrement religieux."
                                            },
                                            {
                                                "example_id": "16c1a721-c702-46b8-984f-1a2c0a47decc",
                                                "sense_id": "6a769560-e526-318e-bc5b-d741d5e5af86",
                                                "text": "Il avait vu beaucoup de choses en vingt-sept ans de vie et ne pensait pas être un intolérant, mais il était choqué par la débâcle des coutumes et l’impunité du crime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fd85999-e04c-4340-90a1-757655d644f0",
                        "source_entry_id": "cd5fa080-ee2b-3f8c-8684-53a57d8631fa",
                        "source_sense_id": "beab48fc-6252-3bd0-a475-88ccf03e65db",
                        "source_sense_description": "being a bigot",
                        "target_lang_word": "sectaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sectaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a49d5139-cb1e-3b5f-aaf3-38fa317b13e0",
                                        "entry_id": "b6a25a70-8573-3c6b-90f1-da6b99e99622",
                                        "glosses": [
                                            "Relatif aux sectes, au sectarisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9314dd82-72b9-4175-950c-387b3bd765b5",
                                                "sense_id": "a49d5139-cb1e-3b5f-aaf3-38fa317b13e0",
                                                "text": "Les définitions incomplètes ou fallacieuses, qui ont pour effet de masquer la spécificité de la dérive sectaire, semblent relever de trois fautes logiques."
                                            },
                                            {
                                                "example_id": "47dcd3f1-45d5-4aed-97d2-23e64d190d86",
                                                "sense_id": "a49d5139-cb1e-3b5f-aaf3-38fa317b13e0",
                                                "text": "Il s’agit en effet de supprimer le conflit interne en l’externalisant et en lui substituant une dépendance au groupe sectaire, et singulièrement à la figure du gourou."
                                            },
                                            {
                                                "example_id": "53350260-b83a-41d4-b6e4-c6dbd06c0f1d",
                                                "sense_id": "a49d5139-cb1e-3b5f-aaf3-38fa317b13e0",
                                                "text": "Rappelez-vous la pétition que Mme Maltais a fait circuler il y a trois ans.\n Elle disait qu’il était inadmissible que, sous le couvert de la liberté de religion, des gestes illégaux puissent être posés par des groupes à dérives sectaires sans être sanctionnés.\n Et que la société québécoise ne pouvait tolérer que des enfants n’aient pas droit à l’éducation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sectaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a49ddc6-be90-3fda-8003-1774a5f17dd2",
                                        "entry_id": "30354807-3cc5-3c6d-b13c-a547cad89d33",
                                        "glosses": [
                                            "Sectateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e635f9f-25b6-4ab1-ba90-07b4181ca479",
                                                "sense_id": "7a49ddc6-be90-3fda-8003-1774a5f17dd2",
                                                "text": "On a souvent fait remarquer que des sectaires anglais ou américains, dont l'exaltation religieuse était entretenue par les mythes apocalyptiques, n'en étaient pas moins souvent des hommes très pratiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9893bda4-092c-3635-a89f-e3bc03c08cea",
                                        "entry_id": "30354807-3cc5-3c6d-b13c-a547cad89d33",
                                        "glosses": [
                                            "Celui qui professe des opinions étroites, intolérantes et violentes."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe73253-0ced-49a4-b00a-b9cffe6f1582",
                                                "sense_id": "9893bda4-092c-3635-a89f-e3bc03c08cea",
                                                "text": "Turgot, l’un des chefs les plus distingués de ce parti, joignait à de vastes connaissances la roideur d’esprit d’un sectaire."
                                            },
                                            {
                                                "example_id": "49ccc81e-963e-43c6-8918-85ddedc0d489",
                                                "sense_id": "9893bda4-092c-3635-a89f-e3bc03c08cea",
                                                "text": "Rapidement, il évoqua tous les supplices inventés par la rage des sectaires, s’efforçant d’évaluer, au petit bonheur, le degré de force qu’il lui faudrait pour les supporter avec constance…"
                                            },
                                            {
                                                "example_id": "265364fd-83f5-4437-bdd9-d75577bfa968",
                                                "sense_id": "9893bda4-092c-3635-a89f-e3bc03c08cea",
                                                "text": "En voilà un grand enfant, un rêveur chimérique, dans la peau du plus terrible des sectaires !"
                                            },
                                            {
                                                "example_id": "a2b486a7-ad53-40ec-a2e0-4fde48e3aebd",
                                                "sense_id": "9893bda4-092c-3635-a89f-e3bc03c08cea",
                                                "text": "Ce sectaire, ainsi que l’en accusaient les socialistes du dehors, avait du sang de dictateur dans les veines."
                                            },
                                            {
                                                "example_id": "7ab07c9f-f001-451f-94b5-3defad08d1e1",
                                                "sense_id": "9893bda4-092c-3635-a89f-e3bc03c08cea",
                                                "text": "Oscar Wilde n'inspire plus de colère, même aux sectaires de la vertu. Tous n'ont plus, pour lui et pour son martyre, que de la pitié douloureuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97a57792-17e6-492d-8055-926513cef5f0",
                        "source_entry_id": "cd5fa080-ee2b-3f8c-8684-53a57d8631fa",
