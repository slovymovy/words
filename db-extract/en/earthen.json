                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5cf155a-ec81-4e6c-bc41-028d6ae07400",
                                                "sense_id": "963b56d1-78af-3713-8102-ff59a941d0d6",
                                                "text": "Volgens mij aardt ze naar haar moeder."
                                            },
                                            {
                                                "example_id": "acc7260e-f4a3-40ab-80bd-c8105e3228f9",
                                                "sense_id": "963b56d1-78af-3713-8102-ff59a941d0d6",
                                                "text": "Het was een pienter kereltje, vriendelijk in zijn optreden; hij aardde beslist niet naar een van zijn ouders."
