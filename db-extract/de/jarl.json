                "senses": [
                    {
                        "sense_id": "bb2cf2d9-e28d-39cb-9ab9-adc00d85147e",
                        "entry_id": "c7711408-c80b-3609-908b-13d5547bb603",
                        "glosses": [
                            "Adelstitel, dem Grafen entsprechend"
                        ],
                        "tags": [
                            "Wikinger"
                        ],
                        "examples": [
                            {
                                "example_id": "790043ec-ab43-4c82-953b-7bf2cd3f2a4e",
                                "sense_id": "bb2cf2d9-e28d-39cb-9ab9-adc00d85147e",
                                "text": "Der Jarl ist mit dem deutschen Grafen vergleichbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c68fa9ad-719c-34de-8db8-bd6983524498",
                        "entry_id": "c7711408-c80b-3609-908b-13d5547bb603",
                        "glosses": [
                            "Adeliger mit dem Titel eines Jarls"
                        ],
                        "tags": [
                            "Wikinger"
                        ],
                        "examples": [
                            {
                                "example_id": "c47bce07-63a5-44b9-b700-fe02d65665bc",
                                "sense_id": "c68fa9ad-719c-34de-8db8-bd6983524498",
                                "text": "„Doch die Jarle wussten, dass die Macht der norwegischen Kriegsflotte groß war, und sie hingen an ihrem Leben. Da warfen die Goden ihnen Feigheit vor, sodass offener Streit ausbrach und die Jarle und Großbauern den Odinspriestern gar mit dem Tode drohten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50872815-3578-456e-8721-5a09716ccded",
                        "source_entry_id": "c7711408-c80b-3609-908b-13d5547bb603",
                        "source_sense_id": "bb2cf2d9-e28d-39cb-9ab9-adc00d85147e",
                        "source_sense_description": "Wikinger: Adelstitel, dem Grafen entsprechend",
                        "target_lang_word": "jarl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jarl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74b997d9-b3a5-3d25-9f03-4d5c5c248f64",
                                        "entry_id": "ccaa8edc-a824-354c-b298-d8d0266e8e9b",
                                        "glosses": [
                                            "A medieval Scandinavian nobleman, especially in Norway and Denmark."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529edc14-263b-4fb0-a59c-43a6911f714e",
                                                "sense_id": "74b997d9-b3a5-3d25-9f03-4d5c5c248f64",
                                                "text": "There were three kinds of Viking: thralls, karls and jarls. Thralls were the slaves. They were owned by karls and jarls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c49240a3-1a5d-484b-bd83-51a50e51a074",
                        "source_entry_id": "c7711408-c80b-3609-908b-13d5547bb603",
                        "source_sense_id": "bb2cf2d9-e28d-39cb-9ab9-adc00d85147e",
                        "source_sense_description": "Wikinger: Adelstitel, dem Grafen entsprechend",
                        "target_lang_word": "jarl",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jarl",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f7fbb5d-9fe0-3b74-98fb-9e38df5a520c",
                                        "entry_id": "db5024af-c9d4-38c7-b160-6b051311bd5e",
                                        "glosses": [
                                            "Titre de noblesse scandinave, équivalant au comte français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778c8598-a586-44be-9421-33faaaadf75e",
                                                "sense_id": "0f7fbb5d-9fe0-3b74-98fb-9e38df5a520c",
                                                "text": "À l’origine, ce titre désignait tout homme libre ; plus tard, il s’appliquait à la classe des grands seigneurs et des guerriers de haute naissance. Lorsqu’un roi était parvenu à réunir en une seule monarchie plusieurs petits États, il plaçait à la tête de ceux-ci des jarls (espèce de gouverneurs ou vice-rois) qui, de ce fait, lui devaient un tribut et du secours en cas de guerre. Parfois ce terme servait aussi à désigner des chefs indépendants. Le Heimskringla donne le nom de jarls aux ducs de Normandie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
