                "senses": [
                    {
                        "sense_id": "60c86ff4-79bf-3a9d-ae77-666750cfab3d",
                        "entry_id": "9019683e-db1f-3330-9114-5a360f976894",
                        "glosses": [
                            "龍飼料"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e0c31e9-8d4b-4cc5-aa2d-3d2087e0ad35",
                                "sense_id": "60c86ff4-79bf-3a9d-ae77-666750cfab3d",
                                "text": "Das nächstemal that der Mann ein bischen Rattengift in das Drachenfutter.",
                                "translation": "下次，那人在龍飼料裡放了放了一點老鼠藥。"
                            }
                        ]
                    },
                    {
                        "sense_id": "5d8618b3-8561-3c51-9ad3-da920963a3f7",
                        "entry_id": "9019683e-db1f-3330-9114-5a360f976894",
                        "glosses": [
                            "為了平息某人（尤其是伴侶）的怒火而贈送的禮物"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74fa40a1-d4ca-4e71-b245-0ed6be7fd033",
                                "sense_id": "5d8618b3-8561-3c51-9ad3-da920963a3f7",
                                "text": "Da er den Hochzeitstag völlig verschwitzt hat, musste er heute Morgen erst mal ordentlich Drachenfutter besorgen.",
                                "translation": "因為他完全忘記了結婚紀念日，所以今天早上他得先去買些像樣的賠罪禮物。"
                            },
                            {
                                "example_id": "b1342e75-619b-4477-a070-7557d848d22c",
                                "sense_id": "5d8618b3-8561-3c51-9ad3-da920963a3f7",
                                "text": "Nach dem feuchtfröhlichen Männerabend wäre es grob fahrlässig, ohne Drachenfutter aufzukreuzen – sonst hängt der Haussegen garantiert schief.",
                                "translation": "在那場酒酣耳熱的兄弟聚會後，如果沒帶點賠罪禮物就出現，簡直是嚴重疏忽——否則家裡肯定會雞犬不寧。"
                            },
                            {
                                "example_id": "6e995e4a-387e-48f1-a3ed-55655ecd0eeb",
                                "sense_id": "5d8618b3-8561-3c51-9ad3-da920963a3f7",
                                "text": "Warum er den mächtigen Schwiegerdrachen aus München, der keinen Hehl aus seiner Abneigung machte, nicht beiseitegefegt oder mit Drachenfutter (Pralinen oder Blumen) besänftigt hat?",
                                "translation": "他為什麼不把那位來自慕尼黑、毫不掩飾對他的厭惡的強勢「惡龍岳母」給打發走，或是乾脆用「龍飼料」（巧克力或鮮花）來安撫她呢？"
                            }
                        ]
                    }
                ],
