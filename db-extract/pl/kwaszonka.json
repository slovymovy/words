                                        "glosses": [
                                            "A small or indefinite quantity or amount (of something); a little, a bit, a few. Usually in partitive construction, frequently without \\\"of\\\"; a single grain or kernel of wheat, barley, oats, sand or dust."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1492cc36-240b-42b7-b2c2-601acceeaf74",
                                                "sense_id": "d1e07294-08d8-3cbf-927e-a47e951517be",
                                                "text": "[…] ill things are like guid—they baith come bit by bit, a pickle at a time […]"
                                            },
                                            {
                                                "example_id": "76d809cf-57f2-48e6-ae5b-b1788892c373",
                                                "sense_id": "d1e07294-08d8-3cbf-927e-a47e951517be",
                                                "text": "I mind him well, and the burn we fished and the pickle things we took out, and your mother that played with us in her cutty sark, and not a shoe between us nor a bodle of money; but the green hills round us, and all we knew of the world that it lay beyond them."
                                            }
                                        ]
