                    {
                        "sense_id": "a1eda935-9ecf-3c70-80fd-2953d29dcbff",
                        "entry_id": "19c3bb24-ebeb-3d69-ba36-5321e4cc6ee2",
                        "glosses": [
                            "отдельный клуб дыма или выхлоп пара, резкий выброс горячего воздуха, также отрывистый, короткий звук, издаваемый при натужном дыхании, выпускании газа, пара из паровой машины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fc825df-09bf-442c-9513-17218b1615e0",
                                "sense_id": "a1eda935-9ecf-3c70-80fd-2953d29dcbff",
                                "text": "Паровоз пых, пых и пошёл."
                            },
                            {
                                "example_id": "1fab2bd8-412c-40d8-a1b0-372844167874",
                                "sense_id": "a1eda935-9ecf-3c70-80fd-2953d29dcbff",
                                "text": "Жена в гневе, а он сигарой пых да пых."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9906c02-b415-34a5-b2b9-478c746026d7",
                        "entry_id": "19c3bb24-ebeb-3d69-ba36-5321e4cc6ee2",
                        "glosses": [
                            "прост. вздох, вдох"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd4ff06-3c8c-49af-a330-9d59e7378a1b",
                                "sense_id": "d9906c02-b415-34a5-b2b9-478c746026d7",
                                "text": "Упал — и ни вздоху, ни пыху."
                            }
                        ]
