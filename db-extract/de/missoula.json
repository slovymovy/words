                "senses": [
                    {
                        "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                        "entry_id": "a40490d1-4412-3aaf-af28-7f530bb1eecd",
                        "glosses": [
                            "Stadt im US-Bundesstaat Montana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ee505a-1390-4b83-8121-676540c5d576",
                                "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                                "text": "„Auf dem Display stand eine Nummer aus Missoula, Montana.“"
                            },
                            {
                                "example_id": "d99e2573-162f-4c3b-ace5-63388e58f0be",
                                "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                                "text": "„In der Nähe von Missoula, Montana, nahmen wir ein Drittel von einem Craftsman Manor, das auf der Interstate 90 nach Westen transportiert wurde.“"
                            },
                            {
                                "example_id": "320525cc-91a3-44af-8a6b-9d651049977e",
                                "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                                "text": "„Das passierte Kris Welles, einer jungen Frau, die für Conlans Furniture Company in Missoula, Montana, arbeitete.“"
                            },
                            {
                                "example_id": "6bac7359-77ca-476d-95bd-23f6494b806d",
                                "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                                "text": "„Diese Emily sagt: ›Deine Nummer hier auf meinem Display hat die Vorwahl von Missoula, Montana ...‹“"
                            },
                            {
                                "example_id": "2de2af9c-32b8-43b7-8ffa-ed2488dc658f",
                                "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                                "text": "„Hätte ich das Transkript gemacht, wäre ich bei jedem Halt aus dem Zug gestiegen. Hätte mich in Städten wie Reno, Cincinnati oder Missoula ein bisschen umgesehen.“"
                            },
                            {
                                "example_id": "a6f7258b-b6c3-4d00-8611-aa426c9b803d",
                                "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                                "text": "„Bei einem ihrer letzten Auftritte in Missoula, Montana, tritt ein Mädchen aus der Menge vor und beschimpft sie als widerliche Heuchler.“"
                            },
                            {
                                "example_id": "a89bc49a-6adb-481e-91d8-f91debc831ee",
                                "sense_id": "a79c4d84-8072-3b91-9edd-cd8b2f2a3417",
                                "text": "„Cassie Wright wurde in Missoula, Montana, geboren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
