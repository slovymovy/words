                "senses": [
                    {
                        "sense_id": "6b959ce2-d507-3f4d-bb5d-ba7dabfffd13",
                        "entry_id": "80e511c2-4a58-3970-9001-6d6958b5b956",
                        "glosses": [
                            "przywrócenie czemuś świeżego, nowego wyglądu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bad31e9-a430-4862-9654-e9a7d023c3f8",
                                "sense_id": "6b959ce2-d507-3f4d-bb5d-ba7dabfffd13",
                                "text": "Zakład Karny z Raciborza bierze udział w programie ekologicznej fundacji Silesia z Katowic. — Pozyskaliśmy 1500 zł na sadzonki. Pieniędzy starczy na wstępny etap odnowy przywięziennego parku – informuje Aleksandra Szlachetko z Działu Kwatermistrzowskiego placówki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "253d2a16-6252-32ee-9f62-e841973bf1d4",
                        "entry_id": "80e511c2-4a58-3970-9001-6d6958b5b956",
                        "glosses": [
                            "szereg zmian ulepszających stan czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e065bc9c-3da5-4028-bfcf-521d90457962",
                                "sense_id": "253d2a16-6252-32ee-9f62-e841973bf1d4",
                                "text": "Rok 2008 jest nie tylko numerologiczną jedynką, która oznacza nowe początki, czy Rokiem Szczura, symbolizującym w chińskim horoskopie odnowę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f78bd8e3-bc8c-358d-b448-ca0ea8c348ff",
                        "entry_id": "80e511c2-4a58-3970-9001-6d6958b5b956",
                        "glosses": [
                            "odtwarzanie uszkodzonych części, komórek przez organizm"
                        ],
                        "tags": [],
                        "examples": [],
