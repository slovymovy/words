                        "cross_references": [
                            {
                                "target_word": "harpy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa2f6d0f-b56f-396f-bb02-a0652c2c8dab",
                                        "entry_id": "9379bfc8-0bb9-33b7-baf7-9c6c72f79910",
                                        "glosses": [
                                            "A mythological creature generally depicted as a bird-of-prey with the head of a maiden, a face pale with hunger and long claws on her hands personifying the destructive power of storm winds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad3264a-1263-48a1-9203-c4ad1c5b916a",
                                                "sense_id": "fa2f6d0f-b56f-396f-bb02-a0652c2c8dab",
                                                "text": "Both table and provisions vanish'd quite,\nWith sound of harpies' wings and talons heard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86bd6eb-b6e8-317c-a09d-5b90eb03c347",
                                        "entry_id": "9379bfc8-0bb9-33b7-baf7-9c6c72f79910",
                                        "glosses": [
                                            "A shrewish woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f02009-7b15-4339-8e18-c8dfdfcee945",
                                                "sense_id": "b86bd6eb-b6e8-317c-a09d-5b90eb03c347",
                                                "text": "But her most subtle wiles proved ineffectual in ridding her, even for a moment, of her harpy jailer[…]"
                                            },
                                            {
                                                "example_id": "e7d93efc-bb5f-43ce-b49c-136616d42eb6",
                                                "sense_id": "b86bd6eb-b6e8-317c-a09d-5b90eb03c347",
                                                "text": "[…] Ed Miliband has yet to come up with a definition of “the squeezed middle” that excludes anyone, but you can bet your bottom dollar he has these laptop-wielding harpies in mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f815bb-e46c-39ad-bf47-cafeae5d18c4",
                                        "entry_id": "9379bfc8-0bb9-33b7-baf7-9c6c72f79910",
                                        "glosses": [
                                            "One who is rapacious or ravenous; an extortioner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e764ba0-c9e5-45e6-852f-0b494ee5b9bc",
                                                "sense_id": "08f815bb-e46c-39ad-bf47-cafeae5d18c4",
                                                "text": "c. 1772, Oliver Goldsmith, letter to Mrs. Bunbury\nThe harpies about me all pocket the pool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc10807-d52e-3e31-81c1-1023a1d72652",
                                        "entry_id": "9379bfc8-0bb9-33b7-baf7-9c6c72f79910",
                                        "glosses": [
                                            "Any of a number of eagle-like birds of prey of the subfamily Harpiinae, especially the species Harpia harpyja."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f90b860-15ae-3cdc-90dc-bb01d3df3f4b",
                                        "entry_id": "9379bfc8-0bb9-33b7-baf7-9c6c72f79910",
                                        "glosses": [
                                            "The European moor buzzard or marsh harrier (Circus aeruginosus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
