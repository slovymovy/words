                        "glosses": [
                            "Synonyme de hoquet (sens 2)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf742e0c-3f1c-41db-bed7-6ab43759c7fe",
                                "sense_id": "ba1ec67d-6038-35a9-94f8-082824a21d35",
                                "text": "Un des scouts embauchés avait le souglou (wallon souglout ‘hoquet’) ; il fut, bien entendu, soupçonné d’avoir mangé des cerises."
                            },
                            {
                                "example_id": "b6c03368-0900-47d7-8abc-d6ac456c96d2",
                                "sense_id": "ba1ec67d-6038-35a9-94f8-082824a21d35",
                                "text": "De façon déconcertante, elle l’entoura, secouée d’un souglou soudain, de ses bras, le berça, le bouleversa, et pleurnicha qu’elle l’aimait et que jamais, au grand jamais, elle n’entrouvrirait, jusqu’à ce qu’il revînt pour sa conquête a un quelconque coquelet sa coquillette."
                            }
                        ]
                    }
