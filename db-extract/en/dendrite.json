    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                "word": "dendrite",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b46e2d5e-1994-42ab-8cd2-948dcfbeaa37",
                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "dendrites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3529d6b-dc78-399f-a4e2-6f2e5f87aaaf",
                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                        "glosses": [
                            "A slender projection of a nerve cell which conducts nerve impulses from a synapse to the body of the cell; a dendron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f930da93-00ad-4e94-9671-08e1b977997b",
                                "sense_id": "d3529d6b-dc78-399f-a4e2-6f2e5f87aaaf",
                                "text": "Little copses of television antennas. Whiplike, graceful thrilling metal dendrites drawing images from the air, bringing brotherhood, communion to immured apartment people."
                            },
                            {
                                "example_id": "7ec43a37-865f-46a6-ad27-8fc78d7e9a2e",
                                "sense_id": "d3529d6b-dc78-399f-a4e2-6f2e5f87aaaf",
                                "text": "A typical brain neuron has perhaps a thousand little wires, called dendrites, which connect it with its fellows."
                            }
                        ]
                    },
                    {
                        "sense_id": "b066dc1d-4e9c-3b03-9f94-26a98ea19b4c",
                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                        "glosses": [
                            "Slender cell process emanating from the cell bodies of dendritic cells and follicular dendritic cells of the immune system."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d8071f71-4fb4-3711-84f4-0c93c4fe6450",
                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                        "glosses": [
                            "Tree-like structure of crystals growing as material crystallizes"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2e377487-b892-3fdb-b51f-4bdbf39c22b5",
                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                        "glosses": [
                            "A hermit who lived in a tree."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6097c697-4038-43c2-bcb6-5a52e316b9b8",
                        "source_entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                        "source_sense_description": "projection of a nerve cell",
                        "target_lang_word": "dendriet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dendriet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "43458199-b242-3298-968d-152956bb2dac",
                                        "entry_id": "422e4152-824c-32e3-8758-8e26dc445d54",
                                        "glosses": [
                                            "uitloper van (het cellichaam van) een zenuwcel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339309bd-992f-4863-a75a-8842a6f95022",
                                                "sense_id": "43458199-b242-3298-968d-152956bb2dac",
                                                "text": "Als de neurotransmitters een dendriet van de volgende cel bereikt hebben, binden ze aan receptoren die zich op de dendriet bevinden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0041204-75a6-3755-8d14-5f8075cae89f",
                                        "entry_id": "422e4152-824c-32e3-8758-8e26dc445d54",
                                        "glosses": [
                                            "vertakkingen op een ijskristal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0f7bce-2e88-42e2-bd37-9ca2e88ce030",
                                                "sense_id": "e0041204-75a6-3755-8d14-5f8075cae89f",
                                                "text": "Langs barsten drongen oplossingen van zwarte mangaanoxides of bruine ijzeroxides in de steen en vormden daar dendrieten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "830470f5-0a09-4efc-941c-6a7fd22ba849",
                        "source_entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
