                        "examples": [
                            {
                                "example_id": "c33f7cee-36ad-4bf1-b81e-605acf573185",
                                "sense_id": "9ff621df-06df-3c01-bb77-f857826fa75f",
                                "text": "„An dem Tag, an dem mein Lieblingsautor, Saul Bellow, starb, reiste ich ins Ausland.“"
                            },
