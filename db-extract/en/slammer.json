                                "sense_id": "155fb5c6-4650-3ede-a196-fdf64284c82b",
                                "text": "Margaret was also, by her own admission, a determined slammer of doors."
                            }
                        ]
                    },
                    {
                        "sense_id": "d741fa50-a7ea-3290-9243-a8925887e0c5",
                        "entry_id": "e1e0f3d6-a9de-3d9c-bd6e-e0bceba26421",
                        "glosses": [
                            "Jail, prison."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ab8bbec7-c284-4fdc-b934-ed2232018632",
                                "sense_id": "d741fa50-a7ea-3290-9243-a8925887e0c5",
                                "text": "A man being sentenced for starving some horses chose 24 hours in the slammer with no food rather than seven days with the regular amenities."
                            }
                        ]
                    },
                    {
                        "sense_id": "a831d0f7-033a-3c0e-9eff-948dd6abd234",
                        "entry_id": "e1e0f3d6-a9de-3d9c-bd6e-e0bceba26421",
                        "glosses": [
                            "A tequila cocktail that is slammed onto a surface to induce fizzing."
