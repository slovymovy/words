{
    "word_family": [
        "ignorance",
        "ignorant",
        "ignorable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fbe3418-d861-3df6-a624-a83f766cb3c8",
                    "sense_definition": "To intentionally refuse to listen to or pay attention to someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lack_of_attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>ignore</w> the noise and focus on your work.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>игнорировать</w> шум и сосредоточиться на работе.",
                                "zh": "你应该<w>忽视</w>噪音，专注于你的工作。"
                            }
                        },
                        {
                            "text": "He decided to <w>ignore</w> the warning and proceed with the plan anyway.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>проигнорировать</w> предупреждение и всё равно действовать по плану.",
                                "zh": "他决定<w>不理会</w>警告，坚持按计划行事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disregard",
                        "discount",
                        "pay no heed",
                        "take no notice of",
                        "tune out",
                        "overlook"
                    ],
                    "antonyms": [
                        "pay attention",
                        "watch"
                    ],
                    "common_phrases": [
                        "ignore the rules",
                        "ignore the warning",
                        "ignore advice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умышленно отказываться слушать или обращать внимание на кого-либо или что-либо.",
                        "zh": "故意拒绝听取或关注某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "умышленно не замечать"
                            },
                            {
                                "target_lang_word": "не обращать внимания",
                                "target_lang_sense_clarification": "пропускать мимо ушей/глаз"
                            },
                            {
                                "target_lang_word": "проигнорировать",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忽视",
                                "target_lang_sense_clarification": "故意不予理会"
                            },
                            {
                                "target_lang_word": "不理会",
                                "target_lang_sense_clarification": "拒绝给予关注"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79378d8-eb77-3552-9dee-7f677d130e3d",
                    "sense_definition": "To pretend not to see or recognize someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lack_of_attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I waved at him across the street, but he seemed to <w>ignore</w> me.",
                            "target_lang_translations": {
                                "ru": "Я помахал ему через улицу, но он, казалось, <w>игнорировал</w> меня.",
                                "zh": "我在街对面朝他挥手，但他似乎<w>不理睬</w>我。"
                            }
                        },
                        {
                            "text": "It is rude to <w>ignore</w> a guest completely at a party.",
                            "target_lang_translations": {
                                "ru": "Невежливо полностью <w>игнорировать</w> гостя на вечеринке.",
                                "zh": "在聚会上完全<w>不理睬</w>客人是很没礼貌的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "turn a blind eye to",
                        "brush off",
                        "snub",
                        "cold-shoulder"
                    ],
                    "antonyms": [
                        "recognize",
                        "notice"
                    ],
                    "common_phrases": [
                        "ignore completely",
                        "try to ignore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Притворяться, что не видишь или не узнаешь кого-либо.",
                        "zh": "假装没看见或不认识某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "демонстративно не замечать"
                            },
                            {
                                "target_lang_word": "не замечать",
                                "target_lang_sense_clarification": "делать вид, что не видишь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不理睬",
                                "target_lang_sense_clarification": "故意表现出冷淡"
                            },
                            {
                                "target_lang_word": "装作没看见",
                                "target_lang_sense_clarification": "假装未察觉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1cbd7b8-95a6-30af-ba8d-c7d50ad770a5",
                    "sense_definition": "To fail to notice or consider something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lack_of_attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot <w>ignore</w> the fact that the costs are rising.",
                            "target_lang_translations": {
                                "ru": "Мы не можем <w>игнорировать</w> тот факт, что расходы растут.",
                                "zh": "我们不能<w>忽略</w>成本正在上升这一事实。"
                            }
                        },
                        {
                            "text": "If you <w>ignore</w> the small details, the project might fail.",
                            "target_lang_translations": {
                                "ru": "Если вы будете <w>пренебрегать</w> мелкими деталями, проект может провалиться.",
                                "zh": "如果你<w>忽略</w>了小细节，项目可能会失败。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overlook",
                        "miss",
                        "neglect"
                    ],
                    "antonyms": [
                        "notice",
                        "observe",
                        "examine"
                    ],
                    "common_phrases": [
                        "ignore the fact",
                        "ignore details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не замечать, упускать из виду или не учитывать что-либо важное.",
                        "zh": "未能注意到或考虑到某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пренебрегать",
                                "target_lang_sense_clarification": "относиться без должного внимания"
                            },
                            {
                                "target_lang_word": "не принимать во внимание",
                                "target_lang_sense_clarification": "не учитывать"
                            },
                            {
                                "target_lang_word": "упускать из виду",
                                "target_lang_sense_clarification": "случайно не заметить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忽略",
                                "target_lang_sense_clarification": "因疏忽而未注意到"
                            },
                            {
                                "target_lang_word": "不予考虑",
                                "target_lang_sense_clarification": "在决策中排除"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ef0fc79-aa70-320a-bfd0-1fe7dfa53fc0",
                    "sense_definition": "To not know or be unaware of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lack_of_knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury <w>ignored</w> the evidence that was not presented in court.",
                            "target_lang_translations": {
                                "ru": "Присяжные <w>не знали</w> об уликах, которые не были представлены в суде.",
                                "zh": "陪审团对未在法庭上提交的证据<w>不知晓</w>。"
                            }
                        },
                        {
                            "text": "He <w>ignored</w> the true nature of the problem until it was revealed to him.",
                            "target_lang_translations": {
                                "ru": "Он <w>не знал</w> истинной сути проблемы, пока она не была ему открыта.",
                                "zh": "在真相大白之前，他一直<w>不知晓</w>问题的本质。"
                            }
                        }
                    ],
                    "synonyms": [
                        "be ignorant of"
                    ],
                    "antonyms": [
                        "know"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely obsolete in modern English, where 'ignore' implies intent."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не знать или не подозревать о чем-либо (устаревшее значение).",
                        "zh": "不知道或未意识到某事（古语用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не знать",
                                "target_lang_sense_clarification": "быть в неведении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不知晓",
                                "target_lang_sense_clarification": "处于无知状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}