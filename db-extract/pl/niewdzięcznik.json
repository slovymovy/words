                "senses": [
                    {
                        "sense_id": "7eee6df8-b3a4-324b-b60b-524fc30ebffe",
                        "entry_id": "ab3e28a0-b38e-319c-badb-4e43ad29bb3c",
                        "glosses": [
                            "osoba niewdzięczna, niepoczuwająca się do wdzięczności"
                        ],
                        "tags": [],
