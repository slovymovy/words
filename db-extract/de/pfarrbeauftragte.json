                "senses": [
                    {
                        "sense_id": "b9d069e3-e4d7-365e-928d-6220bc368bf6",
                        "entry_id": "f7d04549-fde2-3198-bc4a-08e668d5f64e",
                        "glosses": [
                            "Laiin, der die Leitung einer römisch-katholischen Pfarrei (zusammen mit einem für mehrere Pfarreien zuständigen Pfarrmoderator) anvertraut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a9f112-eaa0-4331-9ac1-2a5cc35b6e67",
                                "sense_id": "b9d069e3-e4d7-365e-928d-6220bc368bf6",
                                "text": "„Der c. 517 § 2 CIC hebt also darauf ab, dass im Zusammenwirken zwischen der bzw. dem oder den Pfarrbeauftragten und dem Pfarrmoderator nicht nur einzelne, genau bestimmte Seelsorgsaufgaben verwirklicht werden, sondern vielmehr die als umfassende Seelsorge zu bestimmende Hirtensorge in der vakanten Pfarrei nach Möglichkeit ausgeübt wird.“"
                            },
                            {
                                "example_id": "5cd3ea7d-a23f-4959-98f8-fc1e69048cce",
                                "sense_id": "b9d069e3-e4d7-365e-928d-6220bc368bf6",
                                "text": "„Die rund 250 Mitglieder starke Gemeinde wird vor Ort von der Pastoralreferentin und Pfarrbeauftragten Susanne Wübker geleitet, die Unterstützung von wechselnden katholischen Kurpastoren bekommt.“"
                            },
                            {
                                "example_id": "19aaa2ca-d24d-443a-b379-ff668230880d",
                                "sense_id": "b9d069e3-e4d7-365e-928d-6220bc368bf6",
                                "text": "„In einzelnen Diözesen in Deutschland – vor allem in Limburg und Speyer – sind Frauen als Pfarrbeauftragte tätig.“"
                            },
                            {
                                "example_id": "9125ce7b-9543-44f6-ac6d-ba476e40f5d7",
                                "sense_id": "b9d069e3-e4d7-365e-928d-6220bc368bf6",
                                "text": "„Ich bin seit Dezember 2019 im Bistum Osnabrück Pfarrbeauftragte in der Pfarreiengemeinschaft St.Clemens und St. Jakobus in Bad Iburg und Glane.“"
                            },
                            {
                                "example_id": "3feec789-950d-4eed-83e9-a4d90e0b5e74",
                                "sense_id": "b9d069e3-e4d7-365e-928d-6220bc368bf6",
                                "text": "„Also, ich hab nicht einmal erlebt, dass es jemanden in der Personalabteilung interessiert hätte, wie es, also gar nicht wie es mir als Pfarrbeauftragte geht, das wäre mir noch wichtiger gewesen, das zu fragen.“"
                            },
                            {
                                "example_id": "6f162fd1-e195-4b1f-8bd6-315cab494e08",
                                "sense_id": "b9d069e3-e4d7-365e-928d-6220bc368bf6",
                                "text": "„Gerade hat das Bistum Osnabrück auf den Nordseeinseln Juist und Langeoog zwei Frauen als Pfarrbeauftragte berufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
