                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "887cd405-f2d7-39e1-9c12-05053f016113",
                        "entry_id": "f30c1168-91ff-3d26-9780-904bded75b63",
                        "glosses": [
                            "A city in Poland, also called Oświęcim."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a5172899-ffa1-3387-91e6-5394c5a42d66",
                        "entry_id": "f30c1168-91ff-3d26-9780-904bded75b63",
                        "glosses": [
                            "A former concentration camp in what is now Poland; used metonymically for Nazi evil, the Holocaust."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c95b8b92-57af-46de-9a57-44ff22329229",
                                "sense_id": "a5172899-ffa1-3387-91e6-5394c5a42d66",
                                "text": "Portnoy said in posts on social media that in an initial conversation Sunday the customer took 100% responsibility for his actions with his friend and agreed to take a learning trip to Auschwitz in Poland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9a8c17b-9c2f-4095-8d38-d0fdce4f9337",
                        "source_entry_id": "f30c1168-91ff-3d26-9780-904bded75b63",
                        "source_sense_description": "city in Poland",
                        "target_lang_word": "Osvětim",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Osvětim",
