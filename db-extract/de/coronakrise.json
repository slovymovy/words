                        ],
                        "form": "die Coronakrisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                        "entry_id": "acef1b2e-dee5-3d0b-a435-450a31ad9cfd",
                        "glosses": [
                            "Gesamtheit der negativen Beeinträchtigungen (beispielsweise vorzeitige Todesfälle, Rezession, Firmenpleiten, Arbeitslosigkeit, Kita-/Schul-/Universitätsschließungen, Reisefreiheit, Ausgehverbote), die durch eine vom Coronavirus verursachte Pandemie entstehen"
                        ],
                        "tags": [
                            "Gesundheit",
                            "Bildung",
                            "Einschränkung persönlicher Freiheiten"
                        ],
                        "examples": [
                            {
                                "example_id": "1b32592a-21ed-4193-aa05-81815d9cb8cb",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Die Coronakrise setzt […] der Wirtschaft in der Europäischen Union massiv zu.“"
                            },
                            {
                                "example_id": "2a1767bc-d41e-4c72-bb50-00a4e7261ae4",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Die Coronakrise hat erste Auswirkungen auf die Stimmung im Handel und im Handwerk in Mecklenburg-Vorpommern.“"
                            },
                            {
                                "example_id": "4aefa928-6c58-4dbb-ad81-24ba62588441",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Die weltweite Coronakrise zeigt sich in den Städten rund um den Globus. Selbst auf dem Times Square gibt es keine Passanten und die sonst belebten Gassen in Brüssel bleiben leer.“"
                            },
                            {
                                "example_id": "3856dd77-6784-4f71-9631-5620a6d6afd3",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "Wegen der Coronakrise arbeiten Millionen Menschen im Homeoffice."
                            },
                            {
                                "example_id": "15743414-a778-4153-84fb-a75e9fee539c",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "Wegen der Coronakrise wird die Fußballeuropameisterschaft 2020 in 2021 verschoben."
                            },
                            {
                                "example_id": "14fce7d8-688a-47e4-b323-76dd95bbe503",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Viele alleinerziehende Eltern stehen wegen der Coronakrise vor großen Schwierigkeiten.“"
                            },
                            {
                                "example_id": "b6696b33-f2f8-430e-b476-fdad4279d693",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„[…] die Blumenfachgeschäfte der Schweiz […] müssen wegen der Coronakrise geschlossen bleiben.“"
                            },
                            {
                                "example_id": "a69f3db9-3763-4092-ad3f-7eb3a4927ee0",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Der Tourismusbeauftragte der Bundesregierung, Thomas Bareiß (CDU), sieht die Reise- und Tourismusbranche angesichts der Coronakrise in einer existenzbedrohenden Lage […]“"
                            },
                            {
                                "example_id": "3263b1b8-3afd-4cdf-9652-51c5ec51a051",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Mit einem Nothilfeprogramm in Höhe von 500 Millionen Euro will Schleswig-Holstein wirtschaftliche Folgen der Coronakrise abfedern.“"
                            },
                            {
                                "example_id": "545a9025-71f4-4137-bf44-c2a4dea56927",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Vier junge Italiener erzählen, welche positiven Dinge sie der Coronakrise in Italien abgewinnen können.“"
                            },
                            {
                                "example_id": "f7abb6af-c8b1-4ac6-9e23-526b79d9200e",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Trotz Coronakrise dürfen Restaurants einen Takeaway- oder Lieferservice betreiben.“"
                            },
                            {
                                "example_id": "59f01640-3435-4ad4-9da9-44c2c2c6cfd2",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "[Radsport:] „Die Fernfahrt, die als eines von wenigen Frühjahrsrennen trotz der Coronakrise ausgetragen wird, endet am Sonntag in Nizza.“"
                            },
                            {
                                "example_id": "d849675e-9405-499d-ac9b-b951df463bda",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Die Bundesregierung plant ungeachtet der Coronakrise für den Etat 2021 vorerst weiter ohne neue Schulden.“"
                            },
                            {
                                "example_id": "dcbdce41-8ca8-4c9a-bd59-1bbbccad7288",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Sie wollen in der Coronakrise nicht tatenlos zusehen? So können Sie helfen, ohne das Haus zu verlassen.“"
                            },
                            {
                                "example_id": "256ab50f-eb85-44d2-84da-f765dbe3f6ed",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„Die deutsche Wirtschaft soll in der Coronakrise verstärkt staatliche Unterstützung bekommen.“"
                            },
                            {
                                "example_id": "fb6e777c-818b-47a7-b9a6-f4e0cad39237",
                                "sense_id": "b6b8b4ae-19cf-31aa-a535-f6afd3c596d8",
                                "text": "„[…] wer schon Hartz IV bekommt, leidet unter der Coronakrise zusätzlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
