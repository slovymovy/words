                "senses": [
                    {
                        "sense_id": "84f9bf73-4503-360f-b958-fca414bad2d5",
                        "entry_id": "71a330b5-1cc6-397f-92eb-94c332ab2ac5",
                        "glosses": [
                            "Freiheit in der eigenen Verwaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026f7fac-2003-4a1d-be83-727b9d8a87ee",
                                "sense_id": "84f9bf73-4503-360f-b958-fca414bad2d5",
                                "text": "„Ältere Formen lokaler Selbstverwaltung wurden auf diese Weise ausgelöscht.“"
                            },
                            {
                                "example_id": "41255328-0a99-4147-9c2e-cd6a63424e37",
                                "sense_id": "84f9bf73-4503-360f-b958-fca414bad2d5",
                                "text": "„Sowohl Abed als auch Ghazl heirateten 1993, das Jahr, in dem Israel und die PLO die Osloer Verträge unterzeichneten, welche der Intifada ein Ende bereiteten und die Palästinensische Autonomiebehörde, die sulta, ins Leben riefen, die in den dicht besiedelten Ballungsräumen von Gaza und dem Westjordanland über eine begrenzte Selbstverwaltung verfügte.“"
                            },
                            {
                                "example_id": "fcf1a956-926e-46ec-afd7-0957b891a93b",
                                "sense_id": "84f9bf73-4503-360f-b958-fca414bad2d5",
                                "text": "„›Und Sie waren dort Referent für politische Aktionen draußen auf dem Land. Haben den Bauern was über Landwirtschaft, Medizin und Selbstverwaltung beigebracht - und vielleicht ein bisschen was über Meuchelmord nebenbei. Habe ich recht, Harding?‹“"
                            },
                            {
                                "example_id": "0dc91b64-86d6-4eb1-8598-93f53376bd3d",
                                "sense_id": "84f9bf73-4503-360f-b958-fca414bad2d5",
                                "text": "„Er dachte, die Indios würden sich selbst effizienter regieren als jeder Außenstehende; das Angebot der Selbstverwaltung war auch eine Geste des guten Willens, denn das war es, was die Indios wünschten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
