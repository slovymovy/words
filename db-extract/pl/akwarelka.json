                "translations": [
                    {
                        "translation_id": "dc424f7f-f7cb-48ef-baec-e066cfd56c69",
                        "source_entry_id": "cb9262a9-629b-368d-91ce-01ae3596133c",
                        "source_sense_id": "0258ce92-a31e-3fa6-ac00-73d4c42e06a6",
                        "source_sense_description": "meist im Plural, Kunst: Aquarellfarbe in geringer Menge",
                        "target_lang_word": "Aquarellfarbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquarellfarbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "880f0476-d083-39af-9343-b16555fc8d62",
                                        "entry_id": "252fcf03-1faf-34f3-9536-b5415db76fb0",
                                        "glosses": [
                                            "eine wasserlösliche Farbe (Wasserfarbe), die nicht deckend ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c07d63d2-9073-4349-bec7-0366fd669a47",
                                                "sense_id": "880f0476-d083-39af-9343-b16555fc8d62",
                                                "text": "„Dennoch wirken sie warm und freundlich, was nicht zuletzt daran liegt, dass Illustrator Karsten Teich zur Kolorierung Buntstift und Aquarellfarben verwendet hat“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63c88767-a6c8-4b7f-b234-232de7bd7f50",
                        "source_entry_id": "cb9262a9-629b-368d-91ce-01ae3596133c",
                        "source_sense_id": "52ae9a8e-511a-366c-ae94-df4201c19fe7",
                        "source_sense_description": "Kunst: kleines Aquarell, kleines Aquarellbild",
                        "target_lang_word": "Aquarell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquarell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                        "entry_id": "1e4677a9-bbb9-369a-8e32-66a0cc1f01c0",
                                        "glosses": [
                                            "ein mit wasserlöslichen, nicht deckenden Farben angefertigtes Bild"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323befe6-2189-4739-aba3-7fd6f31bbca4",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "Ich liebe besonders Aquarelle von Landschaften."
                                            },
                                            {
                                                "example_id": "fc90b79f-0fb5-41e4-a7a5-d5c46028276a",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "„Was bei der Mutter ein beinahe zartes Aquarell ergibt, wird beim Sohn zur monumentalen Klage über den Niedergang einer Industriestadt.“"
                                            },
                                            {
                                                "example_id": "70e394ad-5715-4490-9f14-a3bf9bf3c989",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "„Er nahm die beiden Zeichnungen von der Staffelei und holte aus dem Nebenraum zwei Aquarelle.“"
                                            },
                                            {
                                                "example_id": "43f57405-e909-44f9-b78d-eebd0a8caedb",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "„Bestimmt sieht nicht jeder die Qual, die ich in diesen verrückten Aquarellen dargestellt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c6cf6e-7db8-40c7-ad39-ec6fcdfec25d",
                        "source_entry_id": "cb9262a9-629b-368d-91ce-01ae3596133c",
                        "source_sense_id": "52ae9a8e-511a-366c-ae94-df4201c19fe7",
                        "source_sense_description": "Kunst: kleines Aquarell, kleines Aquarellbild",
                        "target_lang_word": "Aquarellbild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquarellbild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77f9f051-25d3-38ee-8f7f-44e32f5cb2bc",
                                        "entry_id": "19bb3f91-9e2c-34e6-ad7e-db1ada4ad6d8",
                                        "glosses": [
                                            "Bild, das in Aquarelltechnik gemalt wurde"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05efb07f-358d-4321-9855-95f0d977e278",
                                                "sense_id": "77f9f051-25d3-38ee-8f7f-44e32f5cb2bc",
                                                "text": "„Für seine großformatigen, technisch perfekten Aquarellbilder habe der Künstler viele Preise eingeheimst.“"
