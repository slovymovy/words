                                    {
                                        "sense_id": "a13d1eb0-2a4a-316b-ac06-abe68dda6166",
                                        "entry_id": "f7675ed7-299f-3b83-a35f-2ef1e02a5b8d",
                                        "glosses": [
                                            "Qui a rapport à la parodie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1f6e49-8a29-41e7-9872-86aa35df212e",
                                                "sense_id": "a13d1eb0-2a4a-316b-ac06-abe68dda6166",
                                                "text": "La plateforme avait également fait des remises spectaculaires sur le dogecoin, une cryptomonnaie à l'origine parodique mais gonflée depuis par l'intérêt - entre autres - du multimilliardaire et patron de Tesla et de X Elon Musk."
                                            },
                                            {
                                                "example_id": "a21162b4-5cfb-418d-81da-75758651ba20",
                                                "sense_id": "a13d1eb0-2a4a-316b-ac06-abe68dda6166",
                                                "text": "“Le Cœur a ses raisons” est un feuilleton télévisé parodique québécois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f8060e1-9dc1-4c42-9ca2-45e078c276c8",
                        "source_entry_id": "72e68a7e-c6fa-34a2-a11e-8744827e20af",
                        "source_sense_id": "2903a42c-6087-3bdd-aadf-ec4598b4d24b",
                        "source_sense_description": "of, related to, or having characteristics of parody",
                        "target_lang_word": "parodistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parodistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "feee9025-b7bf-3146-bc14-5de297051564",
                                        "entry_id": "05798284-fd7d-3490-b092-5ce7be55418b",
                                        "glosses": [
                                            "nach Art oder mit den Mitteln der Parodie: jemanden übertrieben nachahmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fda5bd6b-6113-44c4-b7c6-9eeb6911a83e",
                                                "sense_id": "feee9025-b7bf-3146-bc14-5de297051564",
                                                "text": "„Die Macher [der Fernsehsendung] 'Extra 3' nannten ihr Stück 'Erdowie, Erdowo, Erdogan' und kritisieren darin auf parodistische Weise unter anderem Erdoğans Umgang mit Journalisten in der Türkei, […]“"
                                            },
                                            {
                                                "example_id": "e667788f-8421-450e-abe4-9d96db099a4a",
                                                "sense_id": "feee9025-b7bf-3146-bc14-5de297051564",
                                                "text": "„Die Partei ['Die Partei'] macht auch parodistische Anleihen bei der alten DDR-Staatspartei SED, der Sozialistischen Einheitspartei Deutschlands, die wegen ihrer Allmacht oft einfach 'die Partei' genannt wurde und deren Hymne 'Die Partei, die Partei, die hat immer recht' jetzt auch in den Werbespots von 'Die Partei' auftaucht.“"
                                            },
                                            {
                                                "example_id": "e97b0f7f-2bfb-4755-8a40-5f9d222e66f2",
                                                "sense_id": "feee9025-b7bf-3146-bc14-5de297051564",
                                                "text": "„Cervantes lebte vermutlich von 1547 bis 1616. Er wurde mit seinem parodistischen Ritterroman 'Der sinnreiche Junker Don Quijote von La Mancha' zu einem der Väter des modernen Romans und gilt als einer der größten Autoren der Weltliteratur.“"
                                            },
                                            {
                                                "example_id": "4fe4f060-d65f-4aec-bf88-2efc7ff5768e",
                                                "sense_id": "feee9025-b7bf-3146-bc14-5de297051564",
                                                "text": "„'Vor allem komödiantische Stücke boten Gelegenheit für die parodistische Überzeichnung von Geschlechterrollen', erklärt die Theaterwissenschaftlerin Beate Hochholdinger-Reiterer […]“"
                                            },
                                            {
                                                "example_id": "6cf5c516-ebcd-4fd6-a985-f432570abfba",
                                                "sense_id": "feee9025-b7bf-3146-bc14-5de297051564",
                                                "text": "„[Der junge Heinrich, der Protagonist des Autors,] findet sich auf Galerie-Vernissagen wieder, die [der Autor] Hürlimann zum Anlass nimmt, ein parodistisch verzerrtes Sittenbild des linksliberalen Kunst-Jetsets zu skizzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
