                "senses": [
                    {
                        "sense_id": "8a413ace-01bc-36db-84eb-7ba1499eb063",
                        "entry_id": "bc4a7175-de8e-3efb-a416-d5281746a374",
                        "glosses": [
                            "Person, die sich nach der Philosophie der Steinzeiternährung (Paleo-Ernährung) ernährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aaeed21-dc54-4b8c-a00a-6cec73b860d9",
                                "sense_id": "8a413ace-01bc-36db-84eb-7ba1499eb063",
                                "text": "„Paleo zu 100 Prozent? Machen wir Ausnahmen? Nico Richter teilt die Paleoaner in verschiedene Typen ein:[…]“"
                            },
                            {
                                "example_id": "03d7c886-8245-4eab-9368-898d4708d89a",
                                "sense_id": "8a413ace-01bc-36db-84eb-7ba1499eb063",
                                "text": "„‚Wie kann man ohne Brot frühstücken?‘ ist wohl eine der am häufigsten gestellten Fragen von Nicht-Paleoanern an Paleoaner […].“"
                            },
                            {
                                "example_id": "8bfa45b9-5b38-407b-950d-4d7828b3b525",
                                "sense_id": "8a413ace-01bc-36db-84eb-7ba1499eb063",
                                "text": "„Die Paleoaner sind vom Erfolg ihrer Ernährungsform natürlich überzeugt.“"
                            },
                            {
                                "example_id": "854d0fb9-d034-43ff-a526-83b3bc0b0462",
                                "sense_id": "8a413ace-01bc-36db-84eb-7ba1499eb063",
                                "text": "„‚Für einen eigenen Blog habe ich leider kaum Zeit, aber auf meiner Facebookseite »Paleocoach Saar« versuche ich, Neueinsteigern und Paleoanern zu helfen‘, erklärt der Paleo-Trainer.“"
                            },
                            {
                                "example_id": "e3268cc5-d10a-4761-ae4f-ad650326d40d",
                                "sense_id": "8a413ace-01bc-36db-84eb-7ba1499eb063",
                                "text": "„Den Fleischkonsum sollten Paleoaner jedoch im Auge behalten, rät Gahl.“"
                            },
                            {
                                "example_id": "9214acf0-cd4b-4bd5-8f55-62b923ea0362",
                                "sense_id": "8a413ace-01bc-36db-84eb-7ba1499eb063",
                                "text": "Ich bin ein Paleoaner, da ich nur Lebensmittel konsumiere, die in der Altsteinzeit zur Verfügung standen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
