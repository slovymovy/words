                "translations": [
                    {
                        "translation_id": "2895f75b-8e51-44e9-9cb6-fe37855efcb4",
                        "source_entry_id": "1e07ee77-324b-3c3d-9eb6-7f689aa3ffdf",
                        "source_sense_id": "cf4b030f-97a7-3ebd-99d5-f1e81e05530e",
                        "source_sense_description": "historisch, antikes Griechenland: Agon",
                        "target_lang_word": "Agon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa8ce158-76f2-3f5f-bdd3-a1b2124803e5",
                                        "entry_id": "26fb0096-d2cf-3de4-b8f3-ad9e18e44e4f",
                                        "glosses": [
                                            "sportlicher oder geistiger/musischer Wettstreit im antiken Griechenland, besonders im Rahmen von Festspielen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a02c7f76-29d5-41ac-8da8-b82c68323904",
                                                "sense_id": "aa8ce158-76f2-3f5f-bdd3-a1b2124803e5",
                                                "text": "„Die berühmtesten Agone waren die Olympischen, Pythischen, Nemeischen und Isthmischen Spiele, die man zusammen als Panhellenische Spiele bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b3f7d21-708a-369c-8767-aa7985bf30dc",
                                        "entry_id": "26fb0096-d2cf-3de4-b8f3-ad9e18e44e4f",
                                        "glosses": [
                                            "fester Bestandteil der altgriechischen Komödie, ein Streitgespräch"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcc6665d-a324-40dc-b0e7-78ed5a1f0c35",
                                                "sense_id": "4b3f7d21-708a-369c-8767-aa7985bf30dc",
                                                "text": "„Hierauf folgt die ›Diskussionsrunde‹, der epirrhematische Agon, in dem sich der Protagonist entweder mit dem Chor oder mit einem anderen Schauspieler in einer oft heftigen Diskussion auseinandersetzt, um seinen Widersacher von der Richtigkeit und dem Sinn seines im Prolog geäußerten Vorhabens zu überzeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
