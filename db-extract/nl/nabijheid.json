                                            {
                                                "example_id": "e6f0c9e0-093d-4eff-b997-d262a6493e24",
                                                "sense_id": "498d965b-e5cc-3632-88a7-c22b8854c7ee",
                                                "text": "The proximity of the heat source allowed it to be detected by the sensor."
                                            },
                                            {
                                                "example_id": "032a8601-cdb1-4a12-853b-dc9669094564",
                                                "sense_id": "498d965b-e5cc-3632-88a7-c22b8854c7ee",
                                                "text": "You and I live in close proximity."
