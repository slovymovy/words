                        ],
                        "form": "die Mikroorganismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a04f0ba-bbc0-35d7-b462-173d02e66f70",
                        "entry_id": "f43e5427-34f8-378c-babd-129a652b0d73",
                        "glosses": [
                            "mikroskopisch kleiner Organismus, der nur mit dem Mikroskop sichtbar gemacht werden kann"
                        ],
                        "tags": [
                            "Lebewesen"
                        ],
                        "examples": [
                            {
                                "example_id": "29ecd4e6-acaf-48c6-9b7d-f1e14e97a409",
                                "sense_id": "8a04f0ba-bbc0-35d7-b462-173d02e66f70",
                                "text": "Die Mikrobiologie befasst sich mit Mikroorganismen."
                            },
                            {
                                "example_id": "708f9ccb-06c1-4528-8a1f-7dc0985692ee",
                                "sense_id": "8a04f0ba-bbc0-35d7-b462-173d02e66f70",
                                "text": "„Da die Mikroorganismen im Meeresboden bei der Zersetzung des toten organischen Materials, das aus der Wassersäule herunterrieselt, Sauerstoff verbrauchen, ist in Meeresgebieten mit guter Nährstoffversorgung der Sauerstoff bereits in den obersten Millimetern aufgebraucht.“"
                            },
                            {
                                "example_id": "70448659-dcf1-4113-be51-7c03ebfdc368",
                                "sense_id": "8a04f0ba-bbc0-35d7-b462-173d02e66f70",
                                "text": "„Neben Feuchtigkeit und Luftverschmutzung haben Mikroorganismen einen bedeutenden Anteil am Zerfall alter Wandgemälde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c999746f-0282-484d-90d8-14d1da2113bb",
                        "source_entry_id": "f43e5427-34f8-378c-babd-129a652b0d73",
                        "source_sense_id": "8a04f0ba-bbc0-35d7-b462-173d02e66f70",
                        "source_sense_description": "Lebewesen: mikroskopisch kleiner Organismus, der nur mit dem Mikroskop sichtbar gemacht werden kann",
                        "target_lang_word": "microorganism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microorganism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                        "entry_id": "a1bab713-18af-30f7-9a6f-e54f382cdfeb",
                                        "glosses": [
                                            "An organism that is too small to be seen by the unaided eye; especially, a single-celled organism, such as a bacterium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d075b3-5b00-44ce-9f67-ec9300201499",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "The cud is then reswallowed and further digested by specialized microorganisms that live in the rumen."
                                            },
                                            {
                                                "example_id": "8b9e8060-b94c-47cc-b626-a30e0aed0a76",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "Bacillus anthracis: from the first up to the sixth day, this microorganism was isolatable, or in other words still alive."
                                            },
                                            {
                                                "example_id": "b363dd4d-0cef-436f-a699-902bff3e63b8",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "The differences in biofilm penetration patterns of both tested photosensitisers and the light source could have played an important role for the survival of microorganisms after the application of aPDT. In a recent own study, we showed that the deepest layers of the oral biofilm were not affected by the aPDT [4 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
