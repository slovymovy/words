                "senses": [
                    {
                        "sense_id": "98269091-8b8d-366e-b31e-713e81f381e0",
                        "entry_id": "c8e5ea75-9b47-3317-af8e-82babed7d3a5",
                        "glosses": [
                            "dasjenige Wort in einem Vers, das den Reim trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696683a5-768d-4272-8edf-93eb4393a430",
                                "sense_id": "98269091-8b8d-366e-b31e-713e81f381e0",
                                "text": "„Fischer ging auf und ab, gab Falten lebhaften Unwillens zum besten und fing Reimwörter.“"
                            },
                            {
                                "example_id": "9c21fd0d-8298-4d11-814a-7a3b730f3dd8",
                                "sense_id": "98269091-8b8d-366e-b31e-713e81f381e0",
                                "text": "„Sie formte Wort für Wort, jede Hebung und Senkung der Silben, jedes Reimwort betonend, um jedes G und Ch bemüht, überdeutlich, als spräche sie eine fremde Sprache.“"
                            },
                            {
                                "example_id": "598d9312-bb45-4a56-a790-c715f50b7b34",
                                "sense_id": "98269091-8b8d-366e-b31e-713e81f381e0",
                                "text": "„Ein witziges Reimwort gegen Betonköpfe, vor allem, wenn sie zugleich provokant beim Namen genannt wurden, konnte wie ein Scheinwerfer die grauen Machtgespenster ins Licht zerren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
