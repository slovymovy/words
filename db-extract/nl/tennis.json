        "nl-extract.jsonl": [
            {
                "entry_id": "164ef83b-442e-3d1c-82f7-a0ff261f1b0b",
                "word": "tennis",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "07bd80b9-2555-3692-89ff-daeccb3a60a7",
                        "entry_id": "164ef83b-442e-3d1c-82f7-a0ff261f1b0b",
                        "glosses": [
                            "balsport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9f860c-59a9-4771-82f3-ceb1aafac837",
                                "sense_id": "07bd80b9-2555-3692-89ff-daeccb3a60a7",
                                "text": "De tennishistoricus Gillmeister ziet in het vroegmoderne tennis een gepacificeerde vorm van de toernooien, en in het Duitsland van de negentiende eeuw wordt het toernooi als een terminologisch anker gebruikt voor de nieuwe turnsport."
                            },
                            {
                                "example_id": "8418e39f-ad75-4279-b46b-34f5151038ff",
                                "sense_id": "07bd80b9-2555-3692-89ff-daeccb3a60a7",
                                "text": "Maar het feit dat er specifieke gidsen verschenen voor schermen, paardrijden, voetbal en tennis - om er maar een paar te noemen - geeft aan dat sport zich tot een apart veld van expertise had ontwikkeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3852c782-e0a5-4b17-9e41-459e070143b9",
                        "source_entry_id": "164ef83b-442e-3d1c-82f7-a0ff261f1b0b",
                        "source_sense_id": "07bd80b9-2555-3692-89ff-daeccb3a60a7",
                        "source_sense_description": "balsport",
                        "target_lang_word": "Tennis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tennis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                        "entry_id": "2460240a-8a98-328f-9e97-99ded35a9f61",
                                        "glosses": [
                                            "sportliches Ballspiel, welches als Rückschlagspiel mit einem Tennisball und jeweils einem Tennisschläger pro Person gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a205cc8-38df-4b0f-ae94-d0d26bf92e3d",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„Sie trug ganz kleine Shorts dabei. Alle haben damals Tennis gespielt – sie haben nicht wirklich gespielt, sie sahen nur sehr gut aus.“"
                                            },
                                            {
                                                "example_id": "7d030191-0996-4dc4-9c37-d75f359265bf",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„Tennis ist so gut für Frauen von Politikern und führenden Katholiken.“"
                                            },
                                            {
                                                "example_id": "d7258cf1-5f04-4fa0-bb09-d33587a6f7ae",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„Tennis ist teuer, schwer zu lernen und man muss Verpflichtungen wie Platzabos oder Vereinsmitgliedschaften eingehen - so die weit verbreitete Meinung, die viele vom Einstieg in den Sport abhält.“"
                                            },
                                            {
                                                "example_id": "d242ea3c-2eb9-4b1a-8f7c-8cd7b251976d",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "[…] „Beim Tennis ist Technik fast alles.“"
                                            },
                                            {
                                                "example_id": "fdf0adfc-19df-4d52-b928-2cb641356b2c",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„»Bei den akuten Verletzungen ist Tennis grundsätzlich ein recht verletzungsarmer Sport, weil es keinen direkten Gegnerkontakt gibt«, sagt Born.“"
                                            },
                                            {
                                                "example_id": "6b7c6abc-8274-4878-8e32-c844b54aff5b",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„»Die Gelenke sind beim Tennis insgesamt stark belastet und damit auch verletzungsanfällig«, sagt Sportwissenschaftler Born.“"
                                            },
                                            {
                                                "example_id": "bc41ceb2-5387-49b8-ab74-49d79c083d5a",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„Im Sportverein \"Maccabi\" spielt Bella Tennis.“"
                                            },
                                            {
                                                "example_id": "7aff6015-ea59-419b-a494-e1c54f0de712",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„Ich habe schon immer Sport getrieben, früher Tennis und Volleyball gespielt.“"
                                            },
                                            {
                                                "example_id": "c4d54dd4-6f48-41e0-8405-36397ef09a68",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„Markus studiert an der TU München Mathe im 5. Semester, in seiner Freizeit spielt er Tennis und tanzt gerne – ein ganz normaler Student eben.“"
                                            },
                                            {
                                                "example_id": "2a7878c1-3000-43a7-ae17-bdebe461b6bf",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "„»Mir wurde ein außergewöhnliches Talent geschenkt, Tennis zu spielen, und ich habe es auf einem Niveau getan, das ich niemals für möglich gehalten hätte, und auch viel länger, als ich gedacht hätte.«“ (Roger Federer)"
                                            },
                                            {
                                                "example_id": "3740c84f-45f7-4e23-b379-aaaa6617cabf",
                                                "sense_id": "9195886c-5cb6-36b8-b9d1-1430f6e76daf",
                                                "text": "[Serena Williams:] „Sie veränderte den Blick der schwarzen Community auf Tennis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98700c92-03bc-448d-a73f-ae623f934f07",
