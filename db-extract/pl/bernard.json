                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2dbf6ce-41db-4fd1-84fe-1b77b253af59",
                                "sense_id": "9642803f-0d84-338b-ad02-5226d1a7b9ac",
                                "text": "Jeśli Bernard i ona psom oczy sprzedadzą, to muszą się świata wyrzec całego"
