            {
                "entry_id": "999f013b-6a73-3a54-a7f9-0bbc720da077",
                "word": "éboulis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9b06c8c2-5bfa-3982-85ad-06270201e9a4",
                        "entry_id": "999f013b-6a73-3a54-a7f9-0bbc720da077",
                        "glosses": [
                            "Amas de matières éboulées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b333cd-09bc-44b9-b0a2-544f9cfd3bbb",
                                "sense_id": "9b06c8c2-5bfa-3982-85ad-06270201e9a4",
                                "text": "Les éboulis imposent une biologie très spéciale, car de grandes parties souterraines doivent permettre à la plante de se fixer malgré le milieu mouvant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96fa9b0a-142f-4843-8a4a-7b17666a55ea",
                        "source_entry_id": "999f013b-6a73-3a54-a7f9-0bbc720da077",
                        "source_sense_id": "9b06c8c2-5bfa-3982-85ad-06270201e9a4",
                        "target_lang_word": "Geröll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geröll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                        "entry_id": "045fb55a-7c8b-3ab1-9f3d-4b32e9c889f3",
                                        "glosses": [
                                            "Gesteinssediment mit einer Korngröße oberhalb der von Sand, oft grenzt man nach oben zu Blockgrößen ab. Die Grenzwerte für den Durchmesser sind in Fachwissenschaften oft präzise, aber uneinheitlich festgelegt. Oft wird zudem die Bezeichnung auf leidlich gerundetes Sediment beschränkt. Allgemeinsprachlich wird das Wort oft noch vager verstanden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcbbad1-6683-4216-9616-f71791788164",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "Durch Wind und Wasser abgetragenes Gestein sammelt sich oft als Geröll in Mulden am Fuße der Berge."
                                            },
                                            {
                                                "example_id": "4b5221ab-8e1b-4949-a7e1-60589f7b94a1",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "„Die Stirnlampe beleuchtet einen Ausschnitt, der kaum mehr als ein paar Beine und etwas Geröll erfasst.“"
                                            },
                                            {
                                                "example_id": "43611977-34c0-4a46-a3d3-ac3d6029f22a",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "„Ludwig war der erste, der von der Fuhlsbütteler Straße über den Wall von Geröll und Schutt in die Düsternstraße fand.“"
                                            },
                                            {
                                                "example_id": "47b667e2-7357-4ef8-8635-b1a5282c42b5",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "„Und dort blieb der Mercedes stehen, weil die Fahrbahn zertrümmert und voller Schutt und Geröll war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a93c79c5-d2eb-4461-b95b-3ecdf5c3f5bc",
                        "source_entry_id": "999f013b-6a73-3a54-a7f9-0bbc720da077",
                        "source_sense_id": "9b06c8c2-5bfa-3982-85ad-06270201e9a4",
                        "target_lang_word": "Schutthalde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2603534d-8cf3-4b4c-a7f6-c86ad2ac2095",
                        "source_entry_id": "999f013b-6a73-3a54-a7f9-0bbc720da077",
                        "source_sense_id": "9b06c8c2-5bfa-3982-85ad-06270201e9a4",
                        "target_lang_word": "scree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87d9f839-2d62-3ecc-8d09-874c8418a40c",
                                        "entry_id": "0c1b4cbb-3fe6-3fc5-b234-5b86d5c84de5",
                                        "glosses": [
                                            "Loose stony debris on a slope."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a96aa94e-da83-4d53-ada2-9402d1a9a844",
                                                "sense_id": "87d9f839-2d62-3ecc-8d09-874c8418a40c",
                                                "text": "To the north the towering scree-strewn slopes of Saddleback begin to draw nearer as we start the abrupt descent towards Keswick."
                                            },
                                            {
                                                "example_id": "b0c520ce-bce6-4ada-94b4-5b50d1b0246e",
                                                "sense_id": "87d9f839-2d62-3ecc-8d09-874c8418a40c",
                                                "text": "Struggling down the slope,\nThere's not much hope.\nI begin to try to ride the scree\nBut the rocks are tumbling all around me."
                                            },
                                            {
                                                "example_id": "8a99f8a2-87a9-4836-b8fa-1226c8ed0f7d",
                                                "sense_id": "87d9f839-2d62-3ecc-8d09-874c8418a40c",
                                                "text": "Sprawled prone among the rocks, the team waited for a reply to their request to fire. […] Occasional rounds zinged off the scree, each with a different pitch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd60457a-dd67-361f-b098-66ac224c4666",
                                        "entry_id": "0c1b4cbb-3fe6-3fc5-b234-5b86d5c84de5",
                                        "glosses": [
                                            "Similar debris made up of broken building material such as bricks, concrete, etc."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0cf931-ae77-496d-96a1-88201b8a76f9",
                                                "sense_id": "bd60457a-dd67-361f-b098-66ac224c4666",
                                                "text": "Acres of the industrial port had been reduced to desolation, half-walls, half-chimneys, crazy sticks of steel that looped up out of concrete scree. The temptation not to clear and rebuild must have been strong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268b3d29-9e10-35cf-ac08-d52e497670d4",
                                        "entry_id": "0c1b4cbb-3fe6-3fc5-b234-5b86d5c84de5",
                                        "glosses": [
                                            "A slope made up of scree at the base of a cliff, mountain, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97fe7074-3e66-4608-9e6d-e1a692699544",
                                                "sense_id": "268b3d29-9e10-35cf-ac08-d52e497670d4",
                                                "text": "The next landmark was an apachita 'cairn', at the top of a steep scree. Each pilgrim carried a stone to the summit, spat on it, and threw it on to the cairn — the purpose being, I was told, to relieve the soul of its sins […]"
                                            },
                                            {
                                                "example_id": "19fefa06-5e23-435e-97a3-a30563e97596",
                                                "sense_id": "268b3d29-9e10-35cf-ac08-d52e497670d4",
                                                "text": "Also, special to Crete, and probably derived from some aspect of its climactic history, is cementation. Many screes are converted, in whole or in part, into concrete-like breccias. Carapaces of cemented scree encrust steep slopes. Cliffs of conglomerate or marl are covered with a layer of re-deposited limestone and look like hard rock. However, the loose contents are apt to trickle out through a breach in the crust, resulting in the jagged and hollow cliffs which are a picturesque feature of Crete"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea0b6bb-da79-3294-a779-e92a256cfc6d",
                                        "entry_id": "2734bfa6-9f54-3518-a55f-7cb7f5b9a530",
                                        "glosses": [
                                            "To traverse scree downhill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5320ff4e-50e4-4d5f-aa9e-8707cb552cfb",
                                                "sense_id": "9ea0b6bb-da79-3294-a779-e92a256cfc6d",
                                                "text": "We decided it would be fun to go down the face of the mountain screeing (\"skiing\" on scree)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efbd8ea1-44eb-332b-bc6b-8d476b1cff35",
                                        "entry_id": "2db5ed53-3a3b-3c85-ac1d-aeec14ec6e0c",
                                        "glosses": [
                                            "A harsh, high-pitched sound or cry (as of a hawk)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdffd3b-d269-4b4a-933c-f315b586771b",
                                                "sense_id": "efbd8ea1-44eb-332b-bc6b-8d476b1cff35",
                                                "text": "I think both of our hearts must have gone into overdrive when we heard the metallic scree of a door being rolled open and the men's voices that accompanied it."
                                            },
                                            {
                                                "example_id": "a35d624a-a0ab-4607-b224-1c52cd4d56bf",
                                                "sense_id": "efbd8ea1-44eb-332b-bc6b-8d476b1cff35",
                                                "text": "For a few moments the only sound was the rasp of a file as Lee moved onto the last of Rowdy's hooves, the sound of John clipping, the scree of a hawk flying overhead and the occasional nicker from the horses already tied up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5578d1-1e2f-3c5f-9591-c4f6490bc93c",
                                        "entry_id": "9b990da5-f84f-347f-b564-57ffcf167667",
                                        "glosses": [
                                            "To make a high-pitched cry like that of a hawk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f33bae5-6982-4754-9df9-3d01cc3731d1",
                                                "sense_id": "9e5578d1-1e2f-3c5f-9591-c4f6490bc93c",
                                                "text": "They smelled the land before they saw it. A rich, dark odor of sweet earth, coming at them through a misty rain. Then seabirds appeared, crying and screeing."
                                            },
                                            {
                                                "example_id": "ea53c5ac-3ab0-4c5c-b651-229e45c0a5db",
                                                "sense_id": "9e5578d1-1e2f-3c5f-9591-c4f6490bc93c",
                                                "text": "She didn't want to scream to alert Malicia or a guard. What could she do to get the boy's attention? Suddenly, the memory of the mountaintop came to her. The hawk. She screed like a hawk. The boy stopped and searched the sky, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d42850e5-5414-337e-a6aa-b1b12ea605a0",
                                        "entry_id": "48c61ea2-6d19-33d8-9abe-c7f013c0055c",
                                        "glosses": [
                                            "To flatten or level concrete while still wet, and remove protruding gravel and stones from the surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2a0235e-a0ff-42b3-a459-abfc35a4b520",
                                                "sense_id": "d42850e5-5414-337e-a6aa-b1b12ea605a0",
                                                "text": "The crushing and screeing equipment owned by the TVA was transferred from job to job, and the availability of this equipment was one of the factors in determining who would produce the aggregate."
                                            },
                                            {
                                                "example_id": "c4ae13b6-4e99-4373-93ea-9f124a075ebb",
                                                "sense_id": "d42850e5-5414-337e-a6aa-b1b12ea605a0",
                                                "text": "Sequence of Construction – Circular Dog Kennel. […] Pour concrete. Use a straight 1-inch pipe about 12 feet long to scree each section. Extra help should be on hand to get screeing done. […] Specify a concrete mix that will not harden before screeing can be completed; do not order more concrete than can be property screed at one time; […]"
                                            },
                                            {
                                                "example_id": "469e642a-3134-4b46-a20a-62bfb36659b0",
                                                "sense_id": "d42850e5-5414-337e-a6aa-b1b12ea605a0",
                                                "text": "He was a stupid sonofabitch who didn't scree the concrete enough, his corner post was an eighth of an inch out of plumb, and what asshole set these louvers upside down?"
                                            },
                                            {
                                                "example_id": "246715a2-17ef-4bc0-9ac0-c1db969e2ed2",
                                                "sense_id": "d42850e5-5414-337e-a6aa-b1b12ea605a0",
                                                "text": "The sand bed is screed in preparation for laying the precast paving."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83d21405-5e2f-3d75-b4ad-2b33cc984496",
                                        "entry_id": "1cb88c22-1463-3fa3-a5cc-1bf898182226",
                                        "glosses": [
                                            "A coarse sieve."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f66d7d1-d6c2-410b-b62e-15093a857020",
                                                "sense_id": "83d21405-5e2f-3d75-b4ad-2b33cc984496",
                                                "text": "A contract of lease was entered into between the pursuer, who is the proprietor of the estate of Bargaddie, on the one part, and William M'Creath and others, carrying on business under the firm of the Bargaddie Coal Company, on the other part, […] and the lessees becoming bound to pay to the pursuer the sum of £500 sterling of fixed yearly rent, or, in his option, a lordship of 5½d. per cart of the gross output of coals, such cart weighing 13 cwt., and the coals being riddled through a riddle or scree of the customary size."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
