                "senses": [
                    {
                        "sense_id": "96a6857d-7949-3031-9f8e-cb09f3fef5de",
                        "entry_id": "09631fb2-2a44-3114-9e6e-16e7c533bc7d",
                        "glosses": [
                            "Unternehmen, das Pizza (oder andere Speisen) auf Bestellung zum Kunden bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704fdbf0-769a-4313-904e-bf1ab7b79cf0",
                                "sense_id": "96a6857d-7949-3031-9f8e-cb09f3fef5de",
                                "text": "„Sie könnte beispielsweise (a) im Kühlschrank nachsehen, (b) den Pizzaservice anrufen oder (c) zum Imbiss an der Ecke gehen.“"
                            },
                            {
                                "example_id": "e81f52fc-2bf2-4bdc-9260-21e1ce1efe8a",
                                "sense_id": "96a6857d-7949-3031-9f8e-cb09f3fef5de",
                                "text": "„Wenn Sie zum Beispiel vorhaben, einen Pizzaservice in Ihrer Stadt anzubieten, wie viele Personen können Sie mit Ihrem Pizzadienst maximal erreichen?“"
                            },
                            {
                                "example_id": "53fefd7b-ebbd-47ef-afda-147ed1f0e32b",
                                "sense_id": "96a6857d-7949-3031-9f8e-cb09f3fef5de",
                                "text": "„Dieter rief alle Pizzaservice im Umkreis von 20 Kilometer an und bestellte für insgesamt 40 Personen Pizza, Pasta und was diese sonst noch so anboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
