                        "entry_id": "aa5c6940-4108-375e-89ba-797a89450497",
                        "glosses": [
                            "An ornamental braided cord with decorative metal tips worn on uniforms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eafd005a-efe9-4af1-90f4-fcea22dad2ab",
                                "sense_id": "a1c2776c-1dc9-3638-8b44-9d061e8df8a3",
                                "text": "Lancers wore Dragoon jackets with embroidered cuffs and collars, enormous epaulettes and an aiguillette. They wore very high Polish caps with square crowns, with a brass plate in front and topped with a plume."
                            }
                        ]
                    },
