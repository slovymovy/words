                },
                {
                    "sense_id": "c0b28d36-a4d2-36dc-b279-f7b21207c4a7",
                    "sense_definition": "En très grande quantité ou en très grand nombre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y avait <w>énormément</w> de monde au concert hier soir dans le centre-ville.",
                            "target_lang_translations": {
                                "en": "There were <w>a great many</w> people at the concert in the city centre last night.",
                                "ru": "Вчера вечером на концерте в центре города было <w>много</w> народу.",
                                "de": "Beim Konzert in der Innenstadt waren gestern Abend <w>sehr viele</w> Leute.",
                                "es": "Anoche había <w>muchísima</w> gente en el concierto del centro de la ciudad.",
                                "zh": "昨天晚上市中心的那场音乐会上有<w>大量</w>观众。"
                            }
                        },
                        {
                            "text": "Nous avons encore <w>énormément</w> de travail avant de pouvoir terminer ce projet.",
                            "target_lang_translations": {
                                "en": "We still have <w>a great deal</w> of work to do before we can finish this project.",
                                "ru": "У нас ещё <w>много</w> работы, прежде чем мы сможем завершить этот проект.",
                                "de": "Wir haben noch <w>sehr viel</w> Arbeit vor uns, bevor wir dieses Projekt abschließen können.",
                                "es": "Todavía nos queda <w>muchísimo</w> trabajo antes de poder terminar este proyecto.",
                                "zh": "在完成这个项目之前，我们还有<w>大量</w>工作要做。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beaucoup"
                    ],
                    "common_phrases": [
                        "énormément de monde",
                        "énormément de temps",
                        "énormément de travail"
                    ],
                    "target_lang_definitions": {
                        "en": "In a very large amount or in very great numbers.",
                        "ru": "В очень большом количестве или в очень большом числе.",
                        "de": "In sehr großer Menge oder in sehr großer Anzahl.",
                        "es": "En una cantidad o número muy grande.",
                        "zh": "数量非常大，或人数非常多。"
                    },
