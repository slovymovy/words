                    "sense_definition": "Affirmer sciemment le contraire de la vérité afin de tromper ou d'induire en erreur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a préféré <w>mentir</w> à ses parents plutôt que d'avouer sa mauvaise note.",
                            "target_lang_translations": {
                                "en": "He preferred to <w>lie</w> to his parents rather than admit his bad grade.",
                                "ru": "Он предпочёл <w>солгать</w> родителям, а не признаться в плохой оценке.",
                                "nl": "Hij gaf er de voorkeur aan om tegen zijn ouders te <w>liegen</w> in plaats van zijn slechte cijfer toe te geven.",
                                "de": "Er hat seinen Eltern lieber <w>gelogen</w>, als seine schlechte Note zuzugeben.",
                                "pl": "Wolał <w>kłamać</w> rodzicom, zamiast przyznać się do złej oceny.",
                                "it": "Ha preferito <w>mentire</w> ai genitori piuttosto che ammettere il suo brutto voto.",
                                "cs": "Raději <w>lhal</w> rodičům, než aby přiznal svou špatnou známku.",
                                "tr": "Kötü notunu itiraf etmektense ailesine <w>yalan söylemeyi</w> tercih etti.",
                                "es": "Prefirió <w>mentir</w> a sus padres antes que admitir su mala nota.",
                                "zh": "他宁愿对父母<w>撒谎</w>，也不肯承认自己考砸了。"
                            }
                        },
                        {
                            "text": "Je sais qu'elle <w>ment</w> quand elle évite de me regarder dans les yeux.",
                            "target_lang_translations": {
                                "en": "I know she <w>lies</w> when she avoids looking me in the eyes.",
                                "ru": "Я знаю, что она <w>врёт</w>, когда избегает смотреть мне в глаза.",
                                "nl": "Ik weet dat ze <w>liegt</w> wanneer ze me niet in de ogen durft te kijken.",
                                "de": "Ich weiß, dass sie <w>lügt</w>, wenn sie es vermeidet, mir in die Augen zu sehen.",
                                "pl": "Wiem, że <w>kłamie</w>, kiedy unika patrzenia mi w oczy.",
                                "it": "So che <w>mente</w> quando evita di guardarmi negli occhi.",
                                "cs": "Vím, že <w>lže</w>, když se mi vyhýbá pohledem do očí.",
                                "tr": "Gözlerime bakmaktan kaçındığında onun <w>yalan söylediğini</w> biliyorum.",
                                "es": "Sé que <w>miente</w> cuando evita mirarme a los ojos.",
                                "zh": "她一不敢直视我的眼睛，我就知道她在<w>撒谎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
