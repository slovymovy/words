                        "tags": [
                            "plural"
                        ],
                        "form": "Polacks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6109d6ba-e8b5-3233-920d-b298b5c1b258",
                        "entry_id": "0e7595ce-edd4-3f7f-ae36-aef3d5f039a7",
                        "glosses": [
                            "A Pole, or person of Polish descent."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "offensive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8e26622c-ea0e-41c1-afb1-6c3a4e3938d1",
                                "sense_id": "6109d6ba-e8b5-3233-920d-b298b5c1b258",
                                "text": "which to him appear'd / To be a preparation 'gainſt the Poleak"
                            },
                            {
                                "example_id": "83532d35-75ae-46c4-bfb7-95687018a315",
                                "sense_id": "6109d6ba-e8b5-3233-920d-b298b5c1b258",
                                "text": "So leuied as before, againſt the Poleak."
                            },
                            {
                                "example_id": "140fe361-a021-4f29-8be0-e60965501d45",
                                "sense_id": "6109d6ba-e8b5-3233-920d-b298b5c1b258",
                                "text": "First therefore was he employed into Poland, where by Sigismund, the king of Poland and of Suecia, he was received with great magnificence and applause both of the Polack himself and of his people."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c33bc3e-a3f7-4785-a16c-d14e9f157863",
                        "source_entry_id": "0e7595ce-edd4-3f7f-ae36-aef3d5f039a7",
                        "source_sense_id": "6109d6ba-e8b5-3233-920d-b298b5c1b258",
                        "source_sense_description": "derogatory: Polish person",
                        "target_lang_word": "Pšonek",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pšonek",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "147e210b-8a20-3b1b-a0c3-4fc625260a10",
                                        "entry_id": "b145f408-3fa8-3358-921d-6e8f8bafb728",
                                        "glosses": [
                                            "Polák"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d28249b-fa09-4b9f-a6b0-3e2f2aa7af9e",
                                                "sense_id": "147e210b-8a20-3b1b-a0c3-4fc625260a10",
                                                "text": "Pšonci, jedem, natřete Rusákům prdel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f321b1f8-558a-489c-89a5-91e02e299dd5",
                        "source_entry_id": "0e7595ce-edd4-3f7f-ae36-aef3d5f039a7",
                        "source_sense_id": "6109d6ba-e8b5-3233-920d-b298b5c1b258",
                        "source_sense_description": "derogatory: Polish person",
                        "target_lang_word": "Polak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polak",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5b4dc8-fcaa-3ff1-8449-5f66c67afe97",
                                        "entry_id": "fb2309f1-86f9-3be4-90d6-54780237d424",
                                        "glosses": [
                                            "Polonais."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16031976-fe35-4374-9e13-72b6f948eb19",
                                                "sense_id": "fc5b4dc8-fcaa-3ff1-8449-5f66c67afe97",
                                                "text": "Ainsi, vous ne me feriez jamais prendre un Polak pour un Rital ni un Anglais pour un Allemand. Mon mort, je le sais, je le sens, était Français ; et même, au risque de passer pour un lavedu, je vous affirmerai qu'il était Parigot."
                                            },
                                            {
                                                "example_id": "26cfbd3e-4812-40e5-ac05-11947c0d7a2e",
                                                "sense_id": "fc5b4dc8-fcaa-3ff1-8449-5f66c67afe97",
                                                "text": "Lorsque son père arriva dans ce village au bord de la Meuse, c'était un grand gaillard célibataire qui croyait encore aux promesses de l'avenir. Sauf que là-bas aussi un Polak n'était qu'un Polak, de sorte qu'il dut se contenter d'un poste à la chaîne bien que l'usine cherchât un contremaître."
                                            },
                                            {
                                                "example_id": "d4595ba3-8c68-40c8-9374-8baa0ede50ef",
                                                "sense_id": "fc5b4dc8-fcaa-3ff1-8449-5f66c67afe97",
                                                "text": "À part filer du pognon aux Polaks, qu'est-ce que vous allez faire à Auschwitz ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Polak",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "010e5a58-6d3f-3656-bc17-ca2fcdecf9a7",
                                        "entry_id": "6f3fb439-9b5f-3c04-bd9a-aea59b040b68",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddfb64b7-26d7-4788-bf36-5ab01cd71994",
                        "source_entry_id": "0e7595ce-edd4-3f7f-ae36-aef3d5f039a7",
                        "source_sense_id": "6109d6ba-e8b5-3233-920d-b298b5c1b258",
                        "source_sense_description": "derogatory: Polish person",
                        "target_lang_word": "Polacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dffc6449-5ed7-3893-afbe-ac3b009434d0",
                                        "entry_id": "5d3aede9-977d-3813-8bbc-652ca2a6731c",
                                        "glosses": [
                                            "Mensch polnischer Abstammung"
                                        ],
                                        "tags": [
                                            "stark abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e2613c-b4dc-4f09-afad-a600b8b22965",
                                                "sense_id": "dffc6449-5ed7-3893-afbe-ac3b009434d0",
                                                "text": "Wißt ihr noch, wie ich mit dem Polacken Händel kriegte, dem ich sein gepicht und gekräuselt Haar von ungefähr mit dem Ärmel verwischte?"
                                            },
                                            {
                                                "example_id": "764087ae-12b2-4bd2-93c0-3415a40e252a",
                                                "sense_id": "dffc6449-5ed7-3893-afbe-ac3b009434d0",
                                                "text": "Die Polacken nennen sie mit einem besonderen Nahmen Upiers und Upierzyca, von welchen der gedachte Autor sehr glaubwürdige Zeugnisse anführet."
                                            },
                                            {
                                                "example_id": "1cb566d8-1a17-4c51-ab38-70f2a5969f91",
                                                "sense_id": "dffc6449-5ed7-3893-afbe-ac3b009434d0",
                                                "text": "Und wie er es gewollt hatte, die Polacken wandten sich und kamen mit Geschrei gegen die Zaunlücke hergestürmt."
                                            },
                                            {
                                                "example_id": "bb74620f-d881-4ae4-8993-215c56b7e7ee",
                                                "sense_id": "dffc6449-5ed7-3893-afbe-ac3b009434d0",
                                                "text": "Ich habe daheim, gottlob, soviel Aerger damit, meine Polacken zu Menschen zu erziehen, daß ich wenig Zeit habe, an mich zu denken."
                                            },
                                            {
                                                "example_id": "74d8e408-5027-4c70-93dd-8eaf4137572c",
                                                "sense_id": "dffc6449-5ed7-3893-afbe-ac3b009434d0",
                                                "text": "Auf unser erstes sandt’ er aus und hemmte die Werbungen des Neffen, die er hielt für Zurüstungen gegen den Polacken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Polacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "659790c9-871d-3443-b88c-ad11bbc115e5",
                                        "entry_id": "425cf36e-76a4-3fe8-9395-f2a8d0f58cc9",
                                        "glosses": [
                                            "großes dreimastiges Schiff"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
