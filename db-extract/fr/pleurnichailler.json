                "senses": [
                    {
                        "sense_id": "554302f7-14a6-3db6-8735-442824ab6b22",
                        "entry_id": "6ca93975-7389-339e-970b-8bcc05031597",
                        "glosses": [
                            "Pleurnicher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a747e36-7d4c-4301-ad65-79e66af519e7",
                                "sense_id": "554302f7-14a6-3db6-8735-442824ab6b22",
                                "text": "Qu’elle monte, qu’elle aille donc la retrouver si ça lui chante au lieu de gigoter et de pleurnichailler sur sa chaise !"
                            },
                            {
                                "example_id": "31e399bc-38c0-4f4e-a879-7a4cc8519702",
                                "sense_id": "554302f7-14a6-3db6-8735-442824ab6b22",
                                "text": "Tout le village est sous la tonnelle ; les hommes, taciturnes, boivent du clairin ; tassées à part, les femmes soupirent, pleurnichaillent, et font aller leurs langues."
                            }
                        ]
                    }
