                "senses": [
                    {
                        "sense_id": "aee33e95-f5ac-3ce2-bb4a-d3dd46bb3d44",
                        "entry_id": "8a50dd7e-7f3a-33f8-bc3d-3bedffc1462e",
                        "glosses": [
                            "разг. усилит. к красота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91081c5-7644-43ca-9041-f4a6f4facc00",
                                "sense_id": "aee33e95-f5ac-3ce2-bb4a-d3dd46bb3d44",
                                "text": "Из всей красотищи этой мне больше всего понравилась трещина на столике Антуанетты."
                            },
                            {
                                "example_id": "5876340c-001b-4338-8f8b-e7029064408f",
                                "sense_id": "aee33e95-f5ac-3ce2-bb4a-d3dd46bb3d44",
                                "text": "То, что мы увидели на Бирюсе, даже затопленной, в плесени замзгнутой воды, не поддаётся описанию. Дух захватывает от неповторимой, воистину колдовской красотищи!"
                            }
                        ]
                    }
