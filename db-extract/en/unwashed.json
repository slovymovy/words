                "senses": [
                    {
                        "sense_id": "0bebd9b2-afe1-311e-965d-b22dc366e748",
                        "entry_id": "53736a93-5cf7-3476-b382-229e42c72f5a",
                        "glosses": [
                            "Not having been washed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8bef57d5-a443-47a6-90f5-8cd9c1fa263b",
                                "sense_id": "0bebd9b2-afe1-311e-965d-b22dc366e748",
                                "text": "I say that the eyass should have her meat unwashed, until she becomes a brancher—’twere the ready way to give her the frounce, to wash her meat sooner, and so knows every one who knows a gled from a falcon."
                            }
                        ]
                    },
                    {
                        "sense_id": "063e8f22-8460-3d57-a111-4d5a156cb966",
                        "entry_id": "53736a93-5cf7-3476-b382-229e42c72f5a",
                        "glosses": [
                            "Vulgar, plebeian, lowbrow."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "606c0b65-e812-46f6-9981-c3f8ccfdda45",
                                "sense_id": "063e8f22-8460-3d57-a111-4d5a156cb966",
                                "text": "Gannon is looked upon with distrust by a good many members of the Citizens’ Committee—or perhaps it is with jealousy. He remains, however, a hero to the unwashed elements."
                            },
                            {
                                "example_id": "5ca94f45-8f10-423c-a292-78eb3236bd3a",
                                "sense_id": "063e8f22-8460-3d57-a111-4d5a156cb966",
                                "text": "“Yeah, wading down into the comments. \"Winsomely compelling cop-aganda,\" says C-Rob-69. Oh, wait, that was me.” “Drivel for the unwashed. The Bard, how he weeps.”"
                            }
                        ]
                    }
                ],
