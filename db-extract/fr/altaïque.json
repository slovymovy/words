                "entry_id": "d0876ca8-15be-35dc-97a4-08c218bd02bf",
                "word": "altaïque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5e09d3f-6acc-46ea-98fc-a341ceaa93c2",
                        "entry_id": "d0876ca8-15be-35dc-97a4-08c218bd02bf",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
