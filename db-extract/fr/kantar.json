                "senses": [
                    {
                        "sense_id": "f905e0ab-7e99-362e-b359-0e8a6ed60f17",
                        "entry_id": "b21ba02a-d758-3f98-996c-147734ae4ff7",
                        "glosses": [
                            "Société britannique spécialisée entre autres dans les études de marché et les sondages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d08fb99c-62c5-415f-8b30-af73762a5875",
                                "sense_id": "f905e0ab-7e99-362e-b359-0e8a6ed60f17",
                                "text": "Ce sont eux qui pourraient aujourd’hui récupérer la mise, dans un pays en proie à la hausse du prix de l’énergie, à l’inflation et à l’augmentation des actes de violence parmi les plus jeunes, où 28 % des primo-votants se tourneraient vers l’extrême droite, selon l’institut Kantar, contre 23 % pour les sociaux-démocrates."
                            },
                            {
                                "example_id": "1507100c-04e6-423a-ae1d-7e1e96d2c10c",
                                "sense_id": "f905e0ab-7e99-362e-b359-0e8a6ed60f17",
                                "text": "Au total, on recense en France — selon les statistiques de Facco-Kantar —, 80 millions d’animaux de compagnie."
                            },
                            {
                                "example_id": "d164c4b6-fde5-4b27-a135-391d870f59de",
                                "sense_id": "f905e0ab-7e99-362e-b359-0e8a6ed60f17",
                                "text": "D’après une étude réalisée par Kantar pour FranceAgriMer, en 2021, il s’était vendu 6,6 millions de sapins."
                            }
                        ]
                    }
                ],
