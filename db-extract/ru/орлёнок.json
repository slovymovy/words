                ],
                "senses": [
                    {
                        "sense_id": "1278c0e6-46c5-3048-9952-7764dbe02a48",
                        "entry_id": "5390b9ec-7f83-3fe6-9ffc-439caf184a9a",
                        "glosses": [
                            "eaglet (an eagle chick)"
                        ],
                        "tags": [
                            "animate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "11a87c56-c9f3-4823-b003-5d887d0f588b",
                                "sense_id": "1278c0e6-46c5-3048-9952-7764dbe02a48",
                                "text": "Орлё́нок, орлё́нок — могу́чая пти́ца,\nЛети́ ты в далё́кий мой край,\nТам ма́ма-стару́шка по сы́ну томи́тся,\nРоди́мой приве́т переда́й!",
                                "translation": "Eaglet, eaglet – mighty bird,\nFly thou to my faraway land,\nThere [my] elderly mother for [her] son is pining,\nTo [my] darling [mother], give [my] greetings!",
                                "english": "Eaglet, eaglet – mighty bird,\nFly thou to my faraway land,\nThere [my] elderly mother for [her] son is pining,\nTo [my] darling [mother], give [my] greetings!"
                            }
                        ]
                    },
                    {
                        "sense_id": "8179edf1-fba8-349e-b301-d692e20275af",
                        "entry_id": "5390b9ec-7f83-3fe6-9ffc-439caf184a9a",
                        "glosses": [
                            "a member of a Soviet pioneer camp Орлёнок (or it's modern equivalent) or a boy who is acting like one"
                        ],
                        "tags": [
                            "animate",
                            "masculine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9086335e-91f4-315a-a731-7ec4d392d63b",
                        "entry_id": "5390b9ec-7f83-3fe6-9ffc-439caf184a9a",
                        "glosses": [
                            "a teenager who was fighting on the Red side during the Civil War in Russia, Belarussia and Ukraine (1917-24)"
                        ],
                        "tags": [
                            "animate",
                            "historical",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "63612808-7017-4bf0-b269-061279b9d332",
                                "sense_id": "9086335e-91f4-315a-a731-7ec4d392d63b",
                                "text": "Меня́ называ́ли ‘орлё́нком’ в отря́де,\nВраги́ называ́ют ‘орло́м’.",
                                "translation": "In the squad [mates] called me ‘eaglet’;\nFoes call me ‘eagle’.",
                                "english": "In the squad [mates] called me ‘eaglet’;\nFoes call me ‘eagle’."
                            }
                        ]
                    },
                    {
                        "sense_id": "d454b8d1-0b31-3760-804f-38724f40fa52",
                        "entry_id": "5390b9ec-7f83-3fe6-9ffc-439caf184a9a",
                        "glosses": [
                            "a teenager who took part in the defence of Lemberg fighting on the Polish side during the Polish-Ukrainian War (1918-19)"
                        ],
