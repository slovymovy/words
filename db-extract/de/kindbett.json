                ],
                "senses": [
                    {
                        "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                        "entry_id": "5630d242-0c38-3ffc-8fd9-df0ea77988d9",
                        "glosses": [
                            "die ersten sechs bis acht Wochen nach der Entbindung, während derer sich die weiblichen Geschlechtsorgane mit Ausnahme der Brüste auf ihren normalen Zustand vor der Schwangerschaft zurückbilden"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "d8969813-1741-4ce8-bfa6-a28b969a317a",
                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                "text": "Frauen im Kindbett sind stark infektionsgefährdet."
                            },
                            {
                                "example_id": "3584c4e3-7c86-4948-b152-4df8981e4b2e",
                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                "text": "„Seine Frau hatte er im Kindbett verloren.“"
                            },
                            {
                                "example_id": "c488efd0-3f6d-4e6a-bee4-ffae1a191055",
                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                "text": "„McKennoch, dem die Frau vor kurzem im Kindbett weggestorben, geachtet und rüstig, meinte, sie könnten sich ebensogut zusammentun, zwei ledige Hälften jede für sich, das hätte wenig Sinn.“"
                            },
                            {
                                "example_id": "f7a4de54-348c-4882-8736-5894487a5f3d",
                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                "text": "„Vielleicht konnte sie sich auch darum nicht als Ehefrau und Mutter sehen, Kindbetten sind riskant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
