                    {
                        "translation_id": "3c270f9d-0bde-43ba-8f32-960b5ded637d",
                        "source_entry_id": "8556cd15-80fe-34f0-92d2-b17d9a2341fe",
                        "source_sense_description": "system",
                        "target_lang_word": "Silbenschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silbenschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                        "entry_id": "6b1c5e60-62de-3597-b7d1-a2b5e5dc4816",
                                        "glosses": [
                                            "Schrift, bei der die einzelnen Zeichen (Schriftzeichen) für Silben stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "672b200a-7a65-4110-a469-107d9ac6ef4e",
                                                "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                                "text": "In einer Silbenschrift steht ein Schriftzeichen für eine Silbe und nicht nur für einen Laut, wie das bei alphabetischen Schriften der Fall ist."
                                            },
                                            {
                                                "example_id": "78568810-a42f-4b02-a306-88063cfb4095",
                                                "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                                "text": "Hiragana und Katakana sind japanische Silbenschriften."
                                            },
                                            {
                                                "example_id": "202b1738-fa3a-4ca3-9fef-3eda1d342092",
                                                "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                                "text": "„Dank seiner einfachen Silbenstruktur kommt die Silbenschrift des Japanischen mit knapp 50 Zeichen aus.“"
                                            },
                                            {
                                                "example_id": "cd241037-88e9-4754-aad6-04ec3ff1a252",
                                                "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                                "text": "„Bei einer Silbenschrift entspricht jedes Graphem einer gesprochenen Silbe, in der Regel einem Konsonant-Vokal-Paar.“"
                                            },
                                            {
                                                "example_id": "f5510dd3-0a9d-4c77-81b7-46767044fb20",
                                                "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                                "text": "„Zur Verdeutlichung der Natur von Silbenschriften ist das sicher ein wesentlicher Fortschritt gewesen.“"
                                            },
                                            {
                                                "example_id": "e4554280-e2f1-4cb9-9258-8ff9c02f44fb",
                                                "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                                "text": "„Von den Silbenschriften des Altertums können wir hier absehen, da die Silbenschrift, wie der Verfasser an anderer Stelle ausgeführt hat, keine notwendige Stufe zwischen Wort- und Buchstabenschrift darstellt.“"
                                            },
                                            {
                                                "example_id": "f1a981fa-529b-47a6-bd58-de77d0a129ae",
                                                "sense_id": "4f435855-28b5-3875-81ff-ca09b3f26fb2",
                                                "text": "„Die Juden schrieben auch die Sprachen ihrer Wirtsvölker merkwürdigerweise immer in ihrer semitischen, von rechts nach links laufenden Silbenschrift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
