    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6d34cbf-2868-3476-b874-e9b6901d1acd",
                    "sense_definition": "Живущий в природных условиях (о животных) или растущий без ухода человека (о растениях); не домашний.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом лесу живут <дикие> кабаны и медведи.",
                            "target_lang_translations": {
                                "en": "<Wild> boars and bears live in this forest.",
                                "es": "En este bosque viven jabalíes y osos <salvajes>.",
                                "fr": "Des sangliers et des ours <sauvages> vivent dans cette forêt."
                            }
                        },
                        {
                            "text": "На лугу расцвели красивые <дикие> цветы.",
                            "target_lang_translations": {
                                "en": "Beautiful <wild> flowers bloomed in the meadow.",
                                "es": "En el prado florecieron hermosas flores <silvestres>.",
                                "fr": "De belles fleurs <sauvages> ont fleuri dans la prairie."
                            }
                        }
                    ],
                    "synonyms": [
                        "неодомашненный",
                        "неприручённый",
                        "некультивированный"
                    ],
                    "antonyms": [
                        "домашний",
                        "ручной",
                        "культурный"
                    ],
                    "common_phrases": [
                        "дикие животные",
                        "дикая природа",
                        "дикие птицы",
                        "дикие растения"
                    ],
                    "target_lang_definitions": {
                        "en": "Living in natural conditions (of animals) or growing without human care (of plants); not domestic.",
                        "es": "Que vive en libertad en su entorno natural (animales) o crece sin cultivo ni cuidados del ser humano (plantas); no doméstico.",
                        "fr": "Qui vit dans la nature (pour les animaux) ou pousse sans intervention humaine (pour les plantes) ; non domestique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "animals/plants"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "salvaje",
                                "target_lang_sense_clarification": "animales y plantas"
                            },
                            {
                                "target_lang_word": "silvestre",
                                "target_lang_sense_clarification": "plantas y flores"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sauvage",
                                "target_lang_sense_clarification": "pour les animaux et plantes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb9113e1-a311-3725-aaee-ec47c88def23",
                    "sense_definition": "Не тронутый деятельностью человека, сохранивший первозданный вид; пустынный (о местности).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Путешественники шли через густой <дикий> лес.",
                            "target_lang_translations": {
                                "en": "The travelers walked through a dense <wild> forest.",
                                "es": "Los viajeros caminaban a través de un denso bosque <salvaje>.",
                                "fr": "Les voyageurs marchaient à travers une forêt dense et <sauvage>."
                            }
                        },
                        {
                            "text": "Перед нами открылся <дикий> и прекрасный горный пейзаж.",
                            "target_lang_translations": {
                                "en": "A <wild> and beautiful mountain landscape opened up before us.",
                                "es": "Ante nosotros se abrió un <salvaje> y hermoso paisaje montañoso.",
                                "fr": "Un paysage de montagne <sauvage> et magnifique s'est offert à nous."
                            }
                        }
                    ],
                    "synonyms": [
                        "первозданный"
                    ],
                    "common_phrases": [
                        "дикий лес",
                        "дикий край",
                        "дикое поле",
                        "дикая местность"
                    ],
                    "target_lang_definitions": {
                        "en": "Untouched by human activity, preserving its primordial appearance; desolate (of a locality).",
                        "es": "No alterado por la actividad humana, que conserva su estado natural o virgen; desierto o abrupto (dicho de un lugar).",
                        "fr": "Non touché par l'activité humaine, préservant son état d'origine ; désert (pour un lieu)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "nature/landscape"
                            },
                            {
                                "target_lang_word": "savage",
                                "target_lang_sense_clarification": "rugged/untamed"
                            }
                        ],
                        "es": [
