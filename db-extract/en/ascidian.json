                    },
                    {
                        "translation_id": "d8ef2579-487c-465e-be9c-ce5acff31719",
                        "source_entry_id": "23f5a709-af10-3d1f-89a4-60ee1900bfb0",
                        "source_sense_id": "d0ed7bee-7b1e-3126-bc6c-ff8bc49e3085",
                        "source_sense_description": "any member of the class Ascidiacea",
                        "target_lang_word": "ascidie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascidie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcaea9fd-70b3-3f9a-befa-4258b6383346",
                                        "entry_id": "7c3a2b4d-a84e-3334-b11c-af4945f87991",
                                        "glosses": [
                                            "Organe creux de certaines plantes carnivores, destiné à piéger leurs proies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8f14a9-3941-40db-8208-fa86494eebfe",
                                                "sense_id": "bcaea9fd-70b3-3f9a-befa-4258b6383346",
                                                "text": "De petits animaux se noient dans l'eau contenue dans les urnes ou ascidies des feuilles de Sarracenia."
                                            },
                                            {
                                                "example_id": "67518afc-9841-4ce0-91b7-2c523f46cefa",
                                                "sense_id": "bcaea9fd-70b3-3f9a-befa-4258b6383346",
                                                "text": "Mais certaines vrilles développent à leur extrémité un organe en forme d’urne, « l’ascidie », qui va constituer le piège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef83466-0b75-34aa-a728-f5efe97381e5",
                                        "entry_id": "7c3a2b4d-a84e-3334-b11c-af4945f87991",
                                        "glosses": [
                                            "Nom donné aux animaux marins appartenant à la classe des Ascidiacea dans le sous-embranchement des tuniciers (Tunicata), et qui sont les plus primitifs des chordés, embranchement dont font partie les vertébrés. Note d’usage : Ce terme est généralement utilisé au pluriel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b7322e-89b2-4029-b005-49fff8cd4a3e",
                                                "sense_id": "4ef83466-0b75-34aa-a728-f5efe97381e5",
                                                "text": "Sur les pierres les moins raboteuses, les ascidies composées étendaient leurs plaques luisantes, vertes, brunes, rouges, violettes, semées de figures d’une régularité géométrique, que dessinait chaque famille de ces êtres singuliers."
                                            },
                                            {
                                                "example_id": "2d86f3c9-9900-49e6-af85-a3efb6109d19",
                                                "sense_id": "4ef83466-0b75-34aa-a728-f5efe97381e5",
                                                "text": "Aux embryologistes, qui cherchent inlassablement à mieux comprendre comment une unique cellule fécondée donne naissance à un organisme complexe, plusieurs modèles animaux apportent une aide précieuse : l’ascidie, le nématode, le poisson zèbre, la désormais célèbre mouche drosophile… Et le xénope."
                                            },
                                            {
                                                "example_id": "8cc2d0df-787e-4db2-a0ab-48471b3bbf05",
                                                "sense_id": "4ef83466-0b75-34aa-a728-f5efe97381e5",
                                                "text": "Nous nous régalons de cuisine au ginseng : […] Morceaux de POISSON-GLOBE et d’ASCIDIES VERRUQUEUSES cuits au wok avec du ginseng frit, puis généreusement recouverts de sauce épicée.\n— Les ASCIDIES sont croquantes comme du cartilage, puis libèrent de la saumure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
