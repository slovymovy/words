        "nl-extract.jsonl": [
            {
                "entry_id": "bf8c3797-f24c-3c97-8b34-3dd8243907d2",
                "word": "beklemming",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "4612a2ca-7b72-4dbc-bd86-9b2b42d62c14",
                        "entry_id": "bf8c3797-f24c-3c97-8b34-3dd8243907d2",
                        "tags": [
                            "plural"
                        ],
                        "form": "beklemmingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99252644-a7f0-38cc-9a92-31534c81c2f6",
                        "entry_id": "bf8c3797-f24c-3c97-8b34-3dd8243907d2",
                        "glosses": [
                            "drukkend gevoel van benauwdheid en vast te zitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d88074c-e549-483c-9b6c-06487c744776",
                                "sense_id": "99252644-a7f0-38cc-9a92-31534c81c2f6",
                                "text": "Blackwood Crossing speelt als een nachtmerrie: flarden herinneringen worden aan elkaar gehecht zonder logica. De visuele stijl lijkt op grote horrorgames als Bioshock, maar horror is het niet: in deze droom mag ook plezier en warmte een rol spelen. Die afwisseling is de grote kracht van de game. Beklemming maakt plaats voor warmte, in een kinderspel sluipt angst, die omslaat in verzoening. Drie uur lang gaan de emoties alle kanten op."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d582db9-4ad5-3845-a8ba-4ed99525f217",
                        "entry_id": "bf8c3797-f24c-3c97-8b34-3dd8243907d2",
                        "glosses": [
                            "het recht om voor altijd gebruik te mogen maken van de grond van iemand anders (vrijwel alleen in de provincie Groningen)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f44a821-fc35-445d-8e75-df7c45476be8",
                        "source_entry_id": "bf8c3797-f24c-3c97-8b34-3dd8243907d2",
                        "source_sense_id": "99252644-a7f0-38cc-9a92-31534c81c2f6",
                        "source_sense_description": "drukkend gevoel van benauwdheid en vast te zitten",
                        "target_lang_word": "fear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e61d7ac0-05ff-31dc-a761-c31973a9daf7",
                                        "entry_id": "b91607e2-d6cc-3a96-b041-2dcef9e635eb",
                                        "glosses": [
                                            "A strong, unpleasant emotion or feeling caused by actual or perceived danger or threat."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e84594-438b-40a8-ab0f-3d6dc60f702c",
                                                "sense_id": "e61d7ac0-05ff-31dc-a761-c31973a9daf7",
                                                "text": "He was struck by fear on seeing the snake."
                                            },
                                            {
                                                "example_id": "65f94f4a-2e13-4163-8bcb-9052b03b0f51",
                                                "sense_id": "e61d7ac0-05ff-31dc-a761-c31973a9daf7",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed."
                                            },
                                            {
                                                "example_id": "91ee3827-9fbe-4f0a-9802-0f7273322ced",
                                                "sense_id": "e61d7ac0-05ff-31dc-a761-c31973a9daf7",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "4081730e-458d-4ce5-8ab0-fb724e0d9715",
                                                "sense_id": "e61d7ac0-05ff-31dc-a761-c31973a9daf7",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police[…]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18cdbe85-de22-3d0d-a9aa-ab414cb803b8",
                                        "entry_id": "b91607e2-d6cc-3a96-b041-2dcef9e635eb",
                                        "glosses": [
                                            "A phobia, a sense of fear induced by something or someone."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fea8abe-e37c-405b-a0b4-c09c4594589e",
                                                "sense_id": "18cdbe85-de22-3d0d-a9aa-ab414cb803b8",
                                                "text": "Not everybody has the same fears. I have a fear of ants."
                                            },
                                            {
                                                "example_id": "fb88ca08-e07e-4985-8ec7-5c24b5847876",
                                                "sense_id": "18cdbe85-de22-3d0d-a9aa-ab414cb803b8",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes. The clear light of the bright autumn morning had no terrors for youth and health like hers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faacc530-3870-30eb-b6e2-4570bd9fb4ff",
                                        "entry_id": "b91607e2-d6cc-3a96-b041-2dcef9e635eb",
                                        "glosses": [
                                            "Terrified veneration or reverence, particularly towards God, gods, or sovereigns."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e34e6e0d-d543-49d1-8c30-fbefda5638ac",
                                                "sense_id": "faacc530-3870-30eb-b6e2-4570bd9fb4ff",
                                                "text": "The feare of the Lord is the beginning of wisedome."
                                            },
                                            {
                                                "example_id": "401cf4cb-d28d-46a6-bb64-8518a8e5eda7",
                                                "sense_id": "faacc530-3870-30eb-b6e2-4570bd9fb4ff",
                                                "text": "That sacred dread of all offence to him, which is called the Fear of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d07be44-e758-3c6f-bf16-4b2ecce94b1f",
                                        "entry_id": "b91607e2-d6cc-3a96-b041-2dcef9e635eb",
                                        "glosses": [
                                            "A feeling of dread and anxiety when waking after drinking a lot of alcohol, wondering what one did while drunk."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "684609c2-f2d8-470d-90fd-d2efb716cf81",
                                                "sense_id": "1d07be44-e758-3c6f-bf16-4b2ecce94b1f",
                                                "text": "Her feeling of humiliation had intensified as the day had gone on and her hangover had worsened. She now also had 'the fear' to contend with, […]"
                                            },
                                            {
                                                "example_id": "9724c4cd-cb60-472a-bf9f-66f52e42d2ee",
                                                "sense_id": "1d07be44-e758-3c6f-bf16-4b2ecce94b1f",
                                                "text": "He had the fear, that feeling of dread that you've done something really embarrassing. The fear was a hundred times worse than the hangover. No, a thousand times worse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b7c3e3-5e7b-3bbb-b84a-71337f362219",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To be afraid of (something or someone); to consider or expect (something or someone) with alarm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac9dbc33-4203-457b-876b-8800a66d303c",
                                                "sense_id": "49b7c3e3-5e7b-3bbb-b84a-71337f362219",
                                                "text": "I fear the worst will happen."
                                            },
                                            {
                                                "example_id": "c50d58cd-0560-4c9e-82c8-430daa3aec33",
                                                "sense_id": "49b7c3e3-5e7b-3bbb-b84a-71337f362219",
                                                "text": "I greatly fear my money is not safe."
                                            },
                                            {
                                                "example_id": "dae3abfb-d5a2-4b4a-a753-6f0270bb2602",
                                                "sense_id": "49b7c3e3-5e7b-3bbb-b84a-71337f362219",
                                                "text": "And fear not them which kill the body, but are not able to kill the soul: but rather fear him which is able to destroy both soul and body in hell."
                                            },
                                            {
                                                "example_id": "c4916f05-dab1-470c-b4eb-ab2427570e8f",
                                                "sense_id": "49b7c3e3-5e7b-3bbb-b84a-71337f362219",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            },
                                            {
                                                "example_id": "312ddadb-2508-481e-ae01-260ec2662942",
                                                "sense_id": "49b7c3e3-5e7b-3bbb-b84a-71337f362219",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f815eca6-cffe-3c30-9162-7fdb0a14b995",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To feel fear."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789effd7-2c20-4c73-bafd-0396fe162c4e",
                                                "sense_id": "f815eca6-cffe-3c30-9162-7fdb0a14b995",
                                                "text": "Never fear; help is always near."
                                            },
                                            {
                                                "example_id": "b1d4bf79-8f2b-4fec-a9f3-3802bae9db86",
                                                "sense_id": "f815eca6-cffe-3c30-9162-7fdb0a14b995",
                                                "text": "Fear not, little flock; for it is your Father’s good pleasure to give you the kingdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b6239c-d5ef-3be3-9aa8-72596cba18d3",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To worry about, to feel concern for, to be afraid for [with for]."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b282c5b0-b0f2-4b98-a315-e488d7e28e94",
                                                "sense_id": "95b6239c-d5ef-3be3-9aa8-72596cba18d3",
                                                "text": "She fears for her son’s safety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a0b6d6-8a0c-38f6-9ee3-849e316ebb24",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To venerate; to feel awe towards."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "864427e2-e114-4bce-851f-15810218a48e",
                                                "sense_id": "c3a0b6d6-8a0c-38f6-9ee3-849e316ebb24",
                                                "text": "People who fear God can be found in Christian churches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7b21f6-3d9e-3045-84f9-dddb670e6c42",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To regret."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3329f9b1-5988-4203-a692-4ae44a7c02b3",
                                                "sense_id": "3d7b21f6-3d9e-3045-84f9-dddb670e6c42",
                                                "text": "I fear I have bad news for you: your husband has died."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10db21fd-f468-3c0c-add6-f528400676ff",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To cause fear to; to frighten."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38970b36-6663-4ed6-9b9e-69976295ac3d",
                                                "sense_id": "10db21fd-f468-3c0c-add6-f528400676ff",
                                                "text": "Thenne the knyghte sayd to syre Gawayn / bynde thy wounde or thy blee chaunge / for thou bybledest al thy hors and thy fayre armes /[…]/ For who someuer is hurte with this blade he shalle neuer be staunched of bledynge / Thenne ansuerd gawayn hit greueth me but lytyl / thy grete wordes shalle not feare me ne lasse my courage"
                                            },
                                            {
                                                "example_id": "184e4ca2-7651-472d-a235-2c9bb825e8f5",
                                                "sense_id": "10db21fd-f468-3c0c-add6-f528400676ff",
                                                "text": "Ythrild with deepe disdaine of his proud threat,\nShe shortly thus; Fly they, that need to fly;\nWordes fearen babes."
                                            },
                                            {
                                                "example_id": "8003089d-aedf-45ec-89ec-e4bb1130a336",
                                                "sense_id": "10db21fd-f468-3c0c-add6-f528400676ff",
                                                "text": "Tush, tush! fear boys with bugs."
                                            },
                                            {
                                                "example_id": "36717a61-8c29-4fda-8a5c-4bce30060f72",
                                                "sense_id": "10db21fd-f468-3c0c-add6-f528400676ff",
                                                "text": "We must not make a scarecrow of the law,\nSetting it up to fear the birds of prey,\nAnd let it keep one shape, till custom make it\nTheir perch and not their terror."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd92ca61-ff71-384d-ad77-f38f3b9403d4",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To be anxious or solicitous for."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75117b3c-fafb-4388-b323-adb5966539d8",
                                                "sense_id": "bd92ca61-ff71-384d-ad77-f38f3b9403d4",
                                                "text": "Fearst thou thy person? thou shalt haue a guard:"
                                            },
                                            {
                                                "example_id": "6cc2de32-d540-4edb-9777-4e6176021461",
                                                "sense_id": "bd92ca61-ff71-384d-ad77-f38f3b9403d4",
                                                "text": "The sins of the father are to be laid upon the children: therefore, I promise ye, I fear you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59a34ef7-246f-3e44-88ba-80e319c8cb4b",
                                        "entry_id": "fc61ce16-ac16-306e-a523-a93772585105",
                                        "glosses": [
                                            "To suspect; to doubt."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4663aac3-f201-479d-8a4e-a4a851ecef10",
                                                "sense_id": "59a34ef7-246f-3e44-88ba-80e319c8cb4b",
                                                "text": "Fear you not her courage?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fear",
