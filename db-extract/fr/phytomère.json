                        "entry_id": "a9706d84-1241-33ed-bea3-293deb45d15c",
                        "glosses": [
                            "Unité d’organisation d’une plante, généralement composée d’un entre-nœud et d’un nœud avec une feuille et un bourgeon axillaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dfca7e5-ca6f-49e7-b52d-57f5e3c96ffa",
                                "sense_id": "7e84f6e7-64e2-3afe-b014-51473f204bad",
                                "text": "Une tige de bambou offre une image très parlante de la structure en nœuds et entre-nœuds, qui se construit par empilement de phytomères."
                            },
                            {
                                "example_id": "75817954-5148-42a0-a509-dfb9f6d6558c",
                                "sense_id": "7e84f6e7-64e2-3afe-b014-51473f204bad",
                                "text": "Encore appelé module, un phytomère est une unité d’organisation de la plante."
                            }
                        ]
                    }
