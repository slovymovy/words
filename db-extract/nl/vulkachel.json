                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dauerbrenner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a12a29b1-2d12-358e-8ce4-b350fc52747b",
                                        "entry_id": "f0b17a9f-db17-374a-b056-b81e47526666",
                                        "glosses": [
                                            "Herd oder Ofen mit langer Brenndauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "836004e2-a9ff-4de7-b66b-9eccf8f0a21b",
                                                "sense_id": "a12a29b1-2d12-358e-8ce4-b350fc52747b",
                                                "text": "Ein Dauerbrenner musste nicht ständig in kurzen Abständen mit Brennstoffen bestückt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79d7e80f-14b4-3580-91b2-c69d218f8297",
                                        "entry_id": "f0b17a9f-db17-374a-b056-b81e47526666",
                                        "glosses": [
                                            "Gegenstand oder Thema von längerfristigem Interesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d5f3c6b-272d-4d18-b352-09a2bb4b4cba",
                                                "sense_id": "79d7e80f-14b4-3580-91b2-c69d218f8297",
                                                "text": "Manche Bücher sind echte Dauerbrenner, wie die Bestsellerlisten zeigen."
                                            },
                                            {
                                                "example_id": "3821084a-7199-46c3-9823-f0ee10907cbf",
                                                "sense_id": "79d7e80f-14b4-3580-91b2-c69d218f8297",
                                                "text": "Die Beitrittsverhandlungen der Türkei zur EU und der Streit darüber seit mindestens 10 Jahren innerhalb der EU: das Thema ist ein Dauerbrenner."
                                            },
                                            {
                                                "example_id": "aad20d09-d50f-4515-acb4-2601b3992080",
                                                "sense_id": "79d7e80f-14b4-3580-91b2-c69d218f8297",
                                                "text": "Der Irak ist ein Dauerbrenner in den Medien."
                                            },
                                            {
                                                "example_id": "ab704f89-bcb8-4857-a9ec-ec11def0e971",
                                                "sense_id": "79d7e80f-14b4-3580-91b2-c69d218f8297",
                                                "text": "Der ungleiche Verdienst von Frauen und Männern, das ist nämlich so ein Dauerbrenner, auch im Jahr 2017 bekommen in Deutschland die Frauen im Durchschnitt fast 22 Prozent weniger Geld als die Männer."
                                            },
                                            {
                                                "example_id": "cf2400cd-e937-4b1a-816c-3ddba99a2c59",
                                                "sense_id": "79d7e80f-14b4-3580-91b2-c69d218f8297",
                                                "text": "1970 lief der erste Tatort im deutschen Fernsehen. Damit begann eine Erfolgsgeschichte, die noch lange nicht zu Ende ist. Auch in anderen Ländern kennt man den Krimi-Dauerbrenner aus Deutschland."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
