{
    "word_family": [
        "blood",
        "bloody",
        "bloodless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6eaf68d-a529-3143-bf87-925ca85e3b11",
                    "sense_definition": "Having a specific physiological characteristic related to the circulatory system, used in compound words.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "compound_suffix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most mammals are <w>warm-blooded</w> animals.",
                            "target_lang_translations": {
                                "fr": "La plupart des mammifères sont des animaux <w>à sang chaud</w>."
                            }
                        },
                        {
                            "text": "Reptiles are generally <w>cold-blooded</w> creatures.",
                            "target_lang_translations": {
                                "fr": "Les reptiles sont généralement des créatures <w>à sang froid</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warm-blooded",
                        "cold-blooded"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se dit d'un animal ayant une caractéristique physiologique liée à la régulation de la température corporelle."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "-sang",
                                "target_lang_sense_clarification": "utilisé comme suffixe dans les composés (ex: à sang chaud, à sang froid)"
                            },
                            {
                                "target_lang_word": "à sang chaud",
                                "target_lang_sense_clarification": "physiologie: homéotherme"
                            },
                            {
                                "target_lang_word": "à sang froid",
                                "target_lang_sense_clarification": "physiologie: poïkilotherme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8235e22d-c165-385f-a351-f210415b94c9",
                    "sense_definition": "Having a specific temperament or disposition, used in compound words.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compound_suffix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective hunted the <w>cold-blooded</w> criminal.",
                            "target_lang_translations": {
                                "fr": "Le détective a traqué le criminel <w>de sang-froid</w>."
                            }
                        },
                        {
                            "text": "He committed a <w>cold-blooded</w> act of violence.",
                            "target_lang_translations": {
                                "fr": "Il a commis un acte de violence <w>de sang-froid</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cold-blooded"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se dit d'une personne agissant sans émotion, avec cruauté ou sans pitié."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de sang-froid",
                                "target_lang_sense_clarification": "se dit d'un acte cruel commis sans émotion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87cc7f95-0a38-32b0-8640-9dcfc78d55b6",
                    "sense_definition": "Having a specific degree of ancestry, used in compound words.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compound_suffix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>full-blooded</w> member of the tribe.",
                            "target_lang_translations": {
                                "fr": "Elle est un membre <w>de pur sang</w> de la tribu."
                            }
                        },
                        {
                            "text": "He is <w>half-blooded</w> and proud of his heritage.",
                            "target_lang_translations": {
                                "fr": "Il est <w>métis</w> et fier de son héritage."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full-blooded"
                    ],
                    "target_lang_definitions": {
                        "fr": "Indique le degré d'ascendance ou d'appartenance à un groupe ethnique ou familial."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de pur sang",
                                "target_lang_sense_clarification": "pour une ascendance complète"
                            },
                            {
                                "target_lang_word": "métis",
                                "target_lang_sense_clarification": "pour une ascendance mixte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67d5ec69-0919-341c-9278-2d062dd1b2fa",
                    "sense_definition": "Having a specific type of noble or distinguished ancestry, used in compound words.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compound_suffix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blue-blooded</w> prince attended the gala.",
                            "target_lang_translations": {
                                "fr": "Le prince <w>de sang bleu</w> a assisté au gala."
                            }
                        },
                        {
                            "text": "She married into a <w>blue-blooded</w> family.",
                            "target_lang_translations": {
                                "fr": "Elle s'est mariée dans une famille <w>de sang bleu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blue-blooded"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se dit d'une personne issue de la noblesse ou d'une famille aristocratique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de sang bleu",
                                "target_lang_sense_clarification": "expression idiomatique pour désigner la noblesse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "393ce29b-a46b-32ed-bd9c-17d2dc7188e9",
                    "sense_definition": "Having gained experience, especially through initial participation in combat or a difficult task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young soldier was finally <w>blooded</w> after his first mission.",
                            "target_lang_translations": {
                                "fr": "Le jeune soldat a finalement été <w>aguerri</w> après sa première mission."
                            }
                        },
                        {
                            "text": "The team was <w>blooded</w> in the championship tournament.",
                            "target_lang_translations": {
                                "fr": "L'équipe a été <w>aguerrie</w> lors du tournoi de championnat."
                            }
                        }
                    ],
                    "synonyms": [
                        "experienced",
                        "seasoned"
                    ],
                    "antonyms": [
                        "unblooded"
                    ],
                    "target_lang_definitions": {
                        "fr": "Ayant acquis de l'expérience, notamment après une première participation à un combat ou une épreuve difficile."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aguerri",
                                "target_lang_sense_clarification": "qui a acquis de l'expérience par le combat"
                            },
                            {
                                "target_lang_word": "expérimenté",
                                "target_lang_sense_clarification": "qui a acquis de l'expérience par la pratique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c4817f-a41b-33f2-85eb-2037c6897c1a",
                    "sense_definition": "Covered in blood or bleeding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer left the ring <w>blooded</w> but victorious.",
                            "target_lang_translations": {
                                "fr": "Le boxeur a quitté le ring <w>ensanglanté</w> mais victorieux."
                            }
                        },
                        {
                            "text": "He emerged from the accident <w>blooded</w> and shaken.",
                            "target_lang_translations": {
                                "fr": "Il est sorti de l'accident <w>ensanglanté</w> et secoué."
                            }
                        }
                    ],
                    "synonyms": [
                        "bleeding",
                        "bloody"
                    ],
                    "target_lang_definitions": {
                        "fr": "Couvert de sang ou blessé au point de saigner."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ensanglanté",
                                "target_lang_sense_clarification": "couvert de sang"
                            },
                            {
                                "target_lang_word": "en sang",
                                "target_lang_sense_clarification": "qui saigne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9391c6cb-53ed-37a4-8a6a-56568c10bfbb",
                    "sense_definition": "Past tense and past participle of <w>blood</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commander <w>blooded</w> his new recruits in the skirmish.",
                            "target_lang_translations": {
                                "fr": "Le commandant a <w>aguerri</w> ses nouvelles recrues lors de l'escarmouche."
                            }
                        },
                        {
                            "text": "They have <w>blooded</w> many young players this season.",
                            "target_lang_translations": {
                                "fr": "Ils ont <w>initié</w> beaucoup de jeunes joueurs cette saison."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Faire participer quelqu'un pour la première fois à une épreuve ou un combat pour lui donner de l'expérience."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aguerrir",
                                "target_lang_sense_clarification": "donner de l'expérience par l'épreuve"
                            },
                            {
                                "target_lang_word": "initier",
                                "target_lang_sense_clarification": "faire participer pour la première fois"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}