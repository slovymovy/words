                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01339d6-500a-4791-b127-af499fee3c37",
                                "sense_id": "fb9c3f07-2969-3038-b6d3-2bffd0e6d1bf",
                                "text": "„Ein krankes Pferd, das nicht mehr aufstehen mochte, wurde von einer Musketenkugel erlöst, der einzige Schuss am ersten Tag des Russlandfeldzuges.“"
                            },
                            {
                                "example_id": "9234be08-9e12-449a-b192-9b41a5ff8a3e",
                                "sense_id": "fb9c3f07-2969-3038-b6d3-2bffd0e6d1bf",
                                "text": "„Viele Flüchtlinge, darunter meine Großmutter, senkten den Kopf und sahen sich in der tragischen Rolle, gleichsam überproportional für den Angriffskrieg der Nazis, die Verwüstungen während des Russlandfeldzugs und den Holocaust gebüßt zu haben.“"
                            }
                        ],
