                "senses": [
                    {
                        "sense_id": "a7d126df-cdf1-3499-82aa-0a280da65725",
                        "entry_id": "9c778bb2-4f50-3dfe-b6a5-c5fd8117aa1c",
                        "glosses": [
                            "Médicaliser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbe50c40-e48a-4662-8afe-b50c08b8143e",
                                "sense_id": "a7d126df-cdf1-3499-82aa-0a280da65725",
                                "text": "Ron K. Jaekle, spécialiste en médecine maternelle à l’université de Cincinnati, dénonce le concept de l’émission dans Entertainment Weekly : « Je comprends que tout le monde ait envie de croire que nous surmédicalisons la grossesse, alors que c’est un processus naturel. Mais il faut rappeler qu’avant l’assistance médicale, l’accouchement a causé la perte de nombreuses vies. L’intérêt de cette téléréalité est-il de tuer ? »"
                            }
                        ]
                    }
