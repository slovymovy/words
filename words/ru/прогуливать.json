{
    "word_family": [
        "прогулка",
        "гулять",
        "прогульщик"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "540ed074-1e38-3bd8-a4fa-1968e8835c19",
                    "sense_definition": "не посещать занятия или работу без уважительной причины",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "absenteeism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент часто <w>прогуливает</w> лекции по истории.",
                            "target_lang_translations": {
                                "en": "The student often <w>skips</w> history lectures."
                            }
                        },
                        {
                            "text": "Если ты будешь <w>прогуливать</w> уроки, у тебя будут проблемы с учителями.",
                            "target_lang_translations": {
                                "en": "If you <w>ditch</w> classes, you will have trouble with the teachers."
                            }
                        }
                    ],
                    "synonyms": [
                        "пропускать"
                    ],
                    "common_phrases": [
                        "прогуливать уроки",
                        "прогуливать школу",
                        "прогуливать работу"
                    ],
                    "target_lang_definitions": {
                        "en": "To intentionally miss classes or work without a valid reason."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ditch",
                                "target_lang_sense_clarification": "informal term for skipping school or work"
                            },
                            {
                                "target_lang_word": "skip",
                                "target_lang_sense_clarification": "common term for failing to attend a scheduled event or class"
                            },
                            {
                                "target_lang_word": "play hooky",
                                "target_lang_sense_clarification": "idiomatic expression for staying away from school without permission"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef3e97d8-0db5-3c19-951f-5f4b6911c636",
                    "sense_definition": "выводить кого-либо на прогулку",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нужно <w>прогуливать</w> собаку два раза в день.",
                            "target_lang_translations": {
                                "en": "I need to <w>walk</w> the dog twice a day."
                            }
                        },
                        {
                            "text": "Мама пошла <w>прогуливать</w> маленького ребенка в парке.",
                            "target_lang_translations": {
                                "en": "Mom went to <w>take</w> the little child for a walk in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "выгуливать"
                    ],
                    "common_phrases": [
                        "прогуливать собаку"
                    ],
                    "target_lang_definitions": {
                        "en": "To take someone or an animal out for a walk, usually for exercise or recreation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "walk",
                                "target_lang_sense_clarification": "to take a person or animal out for exercise"
                            },
                            {
                                "target_lang_word": "take out",
                                "target_lang_sense_clarification": "to accompany someone or an animal outside"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe0af294-77dd-336e-b17b-3c5cfd26ac61",
                    "sense_definition": "тратить деньги на развлечения и кутежи",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>прогуливал</w> все свои деньги в ресторанах.",
                            "target_lang_translations": {
                                "en": "He <w>squandered</w> all his money in restaurants."
                            }
                        },
                        {
                            "text": "Не стоит <w>прогуливать</w> зарплату за один вечер.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>blow</w> your salary in one night."
                            }
                        }
                    ],
                    "synonyms": [
                        "проматывать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To spend money lavishly on entertainment, partying, or excessive leisure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squander",
                                "target_lang_sense_clarification": "to waste money in a reckless or foolish manner"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "informal term for spending a large amount of money quickly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}