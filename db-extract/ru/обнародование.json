                ],
                "translations": [
                    {
                        "translation_id": "9f453cf9-7011-4852-8e6f-a7d5b2aeefe9",
                        "source_entry_id": "15860cb8-e8f8-3ee7-9ffe-339b896147db",
                        "source_sense_id": "c4535e66-3d97-35be-8510-cc97d8007aba",
                        "target_lang_word": "publication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "publication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca47c694-abd0-3fcf-8237-7ade46983102",
                                        "entry_id": "555d3ef9-4d61-387f-a536-98122cb2846f",
                                        "glosses": [
                                            "Action par laquelle on rend une chose publique et notoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05c9c1a7-e608-44fb-a888-3a2d50954080",
                                                "sense_id": "ca47c694-abd0-3fcf-8237-7ade46983102",
                                                "text": "Cette norme européenne devra recevoir le statut de norme nationale soit par publication d'un texte identique, soit par entérinement au plus tard en décembre 1999, […]."
                                            },
                                            {
                                                "example_id": "b322ff41-3492-47a6-ad98-f633597c0673",
                                                "sense_id": "ca47c694-abd0-3fcf-8237-7ade46983102",
                                                "text": "Après la publication des résultats de l’écrit sur le site de publinet, les candidats admissibles reçoivent une convocation pour assister à une réunion au lycée Saint-Louis en fin d'après-midi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a428f2ad-cd49-38f1-96a9-f1117fbb2040",
                                        "entry_id": "555d3ef9-4d61-387f-a536-98122cb2846f",
                                        "glosses": [
                                            "Action de publier, de faire paraître, de mettre en vente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490ace4a-4cc4-43da-845a-410dda4a93c8",
                                                "sense_id": "a428f2ad-cd49-38f1-96a9-f1117fbb2040",
                                                "text": "La publication, en 1687, de Principia Mathematica, l’œuvre magistrale d’Isaac Newton révélant les lois de la gravitation universelle, a alors fourni de solides assises théoriques pour la poursuite de l’étude de l’Univers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98ee6e40-dd89-3371-b2e3-0b74fd1946a8",
                                        "entry_id": "555d3ef9-4d61-387f-a536-98122cb2846f",
                                        "glosses": [
                                            "Ouvrage publié."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb46dfc-e6e4-48ca-9741-417771c723dd",
                                                "sense_id": "98ee6e40-dd89-3371-b2e3-0b74fd1946a8",
                                                "text": "Les scientifiques de l’ICARDA et des organisations françaises de recherche ont coécrit plus de 40 publications de recherche au cours des dix dernières années."
                                            },
                                            {
                                                "example_id": "eb9b4223-a84c-4ee6-8610-5123f35db800",
                                                "sense_id": "98ee6e40-dd89-3371-b2e3-0b74fd1946a8",
                                                "text": "Elle l’a annoncé sobrement vendredi dernier, avec l’air de ne pas trop vouloir déranger l’internaute occupé à faire défiler les publications de son fil Instagram. La chanteuse de rock britannique PJ Harvey republie son album To Bring You My Love en vinyle […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c199f98-fe5e-3396-95fa-330829feda17",
                                        "entry_id": "555d3ef9-4d61-387f-a536-98122cb2846f",
                                        "glosses": [
                                            "Première édition d’une carte, comprenant le premier tirage et des réimpressions éventuelles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e759d3e1-77c5-3c2d-9b36-c98c628ca9d3",
                                        "entry_id": "555d3ef9-4d61-387f-a536-98122cb2846f",
                                        "glosses": [
                                            "Texte publié sur un réseau social qui comporte souvent des éléments audio-visuels et des hyperliens."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b25759-3f04-4423-9741-997fe304c2d8",
                                                "sense_id": "e759d3e1-77c5-3c2d-9b36-c98c628ca9d3",
                                                "text": "Les vendredis, je révise les publications sociales des deux dernières semaines."
                                            },
                                            {
                                                "example_id": "75bbb5b5-6283-4c99-8b19-66d6d0e4679d",
                                                "sense_id": "e759d3e1-77c5-3c2d-9b36-c98c628ca9d3",
                                                "text": "Un Superfan est un abonné très actif sur les publications d’une page, après un certain nombre de réactions et commentaires, l’abonné débloque un badge de Superfan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52376d02-4187-42b2-bf49-3f8d84477cef",
                        "source_entry_id": "15860cb8-e8f8-3ee7-9ffe-339b896147db",
                        "source_sense_id": "c4535e66-3d97-35be-8510-cc97d8007aba",
                        "target_lang_word": "proclamation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proclamation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                        "entry_id": "f23f9d1e-e319-3a90-a61b-d7606beb8724",
                                        "glosses": [
                                            "Action de proclamer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30546dce-f82d-4cc5-b86a-4d3d21cdede2",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Le commencement de la philosophie pour Descartes, c’est le doute ; cela seul est toute sa méthode. C'est la proclamation du droit au libre examen. L'avenir de la philosophie est attaché à ce principe."
                                            },
                                            {
                                                "example_id": "6c8de101-3b54-4fed-9bbd-2c9586f1c3d5",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Ce fut une époque de beuveries à décarcasser un veau, parmi les vapeurs des pipes et les proclamations d'esthètes crasseux, toutes lavallières dehors."
                                            },
                                            {
                                                "example_id": "0f5be75d-b3f7-4472-b607-2c7015dc60a4",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Prenons, par exemple, des proclamations pour lesquelles le second facteur prend des valeurs très fortement négatives, celles de Ferroul (704) à gauche ou de Guilloutet (213) à droite."
                                            },
                                            {
                                                "example_id": "24a8187b-5e53-42b4-acb6-b98d9795f385",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Suivirent les premiers progrès de la science occidentale, qui devient efficace (Galilée, Newton); puis, avec le siècle des \"Lumières\", l'affirmation de la prééminence de la \"Raison\", la revendication de la tolérance et surtout la proclamation de l'idée de progrès,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b642e59-d5ec-3a9d-ad8e-e69ef8aed674",
                                        "entry_id": "f23f9d1e-e319-3a90-a61b-d7606beb8724",
                                        "glosses": [
                                            "Écrit qui contient ce que l’on veut publier ou faire connaître au public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc17f88-01e1-42fd-bba6-c91a4e1e36c4",
                                                "sense_id": "4b642e59-d5ec-3a9d-ad8e-e69ef8aed674",
                                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6ba5f7d-bd68-4051-ba96-3e919fa97937",
                        "source_entry_id": "15860cb8-e8f8-3ee7-9ffe-339b896147db",
                        "source_sense_id": "c4535e66-3d97-35be-8510-cc97d8007aba",
                        "target_lang_word": "promulgation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promulgation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "effa433d-522e-3c9b-b528-5244849ac519",
                                        "entry_id": "8ac830ae-8be5-359e-8fb0-df9983974a51",
                                        "glosses": [
                                            "Action de promulguer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa61150-3358-4933-b354-b9e741f2fa05",
                                                "sense_id": "effa433d-522e-3c9b-b528-5244849ac519",
                                                "text": "Ce décret, rendu le 16, reçut, le 23, la sanction du conseil exécutif, qui le mit en vigueur huit jours après sa promulgation."
                                            },
                                            {
                                                "example_id": "8671a096-dbae-42f5-a886-1e5e5a78d04b",
                                                "sense_id": "effa433d-522e-3c9b-b528-5244849ac519",
                                                "text": "Du 2 Frimaire, l'an 2 de la République.\nSur la déclaration unanime du jury, portant :\n1°. Qu'il n'est pas constant qu'il ait été tenu dans la ville de Brienon-sur-Armançon, département de l'Yonne, lors de la promulgation du décret portant abolition de la royauté, des propos tendant à provoquer l’avilissement de la représentation nationale et le rétablissement de la royauté."
                                            },
                                            {
                                                "example_id": "0887d903-4063-4626-8ad0-a41737bccf69",
                                                "sense_id": "effa433d-522e-3c9b-b528-5244849ac519",
                                                "text": "Le Sénat ne s'oppose pas à la promulgation de la loi qui règle les limites des communes de Condé-lès-Vouziers et de Vouziers (Ardennes)."
                                            },
                                            {
                                                "example_id": "52df8c6a-022e-402b-a362-c8a1fbe46c4c",
                                                "sense_id": "effa433d-522e-3c9b-b528-5244849ac519",
                                                "text": "Voici donc le récit de l’écriture d’un texte, avec ses brouillons, ses ratures et finalement sa promulgation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "4570ccd9-3786-4a12-ab32-8658ccdca569",
