                    },
                    {
                        "translation_id": "fe714c8d-7bf6-47ab-b75b-73cf9daee314",
                        "source_entry_id": "927c3528-c13b-395b-b293-87bd15d6ccf0",
                        "source_sense_id": "c06d94bf-db9d-3598-ae56-0d95d8e3ee9d",
                        "target_lang_word": "ausplaudern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausplaudern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "691ad468-81b2-3bb3-a97c-b884aa4935d8",
                                        "entry_id": "93213741-84e0-3dc5-a8ca-8bcef61bac72",
                                        "glosses": [
                                            "ein Geheimnis weitererzählen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f9ce40-241a-4288-80e9-1183a7f28f5c",
                                                "sense_id": "691ad468-81b2-3bb3-a97c-b884aa4935d8",
                                                "text": "„Schweigen war den meisten Menschen so unangenehm, dass sie zu reden begannen und dabei versehentlich die Gedanken ausplauderten, die sie eigentlich am stärksten verbergen wollten.“"
                                            },
                                            {
                                                "example_id": "778eea26-cd69-42be-8165-d097514e194b",
                                                "sense_id": "691ad468-81b2-3bb3-a97c-b884aa4935d8",
                                                "text": "„Sie wollte generell nicht, dass andere Leute zu viel über sie wissen und ihre Geheimnisse womöglich noch ausplauderten.“"
                                            },
                                            {
                                                "example_id": "f3ef6bf7-50de-4330-a306-a5dd9bb6fd6c",
                                                "sense_id": "691ad468-81b2-3bb3-a97c-b884aa4935d8",
                                                "text": "„Da Sie so liebenswürdig zu mir waren und um der alten Zeiten willen werde ich natürlich nichts ausplaudern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be67f9cb-8c1e-339c-badd-a8604f2fbce7",
                                        "entry_id": "93213741-84e0-3dc5-a8ca-8bcef61bac72",
                                        "glosses": [
                                            "lang und ausgiebig miteinander reden"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837be45d-e8a2-43f6-910e-d4fd02c6473e",
                                                "sense_id": "be67f9cb-8c1e-339c-badd-a8604f2fbce7",
                                                "text": "Lassen wir die jungen Mädchen auch sich mit einander ausplaudern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13e48d20-1128-476a-ac58-91996ff846c4",
                        "source_entry_id": "927c3528-c13b-395b-b293-87bd15d6ccf0",
                        "source_sense_id": "c06d94bf-db9d-3598-ae56-0d95d8e3ee9d",
                        "target_lang_word": "divulguer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divulguer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5e544a-6523-3dfb-a02c-dcd11d534ac5",
                                        "entry_id": "7f5bbf47-d01a-35d7-9349-1e6e1c3565e0",
                                        "glosses": [
                                            "Rendre public ce qui n’était pas su ; dévoiler un secret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf25257-9130-4b2c-82ed-83c33de3dd78",
                                                "sense_id": "cc5e544a-6523-3dfb-a02c-dcd11d534ac5",
                                                "text": "En effet, la façon dont le Sauveur s’y prend pour divulguer les grâces réservées à Lourdes est stupéfiante. Afin de les épandre, il ne se borne plus à faire célébrer ses miracles par une propagande toute orale ; non, […] Il en vient aussitôt aux grands moyens."
                                            },
                                            {
                                                "example_id": "93ed7858-cee2-4681-aa1e-0a9751bce9b0",
                                                "sense_id": "cc5e544a-6523-3dfb-a02c-dcd11d534ac5",
                                                "text": "L'intérêt des phénomènes d’embâcle qui peuvent être divulgués sans inconvénient, nous incite à les communiquer sans tarder."
                                            },
                                            {
                                                "example_id": "2df389d4-1ae9-41c9-af40-862a5d148569",
                                                "sense_id": "cc5e544a-6523-3dfb-a02c-dcd11d534ac5",
                                                "text": "L'Abeille lilloise, lancée en 1847 par Henri Dupont, divulguait les scandales de la semaine ; partial, mal rédigé, quoique spirituel, cet hebdomadaire « charivarique » correspond assez bien aux goûts des lecteurs lillois."
                                            },
                                            {
                                                "example_id": "11da4e63-453e-4cd0-8da8-26eb2b2a6099",
                                                "sense_id": "cc5e544a-6523-3dfb-a02c-dcd11d534ac5",
                                                "text": "Manquant à la pudeur la plus élémentaire,\nDois-je, pour les besoins d' la caus' publicitaire,\nDivulguer avec qui, et dans quell' position\nJe plonge dans le stupre et la fornication ?"
                                            },
                                            {
                                                "example_id": "4a6714ac-8797-4a0e-b8f5-cecd0a8046ee",
                                                "sense_id": "cc5e544a-6523-3dfb-a02c-dcd11d534ac5",
                                                "text": "[…] ; le chatbot CYBERLOVER a attiré l'attention des autorités en raison de son penchant à amener les internautes à divulguer suffisamment d'informations personnelles pour que leur identité puisse être usurpée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f95d127-396b-42ac-a886-70c613398d77",
                        "source_entry_id": "927c3528-c13b-395b-b293-87bd15d6ccf0",
                        "source_sense_id": "c06d94bf-db9d-3598-ae56-0d95d8e3ee9d",
                        "target_lang_word": "trahir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trahir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a851dfa-e1fd-3350-9eba-97a8e247d651",
                                        "entry_id": "d77dd896-98d4-3efa-b0c4-03cc93d0c9a9",
                                        "glosses": [
                                            "Faire une perfidie à quelqu’un ; lui manquer de foi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e47369-2f4a-4669-9ea5-ed573669b3ef",
                                                "sense_id": "6a851dfa-e1fd-3350-9eba-97a8e247d651",
                                                "text": "Monsieur, répondit la reine, je puis ne pas aimer mon mari, mais personne n’a le droit d’exiger de moi que je le trahisse. De bonne foi, trahiriez-vous les secrets de la princesse de Porcian, votre femme ?"
                                            },
                                            {
                                                "example_id": "63573cf4-6883-4b57-ab71-aec8f5e4d085",
                                                "sense_id": "6a851dfa-e1fd-3350-9eba-97a8e247d651",
                                                "text": "Je fus stupide et naïf, je méritai ce qui m'arriva. Je me fis détrousser. Peu m'importait l'argent que je perdis. On me trahit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53e6d38-d671-347e-b4bf-3ad2dd1e6ed9",
                                        "entry_id": "d77dd896-98d4-3efa-b0c4-03cc93d0c9a9",
                                        "glosses": [
                                            "Manquer de respect ou de considération, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d57049c-c089-49b7-841c-bf938495244e",
                                                "sense_id": "a53e6d38-d671-347e-b4bf-3ad2dd1e6ed9",
                                                "text": "Oui, mon père à peine en terre, j'étais coupable, oubliant mon deuil, trahissant mon chagrin et son souvenir."
                                            },
                                            {
                                                "example_id": "94b71b4c-05a5-44ce-89d5-83b45c20b01b",
                                                "sense_id": "a53e6d38-d671-347e-b4bf-3ad2dd1e6ed9",
                                                "text": "Trahir les intérêts de quelqu’un, la confiance de son ami."
                                            },
                                            {
                                                "example_id": "1c142054-dde8-42c2-92dd-8c824a95c825",
                                                "sense_id": "a53e6d38-d671-347e-b4bf-3ad2dd1e6ed9",
                                                "text": "Trahir la vérité, sa conscience, son devoir, sa promesse, sa foi, ses serments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3de1fee5-e1a2-37b7-b39e-cd8265f12f53",
                                        "entry_id": "d77dd896-98d4-3efa-b0c4-03cc93d0c9a9",
                                        "glosses": [
                                            "Livrer son pays, sa patrie ; agir par perfidie contre la sécurité de son pays."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e4a19f9-0bd6-3587-8481-48fc8a623cf4",
                                        "entry_id": "d77dd896-98d4-3efa-b0c4-03cc93d0c9a9",
                                        "glosses": [
                                            "Découvrir ou révéler ce qu’on voulait tenir caché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d473f099-c751-4de7-9ece-e047c26cc574",
                                                "sense_id": "0e4a19f9-0bd6-3587-8481-48fc8a623cf4",
                                                "text": "Maudit accent qui me trahit toujours ! C’est vrai, j’arrive d’Italie."
                                            },
                                            {
                                                "example_id": "a31251f3-824d-4ece-b284-3d0f0f7c35fa",
                                                "sense_id": "0e4a19f9-0bd6-3587-8481-48fc8a623cf4",
                                                "text": "Pensant à son accoutrement, il se défit de son faux-col et de sa casquette blanche d’aéronaute, qui pouvaient le trahir, […]."
                                            },
                                            {
                                                "example_id": "92992c47-e3b0-4d0b-a1d7-a22bc62efe9a",
                                                "sense_id": "0e4a19f9-0bd6-3587-8481-48fc8a623cf4",
                                                "text": "Sa figure intelligente, dont les traits et le teint trahissaient une assez forte proportion de sang soudanais, […], prenait par moments une expression de grande affabilité."
                                            },
                                            {
                                                "example_id": "c922681f-7832-4682-98f1-2e4d61c0487f",
                                                "sense_id": "0e4a19f9-0bd6-3587-8481-48fc8a623cf4",
                                                "text": "Rien dans son regard ne trahissait jamais la moindre pitié, c’était un pur soldat, dépourvu d’états d'âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbaaedf9-8c53-30c9-bc21-f787734ab068",
                                        "entry_id": "d77dd896-98d4-3efa-b0c4-03cc93d0c9a9",
                                        "glosses": [
                                            "Surprendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9b9ee2-7849-43a9-9cb2-f7b359829313",
                                                "sense_id": "cbaaedf9-8c53-30c9-bc21-f787734ab068",
                                                "text": "S’il lui arrivait à présent de trahir un lapin au taillis, assis sur son derrière […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc7a48d-6638-3e53-ae48-f78215ee201c",
                                        "entry_id": "d77dd896-98d4-3efa-b0c4-03cc93d0c9a9",
                                        "glosses": [
                                            "Ne pas seconder, desservir, rendre vain, décevoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ee71d3-e15b-4f8e-a613-f9ee95261446",
                                                "sense_id": "cfc7a48d-6638-3e53-ae48-f78215ee201c",
                                                "text": "La fortune a trahi nos efforts."
                                            },
                                            {
                                                "example_id": "62f89af8-7983-444a-86e2-62d8772da04e",
                                                "sense_id": "cfc7a48d-6638-3e53-ae48-f78215ee201c",
                                                "text": "Les événements trahirent ses espérances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1523cc-d72f-3dc0-bbfe-cd59a296bdfc",
                                        "entry_id": "d77dd896-98d4-3efa-b0c4-03cc93d0c9a9",
                                        "glosses": [
                                            "Agir contre ses propres intérêts."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742d4b71-cab4-45d2-aa0d-8a434d638772",
                                                "sense_id": "9d1523cc-d72f-3dc0-bbfe-cd59a296bdfc",
                                                "text": "Il s’est trahi lui-même en cette affaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41427b17-a80a-45bb-80db-8b518540e2b8",
                        "source_entry_id": "927c3528-c13b-395b-b293-87bd15d6ccf0",
                        "source_sense_id": "c06d94bf-db9d-3598-ae56-0d95d8e3ee9d",
                        "target_lang_word": "vendre la mèche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendre la mèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a25698a-5efd-3d8b-9204-81d69ca94efb",
                                        "entry_id": "2d1c6e33-867c-342b-8c19-c7de9d813efe",
                                        "glosses": [
                                            "Révéler quelque chose qui aurait dû rester secret."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "679cbbfb-20b1-42de-a066-db434b4310df",
                                                "sense_id": "9a25698a-5efd-3d8b-9204-81d69ca94efb",
                                                "text": "Découvrir, éventer la mèche, découvrir au moyen d’une contremine l’endroit où une mine a été pratiquée, et enlever la mèche qui devait mettre le feu, et fig. découvrir le secret d’un complot, d’une affaire (vendre la mèche est une locution populaire vicieuse)."
                                            },
                                            {
                                                "example_id": "a0e2eee2-e1d5-49ae-a24c-8e187859b5bc",
                                                "sense_id": "9a25698a-5efd-3d8b-9204-81d69ca94efb",
                                                "text": "Ne croyez pas, messieurs, que j’aie retrouvé le sens de l’ouïe. Hélas non. Mais vous m’aviez déjà fait ce coup-là l’année dernière. Je n’avais pas compris, bien entendu. Mais votre manège m’avait intrigué. Et comme j’interrogeais une personne qui avait assisté à la scène, cette personne me vendit la mèche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
