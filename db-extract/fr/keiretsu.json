                                        "glosses": [
                                            "A set of Japanese companies with interlocking business relationships and shareholdings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aabb7f4-2042-47a8-83ff-1026a7d23fc0",
                                                "sense_id": "f3836524-31ff-3a6f-9634-f6b2eaddf859",
                                                "text": "Japan's keiretsu—or families of firms in large scratch-each-other's back networks—supported this or that faction in the LDP, producing a highly successful, structurally corrupt model of economic development that showed remarkable resilience through Japan's high growth economic period."
                                            }
