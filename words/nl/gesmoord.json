            "senses": [
                {
                    "sense_id": "cf9280f8-f29d-351f-b1f1-7767133db203",
                    "sense_definition": "bereid door langzaam te garen in een gesloten pan met een kleine hoeveelheid vocht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We eten vanavond <w>gesmoorde</w> spruiten met spek en ui.",
                            "target_lang_translations": {
                                "en": "Tonight we are eating <w>braised</w> Brussels sprouts with bacon and onion."
                            }
                        },
                        {
                            "text": "De kok serveerde een heerlijke <w>gesmoorde</w> kabeljauw met verse radijs.",
                            "target_lang_translations": {
                                "en": "The chef served a delicious <w>braised</w> cod with fresh radish."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gesmoorde groenten",
                        "gesmoorde vis"
                    ],
                    "target_lang_definitions": {
