                "senses": [
                    {
                        "sense_id": "505d99bf-8b65-3ffa-915f-b0f7c578b985",
                        "entry_id": "faf2eb75-2af2-3adb-a019-dab8ab7e849b",
                        "glosses": [
                            "To surround something with a halo."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8c3cd7fb-0402-4c9f-adf7-3aad22f1caf3",
                                "sense_id": "505d99bf-8b65-3ffa-915f-b0f7c578b985",
                                "text": "Does not every bird's eye in its sapphire excellence recall a trusty bénédicité, \"speed well,\"—the story of lives compressed in two words? Smiles and tears enhalo it, and it surely accelerates our buoyancy of movement to the rivulet, where forget-me-nots—a treasure trove—are garrisoned by King Cup and Spear-grass."
                            },
                            {
                                "example_id": "6e1fbe8b-0027-446f-97f8-559989e94781",
                                "sense_id": "505d99bf-8b65-3ffa-915f-b0f7c578b985",
                                "text": "I turned and looked down the slope of the hill to where, enhaloed now in birds, stood those other two Martians that I had seen over-night, just as death had overtaken them."
                            }
                        ]
                    }
