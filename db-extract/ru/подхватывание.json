                "translations": [
                    {
                        "translation_id": "5206c69c-957c-4683-b55e-6681dad670c3",
                        "source_entry_id": "b2e877bb-e2b1-391d-8329-324a57e377ab",
                        "source_sense_id": "aebb6c10-f57f-3976-9e78-ae3b6c1f63d8",
                        "target_lang_word": "reprise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reprise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8286996f-f825-3f40-8484-692191321b41",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Action de reprendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72adb3ac-f1fa-4b87-99db-e324e23846a1",
                                                "sense_id": "8286996f-f825-3f40-8484-692191321b41",
                                                "text": "Les citoyennes des halles apportent un don patriotique en réjouissance de la reprise de Toulon : elles demandent grâce en faveur du citoyen Vizon, condamné à la déportation par un jugement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bfe633-d188-3ade-8bff-570e2e378790",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Portion d’une partition que le musicien doit jouer deux fois ou plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010578a7-ff1a-42b9-89ea-84088efdc880",
                                                "sense_id": "c6bfe633-d188-3ade-8bff-570e2e378790",
                                                "text": "Pour cette répétition, par manque de temps, nous ne ferons pas les reprises."
                                            },
                                            {
                                                "example_id": "fa9640aa-c842-4056-9d61-182203831c3a",
                                                "sense_id": "c6bfe633-d188-3ade-8bff-570e2e378790",
                                                "text": "Là, la reprise doit être jouée sostenuto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa532408-7404-3e9d-898d-318dd8c9cf2d",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Œuvre interprétée par quelqu’un qui n’est pas l’artiste original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5770c354-a94c-4b01-be18-da7b8775d7fd",
                                                "sense_id": "fa532408-7404-3e9d-898d-318dd8c9cf2d",
                                                "text": "La version que tu connais est une reprise d’une chanson des années soixante."
                                            },
                                            {
                                                "example_id": "fff1d8e5-158b-4f38-a936-bc7127389c9a",
                                                "sense_id": "fa532408-7404-3e9d-898d-318dd8c9cf2d",
                                                "text": "Ce groupe est accusé de ne rien produire d’original, se contentant de faire des reprises d’autres titres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "543715a8-f3aa-382c-88fd-e1429592ac4f",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Action de reprendre après une pause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4bd0906-884c-4ccd-80d0-37aa3cee4395",
                                                "sense_id": "543715a8-f3aa-382c-88fd-e1429592ac4f",
                                                "text": "Il fut touché à la troisième reprise."
                                            },
                                            {
                                                "example_id": "519d1bfd-63a6-434c-bd83-92c5e1aabd83",
                                                "sense_id": "543715a8-f3aa-382c-88fd-e1429592ac4f",
                                                "text": "J’ai fait trois reprises sur ce cheval."
                                            },
                                            {
                                                "example_id": "40f67ee1-5e3c-4887-99b1-489ae87939b0",
                                                "sense_id": "543715a8-f3aa-382c-88fd-e1429592ac4f",
                                                "text": "Faire une reprise au pas, au trot, au galop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867d6201-fc43-3fe6-9cd2-19cd91be1c2a",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Rediffusion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98b121ba-6bd3-3df6-83a7-cebd7e887a36",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Ce qui est repris."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "189503ac-b96a-372d-958c-01027f7908e3",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Ce que chacun des époux a droit, par lui ou ses représentants, de prélever, avant partage, sur la masse des biens de la communauté, lorsqu’elle est dissoute."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8df5481-881f-44d9-affd-5ddcbe01e11d",
                                                "sense_id": "189503ac-b96a-372d-958c-01027f7908e3",
                                                "text": "Les reprises de la femme s’exercent avant celles du mari."
                                            },
                                            {
                                                "example_id": "f08cb78f-7567-4e3a-8368-f4c08ff96c00",
                                                "sense_id": "189503ac-b96a-372d-958c-01027f7908e3",
                                                "text": "En cas d’insuffisance de la communauté, la femme ou ses héritiers exercent leurs reprises sur les biens personnels du mari."
                                            },
                                            {
                                                "example_id": "78176a00-9580-4450-90ac-f37fedbf9994",
                                                "sense_id": "189503ac-b96a-372d-958c-01027f7908e3",
                                                "text": "Ils ont eu telle propriété pour leurs reprises."
                                            },
                                            {
                                                "example_id": "7f02649a-37e2-4e19-a25c-1f230ca1d39a",
                                                "sense_id": "189503ac-b96a-372d-958c-01027f7908e3",
                                                "text": "Reprises matrimoniales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ed6b1a-6b95-38fe-a742-1148798a7f43",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Navire capturé par les ennemis et repris ensuite par la nation sur laquelle il avait été pris."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdcc679b-0bec-321c-acb4-91be2354979e",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Continuation de ce qui a été interrompu, réitération de ce qui a déjà été fait, recommencement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5acdaf4-a9cf-44a2-91b9-bdd1c2a23dde",
                                                "sense_id": "bdcc679b-0bec-321c-acb4-91be2354979e",
                                                "text": "Depuis 2 ans, tel que précisé à quelques reprises dans mon blogue, j'aide quelques garçons anglophones en français."
                                            },
                                            {
                                                "example_id": "21647cb8-7dd2-44cf-8dab-fe775751ff0b",
                                                "sense_id": "bdcc679b-0bec-321c-acb4-91be2354979e",
                                                "text": "À plusieurs reprises, à différentes reprises : Plusieurs fois, différentes fois."
                                            },
                                            {
                                                "example_id": "f833ba59-745a-468a-b726-4955ae343333",
                                                "sense_id": "bdcc679b-0bec-321c-acb4-91be2354979e",
                                                "text": "À plusieurs reprises, il s’était frotté joyeusement les mains, ce qui, chez lui, ne pouvait passer pour une satisfaction banale."
                                            },
                                            {
                                                "example_id": "822897dc-15eb-4c90-b3b1-403ecde30798",
                                                "sense_id": "bdcc679b-0bec-321c-acb4-91be2354979e",
                                                "text": "Quelques invités et festivaliers se sont désistés au dernier moment, en raison de la reprise de l’épidémie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53977cd2-feae-30e2-b183-0b754510be52",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Continuation de ce qui a été interrompu, réitération de ce qui a déjà été fait, recommencement.",
                                            "En particulier, reprise d'un service d'une société concurrente concurrent à l'occasion d'un changement de contrat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b8f37f-21be-4d1e-81da-5107e7c840f8",
                                                "sense_id": "53977cd2-feae-30e2-b183-0b754510be52",
                                                "text": "Mais la reprise de l’exploitation des TER entre Marseille et Nice n’en demeure pas moins « l’opération la plus importante [pour l’entreprise] cette année », selon les mots de son PDG, Thierry Mallet, rencontré à la gare Saint-Charles de Marseille en mai, lors de la présentation des nouveaux trains de la ligne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c3d2d3-fe68-3857-b955-76f90ad1968d",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Renouvellement et continuation d’un procès interrompu, lorsqu’il y a eu changement de parties ou d’avoué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f197496-af51-48d1-930e-5db7c8a83f21",
                                                "sense_id": "10c3d2d3-fe68-3857-b955-76f90ad1968d",
                                                "text": "Assigner en reprise d’instance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f56d20-0ef6-329d-acee-9f5dd0dd6e12",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Réparation, souvent assez mineure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "020ddf0a-03c8-303f-bee4-b7d06f90d558",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Réparation, souvent assez mineure.",
                                            "Réparation qu’on fait à un mur, à un pilier, etc., soit à la surface, soit dans les fondations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244288e6-65f7-410a-a754-ae992689cdb3",
                                                "sense_id": "020ddf0a-03c8-303f-bee4-b7d06f90d558",
                                                "text": "Il y a des reprises à faire à cette façade."
                                            },
                                            {
                                                "example_id": "d3d70050-fc12-4fae-85f7-358106e55eb5",
                                                "sense_id": "020ddf0a-03c8-303f-bee4-b7d06f90d558",
                                                "text": "Reprise en sous-œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a126476b-2a2f-391b-8af5-27183305fb52",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Réparation, souvent assez mineure.",
                                            "Réparation qu’on fait à une étoffe, à une dentelle qui a été déchirée, à un tissu dont une maille s’est échappée. → voir repriser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c626733-1d2d-4da8-835c-cdfa3bb3b352",
                                                "sense_id": "a126476b-2a2f-391b-8af5-27183305fb52",
                                                "text": "[…] le raccommodage de ses effets m’incombait, naturellement !\nJe m’absorbais de mon mieux dans mes reprises et modérais mon aiguille […]"
                                            },
                                            {
                                                "example_id": "ccd4cf85-c003-420d-a845-14ea44c19b59",
                                                "sense_id": "a126476b-2a2f-391b-8af5-27183305fb52",
                                                "text": "Elle cousait comme elle cuisinait. Ses reprises pour réparer un accroc consistaient à rapprocher les deux bords du trou, à passer un fil et serrer bien fort, ce qui donnait de curieux plis à ses robes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ddaf8b8-ffa7-3c3a-903c-1cea3cf2e517",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Réparation, souvent assez mineure.",
                                            "Restauration de la fonctionnalité et de la conformité aux spécifications d’un produit (vs la « réparation », qui elle ne garantit pas la conformité)."
                                        ],
                                        "tags": [
                                            "Électrotechnique",
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8fe86a3-6830-474c-a628-0cd5f7293423",
                                                "sense_id": "7ddaf8b8-ffa7-3c3a-903c-1cea3cf2e517",
                                                "text": "Reprise – L’action de fabriquer à nouveau des produits non conformes, au travers de l’utilisation du processus originel ou d’un équivalent, d’une manière qui assure la conformité intégrale du produit avec les plans ou spécifications applicables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d2167b-d63f-3662-809f-35e500115e82",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Rachat, action de reprendre des actifs financiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75527c68-92c6-3232-a3fe-8fd8c9f7497f",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Période de combat de trois minutes, suivie d'une pause d'une minute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272c847f-2150-44ab-822d-4c3da0b8a0ba",
                                                "sense_id": "75527c68-92c6-3232-a3fe-8fd8c9f7497f",
                                                "text": "Le boxeur britannique Anthony Joshua a battu ce samedi 12 décembre à Londres, le Bulgare Kubrat Pulev, par KO à la 9ᵉ reprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f780030-fb93-389a-8726-6c23cd38402e",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Maintien en vie, puis redémarrage de la croissance d’une plante après plantation."
                                        ],
                                        "tags": [
                                            "Arboriculture",
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29008839-4032-40f8-a93c-8a9aa6d59ffd",
                                                "sense_id": "4f780030-fb93-389a-8726-6c23cd38402e",
                                                "text": "Aucun regarni n’est à prévoir tant que le taux de reprise est supérieur à 80 %. Leur opportunité sera examinée avec attention si le taux de reprise est inférieur, selon les mêmes principes que pour la régénération naturelle (pas d’acharnement dans des trouées d’origine « naturelle »)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4719d84b-2d8a-3557-a23d-6ee77c68328f",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Couple, capacité d'un véhicule à reprendre de la vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3441eaca-322e-48c2-86cb-c91f22d7be5c",
                                                "sense_id": "4719d84b-2d8a-3557-a23d-6ee77c68328f",
                                                "text": "Une conduite rapide et sure, de brillantes accélérations sans dérapages, tenue de route en toute circonstance, stabilité, reprise et aptitude à surmonter les conditions meme les plus critiques : tels sont les objectifs visés dans la conception d'une voiture hautement performante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607c6d36-6227-3acf-970f-e93b18f95c72",
                                        "entry_id": "92a930d5-d814-38dc-8ea5-8f1173a0c3ed",
                                        "glosses": [
                                            "Somme d’argent versée par le nouvel occupant d’un bien au locataire précédent pour l’indemniser des dépenses engagées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e6cc45-c4c8-4db9-8fa6-896b1d859566",
