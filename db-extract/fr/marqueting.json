                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffb8197b-ad12-3e43-a463-21fd28bdc7ac",
                                        "entry_id": "5b490e79-6391-3c6c-886c-d1155ee611c6",
                                        "glosses": [
                                            "Buying and/or selling in a market (street market or market fair)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b7e8fae-e384-4a2c-8f9b-1d1074c2804c",
                                                "sense_id": "ffb8197b-ad12-3e43-a463-21fd28bdc7ac",
                                                "text": "The final result of the extreme seasonality of marketings of cattle and calves in Arkansas would have been an inshipment of either slaughter cattle or block beef and beef products during three quarters of the year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "995778a8-9713-3146-a003-1f8ee721bcdb",
                                        "entry_id": "5b490e79-6391-3c6c-886c-d1155ee611c6",
                                        "glosses": [
                                            "Buying and/or selling in a market (street market or market fair).",
                                            "Shopping, going to market as a buyer."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edd4cc58-83a2-4137-8f07-0653a27a95a5",
                                                "sense_id": "995778a8-9713-3146-a003-1f8ee721bcdb",
                                                "text": "Although Miss Pross, through her long association with a French family, might have known as much of their language as of her own, if she had had a mind, she had no mind in that direction […] So her manner of marketing was to plump a noun-substantive at the head of a shopkeeper without any introduction in the nature of an article […]"
                                            },
                                            {
                                                "example_id": "8430713e-126f-44b7-a22f-99c65ef507ef",
                                                "sense_id": "995778a8-9713-3146-a003-1f8ee721bcdb",
                                                "text": "[Wife to husband:] I'm going out to do my marketing – keep out of the kitchen, while I'm gone."
                                            },
                                            {
                                                "example_id": "09a19e68-f737-487d-8476-905310396a26",
                                                "sense_id": "995778a8-9713-3146-a003-1f8ee721bcdb",
                                                "text": "We did everything from laundry to house cleaning, washing dishes to cooking, and even marketing. Since I was gifted with the skills to cook, I volunteered to help out in the kitchen and do the marketing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fb103b-a01b-3e18-947b-360b9b051009",
                                        "entry_id": "5b490e79-6391-3c6c-886c-d1155ee611c6",
                                        "glosses": [
                                            "Buying and/or selling in a market (street market or market fair).",
                                            "Attending market as a seller."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40a07b63-3d54-4998-b4c9-0c2a499328ca",
                                                "sense_id": "52fb103b-a01b-3e18-947b-360b9b051009",
                                                "text": "Marketing was a time-consuming task for truck farming families, as the round trip could take most of the day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ff8c50-0bed-36e7-9c5e-45ceaf55e01c",
                                        "entry_id": "5b490e79-6391-3c6c-886c-d1155ee611c6",
                                        "glosses": [
                                            "The promotion, distribution and selling of a product or service; the work of a marketer; includes market research and advertising."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9bdb08-ed77-4184-a53e-84ed7313771b",
                                                "sense_id": "71ff8c50-0bed-36e7-9c5e-45ceaf55e01c",
                                                "text": "a bachelor's degree in marketing"
                                            },
                                            {
                                                "example_id": "6fddabf5-6908-43e4-8b7e-c1b452de5156",
                                                "sense_id": "71ff8c50-0bed-36e7-9c5e-45ceaf55e01c",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result."
                                            },
                                            {
                                                "example_id": "61f5a0c8-3279-4ca5-8c1d-4e5f72cd8110",
                                                "sense_id": "71ff8c50-0bed-36e7-9c5e-45ceaf55e01c",
                                                "text": "Between 2000 and 2019, North Dakota and South Dakota both experienced a rapid increase in the Asian American population, said Minnesota State University Moorhead marketing professor Hyun Sang An."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
