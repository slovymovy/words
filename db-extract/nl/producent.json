                    {
                        "sense_id": "dcb6d69f-0269-3bcf-887f-b1d97e9feaee",
                        "entry_id": "8781f424-2bc4-35af-85f9-b942f1a58d2b",
                        "glosses": [
                            "iemand die (producten of diensten) produceert"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3af4dc6a-454e-4425-a457-9bd86145a845",
                                "sense_id": "dcb6d69f-0269-3bcf-887f-b1d97e9feaee",
                                "text": "De Nationale 7 past in dit ideaal van slow driving. Je rijdt door plaatsen die je alleen kent van de borden boven de snelweg. Nevers, Lyon, Valence, Montélimar. Zo vind je jezelf terug op een warme zomeravond op een pleintje in de oude stad van Montélimar, bij restaurant Aux Gourmands, waar de ober vertelt dat de pistachenoten bij de tarte tatin afkomstig zijn van een lokale producent die maar twee bomen heeft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a7f704a-f3e5-4965-b80f-ecd064fe457f",
                        "source_entry_id": "8781f424-2bc4-35af-85f9-b942f1a58d2b",
                        "source_sense_id": "dcb6d69f-0269-3bcf-887f-b1d97e9feaee",
                        "target_lang_word": "Produzent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Produzent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5a70b58-1813-3bda-a02a-6186ac69ffb2",
                                        "entry_id": "5620d49f-4c9f-36f0-88de-fe04a724f853",
                                        "glosses": [
                                            "Person oder Betrieb, die etwas produziert, herstellt oder erzeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0df253e-6eba-4af0-a29c-b2098f7ab83e",
                                                "sense_id": "f5a70b58-1813-3bda-a02a-6186ac69ffb2",
                                                "text": "„Wenn ein großer Produzent wie Gazprom mit einem großen Händler wie RWE zusammengehe, sei dies nicht unproblematisch für den Wettbewerb, hieß es bei der Behörde - zumal Gazprom in Deutschland bereits zusammen mit BASF den Gasversorger Wingas betreibe.“"
                                            },
                                            {
                                                "example_id": "b74e21c7-1698-409e-be6e-3498c22b61b2",
                                                "sense_id": "f5a70b58-1813-3bda-a02a-6186ac69ffb2",
                                                "text": "„Endlich kam eine elegante, rundliche Dame mittleren Alters und führte ihn durch eine Flucht von Büros zu der Suite des Produzenten.“"
                                            },
                                            {
                                                "example_id": "ee8e4fe4-1381-4832-939a-9c9b41003250",
                                                "sense_id": "f5a70b58-1813-3bda-a02a-6186ac69ffb2",
                                                "text": "„Er läuft monatelang, wird ein Publikumsrenner und bringt dem Produzenten und dem Regisseur den damals noch neuen, aber bereits begehrten Oscar ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d925a33-17a8-4b7e-808d-2f6f46944858",
                        "source_entry_id": "8781f424-2bc4-35af-85f9-b942f1a58d2b",
                        "source_sense_id": "dcb6d69f-0269-3bcf-887f-b1d97e9feaee",
