                        "glosses": [
                            "Qui peut être déguisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb2ea73e-13cf-4e98-8ddd-20d0db6d2b5d",
                                "sense_id": "ffbc7c7d-4c05-3310-9a0d-0bf7eaf5d509",
                                "text": "Il avait pensé de nouveau à ces hasards enchaînés, si aisément déguisables en messagers du Destin ; et il n’aimait pas que le Destin se mêlât de ses affaires."
                            },
                            {
                                "example_id": "6293d42e-285e-4dc6-9ea9-eb32deb63188",
                                "sense_id": "ffbc7c7d-4c05-3310-9a0d-0bf7eaf5d509",
                                "text": "Une contrefaçon de fleurs. Mais leur forme d’insectes n’était pas déguisable."
                            },
                            {
                                "example_id": "1fff7792-cf75-4a82-83bd-8412512629b4",
                                "sense_id": "ffbc7c7d-4c05-3310-9a0d-0bf7eaf5d509",
                                "text": "Comme Athéna dans son épiphanie au chant XIII et Ulysse au chant XXIII, le héros est ici révélé à son fils comme étant changeable, déguisable. Et c’est la façon littéraire de définir l’effet rétroactif du déguisement : lorsque l’entité déguisée est reconnue comme déguisée, elle devient « déguisable »."
                            }
                        ]
                    }
