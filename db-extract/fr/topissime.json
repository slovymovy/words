                        "glosses": [
                            "Tout à fait top, excellent."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3a38bf73-ee41-49ff-8571-8ff0aa7dd402",
                                "sense_id": "4b063dcd-17d1-3047-9529-93703c1bbf0e",
                                "text": "Je t’ai fait part de ce néologisme fondé sur le mot anglais top, le sommet, entendu à la télévision de la bouche d’une jeune femme qui se réjouissait d’avoir des amis « topissimes » !"
                            },
                            {
                                "example_id": "b5150bba-dbe3-4a4b-9496-d5955043b9de",
                                "sense_id": "4b063dcd-17d1-3047-9529-93703c1bbf0e",
                                "text": "Tu as été topissime."
                            },
                            {
                                "example_id": "4276b223-57df-4dc8-8f17-92f1bf72daa1",
                                "sense_id": "4b063dcd-17d1-3047-9529-93703c1bbf0e",
                                "text": "La galette cancalaise aux pommes de terre et hareng fumé artisanalement est topissime et la crêpe au caramel et beurre salé avec une glace au caramel au beurre salé est à manger un genou en terre."
                            },
                            {
                                "example_id": "090db5bf-bc08-446a-841c-5fc125f02730",
                                "sense_id": "4b063dcd-17d1-3047-9529-93703c1bbf0e",
                                "text": "Ébloui par sa propre réussite, il roule Maserati, fume des joints, mène son portable à ébullition, fréquente Saint-Trop' et la trouve « topissime »."
                            }
                        ]
                    }
