                            {
                                "example_id": "b053a835-f0c2-4f31-80e7-24c6881a0f63",
                                "sense_id": "79ceb140-0c06-3bad-ad5f-0f1a6a387a38",
                                "text": "La biguine possède de nombreux traits communs avec le jazz de la Nouvelle Orléans."
                            },
                            {
                                "example_id": "91ff10da-6b2b-48f9-b567-5dbeae8a0e10",
                                "sense_id": "79ceb140-0c06-3bad-ad5f-0f1a6a387a38",
                                "text": "Vous vous demandiez pourquoi cet homme déversait, à plein régime, une musique capable de mettre le feu aux entrailles d’un mort. Biguine ! Salsa ! Compas ! Calypso ! Mazurka ! Feu et feu !"
                            }
                        ]
                    }
