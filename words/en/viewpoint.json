{
    "word_family": [
        "view",
        "point",
        "viewer",
        "viewable",
        "viewing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cfa55cd7-818b-3bae-982a-8de4d068f4ff",
                    "sense_definition": "A particular way of thinking about or considering something; an opinion or perspective.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From a financial <w>viewpoint</w>, the project was a complete success for the company.",
                            "target_lang_translations": {
                                "ru": "С финансовой <w>точки зрения</w> проект стал полным успехом для компании."
                            }
                        },
                        {
                            "text": "It is important to consider every different <w>viewpoint</w> before making a final decision.",
                            "target_lang_translations": {
                                "ru": "Важно рассмотреть каждую различную <w>точку зрения</w> перед принятием окончательного решения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "different viewpoint",
                        "personal viewpoint",
                        "from my viewpoint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный способ мышления или рассмотрения чего-либо; мнение или перспектива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точка зрения",
                                "target_lang_sense_clarification": "мнение или позиция по вопросу"
                            },
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "способ понимания или оценки чего-либо"
                            },
                            {
                                "target_lang_word": "ракурс",
                                "target_lang_sense_clarification": "аспект, с которого рассматривается проблема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53ea04da-8fe1-3ed0-b5ed-d8de739c76fc",
                    "sense_definition": "A physical place or position from which you can see something clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers reached a scenic <w>viewpoint</w> that offered a stunning look at the valley below.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы добрались до живописной <w>смотровой площадки</w>, с которой открывался потрясающий вид на долину внизу."
                            }
                        },
                        {
                            "text": "From the top of the hill you get a good <w>viewpoint</w> of the town.",
                            "target_lang_translations": {
                                "ru": "С вершины холма открывается хорошая <w>точка обзора</w> на город."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scenic viewpoint",
                        "excellent viewpoint",
                        "mountain viewpoint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое место или позиция, с которой можно что-то четко видеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смотровая площадка",
                                "target_lang_sense_clarification": "специально оборудованное место для обзора"
                            },
                            {
                                "target_lang_word": "точка обзора",
                                "target_lang_sense_clarification": "место, откуда открывается вид"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}