                                                "sense_id": "f6250ddb-9b89-3dee-a9f1-b36df44e8837",
                                                "text": "Little children were playing in the drowsy river sunset; girls were going by with bandannas and cotton blouses and bare legs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66f4f9f6-a838-4ef6-ad89-957693e7bc4d",
                        "source_entry_id": "a9a043d5-28e3-3987-9dd3-50982b55b4a7",
