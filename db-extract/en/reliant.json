                                                "sense_id": "d1311d5a-6e8f-32e6-844c-7d5f02d3871f",
                                                "text": "Als Arbeitsloser ist man auf Hilfe vom Staat angewiesen."
                                            },
                                            {
                                                "example_id": "1320f622-7b42-49a0-9a49-15ddc9d2c9b3",
                                                "sense_id": "d1311d5a-6e8f-32e6-844c-7d5f02d3871f",
                                                "text": "„Eine […] Patientengruppe, die oft bereits ohne SARS-CoV-2-Infektion auf langwierige medizinische Betreuung angewiesen ist, sind Krebskranke.“"
                                            },
                                            {
                                                "example_id": "7b538227-0169-479b-aba1-067ffed9160f",
                                                "sense_id": "d1311d5a-6e8f-32e6-844c-7d5f02d3871f",
                                                "text": "„Der Steinkauz ist eine der Vogelarten, der auf die lichten Baumbestände der Streuobstwiesen angewiesen ist.“"
                                            },
                                            {
                                                "example_id": "ef6b0127-7100-446b-ae85-ca85f706a458",
                                                "sense_id": "d1311d5a-6e8f-32e6-844c-7d5f02d3871f",
                                                "text": "Als auxotroph bezeichnet man Organismen, die bestimmte essentielle Substanzen nicht selbstständig synthetisieren können. Somit sind sie darauf angewiesen, diese Stoffe aus der Umwelt aufzunehmen."
                                            },
                                            {
                                                "example_id": "23aa6b9c-0b8c-48e9-955a-57e11282570f",
                                                "sense_id": "d1311d5a-6e8f-32e6-844c-7d5f02d3871f",
                                                "text": "„Zahlreiche Pilze, Insekten und Pflanzen sind auf Totholz angewiesen, zudem trägt der Zersetzungsprozess zur Humusbildung des Waldbodens bei.“"
                                            },
                                            {
                                                "example_id": "a0dc96d6-1eb5-4062-b688-df8347541f5b",
                                                "sense_id": "d1311d5a-6e8f-32e6-844c-7d5f02d3871f",
                                                "text": "„93 Prozent der jüdischen Seniorinnen und Senioren in Deutschland sind auf Grundsicherung angewiesen – im Vergleich zu 2,4 Prozent der deutschen Rentnerinnen und Rentner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
