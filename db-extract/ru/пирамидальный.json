                "senses": [
                    {
                        "sense_id": "a7682275-0419-3591-afab-93a7eda3802d",
                        "entry_id": "c2171f02-5c0c-3456-b49b-94d15162b717",
                        "glosses": [
                            "имеющий форму пирамиды, напоминающий по форме пирамиду, суживающийся кверху"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "37bc9b25-5c20-3ac2-bbe3-536ad04ab05c",
                        "entry_id": "c2171f02-5c0c-3456-b49b-94d15162b717",
                        "glosses": [
                            "относящийся к финансовой пирамиде"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9215bc3d-b48c-349b-9126-1c0a47a1e6fb",
                        "entry_id": "c2171f02-5c0c-3456-b49b-94d15162b717",
                        "glosses": [
                            "анат. связанный с нервной структурой головного мозга млекопитающих, поддерживающей сложную и тонкую координацию движений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc9569e-627f-4b5e-9526-8fe17c048807",
                                "sense_id": "9215bc3d-b48c-349b-9126-1c0a47a1e6fb",
                                "text": "Для небольших нейронов возможны экстрапирамидальные связи, для относительно крупных констатированы пирамидальные связи."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74513ca5-c758-4564-997e-2171cb0b03c9",
                        "source_entry_id": "c2171f02-5c0c-3456-b49b-94d15162b717",
                        "source_sense_description": "имеющий форму пирамиды",
                        "target_lang_word": "pyramidal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyramidal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a74dac5-e8f5-3490-b51c-0d036b43276f",
                                        "entry_id": "3a620613-5beb-30e5-b6a0-62d3f0aac61d",
                                        "glosses": [
                                            "Pyramid-shaped."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce3d2bd-4e42-4fda-9253-ed6e052637b5",
                                                "sense_id": "8a74dac5-e8f5-3490-b51c-0d036b43276f",
                                                "text": "At one point was an isolated pyramidal rock, crowned by a great tree, which appeared to be separated by a cleft from the main crag."
                                            },
                                            {
                                                "example_id": "b8ef4589-ebeb-4753-9b6c-15bfea91ca18",
                                                "sense_id": "8a74dac5-e8f5-3490-b51c-0d036b43276f",
                                                "text": "Below is the deep abyss of the Lauterbrunnen valley, and at its head a stately semi-circle of mountains, with the pyramidal Lauterbrunnen Breithorn as the centre-piece."
                                            },
                                            {
                                                "example_id": "7ffd1949-603e-4cab-8ecb-816422fa8a1e",
                                                "sense_id": "8a74dac5-e8f5-3490-b51c-0d036b43276f",
                                                "text": "Among its attractive features were decorative, tile-hung Italianate towers with pyramidal roofs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7530d94e-ae85-3897-ac26-44eef8506991",
                                        "entry_id": "3a620613-5beb-30e5-b6a0-62d3f0aac61d",
                                        "glosses": [
                                            "Pyramid-shaped.",
                                            "Tetragonal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pyramidal",
                                "target_lang_code": "en",
