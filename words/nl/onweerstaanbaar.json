    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07d7f245-d3f2-312f-b41e-d71432067f4f",
                    "sense_definition": "zo verleidelijk of aantrekkelijk dat je er geen nee tegen kunt zeggen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verleiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geur van versgebakken brood in de ochtend is simpelweg <w>onweerstaanbaar</w> voor mij.",
                            "target_lang_translations": {
                                "en": "The smell of freshly baked bread in the morning is simply <w>irresistible</w> to me."
                            }
                        },
                        {
                            "text": "Zij heeft een <w>onweerstaanbare</w> drang om elke nieuwe gadget meteen te kopen.",
                            "target_lang_translations": {
                                "en": "She has an <w>irresistible</w> urge to buy every new gadget immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "verleidelijk",
                        "aanlokkelijk"
                    ],
                    "antonyms": [
                        "weerstaanbaar"
                    ],
                    "common_phrases": [
                        "onweerstaanbare drang",
                        "onweerstaanbare glimlach"
                    ],
                    "target_lang_definitions": {
                        "en": "so tempting or attractive that it is impossible to say no to"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irresistible",
                                "target_lang_sense_clarification": "compellingly attractive"
                            },
                            {
                                "target_lang_word": "alluring",
                                "target_lang_sense_clarification": "powerfully and mysteriously attractive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b8b0990-b56c-3303-b43b-62137aaf3183",
                    "sense_definition": "onmogelijk tegen te houden of te stoppen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tranen drongen zich <w>onweerstaanbaar</w> op toen hij het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "The tears welled up <w>irresistibly</w> when he heard the bad news."
                            }
                        },
                        {
                            "text": "Het leger zette een <w>onweerstaanbare</w> opmars in richting de hoofdstad.",
                            "target_lang_translations": {
                                "en": "The army began an <w>irresistible</w> advance toward the capital."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwingend"
                    ],
                    "antonyms": [
                        "weerstaanbaar"
                    ],
                    "common_phrases": [
                        "onweerstaanbare opmars",
                        "zich onweerstaanbaar opdringen"
                    ],
                    "target_lang_definitions": {
                        "en": "impossible to hold back, stop, or oppose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irresistible",
                                "target_lang_sense_clarification": "impossible to resist or oppose"
                            },
                            {
                                "target_lang_word": "overpowering",
                                "target_lang_sense_clarification": "extremely strong or intense"
                            },
                            {
                                "target_lang_word": "unstoppable",
                                "target_lang_sense_clarification": "cannot be prevented from continuing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
