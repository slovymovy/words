                        "entry_id": "9bd29a6e-7147-3f84-a8b7-9735ef92ffd2",
                        "glosses": [
                            "Composé binaire du fluor avec d’autres éléments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d022f5c-6212-41ad-965e-d42c9967ce37",
                                "sense_id": "4e81b905-84d4-35b0-a4bd-582445c50739",
                                "text": "Fluorure d’aluminium."
                            },
                            {
                                "example_id": "b0784a09-bda0-4818-af3e-a102a75a01ac",
                                "sense_id": "4e81b905-84d4-35b0-a4bd-582445c50739",
                                "text": "Les fluorures métalliques s’unissent à l’acide fluorhydrique pour fournir des composés appelés fluorhydrates de fluorures."
                            },
                            {
                                "example_id": "4a842707-d4a7-46ab-9af7-30b3a9e90806",
                                "sense_id": "4e81b905-84d4-35b0-a4bd-582445c50739",
                                "text": "Les homologues vrais ou faux du fluorure de méthyle que l’on connaît sont peu nombreux."
                            }
                        ]
                    }
                ],
