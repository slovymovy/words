                "entry_id": "e512ff20-3dda-313b-ba0f-443421099173",
                "word": "porte-documents",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e216bae4-1669-3e6b-a78d-665e37e54ccb",
                        "entry_id": "e512ff20-3dda-313b-ba0f-443421099173",
                        "glosses": [
                            "Petite valise rectangulaire en cuir ou en plastique généralement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02b69026-c75a-4363-be93-e883cac5c094",
                                "sense_id": "e216bae4-1669-3e6b-a78d-665e37e54ccb",
                                "text": "— Qui ça ? s’étonna Long, levant les yeux des papiers qu’il venait de sortir d’un porte-documents fatigué."
                            },
                            {
                                "example_id": "997bf661-f1db-49f0-b0a9-0fe2684f3388",
                                "sense_id": "e216bae4-1669-3e6b-a78d-665e37e54ccb",
                                "text": "Nos deux porte-documents sont côte à côte dans l’herbe, mais une vie ensemble, loufoque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6ab69dc-db4f-485e-9471-418c9358a35c",
                        "source_entry_id": "e512ff20-3dda-313b-ba0f-443421099173",
                        "source_sense_id": "e216bae4-1669-3e6b-a78d-665e37e54ccb",
                        "target_lang_word": "Aktenmappe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktenmappe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f72cb1-c05b-392f-8587-ad0d6d752530",
                                        "entry_id": "1201ae36-3ad2-32b8-ac36-c6e2ab90ab1e",
                                        "glosses": [
                                            "Tasche, in der Dokumente und Akten transportiert werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d5a79dc-078f-4e89-bddf-d268db2e5227",
                                                "sense_id": "a4f72cb1-c05b-392f-8587-ad0d6d752530",
                                                "text": "Der Bewerber brauchte eine lederne Aktenmappe zum Gespräch, aus der er einen Notizblock zog, um sich im Fall der Fälle Wichtiges notieren zu können. Das machte gehörig Eindruck auf den Abteilungsleiter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03c352b4-9d32-3fd8-a28e-503fe7b04ef3",
                                        "entry_id": "1201ae36-3ad2-32b8-ac36-c6e2ab90ab1e",
                                        "glosses": [
                                            "Sammelmappe aus Pappe für Akten, Zeichnungen und lose Blätter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20fcf0e2-986c-427b-b579-cc1c14bccb63",
                                                "sense_id": "03c352b4-9d32-3fd8-a28e-503fe7b04ef3",
                                                "text": "Im Nachlass des Künstlerehepaares fand man eine Aktenmappe mit noch bis zum heutigen Zeitpunkt unbekannten Zeichnungen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4832eef2-de22-4eb4-badb-dbde258cbd2e",
                        "source_entry_id": "e512ff20-3dda-313b-ba0f-443421099173",
                        "source_sense_id": "e216bae4-1669-3e6b-a78d-665e37e54ccb",
                        "target_lang_word": "Aktentasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktentasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                        "entry_id": "7d46d79a-1d16-30b2-9904-2c71140e1028",
                                        "glosses": [
                                            "Tasche für den Transport von Akten, Büchern und sonstigen Büromaterialien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a97fb5-fbfe-4d34-864e-9a36d29c0cf9",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Während er sprach, schaufelten seine Hände geschäftig Papierbündel aus seiner Aktentasche und ordneten sie auf dem Tisch scheinbar automatisch zu einem exakt abgezirkelten Muster.“"
                                            },
                                            {
                                                "example_id": "0261a994-428b-4634-8b45-8383ce770117",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Er stellt seine Aktentasche auf den Boden, nimmt mir den Besen aus der Hand und beginnt mit vorsichtigen Bewegungen – er trägt Lederschuhe – den Schnee von der Markise zu schütteln.“"
                                            },
                                            {
                                                "example_id": "4845d34f-99f3-4fea-9dff-7f5797d66f7a",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Jonas zog die Collegemappe aus seiner Aktentasche und überreichte sie seinem Gegenüber.“"
                                            },
                                            {
                                                "example_id": "d426ea2c-3e4b-4a02-94e3-da1ee6673c1f",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Sie stellte sich hinter einen großen Schwarzen, der sich eine braune Aktentasche an die Brust drückte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b87a775c-e3b0-4f95-98bc-2d8745aa47bd",
                        "source_entry_id": "e512ff20-3dda-313b-ba0f-443421099173",
                        "source_sense_id": "e216bae4-1669-3e6b-a78d-665e37e54ccb",
                        "target_lang_word": "Aktenkoffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktenkoffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                        "entry_id": "7ae7f275-915c-35da-8405-91d1fa04b4b6",
                                        "glosses": [
                                            "handliches Transportbehältnis für Akten oder sonstige Schriftstücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd318dfa-c09b-4c71-8bd9-be7ff9f4c62d",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "Der Vertreter hatte seinen Aktenkoffer dabei."
                                            },
                                            {
                                                "example_id": "4535258c-873d-4599-b147-21b11865468d",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "„Bekleidet war er mit einer Baseballkappe mit auffälligem X-Emblem, einem schwarzen T-Shirt und einer schwarzen Hose, er trug einen roten Aktenkoffer.“"
                                            },
                                            {
                                                "example_id": "745f509c-19a5-4455-bd05-2e501f2ed959",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "„Schalck holt eine Versicherungspolice aus dem Aktenkoffer und knallt sie auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "df4333f3-d897-421b-81d7-442d1e3e2bfc",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "„Ich werfe den Aktenkoffer daneben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
