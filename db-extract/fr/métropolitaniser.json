                "senses": [
                    {
                        "sense_id": "5ee46363-f1a3-3e70-919a-946c8cea15f4",
                        "entry_id": "26fbcd48-e2fe-30c4-bb7f-0aff79ea92d8",
                        "glosses": [
                            "Donner un caractère métropolitain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1c8dfd-cc75-4d8f-b496-2eb991d4f63d",
                                "sense_id": "5ee46363-f1a3-3e70-919a-946c8cea15f4",
                                "text": "Il est donc inévitable qu’apparaisse une tension entre la reproduction politique du système qui façonne le comportement des responsables des municipalités « métropolitanisées » et la nécessité d’une intervention supra-locale dans le contexte métropolitain."
                            },
                            {
                                "example_id": "baa1db36-1a3e-48c0-86b4-d1041650fa14",
                                "sense_id": "5ee46363-f1a3-3e70-919a-946c8cea15f4",
                                "text": "Là, la « marginalité » peut être radicalement niée, l’altérité recluse dans un territoire également différent, le centre clôturé dans sa totalité, « métropolitanisé »."
                            },
                            {
                                "example_id": "13cbb60b-9751-4304-aa8d-692b66a439d9",
                                "sense_id": "5ee46363-f1a3-3e70-919a-946c8cea15f4",
                                "text": "A ce rythme là il a le tps de \"se métropolitaniser\"."
                            }
                        ]
                    }
