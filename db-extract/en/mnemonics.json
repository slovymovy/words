                    },
                    {
                        "translation_id": "7a205da9-ae6f-425d-8a3c-86ca32b642f7",
                        "source_entry_id": "562a7d17-52cd-32d0-ab7b-ceaa5126fcf7",
                        "source_sense_id": "6135ea37-de68-3290-b8af-5a3e3c59c60f",
