                    "sense_id": "81462d17-5314-31e1-bf6a-582507afbb29",
                    "sense_definition": "een blok met een grillige vorm, vaak een stuk van iets groters",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stuk",
                    "name_type": "no",
