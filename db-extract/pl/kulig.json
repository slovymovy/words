                        "examples": [
                            {
                                "example_id": "2f8f5f7d-c845-4634-8126-893c5c4500ed",
                                "sense_id": "96daec24-4610-3af6-8539-e0ca2d7748a8",
                                "text": "A kulig wciąż pędził galopem, krzycząc, gwiżdżąc, śpiewając, strzelając z batów, choć droga była pełna zatok."
                            },
                            {
                                "example_id": "da8bb429-da88-40b9-ad97-d995fdc23830",
                                "sense_id": "96daec24-4610-3af6-8539-e0ca2d7748a8",
                                "text": "Poczynały się te kuligi zwyczajnie w przedostatni tydzień zapustny i trwały do Wstępnej Środy. Że takowe kuligi najwięcej bawiły się pijatyką i obżarstwem, przeto mniej dbając o tańce, przestawali na jakim takim skrzypku, czasem z karczmy porwanym albo między służącą czeladzią wynalezionym…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
