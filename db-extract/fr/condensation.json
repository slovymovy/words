                        "source_sense_description": "Très fines gouttelettes se déposant par contact de la vapeur d'eau",
                        "target_lang_word": "Kondenswasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kondenswasser",
