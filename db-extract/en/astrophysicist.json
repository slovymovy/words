                                "target_senses": [
                                    {
                                        "sense_id": "70f0c6f1-170b-3e79-9018-9b205a67bb97",
                                        "entry_id": "fa50b40a-b841-3861-9f0c-954f6076f2d1",
                                        "glosses": [
                                            "Femme scientifique qui étudie l’astrophysique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573bb390-fe6a-4516-b0e8-02239622447e",
                                                "sense_id": "70f0c6f1-170b-3e79-9018-9b205a67bb97",
                                                "text": "Nous ferons cet exercice sous forme d’un dialogue entre une astrophysicienne (Suzy) et une philosophe des sciences (Christiane) ne partageant pas toujours les mêmes opinions, et même les partageant rarement."
                                            },
                                            {
                                                "example_id": "a54eb93b-ad7d-481f-8109-d0e647662bd4",
                                                "sense_id": "70f0c6f1-170b-3e79-9018-9b205a67bb97",
                                                "text": "« C’est une surprise qu’il y en ait autant qui se soient formées si tôt », a reconnu l’astrophysicienne Jeyhan Kartaltepe."
                                            },
                                            {
                                                "example_id": "116cc1fb-dd15-46ae-bf59-02d7dab9464c",
                                                "sense_id": "70f0c6f1-170b-3e79-9018-9b205a67bb97",
                                                "text": "Aujourd’hui, l’ado de 14 ans se verrait davantage astrophysicienne qu’actrice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
