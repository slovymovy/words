                                        "glosses": [
                                            "Déclaration écrite et publique par laquelle un souverain, un État, un gouvernement, un parti… fait connaître ses vues sur un certain sujet ou rend raison de sa conduite dans quelque affaire importante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad1cb7c-dcca-47a5-9301-efe6c0e5f550",
                                                "sense_id": "d727f2ed-c68e-3d16-92d9-ed403e8f16c0",
                                                "text": "À la veille des élections, ce parti politique fit publier un manifeste, lança un manifeste."
                                            },
                                            {
                                                "example_id": "60962e57-d483-48cf-9e02-956e329eee98",
                                                "sense_id": "d727f2ed-c68e-3d16-92d9-ed403e8f16c0",
                                                "text": "Un crédo est un manifeste de croyances religieuses ou spirituelles"
                                            },
