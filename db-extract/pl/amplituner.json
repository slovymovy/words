                        "glosses": [
                            "połączenie odbiornika radiowego i wzmacniacza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b023a7fb-9749-4628-9ac2-36d0dbf46a41",
                                "sense_id": "324bea3e-e776-3737-b85a-19cf2f6562de",
                                "text": "Wbudowany w amplituner procesor dźwięku (DSP) pozwala na wybór jednego z wirtualnie generowanych środowisk przestrzennych […]"
                            },
                            {
                                "example_id": "4c95f769-69da-4ad5-9f56-16b596d50713",
                                "sense_id": "324bea3e-e776-3737-b85a-19cf2f6562de",
                                "text": "Gdy dysponujemy nieco większą gotówką, warto rozważyć inwestycję w zestaw kina domowego, a więc odtwarzacz, amplituner i komplet głośników zapewniający wrażenia takie jak w kinie wyposażonym w system Dolby Surround"
                            }
                        ],
