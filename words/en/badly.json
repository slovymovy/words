                {
                    "sense_id": "e5e10209-7960-3e17-ba5d-d97fbf95ec0f",
                    "sense_definition": "In a way that is not acceptable, successful, or of high quality.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team played <w>badly</w> and lost the important match.",
                            "target_lang_translations": {
                                "ru": "Команда сыграла <w>плохо</w> и проиграла важный матч.",
                                "cs": "Tým hrál <w>špatně</w> a prohrál důležitý zápas.",
                                "pl": "Drużyna zagrała <w>źle</w> i przegrała ważny mecz.",
                                "zh": "这支队伍表现<w>糟糕</w>，输掉了那场重要的比赛。"
                            }
                        },
                        {
                            "text": "She felt she had been treated <w>badly</w> by her former employer.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что её бывший работодатель обошёлся с ней <w>плохо</w>.",
                                "cs": "Měla pocit, že s ní její bývalý zaměstnavatel zacházel <w>špatně</w>.",
                                "pl": "Czuła, że była <w>źle</w> traktowana przez swojego byłego pracodawcę.",
                                "zh": "她觉得前雇主对她<w>不好</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poorly",
                        "terribly"
                    ],
                    "antonyms": [
                        "well"
                    ],
                    "common_phrases": [
                        "treat badly",
                        "behave badly",
                        "go badly"
                    ],
                    "target_lang_definitions": {
