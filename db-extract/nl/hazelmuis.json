                                    {
                                        "sense_id": "25c432e8-84e7-3436-b9a8-19f8746d83bd",
                                        "entry_id": "8236e97a-ff8a-3840-86aa-ffd40e0a3ad1",
                                        "glosses": [
                                            "mausähnliches, nachtaktives Nagetier, einzige Art der Haselmäuse (Muscardinus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d19f75-2c4a-4983-81a6-6684cc586f0c",
                                                "sense_id": "25c432e8-84e7-3436-b9a8-19f8746d83bd",
                                                "text": "Haselmäuse leben bevorzugt in Mischwäldern mit reichem Buschbestand."
                                            },
                                            {
                                                "example_id": "0c3f0d06-8e55-4bd0-a6b0-3a9c898060f8",
                                                "sense_id": "25c432e8-84e7-3436-b9a8-19f8746d83bd",
                                                "text": "Die Haselmaus ernährt sich bevorzugt von Haselnüssen."
                                            },
                                            {
                                                "example_id": "95f32ddf-131e-43a3-b971-899a7fee6281",
                                                "sense_id": "25c432e8-84e7-3436-b9a8-19f8746d83bd",
                                                "text": "Ein anderer Römer, berichtet Petronius, ließ seinen Gästen gebackene Haselmäuse servieren, in Honig und Mohnsamen gerollt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b13c0be4-29fb-4e52-926d-4fe27b0654f7",
                        "source_entry_id": "66fbc1a3-45f7-3a79-983c-bf9056cc3899",
                        "source_sense_id": "d1ae2de9-e836-3ad7-b60d-81c1603a1171",
                        "source_sense_description": "knaagdier in de familie van slaapmuizen, Muscardinus avellanarius",
                        "target_lang_word": "muscardin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muscardin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee178ae4-f20d-388d-8e81-119b1872c62c",
                                        "entry_id": "59907228-a211-31fa-9b83-e9ab7c2de4e4",
                                        "glosses": [
                                            "Espèce de petit mammifère rongeur, d’Europe et d’Asie, nocturne et hibernant, au pelage roux, à queue touffue et avec de grands yeux noirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5adf9dec-478a-454b-bf48-a869ec6a516f",
                                                "sense_id": "ee178ae4-f20d-388d-8e81-119b1872c62c",
                                                "text": "Le muscardin était autrefois commun dans les haies et taillis, mais il est aujourd’hui de plus en plus rare, suite à la destruction de son habitat par l’homme. Le muscardin passe environ la moitié de sa vie endormi. Lorsqu’il est éveillé, il est toujours dans les arbres, à faire des acrobaties sur les plus fines brindilles, sa queue servant de balancier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f375d4c2-32c1-38a4-b913-f155b422bc63",
                                        "entry_id": "59907228-a211-31fa-9b83-e9ab7c2de4e4",
                                        "glosses": [
                                            "Cépage aux grappes de taille moyenne et de forme cylindrique et compacte, aux baies ovoïdes, noires-bleutées, vinifié avec le grenache, la syrah ou le mourvèdre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8a1385-c516-4f4f-9dd6-ed4ca3d99b54",
                                                "sense_id": "f375d4c2-32c1-38a4-b913-f155b422bc63",
                                                "text": "Le muscardin est un cépage d’appoint qui entre dans la fabrication de plusieurs vins méridionaux. Il leur apporte une note de fraîcheur ainsi qu’un arôme floral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b437560-ea28-3ba4-aa3c-cfec6963f341",
                                        "entry_id": "59907228-a211-31fa-9b83-e9ab7c2de4e4",
                                        "glosses": [
                                            "Pastille ou dragée aromatisée au musc, utilisée sous ce nom essentiellement aux XVIᵉ et XVIIᵉ siècles."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6160297f-70fa-4b9d-ad33-776c77440a29",
                                                "sense_id": "0b437560-ea28-3ba4-aa3c-cfec6963f341",
                                                "text": "Pour les delicats & plus friands on fait des muscardins. Prenez le tiers d’une noix muscade confite, trois dragmes d’écorce de citron, & aucant de mirabolan confit, demi dragme d’ambregris & autant de musc, du sucre le double de tout & avec le mussilage de la gomme tragacant tirée en eau de buglofe, faites-en des muscardins."
                                            },
                                            {
                                                "example_id": "fb1175f5-bfd4-4eb1-a034-9c951e73ba02",
                                                "sense_id": "0b437560-ea28-3ba4-aa3c-cfec6963f341",
                                                "text": "La matiere ordinaire des Suppositoires, est le miel, commun, cuit en une consistence solide & qui puisse se casser étant refroidi, duquel on fait de petites quilles de la longueur du doigt …. On se contente aussi quelque fois de Suppositoires faits avec du Savon coupé en petite pyramide, puis huilé, pour le mieux introduire dans le fondement. Il y en a aussi qui y introduisent des muscardins, en lieu de suppositoires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "muscardin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "080e3b43-eddf-3bbe-a0f9-77105cc3be54",
                                        "entry_id": "a98962d1-e71b-3328-b636-58b4cf9c1bf3",
                                        "glosses": [
                                            "Dragée formée d’une graine de coriandre enrobée de sucre."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba7bff4-ce83-49e6-b187-335391a5093a",
                                                "sense_id": "080e3b43-eddf-3bbe-a0f9-77105cc3be54",
                                                "text": "Les petites dragées qu’on appelle Muscardins ne sont que de la coriandre recouverte de sucre ; on en met dans les massepains ou boëttes qu’on donne dans les jours de réjouissance ou de cérémonie."
                                            },
                                            {
                                                "example_id": "fda8f8c0-fad6-48fd-ae53-5750b3082a0b",
                                                "sense_id": "080e3b43-eddf-3bbe-a0f9-77105cc3be54",
                                                "text": "J’ai acheté un sou de MUSCARDIN. Dites : un sou de DRAGÉES DE CORIANDE.Muscardin est le nom d’une espèce de loir, petit quadrupède rongeur qui dort tout l’hiver."
                                            },
                                            {
                                                "example_id": "aaa2bd86-25c0-4fdc-b8a5-d9ad2dca09f2",
                                                "sense_id": "080e3b43-eddf-3bbe-a0f9-77105cc3be54",
                                                "text": "On offrait aussi aux enfants les « Muscardins ». Ces bonbons étaient en réalité des graines de coriandre enduites d'une pâte sucrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9408727-4e31-33ff-ad34-80edbc0c91d2",
                                        "entry_id": "a98962d1-e71b-3328-b636-58b4cf9c1bf3",
                                        "glosses": [
                                            "Ver à soie desséché suite à une maladie appelée « muscardine »."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bedef5a0-f66c-4afc-b8e6-67e7f9d96cc3",
                                                "sense_id": "d9408727-4e31-33ff-ad34-80edbc0c91d2",
                                                "text": "Les maladies les plus fâcheuses parmi les vers à soie sont celles qu’on a nommées la muscardine et la maladie des morts blancs, ou des morts flats. La première a été ainsi nommée, parce que les vers qui meurent de cette maladie prennent la couleur et la forme de petites dragées, qu’on nomme dans quelques contrées du midi des muscardins."
                                            },
                                            {
                                                "example_id": "73bf41b1-5455-4b57-8e0e-d6f236c721e5",
                                                "sense_id": "d9408727-4e31-33ff-ad34-80edbc0c91d2",
                                                "text": "Il n’y a pas lieu de poser la question de la transmission de la muscardine par hérédité, puisque tout ver muscardin meurt avant d’arriver à l'état de papillon"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
