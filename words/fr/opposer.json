{
    "word_family": [
        "opposition",
        "opposant",
        "opposable",
        "inopposable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c332b52d-0fa8-3f3f-b5fc-c72b6a7abf9f",
                    "sense_definition": "Se mettre en opposition face à une personne, une idée ou une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opposition_conflit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants ont décidé de s'<w>opposer</w> fermement à la construction de cet immeuble."
                        },
                        {
                            "text": "Elle s'<w>oppose</w> à cette décision parce qu'elle la juge tout à fait injuste."
                        }
                    ],
                    "synonyms": [
                        "résister",
                        "combattre"
                    ],
                    "antonyms": [
                        "consentir",
                        "céder"
                    ],
                    "common_phrases": [
                        "s'opposer à un projet",
                        "s'opposer fermement"
                    ]
                },
                {
                    "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                    "sense_definition": "Placer une chose ou faire valoir un argument pour faire obstacle à une autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition_conflit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a <w>opposé</w> un refus catégorique à notre demande de budget."
                        },
                        {
                            "text": "Les manifestants ont <w>opposé</w> une forte résistance face aux forces de l'ordre."
                        }
                    ],
                    "synonyms": [
                        "objecter",
                        "interposer"
                    ],
                    "common_phrases": [
                        "opposer un refus catégorique",
                        "opposer une résistance"
                    ]
                },
                {
                    "sense_id": "87982d32-d2d7-3f43-8d4a-79bcdb88cd86",
                    "sense_definition": "Mettre deux choses ou personnes en comparaison, en contraste ou en concurrence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparaison_contraste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce roman cherche à <w>opposer</w> la vie citadine moderne au calme de la campagne."
                        },
                        {
                            "text": "Le grand débat télévisé a <w>opposé</w> deux candidats aux programmes politiques très différents."
                        }
                    ],
                    "synonyms": [
                        "confronter",
                        "comparer"
                    ],
                    "antonyms": [
                        "associer",
                        "rapprocher"
                    ]
                },
                {
                    "sense_id": "46f18326-bad2-393a-98ab-f977dc37c7f5",
                    "sense_definition": "Déclarer selon les formes légales qu'on fait obstacle à l'exécution d'un acte juridique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le créancier a mandaté un huissier afin de s'<w>opposer</w> au paiement de la somme."
                        },
                        {
                            "text": "L'avocat a fait la démarche nécessaire pour s'<w>opposer</w> à la levée des scellés."
                        }
                    ],
                    "common_phrases": [
                        "s'opposer à un paiement",
                        "s'opposer à un jugement"
                    ]
                }
            ]
        }
    ]
}