                "senses": [
                    {
                        "sense_id": "efa3bcf7-93c2-3e60-b16f-d56ab6823f62",
                        "entry_id": "1b890ccf-2887-387c-9920-2e49e0876153",
                        "glosses": [
                            "Energie, die Lebewesen für ihre Lebensprozesse benötigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007a1b53-09e0-4979-b122-ae8ea97c1fb8",
                                "sense_id": "efa3bcf7-93c2-3e60-b16f-d56ab6823f62",
                                "text": "Ihre Lebensenergie gewinnen die Kleinstlebewesen durch Stoffwechselprozesse, bei denen Methangas und Schwefelverbindungen entstehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f020c88-8724-3261-ab4c-77fe63dc0363",
                        "entry_id": "1b890ccf-2887-387c-9920-2e49e0876153",
                        "glosses": [
                            "körperliche und geistige Kraft oder Vitalität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41b8795-f8d2-4480-bca9-1ef1b122bb04",
                                "sense_id": "2f020c88-8724-3261-ab4c-77fe63dc0363",
                                "text": "Sein Zustand verschlechterte sich leider zunehmend, bis eine Infektion mit dem Coronavirus seinem Körper die gesamte Lebensenergie nahm."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ead70bb5-c053-3043-8fe3-891a45a94928",
                        "entry_id": "1b890ccf-2887-387c-9920-2e49e0876153",
                        "glosses": [
                            "vitale oder spirituelle Kraft, die durch den Körper fließt und das Leben erhält"
                        ],
                        "tags": [
                            "Esoterik"
                        ],
                        "examples": [
                            {
                                "example_id": "a91f17fc-3192-4acc-962f-7734d05fa972",
                                "sense_id": "ead70bb5-c053-3043-8fe3-891a45a94928",
                                "text": "Der Yoga-Meister erklärte, dass das bewusste Atmen dabei hilft, die Lebensenergie, auch Prana genannt, in den Körper zu lenken."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
