                    {
                        "sense_id": "ff87ae84-828e-3726-b1c4-9837b76ba43c",
                        "entry_id": "84ef7255-9cb9-3744-b812-300a0b5825cd",
                        "glosses": [
                            "großer, von Pferden gezogener Rechen, mit dem bei der Ernte liegen gebliebene Halme zusammengerecht wurden"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "fa5a6d0b-037d-45f0-b2e6-cf95eaa69cef",
                                "sense_id": "ff87ae84-828e-3726-b1c4-9837b76ba43c",
                                "text": "„Das Nachharfen mit der sogenannten Hungerharke geschieht gleich mit dem Anfange der Arbeit, und zwar durch alte Invaliden mit Hülfe von Pferden.“ (1826)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7a5e5230-b67f-39a7-b000-033080e64c91",
                        "entry_id": "84ef7255-9cb9-3744-b812-300a0b5825cd",
                        "glosses": [
                            "magere Person, bei der die Rippen stark sichtbar sind"
                        ],
                        "tags": [
                            "derogatory",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf56a37-b2ec-470c-8f1d-d0648575ef2a",
                                "sense_id": "7a5e5230-b67f-39a7-b000-033080e64c91",
                                "text": "Schau mal, die Hungerharke, die ist bestimmt magersüchtig."
                            }
                        ],
                        "sense_index_json": "\"3\""
