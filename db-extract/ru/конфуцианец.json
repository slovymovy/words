                        "translation_id": "4930b6d1-ac1a-4018-90d6-f04bae1be828",
                        "source_entry_id": "b48ce413-fc49-3f2c-99a2-359e050091bb",
                        "source_sense_id": "6f8d6374-1178-3667-8876-f2494585b194",
