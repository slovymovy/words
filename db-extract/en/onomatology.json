                                "target_senses": [
                                    {
                                        "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                        "entry_id": "2482352e-914b-39c8-a850-848096fc0c15",
                                        "glosses": [
                                            "linguistische Disziplin, die sich der Erforschung von Eigennamen widmet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e793ec0-0c3d-4d31-9569-a40059be0bec",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "Die Namenkunde erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                                            },
                                            {
                                                "example_id": "14f29664-7a59-4046-b954-b1c40562b0f1",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "„Aber auch und vor allem Leipzig gilt als traditionelles Zentrum der Onomastik, wie Fachwissenschaftler die Namenkunde nennen.“"
                                            },
                                            {
                                                "example_id": "0650286b-be63-4b4f-92c4-2a2b4c15a58e",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "„In den Lehrplänen ist Namenkunde recht unterschiedlich vertreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2efc49d5-2f91-44cd-abf8-62902ccaa3e5",
                        "source_entry_id": "61415afa-604f-3ed6-be80-fc6432de5ad7",
                        "source_sense_id": "b969390b-3b47-3140-9995-32c310aea259",
                        "source_sense_description": "Namenkunde, Onomastik, Namenforschung",
                        "target_lang_word": "Onomastik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Onomastik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                                        "entry_id": "a0145ffe-a813-3600-b437-1ea387a2b1b4",
                                        "glosses": [
                                            "linguistische Disziplin, die sich der Erforschung von Eigennamen widmet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e92c8d0-84ad-4eb1-ad6f-47cae4e4a90e",
                                                "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                                                "text": "Die Onomastik erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                                            },
                                            {
                                                "example_id": "797fccd7-fec4-47df-81b9-7555329b2e55",
                                                "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                                                "text": "„Aber auch und vor allem Leipzig gilt als traditionelles Zentrum der Onomastik, wie Fachwissenschaftler die Namenkunde nennen.“"
                                            },
                                            {
                                                "example_id": "9d639b39-47bb-4dc7-b3ac-4e1f315399bf",
                                                "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                                                "text": "„Dieser Frage sind verschiedene Forschungsrichtungen wie Onomastik und Logik, Grammatik und Zeichentheorie, Pragma- und Textlinguistik nachgegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "594a59d7-45b9-4eec-aa2e-f9f97dc3b065",
                        "source_entry_id": "61415afa-604f-3ed6-be80-fc6432de5ad7",
                        "source_sense_id": "b969390b-3b47-3140-9995-32c310aea259",
                        "source_sense_description": "Namenkunde, Onomastik, Namenforschung",
                        "target_lang_word": "Namenforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namenforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                        "entry_id": "6f293d46-4ef5-3723-94f2-2676798d595a",
                                        "glosses": [
                                            "linguistische Disziplin, die sich der Erforschung von Eigennamen widmet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5c5397-e358-4c0c-8c5b-b089f7616bb7",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "Die Namenforschung erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                                            },
                                            {
                                                "example_id": "bcd55a6d-a4b2-462a-8444-960fc52a5f1e",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Die Namenforschung der Staaten der Erde ist zweifellos noch nicht abgeschlossen.“"
                                            },
                                            {
                                                "example_id": "5c6edc99-0cff-4373-9650-ca380366d891",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Als traditionelle Orte der Namenforschung im deutschsprachigen Raum sind Lüneburg, Heidelberg, Mainz und Wiesbaden sowie mit Statistiken auch Zentren in Österreich und der Schweiz zu nennen.“"
                                            },
                                            {
                                                "example_id": "15a8366f-d98f-43ab-aafe-3830edc59d61",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Ein Kosename, in der Namenforschung auch als Hypokoristikum bezeichnet, wird oft formal mit einem Kurznamen beziehungsweise einer Kurzform gleichgesetzt.“"
                                            },
                                            {
                                                "example_id": "c5843056-ef60-4b17-9a2a-61a87a749a49",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Bandnamen haben in der Namenforschung bisher keine Beachtung gefunden, obwohl sie sowohl von der kultursemantischen als auch der formal-strukturellen Seite her interessant sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
