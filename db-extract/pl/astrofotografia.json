                                        "entry_id": "686c96ec-ff58-3d04-b9eb-925d60300769",
                                        "glosses": [
                                            "The photography or imaging of astronomical objects, celestial events or areas of the night sky."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15e8934-ce4c-42d5-8233-5b6961c1d11f",
                                                "sense_id": "bb017e31-472c-3ee2-a561-5a144a5c61f0",
                                                "text": "As in most nature photography, the 35mm single lens reflex camera is probably the best choice for astrophotography."
                                            },
                                            {
                                                "example_id": "5edae678-5c92-4ce2-9b5b-9ebb3940118a",
                                                "sense_id": "bb017e31-472c-3ee2-a561-5a144a5c61f0",
                                                "text": "Their^([CMOS sensors']) pixel size, linearity and noise performance are not necessarily ideal for astrophotography."
                                            },
                                            {
                                                "example_id": "4ec6f120-085c-4b7e-8c23-1f31db326281",
                                                "sense_id": "bb017e31-472c-3ee2-a561-5a144a5c61f0",
                                                "text": "Astrophotography is a craft requiring development of skill, not just good equipment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
