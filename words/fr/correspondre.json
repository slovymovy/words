{
    "word_family": [
        "correspondance",
        "correspondant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a767f52-8a3a-3243-b2c0-88d5ce275c3b",
                    "sense_definition": "Être en rapport d'égalité, de conformité ou d'équivalence avec quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette description ne <w>correspond</w> pas du tout à la réalité du terrain."
                        },
                        {
                            "text": "Son profil semble parfaitement <w>correspondre</w> aux attentes de notre entreprise pour ce poste."
                        }
                    ],
                    "synonyms": [
                        "concorder",
                        "coïncider",
                        "équivaloir"
                    ],
                    "antonyms": [
                        "différer",
                        "diverger"
                    ],
                    "common_phrases": [
                        "correspondre aux attentes",
                        "correspondre aux critères",
                        "correspondre au profil"
                    ]
                },
                {
                    "sense_id": "d49a57f2-14d8-338f-b417-92afc59da92f",
                    "sense_definition": "Échanger des lettres, des courriels ou des messages avec quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont continué à <w>correspondre</w> par lettre pendant plusieurs années après leur rencontre."
                        },
                        {
                            "text": "Elle <w>correspond</w> régulièrement avec son amie d'enfance qui habite au Canada."
                        }
                    ],
                    "synonyms": [
                        "écrire"
                    ],
                    "common_phrases": [
                        "correspondre par écrit",
                        "correspondre par lettre"
                    ]
                },
                {
                    "sense_id": "75016a50-b2d9-3211-b13c-1d6180ff73ee",
                    "sense_definition": "Être relié de manière à assurer une correspondance dans les transports publics.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre train régional <w>correspond</w> avec le TGV en gare centrale."
                        },
                        {
                            "text": "Cette ligne de bus permet de <w>correspondre</w> facilement avec le métro."
                        }
                    ],
                    "common_phrases": [
                        "correspondre avec le train",
                        "correspondre avec le métro"
                    ]
                },
                {
                    "sense_id": "fb35c716-432a-3db5-a423-4a04f826ae1b",
                    "sense_definition": "Répondre par ses sentiments, ses pensées ou ses actes à ceux d'une autre personne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "harmonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Touché par son amitié sincère, il s'efforçait d'y <w>correspondre</w> par mille attentions."
                        },
                        {
                            "text": "Il ne savait comment <w>correspondre</w> à l'affection que lui témoignaient ses hôtes."
                        }
                    ],
                    "synonyms": [
                        "répondre"
                    ]
                }
            ]
        }
    ]
}