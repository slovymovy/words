                        "cross_references": [
                            {
                                "target_word": "laborious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5cabcb9-8170-38ef-8e8a-8c7ae15456e2",
                                        "entry_id": "ee17816c-e943-3ab5-8bb3-59874374b8ae",
                                        "glosses": [
                                            "Requiring much physical effort; toilsome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05c69c4-5a05-4161-b634-5a9c873f813d",
                                                "sense_id": "f5cabcb9-8170-38ef-8e8a-8c7ae15456e2",
                                                "text": "Let us face it, our lives are miserable, laborious, and short."
                                            },
                                            {
                                                "example_id": "e2fbd3dd-c85a-4a30-a26e-5bfdec212501",
                                                "sense_id": "f5cabcb9-8170-38ef-8e8a-8c7ae15456e2",
                                                "text": "The coal is then transferred to broad-gauge wagons for transport to Dublin. The transhipment is a rather laborious business, the coal being shovelled by hand from one wagon to another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d780b02d-3437-3eb7-bc5d-5c03fe08b164",
                                        "entry_id": "ee17816c-e943-3ab5-8bb3-59874374b8ae",
                                        "glosses": [
                                            "Mentally difficult; painstaking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4b034b6-ccb0-3700-aa18-d223eb5a770b",
                                        "entry_id": "ee17816c-e943-3ab5-8bb3-59874374b8ae",
                                        "glosses": [
                                            "Industrious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b5ff890-02c7-4e11-be0d-55f3f2c0014e",
                                                "sense_id": "d4b034b6-ccb0-3700-aa18-d223eb5a770b",
                                                "text": "All, with united Force, combine to drive / The lazy Drones from the laborious Hive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
