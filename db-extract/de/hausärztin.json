                                "target_senses": [
                                    {
                                        "sense_id": "89cef163-1c16-3363-afe2-dbc109226f31",
                                        "entry_id": "1710e37c-d3ee-3dbb-ba4c-f0b83601397f",
                                        "glosses": [
                                            "Médecin généraliste que l’on a l’habitude de consulter."
                                        ],
                                        "tags": [],
