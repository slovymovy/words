                                        "sense_id": "994cefdc-a1c6-3e45-81a8-b0f0b8f9473e",
                                        "entry_id": "66a2b1cd-5280-365d-89b4-a945c156aa1f",
                                        "glosses": [
                                            "The period of one's life spent in employment, between leaving school and retirement."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3f797e3-3790-4351-8168-0fb3a612c833",
                                                "sense_id": "994cefdc-a1c6-3e45-81a8-b0f0b8f9473e",
                                                "text": "Some interesting facts have recently been made known by the L.N.E.R. concerning the 178-ton Garratt 2-8-0 + 0-8-2 engine No. 2395, which since construction in 1925 has spent the whole of its working life banking coal trains up the 3 miles of 1 in 40 between Wentworth junction and West Silkstone, on the Worsborough branch, near Barnsley."
                                            },
                                            {
                                                "example_id": "d63994c4-9b32-4f33-9723-8f8df4c4e94b",
                                                "sense_id": "994cefdc-a1c6-3e45-81a8-b0f0b8f9473e",
                                                "text": "To an exceptional degree the duties on these inclines have been passed on from father to son; many a boy has begun his working life in oiling the sheaves and, after passing through every grade, has reached the age of retirement in the responsible position of brakesman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67ba842-d2a7-3caf-b25b-297f10404fd0",
                                        "entry_id": "66a2b1cd-5280-365d-89b4-a945c156aa1f",
                                        "glosses": [
                                            "The lifespan of something, especially a durable good: how long it is expected to last; how long it does in fact last."
                                        ],
                                        "tags": [
                                            "of an object"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92cef7e2-3d56-4e74-8248-aefc7f20d4ee",
                                                "sense_id": "f67ba842-d2a7-3caf-b25b-297f10404fd0",
                                                "text": "Cheaper tires typically have a shorter working life than the pricier alternatives, which means that the total cost of ownership (per mile) is closer to equal although the upfront cost is more affordable."
                                            }
                                        ]
                                    }
                                ]
                            }
