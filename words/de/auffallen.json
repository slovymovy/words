            "senses": [
                {
                    "sense_id": "7306e9be-99bd-3ac3-98ff-6f760aab8ac9",
                    "sense_definition": "durch eine Besonderheit die Aufmerksamkeit auf sich ziehen; hervorstechen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bemerken_aufmerksamkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit seiner bunten Jacke <w>fällt</w> er in der Menge sofort <w>auf</w>."
                        },
                        {
                            "text": "Sie wollte bei der Feier nicht unangenehm <w>auffallen</w> und trug schlichte Kleidung."
                        }
                    ],
                    "synonyms": [
                        "herausstechen",
                        "hervorstechen"
                    ],
                    "antonyms": [
                        "untergehen"
                    ],
                    "common_phrases": [
                        "unangenehm auffallen",
                        "überall auffallen"
                    ]
                },
                {
                    "sense_id": "4099ccf2-a39e-3456-b3d6-74ad598aa663",
                    "sense_definition": "von jemandem wahrgenommen oder bemerkt werden; jemandem ins Bewusstsein treten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bemerken_aufmerksamkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mir ist sofort <w>aufgefallen</w>, dass du eine neue Brille trägst."
                        },
                        {
                            "text": "Ist dir an seinem Verhalten in letzter Zeit etwas Ungewöhnliches <w>aufgefallen</w>?"
                        }
                    ],
                    "antonyms": [
                        "entgehen"
                    ],
                    "common_phrases": [
                        "jemandem sofort auffallen",
                        "jemandem negativ auffallen"
                    ]
                },
                {
                    "sense_id": "7e492310-35a9-399d-91f5-42b19fcbdb5f",
                    "sense_definition": "auf eine Fläche oder einen Körper treffen, insbesondere von Strahlen oder Licht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physikalisches_treffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn die Sonnenstrahlen schräg auf das Glas <w>auffallen</w>, bricht sich das Licht."
                        },
                        {
                            "text": "Ein Teil des <w>auffallenden</w> Lichts wird von der Glasoberfläche reflektiert."
                        }
                    ],
                    "synonyms": [
                        "auftreffen"
                    ],
                    "common_phrases": [
                        "schräg auffallen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45ab7468-d0f9-305f-8aad-f170978f120b",
                    "sense_definition": "das Bemerktwerden oder Auf-sich-aufmerksam-Machen; Substantivierung des Verbs <w>auffallen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bemerken_aufmerksamkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sein ständiges <w>Auffallen</w> ging den anderen Kollegen bald auf die Nerven."
                        },
                        {
                            "text": "Durch gezieltes <w>Auffallen</w> in den Medien wollte die Band bekannter werden."
                        }
                    ],
                    "common_phrases": [
