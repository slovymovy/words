                ],
                "senses": [
                    {
                        "sense_id": "4a35c0bd-be84-38d5-9c2b-dfaf9429fab0",
                        "entry_id": "f826fc56-d186-3dae-a349-5eb376084902",
                        "glosses": [
                            "Donner un caractère hiératique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9cd97b0-86b6-4b3f-bf17-f883b61d2bbc",
                                "sense_id": "4a35c0bd-be84-38d5-9c2b-dfaf9429fab0",
                                "text": "Rien de luxueux ni d’extravagant ne vient hiératiser cette chevelure joliment orchestrée."
                            },
                            {
                                "example_id": "0c8c206c-2d62-486b-adfb-0f16d5ca492a",
                                "sense_id": "4a35c0bd-be84-38d5-9c2b-dfaf9429fab0",
                                "text": "Séducteur, Flaubert n’hésite pas à « hiératiser » ces lieux du corps transformés en objets de désir."
                            },
                            {
                                "example_id": "9d115211-47f4-4c72-881f-64adc63d89af",
                                "sense_id": "4a35c0bd-be84-38d5-9c2b-dfaf9429fab0",
                                "text": "La polysémie du noir tourne aussi autour de l’opposition du couple modestie-élégance : il n’y a pas mieux pour camoufler les souillures d’un vêtement de domestique et en même temps hiératiser l’allure ?"
                            }
                        ]
                    }
