                "senses": [
                    {
                        "sense_id": "1a181e9d-0fab-344c-98af-648784f205dc",
                        "entry_id": "e95248cc-f0a3-3fc3-a5dd-59ec6ccf60d5",
                        "glosses": [
                            "samica pająka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef78209-5235-4abd-a347-75ad5b469aaf",
                                "sense_id": "1a181e9d-0fab-344c-98af-648784f205dc",
                                "text": "Kiedy tylko pajęczycy uda się zatopić szczękoczułki w ciele ofiary, zwykle zastyga na pewien czas, do kilku minut, czekając aż ustaną konwulsje."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f71d9d00-c7d2-43e4-a22e-3689e74cac56",
                        "source_entry_id": "e95248cc-f0a3-3fc3-a5dd-59ec6ccf60d5",
                        "source_sense_id": "1a181e9d-0fab-344c-98af-648784f205dc",
                        "target_lang_word": "паучиха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "паучиха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3aea1c-7e9c-311d-ad4a-ff69de6fd7fb",
                                        "entry_id": "572fd408-3d10-3b53-92b9-f2a95e6f9f7d",
                                        "glosses": [
                                            "женск. к паук; самка паука"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7869153c-24f3-49d4-ae5b-cbf2c6ff779e",
                                                "sense_id": "4b3aea1c-7e9c-311d-ad4a-ff69de6fd7fb",
                                                "text": "Ой вы, братцы-мужики, // Горемыки-бедняки! // А давно уж паука // Взять пора вам за бока: // Ваши души он «спасал» — // Вашу кровушку сосал // Да кормил жену и чад — // Паучиху, паучат, // И пыхтел, осклабив рот: // — Ай дурак же наш народ!"
                                            },
                                            {
                                                "example_id": "9610b06a-2a81-44ac-9588-ad083d1db0d9",
                                                "sense_id": "4b3aea1c-7e9c-311d-ad4a-ff69de6fd7fb",
                                                "text": "Пытаясь разорвать прежние ассоциации, запутываюсь в паутине будущих, давным-давно сплетённых древней паучихой (из ещё не виденных снов), висящей в правом углу под потолком."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
