                "senses": [
                    {
                        "sense_id": "ba14ec4c-c060-34fb-b16a-b687bbda5417",
                        "entry_id": "16d13f97-ff89-33fa-bcfc-108d966cd835",
                        "glosses": [
                            "Sitzmöbel oder Fahrzeug für zwei Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f66f0ca-5dc3-47bd-8fce-475eb70ced40",
                                "sense_id": "ba14ec4c-c060-34fb-b16a-b687bbda5417",
                                "text": "„Dem Sofa gegenüber waren ein mit blauem Samt bezogener Zweisitzer und zwei Esszimmerstühle aus Rattan aufgestellt.“"
                            },
                            {
                                "example_id": "603762dd-93b3-4002-9c03-637bb6c3c490",
                                "sense_id": "ba14ec4c-c060-34fb-b16a-b687bbda5417",
                                "text": "„Er machte seinen Pilotenschein und kaufte sich später einen Doppeldecker, einen Zweisitzer, und unternahm sogar mit seiner Tochter Geneviève Rundflüge.“"
                            },
                            {
                                "example_id": "604f3fe0-9437-45b1-b8e7-15849e01be23",
                                "sense_id": "ba14ec4c-c060-34fb-b16a-b687bbda5417",
                                "text": "„Der Kampf begann, und er wurde mit allen Kräften geführt; da wir aber sahen, daß er noch lange dauern und das Opfer zweifelhaft sein würde, verschoben wir ihn auf die Fahrt in meinem Zweisitzer im Dunkel der Nacht beim Hufgetrappel der vier Pferde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
