        "fr-extract.jsonl": [
            {
                "entry_id": "1bae5873-32ae-3731-8d0b-8d1fc3d3ee58",
                "word": "métaphoriquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "407459f9-e7e0-3955-a15b-a29eeae4c946",
                        "entry_id": "1bae5873-32ae-3731-8d0b-8d1fc3d3ee58",
                        "glosses": [
                            "D’une manière métaphorique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e835446-4ddb-4231-9bd4-50ddeb6184fc",
                                "sense_id": "407459f9-e7e0-3955-a15b-a29eeae4c946",
                                "text": "[Le passage] de l’Épître aux Romains où saint Paul adapte à la parole de Dieu ce que David a dit métaphoriquement de celle des cieux, qui a été entendue de toute la terre."
                            },
                            {
                                "example_id": "c5476929-456c-431d-9d31-0bbf0d442b53",
                                "sense_id": "407459f9-e7e0-3955-a15b-a29eeae4c946",
                                "text": "Pour parler métaphoriquement d’un brave qui ne craint pas le péril, on dit que c’est un lion."
                            },
                            {
                                "example_id": "74b188f3-d108-4b11-82e2-6576b0d16a30",
                                "sense_id": "407459f9-e7e0-3955-a15b-a29eeae4c946",
                                "text": "Je sais bien qu'on dit quelquefois métaphoriquement : La patrie est une mère tendre."
                            },
                            {
                                "example_id": "44461520-34c1-44f4-a678-d9d60cbc1f72",
                                "sense_id": "407459f9-e7e0-3955-a15b-a29eeae4c946",
                                "text": "L’hôtel aussi, au moins métaphoriquement, croula : l’hypothèque n’était qu’une seconde hypothèque, et, disait-on, irrécupérable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80fc0beb-3033-49fe-8a73-233c9d78f97e",
                        "source_entry_id": "1bae5873-32ae-3731-8d0b-8d1fc3d3ee58",
                        "source_sense_id": "407459f9-e7e0-3955-a15b-a29eeae4c946",
                        "target_lang_word": "metaphorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metaphorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                        "entry_id": "5b00ac24-858a-3ff2-a091-d9c33a5b2ad0",
                                        "glosses": [
                                            "bildlich, übertragen verwendet"
                                        ],
                                        "tags": [
                                            "bei Ausdrücken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcbe8dac-ecf4-4d0b-a7c6-e13e17d7ed14",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Nicht wenige der zumeist sehr mittelmäßigen Autoren liefen in die Falle der metaphorischen Instrumentierung, der ästhetischen Aufladung und Bebilderung, als wäre das entscheidende Merkmal von Literatur eine \"gehobene Rede\", die unsere Alltagssprache um jeden Preis poetisierend überbieten müsste.“"
                                            },
                                            {
                                                "example_id": "d749f4ba-3edc-4794-aff4-e3c7b61008a7",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Strauße sind nicht so dumm wie die Menschen, auf die jene Redensart metaphorisch angewandt wird.“"
                                            },
                                            {
                                                "example_id": "32652111-0402-4a85-9a13-3e56a1082078",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Daher könnte man das Wohlwollen metaphorisch eine untätige Freundschaft nennen, die aber, wenn sie länger dauert und zur Vertrautheit wird, in wirkliche Freundschaft übergeht, eine Freundschaft nicht wegen des Vorteils oder der Lust, da wegen solcher Dinge kein Wohlwollen entsteht.“"
                                            },
                                            {
                                                "example_id": "4f2236cd-7941-4908-8708-b3ce7df683a8",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Formen metaphorischen Ausdrucks können statistisch so häufig werden, daß sie eine neue Norm etablieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd39b7ae-43bc-3a9d-8529-bff8d0f71376",
                                        "entry_id": "5b00ac24-858a-3ff2-a091-d9c33a5b2ad0",
                                        "glosses": [
                                            "auf die Metapher bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fc90d9e-0edc-47ea-863e-1f2350ebb351",
                        "source_entry_id": "1bae5873-32ae-3731-8d0b-8d1fc3d3ee58",
                        "source_sense_id": "407459f9-e7e0-3955-a15b-a29eeae4c946",
