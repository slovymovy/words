                "senses": [
                    {
                        "sense_id": "ea66f5c1-5b8e-32bd-aaa2-d10ea5e4b061",
                        "entry_id": "30bfcc64-b365-3ec3-aea3-9bc7b4d237f7",
                        "glosses": [
                            "Buch, das gute Umgangsformen beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbc9a070-e081-4d4b-b1ca-5eab03593c8a",
                                "sense_id": "ea66f5c1-5b8e-32bd-aaa2-d10ea5e4b061",
                                "text": "„Links und rechts neben ihren Tellern lag die komplette Besteckreihe aus dem Benimmbuch.“"
                            },
                            {
                                "example_id": "f81c20c1-b18e-4267-9cb9-09760354cd2a",
                                "sense_id": "ea66f5c1-5b8e-32bd-aaa2-d10ea5e4b061",
                                "text": "„Der „Knigge“ ist ein sehr bekanntes deutsches Benimmbuch – eigentlich die ultimative Sammlung aller Anstandsregeln und Tischmanieren im deutschsprachigen Raum.“"
                            },
                            {
                                "example_id": "a8ad504a-c2e9-4328-a787-a73d8090992c",
                                "sense_id": "ea66f5c1-5b8e-32bd-aaa2-d10ea5e4b061",
                                "text": "„\"Über den Umgang mit Menschen\" von Adolph Freiherr Knigge wurde nach dessen Tod […] nach Belieben und Zeitgeschmack dreist gekürzt und zu einem Benimmbuch umgeschrieben.“"
                            },
                            {
                                "example_id": "095f44b9-f2fc-4f66-addc-e8f7d74b973c",
                                "sense_id": "ea66f5c1-5b8e-32bd-aaa2-d10ea5e4b061",
                                "text": "„»Fluch der Karibik, des Pharaos und so weiter kennt man ja aus dem Kino. Der andere Fluch ist der, den man selbst (nicht) ausstößt«, heißt es im Elmayer-Benimmbuch.“"
                            },
                            {
                                "example_id": "9a7e4045-7c2d-454e-9457-a11b7fbf5ec4",
                                "sense_id": "ea66f5c1-5b8e-32bd-aaa2-d10ea5e4b061",
                                "text": "„COOLNESS – Das Wort sollte es in einem Benimmbuch der feinen akademischen Sitten eigentlich nicht geben oder höchstens so, wie es den Terminus «Geilheit» in einem Benimmbuch für katholische Priester gibt: als Gegen-Wort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
