                                                "sense_id": "fcb6cb1b-5a3b-39ad-8833-b4cda0723ddd",
                                                "text": "Девочка-то, как замуж выходила, ровно огурчик была."
                                            },
                                            {
                                                "example_id": "04395b0d-9320-4c8a-8e6d-5656503e5a0d",
                                                "sense_id": "fcb6cb1b-5a3b-39ad-8833-b4cda0723ddd",
                                                "text": "Ровно плачущий ребёнок запищал где-то сыч."
                                            }
                                        ]
                                    },
