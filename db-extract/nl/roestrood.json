                        "glosses": [
                            "van iets dat het de bruinrode kleur van ijzeroxide heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4b7cc4-6612-4a26-a010-591f4d45eba8",
                                "sense_id": "0019cfe4-48ed-3e2f-a083-1c13d283e749",
                                "text": "In de volksmond wordt zo’n totale eclips ook wel bloedmaan genoemd, omdat de maan dan eventjes rood kan kleuren. Afhankelijk van de samenstelling van de atmosfeer kan de kleur variëren van roestrood tot zeer helderrood."
                            },
                            {
                                "example_id": "2b09bf63-f869-4382-b14d-d5784ff00b35",
                                "sense_id": "0019cfe4-48ed-3e2f-a083-1c13d283e749",
                                "text": "Smith opende zijn show met een model in een lange roestrode jas waar een knal oranje streep over liep en erbij een helblauwe koltrui en een smaragdgroene broek."
                            }
                        ]
                    }
