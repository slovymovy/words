                ],
                "senses": [
                    {
                        "sense_id": "7bb00dbf-e5f2-3219-9294-f0408cf94885",
                        "entry_id": "5d6cee56-b67f-3228-8577-94e9e3eba7f6",
                        "glosses": [
                            "разг. то же, что малость, очень малое количество"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6384ff-a3bc-4aed-8768-ee45081a06c1",
                                "sense_id": "7bb00dbf-e5f2-3219-9294-f0408cf94885",
                                "text": "Но Олег мог поклясться, что денег азербайджанцы истратили самый мизер."
                            },
                            {
                                "example_id": "471a811b-6786-474a-9f85-f91caa09df02",
                                "sense_id": "7bb00dbf-e5f2-3219-9294-f0408cf94885",
                                "text": "По сравнению с общей суммой — это сущий мизер."
                            },
                            {
                                "example_id": "60a59c98-5013-4bea-90c3-29ffad555c04",
                                "sense_id": "7bb00dbf-e5f2-3219-9294-f0408cf94885",
                                "text": "И вот за эту-то минуточку ей, может, господь и простит, ибо дальше этакого мизера с человеческою душой вообразить невозможно."
                            }
                        ]
                    }
                ],
