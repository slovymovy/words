                ],
                "senses": [
                    {
                        "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                        "entry_id": "5caa9683-b9b0-363d-b2b2-27150b7fa72c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c23228a-20b1-4689-bdb5-f3543470e141",
                                "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                                "text": "Herr Gabele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "11283945-6acc-4845-a5d9-8c057a4b2435",
                                "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                                "text": "Die Gabeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "53b36700-e59b-4e13-a350-54be0eb27d5d",
                                "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                                "text": "Der Gabele trägt nie die Schals, die die Gabele ihm strickt."
                            },
                            {
                                "example_id": "0e53cf55-a971-4ee2-becb-9983ad096f81",
                                "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                                "text": "Frau Gabele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5d6ceaa0-e1e0-435e-8eaa-ec2f6feda1f5",
                                "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gabele kommt, geht der Herr Gabele.“"
                            },
                            {
                                "example_id": "f2b90d2e-3235-457f-81dc-5f4f296d91a8",
                                "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                                "text": "Gabele kommt und geht."
                            },
                            {
                                "example_id": "07951af5-3cdc-467a-9226-4fef390cfc45",
                                "sense_id": "fe24deba-ea9c-36e5-9baf-70e26b19352f",
                                "text": "Gabeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
