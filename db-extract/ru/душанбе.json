                        "source_entry_id": "98080f55-67e1-39c0-8d1b-a8e9544167c7",
                        "source_sense_description": "город, столица Таджикистана",
                        "target_lang_word": "Duschanbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Duschanbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee0f466-896c-36d2-930e-f53a2c1987f1",
                                        "entry_id": "980bb925-e5cd-3a1a-80d9-5236016957b3",
                                        "glosses": [
                                            "Hauptstadt von Tadschikistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248b7fc0-6259-4c6f-b7d6-0bc567791c7e",
                                                "sense_id": "2ee0f466-896c-36d2-930e-f53a2c1987f1",
                                                "text": "„Erstaunlich ist, dass Duschanbe, die Hauptstadt des vermutlich ärmsten Staates in der ganzen GUS, einen durchaus wohlhabenden Eindruck macht.“"
                                            },
                                            {
                                                "example_id": "0bbf44e9-d237-4a86-a061-cda52078c7e5",
                                                "sense_id": "2ee0f466-896c-36d2-930e-f53a2c1987f1",
                                                "text": "„In der Nähe Duschanbes sind Truppen Frankreichs, der USA und Russlands stationiert.“"
                                            },
                                            {
                                                "example_id": "14b25dc9-5580-49eb-95a5-03567f791065",
                                                "sense_id": "2ee0f466-896c-36d2-930e-f53a2c1987f1",
                                                "text": "„Wie RIA Novosti am Mittwoch von der Erdbebenwarte in Duschanbe erfuhr, lag das Epizentrum des Erdbebens 80 Kilometer südöstlich der Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "4b88e00f-0000-4cff-97ed-674712ccf1b6",
                                                "sense_id": "2ee0f466-896c-36d2-930e-f53a2c1987f1",
                                                "text": "„Am 6. Oktober 2007 tagten die Staatsoberhäupter der Eurasischen Wirtschaftsgemeinschaft (Eurasian Economic Community, EurasEC) in Duschanbe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
