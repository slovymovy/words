                                                "example_id": "db1f17a7-7126-4502-acaa-097ad8752a50",
                                                "sense_id": "16d40c9f-2007-3a05-9d07-738e03df39d4",
                                                "text": "Les préalables pour engager cette procédure légale sont […]"
                                            }
