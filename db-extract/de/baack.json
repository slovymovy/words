                ],
                "senses": [
                    {
                        "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                        "entry_id": "502776cd-59a3-3578-a19d-0e8e98af282d",
                        "glosses": [
                            "deutschsprachiger Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796b1cb9-a39b-4971-9773-9bff8bcc9672",
                                "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                                "text": "Die Baacks fahren heute in den Hunsrück."
                            },
                            {
                                "example_id": "00887233-18f0-4d6d-8e96-f4781feab391",
                                "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                                "text": "Der Baack trägt nie die Schals, die die Baack ihm strickt."
                            },
                            {
                                "example_id": "7b92bce4-0833-4dab-b720-80ec59a35d1a",
                                "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                                "text": "Frau Baack ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9fdf4aa6-4d69-4559-ac23-4d8f9c111c64",
                                "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                                "text": "Herr Baack wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "adcd1839-5940-45b6-9c9c-d4547c8e3191",
                                "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baack kommt, geht der Herr Baack.“"
                            },
                            {
                                "example_id": "ae1346a2-47f4-4f6f-be81-2cb4ffd9f2cb",
                                "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                                "text": "Baack kommt und geht."
                            },
                            {
                                "example_id": "fe00eaa0-2118-44e1-b980-b400c3e66f78",
                                "sense_id": "3b0c43ee-5200-3801-ab3e-1bbd03988fb0",
                                "text": "Baacks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
