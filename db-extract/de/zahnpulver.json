                            {
                                "example_id": "a1f2c3f1-4c8c-479d-bb73-89f9d2d75c21",
                                "sense_id": "2a3a3e78-1c17-3dd4-9898-0aa06ffde529",
                                "text": "„Katekar lehnte sich an die Mauer, gab etwas Zahnpulver auf seinen Zeigefinger und putzte sich die Zähne, wobei er das Wasser in seinem Glas genau einteilte, und nachdem er ein letztes Mal ausgespuckt hatte, war sein Mund sauber gespült.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
