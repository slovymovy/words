        "fr-extract.jsonl": [
            {
                "entry_id": "49613913-9d56-33e5-9e7c-74367667828e",
                "word": "coulage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "91437c4b-4adc-4daf-9688-70a8f686b344",
                        "entry_id": "49613913-9d56-33e5-9e7c-74367667828e",
                        "tags": [
                            "plural"
                        ],
                        "form": "coulages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09288366-2604-3d82-87eb-2a6091cc6335",
                        "entry_id": "49613913-9d56-33e5-9e7c-74367667828e",
                        "glosses": [
                            "Action de faire couler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058134f2-14f5-422e-8a5d-6bdfa04c7efa",
                                "sense_id": "09288366-2604-3d82-87eb-2a6091cc6335",
                                "text": "Le coulage d’une lessive."
                            },
                            {
                                "example_id": "130e2ace-7e8d-4b3c-b3a5-08767b406265",
                                "sense_id": "09288366-2604-3d82-87eb-2a6091cc6335",
                                "text": "L’époque n’était pas encore aux machines à laver modernes, mais on était passé en quelques décennies de la lessive à l’ancienne, la bue, qui dura jusqu’aux années 50 selon les régions, faite deux ou trois fois l’an, entièrement à la main avec de la cendre végétale récupérée chez le boulanger & qui prenait au moins trois jours entiers, dont un pour l’opération danaïde du coulage, verser & reverser sans cesse de l’eau bouillante sur le linge empilé dans un immense cuvier […]."
                            },
                            {
                                "example_id": "ead85318-7c22-4c64-a16d-ecee8c022b02",
                                "sense_id": "09288366-2604-3d82-87eb-2a6091cc6335",
                                "text": "Le coulage d’une statue, de pièces céramiques."
                            },
                            {
                                "example_id": "e36885a5-ceb0-441c-84fb-1d71aba07d06",
                                "sense_id": "09288366-2604-3d82-87eb-2a6091cc6335",
                                "text": "La première est dite par prétension: les câbles sont tendus avant le coulage du béton."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c0dc8db-b279-3aee-86d6-e5a7e1581ffb",
                        "entry_id": "49613913-9d56-33e5-9e7c-74367667828e",
                        "glosses": [
                            "Action de s’écouler ou de couler en causant une perte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb9f88c2-a095-4557-8651-e6de730fb34b",
                                "sense_id": "0c0dc8db-b279-3aee-86d6-e5a7e1581ffb",
                                "text": "Le coulage d’une pièce de vin."
                            },
                            {
                                "example_id": "66ade472-9cb7-4fd6-a1e6-6d31a20ab642",
                                "sense_id": "0c0dc8db-b279-3aee-86d6-e5a7e1581ffb",
                                "text": "Marchandises sujettes à coulage, au coulage."
                            },
                            {
                                "example_id": "1c961745-a77e-4499-8fca-bfb01aa329e0",
                                "sense_id": "0c0dc8db-b279-3aee-86d6-e5a7e1581ffb",
                                "text": "Le coulage de la vigne."
                            }
                        ]
                    },
                    {
                        "sense_id": "14efe61d-143e-3648-89df-e70c9b52484a",
                        "entry_id": "49613913-9d56-33e5-9e7c-74367667828e",
                        "glosses": [
                            "Pertes provenant d’incurie et de gaspillage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ea7f4c-ff2a-405f-9775-b17bf3211688",
                                "sense_id": "14efe61d-143e-3648-89df-e70c9b52484a",
                                "text": "Le coulage consiste à faire faire des travaux qui ne sont pas urgents ou nécessaires, à dégalonner et regalonner les troupes, à commander des vaisseaux sans s’inquiéter s’il y a du bois et de payer alors le bois trop cher, à se préparer à la guerre sans la faire, à payer les dettes d’un État sans lui en demander le remboursement ou des garanties, etc."
                            },
                            {
                                "example_id": "743595ce-0762-4824-9de0-f3db40eaad45",
                                "sense_id": "14efe61d-143e-3648-89df-e70c9b52484a",
                                "text": "Maman était une bien mauvaise maîtresse de maison, chez elle, le coulage était simplement ridicule."
                            }
                        ]
                    },
                    {
                        "sense_id": "b796d2d3-90ea-3049-b9a1-8cf8a28e1cd2",
                        "entry_id": "49613913-9d56-33e5-9e7c-74367667828e",
                        "glosses": [
                            "Vol de marchandises ou de fournitures par les employés d’une entreprise, d’un magasin."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "de99471e-61c6-43ab-b236-78c06204232b",
                                "sense_id": "b796d2d3-90ea-3049-b9a1-8cf8a28e1cd2",
                                "text": "Le coulage c’est lorsqu’un employé s’en va avec un gigot dans son sac."
                            }
                        ]
                    }
                ],
