                                "example_id": "e5e7ef42-7bf0-4353-a66b-780b0c4b11ea",
                                "sense_id": "f7a285dc-3dda-37f8-85e2-5310fd57b1f3",
                                "text": "„Die Egyptiſchen Kauffleute, welche ihre Waaren von Cairo nach Conſtantinopel zum Verkauff bringen, geben achzig Beutel; …“"
                            },
                            {
                                "example_id": "4df6e611-a970-4302-ab4c-a5a96e6f426d",
                                "sense_id": "f7a285dc-3dda-37f8-85e2-5310fd57b1f3",
                                "text": "„Verwundete bringt man auf achzig Bahren, Die meiſtens ihm allein begegnet waren.“"
                            },
                            {
                                "example_id": "336051ac-2a52-47c8-981d-5ac7c24392f2",
                                "sense_id": "f7a285dc-3dda-37f8-85e2-5310fd57b1f3",
                                "text": "„Diese oben beschriebene Motivation darf bereits den Bibliothekaren der Akademischen und Theodorianischen Bibliothek unterstellt werden, die erstmals vor über achzig Jahren einen gedruckten Inkunabelkatalog planten.“"
                            },
                            {
                                "example_id": "1edd8335-f7d6-47a7-bb54-4e9cac0de914",
                                "sense_id": "f7a285dc-3dda-37f8-85e2-5310fd57b1f3",
                                "text": "„Als die Schuster 1489 die Frage diskutierten, für welchen Zweck sie die achzig oder neunzig Gulden Zunftvermögen verwenden wollten, bildeten sich zwei Fraktionen.“"
                            },
                            {
                                "example_id": "501a8bbd-51cd-4eca-9b62-46eb1ec5bc9c",
                                "sense_id": "f7a285dc-3dda-37f8-85e2-5310fd57b1f3",
                                "text": "Anfangs gehet man in einen Hof, welcher hundert und zwey und sechzig Schuh in der Breite und ein und achzig in der lange hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
