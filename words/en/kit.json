                                "target_lang_word": "基特",
                                "target_lang_sense_clarification": "人名"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "Kit",
                                "target_lang_sense_clarification": "voornaam"
                            }
                        ]
