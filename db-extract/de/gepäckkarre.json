                ],
                "senses": [
                    {
                        "sense_id": "1f72277b-ea13-3520-bc21-5efd0be706f9",
                        "entry_id": "5603aaeb-75a4-3592-923e-81eb03313077",
                        "glosses": [
                            "einfache Transportfläche auf Rädern ohne eigenen Antrieb für Gepäck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e38616-e00b-4660-8262-e88befba9c61",
                                "sense_id": "1f72277b-ea13-3520-bc21-5efd0be706f9",
                                "text": "„Neben verlassen wirkenden Gepäckkarren stehen wir schweigend herum.“"
                            },
                            {
                                "example_id": "aad759ff-86cf-4f50-91cf-dcf449f9e601",
                                "sense_id": "1f72277b-ea13-3520-bc21-5efd0be706f9",
                                "text": "„Achten Sie darauf, dass Sie die Koffer von der Gepäckkarre nehmen und der Fahrer sie zu Ihnen auf den Rücksitz stellt.“"
                            },
                            {
                                "example_id": "41f6d22f-eee4-4a79-8365-787b79b2dfef",
                                "sense_id": "1f72277b-ea13-3520-bc21-5efd0be706f9",
                                "text": "„Wenige Minuten später kehrte er – eine Gepäckkarre, auf der zwei Kinderbuggys übereinander gestapelt waren, vor sich her schiebend – zurück.“"
                            },
                            {
                                "example_id": "c894ebfb-8f97-4088-a7be-f8788461ee82",
                                "sense_id": "1f72277b-ea13-3520-bc21-5efd0be706f9",
                                "text": "„Da stand Flöten-Ewald neben derTreppe und flötete laut »Komm Zigan, komm Zigan, spiel mir ein Lied«, eine Hand an der Deichsel seiner Gepäckkarre, die andere an der weißen Gepäckträger-Mütze, die er vor seiner linken Brust hielt.“"
                            },
                            {
                                "example_id": "f83b5896-1688-4d8c-940f-1bec136a4d3b",
                                "sense_id": "1f72277b-ea13-3520-bc21-5efd0be706f9",
                                "text": "„Er hatte eine Gepäckkarre dabei, nickte den Thurmans freundlich zu und klopfte dann an die Zimmertür.“"
                            },
                            {
                                "example_id": "b30ee4b2-29e0-40dc-b4a4-0eeca25c93bd",
                                "sense_id": "1f72277b-ea13-3520-bc21-5efd0be706f9",
                                "text": "„Die Dolmetscherin hatte dem großen Menschen mit seiner Gepäckkarre eingangs des Belorussischen Bahnhofs gewinkt, flink sortierte er unsere Gepäckstücke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
