                ],
                "senses": [
                    {
                        "sense_id": "12710b01-6727-3d1c-8629-289c41f3b18b",
                        "entry_id": "41f81730-1954-3bec-90d4-29a74385d995",
                        "glosses": [
                            "eine international tätige, 1971 gegründete Umweltschutzorganisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643d9807-9d4d-49bf-8cb1-987febb2e403",
                                "sense_id": "12710b01-6727-3d1c-8629-289c41f3b18b",
                                "text": "„Greenpeace kritisiert, dass in Deutschland nicht genug gegen die Ewigkeitschemikalien unternommen wird.“"
                            },
                            {
                                "example_id": "7966892a-18c8-4560-a64d-19dbf870aed5",
                                "sense_id": "12710b01-6727-3d1c-8629-289c41f3b18b",
                                "text": "Greenpeace versucht durch spektakuläre und medienwirksame Aktionen auf ökologische Missstände aufmerksam zu machen."
                            },
                            {
                                "example_id": "20ee8a86-ee4a-48ea-b8c8-64e1df8a090a",
                                "sense_id": "12710b01-6727-3d1c-8629-289c41f3b18b",
                                "text": "„Die blonde Sekretärin, die normalerweise ihr Gehalt für Firlefanz ausgibt, spendet plötzlich all ihr Geld Greenpeace.“"
                            },
                            {
                                "example_id": "9a1e37e8-a83b-48c7-a4bf-ec0206161f3c",
                                "sense_id": "12710b01-6727-3d1c-8629-289c41f3b18b",
                                "text": "„Wenn es also Sympathien für die Streiter von Greenpeace geben sollte, dann werden sie nicht geäußert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d37db49d-75e2-4f31-b8b8-25e8f1727054",
                        "source_entry_id": "41f81730-1954-3bec-90d4-29a74385d995",
                        "source_sense_id": "12710b01-6727-3d1c-8629-289c41f3b18b",
                        "source_sense_description": "eine international tätige Umweltschutzorganisation",
                        "target_lang_word": "绿色和平",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72ce54b1-cbe9-4a86-b05b-c74c00823e52",
                        "source_entry_id": "41f81730-1954-3bec-90d4-29a74385d995",
                        "source_sense_id": "12710b01-6727-3d1c-8629-289c41f3b18b",
                        "source_sense_description": "eine international tätige Umweltschutzorganisation",
                        "target_lang_word": "Greenpeace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Greenpeace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                        "entry_id": "892145af-5451-3448-9389-ee30b155eaa6",
                                        "glosses": [
                                            "An international, direct-action environmental organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e3d6f7c-bd3e-47c5-995f-b009c57cd226",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "One particularly exciting sequence shows how members of Greenpeace, a Canadian conservation group, defend whales fleeing from a huge Soviet whaler."
                                            },
                                            {
                                                "example_id": "36957b15-d12e-4587-96b9-83312767a23b",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "Since its founding in 1970, Greenpeace has borne witness against environmental injustice through numerous non-violent direct actions."
                                            },
                                            {
                                                "example_id": "4162fa43-d3c6-4ab9-9327-a6a0deeea4d9",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "Before the doors were opened the security guards were warned to look out for \"Greenpeace types,\" not smartly dressed business women."
                                            },
                                            {
                                                "example_id": "6113c2be-58d7-406e-8776-b9ec44b9b7d2",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "Greenpeace had reason to suspect that recent tests had opened a crack in the atoll, causing a serious radiation leak."
                                            },
                                            {
                                                "example_id": "785175d8-03f5-4554-b5ce-c8e1f76519cd",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "A typical Greenpeace action in 1989 saw the organization in alliance with Spanish longline fishermen, angry that the continued use of driftnets was threatening their own livelihoods."
                                            },
                                            {
                                                "example_id": "d700051d-f986-48f6-a686-a15a359a33c2",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "But hardcore Greenpeace types never listen to reason."
                                            },
                                            {
                                                "example_id": "409ec21b-42fe-46d9-b636-e40e45bb5d6e",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "Behind it was a typically bearded, casually dressed Greenpeace type."
                                            },
                                            {
                                                "example_id": "239179cd-438d-4f4f-91f7-9eb7a4302223",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "I mean it's certainly less polemical than having some Greenpeace types confront these hunters with Zodiacs and boycotts and insults in the media."
                                            },
                                            {
                                                "example_id": "1614d346-c809-4b74-85c7-9cb8186b1ccb",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "You remember: the Greenpeace dropout who played chicken with the Soviet Navy."
                                            },
                                            {
                                                "example_id": "a77a9bba-9c76-4ab7-999e-6a9c5be7e541",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "He's an eco-activist maverick, with a Greenpeace mentality when it comes to protecting his little feathered friends."
                                            },
                                            {
                                                "example_id": "72efa8d9-dd9c-4269-8535-55f2ac755de2",
                                                "sense_id": "26e124f6-4fd4-3d8d-9655-283bd23d3a2e",
                                                "text": "Russian lawmakers backed a sweeping amnesty law Wednesday that could see jailed members of the Pussy Riot punk protest band released early and arrested Greenpeace activists avoiding prison, the state-run RIA Novosti news agency reported."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
