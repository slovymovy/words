                        "glosses": [
                            "En parlant des étoffes de laine ou de soie : qui présente des bandes alternativement brillantes et mates, claires et foncées, comme le pékin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c274cb-0596-43ed-aa06-eba2bfc4e840",
                                "sense_id": "721d72d0-766a-36c0-9959-dd2a90756beb",
                                "text": "Des rubans Louis XV pékinés, faille et satin, ivoire et coquelicot."
                            },
                            {
                                "example_id": "38cfd3f7-d4d5-4f5c-aa68-7c3628bd7d22",
                                "sense_id": "721d72d0-766a-36c0-9959-dd2a90756beb",
                                "text": "Brigitte ne s’intéressait pas trop aux cheveux, elle se contentait de rêver sur un tailleur de velours gris souris, pékiné d’une raie noire, que l’on portait, paraît-il, avec une écharpe de skungs."
                            }
                        ]
