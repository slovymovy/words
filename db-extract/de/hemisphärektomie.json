                "senses": [
                    {
                        "sense_id": "493502f8-165f-3e65-83f6-1dbbb4257c9b",
                        "entry_id": "1d58916a-e9eb-33d7-8019-fe0a5fae44db",
                        "glosses": [
                            "operativer Eingriff zur Entfernung einer Großhirnhälfte oder Teilen davon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7483b2d6-2cd2-413c-a3ac-6318a5350bf2",
                                "sense_id": "493502f8-165f-3e65-83f6-1dbbb4257c9b",
                                "text": "„Eine bei einem Erwachsenen durchgeführte Hemisphärektomie hätte für den Patienten katastrophale Folgen.“"
                            },
                            {
                                "example_id": "a2eea5a2-9d46-4f91-8d2c-fe94f7d01d49",
                                "sense_id": "493502f8-165f-3e65-83f6-1dbbb4257c9b",
                                "text": "„In Freiburg hielt er in der Kinderklinik einen Vortrag über Hemisphärektomie bei nicht behandelbaren Epilepsien und fragte mich abends, ob ich ihm das SOS-Kinderdorf in Sulzburg zeigen würde, das von uns betreut wurde.“"
                            },
                            {
                                "example_id": "bc7955b4-14a3-42e1-a08b-3d1b8d527dba",
                                "sense_id": "493502f8-165f-3e65-83f6-1dbbb4257c9b",
                                "text": "„Bei ausgedehnten epileptogenen Zonen, Lokalisation in einer Hemisphäre und einem kontralateralen neurologischen Defizit wird auch die Hemisphärektomie erwogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
