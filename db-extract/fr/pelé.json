                ],
                "senses": [
                    {
                        "sense_id": "f9c77537-9f2b-3ce4-985b-5c7a2994ae42",
                        "entry_id": "90e3ccc1-1d39-3028-a09b-3c537e0fc36b",
                        "glosses": [
                            "Dépourvu de peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1238da-042d-4bd1-bc52-5604edca4797",
                                "sense_id": "f9c77537-9f2b-3ce4-985b-5c7a2994ae42",
                                "text": "Il a le corps tout pelé à la suite de cette maladie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c755e2e-5a2b-3475-ac38-a5198a93a508",
                        "entry_id": "90e3ccc1-1d39-3028-a09b-3c537e0fc36b",
                        "glosses": [
                            "Dépourvu de poils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a5754b-0308-4771-a51b-456f9677cbab",
                                "sense_id": "2c755e2e-5a2b-3475-ac38-a5198a93a508",
                                "text": "Il s'est avancé... il a dit:\n— Nobles pelés et tas de tondus... (il était fort troublé...) le Roy ne peut pas se lever... il a la goutte!"
                            },
                            {
                                "example_id": "a73a3861-b4f5-44da-a5ab-09b625fb7f64",
                                "sense_id": "2c755e2e-5a2b-3475-ac38-a5198a93a508",
                                "text": "Sur les hauteurs de Sainte-Suzanne, près d’une cascade, monsieur Dejean fut tué par un oiseau, probablement un papangue, qui laissa une tortue tomber sur son crâne pelé qu’on confondait facilement avec une pierre."
                            }
                        ]
                    },
                    {
                        "sense_id": "20aef027-9e13-3c55-b3d8-ea0f020e534e",
                        "entry_id": "90e3ccc1-1d39-3028-a09b-3c537e0fc36b",
                        "glosses": [
                            "Dépourvu de végétation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0dddb17b-b431-4b5d-957c-776ddf9223f6",
                                "sense_id": "20aef027-9e13-3c55-b3d8-ea0f020e534e",
                                "text": "Un roc pelé, une montagne pelée - un roc, une montagne où il n’y a ni végétation, ni verdure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90a27811-1b82-4137-a14a-964a535c8803",
                        "source_entry_id": "90e3ccc1-1d39-3028-a09b-3c537e0fc36b",
                        "target_lang_word": "peeled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peeled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df3dafc6-bd72-316f-bd88-249ae42914d0",
                                        "entry_id": "64adcb3a-8087-3ef7-bafd-7291dcdda378",
                                        "glosses": [
                                            "With the outermost layer or skin removed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c63f13b6-b5a2-4a2f-8af0-86f0e754c18e",
                                                "sense_id": "df3dafc6-bd72-316f-bd88-249ae42914d0",
                                                "text": "The peeled fruit quickly turned brown."
                                            },
                                            {
                                                "example_id": "4e18b7c4-902e-45d8-bad3-7b62042fb957",
                                                "sense_id": "df3dafc6-bd72-316f-bd88-249ae42914d0",
                                                "text": "He stirred the campfire stew with a peeled stick, so the bark wouldn't get in it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa24ce2a-1190-3864-8969-ed6425716453",
                                        "entry_id": "64adcb3a-8087-3ef7-bafd-7291dcdda378",
                                        "glosses": [
                                            "Dieted down such as having attained a peak contrast of trained muscle volume."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "peeled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88a21034-fcf1-3d4c-a5ee-5b948e1844bd",
                                        "entry_id": "fdb2fd60-1ad2-38dd-8e09-1e3e6c5a9ce2",
