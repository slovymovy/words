                "senses": [
                    {
                        "sense_id": "3b886e45-da45-3d62-b61e-76a4388d9b33",
                        "entry_id": "000700d7-54af-32b5-8d91-d8fecda838f1",
                        "glosses": [
                            "Traiter le caillé ou le fromage, à température élevée, pour en faire un fromage de type cheddar."
                        ],
                        "tags": [
                            "Caséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "aa7f79e1-65aa-4fb9-9a50-a876345b40de",
                                "sense_id": "3b886e45-da45-3d62-b61e-76a4388d9b33",
                                "text": "Nos vachers de burons n'utilisent-ils pas volontiers le foyer pour cheddariser leur tome à Cantal ?"
                            },
                            {
                                "example_id": "3074891c-90c1-4c8b-a64e-b19e0db8327b",
                                "sense_id": "3b886e45-da45-3d62-b61e-76a4388d9b33",
                                "text": "Cheddariser le caillé selon la technique des retournes ;"
                            },
                            {
                                "example_id": "2324127e-7947-4922-acb8-f9ad6fffa3c4",
                                "sense_id": "3b886e45-da45-3d62-b61e-76a4388d9b33",
                                "text": "Étape 4 : Couper le caillé. Étape 5 : Traitement du caillé. Étape 6 : Vidange du lactosérum. Étape 7 : Cheddariser le fromage. Étape 8 : Saler le fromage."
                            },
                            {
                                "example_id": "7b07e449-8e6f-45fb-883a-23843864190d",
                                "sense_id": "3b886e45-da45-3d62-b61e-76a4388d9b33",
                                "text": "En.1972, on écarte les murs de la salle du cheddar pour y ajuster deux « box », machines à cheddariser un fromage de fonte."
                            },
                            {
                                "example_id": "75374440-51a8-4961-a115-0d99cfd7fd9d",
                                "sense_id": "3b886e45-da45-3d62-b61e-76a4388d9b33",
                                "text": "Le caillé est relevé dans la cuve puis on le laisse se « cheddariser » dans la cuve pendant 30 minutes à température élevée (42°2 à 46°1)."
                            }
                        ]
                    }
                ],
