                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41058deb-b3a1-4b8f-b3e2-fdba89c917c5",
                                "sense_id": "1666a2bb-f9f5-3657-8d3e-30fe15a3ea85",
                                "text": "„Beim alljährlichen Mobilfunk-Test des deutschen Magazins gibt es in Österreich einen Überraschungssieger.“"
                            },
                            {
                                "example_id": "25cdae61-3630-46ec-afa4-b21456bab767",
                                "sense_id": "1666a2bb-f9f5-3657-8d3e-30fe15a3ea85",
                                "text": "„Führende gemässigte Exponenten der Sozialisten wandten sich vom Überraschungssieger der Primärwahlen der Linken ab und liefen zu Macron über.“"
                            },
                            {
                                "example_id": "3a552d1d-d34f-4d72-824c-c9fab6f297a9",
                                "sense_id": "1666a2bb-f9f5-3657-8d3e-30fe15a3ea85",
                                "text": "„Es gab aber sowohl beim Dreikampf als auch beim Fünfkampf nicht den einen Überraschungssieger, der massenhaft Wechselwähler überzeugt haben dürfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
