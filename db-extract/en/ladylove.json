                "senses": [
                    {
                        "sense_id": "c0692225-7629-330c-9899-9a797ddbd514",
                        "entry_id": "04f2e2c5-2cf4-318e-b346-246c55778c71",
                        "glosses": [
                            "A woman who is loved by someone; a female object of desire."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "5131ce5d-1cda-4fea-a1d0-78badc3bd9be",
                                "sense_id": "c0692225-7629-330c-9899-9a797ddbd514",
                                "text": "The knight went on a quest to prove his quality to his ladylove."
                            },
                            {
                                "example_id": "2cd87f30-6f53-4f8d-ba72-5822570b28c9",
                                "sense_id": "c0692225-7629-330c-9899-9a797ddbd514",
                                "text": "the picture of halcyon days where a young gentleman in the costume they used to wear then with a threecornered hat was offering a bunch of flowers to his ladylove with oldtime chivalry through her lattice window"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30e87611-d3fe-463d-a6e1-61583a36e2dd",
                        "source_entry_id": "04f2e2c5-2cf4-318e-b346-246c55778c71",
                        "source_sense_id": "c0692225-7629-330c-9899-9a797ddbd514",
