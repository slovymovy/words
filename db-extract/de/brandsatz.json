                "senses": [
                    {
                        "sense_id": "13802c2c-6902-3b3b-b5af-a84f556d9623",
                        "entry_id": "afb240c5-c3a8-3735-b861-e97be965c677",
                        "glosses": [
                            "Gegenstand, mit dem etwas in Brand gesteckt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4dd29f-9c79-4a85-b817-407d49a57cde",
                                "sense_id": "13802c2c-6902-3b3b-b5af-a84f556d9623",
                                "text": "„Drei Fahrgäste eines Stadtbusses sterben, als randalierende Demonstranten einen Brandsatz auf das vorbeifahrende Fahrzeug schleudern.“"
                            },
                            {
                                "example_id": "23122554-5d6d-46c0-a570-61c00d272c4c",
                                "sense_id": "13802c2c-6902-3b3b-b5af-a84f556d9623",
                                "text": "„In Kremmen warfen die Täter in der Nacht zu Ostersamstag Brandsätze auf ein Heim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
