                "senses": [
                    {
                        "sense_id": "3723294a-bceb-36e3-a74c-e4c1af15b057",
                        "entry_id": "ef0e64dc-8ecc-334f-a82d-78569f394db9",
                        "glosses": [
                            "Regarder, regarder avec insistance, espionner. Regarder de façon bête."
                        ],
                        "tags": [
                            "Franche-Comté"
                        ],
                        "examples": [
                            {
                                "example_id": "31dd3dd1-0538-4c0e-832d-7a106bacea65",
                                "sense_id": "3723294a-bceb-36e3-a74c-e4c1af15b057",
                                "text": "Quand un étranger y passe, tout le monde le rebeuille; et l’envie de voir y est telle, que la porte étant fermé, la tête sort encore."
                            },
                            {
                                "example_id": "d3a299b8-9710-43e0-a49e-cec1c25e417b",
                                "sense_id": "3723294a-bceb-36e3-a74c-e4c1af15b057",
                                "text": "I fait comme moi, not' maître, i rebeuille (regarder avec des yeux de convoitise)."
                            }
                        ]
                    },
                    {
                        "sense_id": "67d0ca69-3ee2-34bf-914b-1e7ce0d8ae8a",
                        "entry_id": "ef0e64dc-8ecc-334f-a82d-78569f394db9",
                        "glosses": [
                            "Tout retourner pour trouver quelque chose."
                        ],
                        "tags": [
                            "Bourgogne"
                        ],
                        "examples": [
                            {
                                "example_id": "686b9094-fa3f-4080-82c2-4bf8b7f21ee0",
                                "sense_id": "67d0ca69-3ee2-34bf-914b-1e7ce0d8ae8a",
                                "text": "Le sanglier rebeuille le sol pour trouver des glands."
                            },
                            {
                                "example_id": "6413417d-e36b-4a5a-9b75-b1af0b182004",
                                "sense_id": "67d0ca69-3ee2-34bf-914b-1e7ce0d8ae8a",
                                "text": "Une personne rebeuille dans une commode à la recherche de ses chaussettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "715531c4-b0ec-3070-adb6-164cc9285e5d",
                        "entry_id": "ef0e64dc-8ecc-334f-a82d-78569f394db9",
                        "glosses": [
                            "Retourner un feu afin de le faire repartir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32c3697-8bc8-44bd-b5ed-7625a20a4d7b",
                                "sense_id": "715531c4-b0ec-3070-adb6-164cc9285e5d",
                                "text": "Rebeuiller le feu."
                            }
                        ]
                    }
