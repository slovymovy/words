                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eff5551-c0c5-4c2a-99ef-3f784d2689a7",
                                "sense_id": "4bdf9172-7013-3901-9ee2-808b96cc5cfc",
                                "text": "Si vous voulez savoir ce que je vais faire à Époisses, je vais me déséreinter et manger du claque-en-bec."
                            },
                            {
                                "example_id": "685f5d9d-3c32-40fe-a62a-7b392bc72d09",
                                "sense_id": "4bdf9172-7013-3901-9ee2-808b96cc5cfc",
                                "text": "L’époisses Perrière Berthaut, de la fromagerie Berthaut, située au cœur du village d’Époisses (Côte-d’Or), est arrivé en tête parmi 1 600 fromages et produits laitiers en lice, tous fabriqués avec au moins 50 % de lait."
                            }
                        ]
                    }
