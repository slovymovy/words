                    {
                        "translation_id": "56fc0747-3399-4417-b180-5c9332654ce3",
                        "source_entry_id": "84c5f50f-12d1-3851-953f-e3600a5ceeb3",
                        "source_sense_description": "Adansonia digitata",
                        "target_lang_word": "baobab",
