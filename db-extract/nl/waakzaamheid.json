                        "examples": [
                            {
                                "example_id": "d2ccfb1b-c1f6-47bb-88dc-27cefcfcded9",
                                "sense_id": "748a391e-8f0a-3c2e-8bc2-d81a3d367d94",
                                "text": "Duitsland zal in een staat van eeuwige waakzaamheid blijven verkeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03514b10-173d-4fab-ba68-f337c5838959",
                        "source_entry_id": "012ccf7b-e573-3e07-a27d-34fe7080beed",
                        "source_sense_id": "748a391e-8f0a-3c2e-8bc2-d81a3d367d94",
                        "source_sense_description": "oplettendheid",
                        "target_lang_word": "Aufmerksamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufmerksamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8db6e1cb-2949-3547-93da-ff5f4a973a5d",
                                        "entry_id": "8b2e18a7-94a3-367e-90c1-7f1ec99db509",
                                        "glosses": [
                                            "gezielte Wahrnehmung der Umwelt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d217901-ce2f-43e9-8cf3-f288575de3d5",
                                                "sense_id": "8db6e1cb-2949-3547-93da-ff5f4a973a5d",
                                                "text": "Nach ein paar Stunden Vortrag ließ seine Aufmerksamkeit nach."
                                            },
                                            {
                                                "example_id": "4454d045-1e7b-4497-9606-370d1dff9800",
                                                "sense_id": "8db6e1cb-2949-3547-93da-ff5f4a973a5d",
                                                "text": "„In die St.-Kamillus-Kirche gingen auch unverheiratete Mädchen, in der Hoffnung, die Aufmerksamkeit eines wohlhabenden Junggesellen auf sich zu ziehen.“"
                                            },
                                            {
                                                "example_id": "066957ee-c0f1-46f1-a57d-1f821783be47",
                                                "sense_id": "8db6e1cb-2949-3547-93da-ff5f4a973a5d",
                                                "text": "„Das hatte Aufmerksamkeit erregt.“"
                                            },
                                            {
                                                "example_id": "527d1c8f-a04c-42fe-bf5a-586fe9458b05",
                                                "sense_id": "8db6e1cb-2949-3547-93da-ff5f4a973a5d",
                                                "text": "„Die brennenden Regenwälder des Amazonas […] haben weltweit enorme Aufmerksamkeit erregt.“"
                                            },
                                            {
                                                "example_id": "255c689a-008e-4004-a518-80ee67d10af5",
                                                "sense_id": "8db6e1cb-2949-3547-93da-ff5f4a973a5d",
                                                "text": "„Der britische Autor Samuel Johnson hat das im 18. Jahrhundert schön formuliert: »Glaubt mir, Sir, wenn ein Mann weiß, dass er in zwei Wochen gehängt wird, schärft das seine Aufmerksamkeit ungemein.«“"
                                            },
                                            {
                                                "example_id": "2a787db0-af30-4477-8620-6738006eb1d4",
                                                "sense_id": "8db6e1cb-2949-3547-93da-ff5f4a973a5d",
                                                "text": "„Ziel von Challenges ist Aufmerksamkeit, die von Mutproben Überwindung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ef97fa4-3aa2-384f-8a11-7f02a6c73ccb",
                                        "entry_id": "8b2e18a7-94a3-367e-90c1-7f1ec99db509",
                                        "glosses": [
                                            "kleines Geschenk, das jemandem bei einem Zusammentreffen übergeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6063646a-201b-4d89-a963-0e97b31d3319",
                                                "sense_id": "7ef97fa4-3aa2-384f-8a11-7f02a6c73ccb",
                                                "text": "Als kleine Aufmerksamkeit brachte er ihr eine Schachtel Pralinen mit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a76f45-9f26-417d-93b3-8b74f9475490",
                        "source_entry_id": "012ccf7b-e573-3e07-a27d-34fe7080beed",
                        "source_sense_id": "748a391e-8f0a-3c2e-8bc2-d81a3d367d94",
                        "source_sense_description": "oplettendheid",
                        "target_lang_word": "Wachsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wachsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                        "entry_id": "50794a6d-8723-339c-98c7-5c020b882447",
                                        "glosses": [
                                            "Einstellung/Verhalten, Geschehnisse aufmerksam zu verfolgen, wachsam zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ef812e-f49e-4b4c-98ff-60b0ca92920a",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "„In der Nacht, als wir uns vor Kap Trafalgar befanden, kam der Kapitän während der Mittelwache an Deck, rief das Vordeck an und befahl größte Wachsamkeit, da wir durch Lord Collingwoods Flotte segeln mussten.“"
                                            },
                                            {
                                                "example_id": "98eac034-8ad7-4756-9e3d-ed0ae8e817b5",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "[COVID-19-Pandemie:] „Nach weiteren Corona-Fällen gilt fortan ‚erhöhte Wachsamkeit‘ im Main-Kinzig-Kreis in Nachbarschaft Frankfurts.“"
                                            },
                                            {
                                                "example_id": "c92fca6a-44c5-4db3-a463-cafbada718f8",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "„Weil der Löwe der ägyptischen Mythologie zufolge die Augen immer offen hat, ist er die Verkörperung der Wachsamkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d4ae2f1-aae2-4310-af26-181cf0a5e8ed",
                        "source_entry_id": "012ccf7b-e573-3e07-a27d-34fe7080beed",
                        "source_sense_id": "748a391e-8f0a-3c2e-8bc2-d81a3d367d94",
                        "source_sense_description": "oplettendheid",
                        "target_lang_word": "watchfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watchfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                        "entry_id": "b5a3c981-3a18-32a6-b64d-882a528d7b62",
                                        "glosses": [
                                            "The state or quality of being watchful; alertness, vigilance or wakefulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2ecd44-da6a-4d86-a326-cc0f4fda3aba",
                                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                                "text": "Continuous watchfulness is maintained around the clock."
                                            },
                                            {
                                                "example_id": "a2545ad7-97d3-476c-a61c-8603a1bfd96e",
                                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                                "text": "The first thing to be undertaken in this weighty work, is a watchfulness over the failings and an inlargement of the dominion, of the Senses."
                                            },
                                            {
                                                "example_id": "16d3e218-335d-491c-8316-39e63800bd37",
                                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                                "text": "1784, Samuel Johnson, letter addressed to Mr. Langton dated 25 August, 1784, cited in James Boswell, The Life of Samuel Johnson, London: Charles Dilly, 1791, Volume 2, p. 545,\nNights of watchfulness produce torpid days […]"
                                            },
                                            {
                                                "example_id": "e93076aa-20cf-4d99-b908-544330b0151c",
                                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                                "text": "Every dark form in the dimness had its ominous quality, its peculiar suggestion of alert watchfulness."
                                            },
                                            {
                                                "example_id": "93c7ce21-a023-4e77-b160-bbefeb92c717",
                                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                                "text": "The steady rhythm of the engines, the fact that he had been sleeping badly, the boredom of a flight that he had done so many times before and did not want to do again, the long humiliation and unhappiness that was always in the background of his mind, all fought against his watchfulness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b07ab609-ec57-40ae-b99c-ca947c1751cb",
                        "source_entry_id": "012ccf7b-e573-3e07-a27d-34fe7080beed",
                        "source_sense_id": "748a391e-8f0a-3c2e-8bc2-d81a3d367d94",
