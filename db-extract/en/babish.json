                ],
                "senses": [
                    {
                        "sense_id": "9a5b8297-9e05-302e-afe6-234173a149f3",
                        "entry_id": "bb96d352-3f6f-3b68-af6f-0bef3024ca8d",
                        "glosses": [
                            "To make or treat as babish."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0994db08-ffa1-4f67-9e96-a931c6e092f4",
                                "sense_id": "9a5b8297-9e05-302e-afe6-234173a149f3",
                                "text": "The Pharisees had babished the simple people with fained and colde religion, and had tangled theyr consciences with."
                            },
                            {
                                "example_id": "4453841e-4e48-416f-919f-f6db76d05e09",
                                "sense_id": "9a5b8297-9e05-302e-afe6-234173a149f3",
                                "text": "The truth is, what with passing those hard years of Mary's reign in obscurity, without all conference or such manner of study as now might do me service, and what with my natural viciosity of overmuch shamefastness, I am so babished in myself, that I cannot raise up my heart and stomach to utter in talk with other, which (as I may say) with my pen I can express indifferently, without great difficulty."
                            },
                            {
                                "example_id": "bb2b1a8f-f647-41a2-a360-a0652b4e883a",
                                "sense_id": "9a5b8297-9e05-302e-afe6-234173a149f3",
                                "text": "And therefore, in that God by this Office hath advanced you so high, as to set you over his Houshold, Be exhorted so far to know your Place, and the dignity and worth of it, as not to be ashamed of it, nor to be babished in the Execution of it."
                            },
                            {
                                "example_id": "977bec16-43d5-4436-936a-61415fc0f8f2",
                                "sense_id": "9a5b8297-9e05-302e-afe6-234173a149f3",
                                "text": "Thay excusyd hir thus, sothly, To make hir clene of hir foly, And babished me that was old."
                            }
                        ]
                    }
                ],
