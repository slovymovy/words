                                "target_senses": [
                                    {
                                        "sense_id": "c386f108-be99-332a-8bf0-07e9b9f2f7ef",
                                        "entry_id": "b747ec7e-3bd6-38a6-ad3d-417461e5eb69",
                                        "glosses": [
                                            "форма дательного падежа множественного числа существительного сель"
                                        ],
                                        "tags": [
