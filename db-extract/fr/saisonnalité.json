                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d09fdf-e8cf-4529-bb67-bfc8c24d00be",
                                                "sense_id": "d17e7321-de47-3ef0-a3ae-b69ac119eef8",
                                                "text": "Tourism has a high degree of seasonality."
                                            },
                                            {
                                                "example_id": "579a80c6-0b23-4b5c-b0e1-2359cca6825c",
                                                "sense_id": "d17e7321-de47-3ef0-a3ae-b69ac119eef8",
                                                "text": "Between the wars the volume of holiday traffic trebled, but the principal drawback remained - that of seasonality."
                                            }
                                        ]
