                    {
                        "translation_id": "e0020d00-1c43-450c-8871-f5820932de38",
                        "source_entry_id": "31c8e380-bc88-3ebb-a849-ce8c1c6ff2dd",
                        "source_sense_id": "10229bdb-5173-3243-83b7-9e172cae6986",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Irene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37acaa57-1098-3998-a1f7-d2f9d80253ce",
                                        "entry_id": "39f19a20-b1e6-3b91-b1f5-991d0293124c",
                                        "glosses": [
                                            "Eirene, the Greek goddess of peace, one of the Horae/Horæ; equivalent to the Roman goddess Pax."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bee473c8-e5d8-3468-9749-bbf05762737c",
                                        "entry_id": "39f19a20-b1e6-3b91-b1f5-991d0293124c",
                                        "glosses": [
                                            "14 Irene, a main belt asteroid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0427b20-5217-3454-8b8c-069605095421",
                                        "entry_id": "39f19a20-b1e6-3b91-b1f5-991d0293124c",
                                        "glosses": [
                                            "A female given name from Ancient Greek, in regular use since the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbccf83b-76e9-448c-ac32-74803ffaef2c",
                                                "sense_id": "d0427b20-5217-3454-8b8c-069605095421",
                                                "text": "But lest I be thought too literall, give me leave to allegorize upon this Irene. Her name is a Greek name, Εἰρήνη, it signifies peace; we must not dote upon our Irene, our private peace, that the publique should suffer for the sake of it."
                                            },
                                            {
                                                "example_id": "216fa506-ad21-44e2-9fab-1a49922f53e0",
                                                "sense_id": "d0427b20-5217-3454-8b8c-069605095421",
                                                "text": "\"And I have such a horrible name. Think of it... Kate. Who would take Kate on a Moonlight Cruise...or out to the Minstrels at the point. If you ever do find me in the company of a strange young man, call me Irene. Promise me.\""
                                            },
                                            {
                                                "example_id": "620ca046-2f92-4b5e-87e6-1e5eab150a4e",
                                                "sense_id": "d0427b20-5217-3454-8b8c-069605095421",
                                                "text": "Better to consider the love of Irene, the seventh of the sisters, with her most elegant name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50bad99-8336-34ee-8371-99bda9229f00",
                                        "entry_id": "39f19a20-b1e6-3b91-b1f5-991d0293124c",
                                        "glosses": [
                                            "A city and town in South Dakota, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a408e6b-20f1-424d-934a-35df4b051e8b",
                        "source_entry_id": "31c8e380-bc88-3ebb-a849-ce8c1c6ff2dd",
