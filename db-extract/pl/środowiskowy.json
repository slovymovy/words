                        "glosses": [
                            "związany ze środowiskiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c33e44b-7464-4be2-8a37-17ddd0518443",
                                "sense_id": "9f3594ab-ea64-3ed2-98cd-1f7277ac6f59",
                                "text": "Nadaje to włóknom keratynowym odporność na zerwanie i czynniki środowiskowe, zapewniając ich giętkość i elastyczność, zaś stwardnienie – przy bardzo dużej ilości mostków dwusiarczkowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
