                        "sense_id": "c442e00f-2cf4-3778-9f8f-5ef8c3d2a2b0",
                        "entry_id": "d41d6554-a3f7-3dff-95bb-b880ae24c5fb",
                        "glosses": [
                            "Sorte de teinture qui va du vert au bleu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2679759b-4038-44e5-91db-71666e0e3a33",
                                "sense_id": "c442e00f-2cf4-3778-9f8f-5ef8c3d2a2b0",
                                "text": "Ces nuances, vertes et bleues, désignées sous le nom d’éméraldine et d’azurite, ne présentent pas de grand intérêt industriel a cause de leur peu d’éclat."
                            },
                            {
                                "example_id": "a1f311c7-9b38-4027-bab4-85fd1757f8e8",
                                "sense_id": "c442e00f-2cf4-3778-9f8f-5ef8c3d2a2b0",
                                "text": "Pour préparer l’éméraldine, on imprègne la fibre textile avec une solution de 113 grains de chlorate de potasse dans 4 litres et demi d’eau, on foularde, on sèche et on imprime une solution de tartrate ou de chlorhydrate d’aniline à 1 pour 100."
                            }
                        ]
                    },
                    {
                        "sense_id": "7371a460-1981-3514-8984-3c43ccd8922e",
                        "entry_id": "d41d6554-a3f7-3dff-95bb-b880ae24c5fb",
                        "glosses": [
                            "Ce qui est de cette teinte."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "76b9549c-2d16-46e2-82d7-e48c64709f22",
                                "sense_id": "7371a460-1981-3514-8984-3c43ccd8922e",
                                "text": "Puis, dans une trouée du désert d’éméraldine, ils découvrirent quelque chose qui ressemblait à une ville."
                            }
                        ]
                    }
