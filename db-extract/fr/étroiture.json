                ],
                "senses": [
                    {
                        "sense_id": "4c0652ba-2aba-340a-86a0-5b070aba527f",
                        "entry_id": "c989673a-5a99-3724-9d86-f2dfdb37a502",
                        "glosses": [
                            "Resserrement sévère du passage, mais pouvant être franchi. On utilise parfois les termes d’étranglement, rétrécissement ou goulet. Elle prend le terme de chatière, lorsque l’étroiture d’une grotte est un passage bas."
                        ],
                        "tags": [
                            "Spéléologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ae622b1c-8b1e-448f-957e-645c09613057",
                                "sense_id": "4c0652ba-2aba-340a-86a0-5b070aba527f",
                                "text": "À l’extrémité de cette première salle, une étroiture donne accès à une deuxième salle, rectangulaire et haute, au sol fortement incliné d’un mur à l’autre, couvert de gours et encombré de piliers."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bdfd55c-b8d1-35ac-8da7-f2a967a177a3",
                        "entry_id": "c989673a-5a99-3724-9d86-f2dfdb37a502",
                        "glosses": [
                            "Passage resserré."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e221cc54-ec3b-4f0d-812b-c0b40d732a28",
                                "sense_id": "9bdfd55c-b8d1-35ac-8da7-f2a967a177a3",
                                "text": "On descendit un couloir verrouillé par une étroiture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "175928c8-8f20-4b71-bcdb-c928ae7947e2",
                        "source_entry_id": "c989673a-5a99-3724-9d86-f2dfdb37a502",
                        "target_lang_word": "squeeze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squeeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae30d8c0-4527-39dd-a60d-f52e112bb35e",
                                        "entry_id": "49ee9ec2-f0ce-3da1-b27b-e61ecff7f92c",
                                        "glosses": [
                                            "To apply pressure to from two or more sides at once."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5467aefd-b63e-49fa-b01b-6f3012a20188",
                                                "sense_id": "ae30d8c0-4527-39dd-a60d-f52e112bb35e",
                                                "text": "I squeezed the ball between my hands."
                                            },
                                            {
                                                "example_id": "00d6ad5b-83fa-4995-b4ef-6a8b848dc760",
                                                "sense_id": "ae30d8c0-4527-39dd-a60d-f52e112bb35e",
                                                "text": "Please don't squeeze the toothpaste tube in the middle."
                                            },
                                            {
                                                "example_id": "42b5d122-f490-43c7-aadf-36f4e6310f92",
                                                "sense_id": "ae30d8c0-4527-39dd-a60d-f52e112bb35e",
                                                "text": "\"Over there—by the rock,\" Steele muttered, with his brush between his teeth, squeezing out raw sienna, and keeping his eyes fixed on Betty Flanders's back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a86543-5d29-332b-8928-96356121be22",
                                        "entry_id": "49ee9ec2-f0ce-3da1-b27b-e61ecff7f92c",
                                        "glosses": [
                                            "To embrace closely; to give a tight hug to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50f6a0ca-ccf2-3c3b-b6b5-dfad14542454",
                                        "entry_id": "49ee9ec2-f0ce-3da1-b27b-e61ecff7f92c",
                                        "glosses": [
                                            "To fit into a tight place."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d76a754-95cf-4a00-8214-011bca357260",
                                                "sense_id": "50f6a0ca-ccf2-3c3b-b6b5-dfad14542454",
                                                "text": "I managed to squeeze the car into that parking space."
                                            },
                                            {
                                                "example_id": "67ef74a8-9808-4dcf-9538-d0f4cde8331f",
                                                "sense_id": "50f6a0ca-ccf2-3c3b-b6b5-dfad14542454",
                                                "text": "Can you squeeze through that gap?"
                                            },
                                            {
                                                "example_id": "83781905-16f2-4c51-806d-afa15087588f",
                                                "sense_id": "50f6a0ca-ccf2-3c3b-b6b5-dfad14542454",
                                                "text": "I sqeezed myself through the crowd."
                                            },
                                            {
                                                "example_id": "9089eddd-76f0-46a6-b5ff-fe3d72014c87",
                                                "sense_id": "50f6a0ca-ccf2-3c3b-b6b5-dfad14542454",
                                                "text": "It was an omen of things to come as in the 56th minute the visitors took the lead after a mix-up between Skrtel and Sotirios Kyrgiakos allowed Ebanks-Blake's through-ball to squeeze between them."
                                            },
                                            {
                                                "example_id": "87675cf3-bf6e-4a69-9de6-fbe3bb23f14e",
                                                "sense_id": "50f6a0ca-ccf2-3c3b-b6b5-dfad14542454",
                                                "text": "Could he not squeeze under the seat of a carriage? He had seen this method adopted by schoolboys, when the journey- money provided by thoughtful parents had been diverted to other and better ends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b2522b8-9b4e-3de4-a183-925c85c8b759",
                                        "entry_id": "49ee9ec2-f0ce-3da1-b27b-e61ecff7f92c",
                                        "glosses": [
                                            "To remove something with difficulty, or apparent difficulty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad2f45c3-2183-4d2a-bf35-a78ce528e685",
                                                "sense_id": "4b2522b8-9b4e-3de4-a183-925c85c8b759",
                                                "text": "He squeezed some money out of his wallet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f198cc-f6c4-3ac5-a8d9-ebf7996fa6e0",
                                        "entry_id": "49ee9ec2-f0ce-3da1-b27b-e61ecff7f92c",
                                        "glosses": [
                                            "To put in a difficult position by presenting two or more choices."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2a8bdec-6f8f-42d3-8401-227545c257e2",
                                                "sense_id": "b0f198cc-f6c4-3ac5-a8d9-ebf7996fa6e0",
                                                "text": "I'm being squeezed between my job and my volunteer work."
                                            },
                                            {
                                                "example_id": "b0072163-2e85-450e-8b9f-c671706d5ea1",
                                                "sense_id": "b0f198cc-f6c4-3ac5-a8d9-ebf7996fa6e0",
                                                "text": "At a time when Mr. Cameron is being squeezed from both sides — from the right by members of his own party and by the anti-immigrant, anti-Europe U.K. Independence Party, and from the left by his Liberal Democrat coalition partners — the move seemed uncharacteristically clunky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4625c6f0-7b72-3278-8380-662f6110a04e",
                                        "entry_id": "49ee9ec2-f0ce-3da1-b27b-e61ecff7f92c",
                                        "glosses": [
                                            "To oppress with hardships, burdens, or taxes; to harass."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46b3169-a005-427a-b068-2f72987b72ad",
                                                "sense_id": "4625c6f0-7b72-3278-8380-662f6110a04e",
                                                "text": "a Civil War where People must expect to be crush'd and squeez'd in the Consequence"
                                            },
                                            {
                                                "example_id": "8b5fe0b7-7fce-4fb2-8bd9-f655fad3d433",
                                                "sense_id": "4625c6f0-7b72-3278-8380-662f6110a04e",
                                                "text": "However he lost out, as other business interests whom he had alienated by his efforts to squeeze every penny of profit from the canal, supported the construction of the railway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd71f6c-3e30-38c6-a541-1ae0363bfa3f",
                                        "entry_id": "49ee9ec2-f0ce-3da1-b27b-e61ecff7f92c",
                                        "glosses": [
                                            "To attempt to score a runner from third by bunting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5592ae-8711-4f5b-a27d-3fa4dc7dc560",
                                                "sense_id": "ebd71f6c-3e30-38c6-a541-1ae0363bfa3f",
                                                "text": "Jones squeezed in Smith with a perfect bunt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squeeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa088eb-2c3c-3cd8-bf13-2705942299e3",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "An instance of squeezing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1a89e7-e58a-4140-9433-769a529f46fd",
                                                "sense_id": "8aa088eb-2c3c-3cd8-bf13-2705942299e3",
                                                "text": "to give something a squeeze",
                                                "translation": "to squeeze something",
                                                "english": "to squeeze something"
                                            },
                                            {
                                                "example_id": "5776ac1f-690e-417b-a06b-7d111bd0e92e",
                                                "sense_id": "8aa088eb-2c3c-3cd8-bf13-2705942299e3",
                                                "text": "Dip your sponge into the water, tehn turn it over and dip it again. That gets both sides wet. Now give it a squeeze to get most of the water out—but not all of it! You'll get the feel of how much water you need in your sponge as you practice with the clay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82742cff-5c8a-3961-8de5-afc2faca5391",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A close or tight fit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af37fc2c-8f65-36d2-a7b8-5f6f5eaf682b",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A difficult position."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae111a8f-3a3a-4a29-9f0e-99a41f746f2a",
                                                "sense_id": "af37fc2c-8f65-36d2-a7b8-5f6f5eaf682b",
                                                "text": "I'm in a tight squeeze right now when it comes to my free time."
                                            },
                                            {
                                                "example_id": "0433fffb-5481-4072-9b5c-4085076f80f1",
                                                "sense_id": "af37fc2c-8f65-36d2-a7b8-5f6f5eaf682b",
                                                "text": "There is a growing recognition that, as the population ages and the squeeze on NHS resources continues, better ways of supporting older people outside hospital need to be developed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed406de-59e3-3ea9-a8f8-8a818b03511c",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A hug or other affectionate grasp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbbec97-b7af-48ce-9ada-d72ae6c670c0",
                                                "sense_id": "3ed406de-59e3-3ea9-a8f8-8a818b03511c",
                                                "text": "a gentle squeeze on the arm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfdf7477-1222-3e3c-8cb2-87d7e7a11804",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A romantic partner."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904c7e3e-f9f6-4b85-a17d-903714803890",
                                                "sense_id": "bfdf7477-1222-3e3c-8cb2-87d7e7a11804",
                                                "text": "I want to be your main squeeze."
                                            },
                                            {
                                                "example_id": "f9df5063-40df-4ceb-b2be-42306f8a05e7",
                                                "sense_id": "bfdf7477-1222-3e3c-8cb2-87d7e7a11804",
                                                "text": "“No, Mona. Her new squeeze is one of Wage's boys.”"
                                            },
                                            {
                                                "example_id": "22c47b84-4888-4251-a3c5-a70402f19d3c",
                                                "sense_id": "bfdf7477-1222-3e3c-8cb2-87d7e7a11804",
                                                "text": "He spent nights cruising queer bars near the pad, saw Wiltsie at the dives, but always in the company of his squeeze, a guy he called 'Duane.'"
                                            },
                                            {
                                                "example_id": "6cbfbfdd-b2d5-4537-b5e1-ae828f227fe1",
                                                "sense_id": "bfdf7477-1222-3e3c-8cb2-87d7e7a11804",
                                                "text": "His young squeeze had just backed out and had not seen the assault on her “sugar daddy” when it happened!"
                                            },
                                            {
                                                "example_id": "3025e2fa-312e-4a6b-a31b-7ad4f10add5c",
                                                "sense_id": "bfdf7477-1222-3e3c-8cb2-87d7e7a11804",
                                                "text": "But even considering that, he might have been a bit more restrained if he hadn't run into his former sexy squeeze, Penny Atieno."
                                            },
                                            {
                                                "example_id": "2ea2bf3c-153b-4ab8-8f58-1cce9292b669",
                                                "sense_id": "bfdf7477-1222-3e3c-8cb2-87d7e7a11804",
                                                "text": "He didn't smile. \"Del. I have two girlfriends already. If I wanted a third—\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "505f5c46-0dbb-3f63-9eb7-60854aff1f55",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "An illicit alcoholic drink made by squeezing Sterno through cheesecloth, etc., and mixing the result with fruit juice."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89c27924-6099-3e0d-b2f8-a5ce286a64db",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "The act of bunting in an attempt to score a runner from third."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc53ed0-718b-43a6-9ce4-6988b3179257",
                                                "sense_id": "89c27924-6099-3e0d-b2f8-a5ce286a64db",
                                                "text": "The game ended in exciting fashion with a failed squeeze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5362874-11cc-318a-ac66-480455af748b",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A play that forces an opponent to discard a card that gives up one or more tricks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "896e01a4-8bbb-30ea-a2ec-590c358ab7b5",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A traversal of a narrow passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede8b1d7-8bf2-4b6b-ba98-9f64e94c9fbe",
                                                "sense_id": "896e01a4-8bbb-30ea-a2ec-590c358ab7b5",
                                                "text": "It was a tight squeeze, but I got through to the next section of the cave."
                                            },
                                            {
                                                "example_id": "f89aaab4-fc93-43d5-a266-45abe7e1da23",
                                                "sense_id": "896e01a4-8bbb-30ea-a2ec-590c358ab7b5",
                                                "text": "The most notorious squeezes have names: the Gun Barrel, Jam Crack, the Electric Armpit Crawl, Devil's Pinch."
                                            },
                                            {
                                                "example_id": "b604e1ac-17ae-4ed9-81b7-9339588e7e88",
                                                "sense_id": "896e01a4-8bbb-30ea-a2ec-590c358ab7b5",
                                                "text": "Prior to going back out to Mystery Cave again we spent a lot of time preparing. We made a squeeze box, which is a wooden box the opening of which can be adjusted in size. We could then crawl through the opening and measure to see how tight of a squeeze we could fit through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99585e85-ddad-33c3-80ec-2b5d5e666ba0",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A moulding, cast or other impression of an object, chiefly a design, inscription etc., especially by pressing wet paper onto the surface and peeling off when dry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d762ad88-5d29-4c72-95a6-a47e096e937a",
                                                "sense_id": "99585e85-ddad-33c3-80ec-2b5d5e666ba0",
                                                "text": "Nollekens, finding his wife always benefited by these visits, never refused White a squeeze of a patera, or any thing that would answer his purpose; […] White […] had turned his wine-cellars into manufactories for the produce of cast coins, and moderns squeezes from Roman lamps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d009bb37-79fe-3322-9cdf-5a86b41935bb",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "The gradual closing of workings by the weight of the overlying strata."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c518a38-ad93-3a5c-b2b7-3751e8dc84f9",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "The situation experienced by a middleman when pressured from both sides, especially financially."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed2a103e-26af-400b-9858-cf3d73c37a7c",
                                                "sense_id": "6c518a38-ad93-3a5c-b2b7-3751e8dc84f9",
                                                "text": "Thus was established a powerful Chinese combination, which maintained itself by submitting to a heavy \"squeeze\" at the hands of the Viceroy and Governor of Canton on the one hand and of the Hoppo on the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f4c67b0-9771-3d8f-a8be-072ba831e04d",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A bribe, fee, or extortionary price paid to a middleman, especially in China; the practice of requiring such a bribe or fee."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e537e86-592e-43fe-a57d-c2b2f3a4c1c3",
                                                "sense_id": "7f4c67b0-9771-3d8f-a8be-072ba831e04d",
                                                "text": "If the licence […] was costly, it secured to them uninterrupted and extraordinary pecuniary advantages; but on the other hand it subjected them to 'calls' or 'squeezes' for contributions to public works, […] for the relief of districts suffering from scarcity […] as well as for the often imaginary […] damage caused by the overflowing of the 'Yangtse Keang' or the 'Yellow River.'"
                                            },
                                            {
                                                "example_id": "a057ea98-f297-48e9-8d5b-e5017f1d0cba",
                                                "sense_id": "7f4c67b0-9771-3d8f-a8be-072ba831e04d",
                                                "text": "They were no colonists; their administration was merely a squeeze, and nothing more, I suspect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba002acc-3ea6-3d0d-b34f-7bb56dd753ce",
                                        "entry_id": "e0dbc41a-4861-310e-88aa-671b8ce30a4c",
                                        "glosses": [
                                            "A person's neck."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3343cc29-1c32-4bef-ae40-384dcdad6885",
                                                "sense_id": "ba002acc-3ea6-3d0d-b34f-7bb56dd753ce",
                                                "text": "\"Got his description putty close: Short black 'air, black whiskers, with a crips^([sic]) curl at the hedges; a white choker, tight round his squeeze; dressed in black, and orful hugly,\" remarked the policeman."
