                                    {
                                        "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                        "entry_id": "02a95388-4099-387f-83f4-6336d92aa700",
                                        "glosses": [
                                            "in Richtung des Meeres oder eines Sees (Binnengewässer)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3b7eb0e-786d-4b62-9bf7-1461ac85f5af",
                                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                                "text": "„Wenn du mit deiner Luftmatratze vom Strand seewärts treibst, bleibe unbedingt drauf, das ist deine einzige Chance!“"
                                            },
                                            {
                                                "example_id": "703690d4-929f-4739-848a-1a61c2ba51a5",
                                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                                "text": "Marineboote und -schiffe sicherten den Tagungsort seewärts ab."
                                            },
                                            {
                                                "example_id": "21db3ae6-9249-489a-b890-51ac0ad36fc4",
                                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                                "text": "„Wir brauchen [für die auf Grund gelaufene Fähre] nur die sprichwörtliche Handbreit Wasser unterm Kiel. Dann könnten wir uns mit Motorenkraft freischwimmen,“ hofft Ackermann. „Da könnte das Hochwasser gerade so reichen.“ Allerdings drückt Ostwind seewärts, da fällt das Hochwasser schon mal niedriger aus."
                                            },
                                            {
                                                "example_id": "cd9ff38e-81df-405e-8f10-cd514a8595ef",
                                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                                "text": "Geologisch gesehen sind die Förden aber keine Fjorde, weil letztere durch seewärts wandernde Gletscher entstanden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
