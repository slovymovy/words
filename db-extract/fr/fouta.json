                    {
                        "sense_id": "95b5b014-c829-388a-9e25-6d175e6fd723",
                        "entry_id": "3299f1b3-f80b-3a8c-87f0-4acc97d28f16",
                        "glosses": [
                            "Pagne tissé qu’on porte au hammam."
                        ],
                        "tags": [
                            "Afrique du Nord"
                        ],
                        "examples": [
                            {
                                "example_id": "5706a73a-6455-4f29-a67b-a27ababa69a3",
                                "sense_id": "95b5b014-c829-388a-9e25-6d175e6fd723",
                                "text": "Un narghilé d’argent très pur\nCoudoie une lampe à pétrole,\nEt des foutas pendent au mur\nPrès d'une horrible camisole."
                            },
                            {
                                "example_id": "13922b65-eab8-4020-885a-13e94a544501",
                                "sense_id": "95b5b014-c829-388a-9e25-6d175e6fd723",
                                "text": "Ce mur est sacré ; tous les jours les femmes arabes viennent y suspendre des ex-voto, fragments de haïcks et de foutas, longues tresses de cheveux roux liés par des fils d’argent, pans de beurnouss."
                            }
                        ]
                    },
                    {
                        "sense_id": "16b4595b-e1ee-3641-af22-dbaca4b24b81",
                        "entry_id": "3299f1b3-f80b-3a8c-87f0-4acc97d28f16",
                        "glosses": [
                            "Foulard ou étoffe de soie rayée que portaient les femmes juives ou musulmanes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "eaacc059-8283-42b8-8040-7178168c22ed",
                                "sense_id": "16b4595b-e1ee-3641-af22-dbaca4b24b81",
                                "text": "Je reconnus les oripeaux qu’elle avait sortis de ses caisses de bois blanc : la jebba orange constellée de paillettes rouges et vertes, la fouta de soie artificielle, brillante, multicolore, orange, jaune, vert, rouge, le foulard vert et jaune orné d’une main et d’un poisson."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b170fb3-1d1a-3e9b-8698-65c75a6c321f",
                        "entry_id": "3299f1b3-f80b-3a8c-87f0-4acc97d28f16",
                        "glosses": [
                            "Serviette de bain légère."
                        ],
