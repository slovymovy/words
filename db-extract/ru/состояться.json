                    },
                    {
                        "form_id": "d2864c71-88bc-4676-b54f-c77912adf9b1",
                        "entry_id": "9d390410-b6ff-3910-a4e9-08639e51cb12",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "состоя́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "920ce414-b255-3277-bb7f-8b612091b71c",
                        "entry_id": "9d390410-b6ff-3910-a4e9-08639e51cb12",
                        "glosses": [
                            "произойти, осуществиться."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be276b98-ab2b-4c8f-a79b-018251f81e72",
                                "sense_id": "920ce414-b255-3277-bb7f-8b612091b71c",
                                "text": "В этот день состоятся выборы во многие органы местного самоуправления."
                            },
                            {
                                "example_id": "a74b9394-a929-40d7-b8e3-f0217f4f1a37",
                                "sense_id": "920ce414-b255-3277-bb7f-8b612091b71c",
                                "text": "Сегодня вечером на киевском стадионе «Динамо» имени Валерия Лобановского состоится матч между футбольными командами «Маккаби» и «Ливерпуль»."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6fe3b70-d40f-3784-8f92-273cfbe88233",
                        "entry_id": "9d390410-b6ff-3910-a4e9-08639e51cb12",
                        "glosses": [
                            "утвердиться к каком-либо качестве, оказаться полноценным представителем какой-либо категории."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d46d4d-e72d-4253-b4d9-1a5e284745b5",
                                "sense_id": "c6fe3b70-d40f-3784-8f92-273cfbe88233",
                                "text": "Он состоялся как крупный предприниматель."
                            },
                            {
                                "example_id": "f29f308f-49cd-4338-8032-43bb903aaf6d",
                                "sense_id": "c6fe3b70-d40f-3784-8f92-273cfbe88233",
                                "text": "Казахстан состоялся как суверенное, независимое государство."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0cafaa0-b124-4411-9474-4c052ff5a557",
                        "source_entry_id": "9d390410-b6ff-3910-a4e9-08639e51cb12",
                        "source_sense_description": "произойти",
                        "target_lang_word": "take place",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "take place",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                        "entry_id": "2954671d-bbc7-38bf-a48a-d80b472f74fa",
                                        "glosses": [
                                            "To happen or to occur."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1e83ee-27d6-4e20-b1c8-26e2973c6baa",
                                                "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                                "text": "Unfortunately, the meeting never took place."
                                            },
                                            {
                                                "example_id": "e5cc8acc-7e36-4dbe-a26d-c0c641d3c3a4",
                                                "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                                "text": "The wedding was to take place in the rose garden."
                                            },
                                            {
                                                "example_id": "53233ea4-c178-465c-91e3-7497e970f4a2",
                                                "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                                "text": "[…] when sold and delivered up to their inhuman purchasers, a more heart-piercing scene cannot well take place."
                                            },
                                            {
                                                "example_id": "b97e9ddf-a112-450e-af78-e575abb00fe9",
                                                "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                                "text": "A change had taken place in the weather the preceding evening, and a keen north-east wind, whistling through the crevices of our bed-room windows all night long, had made us shiver in our beds […]"
                                            },
                                            {
                                                "example_id": "61384edd-e6e0-4e19-9928-346db3a9cb30",
                                                "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                                "text": "The accommodation for passengers was designed on a rather lavish scale, as it was expected that extensive housing development would take place in the vicinity. These hopes were not realised, however, and, apart from the school buildings, the surroundings of the station have never lost their rusticity."
                                            },
                                            {
                                                "example_id": "32558f97-4b3d-44f4-b939-2f7ea197c3b8",
                                                "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "8ef3e953-3684-406c-aaff-fc3920dc5352",
                                                "sense_id": "e0a5b5de-7bea-3876-b973-06754a368a92",
                                                "text": "Part-funded through Avanti West Coast's Station Community Project Fund, events are taking place between April 2021 and April 2022 to coincide with key milestones in the lines' history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9795afd-1d21-3867-8d52-5a8031da3841",
                                        "entry_id": "2954671d-bbc7-38bf-a48a-d80b472f74fa",
                                        "glosses": [
                                            "To take precedence or priority."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd28b43-203d-4779-bbab-ee41656eacff",
                                                "sense_id": "b9795afd-1d21-3867-8d52-5a8031da3841",
                                                "text": "I know him a notorious liar, / Think him a great way fool, solely a coward; / Yet these fixed evils sit so fit in him, / That they take place, when virtue’s steely bones / Look bleak i’ the cold wind […]"
                                            },
                                            {
                                                "example_id": "62ff4ac7-08f8-4401-9000-a010c13560e6",
                                                "sense_id": "b9795afd-1d21-3867-8d52-5a8031da3841",
                                                "text": "As a British Free-Holder, I should not scruple taking place of a French Marquis; and when I see one of my Countreymen amusing himself in his little Cabbage-Garden, I naturally look upon him as a greater Person than the Owner of the richest Vineyard in Champagne."
                                            },
                                            {
                                                "example_id": "a89058c9-eb08-4c91-8ec3-a197edfd47c4",
                                                "sense_id": "b9795afd-1d21-3867-8d52-5a8031da3841",
                                                "text": "[…] I wish anybody could give Mary a hint that it would be a great deal better if she were not so very tenacious, especially if she would not be always putting herself forward to take place of mamma. Nobody doubts her right to have precedence of mamma, but it would be more becoming in her not to be always insisting on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e33df999-4e38-38ac-abdd-e43d77bbfd21",
                                        "entry_id": "2954671d-bbc7-38bf-a48a-d80b472f74fa",
                                        "glosses": [
                                            "To take effect; to prevail."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04799939-638d-4102-9fe8-f0292e6ff6f1",
                                                "sense_id": "e33df999-4e38-38ac-abdd-e43d77bbfd21",
                                                "text": "But he to shifte their curious request, / Gan causen, why she could not come in place; / Her crased helth, her late recourse to rest, / And humid euening ill for sicke folkes cace, / But none of those excuses could take place; / Ne would they eate, till she in presence came."
                                            },
                                            {
                                                "example_id": "0996a2bd-353d-41e7-8939-8858325eef85",
                                                "sense_id": "e33df999-4e38-38ac-abdd-e43d77bbfd21",
                                                "text": "[…] the moderate advice took place, and the people, upon the Kings engagement of soon remedying their miseries, return’d with blessings for him […]"
                                            },
                                            {
                                                "example_id": "6d2ff58c-e8dc-47d4-8a90-b52f6eee8bb0",
                                                "sense_id": "e33df999-4e38-38ac-abdd-e43d77bbfd21",
                                                "text": "If your Doctrine takes place I vvou'd fain knovv vvhat can be the advantage of a great fortune, vvhich all mankind ſo eagerly purſue?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fef87ee-398a-318d-86aa-d257e70d9912",
                                        "entry_id": "2954671d-bbc7-38bf-a48a-d80b472f74fa",
                                        "glosses": [
                                            "To sit in a particular location, take one's place."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74e9057f-7a7b-4316-a439-8ee1b8436273",
                                                "sense_id": "1fef87ee-398a-318d-86aa-d257e70d9912",
                                                "text": "King Henry VIII takes place under the cloth of state; Cardinal Wolsey and Cardinal Campeius sit under him as judges. Queen Katharine takes place some distance from King Henry VIII."
                                            },
                                            {
                                                "example_id": "5ac7ca55-d14e-4956-b293-9ec3849035a9",
                                                "sense_id": "1fef87ee-398a-318d-86aa-d257e70d9912",
                                                "text": "Cedric himself coldly nodded in answer to the Jew's repeated salutations, and signed to him to take place at the lower end of the table, where, however, no one offered to make room for him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
