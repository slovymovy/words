        "nl-extract.jsonl": [
            {
                "entry_id": "cd5e40cd-b638-3406-adb9-5c089a85937d",
                "word": "assembleren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e0b2eaf6-b329-3414-b24b-30c2e49acde7",
                        "entry_id": "cd5e40cd-b638-3406-adb9-5c089a85937d",
                        "glosses": [
                            "bouwen of maken door onderdelen samen te voegen of te monteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6539372-4c5e-46cc-9b61-828c36057b1f",
                                "sense_id": "e0b2eaf6-b329-3414-b24b-30c2e49acde7",
                                "text": "Schaalvergroting is onvermijdelijk, schrijven Franse analisten. Daardoor kan groter worden ingekocht en kunnen ‘platforms’ gedeeld worden. Nu al maakt PSA in het Oost-Franse Sochaux de Opel Zafira en Opel gaat een nieuwe Citroën C3 in Spanje assembleren. Die samenwerking komt voort uit de kortstondige toenadering tussen GM en PSA in 2012-2013."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c61d2b6-a70e-48c3-9778-efa0f4750cbe",
                        "source_entry_id": "cd5e40cd-b638-3406-adb9-5c089a85937d",
                        "source_sense_id": "e0b2eaf6-b329-3414-b24b-30c2e49acde7",
                        "source_sense_description": "bouwen of maken door onderdelen samen te voegen of te monteren",
                        "target_lang_word": "assemble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assemble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b963fe5-0602-3fe4-b255-fd58a1089e15",
                                        "entry_id": "e0736c96-8b4f-3998-b317-d634d53191fc",
                                        "glosses": [
                                            "To put together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b05c98-4b5c-446e-83bb-9ddaf11c4c10",
                                                "sense_id": "3b963fe5-0602-3fe4-b255-fd58a1089e15",
                                                "text": "He assembled the model ship."
                                            },
                                            {
                                                "example_id": "5c5e0960-17e1-434d-9aa0-ef3fe18ebf76",
                                                "sense_id": "3b963fe5-0602-3fe4-b255-fd58a1089e15",
                                                "text": "The handman reads copy and assembles type by hand, including straight composition, tables and display."
                                            },
                                            {
                                                "example_id": "6df4c931-e55a-4b37-805b-2ce22ab33f24",
                                                "sense_id": "3b963fe5-0602-3fe4-b255-fd58a1089e15",
                                                "text": "This micro-generation of Silicon Valley start-ups did two basic things: It put together a labor pool to deliver food or clean toilets or assemble IKEA bookshelves, and it found people who needed those things done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5f71b6-a7d7-3ad2-a5e6-096fb97f740a",
                                        "entry_id": "e0736c96-8b4f-3998-b317-d634d53191fc",
                                        "glosses": [
                                            "To gather as a group."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13dc6ca9-e4eb-4ae9-8c36-4fdd43dfa545",
                                                "sense_id": "6f5f71b6-a7d7-3ad2-a5e6-096fb97f740a",
                                                "text": "The parents assembled in the school hall."
                                            },
                                            {
                                                "example_id": "4997f8fb-dae1-4926-b4b9-3f79c0dd4048",
                                                "sense_id": "6f5f71b6-a7d7-3ad2-a5e6-096fb97f740a",
                                                "text": "Thither he assembled all his train."
                                            },
                                            {
                                                "example_id": "064f76d2-683f-4224-9e4d-e36d939547b9",
                                                "sense_id": "6f5f71b6-a7d7-3ad2-a5e6-096fb97f740a",
                                                "text": "All the men of Israel assembled themselves."
                                            },
                                            {
                                                "example_id": "677fac78-82a5-4ef6-a8e2-3da863c7ad2e",
                                                "sense_id": "6f5f71b6-a7d7-3ad2-a5e6-096fb97f740a",
                                                "text": "Actually, no. The scientists and scholars Heartland is assembling are not members of the gloom-and-doom chorus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74326290-e775-34a9-8352-23d3f485a4c8",
                                        "entry_id": "e0736c96-8b4f-3998-b317-d634d53191fc",
                                        "glosses": [
                                            "To translate from assembly language to machine code."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
