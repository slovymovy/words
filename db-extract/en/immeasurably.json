        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e7204749-43b2-32da-b703-a145cff98e7e",
                "word": "immeasurably",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
                        "entry_id": "e7204749-43b2-32da-b703-a145cff98e7e",
                        "glosses": [
                            "In a manner that is not measurable, in a way that cannot be measured."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "481897d9-f7ce-476c-9de4-95342f07a90b",
                                "sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
                                "text": "The sky seems immeasurably large at night."
                            },
                            {
                                "example_id": "40baee7c-91c3-4173-a689-6b735d84a6db",
                                "sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
                                "text": "Yet Mrs Allen found much favour with the décor of the new vehicles. She also agreed that the levels of comfort were \"immeasurably higher\" than she had previously found."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6e9b457-8fed-4bb3-8692-5b1daa503dbe",
                        "source_entry_id": "e7204749-43b2-32da-b703-a145cff98e7e",
                        "source_sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
                        "source_sense_description": "in a manner that is not measurable",
                        "target_lang_word": "incommensurablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incommensurablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "899eb333-c5a7-3097-b41d-d1277a1d023d",
                                        "entry_id": "c9002316-b126-3f0a-b145-5d45fbaa5ec8",
                                        "glosses": [
                                            "D'une manière incommensurable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c233e91-9325-4318-8771-b238b0c78fa7",
                                                "sense_id": "899eb333-c5a7-3097-b41d-d1277a1d023d",
                                                "text": "Le système [des paris discrétionnaires] dépassait incommensurablement celui des paris mutuels."
                                            },
                                            {
                                                "example_id": "bcac251d-84df-4a88-8b51-ae4fb8961c80",
                                                "sense_id": "899eb333-c5a7-3097-b41d-d1277a1d023d",
                                                "text": "Et, pour couronner le tout, une montagne dépassant incommensurablement en hauteur les pics les plus élevés des Andes ou de l'Himalaya."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b247ad80-ca3d-4fcd-9bf5-3a719fb6ac78",
                        "source_entry_id": "e7204749-43b2-32da-b703-a145cff98e7e",
                        "source_sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
