{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "333e948b-72a2-3cc5-a2f2-5e317648f856",
                    "sense_definition": "Междометие, выражающее сильное чувство, удивление или обращение.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interjection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>О</w> боже, как это красиво!",
                            "target_lang_translations": {
                                "en": "<w>Oh</w> my god, how beautiful this is!"
                            }
                        },
                        {
                            "text": "<w>О</w>, я совсем забыл об этом деле.",
                            "target_lang_translations": {
                                "en": "<w>Oh</w>, I completely forgot about this matter."
                            }
                        }
                    ],
                    "common_phrases": [
                        "о боже"
                    ],
                    "target_lang_definitions": {
                        "en": "An interjection used to express strong emotion, surprise, or to address someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "Used to express surprise, emotion, or as a vocative particle."
                            },
                            {
                                "target_lang_word": "alas",
                                "target_lang_sense_clarification": "Used to express sorrow, regret, or disappointment."
                            },
                            {
                                "target_lang_word": "wow",
                                "target_lang_sense_clarification": "Used to express excitement, astonishment, or admiration."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "2499e531-9695-3543-ae5d-246f17b31115",
                    "sense_definition": "Предлог, указывающий на предмет мысли, речи или чувства (употребляется с предложным падежом).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "preposition_about",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я много читал <w>о</w> нём в книгах.",
                            "target_lang_translations": {
                                "en": "I read a lot <w>about</w> him in books."
                            }
                        },
                        {
                            "text": "Мы долго говорили <w>о</w> погоде.",
                            "target_lang_translations": {
                                "en": "We talked for a long time <w>about</w> the weather."
                            }
                        }
                    ],
                    "common_phrases": [
                        "думать о",
                        "говорить о"
                    ],
                    "target_lang_definitions": {
                        "en": "A preposition indicating the subject of thought, speech, or feeling (used with the prepositional case)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "about",
                                "target_lang_sense_clarification": "Concerning or on the subject of something."
                            },
                            {
                                "target_lang_word": "on",
                                "target_lang_sense_clarification": "Dealing with the subject of; concerning."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f64dbf9c-5244-335e-bea0-135a125cbb3d",
                    "sense_definition": "Предлог, указывающий на соприкосновение или столкновение с чем-либо (употребляется с винительным падежом).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preposition_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он начал <w>опираться</w> <w>о</w> стену.",
                            "target_lang_translations": {
                                "en": "He began to lean <w>against</w> the wall."
                            }
                        },
                        {
                            "text": "Волны бьются <w>о</w> берег.",
                            "target_lang_translations": {
                                "en": "The waves crash <w>against</w> the shore."
                            }
                        }
                    ],
                    "common_phrases": [
                        "опираться о",
                        "биться о"
                    ],
                    "target_lang_definitions": {
                        "en": "A preposition indicating contact or collision with something (used with the accusative case)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "against",
                                "target_lang_sense_clarification": "In physical contact with, or in collision with."
                            },
                            {
                                "target_lang_word": "on",
                                "target_lang_sense_clarification": "Denoting physical contact or impact with a surface."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
