                                        "entry_id": "badb203a-d8aa-3970-9a12-e24529e9db08",
                                        "glosses": [
                                            "Paciente afectado por tuberculosis, por lo cual está sumamente delgado y débil."
                                        ],
                                        "tags": [
                                            "noun",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51dbca7a-44c3-4f3b-bf3e-8956046eb121",
                                                "sense_id": "9c90acfb-c203-354d-807d-b0b03450ef11",
                                                "text": "¡Te adoro! Pero sobre todo me encantas porque eres de esas escritoras-filólogas que veneran las palabras esdrújulas. Eres la única persona lo suficientemente segura de sí misma —¿egocéntrica, ególatra?— como para atreverte a decir \"hético\" en vez de \"delgado\". ¡\"Hético\"! ¡Cómo no amar irracionalmente a una mujer que dice \"hético\"!"
                                            }
