                    ],
                    "common_phrases": [
                        "wyraźnie widać",
                        "mówić wyraźnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "так, что легко заметить, услышать или прочитать; отчётливо, ясно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчётливо",
                                "target_lang_sense_clarification": "хорошо различимо для органов чувств"
                            },
                            {
                                "target_lang_word": "чётко",
                                "target_lang_sense_clarification": "ясно, без искажений (о звуке, изображении)"
                            },
                            {
                                "target_lang_word": "разборчиво",
                                "target_lang_sense_clarification": "легко для прочтения или распознавания речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b39daba-5afa-364f-9ddf-101a3f6f4bb1",
                    "sense_definition": "w sposób niewątpliwy, bezdyskusyjny lub w znacznym stopniu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pewność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W regulaminie było <w>wyraźnie</w> powiedziane, że palenie jest zabronione.",
                            "target_lang_translations": {
                                "ru": "В правилах было <w>прямо</w> сказано, что курение запрещено."
                            }
                        },
                        {
                            "text": "Po długiej podróży był <w>wyraźnie</w> zmęczony i chciał od razu odpocząć.",
                            "target_lang_translations": {
                                "ru": "После долгой дороги он был <w>явно</w> уставшим и хотел сразу же отдохнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "ewidentnie",
                        "najwyraźniej",
                        "jawnie"
                    ],
                    "common_phrases": [
                        "wyraźnie zaznaczyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "несомненным образом, бесспорно или в заметной, значительной степени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явно",
                                "target_lang_sense_clarification": "очевидно, заметно по внешним признакам"
                            },
                            {
                                "target_lang_word": "несомненно",
                                "target_lang_sense_clarification": "бесспорно, со всей определённостью"
                            },
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "недвусмысленно, прямым текстом"
