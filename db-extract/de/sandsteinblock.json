                        "examples": [
                            {
                                "example_id": "214ba3b8-c28f-4df2-a930-413563f03d10",
                                "sense_id": "b3f64566-f114-3bd5-a1ee-db4be2c123ae",
                                "text": "„Überall ragten Sandsteinblöcke aus der Wand, auf denen man Eimer zum Sammeln von Regenwasser abgestellt hatte.“"
                            },
                            {
                                "example_id": "47d65a72-10fa-4615-9da2-18f780a7093c",
                                "sense_id": "b3f64566-f114-3bd5-a1ee-db4be2c123ae",
                                "text": "„Der Boden des Wagens hängt fast auf der Straße, und in die rosa Babydecke ist ein Sandsteinblock eingewickelt, der so groß ist, dass Denny oder ich ihn nicht allein anheben können.“"
                            }
                        ],
