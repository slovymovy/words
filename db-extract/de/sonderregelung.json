                "senses": [
                    {
                        "sense_id": "3dc4e3d2-f8fd-3be8-96df-ba99237e7c9a",
                        "entry_id": "f4921395-22a8-3c1c-bccb-568996383303",
                        "glosses": [
                            "Festlegung/Vorschrift, die für einen besonderen Zweck geschaffen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e44701a7-dc3d-4172-a1bb-3c426cf928e1",
                                "sense_id": "3dc4e3d2-f8fd-3be8-96df-ba99237e7c9a",
                                "text": "„Während an anderen weiterführenden Schulen ab kommender Woche neben den Abschlussschülern auch die Elftklässler wieder an den Schulen unterrichtet werden sollen, gibt es für die Fach- und Berufsoberschulen eine Sonderregelung.“"
                            },
                            {
                                "example_id": "1ab8b71c-e45b-43a6-b845-dd7ae5930a79",
                                "sense_id": "3dc4e3d2-f8fd-3be8-96df-ba99237e7c9a",
                                "text": "„Der Vorsitzende der Innenministerkonferenz Georg Maier (SPD) hat sich für eine Sonderregelung bei der Duldung für Geflüchtete ausgesprochen, die wegen der Corona-Pandemie ihren Job oder Ausbildungsplatz verloren haben.“"
                            },
                            {
                                "example_id": "ff6c8078-d8f7-4619-b66f-c58296a6604a",
                                "sense_id": "3dc4e3d2-f8fd-3be8-96df-ba99237e7c9a",
                                "text": "„Der Deutsche Hausärzteverband hatte gefordert, die Sonderregelung mindestens bis Ende Juni zu verlängern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
