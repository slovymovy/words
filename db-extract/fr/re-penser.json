                    }
                ],
                "senses": [
                    {
                        "sense_id": "40d31d20-3142-3228-9fa1-f26190923356",
                        "entry_id": "9a45d048-a91d-36bd-a85c-4d140f40b9f9",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, et permettant d’insister sur le préfixe de repenser (penser à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55cdceca-de9e-4b96-8f8c-a22ae87fad8e",
                                "sense_id": "40d31d20-3142-3228-9fa1-f26190923356",
                                "text": "Mon enfant propose une aide positive et sensible pour re-penser aux moments marquants qui nourrissent la relation parent/enfant."
                            },
                            {
                                "example_id": "a6536570-5b2c-4485-8f96-1e9e4be7ed60",
                                "sense_id": "40d31d20-3142-3228-9fa1-f26190923356",
                                "text": "L’homme pense d’abord sans parole… Mais pour re-penser, c’est-à-dire réfléchir ou exprimer sa pensée il a besoin de la parole."
                            },
                            {
                                "example_id": "73a27b6f-b927-4d4e-91cb-9e5b944f62b3",
                                "sense_id": "40d31d20-3142-3228-9fa1-f26190923356",
                                "text": "L’auditeur peut re-sentir ce que le compositeur a senti, à des nuances près, mais il ne peut re-penser en aucune manière ce que le compositeur a pensé."
                            },
                            {
                                "example_id": "1a8abb3c-ce1c-4590-8e47-0982ef1ff8df",
                                "sense_id": "40d31d20-3142-3228-9fa1-f26190923356",
                                "text": "’'Il écrit, éteint, se couche, réfléchit, rallume, ré-écrit, ré-éteint, se re-couche, re-pense. — (Jean-Louis Cluzel, d’Ici, Ailleurs !, 2020)"
                            }
                        ]
                    }
                ],
