                "senses": [
                    {
                        "sense_id": "1167fc54-ef28-3c50-9c2d-f42f972a0f80",
                        "entry_id": "5f801057-6cfe-3d16-a978-f35faa99acdd",
                        "glosses": [
                            "weibliche Person, die sich im Freien für Prostitution anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ed28de-e203-409f-a349-5a39456e771c",
                                "sense_id": "1167fc54-ef28-3c50-9c2d-f42f972a0f80",
                                "text": "„An der Prenzlauer Straße vor der kleinen Konditorei stand eine Gruppe Straßenmädchen unter Schirmen und versperrte die Passage.“"
                            },
                            {
                                "example_id": "5da18d33-ee16-4c27-9579-010c30394ca5",
                                "sense_id": "1167fc54-ef28-3c50-9c2d-f42f972a0f80",
                                "text": "„Sie schwankte wie ein Straßenmädchen unter dem brutalen Faustschlag eines Betrunkenen, lief aus dem Zimmer und stürzte, sich an der Rampe festhaltend, die Treppe hinauf.“"
                            },
                            {
                                "example_id": "ff236f59-98c4-4e1f-b822-d766cebffe52",
                                "sense_id": "1167fc54-ef28-3c50-9c2d-f42f972a0f80",
                                "text": "„Der Wirt war hinter der Theke hervorgetreten und hatte sich zwischen zwei blaugefrorene Straßenmädchen gesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
