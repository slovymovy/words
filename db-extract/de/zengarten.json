                "senses": [
                    {
                        "sense_id": "0b863750-69f0-3737-a494-30be2041c1ff",
                        "entry_id": "d44a5372-6b74-3304-9a8f-5c8f43a04b26",
                        "glosses": [
                            "der Erholung dienendes Gelände, welches nur aus Kies, Steinen, Felsbrocken und Moos besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63a46885-63c8-4bed-8b7a-1ad119c44906",
                                "sense_id": "0b863750-69f0-3737-a494-30be2041c1ff",
                                "text": "Neben einem asiatischen Zengarten liegt eine rustikale Seemannshütte, die sich an ein gemütliches Bauernhäuschen reiht."
                            },
                            {
                                "example_id": "401f2946-4dc8-49e4-93d6-ec94038b34b9",
                                "sense_id": "0b863750-69f0-3737-a494-30be2041c1ff",
                                "text": "In Japans berühmtem Zengarten Ryoanji unternimmt man eine Reise zu den Inseln der Seligen."
                            },
                            {
                                "example_id": "ac7b1d52-3f35-4494-8f32-41d75752a432",
                                "sense_id": "0b863750-69f0-3737-a494-30be2041c1ff",
                                "text": "Und beim zweiten Dessert thront ein kleiner Buddha aus weißer Schokolade in einem Zengarten aus weißen Kekskrümeln, flankiert durch Lakritze, Thymian-Crumble und Rhabarber-Creme, wenn wir uns recht erinnern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
