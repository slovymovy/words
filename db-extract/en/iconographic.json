                                        "entry_id": "96fe919c-4825-3b24-bac7-f828a875d7eb",
                                        "glosses": [
                                            "in Bezug auf die Ikonographie, der (wissenschaftlichen) Bestimmung, Beschreibung und Deutung von Kunstwerken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb52ee02-4a11-4c5a-ba4a-f694b9a62e57",
                                                "sense_id": "2bf06a94-3b4c-343a-bb6c-f4875c924b4d",
                                                "text": "„Gemäß alter ikonographischer Tradition sollte auch die königliche Familie im Bild dargestellt werden.“"
                                            },
                                            {
                                                "example_id": "003af596-744b-416f-a63e-0fa45201d937",
                                                "sense_id": "2bf06a94-3b4c-343a-bb6c-f4875c924b4d",
                                                "text": "„Trotz des Bekanntheitsgrades der Bilder sind sowohl ihre Herkunft als auch ihr ikonographischer Sinn bis heute ungeklärt und geheimnisvoll geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
