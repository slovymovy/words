                    },
                    {
                        "form_id": "4871afba-7c8a-4181-b95f-48ab5720c676",
                        "entry_id": "c541a327-9509-3c00-b93b-0d8b71484a72",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "селёдках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e21b55a-e54c-3516-a419-03631f80ed4a",
                        "entry_id": "c541a327-9509-3c00-b93b-0d8b71484a72",
                        "glosses": [
                            "разг. то же, что сельдь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e17c87-7f0f-4af0-b7ec-e666d45e5674",
                                "sense_id": "7e21b55a-e54c-3516-a419-03631f80ed4a",
                                "text": "Крупные зубари приближаются по габаритам к селёдке, но если для корюшки сравнение с селёдкой ― комплимент, то для селёдки ― наоборот (по крайней мере для нашей ― тихоокеанской, гренадёрской)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aaf0201-40a5-33c4-b9d5-5efeed683297",
                        "entry_id": "c541a327-9509-3c00-b93b-0d8b71484a72",
                        "glosses": [
                            "неодуш., разг. мясо такой рыбы, употребляемое в пищу"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "77398bca-a580-3f5b-a073-11e464586916",
                        "entry_id": "c541a327-9509-3c00-b93b-0d8b71484a72",
                        "glosses": [
                            "неодуш., разг., кулин. кушанье, приготовленное из такого мяса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e48d67-0153-4d3b-8a85-9c40d1a1ce57",
                                "sense_id": "77398bca-a580-3f5b-a073-11e464586916",
                                "text": "— Палагея Сидоровна, дай-ка мне настоечки да приготовь селёдки с луком."
                            },
                            {
                                "example_id": "3bbd8973-5b74-4a76-97f2-cf6fe393233b",
                                "sense_id": "77398bca-a580-3f5b-a073-11e464586916",
                                "text": ".. племянница Вера таскала Ольге с поминального стола то блинчики с селёдкой, то кутьи на блюдце, то крахмального киселя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44b4d1d8-820d-4387-9b82-998a8c7897c8",
                        "source_entry_id": "c541a327-9509-3c00-b93b-0d8b71484a72",
                        "source_sense_description": "то же, что сельдь",
                        "target_lang_word": "herring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3770b6-c681-3d2b-a44a-5462a971e954",
                                        "entry_id": "99bb0940-74e0-3eb1-972f-d3404037c4fb",
                                        "glosses": [
                                            "A type of small, oily fish of the genus Clupea, often used as food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa01d38c-dd00-4242-91da-f1b9a63a9f8c",
                                                "sense_id": "2a3770b6-c681-3d2b-a44a-5462a971e954",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e88050a6-c6f2-33f9-b666-e3cc787a36bc",
                                        "entry_id": "99bb0940-74e0-3eb1-972f-d3404037c4fb",
                                        "glosses": [
                                            "Fish in the family Clupeidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c44a036-7c25-34d9-9b10-c6ccc62888c5",
                                        "entry_id": "99bb0940-74e0-3eb1-972f-d3404037c4fb",
                                        "glosses": [
                                            "Those fish and any other fish similar to those in genus Clupea, many of those in the order Clupeiformes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
