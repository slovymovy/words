    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e47ec1fa-aa70-3f86-b943-c34661bcd969",
                "word": "tesseract",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f32bfbf8-8fa7-4d66-8e83-b8aa1abcc7ab",
                        "entry_id": "e47ec1fa-aa70-3f86-b943-c34661bcd969",
                        "tags": [
                            "plural"
                        ],
                        "form": "tesseracts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3dd6e8d-df37-3c2f-a18f-538c0c396471",
                        "entry_id": "e47ec1fa-aa70-3f86-b943-c34661bcd969",
                        "glosses": [
                            "The four-dimensional analogue of a cube; a 4D polytope bounded by eight cubes (analogously to the way a cube is bounded by six squares)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b185aba3-a0a5-437e-87e8-a050fb49c695",
                                "sense_id": "c3dd6e8d-df37-3c2f-a18f-538c0c396471",
                                "text": "[…]then it would trace out a higher cube, or tesseract, and each of the six surrounding cubes, carried on in the same motion, would trace tesseracts also,[…]."
                            },
                            {
                                "example_id": "9437c284-1a9d-4ca0-8ad9-79741f844241",
                                "sense_id": "c3dd6e8d-df37-3c2f-a18f-538c0c396471",
                                "text": "Hence the cube determined by these axes is the face of the tesseract which we now have before us."
                            }
                        ]
                    },
                    {
                        "sense_id": "e518cfa9-1841-304c-800f-28bce73c41f3",
                        "entry_id": "e47ec1fa-aa70-3f86-b943-c34661bcd969",
                        "glosses": [
                            "Any of various fictional mechanisms that explain extradimensional, superluminal, or time travel outside the geometry of the physical universe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d52cb9c-8483-4ca9-a276-decc123bb932",
                                "sense_id": "e518cfa9-1841-304c-800f-28bce73c41f3",
                                "text": "\"I shall just sit down for a moment and pop on my boots and then I'll be on my way. Speaking of ways, pet, by the way, there is such a thing as a tesseract.\""
                            },
                            {
                                "example_id": "3a65aa64-5406-47c7-b01b-886e7e18cf55",
                                "sense_id": "e518cfa9-1841-304c-800f-28bce73c41f3",
                                "text": "When the Tesseract's energy levels spiked, Selvig proved unable to stop it and Loki arrived on Earth via a Tesseract-created portal."
                            },
                            {
                                "example_id": "5d3f447a-73d3-415f-aacc-8ff57e4a2eae",
                                "sense_id": "e518cfa9-1841-304c-800f-28bce73c41f3",
                                "text": "Cooper sees his younger self due to the tesseract in Interstellar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8733f079-5543-4342-addb-6df2038c0ba4",
                        "source_entry_id": "e47ec1fa-aa70-3f86-b943-c34661bcd969",
                        "source_sense_description": "four-dimensional analogue of a cube",
                        "target_lang_word": "teserakt",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teserakt",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "322fea53-87f9-3574-9d0d-26cbcddf1920",
                                        "entry_id": "812e9948-0b92-393f-b686-87a9192721fe",
                                        "glosses": [
                                            "čtyřrozměrná analogie krychle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8da6740-8805-4e7f-a686-a08e47323e9c",
                                                "sense_id": "322fea53-87f9-3574-9d0d-26cbcddf1920",
                                                "text": "Umístíme-li nad sebe dva čtverce a spojíme-li navzájem jejich vrcholy, dostáváme se do třetího rozměru, máme krychli. A kdybychom úplně stejně pokračovali dál, dostali bychom spojením vrcholů dvou trojrozměrných krychlí „čtyřrozměrnou krychli“ - teserakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a289e7d-e76d-45ad-8fa5-27e3621ea3cf",
                        "source_entry_id": "e47ec1fa-aa70-3f86-b943-c34661bcd969",
                        "source_sense_description": "four-dimensional analogue of a cube",
                        "target_lang_word": "tesseract",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tesseract",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2804fc7e-4210-34cb-b7f3-cb40df8fa510",
                                        "entry_id": "60c23c2e-4277-3991-903c-9e8018f146db",
                                        "glosses": [
                                            "Polychore dont les cellules sont 8 cubes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daca667a-1eee-4bb6-a873-3d31b0248a46",
                        "source_entry_id": "e47ec1fa-aa70-3f86-b943-c34661bcd969",
                        "source_sense_description": "four-dimensional analogue of a cube",
                        "target_lang_word": "Tesserakt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tesserakt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e88d42da-11c3-3606-aad4-c9c8862daebd",
                                        "entry_id": "d655841f-44d9-39f6-8c4c-e0d220773233",
                                        "glosses": [
                                            "vierdimensionales Analogon eines Würfels"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb6f320-1e6d-493f-ae40-639184b9cfa5",
                                                "sense_id": "e88d42da-11c3-3606-aad4-c9c8862daebd",
                                                "text": "„Das ist zwar schwer vorstellbar, aber es ist möglich Tesserakte in drei- oder zweidimensionale Räume zu projizieren.“"
                                            },
                                            {
                                                "example_id": "78f1b6c8-63bf-4a26-bbaa-7b528099cc65",
                                                "sense_id": "e88d42da-11c3-3606-aad4-c9c8862daebd",
                                                "text": "„Sogar das von dem spanischen Mathematiker-Linguisten-Schriftsteller Josep M. Albaigès stammende Soneto al tesaracto (2005), das mit dem Tesserakt – dem vierdimensionalen Hyperwürfel – ein eminent geometrisch-mathematisches Thema behandelt und per Zeichnung illustriert, schöpft aus der Sonetthaftigkeit keine Pointe …“"
                                            },
                                            {
                                                "example_id": "3845bcf8-773e-4eb3-ab53-c4235c62deef",
                                                "sense_id": "e88d42da-11c3-3606-aad4-c9c8862daebd",
                                                "text": "„Der vierdimensionale Würfel (Hyperkubus, Tesserakt, 8-Zell): Dies ist der populärste unter den vierdimensionalen platonischen Körpern.“"
                                            },
                                            {
                                                "example_id": "7995022e-2e32-4360-a217-ce79e1503d29",
                                                "sense_id": "e88d42da-11c3-3606-aad4-c9c8862daebd",
                                                "text": "„Der 8-Zeller (C₈) – Maßpolychor, Hyperwürfel oder auch Tesserakt genannt – besteht aus acht Hexaedern (4,4,4), 24 4-Ecken, 32 Kanten und 16 Ecken mit den kartesischen Koordinaten ( ±1, ±1, ±1, ±1).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b70e363-1c55-46a4-b360-2d69cccc1663",
