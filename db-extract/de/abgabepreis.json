                    {
                        "sense_id": "3d5f3fe9-791b-3023-8c7e-d74df5c7bca9",
                        "entry_id": "91f3a16c-5159-3002-8cbb-f9de37fc7776",
                        "glosses": [
                            "von dem Endkunden zu entrichtender Geldbetrag für eine Ware oder Dienstleistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d775e240-42c6-41cf-986d-1f6a5fcc4804",
                                "sense_id": "3d5f3fe9-791b-3023-8c7e-d74df5c7bca9",
                                "text": "„Die Apotheker haben ihre Forderung an die Politik erneuert, dafür zu sorgen, dass in Deutschland wieder einheitliche Abgabepreise für verschreibungspflichtige Medikamente gelten.“"
                            }
                        ],
