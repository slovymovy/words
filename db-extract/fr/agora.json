        "fr-extract.jsonl": [
            {
                "entry_id": "6479b723-b583-3cfe-ba93-2dbf26d2e8ea",
                "word": "agora",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "72e4a670-de89-461a-991f-059ee3bc8031",
                        "entry_id": "6479b723-b583-3cfe-ba93-2dbf26d2e8ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "agoras"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30552287-0d22-37c3-aada-dd8c934c6b52",
                        "entry_id": "6479b723-b583-3cfe-ba93-2dbf26d2e8ea",
                        "glosses": [
                            "Place publique, chez les Grecs, qui servait pour le marché et pour certains actes civils et politiques."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "91aedeaf-903e-41a8-baef-0ddef0a225b2",
                                "sense_id": "30552287-0d22-37c3-aada-dd8c934c6b52",
                                "text": "L’agora d’Athènes."
                            },
                            {
                                "example_id": "e8400289-397e-4a3e-9179-57ca40cfe13f",
                                "sense_id": "30552287-0d22-37c3-aada-dd8c934c6b52",
                                "text": "Les agoras témoignent, au-delà de cette grandiose invention architectonique, de la permanence du caractère démocratique de la polis."
                            },
                            {
                                "example_id": "8ac31361-b840-4241-a09b-92910f50681c",
                                "sense_id": "30552287-0d22-37c3-aada-dd8c934c6b52",
                                "text": "Encore à l'époque classique, l'invasion des boutiques sur l'agora d'Athènes au cœur de la ville, est le terme d'un processus insidieux et non le résultat d'un plan d'urbanisme délibéré."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee6ef695-c1af-3d75-9793-a41652f78a1a",
                        "entry_id": "6479b723-b583-3cfe-ba93-2dbf26d2e8ea",
                        "glosses": [
                            "Espace piétonnier et ouvert."
                        ],
                        "tags": [
                            "Urbanisme moderne"
                        ],
                        "examples": [
                            {
                                "example_id": "f74093f5-69eb-4231-b8d2-0ba0c7f4e78a",
                                "sense_id": "ee6ef695-c1af-3d75-9793-a41652f78a1a",
                                "text": "L’agora d’Evry."
                            }
                        ]
                    },
                    {
                        "sense_id": "5888298b-049b-3f42-9e8d-d16e56ca0eda",
                        "entry_id": "6479b723-b583-3cfe-ba93-2dbf26d2e8ea",
                        "glosses": [
                            "Espace de discussion, synonyme sur une base grecque de forum ou carrefour (de discussion)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f43158-eb79-4e0e-a0db-b1bcaa093875",
                                "sense_id": "5888298b-049b-3f42-9e8d-d16e56ca0eda",
                                "text": "La possibilité de laisser un commentaire après un article sur les sites d'information crée une formidable agora pour les lecteurs. C'est aussi le lieu de défoulement favori des \"trolls\", ces internautes qui s'acharnent à polluer à outrance la moindre discussion."
                            },
                            {
                                "example_id": "8cd9d31f-707a-4e96-814a-8ab879be4427",
                                "sense_id": "5888298b-049b-3f42-9e8d-d16e56ca0eda",
                                "text": "Ensuite il y eut un grand moment participatif de débat citoyen, que Mlle. Muchielli qualifia crânement d’Agora."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e798c72-b55f-4960-b20b-5e59cec998b6",
                        "source_entry_id": "6479b723-b583-3cfe-ba93-2dbf26d2e8ea",
                        "source_sense_description": "Place publique grecque",
                        "target_lang_word": "Agora",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c30216aa-f356-3681-8f33-8167c5ccfd9b",
                                        "entry_id": "374f7505-c00f-3217-bdb7-b747fed08596",
                                        "glosses": [
                                            "Gemeindezentrum im alten Griechenland, griechischer Markt, griechische Volksversammlung, Marktplatz in der Antike"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e1f97f-091f-4276-8e79-a5f3c02bde7e",
                                                "sense_id": "c30216aa-f356-3681-8f33-8167c5ccfd9b",
                                                "text": "Die Agora stellt einen bedeutenden Schritt in der Entwicklung der antiken Demokratie dar."
                                            },
                                            {
                                                "example_id": "2cfe9580-b4ac-4891-a14b-76fc7616c387",
                                                "sense_id": "c30216aa-f356-3681-8f33-8167c5ccfd9b",
                                                "text": "„Die Vororte waren die Agora, wo die Erziehung zur Ungebührlichkeit erblühte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddf55ec1-f8f4-4563-adb6-6c5387e53a35",
                        "source_entry_id": "6479b723-b583-3cfe-ba93-2dbf26d2e8ea",
