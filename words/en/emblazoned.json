{
    "word_family": [
        "emblazon",
        "emblazonment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "29eea9f8-3db4-30d4-aac9-c8cdedf49e9f",
                    "sense_definition": "Decorated with prominent designs, symbols, or ornaments.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal carriage was <w>emblazoned</w> with gold crests and intricate patterns.",
                            "target_lang_translations": {
                                "cs": "Královský kočár byl <w>ozdoben</w> zlatými erby a složitými vzory."
                            }
                        },
                        {
                            "text": "Every soldier wore a uniform <w>emblazoned</w> with the national flag.",
                            "target_lang_translations": {
                                "cs": "Každý voják měl uniformu <w>opatřenou</w> státní vlajkou."
                            }
                        }
                    ],
                    "synonyms": [
                        "adorned",
                        "decorated",
                        "ornamented"
                    ],
                    "common_phrases": [
                        "emblazoned with"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ozdobený výraznými vzory, symboly nebo ornamenty."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zdobený",
                                "target_lang_sense_clarification": "obecně ozdobený něčím"
                            },
                            {
                                "target_lang_word": "opatřený",
                                "target_lang_sense_clarification": "vybavený znakem nebo nápisem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0804fccc-89bf-3cb8-ba2d-78f9477753d3",
                    "sense_definition": "Showing intense emotion or passion, often reflected in one's appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her eyes were <w>emblazoned</w> with a fierce determination that silenced the room.",
                            "target_lang_translations": {
                                "cs": "Její oči <w>planuly</w> divokým odhodláním, které umlčelo celou místnost."
                            }
                        },
                        {
                            "text": "The speaker's face became <w>emblazoned</w> with anger as he described the injustice.",
                            "target_lang_translations": {
                                "cs": "Řečníkova tvář <w>zářila</w> hněvem, když popisoval tu nespravedlnost."
                            }
                        }
                    ],
                    "synonyms": [
                        "impassioned",
                        "fiery"
                    ],
                    "target_lang_definitions": {
                        "cs": "Projevující intenzivní emoce nebo vášeň, často patrné ve výrazu tváře."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "planoucí",
                                "target_lang_sense_clarification": "vyjadřující silnou emoci"
                            },
                            {
                                "target_lang_word": "zářící",
                                "target_lang_sense_clarification": "viditelně vyzařující emoci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca20406d-c168-3830-838a-59bbfd7ca343",
                    "sense_definition": "Clearly and vividly fixed in one's memory or thoughts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That tragic day remains <w>emblazoned</w> in my memory forever.",
                            "target_lang_translations": {
                                "cs": "Ten tragický den zůstává navždy <w>vrytý</w> do mé paměti."
                            }
                        },
                        {
                            "text": "The image of the sunset is <w>emblazoned</w> in her mind.",
                            "target_lang_translations": {
                                "cs": "Obraz západu slunce má <w>vrytý</w> do své mysli."
                            }
                        }
                    ],
                    "synonyms": [
                        "indelible",
                        "unforgettable"
                    ],
                    "common_phrases": [
                        "emblazoned in memory"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jasně a živě vryté do paměti nebo mysli."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vrytý",
                                "target_lang_sense_clarification": "hluboce uložený v paměti"
                            },
                            {
                                "target_lang_word": "nesmazatelný",
                                "target_lang_sense_clarification": "trvale uchovaný v mysli"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdf674ac-4341-3d88-9128-dd1d1f867eb8",
                    "sense_definition": "Simple past and past participle of <w>emblazon</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>emblazoned</w> the shield with a bright red dragon.",
                            "target_lang_translations": {
                                "cs": "Umělec <w>ozdobil</w> štít jasně červeným drakem."
                            }
                        },
                        {
                            "text": "They have <w>emblazoned</w> the company logo on every single product.",
                            "target_lang_translations": {
                                "cs": "Na každý jednotlivý výrobek <w>opatřili</w> firemním logem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa emblazon (zdobit znakem)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ozdobil",
                                "target_lang_sense_clarification": "vyzdobil znakem či symbolem"
                            },
                            {
                                "target_lang_word": "opatřil",
                                "target_lang_sense_clarification": "přidal znak nebo logo na povrch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}