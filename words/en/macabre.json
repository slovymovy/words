{
    "word_family": [
        "macabreness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f8e8f38-f56c-38b6-9c9c-58593a24167c",
                    "sense_definition": "Representing or personifying death.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "death_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted a <w>macabre</w> figure of a skeleton holding a scythe.",
                            "target_lang_translations": {
                                "cs": "Umělec namaloval <w>makabrózní</w> postavu kostlivce držícího kosu."
                            }
                        },
                        {
                            "text": "He felt a chill looking at the <w>macabre</w> statue in the old graveyard.",
                            "target_lang_translations": {
                                "cs": "Při pohledu na tu <w>děsivou</w> sochu na starém hřbitově ho zamrazilo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zobrazující nebo zosobňující smrt."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "makabrózní",
                                "target_lang_sense_clarification": "vztahující se ke smrti a děsivým výjevům"
                            },
                            {
                                "target_lang_word": "hrůzný",
                                "target_lang_sense_clarification": "vyvolávající strach nebo odpor spojený se smrtí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c103996-e210-3cf4-8995-b731be627f73",
                    "sense_definition": "Obsessed with death or the gruesome.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "death_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director is known for his <w>macabre</w> sense of humor in horror films.",
                            "target_lang_translations": {
                                "cs": "Režisér je známý svým <w>černým</w> smyslem pro humor v hororových filmech."
                            }
                        },
                        {
                            "text": "She has a <w>macabre</w> fascination with true crime stories and unsolved mysteries.",
                            "target_lang_translations": {
                                "cs": "Má <w>morbidní</w> zálibu ve skutečných kriminálních příbězích a nevyřešených záhadách."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zaujatý smrtí nebo morbidními tématy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "morbidní",
                                "target_lang_sense_clarification": "chorobně zaměřený na smrt a nepříjemné věci"
                            },
                            {
                                "target_lang_word": "černý",
                                "target_lang_sense_clarification": "používá se ve spojení s humorem zaměřeným na smrt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c54f82bd-d85a-3656-a3e9-f8bea4114829",
                    "sense_definition": "Ghastly, shocking, terrifying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "death_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police discovered a <w>macabre</w> scene inside the abandoned house.",
                            "target_lang_translations": {
                                "cs": "Policie objevila v opuštěném domě <w>otřesnou</w> scénu."
                            }
                        },
                        {
                            "text": "The <w>macabre</w> details of the accident were too shocking for the public to hear.",
                            "target_lang_translations": {
                                "cs": "<w>Hrůzné</w> detaily nehody byly pro veřejnost příliš šokující."
                            }
                        }
                    ],
                    "synonyms": [
                        "ghastly",
                        "horrifying",
                        "shocking",
                        "terrifying"
                    ],
                    "target_lang_definitions": {
                        "cs": "Děsivý, šokující, hrůzný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "děsivý",
                                "target_lang_sense_clarification": "vyvolávající silný pocit hrůzy"
                            },
                            {
                                "target_lang_word": "otřesný",
                                "target_lang_sense_clarification": "šokující svou povahou nebo obsahem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}