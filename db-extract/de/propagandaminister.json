                ],
                "senses": [
                    {
                        "sense_id": "0a7447e4-d5ea-312c-953c-85a39e395699",
                        "entry_id": "42d7b8af-3c20-3c22-a34b-e246b81e7c07",
                        "glosses": [
                            "Leiter der Behörde eines Staates zur Verbreitung politischer oder weltanschaulicher Ideen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db5d3147-5852-404d-90ff-fc66482a0f18",
                                "sense_id": "0a7447e4-d5ea-312c-953c-85a39e395699",
                                "text": "„Antisemitische Propaganda und die wichtigsten Instrumente der politischen Hetze gegen die Juden lagen vorwiegend in den Händen von Joseph Goebbels, auch wenn Himmler und Ribbentrop dem unermüdlichen Propagandaminister nie ganz das Feld überließen.“"
                            },
                            {
                                "example_id": "7227c589-1b5d-4b05-987a-918a8587973e",
                                "sense_id": "0a7447e4-d5ea-312c-953c-85a39e395699",
                                "text": "„Sogar Propagandaminister Joseph Goebbels soll danach auf ihn aufmerksam geworden sein, hieß es, er habe das junge Talent kennenlernen wollen und nach Berlin beordert.“"
                            },
                            {
                                "example_id": "b73a2454-dee6-4f0d-9810-bdf36c40f999",
                                "sense_id": "0a7447e4-d5ea-312c-953c-85a39e395699",
                                "text": "„Propagandaminister Goebbels plant eine Reichskulturkammer und bootet damit seinen Rivalen Robert Ley aus, der Künstler pauschal in die Deutsche Arbeitsfront eingliedern will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
