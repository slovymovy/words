                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eenheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "05ec5c3f-f1a8-39ea-927c-13cf507c2020",
                                        "entry_id": "07d90672-885a-3f1f-8350-7fc88c99fa64",
                                        "glosses": [
                                            "een bij elkaar horend geheel (systeem) met kenmerkende eigenschappen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b00629ae-d492-4d50-afa1-6569b7c644fb",
                                                "sense_id": "05ec5c3f-f1a8-39ea-927c-13cf507c2020",
                                                "text": "Deze mensen werden door deze dreiging tot een eenheid samengesmeed met gemeenschappelijk doel."
                                            },
                                            {
                                                "example_id": "bc4ac5bb-b2ee-426d-9f03-ee13b5c97d79",
                                                "sense_id": "05ec5c3f-f1a8-39ea-927c-13cf507c2020",
                                                "text": "De mobiele eenheid (ME) is een groep politieagenten die als geheel op verschillende plekken kan worden ingezet bij de bestrijding van rellen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061bc322-1423-33b2-868b-bbccca50b210",
                                        "entry_id": "07d90672-885a-3f1f-8350-7fc88c99fa64",
                                        "glosses": [
                                            "het gevoel dat men met velen op één lijn zit"
                                        ],
                                        "tags": [
                                            "maatschappij"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a878aac-ad09-4975-bec8-3f9b3f44e48a",
                                                "sense_id": "061bc322-1423-33b2-868b-bbccca50b210",
                                                "text": "Nationale eenheid is nou eenmaal makkelijker te vangen in termen als democratie en vrijheid, dan in de persoon van een bolwangige veertiger."
                                            },
                                            {
                                                "example_id": "03cc2b56-d1c6-453b-a60b-a7549a1f6856",
                                                "sense_id": "061bc322-1423-33b2-868b-bbccca50b210",
                                                "text": "Trump, schrijft Friedman, „ondermijnt onze heilige rechtsstaat, gooit onze bondgenoten weg, ondermijnt de waarde van de dollar en vernietigt alle hoop op nationale eenheid.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbb1ddd9-cffa-3a09-9859-ed5d81ec9d48",
                                        "entry_id": "07d90672-885a-3f1f-8350-7fc88c99fa64",
                                        "glosses": [
                                            "maat, standaard [1] waarin een grootheid [1] wordt uitgedrukt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "925f8ac3-de91-451a-bbbe-e02e1c74057e",
                                                "sense_id": "fbb1ddd9-cffa-3a09-9859-ed5d81ec9d48",
                                                "text": "De coulomb is de eenheid van lading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e01d8c0-a2e6-3a7a-9c85-d8b5982abc67",
