                                "target_senses": [
                                    {
                                        "sense_id": "e6d25c14-dd91-3b58-b54a-0d3102c61b23",
                                        "entry_id": "d5224c6e-c7a0-31da-89ca-be2ab4deff40",
                                        "glosses": [
                                            "sehr alter Mann, übertragen auch überdurchschnittlich alte Lebewesen oder Gegenstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a968e6f3-3527-4ad4-8432-008bd20f92ea",
                                                "sense_id": "e6d25c14-dd91-3b58-b54a-0d3102c61b23",
                                                "text": "Die kalifornischen Grannenkiefern sind die Methusalems des Pflanzenreiches."
                                            },
                                            {
                                                "example_id": "7cf3d2cc-9ea2-49c6-98e9-6e4188574e17",
                                                "sense_id": "e6d25c14-dd91-3b58-b54a-0d3102c61b23",
                                                "text": "Das Kernkraftwerk Fessenheim ist ein Methusalem unter den französischen Reaktoren."
                                            },
                                            {
                                                "example_id": "b07dfa3f-88d8-4f72-8a3e-cd00ff00507d",
                                                "sense_id": "e6d25c14-dd91-3b58-b54a-0d3102c61b23",
                                                "text": "Mit seinen 97 Jahren ist er ein richtiger Methusalem."
                                            },
                                            {
                                                "example_id": "dd54541b-50f7-4e51-9a55-790dbb47f6d0",
                                                "sense_id": "e6d25c14-dd91-3b58-b54a-0d3102c61b23",
                                                "text": "„Die mehrhundertjährigen Methusaleme sind wahnwitzige Übertreibungen – zu viel des Guten, wahrlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
