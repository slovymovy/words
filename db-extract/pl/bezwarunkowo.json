                        "glosses": [
                            "koniecznie, bezwzględnie, absolutnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aae4fe6-5dda-4390-85dc-bfc773b2cd96",
                                "sense_id": "3d881f44-69cf-3861-aa7b-3a789abeec48",
                                "text": "Przed zwrotem kasety wideo do wypożyczalni należało ją bezwarunkowo przewinąć do początku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c162f895-da5c-4ad6-9c6c-464361479b5d",
                        "source_entry_id": "81a39a3b-6994-375e-8e76-0a369933a1c9",
                        "source_sense_id": "2fb0daa0-d103-3fdd-8d76-0a895b458f42",
                        "target_lang_word": "unconditionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unconditionally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "960132c4-fc6c-3a00-a1a9-94584ef2d921",
                                        "entry_id": "2f63dc6f-34d9-3da3-9d97-0c1a816bfd01",
                                        "glosses": [
                                            "Without condition, absolutely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a8e988-783c-4144-a473-e6f4f53e9463",
                                                "sense_id": "960132c4-fc6c-3a00-a1a9-94584ef2d921",
                                                "text": "German armed forces surrendered unconditionally on May 7. Hostilities in Europe ended officially at midnight, May 8. 1945."
                                            },
                                            {
                                                "example_id": "768537b9-0607-4e9c-b0df-719ba79b8ce8",
                                                "sense_id": "960132c4-fc6c-3a00-a1a9-94584ef2d921",
                                                "text": "I love you unconditionally"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d6e6613-f636-4c0d-b3c2-bcf804ea55f6",
                        "source_entry_id": "81a39a3b-6994-375e-8e76-0a369933a1c9",
                        "source_sense_id": "2fb0daa0-d103-3fdd-8d76-0a895b458f42",
                        "target_lang_word": "imperatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                        "entry_id": "f259221b-2b7e-3d2a-a19d-c9114b962243",
                                        "glosses": [
                                            "In an imperative manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a48866-76f0-489e-ab60-4121b204c088",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "Improvement is imperatively needed."
                                            },
                                            {
                                                "example_id": "e36827c4-dce4-4dc4-8d7f-593e894b9c57",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "1625, John Donne, Sermon preached 26 April, 1625, in Fifty Sermons, Volume 2, London: M.F., J. Marriot and R. Royston, 1649, Sermon 33, p. 299,\n[…] being a mother, and having the dignity of a Parent upon her, she does not proceed supplicatorily, she does not pray them, nor intreat them, she does not say, I would you would go forth, and I would you would looke out, but it is Egredimini, & videte, imperatively, authoritatively, Do it, you must do it: […]"
                                            },
                                            {
                                                "example_id": "bd5a0a02-3e67-432e-8598-f72dde75579d",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "If a man has been possessed by devils for long enough they will rend him as they leave him, however imperatively they may have been cast out. Ernest did not stay long where he was, for he feared each moment that his father and mother would come out."
                                            },
                                            {
                                                "example_id": "2a2d1b1b-c697-4f52-8df8-362766d48a45",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "The military band happened to be braying operatic selections on the plaza just then, and twice he raised his hand imperatively for silence in order to listen to a favourite passage."
                                            },
                                            {
                                                "example_id": "955a98dd-289e-4ce9-b045-17acf9e4f2a2",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "— Come here, Tommy, his sister called imperatively, at once! And you, Jacky, for shame to throw poor Tommy in the dirty sand. Wait till I catch you for that."
                                            },
                                            {
                                                "example_id": "d5f5857b-ed0e-4c2c-961b-aafe3808ccdc",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "[…] wedging his tense arm imperatively under mine, Tom Buchanan compelled me from the room as though he were moving a checker to another square."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1dc7fe5-4d6a-45ec-b04b-7c77bb9b726c",
                        "source_entry_id": "81a39a3b-6994-375e-8e76-0a369933a1c9",
                        "source_sense_id": "2fb0daa0-d103-3fdd-8d76-0a895b458f42",
                        "target_lang_word": "no strings attached",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "no strings attached",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                        "entry_id": "b98d47e0-55dd-37d6-8ec3-7a4244a82f96",
                                        "glosses": [
                                            "Without conditions or obligations; without a catch."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffb2300f-195d-40ec-82b9-b57b276265aa",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "For a friend I’ll help out for free, no strings attached."
                                            },
                                            {
                                                "example_id": "c1989260-b568-4c12-8ef3-ca6868ddc898",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "In the present century marriage is preceded by a betrothment, gifts are usually interchanged (but with no strings attached), and a causeless withdrawal therefrom by either party is considered infamous."
                                            },
                                            {
                                                "example_id": "c410373a-4e4c-4bdb-a453-c787ae6e8728",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "Mr. [James Gillespie] Blaine's declination—it is always understood that we assume there is no string attached to his letter—is undoubtedly a wise move on his part."
                                            },
                                            {
                                                "example_id": "8911d012-02a9-4226-83e9-2f290d348969",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "Listen. We've kept it quiet, but she's in with the elect on French Hill. Her claim's prospected the richest of the outfit. Present indication half a million at least. In her own name, no strings attached. Couldn't she take that and go anywhere in the world and reinstate herself?"
                                            },
                                            {
                                                "example_id": "2951984d-72b3-45c9-a11b-5cc029cc65d5",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "\"No,\" I assured him, after receiving his cordial welcome, \"my offer had no string attached. I'm more than ready to help in any way I can, to find a niche for you in this old town and fit you into it. It doesn't matter where you hail from, or how you got here; New York is an all-comers' race, and the devil take the hindmost.\""
                                            },
                                            {
                                                "example_id": "adfc64b6-5453-44b6-975f-3508a8d2b28d",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "Would he ask her out (if he ever did) just for herself, no strings attached?"
                                            },
                                            {
                                                "example_id": "37f93762-f63e-44c9-a1c6-a4cd2026adf2",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "As to the $12 billion State share, there is not even the pretense of an attempt at congressional oversight, Federal control, or standards of performance. The State share is totally no-string attached."
                                            },
                                            {
                                                "example_id": "c418f1f3-4cfb-47ca-b858-cdd2a1d5c107",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "Who wanna have sex with no strings attached"
                                            },
                                            {
                                                "example_id": "98796207-ecd3-45f7-a600-0a1949062df5",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "'I asked him to think again. I asked him to put Drago's interests first. I repeated that there were no strings attached to my offer.' / 'No visible strings, you mean.'"
                                            },
                                            {
                                                "example_id": "e8f47d0f-e142-468c-ac51-22f3080a9109",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "You say that you want / All of my love / But let's be honest, we don't need all that / I like it better with no strings attached"
                                            },
                                            {
                                                "example_id": "5bc2c867-e6d3-4e2b-ae4a-07c01a4f7e99",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "He also criticised what he called the Government's \"bailout\" of the privatised rail companies with no strings attached, stating: \"There is simply no reason why the same easy solution could not have been applied to London,[…].\""
                                            },
                                            {
                                                "example_id": "bafce7f7-8e33-4c40-b9e7-2def1b229a6c",
                                                "sense_id": "21d47c82-dd88-3f22-931e-12ae627f28a7",
                                                "text": "When government delivers handouts with no string attached, more people naturally want to use and abuse them, which eventually ruins economy and drains a country's wealth. Essentially the welfare state destroys the ethic which sustains this very state."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "008b4105-c5c1-49d9-bbdb-6281beaef692",
                        "source_entry_id": "81a39a3b-6994-375e-8e76-0a369933a1c9",
                        "source_sense_id": "2fb0daa0-d103-3fdd-8d76-0a895b458f42",
                        "target_lang_word": "inconditionnellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconditionnellement",
