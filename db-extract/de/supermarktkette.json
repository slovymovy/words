                "senses": [
                    {
                        "sense_id": "d3143fb4-8299-36f8-a700-b4282a2d0310",
                        "entry_id": "b7ff3a16-2612-31da-a54b-614fd4cca636",
                        "glosses": [
                            "Chaîne de supermarché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a02ab43-97d7-4c7d-ae04-dd30faa1789b",
                                "sense_id": "d3143fb4-8299-36f8-a700-b4282a2d0310",
                                "text": "Für kleine Ladenbesitzer geht die Gefahr von Supermarktketten aus.",
                                "translation": "Pour les petits commerçants, le danger vient des chaînes de supermarchés."
                            },
                            {
                                "example_id": "02169ef4-8754-4e07-8e65-76b9ad10ccfe",
                                "sense_id": "d3143fb4-8299-36f8-a700-b4282a2d0310",
                                "text": "Das ergab eine Untersuchung im Auftrag der größten Supermarktkette des Landes.",
                                "translation": "C'est le résultat d'une étude commandée par la plus grande chaîne de supermarchés du pays."
                            },
                            {
                                "example_id": "b3525791-fe10-4685-98c1-7d249cc728eb",
                                "sense_id": "d3143fb4-8299-36f8-a700-b4282a2d0310",
                                "text": "Von einem bundesweiten Rückruf ist derzeit Rosenkohl der Supermarktkette Rewe betroffen. Interne Qualitätstests hatten zuvor einen ekligen, unangenehmen und viel zu gesunden Geschmack ergeben, auf den niemand Lust hat.",
                                "translation": "Les choux de Bruxelles de la chaîne de supermarchés Rewe font actuellement l’objet d’un rappel à l’échelle nationale. Des tests de qualité internes avaient auparavant révélé un goût écœurant, désagréable et bien trop sain pour être apprécié par qui que ce soit."
                            }
                        ]
                    }
                ],
