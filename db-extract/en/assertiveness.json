                        "target_lang_word": "Rechthaberei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechthaberei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14e43702-7b82-3cde-b2e9-778dfe6bf872",
                                        "entry_id": "6183c2d7-0e13-31dd-b4ba-9e61d12fdad9",
                                        "glosses": [
                                            "Verhalten, seinen eigenen Standpunkt/seine eigene Meinung um nahezu jeden Preis, auch gegen Widerspruch durchzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954c8f88-2954-43e2-88fa-652e3de0b432",
                                                "sense_id": "14e43702-7b82-3cde-b2e9-778dfe6bf872",
                                                "text": "Durch seine Rechthaberei provozierte er die ganze Belegschaft."
                                            },
                                            {
                                                "example_id": "2dc20bd4-f096-4b72-a721-007494c78781",
                                                "sense_id": "14e43702-7b82-3cde-b2e9-778dfe6bf872",
                                                "text": "„Schließlich wandte sich der Meister vom Stuhl mit missgünstiger Ironie an Pierre und bemerkte, er habe sich wohl ein wenig fortreissen lassen, und seine Haltung in der Debatte sei wohl nicht nur von Liebe zur Tugend, sondern auch von Rechthaberei beeeinflusst gewesen.“"
                                            },
                                            {
                                                "example_id": "cff99427-d21e-4be1-b0bb-37d0a98c450f",
                                                "sense_id": "14e43702-7b82-3cde-b2e9-778dfe6bf872",
                                                "text": "„Mit ihr ist das fahrlässige Weib in das fahrende Patriarchat der Herren eingebrochen und kreuzt mit seiner angestammten Rechthaberei und Hysterie die männliche Fahrbahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42a1033f-100c-4e81-9140-74fc6e072109",
                        "source_entry_id": "ddbf731e-ba2e-3360-a644-7b85e365b0a8",
                        "source_sense_id": "8d948ecf-9ff9-37b5-92f0-16e9046f2825",
                        "source_sense_description": "the quality of being assertive",
                        "target_lang_word": "Selbstbehauptung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbehauptung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5a52edc-2872-369b-9b21-f6b1b89c1679",
                                        "entry_id": "593db1ad-990d-35cd-b480-c586d1823a79",
                                        "glosses": [
                                            "Fähigkeit/Haltung, sich selbst, seine Rechte und Unversehrtheit gegen Einschränkung oder Bedrohung zu wahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0ac66b-cd79-42b2-9f2a-c3444cb6da7e",
                                                "sense_id": "e5a52edc-2872-369b-9b21-f6b1b89c1679",
                                                "text": "„An derartigen Bildern kann man studieren, wie sich humane Selbstbehauptung beglaubigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92872c19-5373-4b62-8288-60aec8aeb4df",
                        "source_entry_id": "ddbf731e-ba2e-3360-a644-7b85e365b0a8",
                        "source_sense_id": "8d948ecf-9ff9-37b5-92f0-16e9046f2825",
                        "source_sense_description": "the quality of being assertive",
                        "target_lang_word": "Selbstsicherheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstsicherheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f22a7f5d-317e-3cc7-932b-04ad220cfb42",
                                        "entry_id": "7c6f253c-9740-3227-b724-2e92b381f288",
                                        "glosses": [
                                            "Eigenschaft, sich seiner Kräfte und Fähigkeiten sicher sein"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "512ce5ea-ccc7-41e7-9c99-c84bf6bd07df",
                                                "sense_id": "f22a7f5d-317e-3cc7-932b-04ad220cfb42",
                                                "text": "„Wer die Regeln für korrektes Grüßen, Anreden, Vorstellen und Platzieren kennt, sich stilsicher kleidet und durch erstklassige Tischmanieren glänzt, meistert brenzlige Situationen mit Selbstsicherheit und hat ganz klare Vorteile.“"
                                            },
                                            {
                                                "example_id": "16a7971c-6bd5-4d74-83df-7dd44531d6e3",
                                                "sense_id": "f22a7f5d-317e-3cc7-932b-04ad220cfb42",
                                                "text": "„Was sie dabei denkt, weiß kein Mensch - aber sie strahlt eine Selbstsicherheit aus, die schon fast an Überheblichkeit grenzt.“"
                                            },
                                            {
                                                "example_id": "2f0c6f4b-eb9b-47c2-9897-12819a10b747",
                                                "sense_id": "f22a7f5d-317e-3cc7-932b-04ad220cfb42",
                                                "text": "„Seine Protzerei ging ihr auf die Nerven, aber sie war natürlich auch eifersüchtig auf seine Selbstsicherheit, und darauf, dass ihm offenbar auch bei der Arbeit alles so leicht fiel.“"
                                            },
                                            {
                                                "example_id": "310b5fbc-12bb-4b9d-8f8d-07050b5585b4",
                                                "sense_id": "f22a7f5d-317e-3cc7-932b-04ad220cfb42",
                                                "text": "„Sie würde mit einer großen Selbstsicherheit und einer sehr dicken Brieftasche nach Nigeria zurückkehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b15001a-5a19-45de-a8b9-98da2560b87a",
                        "source_entry_id": "ddbf731e-ba2e-3360-a644-7b85e365b0a8",
                        "source_sense_id": "8d948ecf-9ff9-37b5-92f0-16e9046f2825",
                        "source_sense_description": "the quality of being assertive",
                        "target_lang_word": "Selbstbewusstsein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbewusstsein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                        "entry_id": "b534826f-1edf-3b1c-b41b-76f40596337f",
                                        "glosses": [
                                            "Selbstwertgefühl, Selbstsicherheit"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f29d77dc-7bd8-42d3-883a-2d217e169789",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "Dass ich diese Herausforderung gemeistert habe, hat mein Selbstbewusstsein enorm gesteigert."
                                            },
                                            {
                                                "example_id": "e3c91375-d3da-4184-9da0-8384bcfa4c8a",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Das Selbstbewusstsein der Grünen in Nordrhein-Westfalen war im Frühjahr dieses Jahres groß.“"
                                            },
                                            {
                                                "example_id": "29424a2f-7b22-41e7-a367-1e36b55866eb",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Der Erfolg gab dem Künstler ein neues Selbstbewusstsein.“"
                                            },
                                            {
                                                "example_id": "c7efa12a-6d37-4a18-a60d-a196433f5f17",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Schon dieses Selbstbewusstsein war anstößig.“"
                                            },
                                            {
                                                "example_id": "cdcbfa54-dfbe-48cb-88dd-cd32e0c412ad",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Der theoretische Höchstwert, der ein hohes Maß an Selbstbewusstsein widerspiegelt, liegt bei dieser Befragung bei 25 Punkten.“"
                                            },
                                            {
                                                "example_id": "ed5d9812-b97a-49d8-90f5-35d48cd75d76",
                                                "sense_id": "ed1f4996-d3b0-3953-8f05-7532c351bd4d",
                                                "text": "„Wenn Sie allerdings spüren, dass die Frau Sie nur nutzt, um ihr Selbstbewusstsein aufzupolieren, sollten Sie sich zurückziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebfd31b2-67c7-341d-b3c9-fe7589847477",
                                        "entry_id": "b534826f-1edf-3b1c-b41b-76f40596337f",
                                        "glosses": [
                                            "Fähigkeit, das eigene Ich zu beobachten und zu reflektieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74f9053-1c31-4930-ac3a-7f1e50d73663",
                                                "sense_id": "ebfd31b2-67c7-341d-b3c9-fe7589847477",
                                                "text": "Moralisches Handeln setzt Selbstbewusstsein voraus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
