                        "examples": [
                            {
                                "example_id": "2f97e480-a4c0-474e-82eb-f17a96f592ef",
                                "sense_id": "24c51b2c-2172-3591-bb4c-8b17be6a6b72",
                                "text": "Het lichaam werd door voorbijgangers gevonden op een parkeerplaats bij de zwemplaats Ulesprong, aan de Tsjûkemarwei bij het Friese plaatsje Sint Nicolaasga. De parkeerplaats en het zwemstrand zijn afgesloten, de politie is een groot onderzoek begonnen. Ook een helikopter en de waterpolitie zijn ingeschakeld."
                            },
                            {
                                "example_id": "e1108356-5734-4033-8793-631dbca8af2b",
                                "sense_id": "24c51b2c-2172-3591-bb4c-8b17be6a6b72",
                                "text": "Volgens de gemeente is de zwemplaats het beste bereikbaar met de fiets of het openbaar vervoer, want er zijn door bouwwerkzaamheden minder parkeerplaatsen beschikbaar."
                            }
                        ]
                    }
