                ],
                "senses": [
                    {
                        "sense_id": "b256de7e-b9c3-3ade-98bb-e344b045330f",
                        "entry_id": "3087a7b2-57fe-3752-b29b-ac47a069d356",
                        "glosses": [
                            "Dispositif destiné à introduire de la raideur dans un système."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55137882-573f-4a0b-80d6-5aca1264d559",
                                "sense_id": "b256de7e-b9c3-3ade-98bb-e344b045330f",
                                "text": "Les raidisseurs en « C » (strongbacks) sont souvent utilisés pour la construction de panneaux de coffrage volants."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6c0ab15-4adc-3f0c-829e-69b2355f30d4",
                        "entry_id": "3087a7b2-57fe-3752-b29b-ac47a069d356",
                        "glosses": [
                            "Tendeur, appareil pour tendre fermement les câbles, les fils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68cc5f31-cbfc-40fe-beca-f8a84ed6869b",
                                "sense_id": "f6c0ab15-4adc-3f0c-829e-69b2355f30d4",
                                "text": "Tendeurs-raidisseurs pour espaliers et clôtures."
                            },
                            {
                                "example_id": "685fe437-da59-49db-b6a8-a8b91898508b",
                                "sense_id": "f6c0ab15-4adc-3f0c-829e-69b2355f30d4",
                                "text": "Ils avaient fait venir un serrurier pour les tuteurs, un quincaillier pour les raidisseurs, un charpentier pour les supports."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6f63b3e-f0a9-4508-be3a-dbe3178250fa",
                        "source_entry_id": "3087a7b2-57fe-3752-b29b-ac47a069d356",
                        "source_sense_description": "dispositif pour raidir quelque chose",
                        "target_lang_word": "stiffener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stiffener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2260554-419a-38ff-bb57-a7b5510d0562",
                                        "entry_id": "479424b1-a133-3f92-a5a9-1f7ad9db3156",
                                        "glosses": [
                                            "Anything added to something in order to stiffen it, such as a support beam, or starch for a collar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f8429f-89b9-49db-ab21-f35f5980d715",
                                                "sense_id": "f2260554-419a-38ff-bb57-a7b5510d0562",
                                                "text": "[…] he wears a wisp of black silk round his neck, without any stiffener, as an apology for a neckerchief […]"
                                            },
                                            {
                                                "example_id": "490ba9eb-0cc6-4d51-b23d-cf1a055f85ea",
                                                "sense_id": "f2260554-419a-38ff-bb57-a7b5510d0562",
                                                "text": "[…] each of these stiffener-columns must be designed to resist approximately 26 tons. Sometimes single angles are thus used as stiffeners […]"
                                            },
                                            {
                                                "example_id": "2ee42f88-9e70-473c-b42d-0617b2435a58",
                                                "sense_id": "f2260554-419a-38ff-bb57-a7b5510d0562",
                                                "text": "The tee bar (b) is used as a stiffener to important bulkheads […]"
                                            },
                                            {
                                                "example_id": "2126b81f-0dcf-4b56-b5b4-d9afd0593c7c",
                                                "sense_id": "f2260554-419a-38ff-bb57-a7b5510d0562",
                                                "text": "[…] with this arrangement the cylinders are cast separately from the saddle, and bolted to the frames on each side with a fabricated stiffener between the frames. This stiffener is carried up to form the saddle for the smokebox, and within it is fitted the exhaust pipes from the cylinders to the blast pipe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec197a7c-e29c-3c1e-8ce1-f3be7aa9495e",
                                        "entry_id": "479424b1-a133-3f92-a5a9-1f7ad9db3156",
                                        "glosses": [
                                            "One of a series of angle bars, Z-bars, beams, rods, or other shapes, attached in order to provide them the necessary stiffness or rigidity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61fe7f76-75c4-35fc-bf26-563c4edf46ea",
                                        "entry_id": "479424b1-a133-3f92-a5a9-1f7ad9db3156",
                                        "glosses": [
                                            "An alcoholic drink taken to fortify oneself."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d05f5f-a2b5-4787-880f-ed0c6af6e627",
                                                "sense_id": "61fe7f76-75c4-35fc-bf26-563c4edf46ea",
                                                "text": "I believe the old man has taken himself off to the nearest bar for a stiffener."
                                            }
                                        ]
                                    }
                                ]
