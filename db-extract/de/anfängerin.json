                                    {
                                        "sense_id": "f416cae7-fec5-3a45-b3f5-fe136e2811eb",
                                        "entry_id": "7d032f39-2d32-33ca-a848-d74f47c7c924",
                                        "glosses": [
                                            "Celle qui apprend un métier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4d3c08-5e94-42aa-83cf-ef40e7b288c4",
                                                "sense_id": "f416cae7-fec5-3a45-b3f5-fe136e2811eb",
                                                "text": "J’ignore si son avis est le fruit d’un constat lucide ou l’envie de se débarrasser d’une apprentie désobéissante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faf7be4c-c134-3922-8b29-70d2aa92633d",
                                        "entry_id": "7d032f39-2d32-33ca-a848-d74f47c7c924",
                                        "glosses": [
                                            "Novice, celle qui est malhabile dans les choses dont elle se mêle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f2918e3-eb4a-4d63-a31e-d24212cefe58",
                        "source_entry_id": "344b9cc9-6f36-3e90-a565-01e4109041b6",
