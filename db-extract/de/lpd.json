        "de-extract.jsonl": [
            {
                "entry_id": "889a8e5a-e300-3c7a-a17a-adec73d10ccd",
                "word": "LPD",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "12e059fc-3b69-4a1e-abd8-23e68070c715",
                        "entry_id": "889a8e5a-e300-3c7a-a17a-adec73d10ccd",
                        "tags": [
                            "feminine"
                        ],
                        "form": "LPD’in"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be7ed377-2da0-361f-9f2b-e01bfe2d78ba",
                        "entry_id": "889a8e5a-e300-3c7a-a17a-adec73d10ccd",
                        "glosses": [
                            "vorwiegend , vereinzelt in Deutschland: Abkürzung für Landespolizeidirektion"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "59316535-c8c9-45c8-922a-c456f981224c",
                                "sense_id": "be7ed377-2da0-361f-9f2b-e01bfe2d78ba",
                                "text": "„Die LPD übernimmt die Mehrheit administrativer Aufgaben für die gesamte Landespolizei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8a5f42bf-63f0-38ce-95a3-339f7c235c7f",
                        "entry_id": "889a8e5a-e300-3c7a-a17a-adec73d10ccd",
                        "glosses": [
                            "Abkürzung für Landespostdirektion Berlin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ef4631-e6fa-4312-81f4-101edb80bd16",
                                "sense_id": "8a5f42bf-63f0-38ce-95a3-339f7c235c7f",
                                "text": "„1954 wurde die OPD Berlin in die LPD Berlin überführt und fortan unterstanden die Ämter und Beamten dem Senat von Berlin, […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ce963fa7-aac8-382c-bebe-5a1399577a79",
                        "entry_id": "889a8e5a-e300-3c7a-a17a-adec73d10ccd",
                        "glosses": [
                            "Abkürzung für Leitender Polizeidirektor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a761c698-8783-4cb4-bb94-4fe8a5fd11b5",
                                "sense_id": "ce963fa7-aac8-382c-bebe-5a1399577a79",
                                "text": "„Als höchsten Dienstgrad gibt es […] den Leitenden Polizeidirektor, kurz LPD oder Ltd. PD.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "7740aecc-cd78-3754-944d-8679999fc2a9",
                        "entry_id": "889a8e5a-e300-3c7a-a17a-adec73d10ccd",
                        "glosses": [
                            "Abkürzung für Line Printer Daemon, Protokoll zum Drucken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc663fb2-d4bd-4aae-acb1-e4004addfb0c",
                                "sense_id": "7740aecc-cd78-3754-944d-8679999fc2a9",
                                "text": "„Das LPD (Line Printer Daemon) Drucksystem basiert auf dem Berkeley […] Drucksystem, das viele Jahre eine Hauptstütze der Unix-Umgebung war.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "7bba7b69-439e-3dbd-8e60-18b8a1395854",
                        "entry_id": "889a8e5a-e300-3c7a-a17a-adec73d10ccd",
                        "glosses": [
                            "Abkürzung für Linux Presentation Day, eine Linux-Informationsveranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42489955-85e4-4e52-90fb-7291afe5f23d",
                                "sense_id": "7bba7b69-439e-3dbd-8e60-18b8a1395854",
                                "text": "„Der LPD findet zum gleichen Zeitpunkt an verschiedenen Orten in ganz Deutschland und europäischen Nachbarländern statt.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
