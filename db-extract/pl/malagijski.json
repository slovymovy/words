                                        "examples": [
                                            {
                                                "example_id": "5bd45657-0896-4e35-88fb-38f4e1b0bedb",
                                                "sense_id": "e629e492-6630-3d26-81cb-5f0211cc45b6",
                                                "text": "Φύγε μακριά απ᾿ αυτόν!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "624cce4c-ab41-37fb-9a56-03a7c0744184",
                                        "entry_id": "64b12f07-1ba8-3392-a18d-516d12fc9fe1",
                                        "glosses": [
                                            "δηλώνει",
                                            "καταγωγή ή προέλευση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f8d6b4-9a63-4b95-858a-c1d6a693af50",
                                                "sense_id": "624cce4c-ab41-37fb-9a56-03a7c0744184",
                                                "text": "Ο γείτονάς μου είναι από την Αίγυπτο."
                                            },
                                            {
                                                "example_id": "e7a023c1-25f2-4fa1-b29f-c04a69a20bbd",
                                                "sense_id": "624cce4c-ab41-37fb-9a56-03a7c0744184",
                                                "text": "Ο Μάρκο Πόλο έφερε από την Κίνα το μετάξι στην Ευρώπη."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70d326e-dba1-34cb-9d7b-ff1c259b2cf2",
                                        "entry_id": "64b12f07-1ba8-3392-a18d-516d12fc9fe1",
                                        "glosses": [
                                            "δηλώνει",
                                            "εξάρτηση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3967fd-ebd9-46bf-864a-a3601a8ae1ec",
                                                "sense_id": "a70d326e-dba1-34cb-9d7b-ff1c259b2cf2",
                                                "text": "κρατήσου από μένα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6f83d7-ce73-3b50-864f-d907efbbd180",
                                        "entry_id": "64b12f07-1ba8-3392-a18d-516d12fc9fe1",
                                        "glosses": [
                                            "δηλώνει",
                                            "χρόνο:",
                                            "αφετηρία"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37e09bde-712b-4285-a20b-7643ec8ca023",
                                                "sense_id": "ac6f83d7-ce73-3b50-864f-d907efbbd180",
                                                "text": "Έχω να τον δω απ᾿ την αποφοίτησή μας."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68b93a2d-8019-3e83-a8e9-a441df05c77e",
                                        "entry_id": "64b12f07-1ba8-3392-a18d-516d12fc9fe1",
                                        "glosses": [
                                            "δηλώνει",
                                            "χρόνο:",
