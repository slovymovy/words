                        "glosses": [
                            "Suffixer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b495a9a1-86a0-410e-b120-972ae3b0617f",
                                "sense_id": "b417cb81-41d2-3703-8092-433f8b04d036",
                                "text": "Ainsi ashera (mot d'origine arabe voulant dire « dix ») est tronqué et resuffixé en u donnant ashu."
                            },
                            {
                                "example_id": "6644f657-711c-4497-b6f7-962a1caa9f7e",
                                "sense_id": "b417cb81-41d2-3703-8092-433f8b04d036",
                                "text": "Obtenu par verlan resuffixé à l'ancienne de bouffon, mot qui, par parenthèse, marche toujours très fort chez les jeunes, de banlieue ou non."
                            }
                        ]
                    }
