{
    "word_family": [
        "factional",
        "factionalism",
        "factionalize",
        "factious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5cf79eed-9a8d-31ee-a1ab-5b306d14dc4d",
                    "sense_definition": "A small organized dissenting group within a larger one, especially in politics.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party was split into several <w>factions</w> after the controversial leadership election.",
                            "target_lang_translations": {
                                "ru": "Партия раскололась на несколько <w>фракций</w> после спорных выборов руководства."
                            }
                        },
                        {
                            "text": "A small <w>faction</w> within the committee refused to vote for the new proposal.",
                            "target_lang_translations": {
                                "ru": "Небольшая <w>группировка</w> внутри комитета отказалась голосовать за новое предложение."
                            }
                        }
                    ],
                    "synonyms": [
                        "fringe"
                    ],
                    "common_phrases": [
                        "political faction",
                        "rival faction",
                        "warring faction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая организованная группа внутри более крупной, часто имеющая отличные от большинства взгляды, особенно в политике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фракция",
                                "target_lang_sense_clarification": "политическая или внутрипартийная группа"
                            },
                            {
                                "target_lang_word": "группировка",
                                "target_lang_sense_clarification": "объединение лиц с общими интересами"
                            },
                            {
                                "target_lang_word": "крыло",
                                "target_lang_sense_clarification": "обособленная часть организации или партии"
                            },
                            {
                                "target_lang_word": "клика",
                                "target_lang_sense_clarification": "неодобрительно о группе с корыстными целями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7a16fd6-b7e6-3312-b445-195b0bd39a44",
                    "sense_definition": "A literary or cinematic genre that blends historical facts with fictional elements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel is a work of <w>faction</w> that tells the story of the war through invented characters.",
                            "target_lang_translations": {
                                "ru": "Этот роман — произведение в жанре <w>фэкшн</w>, которое рассказывает историю войны через вымышленных персонажей."
                            }
                        },
                        {
                            "text": "Critics often debate whether this biography should be classified as history or <w>faction</w>.",
                            "target_lang_translations": {
                                "ru": "Критики часто спорят о том, следует ли классифицировать эту биографию как историю или как <w>художественно-документальную прозу</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "work of faction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Литературный или кинематографический жанр, сочетающий исторические факты с вымышленными элементами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фэкшн",
                                "target_lang_sense_clarification": "литературный жанр на стыке факта и вымысла"
                            },
                            {
                                "target_lang_word": "документально-художественный жанр",
                                "target_lang_sense_clarification": "описание жанра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6941886-3e6f-37a9-9c4b-c04e003a4535",
                    "sense_definition": "State of conflict, discord, or internal dissension within a group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city remained in a state of <w>faction</w> and confusion for many years.",
                            "target_lang_translations": {
                                "ru": "Город в течение многих лет оставался в состоянии <w>раздора</w> и неразберихи."
                            }
                        },
                        {
                            "text": "He warned that internal <w>faction</w> would eventually destroy the stability of the government.",
                            "target_lang_translations": {
                                "ru": "Он предупредил, что внутренние <w>распри</w> в конечном итоге разрушат стабильность правительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "fringe"
                    ],
                    "antonyms": [
                        "concord",
                        "harmony"
                    ],
                    "common_phrases": [
                        "state of faction"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used to describe the state of discord itself"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние конфликта, раздора или внутреннего несогласия внутри группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разногласия",
                                "target_lang_sense_clarification": "отсутствие единства во мнениях"
                            },
                            {
                                "target_lang_word": "распри",
                                "target_lang_sense_clarification": "внутренние конфликты и борьба"
                            },
                            {
                                "target_lang_word": "раздоры",
                                "target_lang_sense_clarification": "состояние вражды и споров"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}