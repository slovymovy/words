                "senses": [
                    {
                        "sense_id": "8b9e9e6d-e244-3483-bbe0-2cca8ae9ff4e",
                        "entry_id": "5fa96ab6-3e39-35ac-a418-f80c0408765d",
                        "glosses": [
                            "coffin dodger, old fart (old person)"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "df7f3ef7-8fac-47fe-94a0-423de56e8c41",
                                "sense_id": "8b9e9e6d-e244-3483-bbe0-2cca8ae9ff4e",
                                "text": "An diesem Abend waren die Eltern ziemlich lange damit beschäftigt, darüber nachzudenken, wodurch sich Grufti-Sex auszeichnet und was ganz allgemein überhaupt ein Grufti ist beziehungsweise in welchem Alter die Grufti-Existenz beginnt."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e844f0a-40c2-3f65-8109-82bf1a666588",
                        "entry_id": "5fa96ab6-3e39-35ac-a418-f80c0408765d",
                        "glosses": [
                            "goth (member of the goth subculture)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "70b773d3-c5bd-4ee6-99f6-7834c6693f34",
                                "sense_id": "0e844f0a-40c2-3f65-8109-82bf1a666588",
                                "text": "Schöner Laden. War bis jetzt auf jeder Tour hier. Trotzdem jede Mange Leute, auch mit ältern Büchern. Und ein Banana Dakry. Ach ja, und ein Grufti. Viericks scheint eine blühende Grufti-Szene zu haben, falls >blühend< in diesem Zusammenhang das richtige Adjektiv ist. Gruftis sind klasse. Ohne einen Grufti ist es keine anständige Signierschlange. In Worralorrasurfa gibt es sogar Surfer-Gruftis.",
                                "translation": "Nice shop. Been here on every tour so far. Still, lots of people, even with older books. And a banana dakry. Oh yes, and a goth. Viericks seems to have a thriving goth scene, if 'blooming' is the right adjective in this context. Goths are great. Without a goth, it's not a decent book signing line. There are even surfer goths in Worralorrasurfa.",
                                "english": "Nice shop. Been here on every tour so far. Still, lots of people, even with older books. And a banana dakry. Oh yes, and a goth. Viericks seems to have a thriving goth scene, if 'blooming' is the right adjective in this context. Goths are great. Without a goth, it's not a decent book signing line. There are even surfer goths in Worralorrasurfa."
                            }
                        ]
                    }
                ],
