                        "glosses": [
                            "Couvrir une voie de pierres ou de pavé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "071b5723-237d-4c25-9a41-8e4aa56d471d",
                                "sense_id": "2ef39dbd-a75f-3f2e-a0f2-3b5abbca3a59",
                                "text": "Depuis 5 ans, les travaux ont permis de calader des chemins, de remonter des murs de bordures, de réaliser des palissades en châtaignier."
                            },
                            {
                                "example_id": "01e1b1ca-4e66-470c-94ed-3484c7aa14d2",
                                "sense_id": "2ef39dbd-a75f-3f2e-a0f2-3b5abbca3a59",
                                "text": "Autrefois, pour calader, on employait un matériau de provenance locale pour éviter des frais de transport."
                            },
                            {
                                "example_id": "f0af6ad6-c89d-4e29-b640-38c80a382a2d",
                                "sense_id": "2ef39dbd-a75f-3f2e-a0f2-3b5abbca3a59",
                                "text": "Les limites de l'aire à calader sont balisées par des piquets sur lesquels les niveaux finis sont repérés."
                            }
                        ]
                    }
