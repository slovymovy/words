                "senses": [
                    {
                        "sense_id": "bb0eba21-5b7e-3f27-9a80-986d30732d0e",
                        "entry_id": "90c94b57-3048-3c3e-9dc4-95fa1ad6c3ff",
                        "glosses": [
                            "großer, rauhaariger, hellbrauner bis schwarzer Hund einer britischen Hunderasse, die von der FCI anerkannt ist und zur Gruppe der Laufhunde gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a481dff-14e5-42dc-980f-1c351d0b4838",
                                "sense_id": "bb0eba21-5b7e-3f27-9a80-986d30732d0e",
                                "text": "Dachs, Stein- und Baummarder, Iltis und Fischotter werden ebenso wie der früher zur Otterjagd eingesetzte Otterhund nach einem festgelegten Zeitplan gefüttert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f905b7fe-8bd3-3031-b6aa-8551b8897c4d",
                        "entry_id": "90c94b57-3048-3c3e-9dc4-95fa1ad6c3ff",
                        "glosses": [
                            "zur Jagd auf Otter, aber auch Biber, abgerichteter Hund"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "860b10e5-1c40-49f0-95b1-c815afe4f56b",
                                "sense_id": "f905b7fe-8bd3-3031-b6aa-8551b8897c4d",
                                "text": "In Flüssen, in denen es viele Otter gibt, zieht man in aller Stille große Netze quer durch den Fluß und läßt den Otter durch die Otterhunde treiben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
