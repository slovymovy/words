    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2249ae2a-e704-3186-84a4-598d7bbde5d0",
                    "sense_definition": "in omvang of volume afnemen; kleiner worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ijsklontje <w>slonk</w> snel in de warme middagzon.",
                            "target_lang_translations": {
                                "en": "The ice cube <w>shrank</w> quickly in the warm afternoon sun."
                            }
                        },
                        {
                            "text": "De gletsjers zijn de afgelopen honderd jaar voor meer dan de helft <w>geslonken</w>.",
                            "target_lang_translations": {
                                "en": "The glaciers have <w>shrunk</w> by more than half over the past hundred years."
                            }
                        }
                    ],
                    "synonyms": [
                        "inkrimpen",
                        "krimpen",
                        "verminderen"
                    ],
                    "antonyms": [
                        "groeien",
                        "uitzetten"
                    ],
                    "common_phrases": [
                        "zienderogen slinken"
                    ],
                    "target_lang_definitions": {
                        "en": "To decrease in size or volume; to become smaller."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrink",
                                "target_lang_sense_clarification": "to become smaller in size"
                            },
                            {
                                "target_lang_word": "contract",
                                "target_lang_sense_clarification": "to decrease in volume"
                            },
                            {
                                "target_lang_word": "diminish",
                                "target_lang_sense_clarification": "to become less in size"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fed11086-2e90-3633-a98a-1f5e1e8f5838",
                    "sense_definition": "in aantal of hoeveelheid afnemen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de economische crisis is de voorraad aan grondstoffen flink <w>geslonken</w>.",
                            "target_lang_translations": {
                                "en": "Due to the economic crisis, the supply of raw materials has <w>dwindled</w> significantly."
                            }
                        },
                        {
                            "text": "Het aantal gegadigden voor de nieuwe woningen is de laatste tijd fel <w>geslonken</w>.",
                            "target_lang_translations": {
                                "en": "The number of applicants for the new houses has <w>dropped</w> sharply lately."
                            }
                        }
                    ],
                    "synonyms": [
                        "afnemen",
                        "dalen",
                        "verminderen"
                    ],
                    "antonyms": [
                        "toenemen",
                        "stijgen"
                    ],
                    "common_phrases": [
                        "de voorraad slinkt"
                    ],
                    "target_lang_definitions": {
                        "en": "To decrease in number or quantity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dwindle",
                                "target_lang_sense_clarification": "to gradually become less in amount"
                            },
                            {
                                "target_lang_word": "decrease",
                                "target_lang_sense_clarification": "to go down in number"
                            },
                            {
                                "target_lang_word": "decline",
                                "target_lang_sense_clarification": "to drop in quantity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c0ccd7d-779d-3eb5-aec3-26ade1517685",
                    "sense_definition": "aan intensiteit of kracht verliezen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kracht van de tegenstanders <w>slinkt</w> zienderogen tijdens de tweede helft.",
                            "target_lang_translations": {
                                "en": "The opponents' strength is visibly <w>waning</w> during the second half."
                            }
                        },
                        {
                            "text": "Zijn hoop op een goede afloop <w>slonk</w> met de minuut.",
                            "target_lang_translations": {
                                "en": "His hope for a good outcome <w>faded</w> by the minute."
                            }
                        }
                    ],
                    "synonyms": [
                        "afnemen",
                        "verslappen",
                        "verzwakken"
                    ],
                    "antonyms": [
                        "toenemen",
                        "versterken"
                    ],
                    "common_phrases": [
                        "de hoop slinkt"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose intensity, strength, or power."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wane",
                                "target_lang_sense_clarification": "to decrease in vigor or power"
                            },
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "to lose strength or hope"
                            },
                            {
                                "target_lang_word": "ebb",
                                "target_lang_sense_clarification": "to gradually lessen or recede"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a166382-fa39-3714-8f6f-7d6ab3868497",
                    "sense_definition": "geleidelijk uit het zicht verdwijnen door afstand",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verdwijnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kade van de haven <w>slonk</w> beetje bij beetje naarmate het schip de zee op voer.",
                            "target_lang_translations": {
                                "en": "The harbor quay <w>receded</w> bit by bit as the ship sailed out to sea."
                            }
                        },
                        {
                            "text": "De kustlijn <w>slonk</w> aan de horizon tot er niets meer te zien was.",
                            "target_lang_translations": {
                                "en": "The coastline <w>diminished</w> on the horizon until nothing more could be seen."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegdeemsteren",
                        "verdwijnen"
                    ],
                    "antonyms": [
                        "opdoemen"
                    ],
                    "common_phrases": [
                        "beetje bij beetje slinken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in literaire context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To gradually disappear from view due to distance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recede",
                                "target_lang_sense_clarification": "to move back or away from view"
                            },
                            {
                                "target_lang_word": "diminish",
                                "target_lang_sense_clarification": "to appear smaller in the distance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}