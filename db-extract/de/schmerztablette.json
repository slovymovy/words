                "senses": [
                    {
                        "sense_id": "9cf60f7a-2162-3de6-9e21-9b767d4fb6fd",
                        "entry_id": "6bf0fb93-0c9e-3d69-b3d7-a0c0ea493276",
                        "glosses": [
                            "Tablette, die schmerzlindernd wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb89843-115d-402a-8402-89fcc4096b15",
                                "sense_id": "9cf60f7a-2162-3de6-9e21-9b767d4fb6fd",
                                "text": "„Insbesondere Familien sollten die Hausapotheke vor den Feiertagen auffüllen, um bei Bedarf mit Pflaster, Schmerztabletten oder Fieberzäpfchen versorgt zu sein.“"
                            },
                            {
                                "example_id": "639705eb-df0d-4dcb-bed8-afc88ec13347",
                                "sense_id": "9cf60f7a-2162-3de6-9e21-9b767d4fb6fd",
                                "text": "„Sie warf noch zwei Schmerztabletten ein, legte sich in die Badewanne, und danach fühlte sie sich schon ein wenig besser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f51c4f29-7159-4a18-b7d7-ac607c13f50b",
