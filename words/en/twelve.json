    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "59cd090a-5eb7-36e1-99b8-5c8c4535482e",
                    "sense_definition": "The cardinal number occurring after eleven and before thirteen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are <w>twelve</w> months in a year.",
                            "target_lang_translations": {
                                "ru": "В году <w>двенадцать</w> месяцев.",
                                "zh": "一年有<w>十二</w>个月。"
                            }
                        },
                        {
                            "text": "The meeting is scheduled for <w>twelve</w> o'clock.",
                            "target_lang_translations": {
                                "ru": "Встреча назначена на <w>двенадцать</w> часов.",
                                "zh": "会议定在<w>十二</w>点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "twelve o'clock",
                        "twelve apostles",
                        "twelve tribes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количественное числительное, следующее за одиннадцатью и предшествующее тринадцати.",
                        "zh": "在十一之后、十三之前的基数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двенадцать",
                                "target_lang_sense_clarification": "число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十二",
                                "target_lang_sense_clarification": "数字"
                            }
                        ]
                    }
                }
            ]
        },
        {
