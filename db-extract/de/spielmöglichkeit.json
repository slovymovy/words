                "senses": [
                    {
                        "sense_id": "5ab37ceb-8dc0-314b-90de-c85e838a163b",
                        "entry_id": "8cbef9d5-cc88-3b40-b724-238f432a74ee",
                        "glosses": [
                            "Freiraum, Gelegenheit zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc46d6b8-6fae-4065-8d97-7d2b82ee2d43",
                                "sense_id": "5ab37ceb-8dc0-314b-90de-c85e838a163b",
                                "text": "„Wir haben aber bewusst die ganze Fülle der uns bekannten Spielmöglichkeiten und ihrer Varianten aufgeschrieben, damit didaktische Spiele immer mehr Eingang in die Bildungs- und Erziehungsarbeit finden.“"
                            },
                            {
                                "example_id": "24dc25b4-34f0-4620-b04c-2571f2d06059",
                                "sense_id": "5ab37ceb-8dc0-314b-90de-c85e838a163b",
                                "text": "„Die fortschreitenden Einschränkungen der Spielmöglichkeiten und das Anwachsen der Spielfeindlichkeit im Alltag tragen entscheidend zur Verkümmerung elementarer Spielfähigkeiten bei Kindern, Jugendlichen und Erwachsenen bei.“"
                            },
                            {
                                "example_id": "019bbdde-ea58-4f9c-8153-6a851ba39931",
                                "sense_id": "5ab37ceb-8dc0-314b-90de-c85e838a163b",
                                "text": "„Das Vorspiel, wie wir es kennengelernt haben, kann auch dem Sichkennenlernen der Mitspieler und dem Ausprobieren der Spielmöglichkeiten dienen.“"
                            },
                            {
                                "example_id": "be8420df-81dc-47d0-b86e-391a589d9bc3",
                                "sense_id": "5ab37ceb-8dc0-314b-90de-c85e838a163b",
                                "text": "„Die Spiele dieser Sinngebung umfassen eine breite Palette von Spielmöglichkeiten.“"
                            },
                            {
                                "example_id": "36137670-f5da-4ba5-8f32-1ad4b0495496",
                                "sense_id": "5ab37ceb-8dc0-314b-90de-c85e838a163b",
                                "text": "„Wegen des zunehmenden Rückzugs von Sponsoren schwinden den Profis die Spielmöglichkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
