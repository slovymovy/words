                "senses": [
                    {
                        "sense_id": "1be13361-5e19-3d8b-b875-a634b4f79b13",
                        "entry_id": "86b791de-5645-3392-acd4-1eb60c257feb",
                        "glosses": [
                            "spezielle Schere zum Kürzen des Dochtes von Kerzen, die auch zum Kerzenlöschen verwendet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3e9124-7064-4944-abd6-580441f3d52c",
                                "sense_id": "1be13361-5e19-3d8b-b875-a634b4f79b13",
                                "text": "„Das Putzen des Dochtes mit der Lichtschere nahm viel Zeit in Anspruch und bot uns Knaben Gelegenheit zu manchem Schabernack.“"
                            },
                            {
                                "example_id": "ffb1cf24-1b91-4355-bfb8-46184fd3d11b",
                                "sense_id": "1be13361-5e19-3d8b-b875-a634b4f79b13",
                                "text": "„Die übrigen Habseligkeiten der Kirche bestanden aus einem dreiarmigen kupfernen Leuchter, der an drei Stellen zerbrochen war und den ich ihnen mit Bindfaden zusammenband, damit er nicht wieder auseinanderfiel, wenn man ihn anfaßte, und aus einer Lichtschere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
