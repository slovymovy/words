                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sturmtruppen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0725bfb-803c-347a-af0b-77fe0c38d1e2",
                                        "entry_id": "35487002-f229-356b-9af6-934af5d90695",
                                        "glosses": [
                                            "Soldats de l'unité d'élite de l'armée impériale allemande de la guerre de position de la Première Guerre mondiale."
                                        ],
