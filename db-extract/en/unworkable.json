                "senses": [
                    {
                        "sense_id": "f31b6c69-ccea-327e-be25-2b0f76bad999",
                        "entry_id": "38fd4774-5dc3-38d3-9b9c-2c9e85bb0cdf",
                        "glosses": [
                            "Not workable.",
                            "Not operable; not practical; unmanageable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbb37ca1-c7cb-4d6c-a254-8fcd86dbd1d5",
                                "sense_id": "f31b6c69-ccea-327e-be25-2b0f76bad999",
                                "text": "Near-synonyms: infeasible, untenable, unusable"
                            },
                            {
                                "example_id": "d5b0ac5e-df9d-48aa-92d0-5e8b3275fd3c",
                                "sense_id": "f31b6c69-ccea-327e-be25-2b0f76bad999",
                                "text": "These plans seem unworkable; moreover, a budget for their implementation remains a fantasy."
                            },
                            {
                                "example_id": "89fe2d42-2762-4191-9872-29a343a492ec",
                                "sense_id": "f31b6c69-ccea-327e-be25-2b0f76bad999",
                                "text": "A Welsh Government spokesman said: \"We are opposed to the approach being taken by the UK Government, which we feel is unnecessary, probably unworkable, and will do nothing to resolve industrial disputes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c85e6205-4a32-3b7a-9e60-18f7079e4035",
                        "entry_id": "38fd4774-5dc3-38d3-9b9c-2c9e85bb0cdf",
                        "glosses": [
                            "Not workable.",
                            "Not suitable or amenable for being manipulated or transformed."
                        ],
                        "tags": [
                            "of raw materials"
                        ],
                        "examples": [
                            {
                                "example_id": "24e2392e-24d8-4b32-b8ef-90228b6e6418",
                                "sense_id": "c85e6205-4a32-3b7a-9e60-18f7079e4035",
                                "text": "Near-synonyms: unprocessable, unusable"
                            },
                            {
                                "example_id": "d9872f6e-93f8-4572-b88c-e4a3951a114c",
                                "sense_id": "c85e6205-4a32-3b7a-9e60-18f7079e4035",
                                "text": "unworkable soils;   unworkable clays;   unworkable metals"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96ffb359-1974-4a77-b0d7-bacb956e8091",
                        "source_entry_id": "38fd4774-5dc3-38d3-9b9c-2c9e85bb0cdf",
                        "source_sense_description": "not workable",
                        "target_lang_word": "inexécutable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
