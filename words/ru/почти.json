{
    "word_family": [
        "почтение",
        "почтительный",
        "почёт",
        "почётный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "16c2b996-97c4-3024-879d-ec3068324701",
                    "sense_definition": "Без малого, очень близко к чему-либо; так, что недостает совсем немного.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>почти</w> пришли к месту назначения.",
                            "target_lang_translations": {
                                "en": "We have <w>almost</w> arrived at the destination.",
                                "zh": "我们<w>几乎</w>到达目的地了。"
                            }
                        },
                        {
                            "text": "Я <w>почти</w> всё сделал, осталось совсем немного.",
                            "target_lang_translations": {
                                "en": "I have done <w>almost</w> everything, very little is left.",
                                "zh": "我<w>差不多</w>都做完了，只剩下一点点。"
                            }
                        },
                        {
                            "text": "В зале собралось <w>почти</w> сто человек.",
                            "target_lang_translations": {
                                "en": "<w>Nearly</w> a hundred people gathered in the hall.",
                                "zh": "大厅里聚集了<w>几乎</w>一百人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "приблизительно",
                        "около",
                        "практически"
                    ],
                    "antonyms": [
                        "точно",
                        "в точности"
                    ],
                    "common_phrases": [
                        "почти всё",
                        "почти всегда",
                        "почти никогда",
                        "почти готово",
                        "почти каждый"
                    ],
                    "target_lang_definitions": {
                        "en": "Very close to something, but not completely; lacking very little.",
                        "zh": "表示程度非常接近，但尚未完全达到；差一点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "almost",
                                "target_lang_sense_clarification": "Very close to, but not quite"
                            },
                            {
                                "target_lang_word": "nearly",
                                "target_lang_sense_clarification": "In close approximation; virtually"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "几乎",
                                "target_lang_sense_clarification": "表示程度接近，差一点"
                            },
                            {
                                "target_lang_word": "差不多",
                                "target_lang_sense_clarification": "表示相差很小"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f77e0593-2409-30aa-b03b-ceb91b233131",
                    "sense_definition": "Форма второго лица единственного числа повелительного наклонения глагола <w>почтить</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Почти</w> память героев минутой молчания.",
                            "target_lang_translations": {
                                "en": "<w>Honor</w> the memory of the heroes with a minute of silence.",
                                "zh": "请用默哀一分钟来<w>敬重</w>英雄们的记忆。"
                            }
                        },
                        {
                            "text": "<w>Почти</w> своим присутствием наш скромный праздник.",
                            "target_lang_translations": {
                                "en": "<w>Honor</w> our humble celebration with your presence.",
                                "zh": "请用您的出席来<w>敬重</w>我们简朴的庆典。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb meaning to honor or show respect.",
                        "zh": "动词“敬重”或“纪念”的命令式形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "honour",
                                "target_lang_sense_clarification": "2nd person singular imperative of почтить — to honour"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敬重",
                                "target_lang_sense_clarification": "表示尊敬或纪念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8162f939-d397-38d7-a4a8-9a343ca946c0",
                    "sense_definition": "Форма второго лица единственного числа повелительного наклонения глагола <w>почесть</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Почти</w> за честь выполнить это поручение.",
                            "target_lang_translations": {
                                "en": "<w>Consider</w> it an honor to fulfill this assignment.",
                                "zh": "请把完成这项任务<w>视为</w>一种荣誉。"
                            }
                        },
                        {
                            "text": "Не <w>почти</w> за труд передать это письмо.",
                            "target_lang_translations": {
                                "en": "Do not <w>consider</w> it a trouble to pass on this letter.",
                                "zh": "请不要把转交这封信<w>视为</w>麻烦。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb meaning to consider or deem.",
                        "zh": "动词“认为”或“视为”的命令式形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "2nd person singular imperative of почесть — to deem, consider"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视为",
                                "target_lang_sense_clarification": "表示把某事看作某种性质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
