                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07742155-7fd5-4c9a-a7e0-fa684773589a",
                                "sense_id": "1cbc3d01-e101-3132-b4b5-1a893e5d03b8",
                                "text": "Zou Lei woont samen met vijf andere vrouwen en een literpak oranje frisdrank in een motelkamer."
                            },
                            {
                                "example_id": "7194899d-e488-447d-a934-9a61cf896541",
                                "sense_id": "1cbc3d01-e101-3132-b4b5-1a893e5d03b8",
                                "text": "Daar komt bij dat een groeiende groep mensen melk maar saai of ouderwets vindt. Het traditionele literpak past niet meer in het moderne leefpatroon en de veranderende gezinssamenstelling."
                            },
                            {
                                "example_id": "aa484dc3-5cc1-45cf-8433-724aa23bcde6",
                                "sense_id": "1cbc3d01-e101-3132-b4b5-1a893e5d03b8",
                                "text": "De Maltezers geven eigen postzegels en munten uit. De zegels conformeren zich sinds een paar jaar aan de euro, maar de munten hebben nog de middeleeuwse waarde. Voor 5 scudi kun je omgerekend een literpak melk kopen."
                            }
                        ]
                    }
