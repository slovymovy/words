                        ],
                        "examples": [
                            {
                                "example_id": "5cfb8e72-0d0d-4692-b23e-ce3c8a44bfff",
                                "sense_id": "a7d11411-e226-3e5e-a9f2-673f9c6e2f75",
                                "text": "j’ai ressenti, ce jour, l’impression que le dispositif se complaisait trop sur route et que la troupe hésitait à champoier."
                            },
                            {
                                "example_id": "4dbfd26d-0fc5-4f6f-ad15-c8ff2d53d00e",
                                "sense_id": "a7d11411-e226-3e5e-a9f2-673f9c6e2f75",
                                "text": "Ils abandonnèrent tout et n’ont plus champoié depuis ce temps-là."
                            },
                            {
                                "example_id": "d3929901-1e1d-4209-b9b1-553b818e92e7",
                                "sense_id": "a7d11411-e226-3e5e-a9f2-673f9c6e2f75",
                                "text": "Par suite de cette redevance, il leur était permis d’avoir des fours chez eux et de faire champoier ledit étang."
                            }
                        ]
