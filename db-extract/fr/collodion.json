                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коллодий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "12491958-7e2a-3c92-85dd-9cb0cb9fcb1e",
                                        "entry_id": "9da207fd-a74d-36f0-9c01-9bef8acae629",
                                        "glosses": [
                                            "хим. раствор нитратов целлюлозы (4 части) в смеси спирта (20 частей) и эфира (76 частей)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640e1576-dabb-434e-b9ef-2d675286aed5",
                                                "sense_id": "12491958-7e2a-3c92-85dd-9cb0cb9fcb1e",
                                                "text": "Но для того, чтобы коллодий не приставал к троммелю и имел ровную, без малейшей царапины поверхность, медная лента покрывается слоем желатины."
                                            }
                                        ]
