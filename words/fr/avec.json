{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "c85c92e0-b7c2-3885-970d-c7f1105cc1c8",
                    "sense_definition": "En compagnie de quelqu'un ou conjointement à quelque chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "accompagnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais au cinéma ce soir <w>avec</w> mes amis."
                        },
                        {
                            "text": "Elle a décidé de partir en vacances <w>avec</w> sa sœur."
                        }
                    ],
                    "antonyms": [
                        "sans"
                    ],
                    "common_phrases": [
                        "partir avec quelqu'un",
                        "vivre avec quelqu'un"
                    ]
                },
                {
                    "sense_id": "0a1fe54d-e15b-330f-8cd3-0e8b0535e51a",
                    "sense_definition": "Au moyen de quelque chose ou d'une certaine manière.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "moyen_maniere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a répondu à ma demande <w>avec</w> plaisir et enthousiasme."
                        },
                        {
                            "text": "Elle a coupé le pain <w>avec</w> un grand couteau."
                        }
                    ],
                    "antonyms": [
                        "sans"
                    ],
                    "common_phrases": [
                        "avec plaisir",
                        "écrire avec un stylo"
                    ]
                },
                {
                    "sense_id": "152e37f7-a569-3318-93b6-d9ea29e61143",
                    "sense_definition": "Pour marquer un trait distinctif, une attitude ou un aspect singulier d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caracteristique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il nous fait toujours rire <w>avec</w> ses mimiques ridicules."
                        },
                        {
                            "text": "Elle est très impressionnante <w>avec</w> son grand manteau noir."
                        }
                    ],
                    "common_phrases": [
                        "avec son air sérieux"
                    ]
                },
                {
                    "sense_id": "cac2cd67-ca08-3343-8b4c-ca5dad995298",
                    "sense_definition": "Contre, dans une relation d'opposition ou d'affrontement réciproque.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pays voisin est entré en guerre <w>avec</w> ses rivaux historiques."
                        },
                        {
                            "text": "Il s'est encore disputé <w>avec</w> son collègue de bureau hier."
                        }
                    ],
                    "common_phrases": [
                        "être en guerre avec",
                        "se battre avec quelqu'un"
                    ]
                },
                {
                    "sense_id": "ab0bc65c-aecd-3ece-a8e3-99081ba5d614",
                    "sense_definition": "Malgré ou en dépit de.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Avec</w> tout le respect que je vous dois, je ne suis pas d'accord."
                        },
                        {
                            "text": "<w>Avec</w> toute sa bonne volonté, il n'a pas réussi à terminer le travail."
                        }
                    ],
                    "common_phrases": [
                        "avec tout le respect"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "46ea130e-4b59-3b9b-90df-a8a7a2ac9f46",
                    "sense_definition": "Avec cela, conjointement à une chose connue par le contexte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ellipse_chose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai acheté ce meuble et les vis étaient fournies <w>avec</w>."
                        },
                        {
                            "text": "Il a pris son manteau et il est parti <w>avec</w>."
                        }
                    ],
                    "common_phrases": [
                        "aller avec",
                        "partir avec"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "2bde9b3e-13da-3786-9e7b-451eedae5424",
                    "sense_definition": "En compagnie d'une personne connue par le contexte, sans complément explicite.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "ellipse_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons faire une promenade au parc, tu viens <w>avec</w> ?"
                        },
                        {
                            "text": "Elle part faire les courses et m'a demandé si je venais <w>avec</w>."
                        }
                    ],
                    "common_phrases": [
                        "venir avec"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "fréquent en français régional"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "oral familier"
                        }
                    ]
                },
                {
                    "sense_id": "79dd4840-2a88-369d-9dda-823847c05276",
                    "sense_definition": "Aussi, de la même manière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aussi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère a réussi son examen d'entrée, et moi <w>avec</w>."
                        },
                        {
                            "text": "Tout le monde est parti très tôt ce matin, et lui <w>avec</w>."
                        }
                    ],
                    "common_phrases": [
                        "moi avec",
                        "toi avec"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principalement au Québec et dans certaines régions"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "usage familier"
                        }
                    ]
                }
            ]
        }
    ]
}