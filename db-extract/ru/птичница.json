                        "glosses": [
                            "женск. к птичник; работница, ухаживающая за домашней птицей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4912d06-4542-4608-ba60-fbe1253c385c",
                                "sense_id": "8f8c11db-5227-3905-b5ab-2e10f6bf2113",
                                "text": "Бойкая птичница в фартуке с кармашком, на кармашке желтый утенок, лужица, смеющееся солнышко, лучики врастопырку."
                            },
                            {
                                "example_id": "ff97e2e3-64b7-4f04-92d7-165eefc84c14",
                                "sense_id": "8f8c11db-5227-3905-b5ab-2e10f6bf2113",
                                "text": "Птичница ловила то курицу, то петуха, бригадир сам ощупывал их и браковал..."
                            }
                        ]
                    }
