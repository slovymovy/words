                                "sense_id": "2ad1b3bc-043e-3367-995b-b95f8cd99680",
                                "text": "For why should you praise, for example, the integrity of a Square who faithfully defends the interests of his client, when you ought in reality rather to admire the exact precision of his Rectangles?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b4bbda37-53b9-3fee-83f7-7428dd5dabe7",
                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                        "glosses": [
                            "The product of two quantities."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
