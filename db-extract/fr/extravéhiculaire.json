                        "glosses": [
                            "Hors du vaisseau spatial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4190eb-aa3d-49f1-b9f9-f1d23c9cceb2",
                                "sense_id": "05bd4f44-f663-3a63-b5cb-d4deb6399ce5",
                                "text": "Aux côtés du général Zhai Zhigang (55 ans), commandant de la mission, Wang Yaping a effectué dans la nuit de dimanche à lundi une sortie extravéhiculaire de 6 heures et demie, a indiqué l’agence spatiale chargée des vols habités (CMSA)."
                            },
                            {
                                "example_id": "47b75f28-c74f-4668-8689-5e4cc9c49212",
                                "sense_id": "05bd4f44-f663-3a63-b5cb-d4deb6399ce5",
                                "text": "Pour cela, elles ont l’intention de créer une structure qui aurait la particularité d’être équipée d’une plateforme extravéhiculaire."
                            }
                        ]
                    }
