                        "glosses": [
                            "Qui peut être bousculé, dérangé, voire renversé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cddf6082-f104-49cd-af9a-f09fabb9660b",
                                "sense_id": "f2295faf-e15d-32f9-be49-2d6f89f57ca5",
                                "text": "potelet flexible et bousculable, anti-stationnement pour le mobilier urbain."
                            },
                            {
                                "example_id": "d90d214d-6da3-43bf-b612-d11f8071ec31",
                                "sense_id": "f2295faf-e15d-32f9-be49-2d6f89f57ca5",
                                "text": "Le propre des productions industrielles est qu’elles sont à tout moment bousculables par un changement technologique."
                            },
                            {
                                "example_id": "9f43f20d-98c0-4889-837e-87e75afdc177",
                                "sense_id": "f2295faf-e15d-32f9-be49-2d6f89f57ca5",
                                "text": "Et ce flot continu, cette foule compacte, ce va-et-vient incessant, ces individus ne pensant qu’à se dépêcher, jaillissant du ventre de la chenille, s’y engouffrant aveuglement, bousculant tout ce qui est bousculable, luttant contre les autres, tous les autres."
                            },
                            {
                                "example_id": "735b7465-268a-4fbe-b7b2-417c7f62427a",
                                "sense_id": "f2295faf-e15d-32f9-be49-2d6f89f57ca5",
                                "text": "Pendant ce temps-là, madame Fourcade, qui est tout à fait bousculable, s’ennuie souverainement dans son appartement, et elle a fait la connaissance de son voisin Garcia, un veilleur qui a des horaires de travail décalés."
                            }
                        ]
