                        "cheminement des planètes"
                    ]
                },
                {
                    "sense_id": "58b1bf5b-5234-33cd-be3a-8be17d00a529",
                    "sense_definition": "Progression souterraine ou à couvert de tranchées et de travaux offensifs lors d'un siège.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les sapeurs poursuivaient le <w>cheminement</w> des boyaux en direction des remparts ennemis."
                        },
                        {
                            "text": "Ce <w>cheminement</w> militaire permit aux troupes d'approcher la citadelle sans être vues."
