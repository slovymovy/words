        "fr-extract.jsonl": [
            {
                "entry_id": "dd66e872-7a2c-3344-8054-348e62861eec",
                "word": "thymol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b1dd0793-3d53-38ce-aba7-830cbb76df8c",
                        "entry_id": "dd66e872-7a2c-3344-8054-348e62861eec",
                        "glosses": [
                            "Essence de thym qui a des propriétés antiseptiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11b1ca0-bc2b-438b-b561-2b6c17865a0e",
                                "sense_id": "b1dd0793-3d53-38ce-aba7-830cbb76df8c",
                                "text": "Comme un antiseptique supraterrestre, comme un thymol extrahumain, la liturgie épure, désinfecte la laideur impie de ces lieux."
                            },
                            {
                                "example_id": "99151df3-b272-4884-b4c2-eabfd1c4ee3f",
                                "sense_id": "b1dd0793-3d53-38ce-aba7-830cbb76df8c",
                                "text": "Thymol C₁₀H₁₄O. […]. Traité en solution alcaline par une solution d’iode dans l’iodure de potassium, il donne une poudre rouge brun, très employée sous le nom d’aristol."
                            },
                            {
                                "example_id": "f013751b-ff40-470b-a099-8c034bc3bb0d",
                                "sense_id": "b1dd0793-3d53-38ce-aba7-830cbb76df8c",
                                "text": "Le naphtol ne donne pas cette réaction, bien qu'il soit isomère au thymol."
                            }
                        ]
                    }
                ],
