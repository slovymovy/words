                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e1991a0-4e0f-4742-ba2b-69debb0406fd",
                                                "sense_id": "c606472b-6f80-33a4-88ab-3d6a7e5a2c3e",
                                                "text": "Betrayed (Constantin Costa-Gavras, 1988, VS). Politieke-thriller-specialist maakte minder overtuigende, retorische aanklacht tegen racistische terreur in VS. FBI-agente Debra Winger zoekt toenadering tot de van moord verdachte Tom Berenger, een weduwnaar met twee sproetige kindertjes."
                                            }
                                        ]
                                    }
                                ]
