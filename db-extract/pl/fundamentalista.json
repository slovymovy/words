                        "sense_id": "df1da7d9-bd30-3961-a46d-8e4d26427130",
                        "entry_id": "86998dde-63b3-32cc-a5db-d580d53782ec",
                        "glosses": [
                            "człowiek rygorystycznie przestrzegający jakichś zasad, norm, zwłaszcza w dziedzinie religii i polityki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b106355f-9ec2-4248-8002-0a37a9aa639c",
                                "sense_id": "df1da7d9-bd30-3961-a46d-8e4d26427130",
                                "text": "O zamach podejrzewa się marksistowskich fundamentalistów."
                            },
                            {
                                "example_id": "36fa7060-f23d-4970-8c14-42adbcd89696",
                                "sense_id": "df1da7d9-bd30-3961-a46d-8e4d26427130",
                                "text": "Rozwój wiedzy został jednak gwałtownie zahamowany w XIV wieku, kiedy religijni fundamentaliści przekonali władców, że należy zdławić naukę i filozofię w całym islamskim imperium, ponieważ nowe odkrycia podważają boską wszechwiedzę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
