{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afd906ca-b06a-3355-be14-2562d9b86763",
                    "sense_definition": "The specific time when a person died; an initialism for Time of Death.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acronyms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coroner examined the body to determine the <w>TOD</w>.",
                            "target_lang_translations": {
                                "ru": "Коронер осмотрел тело, чтобы определить <w>время смерти</w>.",
                                "es": "El forense examinó el cuerpo para determinar la <w>hora de la muerte</w>."
                            }
                        },
                        {
                            "text": "Police established the <w>TOD</w> to be between midnight and 2 AM.",
                            "target_lang_translations": {
                                "ru": "Полиция установила, что <w>время смерти</w> наступило между полуночью и двумя часами ночи.",
                                "es": "La policía determinó que la <w>hora de la muerte</w> fue entre medianoche y las dos de la madrugada."
                            }
                        }
                    ],
                    "common_phrases": [
                        "estimated TOD",
                        "determine TOD"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Точное время, когда наступила смерть человека; аббревиатура от Time of Death.",
                        "es": "Momento exacto en que una persona falleció; sigla en inglés de Time of Death (hora de la muerte)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время смерти",
                                "target_lang_sense_clarification": "медицинский/полицейский термин"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hora de la muerte",
                                "target_lang_sense_clarification": "medicina forense o policial"
                            },
                            {
                                "target_lang_word": "hora del fallecimiento",
                                "target_lang_sense_clarification": "medicina legal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47ebd5bd-0274-34bf-9aab-9ab8340d719c",
                    "sense_definition": "A fox.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>tod</w> slipped silently through the heather to escape the hounds.",
                            "target_lang_translations": {
                                "ru": "Старый <w>лис</w> бесшумно проскользнул сквозь вереск, спасаясь от гончих.",
                                "es": "El viejo <w>zorro</w> se deslizó en silencio entre el brezo para huir de los sabuesos."
                            }
                        },
                        {
                            "text": "Farmers in the valley kept a close watch for the <w>tod</w> near their chicken coops.",
                            "target_lang_translations": {
                                "ru": "Фермеры в долине внимательно высматривали <w>лиса</w> возле своих курятников.",
                                "es": "Los granjeros del valle vigilaban atentamente por si rondaba el <w>zorro</w> cerca de los gallineros."
                            }
                        }
                    ],
                    "synonyms": [
                        "reynard"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Scottish and Northern English"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лиса (устаревшее или диалектное название).",
                        "es": "Zorro (término arcaico o dialectal británico)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лис",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "лиса",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "zorro",
                                "target_lang_sense_clarification": "animal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "429d3bac-8688-3514-abcc-6f685cd9d233",
                    "sense_definition": "A male fox.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>tod</w> was seen crossing the field at dusk.",
                            "target_lang_translations": {
                                "ru": "В сумерках видели, как большой <w>лис</w> перебегал поле.",
                                "es": "Se vio a un gran <w>zorro macho</w> cruzar el campo al atardecer."
                            }
                        },
                        {
                            "text": "The hunter distinguished the <w>tod</w> from the vixen by his size.",
                            "target_lang_translations": {
                                "ru": "Охотник отличил <w>лиса</w> от лисицы по размеру.",
                                "es": "El cazador diferenció al <w>zorro macho</w> de la hembra por su tamaño."
                            }
                        }
                    ],
                    "synonyms": [
                        "dog-fox"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Scottish and Northern English"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец лисы.",
                        "es": "Macho del zorro."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лис",
                                "target_lang_sense_clarification": "самец"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "zorro macho",
                                "target_lang_sense_clarification": "animal macho"
                            },
                            {
                                "target_lang_word": "zorro",
                                "target_lang_sense_clarification": "macho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1161990a-14b6-3e1e-a571-0a9ec05c3b9c",
                    "sense_definition": "An old English unit of weight, primarily used for wool, equal to 28 pounds (approximately 12.7 kg).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant purchased a <w>tod</w> of high-quality wool.",
                            "target_lang_translations": {
                                "ru": "Купец приобрел <w>тод</w> высококачественной шерсти.",
                                "es": "El comerciante compró un <w>tod</w> de lana de alta calidad."
                            }
                        },
                        {
                            "text": "In the old market records, prices were listed per <w>tod</w> rather than per pound.",
                            "target_lang_translations": {
                                "ru": "В старых рыночных записях цены указывались за <w>тод</w>, а не за фунт.",
                                "es": "En los antiguos registros del mercado, los precios se indicaban por <w>tod</w> en lugar de por libra."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная английская мера веса, использовавшаяся преимущественно для шерсти, равная 28 фунтам (около 12,7 кг).",
                        "es": "Antigua unidad inglesa de peso, utilizada principalmente para la lana, equivalente a 28 libras (unos 12,7 kg)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тод",
                                "target_lang_sense_clarification": "старинная мера веса"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tod",
                                "target_lang_sense_clarification": "antigua unidad de peso inglesa (28 libras)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a353e7e9-6593-33a6-a870-275275aa0a6f",
                    "sense_definition": "A thick bush or clump of foliage, especially ivy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Birds nested deep within the ivy <w>tod</w> covering the ruins.",
                            "target_lang_translations": {
                                "ru": "Птицы гнездились глубоко в <w>зарослях</w> плюща, покрывавших руины.",
                                "es": "Los pájaros anidaban en lo profundo de la <w>espesura</w> de hiedra que cubría las ruinas."
                            }
                        },
                        {
                            "text": "A dense <w>tod</w> of greenery obscured the entrance to the cave.",
                            "target_lang_translations": {
                                "ru": "Густой <w>куст</w> зелени скрывал вход в пещеру.",
                                "es": "Un denso <w>matorral</w> de vegetación ocultaba la entrada a la cueva."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ivy tod"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Густой куст или скопление листвы, особенно плюща.",
                        "es": "Matorral espeso o mata tupida de follaje, especialmente de hiedra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куст",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "заросли",
                                "target_lang_sense_clarification": "густая растительность"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "matorral",
                                "target_lang_sense_clarification": "mata o maleza espesa"
                            },
                            {
                                "target_lang_word": "espesura",
                                "target_lang_sense_clarification": "follaje espeso"
                            },
                            {
                                "target_lang_word": "mata",
                                "target_lang_sense_clarification": "arbusto tupido"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dec1566d-ad14-3b07-8c3f-c17071feab14",
                    "sense_definition": "A diminutive form of the male given name Todd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I met <w>Tod</w> at the conference last week.",
                            "target_lang_translations": {
                                "ru": "Я встретил <w>Тода</w> на конференции на прошлой неделе.",
                                "es": "Conocí a <w>Tod</w> en el congreso la semana pasada."
                            }
                        },
                        {
                            "text": "Please tell <w>Tod</w> that his appointment is rescheduled.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, скажи <w>Тоду</w>, что его встреча перенесена.",
                                "es": "Por favor, dile a <w>Tod</w> que su cita se ha reprogramado."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма мужского имени Тодд.",
                        "es": "Diminutivo del nombre de pila masculino Todd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тод",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Tod",
                                "target_lang_sense_clarification": "nombre propio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f81d9b5-4f4c-3b2f-8f9f-db93c8edce67",
                    "sense_definition": "An informal short name for Todmorden, a town in England.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The locals often refer to their town simply as <w>Tod</w>.",
                            "target_lang_translations": {
                                "ru": "Местные жители часто называют свой город просто <w>Тод</w>.",
                                "es": "Los lugareños suelen referirse a su ciudad simplemente como <w>Tod</w>."
                            }
                        },
                        {
                            "text": "We took the train to <w>Tod</w> for the weekend market.",
                            "target_lang_translations": {
                                "ru": "Мы поехали на поезде в <w>Тод</w> на рынок выходного дня.",
                                "es": "Tomamos el tren a <w>Tod</w> para ir al mercado de fin de semana."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное сокращенное название города Тодморден в Англии.",
                        "es": "Nombre abreviado informal de Todmorden, una localidad en Inglaterra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тод",
                                "target_lang_sense_clarification": "название города"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Tod",
                                "target_lang_sense_clarification": "nombre de lugar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe8f9dbe-da59-31cd-bdaf-e66bfd11e0b5",
                    "sense_definition": "To weigh a specific amount, specifically in tods (an old unit of weight).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weighing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer checked if the wool sack <w>todded</w> the correct amount.",
                            "target_lang_translations": {
                                "ru": "Фермер проверил, <w>весит</w> ли мешок с шерстью положенное количество.",
                                "es": "El granjero comprobó si el saco de lana <w>pesaba</w> la cantidad correcta."
                            }
                        },
                        {
                            "text": "This bundle <w>tods</w> fully twenty-eight pounds.",
                            "target_lang_translations": {
                                "ru": "Эта связка <w>весит</w> полные двадцать восемь фунтов.",
                                "es": "Este fardo <w>pesa</w> exactamente veintiocho libras."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Весить определенное количество, особенно в тодах (старинная мера веса).",
                        "es": "Pesar una cantidad determinada, específicamente en tods (antigua unidad de peso)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весить",
                                "target_lang_sense_clarification": "иметь вес"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pesar",
                                "target_lang_sense_clarification": "tener un peso específico en tods"
                            }
                        ]
                    }
                }
            ]
        }
