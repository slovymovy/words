                ],
                "senses": [
                    {
                        "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                        "entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                        "glosses": [
                            "Vorgang oder Ergebnis von Kontrolle und gegebenenfalls Verbesserung bereits erarbeiteter Gegenstände oder Werke (Komposition, Plastik, Text und dergleichen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41af221-994e-47f1-bca6-c1e0ce82dd6c",
                                "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                "text": "„Ich fürchte, eine solche Überarbeitung könnte die Authentizität und Aussagekraft beeinträchtigen.“"
                            },
                            {
                                "example_id": "7bc90608-eec9-478c-a54c-faeae4a0b087",
                                "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                "text": "„Aber auch Wieland ließ in seiner Überarbeitung die Zeile nicht stehen – wie Manches nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a80fb017-286e-36f0-bebc-28f76d539b2b",
                        "entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                        "glosses": [
                            "physische und/oder psychische Überanstrengung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e9d308-ce14-4200-97da-2c7b3c59ee60",
                                "sense_id": "a80fb017-286e-36f0-bebc-28f76d539b2b",
                                "text": "Infolge der andauernden Überarbeitung musste sie eine längere Pause einlegen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04da72d4-33a5-4bda-8758-8361ca37b01f",
                        "source_entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                        "source_sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                        "target_lang_word": "revision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9733c03d-ff80-340c-bd53-e9e956be486d",
                                        "entry_id": "d66f72d5-4201-31fa-baa7-0f5c1e5fbcf3",
                                        "glosses": [
                                            "The process of revising:",
                                            "The action or process of reviewing, editing and amending."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6736d1a5-8183-4eca-9e9a-d85d95d5560e",
                                                "sense_id": "9733c03d-ff80-340c-bd53-e9e956be486d",
                                                "text": "Revision can turn a passable paper into an excellent one and change an excellent one into a radiant one."
                                            },
                                            {
                                                "example_id": "cb58a5f1-9d63-43ec-9f65-d89673df3d4f",
                                                "sense_id": "9733c03d-ff80-340c-bd53-e9e956be486d",
                                                "text": "2004, Mara Kalnins (editor), Note on the Text, Joseph Conrad, Victory: An Island Tale, page xxxix,\nThe full history of its composition, revision, transmission, and publication is a complex and intricate one beyond the necessarily limited scope of this Note, […] ."
                                            },
                                            {
                                                "example_id": "fbe5ccdd-e355-43d4-9ca0-cce9a5f5e04f",
                                                "sense_id": "9733c03d-ff80-340c-bd53-e9e956be486d",
                                                "text": "Many formalisms for belief revision use extraneous mechanisms for deciding what beliefs to keep and this makes it harder to iterate the process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3fda3c6-6a19-3629-b43d-59153372cea7",
                                        "entry_id": "d66f72d5-4201-31fa-baa7-0f5c1e5fbcf3",
                                        "glosses": [
                                            "The process of revising:",
                                            "The action or process of reviewing something previously learned, especially one′s notes in preparation for a test or examination."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b27b93f-866b-4815-b407-ac63de38cb64",
                                                "sense_id": "d3fda3c6-6a19-3629-b43d-59153372cea7",
                                                "text": "All that last minute revision really paid off in the exam! I got top marks!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04686e91-f108-3070-87d4-3bb0b45b63d7",
                                        "entry_id": "d66f72d5-4201-31fa-baa7-0f5c1e5fbcf3",
                                        "glosses": [
                                            "A changed edition, or new version; a modification."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaab1c7c-a3ce-42a9-81a1-d81cba2cec1b",
                                                "sense_id": "04686e91-f108-3070-87d4-3bb0b45b63d7",
                                                "text": "The first thing members need to understand about a revision is that the current bylaws are not under consideration at all. If the revision is defeated, no changes to the current bylaws take place."
                                            },
                                            {
                                                "example_id": "1a629a91-f53b-488f-a363-bfd025cf64d5",
                                                "sense_id": "04686e91-f108-3070-87d4-3bb0b45b63d7",
                                                "text": "1992, Helen Baron, Carl Baron (editors), Introduction, The Cambridge Edition of the Works of D. H, Lawrence: Sons and Lovers, Part 1, 2002 paperback edition, Cambridge University Press, page lxxx,\nHowever, it is evident in a minority of cases that a revision by Lawrence is prompted solely by the need to remedy some local effect caused by Garnett′s deletion, and there, clearly, Lawrence′s MS text is, in principle, to be preferred."
                                            },
                                            {
                                                "example_id": "a8affaa2-b612-4862-9e40-dc19165785d5",
                                                "sense_id": "04686e91-f108-3070-87d4-3bb0b45b63d7",
                                                "text": "2008, World Bank, page 209,\nPrevious editions of World Development Indicators used revision 2, first published in 1948. Revision 3 was completed in 1989, and many countries now use it. But revision 2 is still widely used for compiling cross-country data."
                                            },
                                            {
                                                "example_id": "d63c7b38-bf26-4e08-87e4-6c5f27cecd46",
                                                "sense_id": "04686e91-f108-3070-87d4-3bb0b45b63d7",
                                                "text": "Include the revision number. You may need to add a triangle and number, shown in Figure 9-6, to indicate the revision number."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76353536-009c-3b5a-89f4-205be65eefb6",
                                        "entry_id": "d66f72d5-4201-31fa-baa7-0f5c1e5fbcf3",
                                        "glosses": [
                                            "A story corrected or expanded by a writer commissioned by the original author."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c7be0f-8d55-44bc-bfe5-1182af8a527e",
                                                "sense_id": "76353536-009c-3b5a-89f4-205be65eefb6",
                                                "text": "A revision story"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cdc57cb-5148-3609-a773-d2eedce6e8a5",
                                        "entry_id": "c5ffb011-f879-30f5-a91f-a11070d9ffd7",
                                        "glosses": [
                                            "To provide with a new vision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339e5f7a-e73f-4ac0-b38b-8f0ef9078257",
                                                "sense_id": "4cdc57cb-5148-3609-a773-d2eedce6e8a5",
                                                "text": "What philosophy needs is to be revisioned with a more hopeful, engaged inspirational point of view."
                                            },
                                            {
                                                "example_id": "7e6bee70-8ebe-40dc-bc00-ebb9c634cb55",
                                                "sense_id": "4cdc57cb-5148-3609-a773-d2eedce6e8a5",
                                                "text": "Earlier plays of the Broadway comedy genre focused on assimilation […] By re-imagining and re-visioning classic Broadway comedy as a parable of gay growth, Allen has illuminted ^([sic]) the original style and given us something new that is both fresh and funny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "063df748-92c1-42fb-a7ca-e5b13cdc0a41",
                        "source_entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                        "source_sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
