                "senses": [
                    {
                        "sense_id": "c8e8072c-c9da-3ec5-8067-caa3c7a1272f",
                        "entry_id": "680a0b9b-1f24-3f9f-9343-0d29b2942669",
                        "glosses": [
                            "schrikachtig, bangelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72f5bd0-81d4-4166-95d3-2017ce522f18",
                                "sense_id": "c8e8072c-c9da-3ec5-8067-caa3c7a1272f",
                                "text": "Er viel een angstvallige stilte."
                            },
                            {
                                "example_id": "b8128a2a-88e7-4ac0-978a-8cc631303035",
                                "sense_id": "c8e8072c-c9da-3ec5-8067-caa3c7a1272f",
                                "text": "Ze was op haar tenen langs een bobbelig rotsblok in het moeras gelopen, omdat hij had gefluisterd dat het een slapende trol was; ze had een pluk schapenvacht aan prikkeldraad angstvallig laten zitten, omdat hij zei dat het de baard was van een kabouter die hem terug wilde hebben; ze had tijdens de zonnewende een spoor van broodkruimels in het bos gestrooid, omdat hij haar had wijsgemaakt dat de bomen op de langste dag van het jaar aan de wandel gingen en ze zonder die kruimels de weg terug niet konden vinden."
                            },
                            {
                                "example_id": "57d5f15b-a932-4f54-b10c-5a2d48f6b4a4",
                                "sense_id": "c8e8072c-c9da-3ec5-8067-caa3c7a1272f",
                                "text": "Maar deze keer bleef het stil nadat hij zijn vraag had gesteld, angstvallig stil."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e2f2311-f0c4-3a3e-8068-93ebbfc7648b",
                        "entry_id": "680a0b9b-1f24-3f9f-9343-0d29b2942669",
                        "glosses": [
                            "zorgvuldig tot in kleinigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5dbee1-2c09-45e4-9d12-d18d809b4038",
                                "sense_id": "5e2f2311-f0c4-3a3e-8068-93ebbfc7648b",
                                "text": "Hij is een angstvallig persoon."
                            },
                            {
                                "example_id": "42e0a008-e5df-4beb-8f8d-7c8f4bb96d34",
                                "sense_id": "5e2f2311-f0c4-3a3e-8068-93ebbfc7648b",
                                "text": "dat hij tijdens een en dezelfde trip iemand dumpt én iemand ontvoert?' Starling vermeed angstvallig het verboden woord veronderstellen."
                            },
                            {
                                "example_id": "121f6ca0-5d39-4a6f-857d-601d805bb58d",
                                "sense_id": "5e2f2311-f0c4-3a3e-8068-93ebbfc7648b",
                                "text": "In de sombere jaren die volgden mochten deze bakkers geen enkel onverkocht brood mee terugnemen, want brood was zo kostbaar dat de autoriteiten elk brood dat de hoofdstad binnenkwam angstvallig vasthielden."
                            }
                        ]
                    }
                ],
