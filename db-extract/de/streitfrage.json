                        "examples": [
                            {
                                "example_id": "2c1b0d5d-5b09-4b6b-8755-5e720bb97ad3",
                                "sense_id": "b8c7faa1-9e1d-3754-bda3-fe9bdbf345af",
                                "text": "„Streitfragen handeln die Patriarchen untereinander aus.“"
                            },
                            {
                                "example_id": "37bb1fda-f156-4d4f-9caf-6cee8175603c",
                                "sense_id": "b8c7faa1-9e1d-3754-bda3-fe9bdbf345af",
                                "text": "„Streitfragen entschied der Rabbi, und einer der Rabbis in Kosliw war Roths Urgroßvater Akiva, der auch ein großer Geschichtenerzähler war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
