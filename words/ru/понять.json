{
    "word_family": [
        "понимание",
        "понятие",
        "понятливый",
        "понятный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ebf21ab-cc47-3e7e-894b-1ef60dd98e70",
                    "sense_definition": "Осознать смысл чего-либо, уловить суть информации или ситуации.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я сразу <w>понял</w>, что он хотел сказать.",
                            "target_lang_translations": {
                                "pl": "Od razu <w>zrozumiałem</w>, co chciał powiedzieć.",
                                "en": "I immediately <w>understood</w> what he wanted to say."
                            }
                        },
                        {
                            "text": "Ты <w>понял</w> правила этой игры?",
                            "target_lang_translations": {
                                "pl": "<w>Zrozumiałeś</w> zasady tej gry?",
                                "en": "Did you <w>understand</w> the rules of this game?"
                            }
                        }
                    ],
                    "synonyms": [
                        "усвоить",
                        "осознать"
                    ],
                    "common_phrases": [
                        "понять суть",
                        "понять смысл"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uświadomić sobie sens czegoś, pojąć istotę informacji lub sytuacji.",
                        "en": "To realize or grasp the meaning of something; to comprehend the essence of information or a situation."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrozumieć",
                                "target_lang_sense_clarification": "pojąć sens wypowiedzi lub sytuacji"
                            },
                            {
                                "target_lang_word": "pojąć",
                                "target_lang_sense_clarification": "ogarnąć umysłem, przyswoić znaczenie"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to comprehend the meaning or idea"
                            },
                            {
                                "target_lang_word": "grasp",
                                "target_lang_sense_clarification": "to comprehend or get the essence of something"
                            },
                            {
                                "target_lang_word": "comprehend",
                                "target_lang_sense_clarification": "to understand something fully"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca107d6a-12c9-3c9b-bce7-6c3ec5838277",
                    "sense_definition": "Осознать важность или истинное значение чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он наконец <w>понял</w>, как сильно его любят близкие.",
                            "target_lang_translations": {
                                "pl": "W końcu <w>zrozumiał</w>, jak bardzo kochają go bliscy.",
                                "en": "He finally <w>realized</w> how much his loved ones cared for him."
                            }
                        },
                        {
                            "text": "Важно <w>понять</w> всю серьёзность этой проблемы.",
                            "target_lang_translations": {
                                "pl": "Ważne jest, aby <w>zrozumieć</w> całą powagę tego problemu.",
                                "en": "It is important to <w>understand</w> the full seriousness of this problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "осознать"
                    ],
                    "common_phrases": [
                        "понять важность"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zdać sobie sprawę z wagi lub prawdziwego znaczenia czegoś.",
                        "en": "To become conscious of the importance, gravity, or true meaning of something."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrozumieć",
                                "target_lang_sense_clarification": "zdać sobie sprawę z wagi czegoś"
                            },
                            {
                                "target_lang_word": "uświadomić sobie",
                                "target_lang_sense_clarification": "zdać sobie sprawę, dotrzeć do kogoś"
                            },
                            {
                                "target_lang_word": "pojąć",
                                "target_lang_sense_clarification": "dostrzec powagę lub wagę sytuacji"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "realize",
                                "target_lang_sense_clarification": "to become fully aware of a fact or significance"
                            },
                            {
                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to appreciate the significance or reality of something"
                            },
                            {
                                "target_lang_word": "see",
                                "target_lang_sense_clarification": "to recognize or perceive the truth/importance of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70999fe3-7555-3a15-bce3-25d207d64a89",
                    "sense_definition": "Разобрать и осознать содержание речи или текста на иностранном языке.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я долго учил язык, чтобы <w>понять</w> этот фильм без субтитров.",
                            "target_lang_translations": {
                                "pl": "Długo uczyłem się języka, żeby <w>zrozumieć</w> ten film bez napisów.",
                                "en": "I studied the language for a long time in order to <w>understand</w> this movie without subtitles."
                            }
                        },
                        {
                            "text": "Иностранец с трудом <w>понял</w> мой вопрос на улице.",
                            "target_lang_translations": {
                                "pl": "Cudzoziemiec z trudem <w>zrozumiał</w> moje pytanie na ulicy.",
                                "en": "The foreigner could barely <w>make out</w> my question on the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "разобрать"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozszyfrować i pojąć treść mowy lub tekstu w języku obcym.",
                        "en": "To decipher, make out, and comprehend speech or text in a foreign language."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrozumieć",
                                "target_lang_sense_clarification": "odebrać ze zrozumieniem mowę lub tekst w języku obcym"
                            },
                            {
                                "target_lang_word": "pojąć",
                                "target_lang_sense_clarification": "uchwycić treść wypowiedzi"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to comprehend foreign speech or text"
                            },
                            {
                                "target_lang_word": "make out",
                                "target_lang_sense_clarification": "to decipher or decipher words with difficulty"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}