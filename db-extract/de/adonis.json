                        ],
                        "examples": [
                            {
                                "example_id": "85165fc5-9d20-4ce9-b1ec-57b68b731013",
                                "sense_id": "6bcbd44c-da87-38d6-b42a-b870a19d867a",
                                "text": "Mein neuer Nachbar ist ein echter Adonis."
                            },
                            {
                                "example_id": "614278ea-faa7-4c9e-be16-090806e5dea2",
                                "sense_id": "6bcbd44c-da87-38d6-b42a-b870a19d867a",
                                "text": "Susis Freund ist ja nicht gerade ein Adonis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e086a1db-3095-4f8a-a493-ca38383de418",
                        "source_entry_id": "2883d338-6d24-3407-8f53-9829c91c808f",
                        "source_sense_id": "6bcbd44c-da87-38d6-b42a-b870a19d867a",
                        "source_sense_description": "gehoben: schöner, junger Mann",
                        "target_lang_word": "adonis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adonis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb69c6a-e206-3dfb-ab11-e660c0409baf",
                                        "entry_id": "36773604-274c-3beb-91e2-05d692b363d8",
                                        "glosses": [
                                            "Jeune très beau, bel homme, bel éphèbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d44205-f200-4d5f-a9aa-30c62b380131",
                                                "sense_id": "3eb69c6a-e206-3dfb-ab11-e660c0409baf",
                                                "text": "Et puis qu’est-ce que deviendrait la repopulation, s’il fallait condamner au célibat tous ceux qui ne sont pas des adonis."
                                            },
                                            {
                                                "example_id": "e9fbf29d-5313-4fea-b7bd-00a1450c84f1",
                                                "sense_id": "3eb69c6a-e206-3dfb-ab11-e660c0409baf",
                                                "text": "Sans être un adonis, c’était un garçon au-dessus de la trentaine, avec les cheveux et les dents de son âge, avec de bonnes épaules dans un bon veston et assez de figure pour satisfaire son monde."
                                            },
                                            {
                                                "example_id": "ee62dd48-8204-428b-b27c-5901274e364f",
                                                "sense_id": "3eb69c6a-e206-3dfb-ab11-e660c0409baf",
                                                "text": "Son corps n'est plus tellement d'un éphèbe. Il a beau ne vivre qu'à l'ombre pour conserver sa peau blanche laiteuse, il commence à n'être plus un Adonis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00f1163b-7869-3fff-a683-cd5ac5189ac2",
                                        "entry_id": "36773604-274c-3beb-91e2-05d692b363d8",
                                        "glosses": [
                                            "Synonyme de adonide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18d7cfe0-ddff-4a77-85d6-efc1c4e8c977",
                                                "sense_id": "00f1163b-7869-3fff-a683-cd5ac5189ac2",
                                                "text": "Plus dangereux, l’adonis d’été (Adonis aestivalis) est une petite plante annuelle aux feuilles découpées en fines lanières, caractérisée par une belle floraison rouge vif."
                                            },
                                            {
                                                "example_id": "d2b6fd22-79d8-4553-bcc6-c2d9c902b00a",
                                                "sense_id": "00f1163b-7869-3fff-a683-cd5ac5189ac2",
                                                "text": "Bien sûr, il n’attendait pas un miracle de cette longue feuille rugueuse couverte d’un duvet blanchâtre, mais il eut soudain une envie désespérée de chercher, dans cette prairie aux couleurs chatoyantes et aux odeurs capiteuses, les plantes médicinales dont le nom lui revenait à la mémoire : l’aconit, la belladone, l’ergot de seigle, la stramoine, la jusquiame, le colchique, la digitale, l’adonis, le sénevé, le raisin d’ours, la gentiane, le muguet, la saponaire, la prêle, la potentille, la quintefeuille, le tussilage, le millepertuis, le genévrier, la mille-feuille, l’orchidée, l’aunée, le mélilot et la myrtille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1feea8b-6c17-3426-95bd-3ae1b5db53ef",
                                        "entry_id": "36773604-274c-3beb-91e2-05d692b363d8",
                                        "glosses": [
                                            "Synonyme de azuré bleu céleste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
