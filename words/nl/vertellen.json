                },
                {
                    "sense_id": "60ecb057-dfea-3a57-beda-5ab76e5ea3df",
                    "sense_definition": "een fout maken bij het tellen van een aantal",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen kan zich <w>vertellen</w> als er veel lawaai in de kamer is.",
                            "target_lang_translations": {
                                "en": "Anyone can <w>miscount</w> if there is a lot of noise in the room.",
                                "ru": "Любой может <w>обсчитаться</w>, если в комнате много шума."
                            }
                        },
                        {
                            "text": "Ik moet de munten opnieuw tellen omdat ik me <w>verteld</w> heb.",
                            "target_lang_translations": {
                                "en": "I have to count the coins again because I <w>miscounted</w>.",
                                "ru": "Мне нужно пересчитать монеты заново, потому что я <w>обсчитался</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich vertellen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "wederkerig werkwoord (zich vertellen)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make a mistake while counting a number of items.",
                        "ru": "допустить ошибку при подсчете количества чего-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miscount",
                                "target_lang_sense_clarification": "to count incorrectly"
                            },
                            {
                                "target_lang_word": "lose count",
                                "target_lang_sense_clarification": "to forget where one is in a sequence"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обсчитаться",
                                "target_lang_sense_clarification": "ошибиться при счете"
                            },
                            {
                                "target_lang_word": "сбиться со счета",
