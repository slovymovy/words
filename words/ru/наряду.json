                    "sense_id": "5918d25d-e3bf-3e2c-828e-9c3b64c5af69",
                    "sense_definition": "Наравне, на одинаковых правах или условиях.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Женщины на заводе работали <w>наряду</w> с мужчинами.",
                            "target_lang_translations": {
                                "en": "Women at the factory worked <w>alongside</w> men.",
                                "de": "Die Frauen im Werk arbeiteten <w>ebenso wie</w> die Männer."
                            }
                        },
                        {
                            "text": "Этот вопрос обсуждался <w>наряду</w> с другими важными проблемами.",
                            "target_lang_translations": {
                                "en": "This issue was discussed <w>along with</w> other important problems.",
                                "de": "Diese Frage wurde <w>neben</w> anderen wichtigen Problemen diskutiert."
                            }
                        }
                    ],
                    "synonyms": [
                        "наравне"
                    ],
                    "common_phrases": [
                        "наряду с другими",
                        "наряду со всеми"
                    ],
                    "target_lang_definitions": {
                        "en": "Equally, on equal rights or conditions.",
                        "de": "Gleichberechtigt, unter gleichen Bedingungen oder auf gleicher Stufe."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alongside",
                                "target_lang_sense_clarification": "on equal footing with"
                            },
                            {
                                "target_lang_word": "equally with",
                                "target_lang_sense_clarification": "indicating equality"
                            },
                            {
                                "target_lang_word": "on a level with",
                                "target_lang_sense_clarification": "at the same rank or standard"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ebenso wie",
                                "target_lang_sense_clarification": "drückt Gleichheit aus"
                            },
                            {
                                "target_lang_word": "gleichberechtigt neben",
                                "target_lang_sense_clarification": "auf gleicher Stufe stehend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "395540d1-3078-39bb-a050-67b8c3172bad",
                    "sense_definition": "Вместе с кем-либо или чем-либо, одновременно с чем-либо.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Наряду</w> с трамваем мы часто пользуемся автобусом.",
                            "target_lang_translations": {
                                "en": "<w>Along with</w> the tram, we often use the bus.",
                                "de": "<w>Neben</w> der Straßenbahn nutzen wir oft den Bus."
                            }
                        },
                        {
                            "text": "В музее <w>наряду</w> с картинами выставлены редкие скульптуры.",
                            "target_lang_translations": {
                                "en": "In the museum, <w>alongside</w> paintings, rare sculptures are exhibited.",
                                "de": "Im Museum sind <w>neben</w> Gemälden auch seltene Skulpturen ausgestellt."
                            }
                        }
                    ],
                    "synonyms": [
