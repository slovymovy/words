                        "sense_id": "ddbd53c8-eebb-372d-8050-136c9eaa9d42",
                        "entry_id": "5874e7f5-b561-3653-a45d-55ea90c5b5fb",
                        "glosses": [
                            "een wapen dat zeer velen doodt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7751bd-7d85-4f5c-84d2-8f7f46f2c209",
                                "sense_id": "ddbd53c8-eebb-372d-8050-136c9eaa9d42",
                                "text": "Irak werd beschuldigd, schuldig verklaard en gestraft voor het wederrechtelijk bezitten van massavernietigingswapens (hoewel later bleek dat het daar niet over beschikte)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4498faa7-13ad-491b-9ad3-39b46621ea85",
                        "source_entry_id": "5874e7f5-b561-3653-a45d-55ea90c5b5fb",
                        "source_sense_id": "ddbd53c8-eebb-372d-8050-136c9eaa9d42",
                        "source_sense_description": "een wapen dat zeer velen doodt",
                        "target_lang_word": "Massenvernichtungswaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massenvernichtungswaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06ad6f27-989f-38ce-98dc-1b580fbb7578",
                                        "entry_id": "bafd2838-4adc-3a34-b211-f8d5a0f3b04e",
                                        "glosses": [
                                            "Waffe, die besonders gravierende und dauerhafte Schäden für große Teile der Bevölkerung zur Folge hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a52217d5-75f0-4835-85ba-bb346f04d259",
                                                "sense_id": "06ad6f27-989f-38ce-98dc-1b580fbb7578",
                                                "text": "„Die Tendenz hin zu einem allgemeinen Gewaltverbot des modernen Völkerrechts einerseits und das Aufkommen von Massenvernichtungswaffen (deren Zerstörungspotenzial jegliches Legitimationsargument desavouiert) andererseits haben die Lehre vom gerechten Krieg nachhaltig relativiert.“"
                                            },
                                            {
                                                "example_id": "7ccb42ce-467a-4c3a-b544-6a410fdc733a",
                                                "sense_id": "06ad6f27-989f-38ce-98dc-1b580fbb7578",
                                                "text": "„Ein CIA-Spion, der schon zwanzig Jahre dabei war, hatte mitgeholfen, die Verbreitung von Massenvernichtungswaffen zu verhindern.“"
                                            },
                                            {
                                                "example_id": "d3efa5b2-daf7-4e71-b3ac-24a0f9ae0917",
                                                "sense_id": "06ad6f27-989f-38ce-98dc-1b580fbb7578",
                                                "text": "„Deshalb wurden die ehemaligen Produzenten von Massenvernichtungswaffen zu Handlangern der Massenunterhaltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c09232-b3a6-4f3d-b841-7bc9d99c5bb9",
                        "source_entry_id": "5874e7f5-b561-3653-a45d-55ea90c5b5fb",
