                "senses": [
                    {
                        "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                        "entry_id": "7179ef20-44dd-3321-8bc9-ab6e956749ca",
                        "glosses": [
                            "Vorgang des Bespannens eines Schlägers; Art und Weise, wie dieser Schläger bespannt wurde"
                        ],
                        "tags": [
                            "Tennis",
                            "Badminton",
                            "Squash"
                        ],
                        "examples": [
                            {
                                "example_id": "b772113f-4d1f-449a-8ba7-1a0bc23d6c27",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "[Tennisschläger 2024:] Der Preis für eine Besaitung liegt zwischen EUR 25 und EUR 59, je nach Art der Saite."
                            },
                            {
                                "example_id": "7742ec89-9f8f-46fe-be66-07c38f1b8de0",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "[Tennisschläger:] „Die Besaitung eines Schlägers dauert etwa 20 Minuten.“"
                            },
                            {
                                "example_id": "79281fa0-6bfc-4930-a14e-2a6c37d28b36",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "Erst mit der richtigen Besaitung wirst du als Spieler erfolgreich sein."
                            },
                            {
                                "example_id": "8b41f73f-688b-460f-9b3e-0f4e6b8f0af6",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "[Tennisschläger:] Die Profis auf der Tour lassen nach jedem Training und nach jedem Spiel die Besaitung erneuern."
                            },
                            {
                                "example_id": "76034412-ef34-4825-82dd-0e0c1b025bed",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "„Mit Besaitung wiegt ein Tennisschläger zwischen 280 und 350 g.“"
                            },
                            {
                                "example_id": "8ab393a5-a228-4adf-8c5d-c54ebf897f00",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "[Tennisschläger:] „Da jede Bespannung aus einer Längs- und einer Quersaite besteht, kann man auch unterschiedliche Saitentypen in einer Besaitung kombinieren“ […]."
                            },
                            {
                                "example_id": "d21d06b3-8669-4010-8a91-d82f60dbb638",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "[Tennisschläger:] „Armschonung / Komfort – […] Hier empfiehlt sich eine weichere, elastischere Besaitung, um den Schock zu dämpfen.“"
                            },
                            {
                                "example_id": "810b8a45-dbd4-437d-92e1-f080653c58fe",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "[Badmintonschläger:] „Die Besaitung des Schlägers muss eben und einheitlich sein und aus einem Muster von sich kreuzenden Saiten bestehen.“"
                            },
                            {
                                "example_id": "0711abf9-e0fe-4ee2-a6ff-e26c1918a3a3",
                                "sense_id": "765de900-cd65-31db-9132-0693e91f659a",
                                "text": "[Badmintonschläger:] „Die Besaitung darf 280 mm in der gesamten Länge und 220 mm in der gesamten Breite nicht überschreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                        "entry_id": "7179ef20-44dd-3321-8bc9-ab6e956749ca",
                        "glosses": [
                            "Vorgang des Bespannens eines Saiteninstruments (beispielsweise einer Geige, eines Cellos); Art und Weise, wie dieses Instrument bespannt wurde"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f7f6887d-a2ca-4ddf-a6ef-a1e25c847c61",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "„Für die Konzertzither gibt es bis heute zwei weit verbreitete Besaitungen, die sich sowohl in der Stimmung der Griffbrettsaiten, als auch in der Stimmung der Freisaiten (früher „Begleit“- oder „Akkordsaiten“, „Bass“- und „Kontrasaiten“) unterscheiden:“ […]."
                            },
                            {
                                "example_id": "8c94504a-25da-474e-91cc-a8e540293725",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "[Zither:] „Die Wiener Besaitung wird heutzutage nur noch selten verwendet, meist für traditionelle Interpretationen der Wiener Salon- und der Schrammelmusik.“"
                            },
                            {
                                "example_id": "49d66afb-564c-4098-b2d4-027c4039aa78",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "„Da Gamben jedoch zu keiner Zeit „genormt“ waren, hängt die richtige Besaitung von mehreren Faktoren ab, von der Bauweise, von der Lage des Wolftons und von der Stimmung.“"
                            },
                            {
                                "example_id": "ef224f73-aa81-4509-a6bf-7feaeb58f056",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "„Die Spanier entwickelten aus der Laute die Vihuela, welche die gleiche Besaitung, aber einen flachen Körper hat.“"
                            },
                            {
                                "example_id": "f6d5c08a-c521-4980-b208-8346b763777f",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "[Während des Barock] „änderte sich die Besaitung der Gitarre ständig, da nun die Melodie, als tragendes Element, in den Vordergrund trat und viel experimentiert wurde.“"
                            },
                            {
                                "example_id": "89dbbf6b-c365-4f50-9b61-a038b0323bce",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "„Von 1780 stammt ein Hammerflügel des Augsburger Klavierbauers Johann Andreas Stein, der durch seine spezielle Besaitung ohne Pedal ein lautes und leises Spiel ermöglichte.“"
                            },
                            {
                                "example_id": "4c6f9428-0dc0-42de-9ba5-70d1a16f81f2",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "„Die dicken Saiten der Gusle setzen sich aus bis zu 30 Rosshaaren zusammen, einem relativ ungewöhnlichen Material für die Besaitung eines Instruments.“"
                            },
                            {
                                "example_id": "655fc705-609b-425b-b677-3a87c3c7bc4e",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "„Gleichmäßiges Licht von allen Seiten ist wichtig beim Geigenbau. Jede Kante, jede Rundung, auch die Besaitung spielt eine Rolle. Der Lack, und natürlich das Holz.“"
                            },
                            {
                                "example_id": "11a7c9b2-98da-4ac7-9571-c301f8e3a8f7",
                                "sense_id": "48a45e47-1ccd-3ddd-aed8-30b2982285f0",
                                "text": "„Nach neuer Besaitung und wochenlanger Einspielzeit war es endlich soweit: das neugegründete Geigentrio Ruth-Maria Ostermann, Judith Altmann und Andreas Mittler hat die Domholzgeigen in der Öffentlichkeit wieder zum Klingen gebracht“ […]."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
