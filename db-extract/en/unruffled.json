                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7c53a3-755c-452a-9e29-d45fcb41de8c",
                                                "sense_id": "e3ae42d8-6614-37c6-97b7-c4270d16db6f",
                                                "text": "Die Oma hatte eine Haut so glatt wie mit zwanzig."
                                            },
                                            {
                                                "example_id": "607c9c72-18d1-4dce-a3f0-bae925da62a3",
                                                "sense_id": "e3ae42d8-6614-37c6-97b7-c4270d16db6f",
                                                "text": "Nach dem Schleifen und Polieren war der Stahl am glattesten; jetzt hat er schon wieder kleine Unebenheiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e8d3ebb-80d2-3489-ab93-480bf0541e4d",
                                        "entry_id": "77099b90-6b3d-3463-89d5-cc627f056056",
                                        "glosses": [
                                            "rutschig (aber nicht schmierig), zum Beispiel durch Eis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f833ed-b99e-41c3-963f-d9b0b261daab",
                                                "sense_id": "8e8d3ebb-80d2-3489-ab93-480bf0541e4d",
                                                "text": "Sei vorsichtig, die Straße ist glatt!"
                                            },
                                            {
                                                "example_id": "05366e2c-0dfd-451c-b6db-5887326364db",
                                                "sense_id": "8e8d3ebb-80d2-3489-ab93-480bf0541e4d",
                                                "text": "Nach dem Eisregen ist die Straße noch viel glatter als nach dem Schneefall gestern."
                                            }
                                        ],
