                                            {
                                                "example_id": "337b0f7f-5447-4ec2-b8e7-131f1c600261",
                                                "sense_id": "98ffcb00-050d-33e5-8079-038e57ceb9d2",
                                                "text": "In den Printenteig kommt noch Kandiszucker."
                                            },
                                            {
                                                "example_id": "56547ce6-87bc-43bf-9d2f-666bb12821db",
                                                "sense_id": "98ffcb00-050d-33e5-8079-038e57ceb9d2",
                                                "text": "Bertram hat gern zwei Stück Kandiszucker in seinem Tee."
                                            },
                                            {
                                                "example_id": "2d48d5ee-42f2-4245-988a-d74c34350226",
                                                "sense_id": "98ffcb00-050d-33e5-8079-038e57ceb9d2",
                                                "text": "„In der linken Hand hielt er die Apfelsine, in der anderen ein Stück Kandiszucker, das der Doktor ihm freundlicherweise geschenkt hatte.“"
                                            },
                                            {
                                                "example_id": "edb346d2-f29b-443f-923f-054da388941a",
                                                "sense_id": "98ffcb00-050d-33e5-8079-038e57ceb9d2",
                                                "text": "„Er gab ihm dafür aus dem Süßigkeitsbehälter einige Stückchen Kandiszucker, der von Geschenken herrührte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
