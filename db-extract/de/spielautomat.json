                                "target_senses": [
                                    {
                                        "sense_id": "21442611-99e0-3fcb-a1e2-ef5faf12ccd6",
                                        "entry_id": "eb3d6c61-8c51-3d53-8a12-c01543310472",
                                        "glosses": [
                                            "Jeu de hasard que l’on trouve dans les casinos où l’on tire sur un manche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d7c5f8-ba40-4055-bd3f-f9d0d3a8bd95",
                                                "sense_id": "21442611-99e0-3fcb-a1e2-ef5faf12ccd6",
                                                "text": "A l’époque, on surnommait les machines à sous “one armed bandit” (bandit manchot), car elles volaient les gens sans ambages et ne possédaient qu’un levier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6e6fce2-e2a3-39dc-887b-93cec78cd964",
                                        "entry_id": "eb3d6c61-8c51-3d53-8a12-c01543310472",
                                        "glosses": [
                                            "Problème mathématique où un utilisateur se trouve face à plusieurs machines à sous et doit décider lesquelles jouer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4701191d-5695-410a-b188-28ac11d9df9f",
                                                "sense_id": "b6e6fce2-e2a3-39dc-887b-93cec78cd964",
                                                "text": "On dispose de n « bandits manchots », quelle est la meilleure stratégie d’exploration pour maximiser le gain ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
