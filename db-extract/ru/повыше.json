                "entry_id": "7d2e8c1d-d72e-3c14-9e98-017cceda75cd",
                "word": "повыше",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d10c6cb-1b7c-306f-81e2-f4c5090e15f3",
                        "entry_id": "7d2e8c1d-d72e-3c14-9e98-017cceda75cd",
                        "glosses": [
                            "немного более высокий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e85ccb-2a37-4613-beee-5f3c954f1c88",
                                "sense_id": "1d10c6cb-1b7c-306f-81e2-f4c5090e15f3",
                                "text": "А один у них, дошлый парень, Алик Рогов, ростом повыше меня и сложения подходящего, особенно ловко сдувает пыль детской резиновой клизмочкой."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c364b95-1713-3ad6-b61b-d486fe8702bb",
                        "entry_id": "7d2e8c1d-d72e-3c14-9e98-017cceda75cd",
                        "glosses": [
                            "немного более высоко"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79f239e-ec13-4c0a-9b80-a64b934fba53",
                                "sense_id": "5c364b95-1713-3ad6-b61b-d486fe8702bb",
                                "text": "Наконец часов через пять они преодолели самое, казалось, крутое на склоне место, вкатили камень повыше."
                            }
                        ]
                    }
                ],
