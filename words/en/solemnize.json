{
    "word_family": [
        "solemn",
        "solemnity",
        "solemnly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46a27840-79ac-3b93-94ea-d7b987fec7e3",
                    "sense_definition": "To make official or formal through a ceremony or legal act.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple decided to <w>solemnize</w> their marriage in a traditional church ceremony.",
                            "target_lang_translations": {
                                "pl": "Para zdecydowała się <w>zawrzeć</w> małżeństwo podczas tradycyjnej ceremonii kościelnej."
                            }
                        },
                        {
                            "text": "The judge was invited to <w>solemnize</w> the union of the two families.",
                            "target_lang_translations": {
                                "pl": "Sędzia został zaproszony, aby <w>dopełnić formalności</w> związanych z połączeniem dwóch rodzin."
                            }
                        }
                    ],
                    "synonyms": [
                        "formalize",
                        "celebrate",
                        "sanctify"
                    ],
                    "common_phrases": [
                        "solemnize a marriage"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uczynić coś oficjalnym lub formalnym poprzez ceremonię lub akt prawny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zawrzeć",
                                "target_lang_sense_clarification": "w kontekście małżeństwa lub umowy"
                            },
                            {
                                "target_lang_word": "dopełnić formalności",
                                "target_lang_sense_clarification": "w kontekście prawnym lub religijnym"
                            },
                            {
                                "target_lang_word": "uświęcić",
                                "target_lang_sense_clarification": "w kontekście religijnym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd833077-10b0-37bc-b88e-64bfbaec1dfe",
                    "sense_definition": "To make someone or something appear grave, serious, or reverential.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet beauty of the cathedral <w>solemnized</w> the mood of the visitors.",
                            "target_lang_translations": {
                                "pl": "Ciche piękno katedry <w>nadało powagi</w> nastrojowi zwiedzających."
                            }
                        },
                        {
                            "text": "The tragic news <w>solemnized</w> his usually cheerful expression.",
                            "target_lang_translations": {
                                "pl": "Tragiczne wieści sprawiły, że jego zazwyczaj pogodny wyraz twarzy <w>spoważniał</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sober",
                        "gravify"
                    ],
                    "antonyms": [
                        "lighten"
                    ],
                    "target_lang_definitions": {
                        "pl": "Sprawić, że ktoś lub coś staje się poważne, uroczyste lub pełne szacunku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spoważnieć",
                                "target_lang_sense_clarification": "w odniesieniu do nastroju lub wyrazu twarzy"
                            },
                            {
                                "target_lang_word": "nadać powagi",
                                "target_lang_sense_clarification": "w odniesieniu do atmosfery lub sytuacji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}