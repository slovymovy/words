                    "frequency": "Middle",
                    "semantic_group_id": "Veroeffentlichung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zum <w>Release</w> ihres neuen Albums gab die Rockband ein exklusives Konzert in Berlin."
                        },
                        {
                            "text": "Viele Fans warteten monatelang ungeduldig auf das weltweite <w>Release</w> der neuen Single."
