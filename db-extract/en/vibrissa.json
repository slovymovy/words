                        "entry_id": "66215d42-9603-3f83-9fda-d753e9910d7f",
                        "glosses": [
                            "Any of the tactile whiskers on the nose of an animal such as a cat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d123bab-fe74-4840-a65a-065e27d21677",
                                "sense_id": "6e74ea97-172c-3674-9e68-f70fae5e064e",
                                "text": "There are also long hairs inside each ear and sometimes on its tip, and about a dozen very long and strong hairs—the whiskers or vibrissæ— are placed on each upper lip."
                            }
                        ]
                    },
                    {
                        "sense_id": "9aec0e93-4c7a-3238-880a-14b4ff638c75",
                        "entry_id": "66215d42-9603-3f83-9fda-d753e9910d7f",
                        "glosses": [
                            "Any similar feather near the mouth of some birds."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1b7fd6f6-220f-3b1d-bc13-ed76d88afc25",
                        "entry_id": "66215d42-9603-3f83-9fda-d753e9910d7f",
                        "glosses": [
                            "The thick hairs found inside the nostrils of humans and other mammals."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "339497e4-90a8-4c0e-81f6-62fbde2c079a",
                                "sense_id": "1b7fd6f6-220f-3b1d-bc13-ed76d88afc25",
                                "text": "The vibrissae are coarse hairs whose follicles are located just within the nasal meatus. […] Vibrissae are present in most mammals, but their innervation and role in sensory function appears to be less pronounced in humans."
                            }
                        ]
                    }
