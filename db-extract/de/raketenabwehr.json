                "senses": [
                    {
                        "sense_id": "9d844353-7a4c-3b9e-a27a-07b09184b11f",
                        "entry_id": "8e9f4b42-434e-32a2-b37e-b5b96a561f97",
                        "glosses": [
                            "Maßnahmen zur Abwehr anfliegender, feindlicher Raketen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6d851b-fcab-438e-a139-0eb840fc70df",
                                "sense_id": "9d844353-7a4c-3b9e-a27a-07b09184b11f",
                                "text": "„Zum einen wird dabei der vordere Teil der Kabine mit einem Schlafzimmer für die Politiker, Besprechungsräumen und einem Abteil für abhörsichere Kommunikation ausgestattet, zudem erhalten die Jets ein System zur Raketenabwehr.“"
                            },
                            {
                                "example_id": "37bc9de9-e7a9-4101-b0db-3d2a9688c9fd",
                                "sense_id": "9d844353-7a4c-3b9e-a27a-07b09184b11f",
                                "text": "Der russische Vizeaußenminister Sergej Ryabkow warf der neuen US-Regierung von Barack Obama vor, dieses Projekt noch immer nicht aufgegeben zu haben: „Im Gegenteil, wir sehen, dass die Arbeiten an der Raketenabwehr sogar wieder intensiviert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
