                "senses": [
                    {
                        "sense_id": "b48e68ec-2513-3f0d-aa3c-3e60cd74c154",
                        "entry_id": "7911623c-1c29-329a-9c49-d737f65eefa8",
                        "glosses": [
                            "Bereich eines ökonomischen Marktes, der mit Geld zu tun hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e98eff-e153-4ff6-b135-f8c6bfed5221",
                                "sense_id": "b48e68ec-2513-3f0d-aa3c-3e60cd74c154",
                                "text": "„Auch im Geldsektor haben sich mehrere Raiffeisenkassen gebietsmäßig zusammengeschlossen, um auf diese Art die Mitglieder besser bedienen zu können.“"
                            },
                            {
                                "example_id": "46237531-6867-4a0c-b044-f36f1b53a8fa",
                                "sense_id": "b48e68ec-2513-3f0d-aa3c-3e60cd74c154",
                                "text": "„Das finanzielle Fundament der verschiedenen Tätigkeiten im Handels- und Geldsektor ist der Besitz an Grund und Boden.“"
                            },
                            {
                                "example_id": "cb63b00f-7f64-42c9-ad55-cd025792fcaf",
                                "sense_id": "b48e68ec-2513-3f0d-aa3c-3e60cd74c154",
                                "text": "„Dennoch gab es deutliche Anzeichen der Besserung sowohl auf dem Geldsektor als auch auf anderen Wirtschaftsgebieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
