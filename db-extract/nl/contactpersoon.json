                    },
                    {
                        "translation_id": "d8e8f50d-39f9-442c-aecd-3f5a692649c2",
                        "source_entry_id": "604ff05e-e827-3c13-8f13-25bb17584c54",
                        "source_sense_id": "ecce6881-0d00-3975-96f7-fdf63c5ec9be",
                        "target_lang_word": "intermédiaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intermédiaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5827767-8a4a-37d2-9228-acdfad63b7bf",
                                        "entry_id": "cc68241d-9d77-3dd9-92e7-248edd771251",
                                        "glosses": [
                                            "Ce qui est entre deux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e818f880-cafd-43c1-a0b5-c94d6dc7f546",
                                                "sense_id": "a5827767-8a4a-37d2-9228-acdfad63b7bf",
                                                "text": "Passer brusquement d’une idée à une autre sans intermédiaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7877850f-65b0-3be2-a645-e3183591e3e2",
                                        "entry_id": "cc68241d-9d77-3dd9-92e7-248edd771251",
                                        "glosses": [
                                            "Celui qui passe une chose d'un endroit vers un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae88f7e-7149-4aa1-b9ac-618ef441d227",
                                                "sense_id": "7877850f-65b0-3be2-a645-e3183591e3e2",
                                                "text": "En proposant le passage, incessant, d'un discours ordinaire au champ de la science, en devenant un « agitateur de mots », le vulgarisateur se donne un joli rôle : celui de l’intermédiaire, du « passeur de mots »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "204d9a65-9eba-3355-87c8-16c82f95b07a",
                                        "entry_id": "cc68241d-9d77-3dd9-92e7-248edd771251",
                                        "glosses": [
                                            "Personne dont on se sert pour arriver à tel ou tel résultat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc010670-845e-4dc5-80bf-64c12a3191b0",
                                                "sense_id": "204d9a65-9eba-3355-87c8-16c82f95b07a",
                                                "text": "Je me suis procuré cela par l'intermédiaire d’un agent. - Il fut leur intermédiaire pour cette correspondance."
                                            },
                                            {
                                                "example_id": "68d4b132-ecb7-4d70-b728-b1e3937232ba",
                                                "sense_id": "204d9a65-9eba-3355-87c8-16c82f95b07a",
                                                "text": "Il achetait à sa femme, sous le nom d’un intermédiaire, sans paraître aucunement, la maison de la rue de la Pépinière(...)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b3c2b5a-7343-3429-a573-baadbe787f60",
                                        "entry_id": "cc68241d-9d77-3dd9-92e7-248edd771251",
                                        "glosses": [
                                            "Agent économique qui se trouve dans une filière de distribution de marchandises ou de services."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee00913-3865-4916-bcb4-9a059d891242",
                                                "sense_id": "7b3c2b5a-7343-3429-a573-baadbe787f60",
                                                "text": "Des intermédiaires parasites, des commerçants occasionnels, des spéculateurs sans vergogne, étrangers à toute production et à tout travail, ne s’emmillionnent-ils pas chaque jour sous nos yeux […] ?"
                                            },
                                            {
                                                "example_id": "3456296b-213f-41dc-93dc-77d1aabd60a2",
                                                "sense_id": "7b3c2b5a-7343-3429-a573-baadbe787f60",
                                                "text": "Entre le type qui se casse le cul et vend trois balles son kilo de tomates, pauvre cageot, et le clampin qui achète quinze balles chez le Champion du coin son kilo de matichas, il y a un mec, un intermédiaire, qui se fait 3x4 = 12, douze balles, grosso, sans se casser le tronc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intermédiaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab0c574-70c7-38e9-80c9-c7308aecbaea",
                                        "entry_id": "9579f6b6-25c5-3f7a-b371-2d850d365087",
                                        "glosses": [
                                            "Qui est entre deux, en parlant des choses."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5708e50a-827c-428c-aa70-d46a95f4970e",
                                                "sense_id": "2ab0c574-70c7-38e9-80c9-c7308aecbaea",
                                                "text": "Si le pouvoir cède à l’une, l’autre s’irrite, s’il croit devoir rester intermédiaire, alors elles semblent s’entendre toutes deux, votent unanimement contre lui, et l’accusent de marcher sans plan et sans système arrêté d’avance."
                                            },
                                            {
                                                "example_id": "1fe6e3cb-5211-4904-93a3-9012f439840f",
                                                "sense_id": "2ab0c574-70c7-38e9-80c9-c7308aecbaea",
                                                "text": "Les combats intermédiaires constituent un élément essentiel d’un récit excitant : chacun d’entre eux crée une mini-aventure dans l’épopée globale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02daeea-3ceb-31f0-a592-2a20b051f052",
                                        "entry_id": "9579f6b6-25c5-3f7a-b371-2d850d365087",
                                        "glosses": [
                                            "Qualifie des terrains placés entre les roches des époques primitives et les couches de formation récente."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
