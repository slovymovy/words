                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e2f83f3-2eb5-3111-9ee1-96f3d2830a1a",
                        "entry_id": "97b45484-31f1-335d-b87a-b2f144840b56",
                        "glosses": [
                            "in het normale geval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e968b9af-d3c1-4928-aa5c-0a1d8e18bb70",
                                "sense_id": "8e2f83f3-2eb5-3111-9ee1-96f3d2830a1a",
                                "text": "Welk merk tandpasta koopt u normaliter?"
                            },
                            {
                                "example_id": "5879c195-0d72-4ec4-a00d-1f6e60907e27",
                                "sense_id": "8e2f83f3-2eb5-3111-9ee1-96f3d2830a1a",
                                "text": "De mensen die normaliter niet naar het theater gaan, die niet hun favoriete toneelschrijvers kunnen opdreunen en niet de verschillende uitvoeringen van hetzelfde stuk kunnen vergelijken, ...."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a20bed92-fead-441e-bff8-967fd7d87642",
                        "source_entry_id": "97b45484-31f1-335d-b87a-b2f144840b56",
                        "source_sense_id": "8e2f83f3-2eb5-3111-9ee1-96f3d2830a1a",
                        "source_sense_description": "in het normale geval",
                        "target_lang_word": "normalerweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normalerweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2811c6da-9aed-3263-874a-c44984c60081",
                                        "entry_id": "0c407833-08fc-372a-ad56-d710e760226e",
                                        "glosses": [
                                            "unter normalen Umständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df60b279-4fe3-469c-9c62-5ca815c4f4bd",
                                                "sense_id": "2811c6da-9aed-3263-874a-c44984c60081",
                                                "text": "Normalerweise trägt Ursula kein Make-up."
                                            },
                                            {
                                                "example_id": "bae69f91-5491-4218-b946-00bf45ff4bb3",
                                                "sense_id": "2811c6da-9aed-3263-874a-c44984c60081",
                                                "text": "Gewalt lehne ich normalerweise ab, aber ein Überfall ist eine Ausnahmesituation."
                                            },
                                            {
                                                "example_id": "8b21da8c-25ea-4fcb-950e-de628527ad23",
                                                "sense_id": "2811c6da-9aed-3263-874a-c44984c60081",
                                                "text": "„Normalerweise schützt die Plazenta den Fötus vor dem Stresshormon Cortisol.“"
                                            },
                                            {
                                                "example_id": "3bbe8cc1-adc6-4c27-83bb-1caa88d65532",
                                                "sense_id": "2811c6da-9aed-3263-874a-c44984c60081",
                                                "text": "„Einen Heißluftballon erwarben französische Ballonfahrer für den Schnäppchenpreis von 6400 Euro - normalerweise kostet ein solches Fluggerät mehrere zehntausend Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35c60e85-d34a-4ffd-83bc-c55a1222815f",
                        "source_entry_id": "97b45484-31f1-335d-b87a-b2f144840b56",
                        "source_sense_id": "8e2f83f3-2eb5-3111-9ee1-96f3d2830a1a",
                        "source_sense_description": "in het normale geval",
                        "target_lang_word": "normally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b02faa76-9ade-3661-a4bb-0ad6f0c52286",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "Under normal conditions or circumstances; usually; most of the time"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e54816-de05-48ce-91b9-26f4c11cb0e2",
                                                "sense_id": "b02faa76-9ade-3661-a4bb-0ad6f0c52286",
                                                "text": "Normally, I eat breakfast at 6am, but today, I got up late and didn't eat until 9."
                                            },
                                            {
                                                "example_id": "fda4d575-5679-42ff-9dde-f75a17734f60",
                                                "sense_id": "b02faa76-9ade-3661-a4bb-0ad6f0c52286",
                                                "text": "A normally bustling border crossing between Tanzania and Malawi was noticeably quieter than usual on Thursday as a result of an escalating regional trade row."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f819836e-ca94-357e-b1dc-05fc181f4350",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "In the expected or customary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f02addb5-a54b-42f7-885e-2bb2077c91e2",
                                                "sense_id": "f819836e-ca94-357e-b1dc-05fc181f4350",
                                                "text": "Lisa ate normally, until she realised that she was late for choir, when she sped up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87510a4d-a420-3db2-906d-c9a6f0cd5439",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "To a usual or customary extent or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f342f29b-9e22-4d00-a09d-d0edcf42b869",
                                                "sense_id": "87510a4d-a420-3db2-906d-c9a6f0cd5439",
                                                "text": "He was abnormally agitated, she only normally so."
                                            },
                                            {
                                                "example_id": "ebf8f08f-64e8-4fe9-9963-6d2768665c02",
                                                "sense_id": "87510a4d-a420-3db2-906d-c9a6f0cd5439",
                                                "text": "An even more important reason is that our generation is not only normally ignorant but abnormally so. That is, we not only have scholars who do not know the history of the church's testimony, but we have those who tell it like it was not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7702faa-1fcb-3703-87cc-710e64f779cf",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "In the manner of a variable with a Gaussian distribution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5eeb3e6c-25c4-49ae-8092-ccccd173a999",
                        "source_entry_id": "97b45484-31f1-335d-b87a-b2f144840b56",
                        "source_sense_id": "8e2f83f3-2eb5-3111-9ee1-96f3d2830a1a",
                        "source_sense_description": "in het normale geval",
                        "target_lang_word": "normalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15f8bc20-6666-3da0-b4e5-e7d362af29ce",
                                        "entry_id": "1c457171-ab1e-31b4-af4d-baa49311ba1d",
                                        "glosses": [
                                            "D’une manière normale, régulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e3a2f5b-41a8-4511-ad36-1097c8547ddc",
                                                "sense_id": "15f8bc20-6666-3da0-b4e5-e7d362af29ce",
                                                "text": "Par « sentiment de soi sain », j’entends la totale certitude que les sentiments et les désirs éprouvés appartiennent à son propre Soi. Ce n’est pas une certitude raisonnée – elle est là, comme notre pouls, auquel nous ne prêtons aucune attention tant qu’il bat normalement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f177230-2198-3b0f-b632-6b976cd589e7",
                                        "entry_id": "1c457171-ab1e-31b4-af4d-baa49311ba1d",
                                        "glosses": [
                                            "Dans un cas normal ou courant ; sauf circonstance particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a2a3c2a-7712-4bbd-9255-d0f904c50ca1",
                                                "sense_id": "4f177230-2198-3b0f-b632-6b976cd589e7",
                                                "text": "Le revêtement en place, souvent recouvert de gravillons, n’est pas conçu pour être normalement circulable, mais seulement ponctuellement emprunté dans le cadre d’interventions de maintenance."
                                            },
                                            {
                                                "example_id": "09185bf4-0d36-4f43-a7f5-8f25b96ccbc2",
                                                "sense_id": "4f177230-2198-3b0f-b632-6b976cd589e7",
                                                "text": "Ainsi chez le Flet, poisson normalement droitier, les individus dits inversés « gauchers » représentent près d'un tiers dans certaines populations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
