                        ],
                        "examples": [
                            {
                                "example_id": "b036d123-c9ff-432e-a391-5b3e2b78e8a6",
                                "sense_id": "886de5c0-aa9a-3f9b-9bb9-8d94152dcac0",
                                "text": "Ainsi faisait M. Picard, qui, ministre à Bruxelles, trouvait plus commode encore de toucher les appointements attachés à des fonctions qu’il ne remplissait point, et ne débougeait pas de Paris, secondant de son vote docile les caprices de M. Thiers."
                            }
