                                "target_senses": [
                                    {
                                        "sense_id": "cdb2331c-8483-39be-9fd9-fe159d3045be",
                                        "entry_id": "6b73b404-e97e-315d-a3be-5c4523c6c774",
                                        "glosses": [
                                            "Any of a class of aromatic heterocyclic compounds containing a ring of four carbon atoms, two double bonds and an oxygen atom; especially the simplest one, C₄H₄O."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b738b11b-d43b-4646-a1d9-0c5fea6b4a62",
                        "source_entry_id": "7d01f4fa-9812-3bfa-b3c7-2683af2d7968",
                        "source_sense_id": "75484e6b-262f-371b-9fec-c72dcacf3ba0",
                        "target_lang_word": "furane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "236eb446-843c-3bb5-b869-b855da6cc4e1",
                                        "entry_id": "e6341ab0-517b-3979-8255-dad7411a27b5",
                                        "glosses": [
                                            "Hétérocycle de formule chimique brute C₄H₄O."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb19108-507e-4a95-b8c2-90ac18d6bdc5",
                                                "sense_id": "236eb446-843c-3bb5-b869-b855da6cc4e1",
                                                "text": "Le café fait à l’aide de capsules contient plus de furane, un cancérigène, que le café fait à l’aide d’une cafetière classique, montre une étude réalisée par des scientifiques espagnols de l’université de Barcelone."
                                            },
                                            {
                                                "example_id": "27dc5f85-fd9a-4bd5-87a2-6c7039874b0a",
                                                "sense_id": "236eb446-843c-3bb5-b869-b855da6cc4e1",
                                                "text": "Les animaux sauvages profitent, eux aussi, des pollutions industrielles, quand ils « broutent » sur des sols pollués à la dioxine, au furane et aux PCB, ou se désaltèrent dans des cours d’eau chimiqués."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc24aff9-9357-3460-810f-9b6974bcf058",
                                        "entry_id": "e6341ab0-517b-3979-8255-dad7411a27b5",
                                        "glosses": [
                                            "Composé chimique dont la base est le furane."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a9d0190-3bf9-4d25-9f6d-15dbdbd39d63",
                                                "sense_id": "dc24aff9-9357-3460-810f-9b6974bcf058",
                                                "text": "Les dioxines et furanes sont des polluants chimiques organiques générés à l'état de traces au cours de processus thermiques, industriels ou naturels."
                                            },
                                            {
                                                "example_id": "3950ecd3-9ba6-461a-89d3-1e69e96f88cf",
                                                "sense_id": "dc24aff9-9357-3460-810f-9b6974bcf058",
                                                "text": "Cependant, réalisée dans de mauvaises conditions, la combustion du bois émet des polluants néfastes pour la santé, tels que furanes, benzènes, dioxines, composés organiques volatils (COV)… ainsi que des particules fines nocives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
