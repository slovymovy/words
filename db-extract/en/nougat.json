                        "entry_id": "d643dc4e-6c77-349e-b323-3c2f45e4dc09",
                        "glosses": [
                            "A mixture consisting of egg white and a sweetener, variously mixed with (in western Europe) almonds or (in eastern Europe) hazelnuts or (in US) used without nuts as a filler in candy bars."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0df0826-66dd-4964-9794-9fae3920cd8c",
                                "sense_id": "94d2dbaa-9adf-326c-8f12-170cdff339f2",
                                "text": "Cake Nogat: This nogat may be made in moulds, or square pieces."
                            },
                            {
                                "example_id": "c6648a68-6ae6-4a71-9c00-2b3a9a083060",
                                "sense_id": "94d2dbaa-9adf-326c-8f12-170cdff339f2",
                                "text": "[…](being twenty four and\nnever screwed but in her\nsoft nougat thighs)[…]"
                            },
                            {
                                "example_id": "e934ae1a-282d-4a5a-9d6a-62e77727dbb6",
                                "sense_id": "94d2dbaa-9adf-326c-8f12-170cdff339f2",
                                "text": "[…]it helps that Snickers offers the holy trinity of confection: nougat, caramel and peanuts[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b90812cb-93ef-3e29-9c2f-2aa759437eca",
                        "entry_id": "d643dc4e-6c77-349e-b323-3c2f45e4dc09",
                        "glosses": [
                            "A piece of this mixture, typically eaten as a confection."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "64162040-5e83-4253-bcc6-44f8a00445bc",
                                "sense_id": "b90812cb-93ef-3e29-9c2f-2aa759437eca",
                                "text": "When you make a nougat of large dimensions, put in the almonds a few at a time."
                            }
                        ]
