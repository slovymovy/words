                "senses": [
                    {
                        "sense_id": "dccd43ab-7560-3ac4-b62d-982210d3b3ac",
                        "entry_id": "a80d2163-e754-384f-b642-5c4502644135",
                        "glosses": [
                            "größeres Gebiet in der Schweiz, das sich zwischen dem Jura und den Alpen erstreckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e536ebed-245c-49a1-823a-f78808368ccb",
                                "sense_id": "dccd43ab-7560-3ac4-b62d-982210d3b3ac",
                                "text": "„Der Roman spielt im schweizerischen Mittelland, vorwiegend in der zweiten Hälfte des letzten Jahrhunderts, leuchtet aber auch in seine leid- und gewaltvolle erste Hälfte.“"
                            },
                            {
                                "example_id": "1849ae7f-e97f-4882-bef7-944e95bc3fb5",
                                "sense_id": "dccd43ab-7560-3ac4-b62d-982210d3b3ac",
                                "text": "„Mit dem ersten Zentimeter Wärmedämmung können im Mittelland etwa 6474kWh prom“ Bauteilfläche eingespart werden […].“"
                            },
                            {
                                "example_id": "964b96d9-2e14-4940-aa12-1c6309394352",
                                "sense_id": "dccd43ab-7560-3ac4-b62d-982210d3b3ac",
                                "text": "„Das Freiburger (oder Fribourger) Mittelland war schon im Mittelalter bevorzugtes Durchzugsgebiet der Pilger zum Grab des Jakobus nach Spanien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
