                                "target_senses": [
                                    {
                                        "sense_id": "4bfcde3e-6157-324e-8489-db1696f335f5",
                                        "entry_id": "984de951-e7d1-3fac-8a92-11fa91260b23",
                                        "glosses": [
                                            "de berijder van een rijdier, meestal een paard"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68933c2a-55a8-4a02-b4d1-c3740b9e0777",
                                                "sense_id": "4bfcde3e-6157-324e-8489-db1696f335f5",
                                                "text": "De ruiter ging er in galop vandoor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03fb8dd9-405a-3830-aa12-c6fc35d1fb55",
                                        "entry_id": "984de951-e7d1-3fac-8a92-11fa91260b23",
                                        "glosses": [
                                            "iets wat ergens op zit en er boven uit steekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43694c7-e705-4359-8fb1-643aeeb6beda",
                                                "sense_id": "03fb8dd9-405a-3830-aa12-c6fc35d1fb55",
                                                "text": "Je stelt de tabulator op deze schrijfmachine in door een ruitertje te plaatsen."
                                            },
                                            {
                                                "example_id": "1a913ea5-72cd-4794-b2dd-0285e1f3e657",
                                                "sense_id": "03fb8dd9-405a-3830-aa12-c6fc35d1fb55",
                                                "text": "De ruitertjes op de hangmappen geven overzicht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfd0dfaa-8348-357a-bb1d-7e57df8ac3a1",
                                        "entry_id": "984de951-e7d1-3fac-8a92-11fa91260b23",
                                        "glosses": [
                                            "een verticale plank op een nokgording ter ondersteuning van de nokvorsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2781eb5a-cc23-499d-b153-033cd6900775",
                                                "sense_id": "cfd0dfaa-8348-357a-bb1d-7e57df8ac3a1",
                                                "text": "De ruiter werd door de timmerman op de nokgording aangebracht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea4928e4-46d7-3897-9184-1b629f503ee8",
                                        "entry_id": "984de951-e7d1-3fac-8a92-11fa91260b23",
                                        "glosses": [
                                            "een rek waarop onder meer bonen worden gedroogd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f32100a-c6f9-46d1-93af-7d996721136f",
                                                "sense_id": "ea4928e4-46d7-3897-9184-1b629f503ee8",
                                                "text": "Waar in Zeeland worden bonen nu nog op ruiters gezet om te drogen?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "139b6d1f-d3fe-4531-8381-eddb0b900b57",
                        "source_entry_id": "5fecdfb2-139d-33ed-ad16-f7a2bc8948b5",
                        "source_sense_description": "sens 1",
