                                "target_senses": [
                                    {
                                        "sense_id": "31b5f8c1-5583-3fb9-8455-43898ac98961",
                                        "entry_id": "57907e53-0e27-3572-b53e-d8e5f2b7cb9e",
                                        "glosses": [
                                            "Que no se puede resistir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda263ec-7921-42a7-8a17-af6d839e2d9b",
                                                "sense_id": "31b5f8c1-5583-3fb9-8455-43898ac98961",
                                                "text": "«El combate tenía sobre todos una atracción irresistible, y nos llamaba como llama el abismo al que le mira desde el vértice de elevada cima»."
                                            },
                                            {
                                                "example_id": "1fedee76-f417-48f9-9830-79b4d9cdc1a1",
                                                "sense_id": "31b5f8c1-5583-3fb9-8455-43898ac98961",
                                                "text": "«Sin embargo, un impulso irresistible me hacía continuar el camino, deteniéndome solo un instante para saludar a la cruz que vi delante de la puerta; pero esta se hallaba cerrada, y nadie parecía alrededor; fuertes eran mis deseos de llamar; mas ¿cómo osar llamar en la morada de los muertos?…»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29ce1198-86db-363a-a037-1cb320db78b3",
                                        "entry_id": "57907e53-0e27-3572-b53e-d8e5f2b7cb9e",
                                        "glosses": [
                                            "Guapo, encantador, simpático."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9a3ff8-c37b-4115-bcbc-e76b78c3d5ef",
                                                "sense_id": "29ce1198-86db-363a-a037-1cb320db78b3",
                                                "text": "«—Ahora que te has lavado el cuerpo con agua corriente, y te has cepillado los huesos, estás irresistible»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
