                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ee0a397-330f-4502-a63a-e0eea6c38e2b",
                                "sense_id": "c66a4c8d-578a-3eee-94af-1963fe03c51b",
                                "text": "„Ab etwa dem 5. Januar wird die Westwetterlage enden und stattdessen kalte Luft von Norden nach Deutschland strömen. Damit nehmen die Niederschläge ab und die Hochwasserlage entspannt sich.“"
                            },
                            {
                                "example_id": "cb529148-b594-470f-b811-55b5af90159d",
                                "sense_id": "c66a4c8d-578a-3eee-94af-1963fe03c51b",
                                "text": "„Die Hochwasserlage in Deutschland bleibt kritisch, stark aufgeweichte Deiche drohen zu brechen.“"
                            }
                        ],
