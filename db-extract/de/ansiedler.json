                        "glosses": [
                            "Person, die sich an einem bestimmten Ort auf längere Sicht oder auf Dauer niederlässt/niedergelassen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41af0faf-46c3-454f-8b99-7fb67e5dfe30",
                                "sense_id": "338d31e7-be49-3ff0-b06a-0d5d9ebb069c",
                                "text": "„Mit dem Vorrücken der Grenze gegen den Ohio hinab erschien in den Niederlassungen zuweilen ein Mensch, den selbst die furchtlosen Ansiedler, bemalter Indianer und der Geister des Urwalds gewohnt, mit dunkler Scheu betrachteten.“"
                            }
                        ],
