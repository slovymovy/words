            "senses": [
                {
                    "sense_id": "97abc835-3d58-3097-8133-5a8e14cd5d8d",
                    "sense_definition": "Present participle of <w>boast</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept <w>boasting</w> about how much money he had won.",
                            "target_lang_translations": {
                                "es": "Él no paraba de <w>presumir</w> de cuánto dinero había ganado."
                            }
                        },
                        {
                            "text": "The hotel is proud of <w>boasting</w> spectacular views of the coastline.",
                            "target_lang_translations": {
                                "es": "El hotel se enorgullece de <w>presumir de</w> unas vistas espectaculares de la costa."
                            }
                        }
                    ],
                    "synonyms": [
                        "bragging",
                        "crowing"
                    ],
                    "common_phrases": [
                        "boasting about"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio presente o gerundio del verbo 'boast' (presumir o alardear)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "presumiendo",
                                "target_lang_sense_clarification": "alardeando de algo"
                            },
                            {
                                "target_lang_word": "alardeando",
                                "target_lang_sense_clarification": "haciendo ostentación"
                            },
                            {
                                "target_lang_word": "jactándose",
                                "target_lang_sense_clarification": "vanagloriándose"
                            }
                        ]
                    }
