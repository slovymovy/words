                            {
                                "example_id": "e2fe6b82-c224-4500-b0d1-6db4195697bb",
                                "sense_id": "eacdfa35-b0c1-3527-b824-57cf4b4c7c81",
                                "text": "In such a perplexity every man asks his fellow, What's best to be done? and being dozzled with fear, thinks every man wiser than himself."
                            },
                            {
                                "example_id": "93468b1d-fbdc-4a24-822f-1bf443c22544",
                                "sense_id": "eacdfa35-b0c1-3527-b824-57cf4b4c7c81",
                                "text": "The other stood cold as a pyramid, Lacked Beauty, lacked noble blend Of elbow and joist, Was dozzled, was too pipingly voiced To be perfect friend"
                            },
                            {
                                "example_id": "77d29a6b-c828-4fd4-911e-88c22963d5aa",
                                "sense_id": "eacdfa35-b0c1-3527-b824-57cf4b4c7c81",
                                "text": "He longed to see the familiar face of the Mahamatya Shaktar but his peetha (seat) was occupied by Rakshas, who, like his king Nanda, looked dozzled and careless."
                            }
                        ]
                    }
