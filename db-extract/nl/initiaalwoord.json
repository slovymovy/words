                    {
                        "sense_id": "575a59d6-9650-32cd-a11e-6303df649d1e",
                        "entry_id": "7d023c59-638d-370e-a8d0-e87fc7fe4fbf",
                        "glosses": [
                            "een woord dat is samengesteld uit de beginletters van afzonderlijke woorden en dat wordt uitgesproken als een reeks letternamen (omschrijving volgens de Nederlandse Taalunie). Vergelijk met de omschrijving van het woord letternaam in het Afrikaans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e80ce4c3-f15f-49ce-8943-1c40e6169a8b",
                                "sense_id": "575a59d6-9650-32cd-a11e-6303df649d1e",
                                "text": "cd: ceedee."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e158c3-85cc-3c71-8e64-90032be44d18",
                        "entry_id": "7d023c59-638d-370e-a8d0-e87fc7fe4fbf",
                        "glosses": [
                            "een woord dat bestaat uit de beginletters van een meerdelige naam (omschrijving volgens G. Geerts, H. Heestermans (1992) Van Dale groot woordenboek der Nederlandse taal, 12e druk). Vergelijk met de omschrijving van letterwoord door de Nederlandse Taalunie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a64d74-5ba1-4af1-ab61-3d66cba26c7d",
                                "sense_id": "e1e158c3-85cc-3c71-8e64-90032be44d18",
                                "text": "VARA, mavo, Sabena, radar."
                            }
                        ]
                    },
                    {
                        "sense_id": "43574e8d-9c5b-311c-af3e-6de956d0128a",
                        "entry_id": "7d023c59-638d-370e-a8d0-e87fc7fe4fbf",
                        "glosses": [
                            "een woord dat bestaat uit de initialen van de voornamen en familienaam. Soms worden voor de uitspraak noodzakelijke klinkers tussen gevoegd (Grote Winkler Prins Encyclopedie, 9e druk (1991))"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86027d19-b460-4463-819a-1ee4a90be0f8",
                                "sense_id": "43574e8d-9c5b-311c-af3e-6de956d0128a",
                                "text": "RaMbaM voor Rabbi Mozes ben Maimon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dff85ab-6ec7-44d2-9231-686efb81ec20",
                        "source_entry_id": "7d023c59-638d-370e-a8d0-e87fc7fe4fbf",
                        "source_sense_id": "575a59d6-9650-32cd-a11e-6303df649d1e",
                        "source_sense_description": "en 2.",
                        "target_lang_word": "Initialwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Initialwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4a71529-888b-3ad4-8fe7-84924f7b23e9",
                                        "entry_id": "3c808b1d-9f00-3de2-a2de-5b6d9b2c8802",
                                        "glosses": [
                                            "Kurzwort, das aus den Initialen, also den Anfangsbuchstaben des zugrundeliegenden Ausdrucks gebildet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48dfaccb-6d09-49d7-a781-2f488df7da79",
                                                "sense_id": "b4a71529-888b-3ad4-8fe7-84924f7b23e9",
                                                "text": "Beispiele für Initialwörter im Deutschen sind „CDU“, „LKW“, „UNO“."
                                            },
                                            {
                                                "example_id": "6bf4afb0-8022-4936-967f-8ef10dc57e77",
                                                "sense_id": "b4a71529-888b-3ad4-8fe7-84924f7b23e9",
                                                "text": "„In § 177 wendet er sich ‚Initialwörtern u.ä.‘ zu, die er als ‚ganz neue Wörter […] aus künstlich-willkürlicher Einschränkung auf Anfangsbuchstaben oder -silben‘ beschreibt (S. 268).“"
                                            },
                                            {
                                                "example_id": "183de39d-a90e-4302-88bf-17d944d51d62",
                                                "sense_id": "b4a71529-888b-3ad4-8fe7-84924f7b23e9",
                                                "text": "„Fleischer 1983 unterscheidet zwischen Initial- und Silbenwörtern einerseits und »eigentlichen« Kurzwörtern andererseits. Zu den Initialwörtern gehören Wortbildungen wie LKW, PKW, DAV (Deutsche Angestellten-Versicherung).“"
                                            },
                                            {
                                                "example_id": "2013771a-6ad4-4958-9322-9fa21c71921a",
                                                "sense_id": "b4a71529-888b-3ad4-8fe7-84924f7b23e9",
                                                "text": "„Dabei darf nicht übersehen werden, wie viele Initialwörter der Technik aus englischsprachigen Wortgruppen hervorgegangen sind:…“"
                                            },
                                            {
                                                "example_id": "d04732da-3080-4193-975e-2a48aca0701d",
                                                "sense_id": "b4a71529-888b-3ad4-8fe7-84924f7b23e9",
                                                "text": "„Die Akzeptanz dieser übersetzten Initialwörter ist im Französischen sehr groß, was durch die Tatsache untermauert wird, daß diese Initialwörter äußerst produktiv sind und sogar eigensprachlichen Ableitungen bilden.“"
                                            },
                                            {
                                                "example_id": "58bf341d-232d-4597-bca6-02d7887ea1fe",
                                                "sense_id": "b4a71529-888b-3ad4-8fe7-84924f7b23e9",
                                                "text": "„Initialwörter werden im Allgemeinen ohne Punkt geschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5bbd3d5-b1f0-47cf-a06b-3e82ecf4ba74",
                        "source_entry_id": "7d023c59-638d-370e-a8d0-e87fc7fe4fbf",
                        "source_sense_id": "575a59d6-9650-32cd-a11e-6303df649d1e",
                        "source_sense_description": "en 2.",
                        "target_lang_word": "Akronym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akronym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db03fb3e-f098-3c58-af56-90e69999a4e8",
                                        "entry_id": "2f3edd6a-c9e2-315d-b649-f1eb2b124dcb",
                                        "glosses": [
                                            "eine Abkürzung, die als eigenes Wort gesprochen wird; bezeichnet ein Kurzwort, das aus den Anfangsbuchstaben oder -silben von mehreren Wörtern oder aus einem Kompositum entstanden ist"
                                        ],
                                        "tags": [
                                            "im weiteren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d93bc57-7ff9-45d0-b7dd-41d20d4ff89f",
                                                "sense_id": "db03fb3e-f098-3c58-af56-90e69999a4e8",
                                                "text": "„Viele Akronyme – so nennt man die Kunstgebilde aus Anfangsbuchstaben bzw. Silben von Wörtern – sind allerdings inzwischen so geläufig geworden, daß man sie gar nicht mehr als solche erkennt.“"
                                            },
                                            {
                                                "example_id": "f4cc2b17-fde1-4390-9dc5-ef777e84cede",
                                                "sense_id": "db03fb3e-f098-3c58-af56-90e69999a4e8",
                                                "text": "„UNO“, „UNESCO“, „DOPA“, „GNU“ und „EDEKA“ sind Akronyme."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d98dfe2f-8cd0-3cf8-887c-524c6d3375de",
                                        "entry_id": "2f3edd6a-c9e2-315d-b649-f1eb2b124dcb",
                                        "glosses": [
                                            "Kurzwort, das aus den Anfangsbuchstaben mehrerer Wörter gebildet ist"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ea34ae-28a3-47e5-ab33-13735e1ae42e",
                                                "sense_id": "d98dfe2f-8cd0-3cf8-887c-524c6d3375de",
                                                "text": "„UNO“, „UNESCO“, „DOPA“, „GNU“ und „EDEKA“ sind Akronyme."
                                            },
                                            {
                                                "example_id": "f1b9ff0c-9cae-4678-88c3-fb79e15b62dd",
                                                "sense_id": "d98dfe2f-8cd0-3cf8-887c-524c6d3375de",
                                                "text": "„Die Versalien des Akronyms zwingen den Leser dazu, nicht den Lautwert eines Buchstabens zu sprechen, sondern seinen Namen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "323e03b1-c22e-4aad-98b8-51fb5b66492e",
                        "source_entry_id": "7d023c59-638d-370e-a8d0-e87fc7fe4fbf",
                        "source_sense_id": "575a59d6-9650-32cd-a11e-6303df649d1e",
                        "source_sense_description": "en 2.",
                        "target_lang_word": "acronym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acronym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ca2e51-ef4f-353f-924b-9933328d2249",
                                        "entry_id": "3ca80629-6bcd-3484-9950-d885533e3aef",
                                        "glosses": [
                                            "An abbreviation formed by the initial letters of other words.",
                                            "Generally such abbreviations, including those pronounced as individual letters (initialisms such as \\\"TNT\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224bf5d4-bcad-468a-b790-293bf3ffe7d7",
                                                "sense_id": "f2ca2e51-ef4f-353f-924b-9933328d2249",
                                                "text": "Pee-gee-enn. It's an acronym, that's what it is. That's what they call words made up of initials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                        "entry_id": "3ca80629-6bcd-3484-9950-d885533e3aef",
                                        "glosses": [
                                            "An abbreviation formed by the initial letters of other words.",
                                            "Exclusively such abbreviations when pronounced as a word (as \\\"laser\\\" or \\\"NATO\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528dde44-2341-429f-abdc-281f77aa64dd",
                                                "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                                "text": "Some teachers festoon every spare inch of wall with vocabulary choices or maths techniques to use, which look great at first, but to some children might appear quite daunting. You'll probably see unfamiliar acronyms such as Walt (We Are Learning To). Be sure to ask what they stand for and how they are used in practice."
                                            },
                                            {
                                                "example_id": "d51ee229-a35f-480c-993a-eada4ce53cd0",
                                                "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                                "text": "Traders have reportedly come up with the acronym TACO, which stands for “Trump always chickens out,” to take advantage of the trade environment created by the president’s habit of threatening to impose tariffs on countries, and then backing off at the last moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96fb985a-a6ed-3bfd-b18e-3a0712f26d1d",
                                        "entry_id": "3ca80629-6bcd-3484-9950-d885533e3aef",
                                        "glosses": [
                                            "An abbreviation formed by the beginning letters or syllables of other words (as \\\"Benelux\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54a5f48-efbf-42ed-950f-55493fd665e2",
                                                "sense_id": "96fb985a-a6ed-3bfd-b18e-3a0712f26d1d",
                                                "text": "Acronyms or telescoped names like nabisco from National Biscuit Company."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acronym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d6d3a1-1a41-37c2-9b6c-3ffbb4936f6c",
                                        "entry_id": "a67936bd-d1d4-37b8-9350-48e1e0c5813f",
                                        "glosses": [
                                            "To form into an acronym."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c04551d-efc9-4503-a31e-00625cf76438",
                        "source_entry_id": "7d023c59-638d-370e-a8d0-e87fc7fe4fbf",
                        "source_sense_id": "575a59d6-9650-32cd-a11e-6303df649d1e",
