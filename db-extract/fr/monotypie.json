                    {
                        "sense_id": "6ac506b6-97d0-33ef-a2e9-fe45f4152bc9",
                        "entry_id": "71f2db57-348f-3745-a428-5818264b87de",
                        "glosses": [
                            "Procédé de composition au plomb utilisant une monotype."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0adf57-f3eb-4d41-b0f8-ac3485e09d76",
                                "sense_id": "6ac506b6-97d0-33ef-a2e9-fe45f4152bc9",
                                "text": "Dans le domaine de la composition, l’Imprimerie est en mesure de pratiquer tous les procédés actuels en usage : typographie manuelle, linotypie, monotypie, photocomposition simple ou programmée."
                            },
                            {
                                "example_id": "08be89be-2df5-4861-b6e1-5cc6dd2e00bb",
                                "sense_id": "6ac506b6-97d0-33ef-a2e9-fe45f4152bc9",
                                "text": "Les techniques industrielles de composition (la linotypie, la monotypie), la photocomposition, la PAO ( publication assistée par ordinateur ), de même que les procédés modernes d’impression ( l’offset tout particulièrement ), ne peuvent en aucun cas rivaliser avec la typographie."
                            }
                        ]
                    }
