                    },
                    {
                        "sense_id": "09524a9a-1d7b-31ea-94ee-1abd538fe2d7",
                        "entry_id": "b04b3aee-571e-336e-8303-f26a2b9ecc46",
                        "glosses": [
                            "utwór literacki zawierający skargi i żale z powodu klęski ojczyzny lub naruszania wyższych wartości oraz przestrogi dla narodu bądź proroctwa dotyczące odzyskania wolności"
                        ],
