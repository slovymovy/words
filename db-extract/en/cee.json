                                "target_senses": [
                                    {
                                        "sense_id": "8923833b-615c-3518-b749-79cb1c0b654a",
                                        "entry_id": "895f1ff3-8a78-3929-b8f9-910f1a6bceee",
                                        "glosses": [
                                            "название латинской буквы «C, c»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2012aef6-2504-497a-8d42-b77372f9387a",
                                                "sense_id": "8923833b-615c-3518-b749-79cb1c0b654a",
                                                "text": "Горбоносый стал загибать пальцы: «Нам нужен программист: а — небалованный, бэ — доброволец, цэ — чтобы согласился жить в общежитии…»"
                                            },
                                            {
                                                "example_id": "fa8806ca-1c80-42f4-9b04-37fe618db95f",
                                                "sense_id": "8923833b-615c-3518-b749-79cb1c0b654a",
                                                "text": "А он сам с собой в шахматы играет, да быстро так: говорит, к примеру, конь чёрный — аш-три гэ-пять, белый ферзь — цэ-шесть дэ-семь, и прочее в этом роде."
                                            },
                                            {
                                                "example_id": "24e6d79b-1d51-4110-b8a9-1fd466f39ca0",
                                                "sense_id": "8923833b-615c-3518-b749-79cb1c0b654a",
                                                "text": "И «бэ» витамины, и «цэ» тоже не отрава."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "цэ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf018dd-c43b-3fc8-a0d5-10657323666c",
                                        "entry_id": "69ded17d-ff34-345e-a414-f29cd7199178",
                                        "glosses": [
                                            "вульг., эвф., сокр. от целка, целочка; девственница"
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c481c93-bbca-40da-9b7b-129870ece56f",
                                                "sense_id": "0cf018dd-c43b-3fc8-a0d5-10657323666c",
                                                "text": "Раскажи мне, дорогая, // Что ты: цэ или не цэ? // Если цэ, пойдём к сараю, // Если нет, то на крыльце!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
