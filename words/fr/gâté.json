            "senses": [
                {
                    "sense_id": "5da9e7be-a123-3f54-ace6-eac2f11e3d62",
                    "sense_definition": "À qui l'on cède tout et dont on tolère tous les caprices.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses grands-parents lui achètent tout ce qu'il veut, c'est vraiment un enfant <w>gâté</w>."
                        },
                        {
                            "text": "Elle se comporte comme une fille trop <w>gâtée</w> dès qu'on refuse de satisfaire ses moindres envies."
                        }
                    ],
                    "common_phrases": [
                        "enfant gâté"
                    ]
                },
                {
                    "sense_id": "25b456d0-7086-3461-9ca2-ba27889259bb",
                    "sense_definition": "Qui est altéré, corrompu par la décomposition ou la pourriture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne mange pas cette pomme, elle est complètement <w>gâtée</w> à l'intérieur."
                        },
                        {
                            "text": "Une odeur désagréable se dégageait de la viande <w>gâtée</w> oubliée au soleil."
