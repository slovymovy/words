                        ],
                        "form": "die Arbeiterklasse"
                    },
                    {
                        "form_id": "0f104a80-350d-49ae-a76d-20f76ff3b631",
                        "entry_id": "e86a891a-b70c-3e3d-a397-580a1efb369b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Arbeiterklassen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                        "entry_id": "e86a891a-b70c-3e3d-a397-580a1efb369b",
                        "glosses": [
                            "gesellschaftliche Schicht der arbeitenden Bevölkerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894e3982-f28b-49e1-8820-1cb8b5c28956",
                                "sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                                "text": "Erst durch Revolutionen konnte die Arbeiterklasse sich wieder besser stellen."
                            },
                            {
                                "example_id": "78506908-2325-4358-a155-5cfd954c168c",
                                "sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                                "text": "Er und seine Familie zählen sich zur Arbeiterklasse, in Wirklichkeit gehören sie wegen ihren Einkommens und Benehmens längst zur Mittelschicht."
                            },
                            {
                                "example_id": "1239c865-b07f-48cf-a932-823a6cba49c2",
                                "sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                                "text": "„Auch durch die Arbeiterklasse verläuft der gleiche tiefe Riss wie durch die gesamte Gesellschaft – die weißen Arbeiter sehen in den schwarzen vor allem billigere Konkurrenz.“"
                            },
                            {
                                "example_id": "29088076-224b-4415-828c-74ced0d93e4c",
                                "sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                                "text": "„Damian war keiner von denen, die sich als Führer der Arbeiterklasse aufspielen, die zu wissen glauben, wo's langgeht zu den Beseligungen der Revolution.“"
                            },
                            {
                                "example_id": "98a36156-d098-4dd3-8c31-b7160a5b3f5b",
                                "sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                                "text": "„Von Marx über die RAF bis hin zur Partei der Linken waren es hier immer wieder Gutbürgerliche, die sich für die Arbeiterklasse einsetzten – aber keine Ahnung hatten, was das eigentlich für Typen sind und was sie wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a86ff64d-699b-42d1-aded-4baabc2bbc89",
                        "source_entry_id": "e86a891a-b70c-3e3d-a397-580a1efb369b",
                        "source_sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                        "source_sense_description": "gesellschaftliche Schicht der arbeitenden Bevölkerung",
                        "target_lang_word": "working class",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "working class",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eec6714f-1dcd-3d37-bce9-58aac6cc0dc7",
                                        "entry_id": "dd7753e4-3337-3e05-bec4-e8fa90d72b60",
                                        "glosses": [
                                            "The social class of those who perform physical work for a living, as opposed to the professional or middle class, the upper class, or others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7827a5dd-86b4-498f-934b-bed79c8daf0e",
                                                "sense_id": "eec6714f-1dcd-3d37-bce9-58aac6cc0dc7",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them."
                                            },
                                            {
                                                "example_id": "8e71ea2a-00a6-4eee-89bb-47b7a5de6936",
                                                "sense_id": "eec6714f-1dcd-3d37-bce9-58aac6cc0dc7",
                                                "text": "It may seem that the Met was a snobbish outfit, a betrayer of the egalitarian dreams of Charles Pearson, but in being one of the pioneers of working men's fares the company had helped to bring about a revolution that would allow the working classes to live in London. Cheap trains would supersede Gladstone's well-meant Parliamentary Trains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "working class",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54e36629-d3b7-3871-a0ec-87d790d49911",
                                        "entry_id": "cf8e1d5a-8ce8-31f8-ab92-cea61d9e30b2",
                                        "glosses": [
                                            "Alternative spelling of working-class."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ec8cfd-7082-483d-84fa-3c0153bdde6c",
                                                "sense_id": "54e36629-d3b7-3871-a0ec-87d790d49911",
                                                "text": "Socialism has never and nowhere been at first a working class movement. It is by no means an obvious remedy for an obvious evil which the interests of that class will necessarily demand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a593906-3b45-4f54-a3ac-617c31437ff3",
                        "source_entry_id": "e86a891a-b70c-3e3d-a397-580a1efb369b",
                        "source_sense_id": "1262167f-b0ad-3515-b4d9-12c1b7b709f8",
                        "source_sense_description": "gesellschaftliche Schicht der arbeitenden Bevölkerung",
                        "target_lang_word": "classe ouvrière",
