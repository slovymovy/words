                            {
                                "example_id": "f707e125-b64b-4b71-9ba4-c4f6462d483d",
                                "sense_id": "00c0d651-3c07-338c-9633-552ca3dc344c",
                                "text": "De plus, les contraintes mécaniques liées à la mise en œuvre de l'opération de touffetage conduisent à l'emploi de support textile résistant fortement aux efforts de traction, mais présentant également une faible résistance à la perforation de manière à être facilement transpercé par les aiguilles réalisant le touffetage, c'est-à-dire guidant les fibres ou brins à travers le support."
                            }
                        ]
                    },
                    {
                        "sense_id": "c92dd7c1-0f7e-3cb9-be0d-891d3d1d5b39",
                        "entry_id": "34db56b4-7d1c-397f-a360-f7d5662270d4",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef9a489-85b6-496d-a263-b52e89f17531",
                                "sense_id": "c92dd7c1-0f7e-3cb9-be0d-891d3d1d5b39",
                                "text": "Les fibres employées pour former les brins ou poils de touffetage sont généralement constitués de matériaux plastiques polymères, tels que le polypropylène, le polyéthylène ou un polyamide."
                            }
                        ]
                    }
