                        "examples": [
                            {
                                "example_id": "0e86eadb-5d10-4f76-9255-a41a5db1d339",
                                "sense_id": "5839722f-90ec-3a76-b626-c898795d0845",
                                "text": "Un atténuateur est souvent utilisé dans le domaine de la sonorisation afin d'adapter les niveaux sonores."
                            },
                            {
                                "example_id": "fe9ae8cf-fe53-4b96-a904-2733c084b840",
                                "sense_id": "5839722f-90ec-3a76-b626-c898795d0845",
                                "text": "Tant que vous y êtes, faites venir quelqu’un pour réparer le poste tactique et voyez si on ne pourrait pas mettre en place un atténuateur de puissance quelconque pour éviter les surcharges."
                            }
                        ]
