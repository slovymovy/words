                        ],
                        "examples": [
                            {
                                "example_id": "b1755235-3791-40c6-8c04-29aa21b21cac",
                                "sense_id": "98ef1ccc-7f22-332f-9296-a12f25cb86fb",
                                "text": "„Hayali reagierte gelassen auf die Störerin.“"
                            },
                            {
                                "example_id": "88b2d175-9c93-4b5f-a611-77e06a1037f7",
                                "sense_id": "98ef1ccc-7f22-332f-9296-a12f25cb86fb",
                                "text": "„Danach berichtete Dunja Hayali, dass die Störerin nicht aus dem Saal geworfen worden sei, sondern dass sie im Anschluss über den Vorfall mit ihr sprechen werde.“"
                            },
                            {
                                "example_id": "1dc219a9-2e50-4337-b817-3217e696873a",
                                "sense_id": "98ef1ccc-7f22-332f-9296-a12f25cb86fb",
                                "text": "„Die Situation eskaliert auch nicht, als eine Störerin aufsteht, sich der Bühne nähert und dann von den Sicherheitsleuten nach draußen begleitet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
