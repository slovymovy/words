                                                "example_id": "cfd079f0-d585-4b41-8765-3f8f3b70df64",
                                                "sense_id": "58f3887f-8216-3bdf-9122-c13a2bf54168",
                                                "text": "„Die schwarzgelbe Raupe drehte sich mühsam zu ihnen.“"
                                            },
