                    },
                    {
                        "translation_id": "31de862f-cd07-49e1-af0d-639984fc4843",
                        "source_entry_id": "8c0e60a9-7a7b-366a-9d06-2b03990ac33b",
                        "source_sense_id": "02d970d8-db2b-396e-b32f-e4646d5ca6ce",
                        "source_sense_description": "alte Frau mit runzliger Haut",
                        "target_lang_word": "wrinkled old woman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
