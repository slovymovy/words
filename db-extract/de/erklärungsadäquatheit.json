                "senses": [
                    {
                        "sense_id": "3dc05448-fea5-3835-80fe-0d045b482cf2",
                        "entry_id": "ce0fe229-669c-3e2b-99cf-bf66e07abff8",
                        "glosses": [
                            "Anforderung an eine Sprachtheorie, die beobachteten Sprachformen korrekt und vollständig wiederzugeben, die Intuition/ Kompetenz des Sprechers der Sprache zu erfassen und zusätzlich in Übereinstimmung mit einer Sprachtheorie zu stehen, welche sprachliche Universalien und Spracherwerb mit einschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed315bf-7448-49cc-a4de-745067204b1c",
                                "sense_id": "3dc05448-fea5-3835-80fe-0d045b482cf2",
                                "text": "Erklärungsadäquatheit muss mehr Kriterien erfüllen als die Beobachtungsadäquatheit und die Beschreibungsadäquatheit."
                            },
                            {
                                "example_id": "ef872992-4378-4dae-be8b-226b1ecb0919",
                                "sense_id": "3dc05448-fea5-3835-80fe-0d045b482cf2",
                                "text": "In der Generativen Grammatik wurde von Noam Chomsky eine Hierarchie von Adäquatheitsbegriffen entwickelt, darunter als höchste Stufe die Erklärungsadäquatheit."
                            }
                        ],
