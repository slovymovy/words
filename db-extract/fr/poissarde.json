                    },
                    {
                        "form_id": "c5ae2d18-9a1c-4184-ba8b-88bddacf7afb",
                        "entry_id": "31023209-b3fe-3bbc-9b86-faa680a71f1b",
                        "tags": [
                            "masculine"
                        ],
                        "form": "poissard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48535efa-91f7-3b79-b9d9-58b78a38f647",
                        "entry_id": "31023209-b3fe-3bbc-9b86-faa680a71f1b",
                        "glosses": [
                            "Personne grossière et vulgaire."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1475b215-3144-4fd1-ad95-2cbf2325f952",
                                "sense_id": "48535efa-91f7-3b79-b9d9-58b78a38f647",
                                "text": "Sa beauté de Junon, son grand corps majestueux se fondait dans une fureur de poissarde."
                            },
                            {
                                "example_id": "4caa025d-c445-42f3-8b7a-ac53adbb6656",
                                "sense_id": "48535efa-91f7-3b79-b9d9-58b78a38f647",
                                "text": "Pauline éleva la voix et se mit à l’engueuler avec son répertoire de poissarde."
                            },
                            {
                                "example_id": "d68d63e3-5261-4627-8053-693f1df9c7fb",
                                "sense_id": "48535efa-91f7-3b79-b9d9-58b78a38f647",
                                "text": "Et là une bagarre de poissardes, ivres ; un peu plus loin un seul policeman et des maisons tapies dans l’ombre, de hautes maisons, des maisons à dôme, des églises, le Parlement, et la trompe d’un bateau à vapeur sur le fleuve, un son creux, comme une corne de brume."
                            },
                            {
                                "example_id": "1b56dcb4-953d-4ac2-a7ab-dcc159736400",
                                "sense_id": "48535efa-91f7-3b79-b9d9-58b78a38f647",
                                "text": "Et voilà notre poissarde qui s’échauffe, emplit l’air de ses clameurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "926b4d91-8224-378f-a0e5-7d38d03d4a4c",
                        "entry_id": "31023209-b3fe-3bbc-9b86-faa680a71f1b",
                        "glosses": [
                            "Malchanceuse, poursuivie par la déveine, la poisse."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d924f9a5-29ca-4915-bec5-1076991e8f6d",
                                "sense_id": "926b4d91-8224-378f-a0e5-7d38d03d4a4c",
                                "text": "J’AI GAGNÉ ! Le hasard m’a choisie. Moi, Adèle Joly, la poissarde professionnelle, j’ai été tirée au sort ! — (Felicity Stuart, Love me (if you can), Paris, Éditions addictives, volume 3)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f918f145-e1b8-3b23-a007-d6b9349bd775",
                        "entry_id": "31023209-b3fe-3bbc-9b86-faa680a71f1b",
                        "glosses": [
                            "Boucle d'oreille fine et légère, typique de l'époque napoléonienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6dc0ac-0955-4da8-9ab7-5b324569f1f0",
                                "sense_id": "f918f145-e1b8-3b23-a007-d6b9349bd775",
                                "text": "Legs Villeneuve - Esclapon , 1952 MM 51.2.13 70 Boucle d'oreille « poissarde » ovale Époque Louis - Philippe Or ,…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87bd84a6-0756-4c71-919a-16dcad7dd48f",
                        "source_entry_id": "31023209-b3fe-3bbc-9b86-faa680a71f1b",
                        "source_sense_id": "48535efa-91f7-3b79-b9d9-58b78a38f647",
                        "source_sense_description": "Femme de la halle",
                        "target_lang_word": "Grobian",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grobian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                        "entry_id": "0a4c2070-35fc-302e-a4df-a49451b9fe68",
                                        "glosses": [
                                            "Mensch, der sich anderen gegenüber ungewohnt grob, rücksichtslos, ruppig verhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69084752-26f8-4dba-8e3a-b9ca736ba5ea",
                                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                                "text": "„Es waren noch weitere Grobiane, Kumpane des ersteren, anwesend.“"
                                            },
                                            {
                                                "example_id": "883ce77c-f701-4120-ab53-0ebfaee8202c",
                                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                                "text": "„Schon in der Hafenkneipe hatte er erkannt, daß ihm John auf der weiten Fahrt in die Arktis das einsame Dasein unter den Grobianen und den ausgemachten Strolchen seiner Besatzung als guter Kamerad erträglich machen konnte.“"
                                            },
                                            {
                                                "example_id": "d48da117-b4af-49e2-99c3-b005f43a09ab",
                                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                                "text": "„Er stürzte sich auf den Grobian und versetzte ihm einen gezielten Faustschlag ins Gesicht, worauf die anderen Männer Laura Leonore losließen, die weinend davonlief.“"
                                            },
                                            {
                                                "example_id": "df1e6a68-0788-47e9-86f8-2f066cbf85f4",
                                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                                "text": "„Pech gehabt, der Grobian war nicht einzuschüchtern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0471be8b-ede1-4c72-87fa-0abb31260f25",
                        "source_entry_id": "31023209-b3fe-3bbc-9b86-faa680a71f1b",
