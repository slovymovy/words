        "fr-extract.jsonl": [
            {
                "entry_id": "794fd81e-2c14-3086-965d-c181983e7685",
                "word": "latinisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "48fe27ff-ab8a-4faf-b072-ebfd80daa012",
                        "entry_id": "794fd81e-2c14-3086-965d-c181983e7685",
                        "tags": [
                            "plural"
                        ],
                        "form": "latinismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64029f52-2418-3239-8943-7db667e0d78f",
                        "entry_id": "794fd81e-2c14-3086-965d-c181983e7685",
                        "glosses": [
                            "Expression, tour de phrase propre à la langue latine, en particulier quand ils sont employés abusivement dans une autre langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e382d3c4-28ea-4e4a-a3d4-e164e395ae96",
                                "sense_id": "64029f52-2418-3239-8943-7db667e0d78f",
                                "text": "Son français est plein de latinismes."
                            },
                            {
                                "example_id": "ef3265ca-0277-4579-9a28-12fa2b286dec",
                                "sense_id": "64029f52-2418-3239-8943-7db667e0d78f",
                                "text": "Mais cet usage de nor est en fait un latinisme, l’auteur l’utilise comme nec en latin, qui peut cumuler les fonctions coordinative et contrastive."
                            },
                            {
                                "example_id": "e5b725ff-f382-4026-8747-1ebc966cdb64",
                                "sense_id": "64029f52-2418-3239-8943-7db667e0d78f",
                                "text": "Au milieu du XVII° siècle, un obscur moraliste s’est attelé à rédiger, dans un castillan truffé de latinismes, des leçons sur l’agencement juridique du trafic social."
                            },
                            {
                                "example_id": "45349aaf-130e-447d-9358-db7d19a983da",
                                "sense_id": "64029f52-2418-3239-8943-7db667e0d78f",
                                "text": "C’était déjà le cas des poètes parnassiens, qui recouraient massivement aux latinismes et aux hellénismes lexicaux, syntaxiques, rhétoriques, insérés dans une forme métrique impeccablement classique."
                            },
                            {
                                "example_id": "b823983a-dde8-4fa1-84d9-d2e174d7a957",
                                "sense_id": "64029f52-2418-3239-8943-7db667e0d78f",
                                "text": "M. Arnold paraissait aussi à l’aise à jongler avec les rapports d’exploitation des domaines de l’île d’Anjouan qu’avec la récurrence des latinismes chez Hölderlin."
                            }
                        ]
                    }
                ],
                "translations": [
