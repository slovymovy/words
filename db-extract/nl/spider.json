                "senses": [
                    {
                        "sense_id": "46e4b44a-4cd6-30e5-bf75-705e670c2851",
                        "entry_id": "942b0932-077f-3755-b95d-b1e5e6d60cad",
                        "glosses": [
                            "programmatuur die stelselmatig de hyperlinks op webpagina's afloopt om een bestand met informatie op te bouwen, zoals een register voor een zoekmachine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e0429e-4ae9-4f93-938e-074988a7e2b7",
                                "sense_id": "46e4b44a-4cd6-30e5-bf75-705e670c2851",
                                "text": "Bij Fonq gebruiken ze Omnia om prijzen zes keer per dag te veranderen. Daarnaast ‘schraapt’ Fonq met spiders informatie over voorraden bij concurrenten bij elkaar."
                            },
                            {
                                "example_id": "403e2381-3262-46a3-b149-8a3f11ed0f2b",
                                "sense_id": "46e4b44a-4cd6-30e5-bf75-705e670c2851",
                                "text": "De meeste zoekmachines hebben een minder afwachtende houding en sturen een spider of crawler op pad om sites aan de databank toe te voegen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e41b2c27-e9ed-3152-9172-053822128b3b",
                        "entry_id": "942b0932-077f-3755-b95d-b1e5e6d60cad",
                        "glosses": [
                            "benaming voor kleine tweepersoons sportwagens zonder vast dak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e80cdbd6-e37a-4525-b74b-723e453940f7",
                                "sense_id": "e41b2c27-e9ed-3152-9172-053822128b3b",
                                "text": "Een spider is ook een auto met een wegvouwbaar dak, maar met twee zitplaatsen en een typisch sportief karakter."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9d86f91-e9e4-3ac0-84ea-ffed783066ef",
                        "entry_id": "942b0932-077f-3755-b95d-b1e5e6d60cad",
                        "glosses": [
                            "benaming voor een licht vierwielig rijtuig"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a058a4cc-c786-4efb-bcc4-a47bb5d2f294",
                                "sense_id": "f9d86f91-e9e4-3ac0-84ea-ffed783066ef",
                                "text": "Bij onze aankomst te Smiths-Crossing wachtte dokter K. ons met de spider (een vierwielig wagentje voor 4 personen) op."
                            },
                            {
                                "example_id": "50db7e85-f2be-49dc-8e20-dbaf80395c1d",
                                "sense_id": "f9d86f91-e9e4-3ac0-84ea-ffed783066ef",
                                "text": "Van Graaf Reynet af werd de reis voortgezet per Amerikaanschen „spider\", een vierwielig, licht, ijzersterk en voor de bergstreken zeer geschikt rijtuig, 'twelk de Afrikaanders „spinnekop\" noemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d7d88f8-2642-34af-9396-1565848af67a",
                        "entry_id": "942b0932-077f-3755-b95d-b1e5e6d60cad",
                        "glosses": [
                            "type kunstaas bestaand uit dunne, beweeglijke uitsteeksels die met een draadje om een haakje zijn gewikkeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936e9962-acdd-4afc-9868-4fa0dba77d50",
                                "sense_id": "0d7d88f8-2642-34af-9396-1565848af67a",
                                "text": "Op de Kyll heb ik ook wel eens met spiders gevist en daar mooie forellen mee gevangen. Hoewel het vissen met een droge vlieg het mooiste blijft, is een aanbeet van een forel op een spider ook heel spectaculair."
                            }
                        ]
                    },
                    {
                        "sense_id": "0366d177-1451-312d-920a-98f9446d2d96",
                        "entry_id": "942b0932-077f-3755-b95d-b1e5e6d60cad",
                        "glosses": [
                            "hulpstuk met een verhoogd uiteinde waarmee een bal van boven kan worden geraakt wanneer er een andere bal voor ligt"
                        ],
                        "tags": [
                            "snooker"
                        ],
                        "examples": [
                            {
                                "example_id": "44521767-9924-4898-a4e1-3cf47413f9bb",
                                "sense_id": "0366d177-1451-312d-920a-98f9446d2d96",
                                "text": "De familie Theunissen praat met vuur over snookersport: \"Als je de bal niet in de pocket kan krijgen, moet je een spider of een rest gebruiker.\""
                            }
                        ]
                    }
                ],
