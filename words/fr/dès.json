                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez vous inscrire à cette formation <w>dès</w> aujourd'hui."
                        },
                        {
                            "text": "Il faut agir rapidement et prendre des mesures adaptées <w>dès</w> maintenant."
