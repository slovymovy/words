                ],
                "senses": [
                    {
                        "sense_id": "42bbdf6b-ca36-3532-8ee7-2778fb5e7d1e",
                        "entry_id": "86198744-6dac-35ed-a526-641d9637f698",
                        "glosses": [
                            "Gegenstand (meist aus Metall oder Plastik), mit dem man einen Mülleimer von oben her verschließen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "368d5403-10e8-4d2d-9630-081a4ac2370b",
                                "sense_id": "42bbdf6b-ca36-3532-8ee7-2778fb5e7d1e",
                                "text": "Nicht jeder Mülleimerdeckel passt auf jeden Mülleimer und auch nicht jeder Mülleimer zu jedem Mülleimerdeckel."
                            },
                            {
                                "example_id": "0df2fda2-25e7-4161-a545-fdb5de155b15",
                                "sense_id": "42bbdf6b-ca36-3532-8ee7-2778fb5e7d1e",
                                "text": "„Eine Nutzerin schreibt: ‚Ich finde es überhaupt nicht super, wenn ich auf dem Klo sitze und mein Chef, der Aufsichtsrat, der süße Typ aus der Marketingabteilung oder sonst ein Kerl im gleichen Raum vor der Kabine steht und meinen Pipi-Geräuschen lauscht, oder dem verräterisch klappernden Mülleimerdeckel, wenn ich einen Tampon wegwerfe.‘“"
                            },
                            {
                                "example_id": "74442a71-d483-4cbc-9a3a-098f17427309",
                                "sense_id": "42bbdf6b-ca36-3532-8ee7-2778fb5e7d1e",
                                "text": "„Mülleimerdeckel werden zu Schutzschilden, auf denen sich auch vorzüglich über die Bühne schlittern lässt, und wuchtige Ölfässer zu gigantischen Siebenmeilenstiefeln, mit dem sich vereint ein Höllenlärm provozieren lässt.“"
                            },
                            {
                                "example_id": "8cb82637-6183-47d9-aced-e3484eec7ee8",
                                "sense_id": "42bbdf6b-ca36-3532-8ee7-2778fb5e7d1e",
                                "text": "„Ungeduldig stürmte er in die Küche, klappte den Mülleimerdeckel hoch und steckte den Kopf samt Oberkörper hinein.“"
                            },
                            {
                                "example_id": "46363379-eace-4d2c-bc8a-85fe652ada4d",
                                "sense_id": "42bbdf6b-ca36-3532-8ee7-2778fb5e7d1e",
                                "text": "„Gegen die anrückenden Suchtrupps aber schickten die Katholiken tagsüber Frauen und Kinder vor, die mit Mülleimerdeckeln lärmten und die Soldaten mit Steinen bombardierten.“"
                            },
                            {
                                "example_id": "b6f1f58e-b416-4010-8173-46a1b98a4d43",
                                "sense_id": "42bbdf6b-ca36-3532-8ee7-2778fb5e7d1e",
                                "text": "„Dann leere ich die Plastiktüte und verteile den Inhalt gleichmäßig auf die oberste Schicht und lasse den Mülleimerdeckel fallen und lege die Plastiktüte wieder in den Abfalleimer zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
