                        "glosses": [
                            "betrekking hebbend op, overeenkomstig de planeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ebf400a-608c-4f01-be3d-25908853fd30",
                                "sense_id": "0b5b2891-bb47-3606-84a0-69a07f61c7f2",
                                "text": "„Als je naar de ecologische kant kijkt, zien we dat zeven van de negen planetaire grenzen zijn overschreden. De redenen daarvoor zijn volstrekt helder: landgebruik, grondstoffengebruik, uitstoot. Ze hebben allemaal te maken met economische activiteit.”"
                            }
                        ]
                    }
