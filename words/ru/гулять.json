                    "sense_definition": "Встречаться с кем-либо, иметь романтические отношения.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relationships_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <w>гуляла</w> с этим парнем ещё в старших классах школы.",
                            "target_lang_translations": {
