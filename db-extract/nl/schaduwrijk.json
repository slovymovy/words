                "senses": [
                    {
                        "sense_id": "363913a5-1548-33d4-8fcd-6a7158e8cb25",
                        "entry_id": "2b5f4628-cc42-3ce2-aee7-8f39f5c88f98",
                        "glosses": [
                            "met veel schaduw (door de aanwezigheid van veel bomen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f580d05b-b6d8-4cfb-94bc-b36f2e74902e",
                                "sense_id": "363913a5-1548-33d4-8fcd-6a7158e8cb25",
                                "text": "De belletjes klonken nog gedempter dan een maand tevoren; overal was het vol, schaduwrijk en dichtbegroeid; en de jonge sparren die hier en daar in het bos stonden konden niets aan de algemene schoonheid afdoen en deelden in de algemene stemming door het groen van hun donzige jonge uitlopers."
                            },
                            {
                                "example_id": "b4ff2235-2118-448b-bcf0-a6bd1f3af932",
                                "sense_id": "363913a5-1548-33d4-8fcd-6a7158e8cb25",
                                "text": "Ze hebben geluk, de bezoekers en de medewerkers van Erve Dondertman aan de Meester Bosweg in Espelo. ,,Onze kinderboerderij ligt in een bosrijke omgeving”, zegt medewerkster Marjan Noteboom. ,,Het is hier heel erg schaduwrijk met weinig zonplekken. Zelfs met deze hitte is het nog draaglijk.”"
                            }
                        ]
                    }
                ],
