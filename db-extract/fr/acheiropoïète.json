                "senses": [
                    {
                        "sense_id": "53dcac96-1e5c-39cd-842e-4d5e72547cc5",
                        "entry_id": "f86e4769-c924-3da4-b9ba-db18d9d13c8b",
                        "glosses": [
                            "Qualifie une image qui ne serait pas produite par la main de l’homme, mais serait d’origine surnaturelle, comme le portrait qu’on peut voir sur le suaire de Turin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a645b015-15aa-45d4-b33b-c63dc12de696",
                                "sense_id": "53dcac96-1e5c-39cd-842e-4d5e72547cc5",
                                "text": "[Jean-Christian Petitfils] C’est une image impressionnante, acheiropoïète (non faite de main d’homme), quasi indélébile, isotrope (c’est-à-dire sans effet directionnel), que l’on n’est jamais parvenu à reproduire, même en laboratoire, par les techniques les plus variées."
                            }
                        ]
                    }
