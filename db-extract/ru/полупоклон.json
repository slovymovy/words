                ],
                "senses": [
                    {
                        "sense_id": "4d72add3-f082-367e-982b-99d05805a391",
                        "entry_id": "821f41a3-d8cf-3ca6-a49a-d00d4cc27f1a",
                        "glosses": [
                            "half-bow (a gesture)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027e996d-8759-4f37-b173-407331330054",
                                "sense_id": "4d72add3-f082-367e-982b-99d05805a391",
                                "text": "Орды́нов и Яросла́в Ильи́ч сде́лали друг дру́гу по полупокло́ну, ка́ждый с своего́ сту́ла и не́сколько на́бок, и о́ба прикры́ли возни́кшее недоуме́ние извини́тельным сме́хом.",
                                "translation": "Ordynov and Yaroslav Ilyitch made each other a half bow, each a little on one side of his chair, and both covered their confusion with an apologetic laugh.",
                                "english": "Ordynov and Yaroslav Ilyitch made each other a half bow, each a little on one side of his chair, and both covered their confusion with an apologetic laugh."
                            },
                            {
                                "example_id": "77643c37-e120-4522-994d-588215bb3305",
                                "sense_id": "4d72add3-f082-367e-982b-99d05805a391",
                                "text": "— Я гото́в извини́ться пе́ред ва́ми, Никола́й Арте́мьевич, — проговори́л он с учти́вым полупокло́ном, — е́сли я вас то́чно че́м-нибудь оби́дел.",
                                "translation": "'I am ready to apologise to you, Nikolai Artemyevitch,' he said with a polite half-bow, 'if I have really offended you in any way.'",
                                "english": "'I am ready to apologise to you, Nikolai Artemyevitch,' he said with a polite half-bow, 'if I have really offended you in any way.'"
                            }
                        ]
                    }
                ],
