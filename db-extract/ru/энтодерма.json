                "senses": [
                    {
                        "sense_id": "7f445868-c030-3b0a-a177-9a333434d203",
                        "entry_id": "d0c40a48-6e21-38fb-896e-276048a8dab6",
                        "glosses": [
                            "биол. внутренний зародышевый листок у многоклеточных животных, из которого образуются кишечный тракт и связанные с ним железы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b40a18-86ac-494b-b10a-43a5ff06d4d0",
                                "sense_id": "7f445868-c030-3b0a-a177-9a333434d203",
                                "text": "Личинка принимает скоро характер настоящей гаструлы и состоит уже из эктодермы — наружного слоя и энтодермы — внутреннего; она имеет форму мешка с отверстием на нижнем конце."
                            }
                        ]
                    },
