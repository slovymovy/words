                                    {
                                        "sense_id": "0361a81a-ec7d-3eaa-bee3-c0d128c7c4bb",
                                        "entry_id": "4f2a4611-acdd-3d74-83a9-8182bb455a5c",
                                        "glosses": [
                                            "To perform this dance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "107d196b-35f6-4f2e-81f5-dd3a2600c8d3",
                                                "sense_id": "0361a81a-ec7d-3eaa-bee3-c0d128c7c4bb",
                                                "text": "You had one eye in the mirror as / you watched yourself gavotte / And all the girls dreamed that they'd be your partner / They'd be your partner, and / You're so vain"
                                            },
                                            {
                                                "example_id": "f253a828-cf88-44d1-b977-660e79c28036",
                                                "sense_id": "0361a81a-ec7d-3eaa-bee3-c0d128c7c4bb",
                                                "text": "\"Upbeat I can do.\" Karen paged through the options for a while, her pretty face tight, jaw clamped shut, then perked up at something she saw and jabbed the buttons like she wanted to speak to their manager. A bright, jangly guitar burst out of the wall speakers. George Harrison's voice announced that contrary to appearances, it was all right. Karen gavotted into the middle of the bar to dance, eyes closed in rapture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
