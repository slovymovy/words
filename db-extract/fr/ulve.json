                "senses": [
                    {
                        "sense_id": "a676bd5b-98b6-3b21-9411-1be24b51a25b",
                        "entry_id": "8d32ac24-66cf-334f-aaf1-55d075a0fb89",
                        "glosses": [
                            "Algue verte appartenant au genre Ulva et dont fait partie - entre autres - la laitue de mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8328bd1e-4dde-4f9b-9746-ed753da8ac1d",
                                "sense_id": "a676bd5b-98b6-3b21-9411-1be24b51a25b",
                                "text": "Il lui nommait les espèces, avec une pédanterie joyeuse (…) les ulves aux feuilles de laitue larges et minces, d’une transparence glauque ; les fucus dentelés."
                            },
                            {
                                "example_id": "ffb06ce2-308c-42c8-9483-cc2db5e06e20",
                                "sense_id": "a676bd5b-98b6-3b21-9411-1be24b51a25b",
                                "text": "Des extraits d’ulve, les ulvanes, sont utilisés dans le secteur des nanotechnologies."
                            },
                            {
                                "example_id": "4b5592ed-ad29-439c-bc6a-65b279db97d5",
                                "sense_id": "a676bd5b-98b6-3b21-9411-1be24b51a25b",
                                "text": "Apparues exceptionnellement tôt dans la saison sur le littoral des Côtes-d’Armor et du Finistère, les proliférations d’ulves ont couvert, en avril et en mai, des superficies trois fois et demie plus importantes que la moyenne depuis 2002."
                            }
                        ]
                    }
