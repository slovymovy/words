        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "479f14bb-622a-392c-8a82-0c0639178f56",
                    "sense_definition": "Used to express strong agreement or confirmation with what has just been said.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interjection_agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"It is a lovely day for a walk.\" \"<w>Indeed</w>, let's go to the park.\"",
                            "target_lang_translations": {
                                "ru": "— Чудесный день для прогулки. — <w>Несомненно</w>, пойдём в парк.",
                                "nl": "\"Het is een heerlijke dag voor een wandeling.\" \"<w>Inderdaad</w>, laten we naar het park gaan.\"",
                                "pl": "„To piękny dzień na spacer.” „<w>Rzeczywiście</w>, chodźmy do parku.”",
                                "de": "„Es ist ein schöner Tag für einen Spaziergang.“ „<w>In der Tat</w>, lass uns in den Park gehen.“",
                                "fr": "« C'est une belle journée pour une promenade. » « <w>En effet</w>, allons au parc. »",
                                "it": "\"È una bella giornata per una passeggiata.\" \"<w>Infatti</w>, andiamo al parco.\"",
                                "cs": "„Je krásný den na procházku.“ „<w>Jistě</w>, pojďme do parku.“",
                                "tr": "\"Yürüyüş için harika bir gün.\" \"<w>Kesinlikle</w>, hadi parka gidelim.\"",
                                "es": "—Es un día maravilloso para dar un paseo. —<w>Desde luego</w>, vayamos al parque.",
                                "zh": "“今天天气真好，适合散步。”“<w>确实如此</w>，我们去公园吧。”"
                            }
                        },
                        {
                            "text": "\"He is a very talented musician.\" \"<w>Indeed</w>!\"",
                            "target_lang_translations": {
                                "ru": "— Он очень талантливый музыкант. — <w>Безусловно</w>!",
                                "nl": "\"Hij is een zeer getalenteerde muzikant.\" \"<w>Inderdaad</w>!\"",
                                "pl": "„On jest bardzo utalentowanym muzykiem.” „<w>W rzeczy samej</w>!”",
                                "de": "„Er ist ein sehr talentierter Musiker.“ „<w>Allerdings</w>!“",
                                "fr": "« C'est un musicien très talentueux. » « <w>Tout à fait</w> ! »",
                                "it": "\"È un musicista di grande talento.\" \"<w>Proprio così</w>!\"",
                                "cs": "„Je to velmi talentovaný hudebník.“ „<w>Skutečně</w>!“",
                                "tr": "\"O çok yetenekli bir müzisyen.\" \"<w>Gerçekten de öyle</w>!\"",
                                "es": "—Es un músico muy talentoso. —¡<w>Por supuesto</w>!",
                                "zh": "“他是一位非常有天赋的音乐家。”“<w>确实</w>！”"
                            }
                        }
                    ],
                    "synonyms": [
                        "absolutely",
                        "certainly",
                        "definitely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения решительного согласия или подтверждения только что сказанного.",
                        "nl": "Gebruikt om sterke instemming of bevestiging uit te drukken met wat zojuist is gezegd.",
                        "pl": "Używane do wyrażenia zdecydowanej zgody lub potwierdzenia tego, co właśnie zostało powiedziane.",
                        "de": "Wird verwendet, um starke Zustimmung oder Bestätigung zu dem gerade Gesagten auszudrücken.",
                        "fr": "Utilisé pour exprimer un accord fort ou une confirmation de ce qui vient d'être dit.",
                        "it": "Usato per esprimere forte accordo o conferma con quanto è appena stato detto.",
                        "cs": "Používá se k vyjádření silného souhlasu nebo potvrzení toho, co bylo právě řečeno.",
                        "tr": "Az önce söylenmiş olan bir söze güçlü bir şekilde katıldığını veya onayladığını belirtmek için kullanılır.",
                        "es": "Se utiliza para expresar un fuerte acuerdo o confirmación con lo que se acaba de decir.",
                        "zh": "用于表示对刚才所说内容的强烈赞同或确认。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несомненно",
