                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641f2963-67eb-4d86-8de1-3b62639e8ca6",
                                "sense_id": "b2a7b444-509d-3ff9-9ba7-95997b48acff",
                                "text": "Ouais, elle avait pas tort la demoiselle, ça commençait à regrouiller."
                            },
                            {
                                "example_id": "7b4a38ba-9ecb-490e-a3ab-35b7aea31170",
                                "sense_id": "b2a7b444-509d-3ff9-9ba7-95997b48acff",
                                "text": "Il m’a tâté les boules, mais il voyait rien, il m’a envoyé faire une échographie, il pensait à une torsion donc m’a conseillé de vite me regrouiller au risque de perdre ma jolie gauche."
                            }
                        ]
                    }
