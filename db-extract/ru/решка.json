                    }
                ],
                "senses": [
                    {
                        "sense_id": "483a9ef0-3d8c-3489-ac2b-d5a76f3796fd",
                        "entry_id": "9f8da191-aeab-304a-b824-1c6b7d272f4e",
                        "glosses": [
                            "разг. сторона монеты с обозначением её номинала, обратная гербовому изображению; решётка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9fb4028-d2dc-4170-9331-1aa685e8a1fa",
                                "sense_id": "483a9ef0-3d8c-3489-ac2b-d5a76f3796fd",
                                "text": "Тот, кому очередь метать, бьёт пятаком об землю, подошвой притопнет в пятак, шаркнет его, поднимает и мечет высоко: орёл или решка?"
                            },
                            {
                                "example_id": "bdb4f369-b128-4b7a-a605-9b26906157a7",
                                "sense_id": "483a9ef0-3d8c-3489-ac2b-d5a76f3796fd",
                                "text": "Серебряный рубль, сверкнув, взлетел вверх и упал к ногам Одинцова. Выпала решка."
                            },
                            {
                                "example_id": "523bf20a-94ca-4e7c-a854-1afa0304393f",
                                "sense_id": "483a9ef0-3d8c-3489-ac2b-d5a76f3796fd",
                                "text": "Как известно из теории вероятностей, которую я со второго захода успешно сдал в Институте водного транспорта, шансы выпадения орла или решки при подкидывании монеты равновероятны и соотносятся как 50:50."
                            },
                            {
                                "example_id": "20ca9fd0-e2d2-42d8-a554-961f8b018b87",
                                "sense_id": "483a9ef0-3d8c-3489-ac2b-d5a76f3796fd",
                                "text": "Если выпадет орёл ― мы победим, если решка ― проиграем."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34cf41a0-48b9-43eb-bbf5-4b0ba1e5223b",
                        "source_entry_id": "9f8da191-aeab-304a-b824-1c6b7d272f4e",
                        "source_sense_id": "483a9ef0-3d8c-3489-ac2b-d5a76f3796fd",
                        "target_lang_word": "reszka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reszka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "03f5006d-2c23-3930-8f68-82680d49243a",
                                        "entry_id": "86a990cf-2cf4-370b-bf1f-13015bdd0e38",
                                        "glosses": [
                                            "strona monety ukazująca często oblicze jakiejś osoby, znak okolicznościowy lub sam nominał monety"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612b9a31-efd5-4389-84be-367382d151d2",
                                                "sense_id": "03f5006d-2c23-3930-8f68-82680d49243a",
                                                "text": "Rzućmy monetą, jak będzie orzeł, to ty wygrywasz, jak reszka, to zrobimy tak, jak ja powiedziałem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
