                            {
                                "example_id": "53dd125e-49c2-4be2-ae59-6dade14346e1",
                                "sense_id": "0753bc75-b9c0-3da7-89ba-0737efb0a99f",
                                "text": "Send succours (lords), and stop the rage betime, Before the wound do grow uncurable; For being green, there is great hope of help.\""
                            },
                            {
                                "example_id": "053c57a3-f16f-4740-a151-27f77d50bec5",
                                "sense_id": "0753bc75-b9c0-3da7-89ba-0737efb0a99f",
                                "text": "Her feature all as fresh aboue, As is the grasse that grows by Doue, as lyth as lasse of Kent: Her skin as soft as Lemster wooll, As white as snow on peakish hull, or Swanne that swims in Trent. 30 This mayden in a morne betime, Went forth when May was in her prime, to get sweet Cetywall, The hony-suckle, the Harlocke, The Lilly and the Lady-smocke, to decke her summer hall."
                            }
                        ]
                    }
