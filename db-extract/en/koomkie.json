                ],
                "senses": [
                    {
                        "sense_id": "ddac2e4f-8345-383e-9e99-28b6332558f0",
                        "entry_id": "128fe232-3f49-3873-8464-647c313d2537",
                        "glosses": [
                            "A tame female elephant used as a decoy in the capture of wild male elephants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ab43be-fcee-445f-8bd1-65aba89efb3b",
                                "sense_id": "ddac2e4f-8345-383e-9e99-28b6332558f0",
                                "text": "When an elephant is in a proper state to be removed from the keddah, he is conducted either by koomkies or by tame males."
                            },
                            {
                                "example_id": "bf012b4b-4f2d-4ef5-822b-356e9f759857",
                                "sense_id": "ddac2e4f-8345-383e-9e99-28b6332558f0",
                                "text": "Though on some occasions the mahouts accompany the koomkies up to the saun, yet it is safer, and generally the most sure and easy mode, for them to dismount in some contiguous cover with their blankets and ropes, leading the koomkies to the saun, towards which they proceed in the most cunning style."
                            },
                            {
                                "example_id": "6cc63bf3-80a3-4d2f-ac7f-c8b8b17ccb10",
                                "sense_id": "ddac2e4f-8345-383e-9e99-28b6332558f0",
                                "text": "The drivers remain concealed at a little distance, while the koomkies surround the goondah, as this sort of elephant is called."
                            },
                            {
                                "example_id": "05ffa0b8-f869-4005-a9cd-c4931255ec2b",
                                "sense_id": "ddac2e4f-8345-383e-9e99-28b6332558f0",
                                "text": "The hunters rode out on their koomkies, supplied with ropes, and other apparatus, for securing their captives."
                            },
                            {
                                "example_id": "91f05663-37e1-44be-b0cd-347b4eba5ad0",
                                "sense_id": "ddac2e4f-8345-383e-9e99-28b6332558f0",
                                "text": "With the aid of koomkies, the captives were driven in batches of three or four into a circular stockade […]"
                            }
                        ]
                    }
                ],
