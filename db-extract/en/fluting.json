                        "sense_id": "5052f141-614b-3d51-ad6f-71810a7459d0",
                        "entry_id": "16ff76bd-afc1-3270-a90f-2b4f70f9570a",
                        "glosses": [
                            "The act of making such grooves."
                        ],
                        "tags": [],
                        "examples": []
