{
    "word_family": [
        "doof",
        "doving",
        "uitdoven",
        "gedoofd"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6bf9ef6f-5bbf-37a2-9a6e-e7ca8e2858a4",
                    "sense_definition": "een vlam of vuur uit doen gaan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweer wist het vuur in het bos heel snel te <w>doven</w>.",
                            "target_lang_translations": {
                                "en": "The fire department managed to <w>extinguish</w> the fire in the forest very quickly."
                            }
                        },
                        {
                            "text": "De kampeerder <w>doofde</w> het kampvuur heel grondig om een bosbrand te voorkomen.",
                            "target_lang_translations": {
                                "en": "The camper <w>put out</w> the campfire very thoroughly to prevent a forest fire."
                            }
                        }
                    ],
                    "synonyms": [
                        "blussen",
                        "uitmaken",
                        "uitgaan"
                    ],
                    "antonyms": [
                        "aansteken",
                        "vlam vatten"
                    ],
                    "common_phrases": [
                        "het vuur doven",
                        "een kampvuur doven"
                    ],
                    "target_lang_definitions": {
                        "en": "to put out or extinguish a flame or fire"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extinguish",
                                "target_lang_sense_clarification": "to stop a fire from burning"
                            },
                            {
                                "target_lang_word": "put out",
                                "target_lang_sense_clarification": "to extinguish a fire or flame"
                            },
                            {
                                "target_lang_word": "quench",
                                "target_lang_sense_clarification": "to put out a fire or light"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13347f76-5b86-32d0-8101-a92578aaeb83",
                    "sense_definition": "een lamp of lichtbron uitdoen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze zeiden niets en <w>doofden</w> de plafondverlichting voordat ze gingen slapen.",
                            "target_lang_translations": {
                                "en": "They said nothing and <w>turned off</w> the ceiling lights before they went to sleep."
                            }
                        },
                        {
                            "text": "Je moet de lichten <w>doven</w> als je de kamer verlaat.",
                            "target_lang_translations": {
                                "en": "You must <w>extinguish</w> the lights when you leave the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitmaken"
                    ],
                    "antonyms": [
                        "aansteken"
                    ],
                    "common_phrases": [
                        "het licht doven",
                        "de lichten doven"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn off or put out a lamp or light source"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extinguish",
                                "target_lang_sense_clarification": "to stop a light from shining"
                            },
                            {
                                "target_lang_word": "turn off",
                                "target_lang_sense_clarification": "to switch off a light"
                            },
                            {
                                "target_lang_word": "put out",
                                "target_lang_sense_clarification": "to douse a light source"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38301cf9-6c1e-3a56-b1cc-5d451c5c7c7b",
                    "sense_definition": "een geluid minder hard of scherp maken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dikke gordijnen hielpen om het lawaai van de straat te <w>doven</w>.",
                            "target_lang_translations": {
                                "en": "The thick curtains helped to <w>muffle</w> the noise from the street."
                            }
                        },
                        {
                            "text": "De muren zijn speciaal gebouwd om de echo in de grote zaal te <w>doven</w>.",
                            "target_lang_translations": {
                                "en": "The walls are specially built to <w>dampen</w> the echo in the large hall."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geluid doven"
                    ],
                    "target_lang_definitions": {
                        "en": "to muffle, dampen, or reduce the intensity of a sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muffle",
                                "target_lang_sense_clarification": "to make a sound quieter or less clear"
                            },
                            {
                                "target_lang_word": "dampen",
                                "target_lang_sense_clarification": "to reduce the intensity of a sound"
                            },
                            {
                                "target_lang_word": "deaden",
                                "target_lang_sense_clarification": "to make a sound less sharp or loud"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee2f5917-f01d-397f-b867-3840c729457a",
                    "sense_definition": "het vermogen om te horen verliezen; <w>doof</w> worden",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gehoor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de jaren heen begon de oude man langzaam te <w>doven</w>.",
                            "target_lang_translations": {
                                "en": "Over the years, the old man slowly began to <w>go deaf</w>."
                            }
                        },
                        {
                            "text": "Het is een zeldzaam proces waarbij patiënten binnen enkele maanden volledig <w>doven</w>.",
                            "target_lang_translations": {
                                "en": "It is a rare process in which patients <w>become</w> completely <w>deaf</w> within a few months."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to lose the ability to hear; to become deaf"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go deaf",
                                "target_lang_sense_clarification": "to lose one's hearing"
                            },
                            {
                                "target_lang_word": "become deaf",
                                "target_lang_sense_clarification": "the process of losing hearing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99f7d27b-2d9f-3433-b31c-b5af4130b147",
                    "sense_definition": "tekeergaan of zich wild en gek gedragen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De menigte begon te <w>doven</w> toen de uitslag van de wedstrijd bekend werd.",
                            "target_lang_translations": {
                                "en": "The crowd began to <w>go wild</w> when the result of the match became known."
                            }
                        },
                        {
                            "text": "Hij stond te <w>doven</w> van woede na de onterechte beschuldiging.",
                            "target_lang_translations": {
                                "en": "He was <w>raging</w> with anger after the false accusation."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Deze betekenis is regionaal of verouderd."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to rage or behave in a wild and crazy manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "to act with great anger or violence"
                            },
                            {
                                "target_lang_word": "go wild",
                                "target_lang_sense_clarification": "to behave in an uncontrolled way"
                            },
                            {
                                "target_lang_word": "carry on",
                                "target_lang_sense_clarification": "to behave in an excited or anxious way"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c31462f-8ab0-3453-bc11-4b0a548043b9",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>dove</w>; mensen die niet kunnen horen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mensen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn speciale scholen voor <w>doven</w> waar ze gebarentaal leren.",
                            "target_lang_translations": {
                                "en": "There are special schools for <w>the deaf</w> where they learn sign language."
                            }
                        },
                        {
                            "text": "De vereniging komt op voor de rechten van <w>doven</w> en slechthorenden.",
                            "target_lang_translations": {
                                "en": "The association stands up for the rights of <w>deaf people</w> and the hard of hearing."
                            }
                        }
                    ],
                    "common_phrases": [
                        "school voor doven",
                        "tolk voor doven"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'deaf person'; people who are unable to hear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the deaf",
                                "target_lang_sense_clarification": "people who cannot hear as a group"
                            },
                            {
                                "target_lang_word": "deaf people",
                                "target_lang_sense_clarification": "individuals who lack the sense of hearing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}