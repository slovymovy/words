                    {
                        "translation_id": "2ef2cfd1-b65f-49bc-b58a-ded4f4cbcae8",
                        "source_entry_id": "3420828d-35d4-3e1c-be8d-a544b386b5d3",
                        "source_sense_description": "the growing together of bones",
                        "target_lang_word": "Ankylose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ankylose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                        "entry_id": "0b5b51b5-6963-3546-8103-17a2c9425c0c",
                                        "glosses": [
                                            "Versteifung eines natürlicherweise beweglichen Gelenks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67760c4e-e2ea-4fe0-9262-6518f7a16c94",
                                                "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                                "text": "„Neben der klinischen Untersuchung liefert die Computertomographie entscheidende Informationen über den Grad und die Ausdehnung der Ankylose insbesondere nach medial, wo sich aufgrund der engen tomographischen Beziehung zu den großen Halsgefäßen und Hirnnerven operationstechnisch besondere Gefährdungen ergeben können.“"
                                            },
                                            {
                                                "example_id": "75be2712-ee3f-404f-8591-9ec88ee8d265",
                                                "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                                "text": "„Eine weitere Stufe entzündungsbedingter Knochenproliferationen bei zerstörtem Gelenk unter Überbrückung desselben führt zur Ankylose.“"
                                            },
                                            {
                                                "example_id": "cbfd5b68-accd-49bd-92d3-f0cae099620f",
                                                "sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                                                "text": "„Bei Ankylose tritt durch eine Verschmelzung zwischen Wurzelelement und Knochen eine unphysiologisch starre Verbindung zwischen Zahn und Zahnhalteapparat ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
