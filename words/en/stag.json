                        {
                            "text": "He spotted a brown <w>stag</w> flitting quickly among the briars.",
                            "target_lang_translations": {
                                "ru": "Он заметил коричневого <w>крапивника</w>, быстро сновавшего среди колючих кустов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Regional bird name"
                        }
                    ],
                    "target_lang_definitions": {
