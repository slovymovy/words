                        "examples": [
                            {
                                "example_id": "b4cb60fb-15d7-46d8-a8e5-2b93166aa0c5",
                                "sense_id": "4ecfcff8-f7a9-387c-9aff-b8b1fb7ad12f",
                                "text": "Van Dijk is de regerend Europees kampioene in de race tegen de klok. Vorige week veroverde ze in Alkmaar voor de vierde keer op rij de titel en zaterdag was ze ook de gangmaakster bij Trek op het lange en flink glooiende parcours."
                            },
                            {
                                "example_id": "64942474-c7fe-4e71-a86c-d2c47bd7b488",
                                "sense_id": "4ecfcff8-f7a9-387c-9aff-b8b1fb7ad12f",
                                "text": "Met meerdere gangmakers en het 'wavelight'-systeem (een lichtsysteem langs de rand van de baan dat het tempo aangeeft) had de organisatie alles gedaan om Hassan wederom naar een toptijd te loodsen."
                            }
                        ]
