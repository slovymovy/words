                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le Vatican constitue le centre spirituel de l'Église catholique <w>romaine</w> depuis des siècles."
