                        "in exceptional cases"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий собой исключение; не обычный, не типичный.",
                        "tr": "Bir istisna oluşturan; sıradan, tipik veya alışılagelmiş olmayan."
                    },
                    "translations": {
