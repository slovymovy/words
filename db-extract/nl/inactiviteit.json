        "nl-extract.jsonl": [
            {
                "entry_id": "945fed67-0f05-3dfe-8814-84f43bbb30bc",
                "word": "inactiviteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                        "entry_id": "945fed67-0f05-3dfe-8814-84f43bbb30bc",
                        "glosses": [
                            "het niet actief zijn; het niet in beweging zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2e4f91-0b87-42fd-9e07-45756850c411",
                                "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                                "text": "Zo moet vanaf 1 januari een filterkoffieapparaat met isolatiekan automatisch afslaan na 1 minuut inactiviteit. Koffieautomaten met warmhoudplaatje mogen langer aanblijven, maar ook daar is een maximum van 40 minuten."
                            },
                            {
                                "example_id": "d62dd2a2-edc3-419f-b179-8e835e91797e",
                                "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                                "text": "Monfils kwam langszij en in de vijfde set op 2-0. Na maanden inactiviteit door blessures én al meer dan elf uur arbeid in Melbourne was toen ook bij hem het beste er wel af."
                            },
                            {
                                "example_id": "1a87c55c-4c69-470f-84f0-cee7a8cc946c",
                                "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                                "text": "Het verbaast de onderzoekers hoe sociaal geaccepteerd het nog is amper te bewegen. \"Inactiviteit wordt gezien als normaal. Dokters schrijven patiënten veel vaker bedrust voor dan dat ze hen aanmoedigen meer te bewegen,\" schrijven ze."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "530f8c34-2ec9-44b1-96b6-b2d60ab4258c",
                        "source_entry_id": "945fed67-0f05-3dfe-8814-84f43bbb30bc",
                        "source_sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                        "source_sense_description": "het niet actief zijn; het niet in beweging zijn",
                        "target_lang_word": "Inaktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inaktivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                                        "entry_id": "a6c0524c-2279-359c-8f0c-6cbfaf9130d8",
                                        "glosses": [
                                            "Eigenschaft/Tatsache, dass kein aktives, vorwärtsschreitendes Verhalten zu sehen ist, sondern Untätigkeit vorliegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c18012fa-4266-4476-80da-297ebb6a44cb",
                                                "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                                                "text": "„Sie versuchen, auch Ihren Alltag so aktiv wie möglich zu gestalten und lange Phasen der Inaktivität und des Sitzens zu vermeiden.“"
                                            },
                                            {
                                                "example_id": "bd94176d-97ec-4b90-9668-acbf5d173779",
                                                "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                                                "text": "Die WHO warnt davor, dass rund 1,4 Milliarden erwachsene Frauen und Männer durch körperliche Inaktivität Krankheiten und Tod riskierten."
                                            },
                                            {
                                                "example_id": "f3aed31a-d9c1-41a6-8eca-9c6714b46d41",
                                                "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                                                "text": "„Das Herabsinken in die Inaktivität ist vor allem bei den Frauen üblich, die nach der Migrationserfahrung wieder Hausfrauen werden. Die angeführten Zahlen zeigen u.a. den (im volkswirtschaftlichen Sinn) geringen produktiven Beitrag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3027568-c59a-325a-8306-0e31571144df",
                                        "entry_id": "a6c0524c-2279-359c-8f0c-6cbfaf9130d8",
                                        "glosses": [
                                            "Unwirksamkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a653d1-1767-4ebe-9abd-f06c2c081856",
                                                "sense_id": "e3027568-c59a-325a-8306-0e31571144df",
                                                "text": "„Diese für gewöhnliche Papiere zu teuere Leimungsart wird namentlich für photographische oder lithographische Papiere empfohlen, wo es auf die Neutralität und chemische Inaktivität der abgelagerten Leimstoffe ankommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "929be25a-1187-32fe-87ea-66a6d6bb1e13",
                                        "entry_id": "a6c0524c-2279-359c-8f0c-6cbfaf9130d8",
                                        "glosses": [
                                            "Ruhezustand des Prozesses, der eine Krankheit bedingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac24446-b5d0-4f46-87a9-2b44edced430",
                                                "sense_id": "929be25a-1187-32fe-87ea-66a6d6bb1e13",
                                                "text": "„Allerdings muß eingeräumt werden, daß eine hormonelle Inaktivität maligner Tumoren der endokrinen Drüsen durchaus nicht ausgeschlossen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b889d115-a418-4fb5-a9c8-b7c0ee2f3baa",
                        "source_entry_id": "945fed67-0f05-3dfe-8814-84f43bbb30bc",
                        "source_sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                        "source_sense_description": "het niet actief zijn; het niet in beweging zijn",
                        "target_lang_word": "Nichtstun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtstun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                        "entry_id": "2d9a7269-3493-3fcd-8624-5f7fb1707a96",
                                        "glosses": [
                                            "Verhalten ohne Aktivität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f08139e-3934-4e5f-a7eb-20e95c66a08e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "Das Unglück liegt in deinem Leben im Nichtstun."
                                            },
                                            {
                                                "example_id": "015af3da-ea34-4e25-8acd-312e47ac7dfa",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Nach drei Tagen Nichtstun und Langeweile wollte er bei den Segelmanövern mithelfen.“"
                                            },
                                            {
                                                "example_id": "9bc74844-1d7b-4aaf-9edd-53a97df6441e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Er legte sich auf eine Waldwiese und genoss das Nichtstun.“"
                                            },
                                            {
                                                "example_id": "a303774d-d915-4619-a8e7-2f8e255eccf7",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Ich blieb drei Wochen bei ihnen und war aufgrund der Prellungen, die ich erlitten hatte, zum Nichtstun verdammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03b2bf89-c130-4dfd-b6cb-0c2daa3c8717",
                        "source_entry_id": "945fed67-0f05-3dfe-8814-84f43bbb30bc",
                        "source_sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                        "source_sense_description": "het niet actief zijn; het niet in beweging zijn",
                        "target_lang_word": "Stillstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stillstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                        "entry_id": "9913e17d-7615-3bfe-90c5-4955e09f0210",
                                        "glosses": [
                                            "Ende einer Bewegung, eines Prozesses/Vorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433cdc29-43da-4cb3-a4bc-107919c75c3c",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "Wegen der Schäden an den Anlagen kam es zu einem Stillstand der Produktion."
                                            },
                                            {
                                                "example_id": "1de5832f-5f64-4224-9d30-72c793204b19",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Tatsächlich war der Zug schon nach wenigen hundert Metern wieder zum Stillstand gekommen, so daß die Frau ihr Buch hatte sinken lassen.“"
                                            },
                                            {
                                                "example_id": "1e8af26a-b6a9-46f1-99a8-3b197fca610a",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„In erster Linie hatte er dafür gesorgt, dass die starke Blutung aus dem Oberschenkel des Halbtoten zum Stillstand kam, und dann den gebrochenen rechten Unterarm stabilisiert.“"
                                            },
                                            {
                                                "example_id": "ed97b5cc-73e0-4eed-8c76-24e5f1c153d7",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Dies schafft auf der einen Seite einen sehr engen gesellschaftlichen Zusammenhang innerhalb einer biraderi-Einheit. Es wirkt aber auf der anderen Seite auch häufig als Blockade und bedingt weitgehenden gesellschaftlichen Stillstand in den ländlichen Regionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
