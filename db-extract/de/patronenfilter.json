                "senses": [
                    {
                        "sense_id": "1d469748-5ebb-36c9-b0f5-70454d3d26c7",
                        "entry_id": "ee2122ca-36ec-3d3b-8366-5231098d34bd",
                        "glosses": [
                            "durchlässige Vorrichtung, Gerät oder Baugruppe zur Trennung oder Aussonderung bestimmter Feststoffe in Filterpatronen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939294ee-194a-4a86-9e30-7004790ff40c",
                                "sense_id": "1d469748-5ebb-36c9-b0f5-70454d3d26c7",
                                "text": "„Patronenfilter bieten eine große Filterfläche auf kleinstem Raum und sind leicht auszutauschen.“"
                            },
                            {
                                "example_id": "ec7f92ae-1ccd-41cf-b83b-0fd5f0398312",
                                "sense_id": "1d469748-5ebb-36c9-b0f5-70454d3d26c7",
                                "text": "„Das Funktionsprinzip der Patronenfilter ist einfach und lässt sich auch im Selbstbau leicht verwirklichen. Patronenfilter sind mechanische und biologische Filter in einem. Allerdings setzen sie leicht zu, wenn zu viele Schmutzpartikel in den Filter gelangen.“"
                            },
                            {
                                "example_id": "153b9e1e-81ce-46c9-991f-39e5343446e7",
                                "sense_id": "1d469748-5ebb-36c9-b0f5-70454d3d26c7",
                                "text": "„Der Patronenfilter fahrbar lässt sich mit umfangreicher Zusatzausstattung ausrüsten, wie beispielsweise einer Start/Stopp-Automatik oder einer Beleuchtung in der Absaughaube.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
