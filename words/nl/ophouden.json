                },
                {
                    "sense_id": "dd49bf45-4061-3e0d-85da-b3f78bd9b429",
                    "sense_definition": "iets in de hoogte houden",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "omhoog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>hield</w> het bordje met haar nummer <w>op</w>.",
                            "target_lang_translations": {
                                "en": "She <w>held up</w> the sign with her number."
                            }
