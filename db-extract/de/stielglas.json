                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5211983-8134-4516-8c90-a7e85241ef2c",
                                "sense_id": "6cd89de5-6c15-34d5-b197-dc2bc95a0151",
                                "text": "„Eine Karaffe mit Wein und eine weitere mit Wasser stehen auf dem vergoldeten Möbelstück, zusammen mit einem halb ausgetrunkenen Stielglas.“"
                            },
                            {
                                "example_id": "3889f508-0fa9-474a-9e86-0f922b61c487",
                                "sense_id": "6cd89de5-6c15-34d5-b197-dc2bc95a0151",
                                "text": "„Der Barkeeper nickte, stellte ihr kurz darauf ein Stielglas mit tiefrotem Inhalt hin.“"
                            }
                        ],
