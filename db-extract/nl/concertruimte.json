                "senses": [
                    {
                        "sense_id": "183b021d-3977-3afc-aaf3-6fa3cc3a573e",
                        "entry_id": "0f63b188-9ca8-350a-b29e-e3d623fba95d",
                        "glosses": [
                            "zaal voor een muziekuitvoering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "326aaf52-38b7-4866-b011-74db6fdb0ca5",
                                "sense_id": "183b021d-3977-3afc-aaf3-6fa3cc3a573e",
                                "text": "„Als orkest wil je het liefst dat je repetitieruimte in klank aansluit op je concertruimte”, zegt Streevelaar. „Maar wij geven symfonische concerten in, meestal, het Concertgebouw en we begeleiden opera’s in de orkestbak van Het Muziektheater."
                            },
                            {
                                "example_id": "79a58fa2-9c09-4abc-9022-2a47ca5170d3",
                                "sense_id": "183b021d-3977-3afc-aaf3-6fa3cc3a573e",
                                "text": "Amsterdam heeft sinds kort een nieuwe concertruimte: in de kelder van het Trouwgebouw, waar vroeger de kranten gedrukt werden, passen genoeg mensen om van een volwaardige concertzaal te spreken."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7006724-1fec-33af-8f46-408febc46758",
                        "entry_id": "0f63b188-9ca8-350a-b29e-e3d623fba95d",
                        "glosses": [
                            "afgebakend gebied buiten waar een muziekuitvoering wordt verzorgd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fae3294f-9640-4e1d-beae-c919b6a62f3e",
                                "sense_id": "e7006724-1fec-33af-8f46-408febc46758",
                                "text": "Te zien is hoe mensen hurken in een grote tent die toegang bood tot de concertruimte nabij de Mandalay Bay- en Luxor Casino-hotels. Op het open veld zelf, waar volgens ABC meer dan 10.000 mensen dicht opeengepakt stonden, maken mensen zich zo plat mogelijk op de grond of proberen gebukt weg te rennen."
                            },
                            {
                                "example_id": "3546cfd8-1a5b-46a5-869b-3c7d5efa695a",
                                "sense_id": "e7006724-1fec-33af-8f46-408febc46758",
                                "text": "Vier boten met elk vijfentwintig fluitisten, een slagwerker en een dirigent voeren door de grachten, onderweg begeleid door draaiorgels, fanfarebands en carillons. Urenlang fungeerden de grachten als een reusachtige concertruimte."
                            }
                        ]
                    }
