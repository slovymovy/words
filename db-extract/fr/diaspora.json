        "fr-extract.jsonl": [
            {
                "entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                "word": "diaspora",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f6a345f1-46be-4534-b7df-aed2a5037756",
                        "entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                        "tags": [
                            "plural"
                        ],
                        "form": "diasporas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ab3edea-ad25-3e21-ac7a-d4cd1f54c595",
                        "entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                        "glosses": [
                            "Communauté juive installée dans un pays quelconque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96bb76b-81fe-4565-8350-fa1344312b6e",
                                "sense_id": "7ab3edea-ad25-3e21-ac7a-d4cd1f54c595",
                                "text": "Tyr et Damas se remplissaient de Juifs, et rivalisaient presque, pour l’importance de leur diaspora, avec Antioche et Alexandrie."
                            },
                            {
                                "example_id": "d16a6e28-30e6-468a-ac23-b8813636eb82",
                                "sense_id": "7ab3edea-ad25-3e21-ac7a-d4cd1f54c595",
                                "text": "Qu'il sonne à la porte, il se frotterait à Papa, essuierait une bordée de hurlements, car mon père, en sioniste fanatique, abhorrait tout ce qui ressemblait de près ou de loin à la Diaspora comme les gardeuses d'oie, les pogroms et les marieurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "f81a5033-9a94-384d-b1b8-31003d7f0840",
                        "entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                        "glosses": [
                            "(Antiquité) Dispersion à travers le monde, des Juifs du Proche-Orient. Cette population elle-même."
                        ],
                        "tags": [],
                        "note": "Sans adjectif, on l’écrit souvent avec une majuscule",
                        "examples": [
                            {
                                "example_id": "fd738335-5e81-4a83-8c86-ac16c0533f0d",
                                "sense_id": "f81a5033-9a94-384d-b1b8-31003d7f0840",
                                "text": "La galout est une déportation à laquelle on ne peut mettre fin par soi-même, alors que la diaspora est diffusion, dissémination."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea212d32-447a-3b0e-8c2f-b0d88ee117d7",
                        "entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                        "glosses": [
                            "Dispersion d’une partie d’un peuple à travers le monde."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9a83a561-0cb8-44c0-92f7-7bfe450e67ae",
                                "sense_id": "ea212d32-447a-3b0e-8c2f-b0d88ee117d7",
                                "text": "La diaspora arménienne a précédé le génocide de 1915."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ff56a94-554a-327b-ab95-d2fb18d22cca",
                        "entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                        "glosses": [
                            "Population organisée en communauté et fidèle à ses traditions, installée à l’étranger."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "187ad026-990f-4654-9ae5-4cd8d327de5a",
                                "sense_id": "4ff56a94-554a-327b-ab95-d2fb18d22cca",
                                "text": "La diaspora bretonne (à Paris, au Québec), la diaspora malienne, iranienne, etc."
                            },
                            {
                                "example_id": "34beb2b4-90b5-4e73-8962-792d4e6f0256",
                                "sense_id": "4ff56a94-554a-327b-ab95-d2fb18d22cca",
                                "text": "Onze ans plus tard, le tremblement de terre de magnitude 7,2 sur l’échelle de Richter vient ranimer un souvenir encore bien douloureux pour le peuple haïtien ainsi que sa diaspora."
                            },
                            {
                                "example_id": "75b1b214-ea5a-4398-a82b-e55efae4765a",
                                "sense_id": "4ff56a94-554a-327b-ab95-d2fb18d22cca",
                                "text": "Les diasporas composent l’une des formes de relations sociales qui laisse imaginer les modalités en émergence de notre rapport au monde, tant du point de vue de la relation à l’Autre que du lien à l’État."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47bfae95-d5ed-4892-afe7-7dcbd8eca096",
                        "source_entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                        "target_lang_word": "Diaspora",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diaspora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42bbcb3c-0804-354f-b872-1402cf7521a0",
                                        "entry_id": "eea23b95-4d18-3a4f-8009-3c8f812f87f7",
                                        "glosses": [
                                            "Gebiet, in dem eine konfessionelle oder nationale Minderheit ansässig ist und dort von einer Mehrheit aus Andersgläubigen oder aus Personen mit anderer Nationalität umgeben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb17a46-35bb-4be6-bde1-8df16cf9331c",
                                                "sense_id": "42bbcb3c-0804-354f-b872-1402cf7521a0",
                                                "text": "Sie kamen aus der Diaspora zurück."
                                            },
                                            {
                                                "example_id": "eaab78bd-a9d3-4c2b-a1eb-d6e5ecf81b72",
                                                "sense_id": "42bbcb3c-0804-354f-b872-1402cf7521a0",
                                                "text": "Der aus Franken stammende Professor sieht Norddeutschland als Diaspora an, wo er kaum andere Süddeutsche antrifft."
                                            },
                                            {
                                                "example_id": "f6da0398-0fc0-4a1f-a33c-30307f206cd6",
                                                "sense_id": "42bbcb3c-0804-354f-b872-1402cf7521a0",
                                                "text": "„In den Zehn Geboten ist sie festgeschrieben, und immer hat eine strikte Endogamie sie aufrecht erhalten, hat seit der Vertreibung aus Palästina dafür gesorgt, dass die Diaspora nicht zu einer Zerstreuung der Juden im wörtlichen Sinne wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32527fcd-0a57-323d-805c-704d89a7a188",
                                        "entry_id": "eea23b95-4d18-3a4f-8009-3c8f812f87f7",
                                        "glosses": [
                                            "konfessionelle oder nationale Minderheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b90242fd-ddc6-45fa-a2fc-84012239d2ae",
                                                "sense_id": "32527fcd-0a57-323d-805c-704d89a7a188",
                                                "text": "Schauen wir auf Deutschlands Verhältnis zur Diaspora, den außerhalb Israels lebenden Juden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff6e3a05-1eff-4da8-9b0d-580d7b9af55d",
                        "source_entry_id": "4e28051d-bd43-312a-a3c7-2925293c345b",
                        "target_lang_word": "diaspora",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diaspora",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f080d5-4610-3872-af12-1f09b231ef90",
                                        "entry_id": "4c5a096c-52a5-3e23-b5f6-cb3a2f8b7ebb",
                                        "glosses": [
                                            "The dispersion of a group in a manner comparable to that of the Jews among the Gentiles after the Babylonian captivity (6th century BCE)."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6973125c-61b7-43dc-9acd-6f3ac92c363c",
                                                "sense_id": "11f080d5-4610-3872-af12-1f09b231ef90",
                                                "text": "The African diaspora caused a melding of cultures, both African cultures and Western ones, in many places."
                                            },
                                            {
                                                "example_id": "7b3fc310-ae3b-495f-99f6-698a5e24ec68",
                                                "sense_id": "11f080d5-4610-3872-af12-1f09b231ef90",
                                                "text": "This scattering abrode of the Iewes, as it were an heauenly sowing, fell out after their returne from the captiuitie of Babylon. Wherevpon both Acts. 2. and also 1. Pet. 1. and 1. Iam. ver. 1. [sic] they are called Diaspora, that is, a scattering or sowing abrode."
                                            },
                                            {
                                                "example_id": "19636250-1e7b-40ed-b97e-abfc29121aaa",
                                                "sense_id": "11f080d5-4610-3872-af12-1f09b231ef90",
                                                "text": "We're going to use her to train young people in the skills of maintaining these machines, and encourage the Indian diaspora in this country to get involved in our hobby of steam railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e906803-f252-3ce9-8e0a-43eed487e864",
                                        "entry_id": "4c5a096c-52a5-3e23-b5f6-cb3a2f8b7ebb",
                                        "glosses": [
                                            "Jews outside of the land of Israel."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48d9fb2a-a574-3866-b844-c0bce8698022",
                                        "entry_id": "4c5a096c-52a5-3e23-b5f6-cb3a2f8b7ebb",
                                        "glosses": [
                                            "The regions where such a dispersed group (especially the Jews) resides, taken collectively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e6a8841-ce47-460c-9f9e-3dcf8b95432c",
                                                "sense_id": "48d9fb2a-a574-3866-b844-c0bce8698022",
                                                "text": "Jews in the diaspora often have a different perspective on anti-Semitism than Israeli Jews."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cada8d60-0809-3e9f-bc94-c2bbef8f3f67",
                                        "entry_id": "4c5a096c-52a5-3e23-b5f6-cb3a2f8b7ebb",
                                        "glosses": [
                                            "Any dispersion of an originally homogeneous entity, such as a language or culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d327ade-da27-4cbb-a835-2473f2fd44ab",
                                                "sense_id": "cada8d60-0809-3e9f-bc94-c2bbef8f3f67",
                                                "text": "Small wonder that there should have been in recent years fresh talk of the diaspora of English into several mutually incomprehensible languages"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
