                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der erfahrene <w>Leger</w> verlegte die schweren Bodenfliesen im Flur sehr sauber.",
                            "target_lang_translations": {
                                "en": "The experienced <w>layer</w> laid the heavy floor tiles in the hallway very neatly."
                            }
