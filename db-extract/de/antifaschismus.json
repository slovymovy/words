                                "target_senses": [
                                    {
                                        "sense_id": "70bc75e7-0690-3723-b148-78fa7e2e2885",
                                        "entry_id": "396276d2-484b-36a5-8267-5a40c312b2e7",
                                        "glosses": [
                                            "movimento ideologico e politico di lotta contro il fascismo, comprensivo non solo di tutta la sinistra estrema e moderata ma anche della destra moderata"
                                        ],
