                                            {
                                                "example_id": "4a784fe7-b619-4875-80c8-4c204428ad06",
                                                "sense_id": "9cb2d33c-d635-36d5-9a01-9415badb02cf",
                                                "text": "De echtgenote van Filips de Schone werd waanzinnig na de dood van haar man in 1506 en overleefde hem tot 1555."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e8edf0a-b33a-377c-98c1-c985a985a1ad",
                                        "entry_id": "58bcff7a-1c20-30a0-8d2c-52de6ae3f992",
                                        "glosses": [
                                            "geweldig, indrukwekkend"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dabfbec-628c-4cc4-a6e9-8933fd906edb",
                                                "sense_id": "5e8edf0a-b33a-377c-98c1-c985a985a1ad",
                                                "text": "Dat zijn waanzinnige schoenen."
                                            },
                                            {
                                                "example_id": "1f80f0f9-d338-415a-bcfb-1c78fca44fed",
                                                "sense_id": "5e8edf0a-b33a-377c-98c1-c985a985a1ad",
                                                "text": "‘De hele trail is aangelegd en geschikt voor paarden, nooit te steil, echt waanzinnig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19764b40-f4c0-3cfb-b5f1-e47e64ac9f8a",
                                        "entry_id": "58bcff7a-1c20-30a0-8d2c-52de6ae3f992",
                                        "glosses": [
                                            "heel erg"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7c68e9d-95be-4f66-8d03-74e5f1fda823",
                                                "sense_id": "19764b40-f4c0-3cfb-b5f1-e47e64ac9f8a",
                                                "text": "Onevenwichtige liefde Rutte-Trump waanzinnig pijnlijk om naar te kijken."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waanzinnig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "41d6da09-029b-388b-93b1-a891d3be51eb",
                                        "entry_id": "1e319abe-e607-3de0-9b61-9d9976230da5",
                                        "glosses": [
                                            "heel erg, zeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f29899f2-c2e9-43cf-a107-3cd575d1256c",
                                                "sense_id": "41d6da09-029b-388b-93b1-a891d3be51eb",
                                                "text": "Hij is waanzinnig lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d24e9e66-b5cc-4d6d-860e-4914b1eaa194",
                        "source_entry_id": "6078fd25-121b-3946-84be-ab553000fc6f",
                        "source_sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                        "source_sense_description": "Translations",
                        "target_lang_word": "schandalig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schandalig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b70fba22-7b1d-3a99-a473-4b91c9289aeb",
                                        "entry_id": "4248a311-03a4-3d65-ac08-5d745f141035",
                                        "glosses": [
                                            "waarvan schande gesproken kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d97f681-f609-4bc8-9239-12b51d515ef1",
                                                "sense_id": "b70fba22-7b1d-3a99-a473-4b91c9289aeb",
                                                "text": "Veel mensen vinden die wet in Florida die toestaat mensen overhoop te schieten als je maar beweert dat je je bedreigd voelde een schandalige zaak."
                                            },
                                            {
                                                "example_id": "bbf7954a-9d45-463d-8564-0992fd70ed7a",
                                                "sense_id": "b70fba22-7b1d-3a99-a473-4b91c9289aeb",
                                                "text": "Met de zalvende domineeswoorden dat zijn tafel voor iedereen is en dat iedereen daar zijn verhaal mag doen. Op een ding had de redactie niet gerekend: dat Douwes bleef zitten. Slim, vond ik. Want zo kon ze ons kijkers haarfijn uitleggen op welke schandalige wijze ze genaaid werd door Twan en zijn redactie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6902d101-d3ef-428d-8489-ec3c9fd603c4",
                        "source_entry_id": "6078fd25-121b-3946-84be-ab553000fc6f",
                        "source_sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                        "source_sense_description": "Translations",
                        "target_lang_word": "outrageusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outrageusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb39500f-092a-3481-bf1b-1e1734e39d04",
                                        "entry_id": "189580aa-d364-3344-95a2-7fab0871a3fe",
                                        "glosses": [
                                            "D’une manière outrageuse, avec outrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "682b8f75-6b58-4c4f-9f67-9f79cd2ad208",
                                                "sense_id": "fb39500f-092a-3481-bf1b-1e1734e39d04",
                                                "text": "Il leur envoya ensuite un second serviteur ; mais ils le battirent encore, et l’ayant traité outrageusement, ils le renvoyèrent sans lui rien donner."
                                            },
                                            {
                                                "example_id": "ec905f61-a30a-4196-8969-8e9e1f3b2921",
                                                "sense_id": "fb39500f-092a-3481-bf1b-1e1734e39d04",
                                                "text": "L’empereur se mit en colère, et, le chargeant de la perte du dernier combat, lui reprocha outrageusement son peu de conduite ou son peu de cœur, […]"
                                            },
                                            {
                                                "example_id": "77dee809-d1b0-4018-a4c1-a848ae9f70fe",
                                                "sense_id": "fb39500f-092a-3481-bf1b-1e1734e39d04",
                                                "text": "— Il [un billet] était cacheté d’une épingle qui l’a outrageusement piqué, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bb4caaf-289b-366d-9ee3-9cb2110f64a1",
                                        "entry_id": "189580aa-d364-3344-95a2-7fab0871a3fe",
                                        "glosses": [
                                            "D’une manière violente ou excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b564295-3694-417c-b85e-f9026cb64b1b",
                                                "sense_id": "9bb4caaf-289b-366d-9ee3-9cb2110f64a1",
                                                "text": "Au milieu, un poêle en faïence qui fumait outrageusement et dans le fourneau duquel une vieille femme accroupie cuisinait quelque mets mal odorant."
                                            },
                                            {
                                                "example_id": "d7fa8675-86c7-4470-843f-9f1c531a5fcd",
                                                "sense_id": "9bb4caaf-289b-366d-9ee3-9cb2110f64a1",
                                                "text": "Le père Payen fut volé l’autre jour, et battu outrageusement à la tête ; on ne croit pas qu’il en réchappe, […]"
                                            },
                                            {
                                                "example_id": "7925dd2a-4586-4ca1-97df-33a41167d4b1",
                                                "sense_id": "9bb4caaf-289b-366d-9ee3-9cb2110f64a1",
                                                "text": "Pour moi, je leur crierai dans les oreilles qu’ils seront danmés s’ils me volent : j’imiterai ce curé de campagne qui, ayant été outrageusement volé par ses ouailles, leur dit à son prône : « Je ne sais à quoi pensait Jésus-Christ de mourir pour des canailles comme vous. »"
                                            },
                                            {
                                                "example_id": "dc8334c5-511a-4adf-acde-445c400b4a2c",
                                                "sense_id": "9bb4caaf-289b-366d-9ee3-9cb2110f64a1",
                                                "text": "Ce monsieur de Cossé, seul, dérange la fête.\nComment te semble-t-il ?\n– Outrageusement bête."
                                            },
                                            {
                                                "example_id": "8714b569-f614-4b8d-8fdd-c78260738ad4",
                                                "sense_id": "9bb4caaf-289b-366d-9ee3-9cb2110f64a1",
                                                "text": "Les équipiers de Jonathan Sexton (qui est devenu comeilleur marqueur du Tournoi) pourront tenter le Grand Chelem à domicile, face à l’Angleterre — outrageusement balayée par la France, samedi (10-53)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4246861-2a1c-424d-81cb-bd3134ded5b1",
                        "source_entry_id": "6078fd25-121b-3946-84be-ab553000fc6f",
                        "source_sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                        "source_sense_description": "Translations",
                        "target_lang_word": "scandaleusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scandaleusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                        "entry_id": "8ec1ef65-0af7-3e88-a053-5cb2e7b1b492",
                                        "glosses": [
                                            "D’une manière scandaleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ead9e4-533e-4345-8598-1220a3228f71",
                                                "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                                "text": "Trahir scandaleusement la grandeur de sa maison,"
                                            },
                                            {
                                                "example_id": "cace407d-b4fe-408d-8a41-0c79537dbc74",
                                                "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                                "text": "On continue toujours à blâmer un peu la sagesse des juges, qui a fait tant de bruit [dans l’affaire des poisons], et nommé scandaleusement de si grands noms, pour si peu de chose,"
                                            },
                                            {
                                                "example_id": "533291ce-7fa2-4565-9cd5-37c93dab1c84",
                                                "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                                "text": "La fauvette, vive et gaie, n'en est ni moins aimante, ni moins fidèlement attachée ; et la tourterelle, triste et plaintive, n'en est que plus scandaleusement libertine,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
