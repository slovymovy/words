                        {
                            "text": "They placed the small lotus candles <w>afloat</w> the sacred river.",
                            "target_lang_translations": {
                                "zh": "他们将小莲花蜡烛<w>漂浮在</w>圣河之上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "漂浮在……之上。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漂浮在",
