                "senses": [
                    {
                        "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                        "entry_id": "f5ed278d-3af5-3ee5-8a02-2689786a3f7b",
                        "glosses": [
                            "großartig, hervorragend, besonders gut"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0280b861-f12a-4954-83ee-e7845136de0d",
                                "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                                "text": "Das Konzert war echt supi."
                            },
                            {
                                "example_id": "07e2e029-e561-4520-8cd5-54d88ee96a17",
                                "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                                "text": "Er hat mir ein supi Angebot gemacht."
                            },
                            {
                                "example_id": "804774cb-65ba-45c6-b7e2-eab57429bcbd",
                                "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                                "text": "Es ist supi von dir, dass du mitkommst."
                            },
                            {
                                "example_id": "de3299d8-7f33-4f78-998f-324e1a8a4de1",
                                "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                                "text": "Meiner Schwester gefällt es supi im Wohnheim."
                            },
                            {
                                "example_id": "dc89d15b-0175-42ae-a7e6-af5cbcecc73f",
                                "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                                "text": "Alles supi, oder was?"
                            },
                            {
                                "example_id": "9ccdc868-bb3a-47cd-954b-5eaf6e4458c4",
                                "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                                "text": "Wer das normale \"supi\" noch toppen möchte, kann zu \"echt supi\", \"voi supi\" oder gar \"voi voi supi\" greifen (\"supi\" fügt sich hervorragend in viele Dialekte ein!)."
                            },
                            {
                                "example_id": "65e4dfd5-10ea-4d11-b6a6-94c830052415",
                                "sense_id": "f0803731-69ac-3367-b5a5-5e29b6634b9a",
                                "text": "Ebenso macht das Wort „supi“ weniger als indeklinables Adjektiv von sich reden denn als Diagnose des Bildungsfernen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
