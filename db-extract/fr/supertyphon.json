                "senses": [
                    {
                        "sense_id": "643024a6-2757-32bc-8277-b348e6b85680",
                        "entry_id": "988d4301-a8c8-3491-9780-a395f0353e8c",
                        "glosses": [
                            "Typhon avec des vents qui peuvent souffler à plus de 241 km/h (150 miles par heure)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00673054-2898-404a-b738-62b5b7167dc3",
                                "sense_id": "643024a6-2757-32bc-8277-b348e6b85680",
                                "text": "Ce week-end, à la rencontre d’eaux particulièrement chaudes, la « jeune fille » s’est développée en supertyphon de catégorie 5 sur l’échelle de Saffir-Simpson, avec des rafales à 300 km/h à proximité de l’œil."
                            },
                            {
                                "example_id": "6d0234b7-6493-4e86-ab7d-9c640019de69",
                                "sense_id": "643024a6-2757-32bc-8277-b348e6b85680",
                                "text": "Son renforcement a été rapide mardi dernier, puisque c’était même un supertyphon, le deuxième après Sanba, avec des pointes à 295 km/h et une houle cyclonique de près de 10 m !"
                            },
                            {
                                "example_id": "6f79d546-0c2f-4aea-9e73-7543540bf2d5",
                                "sense_id": "643024a6-2757-32bc-8277-b348e6b85680",
                                "text": "Le supertyphon a commencé à infliger des vents violents et de fortes pluies que l’île principale de Luçon, très peuplée."
                            }
                        ]
                    }
                ],
