                ],
                "senses": [
                    {
                        "sense_id": "1d1c5af1-3d71-3f1c-a7ab-baa8939ca0ad",
                        "entry_id": "7d3ea568-76f1-3a9c-b9f8-7a21fdfcc997",
                        "glosses": [
                            "разг. уменьш.-ласк. к заяц"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e008f722-88bf-4be8-956a-a03f4c251028",
                                "sense_id": "1d1c5af1-3d71-3f1c-a7ab-baa8939ca0ad",
                                "text": "Шагал Дед Мороз по дороге, а зайчик в мешке у него сидел."
                            }
                        ]
                    },
                    {
                        "sense_id": "71276758-e07a-3cca-bdf3-2422e8cd0f2e",
                        "entry_id": "7d3ea568-76f1-3a9c-b9f8-7a21fdfcc997",
                        "glosses": [
                            "разг. пятно света (обычно отражённого)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af857b2c-9d21-4954-a5a3-19c4145650e9",
                                "sense_id": "71276758-e07a-3cca-bdf3-2422e8cd0f2e",
                                "text": "Он стукнул кулаком по столу так, что заколебалась вода в бронзовой полоскательнице и светлые зайчики, выпорхнув из неё, заметались по скатерти."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec9c9f4a-fd41-38e0-a824-65c9e28fffad",
                        "entry_id": "7d3ea568-76f1-3a9c-b9f8-7a21fdfcc997",
                        "glosses": [
                            "перен. ласк."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ee6c5c-8c93-47f7-87e9-dbeceacdaf82",
                                "sense_id": "ec9c9f4a-fd41-38e0-a824-65c9e28fffad",
                                "text": "Нарожали внуков и увезли их с собой в Москву. Зайчиков моих."
                            }
                        ]
                    },
                    {
                        "sense_id": "87a3557d-64a5-3a76-b653-74fe1d423b4c",
                        "entry_id": "7d3ea568-76f1-3a9c-b9f8-7a21fdfcc997",
                        "glosses": [
                            "истор., разг. купюра достоинством в один белорусский рубль (изъята из обращения 1 января 2001)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
