                ],
                "senses": [
                    {
                        "sense_id": "0d8c0b15-8ff9-318f-b293-28ffe030e90e",
                        "entry_id": "e7daa99f-87a6-3eb4-970b-c4670c6ceacd",
                        "glosses": [
                            "Soldat, der nicht an der Front kämpft, sondern im Hinterland dient"
                        ],
                        "tags": [
                            "derogatory",
                            "military",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d671d5e0-1413-4705-a581-f2c2fb2b597d",
                                "sense_id": "0d8c0b15-8ff9-318f-b293-28ffe030e90e",
                                "text": "„Sein Band ‚Hitlers erster Krieg‘* geht aber noch weit hinaus über die quellengestützte Kritik an der Selbstdarstellung des NSDAP-Chef, über seine Entlarvung als Etappenhengst statt Frontschwein und über die Feststellung, dass Hitler erst 1919 in München zum radikalen Antisemiten wurde.“"
                            },
                            {
                                "example_id": "c553a760-de8d-49e4-9c72-d509f8a7e5fd",
                                "sense_id": "0d8c0b15-8ff9-318f-b293-28ffe030e90e",
                                "text": "„Sie redet sehr schnell und verspricht sich so reizend dabei, weil sie noch schneller denkt als redet, und sie kennt die ganzen Codewörter, die im US-Militär den Frontstrategen vom Etappenhengst trennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
