        "fr-extract.jsonl": [
            {
                "entry_id": "299e954e-4776-3acf-bca3-d733d57fd730",
                "word": "calvitie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4e527a81-64d9-40c0-a0ac-0dc7c099257f",
                        "entry_id": "299e954e-4776-3acf-bca3-d733d57fd730",
                        "tags": [
                            "plural"
                        ],
                        "form": "calvities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "886e3f6a-c7f4-33e6-9e10-4a1f2cac7114",
                        "entry_id": "299e954e-4776-3acf-bca3-d733d57fd730",
                        "glosses": [
                            "État de ce qui est chauve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "609e3510-a8df-4ec3-a202-eb5e7a564340",
                                "sense_id": "886e3f6a-c7f4-33e6-9e10-4a1f2cac7114",
                                "text": "La Vierge aux paupières endolories écartait la main gauche en un geste rapace, tandis que l’autre main se crispait, avec des doigts surprotecteurs, sur un enfant agenouillé (à la forte calvitie frontale) qui priait, béni à distance par un autre chérubin, lequel s’appuyait à un androgyne au regard louche et à la bouche pincée, tendant, sans aucun souci des convenances, un index indécent en direction de son vis-à-vis."
                            },
                            {
                                "example_id": "6c18c75a-dc05-4a28-bc67-19766fbe85e0",
                                "sense_id": "886e3f6a-c7f4-33e6-9e10-4a1f2cac7114",
                                "text": "Comme une antithèse à cette abondance de poil mentonnier, une calvitie précoce avait dégarni son front."
                            },
                            {
                                "example_id": "0cffe7f6-e976-47af-ab8c-7f1713ce5254",
                                "sense_id": "886e3f6a-c7f4-33e6-9e10-4a1f2cac7114",
                                "text": "Rasé, en sabots et rêche tenue verdâtre, avec casquette de cuir coiffant sa calvitie, il passa de l’absinthe à l’abstinence, du péquet au piquet, de l’éthylisme à l’ascétisme."
                            },
                            {
                                "example_id": "5948aa18-0b03-4523-a1c1-52f4be9db798",
                                "sense_id": "886e3f6a-c7f4-33e6-9e10-4a1f2cac7114",
                                "text": "Sa barbe de trois jours et sa calvitie prononcée le vieillissnte …."
                            },
                            {
                                "example_id": "427d92e6-4d14-4d5f-96e8-11082b77bdf1",
                                "sense_id": "886e3f6a-c7f4-33e6-9e10-4a1f2cac7114",
                                "text": "Calvitie des paupières, absence des cils qui bordent les paupières."
                            }
                        ]
                    },
                    {
                        "sense_id": "dac1e911-d2b6-3180-beb3-e9bd9b9ab770",
                        "entry_id": "299e954e-4776-3acf-bca3-d733d57fd730",
                        "glosses": [
                            "Partie dénuée de cheveux située sur le dessus du crâne, fréquente chez les hommes à partir d'un certain âge."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09a937b1-d740-413c-aeac-e34e2bbf3763",
                        "source_entry_id": "299e954e-4776-3acf-bca3-d733d57fd730",
                        "target_lang_word": "Glatze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glatze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbd7f51-7657-3126-914e-0ee64da63323",
                                        "entry_id": "04246649-238c-347f-a4c9-3f7b9ee43391",
                                        "glosses": [
                                            "haarlose Stelle des normalerweise behaarten Teils des Kopfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1b0462-02ca-4879-9e09-82751df46d6c",
                                                "sense_id": "cbbd7f51-7657-3126-914e-0ee64da63323",
                                                "text": "Seit ich ihn kenne, hat unser Pfarrer eine Glatze."
                                            },
                                            {
                                                "example_id": "aa892162-3f2b-43df-a37c-c85148bd134a",
                                                "sense_id": "cbbd7f51-7657-3126-914e-0ee64da63323",
                                                "text": "„Auf seiner Glatze glitzerten Schweißperlen, doch falls er sie spürte, störten sie ihn nicht.“"
                                            },
                                            {
                                                "example_id": "b56d29a7-662d-48b7-a206-615a61f41621",
                                                "sense_id": "cbbd7f51-7657-3126-914e-0ee64da63323",
                                                "text": "„Erst jetzt erkenne ich das riesige, teerfarbene Melanom auf seiner Glatze.“"
                                            },
                                            {
                                                "example_id": "6523df03-8bdd-4e18-9ec3-f3922607ee23",
                                                "sense_id": "cbbd7f51-7657-3126-914e-0ee64da63323",
                                                "text": "„Günther und Klaus kommen vorübergehend gar ins Waisenhaus, wo man ihnen zum Entsetzen von Günther gleich nach der Ankunft eine Glatze schneidet – eine Schmach, die er nie so recht verwindet.“"
                                            },
                                            {
                                                "example_id": "ffa2ad96-fd2e-410e-b8d5-780edb05777b",
                                                "sense_id": "cbbd7f51-7657-3126-914e-0ee64da63323",
                                                "text": "„Wie er da stand, über den Tisch gebeugt, mit der großen Glatze und dem grauen, unordentlichen Haarkranz, kam er mir sehr alt vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ba60a0a-f31c-3658-ac47-7dad50d31f4b",
                                        "entry_id": "04246649-238c-347f-a4c9-3f7b9ee43391",
                                        "glosses": [
                                            "Person der Skinheadbewegung, die die Kopfbehaarung ziemlich kurz oder ganz entfernt hat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31182b0-53c9-4a54-af3f-4e6d1e09721e",
                                                "sense_id": "1ba60a0a-f31c-3658-ac47-7dad50d31f4b",
                                                "text": "Die Glatzen sind meistens keine Nazis."
                                            },
                                            {
                                                "example_id": "107d9a4d-e327-4919-ac1b-74db8b407206",
                                                "sense_id": "1ba60a0a-f31c-3658-ac47-7dad50d31f4b",
                                                "text": "In der Nähe meiner Wohnung ist ein Fußballstadion, da treffen sich viele Glatzen, und jeden Samstag werden sie sehr aggressiv."
                                            },
                                            {
                                                "example_id": "9ad2eb59-e0be-4daa-9573-16614812fc53",
                                                "sense_id": "1ba60a0a-f31c-3658-ac47-7dad50d31f4b",
                                                "text": "„Es musste ein Nazi sein, wer sonst hatte in Deutschland schon eine Glatze?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ffddf48-7c73-437f-9afa-0d857fb64840",
                        "source_entry_id": "299e954e-4776-3acf-bca3-d733d57fd730",
                        "target_lang_word": "Kahlköpfigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kahlköpfigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0179ec-8e95-38be-97ae-24b85c407209",
                                        "entry_id": "a68eb678-8961-3015-9bde-7b8b9e715abe",
                                        "glosses": [
                                            "Haarkrankheit, bei der die Kopfbehaarung vollkommen verloren gegangen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0a7861-0298-40e3-b2b8-b0b058b04866",
                                                "sense_id": "6f0179ec-8e95-38be-97ae-24b85c407209",
                                                "text": "„Tokio ( AFP ) Rund 35 Jahre nach dem \"Walkman\" wollen zwei japanische Tüftler die Welt mit einer ähnlich bahnbrechenden Erfindung beglücken. In Zusammenarbeit mit dem Konzern Sony entwickelten Hiroaki Tobita und Takuya Kuzi eine intelligente Perücke, die ihren Träger nicht nur auf schönste Weise über seine Kahlköpfigkeit hinwegtröstet, sondern ihm auch den Weg weist, als Fernbedienung bei Powerpoint-Präsentationen dient und seinen Blutdruck sowie seine Körpertemperatur misst.“"
                                            },
                                            {
                                                "example_id": "1f16f0b3-39b5-438c-bf65-d17a04a8c751",
                                                "sense_id": "6f0179ec-8e95-38be-97ae-24b85c407209",
                                                "text": "„Trotz seiner aufdringlichen Kahlköpfigkeit wirkte er jung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f00d81f9-c62c-4921-bccc-49103b77a8da",
