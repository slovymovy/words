                "senses": [
                    {
                        "sense_id": "4a24ce3a-621a-37a6-acb8-5db9503970d4",
                        "entry_id": "165f5de3-e504-3013-96df-fe9082c8841b",
                        "glosses": [
                            "weibliches Mitglied der Schweizergarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a86c0c3-a470-4e67-94da-871998efc333",
                                "sense_id": "4a24ce3a-621a-37a6-acb8-5db9503970d4",
                                "text": "„Als die Kidnapper bereits in den Vatikan eingedrungen sind, kann sie nur noch eine junge Schweizergardistin – die erste Frau bei der Garde – aufhalten. “"
                            },
                            {
                                "example_id": "ee7f8334-f0f9-4651-bc87-5b24c6f76710",
                                "sense_id": "4a24ce3a-621a-37a6-acb8-5db9503970d4",
                                "text": "„Frauen konnten nun alles werden, es musste ja nicht gerade etwas so Verwegenes wie Linienpilotin oder Schweizergardistin sein.“"
                            },
                            {
                                "example_id": "e08fd05f-4bae-4f4b-aa99-e3fb846c1e58",
                                "sense_id": "4a24ce3a-621a-37a6-acb8-5db9503970d4",
                                "text": "„Die Reformierte sagt, sie wäre ‹sehr gerne› Schweizergardistin geworden, wenn die Schweizergarde auch Frauen zulassen würde.“"
                            },
                            {
                                "example_id": "dd1e82fa-2b52-4777-b399-fe721be9ee92",
                                "sense_id": "4a24ce3a-621a-37a6-acb8-5db9503970d4",
                                "text": "„Nein, die am Treffen anwesende Trudy Schmid-Loretan ist nicht die erste Schweizergardistin.“"
                            },
                            {
                                "example_id": "7e3a1732-244f-48bf-ba34-87106c1eba35",
                                "sense_id": "4a24ce3a-621a-37a6-acb8-5db9503970d4",
                                "text": "„Direkt aus dem Vatikan kam die erste Schweizergardistin als Unterstützung, um gemeinsam mit ihnen den Papst persönlich willkommen zu heißen. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
