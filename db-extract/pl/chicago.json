                                "target_senses": [
                                    {
                                        "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                        "entry_id": "02695c99-b3e7-33e0-84bd-c41e46a47d5b",
                                        "glosses": [
                                            "drittgrößte Stadt in den Vereinigten Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd152014-b97a-4e32-9d55-77e041ef3276",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "Chicago liegt am Südwestufer des Michigansees."
                                            },
                                            {
                                                "example_id": "e2d3f6a5-9a81-4afb-84ba-461f42aa5eac",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "Chicago liegt im US-Bundesstaat Illinois."
                                            },
                                            {
                                                "example_id": "16f5d331-c6ff-4132-8e5a-a0204d9ed430",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "Chicago hat 77 Stadtbezirke."
                                            },
                                            {
                                                "example_id": "73b71b98-04c0-4370-a9c5-6b73afdbf6b7",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "„Als habe jemand einen Schalter umgelegt, war es wieder da, das Charisma, das er schon in Chicago ausgestrahlt hatte.“"
                                            },
                                            {
                                                "example_id": "cf224ee7-fa87-48c6-a030-721d60abd9f8",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "„Ein bespielbares Stadion war in Chicago und Umgebung nicht zu finden, aber Halas hatte die rettende Idee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
