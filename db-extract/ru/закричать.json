                "translations": [
                    {
                        "translation_id": "c34d81eb-8644-4321-8751-4c5f6c0a3dbb",
                        "source_entry_id": "3b851c23-1bb2-3b23-aac4-bbd534411118",
                        "source_sense_description": "выкрикнуть",
                        "target_lang_word": "cry out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cry out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c7d4bd4-6f57-387b-80c7-16f5a89a6064",
                                        "entry_id": "5a8bbf08-f03b-3e40-9546-1cffcf7acd1e",
                                        "glosses": [
                                            "To shout in a loud voice, due to pain, or fear, or unhappiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c95720d9-f96d-4458-b047-e70f418fc257",
                                                "sense_id": "1c7d4bd4-6f57-387b-80c7-16f5a89a6064",
                                                "text": "Vſurers, you are none of theſe cryers vnto God, but thoſe that hourely vnto God are most cryde out againſt. God hath cryde out vnto you by his Preachers, GOD hath cride out vnto you by the poore ; Pryſoners on their death-beds haue cride out of you : and when they haue had but one houre to interceſſionate for their ſoules, and ſue out the pardon of their numberleſſe ſins, the whole of that howre (ſauing one minute, when in two words they cryde for mercy,) haue they ſpent, in crying for vengeance againſt you."
                                            },
                                            {
                                                "example_id": "454bbe42-29b0-4174-9ead-ff567d46c8b6",
                                                "sense_id": "1c7d4bd4-6f57-387b-80c7-16f5a89a6064",
                                                "text": "Do you cry out in your sleep?"
                                            },
                                            {
                                                "example_id": "56eee82f-266a-4158-80d3-c91159ce29ff",
                                                "sense_id": "1c7d4bd4-6f57-387b-80c7-16f5a89a6064",
                                                "text": "At the very moment he cried out, David realised that what he had run into was only the Christmas tree."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
