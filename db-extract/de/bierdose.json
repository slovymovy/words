                "senses": [
                    {
                        "sense_id": "18b9309b-a7ed-381f-b41e-85efdd82782a",
                        "entry_id": "6ee210d1-bacd-3127-abf9-e6a3a80a70bc",
                        "glosses": [
                            "Dose zur Aufbewahrung von Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7bc1717-70b7-472b-9d43-16211a0bf8b3",
                                "sense_id": "18b9309b-a7ed-381f-b41e-85efdd82782a",
                                "text": "Gib mir mal die Bierdose, sagte der Freund."
                            },
                            {
                                "example_id": "5aefdfad-fc9e-48fe-a740-bcccbba75d1a",
                                "sense_id": "18b9309b-a7ed-381f-b41e-85efdd82782a",
                                "text": "„Jürgen versuchte, eine Bierdose zu öffnen, aber der Ring riß ab, ohne den Verschluß mit aufzuziehen.“"
                            },
                            {
                                "example_id": "20c1f43f-754c-47c6-b0fc-f9b846adadec",
                                "sense_id": "18b9309b-a7ed-381f-b41e-85efdd82782a",
                                "text": "„Die Sechserkartons wurden geöffnet und Bierdosen herumgereicht.“"
                            },
                            {
                                "example_id": "c69bf695-6040-4923-8f80-0ea96dececc1",
                                "sense_id": "18b9309b-a7ed-381f-b41e-85efdd82782a",
                                "text": "„Frank drückte die Zigarette aus und ließ sie in eine Bierdose fallen, die er unter dem Tisch stehen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
