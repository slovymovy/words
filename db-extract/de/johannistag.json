                ],
                "senses": [
                    {
                        "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                        "entry_id": "eefd2c29-e2f2-3df6-a517-15904504f38d",
                        "glosses": [
                            "nach Johannes dem Täufer benannter Tag nach der Sommersonnenwende; der 24. Juni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de41d691-459e-4ab5-a629-063fdeb57c91",
                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                "text": "„Da der Johannistag in diesem Jahr auf einen Sonntag fällt und das Wetter herrlich ist, zieht es Winfried und mich in die Natur.“"
                            },
                            {
                                "example_id": "352acb21-5b5d-49bd-8817-3f37bab6492d",
                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                "text": "„Dieses wundervolle Spektakel können wir jedes Jahr von Ende Mai bis Ende Juli beobachten, wobei der Höhepunkt um den Johannistag liegt.“"
                            },
                            {
                                "example_id": "cbb03b76-8b27-4077-99de-d18dfc305f16",
                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                "text": "„Die Wölfe hielten bei einem Freunde zusammen Johannistag, schmausten und zechten viel, waren lustig und guter Dinge.“"
                            },
                            {
                                "example_id": "00e56b07-999b-4791-98cc-c9d292731550",
                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                "text": "„Am Johannistag kommen nämlich die Bauern zusammen und ergötzen sich, die Alten durch Trinken, die Jungen durch Tanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
