                        "form": "informes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "370e8d18-eb8c-39b0-bd35-4ea0afbc7aa1",
                        "entry_id": "406a173c-7cbe-31f3-8274-3a1ecec2a5a0",
                        "glosses": [
                            "Dont la forme est indécise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba846c5-be14-4094-a3f8-80a63e0cea25",
                                "sense_id": "370e8d18-eb8c-39b0-bd35-4ea0afbc7aa1",
                                "text": "Une masse, un animal informe."
                            }
                        ]
                    },
                    {
                        "sense_id": "4589e149-551f-3adf-b891-7d1ee3064f60",
                        "entry_id": "406a173c-7cbe-31f3-8274-3a1ecec2a5a0",
                        "glosses": [
                            "Sans forme, sans tenue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbdb9e7d-b5f7-4ac6-a7b3-ffe4a2f9573f",
                                "sense_id": "4589e149-551f-3adf-b891-7d1ee3064f60",
                                "text": "C’est un ouvrage informe et qui n’est pas encore mis dans l’ordre où il doit être."
                            },
                            {
                                "example_id": "d6e4c9fb-2a04-4ba7-936a-43a738a2d3d8",
                                "sense_id": "4589e149-551f-3adf-b891-7d1ee3064f60",
                                "text": "Des essais informes."
                            }
                        ]
                    },
                    {
                        "sense_id": "a71fb700-696b-37ee-a161-8abc0d9a7dc3",
                        "entry_id": "406a173c-7cbe-31f3-8274-3a1ecec2a5a0",
                        "glosses": [
                            "Qui ne fait pas foi, qui n’est pas revêtu des formes prescrites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ec70ec-1488-4efe-9285-92428fe7055f",
                                "sense_id": "a71fb700-696b-37ee-a161-8abc0d9a7dc3",
                                "text": "C’est une pièce informe qui ne peut servir."
                            },
                            {
                                "example_id": "94cf452f-95a6-4573-bca8-583274ef4983",
                                "sense_id": "a71fb700-696b-37ee-a161-8abc0d9a7dc3",
                                "text": "Cet acte est informe."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a38da40-91fc-364a-96c5-5098200d2aef",
                        "entry_id": "406a173c-7cbe-31f3-8274-3a1ecec2a5a0",
                        "glosses": [
                            "S’est dit des étoiles qui, en raison de leur peu d’éclat, n’avaient pas été comprises dans les constellations désignées par des noms particuliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de0e1b5-5a33-40c4-bfe1-00b86e28e597",
                                "sense_id": "7a38da40-91fc-364a-96c5-5098200d2aef",
                                "text": "Étoiles informes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac5e6df3-2747-4a02-bf38-ec0c9cccfb7f",
                        "source_entry_id": "406a173c-7cbe-31f3-8274-3a1ecec2a5a0",
                        "source_sense_id": "370e8d18-eb8c-39b0-bd35-4ea0afbc7aa1",
                        "source_sense_description": "Dont la forme est indécise.",
                        "target_lang_word": "shapeless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shapeless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d783b39d-16ad-32a7-9db2-c3a81b6908ea",
                                        "entry_id": "a8d12e90-ea3b-3d35-aceb-378fd97db17c",
                                        "glosses": [
                                            "Without a clearly defined or identifiable shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a24caba-b59a-4f0a-81a0-a62457203d32",
                                                "sense_id": "d783b39d-16ad-32a7-9db2-c3a81b6908ea",
                                                "text": "If you skip the prelude, which is at once rhythmically square and shapeless, this Lohengrin starts out decently enough, for Hans Helm is one of the okayest Heralds on disc (a modest compliment, to be sure)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac940e4-6e90-45c9-86b8-328c13f1b48e",
                        "source_entry_id": "406a173c-7cbe-31f3-8274-3a1ecec2a5a0",
                        "source_sense_id": "370e8d18-eb8c-39b0-bd35-4ea0afbc7aa1",
                        "source_sense_description": "Dont la forme est indécise.",
                        "target_lang_word": "formless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7539b1a3-5b0a-33a3-b2d7-e9ddd1463b4a",
                                        "entry_id": "7d08f871-1c08-39fc-9a12-605a7711c01a",
                                        "glosses": [
                                            "Without form; shapeless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9262dba0-671b-404c-b048-fd2780ecb976",
                                                "sense_id": "7539b1a3-5b0a-33a3-b2d7-e9ddd1463b4a",
                                                "text": "It spread slowly up from the sea-rim, a welling upwards of pure white light, ghosting the beach with silver and drawing the grey bastions of sandstone out of formless space."
                                            },
                                            {
                                                "example_id": "148e85a1-dc92-490d-b89e-3e8cc7329dbd",
                                                "sense_id": "7539b1a3-5b0a-33a3-b2d7-e9ddd1463b4a",
                                                "text": "1985: Now the earth was a formless void, there was darkness over the deep, with a divine wind sweeping over the waters. — Genesis 1:2 (New Jerusalem Bible)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8532515f-4322-387f-b998-c8d5404222f1",
                                        "entry_id": "7d08f871-1c08-39fc-9a12-605a7711c01a",
                                        "glosses": [
                                            "Without the use of forms or templates."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d471fa70-2d03-4718-b749-76be89c347af",
                                                "sense_id": "8532515f-4322-387f-b998-c8d5404222f1",
                                                "text": "You'll be prompted with the New Project dialog (see Figure 1.11) from which you'll have at least two types of projects from which to choose: Windows CE for the Pocket PC Project and Windows CE Formless project."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
