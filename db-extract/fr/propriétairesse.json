                "senses": [
                    {
                        "sense_id": "eaaab37e-9a23-3eb7-a200-9614f0f190ec",
                        "entry_id": "10b5ec71-7083-3655-9363-492d7889d2b1",
                        "glosses": [
                            "Femme propriétaire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b69e84f4-05ef-4aee-bd90-dc6e60215636",
                                "sense_id": "eaaab37e-9a23-3eb7-a200-9614f0f190ec",
                                "text": "C’est un accident de même nature qui a frappé dernièrement M. Gauthier de Rigny, par la main d’une des plus riches propriétairesses de Belgique."
                            },
                            {
                                "example_id": "64b8824d-1acf-4b34-98ac-4013abae04c8",
                                "sense_id": "eaaab37e-9a23-3eb7-a200-9614f0f190ec",
                                "text": "mais le Parlement de Bordeaux, dont la Soule dépend à l’époque de Bela, casse les exécutions faites, en vertu de telles dettes, sur les héritiers statutaires des femmes propriétairesses"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "638aa540-2959-4cc8-8e81-db4c915322bd",
                        "source_entry_id": "10b5ec71-7083-3655-9363-492d7889d2b1",
                        "source_sense_id": "eaaab37e-9a23-3eb7-a200-9614f0f190ec",
                        "target_lang_word": "Besitzerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besitzerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                        "entry_id": "325cfe21-3d38-357e-9f2b-0aa46dcbeb02",
                                        "glosses": [
                                            "weibliche Person, die etwas in ihrem Besitz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a92702-be1c-4da7-9da1-3722458d9e8f",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin des Geschäftes umarmte mich zum Abschied und gab mir wieder drei Schillerlocken mit.“"
                                            },
                                            {
                                                "example_id": "4f809061-d331-410a-8de8-3274aca7f639",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Nach vielem Hin und Her mit der Besitzerin hatte ich es geschafft, dass im Gästehaus eine Klimaanlage eingebaut wurde.“"
                                            },
                                            {
                                                "example_id": "e7fdbdcf-0cc5-4e7c-8d99-cf6bc58a43bb",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin führte sie in einen Raum hinter dem Laden, der abgeblendet war.“"
                                            },
                                            {
                                                "example_id": "7904b344-faeb-4c40-8529-67f59b32efe5",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Eine Woche später waren sie stolze Besitzerinnen eines kleinen blauen Citroën.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
