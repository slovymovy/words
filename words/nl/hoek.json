                {
                    "sense_id": "528f7e90-8376-34dd-aa2a-5a873774ea8e",
                    "sense_definition": "de grootte van de draaiing tussen twee lijnen die in één punt samenkomen, gemeten in graden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een rechte <w>hoek</w> is precies negentig graden.",
                            "target_lang_translations": {
                                "en": "A right <w>angle</w> is exactly ninety degrees.",
                                "ru": "Прямой <w>угол</w> составляет ровно девяносто градусов."
                            }
                        },
                        {
                            "text": "De architect berekende de <w>hoek</w> van het dak.",
                            "target_lang_translations": {
                                "en": "The architect calculated the <w>angle</w> of the roof.",
                                "ru": "Архитектор рассчитал <w>угол</w> наклона крыши."
                            }
