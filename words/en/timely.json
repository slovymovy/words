                            {
                                "target_lang_word": "заблаговременно",
                                "target_lang_sense_clarification": "заранее"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rechtzeitig",
                                "target_lang_sense_clarification": "bevor es zu spät ist"
                            },
                            {
                                "target_lang_word": "frühzeitig",
