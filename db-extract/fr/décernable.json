                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e19c19-221a-43a7-826e-96a224923054",
                                "sense_id": "98a444e5-dd0b-31f4-8221-5c21b25298f4",
                                "text": "Mystique, il l’est, voyez sa Muse, tant au-dessus, (éloge rarement décernable aux dessins d’à présent), tant au-dessus des paraphrases, et ce Parfum des Fleurs que profanerait toute exégèse."
                            },
                            {
                                "example_id": "9878af51-20f5-4e57-98da-0fe55e7ba98b",
                                "sense_id": "98a444e5-dd0b-31f4-8221-5c21b25298f4",
                                "text": "De créer un office de contrôle ou une marque de qualité, décernable seulement aux brûleurs sans fumée et indéréglables."
                            },
                            {
                                "example_id": "355faa8b-99c0-44fe-9f54-f5d2dc3a355a",
                                "sense_id": "98a444e5-dd0b-31f4-8221-5c21b25298f4",
                                "text": "Ce matin, par 3 lettres à Sylvie Reff et à la famille Dadelsen en Suisse, j’ai lancé l’idée d’un prix de poésie « Jean-Paul de Dadelsen », décernable à Strasbourg (au « Singe Bleu ») tous les 22 juin, anniversaire de l’auteur du Jonas."
                            }
                        ]
                    }
