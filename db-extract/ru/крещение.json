                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23f30b2-6249-4cb8-9c02-bae6e78d18bb",
                                                "sense_id": "41149e15-5aa3-3658-b98a-27e0af6581a8",
                                                "text": "Bitwa pod Monte Cassino była dla Polaków chrztem bojowym."
