                "senses": [
                    {
                        "sense_id": "84c64c10-3d2f-30db-89f9-4b843012a61e",
                        "entry_id": "3cff5c4a-8b15-3861-a25b-3c46955dbd2c",
                        "glosses": [
                            "The act of firing an arrow from a bow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f87aeba-2266-4dba-8347-53cf22b969c9",
                                "sense_id": "84c64c10-3d2f-30db-89f9-4b843012a61e",
                                "text": "It is, however, interesting in connection with that fact to remember that the last bowshot in English warfare was fired during the Civil War."
                            }
                        ]
                    },
                    {
                        "sense_id": "531b0a55-c479-359d-a76b-c0610e8e32ba",
                        "entry_id": "3cff5c4a-8b15-3861-a25b-3c46955dbd2c",
                        "glosses": [
                            "The distance that the arrow of an average archer can effectively travel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472051b5-208c-413b-a0fe-f417ec564a71",
                                "sense_id": "531b0a55-c479-359d-a76b-c0610e8e32ba",
                                "text": "If you will obligingly, set up your armour targets within a shortened range, say, for instance, a Robin Hood bowshot of 200 yards, you shall see what the brute force of the old smooth-bore will do."
                            },
                            {
                                "example_id": "201aac75-1a52-431e-a4ef-b5f47789e16e",
                                "sense_id": "531b0a55-c479-359d-a76b-c0610e8e32ba",
                                "text": "But first run up the King's banner, hang out all the shields, and send as many men to the fighting top as you can. And about five bowshots hence, when you get open sea on your port bow, run up a few signals."
                            },
                            {
                                "example_id": "6bf9831f-c8a8-4804-a9e9-776c0be98e31",
                                "sense_id": "531b0a55-c479-359d-a76b-c0610e8e32ba",
                                "text": "They are within a bowshot of the kirk door."
                            }
                        ]
                    }
                ],
