                                        "sense_id": "a2d4ff53-a758-38a6-b88c-935cdd47e3cf",
                                        "entry_id": "c6d42a7e-7a28-3679-90a9-11cff53b5dc5",
                                        "glosses": [
                                            "Variante de Apolline."
