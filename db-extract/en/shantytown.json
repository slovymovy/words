                    {
                        "translation_id": "bb13f0f4-b4df-4255-9ef0-46ef41cc2958",
                        "source_entry_id": "87e2cc41-e2ab-3324-9995-c4baeb932438",
                        "source_sense_id": "2a10f8fb-795b-3fcd-954e-48e9e694af87",
                        "source_sense_description": "area containing a collection of shacks and shanties",
                        "target_lang_word": "Barackenstadt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barackenstadt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd402327-7af5-3de9-9d18-2348671841e9",
                                        "entry_id": "36d7b0ad-42ad-3d84-9c59-ee1cad1e15f5",
                                        "glosses": [
                                            "hauptsächlich aus Baracken bestehende Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605604ca-6b90-4c25-a247-0c8bc7754464",
                                                "sense_id": "bd402327-7af5-3de9-9d18-2348671841e9",
                                                "text": "„Es ging hinauf bis zum Kamm der Höhen, dann vorbei an drei geschlossenen jüdischen Siedlungen auf dem Stadtgebiet von Anata und der beduinischen Barackenstadt Khan al-Ahmar, welche sich über eine Parzelle aus dem Besitz von Abeds Großvater erstreckte.“"
                                            },
                                            {
                                                "example_id": "8267cb44-d66b-43df-ad84-305f91b39b74",
                                                "sense_id": "bd402327-7af5-3de9-9d18-2348671841e9",
                                                "text": "„Sie passierten eine langgestreckte Barackenstadt am Rand eines Nebenarms, um Siedlung und Bach kein Gras und Pflanzenwuchs mehr, ein Gelände aus nacktem Lehm, bevölkert mit Abfall, Hühnern und struppigen Kötern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd2257e1-10dd-4dd8-9910-933ce2c5c93f",
                        "source_entry_id": "87e2cc41-e2ab-3324-9995-c4baeb932438",
                        "source_sense_id": "2a10f8fb-795b-3fcd-954e-48e9e694af87",
                        "source_sense_description": "area containing a collection of shacks and shanties",
                        "target_lang_word": "Elendsviertel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elendsviertel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d18422-9b35-3b6e-aa7b-b82465f7e639",
                                        "entry_id": "e5b05b45-3ff9-31e7-a9f5-2b237ac1cf15",
                                        "glosses": [
                                            "ein verwahrloster Stadtbezirk, der von armen Menschen bewohnt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435f9dd9-1fd2-4ee9-82fc-098509830834",
                                                "sense_id": "c3d18422-9b35-3b6e-aa7b-b82465f7e639",
                                                "text": "In den Elendsvierteln um Lagos leben hunderttausende Menschen in bitterer Armut."
                                            },
                                            {
                                                "example_id": "8a5411e7-915d-4490-aeb2-823f03422851",
                                                "sense_id": "c3d18422-9b35-3b6e-aa7b-b82465f7e639",
                                                "text": "„Zwanzig Minuten später stand Thomas Lieven in dem kleinen Ordinationsraum von Dr. Ted Willcox, einem älteren Arzt, der seine Praxis im ärmsten Elendsviertel New Yorks aufgeschlagen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c27d2b7-f7ed-4379-a7dd-45ef34647971",
                        "source_entry_id": "87e2cc41-e2ab-3324-9995-c4baeb932438",
                        "source_sense_id": "2a10f8fb-795b-3fcd-954e-48e9e694af87",
                        "source_sense_description": "area containing a collection of shacks and shanties",
                        "target_lang_word": "Slum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                        "entry_id": "983d84f9-a568-3949-87ea-ea374a4b8b74",
                                        "glosses": [
                                            "verwahrloster Stadtbezirk (vor allem in einer Großstadt), der von armen Menschen bewohnt wird und durch heruntergekommene Bausubstanz und schlecht ausgestattete Infrastruktur gekennzeichnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb9000b-4fb8-40fa-bc85-7fe3b4ea4623",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "Die Wasserversorgung in den indischen Slums ist katastrophal."
                                            },
                                            {
                                                "example_id": "106d9610-4abc-48e2-aba9-12b25500dd22",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„Johanna Sarre, die fließend Kisuaheli spricht, hat zwei Monate im Slum gewohnt und Feldforschung direkt vor Ort betrieben.“"
                                            },
                                            {
                                                "example_id": "3873f4a7-1d74-4677-a9b1-c9d22414730f",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„Sie war vor allem in den Slums von Luanda zu einer Massenbewegung geworden.“"
                                            },
                                            {
                                                "example_id": "d3ae41ea-e9ee-4a25-8558-363371431f23",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„Für die Tollkühnsten unter uns wurde ein Ausflug in die umliegenden Slums organisiert.“"
                                            },
                                            {
                                                "example_id": "3b940feb-392b-4440-bf95-2ba7e642d5fc",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„In der ersten Woche bereits besuchten sie die Slums von Isale Eko.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
