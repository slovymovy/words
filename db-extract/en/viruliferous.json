                        "glosses": [
                            "Virus-carrying, especially of insects which infest agricultural crops."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5b03819-2468-4cda-8605-20422f4f16b3",
                                "sense_id": "7eeab8e5-3d7c-33f9-aa7c-5551ce045ec6",
                                "text": "Circumstantial evidence suggests that heavy infestation by viruliferous aphids can overcome the highest degree of host plant resistance."
                            },
                            {
                                "example_id": "6927b7cf-d757-44ec-ab41-9a026eb7457a",
                                "sense_id": "7eeab8e5-3d7c-33f9-aa7c-5551ce045ec6",
                                "text": "Viruliferous curl mites increase during summer on volunteer wheat, and are carried by air currents into the new wheat crop."
                            },
                            {
                                "example_id": "9afc2012-380d-4bb6-8d18-bd303c28cbf6",
                                "sense_id": "7eeab8e5-3d7c-33f9-aa7c-5551ce045ec6",
                                "text": "Maize streak virus, an endemic pathogen of native African grasses, was then carried to maize plants by viruliferous leafhoppers."
                            }
                        ]
