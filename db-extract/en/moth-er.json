                        "glosses": [
                            "A person (especially an entomologist) or animal that catches moths."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850223fe-e222-4e36-848e-3fae006cdcdd",
                                "sense_id": "bcb129f8-d100-36a3-ac89-ac69a3c1b814",
                                "text": "Real moth-ers, mothies or lepidopterists, will use a mercury vapour bulb and even a special trap[.]"
                            },
                            {
                                "example_id": "dbaf3c5d-cf0b-4b7f-a3a0-8d9cf9096096",
                                "sense_id": "bcb129f8-d100-36a3-ac89-ac69a3c1b814",
                                "text": "Modern moth-ers use black lights, mercury vapor lamps, and portable generators to saturate the night sky[.]"
                            },
                            {
                                "example_id": "e59210fd-b81f-474b-8d73-33a7ca8667ba",
                                "sense_id": "bcb129f8-d100-36a3-ac89-ac69a3c1b814",
                                "text": "Many species of bats are skilled ‘moth-ers’: they pursue them at speed after detecting them[.]"
                            }
                        ]
