                "senses": [
                    {
                        "sense_id": "321e4d8b-d85f-36fd-bd97-49151980b91a",
                        "entry_id": "2394c990-9467-3e16-8606-e09b3b3e5879",
                        "glosses": [
                            "eenvoudige, korte meestal niet verharde landingsbaan voor vliegtuigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a414f4-fd71-4f1b-9db0-099ead50a841",
                                "sense_id": "321e4d8b-d85f-36fd-bd97-49151980b91a",
                                "text": "Clarice Starling, die in een surveillancewagen vanaf de landingsstrip Potter binnenreed, moest zich dicht naar het gevangenraster buigen om de hulpsheriff te kunnen verstaan, die dit alles aan Jack Crawford uitlegde."
                            },
                            {
                                "example_id": "5429d55d-5c11-4fcb-a92f-32797c573041",
                                "sense_id": "321e4d8b-d85f-36fd-bd97-49151980b91a",
                                "text": "Operatie Market Garden, het geallieerde offensief tegen de Duitsers, wordt groots herdacht. In september is het 75 jaar geleden. Bij Ede is een landingsstrip nagebouwd zoals die er aan het einde van de oorlog uitzag. Dit jaar doen ook Duitsers mee."
                            },
                            {
                                "example_id": "6c322a7a-08b4-499e-812f-393e180f7b3e",
                                "sense_id": "321e4d8b-d85f-36fd-bd97-49151980b91a",
                                "text": "Timmerman: \"Drie jaar geleden lag de finish boven op die klim, nu volgt na de top nog zes kilometer in dalende lijn naar Courchevel, waar de streep ligt getrokken op een landingsstrip die jarenlang behoorde tot de gevaarlijkste 'luchthavens' ter wereld. Het is een rit voor waaghalzen en stuurmanskunstenaars, want ook de afdaling van de Cormet de Roselend is link en in de afdaling van de Côte de Longefoy hebben ze liefst 26 haarspeldbochten in 10 kilometer gepropt.\""
                            }
                        ]
                    }
