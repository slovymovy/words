                                    {
                                        "sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                                        "entry_id": "c32d2dc3-0359-3e3d-b69d-a9932772f826",
                                        "glosses": [
                                            "Bezeichnung für den Nadelwald in Nordamerika, Nordeuropa und Sibirien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a47c7cf3-c868-4699-850a-823c8347d9be",
                                                "sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                                                "text": "Die Taiga erstreckt sich im Norden Asiens bis zur Tundra und im Osten bis zum Pazifik."
                                            },
                                            {
                                                "example_id": "96b00f75-5cc3-445c-a794-95953b63c776",
                                                "sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                                                "text": "„Weit erstreckt sich die Taiga unter dem Wolkenverhangenen Himmel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
