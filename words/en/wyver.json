            "senses": [
                {
                    "sense_id": "4ece58db-1ed5-3bac-9d33-1865db129760",
                    "sense_definition": "An obsolete form of <w>wyvern</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old manuscript contained a drawing of a <w>wyver</w> guarding the castle gate.",
                            "target_lang_translations": {
                                "es": "El antiguo manuscrito contenía un dibujo de un <w>guiverno</w> custodiando la puerta del castillo."
                            }
                        },
                        {
                            "text": "In medieval heraldry, the <w>wyver</w> was often depicted with two legs and a dragon-like tail.",
                            "target_lang_translations": {
                                "es": "En la heráldica medieval, el <w>guiverno</w> a menudo se representaba con dos patas y una cola de dragón."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This term is no longer in standard use."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Una forma obsoleta de wyvern, una criatura legendaria con cuerpo de dragón, dos patas y alas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "guiverno",
                                "target_lang_sense_clarification": "Término heráldico para la criatura mítica."
                            },
                            {
                                "target_lang_word": "dragón alado",
                                "target_lang_sense_clarification": "Descripción general de la criatura."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
