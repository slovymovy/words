                                        "examples": [
                                            {
                                                "example_id": "18f779c3-5c1a-4966-aab3-51ad5bbdde37",
                                                "sense_id": "72a6dbea-8f07-3ca1-80f7-127794acde26",
                                                "text": "„Nach seinen Angaben hatte er sie erst dort chloroformiert und gefesselt. Und warum sollte er in diesem Punkt lügen?“ (2003)"
                                            },
                                            {
                                                "example_id": "b5ea0ecb-d243-4991-97cd-e4f4040d8ecd",
                                                "sense_id": "72a6dbea-8f07-3ca1-80f7-127794acde26",
                                                "text": "„Nach 24 Stunden wurden die Schweinchen chloroformiert, die Bauchhöhle geöffnet.“ (1908)"
                                            },
                                            {
                                                "example_id": "1cece16e-48a0-44fb-bc8a-b8758b69c2ad",
                                                "sense_id": "72a6dbea-8f07-3ca1-80f7-127794acde26",
                                                "text": "„Der Kranke, der behufs Entfernung einer Neubildung im Kehlkopfe chloroformiert wurde, hörte auf zu athmen, und nur nach beharrlichen Tractionen der Zunge gelang es, ihn ins Leben zurückzurufen.“ (1898)"
                                            }
                                        ],
