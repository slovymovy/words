                    "frequency": "Middle",
                    "semantic_group_id": "betrokkenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De organisatie is <w>verwikkeld</w> geraakt in een groot schandaal.",
                            "target_lang_translations": {
                                "pl": "Organizacja została <w>uwikłana</w> w wielki skandal."
                            }
                        },
                        {
                            "text": "Zij is al jaren <w>verwikkeld</w> in een juridische strijd met haar buren.",
                            "target_lang_translations": {
