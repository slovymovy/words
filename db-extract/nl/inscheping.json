                                    {
                                        "sense_id": "86854b94-0772-3b08-873e-e7f46688d455",
                                        "entry_id": "6330cda9-2a9f-3a10-a4df-ae5ddc962428",
                                        "glosses": [
                                            "The process by which something is loaded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7c175b-a66c-4570-9ec7-782c547a961b",
                                                "sense_id": "86854b94-0772-3b08-873e-e7f46688d455",
                                                "text": "The loading of hazardous cargoes is not permitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94fffb4-b7d0-304d-946b-711accb10e1e",
                                        "entry_id": "6330cda9-2a9f-3a10-a4df-ae5ddc962428",
                                        "glosses": [
                                            "A load, especially in the engineering and electrical engineering senses of force exerted, or electrical current or power supplied."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88bebbba-3fe0-4131-bfef-a1ee2f1046f7",
                                                "sense_id": "b94fffb4-b7d0-304d-946b-711accb10e1e",
                                                "text": "I need to recheck the loadings on the external walls."
                                            },
                                            {
                                                "example_id": "60ebf766-222d-4351-9e38-5a4bcc80f315",
                                                "sense_id": "b94fffb4-b7d0-304d-946b-711accb10e1e",
                                                "text": "The loading on the generators peaks during the early evening."
                                            },
                                            {
                                                "example_id": "a6bb070e-5e74-4656-a006-5c544a722f8a",
                                                "sense_id": "b94fffb4-b7d0-304d-946b-711accb10e1e",
                                                "text": "Comparing both Regions' 1959 services against those of 1939 an appreciable deceleration is evident. This was due to increased loadings, even though more trains were being run, while on the W.R. in particular the increased volume of freight traffic over the line shared the blame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4b31af5-e85b-3e83-887d-571bbde5458c",
                                        "entry_id": "6330cda9-2a9f-3a10-a4df-ae5ddc962428",
                                        "glosses": [
                                            "An hourly pay rate given to a casual employee which is higher than the equivalent full-time or part-time employee's rate, usually paid to compensate for a lack of benefits such as sick leave or annual leave."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1458220f-8672-313a-8d35-2f627519145c",
                                        "entry_id": "6330cda9-2a9f-3a10-a4df-ae5ddc962428",
                                        "glosses": [
                                            "A weighting or bias."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d64588-6ff2-4355-a632-407d6800e5f8",
                                                "sense_id": "1458220f-8672-313a-8d35-2f627519145c",
                                                "text": "We may note with some surprise that the hysteria scale has a positive loading on this factor, i.e. is situated towards the normal rather than the neurotic end."
                                            }
                                        ]
                                    }
                                ]
