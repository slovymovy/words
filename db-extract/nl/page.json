                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1406c885-e17e-4f31-ad1e-fb2e17b2166f",
                                                "sense_id": "0c05b70a-41ae-3e9a-93f4-77108abc49e8",
                                                "text": "The book which he was reading had 213 pages."
                                            },
