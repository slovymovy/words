                "senses": [
                    {
                        "sense_id": "b6338ede-32b7-37bf-b337-8c60b90624bf",
                        "entry_id": "b47adcd6-959d-3d29-823e-6b7784f2916d",
                        "glosses": [
                            "nielegalna kopia danej rzeczy, mająca wprowadzić kogoś w błąd przez naśladowanie oryginału"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4171380e-f150-4fab-b7c3-d876a246a4e7",
                                "sense_id": "b6338ede-32b7-37bf-b337-8c60b90624bf",
                                "text": "Policja, która od dłuższego czasu otrzymywała sygnały o fałszywkach, poszukiwała ich producentów i dystrybutorów."
                            },
                            {
                                "example_id": "0f4172e1-d4b2-4287-957c-a4e347d3fd40",
                                "sense_id": "b6338ede-32b7-37bf-b337-8c60b90624bf",
                                "text": "Bilety będą kodowane, organizatorzy zapewniają, że ewentualni podrabiacze nie mają najmniejszych szans na wprowadzenie do obiegu fałszywek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
