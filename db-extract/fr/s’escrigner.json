                "senses": [
                    {
                        "sense_id": "4ed5f110-b450-3f25-b8e5-8f82bfdb483f",
                        "entry_id": "2afe9989-ae52-33ed-92e2-f7d748a73df9",
                        "glosses": [
                            "Variante populaire de s’escrimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d457ee70-d540-4f1b-a4bd-60a5a2104488",
                                "sense_id": "4ed5f110-b450-3f25-b8e5-8f82bfdb483f",
                                "text": "Il s’escrigne sur ses espaliers, dit-elle en goûtant une sauce du bout du doigt."
                            },
                            {
                                "example_id": "e3fcd52e-a4fc-471c-9d4e-cf555103b5a0",
                                "sense_id": "4ed5f110-b450-3f25-b8e5-8f82bfdb483f",
                                "text": "Je parlais justement de ceux qui s'escrignent à faire du bio, de la commercialisation directe style AMAP; dans un contexte de polyagriculture non spécialisé (pour éviter de continuer à fréquenter les grandes surfaces pour l'alimentaire)."
                            },
                            {
                                "example_id": "2d7a29ce-f53e-486f-80e2-52dd4b2784a9",
                                "sense_id": "4ed5f110-b450-3f25-b8e5-8f82bfdb483f",
                                "text": "Cela fait des année que ma femme s'escrigne à pratiquer la permaculture; cette année elle s'est plantée avec du mulch de feuilles de chêne (tanin), l'année dernière c'était avec du mulch de pin."
                            }
                        ]
                    }
