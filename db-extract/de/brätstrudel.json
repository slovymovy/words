                            {
                                "example_id": "617a0e5b-534c-46cf-bdd0-056b9ba59af1",
                                "sense_id": "4468f2d9-ac12-3b86-a8b7-f8c781511f6f",
                                "text": "„Die Brätstrudel im Dampfgarer bei 80 Grad 25 Minuten dämpfen oder in einer gewürzten Fleischbrühe (oder Salzwasser) gar ziehen lassen.“"
                            },
                            {
                                "example_id": "57c2a399-9280-4671-9c8c-f7272a9b4242",
                                "sense_id": "4468f2d9-ac12-3b86-a8b7-f8c781511f6f",
                                "text": "„Die geschnitten Scheiben (Brätstrudel) in eine Pfanne, in der vorher Butter geschmolzen wird, an den Schnittseiten beidseitig, braun anbraten.“"
                            }
                        ],
