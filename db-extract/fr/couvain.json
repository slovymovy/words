                ],
                "senses": [
                    {
                        "sense_id": "d96ae958-bb92-39de-a476-6aeee444710c",
                        "entry_id": "9f6fd7e8-c6d4-34ea-905f-cea5c823dcf7",
                        "glosses": [
                            "Ensemble des œufs, larves et nymphes contenus dans une ruche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2731d0-b35e-4101-8b36-4727c3afd340",
                                "sense_id": "d96ae958-bb92-39de-a476-6aeee444710c",
                                "text": "Quelle aventure peut-elle l’attendre à l’Opéra, dans le grouillement d’une foule encapuchonnée et masquée de noir, qui coule ou s’agglutine aussi incompréhensiblement qu’une file de fourmis ou un couvain d’abeilles ?"
                            },
                            {
                                "example_id": "060f1a25-fd27-4e72-be9e-3998477437cc",
                                "sense_id": "d96ae958-bb92-39de-a476-6aeee444710c",
                                "text": "La colonie d’abeilles noires au plus fort de la saison conserve des réserves généreuses malgré le couvain très développé. Les abeilles noires assurent le stock pour l’hiver. Entre le miel et le couvain, un cercle de pollen assure les apports en protéines pour les larves en développement."
                            },
                            {
                                "example_id": "35b5915f-86fd-49ef-9b73-d149a13fe432",
                                "sense_id": "d96ae958-bb92-39de-a476-6aeee444710c",
                                "text": "Le développement lent du couvain en début de saison, la modération de sa taille pendant la belle saison, la destruction en cas de disette des cellules de reine et le sacrifice des mâles, parfois du couvain d’ouvrière si la famine se prolonge, ainsi que la parcimonie de l’abeille noire dans l’utilisation de ses provisions lui permettent de passer sans encombre des périodes un peu longues de mauvais temps empêchant toute sortie.."
                            }
                        ]
                    },
                    {
                        "sense_id": "af609733-3f10-3aa0-98e9-127ead36ca4a",
                        "entry_id": "9f6fd7e8-c6d4-34ea-905f-cea5c823dcf7",
                        "glosses": [
                            "Tas d’œufs de punaises et de quelques autres insectes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b65d95-efb4-4954-a320-53223f93ea7f",
                                "sense_id": "af609733-3f10-3aa0-98e9-127ead36ca4a",
                                "text": "Les fourmis cherchent avec avidité le couvain des punaises."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30a706d9-7311-42ff-86fa-e19517b49c18",
                        "source_entry_id": "9f6fd7e8-c6d4-34ea-905f-cea5c823dcf7",
                        "target_lang_word": "Brut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brut",
