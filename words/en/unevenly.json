{
    "word_family": [
        "even",
        "uneven",
        "evenness",
        "unevenness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "79eda257-ebd2-38a2-acd2-1735e77a0b34",
                    "sense_definition": "In an uneven or haphazard manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paint was applied <w>unevenly</w> across the rough wooden surface.",
                            "target_lang_translations": {
                                "ru": "Краска была нанесена <w>неро́вно</w> по всей шероховатой деревянной поверхности."
                            }
                        },
                        {
                            "text": "The stones were <w>unevenly</w> distributed along the garden path.",
                            "target_lang_translations": {
                                "ru": "Камни были <w>неро́вно</w> разложены вдоль садовой дорожки."
                            }
                        }
                    ],
                    "synonyms": [
                        "haphazardly"
                    ],
                    "antonyms": [
                        "evenly"
                    ],
                    "common_phrases": [
                        "distributed unevenly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неровным, беспорядочным или хаотичным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неро́вно",
                                "target_lang_sense_clarification": "описывает негладкую поверхность или неравномерное распределение чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "100527c3-7dd7-3361-8f18-40df26f56132",
                    "sense_definition": "In an unequal manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Resources are often <w>unevenly</w> divided among the different regions.",
                            "target_lang_translations": {
                                "ru": "Ресурсы часто <w>неравноме́рно</w> распределены между различными регионами."
                            }
                        },
                        {
                            "text": "The wealth in the country is <w>unevenly</w> distributed among the population.",
                            "target_lang_translations": {
                                "ru": "Богатство в стране <w>неравноме́рно</w> распределено среди населения."
                            }
                        }
                    ],
                    "synonyms": [
                        "unequally"
                    ],
                    "antonyms": [
                        "equally"
                    ],
                    "common_phrases": [
                        "unevenly divided"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неравным, несправедливым или неодинаковым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неравноме́рно",
                                "target_lang_sense_clarification": "описывает распределение ресурсов или величин, которые различаются в разных частях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}