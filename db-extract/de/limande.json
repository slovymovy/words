                        "entry_id": "4ff9a31d-ea50-3fe3-a1ea-54e5d4d279ec",
                        "glosses": [
                            "ein Plattfisch, der auf steinigen Böden im gesamten Nord-Ost-Atlantik lebt"
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "164fa8e4-e46b-443c-b7af-509fa9a81301",
                                "sense_id": "8c7ead18-10e3-3640-8dca-f3558644e82c",
                                "text": "Die Limande ist ein Speisefisch."
                            },
                            {
                                "example_id": "a6492e3e-b636-4bde-a981-2ee6a30351d4",
                                "sense_id": "8c7ead18-10e3-3640-8dca-f3558644e82c",
                                "text": "„Die Nudibranchier haben nur geringe Bedeutung als Fischnahrung, sie werden zuweilen bei der Nahrung der Kliesche und der Limande erwähnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
