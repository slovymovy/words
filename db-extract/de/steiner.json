                ],
                "senses": [
                    {
                        "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                        "entry_id": "9566d0b2-0e00-33eb-a3af-852926c1a49e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3baadb5c-e980-427c-8503-78bf6718669e",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Der Sonderbeauftragte der Bundesregierung für Afghanistan und Pakistan, Michael Steiner, gibt seinen Posten auf."
                            },
                            {
                                "example_id": "81c2bbe7-6671-4963-9c15-a12aa6a0200a",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Frau Steiner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f45f46a8-7a55-4af3-bca1-280d948848f0",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Herr Steiner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "703d0dda-383a-46f8-bea6-71b0893a76c8",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Die Steiners fahren heute nach Nürnberg."
                            },
                            {
                                "example_id": "1186bd9e-c7ec-406c-b5a0-1bd9acbc5820",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Der Steiner trägt nie die Schals, die die Steiner ihm strickt."
                            },
                            {
                                "example_id": "3b44b5a0-e7c2-4b5a-a19e-af27fa4bed68",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Steiner kommt, geht der Herr Steiner.“"
                            },
                            {
                                "example_id": "b889e844-a0e5-4156-92f2-d68191fc9ba3",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Steiner kommt und geht."
                            },
                            {
                                "example_id": "018ddeb8-1bdb-4c1a-a171-9cc9195d5ad4",
                                "sense_id": "d433ec78-9d3d-326b-97ec-6f65acbed702",
                                "text": "Steiners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
