                                "target_senses": [
                                    {
                                        "sense_id": "0e651375-37f3-3819-8ef7-fd75d23d4986",
                                        "entry_id": "0e6a9e03-7bb5-384f-9939-01af9c618612",
                                        "glosses": [
                                            "het slechter worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12682f36-9cff-4af3-8dc6-ea1ddc4d353f",
                                                "sense_id": "0e651375-37f3-3819-8ef7-fd75d23d4986",
                                                "text": "\"Het is beter om patiënten in een vroeg stadium te helpen, om eventuele verergering van de klachten te voorkomen\", zegt Plooij. Sommige mensen zijn volgens haar al geholpen met een paar gesprekken. Ze geeft als voorbeeld personen die een naaste hebben verloren en wel kampen met depressieve klachten, maar nog geen depressie hebben."
                                            },
                                            {
                                                "example_id": "c67c8c8e-00c9-421d-8e94-1fca511f32e4",
                                                "sense_id": "0e651375-37f3-3819-8ef7-fd75d23d4986",
                                                "text": "In Nederland hebben ongeveer 400 mensen de ziekte van Fabry. Circa zestig van hen krijgen enzymtherapie. Eens in de twee weken krijgen ze in het AMC per infuus Replagal of Fabrazyme toegediend dat de verergering van de ziekte helpt te vertragen. Die enzymtherapie kost jaarlijks per patiënt ongeveer 200.000 euro. Voor de hele groep patiënten bedragen de kosten 11 miljoen euro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05f2d0d9-cb23-40aa-9f8c-ffe6203a7a83",
                        "source_entry_id": "9ea4e31c-6764-3ac6-baa8-2fd734f00c9a",
                        "source_sense_id": "dc69f0ef-3e9e-30d8-9f2f-78c0c21e9e1d",
                        "target_lang_word": "verscherping",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verscherping",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3496f152-6c0e-352a-a9bb-22fd8397c140",
                                        "entry_id": "b097211c-f9ac-3ae4-9278-1405fc42788a",
                                        "glosses": [
                                            "het strenger maken van regels en het strikter toepassen van bestaande regels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a2b5ff-abde-4521-9ad5-429858bff6d3",
                                                "sense_id": "3496f152-6c0e-352a-a9bb-22fd8397c140",
                                                "text": "De Europese Commissie staat voor een verscherping van het toezicht op communicatiediensten als Skype en WhatsApp. Volgens de Britse zakenkrant Financial Times worden techbedrijven als Microsoft (Skype) en Facebook (WhatsApp) in de aanstaande herziening van de regels omtrent telecomdiensten aan strengere privacy- en veiligheidsregels onderworpen."
                                            },
                                            {
                                                "example_id": "cde47c4c-49c6-4cbd-a87e-2b064b1f5ddf",
                                                "sense_id": "3496f152-6c0e-352a-a9bb-22fd8397c140",
                                                "text": "Op basis van het OVV-onderzoek naar dit treinongeval kondigde staatssecretaris Sharon Dijksma in maart van dit jaar aan te zullen pleiten voor verscherping van de Europese normen voor botsveiligheid. Ze nam de conclusie over dat machinisten beter beschermd moeten worden, onder meer door een schuilplek in de cabine te realiseren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a690b1-95e2-3e19-8144-66d9d9567e26",
                                        "entry_id": "b097211c-f9ac-3ae4-9278-1405fc42788a",
                                        "glosses": [
                                            "het verschijnsel dat alle stemhebbende obstruenten stemloos worden uitgesproken als ze aan het woordeinde of in een spreekpauze staan"
                                        ],
