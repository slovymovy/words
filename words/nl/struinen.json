{
    "word_family": [
        "struiner",
        "gestruin"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40b86178-0175-3f10-a4ff-dce8a363a7f6",
                    "sense_definition": "Op een ontspannen of zoekende manier ronddwalen of wandelen, vaak door de natuur of een stad.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ronddwalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We wilden lekker door het bos <w>struinen</w> en genieten van de herfstkleuren.",
                            "target_lang_translations": {
                                "en": "We wanted to <w>wander</w> through the forest and enjoy the autumn colors."
                            }
                        },
                        {
                            "text": "Tijdens onze vakantie hielden we ervan om urenlang door de oude straatjes te <w>struinen</w>.",
                            "target_lang_translations": {
                                "en": "During our vacation, we loved to <w>stroll</w> through the old streets for hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "wandelen",
                        "dwalen",
                        "ronddwalen",
                        "slenteren",
                        "kuieren",
                        "ronddolen",
                        "rondsjouwen"
                    ],
                    "common_phrases": [
                        "door het bos struinen",
                        "door de straten struinen"
                    ],
                    "target_lang_definitions": {
                        "en": "To wander or stroll in a relaxed or searching manner, often through nature or a city."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "to walk around in a relaxed, aimless way"
                            },
                            {
                                "target_lang_word": "stroll",
                                "target_lang_sense_clarification": "to walk in a leisurely way"
                            },
                            {
                                "target_lang_word": "roam",
                                "target_lang_sense_clarification": "to travel or walk about without a fixed destination"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38a91411-d81b-3984-9174-3b1378039f07",
                    "sense_definition": "Nieuwsgierig rondkijken of zoeken naar iets interessants, bijvoorbeeld op een markt of internet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind het heerlijk om op rommelmarkten te <w>struinen</w> naar oude boeken.",
                            "target_lang_translations": {
                                "en": "I love to <w>browse</w> flea markets for old books."
                            }
                        },
                        {
                            "text": "Zij kan urenlang op het internet <w>struinen</w> naar leuke aanbiedingen.",
                            "target_lang_translations": {
                                "en": "She can <w>browse</w> the internet for hours looking for great deals."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondsnuffelen",
                        "snuffelen",
                        "rondkijken",
                        "rondscharrelen"
                    ],
                    "common_phrases": [
                        "op rommelmarkten struinen",
                        "op internet struinen"
                    ],
                    "target_lang_definitions": {
                        "en": "To look around curiously or search for something interesting, for example at a market or on the internet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "browse",
                                "target_lang_sense_clarification": "to look through items or information casually"
                            },
                            {
                                "target_lang_word": "rummage",
                                "target_lang_sense_clarification": "to search through a place or container, like a market stall"
                            },
                            {
                                "target_lang_word": "nose about",
                                "target_lang_sense_clarification": "to snoop or look around curiously"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}