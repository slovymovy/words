                "senses": [
                    {
                        "sense_id": "4f86f1c7-cb25-3941-bf52-430bb7ff8cf2",
                        "entry_id": "ce2a6aeb-d056-37b1-afe2-7b8b5d9c1cd0",
                        "glosses": [
                            "prostytutka lub kobieta mająca przygodne kontakty seksualne z mężczyznami"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "547cc71c-451e-4330-a414-005e5bd9c37c",
                        "source_entry_id": "ce2a6aeb-d056-37b1-afe2-7b8b5d9c1cd0",
                        "source_sense_id": "4f86f1c7-cb25-3941-bf52-430bb7ff8cf2",
                        "target_lang_word": "harlot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harlot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cde68bae-e84d-3d75-a9e3-3f6ed273d72e",
                                        "entry_id": "a4a9e135-09d1-37fb-b7e6-8ed0b08ade80",
                                        "glosses": [
                                            "A female prostitute."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f591e3-8a63-4b3d-b7e4-c133d4f444ee",
                                                "sense_id": "cde68bae-e84d-3d75-a9e3-3f6ed273d72e",
                                                "text": "This day (great Duke) ſhe ſhut the doores vpon me, / While she with Harlots feaſted in my housſe."
                                            },
                                            {
                                                "example_id": "9f25fb75-0a4d-4fbe-b2bf-6d234fe42518",
                                                "sense_id": "cde68bae-e84d-3d75-a9e3-3f6ed273d72e",
                                                "text": "The bastard of a harlot, born in a brothel, suckled on gin, and familiar from earliest infancy with all the bestialities of debauch,[…]"
                                            },
                                            {
                                                "example_id": "78848652-fe04-4212-8325-86a3711a8aad",
                                                "sense_id": "cde68bae-e84d-3d75-a9e3-3f6ed273d72e",
                                                "text": "Truly, My Satan, thou art but a Dunce, / And dost not know the Garment from the Man. / Every Harlot was a Virgin once, / Nor canst thou ever change Kate into Nan."
                                            },
                                            {
                                                "example_id": "cc2823da-e875-4692-a6dc-3270f549f1bb",
                                                "sense_id": "cde68bae-e84d-3d75-a9e3-3f6ed273d72e",
                                                "text": "He was stopped by a painted harlot, who put her hand on his arm; he pushed her violently away with brutal words."
                                            },
                                            {
                                                "example_id": "a47d900c-cac7-4f02-a3c4-249d3768a448",
                                                "sense_id": "cde68bae-e84d-3d75-a9e3-3f6ed273d72e",
                                                "text": "O fine religious, decent folk, / In Virtue’s flaunting gold and scarlet, / I sneer between two puffs of smoke,— / Give me the publican and harlot."
                                            },
                                            {
                                                "example_id": "f3d6174e-d825-4f18-8ef2-2fa1a67bae76",
                                                "sense_id": "cde68bae-e84d-3d75-a9e3-3f6ed273d72e",
                                                "text": "Charlotte the Harlot show me your legs, / Charlotte the Harlot take me to bed. / Charlotte the Harlot let me see blood, / Charlotte the Harlot let me see love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377a4ae0-362a-330c-b41d-8e45e997d15c",
                                        "entry_id": "a4a9e135-09d1-37fb-b7e6-8ed0b08ade80",
                                        "glosses": [
                                            "A female who is considered promiscuous."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2df79c4c-8e7e-3f8f-9d79-61cd033898fa",
                                        "entry_id": "a4a9e135-09d1-37fb-b7e6-8ed0b08ade80",
                                        "glosses": [
                                            "A churl; a common man; a person, male or female, of low birth, especially one given to low conduct."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ab4428-e1e3-4d81-861a-032215baf894",
                                                "sense_id": "2df79c4c-8e7e-3f8f-9d79-61cd033898fa",
                                                "text": "By suche ydle and wicked harlottes the enheritaunce of Christe is troden vnder fote."
                                            },
                                            {
                                                "example_id": "0c9e055c-ea8a-460c-9ec4-ef2e9c13bcb0",
                                                "sense_id": "2df79c4c-8e7e-3f8f-9d79-61cd033898fa",
                                                "text": "When lust doth rage it like a canker frets;\nIt topsie turvie, upside downe all sets;[…]\nWhere once it reigneth, there it maketh sure,\nA man a harlot, and a wife a whoore;"
                                            },
                                            {
                                                "example_id": "dd6ef606-cd03-4787-9ed9-c61d62dadba0",
                                                "sense_id": "2df79c4c-8e7e-3f8f-9d79-61cd033898fa",
                                                "text": "[Take into your service] none but such as deny all ungod∣liness, and worldly lusts, and live soberly, chastely, and moderately in the Seas, and whose speech is not stinking, and unclean, as most Sea-mens are. What should you do with such Harlots in your service? which calls for holiness, and better principled men."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harlot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "753f0298-757c-3790-92df-5b36851792e6",
                                        "entry_id": "b296b62b-ebd7-3bed-9c45-3d88b5cd8dcd",
                                        "glosses": [
                                            "To play the harlot; to practice lewdness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c1326a-9b62-4e0a-ab93-b8300f4722c4",
                                                "sense_id": "753f0298-757c-3790-92df-5b36851792e6",
                                                "text": "[…] they that spend their youth in loitering, bezzling, and harlotting, their studies in unprofitable questions, and barbarous sophistry"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harlot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75c713c8-4f17-3d15-b0fa-364d940c56a6",
                                        "entry_id": "9f1f3c8d-c674-3462-ae8a-c081d99ddf66",
                                        "glosses": [
                                            "Wanton; lewd; low; base."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ddcebf9-b569-42a2-8b8e-d437222af9ea",
                                                "sense_id": "75c713c8-4f17-3d15-b0fa-364d940c56a6",
                                                "text": "The intellection in it, kiddo—the intellection.... That most harlot of harlots... talking of me, laughing at me... I'll kill her...."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "508af015-fad3-4e5b-99d8-f2752b8bf5a2",
                        "source_entry_id": "ce2a6aeb-d056-37b1-afe2-7b8b5d9c1cd0",
                        "source_sense_id": "4f86f1c7-cb25-3941-bf52-430bb7ff8cf2",
                        "target_lang_word": "strumpet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strumpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c97e064-2c6d-313e-b369-f2ffe8ade40e",
                                        "entry_id": "a1c4e905-98ea-32ab-89f2-8af02b419251",
                                        "glosses": [
                                            "A female prostitute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6883a67e-3aff-4020-ac81-57d9bc57b652",
                                                "sense_id": "5c97e064-2c6d-313e-b369-f2ffe8ade40e",
                                                "text": "Em[ilia]. Fie, fie vpon thee ſtrumpet. / Bian[ca]. I am no ſtrumpet, but of life as honeſt, / As you, that thus abuſe me. / Em[ilia]. As I: fough, fie vpon thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f922a93-d203-3dff-9be4-f1297f35ba43",
                                        "entry_id": "a1c4e905-98ea-32ab-89f2-8af02b419251",
                                        "glosses": [
                                            "A woman who is very sexually active."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dc28094-8e70-3a4d-adff-699792f06f01",
                                        "entry_id": "a1c4e905-98ea-32ab-89f2-8af02b419251",
                                        "glosses": [
                                            "A female adulterer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59f9e55b-245f-30d1-a1d6-d52d533f19e6",
                                        "entry_id": "a1c4e905-98ea-32ab-89f2-8af02b419251",
                                        "glosses": [
                                            "A mistress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea26ed0a-3372-356b-8c9c-c32aaa7dac65",
                                        "entry_id": "a1c4e905-98ea-32ab-89f2-8af02b419251",
                                        "glosses": [
                                            "A trollop; a whore."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1320b0f-119d-4f36-ba9a-dad6114f150c",
                                                "sense_id": "ea26ed0a-3372-356b-8c9c-c32aaa7dac65",
                                                "text": "He cals her on a ſudden, all to naught; ſhe is a ſtrumpet, a light huswife, a bitch, an arrant whore."
                                            },
                                            {
                                                "example_id": "f9ecea65-e643-440d-9798-660355f32eb8",
                                                "sense_id": "ea26ed0a-3372-356b-8c9c-c32aaa7dac65",
                                                "text": "We have legalized the strumpet and are guarding her retreat; Greed is seeking out commercial souls before his judgement seat; O, be swift, ye clods, to answer him! be jubilant my feet! Our god is marching on!"
                                            },
                                            {
                                                "example_id": "5cb120bf-4eca-49ee-9f38-f9afacd6fbcf",
                                                "sense_id": "ea26ed0a-3372-356b-8c9c-c32aaa7dac65",
                                                "text": "However, terrible as it may seem to the tall maiden sisters of J.P.'s in Queen Anne houses with walled vegetable gardens, this courtesan, strumpet, harlot, whore, punk, fille de joie, street-walker, this trollop, this trull, this baggage, this hussy, this drab, skit, rig, quean, mopsy, demirep, demimondaine, this wanton, this fornicatress, this doxy, this concubine, this frail sister, this poor Queenie--did actually solicit me, did actually say 'coming home to-night, dearie' and my soul was not blasted enough to call a policeman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "strumpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "701227a2-62f3-3ef0-af96-c9f16acd8827",
                                        "entry_id": "8924a79c-46fa-347e-ba4e-b792bdc44300",
                                        "glosses": [
                                            "To debauch."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a6f6fb-0941-4820-bbb8-fc0d156008ff",
                                                "sense_id": "701227a2-62f3-3ef0-af96-c9f16acd8827",
                                                "text": "My blood is mingled with the crime of lust; / For if we two be one, and thou play false, / I do digest the poison of thy flesh, / Being strumpeted by thy contagion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f87272-5db4-3973-8ac4-de628bb18fd5",
                                        "entry_id": "8924a79c-46fa-347e-ba4e-b792bdc44300",
                                        "glosses": [
                                            "To dishonour with the reputation of being a strumpet; to belie; to slander."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f96e24f-7385-43bf-958a-3860f614f872",
                                                "sense_id": "88f87272-5db4-3973-8ac4-de628bb18fd5",
                                                "text": "That proud man, that vvas / Deny'd the honour of your bed, yet durſt / VVith his untrue reports, ſtrumpet your fame, / Compell'd by mee, hath given himſelfe the lye, / And in his ovvne blood vvrote it, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9c3e1bf-cf3b-4244-a825-52a46f2d4b06",
                        "source_entry_id": "ce2a6aeb-d056-37b1-afe2-7b8b5d9c1cd0",
