                                        "sense_id": "ff386bf2-3b0e-3a45-a8d3-5d45b61b082c",
                                        "entry_id": "dca9495b-280b-3651-9afa-73b0bea56f41",
                                        "glosses": [
                                            "A dessert consisting of chestnut purée which has been riced or extruded into vermicelli-like noodles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddcbc496-0eec-4e8a-aa67-115eb9723bb0",
                                                "sense_id": "ff386bf2-3b0e-3a45-a8d3-5d45b61b082c",
                                                "text": "... chestnut purée is often minimally altered. A Mont Blanc, for example, showcases its slightly sticky, candied attraction with only a little whipped cream and meringue to temper it."
                                            },
                                            {
                                                "example_id": "d9031408-dc5e-400b-ad01-ec996e0e2eb4",
                                                "sense_id": "ff386bf2-3b0e-3a45-a8d3-5d45b61b082c",
                                                "text": "A Mont Blanc is a celebration of decadent chestnut cream, a particularly beloved and nostalgic French flavor, and is eaten primarily around Christmas."
                                            },
                                            {
                                                "example_id": "89c486e6-7a04-46cb-8017-a4060159ec23",
                                                "sense_id": "ff386bf2-3b0e-3a45-a8d3-5d45b61b082c",
                                                "text": "\"I cut a slice of Mont Blanc for you. Here you go.\" The Mont Blanc on the fork had been beautifully split into four, and the layers of cream and sponge cake inside were visible. \"This is all yours! I added a whole chestnut on top too!\""
                                            },
                                            {
                                                "example_id": "776b5bbc-659f-4cb9-9135-2c297bfd7819",
                                                "sense_id": "ff386bf2-3b0e-3a45-a8d3-5d45b61b082c",
                                                "text": "... a Mont Blanc pudding of chestnut purée and cream. After Yvonne said this was one of Ninette's favourite dishes, he sent a bowl to the Palace with a card saying it was for the Dreyfus sisters and Manon. Ninette sent chocolates in[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
