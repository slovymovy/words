                "senses": [
                    {
                        "sense_id": "6401a5fc-4d9b-3ef3-9d7d-f7a9d2478d71",
                        "entry_id": "1a22d955-623e-39a0-a0ff-01c8e398a89a",
                        "glosses": [
                            "ein Hilfsmittel, das etwas verschlossenes öffnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b4355c-2dfb-4557-b99b-50e08d3daf76",
                                "sense_id": "6401a5fc-4d9b-3ef3-9d7d-f7a9d2478d71",
                                "text": "Gib mir mal den Öffner, denn meine Zähne haben die letzte Bierflasche nicht überstanden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2c633c1-0157-3460-87bf-1fdcf78b5da5",
                        "entry_id": "1a22d955-623e-39a0-a0ff-01c8e398a89a",
                        "glosses": [
                            "eine Vorrichtung, die etwas verschlossenes öffnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb263bd8-b8ed-4aec-ad58-94d35cb3864a",
                                "sense_id": "a2c633c1-0157-3460-87bf-1fdcf78b5da5",
                                "text": "Drück ja nicht den Öffner! Denn die Schwiegermutter soll noch ein wenig den Regen genießen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                        "entry_id": "1a22d955-623e-39a0-a0ff-01c8e398a89a",
                        "glosses": [
                            "eine elektrische Vorrichtung beziehungsweise Schaltung, die den elektrischen Strom unterbricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b50e541-22bc-4c5e-86c8-91f323d4cf65",
                                "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                                "text": "Der Öffner der Schaltung hat nur eine Wirkung, wenn er nicht vom Schließer des anderen Schützes überbrückt wird."
                            },
                            {
                                "example_id": "5de8197d-c5d4-4829-8695-39b3d8632bbd",
                                "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                                "text": "NOT-Aus-Taster sind Öffner."
                            },
                            {
                                "example_id": "e9d3becf-1762-4520-be6f-f0f55d0175ad",
                                "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                                "text": "Bei Betätigung stellen Einschalter als Schließer Kontaktverbindungen her, während Öffner Verbindungen trennen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
