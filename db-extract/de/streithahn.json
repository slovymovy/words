                "senses": [
                    {
                        "sense_id": "482dd4cb-eafb-378e-bfd9-3a95c7bfa03e",
                        "entry_id": "b78d5808-0cd1-3ed5-8dfe-d41ec76808a7",
                        "glosses": [
                            "jemand, der immer wieder mit anderen in Streit gerät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae54756f-30d9-4d9d-a22e-2d7d796b929a",
                                "sense_id": "482dd4cb-eafb-378e-bfd9-3a95c7bfa03e",
                                "text": "„Gleich darauf hatten sich die Streithähne wieder in den zerrauften Haaren.“"
                            },
                            {
                                "example_id": "706b4cda-fd3e-49c6-8bc3-ce9285a49c6a",
                                "sense_id": "482dd4cb-eafb-378e-bfd9-3a95c7bfa03e",
                                "text": "„Du hast es schon bei uns gegessen, obwohl es nicht auf der Speisekarte steht, denn Mansaf ist ein Gericht, das man serviert, wenn man Streithähne miteinander versöhnen oder jemandes Herz gewinnen will, Freunden eine Freude machen oder jemanden trösten möchte, der Trost braucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
