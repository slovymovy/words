                    {
                        "sense_id": "0b832ebe-3e90-3d5f-9011-7d80130fb62c",
                        "entry_id": "bd3577e9-51e7-3ad3-ba72-1d8b53a0b6a8",
                        "glosses": [
                            "One who runs a shop, either the owner or manager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d15a99-ec9d-43af-b6cc-471470cbb81c",
                                "sense_id": "0b832ebe-3e90-3d5f-9011-7d80130fb62c",
                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                            }
                        ]
                    },
                    {
                        "sense_id": "21ca8f53-664d-3f60-85a1-1188b8cd6631",
                        "entry_id": "bd3577e9-51e7-3ad3-ba72-1d8b53a0b6a8",
                        "glosses": [
                            "One who is in charge of stores or goods of any kind."
                        ],
                        "tags": [],
                        "examples": [
