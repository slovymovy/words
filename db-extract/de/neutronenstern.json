                "senses": [
                    {
                        "sense_id": "d6dbc995-ff15-3a73-bd91-22a9cfe40daf",
                        "entry_id": "35de4f15-434b-33ed-b0a1-c3a36878c072",
                        "glosses": [
                            "kosmisches Objekt, das im Wesentlichen aus Neutronen besteht und am Ende seiner Sternentwicklung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28e6c4d-f9fe-46c8-981d-787dad948219",
                                "sense_id": "d6dbc995-ff15-3a73-bd91-22a9cfe40daf",
                                "text": "Neutronensterne sind nicht nur hinsichtlich ihrer Dichte, sondern auch hinsichtlich ihres Magnetfeldes, ihrer Temperatur und weiterer physikalischer Größen die extremsten Objekte im Kosmos, die man überhaupt kennt."
                            },
                            {
                                "example_id": "f82109cd-96cd-454d-b148-7ab2620de095",
                                "sense_id": "d6dbc995-ff15-3a73-bd91-22a9cfe40daf",
                                "text": "„Im Zentrum des Krebsnebels befinden sich die Reste eines einst massereichen Sterns, ein rotierender Neutronenstern, der mehr oder weniger rasch pulsierende, hoch- und niedrigenergetische Strahlung aussendet und deshalb \"Pulsar\" genannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c10c7b80-f3e3-42c8-ae22-647e4cfb2299",
                        "source_entry_id": "35de4f15-434b-33ed-b0a1-c3a36878c072",
                        "source_sense_id": "d6dbc995-ff15-3a73-bd91-22a9cfe40daf",
