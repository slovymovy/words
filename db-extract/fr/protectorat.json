                                        "sense_id": "44f49719-1187-37d8-b444-7639a2dd480b",
                                        "entry_id": "25915685-5bd5-34a0-8ae1-f6ecd2f2a3e6",
                                        "glosses": [
                                            "An autonomous state under protectorate."
                                        ],
