                                "target_senses": [
                                    {
                                        "sense_id": "29c2c288-a3a6-31bf-9d45-a0ff7d616383",
                                        "entry_id": "c7c77f50-0771-37a1-8160-0af371cddae4",
                                        "glosses": [
                                            "Polir, raboter avec la varlope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d3afda-8373-4e75-b4cf-24fc270f3517",
                                                "sense_id": "29c2c288-a3a6-31bf-9d45-a0ff7d616383",
                                                "text": "Ceux qui fournissaient les matériaux de construction devaient être équarris à la grande hache ou débité, avec une scie maniée par deux hommes, en madriers et en planches, qu’il fallait varloper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b498cad1-cea8-3016-995e-baa810079472",
                                        "entry_id": "c7c77f50-0771-37a1-8160-0af371cddae4",
                                        "glosses": [
                                            "Débiter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7397466d-b8fc-4853-87de-58e086a70187",
                                                "sense_id": "b498cad1-cea8-3016-995e-baa810079472",
                                                "text": "Sa voix nette et coupante varlopait ses axiomes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2375fda-2243-3e85-94fd-b417879def53",
                                        "entry_id": "c7c77f50-0771-37a1-8160-0af371cddae4",
                                        "glosses": [
                                            "Retrancher violemment d’un tout."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1bf3b3-4a4a-4315-9cbe-42fade8e7c8b",
                                                "sense_id": "c2375fda-2243-3e85-94fd-b417879def53",
                                                "text": "À mes yeux, l’électoralisme péquiste a varlopé ce qu’il y avait de frais et de révolutionnaire dans l’idée d’indépendance."
                                            },
                                            {
                                                "example_id": "a000f84d-d9ab-49de-84fb-2a47d4688411",
                                                "sense_id": "c2375fda-2243-3e85-94fd-b417879def53",
                                                "text": "Une employee varlopee parce qu' elle ne parle pas francais"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7edc3477-8c2d-382e-ab2e-c6fbe62c0570",
                                        "entry_id": "c7c77f50-0771-37a1-8160-0af371cddae4",
                                        "glosses": [
                                            "Maltraiter ou malmener fortement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c10bc7-e692-45e4-9847-d141b8a5844b",
                                                "sense_id": "7edc3477-8c2d-382e-ab2e-c6fbe62c0570",
                                                "text": "On peut dire qu’un des mots de la langue française qui se fait varloper le plus souvent c’est le mot connexion."
                                            },
                                            {
                                                "example_id": "9ff77180-1a82-4da3-bd4e-e1ee4a13160f",
                                                "sense_id": "7edc3477-8c2d-382e-ab2e-c6fbe62c0570",
                                                "text": "Je voulais me faire ma propre opinion sur ce film québécois qui s’est fait varloper par la critique."
                                            },
                                            {
                                                "example_id": "58b859ce-bed6-4a9c-a63d-03aaecb87a14",
                                                "sense_id": "7edc3477-8c2d-382e-ab2e-c6fbe62c0570",
                                                "text": "Moutier écrit donc que sa liberté d’expression littéraire a été limitée au nom d’une morale qu’il varlope avec ironie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0dd7dc-7ab6-3cc6-980e-b09bbbae311a",
                                        "entry_id": "c7c77f50-0771-37a1-8160-0af371cddae4",
                                        "glosses": [
                                            "Bricoler."
                                        ],
                                        "tags": [
