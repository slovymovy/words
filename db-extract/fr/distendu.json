            {
                "entry_id": "ff034b20-ffd8-3596-9258-1b15f82dbb68",
                "word": "distendu",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2dd9698a-be47-364e-b1d2-e880f91e599e",
                        "entry_id": "ff034b20-ffd8-3596-9258-1b15f82dbb68",
                        "glosses": [
                            "Participe passé masculin singulier de distendre."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "60202354-4aa7-478d-a21e-ed458d5d39dc",
                                "sense_id": "2dd9698a-be47-364e-b1d2-e880f91e599e",
                                "text": "La haute lampe placée derrière les promeneurs éclaira subitement l’homme qui riait sans bruit, les yeux fermés. Sur son visage blanchâtre, distendu par une hilarité muette, la sueur coulait à grosses gouttes."
                            },
                            {
                                "example_id": "e77ae6e0-7089-403d-815c-192803394465",
                                "sense_id": "2dd9698a-be47-364e-b1d2-e880f91e599e",
                                "text": "Les lobes de ses oreilles ont été distendus par des boucles à trois étages et le trou percé autrefois est devenu une longue fente tellement pèsent les pierres et l’or."
                            },
                            {
                                "example_id": "f48876fb-85b9-4b88-913c-9fb9e0826911",
                                "sense_id": "2dd9698a-be47-364e-b1d2-e880f91e599e",
                                "text": "« C'est pour qui ? » se renseigna le Michel-Ange de l'épiderme, tout en se grattant les roustons à travers son calfouette distendu et d'une couleur indéfinissable."
                            }
                        ]
                    }
                ],
