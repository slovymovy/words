                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf4e5e3-53d6-41df-832c-0ae880547656",
                                                "sense_id": "b6116e95-b96e-3809-80db-e3ec713f207f",
                                                "text": "\"You're useless when you're high on catnip, you know that?\" \"Mewww mew?\" \"No I will NOT put on Dark Side of the Moon and the Wizard of Oz for you. Goddamned stoner cat.\""
