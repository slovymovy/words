                        "source_sense_id": "b6b69f09-e205-3233-88ab-099ffd359d5a",
                        "source_sense_description": "abwägendes Verhalten, Berücksichtigung mehrerer Seiten einer schwierigen Angelegenheit",
                        "target_lang_word": "balancing act",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balancing act",
