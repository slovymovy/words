                                    },
                                    {
                                        "sense_id": "06f2eba4-deac-3e9c-99f8-1ac5c64843a4",
                                        "entry_id": "91752adc-a429-3cc7-bc56-83316a55fd55",
                                        "glosses": [
                                            "A sweet/candy having a sharply sour taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd0d993-f049-4b13-a3f2-c06628391245",
                                                "sense_id": "06f2eba4-deac-3e9c-99f8-1ac5c64843a4",
                                                "text": "“You know I like them candies, especially the lemon sours.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f092e6-8023-35e5-b165-549eee44a4f5",
                                        "entry_id": "91752adc-a429-3cc7-bc56-83316a55fd55",
                                        "glosses": [
                                            "A sour or acid substance; whatever produces a painful effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ec3c94-ebbb-4f69-9fdd-bfab6b4f87f6",
                                                "sense_id": "28f092e6-8023-35e5-b165-549eee44a4f5",
                                                "text": "For many Years of Sorrow can dispense;\nA Dram of Sweet is worth a Pound of Sour"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e37d430-3218-3f1c-8241-27f039ee8baf",
                                        "entry_id": "91752adc-a429-3cc7-bc56-83316a55fd55",
                                        "glosses": [
                                            "The acidic solution used in souring fabric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0ba2f0-3860-306c-962a-7765fe759683",
                                        "entry_id": "6b03a170-478b-3aa0-bee8-edd8605f7754",
                                        "glosses": [
                                            "To make sour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75274117-c9bf-4372-80f9-38659ce9217d",
                                                "sense_id": "bc0ba2f0-3860-306c-962a-7765fe759683",
                                                "text": "Too much lemon juice will sour the recipe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62887888-aab8-3cfb-bf26-b3bbf5125d29",
                                        "entry_id": "6b03a170-478b-3aa0-bee8-edd8605f7754",
                                        "glosses": [
                                            "To become sour."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb2bc9cb-465c-4fd4-8b35-5d436a306392",
                                                "sense_id": "62887888-aab8-3cfb-bf26-b3bbf5125d29",
                                                "text": "So the sun's heat, with different powers, / Ripens the grape, the liquor sours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaca5175-6e2e-314b-916f-76cd00f7f50e",
                                        "entry_id": "6b03a170-478b-3aa0-bee8-edd8605f7754",
                                        "glosses": [
                                            "To spoil or mar; to make disenchanted."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "925c8832-d5f8-47d0-8ff1-801808e50513",
                                                "sense_id": "eaca5175-6e2e-314b-916f-76cd00f7f50e",
                                                "text": "To sour your happiness I must report, / The queen is dead."
                                            },
                                            {
                                                "example_id": "874cceef-e525-4ad5-b842-88665ee3bbeb",
                                                "sense_id": "eaca5175-6e2e-314b-916f-76cd00f7f50e",
                                                "text": "He was prudent and industrious, and so good a husbandman, that he might have led a very easy and comfortable life, had not an arrant vixen of a wife soured his domestic quiet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d4f57e5-9de6-3656-8050-724f89fae9b6",
                                        "entry_id": "6b03a170-478b-3aa0-bee8-edd8605f7754",
                                        "glosses": [
                                            "To become disenchanted."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee27e1d5-f189-40e0-8f24-0467b8f15f68",
                                                "sense_id": "9d4f57e5-9de6-3656-8050-724f89fae9b6",
                                                "text": "We broke up after our relationship soured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf75721a-5ef5-3ce4-94e6-d86ce9232f14",
                                        "entry_id": "6b03a170-478b-3aa0-bee8-edd8605f7754",
                                        "glosses": [
                                            "To make (soil) cold and unproductive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d68231-33c1-4b1d-82b0-dd55e006f05a",
                                                "sense_id": "cf75721a-5ef5-3ce4-94e6-d86ce9232f14",
                                                "text": "stagnant water , which tends to sour the soil"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86110446-7e7a-3942-9de6-854fc6c1f8ba",
                                        "entry_id": "6b03a170-478b-3aa0-bee8-edd8605f7754",
                                        "glosses": [
