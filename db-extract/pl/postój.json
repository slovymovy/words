                                        "sense_id": "44efbdff-8cd1-3325-aa52-8bf084cf7ee4",
                                        "entry_id": "4f52791b-4203-326c-946b-7160afd77f7f",
                                        "glosses": [
                                            "разг. расстояние между двумя ближайшими пунктами, где останавливается трамвай, автобус, поезд и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f55d315-1843-4cfd-8ffd-10fc67ef6d7c",
                                                "sense_id": "44efbdff-8cd1-3325-aa52-8bf084cf7ee4",
                                                "text": "Лёха живет в шести остановках трамваем от метро «Коломенская»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bfad6fb-1b76-42ca-91e5-33b791e45613",
                        "source_entry_id": "80c33e38-2df0-3746-893d-b2f44b15b15e",
                        "source_sense_id": "e1f0f384-5c84-37ea-a003-4300e00eef6b",
                        "target_lang_word": "стоянка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стоянка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8955e6e6-243f-3587-a8e9-b22ced51a9cd",
                                        "entry_id": "ca22b3a4-7ee8-3cbe-9f3a-9880b3be7075",
                                        "glosses": [
                                            "остановка во время движения, похода и тому подобного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23053966-5017-4acc-9c05-c13d3e96e9d2",
                                                "sense_id": "8955e6e6-243f-3587-a8e9-b22ced51a9cd",
                                                "text": "Помню: мы ехали поездом в Париж, и в Варшаве стоянка длилась полчаса — он радовался, что можно выйти из вагона и не быть кем-то узнанным."
                                            },
                                            {
                                                "example_id": "47fd446f-b7b7-4e89-9519-f05875f63bef",
                                                "sense_id": "8955e6e6-243f-3587-a8e9-b22ced51a9cd",
                                                "text": "Я подошла к окну и выглянула — на асфальтовой полоске за газоном темнел силуэт припаркованного автомобиля, а уж мне ли было не знать, что стоянка там запрещена?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "330bbbe3-bf4f-32be-98a3-e1137bd48591",
                                        "entry_id": "ca22b3a4-7ee8-3cbe-9f3a-9880b3be7075",
                                        "glosses": [
                                            "место, где происходит или происходила стоянка [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a704f8d-61a9-47b3-ada0-04759943382f",
                                                "sense_id": "330bbbe3-bf4f-32be-98a3-e1137bd48591",
                                                "text": "Первая стоянка нашей эскадры — древний, живописный, неповторимый Стамбул."
                                            },
                                            {
                                                "example_id": "bf6c5e51-8a2a-4c46-b13e-a077c7d04203",
                                                "sense_id": "330bbbe3-bf4f-32be-98a3-e1137bd48591",
                                                "text": "Секретарши и стенографистки городских учреждений в Вашингтоне, задержавшиеся на службе до темноты, боятся перебежать улицу до стоянки такси, даже если стоянка находится наискосок от здания конгресса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f743f89f-2f0a-3576-bb83-e3308ec72a00",
                                        "entry_id": "ca22b3a4-7ee8-3cbe-9f3a-9880b3be7075",
                                        "glosses": [
                                            "археол. место обитания первобытных людей или остановки кочевников"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdeefd74-7589-4640-a414-7f9841055e1b",
                                                "sense_id": "f743f89f-2f0a-3576-bb83-e3308ec72a00",
                                                "text": "Интересной была только экскурсия на Кавголовское озеро — на песчаную косу, где, по словам Юры, была неолитическая стоянка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
