{
    "word_family": [
        "recouvrement",
        "recouvrable",
        "irrécouvrable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed160be1-010c-3cc6-ab55-6dd7ee27ea6b",
                    "sense_definition": "Retrouver ou rentrer en possession de ce qu'on avait perdu, en particulier un état, une faculté ou un droit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs semaines de repos complet, le patient a enfin réussi à <w>recouvrer</w> la santé."
                        },
                        {
                            "text": "Il lui a fallu quelques minutes pour <w>recouvrer</w> ses esprits après cette terrible nouvelle."
                        }
                    ],
                    "synonyms": [
                        "retrouver",
                        "récupérer"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "recouvrer la santé",
                        "recouvrer la vue",
                        "recouvrer ses esprits",
                        "recouvrer son calme"
                    ]
                },
                {
                    "sense_id": "668c4916-00dd-373a-b2dc-c9b662815c64",
                    "sense_definition": "Obtenir le paiement ou la restitution d'une somme d'argent due par un débiteur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise fait appel à un huissier pour <w>recouvrer</w> les factures impayées depuis des mois."
                        },
                        {
                            "text": "Nous espérons <w>recouvrer</w> cette créance avant la clôture définitive de l'exercice comptable."
                        }
                    ],
                    "synonyms": [
                        "percevoir",
                        "encaisser",
                        "récupérer"
                    ],
                    "common_phrases": [
                        "recouvrer une dette",
                        "recouvrer une créance",
                        "recouvrer des impayés"
                    ]
                },
                {
                    "sense_id": "3d968de3-a34c-3b52-8e05-9af41cf0b1f5",
                    "sense_definition": "Percevoir des impôts, taxes ou cotisations pour le compte de l'administration publique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le Trésor public est chargé de <w>recouvrer</w> l'impôt auprès des contribuables chaque année."
                        },
                        {
                            "text": "Ces nouvelles taxes seront directement <w>recouvrées</w> par les services des douanes."
                        }
                    ],
                    "synonyms": [
                        "percevoir",
                        "lever",
                        "collecter"
                    ],
                    "common_phrases": [
                        "recouvrer l'impôt",
                        "recouvrer des taxes"
                    ]
                }
            ]
        }
    ]
}