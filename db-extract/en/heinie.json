    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0d5a5c5d-49f9-3276-a979-c4fcb5fde53e",
                "word": "Heinie",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26abc8c2-9b84-3216-956b-e7b53a896b9e",
                        "entry_id": "0d5a5c5d-49f9-3276-a979-c4fcb5fde53e",
                        "glosses": [
                            "A diminutive form of Heinrich, or its English cognate Henry, sometimes applied to a person of (real or supposed) German heritage."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "000e3597-be74-48ec-8ee3-c6c048a16d8a",
                                "sense_id": "26abc8c2-9b84-3216-956b-e7b53a896b9e",
                                "text": "Henry \"Heinie\" Manush,^([Heinie Manush]) yet another outfield prospect, joined the Tigers in 1923, having impressed management with his outstanding Western League batting average of .375 the previous season. Major league pitching proved no mystery to Heinie either, as he connected for a .334 batting average in 1924, his freshman season."
                            },
                            {
                                "example_id": "ce2f96fa-1bbb-444c-adb2-5501dccf12d9",
                                "sense_id": "26abc8c2-9b84-3216-956b-e7b53a896b9e",
                                "text": "Heinie^([Heinie Zimmerman]) played with the Cubs from 1907 thru 1916, as a third baseman."
                            },
                            {
                                "example_id": "c8a68b55-78bd-4766-bbd5-fce3d7b56c5f",
                                "sense_id": "26abc8c2-9b84-3216-956b-e7b53a896b9e",
                                "text": "Lieutenant Colonel Harry C. “Heinie” Aderholt,^([Harry C. Aderholt]) who was born and raised in Birmingham, had been with the CIA since the Korean War and now commanded clandestine air operations out of Okinawa and Thailand. Heinie Aderholt knew most of the Alabama Guard pilots."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7c2ba1ec-907b-3eee-94cb-735df012a8ca",
                "word": "heinie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bb646b79-10f3-4063-a593-6d08ba291b90",
                        "entry_id": "7c2ba1ec-907b-3eee-94cb-735df012a8ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "heinies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "562e3670-6c3b-364b-bf5a-a3c6dae49af9",
                        "entry_id": "7c2ba1ec-907b-3eee-94cb-735df012a8ca",
                        "glosses": [
                            "The buttocks."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "595bc6b9-d2c2-487b-ae92-0814ef6c3648",
                                "sense_id": "562e3670-6c3b-364b-bf5a-a3c6dae49af9",
                                "text": "She had spent enough time kissing heinies to wear her lips right off. And Shelby Symington didn't like kissing heinies. Down in Atlanta, where she was from, people used to line up to kiss hers."
                            },
                            {
                                "example_id": "16c21ea7-4b48-460c-8a1e-f7e1ca8ef38d",
                                "sense_id": "562e3670-6c3b-364b-bf5a-a3c6dae49af9",
                                "text": "2001, Stephen Coonts, America: Jake Grafton, Book 9, 2013, unnumbered page,\n“I hope you’re right,” Jake said, “because if you aren’t, Jacob Lee Grafton, we’ve been betting our heinies for a lot of years. One more big bet won’t make any difference.”"
                            },
                            {
                                "example_id": "0ca6d80a-f845-4cc4-b1e7-419ce3e01ea8",
                                "sense_id": "562e3670-6c3b-364b-bf5a-a3c6dae49af9",
                                "text": "But Leandro simply could not reconcile himself to the thought of her taking all the risk to save both their heinies."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "08c9ed2c-c9b9-3adb-8ef9-d545b6b50ec1",
                "word": "Heinie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ebc340c7-8f8f-4636-9724-dc7316c0d30e",
                        "entry_id": "08c9ed2c-c9b9-3adb-8ef9-d545b6b50ec1",
                        "tags": [
                            "plural"
                        ],
                        "form": "Heinies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8799497a-e859-35e4-a199-a535c8c8b08c",
                        "entry_id": "08c9ed2c-c9b9-3adb-8ef9-d545b6b50ec1",
                        "glosses": [
                            "A German, especially a German soldier."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "47926746-841f-43ec-a46d-6d72432ebf57",
                                "sense_id": "8799497a-e859-35e4-a199-a535c8c8b08c",
                                "text": "\"Let's go get them heinies, Sergeant,\" I challenged, with forced good cheer."
                            },
                            {
                                "example_id": "3f85d4ea-2467-4a39-a467-0dce78255ded",
                                "sense_id": "8799497a-e859-35e4-a199-a535c8c8b08c",
                                "text": "The Heinies had run off. We were suspicious; the boys were a little nervous because in a hedgerow we didn't know where our friends and foes were. Suddenly Bud said, “Damn, there's a Heinie over there. There's his helmet!”"
                            },
                            {
                                "example_id": "4b2cd111-f7f3-4fd5-b6e2-0fa8744fecb2",
                                "sense_id": "8799497a-e859-35e4-a199-a535c8c8b08c",
                                "text": "At the outcry of “Heinies!\" Gaul jumped out of the window and bolted for the woods."
                            }
                        ]
                    }
                ],
