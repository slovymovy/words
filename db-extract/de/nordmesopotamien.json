                "senses": [
                    {
                        "sense_id": "9527dae4-ee86-32a8-8cc4-d92b2bdcd49d",
                        "entry_id": "c4e4a5e7-09fc-3113-9952-f699d92c5b17",
                        "glosses": [
                            "nördlicher Teil Mesopotamiens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dbd2dd-306e-41e7-81e7-ba436b0faf52",
                                "sense_id": "9527dae4-ee86-32a8-8cc4-d92b2bdcd49d",
                                "text": "„Das sogenannte Königreich von Obermesopotamien war ein vom Amurriter Samsi-Addu […] begründeter Territorialstaat, der große Teile Nordmesopotamiens, das Haburgebiet und den Mittleren Euphra einschließlich Mari umfaßte.“"
                            },
                            {
                                "example_id": "598097bb-22c5-48c9-93bc-47db380dd41d",
                                "sense_id": "9527dae4-ee86-32a8-8cc4-d92b2bdcd49d",
                                "text": "„Es ist schwerer, eine zusammenhängende Geschichte von Nordmesopotamien und Nordsyrien in dem halben Jahrtausend vom Aufstieg Akkades bis zum Beginn des 18. Jahrhunderts v.Chr. zu schreiben, als eine Geschichte Babyloniens während des gleichen Zeitraums; […].“"
                            }
                        ],
