                "senses": [
                    {
                        "sense_id": "c7f4e256-6bd0-3a7f-8fed-fb1b18ff99a4",
                        "entry_id": "ced867c9-1b9c-3af2-bf9d-fb6711cf6a4f",
                        "glosses": [
                            "Fromage produit à l'origine dans la région lilloise, puis ailleurs en France, à base de lait de vache, à pâte pressée non cuite, d'une masse moyenne de deux kilogrammes, à la croûte grisâtre et à la chair orangée."
                        ],
                        "tags": [
                            "Fromage"
                        ],
                        "examples": [
                            {
                                "example_id": "7a923e09-62bc-40cb-83f1-099ec66325e4",
                                "sense_id": "c7f4e256-6bd0-3a7f-8fed-fb1b18ff99a4",
                                "text": "La mimolette est fabriquée avec du lait de vache. Sa pâte est pressée non cuite. La mimolette peut être jeune (affinée 3 mois) avec une pâte souple et un goût fruité ou vieille (affinée 12 mois) avec une pâte dure, friable et un goût bien plus prononcé."
                            },
                            {
                                "example_id": "f411715f-9640-495f-815a-8ec62ed26a0b",
                                "sense_id": "c7f4e256-6bd0-3a7f-8fed-fb1b18ff99a4",
                                "text": "C’est drôle, leurs pattes ont la couleur de la mimolette, exactement."
                            },
                            {
                                "example_id": "ea551fdc-5075-440e-86d3-6adb3cac47cc",
                                "sense_id": "c7f4e256-6bd0-3a7f-8fed-fb1b18ff99a4",
                                "text": "Incorporer 1 cuil. à café de moutarde poivrée, puis la mimolette râpée, petit à petit, en laissant bien fondre le fromage entre chaque ajout."
                            }
                        ]
                    }
                ],
