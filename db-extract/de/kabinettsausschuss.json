                ],
                "senses": [
                    {
                        "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                        "entry_id": "ebbcb150-8af0-3bbc-bee0-14d2ea78bb3b",
                        "glosses": [
                            "Gruppe von Personen bestehend aus einem Teil der Mitglieder einer Regierung, die ein einzelnes Thema bearbeiten (beispielsweise dem Umweltschutz, Kampf gegen Rechtsextremismus, Brexit, der deutschen Einheit, Coronapandemie, den Rüstungsexporten, …)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17785038-6a6c-4651-9079-d8cbfd58f125",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Vergangene Woche hatte der Kabinettsausschuss der Bundesregierung einen Maßnahmenplan vorgelegt, mit dem Rechtsextremismus und Rassismus in Deutschland Einhalt geboten werden soll.“"
                            },
                            {
                                "example_id": "1eb4ed9c-b240-4792-adec-690da9b86676",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„In Berlin tagte der Kabinettsausschuss Rechtsextremismus - unter Leitung der Bundeskanzlerin.“"
                            },
                            {
                                "example_id": "65a2de1c-62a4-4eee-b30d-6b051f56d637",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Am 20. Mai, kurz vor dem ersten Jahrestag der Ermordung Walter Lübckes, tagte der neue Kabinettsausschuss zum ersten Mal.“"
                            },
                            {
                                "example_id": "cb3be185-3580-40b0-939a-4c5d0f0284e0",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„In Berlin tagte heute zum ersten Mal der Kabinettsausschuss, der sich mit dem Brexit beschäftigt.“"
                            },
                            {
                                "example_id": "f3f154b0-997c-41b2-8706-37d693b2a210",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Erstmals in der Geschichte der Bundesrepublik ist am Mittwoch ein Kabinettsausschuss zusammengekommen, der sich speziell mit Fragen der Digitalisierung befassen und dabei die Interessen der unterschiedlichen Ressorts besser vernetzen soll.“"
                            },
                            {
                                "example_id": "68896317-4f0f-413a-9a1e-2e97ab41e60b",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Dabei hatte der am 7. Februar 1990 eingerichtete Kabinettsausschuss Deutsche Einheit mit seinen für bestimmte Sachbereiche zuständigen Arbeitsgruppen eine die Gesamtabläufe koordinierende Funktion“ […]."
                            },
                            {
                                "example_id": "ea37c333-31c0-44de-873d-0d63df4ddef2",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Der Export der Fregatten und Luftabwehrsysteme aus den Rüstungsschmieden Thyssenkrupp Marine Systems und Diehl Defence wurde vom Bundessicherheitsrat genehmigt, einem Kabinettsausschuss, dem neben Merkel sieben Minister angehören.“"
                            },
                            {
                                "example_id": "f37cf39b-bc7f-4c42-a855-c5ca1f0cdccf",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Zwei Mal werde sich der zuständige Kabinettsausschuss in dieser Woche treffen, um über die große Zukunft nach dem Brexit zu diskutieren, bestätigt Innenministerin Amber Rudd.“"
                            },
                            {
                                "example_id": "148e86bf-36d7-4c9a-b4bf-efedf2215461",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„»Ich halte es auch für richtig, dass wir nun einen Kabinettsausschuss haben, der von der Kanzlerin geführt wird, mit den zuständigen Ressortministern.«“"
                            },
                            {
                                "example_id": "73991e66-388f-482e-8167-1255f79f89ad",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Bereits im Herbst 1970 wurde eine Verfassungsänderung eingeleitet, die dem Bund die Zuständigkeit für ein umfassendes Gesetzgebungsprogramm für alle wichtigen Umweltbereiche einräumen sollte. Eingerichtet wurde auch ein Kabinettsausschuss für Umweltfragen.“"
                            },
                            {
                                "example_id": "1ed82b36-936d-4a53-8835-b3d522012acd",
                                "sense_id": "d4550872-03e0-398a-9727-70b624a41b0e",
                                "text": "„Was war am 10. Apr. 1967? – Der Kabinettsausschuss für mittelfristige Finanzplanung tritt unter Vorsitz von Bundeskanzler Kurt Georg Kiesinger zu seiner konstituierenden Sitzung zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
