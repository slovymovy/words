                                "example_id": "84b846db-dcc5-4e3b-b9e9-9ee8aeea1fe0",
                                "sense_id": "e260fac6-1d70-3a80-b60e-37388af2573f",
                                "text": "На границе Аризоны и Юты недалеко друг от друга стоят два больших дорожных щита."
                            }
                        ]
