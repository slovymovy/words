                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaadwillend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek haar <w>boosaardig</w> aan nadat zij zijn geheim had verklapt.",
                            "target_lang_translations": {
                                "en": "He looked at her <w>maliciously</w> after she had revealed his secret.",
                                "fr": "Il l'a regardée <w>méchamment</w> après qu'elle eut révélé son secret."
                            }
                        },
                        {
                            "text": "De wereld leek die avond veel te groot en te <w>boosaardig</w> voor het kleine kind.",
                            "target_lang_translations": {
                                "en": "The world seemed much too big and <w>wicked</w> for the small child that evening.",
                                "fr": "Ce soir-là, le monde semblait bien trop grand et trop <w>hostile</w> pour le petit enfant."
                            }
                        }
