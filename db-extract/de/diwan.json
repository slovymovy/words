                        "form": "die Diwane"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4c9f87f-f16f-3a20-bd35-ace03304162f",
                        "entry_id": "aa879fe0-df37-3cff-ae5c-b8dd55823cdd",
                        "glosses": [
                            "Register von Schriftstücken staatlicher oder wirtschaftlicher Art in der islamischen Verwaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ca7f3f-bfbc-41c0-b1ee-c1327c25bde8",
                                "sense_id": "b4c9f87f-f16f-3a20-bd35-ace03304162f",
                                "text": "„Es war eine alte Ausgabe des Diwans von Abu Novás, die sie vor drei Jahren in Kairo gekauft hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c55b57cd-6213-3fff-beab-23e23ca10c80",
                        "entry_id": "aa879fe0-df37-3cff-ae5c-b8dd55823cdd",
                        "glosses": [
                            "kann für Ratsversammlung, Kanzlei, Gerichtshof, Empfangsraum des Herrschers stehen oder auch in der osmanischen Türkei den Staatsrat meinen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "48107b42-734f-3f7f-a234-3f3126f512d3",
                        "entry_id": "aa879fe0-df37-3cff-ae5c-b8dd55823cdd",
                        "glosses": [
                            "die zur Einrichtung der betreffenden Räume gehörenden niedrigen Polsterbänke an der Wand"
                        ],
                        "tags": [
                            "davon abgeleitet ist im europäischen Raum"
                        ],
                        "examples": [
                            {
                                "example_id": "6a70c63e-e370-41f1-afd6-20b300f92ee1",
                                "sense_id": "48107b42-734f-3f7f-a234-3f3126f512d3",
                                "text": "„Im abgedunkelten Bibliothekszimmer meines verstorbenen Vaters - in den Kriegsnächten - beschwor er sie in improvisierten Gespensternoveletten, während geisterhaft Rainer Maria Rilke ihm vom Diwan durch sein Lorgnon zusah.“"
                            },
                            {
                                "example_id": "89cda5ff-2729-4973-ae2b-6bdc3b086319",
                                "sense_id": "48107b42-734f-3f7f-a234-3f3126f512d3",
                                "text": "„Es gab einen riesigen Diwan, auf dem wir vier uns in einer gemeinsamen Umarmung zusammenkuschelten.“"
                            },
                            {
                                "example_id": "c40ec5a6-3a7f-4966-884e-72900efa66b2",
                                "sense_id": "48107b42-734f-3f7f-a234-3f3126f512d3",
                                "text": "„Ich falle auf einen Diwan nieder und schaue mir die Augen blind.“"
                            },
                            {
                                "example_id": "f2d6937d-76c1-4061-b935-adb7645ee815",
                                "sense_id": "48107b42-734f-3f7f-a234-3f3126f512d3",
                                "text": "„Sie lag auf dem Diwan, auf der Seite, und stützte den Kopf mit dem Ellbogen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06c3798f-0a4b-4d87-90cb-45f2bdf0a496",
                        "source_entry_id": "aa879fe0-df37-3cff-ae5c-b8dd55823cdd",
