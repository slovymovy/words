                                        "sense_id": "4856cc7c-2b71-362b-b13a-c41bd20492a6",
                                        "entry_id": "4151d4c8-c9f5-3a3d-8a97-9f06f0f96510",
                                        "glosses": [
                                            "Convention accompagnée d’actes publics qui lui donnent un caractère d’une importance primordiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af245741-b65e-46f2-a5fa-a865a4a87cd1",
                                                "sense_id": "4856cc7c-2b71-362b-b13a-c41bd20492a6",
                                                "text": "Aussitôt que les deux parties, […], auront établi les bases d’un accommodement, je désire, monsieur l’amiral, qu’elles puissent former ensemble des pactes, à titre de voisins et d’amis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287231d6-261d-367b-abd7-8d2fb61347ba",
                                        "entry_id": "4151d4c8-c9f5-3a3d-8a97-9f06f0f96510",
                                        "glosses": [
                                            "Alliance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d158ea69-d604-4bc4-96ee-fbfbd3601aa5",
                                                "sense_id": "287231d6-261d-367b-abd7-8d2fb61347ba",
                                                "text": "La constitution de 1793 fut le premier pacte social qui, depuis l'origine du monde, eût fait un dogme de la fraternité humaine."
                                            },
                                            {
                                                "example_id": "960ee06b-3c4c-4722-b48c-e572ba49546f",
                                                "sense_id": "287231d6-261d-367b-abd7-8d2fb61347ba",
                                                "text": "La France demande que soit soumise au Tribunal de La Haye la question de savoir si le pacte franco-soviétique est compatible avec Locarno."
                                            },
                                            {
                                                "example_id": "b7f3e51a-67e3-4a7f-9ab4-40bbfe26e1a4",
                                                "sense_id": "287231d6-261d-367b-abd7-8d2fb61347ba",
                                                "text": "Moscou offre en compensation une rectification frontalière en Carélie orientale et la conclusion d'un pacte d'assistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
