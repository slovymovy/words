                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fda5ecb-f92c-4b33-8037-3d5918b6fac8",
                                "sense_id": "d3f5ee3b-3e22-30c2-b551-236c26ea3357",
                                "text": "Mon ordinateur a un processeur de 3 gigahertz."
                            },
