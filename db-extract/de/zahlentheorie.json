                        "sense_id": "79e5310c-4df9-3d05-ad89-32e292e261f5",
                        "entry_id": "840fd4b1-7282-3733-bc78-7935a6ed7a19",
                        "glosses": [
                            "Teilgebiet der Mathematik, welches sich mit den Eigenschaften ganzer Zahlen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "163bff81-daa4-412e-bf25-bea9107326f0",
                                "sense_id": "79e5310c-4df9-3d05-ad89-32e292e261f5",
                                "text": "Anwendungen der Zahlentheorie finden sich in der Kryptographie, insbesondere bei der Frage nach der Sicherheit der Datenübertragung im Internet."
                            },
                            {
                                "example_id": "029cb863-dc6e-481c-81d8-5dad4faf473b",
                                "sense_id": "79e5310c-4df9-3d05-ad89-32e292e261f5",
                                "text": "„Der Satz des Pythagoras hat viele Anwendungen, insbesondere beim Berechnen von Längen, er hat aber auch bedeutende Impulse in die Zahlentheorie gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
