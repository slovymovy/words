                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ec825e3-d142-4b87-bc18-48e9316153e0",
                        "source_entry_id": "19246dda-48df-3bcd-9d74-ab9107583e7d",
                        "target_lang_word": "Transvaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transvaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc964e5f-07fb-35b0-abab-b95400c62caa",
                                        "entry_id": "d341ec63-0b35-3238-94b4-82762095b820",
                                        "glosses": [
                                            "zeitweise unabhängige Republik, Kolonie Großbritanniens, Provinz der Südafrikanischen Union, gelegen im Nordosten Südafrikas, inzwischen als Provinz aufgelöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9a43ea-f95b-4340-9934-83a2bf4572e0",
                                                "sense_id": "dc964e5f-07fb-35b0-abab-b95400c62caa",
                                                "text": "„Es gelang ihm, alle wichtigen Leute zu treffen, vom Vizepräsidenten der Burenrepublik Transvaal über den Sultan von Sansibar bis zum Khediven von Ägypten.“"
                                            },
                                            {
                                                "example_id": "062436ab-beb2-4d9a-9806-a089c922880b",
                                                "sense_id": "dc964e5f-07fb-35b0-abab-b95400c62caa",
                                                "text": "„Ab 1882 werden in Transvaal große Goldvorkommen entdeckt.“"
                                            },
                                            {
                                                "example_id": "a8a1490b-4ad8-4fc9-92fd-a6ebebf2aa20",
                                                "sense_id": "dc964e5f-07fb-35b0-abab-b95400c62caa",
                                                "text": "„Denn nun verschob sich das Machtgleichgewicht in der ganzen Region zugunsten des Transvaal, der bis dahin als wirtschaftlich unbedeutend gegolten hatte und von nur einigen tausend weißen Siedlern ursprünglich niederländischer Herkunft, den sogenannten Buren (Bauern), beherrscht wurde.“"
                                            },
                                            {
                                                "example_id": "de226a6b-14bb-47a5-8594-4ee44ad4c809",
                                                "sense_id": "dc964e5f-07fb-35b0-abab-b95400c62caa",
                                                "text": "„Nachdem zunächst aus Rhodesien und Transvaal Aufstände gemeldet wurden, hat der Aufruhr inzwischen auf Tanganjika, den Kongo und weitere, nach Norden bis zum Sudan hin reichende Gebiete übergegriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b730d4b6-9ca5-49af-8eff-ce77dad9f678",
                        "source_entry_id": "19246dda-48df-3bcd-9d74-ab9107583e7d",
