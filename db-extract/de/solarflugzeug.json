                        "examples": [
                            {
                                "example_id": "9ee52023-5483-4e9f-a82c-6b6affc76218",
                                "sense_id": "1ec7728e-b506-34f5-8607-bf66748f8a83",
                                "text": "Das Solarflugzeug \"Solar Impulse 2\" hat bei seinem Versuch einer Erdumrundung einen ersten Weltrekord aufgestellt.",
                                "translation": "Lors de sa tentative de tour du monde, l’avion solaire « Solar Impulse 2 » a établi un premier record mondial."
                            },
                            {
                                "example_id": "b4aa154b-a15f-41dd-aed0-9cd7781e233d",
                                "sense_id": "1ec7728e-b506-34f5-8607-bf66748f8a83",
                                "text": "Während der Überquerung der USA hatte die Maschine mit 1541 Kilometern einen neuen Streckenrekord für Solarflugzeuge aufgestellt.",
                                "translation": "Lors de son survol des États-Unis, l’engin avait établi le nouveau record mondial de distance parcourue par un avion solaire à 1 541 kilomètres."
                            }
                        ]
                    }
