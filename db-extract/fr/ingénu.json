                    {
                        "translation_id": "c838fdc0-afa9-4c8f-ae5f-e30436faf2c2",
                        "source_entry_id": "299b0930-a0ec-3f8e-b337-876a0afbc567",
                        "source_sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                        "target_lang_word": "onnozel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onnozel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a84116c9-5b02-354f-b054-48484e076737",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "onschadelijk (ook van zaken)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44a59e47-ffae-4bc0-831f-bc45f7c7607c",
                                                "sense_id": "a84116c9-5b02-354f-b054-48484e076737",
                                                "text": "Item die derde schouwe is des Woensdages na sinte Martijnsdach in den winter alle dyken in hair volle groot te wesen up 10 se., then ware offet den hiemraden onnosel dochte wesen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "onschuldig, schuldeloos (zonder seksuele ervaringen)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64371630-212c-4f46-b72b-cf8e71e0213c",
                                                "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                                "text": "Het feest van de Onnozele Kinderen wordt op 28 december gevierd."
                                            },
                                            {
                                                "example_id": "d590cffc-b933-47f8-acac-f195aa6fd7c7",
                                                "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                                "text": "di cuesch ende fijn ende onbeulect es, betekent mede daer ic noit met sunde en dede maer hebben gehouden van kinde alneen onosel van wiuen ende suuer ende reen"
                                            },
                                            {
                                                "example_id": "315e3038-b0ef-4561-9e24-75deff7b4e7d",
                                                "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                                "text": "Ende vp onse kinder na desen. Doe dede al dar pylatus. Gheselen den onnoselen ihesus. Want het was die romsce wet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83f3f90e-7ee4-3ab7-b6ce-cae93b99bd8d",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "dwaas, naïef"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a91f3dd-3361-4a20-b97e-339a388704c3",
                                                "sense_id": "83f3f90e-7ee4-3ab7-b6ce-cae93b99bd8d",
                                                "text": "De Heeren vragen hem, waar in hy een dief was; De Lant-heer antwoord: Om dat mijn buur-mans zeug, die hy zijn Boer betrouwt had, elf biggelen geworpen had, en zijn ezelin, die hem te bewaren gegeven was, maar een jong geworpen had. Door welke onnozele antwoord, de Heeren bestonden te lagchen, hem vragende, of hy dan ook een dief was, om dat zijn vrouw maar een kind gebaart had? Hy antwoorde, dat het den aart der vrouwen was, gemeenlijk maar een kint voort te brengen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a8dee02-67ac-327a-9902-e641e3b1b3a6",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "niet ernstig"
                                        ],
                                        "tags": [
                                            "van een ding, kwestie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a7b93d7-c602-34ce-ba55-d0c1ff5cf615",
