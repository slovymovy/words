{
    "word_family": [
        "precociousness",
        "precocity",
        "precociously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e3e2714-8be2-3185-bf82-6392d7055c1d",
                    "sense_definition": "Exhibiting advanced skills, intelligence, or aptitudes at an abnormally early age, especially in children.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "early-development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>precocious</w> child began reading the newspaper at age four.",
                            "target_lang_translations": {
                                "tr": "<w>Erken gelişmiş</w> çocuk dört yaşında gazete okumaya başladı."
                            }
                        },
                        {
                            "text": "Teachers quickly noticed the <w>precocious</w> student who was solving complex math problems far ahead of her peers.",
                            "target_lang_translations": {
                                "tr": "Öğretmenler, akranlarının çok ötesinde karmaşık matematik problemlerini çözen <w>üstün zekalı</w> öğrenciyi hemen fark etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "tranty",
                        "prodigious"
                    ],
                    "common_phrases": [
                        "precocious child",
                        "precocious talent"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle çocuklarda, olağanüstü erken yaşta gelişmiş beceriler, zeka veya yetenekler gösteren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "erken gelişmiş",
                                "target_lang_sense_clarification": "çocuklar veya zihinsel yetenekler için"
                            },
                            {
                                "target_lang_word": "bücür",
                                "target_lang_sense_clarification": "akıllı, büyümüş de küçülmüş çocuk"
                            },
                            {
                                "target_lang_word": "üstün zekalı",
                                "target_lang_sense_clarification": "yaşına göre çok yetenekli çocuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57cbe7f9-5bc6-3e73-9394-d5703be3e36a",
                    "sense_definition": "Characterized by exceptionally early biological development, flowering, or maturity in plants or animals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "early-development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>precocious</w> plant was already blooming flowers by day four of the experiment.",
                            "target_lang_translations": {
                                "tr": "<w>Erken olgunlaşan</w> bitki, deneyin dördüncü gününde zaten çiçek açıyordu."
                            }
                        },
                        {
                            "text": "Biologists studied the <w>precocious</w> development of the species in warmer climates.",
                            "target_lang_translations": {
                                "tr": "Biyologlar, türün daha sıcak iklimlerdeki <w>erken</w> gelişimini incelediler."
                            }
                        }
                    ],
                    "antonyms": [
                        "altricial",
                        "serotinous"
                    ],
                    "common_phrases": [
                        "precocious development",
                        "precocious flowering"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bitki veya hayvanlarda istisnai derecede erken biyolojik gelişme, çiçeklenme veya olgunlaşma ile karakterize edilen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "erken olgunlaşan",
                                "target_lang_sense_clarification": "canlılar ve biyolojik süreçler için"
                            },
                            {
                                "target_lang_word": "turfanda",
                                "target_lang_sense_clarification": "erken meyve veren bitkiler için"
                            },
                            {
                                "target_lang_word": "erken gelişen",
                                "target_lang_sense_clarification": "biyolojik gelişim için"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}