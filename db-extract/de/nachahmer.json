                    }
                ],
                "senses": [
                    {
                        "sense_id": "689f8f32-d595-3035-a409-1d95691b7a03",
                        "entry_id": "5160f87d-568a-3c45-be84-888235467d92",
                        "glosses": [
                            "Person, die jemand/etwas nachmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c9a4ca-ff54-43e6-bd01-5bc917859201",
                                "sense_id": "689f8f32-d595-3035-a409-1d95691b7a03",
                                "text": "„Ich versuche in diesem Buch ausnahmsweise, ab und zu Witze zu analysieren, um Nacherzählern und Nachahmern zu helfen, sozusagen Schwimmunterricht beim Lachen zu erzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a952088d-86b9-43a8-8186-351f2655d34d",
                        "source_entry_id": "5160f87d-568a-3c45-be84-888235467d92",
                        "source_sense_id": "689f8f32-d595-3035-a409-1d95691b7a03",
                        "source_sense_description": "Person, die jemand/etwas nachmacht",
                        "target_lang_word": "copycat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copycat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b0b2001-58a9-328d-9129-67b73e04020e",
                                        "entry_id": "c9d7293f-06a9-39c3-a258-1a8d4756aa25",
                                        "glosses": [
                                            "One who imitates or plagiarizes others' work."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b8fe9c2-1e51-4ec9-972b-d55566fa953d",
                                                "sense_id": "5b0b2001-58a9-328d-9129-67b73e04020e",
                                                "text": "And in it all they are merely copy-cats—servile followers of the aristocratic creed, but without the genuine prestige of the old-time nobilities."
                                            },
                                            {
                                                "example_id": "cd3f59d0-5c92-4d60-97b7-40cb7fbc2e11",
                                                "sense_id": "5b0b2001-58a9-328d-9129-67b73e04020e",
                                                "text": "I wanted to make them brilliant. I wanted to make them interesting. And of course I could not do it by myself. I am nothing but a copycat. I just quoted a lot of things I had heard you say; and I did worse than that, Peter."
                                            },
                                            {
                                                "example_id": "3df03102-72b6-4514-9c6e-398ac2b722ce",
                                                "sense_id": "5b0b2001-58a9-328d-9129-67b73e04020e",
                                                "text": "Early offerings--many of them packaged in sultry covers featuring buxom women in silk pajamas--were huge sellers. But when copycats and counterfeiters drove down margins, Chan switched to real estate, snapping up 200 acres of land in the city of Guigang and erecting dozens of office towers and residential developments. Among his most ambitious recent projects: a luxury Guigang housing complex dubbed \"Wealthy Persons' New Town.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c35e2ec-4d88-35df-b68b-5292474b0ae2",
                                        "entry_id": "c9d7293f-06a9-39c3-a258-1a8d4756aa25",
                                        "glosses": [
                                            "A criminal who imitates the crimes of another; specifically, a criminal who commits the same crime, especially a highly-publicized one, that has just or recently been committed by someone else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29badfb6-8ec1-45a8-9f38-8c03a764fc4a",
                                                "sense_id": "3c35e2ec-4d88-35df-b68b-5292474b0ae2",
                                                "text": "a copycat strangler"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "copycat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d75459d-e1ed-3190-9b77-4b6d2a0ec474",
                                        "entry_id": "5499ae21-55a5-312e-a137-221a0117d1f5",
                                        "glosses": [
                                            "Imitative; unoriginal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d705642-3147-4307-93cb-483e465b056d",
                                                "sense_id": "4d75459d-e1ed-3190-9b77-4b6d2a0ec474",
                                                "text": "copycat crime"
                                            },
                                            {
                                                "example_id": "6fe4807b-c0cb-4b2c-964f-9d37ee6152d2",
                                                "sense_id": "4d75459d-e1ed-3190-9b77-4b6d2a0ec474",
                                                "text": "“Because of my size, I was a natural leader in junior high school. Gangs are the most copycat of subcultures. It used to be zoot suits; now it's tattoos. When I was thirteen, I got a tattoo.”"
                                            },
                                            {
                                                "example_id": "7edb07ce-4cc8-461a-b231-0cdaf155de1f",
                                                "sense_id": "4d75459d-e1ed-3190-9b77-4b6d2a0ec474",
                                                "text": "As one executive put it: Now in the beverage market we are to a great extent very copycat."
                                            },
                                            {
                                                "example_id": "55d55681-f6cd-4d9e-b6db-95f092a26195",
                                                "sense_id": "4d75459d-e1ed-3190-9b77-4b6d2a0ec474",
                                                "text": "It was that very copycat kind of \"grandfather stealing\" that makes Jinjue's text look like the son of Du Fei's Record, even as it works to push Du Fei's \"father-text\" out of the way."
                                            },
                                            {
                                                "example_id": "929f1809-8dfb-40cf-89c5-834aa75edacb",
                                                "sense_id": "4d75459d-e1ed-3190-9b77-4b6d2a0ec474",
                                                "text": "We need to figure out how to balance the public interest in learning about a mass shooting with the public interest in reducing copycat crime."
                                            },
                                            {
                                                "example_id": "12c26538-6b00-4624-a1c8-ad03f367ae1d",
                                                "sense_id": "4d75459d-e1ed-3190-9b77-4b6d2a0ec474",
                                                "text": "The chief executive and founder of Meta used his new Threads account to say Twitter had not “nailed” its opportunity to become a mega app and that his copycat version would be “focusing on kindness”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "copycat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10d70d97-d0e1-3dc1-8ed5-be8a63edacf0",
                                        "entry_id": "625d434d-5a15-3ba1-80cc-4c39c44de5dd",
                                        "glosses": [
                                            "To act as a copycat; to copy in a shameless or derivative way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3863af76-ad47-4f73-a231-e7ce0eb0fae9",
                                                "sense_id": "10d70d97-d0e1-3dc1-8ed5-be8a63edacf0",
                                                "text": "Because beasts don't talk with words, they talk with sounds, and I copycatted my language from beasts and birds[…]"
                                            },
                                            {
                                                "example_id": "61eb06ff-8825-4353-ad7f-45a4de465840",
                                                "sense_id": "10d70d97-d0e1-3dc1-8ed5-be8a63edacf0",
                                                "text": "In a genre that is rife with copycatting, Ms. Cain deserves some credit for having gotten a potentially interesting new series off the ground."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "726e6f5e-7a69-4d83-811d-9ca4127618fb",
                        "source_entry_id": "5160f87d-568a-3c45-be84-888235467d92",
                        "source_sense_id": "689f8f32-d595-3035-a409-1d95691b7a03",
                        "source_sense_description": "Person, die jemand/etwas nachmacht",
                        "target_lang_word": "imitator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imitator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9813002d-587e-38bc-b135-6dd45e40c87b",
                                        "entry_id": "36bce7f4-91e3-3e2a-a9ac-a78da43aeb5d",
                                        "glosses": [
                                            "A person who imitates or apes another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621ae26d-4a79-499d-b81f-44c05387bef9",
                                                "sense_id": "9813002d-587e-38bc-b135-6dd45e40c87b",
                                                "text": "Chalk it up to the government’s revelations in recent years about UFOs, or maybe just the pendulum swinging back, again, after “The X-Files” inspired a host of imitators in the 1990s."
                                            },
                                            {
                                                "example_id": "87bbe984-6007-45f7-9896-40c7f48b1f4a",
                                                "sense_id": "9813002d-587e-38bc-b135-6dd45e40c87b",
                                                "text": "Other far-right sites would gravitate to Epik. Among the first to announce its migration in early 2019 was BitChute, a YouTube imitator that had been blocked by PayPal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26d149bb-c454-45d5-a96c-beab4aa872f9",
                        "source_entry_id": "5160f87d-568a-3c45-be84-888235467d92",
                        "source_sense_id": "689f8f32-d595-3035-a409-1d95691b7a03",
                        "source_sense_description": "Person, die jemand/etwas nachmacht",
                        "target_lang_word": "imitateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imitateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                        "entry_id": "aefd927c-01b7-3973-86c7-a659de50170c",
                                        "glosses": [
                                            "Celui qui imite, en parlant principalement d’une personne qui règle sa conduite, ses actions sur celles d’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b0d1b5-fe84-4857-90f7-9776291bd07d",
                                                "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                                "text": "Je forme une entreprise qui n’eut jamais d’exemple, et dont l’exécution n’aura point d’imitateur. Je veux montrer à mes semblables un homme dans toute la vérité de la nature, et cet homme, ce sera moi."
                                            },
                                            {
                                                "example_id": "207ae223-187a-4cac-9cf4-e1e2b22aaff8",
                                                "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                                "text": "Ridicules imitateurs des manies anglaises, en faisant des courses, nous avons aussi introduit chez nous l’usage des paris et nous en avons fait une véritable science de combinaison."
                                            },
                                            {
                                                "example_id": "4a951082-f56e-43a8-b624-b79812075888",
                                                "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                                "text": "C’est un jeu d’enfant, en cours de route, de se substituer aux substituteurs, d’imiter les imitateurs, de plagier les plagieurs, de renévroser les névroses, de psychotiser les psychoses, et surtout, surtout, de déféticher les féticheurs, de réensorceler les sorcières et les envoûteurs inconscients, bien sûr, peu importe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083c4762-ddbd-37d3-b65c-500b44e9c8c4",
                                        "entry_id": "aefd927c-01b7-3973-86c7-a659de50170c",
                                        "glosses": [
                                            "Artiste qui donne en spectacle, en les forçant, une imitation de la voix et des manières d'un personnage public."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "946dcf5a-4c19-4ac5-bcff-54c182706563",
                                                "sense_id": "083c4762-ddbd-37d3-b65c-500b44e9c8c4",
                                                "text": "Vince Taylor passa en vedette à l’Olympia, avec, en vedette américaine, Henri Tisot, l’imitateur du général De Gaulle et en vedette anglaise, à l’antépénultième place, Rosalie Dubois une ancienne poissonnière […]."
                                            },
                                            {
                                                "example_id": "a4b6b506-5bb5-48bf-bb5e-c1ddb8573699",
                                                "sense_id": "083c4762-ddbd-37d3-b65c-500b44e9c8c4",
                                                "text": "Le professeur Léon Schwartzenberg vient d’annoncer que le célèbre imitateur souffre d’un cancer des voies respiratoires et que le traitement chimiothérapique l’oblige à annuler son spectacle au palais des Congrès, qui devait débuter la semaine prochaine à guichets fermés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cffc3a8f-3ce6-32cf-b732-05dc91919f62",
                                        "entry_id": "aefd927c-01b7-3973-86c7-a659de50170c",
                                        "glosses": [
                                            "Écrivain ou artiste qui imite le style, la manière, le genre d’un autre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd2b647-97e9-4842-b433-aaad0ef96508",
                                                "sense_id": "cffc3a8f-3ce6-32cf-b732-05dc91919f62",
                                                "text": "Cet écrivain, cet artiste a eu beaucoup d’imitateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imitateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a5e0505-13bb-3020-8e27-66e2b7bb870f",
                                        "entry_id": "fc0fb3c8-ce9c-38f4-8d8e-0cfdee2640aa",
                                        "glosses": [
                                            "Qui imite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf15127-2211-4512-955a-cbf7cc45c028",
                                                "sense_id": "3a5e0505-13bb-3020-8e27-66e2b7bb870f",
                                                "text": "Les Russes sont tellement imitateurs, que toutes les maladies de la civilisation se répercutent chez eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5a79382-63ed-4bd4-97a9-90cf3c9eed38",
                        "source_entry_id": "5160f87d-568a-3c45-be84-888235467d92",
                        "source_sense_id": "689f8f32-d595-3035-a409-1d95691b7a03",
                        "source_sense_description": "Person, die jemand/etwas nachmacht",
                        "target_lang_word": "pasticheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasticheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "114ce678-68d8-3b1c-bb33-208082d4f4aa",
                                        "entry_id": "2b78e781-4ba5-3b7c-9d31-5ebb557d18c0",
                                        "glosses": [
                                            "Auteur d’un pastiche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c85ff442-48d3-4f28-8e31-c596c0394df4",
                                                "sense_id": "114ce678-68d8-3b1c-bb33-208082d4f4aa",
                                                "text": "Avec l’aide de ses enfants, de son neveu qui révéla à cette occasion ses prodigieux talents de pasticheur, et de quelques comparses et complices, dont Lester Nowak et Frantz Ingehalt, il avait mis sur pied l’opération qui devait lui permettre, des années plus tard et même après sa mort, de mystifier à son tour les collectionneurs, les experts et les marchands de tableaux."
                                            },
                                            {
                                                "example_id": "aa2532f3-f862-44db-8dcf-824a3b521dbb",
                                                "sense_id": "114ce678-68d8-3b1c-bb33-208082d4f4aa",
                                                "text": "Le pasticheur commence donc par être analyste, entrant dans les profondeurs d’une œuvre pour en saisir ses caractéristiques spécifiques. Il la modélise et se l’approprie avant de pouvoir en reformuler l’essence dans une œuvre nouvelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "827aeb02-e9a8-352b-906b-68bd703496bf",
                                        "entry_id": "2b78e781-4ba5-3b7c-9d31-5ebb557d18c0",
                                        "glosses": [
                                            "Personne (artiste ou écrivain) qui imite ou copie sans originalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112bebd2-29af-40a0-96a9-d42c90eef803",
                                                "sense_id": "827aeb02-e9a8-352b-906b-68bd703496bf",
                                                "text": "Alors, l’artiste qui ne porte pas le germe de l’image qui sera la sienne, ne peut que rester tributaire de l’image d’autrui (ce qu’il ne peut rendre qu’incomplètement), donc rester un peintre mitigé, pasticheur, imitateur, ou alors il se repose sur la technique ou l’exécution, souvent illisibles de préciosité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
