                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résultante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24c21966-e045-32b6-9844-7fce04772669",
                                        "entry_id": "4fda03c9-3fd0-3e34-950a-151908e24437",
                                        "glosses": [
                                            "Force qui résulte de la composition de plusieurs forces appliquées à un point donné."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a89f24-9989-417a-a388-bb2cb8eea3d7",
                                                "sense_id": "24c21966-e045-32b6-9844-7fce04772669",
                                                "text": "On peut à deux forces substituer leur résultante lorsque ces forces s’appliquent à un solide."
                                            },
                                            {
                                                "example_id": "91c24fa9-7381-4f79-90a0-696e5bc1fd47",
                                                "sense_id": "24c21966-e045-32b6-9844-7fce04772669",
                                                "text": "Plus généralement, à tout système d’efforts, on associe une résultante ⃑R et un moment ⃑M₀de ces efforts par rapport à un point O."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c444e9-52f3-3db3-a319-324e663f5fd9",
                                        "entry_id": "4fda03c9-3fd0-3e34-950a-151908e24437",
                                        "glosses": [
                                            "Produit, résultat, conséquence."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "572ade5e-ab56-4c13-ac52-deb5b249e7ff",
                                                "sense_id": "76c444e9-52f3-3db3-a319-324e663f5fd9",
                                                "text": "Mais comme au fond la religion est en grande partie, sinon en totalité, une résultante de la forme économique, les deux causes, en réalité, n’en font qu’une."
                                            },
                                            {
                                                "example_id": "d6998929-5b67-4cbd-bb27-23f360b23bcb",
                                                "sense_id": "76c444e9-52f3-3db3-a319-324e663f5fd9",
                                                "text": "Elle passa en courant devant la mère Pampine posée sur son paillasson comme une résultante de mal de mer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "résultante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94fa3d50-b5e4-356b-b382-1cc8d2aa7891",
                                        "entry_id": "ab4879d9-e167-3f26-bb04-3fe31e3ee239",
                                        "glosses": [
                                            "Féminin singulier de résultant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c577135f-d743-4124-84ab-52fcd35a62ed",
                                                "sense_id": "94fa3d50-b5e4-356b-b382-1cc8d2aa7891",
                                                "text": "L’action anticoagulante résultante de l’injection de la poudre totale doit donc être regardée ici comme la somme algébrique d’actions coagulantes et anticoagulantes multiples."
                                            }
                                        ]
                                    }
                                ]
