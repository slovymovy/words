                    },
                    {
                        "translation_id": "cde418c9-6e72-47c6-b260-5167da04f8b5",
                        "source_entry_id": "2112ef90-db38-316d-8a6a-5b7262c0f9b1",
                        "source_sense_id": "f10c9659-46d2-375c-8c6d-e686cf6656fd",
                        "target_lang_word": "médaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d84e278e-9926-3492-96af-4183b7f1f0d9",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce de monnaie antique, ainsi désignée par les collectionneurs à partir de la Renaissance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e30e7aff-d346-4dce-88b0-2adb0038e083",
                                                "sense_id": "d84e278e-9926-3492-96af-4183b7f1f0d9",
                                                "text": "Médaille antique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dd31dd8-7158-35f1-ad98-6240c69f0e90",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce de métal frappée ou fondue en l’honneur d’une personne illustre, ou pour conserver le souvenir d’une action mémorable, d’un événement, d’une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5574afd9-dafe-4a31-bc2c-b74bd322f452",
                                                "sense_id": "0dd31dd8-7158-35f1-ad98-6240c69f0e90",
                                                "text": "Ton frère est mort écrasé, mais on lui a apporté la médaille sur son lit de mort. Si des fois tu causes avec des collègues, même avec des chefs, tu peux dire comme ça : « Mon frère a reçu la médaille. » Ça montre, tu comprends, ça montre. »"
                                            },
                                            {
                                                "example_id": "8a341d5a-2758-4936-bfb2-4c72362d82eb",
                                                "sense_id": "0dd31dd8-7158-35f1-ad98-6240c69f0e90",
                                                "text": "Fils sentit sa bouche se dessécher alors qu'il regardait Valerian mâcher un morceau de jambon, son profil de médaille satisfait, appréciant même le goût qui lui remplissait la bouche bien qu'il ait pu renvoyer d'un simple mouvement de doigts des gens dont le sucre et le cacao lui avaient permis de vieillir dans un confort de roi ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af79d8f9-241f-3189-ab57-5470ab6f4d04",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce d’or, d’argent, ou de cuivre, généralement bénite, qui représente un sujet de dévotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3a692e-b95f-4b1a-8193-7550695a5a51",
                                                "sense_id": "af79d8f9-241f-3189-ab57-5470ab6f4d04",
                                                "text": "Il a plusieurs médailles suspendues à son chapelet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d83e8a0-0faf-36a4-b137-29ee657ec961",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce d’or, d’argent, ou de cuivre qu’on décerne aux sportifs ayant gagné des compétitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7f6473-6d99-496d-b01d-e2b38c90b00f",
                                                "sense_id": "2d83e8a0-0faf-36a4-b137-29ee657ec961",
                                                "text": "Il a eu la médaille d’or de curling aux jeux olympiques"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5116bc94-c0ab-3963-9490-d42c221a499c",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Prix qu’on décerne aux poètes, aux orateurs, aux artistes, aux industriels qui ont obtenu les premiers rangs dans les concours ouverts par les académies ou par le gouvernement, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "625bbddf-962b-3436-91d7-4ac2f3c5ff53",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Décoration qu’on décerne aux militaires ou aux civils pour hauts faits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3ea941-ebbe-4c5d-8753-2edf5c91f133",
                                                "sense_id": "625bbddf-962b-3436-91d7-4ac2f3c5ff53",
                                                "text": "On le sait, les médailles sont faites pour décorer les guerres terminées ou à venir : le tee-shirt en sueur est pour celle qu’on mène sous les bombardements immédiats ou contre un maigre salaire."
                                            },
                                            {
                                                "example_id": "3b15bc6e-f410-48d9-8c33-f276a7b0e561",
                                                "sense_id": "625bbddf-962b-3436-91d7-4ac2f3c5ff53",
                                                "text": "La médaille militaire. instituée en 1852 en faveur des sous-officiers et soldats les plus méritants et qu’on donne également aux généraux en récompense de services éclatants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869dfd0b-ec20-30e7-af46-944f4050ee38",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Plaque de métal numérotée que portent les commissionnaires, les porteurs des gares de chemins de fer, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "858d1979-bd7f-3da8-a684-e32636faba80",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Pièce de métal attribuée aux membres de certaines corporations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f14ac16-c9e5-4b3b-a721-924f5b0633f9",
                                                "sense_id": "858d1979-bd7f-3da8-a684-e32636faba80",
                                                "text": "Médaille de député."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a6c8f3-1cb3-3783-9568-aafe57c98a24",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Défaut dans une vitre, c'est une tache blanchâtre et opaque."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bca6f99-43df-4a28-88ca-227f32ad715d",
                                                "sense_id": "21a6c8f3-1cb3-3783-9568-aafe57c98a24",
                                                "text": "Le verre soit ordinaire, dit d'Alsace, soit en verre blanc, sera toujours d'une épaisseur égale, d'une teinte pure, non rayé, sans gauche, piqûre, bouillon, médaille ou autres défauts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4401e6e5-9926-3aa9-85c9-f46ded5ccd50",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Récompense."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cebd8d3-9df8-49b9-b702-ad484016c60f",
                                                "sense_id": "4401e6e5-9926-3aa9-85c9-f46ded5ccd50",
                                                "text": "— Merde alors ! Un mec qui a trafiqué avec les Fritz pendant toute l’occupation, et tu trouves qu’il n’a rien fait ? Il a frayé avec la Milice. Balancé du fric à toutes les organisations plus ou moins nazies de Vichy, et tu voudrais qu’on lui file une médaille !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986aa5d0-5f8d-3cbb-add3-07e79985fd4b",
                                        "entry_id": "502a580f-1c44-34d3-ba6a-218399c92c27",
                                        "glosses": [
                                            "Synonyme de perche-soleil commune (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
