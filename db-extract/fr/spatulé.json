                "senses": [
                    {
                        "sense_id": "e50fd270-4ff9-3ae7-97f0-eefe982b77fb",
                        "entry_id": "9ab01895-f344-3174-a833-344ca1521ec9",
                        "glosses": [
                            "Se dit d’une partie qui est rétrécie à la base, large et arrondie au sommet, et qui fait penser à une spatule."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "99dc0022-0794-434c-bff3-1fc642c43b02",
                                "sense_id": "e50fd270-4ff9-3ae7-97f0-eefe982b77fb",
                                "text": "Le pouce se raidit, affreusement long, spatulé, et s’appliqua étroitement contre l’index. Ainsi la main prit soudain une expression simiesque et crapuleuse."
                            },
                            {
                                "example_id": "55491945-8128-4f94-a6e1-4ed66d53b4d8",
                                "sense_id": "e50fd270-4ff9-3ae7-97f0-eefe982b77fb",
                                "text": "Cambronne Mâcheclair entre-frotta d’aise ses orteils spatulés : beau temps pour s’en aller pêcher le dormeur à la Prise d’Eau !"
                            },
                            {
                                "example_id": "50a2528e-7cd0-4428-bebb-f3b5deb32708",
                                "sense_id": "e50fd270-4ff9-3ae7-97f0-eefe982b77fb",
                                "text": "Ou alors les mains de Bud : ses fabuleux doigts spatulés qui semblent caresser les touches plus qu’elles ne les frappent, avec le gras du doigt, sans le moindre signe d’effort ou d’usure."
                            }
                        ]
                    },
                    {
                        "sense_id": "e44495d7-b1e5-322b-a016-0f746d7e86a0",
                        "entry_id": "9ab01895-f344-3174-a833-344ca1521ec9",
                        "glosses": [
                            "Se dit de pétales dont la partie proximale (l'onglet et la lame) est enroulée dans le sens longitudinal parfois jusqu'à former un tube, et dont la partie distale (le limbe) est plate et forme une sorte de spatule."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5ae28f67-a7d0-4521-9215-5c6c2ac08c58",
                                "sense_id": "e44495d7-b1e5-322b-a016-0f746d7e86a0",
                                "text": "Les pétales présentent dans leur forme plus de variété que les folioles du calice. Is sont, dans leurs conditions normales :\n […] Spatulés dans le Cleome pentaphylla, le Diciamnus albus."
                            }
                        ]
                    }
