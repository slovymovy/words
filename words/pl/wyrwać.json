{
    "word_family": [
        "wyrywać",
        "wyrwanie",
        "wyrwany"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "760cb3a1-b860-3b1f-9599-001f6dd524fc",
                    "sense_definition": "wyciągnąć coś z jakiegoś miejsca przy użyciu siły",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "usuwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dentysta musiał <w>wyrwać</w> zepsuty ząb.",
                            "target_lang_translations": {
                                "ru": "Стоматологу пришлось <w>вырвать</w> больной зуб."
                            }
                        },
                        {
                            "text": "Chłopiec <w>wyrwał</w> chwast z ogrodu.",
                            "target_lang_translations": {
                                "ru": "Мальчик <w>вырвал</w> сорняк из сада."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyszarpać"
                    ],
                    "common_phrases": [
                        "wyrwać ząb",
                        "wyrwać chwast"
                    ],
                    "target_lang_definitions": {
                        "ru": "вытащить или извлечь что-либо из какого-либо места с применением силы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырвать",
                                "target_lang_sense_clarification": "извлечь с силой (например, зуб или сорняк)"
                            },
                            {
                                "target_lang_word": "выдернуть",
                                "target_lang_sense_clarification": "резко потянув, извлечь из чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93f247ce-6ab4-3b77-b42f-31c1e751c61a",
                    "sense_definition": "odebrać komuś coś gwałtownie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "usuwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej <w>wyrwał</w> kobiecie torebkę z ręki.",
                            "target_lang_translations": {
                                "ru": "Вор <w>вырвал</w> у женщины сумочку из рук."
                            }
                        },
                        {
                            "text": "Dziecko <w>wyrwało</w> zabawkę koledze.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>вырвал</w> игрушку у товарища."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyszarpać"
                    ],
                    "common_phrases": [
                        "wyrwać torebkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "силой отобрать у кого-либо что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырвать",
                                "target_lang_sense_clarification": "силой отнять предмет из рук"
                            },
                            {
                                "target_lang_word": "выхватить",
                                "target_lang_sense_clarification": "быстро и неожиданно забрать что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79cd4fba-d501-3772-a1aa-9b4c609799d3",
                    "sense_definition": "uwolnić się z trudnej sytuacji lub miejsca",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ucieczka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Więźniowi udało się <w>wyrwać</w> z niewoli.",
                            "target_lang_translations": {
                                "ru": "Заключенному удалось <w>вырваться</w> из плена."
                            }
                        },
                        {
                            "text": "Muszę <w>wyrwać</w> się z pracy wcześniej.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>вырваться</w> с работы пораньше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wyrwać się z domu",
                        "wyrwać się z pracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "освободиться из трудной ситуации или места"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырваться",
                                "target_lang_sense_clarification": "освободиться из плена или стесненных обстоятельств"
                            },
                            {
                                "target_lang_word": "выбраться",
                                "target_lang_sense_clarification": "с трудом покинуть какое-то место"
                            }
                        ]
                    },
                    "synonyms": [
                        "wydostać się",
                        "uwolnić się"
                    ]
                },
                {
