                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cake",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64414c1d-39bd-3014-8295-96606b97bc17",
                                        "entry_id": "917d6d31-e2b5-3b35-80aa-ffc363e38942",
                                        "glosses": [
                                            "Gâteau en forme de parallélépipède rectangle, aux raisins secs et aux fruits confits."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8a3ba41-5704-49e6-9f6d-5133f2b55d5e",
                                                "sense_id": "64414c1d-39bd-3014-8295-96606b97bc17",
                                                "text": "Déposer la torsade dans un moule à cake beurré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "289d2d89-5636-356f-b0f9-2191ba4da9c8",
                                        "entry_id": "917d6d31-e2b5-3b35-80aa-ffc363e38942",
                                        "glosses": [
                                            "Gâteau salé ayant cette même forme, et pouvant contenir des morceaux de viande, d’olives, etc."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04349ab6-a365-4b9e-be35-3d3bc244a796",
                                                "sense_id": "289d2d89-5636-356f-b0f9-2191ba4da9c8",
                                                "text": "On trouvait aussi chez elles des mangues vertes, […]. Cela et d’autres choses encore : des cakes à la coco ; des bonbons piments, purée de haricots blancs agrémentée de safran et de piments verts; du pain tartiné d’achards, légumes mijotés dans une sauce au safran, aux oignons et aux piments verts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6625e82-8ceb-3e9a-8b97-4a384d0b8549",
                                        "entry_id": "917d6d31-e2b5-3b35-80aa-ffc363e38942",
                                        "glosses": [
                                            "Boue durcie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b9ecd64-803f-4317-80f8-a2ffc9e53f76",
                                                "sense_id": "a6625e82-8ceb-3e9a-8b97-4a384d0b8549",
                                                "text": "L’écoulement turbulent déplacera non seulement presque toute la boue circulable, mais détruira aussi les couches tendres de cake par une action décapante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2451f8cb-104e-385f-81d9-c385082f8c3b",
                                        "entry_id": "917d6d31-e2b5-3b35-80aa-ffc363e38942",
                                        "glosses": [
                                            "Matière fécale."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54e52fa5-dd02-4d49-8583-5126b897d6ef",
                                                "sense_id": "2451f8cb-104e-385f-81d9-c385082f8c3b",
                                                "text": "\"Couler un bronze\", \"démouler un cake\"... Il existe de nombreuses façons pour décrire le fait d'\"aller à la selle\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cake",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce0c488f-3089-381d-b789-507b1b6a380b",
                                        "entry_id": "34cb324b-a674-3902-95fb-99a7fd5b3b1f",
                                        "glosses": [
                                            "ou Mec, kéké, cacou."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a700e1ec-4975-4d31-b298-a356348244c9",
                                                "sense_id": "ce0c488f-3089-381d-b789-507b1b6a380b",
                                                "text": "Il faut vraiment être cake pour croire à un pareil tissu d’inepties."
                                            },
                                            {
                                                "example_id": "3af8542c-7088-459b-8ca9-13c77d6d32ba",
                                                "sense_id": "ce0c488f-3089-381d-b789-507b1b6a380b",
                                                "text": "Abramovitch multiplie les gros coups. Mais voilà, flamber comme un cake, ça coûte cher."
                                            },
                                            {
                                                "example_id": "f859f9b2-394b-49fd-9a0c-c645776b149d",
                                                "sense_id": "ce0c488f-3089-381d-b789-507b1b6a380b",
                                                "text": "Une tronche de cake."
                                            }
                                        ]
                                    }
                                ]
                            },
