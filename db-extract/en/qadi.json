                    },
                    {
                        "translation_id": "70ebf7b1-5b02-4383-9515-2b6fd6ed36e9",
                        "source_entry_id": "1fa87a1f-ded9-328e-9fa0-268688e83377",
                        "source_sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                        "source_sense_description": "judge in Islam",
                        "target_lang_word": "cadi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                        "entry_id": "eab450f9-baa4-3242-b063-55faedbd6a3d",
                                        "glosses": [
                                            "Juge musulman qui remplit à la fois les fonctions civiles et religieuses."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b30a19-eaed-4f14-b47c-af8c3eb9b810",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Nazira minauda gentiment avant de répondre aux deux témoins par un oui sacramentel ; …. Sa réponse fut portée au cadi."
                                            },
                                            {
                                                "example_id": "50ec2eab-7cd0-4735-a1e7-919a5d1c2dba",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Au point de vue juridique, les juifs relevaient de leurs rabbins et de la loi mosaïque dans les question de statut personnel ; pour le reste ils étaient justiciables, comme les musulmans, des caïds et des cadis."
                                            },
                                            {
                                                "example_id": "a4666e91-a664-427e-8e83-6e4b2aede541",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Non plus dans l’immensité du monde somptueux, pas même sur le chemin qui va de Velji Lug à Nezuke, mais sur ce pauvre petit bout de route qui sépare la mechtchéma, où le cadi la mariera au fils de Mustaj bey, de l’extrémité du pont, là où la pente abrupte et pierreuse mène à l’étroit chemin de Nezuke sur lequel, cela, elle en est sûre, elle ne posera jamais le pied."
                                            },
                                            {
                                                "example_id": "e418518f-d809-416f-ae10-f60c13313671",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Un cadi est un lettré versé dans le droit musulman, qui fait office de juge traditionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a0285a-f5ff-3bf9-bae9-a3844f71d4f2",
                                        "entry_id": "eab450f9-baa4-3242-b063-55faedbd6a3d",
                                        "glosses": [
                                            "Juge."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b51efc-b7af-41bc-8bb9-f0a9a5ef7f2b",
                                                "sense_id": "b2a0285a-f5ff-3bf9-bae9-a3844f71d4f2",
                                                "text": "Popinot était au milieu de la civilisation parisienne un très-habile cadi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ff5fb8b-b59a-4e52-b8a1-873afb19ff15",
                        "source_entry_id": "1fa87a1f-ded9-328e-9fa0-268688e83377",
                        "source_sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                        "source_sense_description": "judge in Islam",
                        "target_lang_word": "Kadi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kadi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01e5a368-2252-305c-ab95-1855c76bc0e5",
                                        "entry_id": "b3db9e1e-a326-366d-b968-1c20af572d4b",
                                        "glosses": [
                                            "Bezeichnung für einen Richter in einigen arabischen Staaten"
                                        ],
                                        "tags": [
                                            "spezieller"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ad7d52-c519-48f5-b56e-aa88fc033428",
                                                "sense_id": "01e5a368-2252-305c-ab95-1855c76bc0e5",
                                                "text": "„Ibn Beschir war Kadi in der Stadt. Er ließ sich den Fall vortragen und fand ihn bedenklich; […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19f9052c-57e2-3c66-8413-8768793340e8",
                                        "entry_id": "b3db9e1e-a326-366d-b968-1c20af572d4b",
                                        "glosses": [
                                            "allgemein, Person oder Einrichtung, welche für die Rechtssprechung zuständig ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0d29b47-aa5d-4a94-bb11-71d1a90dbaf7",
                                                "sense_id": "19f9052c-57e2-3c66-8413-8768793340e8",
                                                "text": "„In Deutschland zerren Unternehmen ihre gescheiterten Manager selten vor den Kadi.“"
                                            },
                                            {
                                                "example_id": "381c38b1-2db3-47b5-a972-47c1761903e9",
                                                "sense_id": "19f9052c-57e2-3c66-8413-8768793340e8",
                                                "text": "„Er hat seine halbkriminellen und kriminellen Praktiken, ohne jeden Respekt vor Tabus und oft haarscharf am Kadi vorbei, nie aufgegeben; hat dabei andere jedoch oft ins Messer laufen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
