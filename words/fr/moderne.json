    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8c515df-8497-33b7-a30c-abb22ba35b04",
                    "sense_definition": "Qui appartient à notre temps ou à une époque récente, par opposition à ce qui est ancien ou traditionnel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ville possède à la fois des monuments historiques et un quartier très <w>moderne</w>."
                        },
                        {
                            "text": "Le musée consacre une exposition temporaire aux chefs-d'œuvre de l'art <w>moderne</w>."
                        }
                    ],
                    "synonyms": [
                        "actuel"
                    ],
                    "antonyms": [
                        "ancien",
                        "antique",
                        "passé"
                    ],
                    "common_phrases": [
                        "art moderne",
                        "monde moderne",
                        "vie moderne"
                    ]
                },
                {
                    "sense_id": "c76a4c95-1cda-3f6c-9339-d962be9ec514",
                    "sense_definition": "Qui utilise ou intègre les innovations et progrès techniques les plus récents.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouvel hôpital dispose d'un équipement <w>moderne</w> particulièrement efficace."
                        },
                        {
                            "text": "Les laboratoires utilisent des technologies <w>modernes</w> pour analyser ces échantillons complexes."
                        }
                    ],
                    "synonyms": [
                        "avancé",
                        "perfectionné"
                    ],
                    "antonyms": [
                        "désuet",
                        "périmé"
                    ],
                    "common_phrases": [
                        "équipement moderne",
                        "technologie moderne"
                    ]
                },
                {
                    "sense_id": "bda6f640-dcd9-3da6-a9e2-f277d95a6368",
                    "sense_definition": "Qui s'affranchit des conventions ou de la tradition par une manière de penser ou de vivre novatrice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses parents ont une vision très <w>moderne</w> de l'éducation des enfants."
                        },
                        {
                            "text": "Cet auteur propose une lecture résolument <w>moderne</w> des textes classiques."
                        }
                    ],
                    "antonyms": [
                        "ancien"
                    ],
                    "common_phrases": [
                        "vision moderne",
                        "esprit moderne"
                    ]
                },
                {
                    "sense_id": "cb35b165-d1b3-3262-b49e-be10c71176c0",
                    "sense_definition": "Relatif à la période historique s'étendant de la fin du Moyen Âge à la Révolution française.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants analysent les institutions politiques caractéristiques de l'époque <w>moderne</w>."
                        },
                        {
                            "text": "Ce professeur est un grand spécialiste de l'histoire <w>moderne</w> européenne."
                        }
                    ],
                    "antonyms": [
                        "médiéval"
                    ],
                    "common_phrases": [
                        "époque moderne",
                        "histoire moderne",
                        "temps modernes"
                    ]
                },
                {
                    "sense_id": "9ea02e49-f3db-3ea1-a845-5f93d9909d8e",
                    "sense_definition": "Qualifie le mouvement architectural développé entre 1750 et 1870, alliant références au passé et innovations stylistiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'opéra Garnier représente une pièce maîtresse de l'architecture <w>moderne</w> du dix-neuvième siècle."
                        },
                        {
                            "text": "Plusieurs façades du quartier illustrent les principes de l'architecture <w>moderne</w>."
                        }
                    ],
                    "common_phrases": [
                        "architecture moderne"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1a32ff0-9911-3135-97d3-f37ff83ec74e",
                    "sense_definition": "Personne, notamment un auteur ou un artiste, qui a vécu ou créé depuis la Renaissance, par opposition aux auteurs de l'Antiquité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La célèbre querelle littéraire opposait les partisans des Anciens et des <w>Modernes</w>."
