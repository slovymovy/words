{
    "word_family": [
        "pissen",
        "bed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64e3bbc9-ae51-3da0-a919-1c306bf8cc0c",
                    "sense_definition": "Een klein, grijsachtig schaaldier met een plat lichaam dat onder stenen en in vochtige omgevingen leeft.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "isopod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik de oude bloempot optilde, kroop er snel een <w>pissebed</w> weg.",
                            "target_lang_translations": {
                                "en": "When I lifted the old flowerpot, a <w>woodlouse</w> quickly crawled away."
                            }
                        },
                        {
                            "text": "Kinderen vinden het vaak leuk om een <w>pissebed</w> in de tuin te zoeken.",
                            "target_lang_translations": {
                                "en": "Children often enjoy looking for a <w>woodlouse</w> in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "keldermot",
                        "kelderzeug",
                        "muurvarken",
                        "steenmot",
                        "varkensbeest"
                    ],
                    "common_phrases": [
                        "een grijze pissebed"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, greyish crustacean with a flat body that lives under stones and in damp environments."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "woodlouse",
                                "target_lang_sense_clarification": "small terrestrial crustacean"
                            },
                            {
                                "target_lang_word": "pill bug",
                                "target_lang_sense_clarification": "type of woodlouse that can roll into a ball"
                            },
                            {
                                "target_lang_word": "sowbug",
                                "target_lang_sense_clarification": "flat-bodied woodlouse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c070d2aa-8bbc-3ebc-8529-d4dcbdb8f561",
                    "sense_definition": "Iemand die in zijn of haar bed plast.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bedwetter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn kleine broertje was vroeger een echte <w>pissebed</w>, maar nu gebeurt het nooit meer.",
                            "target_lang_translations": {
                                "en": "My little brother used to be a real <w>bedwetter</w>, but now it never happens anymore."
                            }
                        },
                        {
                            "text": "Het is voor een kind heel vervelend om als <w>pissebed</w> te worden geplaagd.",
                            "target_lang_translations": {
                                "en": "It is very unpleasant for a child to be teased for being a <w>bedwetter</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedplasser",
                        "bedzeiker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used informally or slightly mockingly"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who wets his or her bed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bedwetter",
                                "target_lang_sense_clarification": "person who wets the bed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdab44bf-4fd1-3cbd-bdf8-f155d2bfe4f0",
                    "sense_definition": "Volksnaam voor de <w>paardenbloem</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dandelion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In sommige dialecten wordt de paardenbloem ook wel een <w>pissebed</w> genoemd.",
                            "target_lang_translations": {
                                "en": "In some dialects, the dandelion is also called a <w>piss-a-bed</w>."
                            }
                        },
                        {
                            "text": "De oude boer wees naar het gele veld en noemde elke bloem een <w>pissebed</w>.",
                            "target_lang_translations": {
                                "en": "The old farmer pointed to the yellow field and called every flower a <w>dandelion</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "paardenbloem"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in specific regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Folk name for the dandelion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dandelion",
                                "target_lang_sense_clarification": "yellow-flowered wild plant"
                            },
                            {
                                "target_lang_word": "piss-a-bed",
                                "target_lang_sense_clarification": "archaic folk name for dandelion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
