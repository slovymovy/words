                "senses": [
                    {
                        "sense_id": "a565fa40-fe49-3377-ba57-1d901714d72e",
                        "entry_id": "5ce531a7-d225-3124-9176-b72631bba172",
                        "glosses": [
                            "Donner un caractère ostéopathique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2bfd492-da9a-45a2-9132-bfd4af514349",
                                "sense_id": "a565fa40-fe49-3377-ba57-1d901714d72e",
                                "text": "Faudra-t-il pour continuer à vivre que la kinési s’ostéopathise ou que l’ostéopathie se kinésithérapise?"
                            },
                            {
                                "example_id": "d59d6ecf-5424-4d97-9ab2-27f916eafb76",
                                "sense_id": "a565fa40-fe49-3377-ba57-1d901714d72e",
                                "text": "Et pour cela, il n'est pas forcement nécessaire de « s'ostéopathiser » , vous avez parfaitement le droit de ne rester que « kiné »."
                            }
                        ]
                    },
                    {
                        "sense_id": "e33ab7ee-fd67-39ab-8b48-e47260249a1f",
                        "entry_id": "5ce531a7-d225-3124-9176-b72631bba172",
                        "glosses": [
                            "Traiter par l’ostéopathie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4477acad-6bc5-4118-91d3-1fe9f2e592dd",
                                "sense_id": "e33ab7ee-fd67-39ab-8b48-e47260249a1f",
                                "text": "Les chevaux pris en milieu de carrière et n'ayant jamais recu de soins ont été ostéopathisés et infiltrés."
                            }
                        ]
                    }
