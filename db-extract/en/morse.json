                        "entry_id": "db7e393f-6c17-3447-8069-b8495d33d5e6",
                        "glosses": [
                            "A walrus."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "99726267-4c05-4848-8293-0abc39c48309",
                                "sense_id": "fd07fca1-e5f9-366a-be58-0470b92a705e",
                                "text": "The morse is said to roar or bellow loudly, but the animal we slew made no outcry, [...]"
                            },
                            {
                                "example_id": "4faa7670-bde3-4774-bb46-a767c7a970c9",
                                "sense_id": "fd07fca1-e5f9-366a-be58-0470b92a705e",
                                "text": "Then we passed through a great deale of small ice, and sawe, upon some peices, two morses, and upon some, one; and also diuers seales, layeing upon peices of ice."
                            }
                        ]
                    }
                ],
