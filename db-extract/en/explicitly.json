                        "glosses": [
                            "In an explicit manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c506f583-18da-4dae-b92a-bdde5f1f9dab",
                                "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                "text": "The fifth amendment to the United States constitution provides explicitly for the protection of private property."
                            },
                            {
                                "example_id": "44c3c3c5-429b-4639-a616-fcc30e068e7a",
                                "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                "text": "Descartes's methodism with its regulative criterion leads him to explicitly deny that accidentally true belief qualifies as knowledge."
                            }
                        ]
                    }
                ],
