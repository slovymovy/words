                "translations": [
                    {
                        "translation_id": "8b38e0bd-5041-4ac4-9927-78f6130c0cf1",
                        "source_entry_id": "81c86cc2-f43c-3d46-ab5c-3684429ca791",
                        "source_sense_id": "b2425da5-ec37-3ff3-b533-751cc9cd50cf",
                        "target_lang_word": "Central Asiatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Central Asiatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb0b981b-8fdc-36cf-9a00-98f4c39b48ea",
                                        "entry_id": "13f45507-86d1-31a2-8f8e-a2ebdce15b7f",
                                        "glosses": [
                                            "Synonym of Central Asian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4beead95-7794-414e-afe6-34ed3a09861c",
                                                "sense_id": "eb0b981b-8fdc-36cf-9a00-98f4c39b48ea",
                                                "text": "The Central Asiatic race, the Mongol, the Tartar, when pure, revelled in tents and arms; plunder and the pomp of war was their whole aim."
                                            },
                                            {
                                                "example_id": "b583e2c9-e5cd-4c67-83e1-667725d880f3",
                                                "sense_id": "eb0b981b-8fdc-36cf-9a00-98f4c39b48ea",
                                                "text": "The principal sets of Central Asiatic manufactures are Bokhara, Karshi, Yenghi Ürgendj, Khokand, and Namengan."
                                            },
                                            {
                                                "example_id": "ce757609-11ce-4bc0-b219-41d4ae22e653",
                                                "sense_id": "eb0b981b-8fdc-36cf-9a00-98f4c39b48ea",
                                                "text": "Ṭāq-i Bustān lies just east of Kirmānshāh, a town in western Irān on the so-called High Road that led from Mesopotamia through the central Zagros Mountains to Khurāsān, the crucially important Central Asiatic frontier of Arab conquest."
                                            }
                                        ]
                                    }
                                ]
                            },
