                                "target_senses": [
                                    {
                                        "sense_id": "08d916da-249a-3751-8e3f-8ec617077968",
                                        "entry_id": "7b75f923-998a-38f0-9fd8-372a6692afce",
                                        "glosses": [
                                            "Synonym of Bengali (language)."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faaf4401-ae10-4351-afd4-668376c09bf1",
                                                "sense_id": "08d916da-249a-3751-8e3f-8ec617077968",
                                                "text": "The segmental phones of Bangla are slightly different from those of other Indo-European languages."
                                            },
                                            {
                                                "example_id": "b67fef98-870f-456c-b3cc-5fcf7bb584dd",
                                                "sense_id": "08d916da-249a-3751-8e3f-8ec617077968",
                                                "text": "I have spent a great deal of time in the subject of Bangla spelling reform, researched about it, written and published about it. I have written in Bangla in the reform I proposed for many years."
                                            },
                                            {
                                                "example_id": "32813c7c-f561-496b-872e-58186628fd47",
                                                "sense_id": "08d916da-249a-3751-8e3f-8ec617077968",
                                                "text": "The best thorough treatment of Bangla phonetics and phonology remains Ferguson and Chowdhury (1960)."
                                            },
                                            {
                                                "example_id": "e1d22817-338d-4254-859f-9c890b6921b7",
                                                "sense_id": "08d916da-249a-3751-8e3f-8ec617077968",
                                                "text": "Whitechapel: Transport for London has been asked to erect signs at the Elizabeth Line station in Bangla, as well as English, to reflect the East End's cultural diversity. There are already bilingual notices at Southall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fed971d-d60c-3c67-ad79-b75631245980",
                                        "entry_id": "7b75f923-998a-38f0-9fd8-372a6692afce",
                                        "glosses": [
                                            "Synonym of Bengal (region)."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16f399d1-8c39-4ccf-9c91-8101c4fd3ae3",
                                                "sense_id": "2fed971d-d60c-3c67-ad79-b75631245980",
                                                "text": "Historian Neehar Ranjan Roy has said that although the place lay on the footsteps of the Himalayas, it was in fact linked to the Bangla region."
                                            },
                                            {
                                                "example_id": "280b5418-8618-4b7a-8ff4-0d75cbcf6276",
                                                "sense_id": "2fed971d-d60c-3c67-ad79-b75631245980",
                                                "text": "As the Greek histories suggest, Alexander the Great was unsuccessful in his bid to conquer the Bangla region, then known as Gangaridai/Gangaridi, largely due to the military prowess of the people of the region;"
                                            },
                                            {
                                                "example_id": "95090295-75f7-4bc4-a3f1-17820c39ae2a",
                                                "sense_id": "2fed971d-d60c-3c67-ad79-b75631245980",
                                                "text": "All the river banks of the western parts of Bangla have such places which include the catchment areas of Mayurakhi, Ajay, Banka, Damodar, Dwarakeswar, Kangsabati, etc.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bangla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c3e316f-0f87-30c8-b8a9-77a47b0c364e",
                                        "entry_id": "819ce117-f735-322a-8f72-af6ef8063600",
                                        "glosses": [
                                            "Bengali (ethnicity)."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14377dec-675c-478c-95b0-135bd0976f1c",
                                                "sense_id": "4c3e316f-0f87-30c8-b8a9-77a47b0c364e",
                                                "text": "This cooking's so different he says, from their Bangla cooking."
                                            },
                                            {
                                                "example_id": "61d2efb2-7bdc-4c45-89ba-a7a4f5e609dc",
                                                "sense_id": "4c3e316f-0f87-30c8-b8a9-77a47b0c364e",
                                                "text": "After a gap of two years caused by the Covid 19 pandemic, the Bangla new year Pohela Boisakh was celebrated across Bangladesh on Thursday, April 14 with enthusiasm and festivity."
                                            },
                                            {
                                                "example_id": "5157a7b9-19e5-4283-9e1d-ea6f61676829",
                                                "sense_id": "4c3e316f-0f87-30c8-b8a9-77a47b0c364e",
                                                "text": "On Friday, Bengalis will welcome 1429 as per Bangla calendar"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bangla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33c27d66-3d5c-3ef3-acb5-dbad4e9beaed",
