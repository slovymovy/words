        "ru-extract.jsonl": [
            {
                "entry_id": "433926dd-e7f0-3d14-b337-19e90ee0685a",
                "word": "Титов",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5ebe1e1-06d2-3350-86de-28303156057e",
                        "entry_id": "433926dd-e7f0-3d14-b337-19e90ee0685a",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbabf4a1-b3a6-4e74-9a1c-14764936b75a",
                                "sense_id": "b5ebe1e1-06d2-3350-86de-28303156057e",
                                "text": "Вам надо сделать еще одно последнее усилие, и именно: съездить с этим письмом к г-ну Титову и прочесть его ему непременно."
                            },
                            {
                                "example_id": "f52ca272-4977-435a-96b3-27ef33b3b00d",
                                "sense_id": "b5ebe1e1-06d2-3350-86de-28303156057e",
                                "text": "Вообще в доме Титовых молодежь жила весело, и сам дедушка поощрял это веселье."
                            },
                            {
                                "example_id": "690053d2-8385-4399-afa7-dcf61ca826e6",
                                "sense_id": "b5ebe1e1-06d2-3350-86de-28303156057e",
                                "text": "― Костик, ты опоздаешь, ― долетел до нас окрик Титовой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5769d4b9-355b-492e-8b8c-dfe16037ca66",
                        "source_entry_id": "433926dd-e7f0-3d14-b337-19e90ee0685a",
