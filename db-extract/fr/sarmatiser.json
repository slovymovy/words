                "senses": [
                    {
                        "sense_id": "2e03ed46-426e-31db-929d-aaa4499aed53",
                        "entry_id": "b119c7c6-7be8-3cd8-bced-90e1711e6d87",
                        "glosses": [
                            "Donner un caractère sarmate à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da4f720-7470-46a3-b913-82232d438f9a",
                                "sense_id": "2e03ed46-426e-31db-929d-aaa4499aed53",
                                "text": "Cela montre une adaptation rapide d’éléments alano-sarmates dans le costume de l’aristocratie grecque « sarmatisée » du Pont."
                            },
                            {
                                "example_id": "90677944-1fbe-43b6-acdb-f521073202df",
                                "sense_id": "2e03ed46-426e-31db-929d-aaa4499aed53",
                                "text": "De même que les Scythes épargnèrent les riches emporia des Grecs de la Mer Noire, les Sarmates, tout en les encerclant, se contentent de les « sarmatiser » pendant des siècles avant de leur porter, à la suite des Goths, le coup de grâce, au cours du IIIe siècle de notre ère seulement."
                            },
                            {
                                "example_id": "c88fe06a-e820-40f4-9d6d-d361e4a0ebc8",
                                "sense_id": "2e03ed46-426e-31db-929d-aaa4499aed53",
                                "text": "Le christianisme doit donc se “nationaliser”, comme il s’était germanisé (sarmatisé ?) aux temps de la conversion, pour être en adéquation avec la spécificité “racique” des nouvelles ouailles nord-européennes ou issues de la cavalerie des Légions de l’Urbs."
                            }
                        ]
                    }
