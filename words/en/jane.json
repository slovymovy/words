                                "zh": "<w>简</w>先生在这家公司已经工作了二十年。"
                            }
                        },
                        {
                            "text": "We received a letter from the <w>Jane</w> family regarding the estate.",
                            "target_lang_translations": {
                                "ru": "Мы получили письмо от семьи <w>Джейн</w> касательно поместья.",
                                "zh": "我们收到了<w>简</w>一家关于遗产问题的信。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
