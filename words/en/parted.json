    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3a5a2650-c0d1-3404-8c9e-efe3f8bc8397",
                    "sense_definition": "Separated or divided into pieces",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>parted</w> curtains revealed a beautiful view of the garden.",
                            "target_lang_translations": {
                                "ru": "<w>Раздвинутые</w> шторы открыли прекрасный вид на сад."
                            }
                        },
                        {
                            "text": "They stood on the platform as <w>parted</w> lovers saying goodbye.",
                            "target_lang_translations": {
                                "ru": "Они стояли на платформе как <w>разлученные</w> влюбленные, прощаясь друг с другом."
                            }
                        }
                    ],
                    "synonyms": [
                        "divided",
                        "separated"
                    ],
                    "antonyms": [
                        "joined",
                        "united"
                    ],
                    "common_phrases": [
                        "parted curtains",
                        "parted ways"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделенный на части или отодвинутый в стороны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздвинутый",
                                "target_lang_sense_clarification": "о шторах или предметах, которые развели в стороны"
                            },
                            {
                                "target_lang_word": "разлученный",
                                "target_lang_sense_clarification": "о людях, которые расстались"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab4162b4-934d-3dfe-83a9-6154c21ff02c",
                    "sense_definition": "Having a deep split or cleft",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist examined the <w>parted</w> leaf under the microscope.",
                            "target_lang_translations": {
                                "ru": "Ботаник изучил <w>рассеченный</w> лист под микроскопом."
                            }
                        },
                        {
                            "text": "The plant has distinct <w>parted</w> foliage that grows in the shade.",
                            "target_lang_translations": {
                                "ru": "У этого растения отчетливая <w>рассеченная</w> листва, которая растет в тени."
                            }
                        }
                    ],
                    "synonyms": [
                        "cleft",
                        "split"
                    ],
                    "common_phrases": [
                        "parted leaf"
                    ],
                    "target_lang_definitions": {
