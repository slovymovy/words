                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fde50a8-6810-4230-931c-d399ab9754e0",
                                                "sense_id": "9a398ea9-d931-389a-b06b-bcc3a043c449",
                                                "text": "Er gilt als anerkannte Kapazität auf seinem Gebiet."
                                            },
                                            {
                                                "example_id": "b0da580b-99b9-4533-8c2e-1be4e8fbab83",
                                                "sense_id": "9a398ea9-d931-389a-b06b-bcc3a043c449",
                                                "text": "„Vor zwei Jahren hatte ihm eine Kapazität auf seine Frage, wie lange er noch zu leben habe, erklärt, daß es höchstens zwei Jahre wären, wenn er sich sorgfältig pflege.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
