                ],
                "senses": [
                    {
                        "sense_id": "aca7d2fd-e2b3-3181-b243-f7ed915a8b62",
                        "entry_id": "4492109a-a00c-37de-9792-63152827d1cd",
                        "glosses": [
                            "jemand, der unter einer Heroinabhängigkeit leidet, heroinabhängig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f5d559-a071-4562-b43d-100fad7ddea3",
                                "sense_id": "aca7d2fd-e2b3-3181-b243-f7ed915a8b62",
                                "text": "„Diese Gifte lassen sich einfacher anwenden, wenn ein Opfer sich selbst spritzt, wie etwa ein Diabetiker oder ein Heroinabhängiger.“"
                            },
                            {
                                "example_id": "eeb73997-b8dc-41a9-888d-16cbe580b89a",
                                "sense_id": "aca7d2fd-e2b3-3181-b243-f7ed915a8b62",
                                "text": "„Wacht man durch Naloxon als Heroinabhängiger aus der Überdosis wieder auf, verspürt man den Drang, erneut etwas zu nehmen, da der Rausch erst mal weg ist.“"
                            },
                            {
                                "example_id": "ec3ad09c-df00-417e-9f16-7274fe8aa415",
                                "sense_id": "aca7d2fd-e2b3-3181-b243-f7ed915a8b62",
                                "text": "„Sie bekommen starke Blähungen und fürchterlichen Durst und dann beginnen sie zu zittern wie ein Heroinabhängiger auf Entzug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
