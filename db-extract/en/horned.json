                        "target_lang_word": "cornu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cornu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a8db21e-457f-32ec-83a9-8d87c75d42b1",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Qui a des cornes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b33555e-d9fe-4bdf-b7f4-7fed78c5c59a",
                                                "sense_id": "3a8db21e-457f-32ec-83a9-8d87c75d42b1",
                                                "text": "Les diables cornus."
                                            },
                                            {
                                                "example_id": "d04b57a8-c515-4e1f-95c5-8680103b99cc",
                                                "sense_id": "3a8db21e-457f-32ec-83a9-8d87c75d42b1",
                                                "text": "Un animal cornu blessa de quelque coups Le lion, qui, plein de courroux…"
                                            },
                                            {
                                                "example_id": "ca1bb143-f2dd-4134-bb94-4e687031affc",
                                                "sense_id": "3a8db21e-457f-32ec-83a9-8d87c75d42b1",
                                                "text": "Vint à passer un troupeau de bœufs, et le désordre fut à son comble. Les bêtes cornues, nous ne voulons pas parler des bipèdes mariés qui lors traversaient le Pont-Neuf, mais bien des bœufs, couraient çà et là, baissant la tête, effarés, harcelés par les chiens, bâtonnés par les conducteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc9acc57-162e-3594-bbd1-e3f4f7a46150",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Qui a des coins ou angles saillants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c95237a0-3ff3-4540-8e0f-60b705a4beb5",
                                                "sense_id": "cc9acc57-162e-3594-bbd1-e3f4f7a46150",
                                                "text": "Un pain cornu. Une pièce de terre cornue."
                                            },
                                            {
                                                "example_id": "14120a6e-1aa1-4494-8403-31aafcd172be",
                                                "sense_id": "cc9acc57-162e-3594-bbd1-e3f4f7a46150",
                                                "text": "Du fond de cet antre pierreux, Entre deux montagnes cornues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c7d296a-d4f5-3cc1-be66-e64e27b03d0a",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Bizarre, étrange, absurde, illogique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359079bb-49fb-4007-a73e-f3702bdaf4a8",
                                                "sense_id": "3c7d296a-d4f5-3cc1-be66-e64e27b03d0a",
                                                "text": "On donnait le nom d’argument cornu à cet argument-ci : Vous avez ce que vous n'avez pas perdu ; or vous n'avez pas perdu des cornes ; donc vous avez des cornes."
                                            },
                                            {
                                                "example_id": "48f10b64-10f3-4e25-8080-4e7d37c6244c",
                                                "sense_id": "3c7d296a-d4f5-3cc1-be66-e64e27b03d0a",
                                                "text": "Lièvres cornus, idées folles, extravagantes, ainsi dites parce que les lièvres n'ont pas de cornes."
                                            },
                                            {
                                                "example_id": "7ced5f73-b697-4641-8a64-1a6e7297a7f0",
                                                "sense_id": "3c7d296a-d4f5-3cc1-be66-e64e27b03d0a",
                                                "text": "Et de lièvres cornus le cerveau [ils] nous barbouillent."
                                            },
                                            {
                                                "example_id": "7465f7ed-d1a7-46ed-83b7-cbf987c751b3",
                                                "sense_id": "3c7d296a-d4f5-3cc1-be66-e64e27b03d0a",
                                                "text": "Tous vos beaux arguments cornus Pour me persuader de vivre Et pour m’obliger à vous suivre, N'étaient donc que pour m’attraper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d088d69b-219c-3d42-9af5-c88d532e6048",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Mari trompé."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f075080b-5b4c-4557-9633-e915993fb18a",
                                                "sense_id": "d088d69b-219c-3d42-9af5-c88d532e6048",
                                                "text": "Ainsi sont les Européennes, dit Michael. Ah, mes amis, si tous les cornus d’Europe portaient lampions, ô miséricorde, quelle illumination !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbdb4841-11d6-38b4-b386-baf52ec0740b",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Dont le style ou les anthères sont en forme de corne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac25e8c7-0c1a-3c2d-ae14-6a9369e77ec7",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Affecté de l’ergot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7cbc609-736b-4994-8110-eb578bd6570b",
                                                "sense_id": "ac25e8c7-0c1a-3c2d-ae14-6a9369e77ec7",
                                                "text": "Blé cornu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f343efe-636c-37be-bc73-5b87c7331397",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Dont la hanche, très prononcée, forme une forte saillie, défaut dû, soit à une conformation vicieuse, soit simplement à la maigreur."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ffde7d-5712-41d0-be3c-09e61c14a639",
                                                "sense_id": "1f343efe-636c-37be-bc73-5b87c7331397",
                                                "text": "Cheval cornu, jument cornue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b3ee598-3866-3f96-a532-d073a48223f0",
                                        "entry_id": "07683726-e0ff-3eea-bd9e-aa2319a83182",
                                        "glosses": [
                                            "Diacritique « ◌̛ » de l’alphabet vietnamien attaché au coin supérieur droite des lettres « o » et « u » pour donner « ơ » et « ư » (arrondissement de voyelles)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cornu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58563fd9-0194-3551-bded-576dbac093f9",
                                        "entry_id": "c67aed6e-9a32-3619-b20a-3b4f990256a7",
