    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "86df4e1f-c488-32c0-92a4-afa579dedc15",
                "word": "meridional",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5dbd2608-930a-35bd-a0e2-fbc1e1f6561a",
                        "entry_id": "86df4e1f-c488-32c0-92a4-afa579dedc15",
                        "glosses": [
                            "located in the south, southern; later especially, often pertaining to the southern parts of Europe."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "13a7f5bd-98be-4b47-89be-c996d4624dfd",
                                "sense_id": "5dbd2608-930a-35bd-a0e2-fbc1e1f6561a",
                                "text": "Offices that require heat […] should be meridional."
                            },
                            {
                                "example_id": "a51c43c8-61e2-4fa8-88da-0138166ae76d",
                                "sense_id": "5dbd2608-930a-35bd-a0e2-fbc1e1f6561a",
                                "text": "For much of the 19th century what we now know as South America was called Meridional America"
                            }
                        ]
                    },
                    {
                        "sense_id": "cbdc96c1-3719-35d4-8199-e3db8d163c85",
                        "entry_id": "86df4e1f-c488-32c0-92a4-afa579dedc15",
                        "glosses": [
                            "of or characteristic of southern areas or people, especially those in the southern parts of Europe"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c5696e66-3563-43b0-b33c-fc2332d0ce80",
                                "sense_id": "cbdc96c1-3719-35d4-8199-e3db8d163c85",
                                "text": "This, Constance recognised, may have had nothing to do with the situation – it was probably just a meridional convention – for in the Mediterranean countries nobody trusts his neighbour [...]."
                            },
                            {
                                "example_id": "e3149cf1-31d2-45f3-90d8-50f2c34bd770",
                                "sense_id": "cbdc96c1-3719-35d4-8199-e3db8d163c85",
                                "text": "As soon as he heard the news of the trial and execution, he summed up the incident as a monument to Catholic intolerance, meridional superstition and judicial bigotry – and he decided to do something about it."
                            }
                        ]
                    },
                    {
                        "sense_id": "d32facef-18f2-3b68-a66b-9df7e6263c9b",
                        "entry_id": "86df4e1f-c488-32c0-92a4-afa579dedc15",
                        "glosses": [
                            "along a north–south direction, or relative to a meridian; or relating to meridians or a meridian"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
