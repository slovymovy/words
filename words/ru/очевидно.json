{
    "word_family": [
        "очевидный",
        "очевидность"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a5c18fc1-234c-3cbe-b4e6-6c09b53e1859",
                    "sense_definition": "Оценочная характеристика ситуации как ясной, понятной и не вызывающей сомнений.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "certainty_fact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для всех <w>очевидно</w>, что это было правильное решение.",
                            "target_lang_translations": {
                                "en": "It is <w>obvious</w> to everyone that this was the right decision.",
                                "de": "Für alle ist es <w>offensichtlich</w>, dass dies die richtige Entscheidung war.",
                                "zh": "对所有人来说，这无疑是一个正确的决定，这一点<w>显而易见</w>。"
                            }
                        },
                        {
                            "text": "В её поведении произошла перемена, и это было совершенно <w>очевидно</w>.",
                            "target_lang_translations": {
                                "en": "There was a change in her behavior, and it was completely <w>obvious</w>.",
                                "de": "In ihrem Verhalten gab es eine Veränderung, und das war völlig <w>offensichtlich</w>.",
                                "zh": "她的行为发生了变化，这一点<w>显而易见</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ясно",
                        "понятно",
                        "несомненно",
                        "бесспорно",
                        "явно"
                    ],
                    "antonyms": [
                        "неочевидно",
                        "сомнительно"
                    ],
                    "common_phrases": [
                        "совершенно очевидно",
                        "стало очевидно",
                        "всем очевидно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to describe a situation that is clear, easy to understand, or certain.",
                        "de": "Wird verwendet, um eine Situation zu beschreiben, die klar, leicht verständlich oder zweifellos ist.",
                        "zh": "用于描述情况清晰、易于理解或确定无疑。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "it is obvious",
                                "target_lang_sense_clarification": "predicative phrase"
                            },
                            {
                                "target_lang_word": "obviously",
                                "target_lang_sense_clarification": "general adverb"
                            },
                            {
                                "target_lang_word": "clearly",
                                "target_lang_sense_clarification": "without doubt"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "offensichtlich",
                                "target_lang_sense_clarification": "allgemeines Adverb"
                            },
                            {
                                "target_lang_word": "klar",
                                "target_lang_sense_clarification": "ohne Zweifel"
                            },
                            {
                                "target_lang_word": "es ist offensichtlich",
                                "target_lang_sense_clarification": "prädikativer Ausdruck"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显而易见",
                                "target_lang_sense_clarification": "形容情况非常清楚"
                            },
                            {
                                "target_lang_word": "显然",
                                "target_lang_sense_clarification": "副词，表示事实清楚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94cc4b31-9cf2-3eb9-b940-624ebf95c520",
                    "sense_definition": "Вводное слово, используемое для выражения предположения, основанного на наблюдениях или догадках; соответствует по значению словам «вероятно», «по-видимому».",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "probability_inference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы долго стучали в дверь, но хозяев, <w>очевидно</w>, не было дома.",
                            "target_lang_translations": {
                                "en": "We knocked on the door for a long time, but the owners were <w>apparently</w> not home.",
                                "de": "Wir klopften lange an die Tür, aber die Besitzer waren <w>anscheinend</w> nicht zu Hause.",
                                "zh": "我们敲了很久的门，但主人<w>看来</w>不在家。"
                            }
                        },
                        {
                            "text": "Он, <w>очевидно</w>, забыл о нашей встрече и не пришёл.",
                            "target_lang_translations": {
                                "en": "He <w>evidently</w> forgot about our meeting and didn't come.",
                                "de": "Er hat <w>offenbar</w> unser Treffen vergessen und ist nicht gekommen.",
                                "zh": "他<w>显然</w>是忘了我们的会面，所以没来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вероятно",
                        "по-видимому",
                        "наверное",
                        "видимо"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate that something seems to be true based on evidence or observation.",
                        "de": "Wird verwendet, um auszudrücken, dass etwas aufgrund von Beobachtungen oder Hinweisen wahr zu sein scheint.",
                        "zh": "用于表示根据证据或观察得出的推测。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apparently",
                                "target_lang_sense_clarification": "based on appearance/inference"
                            },
                            {
                                "target_lang_word": "evidently",
                                "target_lang_sense_clarification": "based on evidence"
                            },
                            {
                                "target_lang_word": "obviously",
                                "target_lang_sense_clarification": "inference"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "anscheinend",
                                "target_lang_sense_clarification": "basierend auf dem äußeren Anschein"
                            },
                            {
                                "target_lang_word": "offenbar",
                                "target_lang_sense_clarification": "aufgrund von Hinweisen"
                            },
                            {
                                "target_lang_word": "augenscheinlich",
                                "target_lang_sense_clarification": "nach den Umständen zu urteilen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看来",
                                "target_lang_sense_clarification": "表示根据迹象推断"
                            },
                            {
                                "target_lang_word": "显然",
                                "target_lang_sense_clarification": "表示根据证据推断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "508f4cec-57f2-3b9e-9d18-65593e76c330",
                    "sense_definition": "Вводное слово, выражающее уверенность говорящего в истинности сказанного; соответствует по значению словам «безусловно», «конечно».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Очевидно</w>, мы просто не понимаем друг друга в этом вопросе.",
                            "target_lang_translations": {
                                "en": "<w>Obviously</w>, we just don't understand each other on this matter.",
                                "de": "<w>Offensichtlich</w> verstehen wir uns in dieser Frage einfach nicht.",
                                "zh": "<w>显然</w>，我们在这个问题上只是互相不理解。"
                            }
                        },
                        {
                            "text": "Вы, <w>очевидно</w>, правы, и спорить здесь не имеет смысла.",
                            "target_lang_translations": {
                                "en": "You are <w>obviously</w> right, and there is no point in arguing here.",
                                "de": "Sie haben <w>offensichtlich</w> recht, und es hat keinen Sinn, hier zu streiten.",
                                "zh": "你<w>显然</w>是对的，在这里争论没有意义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "безусловно",
                        "конечно",
                        "разумеется"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize that something is true, well-known, or undeniable.",
                        "de": "Wird verwendet, um zu betonen, dass etwas wahr, allgemein bekannt oder unbestreitbar ist.",
                        "zh": "用于强调某事是真实的、众所周知的或不可否认的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obviously",
                                "target_lang_sense_clarification": "emphasis on certainty"
                            },
                            {
                                "target_lang_word": "clearly",
                                "target_lang_sense_clarification": "emphasis"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "offensichtlich",
                                "target_lang_sense_clarification": "Betonung der Gewissheit"
                            },
                            {
                                "target_lang_word": "klarerweise",
                                "target_lang_sense_clarification": "Betonung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显然",
                                "target_lang_sense_clarification": "强调确定性"
                            },
                            {
                                "target_lang_word": "毫无疑问",
                                "target_lang_sense_clarification": "强调不可否认"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "421bcc12-2155-312e-9a7c-90961d4966d7",
                    "sense_definition": "Заметно, видимо для глаз.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "visual_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его благосостояние росло <w>очевидно</w> для всех соседей.",
                            "target_lang_translations": {
                                "en": "His wealth grew <w>visibly</w> to all the neighbors.",
                                "de": "Sein Wohlstand wuchs für alle Nachbarn <w>zusehends</w>.",
                                "zh": "他的财富在邻居们眼中<w>明显地</w>增长着。"
                            }
                        },
                        {
                            "text": "Сундуки с добром полнели <w>очевидно</w> день ото дня.",
                            "target_lang_translations": {
                                "en": "The chests of goods filled up <w>visibly</w> day by day.",
                                "de": "Die Truhen mit Gütern füllten sich <w>zusehends</w> von Tag zu Tag.",
                                "zh": "装满财物的箱子一天天<w>明显地</w>充实起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "заметно"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that can be seen with the eyes; visibly.",
                        "de": "Auf eine Weise, die mit den Augen wahrgenommen werden kann; sichtlich.",
                        "zh": "以肉眼可见的方式；明显地。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visibly",
                                "target_lang_sense_clarification": "perceptible by eye"
                            },
                            {
                                "target_lang_word": "noticeably",
                                "target_lang_sense_clarification": "perceptible"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zusehends",
                                "target_lang_sense_clarification": "mit den Augen wahrnehmbar"
                            },
                            {
                                "target_lang_word": "sichtlich",
                                "target_lang_sense_clarification": "deutlich erkennbar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明显地",
                                "target_lang_sense_clarification": "肉眼可见的程度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "729c881a-f43e-337c-881b-4564a5b84667",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>очевидный</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его превосходство в этой игре было <w>очевидно</w> с первых минут.",
                            "target_lang_translations": {
                                "en": "His superiority in this game was <w>obvious</w> from the very first minutes.",
                                "de": "Seine Überlegenheit in diesem Spiel war von den ersten Minuten an <w>offensichtlich</w>.",
                                "zh": "他在比赛中的优势从最初几分钟起就非常<w>明显</w>。"
                            }
                        },
                        {
                            "text": "Это противоречие <w>очевидно</w> и требует немедленного разрешения.",
                            "target_lang_translations": {
                                "en": "This contradiction is <w>obvious</w> and requires immediate resolution.",
                                "de": "Dieser Widerspruch ist <w>offensichtlich</w> und erfordert eine sofortige Lösung.",
                                "zh": "这个矛盾是<w>显而易见</w>的，需要立即解决。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Easy to see, recognize, or understand.",
                        "de": "Leicht zu sehen, zu erkennen oder zu verstehen (Kurzform des Adjektivs).",
                        "zh": "容易看到、识别或理解的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obvious",
                                "target_lang_sense_clarification": "adjective"
                            },
                            {
