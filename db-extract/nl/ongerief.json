                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf159840-523f-34f1-a2bd-7189c22dd027",
                        "entry_id": "880566ca-865c-3c1f-bc4f-273ff2d4f773",
                        "glosses": [
                            "hinder, ongemak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191ef4d8-7a54-46e9-abde-9a307dd1812a",
                                "sense_id": "bf159840-523f-34f1-a2bd-7189c22dd027",
                                "text": "In het boek 'Het taaie ongerief' heeft Theo Thijssen (1879 - 1943) de kledingellende in de crisistijd beeldend beschreven"
                            },
                            {
                                "example_id": "f25dfd70-7613-4e3e-8331-402efd0b8b2e",
                                "sense_id": "bf159840-523f-34f1-a2bd-7189c22dd027",
                                "text": "In zijn jongste roman neemt de moegetergde schrijver wraak voor het ongerief dat de paparazzi hem de voorbije jaren hebben aangedaan."
                            },
                            {
                                "example_id": "8f2c8005-ce76-4fd8-ad9f-ac900388ea83",
                                "sense_id": "bf159840-523f-34f1-a2bd-7189c22dd027",
                                "text": "Australisch onderzoek onder 13.000 internationale rocksterren leverde in 2013 een schokkend resultaat op: deze artiesten worden gemiddeld 25 jaar minder oud dan wij. De cijfers zijn gekleurd doordat popsterren veel vaker vroegtijdig ten prooi vallen aan overdoses drugs, vliegtuigongelukken en ander rock-'n-roll-ongerief."
                            },
                            {
                                "example_id": "84380f19-fbab-4331-959c-7b6433ff7142",
                                "sense_id": "bf159840-523f-34f1-a2bd-7189c22dd027",
                                "text": "Lezers reageren op het nieuws dat de files voorlopig niet verdwijnen en melden ander ongerief inzake de auto."
                            }
                        ]
                    }
                ],
