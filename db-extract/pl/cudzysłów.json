                "senses": [
                    {
                        "sense_id": "305049ff-5b32-3a34-899b-8cb9cd1296e6",
                        "entry_id": "54627772-572c-3b53-9ed9-2509463dc07e",
                        "glosses": [
                            "quotation mark"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "0187c1b1-f34d-42b6-9026-3ef80b2edf0c",
                                "sense_id": "305049ff-5b32-3a34-899b-8cb9cd1296e6",
                                "text": "w cudzysłowie/w cudzysłowach",
                                "translation": "in quotation marks",
                                "english": "in quotation marks"
                            },
                            {
                                "example_id": "8b75e20d-fdda-4437-9ed2-c6073a477ac8",
                                "sense_id": "305049ff-5b32-3a34-899b-8cb9cd1296e6",
                                "text": "Rychło dopomną się carowie moskiewscy o spuściznę po Rusi kijowskiej, o swą „ojcowiznę”, do której zaliczą wszystkie nabytki Giedyminowiczów, [...] i rozpoczną okres wojen moskiewskich. Użyliśmy wyrazu „ojcowizna” w cudzysłowie; chcemy sprecyzować, jakim był i czy był wogóle tytuł prawny carów moskiewskich do określenia całej Rusi Giedyminowiczów, jako należącej się im „ojcowizny” po Rusi kijowskiej, Rusi Włodzimierza Świętego.",
                                "translation": "The tsars of Moscow will quickly demand the legacy of Kievan Rus, their \"inherited land\", in which they will include all the lands acquired by the Gediminid dynasty, … and will begin the era of the Muscovite Wars. We have used the expression \"inherited land\" in quotation marks; we want to specify what was, and even whether there was, the tsars of Moscow's legal title to all of the Gediminids' Rus as the \"land inherited\" from Kievan Rus that belonged to them.",
                                "english": "The tsars of Moscow will quickly demand the legacy of Kievan Rus, their \"inherited land\", in which they will include all the lands acquired by the Gediminid dynasty, … and will begin the era of the Muscovite Wars. We have used the expression \"inherited land\" in quotation marks; we want to specify what was, and even whether there was, the tsars of Moscow's legal title to all of the Gediminids' Rus as the \"land inherited\" from Kievan Rus that belonged to them."
                            },
                            {
                                "example_id": "37807d18-6d9b-40ff-a599-4a7b2e436211",
                                "sense_id": "305049ff-5b32-3a34-899b-8cb9cd1296e6",
                                "text": "Wszystko, co znajdziecie w cudzysłowach, pochodzi z listów, pamiętników lub innych ówczesnych dokumentów.",
                                "translation": "Everything that you will find in quotation marks comes from letters, journals, or other contemporary documents.",
                                "english": "Everything that you will find in quotation marks comes from letters, journals, or other contemporary documents."
                            },
                            {
                                "example_id": "76b94a55-7dae-48bd-9226-4ba282dedd53",
                                "sense_id": "305049ff-5b32-3a34-899b-8cb9cd1296e6",
                                "text": "W języku angielskim cudzysłów na początku i na końcu cytatu pisze się na górze, nazywa się go inverted commas.",
                                "translation": "In English a quotation mark is written at the start and at the end of a quote at the top [of a line of text]; it is called inverted commas.",
                                "english": "In English a quotation mark is written at the start and at the end of a quote at the top [of a line of text]; it is called inverted commas."
                            }
                        ]
                    }
