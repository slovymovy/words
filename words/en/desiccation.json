                            },
                            {
                                "target_lang_word": "десикация",
                                "target_lang_sense_clarification": "научный термин: обезвоживание или подсушивание"
                            },
                            {
                                "target_lang_word": "сушка",
                                "target_lang_sense_clarification": "процесс удаления влаги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7022e46c-8553-3e68-80b6-0f870981bd05",
                    "sense_definition": "A specific act or instance of drying out thoroughly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drying_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Repeated <w>desiccations</w> of the marsh in the dry season caused significant mortality among aquatic larvae.",
                            "target_lang_translations": {
                                "ru": "Повторные <w>пересыхания</w> болота в сухой сезон привели к значительной гибели водных личинок."
                            }
                        },
                        {
                            "text": "The experiment documented each <w>desiccation</w> to measure how the bacteria reacted over time.",
                            "target_lang_translations": {
                                "ru": "В эксперименте фиксировалось каждое <w>высушивание</w>, чтобы измерить реакцию бактерий с течением времени."
                            }
                        }
                    ],
                    "common_phrases": [
                        "repeated desiccations"
                    ],
                    "target_lang_definitions": {
