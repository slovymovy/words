                        "translation_id": "f2b09759-3b03-49a5-8d21-2b8e22e6900a",
                        "source_entry_id": "868e1c4e-8d6f-3687-9c10-d044e58fdc22",
                        "source_sense_id": "20d4c021-232e-392c-860e-c3da7f5d8fc0",
                        "target_lang_word": "unipennate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unipennate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6406ec14-160f-3df4-94ba-47cadd792e7f",
                                        "entry_id": "aff950f2-d207-3d72-a0f2-1063adfbc76b",
                                        "glosses": [
                                            "Of, pertaining to, or having the nature of a muscle, the parallel fibres of which attach to a tendon at an acute angle (as a feather that is barbed on one side)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13e02499-963c-40c6-be65-eacee15e6415",
                                                "sense_id": "6406ec14-160f-3df4-94ba-47cadd792e7f",
                                                "text": "We applied this method to the proximal aponeurosis of the unipennate medial gastrocnemius muscle (MG) of the cat during active force production at fixed muscle length."
                                            },
                                            {
                                                "example_id": "12b3d2f9-2934-4423-b679-98429ae0cd93",
                                                "sense_id": "6406ec14-160f-3df4-94ba-47cadd792e7f",
                                                "text": "The most distal region of the muscle was again unipennate, with fibers oriented between the posterior aponeurosis and the anterior surface of the muscle (Fig. 1D,E)."
                                            },
                                            {
                                                "example_id": "2e2835a2-a9f1-4481-a680-ae7c411aa37b",
                                                "sense_id": "6406ec14-160f-3df4-94ba-47cadd792e7f",
                                                "text": "Although only one component of the muscle fiber force is used effectively to move the tendon, the advantage of the unipennate muscle system is that an increased number of sarcomeres can be placed in parallel to increase the effective force of the muscle (figure 2.19)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
