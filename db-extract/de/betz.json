                ],
                "senses": [
                    {
                        "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                        "entry_id": "bc83def1-219d-308f-a5d7-6ed485d9862b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3bf7a8-8e22-4ec4-86f2-e7d77ac6cb11",
                                "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                                "text": "Frau Betz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "da961d96-d515-462f-985b-738e88e8b736",
                                "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                                "text": "Herr Betz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9f76601d-c3e8-4965-a401-fbd59ebce703",
                                "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                                "text": "Die Betzens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "93da0a0e-9330-4a9d-8f9b-cef533368e86",
                                "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                                "text": "Der Betz trägt nie die Schals, die die Betz ihm strickt."
                            },
                            {
                                "example_id": "579cd9fb-25cf-4d1f-b12b-2f0fbfe423f5",
                                "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Betz kommt, geht der Herr Betz.“"
                            },
                            {
                                "example_id": "5816c1b6-1625-4ea4-9027-31840990d9d8",
                                "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                                "text": "Betz kommt und geht."
                            },
                            {
                                "example_id": "cf47a2c4-2872-4b13-9579-0e1697418950",
                                "sense_id": "121f8f12-3d41-3757-9b26-681bfda2820d",
                                "text": "Betzes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
