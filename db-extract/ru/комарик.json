                    {
                        "translation_id": "dbd3e39a-4af3-4137-bd84-7c2beb3b506c",
                        "source_entry_id": "38c90d64-1661-3906-9e25-d00bd8045d88",
                        "source_sense_description": "комар",
                        "target_lang_word": "Moskito",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moskito",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9821ff1e-1e98-3e93-a9ce-8940201acfec",
                                        "entry_id": "6a5e4a92-4c9e-3e6e-81b2-3173fe79065e",
                                        "glosses": [
                                            "tropische Stechmücke"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd1a7208-0bee-4893-b22a-a3d9beccacb6",
                                                "sense_id": "9821ff1e-1e98-3e93-a9ce-8940201acfec",
                                                "text": "Malaria wird durch Moskitos übertragen."
                                            },
                                            {
                                                "example_id": "b1e1022e-557a-46b4-8a93-3d984003d6c5",
                                                "sense_id": "9821ff1e-1e98-3e93-a9ce-8940201acfec",
                                                "text": "„Im Regenwald stiegen Moskitos, die Denguefieber, Gelbfieber, Chicungunyafieber und Malaria übertrugen, von der Abenddämmerung bis zur Morgenröte in dicken Wolken auf, so zahlreich wie die Sauerstoffatome in der Luft, durch die sie hindurchwirbelten – so fühlte es sich jedenfalls an.“"
                                            },
                                            {
                                                "example_id": "35c01c41-4c5e-44f5-8fe3-a000fe67e407",
                                                "sense_id": "9821ff1e-1e98-3e93-a9ce-8940201acfec",
                                                "text": "„Ich erinnere mich an ihn als einen Film voller Heldentaten und Moskito, Moskitos, die genau so grausam waren wie die in Murano auf Carlotas bleicher Haut.“"
                                            },
                                            {
                                                "example_id": "b0fd03c6-49dc-4503-937c-2dc18fb88af5",
                                                "sense_id": "9821ff1e-1e98-3e93-a9ce-8940201acfec",
                                                "text": "„Mit dem rotseidenen Taschentuch, das er in der Hand hielt, um sich damit Kühlung zuzufächeln, schlug er einige Male nach den Moskitos zu seinen Füßen.“"
                                            },
                                            {
                                                "example_id": "3ef10748-682d-4012-9df8-7ce50df2ca0f",
                                                "sense_id": "9821ff1e-1e98-3e93-a9ce-8940201acfec",
                                                "text": "„Wie um unsere Schwierigkeiten noch zu vergrößern, hatten uns den ganzen Tag Moskitos und Sandmücken gequält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85589d1e-fc4b-394a-96c0-5ae863265a89",
                                        "entry_id": "6a5e4a92-4c9e-3e6e-81b2-3173fe79065e",
                                        "glosses": [
                                            "Stechmücke"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f53cb2ca-fc3d-47b2-823b-18340b698fbd",
                                                "sense_id": "85589d1e-fc4b-394a-96c0-5ae863265a89",
                                                "text": "„Wie um unsere Schwierigkeiten noch zu vergrößern, hatten uns den ganzen Tag Moskitos und Sandmücken gequält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
