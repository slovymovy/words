                        "entry_id": "3763ca67-cfa4-36d3-bb54-ae6e8f1886c2",
                        "glosses": [
                            "Châssis de toit, dont l’encadrement est dans la pente du toit et l'ouverture par le milieu."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41c9d39e-137d-455e-a56d-2b7ac1e18fc6",
                        "source_entry_id": "3763ca67-cfa4-36d3-bb54-ae6e8f1886c2",
                        "source_sense_id": "729bf7c0-21be-322b-b0a9-ee9586526d44",
                        "target_lang_word": "Dachflächenfenster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a8317942-cbb9-440d-8e11-7b28ec56c5b2",
                        "source_entry_id": "3763ca67-cfa4-36d3-bb54-ae6e8f1886c2",
                        "source_sense_id": "729bf7c0-21be-322b-b0a9-ee9586526d44",
                        "target_lang_word": "Velux",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Velux",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22fa9a87-8acc-362b-a067-33c3162936a7",
                                        "entry_id": "58d07d6c-c610-3862-9943-afa942237858",
                                        "glosses": [
                                            "A skylight or roof window, especially one manufactured by the VELUX company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f63679-e001-4720-bd83-04479b6b3676",
                                                "sense_id": "22fa9a87-8acc-362b-a067-33c3162936a7",
                                                "text": "On the north side, he raised and classicised the stair tower window and replaced veluxes in the low-sweeping roof with a pair of piended (hipped) dormers."
                                            },
                                            {
                                                "example_id": "4e09fba0-7c02-411f-bf23-17a71df9bea2",
                                                "sense_id": "22fa9a87-8acc-362b-a067-33c3162936a7",
                                                "text": "With proper insulation and a few veluxes I could make more rooms up here — more money-earning 'chambres d'hotes'."
                                            },
                                            {
                                                "example_id": "9582c8f3-e639-45dc-9def-20379a15dc63",
                                                "sense_id": "22fa9a87-8acc-362b-a067-33c3162936a7",
                                                "text": "There are two large Veluxes in the steeply pitched roof, and a battery of windows is set high into the bare white walls."
                                            },
                                            {
                                                "example_id": "bc1d6a94-66ed-4a8e-9847-a743c03e26cb",
                                                "sense_id": "22fa9a87-8acc-362b-a067-33c3162936a7",
                                                "text": "The loft was broad and high, with splendid rough-cut oak purlins and three large Veluxes. It contained junk, I thought at first, but then I was surprised to make out that this included Victorian and even Georgian furniture […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
