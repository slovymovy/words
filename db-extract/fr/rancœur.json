        "fr-extract.jsonl": [
            {
                "entry_id": "d63f5a52-2a25-3eda-a2ff-3517ee671c34",
                "word": "rancœur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5373c69-87b3-43d2-be9c-6e4aee31ed92",
                        "entry_id": "d63f5a52-2a25-3eda-a2ff-3517ee671c34",
                        "tags": [
                            "plural"
                        ],
                        "form": "rancœurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8d10581-d29c-3cf8-a409-0a56ea7dca5e",
                        "entry_id": "d63f5a52-2a25-3eda-a2ff-3517ee671c34",
                        "glosses": [
                            "Mécontentement, aigreur, dégoût que laisse après elle une déception, une mésaventure, une injustice ; ressentiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75cf4867-7b0f-433f-88a6-e4ea065e19fc",
                                "sense_id": "d8d10581-d29c-3cf8-a409-0a56ea7dca5e",
                                "text": "Et, peu à peu, de la douceur primordiale, un peu timide et avide de tendresse de son caractère, montaient une sourde irritation, une rancœur et une révolte."
                            },
                            {
                                "example_id": "01c95ed7-95d7-4bab-a0f5-0cf2445c9808",
                                "sense_id": "d8d10581-d29c-3cf8-a409-0a56ea7dca5e",
                                "text": "Dans une lettre adressée au duc de Nevers, en 1208, Innocent III exhale sa rancœur contre les juifs."
                            },
                            {
                                "example_id": "b6d2ed69-fe33-4705-a767-c727cbd4055d",
                                "sense_id": "d8d10581-d29c-3cf8-a409-0a56ea7dca5e",
                                "text": "Chaque vexation qu’il me fit subir accroissait ma rancœur."
                            },
                            {
                                "example_id": "7e245dbf-1fef-4c55-ac23-15491e0d3abd",
                                "sense_id": "d8d10581-d29c-3cf8-a409-0a56ea7dca5e",
                                "text": "La rancœur lui fit repousser son assiette d'un geste vif, mais aussitôt elle reprit..."
                            }
                        ]
                    },
                    {
                        "sense_id": "68ac9233-0db3-3e7e-8744-c1d62c3e2847",
                        "entry_id": "d63f5a52-2a25-3eda-a2ff-3517ee671c34",
                        "glosses": [
                            "Motif d’un sentiment de rancœur (généralement au pluriel)."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "09a5d863-122b-4d58-babd-40d647c56446",
                                "sense_id": "68ac9233-0db3-3e7e-8744-c1d62c3e2847",
                                "text": "Les romans écrits par des femmes sont pleins des désillusions de la dévirginisation, de la légitimité de l’adultère, de la réhabilitation du lesbianisme comme remplacement, etc. Nos mères n’auraient jamais osé étaler de pareilles choses, chacune gardait pour elle ses rancœurs, cherchant au besoin des consolations dans la religion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12aa306c-bb97-4d47-93b8-ce66d203375b",
                        "source_entry_id": "d63f5a52-2a25-3eda-a2ff-3517ee671c34",
                        "target_lang_word": "Groll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Groll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                        "entry_id": "0e986053-3c41-3cc6-9559-1c080cedb95d",
                                        "glosses": [
                                            "lang anhaltender, aber stiller Zorn, versteckter Hass, verborgene Feindschaft"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bc33cee-b7af-4530-acb1-7c29633edf26",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "Ich hege keinen Groll gegen dich, ich bin einfach sehr beschäftigt."
                                            },
                                            {
                                                "example_id": "907690f2-5d6f-4824-b5e1-11b24e989a41",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "Peter hat einen tiefen Groll auf seine Exfrau."
                                            },
                                            {
                                                "example_id": "6e4365f2-2ffa-4e6e-bc18-42bb9aba7f06",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Steinmeiers Worten hört man Groll selbst dann nicht an, wenn es Zoff gegeben hat.“"
                                            },
                                            {
                                                "example_id": "53fbf068-f7f0-43df-aab0-253546f7a7d3",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Sie waren viel zu verspielt, um sich von oben mit Feindseligkeit und Groll und Erbitterung indoktrinieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "3bce2ec0-969d-4621-9eb0-2c40059752cf",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Da fühle ich einen kleinen Groll gegen Karnej in mir erwachen.“"
                                            },
                                            {
                                                "example_id": "ff79420c-5df3-411d-a091-30803b222e12",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Ein hübsches Sümmchen ist das, und ihre Freude darüber mildert ihren Groll auf Jürgen Loose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d7c951e-749e-31e2-949a-b681c60b1ec2",
                                        "entry_id": "0e986053-3c41-3cc6-9559-1c080cedb95d",
                                        "glosses": [
                                            "plötzlich aufwallender und hervorbrechender Zorn"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff66d92-5e84-4cc7-8518-379f34bdfbb7",
                                                "sense_id": "4d7c951e-749e-31e2-949a-b681c60b1ec2",
                                                "text": "In einem Anfall von Groll erwürgte Mechthild ihre Tante."
                                            },
                                            {
                                                "example_id": "04d1a7a9-109f-4fbb-aa2b-2e2635c6ef9b",
                                                "sense_id": "4d7c951e-749e-31e2-949a-b681c60b1ec2",
                                                "text": "„Der Leser muß mich verabscheuen, das ist mir klar; aber ich rate ihm, mit seinem Groll zu warten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dbb5ef1-937e-437f-a8d8-6809bdd24470",
                        "source_entry_id": "d63f5a52-2a25-3eda-a2ff-3517ee671c34",
