                {
                    "sense_id": "bee51cfc-e924-3246-8fea-2f76ba700671",
                    "sense_definition": "Qui est timide, ombrageux, réservé ou peu disposé à nouer des relations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne sois pas si <w>farouche</w> et viens donc discuter un moment avec nos invités.",
                            "target_lang_translations": {
                                "en": "Don't be so <w>shy</w>; come and chat with our guests for a while.",
                                "ru": "Не будь таким <w>застенчивым</w> и поболтай немного с нашими гостями.",
                                "de": "Sei nicht so <w>schüchtern</w> und komm doch her und plauder ein Weilchen mit unseren Gästen.",
                                "es": "No seas tan <w>tímido</w> y ven a charlar un rato con nuestros invitados.",
                                "zh": "别这么<w>害羞</w>嘛，过来和我们的客人聊一会儿吧。"
                            }
                        },
                        {
                            "text": "Cet enfant <w>farouche</w> se cache toujours derrière sa mère dès qu'un inconnu arrive.",
                            "target_lang_translations": {
                                "en": "This <w>shy</w> child always hides behind their mother whenever a stranger arrives.",
                                "ru": "Этот <w>застенчивый</w> ребёнок всегда прячется за маминой спиной, как только появляется незнакомец.",
                                "de": "Dieses <w>scheue</w> Kind versteckt sich immer hinter seiner Mutter, sobald ein Fremder kommt.",
                                "es": "Este niño <w>tímido</w> siempre se esconde detrás de su madre en cuanto llega un desconocido.",
                                "zh": "这个<w>害羞</w>的孩子，一有陌生人来，就总躲在妈妈身后。"
                            }
                        }
                    ],
                    "synonyms": [
                        "timide",
                        "ombrageux",
                        "sauvage",
                        "réservé"
                    ],
                    "antonyms": [
                        "sociable"
                    ],
                    "common_phrases": [
                        "ne pas être farouche"
                    ],
                    "target_lang_definitions": {
                        "en": "Timid, wary or reserved, and reluctant to form relationships with others.",
                        "ru": "Замкнутый, застенчивый или недоверчивый человек, не склонный к общению с другими.",
                        "de": "Eine Person, die schüchtern wirkt, sich zurückhält und ungern Kontakte zu anderen knüpft.",
                        "es": "Dicho de una persona tímida y reservada, poco dispuesta a relacionarse con los demás.",
                        "zh": "形容性格怕生、拘谨或冷淡，不愿与人交往。"
                    },
