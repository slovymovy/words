                            {
                                "target_lang_word": "полоса́",
                                "target_lang_sense_clarification": "частот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波段",
                                "target_lang_sense_clarification": "无线电频率范围"
                            },
                            {
                                "target_lang_word": "频段",
                                "target_lang_sense_clarification": "频率范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84c455e2-f42a-37fd-b049-f365fa2eb2d4",
                    "sense_definition": "A stack of cash, specifically one thousand dollars.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strip_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He saved up a whole <w>band</w> to buy his first car.",
                            "target_lang_translations": {
                                "ru": "Он накопил целый <w>кусок</w>, чтобы купить свою первую машину.",
                                "zh": "他攒了整整<w>一叠</w>钱买了第一辆车。"
                            }
                        },
                        {
                            "text": "The rapper flashed a <w>band</w> of cash in his new music video.",
                            "target_lang_translations": {
                                "ru": "Рэпер похвастался <w>пачкой</w> наличных в своем новом клипе.",
                                "zh": "这位说唱歌手在他的新音乐录影带中炫耀了一叠现金。"
                            }
