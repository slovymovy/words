                ],
                "senses": [
                    {
                        "sense_id": "a4ae6aa8-6ecb-363f-88d2-32c032965c01",
                        "entry_id": "30ace96c-6a2e-3732-9339-1482df9f5fbe",
                        "glosses": [
                            "книжн. относящийся к архитектонике, построению единого целого на основе взаимосвязи составляющих частей и элементов; структурированный, упорядоченный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5560b1ff-9af3-45e3-aa07-08afa930bd0c",
                                "sense_id": "a4ae6aa8-6ecb-363f-88d2-32c032965c01",
                                "text": "Симметрия, должно быть, казалась мне основным архитектоническим законом драмы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca59700d-2f4f-47c2-89e3-2aa798612539",
                        "source_entry_id": "30ace96c-6a2e-3732-9339-1482df9f5fbe",
                        "source_sense_id": "a4ae6aa8-6ecb-363f-88d2-32c032965c01",
                        "target_lang_word": "architectonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architectonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                        "entry_id": "be46a6f8-23f3-373f-8f57-c8ec87adff16",
                                        "glosses": [
                                            "Relating to or characteristic of architecture, design and construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a2a9af-e378-4e56-8680-22ea0954a5d8",
                                                "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                                "text": "architectonic wisdom"
                                            },
                                            {
                                                "example_id": "728052ca-1338-44ff-980e-1b9aa04a4dec",
                                                "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                                "text": "[T]he great Creator hath likevviſe ſignalized his Care and Skill, by giving Animals an architectonick Faculty, to build themſelves convenient places of Retirement, in vvhich to repoſe and ſecure themſelves, and to nurſe up their Young."
                                            },
                                            {
                                                "example_id": "365f8214-2ea9-449b-b3e7-3570b4591201",
                                                "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                                "text": "these architectonic functions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad55c9d8-50e9-364b-840c-931c01e7bf5b",
                                        "entry_id": "be46a6f8-23f3-373f-8f57-c8ec87adff16",
                                        "glosses": [
                                            "Foundational, fundamental; supporting the structure of a morality, society, or culture."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0595164a-3b7d-449c-84c1-3abacbe3681a",
                                                "sense_id": "ad55c9d8-50e9-364b-840c-931c01e7bf5b",
                                                "text": "We do not of course always, or even often, find the moral principles clearly and consciously expressed or consistently supported, but we cannot but feel that they are present in the shape of instincts, and those instincts pervading and architectonic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6bbdff-2b16-3d49-906f-e7f87ba11b38",
                                        "entry_id": "be46a6f8-23f3-373f-8f57-c8ec87adff16",
                                        "glosses": [
                                            "Relating to the scientific systematization of the totality of knowledge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "architectonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b30e2d19-5981-32e5-b501-4621b6f8a80e",
                                        "entry_id": "e5c0ad39-e652-3500-9716-4bd9c102794e",
                                        "glosses": [
                                            "The design, structure, or architecture of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da84faf9-50b8-4f3f-a8f7-b1d29701c892",
                                                "sense_id": "b30e2d19-5981-32e5-b501-4621b6f8a80e",
                                                "text": "Because the poems are an investigation into the nature of time, it is important to be aware of the overall temporal architectonic of the love-cycle."
                                            },
                                            {
                                                "example_id": "a1fdb181-d828-4d8e-8f71-5a48ba769d61",
                                                "sense_id": "b30e2d19-5981-32e5-b501-4621b6f8a80e",
                                                "text": "The question of commandeering social space and, by extension, reviving a public sphere could well be developed within the architectonic of Bakhtin's theory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "634e9434-06eb-4c85-a1d3-12223daea79d",
                        "source_entry_id": "30ace96c-6a2e-3732-9339-1482df9f5fbe",
                        "source_sense_id": "a4ae6aa8-6ecb-363f-88d2-32c032965c01",
                        "target_lang_word": "architektonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architektonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                        "entry_id": "380afd71-6b69-35ca-acec-8f2eee2d1a09",
                                        "glosses": [
                                            "die Architektur oder Architektonik betreffend, was zu ihr gehört oder auf ihr beruht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c1c861-2ee4-42b0-b9b9-7e1ad29c28c6",
                                                "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                                "text": "„Ringsum erheben sich klassizistische Straßenzüge, stuckselig und mit der architektonischen Großzügigkeit der Jahrhundertwende entworfen.“"
                                            },
                                            {
                                                "example_id": "d8515235-04be-4734-a9b6-b2fbc7a32994",
                                                "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                                "text": "„Die gegenüber einem reinen Zweckbau deutlich höheren Kosten nahm die Stiftungsuniversität für ihre architektonischen Ambitionen in Kauf, zumal auch die öffentliche Hand von dem Großvorhaben angetan war und großzügig Fördermittel bereitstellte: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d156f175-f913-41c0-a466-c69ce87542f1",
                        "source_entry_id": "30ace96c-6a2e-3732-9339-1482df9f5fbe",
                        "source_sense_id": "a4ae6aa8-6ecb-363f-88d2-32c032965c01",
                        "target_lang_word": "architektoniczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architektoniczny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "eabd5e50-6fbf-3980-b03b-b8fc3de34ba4",
                                        "entry_id": "85ed09f2-9ebd-364b-be68-2209d1eaa6d4",
                                        "glosses": [
                                            "związany z architekturą, tworzony dla / za pomocą architektury"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b439b88-136a-488e-acaf-6ea14fe415a3",
                                                "sense_id": "eabd5e50-6fbf-3980-b03b-b8fc3de34ba4",
                                                "text": "Dzisiejsze Zakopane przedstawia sobą konglomerat najrozmaitszych stylów architektonicznych – tradycyjnych i nowoczesnych, ludowych i przemysłowych"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8b42fa4-c3e6-4efc-8136-ce729b0fa6ac",
                        "source_entry_id": "30ace96c-6a2e-3732-9339-1482df9f5fbe",
                        "source_sense_id": "a4ae6aa8-6ecb-363f-88d2-32c032965c01",
                        "target_lang_word": "architectonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architectonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d55e7abc-3612-392d-a041-b91747bf3cf2",
                                        "entry_id": "5d133da3-1471-3743-96cf-9466421a5ee3",
                                        "glosses": [
                                            "Qui a rapport à l’art de la construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56dda538-ba49-4662-8aee-de3748a446e6",
                                                "sense_id": "d55e7abc-3612-392d-a041-b91747bf3cf2",
                                                "text": "L’extérieur de l’église est un singulier mélange architectonique qui tient à tous les ordres catholiques sans appartenir à aucun."
                                            },
                                            {
                                                "example_id": "8b41aff2-aa76-4da5-8fb7-e1c73eb2048e",
                                                "sense_id": "d55e7abc-3612-392d-a041-b91747bf3cf2",
                                                "text": "[Des ossuaires bretons] Trois s’écartent de la conception architectonique qui les caractérise : à Lampaul-Guimiliau et à Saint-Thégonnec ils ont une abside polygonale, à Kermoroch (C. du N.) elle est octogonale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "797cf96e-9a6a-3f2d-badc-044024006ec8",
                                        "entry_id": "5d133da3-1471-3743-96cf-9466421a5ee3",
                                        "glosses": [
                                            "Méthode qui coordonne les diverses parties d’un système."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "architectonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c153a5d5-ed7d-30f1-9471-4111ec31580a",
                                        "entry_id": "51fd6290-5d86-3651-8a48-b37dd0c26a8f",
                                        "glosses": [
                                            "Synonyme d’architecture."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2aec576-4dbe-45b2-a324-6ecd2c254b02",
                                                "sense_id": "c153a5d5-ed7d-30f1-9471-4111ec31580a",
                                                "text": "Enseigner l’architectonique"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507ca630-2291-31ce-9131-90bba6f93a42",
                                        "entry_id": "51fd6290-5d86-3651-8a48-b37dd0c26a8f",
                                        "glosses": [
                                            "Art de la construction systématique, construction ainsi structurée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a3e8b0-23fc-4fa1-8f6e-fd12ece93c2f",
                                                "sense_id": "507ca630-2291-31ce-9131-90bba6f93a42",
                                                "text": "Par architectonique, j’entends l’art des systèmes. […] L’architectonique est ce qu’il y a de scientifique dans notre connaissance en général."
                                            }
                                        ]
                                    }
