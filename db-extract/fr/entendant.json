                        "examples": [
                            {
                                "example_id": "ef7bc88c-483b-4a88-b040-59730892fb93",
                                "sense_id": "2c088aad-b5cf-3590-9ef9-392d86da06f3",
                                "text": "En entendant cette horrible phrase, Pons se redressa comme si la décharge de quelque pile galvanique l’eût atteint, salua froidement sa cousine et alla reprendre son spencer."
                            },
                            {
                                "example_id": "4a38209c-310b-4678-b99b-44c634be53b1",
                                "sense_id": "2c088aad-b5cf-3590-9ef9-392d86da06f3",
                                "text": "Oui, je lui voudrais une femme qui l’influençât, il ne m’échapperait pas ; il m’échappe quelquefois, et cela se conçoit : je ne le tiens que par sa raison ; en m’entendant avec une jolie femme, je le tiendrais par sa folie, et c’est plus fort."
                            }
                        ]
                    }
