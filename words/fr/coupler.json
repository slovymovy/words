                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hôpital a choisi de <w>coupler</w> la chimiothérapie avec un suivi nutritionnel strict."
                        },
                        {
                            "text": "Cette nouvelle stratégie commerciale est <w>couplée</w> à une campagne publicitaire sur les réseaux."
                        }
                    ],
                    "synonyms": [
