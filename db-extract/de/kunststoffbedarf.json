                "senses": [
                    {
                        "sense_id": "38cdcdfb-f78c-388d-8bf7-2526b6227b1b",
                        "entry_id": "2b5bd6f3-068e-3ad1-9172-23798b329825",
                        "glosses": [
                            "Nachfrage nach dem Material Kunststoff (meist als Rohstoff zur Produktion)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc8bdd2-e548-4463-bdba-72b3f27297de",
                                "sense_id": "38cdcdfb-f78c-388d-8bf7-2526b6227b1b",
                                "text": "„Der weltweite Kunststoffbedarf soll sich Prognosen zufolge bis 2015 um durchschnittlich 4,7 % pro Jahr auf 277 Mio. t erhöhen.“"
                            },
                            {
                                "example_id": "436f800b-1d15-4ffd-b21b-016352c7d5ca",
                                "sense_id": "38cdcdfb-f78c-388d-8bf7-2526b6227b1b",
                                "text": "„Denn vor allem in den Schwellenländern und Osteuropa mit einem überdurchschnittlich wachsenden Kunststoffbedarf eröffnet sich ein attraktives Absatzpotenzial für Kunststoffprodukte.“"
                            },
                            {
                                "example_id": "4378bc12-245d-4212-93ac-333b10146ef8",
                                "sense_id": "38cdcdfb-f78c-388d-8bf7-2526b6227b1b",
                                "text": "„Der steigende Bedarf an Primärkunststoffen trifft auf veraltete Produktionswerke der Kunststofferzeuger in Europa. Die entsprechenden Konzerne investieren in erster Linie in den Wachstumsmärkten, wo der Kunststoffbedarf noch stärker steigt.“"
                            },
                            {
                                "example_id": "683e0120-b75d-435f-b397-fdf8b4365807",
                                "sense_id": "38cdcdfb-f78c-388d-8bf7-2526b6227b1b",
                                "text": "„Durch eine Produktionsumstellung der Polyethylen (PE)-Flaschen konnte der Kunststoffbedarf und somit der Verbrauch an Rohstoffen deutlich reduziert werden.“"
                            },
                            {
                                "example_id": "34e54324-6b2c-4087-9092-5fd06d06900d",
                                "sense_id": "38cdcdfb-f78c-388d-8bf7-2526b6227b1b",
                                "text": "„Die flexible Verpackung enthält 20 Prozent Kreideanteil bei minimalem Kunststoffbedarf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
