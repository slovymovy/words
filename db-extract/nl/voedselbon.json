                "senses": [
                    {
                        "sense_id": "eda3903f-f979-3d05-a470-4ee94e6015d2",
                        "entry_id": "4401fb8b-8fdc-3a0d-a325-f1a7215562e4",
                        "glosses": [
                            "een waardebon die recht geeft op een (gratis) bepaalde hoeveelheid voeding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ffcd276-1f9d-4299-ab8f-e548a1a7f4be",
                                "sense_id": "eda3903f-f979-3d05-a470-4ee94e6015d2",
                                "text": "In de Bengalese plaats Chittagong zijn zeker tien mensen doodgedrukt en meer dan vijftig gewonden gevallen. Dat gebeurde volgens de plaatselijke politie toen een gebedsbijeenkomst waarbij gratis voedselbonnen werden uitgedeeld compleet uit de hand liep."
                            },
                            {
                                "example_id": "fa7971ec-cf68-4ae7-8b3a-3674e2a3e0ac",
                                "sense_id": "eda3903f-f979-3d05-a470-4ee94e6015d2",
                                "text": "Ruim 200.000 mensen zijn geholpen met een voedselpakket of voedselbonnen, 76.000 ondervoede kinderen kregen pindapasta als bijvoeding om aan te sterken. Miljoenen liters water werden uitgedeeld en werden er 121 waterbronnen gebouwd of hersteld."
                            }
                        ]
                    },
                    {
                        "sense_id": "18a521e9-8048-3f1a-8a41-611a13287db2",
                        "entry_id": "4401fb8b-8fdc-3a0d-a325-f1a7215562e4",
                        "glosses": [
                            "een bon die het recht geeft om een bepaalde hoeveelheid voeding te kopen, m.n. gebruikelijk in de Tweede Wereldoorlog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7eecc4c-bb5d-49e3-86cd-a725c554e197",
                                "sense_id": "18a521e9-8048-3f1a-8a41-611a13287db2",
                                "text": "Een interessant nieuw aanknopingspunt bood het dagboek van Anne Frank. „In maart 1944 schreef ze herhaaldelijk over de arrestatie van twee handelaren in distributiebonnen. Ze noemt hen B en D (Martin Brouwer en Pieter Daatzelaar van de firma Gies & Co.) Dit bedrijf was gelieerd aan Otto Franks (de vader van Anne) bedrijf Opekta en in hetzelfde pand gevestigd. De twee werden gearresteerd voor illegale handel in voedselbonnen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02b31a6c-e498-478d-9cba-81b430ba6ae8",
                        "source_entry_id": "4401fb8b-8fdc-3a0d-a325-f1a7215562e4",
                        "source_sense_id": "eda3903f-f979-3d05-a470-4ee94e6015d2",
                        "target_lang_word": "food stamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "food stamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "804a7d0d-fff3-3ff1-95b2-42b68602edd2",
                                        "entry_id": "3060fa43-9e6c-388f-b221-eb92e00b6456",
                                        "glosses": [
                                            "A stamp or similar paper document (e.g. coupon) issued to be exchanged in shops or storage facilities for food, or (by extension) for other essential provisions, notably in a rationing system or as a non-financial form of welfare benefit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c547721-7923-4902-92ce-a1ad02182290",
                                                "sense_id": "804a7d0d-fff3-3ff1-95b2-42b68602edd2",
                                                "text": "The authorities claim they turned from unemployment checks to food stamps to avoid alcoholics wasting their families' allowances in pubs."
                                            },
                                            {
                                                "example_id": "e74d504c-e319-4908-b29f-fa21d8ca018c",
                                                "sense_id": "804a7d0d-fff3-3ff1-95b2-42b68602edd2",
                                                "text": "The bill extends Trump’s 2017 tax cuts and includes new spending for border security and the military. Republicans aimed to offset these costs with cuts to programmmes^([sic]) such as Medicaid, food stamps and green-energy tax credits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
