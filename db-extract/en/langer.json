                "senses": [
                    {
                        "sense_id": "5527e49b-9b9c-3183-8516-08f66ff5478f",
                        "entry_id": "8f0e49b2-9a75-3529-8800-9a4fb71c91b2",
                        "glosses": [
                            "Fool; idiot; annoying or contemptible person (usually male)."
                        ],
                        "tags": [
                            "Ireland",
                            "derogatory",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e9be25f3-7ac1-3cf6-8ea6-85ec0efb9a80",
                        "entry_id": "8f0e49b2-9a75-3529-8800-9a4fb71c91b2",
                        "glosses": [
                            "An annoying person."
                        ],
                        "tags": [
                            "Ireland",
                            "derogatory",
                            "offensive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2b00df04-28cd-4ca5-9405-aa6231db6258",
                                "sense_id": "e9be25f3-7ac1-3cf6-8ea6-85ec0efb9a80",
                                "text": "\"Give it up will ya! get a job, ja langer!\""
                            },
                            {
                                "example_id": "bf12c81f-d96f-4064-90d7-7f3579b09a01",
                                "sense_id": "e9be25f3-7ac1-3cf6-8ea6-85ec0efb9a80",
                                "text": "And central to it all is wind-up, making a langer out of people, to use that now unfortunate word that can still only be used correctly and said correctly by Cork people, even though the rest of the country has taken to it with gusto, embarrassing themselves like white people trying to talk black slang to be \"street\"."
                            },
                            {
                                "example_id": "212d80fa-d3a3-410e-a502-aad8bf7782d2",
                                "sense_id": "e9be25f3-7ac1-3cf6-8ea6-85ec0efb9a80",
                                "text": "Langers boy, every wan of ‘em. Golfers are only langers. They’re only golfing cos they can’t hurl. Anyone that golfs in Cork is only a failed hurler and a langer, boy."
                            }
                        ]
                    },
                    {
                        "sense_id": "97f9496b-a95a-3b35-b75a-e6899f23d683",
                        "entry_id": "8f0e49b2-9a75-3529-8800-9a4fb71c91b2",
                        "glosses": [
                            "Penis."
                        ],
                        "tags": [
                            "Ireland",
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "f7fac1a5-e9b5-47d0-b321-ff18194bc66a",
                                "sense_id": "97f9496b-a95a-3b35-b75a-e6899f23d683",
                                "text": "Mike opened his knees wide, so that his langer would be framed by the gap between his legs. For first impressions a boner would have been good, but not likely."
                            },
                            {
                                "example_id": "aabb8789-a8a7-430f-a143-902f58384bd2",
                                "sense_id": "97f9496b-a95a-3b35-b75a-e6899f23d683",
                                "text": "He showed me a photograph. There was a woman and a man doing something, but I wasn't sure what. The man was standing over the woman holding his langer (the Cork word) and she was looking up at him smiling. I felt ill and started to walk backwards."
                            }
                        ]
                    }
