                    },
                    {
                        "translation_id": "85d3153c-c8fa-4d73-8f6b-f48a3e478d1d",
                        "source_entry_id": "acf69ad3-9047-3967-8535-627e166bc03b",
                        "source_sense_id": "9d84a026-1aa3-37ce-ae5b-170d8bc882b9",
                        "source_sense_description": "iemand die anderen stimuleert om bepaalde dingen te gaan doen",
                        "target_lang_word": "founder",
