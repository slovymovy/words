                                        "sense_id": "ac6fdbe8-aef4-3748-adf1-aa7d6958854e",
                                        "entry_id": "34af9d17-55e8-3418-850d-0b1a34d56413",
                                        "glosses": [
                                            "Résultat de cet examen sérologique, classement selon les caractéristiques du sérum."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
