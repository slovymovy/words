                        "examples": [
                            {
                                "example_id": "07b8ffbf-3186-46b8-9144-6a96d305ad1a",
                                "sense_id": "1378062b-d946-3b35-b9c2-9ca233e7ed65",
                                "text": "Sylvia Barlag, Nederlandse bestuurslid van de IAAF, was helemaal niet verrast dat het bestuur van de internationale atletiekfederatie in Wenen besloot de uitsluiting van de Russische atletieksport te handhaven. Zij constateerde tevreden dat het een unaniem besluit was. \"Unaniem is unaniem\", zei ze over de saamhorigheid binnen het bestuur."
                            },
                            {
                                "example_id": "f9e02e5f-fdee-420c-9ec5-4dbdc6a5c040",
                                "sense_id": "1378062b-d946-3b35-b9c2-9ca233e7ed65",
                                "text": "Het Nederlandse bestuurslid van de internationale atletiekfederatie IAAF, Sylvia Barlag, heeft bij de FBK Games laten weten dat Rusland nog altijd geen haast maakt met opschonen van de eigen door dopingschandalen besmette atletieksport. \"Ik heb het gevoel dat ze niet goed gebruik maken van de tijd\", aldus Barlag."
                            }
                        ]
                    }
