        "fr-extract.jsonl": [
            {
                "entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                "word": "accotoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "257dcc5d-a501-445e-a226-08509b11fb33",
                        "entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                        "tags": [
                            "plural"
                        ],
                        "form": "accotoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                        "entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                        "glosses": [
                            "ou Ce qui sert à s’accoter, appuis pour les bras disposés sur les côtés d'un siège, communément appelés accoudoirs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6da74146-81e0-4afe-abd7-71780d2d46ad",
                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                "text": "Les accotoirs d’un fauteuil, d’un confessionnal."
                            },
                            {
                                "example_id": "2de0599c-9556-4109-bad3-65c9cfcebfb5",
                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                "text": "Cela vous servira d’accotoir."
                            },
                            {
                                "example_id": "9b979aa9-f00b-4164-9e8c-f8930dbea88f",
                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                "text": "Le dossier du fauteuil se redresse, sur lequel se rattache perpendiculairement l'accotoir."
                            },
                            {
                                "example_id": "257562b4-1e23-4bdc-8f89-3cc3f3be2805",
                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                "text": "L’Américaine se couchait sur le tapis, démolissant les coussins, les attirant sous elle, en calant son dos et ses bras, cherchant longuement et presque voluptueusement un paresseux allongement appuyé à de mollets accotoirs ; puis la Tompkins allumait une cigarette."
                            }
                        ]
                    },
                    {
                        "sense_id": "9579733c-9d50-35bf-999b-17a3af6cb392",
                        "entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                        "glosses": [
                            "Tout objet qui sert à s'accoter ou à accoter quelque chose."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "76b0bc0f-6b6c-3cd2-a057-673848b7d857",
                        "entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                        "glosses": [
                            "Morceaux de marbre que l'on scelle le long d'une tranche avant d'en faire la taille."
                        ],
                        "tags": [
                            "Marbrerie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b319f5c5-ca24-492d-917a-cb82e3d276cb",
                        "source_entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                        "target_lang_word": "Armlehne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armlehne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                        "entry_id": "f535a232-31c0-31dc-8b42-445dc2afb2b0",
                                        "glosses": [
                                            "Ablagefläche am linken und rechten Rand eines Stuhles, Sessels oder Ähnlichem, die zum Abstützen der Arme dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310164c1-1ca4-4949-950b-8eacb957e5b9",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Die Mittelkonsole wurde überarbeitet und eine elektrische Parkbremse schafft Platz für eine neue Armlehne mit Stauraum.“"
                                            },
                                            {
                                                "example_id": "16d96abe-b363-477d-b7bf-cc07f3ab4e9c",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Gabi setzt sich neben mich auf die Armlehne und schaut mich an.“"
                                            },
                                            {
                                                "example_id": "ef5a9368-009f-4454-9fb9-ab3a2b073e8a",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Er fegt meine Jacke vom benachbarten Stuhl, setzt sich hin und nimmt sofort die Armlehne in Beschlag.“"
                                            },
                                            {
                                                "example_id": "dbd41bfc-8ef1-44ee-abb4-37a853698c8a",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Seine Frau kam um die Sitzgruppe herum und setzte sich zu ihrem Mann auf die Armlehne seines Sessels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c745bcc2-f7ca-45df-ad36-f6b3ade0f5ed",
                        "source_entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
