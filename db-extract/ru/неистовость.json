                "senses": [
                    {
                        "sense_id": "1e937827-b3ea-39bf-a9ca-a8132618fb48",
                        "entry_id": "f1755f9b-b5f8-3951-b8f0-32e622cbf437",
                        "glosses": [
                            "свойство по значению прилагательного неистовый"
                        ],
