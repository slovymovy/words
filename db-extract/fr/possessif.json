                            {
                                "example_id": "f9d855f5-f22a-4f12-a9f5-5304b408a8b0",
                                "sense_id": "b13cdc65-82eb-3b38-a34c-cca9f26496c2",
                                "text": "Mon, ton, son, nos, vos, leurs sont des déterminants (ou adjectifs) possessifs."
                            },
                            {
                                "example_id": "d86bd3f1-2c37-4d47-b035-e6f72d1d1273",
                                "sense_id": "b13cdc65-82eb-3b38-a34c-cca9f26496c2",
                                "text": "Le mien, la mienne, les nôtres sont des pronoms possessifs."
                            }
