                "senses": [
                    {
                        "sense_id": "fb73104e-d55f-30b3-8b18-8f6903bbf8fc",
                        "entry_id": "29529c01-d5c0-39e9-941e-d2a168e340d2",
                        "glosses": [
                            "хим. продукт дистилляции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f04457-a99a-4363-87ac-c4600316bcef",
                                "sense_id": "fb73104e-d55f-30b3-8b18-8f6903bbf8fc",
                                "text": "Лёгкий нефтяной дистиллят."
                            },
                            {
                                "example_id": "aa1e8115-2b2c-4fd9-8d69-1214bafc4886",
                                "sense_id": "fb73104e-d55f-30b3-8b18-8f6903bbf8fc",
                                "text": "Парафиновый дистиллят."
                            },
                            {
                                "example_id": "ac3c2929-1626-4505-aa47-7f86b852b35c",
                                "sense_id": "fb73104e-d55f-30b3-8b18-8f6903bbf8fc",
                                "text": "Содержимое колбы медленно кипятят на колбонагревателе или электроплитке, собирая дистиллят в приёмник — круглодонную колбу для отгонки фтора в интервале температур 130–135 °C."
                            },
                            {
                                "example_id": "612d003f-bdeb-4e9e-b517-ea6655369ba1",
                                "sense_id": "fb73104e-d55f-30b3-8b18-8f6903bbf8fc",
                                "text": "В тех странах, где принято пить напитки, полученные путём обычной дистилляции, — это не только коньяк и виски, но и все бренди (виноградные, плодовые и ягодные), а также виноградные дистилляты типа граппы, чачи и т. д., алкоголизм встречается реже."
                            }
                        ]
                    }
