                "entry_id": "117bcd1d-5134-3ddf-8599-72e2582d247b",
                "word": "cognomen",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "89ed9648-8480-4b43-8acf-b5e0523146cc",
                        "entry_id": "117bcd1d-5134-3ddf-8599-72e2582d247b",
                        "tags": [
