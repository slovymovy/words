            {
                "entry_id": "9bd58869-b475-3328-b32d-60d2f123a4aa",
                "word": "fiu",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "335611ca-684f-323b-b67d-772e339c95bb",
                        "entry_id": "9bd58869-b475-3328-b32d-60d2f123a4aa",
                        "glosses": [
                            "Relatif à ce sentiment de fiu et à ses réactions."
                        ],
                        "tags": [
                            "Polynésie française"
                        ],
                        "examples": [
                            {
                                "example_id": "97cea68f-0a76-4525-8768-35ba9b6bb57a",
                                "sense_id": "335611ca-684f-323b-b67d-772e339c95bb",
                                "text": "Les secrétaires de la haute-administration qui sont loin d’être écroulées sous le travail, non pas parce que leurs chefs sont exigeants mais tout simplement parce qu’elles sont \"fiu\" (=lasse), un argument auquel les supérieurs hiérarchiques sont sensibles."
                            },
                            {
                                "example_id": "daeca89d-af4a-4946-837d-25a8bfc628d9",
                                "sense_id": "335611ca-684f-323b-b67d-772e339c95bb",
                                "text": "Les foyers sont fiu d’avoir de l’eau chocolatée au robinet."
                            },
                            {
                                "example_id": "2a6cdb6c-cf63-4641-9557-d01466ec5bf0",
                                "sense_id": "335611ca-684f-323b-b67d-772e339c95bb",
                                "text": "Si le maçon est fiu, il s’arrêtera de travailler pour quelques jours ou pour plusieurs semaines."
                            }
                        ]
                    }
                ],
