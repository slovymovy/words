                        "examples": [
                            {
                                "example_id": "a7b22a39-bb69-4d04-b522-bd1eef686cce",
                                "sense_id": "ca812f24-310b-3f90-83b0-a9b80a735111",
                                "text": "De bondsvergadering van de KNVB heeft dinsdag ingestemd met de voetbalpiramide, die vanaf het seizoen 2016/2017 middels de herinvoering van de tweede divisie voor een betere doorstroming moet zorgen tussen het betaald en het amateurvoetbal."
                            },
                            {
                                "example_id": "b05265de-549d-48fa-835f-8ad1e8ae4d65",
                                "sense_id": "ca812f24-310b-3f90-83b0-a9b80a735111",
                                "text": "Bert van Oostveen, directeur betaald voetbal van de KNVB, noemde dinsdagavond in Zeist het besluit van de Bondsvergadering van de voetbalbond om in te stemmen met de nieuw te vormen voetbalpiramide \"historisch\"."
                            }
                        ]
                    },
