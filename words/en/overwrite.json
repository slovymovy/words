{
    "word_family": [
        "writer",
        "writing",
        "written",
        "wrote"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0118cd12-8e91-3602-bc32-803a1f5e409f",
                    "sense_definition": "To replace existing data with new data in a computer file or storage medium.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "data_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system will <w>overwrite</w> your previous save file if you continue.",
                            "target_lang_translations": {
                                "zh": "如果你继续，系统将会<w>覆盖</w>你之前的存档文件。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>overwrite</w> the original document when saving your changes.",
                            "target_lang_translations": {
                                "zh": "保存更改时，请小心不要<w>覆盖</w>原始文档。"
                            }
                        }
                    ],
                    "synonyms": [
                        "replace",
                        "supersede"
                    ],
                    "common_phrases": [
                        "overwrite data",
                        "overwrite file"
                    ],
                    "target_lang_definitions": {
                        "zh": "在计算机文件或存储介质中用新数据替换现有数据。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "覆盖",
                                "target_lang_sense_clarification": "指用新内容替换旧内容，常用于计算机数据处理。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "026ff8c7-a583-3568-85fc-06e599d06c12",
                    "sense_definition": "To write more than is necessary or appropriate for a given context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students often <w>overwrite</w> their essays, adding unnecessary details that distract from the main point.",
                            "target_lang_translations": {
                                "zh": "学生们经常把文章<w>写得冗长</w>，添加了许多分散主旨的不必要细节。"
                            }
                        },
                        {
                            "text": "The author tends to <w>overwrite</w>, making the plot feel slow and repetitive.",
                            "target_lang_translations": {
                                "zh": "这位作者倾向于<w>写得冗长</w>，导致情节显得拖沓且重复。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "写作时内容冗长，超出了必要的范围。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "写得冗长",
                                "target_lang_sense_clarification": "指写作内容过多、不精炼。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9aa9113-7b96-31b0-ad7a-1be0fe6102bd",
                    "sense_definition": "To write in an overly complex, flowery, or excessively descriptive style.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "writing_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics felt the novel was <w>overwritten</w> and lacked a clear narrative voice.",
                            "target_lang_translations": {
                                "zh": "评论家认为这部小说<w>辞藻堆砌</w>，缺乏清晰的叙事风格。"
                            }
                        },
                        {
                            "text": "He tends to <w>overwrite</w> his descriptions, using too many adjectives and metaphors.",
                            "target_lang_translations": {
                                "zh": "他倾向于<w>辞藻堆砌</w>，使用了太多的形容词和隐喻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "embellish"
                    ],
                    "target_lang_definitions": {
                        "zh": "写作风格过于复杂、华丽或描述过度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辞藻堆砌",
                                "target_lang_sense_clarification": "指文章修饰过度，显得不自然。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "642278bf-aee8-3d16-916c-40c0b3791d21",
                    "sense_definition": "To write something on top of existing text or a surface.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "writing_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child tried to <w>overwrite</w> the faint pencil marks with a dark marker.",
                            "target_lang_translations": {
                                "zh": "孩子试图用深色记号笔在模糊的铅笔痕迹上<w>重写</w>。"
                            }
                        },
                        {
                            "text": "Do not <w>overwrite</w> the notes written in the margins of the book.",
                            "target_lang_translations": {
                                "zh": "不要在书页边缘的笔记上<w>重写</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在现有文字或表面上书写。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重写",
                                "target_lang_sense_clarification": "指在原有字迹上再次书写。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26c948a9-3708-3d3f-b736-b1a6632d7677",
                    "sense_definition": "The process of replacing old data with new data.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "data_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software performs an <w>overwrite</w> of the temporary files every hour.",
                            "target_lang_translations": {
                                "zh": "该软件每小时会对临时文件执行一次<w>覆盖</w>。"
                            }
                        },
                        {
                            "text": "An accidental <w>overwrite</w> caused the loss of all my unsaved work.",
                            "target_lang_translations": {
                                "zh": "一次意外的<w>覆盖</w>导致我所有未保存的工作丢失了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "data overwrite"
                    ],
                    "target_lang_definitions": {
                        "zh": "用新数据替换旧数据的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "覆盖",
                                "target_lang_sense_clarification": "指数据替换的操作过程。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}