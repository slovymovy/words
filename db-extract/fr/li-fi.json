                    },
                    {
                        "translation_id": "c55dbe02-b71c-4851-88be-d0f46721460a",
                        "source_entry_id": "22bdcf78-f169-3585-8118-ae545ea5e851",
                        "source_sense_id": "b0675572-d19b-3f59-90cf-e79f202642b7",
                        "target_lang_word": "OWS",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "OWS",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27845f17-fa36-3de6-a88d-646c182b0420",
                                        "entry_id": "178f42f9-1178-3cb7-a5bf-4e9d692d0dbf",
                                        "glosses": [
                                            "Initialism of Occupy Wall Street: a protest movement that began in 2011 in New York City's Wall Street financial district, primarily opposing social and economic inequality, greed, corruption and the influence of corporations on government."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8911be58-1839-45c6-b9c4-d54690a55840",
                                                "sense_id": "27845f17-fa36-3de6-a88d-646c182b0420",
                                                "text": "In one of the OWS emails, liberal writer Matt Taibbi encouraged protesters to come up with some demands."
                                            },
                                            {
                                                "example_id": "309d99e9-fcc3-451f-bc4e-14fc2a2863a7",
                                                "sense_id": "27845f17-fa36-3de6-a88d-646c182b0420",
                                                "text": "OWS has contributed more to our politics than anything else in the last 40 years. Americans are becoming aware of just how unequal and undemocratic this country is and for that OWS has to be shut up."
                                            },
                                            {
                                                "example_id": "cc19c4ad-6fd9-4ea6-aecc-146df9d12e87",
                                                "sense_id": "27845f17-fa36-3de6-a88d-646c182b0420",
                                                "text": "This debate was important because the OWS Antiwar Working Group brought it up when acknowledging a similar conversation[…]"
                                            },
                                            {
                                                "example_id": "59b656ec-8a43-418a-9ade-f59e12eb30c7",
                                                "sense_id": "27845f17-fa36-3de6-a88d-646c182b0420",
                                                "text": "An OWS afternoon march ends not at Wall Street but at a rally by postal workers protesting against a five-day delivery week."
                                            },
                                            {
                                                "example_id": "3814190c-279b-443b-875b-362fd6242f82",
                                                "sense_id": "27845f17-fa36-3de6-a88d-646c182b0420",
                                                "text": "The OWS movement splintered after Mayor Michael Bloomberg had police raid Zuccotti Park and it has been unable to articulate a clear message since."
                                            },
                                            {
                                                "example_id": "2e010df5-f612-48b3-8925-b3c7191f2f89",
                                                "sense_id": "27845f17-fa36-3de6-a88d-646c182b0420",
                                                "text": "My boss had me meet her husband, an anthropologist, at a Korean restaurant to explain OWS. I couldn't get over the strangeness of needing to get someone to explain something happening in the open just down the street."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
