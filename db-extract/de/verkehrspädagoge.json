                "senses": [
                    {
                        "sense_id": "0aae6b80-314f-34c8-8103-6edcee2e53b9",
                        "entry_id": "0ab01915-ff18-350f-9db3-7bcd0de3a62c",
                        "glosses": [
                            "Person, die beruflich in Forschung und Lehre im akademischen Bildungsbereich Verkehrspädagogik tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec28578a-ad95-49d9-aac5-654148b72698",
                                "sense_id": "0aae6b80-314f-34c8-8103-6edcee2e53b9",
                                "text": "„Ein von Verkehrspädagogen und -psychologen betreuter Durchgang dauert etwa 1,5 Stunden.“"
                            },
                            {
                                "example_id": "bc39e45c-b3cb-433f-bc96-8779250ea735",
                                "sense_id": "0aae6b80-314f-34c8-8103-6edcee2e53b9",
                                "text": "„Das fordern die Verkehrspädagogen Bongard und Winterfeld von der Pädagogischen Hochschule Berlin, die jetzt im Auftrag des Bundesverkehrsministeriums das Verkehrswissen und das Verkehrsverständnis von fünf- und sechsjährigen Kindern vor deren Schuleintritt untersuchten.“"
                            },
                            {
                                "example_id": "a323ebf2-dcae-4ebc-9210-327fbb310450",
                                "sense_id": "0aae6b80-314f-34c8-8103-6edcee2e53b9",
                                "text": "„Der Verkehrspädagoge Wolfgang Stern ergänzte, dass mangelnde Fahrpraxis und die fehlende Beherrschung der Maschine Probleme darstellten, die durch Trainings behoben werden könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1f9c0e23-ba5a-3026-af1a-ca31c2d97fb6",
                        "entry_id": "0ab01915-ff18-350f-9db3-7bcd0de3a62c",
                        "glosses": [
                            "Person, die sich (beruflich) als Verkehrserzieher im praktischen Lehrbetrieb betätigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3fd2f87-67de-4332-969f-19f95258127b",
                                "sense_id": "1f9c0e23-ba5a-3026-af1a-ca31c2d97fb6",
                                "text": "„Schon in Kitas und Schulen soll durch Verkehrspädagogen ‚eine Saat‘ für verantwortungsbewußtes Verhalten im Verkehr gelegt, die Problemgruppe der jungen Erwachsenen im Alter von 18 bis 25 Jahren, die die meisten Unfälle verursachen, sollen in ihrer eigenen Sprache angesprochen werden.“"
                            },
                            {
                                "example_id": "22746320-cbd1-4294-a36f-29d4d8516fcb",
                                "sense_id": "1f9c0e23-ba5a-3026-af1a-ca31c2d97fb6",
                                "text": "„So sehr den Verkehrspädagogen Erfolg zu wünschen wäre – die vielfältigen Anreize zum Übertreten der Verkehrsregeln sind offenbar stärker.“"
                            },
                            {
                                "example_id": "d5f3083b-e705-4f1f-8742-269847ac634f",
                                "sense_id": "1f9c0e23-ba5a-3026-af1a-ca31c2d97fb6",
                                "text": "„Angehende Verkehrspädagogen sind schon auf der Schulbank umworben.“"
                            },
                            {
                                "example_id": "609a2df2-fe75-48ff-a235-a8f88628e8e1",
                                "sense_id": "1f9c0e23-ba5a-3026-af1a-ca31c2d97fb6",
                                "text": "„Deshalb besteht seit Herbst 2014 für die erfolgreichen Absolventen der vorgesehenen Ausbildungskriterien die Möglichkeit, mit den jeweiligen Verbandsprüfungen abzuschließen und die Berechtigung zur Bezeichnung \"Geprüfter Verkehrspädagoge / MPU-Berater (DVPK) bzw. \"Geprüfter Kraftfahreignungsberater (DVPK)\" (Deutscher Verband der Psychologen und Kraftfahreignungsberater e.V.)“"
                            },
                            {
                                "example_id": "de89fc58-2373-4800-b84c-ccbb3fd75f51",
                                "sense_id": "1f9c0e23-ba5a-3026-af1a-ca31c2d97fb6",
                                "text": "„Alexander K. ist seit 1992 Fahrlehrer und Verkehrspädagoge. Sein Fachwissen gibt er mit einem großen Maß an Kompetenz an seine Kursteilnehmer weiter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
