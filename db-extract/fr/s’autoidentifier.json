                "senses": [
                    {
                        "sense_id": "0d4ec35f-6965-3f7d-9680-994f0dcd482f",
                        "entry_id": "1714fb9e-26e7-3d4d-a40a-8ec40581aaea",
                        "glosses": [
                            "S’identifier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0655a4-6cff-439c-bd2c-c428127478a2",
                                "sense_id": "0d4ec35f-6965-3f7d-9680-994f0dcd482f",
                                "text": "Le représentant d’un trilinguisme en exercice, George Steiner est embarrassé de s’autoidentifier Anglais, Français ou Allemand, étant le descendant d'une famille mixte, les trois langues ont été acquises par lui dans son enfance précoce."
                            },
                            {
                                "example_id": "db0e4814-0089-4862-b2a1-42b683ec7835",
                                "sense_id": "0d4ec35f-6965-3f7d-9680-994f0dcd482f",
                                "text": "À l’heure actuelle, les candidates et candidats à un poste sont invités à s’autoidentifier sur la formule de demande puis, si le gestionnaire décide d’utiliser l’« EE comme critère de placement », ils doivent s’autoidentifier de nouveau."
                            },
                            {
                                "example_id": "8b057027-0757-4afe-bf7f-75426a7b9375",
                                "sense_id": "0d4ec35f-6965-3f7d-9680-994f0dcd482f",
                                "text": "Les clients souhaitant bénéficier des services de nos bureaux doivent s'autoidentifier comme étant des personnes vivant avec une incapacité."
                            }
                        ]
                    },
