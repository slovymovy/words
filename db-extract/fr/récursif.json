                    },
                    {
                        "form_id": "9fee61c9-cd31-4ae8-8464-59aeddabeae5",
                        "entry_id": "b6f81d01-dd3d-3de4-93e6-496936d35424",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "récursives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "520cb04b-2406-334e-a49d-0725420c38db",
                        "entry_id": "b6f81d01-dd3d-3de4-93e6-496936d35424",
                        "glosses": [
                            "Qui se définit en s’utilisant soi-même, directement ou indirectement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a05ec81-e3ff-453c-8bd3-588e552313b9",
                                "sense_id": "520cb04b-2406-334e-a49d-0725420c38db",
                                "text": "On peut définir la fonction factorielle de manière récursive."
                            },
                            {
                                "example_id": "93e42b29-f942-417b-bd01-f6b2c12232f5",
                                "sense_id": "520cb04b-2406-334e-a49d-0725420c38db",
                                "text": "Fonctions et relations récursives s'obtiennent en passant aux fonctions partielles et ajoutant la minimisation non bornée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e87ce36a-b9ee-4ed2-a44d-2698011b3757",
                        "source_entry_id": "b6f81d01-dd3d-3de4-93e6-496936d35424",
                        "source_sense_id": "520cb04b-2406-334e-a49d-0725420c38db",
                        "target_lang_word": "rekursiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rekursiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a09b569-7bb7-317c-bacf-c8618505e290",
                                        "entry_id": "066e8a1f-f9be-33c0-99db-e49566d13c2c",
                                        "glosses": [
                                            "durch sich selbst definierend, sich selbst aufrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38be59c9-cbd1-4188-8096-c85a304ba384",
                                                "sense_id": "9a09b569-7bb7-317c-bacf-c8618505e290",
                                                "text": "Die Fakultätsfunktion wird gern als Paradebeispiel für eine rekursiv implementierte Funktion in den Vorlesungen vorgestellt."
                                            },
                                            {
                                                "example_id": "2ea1e0f4-ef0b-48d3-ace7-4d833dd6a358",
                                                "sense_id": "9a09b569-7bb7-317c-bacf-c8618505e290",
                                                "text": "Bei Linux-Befehlen, die rekursiv arbeiten, werden auch alle Unterverzeichnisse durchlaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dab028b3-5d62-3f23-acee-59a1af265c59",
                                        "entry_id": "066e8a1f-f9be-33c0-99db-e49566d13c2c",
                                        "glosses": [
                                            "mehrfaches Auftreten gleicher Sprachformen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7583eff-b28c-42b1-a8a0-06dcd1dd6370",
                                                "sense_id": "dab028b3-5d62-3f23-acee-59a1af265c59",
                                                "text": "In einem Satz wie „Das schöne, sonnige, windige … Wetter gefällt mir“ liegt eine rekursive Struktur der Adjektive vor, die darin besteht, dass man hier (theoretisch nach Belieben) gleichgeordnete Adjektive aneinanderreihen kann."
                                            },
                                            {
                                                "example_id": "159aa243-11be-4d44-8b8f-de3685200496",
                                                "sense_id": "dab028b3-5d62-3f23-acee-59a1af265c59",
                                                "text": "Eine ähnliche rekursive Struktur kommt in der Wortbildung vor: „Ururur…oma“, „vorvorvor…gestern“ und viele andere mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1edbd0d2-7506-3e84-afb9-a647e3df8dcc",
                                        "entry_id": "066e8a1f-f9be-33c0-99db-e49566d13c2c",
                                        "glosses": [
                                            "Informatik, formale Sprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb2b5cb1-a339-4927-b98d-ea0143f2dd87",
                                                "sense_id": "1edbd0d2-7506-3e84-afb9-a647e3df8dcc",
                                                "text": "Jede rekursive Produktion macht eine Grammatik trivialerweise rekursiv. Hingegen gibt es rekursive Sprachen, die keinerlei rekursive Produktionen enthalten müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d1e0cf69-40c3-395c-9244-b19c542c7e10",
                                        "entry_id": "066e8a1f-f9be-33c0-99db-e49566d13c2c",
                                        "glosses": [
                                            "Informatik, formale Sprachen",
                                            "rekursive Produktion: eine Produktion (Ersetzungsregel) der Gestalt N→α, mit also dem Nichtterminalsymbol N, als linker Seite heißt rekursiv dann und nur dann, wenn die rechte Seite α, die Gestalt α=βNγ, hat."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "4aa453cb-1b86-32dc-87ff-981cb70045c7",
                                        "entry_id": "066e8a1f-f9be-33c0-99db-e49566d13c2c",
                                        "glosses": [
                                            "Informatik, formale Sprachen",
                                            "rekursive Grammatik: eine Grammatik G heißt rekursiv dann und nur dann, wenn sie ein Nichtterminalsymbol N, besitzt und eine Ableitung N⇒_G^*αNβ, zu einer Satzform αNβ,, die also dasselbe N, irgendwo enthält."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3b\""
                                    }
                                ]
                            }
                        ]
