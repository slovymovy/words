    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ba881a8-51e7-3e9f-914a-fa2f98b92e05",
                    "sense_definition": "To copy or imitate the actions or qualities of someone else, often because you admire them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Young athletes often try to <w>emulate</w> their sports heroes by practicing every single day."
                        },
                        {
                            "text": "It is difficult to <w>emulate</w> the success of such a talented and experienced leader."
                        }
                    ],
                    "synonyms": [
                        "imitate",
                        "mimic",
                        "copy"
                    ],
                    "common_phrases": [
                        "emulate success",
                        "emulate hero"
                    ]
                },
                {
                    "sense_id": "f3824e4a-09cb-3116-ba63-d8198eba04b3",
                    "sense_definition": "To strive to equal or surpass someone or something.",
