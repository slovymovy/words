                                            {
                                                "example_id": "d2b8ad46-7b99-4229-8a25-eb8f5cf21dcf",
                                                "sense_id": "fd5182e2-93e7-3bc6-8cd8-3b6070510574",
                                                "text": "Pomiar prędkości obrotowej trzpienia dał wynik 7926,2 obr./min ±0,1."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "a5c4a560-968a-3dae-8fa9-c43efc50890d",
                                        "entry_id": "c19e7341-9a8d-3239-8a37-1b20d2bf71e8",
                                        "glosses": [
                                            "taki, który może się obracać; obracający się"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b62a9d4-b65b-4f78-95ce-2cca48633826",
                                                "sense_id": "a5c4a560-968a-3dae-8fa9-c43efc50890d",
                                                "text": "Wydobyła płytę z koperty, położyła ją na obrotowym talerzu i przesunęła ramię z igłą magnetyczną na brzeg"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
