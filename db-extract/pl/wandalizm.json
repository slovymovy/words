                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b56889e-efcc-433d-bd61-b3d2f599587a",
                        "source_entry_id": "3942cd21-c113-3588-b263-e7a511a4f263",
                        "source_sense_id": "f4a8024d-c310-3cff-a59d-4e9cb57afaa7",
                        "target_lang_word": "vandalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vandalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                        "entry_id": "dfea5851-fcc9-36d0-8c23-751a79b7a69b",
                                        "glosses": [
                                            "Willful damage to or destruction of any property, such as graffiti or defacement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca108c9-cf3c-449b-b4bb-d2d671749207",
                                                "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                                "text": "As we turned down the street I was appalled by the vandalism: spray paint and smashed windows that were everywhere."
                                            },
                                            {
                                                "example_id": "7ae7778c-07ec-4301-823a-58b49f7fa6c1",
                                                "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                                "text": "Bradford once boasted two stations with overall roofs. The pair were swept away in the 1970s in an act of corporate and civic vandalism."
                                            },
                                            {
                                                "example_id": "0ec5b467-2a0a-4124-8f0d-45c9b295a50a",
                                                "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                                "text": "President Donald Trump seemed to issue a warning to individuals who participate in Tesla vandalisms, as reports of destruction to vehicles, dealerships and charging stations surge across the country. […] When asked about his comments at the White House on Friday afternoon, Trump called the vandalism suspects \"terrorists\" and appeared to argue what was happening with Tesla vehicles was worse than what happened during the Jan. 6 riots at the Capitol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8de6e560-6730-43f9-b2cf-6db21d4978e2",
                        "source_entry_id": "3942cd21-c113-3588-b263-e7a511a4f263",
                        "source_sense_id": "f4a8024d-c310-3cff-a59d-4e9cb57afaa7",
                        "target_lang_word": "вандали́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вандали́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "33d673fe-4f61-3db2-9345-8bcd79fef553",
                                        "entry_id": "badeeb5f-8837-37f3-8897-ad318df993af",
                                        "glosses": [
                                            "истор. способ действия вандалов, разграбивших Рим в 450 году н. э. под начальством Гейзериха; варварство"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46b17105-c2e5-3856-90c8-674d39cff5e7",
                                        "entry_id": "badeeb5f-8837-37f3-8897-ad318df993af",
                                        "glosses": [
                                            "стремление к уничтожению предметов искусства, дикость по отношению к культуре и её продуктам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48fc1499-5433-49f2-b74a-10dabab69dc2",
                                                "sense_id": "46b17105-c2e5-3856-90c8-674d39cff5e7",
                                                "text": "Луч выхватывает следы вандализма: отломанная от пианино крышка валяется в углу, расколотые рамы картин без полотен, в буфете выбиты стёкла, повсюду экскременты — уже высохшие."
                                            },
                                            {
                                                "example_id": "eece3f14-cc36-4c4f-8d56-6db967cc134b",
                                                "sense_id": "46b17105-c2e5-3856-90c8-674d39cff5e7",
                                                "text": "Уничтожение детских и спортивных площадок — это открытый акт вандализма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c3d60e-bfcf-3d96-9c07-147ea389b46e",
                                        "entry_id": "badeeb5f-8837-37f3-8897-ad318df993af",
                                        "glosses": [
                                            "безучастие к просвещению и искусствам; отсутствие всякого вкуса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009d2671-687d-4621-ba0f-7b319cd17d08",
                                                "sense_id": "a9c3d60e-bfcf-3d96-9c07-147ea389b46e",
                                                "text": "В статье «Расшаркивающееся искусство» (обзор картинной выставки) читаем: «Кто может в настоящее время услаждаться чтением „Бедной Лизы“ Карамзина и стихотворений Фета, тот может совершенно безгрешно и целомудренно предаться созерцанию пейзажиков». Весь вандализм шестидесятых годов превосходно выразился в одной этой фразе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1133ed40-cbb1-32b3-a857-5f6c23bbd9ce",
                                        "entry_id": "badeeb5f-8837-37f3-8897-ad318df993af",
                                        "glosses": [
                                            "перен. любые аморальные деструктивные действия или демонстративное нарушение общепринятых норм поведения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4499265-9fa1-409d-86f5-b055c7e9162d",
                                                "sense_id": "1133ed40-cbb1-32b3-a857-5f6c23bbd9ce",
                                                "text": "— Это вандализм — бить стёкла, когда у нас не хватает средств вставить стёкла, разрушенные временем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6b0a35-2a75-3c18-bcbd-f574c943e953",
                                        "entry_id": "badeeb5f-8837-37f3-8897-ad318df993af",
                                        "glosses": [
                                            "жарг. викип. злонамеренная порча контента"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f7c1781-eb14-4fe0-b517-594da19601ba",
                                                "sense_id": "be6b0a35-2a75-3c18-bcbd-f574c943e953",
                                                "text": "У нас все администраторы борются с вандализмом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "114c9f99-8ac6-483a-a498-d27fbc753c68",
                        "source_entry_id": "3942cd21-c113-3588-b263-e7a511a4f263",
                        "source_sense_id": "f4a8024d-c310-3cff-a59d-4e9cb57afaa7",
                        "target_lang_word": "vandalismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vandalismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7e9155-547f-30b4-893b-f41a486e7518",
                                        "entry_id": "4093824f-577c-3f7e-abc6-1ccc0ecb9273",
                                        "glosses": [
                                            "tendenza a devastare e rovinare per puro gusto di distruzione"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab184a2-fdc4-4b10-ae27-8934d5511578",
                                                "sense_id": "3a7e9155-547f-30b4-893b-f41a486e7518",
                                                "text": "Scrivere sui muri è vandalismo."
                                            }
                                        ]
