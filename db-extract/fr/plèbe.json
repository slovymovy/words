        "fr-extract.jsonl": [
            {
                "entry_id": "57696ff8-d7ce-3cbd-9d8b-593b3d199b70",
                "word": "plèbe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85cf2913-517d-47c0-9210-a2dbb985eb91",
                        "entry_id": "57696ff8-d7ce-3cbd-9d8b-593b3d199b70",
                        "tags": [
                            "plural"
                        ],
                        "form": "plèbes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36f26480-cb4d-3489-b8eb-df53b420940f",
                        "entry_id": "57696ff8-d7ce-3cbd-9d8b-593b3d199b70",
                        "glosses": [
                            "(Antiquité) Dans l'ancienne Rome, ensemble des classes du peuple romain qui n'appartiennent pas à l'aristocratie, au patriciat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2bf87f-5208-4648-9f18-53f43dc9ce58",
                                "sense_id": "36f26480-cb4d-3489-b8eb-df53b420940f",
                                "text": "À partir de 462 av. J.-C., la plèbe réclame la mise par écrit d'une loi, connaissable par tous, fixant l'étendue des pouvoirs des consuls."
                            },
                            {
                                "example_id": "1b473b7d-030e-483f-b4e8-9e6b4c9079c7",
                                "sense_id": "36f26480-cb4d-3489-b8eb-df53b420940f",
                                "text": "Laïus Curion, tribun de la plèbe, qui s’était fait le défenseur de César et de sa dignité menacée, avait plusieurs fois pris devant le Sénat l’engagement suivant: si la puissance militaire de César inquiétait quelqu’un, et puisque, d’autre part, le pouvoir absolu et les armements de Pompée éveillaient chez les citoyens des craintes qui n’étaient pas médiocres, il proposait que l’un et l’autre désarmât et licenciât ses troupes; du coup, la république recouvrerait la liberté et l’indépendance. Il ne se borna point à cet engagement, mais il prit même l’initiative de provoquer un vote du Sénat ; les consuls et les amis de Pompée s’y opposèrent, et, sur cette manœuvre dilatoire, l’assemblée se sépara."
                            }
                        ]
                    },
                    {
                        "sense_id": "e58346fa-905c-392a-a822-f685ee89ed69",
                        "entry_id": "57696ff8-d7ce-3cbd-9d8b-593b3d199b70",
                        "glosses": [
                            "Peuple."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d1e35010-9d2b-4538-9242-9e6fec7f23e1",
                                "sense_id": "e58346fa-905c-392a-a822-f685ee89ed69",
                                "text": "Jean-Émile, nous n’allons pas nous mêler à la plèbe."
                            },
                            {
                                "example_id": "225fd22c-d83e-4eec-bdd9-e63bb9d7676c",
                                "sense_id": "e58346fa-905c-392a-a822-f685ee89ed69",
                                "text": "Ma dernière vision de lui, alors que je lançais un grand au revoir, fut celle d'un riche milliardaire perdu dans le carrousel des bagages, parmi la plèbe, jouant des coudes avec le reste des mortels afin de récupérer ses bagages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "587e4c0d-88dd-467c-81ae-cd8d260f0d8b",
                        "source_entry_id": "57696ff8-d7ce-3cbd-9d8b-593b3d199b70",
                        "source_sense_id": "36f26480-cb4d-3489-b8eb-df53b420940f",
                        "source_sense_description": "(Histoire) (Antiquité) Bas peuple romain",
                        "target_lang_word": "Plebejer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plebejer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                        "entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                                        "glosses": [
                                            "der gemeine Mann des alten Roms, jemand, der zu der Plebs gehörte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e66fc5-fd6a-4427-bf66-4a3453555ca0",
                                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                                "text": "Die Plebejer sammelten sich am Rande des Marktplatzes."
                                            },
                                            {
                                                "example_id": "78eb0155-1402-4a1a-9dfc-0c75a5d094b6",
                                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                                "text": "Zwischen Patriziern und Plebejern bestand ein Eheverbot."
                                            },
                                            {
                                                "example_id": "af41e1cb-0eea-427a-ba94-b188075a35ac",
                                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                                "text": "„Im Verlauf des 5. Jahrhunderts v.Chr. zwangen die Plebejer dem patrizischen Adel die Kodifikation des geltenden Gewohnheitsrechts (XII-Tafel-Gesetz) sowie die zivilrechtliche Gleichstellung […] ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c861457-064c-3f1e-9302-3db5cc65cd41",
                                        "entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                                        "glosses": [
                                            "einer aus dem gemeinen Volke, ein ungehobelter oder ungebildeter Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3b9509e-2926-46c7-87d1-017f647e2438",
                                                "sense_id": "8c861457-064c-3f1e-9302-3db5cc65cd41",
                                                "text": "Vergiss diese Plebejer, im Grunde sollte man ihnen den Zutritt zur Ausstellung verwehren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0acdd2ec-c232-4328-89cd-212e127aacb5",
                        "source_entry_id": "57696ff8-d7ce-3cbd-9d8b-593b3d199b70",
