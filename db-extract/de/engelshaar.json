                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Engelshaar"
                    },
                    {
                        "form_id": "88767ce0-1f13-437b-928b-b9fc1d12faec",
                        "entry_id": "f1dbbdd5-2d72-3e60-a7a7-9336b6fd2f42",
                        "tags": [
                            "accusative",
