                        "glosses": [
                            "Nom vernaculaire en Inde du sésame, graine de Sesamum indicum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c53c8f5c-1e51-41ff-add0-5bbf64436d71",
                                "sense_id": "bfaa630d-6f97-32be-a3eb-d21c456fcc22",
                                "text": "Gengeli, (le) graine employée dans les sacrifices."
                            },
                            {
                                "example_id": "28e281b6-d325-46f4-9ed7-cec2e51867e3",
                                "sense_id": "bfaa630d-6f97-32be-a3eb-d21c456fcc22",
                                "text": "On se sert dans l'Inde de l'huile extraite du copra [… ou] de celle de gingeli qui lui est bien inférieure. en note : L'auteur dit Gergelim mais dans le pays on prononce gengeli."
                            },
                            {
                                "example_id": "4788a713-6d9e-4378-a1db-8cd17a558287",
                                "sense_id": "bfaa630d-6f97-32be-a3eb-d21c456fcc22",
                                "text": "…de l'huile de gengeli."
                            },
                            {
                                "example_id": "1d76d2c9-c6ad-41fc-b12f-16070fc220c8",
                                "sense_id": "bfaa630d-6f97-32be-a3eb-d21c456fcc22",
                                "text": "On assure que dans les Indes orientales on se procure de l'huile de rose, en plaçant les feuilles de roses par couches alternatives avec la graine d'une espèce de digitale, appelée gengeli."
                            }
                        ]
                    }
