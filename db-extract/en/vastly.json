                                    {
                                        "sense_id": "b984469e-9c26-3bd4-9fe4-87eaa29c6296",
                                        "entry_id": "9aab38e6-0828-36dc-9718-e5d7ab6bd151",
                                        "glosses": [
                                            "beträchtlich, ins Gewicht fallend, wichtig, ernst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf64cd59-2ced-476e-b7d5-d956b5249f38",
                                                "sense_id": "b984469e-9c26-3bd4-9fe4-87eaa29c6296",
                                                "text": "Der Unfall brachte einen erheblichen Schaden."
                                            },
                                            {
                                                "example_id": "d4446436-b95c-4b47-830b-0c877a237e73",
                                                "sense_id": "b984469e-9c26-3bd4-9fe4-87eaa29c6296",
                                                "text": "„Nachdem erhebliche Mängel beim Bau der Kölner U-Bahn bekanntgeworden sind, hat die Stadt am Montag damit begonnen, die Baustelle vorsorglich zu stabilisieren.“"
                                            },
                                            {
                                                "example_id": "685e1781-596c-4c15-b9fd-aa26c0c0d80d",
                                                "sense_id": "b984469e-9c26-3bd4-9fe4-87eaa29c6296",
                                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                                            },
                                            {
                                                "example_id": "99770851-6ad9-4bb4-b6cb-7548bb67087a",
                                                "sense_id": "b984469e-9c26-3bd4-9fe4-87eaa29c6296",
                                                "text": "„Das gelungene Bubenstück hätte ihm eine erhebliche Aufmerksamkeit gesichert und einen gewaltigen Ansehensschub verschafft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4c3de54-8598-4904-98da-1e986cc73ff8",
                        "source_entry_id": "a297b871-a756-3a4c-bf92-cae4546d039a",
