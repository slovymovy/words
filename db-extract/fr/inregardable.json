                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2da54a-aa2d-4d18-b74d-f156ce32e4bd",
                                                "sense_id": "cae9b804-9bd5-3c7e-984d-b585d37e2190",
                                                "text": "The heart-wrenching, unwatchable footage of his death on September 30, 2000 shows him cowering in terror as his father tries vainly to shield him […]"
                                            },
                                            {
                                                "example_id": "b4a88fc3-476f-4393-9ac8-4939ad503b35",
                                                "sense_id": "cae9b804-9bd5-3c7e-984d-b585d37e2190",
                                                "text": "His first movies were so gross, most people consider them unwatchable."
                                            }
                                        ]
