                                "target_senses": [
                                    {
                                        "sense_id": "94c35933-1776-3930-bae1-905c4011ee33",
                                        "entry_id": "1be0af67-9ee3-3bf8-ab16-0b297629c368",
                                        "glosses": [
                                            "Relatif à l'ordre architectural grécolatin caractérisé notamment par des colonnes à chapiteau à échine plate (nue, sans décors), dont le fût est orné de vingt cannelures et sans base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32a50079-554e-4b42-a377-bf3c4600d4fc",
                                                "sense_id": "94c35933-1776-3930-bae1-905c4011ee33",
                                                "text": "Une colonne dorique."
                                            },
                                            {
                                                "example_id": "1e7719cf-6831-46c8-ab4c-b44d01d1ccc0",
                                                "sense_id": "94c35933-1776-3930-bae1-905c4011ee33",
                                                "text": "L’entablement dorique a sa frise ornée de triglyphes et de métopes."
                                            },
                                            {
                                                "example_id": "30a5d8f3-1519-43df-86a5-9a723002abf5",
                                                "sense_id": "94c35933-1776-3930-bae1-905c4011ee33",
                                                "text": "L’ordre dorique."
                                            },
                                            {
                                                "example_id": "5d182aa2-6634-4e12-87a3-b84777651075",
                                                "sense_id": "94c35933-1776-3930-bae1-905c4011ee33",
                                                "text": "Les colonnes du péristyle et du portique reposaient immédiatement sur les degrés du temple ; elles étaient sans base, cannelées et d’ordre dorique s’étaient écoulé."
                                            },
                                            {
                                                "example_id": "4796b5d1-f6d6-483b-8997-6ee33b21b09d",
                                                "sense_id": "94c35933-1776-3930-bae1-905c4011ee33",
                                                "text": "Les gens qui aiment le bon goût et la sobriété en architecture, doivent trouver l’Escurial quelque chose de parfait, car la seule ligne employée est la ligne droite, le seul ordre, l’ordre dorique, le plus triste et le plus pauvre de tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef855fb-51fb-3028-b3f7-5b4e4f5c6d1a",
                                        "entry_id": "1be0af67-9ee3-3bf8-ab16-0b297629c368",
                                        "glosses": [
                                            "Qui concerne la Doride antique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a2248b-0cd8-4ac3-9129-b916880a933e",
                                                "sense_id": "4ef855fb-51fb-3028-b3f7-5b4e4f5c6d1a",
                                                "text": "Thurium est fondé, quatre cent quarante-six ans avant J.-C., par des Grecs qui se divisent en dix tribus qui prennent, d’après les nations dont elles sortaient, les noms d’arcadique, achaïque, éléenne, béotienne, amphictyonique, dorique, iade, athénaïque, euboïque et nésiote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6d2ebd-3a15-3be1-81c8-c95aa64a7126",
                                        "entry_id": "1be0af67-9ee3-3bf8-ab16-0b297629c368",
                                        "glosses": [
                                            "Relatif à une colonne ou un pilastre sobre, dont les ornements sont rares, légers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968c52a2-6358-4e46-8cc3-adc2ab6e562c",
                                                "sense_id": "9a6d2ebd-3a15-3be1-81c8-c95aa64a7126",
                                                "text": "Les quatres pilastres doriques de l'église Saint-Maurice d'Orelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dorique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65c3b414-cb3f-31b1-8f33-c13f11b87ed2",
                                        "entry_id": "3195d9ac-491f-3cbd-8752-eccf668afb96",
                                        "glosses": [
                                            "L’un des cinq ordres d’architecture antique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9218926-b74e-4cbf-b96c-262e73af5c72",
