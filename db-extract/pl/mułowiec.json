                        "translation_id": "b3c3e520-2dd9-4939-8c96-14c8d5ff28db",
                        "source_entry_id": "f0980abd-e74e-3dcf-b1bd-1df63cad8175",
                        "source_sense_id": "bfe52c87-2420-3839-829f-db8ff6372305",
                        "target_lang_word": "marna",
