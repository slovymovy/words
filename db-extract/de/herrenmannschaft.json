                "senses": [
                    {
                        "sense_id": "f74334cd-75cf-3821-a890-b2265a795ebf",
                        "entry_id": "b3f9082f-a907-3cd9-8ce7-f0c4ddfd62dc",
                        "glosses": [
                            "Gruppe von männlichen Sportlern, die eine Mannschaft bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1444c00-50c6-4ac6-b79b-240a1c7e0e67",
                                "sense_id": "f74334cd-75cf-3821-a890-b2265a795ebf",
                                "text": "„Einer der Amateurvereine ist der FC 1926 Großen Buseck, dessen erste Herrenmannschaft in der Kreisliga A Gießen spielt.“"
                            },
                            {
                                "example_id": "e26b5fc4-924a-4f66-9ff0-40c6e05c6a99",
                                "sense_id": "f74334cd-75cf-3821-a890-b2265a795ebf",
                                "text": "„Die Herrenmannschaft der einst ruhmreichen ‚Ländches-SG‘ ist dagegen so weit von der Erstklassigkeit entfernt wie noch nie.“"
                            },
                            {
                                "example_id": "5ad058be-2e24-4b2c-80d5-d6069711a61b",
                                "sense_id": "f74334cd-75cf-3821-a890-b2265a795ebf",
                                "text": "„Zusammengelegt stehen den beiden Herrenmannschaften nun etwa 35 Spieler zur Verfügung, bestehend jeweils rund zur Hälfte aus den beiden Vereinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
