                    "sense_id": "9e89f479-fa7f-3884-acf3-fb93dc4d45ea",
                    "sense_definition": "Aardig, welwillend en beleefd in de omgang met anderen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>vriendelijke</w> vrouw wees ons de weg naar het station.",
                            "target_lang_translations": {
                                "en": "The <w>friendly</w> woman showed us the way to the station.",
                                "ru": "<w>Приветливая</w> женщина показала нам дорогу на вокзал.",
                                "pl": "<w>Miła</w> kobieta wskazała nam drogę na stację.",
                                "de": "Die <w>freundliche</w> Frau zeigte uns den Weg zum Bahnhof.",
                                "fr": "La femme <w>gentille</w> nous a indiqué le chemin de la gare.",
                                "it": "La donna <w>gentile</w> ci ha mostrato la strada per la stazione.",
                                "cs": "<w>Milá</w> žena nám ukázala cestu na nádraží.",
                                "tr": "<w>Güler yüzlü</w> kadın bize istasyonun yolunu gösterdi.",
                                "es": "La mujer <w>amable</w> nos indicó el camino a la estación."
                            }
                        },
                        {
                            "text": "Hij schreef een brief met een <w>vriendelijke</w> toon.",
                            "target_lang_translations": {
                                "en": "He wrote a letter with a <w>friendly</w> tone.",
                                "ru": "Он написал письмо в <w>дружелюбном</w> тоне.",
                                "pl": "Napisał list w <w>przyjaznym</w> tonie.",
                                "de": "Er schrieb einen Brief in einem <w>freundlichen</w> Ton.",
                                "fr": "Il a écrit une lettre sur un ton <w>amical</w>.",
                                "it": "Ha scritto una lettera con un tono <w>amichevole</w>.",
                                "cs": "Napsal dopis v <w>přátelském</w> tónu.",
                                "tr": "<w>Dostça</w> bir tonla bir mektup yazdı.",
                                "es": "Escribió una carta con un tono <w>amistoso</w>."
                            }
                        },
                        {
                            "text": "Onderaan de e-mail stond: met <w>vriendelijke</w> groet.",
                            "target_lang_translations": {
                                "en": "At the bottom of the email it said: <w>kind</w> regards.",
                                "ru": "В конце письма было написано: с <w>дружеским</w> приветом.",
                                "pl": "Na dole e-maila było napisane: z <w>poważaniem</w>.",
                                "de": "Am Ende der E-Mail stand: Mit <w>freundlichen</w> Grüßen.",
                                "fr": "Au bas de l'e-mail, il était écrit : <w>cordialement</w>.",
                                "it": "In fondo all'e-mail c'era scritto: <w>cordiali</w> saluti.",
                                "cs": "Na konci e-mailu bylo napsáno: s <w>přátelským</w> pozdravem.",
                                "tr": "E-postanın altında şöyle yazıyordu: <w>saygılarımla</w>.",
                                "es": "Al final del correo electrónico decía: un <w>atento</w> saludo."
                            }
                        }
                    ],
