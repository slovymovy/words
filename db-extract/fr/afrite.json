                "senses": [
                    {
                        "sense_id": "ab38a1be-2f89-34b2-ab7d-8a8f439eb15b",
                        "entry_id": "db741011-dcd3-3607-a02e-a5005e0fee37",
                        "glosses": [
                            "Sorte de djinn, génie de la mythologie arabe généralement considéré comme malfaisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca39c77-8769-40a3-9818-3b46cfacc729",
                                "sense_id": "ab38a1be-2f89-34b2-ab7d-8a8f439eb15b",
                                "text": "Je vous ai pêché, je vous ai rendu la vie, et vous m’appartenez comme la créature est au créateur, comme, dans les contes de fées, l’Afrite est au génie, comme l’icoglan est au Sultan, comme le corps est à l’âme !"
                            },
                            {
                                "example_id": "683055d1-c4ba-4c90-9bae-d690ba54f912",
                                "sense_id": "ab38a1be-2f89-34b2-ab7d-8a8f439eb15b",
                                "text": "À voir cette fille étrange, un poète lui aurait donné l’Yémen pour patrie, elle tenait de l’Afrite et du Génie des contes arabes."
                            },
                            {
                                "example_id": "2fba83f1-57b8-4dbf-9bf5-e7b3076dcd30",
                                "sense_id": "ab38a1be-2f89-34b2-ab7d-8a8f439eb15b",
                                "text": "Le roi légendaire Tahmouras soutint une lutte gigantesque contre les Afrites ou Divs, qu'il chassa dans les mers et au fond des déserts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b78fd916-307b-40a7-8dcf-ca28b6d6d781",
                        "source_entry_id": "db741011-dcd3-3607-a02e-a5005e0fee37",
                        "source_sense_id": "ab38a1be-2f89-34b2-ab7d-8a8f439eb15b",
