                                "target_senses": [
                                    {
                                        "sense_id": "6cb7b114-e4a5-3d4d-a664-c88afff1b99b",
                                        "entry_id": "4dcf752a-050b-3dae-b945-b2f04e9804e6",
                                        "glosses": [
                                            "Ombre considérablement agrandie d’un objet, observée d’un sommet montagneux dans la direction opposée au soleil, sur un nuage de gouttelettes d’eau ou sur du brouillard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47169f97-947c-4570-83e1-d0deba62d99c",
                                                "sense_id": "6cb7b114-e4a5-3d4d-a664-c88afff1b99b",
                                                "text": "À Ledges Cave, en Afrique du Sud, Clint Ralph a capturé une image d’un spectre de Brocken."
                                            },
                                            {
                                                "example_id": "f8ba8bb5-5d70-40da-a284-6808dc67e26d",
                                                "sense_id": "6cb7b114-e4a5-3d4d-a664-c88afff1b99b",
                                                "text": "Pendant un instant, là, au sommet, on peut voir parfois le spectre de Brocken — un phénomène qui se produit au coucher du soleil, lorsqu’on se place entre le soleil et les nuages et qu’on peut voir son ombre à soi se dessiner sur les nuées, au milieu d’un arc-en-ciel ; quelque chose comme l’auréole de Jésus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
