                "senses": [
                    {
                        "sense_id": "6ad66554-c173-3933-9989-70d2bbe685fc",
                        "entry_id": "def1215b-eb4b-33d6-a96e-daabfb3743df",
                        "glosses": [
                            "книжн. бедняк, нищий; человек, лишённый средств существования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d416497-c21e-4c18-bc57-66ee68294435",
                                "sense_id": "6ad66554-c173-3933-9989-70d2bbe685fc",
                                "text": "Капиталистическая система превращает десятки миллионов людей в безработных пауперов."
                            },
                            {
                                "example_id": "ad4acb3e-c5b1-4e4b-8834-2d514b6a9807",
                                "sense_id": "6ad66554-c173-3933-9989-70d2bbe685fc",
                                "text": "Нищета и голод были укоренены в самой Природе, и самым эффективным способом борьбы с нищетой было объявлено естественное воздействие голода, принуждающее паупера продавать свой труд."
                            }
                        ]
                    }
