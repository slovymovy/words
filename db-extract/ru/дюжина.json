                    {
                        "translation_id": "b1cdf0cf-1c9e-4e0d-bdd7-538c28a85170",
                        "source_entry_id": "07422958-95a0-3a8a-8364-86bf8817f825",
                        "source_sense_id": "350555a4-7f64-3dbc-83ad-9eaf467e154e",
                        "target_lang_word": "Dutzend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dutzend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                        "entry_id": "07040f58-a0a9-374a-94e5-a8b4f08fdef3",
                                        "glosses": [
                                            "alter, aber auch heute noch gebräuchlicher Zahlklassifikator für die Zahl Zwölf; zwölf"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56347f0b-b960-47bd-9ec5-b76122a4f745",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            },
                                            {
                                                "example_id": "9931d1f3-0ba1-4d04-9594-e8c555c6387b",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Fast alle, die im Höhenbergsteigen Rang und Namen haben, sind an der Lhotse-Südwand gescheitert, insgesamt rund ein Dutzend Expeditionen.“"
                                            },
                                            {
                                                "example_id": "dd4f2bcb-f47d-48c3-9f0e-7cfe061a17bd",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "Ich habe heute zwei Dutzend Äpfel gekauft."
                                            },
                                            {
                                                "example_id": "7e577050-d971-42f4-ac5d-2e530919f627",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Er schlägt ein Dutzend Eier hinein.“"
                                            },
                                            {
                                                "example_id": "519c8961-6cdf-460d-b676-f23b515f8b72",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Ich fand mich plötzlich auf einem Podium einem Lautsprecher und etwa zwei Dutzend bleichen Gesichtern gegenüber, die deutschen Journalisten gehörten.“"
                                            },
                                            {
                                                "example_id": "19f27b37-f120-4677-8090-650be6a9b429",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Als er am oberen Ende der breiten, steilen Rampe angelangt war, die zu dem großen Veranstaltungssaal führte, sah er vor der Türreihe bereits eine Schar von Leuten warten, mindestens zwei Dutzend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50f76240-0607-3abe-b665-b60280df29af",
                                        "entry_id": "07040f58-a0a9-374a-94e5-a8b4f08fdef3",
                                        "glosses": [
                                            "unbestimmte Anzahl von etwas; viele"
                                        ],
                                        "tags": [
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85cc5a4-eb47-4fdb-b7db-541e63e390e2",
                                                "sense_id": "50f76240-0607-3abe-b665-b60280df29af",
                                                "text": "Auf dem Platz versammelten sich dutzende Schaulustige."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "643e00b1-314b-4d13-969d-7d691aa8768c",
                        "source_entry_id": "07422958-95a0-3a8a-8364-86bf8817f825",
                        "source_sense_id": "350555a4-7f64-3dbc-83ad-9eaf467e154e",
                        "target_lang_word": "douzaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douzaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                        "entry_id": "ce7ae3be-47d2-3057-be3b-9fde7eca56ca",
                                        "glosses": [
                                            "Douze ou à peu près douze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3be2c6-3f12-4c3c-8d35-2b64e7e027fb",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "— M’apportes-tu seulement douze douzaines de messes à un écu chacune, ou garderas-tu toujours pour toi seul l’or que te versent à flots tes dévotes de province, vieux pingre ?"
                                            },
                                            {
                                                "example_id": "eece312e-7a2d-4274-baa0-4def54119204",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "La douzaine d’otages est prête : il y en a même treize. Rien que des domestiques stylés de la guerre et tout enfant qui crie quand le canon tonne est giflé."
                                            },
                                            {
                                                "example_id": "604ef9a0-a642-4cd3-ad29-a0a32316fb49",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "A une douzaine de kilomètres en aval de Combloux, […], on note un replat où affleurent quelques blocs erratiques granitiques."
                                            },
                                            {
                                                "example_id": "838777f6-bc3d-4978-be96-e1d9027dd7cb",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "La bourgeoisie devait être nombreuse à Auvillar, écrit le docteur Labat, puisque, sous la Restauration, on y comptait une douzaine de chevaliers de Saint-Louis."
                                            },
                                            {
                                                "example_id": "231fc2f2-1fd4-481e-ba23-304e1e2417e1",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "Les deux hommes consultèrent la carte : il commandèrent chacun une douzaine d’escargots qu’ils arrosèrent de muscadet."
                                            },
                                            {
                                                "example_id": "bcb46ebb-4c3e-4f20-bcd1-6d8a6b8528ef",
                                                "sense_id": "c8c52fb2-977c-3ae1-9a5c-d152f1d5d46b",
                                                "text": "Le nouveau campement est établi à une douzaine de kilomètres de l’ancien, dans une plaine ondulée et verdoyante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cfc017b-a2cb-3914-93b2-ebdf094edc12",
                                        "entry_id": "ce7ae3be-47d2-3057-be3b-9fde7eca56ca",
                                        "glosses": [
                                            "Nombre indéterminé, mais qui n’est pas considérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e55dd2-bc8b-4bb0-b0e8-c66533f7a9bd",
                                                "sense_id": "6cfc017b-a2cb-3914-93b2-ebdf094edc12",
                                                "text": "Friand de la lame il s’est, sous la Restauration, aligné, une douzaine de fois, au côtés des « brigands de la Loire » en face des gentilshommes royalistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
