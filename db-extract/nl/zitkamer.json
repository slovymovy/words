                            "kamer in een huis met gemakkelijke stoelen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44000940-b0ca-4b8d-b77b-62a398786443",
                                "sense_id": "2e6d82fd-968f-3165-83a5-a874bb929246",
                                "text": "In de zitkamer keken we televisie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85fb80b3-338f-4d49-890f-31fdaee23771",
                        "source_entry_id": "b9433ed4-22e3-383b-8a47-bbfa6bdf71de",
                        "source_sense_id": "2e6d82fd-968f-3165-83a5-a874bb929246",
                        "target_lang_word": "Wohnzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Raum in einem Haus oder einer Wohnung, der für den Aufenthalt von Personen am Tag bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c88b32-8655-4e34-81e9-fec041e72d1e",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "Das Wohnzimmer ist meist der größte Wohnraum."
                                            },
                                            {
                                                "example_id": "6d44d3f2-fe32-45ca-8b5b-d30f5d946645",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er stand auf, ließ Hugo und mich im Arbeitszimmer zurück und ging ins Wohnzimmer, wo er sich einen Whiskey aus der Hausbar einschenken würde, einen großen.“"
                                            },
                                            {
                                                "example_id": "648a9392-9d10-4fc8-a742-28cdd4675c4b",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Morell saß, an einem Glas Brandy nippend, in dem warmen Wohnzimmer in Westminster, dem seine Frau eine echt weibliche Note gegeben hatte.“"
                                            },
                                            {
                                                "example_id": "263baad3-9cc7-4d71-b4b3-da18c5f7a8c1",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Sie rannte mit wehender Pelerine ins Wohnzimmer und warf Aschenbecher unter das Klavier.“"
                                            },
                                            {
                                                "example_id": "3b550fb1-50f0-4a46-a6d6-5ec4008cee0d",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Neben ihrer Schlafcouch im Wohnzimmer hängt ein Wandteppich mit einer idyllischen Waldszene.“"
                                            },
                                            {
                                                "example_id": "b3287855-da2a-4b2e-87b9-3435fb7fb86f",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er beobachtete den unten schmiedeeisernen, oben grüngekachelten Ofen im Wohnzimmer wie ein widerspenstiges, gefährliches Biest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Einrichtung eines Wohnzimmers^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab2700c-fda7-4abe-b0d4-455145bd5ac8",
                                                "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                                "text": "Wir haben uns endlich entschlossen, ein neues Wohnzimmer zu kaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c069d37e-6ad7-4600-aeb3-9df0184d4f39",
                        "source_entry_id": "b9433ed4-22e3-383b-8a47-bbfa6bdf71de",
