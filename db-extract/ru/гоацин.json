                "translations": [
                    {
                        "translation_id": "7eb75974-c104-4826-aa20-7e86289718c2",
                        "source_entry_id": "44f3f45b-ddf3-3375-951e-f84151dcaa58",
                        "source_sense_id": "4248cb9c-e17d-38a6-8bd1-eafb6eedd563",
                        "source_sense_description": "Птица",
                        "target_lang_word": "hoatzin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoatzin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e856ec-3a07-30ee-aad1-5cabeba2ac9c",
                                        "entry_id": "22e85152-1b19-334f-bb4a-14b8a40ae44d",
                                        "glosses": [
                                            "A bird of the species Opisthocomus hoazin of the order Opisthocomiformes, with claws on the wing fingers of the juvenile and an enlarged crop used as a rumen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a9b907-f12b-41d2-a7c5-92bfc076cbf4",
                                                "sense_id": "b8e856ec-3a07-30ee-aad1-5cabeba2ac9c",
                                                "text": "Hoatzins are large birds — at about twenty-six inches from head to tail, they are much larger than Archaeopteryx — with a yellowish chest, brown striped back, and a long narrow tail (Figure 53). Hoatzins are unusual in several ways, one of which is that hatchling hoatzins have claws on their wings. Although some other birds have vestigial wing claws, the hoatzin is the only species known to have functional wing or hand claws."
                                            },
                                            {
                                                "example_id": "bb6a325f-7344-4ef3-a410-677dabca2c8f",
                                                "sense_id": "b8e856ec-3a07-30ee-aad1-5cabeba2ac9c",
                                                "text": "The hoatzin is a very colorful bird with a blue head, a tuft of feathers standing up on the head, and an orange iris in the eye."
                                            },
                                            {
                                                "example_id": "6977176a-1538-431e-963b-42fc6914f715",
                                                "sense_id": "b8e856ec-3a07-30ee-aad1-5cabeba2ac9c",
                                                "text": "Unique among riverine bird species, the hoatzin (Opisthocomus hoatzin) is found along slow meandering streams and oxbows within the Amazon and Orinoco basins (Plate 12-43). Hoatzins resemble chickens in size and shape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
