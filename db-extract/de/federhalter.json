                "senses": [
                    {
                        "sense_id": "84ead038-e388-3a5a-aa3e-e8187b1c18a0",
                        "entry_id": "dfddf516-dc3a-312b-bc6b-66efade92955",
                        "glosses": [
                            "Schreibgerät, das einen kleinen Speicher für Tinte enthält und somit andauerndes Schreiben mit Tinte ermöglicht"
                        ],
                        "tags": [
                            "Kurzform von Füllfederhalter"
                        ],
                        "examples": [
                            {
                                "example_id": "d74d5e9b-9688-4532-acc9-f9ea04b26486",
                                "sense_id": "84ead038-e388-3a5a-aa3e-e8187b1c18a0",
                                "text": "Meine Federhalter benötigen kleine Tintenpatronen."
                            },
                            {
                                "example_id": "3f281980-9c25-43a1-8e38-42664e3f9bc0",
                                "sense_id": "84ead038-e388-3a5a-aa3e-e8187b1c18a0",
                                "text": "In diesen Federhaltern sind Patronen mit roter Tinte drin."
                            },
                            {
                                "example_id": "def7d788-ed11-4497-a600-2738800c1a8a",
                                "sense_id": "84ead038-e388-3a5a-aa3e-e8187b1c18a0",
                                "text": "Mein Federhalter ist pink."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "916f403b-2577-3ed0-96e4-ee7f804eb5e6",
                        "entry_id": "dfddf516-dc3a-312b-bc6b-66efade92955",
                        "glosses": [
                            "Schreibgerät, Halter für verschiedene aufsteckbare Federn (Schreibfedern, Zeichenfedern, Schneidfedern)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70fdedaf-aa5c-4094-958d-031fcd88a677",
                                "sense_id": "916f403b-2577-3ed0-96e4-ee7f804eb5e6",
                                "text": "Mein Federhalter ist pink."
                            },
                            {
                                "example_id": "53659374-4625-4a52-986d-5adc95448f3f",
                                "sense_id": "916f403b-2577-3ed0-96e4-ee7f804eb5e6",
                                "text": "Ich habe daheim eine große Sammlung an Federhaltern.",
                                "translation": "„Die 85-jährige [sic!] greift im Laufe des Tages zum Federhalter und schreibt auf, was sie in diesem Jahrhundert erlebt hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
