                    {
                        "translation_id": "9e64e1b9-e279-42c7-90c0-5d006efc51b4",
                        "source_entry_id": "4f466452-5369-3589-bc4e-e6aeac4342ae",
                        "source_sense_id": "7af07f8e-1a50-3d42-b63c-c696128ff468",
                        "target_lang_word": "Orion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orion",
