{
    "word_family": [
        "deliberate",
        "deliberative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "458ec02c-42ec-3817-9689-bfc9ae7afdd4",
                    "sense_definition": "The act of carefully considering or weighing reasons before making a decision.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thought_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After much <w>deliberation</w>, the committee decided to postpone the project.",
                            "target_lang_translations": {
                                "ru": "После долгих <w>размышлений</w> комитет решил отложить проект."
                            }
                        },
                        {
                            "text": "The decision required careful <w>deliberation</w> to avoid any potential errors.",
                            "target_lang_translations": {
                                "ru": "Это решение потребовало тщательного <w>обдумывания</w>, чтобы избежать возможных ошибок."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflection",
                        "thought",
                        "pondering"
                    ],
                    "common_phrases": [
                        "careful deliberation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс тщательного обдумывания или взвешивания всех «за» и «против» перед принятием решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обду́мывание",
                                "target_lang_sense_clarification": "процесс глубокого осмысления ситуации"
                            },
                            {
                                "target_lang_word": "размышле́ние",
                                "target_lang_sense_clarification": "интеллектуальный процесс анализа вариантов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d075641c-0da4-38f1-a5ad-d969b969be57",
                    "sense_definition": "A formal process of discussion and examination of issues by a group or council.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "thought_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury began their <w>deliberations</w> behind closed doors early this morning.",
                            "target_lang_translations": {
                                "ru": "Присяжные начали свои <w>совещания</w> за закрытыми дверями рано утром."
                            }
                        },
                        {
                            "text": "The <w>deliberations</w> of the council lasted for several hours before a vote was taken.",
                            "target_lang_translations": {
                                "ru": "Обсуждения в совете длились несколько часов, прежде чем было проведено голосование."
                            }
                        }
                    ],
                    "synonyms": [
                        "contemplation",
                        "deliberation"
                    ],
                    "common_phrases": [
                        "jury deliberations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный процесс обсуждения и рассмотрения вопросов группой лиц или советом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассмотре́ние",
                                "target_lang_sense_clarification": "официальное изучение вопроса для принятия решения"
                            },
                            {
                                "target_lang_word": "обсужде́ние",
                                "target_lang_sense_clarification": "коллективный процесс обмена мнениями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}