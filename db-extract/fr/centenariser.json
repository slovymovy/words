                "senses": [
                    {
                        "sense_id": "936a9865-7261-3764-a1f9-b263ec7a42b0",
                        "entry_id": "7eab6e2a-5873-310d-a781-7ba40fc402f5",
                        "glosses": [
                            "Célébrer le centenaire de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5065bd1f-196e-47dd-93d7-86deebbaca5d",
                                "sense_id": "936a9865-7261-3764-a1f9-b263ec7a42b0",
                                "text": "Quand, pour la première fois, cette idée folichonne de centenariser Voltaire, parut dans les feuilles rouges, les journaux conservateurs se sont hâtés de jeter le cri d’alarme."
                            },
                            {
                                "example_id": "37ef8cdb-35e5-4798-99b1-8968ae767233",
                                "sense_id": "936a9865-7261-3764-a1f9-b263ec7a42b0",
                                "text": "Chacun sera centenarisé par la force commémorative du réveil et de la revanche."
                            },
                            {
                                "example_id": "9a0430a2-7624-4a22-94d8-6d1af9c06f2f",
                                "sense_id": "936a9865-7261-3764-a1f9-b263ec7a42b0",
                                "text": "Nous ne « centenarisons » plus que des questions épuisées."
                            }
                        ]
                    }
