                                "target_senses": [
                                    {
                                        "sense_id": "2b74d787-acae-3847-95ed-8bb408c87918",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Dedicado al culto o el servicio de una deidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ae31f77-916f-45b6-8199-5f36826bde5f",
                                                "sense_id": "2b74d787-acae-3847-95ed-8bb408c87918",
                                                "text": "y es de saber que las ynouaçiones todas y la publicaçión del misterio diuinal no fue ello paresçido o declarado enteramente, así commo ya te he dicho, saluo en aquella tierra santa & escogida desde la criaçión del mundo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7eaf93ff-dcad-3c24-bb8c-dca2a52ac720",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Digno de alabanza por su pureza o bondad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7777683e-95f3-4453-9adf-8f8279bda442",
                                                "sense_id": "7eaf93ff-dcad-3c24-bb8c-dca2a52ac720",
                                                "text": "Job, aquel santo varón,\nde muy puro coraçón\nperfetamente me amava\ne por nombre me nombrava\nPaçiençia en tribulaçión."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "037daf51-d3ee-3908-b700-380a747a96f1",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "En particular, explícitamente designado como santo₂ por alguna confesión religiosa."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "167d8817-d436-45a1-9530-257a6d163b59",
                                                "sense_id": "037daf51-d3ee-3908-b700-380a747a96f1",
                                                "text": "y comenzaron a tenerle y reverenciarle por santo como si le hubiera canonizado la iglesia."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "32d369a9-204a-3108-8d1a-f399ec76043d",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Por extensión, propio de o relativo a la semana que media entre el domingo de ramos y el de resurrección."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e501e70a-89e1-498d-8b51-920f15b4fd87",
                                                "sense_id": "32d369a9-204a-3108-8d1a-f399ec76043d",
                                                "text": "Salieron miércoles santo, y otros en mayor número jueves santo."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e4cbf563-8680-3b0e-9d73-13f28cd9e16f",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Por extensión y figuradamente, de espíritu generoso y apacible."
                                        ],
                                        "tags": [
                                            "figurative",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d00304c-f772-4962-a6c5-15dc45ae1bca",
                                                "sense_id": "e4cbf563-8680-3b0e-9d73-13f28cd9e16f",
                                                "text": "—Es la misma virtud —respondió don Eduardo—, es una santa mujer que me profesa singular afecto y quiere cuidar a mi padre."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "abd6f45c-0b34-307e-97c3-21b3e5d41743",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Por extensión, que sorprende por su eficacia."
                                        ],
                                        "tags": [
                                            "por extensión"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63ba3cde-13cb-4a26-a6bf-4aa9fa5b3451",
                                                "sense_id": "abd6f45c-0b34-307e-97c3-21b3e5d41743",
                                                "text": "Como iba diciendo, quieras que no quieras, tuvo la bruja que beberse un jarro de aceite bendito, y entonces empezó a hacer visajes como una mona, y a vomitarlo todo, digo, que cantó de plano; porque el demonio puede ser remitente a cuanto le hagan, menos al óleo sagrado, que es santo remedio para hacerlo charlar más que un barbero y que un jefe de club eleccionario."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "7a4c274d-c871-34cc-b5e3-cd1b246b4868",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Úsase para poner énfasis."
                                        ],
                                        "tags": [
                                            "enfático"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43ac2e6c-5c9a-4401-bedf-8be577aa5703",
                                                "sense_id": "7a4c274d-c871-34cc-b5e3-cd1b246b4868",
                                                "text": "Creedme que esto os será más provechoso que no estarlos besando y abrazándolos todo el santo día hechas monas, que de mucho jugar con sus hijos los medio matan."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "ee274362-df37-39ec-84af-e1a6cf6132f0",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Propio de, relativo o aficionado al club deportivo San Lorenzo de Almagro."
                                        ],
                                        "tags": [
                                            "Argentina",
                                            "colloquial",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49af6365-ba68-46a9-9a35-113774ec25c3",
                                                "sense_id": "ee274362-df37-39ec-84af-e1a6cf6132f0",
                                                "text": "El compromiso se suspendió hace un par de semanas debido a la muerte del hincha de Vélez Emanuel Álvarez, de 21 años, tras recibir un balazo cuando se trasladaba junto con otros aficionados al estadio santo. La policía y la justicia no han identificado aún al autor del disparo."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "f80c8129-49a8-3298-baf0-44c6748d7885",
                                        "entry_id": "11fcedfa-8d6e-3c6e-95b1-2839d3fd4334",
                                        "glosses": [
                                            "Propio de, relativo o aficionado al club deportivo Juventud Antoniana de Salta."
                                        ],
                                        "tags": [
                                            "Argentina",
                                            "colloquial",
                                            "noun"
                                        ],
