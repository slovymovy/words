                "senses": [
                    {
                        "sense_id": "d6cf9520-cdee-3b66-8ecd-237a740e0129",
                        "entry_id": "ecc1d3c7-4652-3836-91f0-68f9c1ff0b66",
                        "glosses": [
                            "Spiel, das in einem größeren Innenraum ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a66d019-1c2a-479c-bdce-09b21d729f70",
                                "sense_id": "d6cf9520-cdee-3b66-8ecd-237a740e0129",
                                "text": "„Mit Bangen denkt man jetzt schon daran, daß 1971 nach den europäischen Hallenspielen, die offiziell zu Europameisterschaften erklärt wurden, sogar ein Erdteilkampf Amerika gegen Europa in der Halle geplant ist.“"
                            },
                            {
                                "example_id": "622b84e6-1e22-466a-8ad4-3f47c7aaa915",
                                "sense_id": "d6cf9520-cdee-3b66-8ecd-237a740e0129",
                                "text": "„Am nächsten Wochenende steigen nun im goldenen Prag die europäischen Hallenspiele, die im vergangenen Jahr hier in der Westfalenhalle ihre verheißungsvolle Ouvertüre erlebten.“"
                            },
                            {
                                "example_id": "c34cd9ff-0b1c-47a7-b0b5-ff44d1623ed2",
                                "sense_id": "d6cf9520-cdee-3b66-8ecd-237a740e0129",
                                "text": "„Diem allerdings, der große Freiluft-Enthusiast, sah in dem Hallenspiel ein dumpfes, embryonales Stadium, das mit der Geburt der Feldhandball-Idee überwunden werden sollte.“"
                            },
                            {
                                "example_id": "eafdd4c9-3113-4432-8bcf-4533510f0224",
                                "sense_id": "d6cf9520-cdee-3b66-8ecd-237a740e0129",
                                "text": "„In einem unerhört spannenden Ringen in fünf Sätzen schlug der Oberprimaner den italienischen Tennisriesen Orlando Sirola, der im Hallenspiel nahezu als unschlagbar gilt.“"
                            },
                            {
                                "example_id": "fe8dc897-88dc-4f05-9a0f-4e3e796403e3",
                                "sense_id": "d6cf9520-cdee-3b66-8ecd-237a740e0129",
                                "text": "„Man ist dort, durch die Witterung bedingt, mehr als anderswo auf Hallenspiele angewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
