                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87d8d07-9512-4d04-aab0-c9d276f6c6c6",
                                                "sense_id": "afbff24d-04bc-30c9-ba62-6a911067b1b0",
                                                "text": "„Vorder- und Hinterzwiesel verbinden die Trachten eines Reitsattels und sorgen dafür, dass kein Druck auf die Wirbelsäule des Pferdes entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
