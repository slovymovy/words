                    "sense_definition": "Nonstandard spelling of <w>have</w>, used to represent colloquial speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>of</w> told me you were coming earlier.",
                            "target_lang_translations": {
                                "ru": "Тебе <w>бы</w> следовало сказать мне раньше, что ты придешь."
