    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "770c1532-b434-31dd-b86f-165ff1ee9cf6",
                    "sense_definition": "Vor großer Hitze in roter oder oranger Farbe leuchten, ohne eine offene Flamme zu zeigen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hitze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Kohlen im Grill <w>glühen</w> schon seit einer Stunde und sind bereit für das Fleisch."
                        },
                        {
                            "text": "Das Eisen muss im Feuer hell <w>glühen</w>, bevor der Schmied es bearbeiten kann."
                        }
                    ],
                    "synonyms": [
                        "leuchten"
                    ],
                    "common_phrases": [
                        "vor Hitze glühen"
                    ]
                },
                {
                    "sense_id": "5d307d17-2346-364a-aadf-153d88ded393",
                    "sense_definition": "Sehr heiß sein und eine auffallend hohe Körpertemperatur oder Fieber haben.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "körper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das kranke Kind <w>glüht</w> am ganzen Körper vor hohem Fieber."
                        },
                        {
                            "text": "Fass ihr mal an die Stirn, sie <w>glüht</w> förmlich und braucht Ruhe."
                        }
                    ],
                    "common_phrases": [
                        "vor Fieber glühen"
                    ]
                },
                {
                    "sense_id": "1155c482-dfae-3f1d-ab70-bde30247d659",
                    "sense_definition": "Eine starke innere Erregung, Begeisterung oder Leidenschaft für eine Sache empfinden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ihre Wangen <w>glühten</w> vor Begeisterung, als sie von ihrer langen Reise erzählte."
                        },
                        {
                            "text": "Der junge Forscher <w>glüht</w> förmlich für die Wissenschaft und arbeitet Tag und Nacht."
                        }
                    ],
                    "synonyms": [
                        "brennen"
                    ],
                    "common_phrases": [
                        "vor Begeisterung glühen"
                    ]
                },
                {
                    "sense_id": "3fd367f3-b28d-3496-a693-00061cf71452",
                    "sense_definition": "Aufgrund überaus intensiver Nutzung ununterbrochen beansprucht werden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nutzung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach den überraschenden Nachrichten <w>glühten</w> in der Redaktion die Telefone pausenlos."
                        },
                        {
                            "text": "In den Tagen vor der Eröffnung <w>glühten</w> die Drähte zwischen den beiden Partnern."
                        }
                    ],
                    "common_phrases": [
                        "die Drähte glühen",
                        "die Telefone glühen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "metaphorische Verwendung"
                        }
                    ]
                },
                {
                    "sense_id": "98878a2b-e368-3056-8e38-7d0fcfbb8a7c",
                    "sense_definition": "In intensiven warmen, rötlichen oder goldenen Farben scheinen oder leuchten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hitze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kurz vor Sonnenuntergang <w>glühte</w> der gesamte Himmel in tiefem Orange."
                        },
                        {
                            "text": "Die Gipfel der Berge <w>glühen</w> im letzten Licht des späten Abends."
                        }
                    ],
                    "synonyms": [
                        "leuchten",
                        "strahlen"
                    ],
                    "common_phrases": [
                        "am Abendhimmel glühen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "070cc286-385c-358c-a10e-76e05bf11a57",
                    "sense_definition": "Das warme, sichtbare Leuchten eines stark erhitzten Körpers ohne offene Flammen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hitze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das rötliche <w>Glühen</w> des Ofens spendete im Zimmer behagliche Wärme."
                        },
                        {
                            "text": "In der Dunkelheit war nur noch das schwache <w>Glühen</w> der Asche zu sehen."
                        }
                    ],
                    "common_phrases": [
