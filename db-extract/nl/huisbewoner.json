                        "glosses": [
                            "persoon die in een bepaalde woning woont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccec505-af2f-4644-88e8-b391902cb80e",
                                "sense_id": "153844c9-beb0-3038-97b6-c32c3a40492f",
                                "text": "Aan de muur in de woonkamer hangen foto’s van de kinderen. Twee meisjes in een bakfiets. Daarnaast dezelfde twee meisjes, samen spelend in de tuin. Andere huisbewoners zijn een man en een vrouw. Dit is huisje, tuintje, boompje. Maar niet volgens de klassieke invulling."
                            }
                        ]
                    }
