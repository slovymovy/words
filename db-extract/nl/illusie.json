                "senses": [
                    {
                        "sense_id": "51c5c70d-f2fd-36dd-86f9-b3bce1d494a7",
                        "entry_id": "33356e5a-8716-3742-ae78-975eec0f657a",
                        "glosses": [
                            "Illusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d7db10c-c3d8-4ed1-9f0d-2e294d0ecf87",
                                "sense_id": "51c5c70d-f2fd-36dd-86f9-b3bce1d494a7",
                                "text": "Een illusie armer zijn.",
                                "translation": "Être Gros Jean comme devant."
                            },
                            {
                                "example_id": "47e159e5-6ad7-4ec9-9e9f-0567a4b50201",
                                "sense_id": "51c5c70d-f2fd-36dd-86f9-b3bce1d494a7",
                                "text": "Een illusie de grond in boren.",
                                "translation": "Détruire une illusion."
                            },
                            {
                                "example_id": "fefe7c8f-dccc-4fd2-b956-416d9eb682a7",
                                "sense_id": "51c5c70d-f2fd-36dd-86f9-b3bce1d494a7",
                                "text": "Illusies koesteren.",
                                "translation": "Caresser des illusions."
                            },
                            {
                                "example_id": "43eeb720-64ba-4dce-8085-7da2d72dd7be",
                                "sense_id": "51c5c70d-f2fd-36dd-86f9-b3bce1d494a7",
                                "text": "Zich illusies maken.",
                                "translation": "Se faire des illusions, se bercer d’illusions, (Familier) se monter le bourrichon."
                            },
                            {
                                "example_id": "482c4615-bea8-4201-9a5b-51ad4ffd6b71",
                                "sense_id": "51c5c70d-f2fd-36dd-86f9-b3bce1d494a7",
                                "text": "Een illusie verstoren.",
                                "translation": "Rompre le charme."
                            },
                            {
                                "example_id": "f4d80e0d-30ab-49fc-8247-13e421e58908",
                                "sense_id": "51c5c70d-f2fd-36dd-86f9-b3bce1d494a7",
                                "text": "Een illusie wekken.",
                                "translation": "Créer une illusion."
                            }
                        ]
                    }
