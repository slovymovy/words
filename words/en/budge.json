{
    "word_family": [
        "budger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "598da0f2-1e4d-3600-8a57-041335b0984d",
                    "sense_definition": "To move slightly or begin to move, or to be shifted from a fixed position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been pushing this heavy wooden table for ten minutes, but it won't <w>budge</w>.",
                            "target_lang_translations": {
                                "zh": "我已经推这张沉重的木桌十分钟了，可它就是不<w>挪动</w>。"
                            }
                        },
                        {
                            "text": "Despite our best efforts to push the car out of the mud, it refused to <w>budge</w> an inch.",
                            "target_lang_translations": {
                                "zh": "尽管我们拼命想把车从泥里推出来，它还是一寸也不<w>移动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shift"
                    ],
                    "common_phrases": [
                        "won't budge",
                        "budge an inch"
                    ],
                    "target_lang_definitions": {
                        "zh": "稍微移动、开始移动，或从固定位置被移开。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挪动",
                                "target_lang_sense_clarification": "指物体稍微移动，或原本固定不动的东西开始移动"
                            },
                            {
                                "target_lang_word": "移动",
                                "target_lang_sense_clarification": "强调位置发生变化，常用于东西终于动了"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f7c560f-ffab-370e-818c-1ae315df1d87",
                    "sense_definition": "To cause something to move or shift from a fixed position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The box was so heavy that we could not <w>budge</w> it even a little bit.",
                            "target_lang_translations": {
                                "zh": "这个箱子太重了，我们连一点也<w>挪不动</w>它。"
                            }
                        },
                        {
                            "text": "He tried to <w>budge</w> the jammed window, but the old frame was stuck fast.",
                            "target_lang_translations": {
                                "zh": "他试着<w>挪动</w>那扇卡住的窗户，但旧窗框死死卡住了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shift"
                    ],
                    "common_phrases": [
                        "unable to budge"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物从固定位置移动或移开。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挪动",
                                "target_lang_sense_clarification": "指使某个固定的东西移动一点"
                            },
                            {
                                "target_lang_word": "移动",
                                "target_lang_sense_clarification": "强调把东西从原位移开"
                            },
                            {
                                "target_lang_word": "挪动",
                                "target_lang_sense_clarification": "口语里常说把重物推得动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "630279ac-1aee-3846-81c3-c711fe3280d1",
                    "sense_definition": "To change one's opinion, decision, or position; to yield or compromise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee tried to negotiate a compromise, but the director refused to <w>budge</w> on his decision.",
                            "target_lang_translations": {
                                "zh": "委员会试图协商出一个折中方案，但主任在自己的决定上拒绝<w>让步</w>。"
                            }
                        },
                        {
                            "text": "Once she makes up her mind about a project, she will not <w>budge</w> for anyone.",
                            "target_lang_translations": {
                                "zh": "她一旦对某个项目拿定主意，就不会为任何人<w>改变主意</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "refuse to budge"
                    ],
                    "target_lang_definitions": {
                        "zh": "改变自己的看法、决定或立场；作出让步或妥协。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "让步",
                                "target_lang_sense_clarification": "指在立场、决定或要求上退一步"
                            },
                            {
                                "target_lang_word": "改变主意",
                                "target_lang_sense_clarification": "指改变原先的想法或决定"
                            },
                            {
                                "target_lang_word": "松口",
                                "target_lang_sense_clarification": "多用于终于不再坚持原意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a227b29-7687-308a-82d1-66c3e3e7ba28",
                    "sense_definition": "To cut or butt in line; to join a queue ahead of others who are waiting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "line_cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is very rude to <w>budge</w> in line when others have been waiting patiently.",
                            "target_lang_translations": {
                                "zh": "别人都在耐心排队等候时去<w>插队</w>是很不礼貌的。"
                            }
                        },
                        {
                            "text": "The teacher told the student not to <w>budge</w> ahead of his classmates.",
                            "target_lang_translations": {
                                "zh": "老师叫那个学生不要跑到同学前面去<w>插队</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "budge in line"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe cutting in line"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "插到队伍前面；在别人等待时抢先排到前面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "插队",
                                "target_lang_sense_clarification": "指排队时跑到别人前面去"
                            },
                            {
                                "target_lang_word": "加塞",
                                "target_lang_sense_clarification": "较口语，指排队时硬挤到前面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f24c60d0-89d5-3e2f-8bf0-bec5cc0dbdf1",
                    "sense_definition": "To try to improve the spot of a decision on a sports field.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_cheating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee warned the player not to <w>budge</w> the ball forward before the free kick.",
                            "target_lang_translations": {
                                "zh": "裁判警告那名球员，在罚任意球前不要把球<w>挪前</w>。"
                            }
                        },
                        {
                            "text": "In many casual games, players often try to <w>budge</w> their position to get a slight advantage.",
                            "target_lang_translations": {
                                "zh": "在许多随意进行的比赛里，球员常常会试着把自己的位置<w>挪前</w>一点来获得些微优势。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在体育场上把球或自己的位置偷偷往更有利的地方移一点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挪前",
                                "target_lang_sense_clarification": "指在比赛中把球或位置偷偷往前挪一点以占便宜"
                            },
                            {
                                "target_lang_word": "偷挪",
                                "target_lang_sense_clarification": "强调为了获得优势而偷偷移动位置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d662b416-8c8e-3290-97c5-d6205a69e424",
                    "sense_definition": "A kind of fur prepared from lambskin dressed with the wool on, formerly used as an edging and ornament, especially on scholastic habits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical robes were trimmed with fine <w>budge</w> to denote academic status.",
                            "target_lang_translations": {
                                "zh": "这些历史服袍镶着精美的<w>羔皮饰边</w>，以显示学术身份。"
                            }
                        },
                        {
                            "text": "He wore a traditional gown adorned with <w>budge</w> along the collar.",
                            "target_lang_translations": {
                                "zh": "他穿着一件传统长袍，领口饰有<w>羔皮饰边</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for a type of fur"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用带毛羔羊皮制成的毛皮，旧时常用作衣袍边饰和装饰，尤其见于学袍。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "羔皮饰边",
                                "target_lang_sense_clarification": "指用羔羊皮毛做成的衣袍镶边或装饰"
                            },
                            {
                                "target_lang_word": "羊羔毛皮镶边",
                                "target_lang_sense_clarification": "较偏解释性的说法，指带毛的羔羊皮镶边"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d12beb35-a1fc-3e6b-b1fc-d279bbad65e0",
                    "sense_definition": "Alcoholic drink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alcohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old tavern was filled with sailors sharing stories over cups of strong <w>budge</w>.",
                            "target_lang_translations": {
                                "zh": "老酒馆里满是水手，他们一边喝着烈性的<w>酒</w>，一边讲故事。"
                            }
                        },
                        {
                            "text": "They spent their last coins on cheap <w>budge</w> at the local pub.",
                            "target_lang_translations": {
                                "zh": "他们把最后几枚硬币都花在了当地酒吧里的便宜<w>酒</w>上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "obsolete slang for alcoholic beverage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "酒精饮料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "酒",
                                "target_lang_sense_clarification": "泛指含酒精饮料，旧式俚语"
                            },
                            {
                                "target_lang_word": "烈酒",
                                "target_lang_sense_clarification": "常指度数较高的酒"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9b5e2e71-f337-36d5-8afd-d05a5f755a18",
                    "sense_definition": "Austere, stiff, or solemn, like scholastics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor maintained a <w>budge</w> expression throughout the entire ceremony.",
                            "target_lang_translations": {
                                "zh": "整个仪式过程中，那位教授始终保持着<w>严肃</w>的表情。"
                            }
                        },
                        {
                            "text": "He looked very <w>budge</w> in his formal attire, refusing to smile at any jokes.",
                            "target_lang_translations": {
                                "zh": "他穿着正式服装，看起来十分<w>刻板</w>，听到任何玩笑都不肯笑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "像学者那样严肃、拘谨或庄重的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "严肃",
                                "target_lang_sense_clarification": "指神情或态度庄重严厉"
                            },
                            {
                                "target_lang_word": "刻板",
                                "target_lang_sense_clarification": "指人显得拘谨、生硬、不自然"
                            },
                            {
                                "target_lang_word": "庄重",
                                "target_lang_sense_clarification": "较书面，指庄重而冷峻"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b1ad5e13-22f8-3315-8911-91bacda6fab4",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Budge</w> to speak at our annual historical society meeting.",
                            "target_lang_translations": {
                                "zh": "我们邀请了<w>巴奇</w>先生在年度历史学会会议上发言。"
                            }
                        },
                        {
                            "text": "The local library has a collection of papers donated by the <w>Budge</w> family.",
                            "target_lang_translations": {
                                "zh": "当地图书馆收藏了一批由<w>巴奇</w>家族捐赠的文件。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "巴奇",
                                "target_lang_sense_clarification": "英文姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}