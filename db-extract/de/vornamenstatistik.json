                "senses": [
                    {
                        "sense_id": "2d0e47bb-da1d-34d2-b2dc-2cbdfaca3c7b",
                        "entry_id": "a1464192-c15e-3301-a21b-a0c8868e6552",
                        "glosses": [
                            "Erhebung/Darstellung, wie häufig welche Vornamen gewählt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d722af-abc8-4b7a-b490-fe4bf3b812b1",
                                "sense_id": "2d0e47bb-da1d-34d2-b2dc-2cbdfaca3c7b",
                                "text": "„Wenn auch aufgrund der geringen Anzahl der Geburten kaum direkte Vergleiche möglich sind, sollte die akribische Vornamenstatistik dieses Landes nicht unerwähnt bleiben.“"
                            },
                            {
                                "example_id": "be0d8686-fed2-4dc0-9333-d3cad0e074d5",
                                "sense_id": "2d0e47bb-da1d-34d2-b2dc-2cbdfaca3c7b",
                                "text": "„Weil es keine amtliche deutsche Vornamenstatistik gibt, ermittelt der Hobby-Forscher nach eigenen Angaben seit Jahren die häufigsten Babynamen. “"
                            },
                            {
                                "example_id": "d061d4a2-d1f8-41ed-8504-9af972ae76af",
                                "sense_id": "2d0e47bb-da1d-34d2-b2dc-2cbdfaca3c7b",
                                "text": "Im Internet sind die Vornamenstatistiken vieler Kommunen abrufbar."
                            },
                            {
                                "example_id": "3fddb336-2464-48d4-9a37-0056c1bdd688",
                                "sense_id": "2d0e47bb-da1d-34d2-b2dc-2cbdfaca3c7b",
                                "text": "„Das fängt schon bei meinem Namen an: »Kaya« liegt in der deutschen Vornamenstatistik weit hinter »Horst«, »Günther« und »Manfred«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
