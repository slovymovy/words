                        "examples": [
                            {
                                "example_id": "1cfdf371-537c-4918-9ec5-ea393104a5a7",
                                "sense_id": "b575d20a-f374-3f42-8fa2-725048ab0523",
                                "text": "„Der Wehrmachtsbericht kündet fast täglich: »Aus dem Osten werden keine besonderen Kampfhandlungen gemeldet …«“"
                            },
                            {
                                "example_id": "7d45d8a3-18e9-47d2-9070-5f5dfa0126f2",
                                "sense_id": "b575d20a-f374-3f42-8fa2-725048ab0523",
                                "text": "„Er kaufte sich an einem Stand eine Zeitung und blieb stehen und las den Wehrmachtsbericht.“"
                            },
                            {
                                "example_id": "6570c8b2-673a-4759-b106-daa0dca59b7f",
                                "sense_id": "b575d20a-f374-3f42-8fa2-725048ab0523",
                                "text": "„Das Radio lief noch, aber den offiziellen Wehrmachtsberichten traute in Götzlack niemand mehr.“"
                            }
                        ],
