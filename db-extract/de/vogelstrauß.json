                                    },
                                    {
                                        "sense_id": "b6cdd7a7-b51c-35dc-88e7-6bb25d924959",
                                        "entry_id": "41ff7459-0525-354a-84ff-7cfee7205195",
                                        "glosses": [
                                            "heftige, verbale Auseinandersetzung (die mitunter auch in Handgreiflichkeiten ausarten kann)"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29891e05-b5c1-4ffa-9710-6296a69f5254",
                                                "sense_id": "b6cdd7a7-b51c-35dc-88e7-6bb25d924959",
                                                "text": "„Peterſen erhob ſich, friſch, munter und zuverſichtlich, in tapferer Attitüde, ſtreitbar und bereit, den Strauß zu wagen.“"
                                            },
                                            {
                                                "example_id": "5a476608-9ed8-4da8-a548-4524c5d2b869",
                                                "sense_id": "b6cdd7a7-b51c-35dc-88e7-6bb25d924959",
                                                "text": "„[…]; namentlich mit dem Königtum und dem Adel hatte die Kirche manchen harten Strauß auszufechten.“"
                                            },
                                            {
                                                "example_id": "0fc61c5f-ffda-4faa-9bb2-a5d34e88d367",
                                                "sense_id": "b6cdd7a7-b51c-35dc-88e7-6bb25d924959",
                                                "text": "„Carlo, wir muͤſſen uns auf einen harten Strauß gefaßt machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "49a593b6-1893-36c6-89c7-bea72ed03f8b",
                                        "entry_id": "41ff7459-0525-354a-84ff-7cfee7205195",
