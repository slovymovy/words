                        "examples": [
                            {
                                "example_id": "30c344fc-7eea-4c0a-baca-bbb422daa56e",
                                "sense_id": "8b73014e-145d-311e-b77e-27ad77edae02",
                                "text": "„Der Historiker Ronald Zweig hat nachgewiesen, dass die türkischen Behörden das Schiff auf Betreiben des britischen Außenministers Anthony Eden zum Verlassen der türkischen Gewässer zwangen, nachdem Eden Premierminister Winston Churchill und das Kabinett bewusst über die Seetüchtigkeit des Schiffes getäuscht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
