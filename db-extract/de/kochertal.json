                ],
                "senses": [
                    {
                        "sense_id": "1b1100b0-1981-31e3-8399-c9b9f43c65bd",
                        "entry_id": "a8fd8e5e-bc59-3db3-bea7-efe6690d9d32",
                        "glosses": [
                            "das Tal, in dem der Kocher fließt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "c205e803-5911-432b-a79c-54c06ef36d33",
                                "sense_id": "1b1100b0-1981-31e3-8399-c9b9f43c65bd",
                                "text": "„Diese ehemalige Kirchen- und Klosteranlage aus dem 11. Jahrhundert thront hoch über dem Kochertal und bietet Besuchern einen unvergesslichen Ausblick auf die Altstadt von Schwäbisch Hall.“"
                            },
                            {
                                "example_id": "88bd52cc-7a39-4d71-af23-57f5a8f2118a",
                                "sense_id": "1b1100b0-1981-31e3-8399-c9b9f43c65bd",
                                "text": "„Den Grundstock etwa für die Schraubenindustrie legte der Handlungsreisende Hermann Ruhnau aus dem Sauerland, der mit einem Partner Ende des 19. Jahrhunderts im Kochertal die Eisenwarenfabrik Arnold gründete.“"
                            },
                            {
                                "example_id": "396b51bf-0069-4956-895a-0182d66bb6f6",
                                "sense_id": "1b1100b0-1981-31e3-8399-c9b9f43c65bd",
                                "text": "„Die SGOS muss zum kampf- und heimstarken TSV Sulzbach-Laufen ins Kochertal.“"
                            },
                            {
                                "example_id": "7660e81c-f6fc-4d1b-9bf8-d95a838aab83",
                                "sense_id": "1b1100b0-1981-31e3-8399-c9b9f43c65bd",
                                "text": "„Wie es jetzt mit dem Projekt im Kochertal weitergeht.“"
                            },
                            {
                                "example_id": "53136cfd-a3b3-4a74-a74b-097c89a8570c",
                                "sense_id": "1b1100b0-1981-31e3-8399-c9b9f43c65bd",
                                "text": "„Abtsgmünd und Hüttlingen, dazu noch Oberkochen, sind künftig das Kochertal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
