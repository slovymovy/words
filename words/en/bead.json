{
    "word_family": [
        "beading",
        "beady"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d6ca4fd-2a9b-3c6e-a5e4-24b756da3e71",
                    "sense_definition": "A small, round object with a hole used for decoration or jewelry.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a beautiful necklace using colorful glass <w>beads</w>.",
                            "target_lang_translations": {
                                "zh": "她用彩色的玻璃<w>珠子</w>做了一条漂亮的项链。"
                            }
                        },
                        {
                            "text": "The artisan carefully threaded each <w>bead</w> onto the silk string.",
                            "target_lang_translations": {
                                "zh": "工匠小心翼翼地将每一颗<w>珠子</w>穿在丝线上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "glass bead",
                        "wooden bead"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种有孔的小圆珠，常用于装饰或制作首饰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "珠子",
                                "target_lang_sense_clarification": "指一般的小圆珠。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3299b01b-977d-3d92-a02f-349a4f673bb7",
                    "sense_definition": "A small drop of liquid, such as sweat or water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small <w>beads</w> of sweat appeared on his forehead after the long run.",
                            "target_lang_translations": {
                                "zh": "长跑后，他的额头上冒出了细小的汗<w>珠</w>。"
                            }
                        },
                        {
                            "text": "The morning dew formed <w>beads</w> of water on the green leaves.",
                            "target_lang_translations": {
                                "zh": "晨露在绿叶上凝结成了水<w>珠</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "beads of sweat"
                    ],
                    "target_lang_definitions": {
                        "zh": "小滴液体，如汗水或水珠。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "珠",
                                "target_lang_sense_clarification": "用于形容成滴的液体，如汗珠、水珠。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37287248-8a6c-385e-b7ff-945e958a4f6d",
                    "sense_definition": "Each individual unit in a string used for prayer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held the prayer <w>beads</w> while reciting his daily devotions.",
                            "target_lang_translations": {
                                "zh": "他一边诵读每日祷文，一边手持<w>念珠</w>。"
                            }
                        },
                        {
                            "text": "The monk counted the <w>beads</w> on his rosary during the silent meditation.",
                            "target_lang_translations": {
                                "zh": "僧人在静默冥想时拨动着手中的<w>念珠</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prayer bead"
                    ],
                    "common_phrases": [
                        "prayer beads"
                    ],
                    "target_lang_definitions": {
                        "zh": "念珠，指用于祈祷或冥想的串珠。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "念珠",
                                "target_lang_sense_clarification": "特指宗教祈祷用的串珠。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9850a9e-395d-3b7a-a548-1e6c10280340",
                    "sense_definition": "A small metal part at the end of a gun barrel used for aiming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter aligned the <w>bead</w> with the target before pulling the trigger.",
                            "target_lang_translations": {
                                "zh": "猎人在扣动扳机前，将<w>准星</w>对准了目标。"
                            }
                        },
                        {
                            "text": "She carefully drew a <w>bead</w> on the distant mark.",
                            "target_lang_translations": {
                                "zh": "她小心地用<w>准星</w>瞄准了远处的标记。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "draw a bead"
                    ],
                    "target_lang_definitions": {
                        "zh": "枪管末端的准星，用于瞄准。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "准星",
                                "target_lang_sense_clarification": "枪械上用于瞄准的部件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7730dcf7-9f7d-3a0e-bcbe-f1a8f6447b75",
                    "sense_definition": "A clear understanding or focus on a specific goal or issue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team finally has a <w>bead</w> on the cause of the software error.",
                            "target_lang_translations": {
                                "zh": "团队终于<w>掌握</w>了软件错误的原因。"
                            }
                        },
                        {
                            "text": "We need to get a better <w>bead</w> on the project requirements before starting.",
                            "target_lang_translations": {
                                "zh": "在开始之前，我们需要更好地<w>掌握</w>项目需求。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a bead"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事有清晰的了解或明确的关注。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "掌握",
                                "target_lang_sense_clarification": "指对情况或问题的了解。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d4fd8a9-6345-36ec-bd08-1231849dd6a6",
                    "sense_definition": "To form into small, round drops.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rainwater began to <w>bead</w> on the freshly waxed surface of the car.",
                            "target_lang_translations": {
                                "zh": "雨水开始在刚打过蜡的车身上<w>凝结成珠</w>。"
                            }
                        },
                        {
                            "text": "The oil started to <w>bead</w> on the surface of the water.",
                            "target_lang_translations": {
                                "zh": "油开始在水面上<w>凝结成珠</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形成小圆滴状。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "凝结成珠",
                                "target_lang_sense_clarification": "形容液体在表面形成水珠。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "405f49b4-c95d-3a03-b4c9-c5390371dccc",
                    "sense_definition": "To decorate something by attaching small, round objects to it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer spent hours <w>beading</w> the wedding dress by hand.",
                            "target_lang_translations": {
                                "zh": "设计师花了几个小时手工为婚纱<w>缀珠</w>。"
                            }
                        },
                        {
                            "text": "She decided to <w>bead</w> the edges of the fabric for a more elegant look.",
                            "target_lang_translations": {
                                "zh": "她决定在布料边缘<w>缀珠</w>，以使其看起来更优雅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beading"
                    ],
                    "target_lang_definitions": {
                        "zh": "用珠子装饰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缀珠",
                                "target_lang_sense_clarification": "指在织物上缝缀珠子进行装饰。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4242d858-62d7-3fc5-a091-1548ed54729a",
                    "sense_definition": "An acronym for Broadband Equity, Access, and Deployment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The government announced new funding guidelines for the <w>BEAD</w> program.",
                            "target_lang_translations": {
                                "zh": "政府公布了<w>BEAD计划</w>的最新资金指导方针。"
                            }
                        },
                        {
                            "text": "States are currently preparing their proposals to receive <w>BEAD</w> infrastructure grants.",
                            "target_lang_translations": {
                                "zh": "各州目前正在准备申请<w>BEAD计划</w>的基础设施拨款。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "宽带公平、接入和部署计划（BEAD）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "BEAD计划",
                                "target_lang_sense_clarification": "指美国政府的宽带基础设施项目。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}