                    "frequency": "Low",
                    "semantic_group_id": "travaux_aquatiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les autorités ont décidé de <w>draguer</w> le port afin de permettre aux gros bateaux d'accoster."
                        },
                        {
                            "text": "Il faut régulièrement <w>draguer</w> cette rivière pour limiter les risques de crues."
                        }
                    ],
