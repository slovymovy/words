        "fr-extract.jsonl": [
            {
                "entry_id": "39da1879-e8b5-3b90-b498-1b704bbb5505",
                "word": "charroi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a61caf68-25de-4d8e-a1ed-b5d1bc7127fe",
                        "entry_id": "39da1879-e8b5-3b90-b498-1b704bbb5505",
                        "tags": [
                            "plural"
                        ],
                        "form": "charrois"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "844c53c9-e262-321b-ad3b-9640a0d6749f",
                        "entry_id": "39da1879-e8b5-3b90-b498-1b704bbb5505",
                        "glosses": [
                            "Transport par chariot, charrette, tombereau, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55875592-f819-4fb7-b2d7-251de00d68fe",
                                "sense_id": "844c53c9-e262-321b-ad3b-9640a0d6749f",
                                "text": "Là gisaient d’énormes troncs, rongés de pourriture, que jamais outil ne devait débiter en billes, que jamais charroi ne devait entraîner jusqu’au lit de la Sil valaque."
                            },
                            {
                                "example_id": "50b93990-d9fc-43ed-8543-2b8548fc3cf6",
                                "sense_id": "844c53c9-e262-321b-ad3b-9640a0d6749f",
                                "text": "Creusé par les charrois, le chemin fuyait, bleuâtre, entre les futaies."
                            },
                            {
                                "example_id": "409dc813-5e4b-4368-9382-9898f8d26c00",
                                "sense_id": "844c53c9-e262-321b-ad3b-9640a0d6749f",
                                "text": "J’ai pas de conseils à te donner, mais si tu ne votes pas pour ma liste, tu peux te fouiller pour que je te prête le carcan pour rentrer tes foins et faire tes charrois."
                            },
                            {
                                "example_id": "0c49bc04-7eb4-48e1-9121-5072404f69ff",
                                "sense_id": "844c53c9-e262-321b-ad3b-9640a0d6749f",
                                "text": "Droit devant eux, dissimulée encore par un pli de terrain, mais tout près, passait la grande route du Nord.\nElle était la seule qui, du Centre, du Sud et de l’Est, de Kaboul et de Peshawar, de Gardez, Ghazni et Kandahar, menait aux plaines et aux steppes étalées par-delà l’Hindou Kouch. Elle portait tout le charroi d’un peuple."
                            },
                            {
                                "example_id": "28121c1c-8d7c-4987-a3d0-b402b534efe9",
                                "sense_id": "844c53c9-e262-321b-ad3b-9640a0d6749f",
                                "text": "Les dernières centaines de mètres ne furent pas une promenade, sur un chemin plat, abîmé par les charrois, dont le dernier, celui de la matinée, avait conduit l’ancien tenancier vers sa nouvelle terre ; les chars s’embourbent jusqu’à mi-moyeu, bêtes et gens éprouvent les plus grandes difficultés à dégager leurs pieds, leurs jambes de la boue épaisse dans laquelle ils s’enfoncent jusque dans les derniers mètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "de12690e-cc62-30dc-8241-604a0c36a4f5",
                        "entry_id": "39da1879-e8b5-3b90-b498-1b704bbb5505",
                        "glosses": [
                            "Salaire, prix payé pour ce transport."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d4cab4d-2168-4fc4-9c04-ad05eea3f2d7",
                        "source_entry_id": "39da1879-e8b5-3b90-b498-1b704bbb5505",
                        "target_lang_word": "Fuhre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fuhre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9def9bbc-c003-3d96-bfc0-2f1b3b5e55ce",
                                        "entry_id": "53571ab6-d3d5-3c04-8508-06ae65602ce7",
                                        "glosses": [
                                            "die Ladung eines (rollenden) Transportmittels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb437b02-5a7a-44a7-a814-a7c0ddc2169b",
                                                "sense_id": "9def9bbc-c003-3d96-bfc0-2f1b3b5e55ce",
                                                "text": "Er griff zur Schubkarre und brachte eine Fuhre Sand."
                                            },
                                            {
                                                "example_id": "37be3434-1306-4748-9cf5-48ece1758bad",
                                                "sense_id": "9def9bbc-c003-3d96-bfc0-2f1b3b5e55ce",
                                                "text": "„Er war wie ein angeschirrtes Pferd, das mit einer Fuhre bergabläuft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7439c4f-006b-35bb-8d67-375323565d77",
                                        "entry_id": "53571ab6-d3d5-3c04-8508-06ae65602ce7",
                                        "glosses": [
                                            "die dem Transport dienende Fahrt (mit einem Wagen)"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a092c5-d554-4413-84b8-d3e472fcc07d",
                                                "sense_id": "f7439c4f-006b-35bb-8d67-375323565d77",
                                                "text": "Kannst du diese Fuhre übernehmen?"
                                            },
                                            {
                                                "example_id": "57f7da16-8383-4c26-b437-5272ba0491a8",
                                                "sense_id": "f7439c4f-006b-35bb-8d67-375323565d77",
                                                "text": "„Währenddessen erledigte Markowitz seinen Auftrag, es soll seine letzte Fuhre sein, danach, so sein Plan, will er sich zur wohlverdienten Ruhe setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ce01fa1-f2c1-4fec-a81a-78c986f2439a",
