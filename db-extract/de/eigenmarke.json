                                        "examples": [
                                            {
                                                "example_id": "c87f96b3-fac0-458d-ae95-e72d68067374",
                                                "sense_id": "7a4d7f3e-5d64-396d-a6cc-d5bd352ea4d8",
                                                "text": "You'd be surprised how many name brand companies produce some private label work for the big box and grocery chains."
                                            },
                                            {
                                                "example_id": "a0d62e71-d2d4-48a5-8a75-50b17a08cb03",
                                                "sense_id": "7a4d7f3e-5d64-396d-a6cc-d5bd352ea4d8",
                                                "text": "This summer, Mondelez International sued Aldi, claiming its private-label cookie line “blatantly copies” the packaging of popular signature snacks like Oreos and Chips Ahoy!"
                                            }
                                        ]
                                    }
                                ]
                            },
