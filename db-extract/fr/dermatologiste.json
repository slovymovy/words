                        "translation_id": "b8a19811-f094-4cd7-b45d-bd1da5b5d3e5",
                        "source_entry_id": "20606445-5eb5-36f0-b72d-8ee42a57e21d",
                        "source_sense_id": "43219d10-8ec7-3ce5-8164-3f3308679117",
