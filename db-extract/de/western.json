                "senses": [
                    {
                        "sense_id": "238e5569-e143-36a4-a00f-94820c291c34",
                        "entry_id": "b26234c0-01cc-3bd1-b588-9ab592f61676",
                        "glosses": [
                            "Filmgenre, dessen Handlung sich im Wilden Westen abspielt"
                        ],
                        "tags": [
                            "Kinematografie"
                        ],
                        "examples": [
                            {
                                "example_id": "e0bbe2a8-add5-48f7-aede-98776b5e8553",
                                "sense_id": "238e5569-e143-36a4-a00f-94820c291c34",
                                "text": "Heute Abend kommt ein guter Western im Fernsehen."
                            },
                            {
                                "example_id": "e9384229-6474-41aa-8305-b65b895439ed",
                                "sense_id": "238e5569-e143-36a4-a00f-94820c291c34",
                                "text": "„1903 kam mit \"Der große Eisenbahnraub\" der erste Western ins Kino, zu einer Zeit also, als es den wilden Westen fast noch tatsächlich gab.“"
                            },
                            {
                                "example_id": "7eaa9544-9bc9-4ba4-9ec9-e294a7e59de4",
                                "sense_id": "238e5569-e143-36a4-a00f-94820c291c34",
                                "text": "„Ein Western wird gedreht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "332a7ddb-4f73-4c7e-97c1-f0acb7ad4155",
                        "source_entry_id": "b26234c0-01cc-3bd1-b588-9ab592f61676",
                        "source_sense_id": "238e5569-e143-36a4-a00f-94820c291c34",
                        "source_sense_description": "Filmgenre, dessen Handlung sich im Wilden Westen abspielt",
                        "target_lang_word": "western",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "western",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb5b48c-b80f-351a-bf45-f04ad7f91aa3",
                                        "entry_id": "d91d7c3e-21ba-3e12-bb07-2f9448255941",
                                        "glosses": [
                                            "Of, facing, situated in, or related to the west."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14ed161c-9c04-4d1e-b626-5c7222d61d0d",
                                                "sense_id": "6cb5b48c-b80f-351a-bf45-f04ad7f91aa3",
                                                "text": "the western approaches"
                                            },
                                            {
                                                "example_id": "67e40e14-bd3c-4b71-8f23-f4ad973822c1",
                                                "sense_id": "6cb5b48c-b80f-351a-bf45-f04ad7f91aa3",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "901baac1-712d-3231-97c6-c8bb0468c414",
                                        "entry_id": "d91d7c3e-21ba-3e12-bb07-2f9448255941",
                                        "glosses": [
                                            "Blowing from the west; westerly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c803687e-1dbf-3c03-b60f-ede76cf0e2f4",
                                        "entry_id": "d91d7c3e-21ba-3e12-bb07-2f9448255941",
                                        "glosses": [
                                            "Occidental."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "806aa9ba-0bbc-43cd-9ebe-258a85c0bcf6",
                                                "sense_id": "c803687e-1dbf-3c03-b60f-ede76cf0e2f4",
                                                "text": "Japanese is traditionally written downwards (tategaki) and you begin reading from the top right of a page. This means that books are opened from what we would consider to be the back. Nowadays, however, books, newspapers and magazines are often written western style, in horizontal lines (yokogaki) from left to right and, in these cases, the book is opened from our (western) understanding of the front."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "western",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68905275-1af5-38d9-9e67-b87865a30af8",
                                        "entry_id": "fac7276c-9c62-34c9-88d6-00ba242893be",
                                        "glosses": [
                                            "A film, or some other dramatic work, set in, the historic (c. 1850–1910) American West (west of the Mississippi river) focusing on conflict between whites and Indians, lawmen and outlaws, ranchers and farmers, or industry (railroads, mining) and agriculture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41774c24-0293-4d05-a549-d483b1c7fbc5",
                        "source_entry_id": "b26234c0-01cc-3bd1-b588-9ab592f61676",
                        "source_sense_id": "238e5569-e143-36a4-a00f-94820c291c34",
                        "source_sense_description": "Filmgenre, dessen Handlung sich im Wilden Westen abspielt",
                        "target_lang_word": "western",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "western",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e9fb45-bb96-3fbe-8314-0b5cf3da341f",
                                        "entry_id": "9c8968ed-4ebd-3c50-a4ad-12e92595e9db",
                                        "glosses": [
                                            "Genre cinématographique dont l’action se situe en Amérique du Nord lors de la conquête de l’Ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9114795e-4b3e-4c77-a8e0-2fe29a3764b5",
                                                "sense_id": "e6e9fb45-bb96-3fbe-8314-0b5cf3da341f",
                                                "text": "Montons sur ce large bureau, allons, mes souvenirs de westerns! Comment attraper un plafonnier au lasso? Oups! Raté!"
                                            },
                                            {
                                                "example_id": "bce23e26-46fc-4bc4-a0c3-65bb80391632",
                                                "sense_id": "e6e9fb45-bb96-3fbe-8314-0b5cf3da341f",
                                                "text": "Le 27 août 1964, dans une petite salle de la banlieue de Florence, le mythe de l'Ouest prend du plomb dans l'aile. Une poignée de spectateurs découvrent un bon petit western rital, maquillé en série B made in USA, qui écorne délibérément la légende imprimée par John Ford."
                                            },
                                            {
                                                "example_id": "9ec9c52f-5bd8-492e-934e-5796e73533d6",
                                                "sense_id": "e6e9fb45-bb96-3fbe-8314-0b5cf3da341f",
                                                "text": "Rien que par ce petit fait, nous pouvons déjà comprendre que le discernement risque d'être parfois bien brouillé, que nous ne sommes décidément pas dans un western où les bons et les méchants sont clairement définis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d058853-aa61-3b4c-86b6-207edd0e08e6",
                                        "entry_id": "9c8968ed-4ebd-3c50-a4ad-12e92595e9db",
                                        "glosses": [
                                            "Style musical québécois se rapprochant du country américain, mais généralement en français."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
