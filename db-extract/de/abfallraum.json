                "senses": [
                    {
                        "sense_id": "452d357e-1ab1-3150-84a2-a2deb61fc541",
                        "entry_id": "2428be8c-99b1-335a-a618-b15632638710",
                        "glosses": [
                            "Raum, in dem Abfall sortiert, gesammelt, gelagert wird und für die Abholung bereitsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96372f74-383e-4fcf-940d-48b268f4f22e",
                                "sense_id": "452d357e-1ab1-3150-84a2-a2deb61fc541",
                                "text": "„Jeder Mitarbeitende ist für die Einhaltung der Abfallraum-Regeln mit verantwortlich und hat sich strikte an die im Abfallraum plakatierten Regeln zu halten“"
                            },
                            {
                                "example_id": "02ddfa39-6f60-42ef-8a51-a6a4894b76cf",
                                "sense_id": "452d357e-1ab1-3150-84a2-a2deb61fc541",
                                "text": "„Alle Abfalltonnen und Säcke sollen in einem Abfallhäuschen oder Abfallraum Platz finden.“"
                            },
                            {
                                "example_id": "2261d846-9cc4-49e6-99e3-b9c705f452dc",
                                "sense_id": "452d357e-1ab1-3150-84a2-a2deb61fc541",
                                "text": "„Bei mehreren Nutzern des Abfallraumes muss eine Nutzungsordnung aufgestellt werden, in welcher auch die Verantwortlichkeiten beschrieben werden.“"
                            },
                            {
                                "example_id": "b4c4f22e-f4e2-4509-9b46-c32221d77b83",
                                "sense_id": "452d357e-1ab1-3150-84a2-a2deb61fc541",
                                "text": "„Im Erdgeschoss des Gebäudes befinden sich der Fahrstuhl, die Briefkästen, ein grosser Abfallraum, eine Waschküche und ein Fahrradraum.“"
                            },
                            {
                                "example_id": "18a180df-22e9-4646-b8a3-9671b7aba659",
                                "sense_id": "452d357e-1ab1-3150-84a2-a2deb61fc541",
                                "text": "„Ebenfalls wird Ihr Abfallraum dadurch aufgeräumter und eine bessere Hygiene wird ebenfalls erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
