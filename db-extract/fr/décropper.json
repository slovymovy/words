                        "glosses": [
                            "Remettre des choses que l’on avait croppées dans une image."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e743b4eb-bd94-47cb-a61e-563feb1ce293",
                                "sense_id": "9b1bec81-ee81-35f5-a2d9-272b2663e2e0",
                                "text": "Et je ferai volontiers un match entre D7100 + 18-55 et EOS M5 + 15-45 (pas facile de décropper un 18 pour obtenir du 15 par exemple...)."
                            },
                            {
                                "example_id": "0b107370-6314-4a06-8bc3-ff3ce55f5e28",
                                "sense_id": "9b1bec81-ee81-35f5-a2d9-272b2663e2e0",
                                "text": "Tu peux décropper un tout petit peu ?"
                            },
                            {
                                "example_id": "5e8e34ec-daa6-4961-8b45-f124d422e6cf",
                                "sense_id": "9b1bec81-ee81-35f5-a2d9-272b2663e2e0",
                                "text": "Il ne reste plus qu'à faire la même photo avec le D750 et 24-120 et à cropper à portion équivalente (donc à + de 100%) ou décropper celle du D850 pour qu'elle corresponde à la portion à 100% du D750 (donc à - de 100%) pour vraiment voir la différence."
                            },
                            {
                                "example_id": "1f6bbfdb-5571-4c8c-812c-eb112ff29156",
                                "sense_id": "9b1bec81-ee81-35f5-a2d9-272b2663e2e0",
                                "text": "je décroppe un peu, parce que ça semble plus dur que prévu."
                            }
