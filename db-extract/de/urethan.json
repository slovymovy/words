                "senses": [
                    {
                        "sense_id": "ac15a434-0b4b-30d8-81e0-ae0fc739ac97",
                        "entry_id": "e6307c78-9e57-3c5c-82a7-423644285772",
                        "glosses": [
                            "Ester der Carbamidsäuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74cdae8d-3ad3-4810-ae65-cddd0bf7186c",
                                "sense_id": "ac15a434-0b4b-30d8-81e0-ae0fc739ac97",
                                "text": "„Grundgerüst ist ein Endo-Skelett aus Urethan, das für alle Flex-Eigenschaften des Boots verantwortlich ist.“"
                            },
                            {
                                "example_id": "0ebd79e8-ecdb-48f1-ac72-687a5b2b2dd8",
                                "sense_id": "ac15a434-0b4b-30d8-81e0-ae0fc739ac97",
                                "text": "„Geschätzte 7,8 Millionen Bälle werden jährlich in Deutschland verkauft. Zwischen 80 Cent und 8 Euro muss man hinblättern - viele Modelle sind High-Tech-Produkte, die mit Titanium oder Urethan veredelt sind.“"
                            },
                            {
                                "example_id": "403dcf66-f995-4671-b3f3-8ef40a8f79e1",
                                "sense_id": "ac15a434-0b4b-30d8-81e0-ae0fc739ac97",
                                "text": "„Urethane wurden als Carbamidsäurederivate 1834 hergestellt und 1886 als Hypnotika eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
