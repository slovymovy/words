                "senses": [
                    {
                        "sense_id": "e412afe7-8d99-3de4-ab65-3e249dc204f8",
                        "entry_id": "915d54fb-0fe9-3fe0-916d-5925ea5c1637",
                        "glosses": [
                            "Donner ou attribuer un caractère rappelant l’humoriste Dieudonné à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf4002b-5981-4676-a2cb-46e579dfc478",
                                "sense_id": "e412afe7-8d99-3de4-ab65-3e249dc204f8",
                                "text": "Et si en plus tu oses faire le moindre parallèle entre sa religion et l'argent, tu te fais \"Dieudonnéiser\" LOL!"
                            },
                            {
                                "example_id": "c0fd0ff2-8db9-4fed-a9fe-e2bfa40744f9",
                                "sense_id": "e412afe7-8d99-3de4-ab65-3e249dc204f8",
                                "text": "Ils testent leur pouvoir, la corporation des journalistes de gauche tente de l'éloigner des antennes, de le Soraliser ou le Dieudonnéiser."
                            },
                            {
                                "example_id": "153cc11c-da12-4441-8a2a-281822e1a4a0",
                                "sense_id": "e412afe7-8d99-3de4-ab65-3e249dc204f8",
                                "text": "Tu es dieudonnéisé."
                            },
                            {
                                "example_id": "3c755792-5661-4ab0-b532-0846ba881a6d",
                                "sense_id": "e412afe7-8d99-3de4-ab65-3e249dc204f8",
                                "text": "Probablement qu'ils ont eu peur de se faurissoniser, de se dieudonnéiser ou même de s'onfrayiser."
                            },
                            {
                                "example_id": "d07e9014-19c2-4905-94e9-6d13f1aa76ed",
                                "sense_id": "e412afe7-8d99-3de4-ab65-3e249dc204f8",
                                "text": "En matière de bibine, je suis pour la paix des ménages, je n'ai aucune envie de me faire « Dieudonnéiser »."
                            }
                        ]
                    }
                ],
