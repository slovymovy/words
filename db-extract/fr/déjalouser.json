                "senses": [
                    {
                        "sense_id": "1a9bcc8c-fba2-3e56-a536-33cf4d5b6295",
                        "entry_id": "0904be4c-2985-313b-935e-0dd1acecb323",
                        "glosses": [
                            "Faire cesser d’être jaloux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b008675-2f72-442f-a7b5-a4b8fd813fc3",
                                "sense_id": "1a9bcc8c-fba2-3e56-a536-33cf4d5b6295",
                                "text": "Merci pour tous les compliments, mais pour te déjalouser, mes cheveux, y en a qui sont pas à moi"
                            },
                            {
                                "example_id": "07fa5f6e-2a3a-429f-af3a-3a852583cd66",
                                "sense_id": "1a9bcc8c-fba2-3e56-a536-33cf4d5b6295",
                                "text": "Pour vous accompagner du mieux possible dans vos tentatives pour vous « déjalouser »;"
                            },
                            {
                                "example_id": "90d1ba51-b597-4c17-b178-960162f788f6",
                                "sense_id": "1a9bcc8c-fba2-3e56-a536-33cf4d5b6295",
                                "text": "Je fonce sus à la jalousie. Je la déjalouse à grandes sabrures."
                            }
                        ]
                    }
