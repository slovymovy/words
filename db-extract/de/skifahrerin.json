                ],
                "senses": [
                    {
                        "sense_id": "a259b1ca-d66a-3106-b305-d1c999cceaed",
                        "entry_id": "a09cd450-2b03-31c1-aa55-aa4c7d34a26c",
                        "glosses": [
                            "weibliche Person, die Ski fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0b5347-d1e2-44e7-a195-a31f91203406",
                                "sense_id": "a259b1ca-d66a-3106-b305-d1c999cceaed",
                                "text": "Auf der Piste messe ich mich gern mit ausländischen Skifahrerinnen."
                            },
                            {
                                "example_id": "de39aa3a-4bac-41ad-ba01-de4ba87d2423",
                                "sense_id": "a259b1ca-d66a-3106-b305-d1c999cceaed",
                                "text": "Unter den Neuankömmlingen waren einige attraktive Skifahrerinnen."
                            },
                            {
                                "example_id": "3c74a8a9-75ca-40e1-bbc1-510221290ea2",
                                "sense_id": "a259b1ca-d66a-3106-b305-d1c999cceaed",
                                "text": "Als erfahrene Skifahrerin rate ich dir von deinem Vorhaben ab."
                            },
                            {
                                "example_id": "980e1cb5-980b-4b64-a55f-d943a916eee0",
                                "sense_id": "a259b1ca-d66a-3106-b305-d1c999cceaed",
                                "text": "„Sie war selbst eine hervorragende Tennisspielerin und eine gute Skifahrerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bd0f3c6-77c3-45bf-9470-8f00627160c4",
                        "source_entry_id": "a09cd450-2b03-31c1-aa55-aa4c7d34a26c",
                        "source_sense_id": "a259b1ca-d66a-3106-b305-d1c999cceaed",
                        "source_sense_description": "Sport: weibliche Person, die Ski fährt",
                        "target_lang_word": "skier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73a1d907-372d-3037-88eb-c416067b314b",
                                        "entry_id": "e23b71b2-7510-34ba-b05a-b65890572ee4",
                                        "glosses": [
                                            "One who skis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0fbc0b6-2e09-4ad1-974f-bdcbacae8dbb",
                                                "sense_id": "73a1d907-372d-3037-88eb-c416067b314b",
                                                "text": "a professional skier"
                                            },
                                            {
                                                "example_id": "c881799b-11fa-4c81-b061-dfc9051725c9",
                                                "sense_id": "73a1d907-372d-3037-88eb-c416067b314b",
                                                "text": "a poor skier"
                                            },
                                            {
                                                "example_id": "bf1c05ff-b645-4507-8262-32b0dab8f2aa",
                                                "sense_id": "73a1d907-372d-3037-88eb-c416067b314b",
                                                "text": "Some ski instructors are allowed to take groups off-piste too, so long as they don't travel across glaciers, but the tour hosts and reps who commonly show skiers around pisted runs within large resorts are definitely not allowed to go off-piste […]"
                                            },
                                            {
                                                "example_id": "08396532-4db2-4968-879b-ce96ecbd7134",
                                                "sense_id": "73a1d907-372d-3037-88eb-c416067b314b",
                                                "text": "Townsend hare inhabit this area, particularly above the cabin, and a skier is likely to have one explode from a tree well and disappear into the whiteness as he skis by. Life is a constant bivouac for them -- they spend days huddled in tree wells during storms -- but I suspect they are as content and warm in their luxurious coats as we are in a cabin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4627ce7d-6f97-3296-bc1e-23dca316f470",
                                        "entry_id": "fb6df4bb-434e-3e70-94cb-30c2a2e2c29b",
                                        "glosses": [
                                            "A ball hit high in the air, often leading to a catch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d009b0-cb4c-4566-b191-73666e20e704",
                                                "sense_id": "4627ce7d-6f97-3296-bc1e-23dca316f470",
                                                "text": "However, when Guha returned, she picked the wrong ball to pull and hit a skier to Charlotte Edwards."
                                            },
                                            {
                                                "example_id": "8f7866b4-513f-4e11-8f7d-b97b4f091c39",
                                                "sense_id": "4627ce7d-6f97-3296-bc1e-23dca316f470",
                                                "text": "The second thing I did my best to get out of was the unpleasant position Monty found himself in rather too often in Sri Lanka: standing under a skier in the deep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4f1eb09-bfe6-4eae-b054-9df120ba59e0",
                        "source_entry_id": "a09cd450-2b03-31c1-aa55-aa4c7d34a26c",
                        "source_sense_id": "a259b1ca-d66a-3106-b305-d1c999cceaed",
                        "source_sense_description": "Sport: weibliche Person, die Ski fährt",
                        "target_lang_word": "skieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f5bd9dd-fd05-35dd-a7cf-2c668a459abf",
                                        "entry_id": "f63b9c46-1d7e-31b0-804a-e0f830b61187",
                                        "glosses": [
                                            "Femme pratiquant le ski."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7ce590-eb36-40cb-9f47-182a2cfd9ead",
                                                "sense_id": "3f5bd9dd-fd05-35dd-a7cf-2c668a459abf",
                                                "text": "Bien que je ne souhaite aucun malheur à nos skieuses, j’aimerais mieux être dans la position de Shiffrin."
                                            },
                                            {
                                                "example_id": "7bc48481-3f50-49a6-8d78-52d39bcd34d0",
                                                "sense_id": "3f5bd9dd-fd05-35dd-a7cf-2c668a459abf",
                                                "text": "Les skieurs et skieuses alpins du groupe France étaient réunis cette semaine à Zagreb."
                                            },
                                            {
                                                "example_id": "ac0e4c57-2e5b-48f6-ab59-e432d198af32",
                                                "sense_id": "3f5bd9dd-fd05-35dd-a7cf-2c668a459abf",
                                                "text": "La skieuse de Vail (Colorado) peut désormais viser un cinquième gros globe de cristal pour, cette fois, dépasser sa compatriote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
