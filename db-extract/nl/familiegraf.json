                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e7b15b-2e9e-4014-bc28-1f74d245d98c",
                                "sense_id": "912267ed-5d51-327e-adfa-420db550c64f",
                                "text": "De vorige week overleden oud-president George Bush senior is bijgezet in het familiegraf in Texas. De kist werd met een speciale trein vervoerd. Veel mensen stonden langs de route om de laatste eer te bewijzen."
                            },
                            {
                                "example_id": "90eee7ed-9553-4d1a-b4fb-855ae5dd6ade",
                                "sense_id": "912267ed-5d51-327e-adfa-420db550c64f",
                                "text": "Familieleden mochten bij de begrafenis aanwezig zijn. Volgens een zoon had de familie Morsi willen bijzetten in het familiegraf in zijn geboorteplaats ten noorden van Caïro, maar stonden de autoriteiten dat niet toe."
                            }
                        ]
                    }
