                    },
                    {
                        "translation_id": "7e0bd0ad-4ef3-4c0d-ba08-974c3563952e",
                        "source_entry_id": "1634c3cb-2b28-3165-bfff-b2559444a70e",
                        "source_sense_id": "3e9faa59-c1d5-34b9-a3c4-7593783de970",
                        "source_sense_description": "diejenigen Leute, die zum engen Umfeld einer Person gehören und die ihre Gefolgschaft bilden",
                        "target_lang_word": "entourage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entourage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0add0f3b-0a40-30af-801f-a3fe17f08d00",
                                        "entry_id": "95b9c28a-1186-37a3-8469-8e357c147e0a",
                                        "glosses": [
                                            "Ce qui entoure un objet, en guise d’ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6216c9fe-1b2f-4f06-add2-54d3dad8d4e5",
                                                "sense_id": "0add0f3b-0a40-30af-801f-a3fe17f08d00",
                                                "text": "Entourage de fleurs, de perles."
                                            },
                                            {
                                                "example_id": "1430041d-c921-492a-9696-6833576450bf",
                                                "sense_id": "0add0f3b-0a40-30af-801f-a3fe17f08d00",
                                                "text": "Elle prit un solide bâton, qu’elle aiguisa d’un bout avec son couteau, puis elle se fit un entourage de fagots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521179d2-b90c-3d89-9589-9ce9dc171618",
                                        "entry_id": "95b9c28a-1186-37a3-8469-8e357c147e0a",
                                        "glosses": [
                                            "Ensemble de ceux qui entourent ordinairement quelqu’un, qui vivent dans sa familiarité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "559880ce-51bc-4824-a9df-a989c3427845",
                                                "sense_id": "521179d2-b90c-3d89-9589-9ce9dc171618",
                                                "text": "Son absence durait un an, deux ans. Et puis, un beau soir, sans que personne de son entourage fût prévenu, il reparaissait soudainement."
                                            },
                                            {
                                                "example_id": "dcd93638-5bc7-498f-99c2-1728972db068",
                                                "sense_id": "521179d2-b90c-3d89-9589-9ce9dc171618",
                                                "text": "[…] ; mais j'ai tout lieu de supposer que dans le brillant entourage de ce bonisseur, il n'y a personne ayant entendu parler du Mouvement socialiste."
                                            },
                                            {
                                                "example_id": "ee48adcc-a21f-4fc2-b5a8-f7edc266c029",
                                                "sense_id": "521179d2-b90c-3d89-9589-9ce9dc171618",
                                                "text": "Ainsi Coitier s'est vite fait une place importante dans ce cénacle de médecins qui vivent dans l’entourage de Louis XI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da76f306-536d-3bd8-8f98-06fe72a61fcc",
                                        "entry_id": "95b9c28a-1186-37a3-8469-8e357c147e0a",
                                        "glosses": [
                                            "Mur de briques rouges (le mur peut être à intérieur d'une maison ou à l'extérieur d'une maison)."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
