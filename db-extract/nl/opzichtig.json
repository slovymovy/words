                        "glosses": [
                            "bedoeld om in het oog te vallen, vaak op banale wijze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98d8e1fb-661c-4fb1-a21e-a7c961c7a707",
                                "sense_id": "2c8e798b-da54-3a99-b378-04f5b4f755bf",
