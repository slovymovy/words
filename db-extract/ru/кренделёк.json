                        "examples": [
                            {
                                "example_id": "f436b055-c865-49ff-927e-4af39023ad7c",
                                "sense_id": "8b090e07-98a2-3113-b5c3-373f017bd364",
                                "text": "Да́лее Ку́нин ви́дел, как его́ гость взял из суха́рницы оди́н кренделёк, откуси́л от него́ кусо́чек, пото́м поверте́л в рука́х и бы́стро су́нул его́ себе́ в карма́н.",
                                "translation": "Then Kunin saw his visitor take a biscuit from the cake-basket, nibble a little bit off it, then turn it over in his hand and hurriedly stick it in his pocket.",
                                "english": "Then Kunin saw his visitor take a biscuit from the cake-basket, nibble a little bit off it, then turn it over in his hand and hurriedly stick it in his pocket."
                            }
                        ]
                    }
