                "senses": [
                    {
                        "sense_id": "6614b8a8-9791-3115-9c50-733c1b37153d",
                        "entry_id": "837d4e95-542e-3c8f-9cb9-b04db1b4b0f8",
                        "glosses": [
                            "Donner un caractère pignouf à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f1e2d9-21a2-4cdb-a99b-959a45dcbfef",
                                "sense_id": "6614b8a8-9791-3115-9c50-733c1b37153d",
                                "text": "Tout est parti de l'envie de pignoufiser Hubert Reeves (avec l'idée d'un fond étoilé) et Yves Coppens (en Indiana Jones), après avoir vus l'un puis l'autre dans Nulle part ailleurs."
                            },
                            {
                                "example_id": "1240f565-7638-4fa0-b0b9-5572fd6c464c",
                                "sense_id": "6614b8a8-9791-3115-9c50-733c1b37153d",
                                "text": "Une famille qui s'est enrichie petit à petit, au fur et à mesure de mes coups de coeur et de mes envies de pignoufiser certains héros."
                            },
                            {
                                "example_id": "d4ba43ba-2ecd-43e4-acfe-8798f27b5a1f",
                                "sense_id": "6614b8a8-9791-3115-9c50-733c1b37153d",
                                "text": "Je crains me pignoufiser aussi."
                            }
                        ]
                    }
                ],
