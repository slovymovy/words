                "senses": [
                    {
                        "sense_id": "471abfd4-0012-3348-835a-51ff8eb368d5",
                        "entry_id": "da4b4717-e045-337d-b31d-3e24eece93e5",
                        "glosses": [
                            "relativ schwache Beleuchtung eines Kraftfahrzeugs, die beim Halten im Dunkeln angeschaltet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77fea5a2-96b6-45ee-98c9-d5277e0c2959",
                                "sense_id": "471abfd4-0012-3348-835a-51ff8eb368d5",
                                "text": "„Vor allem auf den Strecken über Land würde die Geschwindigkeit häufig stark überschritten, außerdem führen etliche Fahrzeuge des nachts ohne Licht oder nur mit Standlicht.“"
                            },
                            {
                                "example_id": "93bf229a-b3fa-441d-9336-2e545495980f",
                                "sense_id": "471abfd4-0012-3348-835a-51ff8eb368d5",
                                "text": "„Taxis warten mit Standlicht auf der Straße.“"
                            },
                            {
                                "example_id": "b253a368-3786-4d1a-97dd-a7bc7727f49e",
                                "sense_id": "471abfd4-0012-3348-835a-51ff8eb368d5",
                                "text": "„Der Motor ging aus und kurz wurde es dunkler, als die Scheinwerfer auf Standlicht sprangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
