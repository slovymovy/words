                    {
                        "sense_id": "8880d6a3-93ca-36b9-b69d-25ceb9d884fc",
                        "entry_id": "ac9bfd9d-0352-38a0-9eca-7b494b728988",
                        "glosses": [
                            "The class of literature comprising poems."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ed42f72d-c585-4e23-9c48-fb52c5a87e83",
                                "sense_id": "8880d6a3-93ca-36b9-b69d-25ceb9d884fc",
                                "text": "I know not well how to excuse him, in that hee deemed his Poesie worthy to be published."
                            },
                            {
                                "example_id": "e33a8166-97f1-40ab-a97d-cd94aaaf0029",
                                "sense_id": "8880d6a3-93ca-36b9-b69d-25ceb9d884fc",
                                "text": "We know a poetical young gentleman—a very poetical young gentleman. We do not mean to say that he is troubled with the gift of poesy in any remarkable degree, but his countenance is of a plaintive and melancholy cast, his manner is abstracted and bespeaks affliction of soul:[…]"
                            }
                        ]
                    }
