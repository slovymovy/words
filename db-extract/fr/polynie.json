        "fr-extract.jsonl": [
            {
                "entry_id": "b1c83c1d-5e0f-3bbd-beef-23673b5b50b9",
                "word": "polynie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "811fe79a-a369-4c75-b726-f16eb78512b8",
                        "entry_id": "b1c83c1d-5e0f-3bbd-beef-23673b5b50b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "polynies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
                        "entry_id": "b1c83c1d-5e0f-3bbd-beef-23673b5b50b9",
                        "glosses": [
                            "Zone qui reste libre de glace au milieu de la banquise formée d’eau de mer en Arctique ou en Antarctique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7adeb77-ba68-4431-a696-04dbe89e926e",
                                "sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
                                "text": "Le vent – nigiq – tourne en effet au sud-ouest. Piquant, il se charge d’humidité au-dessus des polynies, espaces d’eau libre de la vaste baie de Melville ; le royaume de Thulé est isolé du Grand Sud par une de ces polynies, parfois transformée en champ de glace hummockée."
                            },
                            {
                                "example_id": "d27714cf-2f6a-4278-959c-32064f65c9d2",
                                "sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
                                "text": "Ces étendues dépourvues de glace, appelées « polynies », peuvent se former dans l’océan Arctique ou son pendant austral, l’océan Antarctique, mais il est rare qu’ils atteignent cette taille, surtout aussi loin du large."
                            },
                            {
                                "example_id": "b517a34a-2dc7-4f12-ae93-5c7ef5c3e532",
                                "sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
                                "text": "Une sorte de piste entre le navire et la future Mirny servait jour et nuit. En cas de polynie et de failles, on posait en travers rondins et planches."
                            },
                            {
                                "example_id": "7f12f8cc-38e9-45ee-8204-e4b82f27222b",
                                "sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
                                "text": "Cela leur a permis de réaliser que les anciens Nordiques se procuraient de l'ivoire jusque dans les eaux de l'Extrême-Arctique, «en particulier de la polynie des eaux du Nord, et peut-être de l’intérieur de l’Arctique canadien»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81140440-ab0a-4773-b7fb-d3af7495be24",
                        "source_entry_id": "b1c83c1d-5e0f-3bbd-beef-23673b5b50b9",
                        "source_sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
                        "target_lang_word": "polynia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polynia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b67a94c9-4b0a-3b29-9e48-890704129b17",
                                        "entry_id": "ed682033-4d09-30fa-b4c1-19ceed703fc2",
                                        "glosses": [
                                            "Alternative spelling of polynya."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3693dc4-233b-4832-b037-97d2809fdc94",
                                                "sense_id": "b67a94c9-4b0a-3b29-9e48-890704129b17",
                                                "text": "We immediately ascended a hill, and saw that the supposed land was nothing but hummocks of ice, piled up beyond a large Polynia, or space of open water, which extended from east to west, as far as the eye could reach."
                                            },
                                            {
                                                "example_id": "3d46adbb-c27c-4894-9ede-dbd3fdec4712",
                                                "sense_id": "b67a94c9-4b0a-3b29-9e48-890704129b17",
                                                "text": "Dr. [Ian] Stirling pointed out that colonies of nesting sea-birds were an indicator of permanent polynias and that the productivity studies in such polynias might prove interesting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f75cd9ec-7915-414b-9e04-4f898c5e3f55",
                        "source_entry_id": "b1c83c1d-5e0f-3bbd-beef-23673b5b50b9",
                        "source_sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
                        "target_lang_word": "полынья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "полынья",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d29f6528-b838-3f98-b782-3bfd578de88a",
                                        "entry_id": "5aeab9f1-94d2-324b-8244-a8c02bbd7d60",
                                        "glosses": [
                                            "незамёрзший или протаявший участок на воде, промежуток среди льда, покрывающего водоём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06c5259a-9628-4a72-a445-d46b3dcf47da",
                                                "sense_id": "d29f6528-b838-3f98-b782-3bfd578de88a",
                                                "text": "То он, Резанов, упал в прорубь, то он провалился в полынью, а недавно последовало уточнение, что он провалился в полынью вместе с лошадью."
                                            },
                                            {
                                                "example_id": "6bf71d2d-cb7d-4b0e-b8e6-894c4cde5633",
                                                "sense_id": "d29f6528-b838-3f98-b782-3bfd578de88a",
                                                "text": "Буер попал в полынью одним коньком."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5a3c42-d260-42aa-81bf-438659b38613",
                        "source_entry_id": "b1c83c1d-5e0f-3bbd-beef-23673b5b50b9",
                        "source_sense_id": "e9f7001d-b022-3f90-9bbd-257b8fe6f8fd",
