                        "sense_id": "ee1b1917-2375-3169-bf31-b40fdf1855a7",
                        "entry_id": "576aea66-316d-3cb1-9bef-00c87e62d924",
                        "glosses": [
                            "Qui est susceptible d’être perfectionné ou de se perfectionner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ebbc7b-02d7-4a0f-a08f-1bdd0055a81b",
                                "sense_id": "ee1b1917-2375-3169-bf31-b40fdf1855a7",
                                "text": "L’homme est de sa nature un être perfectible."
                            },
                            {
                                "example_id": "c5bd3da2-ea18-4dd3-8357-632e8ea74fec",
                                "sense_id": "ee1b1917-2375-3169-bf31-b40fdf1855a7",
                                "text": "Comment pourrait-on t’aimer, car tu n’es même pas une personne, une créature définie, imparfaite, mais du moins perfectible. Tu es une eau informe qui coule selon la pente qu’on lui offre, un poisson sans mémoire et sans réflexion qui tant qu’il vivra dans son aquarium se heurtera cent fois par jour contre le vitrage qu’il continuera à prendre pour de l’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a69e2f2-785d-3589-9d12-2674a9bd1e6c",
                        "entry_id": "576aea66-316d-3cb1-9bef-00c87e62d924",
                        "glosses": [
                            "Qui est susceptible d'améliorations, d'amendements, de corrections."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
