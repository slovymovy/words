                "senses": [
                    {
                        "sense_id": "5b3b2567-c703-350b-8bd9-4e58cfff7d04",
                        "entry_id": "5bf4d0b6-017b-3f0a-99b4-bd9270103d66",
                        "glosses": [
                            "Sylvia curruca, niewielki ptak eurazjatycki wijący gniazda wewnątrz ciernistych krzewów lub żywopłotów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d14b3e4-067e-4cf8-b1eb-cc81030ff8b7",
                                "sense_id": "5b3b2567-c703-350b-8bd9-4e58cfff7d04",
                                "text": "Wyszedł z drumli głos cudny, aż rozbrzmiały echa, i zaraz w zaroślach odezwały się drozdy, zięby, sikorki, piegże i inne drobne ptactwo, jakby ukryta kapela, co tylko znaku czeka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d355dd6-0ede-4c45-84db-44ffcfcfa93a",
                        "source_entry_id": "5bf4d0b6-017b-3f0a-99b4-bd9270103d66",
