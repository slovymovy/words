                ],
                "senses": [
                    {
                        "sense_id": "cef86d4f-9032-379f-8153-575913cc34f0",
                        "entry_id": "7cf0bf24-914a-3276-8c61-2625255263c9",
                        "glosses": [
                            "Bénéficier de l'air et du soleil."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d4fcd987-fd70-4699-9da6-e63ebbbc532a",
                                "sense_id": "cef86d4f-9032-379f-8153-575913cc34f0",
                                "text": "[…], mais je me sentirais embarrassé s'il me surprenait en pleine contemplation des naturistes pentalfiens. Ils ne font rien de mal pourtant, au contraire, ils se vitaminent, ils s'oxygènent, ils se chlorophyllent."
                            },
                            {
                                "example_id": "41a38381-8853-45cf-9130-fb4c3c78362c",
                                "sense_id": "cef86d4f-9032-379f-8153-575913cc34f0",
                                "text": "On se contourne les rives du Papabezpa. La vibrante nature ignore les exactions des hommes et continue de chlorophyller sous le soleil."
                            },
                            {
                                "example_id": "704a3e7d-b0f9-4bdd-9631-9c14e2e5352a",
                                "sense_id": "cef86d4f-9032-379f-8153-575913cc34f0",
                                "text": "En vue de chlorophyller nos esprits, nous gagnâmes le parc des Moutiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ae699e7-6b93-3499-8c7c-fe5074f5421f",
                        "entry_id": "7cf0bf24-914a-3276-8c61-2625255263c9",
                        "glosses": [
                            "Apporter de la verdure à."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5ac1835d-945a-48a5-aeb8-f0cdf45a3aa2",
                                "sense_id": "6ae699e7-6b93-3499-8c7c-fe5074f5421f",
                                "text": "[…], le siècle est jalonné par des projets de « ville paysagère », sans que la trajection, dont parle Augustin Berque, soit évoquée, seul le désir d'oxygéner, de chlorophyller domine leur louable intention !"
                            },
                            {
                                "example_id": "8e4e31a0-fe48-44a2-b7dd-54767f777a68",
                                "sense_id": "6ae699e7-6b93-3499-8c7c-fe5074f5421f",
                                "text": "D'autres graines d'idées sont en germination dans la commission d'embellissement pour «chlorophyller» un peu plus notre village."
                            }
                        ]
                    },
                    {
                        "sense_id": "45eeb6dc-2898-31fa-916f-90ce37a3850c",
                        "entry_id": "7cf0bf24-914a-3276-8c61-2625255263c9",
                        "glosses": [
                            "Traiter à la chlorophylle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5e1053-7c42-4e0b-81e1-42d3183a596a",
                                "sense_id": "45eeb6dc-2898-31fa-916f-90ce37a3850c",
                                "text": "[…] : les parquets des chambres étaient si vétustes que l'on craignait, en les mouillant de les pourrir à jamais ; on ne les lavait plus ; on les frottait avec de l'herbe, on les chlorophyllait, on les brunissait, on les revigorait."
                            }
                        ]
                    }
