                "senses": [
                    {
                        "sense_id": "be7a6b54-c0eb-3861-8682-f6943f88b159",
                        "entry_id": "7862d228-5b35-3d69-9565-8a703a23fd68",
                        "glosses": [
                            "eine spezielle Wasserpfeife, die meist aus Acryl, Glas oder Kunststoff gefertigt ist und zum Konsumieren primär von Drogen wie Marihuana und Haschisch dient, auch für Tabak verwendet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7553aa34-678f-4c2d-8513-c4c8efa351b4",
                                "sense_id": "be7a6b54-c0eb-3861-8682-f6943f88b159",
                                "text": "Jonas nahm die Bong zur Feier mit."
                            },
                            {
                                "example_id": "6cd7f05c-ac8f-4d56-a507-cd20a8d59d2d",
                                "sense_id": "be7a6b54-c0eb-3861-8682-f6943f88b159",
                                "text": "„Cannabisprodukte werden zumeist geraucht, in Form von Joints oder mittels Pfeife, Bong oder Schillum.“"
                            },
                            {
                                "example_id": "c9bdf5ce-00cc-4f02-be92-69369e3f6b3f",
                                "sense_id": "be7a6b54-c0eb-3861-8682-f6943f88b159",
                                "text": "„Mit zehn begann er, Bong zu rauchen – auf einem Hügel hinterm Haus, den die Büsche vor den Blicken der Betreuer schützten.“"
                            },
                            {
                                "example_id": "901c94fe-69b0-400f-a309-2e575ff68356",
                                "sense_id": "be7a6b54-c0eb-3861-8682-f6943f88b159",
                                "text": "„Als Hardcore-Kiffer nahm Marcel es dann mit Gleichmut hin, dass er nach einer wie üblich traumlosen Nacht bereits am folgenden Vormittag zum Eidbrecher wurde und sich eine erste Bong entflammte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
