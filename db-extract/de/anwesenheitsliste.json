                ],
                "senses": [
                    {
                        "sense_id": "4531d4a4-43cf-32ea-a75b-56971bff2b53",
                        "entry_id": "6df2fdcc-bd0e-30c6-ba20-6462d96fefb1",
                        "glosses": [
                            "Liste, die die Namen der anwesenden Personen enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21bc5807-6831-42c7-9673-65cb84e2cf9f",
                                "sense_id": "4531d4a4-43cf-32ea-a75b-56971bff2b53",
                                "text": "„Ein Blick auf die Anwesenheitsliste seit Mai 2016 zeigt: Der Außenminister hat – teilweise bedingt durch Auslandsaufenthalte – fast jeden zweiten Termin nicht wahrgenommen.“"
                            },
                            {
                                "example_id": "81dbb7d7-bf4c-4596-8c2b-9fcd3d64a3d3",
                                "sense_id": "4531d4a4-43cf-32ea-a75b-56971bff2b53",
                                "text": "„Gemäss Anwesenheitsliste schwänzte kein einziges der 125 Ratsmitglieder die Sitzung, was sie anerkennend verkündete.“"
                            },
                            {
                                "example_id": "470bdcc1-9c80-4cf4-bc7d-34c1a7026f39",
                                "sense_id": "4531d4a4-43cf-32ea-a75b-56971bff2b53",
                                "text": "„Nun, gut ein Jahr nach den Protesten, hat sich die Lage aus Sicht der Studierenden zwar verbessert; aber abgeschafft sind die ungeliebten Anwesenheitslisten noch immer nicht überall.“"
                            },
                            {
                                "example_id": "f666bc42-d82b-4cdb-942e-b0dcba9ce072",
                                "sense_id": "4531d4a4-43cf-32ea-a75b-56971bff2b53",
                                "text": "„Sie verschulten die Universität und machten die Seminarräume mit den Anwesenheitslisten zu den langweiligsten Orten der Bundesrepublik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
