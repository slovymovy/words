                "senses": [
                    {
                        "sense_id": "6c0c7ae7-117e-377a-a94d-1bd484b0ed66",
                        "entry_id": "c7ed75e0-03a6-3734-9d20-dee774ca034f",
                        "glosses": [
                            "het verschijnsel dat een klank in een taal vervangen wordt door een andere klank (vooral als dit regelmatig en in relatief korte tijd gebeurt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969bee76-5c71-4721-b4d2-ac1b2e7b6f06",
                                "sense_id": "6c0c7ae7-117e-377a-a94d-1bd484b0ed66",
                                "text": "In het Oudnederlands is een klankverschuiving opgetreden waarbij een /f/ voor een /t/ in een /x/ veranderde, waardoor we nu het woord lucht hebben in plaats van luft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2914aef8-9b10-4aab-ba66-8fe1b0e12368",
                        "source_entry_id": "c7ed75e0-03a6-3734-9d20-dee774ca034f",
                        "source_sense_id": "6c0c7ae7-117e-377a-a94d-1bd484b0ed66",
                        "source_sense_description": "het verschijnsel dat een klank in een taal in de loop van de tijd vervangen wordt door een andere klank",
                        "target_lang_word": "Lautverschiebung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lautverschiebung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c2cc6d-a7dc-3a8b-9ce7-ea26cbf8bde2",
                                        "entry_id": "7bc41d53-1173-3fe1-b661-1bad2735ae79",
                                        "glosses": [
                                            "Veränderung des Systems der Laute von einem Entwicklungsstadium einer Sprache zum nächsten"
                                        ],
                                        "tags": [
                                            "Historiolinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "204ad6c1-e22f-4ff6-8a0c-9032702d78c2",
                                                "sense_id": "e0c2cc6d-a7dc-3a8b-9ce7-ea26cbf8bde2",
                                                "text": "„Diese Entwicklung wird die germanische oder erste Lautverschiebung genannt und ist in allen germanischen Sprachen vorhanden.“"
                                            },
                                            {
                                                "example_id": "494edc62-5379-4b80-bc6a-5bf593435418",
                                                "sense_id": "e0c2cc6d-a7dc-3a8b-9ce7-ea26cbf8bde2",
                                                "text": "„Die sogenannte zweite Lautverschiebung führt durch Veränderungen im Konsonantensystem zur Ausgliederung des Deutschen bzw. seiner ‚hochdeutschen‘ Dialekte aus den germanischen Sprachen.“"
                                            },
                                            {
                                                "example_id": "7b3801e7-7d90-49f1-b4c9-e0243101a9ab",
                                                "sense_id": "e0c2cc6d-a7dc-3a8b-9ce7-ea26cbf8bde2",
                                                "text": "„Es war die sogenannte zweite Lautverschiebung, mit der das Deutsche entstand. Bei der verschieben sich die stimmlosen Verschlusslaute, also p, t, k, zu Doppelkonsonanten: p zu pf, t zu tz, k zu kch im Anlaut, innerhalb eines Wortes zu Reibelauten. Wer es lieber anschaulich hat: Diese Lautverschiebung ist dafür verantwortlich, dass es auf Deutsch Pflug heißt, auf Englisch aber plough, auf deutsch offen, auf Englisch aber open, oder Pfeffer (englisch pepper).“"
                                            },
                                            {
                                                "example_id": "3ffdbb87-1db0-4111-a49a-ebe071bed3f6",
                                                "sense_id": "e0c2cc6d-a7dc-3a8b-9ce7-ea26cbf8bde2",
                                                "text": "„Das gilt für bestimmte lautliche Unterschiede, von denen die bekanntesten die durch die Lautverschiebung bewirkten sind; die Lautverschiebungen (ik/ich, maken/machen, Dorp/Dorf, dat/das, Appel/Appel) decken sich nicht, sondern öffnen sich zum - von Theodor Frings so benannten - »Rheinischen Fächer«.“"
                                            },
                                            {
                                                "example_id": "fdd01782-3746-44ba-afe7-fce80bc3676b",
                                                "sense_id": "e0c2cc6d-a7dc-3a8b-9ce7-ea26cbf8bde2",
                                                "text": "„Aus den gemeinsamen Anfängen der indogermanischen Sprachfamilie, zu der auch Griechisch, Persisch oder Sanskrit gehören, hat sich im Zuge der ersten oder germanischen Lautverschiebung eine Art Urgermanisch entwickelt.“"
                                            },
                                            {
                                                "example_id": "ee44038a-42c0-4fa8-936f-2597c6d04de5",
                                                "sense_id": "e0c2cc6d-a7dc-3a8b-9ce7-ea26cbf8bde2",
                                                "text": "„Da er recht billig war, fand er bei den jungen Männern großen Zuspruch; und in der sächsischen Lautverschiebung wird aus den Schüler halt der Schieler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c3f6f7e-740a-48f3-bb6f-7c16c33d7c07",
                        "source_entry_id": "c7ed75e0-03a6-3734-9d20-dee774ca034f",
                        "source_sense_id": "6c0c7ae7-117e-377a-a94d-1bd484b0ed66",
                        "source_sense_description": "het verschijnsel dat een klank in een taal in de loop van de tijd vervangen wordt door een andere klank",
                        "target_lang_word": "Lautwandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lautwandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                        "entry_id": "b3bee404-bd1b-377d-9d38-7e4ecf808098",
                                        "glosses": [
                                            "Veränderung von Lauten einer Sprache im Lauf der Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44942316-c981-4e7d-b11a-d994b2b75449",
                                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                                "text": "Die sog. Lautgesetze geben viele Beispiele von Lautwandel an. In der zweiten, hochdeutschen Lautverschiebung wurde z.B. germanisch [t] (germ. \"holta\" \"Holz\") zu althochdeutsch [ts] (ahd. \"holz\")."
                                            },
                                            {
                                                "example_id": "2d778e5c-e2ef-4923-9a78-03ca07b65ab2",
                                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                                "text": "„Dieser Lautwandel sondert die süd- und mitteldeutschen Mundarten, zusammenfassend Hochdeutsch genannt.“"
                                            },
                                            {
                                                "example_id": "8d7adc36-4cbd-4b2b-bc03-ddc4c0df7f3c",
                                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                                "text": "„Um die Erscheinung zu begreifen, die man als Lautwandel zu bezeichnen pflegt, muss man sich die physischen und psychischen Prozesse klar machen, welche immerfort bei der Hervorbringung der Lautkomplexe stattfinden.“"
                                            },
                                            {
                                                "example_id": "d984283c-510f-41df-b6a7-5a5d348aae37",
                                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                                "text": "„Von vielen Vorgängen der Vereinfachung im grammatischen Gerüst wird vermutet, daß sie ursächlich mit Lautwandel in Verbindung stehen…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
