                        "entry_id": "a7b073b3-cee5-36cf-8125-14be1ea82b22",
                        "glosses": [
                            "A seating area for VIPs in a stadium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b0d6e4-b182-40b6-b0cd-521ea42487e8",
                                "sense_id": "632d71db-947c-3388-bbf2-0cb453dedc20",
                                "text": "When Aislyn showed up at the rally with her ticket, she and her friends and parents all got quickly ushered over to a fancy-looking private entrance and up to an even fancier luxury skybox."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7892133-dcb4-34af-8989-5ddbb51dfda1",
                        "entry_id": "a7b073b3-cee5-36cf-8125-14be1ea82b22",
                        "glosses": [
                            "A cube with textures on its inner faces, used to simulate the sky or similar backdrop around a three-dimensional playfield."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceee2a8a-8cd1-46d9-b156-b28b5e4948cf",
                                "sense_id": "a7892133-dcb4-34af-8989-5ddbb51dfda1",
                                "text": "Thankfully, tools have been created to assist in the skybox creation process."
                            },
                            {
                                "example_id": "c354349a-773e-4897-8b24-6f5dd6eb7a4c",
                                "sense_id": "a7892133-dcb4-34af-8989-5ddbb51dfda1",
                                "text": "To ensure consistent sizing for all images, you should give each image in the skybox the same pixel width and height dimensions."
                            }
                        ]
                    }
                ],
