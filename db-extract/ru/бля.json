                                            {
                                                "example_id": "bd2ed3fa-9c58-4adf-acdf-b23c339b69cd",
                                                "sense_id": "ee7fc3b5-0adb-34a7-8ee0-7aa27672ffc8",
                                                "text": "Zamkniesz się, kurwa, czy nie?!"
                                            },
                                            {
                                                "example_id": "5300b751-6916-4778-abe6-90b0672b2f4d",
                                                "sense_id": "ee7fc3b5-0adb-34a7-8ee0-7aa27672ffc8",
                                                "text": "O kurwa, zajebali mi portfel!"
