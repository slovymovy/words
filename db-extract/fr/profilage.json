                        "sense_id": "5496f53b-c394-3932-9a97-fbd10deb85e1",
                        "entry_id": "f02e0319-e1eb-3332-a1ae-2f5524605164",
                        "glosses": [
                            "Fabrication de profilés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0386c264-dad8-4fa5-b6a6-d672c1861b56",
                                "sense_id": "5496f53b-c394-3932-9a97-fbd10deb85e1",
                                "text": "Outil de profilage."
                            },
                            {
                                "example_id": "fa382adc-9581-40d2-abd9-4a292f88f943",
                                "sense_id": "5496f53b-c394-3932-9a97-fbd10deb85e1",
                                "text": "Son modèle est un certain Féréor – ancien artisan cloutier – qui a su créer dans le village une petite usine d’effilage et de profilage des métaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "f161fbb5-1058-3118-bc52-4b8a91665510",
                        "entry_id": "f02e0319-e1eb-3332-a1ae-2f5524605164",
                        "glosses": [
                            "Opération de façonnage de la matière destiné à donner une forme adéquate à une pièce ou à un produit fini."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f070d2f4-fcac-3bd0-b221-dbc79bffecb9",
                        "entry_id": "f02e0319-e1eb-3332-a1ae-2f5524605164",
                        "glosses": [
                            "Établissement a posteriori, à partir d’indices liés à un acte ou un comportement, d’un profil psychosociologique de personnalité compatible avec l’acte ou le comportement en question."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df13628-5507-47bd-b7ae-c3fe2d2afc7f",
                                "sense_id": "f070d2f4-fcac-3bd0-b221-dbc79bffecb9",
                                "text": "Un tribunal a ordonné à la police de Longueuil de payer 12 000 $ à une victime de profilage racial et de documenter dorénavant toutes ses interventions auprès de personnes racisées, une première au Québec."
                            }
                        ]
                    },
                    {
                        "sense_id": "4accd530-fa38-36b7-95d8-51b1e9a4e0f6",
                        "entry_id": "f02e0319-e1eb-3332-a1ae-2f5524605164",
                        "glosses": [
                            "Fabrication d’images sensorielles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71bd505-bd90-493b-b1e7-af1fd2d05d17",
                                "sense_id": "4accd530-fa38-36b7-95d8-51b1e9a4e0f6",
                                "text": "Savez-vous que notre conscience ne perçoit pas tout de go mais effectue des séries compliquées de synthèses qui, au moyen de profilages successifs, parviennent à faire apparaître à nos sens des objets divers comme, par exemple, un chat, un balai ou une tapette à mouches et Dieu sait si c’est utile ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a552fa75-7756-3263-a46a-b1279e5e7273",
                        "entry_id": "f02e0319-e1eb-3332-a1ae-2f5524605164",
                        "glosses": [
                            "Comparaison du profil de consommateurs avec le profil moyen ^([1])."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
