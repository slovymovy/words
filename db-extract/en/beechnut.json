                                        "examples": [
                                            {
                                                "example_id": "91311cb0-1bd7-4369-8bd5-3ac2c36e0193",
                                                "sense_id": "a364ad2d-b4d0-339a-a239-8679b5331277",
                                                "text": "Koho zajímá, že si nějaká bukvice vzala jinou bukvici?! To žádná svatba není…"
                                            },
                                            {
                                                "example_id": "e82e588c-785c-48cd-94e0-3895793668f6",
                                                "sense_id": "a364ad2d-b4d0-339a-a239-8679b5331277",
                                                "text": "„Vy jste bukvice, ne?“ „Prosím?“ „Vy jste buzerant, ne?“ Tak měl probíhat přijímací pohovor při náboru pracovní síly do kuchyně v jedné z pražských restaurací."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55f4f158-d303-4b11-a47c-6e2f5a84414c",
