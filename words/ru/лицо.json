                    "target_lang_definitions": {
                        "en": "A grammatical category of verbs and pronouns indicating the speaker, the addressee, or the one being spoken about.",
                        "zh": "动词和代词的语法范畴，表示说话人、听话人或所谈论的对象。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "person",
                                "target_lang_sense_clarification": "grammar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人称",
                                "target_lang_sense_clarification": "语法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64db8ab2-2c7c-3d52-9512-e5429fe3e377",
                    "sense_definition": "Субъект гражданских прав и обязанностей (организация или человек).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personhood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое юридическое <w>лицо</w> обязано платить налоги в соответствии с законом.",
                            "target_lang_translations": {
                                "en": "Every legal <w>entity</w> is obliged to pay taxes in accordance with the law.",
                                "zh": "每个法律<w>实体</w>都必须依法纳税。"
                            }
                        },
                        {
                            "text": "Договор был заключён между двумя физическими <w>лицами</w> без участия нотариуса.",
                            "target_lang_translations": {
                                "en": "The contract was concluded between two natural <w>persons</w> without a notary.",
                                "zh": "这份合同是在没有公证人参与的情况下，由两个自然<w>人</w>签署的。"
                            }
                        }
                    ],
                    "synonyms": [
