                                        "entry_id": "0dae515a-075e-3713-b3d1-ec1987315f3b",
                                        "glosses": [
                                            "zapach odczuwany w wilgotnych, niewietrzonych lub zagrzybionych pomieszczeniach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4d902b-c993-4e24-b548-6eaf0adc828d",
                                                "sense_id": "696d5685-6041-3ddf-911f-ffff1931e674",
                                                "text": "Zrobiło się duszno, cuchnie stęchlizną, dymem, gotowanym godzinami jedzeniem oraz ludzkim potem, jakbyśmy wstąpili do piekielnego kręgu."
                                            }
