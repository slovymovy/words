                        "glosses": [
                            "Thoughtlessness, carelessness; a thoughtless act."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ab9217-b886-4d05-9ec5-81e6033907f7",
                                "sense_id": "c890b9bb-7b55-362d-930b-dd4e6ce8393e",
                                "text": "[S]ome sudden etourderie not at all in harmony with my feelings; some trait, in the character of her country, has suddenly dissolved the charm, and awakened me to a full sense of the folly I was guilty of."
                            },
                            {
                                "example_id": "6e543407-ce54-4ce2-852d-501b3eb631a0",
                                "sense_id": "c890b9bb-7b55-362d-930b-dd4e6ce8393e",
                                "text": "Henry is blameless, and in spite of a moment's étourderie thinks of nobody but you."
                            },
                            {
                                "example_id": "2eebd7e0-806e-461b-97b3-85a23aa96727",
                                "sense_id": "c890b9bb-7b55-362d-930b-dd4e6ce8393e",
                                "text": "His love affairs appeared as the étourderies of a much younger man."
                            }
                        ]
                    }
