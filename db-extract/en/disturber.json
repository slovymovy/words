                                    {
                                        "sense_id": "61fb4042-4812-3b27-ad51-452be7a5b2f3",
                                        "entry_id": "91c293a8-9d81-31f6-9235-16bce2fb9551",
                                        "glosses": [
                                            "Person, die für Unruhe sorgt und andere zum Widerstand, zur Auflehnung bewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc1b5b45-cdd4-4f7c-b4a7-b1e1b9fdb2e1",
                                                "sense_id": "61fb4042-4812-3b27-ad51-452be7a5b2f3",
                                                "text": "„Da gibt es immer die Anführer, die Schläger, die Aufwiegler, aber es gibt auch die Mitläufer.“"
                                            }
