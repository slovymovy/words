{
    "word_family": [
        "redolence",
        "redolency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c85e20f5-cb53-3e61-af8a-08b76f7cb782",
                    "sense_definition": "Having a pleasant, sweet, or strong smell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was <w>redolent</w> with the scent of blooming jasmine.",
                            "target_lang_translations": {
                                "nl": "De tuin was <w>geurig</w> door de geur van bloeiende jasmijn."
                            }
                        },
                        {
                            "text": "The air in the bakery was <w>redolent</w> of fresh cinnamon rolls.",
                            "target_lang_translations": {
                                "nl": "De lucht in de bakkerij was <w>welriekend</w> naar verse kaneelbroodjes."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragrant",
                        "aromatic"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een aangename, zoete of sterke geur verspreidend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geurig",
                                "target_lang_sense_clarification": "met een prettige geur"
                            },
                            {
                                "target_lang_word": "welriekend",
                                "target_lang_sense_clarification": "een aangename geur hebbend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63cbcc70-6211-3856-82e9-8a0770831330",
                    "sense_definition": "Having a strong smell of a specific substance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His clothes were <w>redolent</w> of stale tobacco smoke.",
                            "target_lang_translations": {
                                "nl": "Zijn kleren waren <w>doordrongen van</w> de geur van oude tabaksrook."
                            }
                        },
                        {
                            "text": "The old cellar was <w>redolent</w> of damp earth and mold.",
                            "target_lang_translations": {
                                "nl": "De oude kelder was <w>riekend naar</w> vochtige aarde en schimmel."
                            }
                        }
                    ],
                    "synonyms": [
                        "smelling",
                        "reeking"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een sterke geur van een specifieke substantie verspreidend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "riekend naar",
                                "target_lang_sense_clarification": "een specifieke geur afgevend"
                            },
                            {
                                "target_lang_word": "doordrongen van",
                                "target_lang_sense_clarification": "sterk ruikend naar iets"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daafa827-423f-33b8-ab2f-a60059038c15",
                    "sense_definition": "Suggestive or reminiscent of something from the past.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reminiscent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house was <w>redolent</w> of a bygone era of elegance.",
                            "target_lang_translations": {
                                "nl": "Het oude huis <w>deed denken aan</w> een vervlogen tijdperk van elegantie."
                            }
                        },
                        {
                            "text": "His speech was <w>redolent</w> of the political rhetoric from the fifties.",
                            "target_lang_translations": {
                                "nl": "Zijn toespraak <w>ademde</w> de politieke retoriek van de jaren vijftig."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Suggestief of herinnerend aan iets uit het verleden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "doen denken aan",
                                "target_lang_sense_clarification": "herinneringen oproepend aan iets"
                            },
                            {
                                "target_lang_word": "ademen",
                                "target_lang_sense_clarification": "de sfeer uitstralen van iets"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}