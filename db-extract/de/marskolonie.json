                "senses": [
                    {
                        "sense_id": "e036faa0-4216-3bfd-bd9d-f66746b532a5",
                        "entry_id": "b3a2050b-f516-3122-a6eb-49c2f39958f0",
                        "glosses": [
                            "von Menschen auf dem Planeten Mars errichtete Kolonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f4ad35-81a3-470e-af4a-278aa05654d9",
                                "sense_id": "e036faa0-4216-3bfd-bd9d-f66746b532a5",
                                "text": "„Die Marskolonie, die er im Sinn hat, soll dereinst nicht eine Hand voll, sondern gleich hunderte Menschen beherbergen.“"
                            },
                            {
                                "example_id": "8ee7c741-295e-4134-8c02-73e78c3cd051",
                                "sense_id": "e036faa0-4216-3bfd-bd9d-f66746b532a5",
                                "text": "„Im Roman \"Marsianischer Zeitsturz\" etwa beschreibt er einen autistischen Jungen in einer Marskolonie, dessen Zeitwahrnehmung nicht linear funktioniert.“"
                            },
                            {
                                "example_id": "6dfedc81-1587-4303-b52b-60e622a77548",
                                "sense_id": "e036faa0-4216-3bfd-bd9d-f66746b532a5",
                                "text": "„Elon Musk spricht allen Ernstes von einer Marskolonie, die nach und nach auf eine Million Einwohner anwächst.“"
                            },
                            {
                                "example_id": "9e2e270f-dc92-46ba-8221-ceb46c4039f2",
                                "sense_id": "e036faa0-4216-3bfd-bd9d-f66746b532a5",
                                "text": "„Deshalb müssen wir die Marskolonie, sobald sie besteht, auch autark machen, damit sie unabhängig von der Erde existieren kann.“"
                            },
                            {
                                "example_id": "a36465b9-b900-49af-b4a7-144e6cf61cf6",
                                "sense_id": "e036faa0-4216-3bfd-bd9d-f66746b532a5",
                                "text": "„Mithilfe von Raumschiffen sollen 2025 die ersten Menschen auf eine Marskolonie transportiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
