                "senses": [
                    {
                        "sense_id": "8f3c3dee-2025-3c07-92e8-eb7f493f5433",
                        "entry_id": "59b8404d-0fa1-3316-b151-0ea8965b72b6",
                        "glosses": [
                            "Laub, das aus den Blättern der Kartoffelpflanze besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fc964c-286b-4ea9-9e9d-f58456fb1c11",
                                "sense_id": "8f3c3dee-2025-3c07-92e8-eb7f493f5433",
                                "text": "„Elsa stößt die Spatengabel am Rand der Kartoffellaubs tief in die Erde und hebt den Boden mit den Knollen an.“"
                            },
                            {
                                "example_id": "db464448-91d7-4a11-9d05-4b0830a88c9f",
                                "sense_id": "8f3c3dee-2025-3c07-92e8-eb7f493f5433",
                                "text": "„Hans Ritter überreichte ihm den Brief mit kurzen Worten! und trat einen Schritt beiseite. Es war wohl noch eine Stunde bis zur Abenddämmerung, die Sonne leuchtete warm und klar über Thal und Strom, und über den jenseitigen Bergen lag ein wunderbar milder, weicher Silberduft, aber quer durch das lieblich stille Bild zogen sich jetzt langsam schwelende, mißfarbige Rauchstreifen von den Aeckern unterhalb des Rebenhanges hin, wo hochgehäuft das dürre, abgestorbene Kartoffellaub verbrannte. “"
                            },
                            {
                                "example_id": "bec87f1b-b497-471e-b3ba-edb8289f0381",
                                "sense_id": "8f3c3dee-2025-3c07-92e8-eb7f493f5433",
                                "text": "„Der bodenbürtige Pilz überwintert in Abfallhaufen, an abgestorbenem Kartoffellaub und an befallenen Knollen im Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
