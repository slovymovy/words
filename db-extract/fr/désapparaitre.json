                "senses": [
                    {
                        "sense_id": "40f8b198-599c-3546-9405-51ad28617446",
                        "entry_id": "49257e0c-e783-3bc3-a254-c6d8f1c72e35",
                        "glosses": [
                            "Ne plus apparaitre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc153c7-eb08-456b-8bf4-553c5a1f7bd2",
                                "sense_id": "40f8b198-599c-3546-9405-51ad28617446",
                                "text": "J’ai essayé de me montrer à travers la question du rapport au texte dont les enjeux désapparaissent lorsque celui-ci est trop présent, en tant que texte."
                            },
                            {
                                "example_id": "e7944de4-5fa8-491f-9804-28d31336ccb0",
                                "sense_id": "40f8b198-599c-3546-9405-51ad28617446",
                                "text": "Ceux-là \"désapparaissent\" au monde et s’aperçoivent enfin d’eux-mêmes."
                            },
                            {
                                "example_id": "b2995915-d9e5-4278-8b4c-ea0167dc5142",
                                "sense_id": "40f8b198-599c-3546-9405-51ad28617446",
                                "text": "De plus quand je vais dans gestionnaire des tâches je peux voir que le message \"pas de réponse\" sur le logiciel usbfix qui est en recherche ne cesse de désapparaitre et apparaitre...."
                            }
                        ]
                    }
                ],
