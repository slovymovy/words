                "senses": [
                    {
                        "sense_id": "93de6a37-7e50-313d-ba25-e7372a5dcb15",
                        "entry_id": "25966a53-322c-30dd-98ed-9bc9c3e19460",
                        "glosses": [
                            "Petite baguette, petite verge."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c4a9c9f7-6dca-3f74-b49d-7b4fe03b3c6e",
                        "entry_id": "25966a53-322c-30dd-98ed-9bc9c3e19460",
                        "glosses": [
                            "Bâtonnet recouvert de glu, pour capturer les oiseaux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b8925152-6837-4ea8-907b-a33dc2a1dcad",
                                "sense_id": "c4a9c9f7-6dca-3f74-b49d-7b4fe03b3c6e",
                                "text": "Le fils de François y « faisait le poste » aux ortolans, à grands renfort de vergettes et de glu ; il en avait souvent jusque dans les cheveux."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f064466-c703-3b13-b704-155970b2ec8b",
                        "entry_id": "25966a53-322c-30dd-98ed-9bc9c3e19460",
                        "glosses": [
                            "Tige métallique à faible section qui renforce la solidité d’un panneau de vitrail."
                        ],
                        "tags": [
                            "Vitrerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "99817aa4-6464-3a3a-a261-db2cc1d86067",
                        "entry_id": "25966a53-322c-30dd-98ed-9bc9c3e19460",
                        "glosses": [
                            "Brosse servant à nettoyer des vêtements, des étoffes, etc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1e6471d0-129a-40c6-8af8-edc5d7f65c15",
                                "sense_id": "99817aa4-6464-3a3a-a261-db2cc1d86067",
                                "text": "Il faut donner deux ou trois coups de vergette à cet habit, à ce chapeau."
                            },
                            {
                                "example_id": "f224b319-383b-4225-829d-20a79f2de502",
                                "sense_id": "99817aa4-6464-3a3a-a261-db2cc1d86067",
                                "text": "La peau a ses usages, on en fait des cribles, comme l'on fait aussi des vergettes, des brosses, des pinceaux avec les soies."
                            },
                            {
                                "example_id": "29aeac14-5a84-49b4-97c9-d18b4fffab98",
                                "sense_id": "99817aa4-6464-3a3a-a261-db2cc1d86067",
                                "text": "— Et ce képi !… (Le lui ôtant.) Ce képi n’est pas propre... Prenez une vergette, et brossez ça..."
                            }
                        ]
                    },
                    {
                        "sense_id": "507c63d1-0487-30c8-aa13-ff5daffa391b",
                        "entry_id": "25966a53-322c-30dd-98ed-9bc9c3e19460",
                        "glosses": [
                            "Coiffure, cheveux coupés assez ras pour qu’ils se dressent comme les poils d’une brosse."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e70b998a-76b5-4a32-b24b-f025e864ffa0",
                                "sense_id": "507c63d1-0487-30c8-aa13-ff5daffa391b",
                                "text": "Tantôt hauts, tantôt courts, frisés & plats, poudrés, teints, parfumés, en cadenette, en vergette."
                            },
                            {
                                "example_id": "76a942e7-9afa-4ff7-b399-a7697f58b252",
                                "sense_id": "507c63d1-0487-30c8-aa13-ff5daffa391b",
                                "text": "Le personnage en question pouvait avoir vingt-cinq ans. Gros visage étonné, cheveux blonds taillés en vergette."
                            }
                        ]
                    },
                    {
                        "sense_id": "c706af5e-368c-3cb6-96d7-c575c101337f",
                        "entry_id": "25966a53-322c-30dd-98ed-9bc9c3e19460",
                        "glosses": [
                            "Cercle qui tend la peau d’un tambour."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
