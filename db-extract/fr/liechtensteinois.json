                "translations": [
                    {
                        "translation_id": "8a488895-832b-4c6f-960b-08be1e28707f",
                        "source_entry_id": "045d8dbe-a08d-333e-b403-73a4dc7d8383",
                        "source_sense_id": "957b4c79-3612-3bf9-b9bc-8e60130a49ad",
                        "target_lang_word": "liechtensteinisch",
