                        "glosses": [
                            "bedrijf dat luchtbanden produceert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c576bb1c-c5be-458b-90f5-7332f8742f89",
                                "sense_id": "1788a192-ea35-36d4-8423-c6f2dfca5026",
                                "text": "Het was schering en inslag afgelopen weekend op het circuit van Silverstone: klapbanden. De achterbanden van vier wagens gingen op hoge snelheid kapot, en bandenfabrikant Pirelli moet daarom op het matje komen. De teams in de Formule 1 eisen een oplossing. Want volgend weekend moeten ze alweer in Duitsland aan de bak."
                            },
                            {
                                "example_id": "01a67125-029c-40b1-b051-2873be2432a9",
                                "sense_id": "1788a192-ea35-36d4-8423-c6f2dfca5026",
                                "text": "Bandenfabrikant Pirelli had gehoopt met twee stops de problemen met de banden, die het afgelopen seizoen veel voorkwamen, te verminderen. Voor de teams betekende dat echter een te grote inbreuk op hun vrijheid in de racestrategie."
                            },
                            {
                                "example_id": "ebd08cbe-d837-43fc-91b9-7a3c413862ae",
                                "sense_id": "1788a192-ea35-36d4-8423-c6f2dfca5026",
                                "text": "Het tribunaal van de FIA hield donderdag in Parijs een hoorzitting over de kwestie. Mercedes en Pirelli moesten zich verantwoorden voor de geheime bandentest van 1.000 kilometer, die het team half mei in Barcelona op uitnodiging van de bandenfabrikant uitvoerde met de bolide van dit seizoen."
                            }
                        ]
                    }
