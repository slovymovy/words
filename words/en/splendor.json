{
    "word_family": [
        "splendid",
        "splendidly",
        "resplendent",
        "resplendence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "864e9b8f-9d76-3fc0-8a57-52223f567a21",
                    "sense_definition": "Magnificent appearance, display, or grandeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "magnificence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists were amazed by the architectural <w>splendor</w> of the ancient palace.",
                            "target_lang_translations": {
                                "de": "Die Touristen waren von der architektonischen <w>Pracht</w> des alten Palastes überwältigt."
                            }
                        },
                        {
                            "text": "The coronation was celebrated with great pomp and <w>splendor</w>.",
                            "target_lang_translations": {
                                "de": "Die Krönung wurde mit großem Pomp und <w>Prunk</w> gefeiert."
                            }
                        }
                    ],
                    "synonyms": [
                        "grandeur",
                        "magnificence"
                    ],
                    "antonyms": [
                        "modesty",
                        "simplicity"
                    ],
                    "common_phrases": [
                        "in all its splendor"
                    ],
                    "target_lang_definitions": {
                        "de": "Großartige, überwältigende Erscheinung, Prunk oder Erhabenheit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Pracht",
                                "target_lang_sense_clarification": "üppige Schönheit, prunkvolles Aussehen"
                            },
                            {
                                "target_lang_word": "Glanz",
                                "target_lang_sense_clarification": "Glanz und Prunk, festliche Pracht"
                            },
                            {
                                "target_lang_word": "Herrlichkeit",
                                "target_lang_sense_clarification": "imposante Erhabenheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4448f520-b57e-320e-9c70-8057722103f6",
                    "sense_definition": "Great brightness, brilliance, or radiant light.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "brightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moon illuminated the desert with its silver <w>splendor</w>.",
                            "target_lang_translations": {
                                "de": "Der Mond erhellte die Wüste mit seinem silbernen <w>Glanz</w>."
                            }
                        },
                        {
                            "text": "We paused to admire the dazzling <w>splendor</w> of the morning sunrise.",
                            "target_lang_translations": {
                                "de": "Wir hielten inne, um die blendende <w>Pracht</w> des morgendlichen Sonnenaufgangs zu bewundern."
                            }
                        }
                    ],
                    "synonyms": [
                        "brilliance",
                        "radiance",
                        "luster"
                    ],
                    "antonyms": [
                        "dimness",
                        "dullness"
                    ],
                    "target_lang_definitions": {
                        "de": "Große Helligkeit, strahlender Schein oder Leuchten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Glanz",
                                "target_lang_sense_clarification": "strahlendes Leuchten, Lichtschein"
                            },
                            {
                                "target_lang_word": "Strahlen",
                                "target_lang_sense_clarification": "strahlendes Leuchten"
                            },
                            {
                                "target_lang_word": "Pracht",
                                "target_lang_sense_clarification": "strahlende Erscheinung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76857b5f-8fa3-3e0e-8417-9e8462c7d2c4",
                    "sense_definition": "Great fame, honor, or glory.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "magnificence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical empire reached the peak of its military <w>splendor</w> during the fifth century.",
                            "target_lang_translations": {
                                "de": "Das historische Reich erreichte im fünften Jahrhundert den Höhepunkt seines militärischen <w>Ruhms</w>."
                            }
                        },
                        {
                            "text": "Few artists ever achieve such enduring <w>splendor</w> in the public memory.",
                            "target_lang_translations": {
                                "de": "Nur wenige Künstler erlangen jemals einen so dauerhaften <w>Glanz</w> im öffentlichen Gedächtnis."
                            }
                        }
                    ],
                    "synonyms": [
                        "glory",
                        "fame",
                        "renown"
                    ],
                    "antonyms": [
                        "obscurity",
                        "infamy"
                    ],
                    "target_lang_definitions": {
                        "de": "Großer Nachruhm, Ehre oder geschichtlicher Glanz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ruhm",
                                "target_lang_sense_clarification": "großes Ansehen, Ehre"
                            },
                            {
                                "target_lang_word": "Glanz",
                                "target_lang_sense_clarification": "im übertragenen Sinn: Blütezeit, Ruhm"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}