                        ],
                        "examples": [
                            {
                                "example_id": "bfdf317c-f042-4a1c-91af-8ef961bc07e9",
                                "sense_id": "f4350edd-383a-3f45-9e25-dd0e6d501e3e",
                                "text": "Rond de kerstkribbe stonden Maria, Jozef, herders, schapen, engelen en de wijzen uit het oosten."
                            },
                            {
                                "example_id": "df4e6dd4-8d58-4041-8575-90324bb90928",
                                "sense_id": "f4350edd-383a-3f45-9e25-dd0e6d501e3e",
                                "text": "Ze had honderden details herkend, de kerstboomversiering, de kerstkribbe, de decoraties, het serviesgoed, de tafelkleden, de bedienden die meededen met de dans om de boom, alles. Ook Eric zou er behoorlijk veel van herkennen door de Kerstmissen in Saltsjôbaden."
                            }
                        ]
