                                    },
                                    {
                                        "sense_id": "815dfd64-9076-3ad4-9751-edcd0c395fc7",
                                        "entry_id": "52c9971a-99a7-3452-beeb-0e066ca574f7",
                                        "glosses": [
                                            "Sequentially after this point (in time, in the writing constituting a document, in the movement along a path, etc.)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18c51bb8-20c5-327a-bcee-9eda6effa505",
                                        "entry_id": "52c9971a-99a7-3452-beeb-0e066ca574f7",
                                        "glosses": [
                                            "In time to come; in some future time or state."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a0b2f5a-0082-4f14-9c39-d98c85cc1302",
                                                "sense_id": "18c51bb8-20c5-327a-bcee-9eda6effa505",
                                                "text": "She should have died hereafter; / There would have been a time for such a word."
                                            },
                                            {
                                                "example_id": "e6398543-86c6-4e99-bee8-19384ca21859",
                                                "sense_id": "18c51bb8-20c5-327a-bcee-9eda6effa505",
                                                "text": "[…] when hereafter he from war shall come / And bring his Trojans peace and triumph […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hereafter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "267d9755-0534-3cc3-81a3-af02a0255fbb",
                                        "entry_id": "f76088f4-a3f1-326a-a55d-0f68242c12da",
                                        "glosses": [
                                            "A future existence or state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34e09dea-e76f-3027-a21f-66c3c65d30b8",
                                        "entry_id": "f76088f4-a3f1-326a-a55d-0f68242c12da",
                                        "glosses": [
                                            "Existence after death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "poetic",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41317690-e12a-4c6e-a62d-c8eeb38cd18c",
                                                "sense_id": "34e09dea-e76f-3027-a21f-66c3c65d30b8",
                                                "text": "'Tis the Divinity that stirs within us; / 'Tis Heaven itself that points out an hereafter, / and intimates eternity to man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hereafter",
                                "target_lang_code": "en",
                                "target_senses": [
