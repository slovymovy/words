                                        "entry_id": "4e054bf7-cb8e-3db1-afef-3ff76bdb89ad",
                                        "glosses": [
                                            "A reusable diaper made of thick, durable cloth materials."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a00ae42-f633-408e-b53f-60f282f1bb2b",
                                                "sense_id": "c2be9387-79ba-380b-aaaa-94278ec4d860",
                                                "text": "All mothers with infants reported the use of a regular cloth diaper made of cotton, and all reported a preference for cloth diapers made of this fiber."
                                            },
                                            {
                                                "example_id": "99c83f78-be8b-4410-9d1b-accc75a6b8d4",
                                                "sense_id": "c2be9387-79ba-380b-aaaa-94278ec4d860",
                                                "text": "Indeed, parents had always complained about the odious laundering, folding, and storing of cloth diapers."
                                            },
                                            {
                                                "example_id": "3fea0894-fee9-4aa2-9ae4-d23d9fe0d6ac",
                                                "sense_id": "c2be9387-79ba-380b-aaaa-94278ec4d860",
                                                "text": "I talked to a father in South Africa who had to give up cloth diapers because of a drought."
                                            }
