                            }
                        },
                        {
                            "text": "De massage hielp om zijn pijnlijke rugspieren te <w>ontspannen</w>.",
                            "target_lang_translations": {
                                "en": "The massage helped to <w>loosen</w> his painful back muscles.",
                                "ru": "Массаж помог <w>расслабить</w> его болезненные мышцы спины.",
                                "pl": "Masaż pomógł <w>rozluźnić</w> jego obolałe mięśnie pleców.",
                                "de": "Die Massage half dabei, seine schmerzenden Rückenmuskeln zu <w>entspannen</w>.",
                                "fr": "Le massage a aidé à <w>relâcher</w> ses muscles du dos douloureux.",
                                "it": "Il massaggio ha aiutato a <w>distendere</w> i suoi muscoli doloranti della schiena.",
                                "cs": "Masáž pomohla <w>uvolnit</w> jeho bolavé zádové svaly.",
                                "tr": "Masaj, ağrıyan sırt kaslarını <w>gevşetmeye</w> yardımcı oldu.",
                                "es": "El masaje ayudó a <w>relajar</w> los doloridos músculos de su espalda."
                            }
