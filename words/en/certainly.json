                    "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                    "sense_definition": "Used to give an emphatic affirmative answer or to express agreement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Can you help me with these bags?\" \"<w>Certainly</w>, I would be happy to.\"",
                            "target_lang_translations": {
                                "ru": "«Вы можете помочь мне с этими сумками?» «— <w>Конечно</w>, с удовольствием».",
                                "nl": "\"Kun je me helpen met deze tassen?\" \"<w>Zeker</w>, dat doe ik graag.\"",
                                "pl": "„Czy możesz mi pomóc z tymi torbami?” „<w>Oczywiście</w>, z chęcią.”",
                                "de": "„Kannst du mir mit diesen Taschen helfen?“ „<w>Gerne</w>, das mache ich doch glatt.“",
                                "fr": "« Pouvez-vous m'aider avec ces sacs ? » « <w>Certainement</w>, avec plaisir. »",
                                "it": "\"Puoi aiutarmi con queste borse?\" \"<w>Certamente</w>, con piacere.\"",
                                "cs": "„Můžeš mi pomoct s těmi taškami?“ „<w>Jistě</w>, rád.“",
                                "tr": "\"Bu çantalarda bana yardım edebilir misiniz?\" \"<w>Elbette</w>, memnuniyetle yardımcı olurum.\"",
                                "es": "—¿Puedes ayudarme con estas bolsas? —<w>Por supuesto</w>, con mucho gusto.",
                                "zh": "“你能帮我拿一下这些袋子吗？”“<w>当然</w>，我很乐意。”"
                            }
                        },
                        {
                            "text": "\"May I sit here?\" \"<w>Certainly</w>, the seat is free.\"",
                            "target_lang_translations": {
                                "ru": "«Можно мне здесь сесть?» «— <w>Конечно</w>, место свободно».",
                                "nl": "\"Mag ik hier zitten?\" \"<w>Natuurlijk</w>, de stoel is vrij.\"",
                                "pl": "„Czy mogę tu usiąść?” „<w>Jasne</w>, to miejsce jest wolne.”",
                                "de": "„Darf ich mich hierhin setzen?“ „<w>Natürlich</w>, der Platz ist frei.“",
                                "fr": "« Puis-je m'asseoir ici ? » « <w>Bien sûr</w>, la place est libre. »",
                                "it": "\"Posso sedermi qui?\" \"<w>Certamente</w>, il posto è libero.\"",
                                "cs": "„Mohu si sem sednout?“ „<w>Samozřejmě</w>, to místo je volné.“",
                                "tr": "\"Buraya oturabilir miyim?\" \"<w>Tabii ki</w>, koltuk boş.\"",
                                "es": "—¿Puedo sentarme aquí? —<w>Claro que sí</w>, el asiento está libre.",
                                "zh": "“我可以坐这儿吗？”“<w>当然</w>，这个座位是空的。”"
                            }
                        }
                    ],
