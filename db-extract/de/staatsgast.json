                "senses": [
                    {
                        "sense_id": "537a2130-1d88-3188-a542-8f4962fac8f8",
                        "entry_id": "802f1342-4e3f-3a3d-84a5-34b4370e5dac",
                        "glosses": [
                            "von einem Staat offiziell empfangener Repräsentant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb14396-a159-4b61-bb8c-ecb379f280f1",
                                "sense_id": "537a2130-1d88-3188-a542-8f4962fac8f8",
                                "text": "„Bei seinem Jerusalembesuch im Jahr 1855 durfte Montefiore, der dank seiner weitverzweigten Beziehungen in Palästina schon fast als Staatsgast behandelt wurde, als erster Jude seit Jahrhunderten den Tempelberg besuchen.“"
                            },
                            {
                                "example_id": "3e5f4f4a-2ee6-4c29-ab53-03613cd7e665",
                                "sense_id": "537a2130-1d88-3188-a542-8f4962fac8f8",
                                "text": "„Als Leiter der Abteilung für Operationen gegen Amerika war Carlos so etwas wie ein Staatsgast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
