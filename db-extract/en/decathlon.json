                                        "sense_id": "8c6dff51-5a7e-310b-a59e-aee4f0f71521",
                                        "entry_id": "911b7b02-29f7-32c5-b5f6-7394e7a190cc",
                                        "glosses": [
                                            "Concours qui se déroule en deux jours comprenant le 100 m, le saut en longueur, lancer du poids, saut en hauteur, 400 m, 110 m haies, lancer du disque, saut à la perche, lancer du javelot, 1500 m."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0acf9d08-b014-4bff-844b-93f25414246e",
                                                "sense_id": "8c6dff51-5a7e-310b-a59e-aee4f0f71521",
                                                "text": "Le décathlon est sans doute, aux Jeux olympiques, la plus exigeante des disciplines athlétiques en plein air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
