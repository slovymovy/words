                ],
                "senses": [
                    {
                        "sense_id": "49608faf-e185-32c8-b076-ff4317d29245",
                        "entry_id": "56bd92e8-59a5-37b8-a02a-77a0acc325a5",
                        "glosses": [
                            "Mediziner, der auf operative Behandlungen des Mundes spezialisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c91a4eb-392e-4a20-ac69-70142aaf1ef3",
                                "sense_id": "49608faf-e185-32c8-b076-ff4317d29245",
                                "text": "„Dicke Zungenbändchen sollten besser von einem Hals-Nasen-Ohrenarzt oder einem Mundchirurgen unter sicheren Bedingungen durchtrennt werden.“"
                            },
                            {
                                "example_id": "cc898bda-5bd2-4910-84e9-ca3b1eff5dd2",
                                "sense_id": "49608faf-e185-32c8-b076-ff4317d29245",
                                "text": "„Länger denn ein Menschenalter galt er für den ersten Mundchirurgen der Vereinigten Staaten.“"
                            },
                            {
                                "example_id": "3891d5ac-79a1-472f-b543-4726666dedd4",
                                "sense_id": "49608faf-e185-32c8-b076-ff4317d29245",
                                "text": "„Sie können zwar die berühmten aber seltenen Riesenhonorare der großen Prothetiker und Mundchirurgen nicht erreichen, aber ihr Einkommen ist gleichmäßiger und ihre Arbeit sehr angenehm.“"
                            },
                            {
                                "example_id": "7d78033c-5e20-4663-a263-2d0d9375dcb3",
                                "sense_id": "49608faf-e185-32c8-b076-ff4317d29245",
                                "text": "„Bei Infiltration des Kiefers soll die erkrankte Knochenpartie durch einen kompetenten Mundchirurgen ausgeräumt werden.“"
                            },
                            {
                                "example_id": "63641417-1df2-43c6-82c7-aa522cd63290",
                                "sense_id": "49608faf-e185-32c8-b076-ff4317d29245",
                                "text": "„Es werden fast nie medizinische Gründe angeführt, die zum Besuch eines Kieferorthopäden oder eines Mundchirurgen motivieren könnten, sondern durchweg das erstrebenswerte Nonplusultra des amerikanischen Selbstwertgefühls […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
