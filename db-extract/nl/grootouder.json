                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4c8436-f52e-4e0a-96de-2ebbd471ee29",
                                                "sense_id": "734d07ec-85f7-3bab-997d-678a119814b1",
                                                "text": "A 15-year-old orphan is being forced from the Arizona senior community where he lives with his grandparents after the homeowner’s association said it could face legal issues if he stayed."
                                            },
                                            {
                                                "example_id": "9758f8b9-b96f-4c43-affc-b9216f938f4a",
                                                "sense_id": "734d07ec-85f7-3bab-997d-678a119814b1",
                                                "text": "More than 140,000 US children have lost a parent or grandparent who takes care of them to Covid-19, CDC researchers reported Thursday, which is as many as one in 500 US kids."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grandparent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "812fa0df-6b39-3ab0-9582-0af1ed1f2ea3",
                                        "entry_id": "1848161c-ee70-3a1a-a226-5902ce9c282c",
                                        "glosses": [
                                            "Synonym of grandfather."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3a9d827-e200-4931-9198-828228bde79d",
                        "source_entry_id": "d32c7001-f145-398f-9ebf-fd4bc3f40467",
