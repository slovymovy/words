                "senses": [
                    {
                        "sense_id": "fcd318f2-7d31-3d3b-ab4e-9dd2013949ef",
                        "entry_id": "dd1556bd-28ab-39cc-b633-83d6c40636c5",
                        "glosses": [
                            "abwechselnde Aktion und Reaktion zweier beteiligter Parteien, von denen die eine stärker ist als die andere, diese stärkere Partei aber nicht sofort vernichtend zuschlägt; abwechselnde Aktion und Reaktion zweier beteiligter Parteien, von denen die eine schwächer ist als die andere, diese schwächere Partei aber beständig die stärkere reizt und herausfordert ohne sich festsetzen zu lassen"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "c238c44f-2d5d-4d59-8726-1015219f61de",
                                "sense_id": "fcd318f2-7d31-3d3b-ab4e-9dd2013949ef",
                                "text": "Der Entführer setzt bewusst eine blonde Frau als Köder ein, um den Ehemann der Vermissten in ein grausames Katz-und-Maus-Spiel zu verwickeln."
                            },
                            {
                                "example_id": "17f34ab5-9d09-4223-b246-2565d1b531d7",
                                "sense_id": "fcd318f2-7d31-3d3b-ab4e-9dd2013949ef",
                                "text": "„Insgesamt demonstrierten am Wochenende bis zu 5000 Menschen trotz Verboten in der Hauptstadt gegen die deutsche Coronapolitik. Sie liefen in mehreren Aufzügen durch die Stadt und lieferten sich dabei immer wieder ein Katz-und-Maus-Spiel mit der Polizei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
