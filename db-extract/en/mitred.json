                "senses": [
                    {
                        "sense_id": "a17ff5b8-b3b2-3989-ad23-ef284b99165a",
                        "entry_id": "62659cfc-c248-340c-b86a-acd4036120ac",
                        "glosses": [
                            "Wearing an abbot's or bishop's mitre."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c46d280-6b99-4d00-ac4a-cb2ba7f93cfe",
                                "sense_id": "a17ff5b8-b3b2-3989-ad23-ef284b99165a",
                                "text": "Our Fathers must hide themselves rather like robbers who chuse a leader, than godly priests who elect a mitred Abbot. […] And mark me, brother! not in the proudest days of the mitred Abbey, was a Superior ever chosen, whom his office shall so much honour, as he shall be honoured, who now takes it upon him in these days of tribulation."
                            },
                            {
                                "example_id": "00b9d5ba-c437-48da-90a3-51b19251f312",
                                "sense_id": "a17ff5b8-b3b2-3989-ad23-ef284b99165a",
                                "text": "Mitred emissaries also passed from Gregory to the Emperor, summoning him to attend the diet within a time by which no one unwafted by wings or steam could have reached the place […]"
                            },
                            {
                                "example_id": "e1bf3619-4fc5-4052-bc38-c7fc9df2605d",
                                "sense_id": "a17ff5b8-b3b2-3989-ad23-ef284b99165a",
                                "text": "Their leaves were green when the Abbey rose in splendour, and mitred abbots walked in their shadow."
                            },
                            {
                                "example_id": "b35120cb-534b-4c05-a573-498d363bfded",
                                "sense_id": "a17ff5b8-b3b2-3989-ad23-ef284b99165a",
                                "text": "Again I bestride the mitred, leather-winged steed."
                            }
                        ]
