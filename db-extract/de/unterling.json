                ],
                "senses": [
                    {
                        "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                        "entry_id": "860cefec-93b6-367b-8246-f2fd4671fe3c",
                        "glosses": [
                            "Person, die im Vergleich zu einer anderen einen niedrigeren Status hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b212e75-936a-43be-9fdf-5012723d4e73",
                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                "text": "„Mithin wollen die Chefs mehr Kontrolle über ihre Unterlinge, was weder progressiv noch nett ist.“"
                            },
                            {
                                "example_id": "4cec31e9-91f0-4eff-ad0f-509d2687adf5",
                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                "text": "„Bei Fox News herrschte Ailes wie ein Autokrat - bis die Unterlinge ihrerseits rebellierten.“"
                            },
                            {
                                "example_id": "db52c1e6-8d1b-4f67-8668-337642cbaf70",
                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                "text": "„Ein schnauzbärtiger Unterling eilt herbei, den Herrscher zu trösten: […].“"
                            },
                            {
                                "example_id": "d7c1640f-7f13-4c89-836b-5f75fe43805a",
                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                "text": "„Der Treck war fast zusammengestellt, als der Auftritt der aufrechten Nazis vollends zur Groteske wurde und auch noch Herr Abramowski in Götzlack vorbeischaute, ein Unterling des Herrn Bierfreund, um das am Morgen ausgesprochene Verbot zu kontrollieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b9b0ccf-9306-4c9a-9b3e-692b2a1cca60",
                        "source_entry_id": "860cefec-93b6-367b-8246-f2fd4671fe3c",
                        "source_sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                        "source_sense_description": "Person, die im Vergleich zu einer anderen einen niedrigeren Status hat",
                        "target_lang_word": "underling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77607681-8391-37b9-baca-6ee73abc299c",
                                        "entry_id": "11f2457e-e99e-3ad1-b168-dc13c297da7a",
                                        "glosses": [
                                            "A subordinate, or person of lesser rank or authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713fb8d4-9b50-4d26-83fc-559a67911fe7",
                                                "sense_id": "77607681-8391-37b9-baca-6ee73abc299c",
                                                "text": "The fault, dear Brutus, is not in our stars, / But in ourselves, that we are underlings."
                                            },
                                            {
                                                "example_id": "0185dcaf-c4b3-410c-ad6d-96610c79ae8e",
                                                "sense_id": "77607681-8391-37b9-baca-6ee73abc299c",
                                                "text": "\"I love not that underlings should perceive my wisdom.\""
                                            },
                                            {
                                                "example_id": "df621598-425e-4318-9d29-2cd8c4229782",
                                                "sense_id": "77607681-8391-37b9-baca-6ee73abc299c",
                                                "text": "His decision to stay at the compound in the face of possible assassination set an example, making it more difficult for his underlings to cut and run. “Anyone who left is a traitor,” Ruslan Stefanchuk, the speaker of Ukraine’s parliament, told its members a few hours after the invasion started."
                                            },
                                            {
                                                "example_id": "8110f367-cc29-4f6c-9f64-df5527f2883c",
                                                "sense_id": "77607681-8391-37b9-baca-6ee73abc299c",
                                                "text": "So read the email from Ray Dalio, founder of the world’s largest hedge fund, Bridgewater Associates, and a billionaire many times over. It would be read by more than 1,000 of his underlings at the company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cac9055-2425-35e8-8bc1-fb56a9967717",
                                        "entry_id": "11f2457e-e99e-3ad1-b168-dc13c297da7a",
                                        "glosses": [
                                            "A low, wretched person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
