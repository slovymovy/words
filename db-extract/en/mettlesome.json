                    }
                ],
                "senses": [
                    {
                        "sense_id": "6623d393-2636-3bd2-8752-515524e0e99f",
                        "entry_id": "2cab986c-0be5-3232-86f4-6cc14d3a29df",
                        "glosses": [
                            "Marked by mettle or bravery; courageous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75519974-3c7e-498e-91a7-10ad889a29f0",
                                "sense_id": "6623d393-2636-3bd2-8752-515524e0e99f",
                                "text": "The instant Haley touched the saddle, the mettlesome creature bounded from the earth with a sudden spring, that threw his master sprawling, some feet off, on the soft, dry turf."
                            },
                            {
                                "example_id": "78112840-fa75-43de-8a55-5f241b9d2033",
                                "sense_id": "6623d393-2636-3bd2-8752-515524e0e99f",
                                "text": "Among them was the \"West Country\" driver, Swain, of Bude, over the Great Central, who reminded me irresistibly of a hunter putting a particularly mettlesome steed at the fences."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "012a41f8-5559-4fe4-9baf-8f3982f0e3ac",
                        "source_entry_id": "2cab986c-0be5-3232-86f4-6cc14d3a29df",
                        "source_sense_id": "6623d393-2636-3bd2-8752-515524e0e99f",
                        "source_sense_description": "of great mettle",
                        "target_lang_word": "preux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5eb2f1-aa2a-381f-9314-b046d145fe4f",
                                        "entry_id": "39717d24-bf14-3cb0-bdea-83dd66c495d7",
                                        "glosses": [
                                            "Chevalier."
                                        ],
                                        "tags": [
                                            "Middle-Ages"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857766d5-cd72-429a-8392-12ca54198303",
                                                "sense_id": "5a5eb2f1-aa2a-381f-9314-b046d145fe4f",
                                                "text": "En ordre de bataille il a formé ses preux."
                                            },
                                            {
                                                "example_id": "ea76b919-482f-4042-ae02-2520a9de4af1",
                                                "sense_id": "5a5eb2f1-aa2a-381f-9314-b046d145fe4f",
                                                "text": "Le prince combattait au premier rang ; l’un de ses preux fut fait prisonnier à ses côtés."
                                            },
                                            {
                                                "example_id": "a0675e60-4a94-4fd3-9932-a72527fafa1e",
                                                "sense_id": "5a5eb2f1-aa2a-381f-9314-b046d145fe4f",
                                                "text": "Comme bon nombre de nobles à l’époque de la Restauration, il avait ravivé dans son âme les idées chevaleresques, et, suppléant par la force de l’imagination à celle du sang, il croyait consciencieusement sentir celui des anciens preux couler, sans mélange, dans ses veines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e255ec5b-8c4a-3554-9fd7-6e15f29fae18",
                                        "entry_id": "39717d24-bf14-3cb0-bdea-83dd66c495d7",
                                        "glosses": [
                                            "Valeureux chevalier."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a57c26-7601-4d52-8bfd-491151160439",
                                                "sense_id": "e255ec5b-8c4a-3554-9fd7-6e15f29fae18",
                                                "text": "Ce glaive, ce cor, ce casque et ce bouclier étaient donc très probablement ceux du chevalier au cygne, et ce chevalier, sans aucun doute, était un de ces anciens preux qui avaient pris part aux croisades."
                                            },
                                            {
                                                "example_id": "3a657e83-189f-4aae-8938-2b5d77972aff",
                                                "sense_id": "e255ec5b-8c4a-3554-9fd7-6e15f29fae18",
                                                "text": "Pourquoi restaurer les histoires vermoulues et poudreuses du moyen-âge, lorsque la chevalerie s’en est allée pour toujours, accompagnée des concerts de ses ménestrels, des enchantements de ses fées et de la gloire de ses preux ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81b6cb3b-fe83-346c-a581-dae63ad6952b",
                                        "entry_id": "194a1548-d6dd-38f5-8dac-cd2d5f241cb8",
                                        "glosses": [
                                            "Brave, hardi, vaillant, valeureux."
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c13e26d-5430-4a08-93f5-704dd453f452",
                                                "sense_id": "81b6cb3b-fe83-346c-a581-dae63ad6952b",
                                                "text": "Ses preux compagnons le suivirent jusque dans la mort."
                                            },
                                            {
                                                "example_id": "001d6e53-cef5-46e7-9004-f66c08b4288d",
                                                "sense_id": "81b6cb3b-fe83-346c-a581-dae63ad6952b",
                                                "text": "C’était un preux et hardi chevalier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18e5fa9b-093a-4f5e-92c1-18676cc74390",
                        "source_entry_id": "2cab986c-0be5-3232-86f4-6cc14d3a29df",
                        "source_sense_id": "6623d393-2636-3bd2-8752-515524e0e99f",
                        "source_sense_description": "of great mettle",
                        "target_lang_word": "mutig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                        "entry_id": "89093b04-94dc-3414-a109-30686ac9f9cf",
                                        "glosses": [
                                            "voller Mut, Mut aufbringend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af10f5e-bbac-466e-b183-8f6b7bf053fd",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "Sei mutig!"
                                            },
                                            {
                                                "example_id": "151b9f94-b0b2-4219-a13d-9238a8b9e098",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "„Der Schiläufer, der ein steiles Gelände sicher hinabfahren will, muss Schutzreflexe abbauen. […] Er muss das Schutzstreben in die Rücklage aufgeben und mutig die Vorlage suchen, um seine Schier sicher führen zu können.“"
                                            },
                                            {
                                                "example_id": "256a45a8-6758-4242-a6fe-3a722198eb39",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "„Erst wenn die Mutigen klug und die Klugen mutig geworden sind, wird das zu spüren sein, was irrtümlicherweise schon oft festgestellt wurde: ein Fortschritt der Menschheit.“"
                                            },
                                            {
                                                "example_id": "ebed669d-c699-4458-85ff-ef6d97b655e6",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "„Doch selbst für mutige Spitzenreiter wie ihn wird einmal die Zeit kommen, vom Risikosport Abschied zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9183cec3-0900-4945-a97a-786507df80e6",
                        "source_entry_id": "2cab986c-0be5-3232-86f4-6cc14d3a29df",
