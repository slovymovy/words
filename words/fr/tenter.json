    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92869b34-9386-38c1-a5a8-ea3c85e75719",
                    "sense_definition": "Faire un effort pour accomplir quelque chose ; entreprendre une action sans certitude du résultat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>tenter</w> un concours difficile cette année."
                        },
                        {
                            "text": "Les alpinistes <w>tenteront</w> d'atteindre le sommet de la montagne dès le lever du soleil."
                        }
                    ],
                    "synonyms": [
                        "essayer",
                        "entreprendre"
                    ],
                    "common_phrases": [
                        "tenter sa chance",
                        "tenter le coup",
                        "tenter une expérience"
                    ]
                },
                {
                    "sense_id": "d2b647da-b1b4-3b04-bc5a-dd5a5a8a55a2",
                    "sense_definition": "Donner envie ou inspirer le désir de faire ou d'obtenir quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une promenade au bord de la mer me <w>tente</w> beaucoup cet après-midi."
                        },
                        {
                            "text": "Est-ce qu'un voyage en Italie vous <w>tenterait</w> pour les prochaines vacances ?"
                        }
                    ],
                    "common_phrases": [
                        "être bien tenté"
                    ]
                },
                {
                    "sense_id": "aaf77de2-015c-391e-a3a7-2b4a862e2268",
                    "sense_definition": "Inciter quelqu'un à commettre une faute morale ou un péché en exerçant une séduction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le récit biblique, le serpent <w>tenta</w> la femme dans le jardin."
                        },
                        {
                            "text": "Le démon chercha à <w>tenter</w> l'ermite en lui promettant richesses et plaisirs."
                        }
                    ]
                }
            ]
        }
