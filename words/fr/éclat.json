            "senses": [
                {
                    "sense_id": "18842f89-e4b1-330d-af95-036be8988792",
                    "sense_definition": "Morceau détaché violemment d'un corps dur qui se brise ou explose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a ramassé chaque <w>éclat</w> de verre brisé pour éviter un accident."
                        },
                        {
                            "text": "Le soldat a été blessé à la jambe par un <w>éclat</w> d'obus."
                        }
                    ],
                    "synonyms": [
                        "fragment",
                        "morceau",
                        "débris"
                    ],
                    "common_phrases": [
