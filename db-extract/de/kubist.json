                ],
                "senses": [
                    {
                        "sense_id": "0dc1745e-171d-3233-aa2a-c23fa7be8e3c",
                        "entry_id": "6acc982f-1ed9-3413-be46-045f14627347",
                        "glosses": [
                            "Vertreter des Kubismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8451039f-94f9-42eb-aafb-d555371ee447",
                                "sense_id": "0dc1745e-171d-3233-aa2a-c23fa7be8e3c",
                                "text": "„Im »Sturm« wurde die neue Kunst der Futuristen und Kubisten und vor allem der Expressionismus propagiert, der Aufstand gegen die wilhelminische Fassadenprotzerei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c372ec40-ad65-4d48-b4ff-f60609f3cb9f",
                        "source_entry_id": "6acc982f-1ed9-3413-be46-045f14627347",
                        "source_sense_id": "0dc1745e-171d-3233-aa2a-c23fa7be8e3c",
                        "source_sense_description": "Vertreter des Kubismus",
                        "target_lang_word": "Cubist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b9ddd52-c206-3d61-bb25-462a0c1043b6",
                                        "entry_id": "ee5913ac-2279-312f-9696-dc27f4eca800",
                                        "glosses": [
                                            "An artist who works in the style of cubism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf0cecb-5b36-4a32-a2f9-eb5f4fe156ba",
                                                "sense_id": "7b9ddd52-c206-3d61-bb25-462a0c1043b6",
                                                "text": "To the world at large, relativity seemed to pull the rug out from under perceived reality. And for many advanced thinkers of the 1920s, from Dadaists to Cubists to Freudians, that was a fitting credo, reflecting what science historian David Cassidy calls \"the incomprehensiveness of the contemporary scene--the fall of monarchies, the upheaval of the social order, indeed, all the turbulence of the 20th century.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98572e20-319a-30ae-827b-eb982f766608",
                                        "entry_id": "22bf576b-6b33-32d4-a9a6-d1fc32497929",
                                        "glosses": [
                                            "Of, or pertaining to cubism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a382d32e-a30c-4efa-881c-cd2fefe326b6",
                                                "sense_id": "98572e20-319a-30ae-827b-eb982f766608",
                                                "text": "Her most notable feature is her eyes, which are distinctly uneven—the left one is a good quarter-inch higher than the right. Despite this Cubist touch, Shannen's face is particularly inexpressive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8ab66c1-3cc8-423a-b1b1-96a379a99f1a",
                        "source_entry_id": "6acc982f-1ed9-3413-be46-045f14627347",
                        "source_sense_id": "0dc1745e-171d-3233-aa2a-c23fa7be8e3c",
                        "source_sense_description": "Vertreter des Kubismus",
                        "target_lang_word": "cubist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3114c66a-cd44-382e-8686-fb55e9eb136b",
                                        "entry_id": "dbabaf33-2596-3583-9e5e-fcdab6fd14bd",
                                        "glosses": [
                                            "Alternative letter-case form of Cubist."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d1c2ae-5bda-49cb-8ff6-5adbf7e6bf5a",
                                                "sense_id": "3114c66a-cd44-382e-8686-fb55e9eb136b",
                                                "text": "They sat on cubist sofas in full evening dress and allowed us to hand them thimbles of cherry brandy and to talk to them about their poetry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00498df1-d545-3e37-a07b-619c1b5e0a38",
                                        "entry_id": "e88cbd12-67dd-39b8-967e-0667a696b5fb",
                                        "glosses": [
                                            "Alternative letter-case form of Cubist."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99ade163-b0fd-3ed2-ae74-15e56784cbd5",
                                        "entry_id": "b3486714-33ba-3f6f-b071-12c2c19c6a63",
                                        "glosses": [
                                            "A player of Rubik's cube; a cuber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696b9fc0-7f1a-4f6b-822d-c46c668008da",
                                                "sense_id": "99ade163-b0fd-3ed2-ae74-15e56784cbd5",
                                                "text": "[…] as far as I know there is no standard word describing the art of playing with the cube. Cubing? Cubistics? Rubikonomia? or perhaps Rubikomania? Can the science (or art) of doing it be called “cubology”, as suggested by Scientific American? Some enthusiasts borrow “cubism” and call themselves “cubists”, all very reminiscent of the 1920s three dimensional, modern art phase."
                                            },
                                            {
                                                "example_id": "e5278e6b-8532-4c2c-8e84-fc446a58b886",
                                                "sense_id": "99ade163-b0fd-3ed2-ae74-15e56784cbd5",
                                                "text": "Being a new reader of this group and a novice cubist, I'm not familiar with either of these notations. Would someone please fill me in? Thanks in advance for the help."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
