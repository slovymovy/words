                ],
                "senses": [
                    {
                        "sense_id": "a51f9d90-222a-3d59-9460-0e995090c591",
                        "entry_id": "8188ec54-dce5-3f42-a015-e69d2a5ba03c",
                        "glosses": [
                            "US-amerikanischer Fahrzeughersteller"
                        ],
                        "tags": [
                            "ohne Genus, ohne Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd3c872-82f5-4a9e-a64a-dab5dee939b8",
                                "sense_id": "a51f9d90-222a-3d59-9460-0e995090c591",
                                "text": "„Es stellt sich heraus, dass sie in Dearborn wohnt, wo sich die Weltzentrale von Ford befindet, und ihr Vater ist dort ein wichtiger Manager.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f7e70717-de30-38d6-8927-a610320d685c",
                        "entry_id": "8188ec54-dce5-3f42-a015-e69d2a5ba03c",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd07e5d7-cdb2-4b1d-8f43-6d2f67f645c9",
                                "sense_id": "f7e70717-de30-38d6-8927-a610320d685c",
                                "text": "„Der Junge und das Mädchen beobachteten, wie der Ford um eine Kurve verschwand.“"
                            },
                            {
                                "example_id": "6332917d-1ad8-452f-9394-21afdc966885",
                                "sense_id": "f7e70717-de30-38d6-8927-a610320d685c",
                                "text": "„Das Geld, schrieb ich meiner Tante am Ende des Sommers, reichte für eine Busfahrkarte nach Los Angeles, ein paar Übernachtungen in einem Motel, die Kaution für eine Wohnung in der Nähe von Chinatown und einen gebrauchten Ford, Baujahr 1964.“"
                            },
                            {
                                "example_id": "ea42ed7f-302d-4b8b-a4ec-47df7b3755a0",
                                "sense_id": "f7e70717-de30-38d6-8927-a610320d685c",
                                "text": "„Der Ford ist ein neueres Model, das sich sehr angenehm bedienen lässt.“"
                            },
                            {
                                "example_id": "bf24843d-4aa9-42bf-87ce-d577c3d1ea68",
                                "sense_id": "f7e70717-de30-38d6-8927-a610320d685c",
                                "text": "„Sein Wagen wäre mindestens fünf Jahre alt, nicht sonderlich gepflegt, würde jedoch Kraft und Stärke dokumentieren, etwa ein Ford, wie ihn die Polizei bevorzugt.“"
                            },
                            {
                                "example_id": "e8187349-cbc3-4a04-97cd-3aa52d6cf599",
                                "sense_id": "f7e70717-de30-38d6-8927-a610320d685c",
                                "text": "„Der Fahrer des Wagens, der Cafferatas Ford blockieren sollte, war nicht schnell genug, und Cafferatas Chauffeur konnte der Falle entkommen.“"
                            },
                            {
                                "example_id": "cedca4db-7eda-4e1c-8b35-0002d7d8b2f7",
                                "sense_id": "f7e70717-de30-38d6-8927-a610320d685c",
                                "text": "„Drei Stockwerke tiefer saßen zwei Typen in einem dunkelgrünen Ford, der einsam am gegenüberliegenden Randstein geparkt war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
