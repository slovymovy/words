                ],
                "senses": [
                    {
                        "sense_id": "4b85fb23-393c-3786-8b90-83481f10cc55",
                        "entry_id": "3e50cd58-4cb9-341e-9fb6-307459fcb846",
                        "glosses": [
                            "eine direkt auf einen Krug aufgebrachte Dekoration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61315c8-99ed-4c2c-8959-5779b6de5cc0",
                                "sense_id": "4b85fb23-393c-3786-8b90-83481f10cc55",
                                "text": "„Von da an wurden keine Formen mit neuen Bildern mehr angefertigt; man nützte die vorhandenen alten aus oder fertigte mittels scharfer Krugbilder neue an, die aber natürlich an Schärfe den Original-Arbeiten lange nicht gleich kommen.“"
                            },
                            {
                                "example_id": "05f3a41a-4d2e-42c5-b16e-0387110327c8",
                                "sense_id": "4b85fb23-393c-3786-8b90-83481f10cc55",
                                "text": "„In Bezug auf Schärfe der Detailornamente stehen die Krugbilder jener Werkstätten denen der Siegburger nach.“"
                            },
                            {
                                "example_id": "c38de299-1f54-4172-baa0-7bbb99378738",
                                "sense_id": "4b85fb23-393c-3786-8b90-83481f10cc55",
                                "text": "„Auf der Gemme ist das Krugbild des Osiris mit Blick nach links eingegraben.“"
                            },
                            {
                                "example_id": "a7a313b5-bbe3-49bc-8fbd-aeceba31e35e",
                                "sense_id": "4b85fb23-393c-3786-8b90-83481f10cc55",
                                "text": "„Genau an der Stelle, […], genau dort bricht im Lustspiel eine Scherbe aus dem einst so stattlichen Krugbild der Macht.“"
                            },
                            {
                                "example_id": "c6a1ea89-02ef-431e-bd3b-d03c70f829cc",
                                "sense_id": "4b85fb23-393c-3786-8b90-83481f10cc55",
                                "text": "„Ein Krugbild des Osiris (Abb. 167), wie es bei unrichtiger Benennung, doch vorzüglicher Wiedergabe auch die ISIS der kaiserlichen Schatzkammer (B) darstellt, ist, wenn nicht von einem Fälscher, dann von Fischer zu diesem Zweck benutzt worden.“"
                            },
                            {
                                "example_id": "07b2bd39-d155-4229-a1bb-563c1009d1f8",
                                "sense_id": "4b85fb23-393c-3786-8b90-83481f10cc55",
                                "text": "„[…]; einige Stücke sind mit dem Krugbild des Osiris verbunden (eins von ihnen ist besonders interessant, da das Bildnis vor dem Hintergrund einer sorgfältig dargestellten Tempelfassade gezeigt ist - Taf. 61,3c!).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
