{
    "word_family": [
        "lappa"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "107eeb16-38f0-3a17-addd-506059e90be0",
                    "sense_definition": "A traditional West African garment consisting of a large piece of fabric wrapped around the waist like a skirt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woman tied her colorful <w>lappa</w> securely before heading to the market.",
                            "target_lang_translations": {
                                "ru": "Женщина надежно завязала свою яркую <w>лаппу</w>, прежде чем отправиться на рынок."
                            }
                        },
                        {
                            "text": "She wore a matching blouse with her <w>lappa</w> for the traditional ceremony.",
                            "target_lang_translations": {
                                "ru": "На традиционную церемонию она надела подходящую блузку к своей <w>лаппе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pagne",
                        "sarong"
                    ],
                    "common_phrases": [
                        "wrap a lappa",
                        "traditional lappa"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "West Africa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная западноафриканская одежда, представляющая собой большой кусок ткани, обернутый вокруг талии как юбка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаппа",
                                "target_lang_sense_clarification": "традиционная африканская юбка"
                            },
                            {
                                "target_lang_word": "пань",
                                "target_lang_sense_clarification": "аналогичный предмет одежды в франкоязычной Африке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7306c6a-727a-3208-a178-6cab96f91ad9",
                    "sense_definition": "In cricket, a forceful, horizontal hit of the ball, often played with a cross-bat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cricket_strokes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman attempted a wild <w>lappa</w> but unfortunately missed the ball completely.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен попытался нанести яростный удар <w>лаппа</w>, но, к сожалению, совсем промахнулся по мячу."
                            }
                        },
                        {
                            "text": "When the ball bounced, the open stance was a good preliminary position from which to play the <w>lappa</w>.",
                            "target_lang_translations": {
                                "ru": "Когда мяч отскочил, открытая стойка была хорошей предварительной позицией для выполнения удара <w>лаппа</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swipe",
                        "slog"
                    ],
                    "common_phrases": [
                        "cross-batted lappa"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Caribbean"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: сильный горизонтальный удар по мячу, часто выполняемый поперечной битой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаппа",
                                "target_lang_sense_clarification": "размашистый удар в крикете"
                            },
                            {
                                "target_lang_word": "сильный удар",
                                "target_lang_sense_clarification": "горизонтальный удар битой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a52b28e6-0bf0-31c7-82b1-978447d681f2",
                    "sense_definition": "An ancient inland city-state located on the island of Crete.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ancient_geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Archaeologists have discovered significant Roman remains in the ancient city of <w>Lappa</w>.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили значительные римские руины в древнем городе <w>Лаппа</w>."
                            }
                        },
                        {
                            "text": "The territory of <w>Lappa</w> once stretched across the island from the north coast to the south.",
                            "target_lang_translations": {
                                "ru": "Территория <w>Лаппы</w> когда-то простиралась через весь остров от северного побережья до южного."
                            }
                        }
                    ],
                    "synonyms": [
                        "Lappa Crete"
                    ],
                    "common_phrases": [
                        "ancient Lappa"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical geography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древний внутренний город-государство, расположенный на острове Крит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лаппа",
                                "target_lang_sense_clarification": "древний город на Крите"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
