                        "régir une succession"
                    ]
                },
                {
                    "sense_id": "56114a67-9157-3c68-b7fe-7e562145b307",
                    "sense_definition": "En grammaire, commander un mot en imposant un cas ou une fonction syntaxique particulière.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "syntaxe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette phrase complexe, le verbe transitif direct <w>régit</w> un complément d'objet."
                        },
                        {
                            "text": "En latin classique, cette préposition spécifique <w>régit</w> toujours l'ablatif sans exception."
                        }
                    ],
                    "synonyms": [
