                            {
                                "example_id": "5e38515a-0deb-4954-a1bb-d10d363c9f6c",
                                "sense_id": "2ed290d8-a0ab-37be-922d-b413b802584e",
                                "text": "Cet arbre, ça fait de la pègue."
                            },
                            {
                                "example_id": "b9a7d466-1f68-418d-8f8a-89b255ec7c04",
                                "sense_id": "2ed290d8-a0ab-37be-922d-b413b802584e",
                                "text": "En règle générale, les descendants d’Italiens ne font pas trop cuire les pâtes. « Les Français, ils te font de la pègue », de la colle. La pègue, c’est le produit d’une cuisson relativement longue, unique façon de faire dans les familles françaises de souche jusqu’à une date récente."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddb07b22-b681-3bcb-ad07-2e4ee646b8f5",
                        "entry_id": "8a7f8f84-10c8-399d-822e-e94d96a31468",
                        "glosses": [
                            "Bonbon à la réglisse, de consistance molle."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
