                "senses": [
                    {
                        "sense_id": "c605b397-9b16-3c52-915b-766ba0c485fc",
                        "entry_id": "8871f71f-81a3-3535-86a3-354aa1b0e552",
                        "glosses": [
                            "To be unwilling; will not (+ infinitive)."
                        ],
                        "tags": [
                            "auxiliary",
                            "modal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a4ff10ee-55fd-4696-a7c3-53508af25b7b",
                                "sense_id": "c605b397-9b16-3c52-915b-766ba0c485fc",
                                "text": "I here auow thee neuer to forſake.\n Ill weares he armes, that nill them vſe for Ladies ſake."
                            },
                            {
                                "example_id": "0d6d0a82-a08e-4832-81f9-c2de066d4080",
                                "sense_id": "c605b397-9b16-3c52-915b-766ba0c485fc",
                                "text": "What I nill tell, you aske (quoth ſhe) in vaine,\n Nor mou’d by praier, nor conſtraind by powre[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "4ddc8dce-598a-3491-9bba-352efe074b43",
                        "entry_id": "8871f71f-81a3-3535-86a3-354aa1b0e552",
                        "glosses": [
                            "To be unwilling."
                        ],
                        "tags": [
                            "archaic",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3687d2a1-37d8-45ca-9450-4612e10fa333",
                                "sense_id": "4ddc8dce-598a-3491-9bba-352efe074b43",
                                "text": "I must indeed abide the Doom of Men, whether I will or I nill:[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7ee27a33-d390-39ab-bee1-fbf45ebe2927",
                        "entry_id": "8871f71f-81a3-3535-86a3-354aa1b0e552",
                        "glosses": [
                            "To reject, refuse, negate."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d8a8c4e9-629b-46b5-92b0-9a107b9c8fc1",
                                "sense_id": "7ee27a33-d390-39ab-bee1-fbf45ebe2927",
                                "text": "Certes (ſayd he) I n’ill thine offred grace,\n Ne to be made ſo happy doe intend[…]."
                            }
                        ]
                    }
