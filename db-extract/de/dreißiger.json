                "senses": [
                    {
                        "sense_id": "0557e1f0-c4a5-3e58-bbde-e19f9a64f213",
                        "entry_id": "9ecf2227-4fc5-31a0-ae39-90d9f45d50c7",
                        "glosses": [
                            "ein Objekt, das mit der Zahl 30 verknüpft ist, zum Beispiel mit der Modellnummer 30 oder einer Segelfläche von 30 qm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc3dcd9-92ae-427b-898e-e9970ce56abc",
                                "sense_id": "0557e1f0-c4a5-3e58-bbde-e19f9a64f213",
                                "text": "Ich fahre lieber den Dreißiger."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf85e252-579a-35a8-ad35-97c25002d100",
                        "entry_id": "9ecf2227-4fc5-31a0-ae39-90d9f45d50c7",
                        "glosses": [
                            "das vierte Jahrzehnt eines Jahrhunderts oder eines Lebens"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "bb7e5190-71cb-4a77-ab1f-d1249bcfaa8e",
                                "sense_id": "cf85e252-579a-35a8-ad35-97c25002d100",
                                "text": "Sie sind Ende der Dreißiger nach Norden geflohen."
                            },
                            {
                                "example_id": "8bffb451-4f14-4248-b530-92d80dbcec54",
                                "sense_id": "cf85e252-579a-35a8-ad35-97c25002d100",
                                "text": "Vermutlich wurde das Gebäude in den Dreißigern vor Christi fertiggestellt."
                            },
                            {
                                "example_id": "7f238a5b-b2f1-4992-852c-69196712cc2e",
                                "sense_id": "cf85e252-579a-35a8-ad35-97c25002d100",
                                "text": "Jetzt, wo sie ihre Dreißiger hinter sich gelassen hat, wird sie vielleicht etwas ruhiger und sesshafter."
                            },
                            {
                                "example_id": "dcaf45a8-ece0-437d-9af7-2fce861bca23",
                                "sense_id": "cf85e252-579a-35a8-ad35-97c25002d100",
                                "text": "„Die Alteingesessenen waren tolerant, und sie fanden, daß die mondäne Welt ihrem Ort nicht schlecht stand, als in den Dreißigern neue Fremdlinge kamen und lange blieben.“"
                            },
                            {
                                "example_id": "9b93e715-f833-485a-b89a-8ad032a2b117",
                                "sense_id": "cf85e252-579a-35a8-ad35-97c25002d100",
                                "text": "„In den späten Dreißigern wurde Herman zum Direktionsassistenten der Filiale in Newark befördert, eine Position, die hauptsächlich mit Juden besetzt war (und für diese, mit wenigen Ausnahmen, tatsächlich die höchste mögliche Position darstellte).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f02feb90-6d0e-3640-bbb8-a8236ac9cb7c",
                        "entry_id": "9ecf2227-4fc5-31a0-ae39-90d9f45d50c7",
                        "glosses": [
                            "Person, die zwischen 30 und 39 Jahren alt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "856b1c60-5099-4b33-afe4-79d63f26f02e",
                                "sense_id": "f02feb90-6d0e-3640-bbb8-a8236ac9cb7c",
                                "text": "Der smarte Dreißiger öffnet uns selbst die Tür."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
