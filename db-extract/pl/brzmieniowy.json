                        "examples": [
                            {
                                "example_id": "4d4f5cd4-5572-489b-9229-03cff96ff4b4",
                                "sense_id": "c244147b-f778-31c2-bab7-3068a49604bb",
                                "text": "Muzyka europejska posługuje się w oktawie 12 samoistnymi jakościami brzmieniowymi, które stanowią jej materiał dźwiękowy, czyli strój muzyczny"
                            },
                            {
                                "example_id": "63dfcdb0-b6d4-44b5-8955-8914602526dd",
                                "sense_id": "c244147b-f778-31c2-bab7-3068a49604bb",
                                "text": "Dźwięki różniące się od siebie o oktawę mają pomimo różnicy wysokości te samą jakość brzmieniową"
                            }
                        ],
