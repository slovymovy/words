                        "examples": [
                            {
                                "example_id": "77fe1907-608c-477f-b489-8927fe6f06b0",
                                "sense_id": "2b7a1290-9af0-34fa-986e-54d1a983ba70",
                                "text": "Je crois qu’il me trouve un peu couenne, — parce que ses blagues ne m’amusent pas."
                            },
                            {
                                "example_id": "e2a35572-3785-4be6-8e58-0305457519d4",
                                "sense_id": "2b7a1290-9af0-34fa-986e-54d1a983ba70",
                                "text": "C’est y couenne, hein, un homme qu’est bu !…"
                            }
                        ]
                    }
                ],
