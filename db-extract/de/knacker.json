                    {
                        "form_id": "6181a2e0-8a99-469a-9c16-6f9173abdcbc",
                        "entry_id": "89dff101-b826-3fa4-afd4-b24a09fd3f92",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Knacker"
                    },
                    {
                        "form_id": "f8b514da-490d-40b1-a532-b079a7292998",
                        "entry_id": "89dff101-b826-3fa4-afd4-b24a09fd3f92",
                        "tags": [
                            "accusative",
