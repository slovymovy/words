                "senses": [
                    {
                        "sense_id": "89f0ff8c-01c3-3f8e-86c9-c2ec6d8c04af",
                        "entry_id": "17672a0f-4f7b-3a41-a9ed-5ce137b164c5",
                        "glosses": [
                            "Qui aime collectionner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dcd966d-37c0-4975-9525-7be92e5ff66f",
                                "sense_id": "89f0ff8c-01c3-3f8e-86c9-c2ec6d8c04af",
                                "text": "Fatigué des femmes — non de la sienne — Renaud a quitté cette fièvre collectionneuse, cette anxiété de philatéliste qui le jetait au-devant d’une femme nouvelle : « Ah ! un exemplaire qui me manquait !… »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                "word": "collectionneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c9a207ec-a54c-4e0c-a856-6077080d6c3f",
                        "entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                        "tags": [
                            "plural"
                        ],
                        "form": "collectionneurs"
                    },
                    {
                        "form_id": "9d3d4f36-6151-4afe-ac2a-bb790aec7404",
                        "entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                        "tags": [
                            "feminine"
                        ],
                        "form": "collectionneuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                        "entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                        "glosses": [
                            "Personne qui collectionne quelque chose ; celui qui fait des collections."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "729adadf-5791-43bd-ac00-8cd9a67e5db1",
                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                "text": "Les journaux et les magazines qui alimentaient les cerveaux américains (car les livres, sur ce continent impatient, n’intéressaient plus que les collectionneurs) devinrent instantanément un feu d’artifice."
                            },
                            {
                                "example_id": "5bfad12e-fbc3-450c-90df-c894bd84363e",
                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                "text": "J’aime la nature telle que les dieux l’on faite, et j’aime tant à la voir que je ne trouve pas le temps de la regarder par les yeux des autres, comme font les collectionneurs de tableaux."
                            },
                            {
                                "example_id": "562140df-c2e0-490a-8d28-a0c22a7c52f1",
                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                "text": "— Il publia, en 1706, un recueil, Cent Vues de Venise, aux planches incisées avec une maestria qui lui fait le plus grand honneur et lui assure, aujourd'hui encore, l'admiration des iconophiles collectionneurs."
                            },
                            {
                                "example_id": "80df6bb0-8fba-4a74-8518-61b8aa6354e3",
                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                "text": "Un cartophile est un collectionneur de cartes postales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b34e1bf6-a69e-4cde-abaf-8f30d261fb79",
                        "source_entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                        "source_sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                        "target_lang_word": "Sammler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sammler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                        "entry_id": "0581115c-c573-3ead-b8a2-c9a3fb5b855e",
                                        "glosses": [
                                            "Person, die Gegenstände einer bestimmten Art (z. B. Münzen, Briefmarken, Karten) sammelt, meist als Hobby"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c1dd32-3044-448a-9848-a62b347f4652",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "Ansichtskarten aus der Zeit vor 1945 sind bei Sammlern sehr beliebt."
                                            },
                                            {
                                                "example_id": "c91d59b3-d47e-4b9c-9e18-c72dc0bbcfc3",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Meine Grundschullehrerin hieß auch Friede, denkt der Wolfram in mir, und meine finnische Liebe wurde auf den Namen Pia-Maria getauft, was nicht eben nach Jägern und Sammlern klingt.“"
                                            },
                                            {
                                                "example_id": "ce2145c8-0bd4-4920-891d-c082a93f5acc",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Aber dann kam hinzu, daß dies auch seine Wissenschaft hatte - der alte Elias entdeckte auf seine alten Tage die Wonnen des Sammlers (ohne es zu wissen).“"
                                            },
                                            {
                                                "example_id": "f0edb2a4-bb23-4702-841e-a3faadc044ee",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Doktor Mungole war ein Sammler.“"
                                            },
                                            {
                                                "example_id": "67d16baf-5e7b-4d33-8a94-c9b3f973b23e",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Auch Sung war eher ein Sammler als ein Geschäftsmann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d82d5066-1b6c-3487-8b7e-73c8d4f719b6",
                                        "entry_id": "0581115c-c573-3ead-b8a2-c9a3fb5b855e",
                                        "glosses": [
                                            "großes Rohr der Kanalisation"
                                        ],
                                        "tags": [
                                            "Straßenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7aa43f-af8b-4b90-a30d-d84192fd0a12",
                                                "sense_id": "d82d5066-1b6c-3487-8b7e-73c8d4f719b6",
                                                "text": "„Für das Schmutz- und Abwasser im Sammler gibt es landschaftlich unterschiedliche Ausdrücke wie Kanalwasser, Kanaljauche, Stadtlauge, städtisches Abwasser, Schleusenwasser, Sielwasser u.a.m.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8806a950-f77b-445a-829d-0b788e8782b0",
                        "source_entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                        "source_sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                        "target_lang_word": "collector",
