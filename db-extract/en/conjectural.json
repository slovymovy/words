                    {
                        "translation_id": "44e5d5e4-0fea-4403-8687-3426215bf433",
                        "source_entry_id": "4076749f-b45a-399b-853a-6f782d9ab9f2",
                        "source_sense_id": "d8891d88-7f78-3187-b237-8afb0235d9f4",
                        "source_sense_description": "in the nature of a conjecture",
                        "target_lang_word": "conjectural",
