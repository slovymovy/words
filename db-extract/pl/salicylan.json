                        "examples": [
                            {
                                "example_id": "f7f9f268-2e90-489b-ab7a-ba1a78631dce",
                                "sense_id": "6105b210-8731-35e0-a277-58d82452c893",
                                "text": "Naukowcy z Uniwersytetu Warmińsko-Mazurskiego pracują nad wyhodowaniem nowej odmiany wierzby o wysokiej zawartości salicylanów w korze"
                            },
                            {
                                "example_id": "6a01e7aa-d4aa-4b2a-a219-84bb23bd1a8f",
                                "sense_id": "6105b210-8731-35e0-a277-58d82452c893",
                                "text": "Za składniki czynne liści uznawane są salicylany, głównie salicylan metylu stanowiący ponad 95% olejku eterycznego oraz gaulteryna – jego glikozydowy prekursor obecny w świeżym surowcu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
