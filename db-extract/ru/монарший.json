                "senses": [
                    {
                        "sense_id": "339f7701-e6ea-3a4b-8fcb-a62d6dc4d8fe",
                        "entry_id": "34649f2f-68f0-37ea-861f-767c060ca47f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным монарх"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0819439a-8cde-409c-bdb8-989377e213b3",
                                "sense_id": "339f7701-e6ea-3a4b-8fcb-a62d6dc4d8fe",
                                "text": "По окончании двухнедельного траура, который длился до пятницы, Елизавета II вернулась к исполнению монарших обязанностей."
                            },
                            {
                                "example_id": "e0a137fb-ceae-4dac-93ef-44121e49a6f1",
                                "sense_id": "339f7701-e6ea-3a4b-8fcb-a62d6dc4d8fe",
                                "text": "Нравы двора, интриги, капризы фавориток — всё выворачивалось наизнанку, представляя монаршье правление сплошным маневрированием от одной юбки к другой."
                            }
                        ]
                    }
