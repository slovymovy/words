                        "examples": [
                            {
                                "example_id": "4bf2a95c-72bf-4e04-a4e9-1d5fcd0ff5ed",
                                "sense_id": "4d75d9c9-3415-3330-ab68-fd86882bbbdf",
                                "text": "Maar misschien was dat voor haar niet zo belangrijk, omdat het de staalmagnaat wellicht koud liet of ze al dan niet kon dansen."
                            },
                            {
                                "example_id": "fd52a0f3-42a2-45b2-a9e8-20cc3f7a2e72",
                                "sense_id": "4d75d9c9-3415-3330-ab68-fd86882bbbdf",
                                "text": "Een van hen was de steenrijke staalmagnaat en filantroop Andrew Carnegie, bekend van de New Yorkse Carnegie Hall. En hij had een bijzonder plan. Hij wilde een dinosaurus inzetten om de wereldvrede te bewaren."
                            },
                            {
                                "example_id": "1bee6607-86b9-43a2-9cd9-165e2e6f435e",
                                "sense_id": "4d75d9c9-3415-3330-ab68-fd86882bbbdf",
                                "text": "Russische superrijken willen af van hun voetbalclubs in Engeland. Zo liet staalmagnaat Alisher Oesmanov, die voor 30 procent eigenaar was van Arsenal, zich onlangs voor 550 miljoen pond uitkopen. En volgens Britse media zou Roman Abramovitsj zijn club Chelsea voor een geschatte 2,5 miljard pond van de hand willen doen."
                            }
                        ]
