                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746ec95a-c53b-4a24-8921-ffa80a5b89dd",
                                                "sense_id": "61e4ae0f-9c29-3b05-adbd-4a3c011f16e5",
                                                "text": "Par abus de langage, le terme « accesseur » peut aussi être employé pour désigner indifféremment l'une de ces deux méthodes : l’accesseur au sens strict, aussi bien que le mutateur."
                                            }
