                ],
                "senses": [
                    {
                        "sense_id": "068f4abf-1578-38f6-9891-d0c6004a04f0",
                        "entry_id": "796cdac3-9a4d-31af-8ccc-e713de87d094",
                        "glosses": [
                            "die Eurythmie/Eurhythmie betreffend, zu ihr gehörend, nach ihren Ideen und Vorgaben gestaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2e735c7-f2af-405a-972d-8de550ecfd42",
                                "sense_id": "068f4abf-1578-38f6-9891-d0c6004a04f0",
                                "text": "„Den untern Raum nehmen zunächst vier Figuren ein in eurythmischer Anordnung auseinander gehalten.“"
                            },
                            {
                                "example_id": "5a8c63c4-c938-4c6d-b060-9371599c627a",
                                "sense_id": "068f4abf-1578-38f6-9891-d0c6004a04f0",
                                "text": "„Dessen Laute, Sprachmelodieführung, Rhythmus und Akzente werden - eurythmisch aufgenommen - zu einer Gestalt, die hinter Faust auf der Bühne erscheint.“"
                            },
                            {
                                "example_id": "b36391cd-56da-4b4a-a853-d3d983870597",
                                "sense_id": "068f4abf-1578-38f6-9891-d0c6004a04f0",
                                "text": "„Eurythmisch dargestellt wird die soziale Utopie „Das Märchen von der grünen Schlange und der schönen Lilie“ von Johann Wolfgang von Goethe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
