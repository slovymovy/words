                "senses": [
                    {
                        "sense_id": "e4e8d659-9e23-3d5f-868b-00373c5ae0dd",
                        "entry_id": "bb7313ba-4a5c-31aa-92f5-f4a048a8fb28",
                        "glosses": [
                            "kurze, ruckartige Bewegung der Augenlider"
