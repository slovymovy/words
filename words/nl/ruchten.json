                    "frequency": "VeryLow",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De menigte begon luid te <w>ruchten</w> toen de spreker het podium betrad.",
                            "target_lang_translations": {
