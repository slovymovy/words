                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5334172c-4d97-4fcc-ba4d-0652ac0026f4",
                                                "sense_id": "753bf857-658c-38ad-b022-ab78136d3bb9",
                                                "text": "Bierkenner Marco Daane voert de geschiedenis van het brouwen nog verder terug, naar de prehistorie, hij beschrijft de overgang van haver naar gerst en van gruit naar hop, en laat de lezer niet in het ongewisse over de verschillen tussen het Limburgse ‘swartbier’, de Groninger ‘kluin’ waar men een ‘klunskonk’ van kreeg en de Hollandse ‘kuit’ die rond 1400 ontstond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a6c900-40c2-325e-9a1b-f342c51f239c",
                                        "entry_id": "51b119be-c248-315d-8d35-82205a3d2ef9",
                                        "glosses": [
                                            "iets samenstellen uit verschillende ingrediënten"
                                        ],
