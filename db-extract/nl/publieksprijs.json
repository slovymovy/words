                        "glosses": [
                            "een prijs waarbij het publiek (en dus niet een jury) beslist wie er wint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414ce66d-5cba-46f4-bbc6-fa10dfc3145d",
                                "sense_id": "56ae64fe-d509-3619-b551-acd1a24bb41b",
                                "text": "Le ciel Flamand van Peter Monsaert, dat net zoals Home genomineerd was in negen categorieën, wist twee van zijn nominaties te verzilveren: Wim Willaert won de Ensor voor beste mannelijke bijrol en David Williamson die voor beste fotografie. De publieksprijs voor beste Vlaamse film ging naar Sprakeloos van Hilde Van Mieghem."
                            },
                            {
                                "example_id": "da3d9e9d-7618-4521-a87a-67b7ce4d8c62",
                                "sense_id": "56ae64fe-d509-3619-b551-acd1a24bb41b",
                                "text": "De achtste editie van een festival voor jong Almelo's talent en grote namen, zoals Gregory Page vindt aankomende zondag plaats: Het Liedjesmakersfestival Paco Plumtrek in theater Hof 88. Dit jaar is er een extra feestelijk tintje. Het festival is genomineerd voor de publieksprijs Festival Award Overijssel 2017"
                            }
                        ]
                    }
