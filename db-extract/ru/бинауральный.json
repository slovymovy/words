                                "target_senses": [
                                    {
                                        "sense_id": "ead20794-a9d4-3c0a-8e50-44ca909fb5a9",
                                        "entry_id": "efbbe58c-d1ec-3df9-a739-88bd1b8657bf",
                                        "glosses": [
                                            "Of, relating to, affecting, or designed for use with two ears."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59e63602-4b38-48a1-a262-1d0edea68326",
                                                "sense_id": "ead20794-a9d4-3c0a-8e50-44ca909fb5a9",
                                                "text": "In 1839, German experimenter Heinrich Wilhelm Dove discovered that illusory \"beats\" are perceived when pure tones of slightly different frequency are separately and simultaneously presented to each ear. Dove's insight was to realize that since there is no acoustic mixing of the tones, the perceived beats must exist solely within the auditory system, specifically that part which processes binaural (e.g., \"stereo\") sound."
                                            }
                                        ]
                                    }
