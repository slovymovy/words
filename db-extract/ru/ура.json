                    {
                        "translation_id": "0cfa2cd5-1b1e-4a0d-8bd7-bc95d658078f",
                        "source_entry_id": "37d80994-d4d4-3490-8ba3-02c2e7aac891",
                        "source_sense_id": "997703aa-1d48-3391-8029-1dbdb89a2284",
