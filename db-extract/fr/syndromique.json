                ],
                "senses": [
                    {
                        "sense_id": "786298a3-9fed-34c7-bc2e-d5191caba8e5",
                        "entry_id": "2beed151-bb24-3600-b477-684dfa2b52cf",
                        "glosses": [
                            "Qualifie un élément de diagnostic qui fait partie d'un syndrome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb7da4c5-1ae9-4dde-90f0-3b41e4ba9f50",
                                "sense_id": "786298a3-9fed-34c7-bc2e-d5191caba8e5",
                                "text": "A ces premiers détails, il paraît bien que nous n’avons pas affaire à une entité morbide nouvelle, mais bien à un signe syndromique se rapportant à plusieurs sortes d’affections."
                            },
                            {
                                "example_id": "64481a87-b4ed-4e10-95cc-ce06cfc64722",
                                "sense_id": "786298a3-9fed-34c7-bc2e-d5191caba8e5",
                                "text": "On définit aujourd’hui deux catégories d’autisme : l’autisme syndromique et l’autisme non syndromique, toutes deux regroupées sous le terme générique de troubles du spectre autistique."
                            },
                            {
                                "example_id": "6c69e50b-576e-4338-a729-9e323d09a954",
                                "sense_id": "786298a3-9fed-34c7-bc2e-d5191caba8e5",
                                "text": "Bien que les surdités syndromiques ne représentent que 10 à 15 % (Marlin & Denoyelle, 2016), les atteintes associées physiques ou neuro-développementales sont retrouvées chez 30 à 40 % des enfants présentant une surdité (SFORL, 2018)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0c9b2c9-da67-4c16-9344-2e3e34ef8160",
                        "source_entry_id": "2beed151-bb24-3600-b477-684dfa2b52cf",
                        "source_sense_id": "786298a3-9fed-34c7-bc2e-d5191caba8e5",
                        "target_lang_word": "syndemic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syndemic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "718ba3fc-4da7-3ba1-8e15-ba2176676b43",
                                        "entry_id": "a1152af1-535e-30b8-8986-8cf77e1bccda",
                                        "glosses": [
                                            "An aggregation of two or more diseases that interact synergistically within a population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba0c914d-94d6-4da1-bf4a-e1d348786f6a",
                                                "sense_id": "718ba3fc-4da7-3ba1-8e15-ba2176676b43",
                                                "text": "In sum malnutrition, infectious disease, and cognitive impairment constitute a syndemic that is rooted in and perpetuates suboptimal social, political, and economic conditions."
                                            },
                                            {
                                                "example_id": "3568f1e7-ffd7-4a48-b044-eda7fc37039a",
                                                "sense_id": "718ba3fc-4da7-3ba1-8e15-ba2176676b43",
                                                "text": "The aggregation of these diseases on a background of social and economic disparity exacerbates the adverse effects of each separate disease. COVID-19 is not a pandemic. It is a syndemic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "syndemic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7111e4e9-b040-3db8-ac65-5355e01a68e9",
                                        "entry_id": "4f88be5c-e8f8-3758-820b-706665703a4b",
                                        "glosses": [
                                            "Describing such a situation"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2094637-271a-4b85-896a-4c2544d64072",
                                                "sense_id": "7111e4e9-b040-3db8-ac65-5355e01a68e9",
                                                "text": "The syndemic nature of the threat we face means that a more nuanced approach is needed if we are to protect the health of our communities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
