                        "entry_id": "86c5f4fc-123c-3030-9893-fe618a2bcf46",
                        "glosses": [
                            "Angehörige einer südostasiatischen Ethnie, die hauptsächlich in Malaysia, Thailand und Indonesien lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4bb8ca-3cc3-4240-bd35-4e60a725c1a3",
                                "sense_id": "85ab0a0d-a3b9-3c0d-8242-b696966875b1",
                                "text": "Die verwitwete Malaiin hatte drei Kinder zu versorgen."
                            },
                            {
                                "example_id": "afaa9cf8-decb-4e46-b8c6-93946e4366b0",
                                "sense_id": "85ab0a0d-a3b9-3c0d-8242-b696966875b1",
                                "text": "„Sie hatte sich nach Art der Malaiinnen in einen Sarong gewickelt und lag auf ihrer Ottomane.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
