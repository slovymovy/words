                    {
                        "sense_id": "a49f0d34-7e6e-302b-955a-1cf17b4185c0",
                        "entry_id": "ab96d414-3194-3358-94f0-2a8673a7ca12",
                        "glosses": [
                            "urządzenie sieciowe łączące ze sobą użytkowników różnych sieci, pełniące rolę węzła komunikacyjnego"
                        ],
                        "tags": [],
