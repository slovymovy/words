                        "examples": [
                            {
                                "example_id": "93160c70-024a-45f1-913d-5f6e69ca94a6",
                                "sense_id": "3f84e910-98f8-3be6-8a3c-6f765d02b1ac",
                                "text": "Paraît que gn'a d'argents-voyers que voudraient ce pont de guingoi pour pas effaroucher les borniclasses que regardent en Picardie si la Champagne brûle."
                            },
                            {
                                "example_id": "6367576b-19b3-4cc8-97a0-cfd10ea36729",
                                "sense_id": "3f84e910-98f8-3be6-8a3c-6f765d02b1ac",
                                "text": "Tas de borniclasses qu'ont pas voulu écouter ceusses qui connaissaient le détrancannement, y perdent la boussole, y z'en sont comme de bardoires contre un réverbère."
                            }
                        ]
                    }
