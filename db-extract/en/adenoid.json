                                                "sense_id": "589fd566-3f13-3102-8eaf-83716b888e07",
                                                "text": "Italië produceert en exporteert goede kwaliteit hazelnoten en amandelen."
                                            },
                                            {
                                                "example_id": "ef90ff76-1b0a-4a17-992a-80cf7bb96e0f",
                                                "sense_id": "589fd566-3f13-3102-8eaf-83716b888e07",
                                                "text": "Op kleurrijk beschilderde bordjes liggen mlawi's, croissantjes en chocoladebroodjes, twee spiegeleieren, olijven, olijfolie, versgebakken volkorenbrood, honing, boter en amandelpasta."
                                            }
