                "senses": [
                    {
                        "sense_id": "872a49af-71db-3799-8d14-020e08a82211",
                        "entry_id": "38dfc522-e429-3788-8ed5-9cdff58e7de6",
                        "glosses": [
                            "Filterstation für die Lymphe oder das Gewebewasser im Körper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec077cbc-f294-48ef-a03b-2ce88ec07d4a",
                                "sense_id": "872a49af-71db-3799-8d14-020e08a82211",
                                "text": "„Nun treten beim Kindergartenkind, also etwa von drei bis fünf Jahren, die Lymphdrüsen am Hals deutlich hervor und sind zusätzlich Sitz von Entzündungen.“"
                            },
                            {
                                "example_id": "107d75c8-1c71-43f9-b86a-2419c2c60676",
                                "sense_id": "872a49af-71db-3799-8d14-020e08a82211",
                                "text": "„Die Lymphdrüsen röten sich und werden groß wie Hühnereier.“"
                            },
                            {
                                "example_id": "aad7d300-e350-4a0f-977d-c0351f462a69",
                                "sense_id": "872a49af-71db-3799-8d14-020e08a82211",
                                "text": "„Das Fieber der Kranken sank, ihre Lymphdrüsen schwollen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
