    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ae036652-ad99-379f-b82c-5cdd2ba18303",
                "word": "Enoch",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7076af74-4eda-3a63-899c-72928ee3b0d1",
                        "entry_id": "ae036652-ad99-379f-b82c-5cdd2ba18303",
                        "glosses": [
                            "In the Bible, one of the few people recorded as being taken by God before death."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9199d0f8-b056-457e-80e7-6ce1e32a45c3",
                                "sense_id": "7076af74-4eda-3a63-899c-72928ee3b0d1",
                                "text": "Enoch was the son of Jared, and was Noah’s great grandfather."
                            },
                            {
                                "example_id": "f96d9f8a-57ac-4be8-8e44-6f03cb5b8588",
                                "sense_id": "7076af74-4eda-3a63-899c-72928ee3b0d1",
                                "text": "And Enoch walked with God: and he was not; for God took him."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b59a25b-d5d9-3aae-9c69-856be8a4c991",
                        "entry_id": "ae036652-ad99-379f-b82c-5cdd2ba18303",
                        "glosses": [
                            "The title of three apocryphal books of the Bible."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "afcb5076-171e-399e-90c0-830fc10db1c0",
                        "entry_id": "ae036652-ad99-379f-b82c-5cdd2ba18303",
                        "glosses": [
                            "First son of Cain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b8b036-76af-4019-861f-d605ef875062",
                                "sense_id": "afcb5076-171e-399e-90c0-830fc10db1c0",
                                "text": "And Cain knew his wife; and she conceived, and bare Enoch: and he builded a city, and called the name of the city, after the name of his son, Enoch."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e3f141f-d87c-36e6-b78e-d589d76dc5d7",
                        "entry_id": "ae036652-ad99-379f-b82c-5cdd2ba18303",
                        "glosses": [
                            "A male given name from Hebrew of biblical origin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11eabb40-f62e-474b-bec6-4faf63835c67",
                                "sense_id": "8e3f141f-d87c-36e6-b78e-d589d76dc5d7",
                                "text": "There Enoch spoke no word to any one,\n But homeward—home—what home? had he a home?\n His home, he walk'd."
                            }
                        ]
                    },
                    {
                        "sense_id": "db91a5f3-98fb-33f3-bab7-e7820e4ad7a4",
                        "entry_id": "ae036652-ad99-379f-b82c-5cdd2ba18303",
                        "glosses": [
                            "A First Nation reserve in Alberta, Canada; the postal name of Stony Plain Indian Reserve No. 135."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
