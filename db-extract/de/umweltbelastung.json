                "senses": [
                    {
                        "sense_id": "0caace55-9841-398f-99a5-bfd3576a853d",
                        "entry_id": "8508f5a6-2354-328f-9625-45baf10c9a3a",
                        "glosses": [
                            "Belastung der Umwelt mit Abfall- und Schadstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6955c60-fbed-47f8-af48-2f94ed0eee9b",
                                "sense_id": "0caace55-9841-398f-99a5-bfd3576a853d",
                                "text": "„Die Lebenserwartung in der DDR lag deutlich niedriger als in der Bundesrepublik, die Umweltbelastung dagegen teilweise dramatisch höher.“"
                            },
                            {
                                "example_id": "8f5e9e6f-3cfd-429e-81b9-6732a83a6831",
                                "sense_id": "0caace55-9841-398f-99a5-bfd3576a853d",
                                "text": "„Der Lärm, die vielen Menschen auf so engem Raum, das Fehlen von Kontrolle, der Tod meiner Eltern, all das waren Gründe genug, von der Umweltbelastung ganz zu schweigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
