                        "entry_id": "4d2a8ebd-8790-326e-9e12-5988603f703a",
                        "glosses": [
                            "A point in a program at which operation may be interrupted during debugging so that the state of the program at that point can be investigated."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
