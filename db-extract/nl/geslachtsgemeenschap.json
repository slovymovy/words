                ],
                "translations": [
                    {
                        "translation_id": "53062138-1230-4140-bcd7-1e59952dd08d",
                        "source_entry_id": "69148c11-f34e-3f96-a12d-6680a3aa80f4",
                        "source_sense_id": "d17556a7-7008-3ea2-8685-31b51f20af71",
                        "source_sense_description": "seks waarbij de man met zijn penis het lichaam van de partner binnengaat",
                        "target_lang_word": "Geschlechtsverkehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschlechtsverkehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                        "entry_id": "0536b6df-c80c-37ae-bb14-3342cb4d9d99",
                                        "glosses": [
                                            "geschlechtliche Vereinigung, bei welcher der erigierte Penis in die Vagina oder in den Anus des Sexualpartners eingeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cccffd33-a378-4f19-8775-8c481c80cbad",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "Sie hatten Geschlechtsverkehr, obwohl sie sich erst vor kurzem kennengelernt hatten."
                                            },
                                            {
                                                "example_id": "255dfd7b-c2ab-45e0-9663-be23c3961ac6",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "Immer wieder infizieren sich Menschen durch ungeschützten Geschlechtsverkehr mit zum Teil gefährlichen Krankheiten."
                                            },
                                            {
                                                "example_id": "5a242bf7-938a-4ea5-8592-eaadcb87bb6c",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "Erzwungener Geschlechtsverkehr ist als Vergewaltigung strafbar."
                                            },
                                            {
                                                "example_id": "f4017772-fb40-4e83-a344-06411bcd1003",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "In manchen Kulturkreisen muss oder musste Geschlechtsverkehr bereits am Tag der Hochzeit stattfinden."
                                            },
                                            {
                                                "example_id": "e9df04cc-8742-468c-bda1-578f1dbcf66f",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "Unter Verwandten ist zumeist vaginaler Geschlechtsverkehr verboten."
                                            },
                                            {
                                                "example_id": "e920a7a2-baa1-49af-8a6c-7217357cd54b",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "Trägt der Mann während des Geschlechtsverkehrs ein Kondom, so wird das Risiko einer Schwangerschaft bei seiner Geschlechtspartnerin deutlich reduziert."
                                            },
                                            {
                                                "example_id": "90954183-82d3-488c-b2fe-e9f1fc8dde3b",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "„Damals hatte ich noch keinen Geschlechtsverkehr und setzte nun auf diesen meine Hoffnung, leider vergebens.“"
                                            },
                                            {
                                                "example_id": "2b2e923c-da25-4dc8-93b1-506119f21021",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "„Er redete bloß immerzu mit seiner völlig monotonen Stimme von einer Puppe, mit der er im vergangenen Sommer angeblich Geschlechtsverkehr gehabt hatte.“"
                                            },
                                            {
                                                "example_id": "1762c719-284d-4eef-a08e-ae94ee30bcf8",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "„In ihrer Kellerwohnung an der Ecke 57th Street und Kimbark Avenue tanzte sie in Unterwäsche für Roth (»der Inbegriff der Bezauberung«), doch zu ihren Hemmungen gehörte auch Vaginismus, eine Verengung der Vagina, die Geschlechtsverkehr unmöglich machte.“"
                                            },
                                            {
                                                "example_id": "2effd0a3-f30a-48cf-904e-6fcfa018e8fe",
                                                "sense_id": "6d66e2dd-4552-3b7d-b39a-401b75e897aa",
                                                "text": "„Außerehelicher Geschlechtsverkehr zwischen »Juden und Staatsangehörigen deutschen oder artverwandten Blutes« ist ebenfalls verboten und kann mit Gefängnis oder Zuchthaus bestraft werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
