                                "target_senses": [
                                    {
                                        "sense_id": "848373d1-d6aa-3846-9a5d-bb17d095f5e5",
                                        "entry_id": "9f4e8445-c04d-35a5-a037-4f4ce1d27d6d",
                                        "glosses": [
                                            "strumento d'ingrandimento per osservare organismi piccolissimi come batteri e virus; deriva dalle invenzioni di Galileo Galilei; m. stereoscopico a visore binoculare per osservare parti non trasparenti; m. elettronico che utilizza una proiezione delle immagini con mezzi elettronici per un maggiore ingrandimento"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb931e7-a04d-4283-b090-fe08d18e7cc0",
                                                "sense_id": "848373d1-d6aa-3846-9a5d-bb17d095f5e5",
                                                "text": "i virus sono visibili solo con il microscopio elettronico"
                                            },
                                            {
                                                "example_id": "41322d13-fcfa-45bd-8cc6-7477bc77bf5c",
                                                "sense_id": "848373d1-d6aa-3846-9a5d-bb17d095f5e5",
                                                "text": "con l'invenzione del microscopio, gli scienziati poterono vedere come si riproducono le cellule viventi"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b617c141-6890-3383-94b0-db19eb45cb2e",
                                        "entry_id": "9f4e8445-c04d-35a5-a037-4f4ce1d27d6d",
                                        "glosses": [
                                            "una delle ottantotto costellazioni moderne"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eff7cf47-ea1f-4a06-a751-ac9b557f3022",
                        "source_entry_id": "a3e0d19c-7e1d-304e-9f62-3db7f39207c7",
                        "source_sense_id": "33fa5b70-0998-384c-b378-1ad63197734f",
