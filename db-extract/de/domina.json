                        "sense_id": "335b72ce-fd3f-3e57-a859-1ed6169ca5ec",
                        "entry_id": "0ebfc616-773b-3bfc-bf26-8f851ae64eaf",
                        "glosses": [
                            "Prostituierte, die einem Kunden Befriedigung verschafft, indem sie ihn wunschgemäß quält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21ebfcb-174b-472f-b619-6779628f81bc",
                                "sense_id": "335b72ce-fd3f-3e57-a859-1ed6169ca5ec",
                                "text": "„Der eine kann nur vögeln, wenn ihn irgendeine Domina mit der Peitsche bearbeitet.“"
                            },
                            {
                                "example_id": "fefb9c30-a1e9-4286-82f4-e7a9e3d933f0",
                                "sense_id": "335b72ce-fd3f-3e57-a859-1ed6169ca5ec",
                                "text": "„Ein nicht geringer Prozentsatz betuchter Männer besucht sogar regelmäßig eine Domina und lässt sich von ihr für zweihundertfünfzig Euro eine Stunde lang demütigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e02890f-7d8a-4e65-a5e8-dee75439dbee",
                        "source_entry_id": "0ebfc616-773b-3bfc-bf26-8f851ae64eaf",
                        "source_sense_id": "335b72ce-fd3f-3e57-a859-1ed6169ca5ec",
                        "source_sense_description": "Prostituierte, die einem Kunden Befriedigung verschafft, indem sie ihn wunschgemäß quält",
                        "target_lang_word": "dominatrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dominatrix",
