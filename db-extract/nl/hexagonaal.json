                    {
                        "sense_id": "2648ed85-cb5c-3903-9538-0d7007c42acf",
                        "entry_id": "5de3aeff-75ec-3706-ae17-9fe81fede911",
                        "glosses": [
                            "als hoofdas van de rotatiesymmetrie een zestallige as bezittend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b58d2f9-67b9-4c99-911c-37e4f1d507e3",
                                "sense_id": "2648ed85-cb5c-3903-9538-0d7007c42acf",
                                "text": "Een hexagonale eenheidscel heeft twee rechte hoeken en een hoek van 120 graden, net als de trigonale, maar de rotatiesymmetrie is hoger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68cdc443-ff1e-4769-8baf-c6683c679e2b",
                        "source_entry_id": "5de3aeff-75ec-3706-ae17-9fe81fede911",
