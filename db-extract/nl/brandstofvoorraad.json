                        "examples": [
                            {
                                "example_id": "a3215474-22a8-4f51-9922-10512e53cd25",
                                "sense_id": "ecbb9d7a-bd72-3567-8bb5-3e52af8d0de4",
                                "text": "Aan boord van het toestel, een Hercules-vliegtuig van Defensie, zijn dekens, ledlampen en droog voedsel. Het vliegtuig vliegt niet rechtstreeks naar Erbil. Omdat de brandstofvoorraad daar te beperkt is, maakt het toestel een tussenlanding in Roemenië."
                            },
                            {
                                "example_id": "c4f26fe9-1143-4536-a4f2-21e23442baf1",
                                "sense_id": "ecbb9d7a-bd72-3567-8bb5-3e52af8d0de4",
                                "text": "Alleen de kleinere luchthavens, zoals Nice en Nantes, hebben nog problemen met de brandstofvoorraad. Zij krijgen hulp van andere luchthavens die een deel van hun voorraden afstaan."
                            }
                        ]
                    }
