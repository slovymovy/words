                    {
                        "sense_id": "c5acf642-e2ba-39a5-b11f-71c47dbc579d",
                        "entry_id": "fd053bdd-e2a3-3190-9d97-379ff63b86c8",
                        "glosses": [
                            "muzieknummer dat een radiostation of -programma laat horen op verzoek van een luisteraar: de aanvrager"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561ebc8a-1c6a-492f-b989-4754a963af84",
                                "sense_id": "c5acf642-e2ba-39a5-b11f-71c47dbc579d",
                                "text": "Eurocommissaris Frans Timmermans doet maandag de deur van het Glazen Huis op slot. Hij mag daarna als eerste een verzoekplaat indienen en een donatie door de welbekende brievenbus schuiven."
                            },
                            {
                                "example_id": "96555391-f317-4515-9503-222becb746de",
                                "sense_id": "c5acf642-e2ba-39a5-b11f-71c47dbc579d",
                                "text": "Nick Geitenbeek, Tim Harink, Niels Haarhuis, Jesse Masselink en Rick Hammink zijn van woensdag 18 december 19.00 uur tot donderdag 19 december 19.00 uur 24 uur actief als deejay, net als de radiomakers in het Glazen Huis in Leeuwarden. De leerlingen vragen 0,50 euro per verzoekplaat. Ook andere scholieren spannen zich in. Alle groepen van de school bedenken acties om geld in te zamelen."
                            }
                        ]
                    }
