                                "target_senses": [
                                    {
                                        "sense_id": "24e0a490-9639-3c0c-8afd-a658b077e0c3",
                                        "entry_id": "4bd323fc-e288-3b34-9cc5-f497c56c55e7",
                                        "glosses": [
                                            "Hermaphrodisme séquentiel dans lequel la maturation des gamètes femelles précède celle des gamètes mâles, ce qui rend l’autogamie (ou autofécondation) plus difficile, voire impossible. → voir dichogamie"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cda81171-7217-3641-8bc0-1b3de16fae3c",
                                        "entry_id": "4bd323fc-e288-3b34-9cc5-f497c56c55e7",
                                        "glosses": [
                                            "Hermaphrodisme séquentiel dans lequel la maturation des gamètes femelles précède celle des gamètes mâles, ce qui rend l’autogamie (ou autofécondation) plus difficile, voire impossible. → voir dichogamie",
                                            "Maturation des stigmates, organes femelles recueillant le pollen, précédant celle des anthères (organes mâles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31dcab32-f031-4f05-9248-adf825b38481",
                                                "sense_id": "cda81171-7217-3641-8bc0-1b3de16fae3c",
                                                "text": "La protogynie favorise la pollinisation croisée : les anthères étant fanées quand les stigmates murissent, la fécondation ne peut se faire que d’une fleur à l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab028db-058f-3cf8-902c-6c8e364434ed",
                                        "entry_id": "4bd323fc-e288-3b34-9cc5-f497c56c55e7",
                                        "glosses": [
                                            "Hermaphrodisme séquentiel dans lequel la maturation des gamètes femelles précède celle des gamètes mâles, ce qui rend l’autogamie (ou autofécondation) plus difficile, voire impossible. → voir dichogamie",
                                            "Hermaphrodisme où l'espèce est d’abord femelle puis mâle afin d’améliorer l’efficacité de la reproduction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f8dec0-bc3d-4a6a-ac16-7e5b13d9631f",
                                                "sense_id": "6ab028db-058f-3cf8-902c-6c8e364434ed",
                                                "text": "La protogynie de certains poissons ne facilite pas leur identification. Chez certaines espèces de poissons perroquets par exemple, le mâle est très coloré tandis que la femelle est plus terne, mais les jeunes mâles ressemblent à s’y méprendre aux femelles!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
