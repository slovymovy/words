                        "entry_id": "9a922453-3de1-349c-ad1c-e2bd1e74ed4c",
                        "glosses": [
                            "een verhaal of stuk waarin men een bepaald gezichtspunt met argumenten tracht te onderbouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f09cd5-b948-4bb8-b8f1-888a7b718073",
                                "sense_id": "e52455a3-c886-30dd-a835-534488cc559f",
                                "text": "Als ik dan dat áálgladde betoogje van de heer De Hoop Scheffer hoor, dan wordt het bij mij koud."
                            },
                            {
                                "example_id": "22ec6cad-6a98-44ec-8b21-ac399299739b",
                                "sense_id": "e52455a3-c886-30dd-a835-534488cc559f",
                                "text": "Een kort en krachtig betoog werkt meestal beter dan een eindeloos durende toespraak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4158502b-54c7-4869-beec-027527461e61",
