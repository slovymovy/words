                            "target_lang_translations": {
                                "en": "The chef put on his white <w>apron</w> before he started preparing the dinner."
                            }
                        },
                        {
                            "text": "Vergeet niet een <w>schort</w> voor te binden als je gaat schilderen om vlekken te voorkomen.",
                            "target_lang_translations": {
