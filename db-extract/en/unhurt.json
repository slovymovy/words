                "senses": [
                    {
                        "sense_id": "0260b91d-a284-3c57-8979-7d35ca5e8c6a",
                        "entry_id": "4eb6627a-c7cf-3943-9014-11791d06f638",
                        "glosses": [
                            "Not hurt; unharmed or unscathed"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6bd87045-23fb-4287-97c5-fd6119958f45",
                                "sense_id": "0260b91d-a284-3c57-8979-7d35ca5e8c6a",
                                "text": "The 0812 Huddersfield-Sheffield service struck the stabiliser leg of a lorry being used to take away portable toilets after local repair work. [...] The train crew and 25 passengers were unhurt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f81fe5ce-29be-4afd-8aac-bb9d4397b394",
                        "source_entry_id": "4eb6627a-c7cf-3943-9014-11791d06f638",
                        "source_sense_id": "0260b91d-a284-3c57-8979-7d35ca5e8c6a",
                        "source_sense_description": "not hurt",
                        "target_lang_word": "ongedeerd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongedeerd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae6be6b-5216-3cbc-b5cb-53a1984d149f",
                                        "entry_id": "ad0e5407-b211-34ce-b651-bbae07f0d08b",
                                        "glosses": [
                                            "niet verwond door het gebeuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfcc2073-41d9-476b-ac0d-f0706b6c8520",
                                                "sense_id": "4ae6be6b-5216-3cbc-b5cb-53a1984d149f",
                                                "text": "Er waren wonder boven wonder een aantal ongedeerde passagiers na die vliegramp."
                                            },
                                            {
                                                "example_id": "820e683a-edb4-4aae-8347-c33a11e29e25",
                                                "sense_id": "4ae6be6b-5216-3cbc-b5cb-53a1984d149f",
                                                "text": "'Alles is voor elkaar,' zei hij. 'Meer hoeven we voorlopig niet te doen. De Koning schijnt nog ongedeerd te zijn en de Mollen zijn aan het werk, zodat wij rustig kunnen wachten op de dag van morgen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d528653-8bc6-4be2-9293-2880c1b7491d",
                        "source_entry_id": "4eb6627a-c7cf-3943-9014-11791d06f638",
                        "source_sense_id": "0260b91d-a284-3c57-8979-7d35ca5e8c6a",
                        "source_sense_description": "not hurt",
                        "target_lang_word": "indemne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indemne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5159e943-61a4-382c-b75d-beca708aa0cd",
                                        "entry_id": "4be9d025-6dec-39f2-a56e-c35a2a532d35",
                                        "glosses": [
                                            "Qui n’a pas éprouvé de perte, qui est indemnisé, dédommagé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7cd2277-f12f-4367-a767-f5582ccd88a9",
                                                "sense_id": "5159e943-61a4-382c-b75d-beca708aa0cd",
                                                "text": "Rendre quelqu’un indemne."
                                            },
                                            {
                                                "example_id": "a305d03c-2c86-4bda-9f2a-e6f933cc0883",
                                                "sense_id": "5159e943-61a4-382c-b75d-beca708aa0cd",
                                                "text": "Sortir indemne d’une affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d232f537-972a-37fa-a941-8b40cc18bbbd",
                                        "entry_id": "4be9d025-6dec-39f2-a56e-c35a2a532d35",
                                        "glosses": [
                                            "Qui n’éprouve, qui n’a éprouvé aucun dommage."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2a5b9a-71a7-45af-b59d-02a66b3ab0b6",
                                                "sense_id": "d232f537-972a-37fa-a941-8b40cc18bbbd",
                                                "text": "L’un sera criblé de maladies vénériennes, l’autre sera indemne."
                                            },
                                            {
                                                "example_id": "37fca23f-86d3-4e6c-a0a6-46f9a8c8bcc7",
                                                "sense_id": "d232f537-972a-37fa-a941-8b40cc18bbbd",
                                                "text": "Et puis, il a desserré peu à peu le crin, dégagé le cou. Il s'est assuré que la bête est indemne, la strangulation inefficace encore."
                                            },
                                            {
                                                "example_id": "d843d7a4-63af-4da3-84b2-95726a367390",
                                                "sense_id": "d232f537-972a-37fa-a941-8b40cc18bbbd",
                                                "text": "Un vétérinaire de campagne de 45 ans, dont la voiture a été traînée sur une quarantaine de mètres par une locomotive, est sorti indemne de l'accident, mercredi à Alland’huy-et-Sausseuil (Ardennes), a-t-on appris auprès des gendarmes."
                                            },
                                            {
                                                "example_id": "c55c2238-2d39-427e-a6f3-9dcfd5726e37",
                                                "sense_id": "d232f537-972a-37fa-a941-8b40cc18bbbd",
                                                "text": "« Les femmes dont les mères sont ostéoporotiques ont en moyenne des densités osseuses plus faibles que celles dont les mères sont indemnes d’ostéoporose », indique le Dr Lespessailles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
