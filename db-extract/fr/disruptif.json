                                    {
                                        "sense_id": "b9c9d047-a380-3f6a-93c7-36e304a6859f",
                                        "entry_id": "4a746df9-a3d3-3f03-8bf9-6f5af86a01b7",
                                        "glosses": [
                                            "Causing disruption or unrest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fcf36be-3018-4ee0-8a8d-e8e0e74a4708",
                                                "sense_id": "b9c9d047-a380-3f6a-93c7-36e304a6859f",
                                                "text": "Children who exhibit disruptive behaviour may be expelled from school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a85d49a5-2a11-358f-80c0-4c54eb4f7175",
                                        "entry_id": "4a746df9-a3d3-3f03-8bf9-6f5af86a01b7",
                                        "glosses": [
                                            "Causing major change, as in a market."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf0a42ce-3cb8-47d3-a8f2-4f82e1b0918f",
                                                "sense_id": "a85d49a5-2a11-358f-80c0-4c54eb4f7175",
                                                "text": "disruptive technologies"
                                            },
                                            {
                                                "example_id": "d4705698-5fe8-4b77-949d-8d10953eb5c7",
                                                "sense_id": "a85d49a5-2a11-358f-80c0-4c54eb4f7175",
                                                "text": "Each time a disruptive technology emerged, between one-half and two-thirds of the established manufacturers failed to introduce models employing the new architecture—in stark contrast to their timely launches of critical sustaining technologies."
                                            },
                                            {
                                                "example_id": "d4122c94-9f03-4392-a6fe-6b88e360813a",
                                                "sense_id": "a85d49a5-2a11-358f-80c0-4c54eb4f7175",
                                                "text": "[…] companies tend to lose their leadership positions to companies that enter the market with a disruptive technology or market change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
