                ],
                "senses": [
                    {
                        "sense_id": "d17e8ce0-9da5-3d9f-bb11-f3efdfa5aacb",
                        "entry_id": "6109c8e6-b6fb-3e6d-9d68-e508e6ed527e",
                        "glosses": [
                            "wissenschaftliche Erforschung des Herz-Kreislauf-Systems, insbesondere mit dem Ziel, neue Präventions-, Diagnose- und Behandlungsmethoden zu entwickeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea38b699-cb49-43a7-a8e9-502ac1ce29c5",
                                "sense_id": "d17e8ce0-9da5-3d9f-bb11-f3efdfa5aacb",
                                "text": "„Bürgers Forschungsbereiche waren die Kreislaufforschung, Hepatitsforschung und Alternsforschung.“"
                            },
                            {
                                "example_id": "f3ed208c-e9b8-419f-bac5-448180470a65",
                                "sense_id": "d17e8ce0-9da5-3d9f-bb11-f3efdfa5aacb",
                                "text": "„Die Kreislaufforschung war für die Luftwaffe von besonderem Interesse.“"
                            },
                            {
                                "example_id": "727a4a4c-5039-4cce-a401-e51451de7571",
                                "sense_id": "d17e8ce0-9da5-3d9f-bb11-f3efdfa5aacb",
                                "text": "„Die Stiftung bietet jungen Wissenschaftlern zusätzliche Anreize, sich gezielt in der Herz- und Kreislaufforschung zu engagieren, und ist mit 12.000 EUR dotiert.“"
                            },
                            {
                                "example_id": "0ff7062b-c131-44f0-baf8-aa256c8fd0eb",
                                "sense_id": "d17e8ce0-9da5-3d9f-bb11-f3efdfa5aacb",
                                "text": "„Die Anträge verteilen sich wie folgt auf die Forschungsschwerpunkte der Medizinischen Fakultät: uns erreichten 27 Anträge aus dem Bereich Infektionsforschung und Immunologie, 3 aus der Nieren- und Kreislaufforschung, 9 aus dem Bereich Neurowissenschaften, 12 aus der Tumorforschung und 1 Antrag aus der Medizintechnologieentwicklung.“"
                            },
                            {
                                "example_id": "3a949029-3d7b-4394-99fc-15f4fbcfa95f",
                                "sense_id": "d17e8ce0-9da5-3d9f-bb11-f3efdfa5aacb",
                                "text": "„Das Laborjournal untersuchte nun in einer diesen Monat erschienenen Publikationsanalyse der Jahre 2008 bis 2012 zum Thema Herz- und Kreislaufforschung, welche Veröffentlichungen und welche Autoren in diesem Zeitraum am häufigsten zitiert wurden.“"
                            },
                            {
                                "example_id": "c057ffc0-9755-4384-84cc-0b0800ae1992",
                                "sense_id": "d17e8ce0-9da5-3d9f-bb11-f3efdfa5aacb",
                                "text": "„Als Diplom-Biologe ging er 1958 an die Arbeitsstelle für Kreislaufforschung, Arbeitsgruppe für Biochemie, der ehemaligen Akademie der Wissenschaften der DDR nach Berlin-Buch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
