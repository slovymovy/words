                    "frequency": "High",
                    "semantic_group_id": "zustand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte bring dein Zimmer vor dem Abendessen in <w>Ordnung</w>."
                        },
                        {
                            "text": "Auf seinem Schreibtisch herrscht immer eine perfekte <w>Ordnung</w>."
                        }
                    ],
                    "antonyms": [
                        "Unordnung",
                        "Chaos"
                    ],
                    "common_phrases": [
