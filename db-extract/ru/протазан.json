                "senses": [
                    {
                        "sense_id": "7543e305-8c14-3c03-ac42-9f7a40e8e1af",
                        "entry_id": "cf314269-147d-34b5-895a-59806e71512f",
                        "glosses": [
                            "истор. старинное колющее оружие, разновидность копья, состоящая из длинного древка и насаженного на него широкого плоского металлического наконечника с ушками в форме месяца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea7b3b9d-9744-42d2-9333-b375622716af",
                                "sense_id": "7543e305-8c14-3c03-ac42-9f7a40e8e1af",
                                "text": "К слову «протазан» дано примечание: «Алебарда, бердыш, широкое копьё»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "540edfcf-4bb6-4c41-831f-ae232ca7aa47",
                        "source_entry_id": "cf314269-147d-34b5-895a-59806e71512f",
                        "source_sense_id": "7543e305-8c14-3c03-ac42-9f7a40e8e1af",
                        "target_lang_word": "partisan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partisan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6929d014-0269-3099-b1e6-28d9a6a2eeae",
                                        "entry_id": "38fd3878-9290-3e09-bc8b-d82fb9cb10a6",
                                        "glosses": [
                                            "An adherent to a party or faction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d268945-9664-4765-8a0d-e3f40f84d55a",
                                                "sense_id": "6929d014-0269-3099-b1e6-28d9a6a2eeae",
                                                "text": "\"Strong partisans of neither party, Indiana farmers failed to act as a block […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06636497-1449-34ab-abe9-fcb556f7bd40",
                                        "entry_id": "38fd3878-9290-3e09-bc8b-d82fb9cb10a6",
                                        "glosses": [
                                            "A fervent, sometimes militant, supporter or proponent of a party, cause, faction, person, or idea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b43b1cd-662a-3e5a-a427-766274edb2cb",
                                        "entry_id": "38fd3878-9290-3e09-bc8b-d82fb9cb10a6",
                                        "glosses": [
                                            "A member of a band of detached light, irregular troops acting behind occupying enemy lines in the ways of harassment or sabotage; a guerrilla fighter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8d3cda2-3388-3b9e-8450-b1719b531e62",
                                        "entry_id": "38fd3878-9290-3e09-bc8b-d82fb9cb10a6",
                                        "glosses": [
                                            "The commander of a body of detached light troops engaged in making forays and harassing an enemy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "partisan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22781f6f-4c3f-3a35-be59-60c009cf4d59",
                                        "entry_id": "07d54a4d-c05a-37b4-8192-cc5a10931008",
                                        "glosses": [
                                            "Serving as commander or member of a body of detached light troops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f605e456-4b50-4bd1-b4e5-0f38864904b4",
                                                "sense_id": "22781f6f-4c3f-3a35-be59-60c009cf4d59",
                                                "text": "partisan officer, partisan corps"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055b0a25-7a08-3d68-a733-96d830096c2f",
                                        "entry_id": "07d54a4d-c05a-37b4-8192-cc5a10931008",
                                        "glosses": [
                                            "Adherent to a party or faction; especially, having the character of blind, passionate, or unreasonable adherence to a party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd46876-a881-4a8b-872a-cbab18874526",
                                                "sense_id": "055b0a25-7a08-3d68-a733-96d830096c2f",
                                                "text": "They were blinded by partisan zeal."
                                            },
                                            {
                                                "example_id": "acc17860-0f3a-4815-9379-3853fb469a7c",
                                                "sense_id": "055b0a25-7a08-3d68-a733-96d830096c2f",
                                                "text": "Having put partisan interests to one side, Greenwood set about making teamwork a watchword for her chairmanship, while seeking the broadest possible participation in subsequent inquiries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "971efdf4-1249-31ac-b4b6-71367c025339",
                                        "entry_id": "07d54a4d-c05a-37b4-8192-cc5a10931008",
                                        "glosses": [
                                            "Devoted to or biased in support of a party, group, or cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a8ee248-d85e-4848-93a6-c252accef861",
                                                "sense_id": "971efdf4-1249-31ac-b4b6-71367c025339",
                                                "text": "partisan politics"
                                            },
                                            {
                                                "example_id": "a942913c-2932-41ad-86ed-2e4ac814a22b",
                                                "sense_id": "971efdf4-1249-31ac-b4b6-71367c025339",
                                                "text": "England will regard it as a measure of justice for Frank Lampard's disallowed goal against Germany in Bloemfontein at the 2010 World Cup - but it was also an illustration of how they rode their luck for long periods in front of a predictably partisan home crowd."
                                            },
                                            {
                                                "example_id": "a54e0977-0b28-42cd-80b2-c510b35bb1f5",
                                                "sense_id": "971efdf4-1249-31ac-b4b6-71367c025339",
                                                "text": "He finds, not “demigods” but “a combative group of exhausted, drunken, broken, petty, partisan, scheming, squabbling, bloviating, sensory-deprived, underoxygenated, fed-up, talked-out, overheated delegates so distraught they threatened violence, secession."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "partisan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c1b6f3e-ac58-3fd1-98b3-a2d7a774c5dd",
                                        "entry_id": "cae05f2f-d451-31b2-bcb3-1f6780c36fce",
                                        "glosses": [
                                            "A long-handled spear with a triangular, double-edged blade having lateral projections, in some forms also used in boar hunting."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb95313-ab55-4746-86f2-fc2c1161aef6",
                                                "sense_id": "7c1b6f3e-ac58-3fd1-98b3-a2d7a774c5dd",
                                                "text": "I had as lief have a reed that will do me no service as a partisan I could not heave."
                                            },
                                            {
                                                "example_id": "19947927-6513-4f85-a140-4961c4e01e57",
                                                "sense_id": "7c1b6f3e-ac58-3fd1-98b3-a2d7a774c5dd",
                                                "text": "Salisbury and his attendants were also now drawing near, with bills and partisans brandished, and bows already bended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b51bc177-212d-332b-968b-857cb33f9fa3",
                                        "entry_id": "cae05f2f-d451-31b2-bcb3-1f6780c36fce",
                                        "glosses": [
                                            "A soldier armed with such a weapon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
