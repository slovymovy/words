                "senses": [
                    {
                        "sense_id": "1a67e22b-c905-33e1-abb8-61d95960fadd",
                        "entry_id": "e0ba6e29-3cb0-3ac3-be07-5a8c24eaf748",
                        "glosses": [
                            "System, das mediale Inhalte erst nach der Bezahlung einer bestimmten Summe verfügbar macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b056491b-41fe-4b6f-8b0a-2cdc92c37b63",
                                "sense_id": "1a67e22b-c905-33e1-abb8-61d95960fadd",
                                "text": "„Ab Sommer will die US-Zeitung eine Paywall für ihre Online-Angebote einführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5f0b1a0-d7b6-4641-8488-381a4354bb42",
                        "source_entry_id": "e0ba6e29-3cb0-3ac3-be07-5a8c24eaf748",
                        "source_sense_id": "1a67e22b-c905-33e1-abb8-61d95960fadd",
                        "source_sense_description": "System, das mediale Inhalte erst nach der Bezahlung einer bestimmten Summe verfügbar macht",
                        "target_lang_word": "paywall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paywall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                        "entry_id": "b9af5c2d-445e-3ad3-b737-556fababdbf3",
                                        "glosses": [
                                            "A system that restricts access to content with a purchase or a paid subscription."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f6c639-6809-4e28-93c5-fbc803ccbcda",
                                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                                "text": "The premium content on this website is behind a paywall."
                                            },
                                            {
                                                "example_id": "8c5cee33-9bac-49f6-89f8-135ccc7f12f6",
                                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                                "text": "Techdirt got wind of a secret meeting by newspaper execs, complete with antitrust lawyers, to discuss how to proceed on the issue of implementing paywalls going forward."
                                            },
                                            {
                                                "example_id": "fda90985-a7df-4489-9437-786dbb54c759",
                                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                                "text": "Scores of other newspapers started selling digital subscriptions in 2011, either with a paywall on their sites or by charging for mobile access with an e-reader app. […] Time magazine also set up a paywall in 2011, its second attempt in two years, […]"
                                            },
                                            {
                                                "example_id": "3123d537-f9f8-4808-9b19-d5a9bd9310d8",
                                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                                "text": "As for the larger general-interest dailies, Long Island's Newsday was the first to erect its paywall, in October 2009. It allowed full access for subscribers to the print edition of the paper or the parent company Cablevision, or for people willing to pay $5 per week."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paywall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "072bfdb1-5bf2-3bea-96e9-576179baec64",
                                        "entry_id": "ac55ade3-a848-3738-9c5c-49a13afa31fb",
                                        "glosses": [
                                            "To restrict access to (a website or other resource) by means of a paywall."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e05c72c-b188-4e32-92eb-695803381078",
                        "source_entry_id": "e0ba6e29-3cb0-3ac3-be07-5a8c24eaf748",
                        "source_sense_id": "1a67e22b-c905-33e1-abb8-61d95960fadd",
                        "source_sense_description": "System, das mediale Inhalte erst nach der Bezahlung einer bestimmten Summe verfügbar macht",
                        "target_lang_word": "paywall",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paywall",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b498daa9-8143-3373-82d6-faf204e56704",
                                        "entry_id": "45b1318f-8854-3334-8a73-da269a46ce7e",
                                        "glosses": [
                                            "Site dont une partie du contenu est visible gratuitement et dont l’entièreté est disponible sous condition de paiement."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eafecf45-9dfd-49e7-8a30-c04c1430a39e",
                                                "sense_id": "b498daa9-8143-3373-82d6-faf204e56704",
                                                "text": "Ces modèles de paywall, après la lecture de 15 ou 20 articles, et d’abonnements vont-ils s’imposer peu à peu, comme l’indiquent les chiffres venus des États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
