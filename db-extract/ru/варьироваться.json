                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4bf9f02-e91e-348b-ab60-6a0b40af789d",
                        "entry_id": "e4cb51a4-a4d2-3c1b-a569-200e010617a2",
                        "glosses": [
                            "книжн. видоизменяться, разнообразиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f02e23-25b6-4047-8a15-8e71e50f882f",
                                "sense_id": "d4bf9f02-e91e-348b-ab60-6a0b40af789d",
                                "text": "Пропорции, в которой эти части присутствуют в той или иной теории, могут существенно варьироваться, равно как может варьироваться и степень взаимопроникновения этих двух компонентов теоретического анализа."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad69842d-7d2f-343c-a5c4-5545879f27d7",
                        "entry_id": "e4cb51a4-a4d2-3c1b-a569-200e010617a2",
                        "glosses": [
                            "страд. к варьировать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbec49c8-934f-41fe-8d66-cd459d6aad85",
                        "source_entry_id": "e4cb51a4-a4d2-3c1b-a569-200e010617a2",
                        "target_lang_word": "vary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc4dbae-4939-387c-9788-ca361873f01c",
                                        "entry_id": "37024b3b-ad5e-3fc0-bb7e-cef9c75e73b8",
                                        "glosses": [
                                            "To change with time or a similar parameter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5855032d-469d-46e1-80e5-6c4240cf1820",
                                                "sense_id": "cbc4dbae-4939-387c-9788-ca361873f01c",
                                                "text": "He varies his magic tricks so as to minimize the possibility that any given audience member will see the same trick twice."
                                            },
                                            {
                                                "example_id": "edea8899-7076-442f-ba62-6e23772b0dba",
                                                "sense_id": "cbc4dbae-4939-387c-9788-ca361873f01c",
                                                "text": "We are to vary the customs according to the time and country where the scene of action lies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7800f10b-891a-393d-9318-78545cd6e5ab",
                                        "entry_id": "37024b3b-ad5e-3fc0-bb7e-cef9c75e73b8",
                                        "glosses": [
                                            "To institute a change in, from a current state; to modify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86635a85-1900-4808-8be4-1454d586f84a",
                                                "sense_id": "7800f10b-891a-393d-9318-78545cd6e5ab",
                                                "text": "You should vary your diet. Eating just bread will do you harm in the end."
                                            },
                                            {
                                                "example_id": "cf1a7560-3458-45a5-9218-b130b034116e",
                                                "sense_id": "7800f10b-891a-393d-9318-78545cd6e5ab",
                                                "text": "a. 1687, Edmund Waller, to Phyllis\nGods, that never change their state, / Vary oft their love and hate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae99624-045f-3ab2-ac17-b182b75775c4",
                                        "entry_id": "37024b3b-ad5e-3fc0-bb7e-cef9c75e73b8",
                                        "glosses": [
                                            "Not to remain constant: to change with time or a similar parameter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c355d57-616f-47a9-97ab-e771fd55b3ac",
                                                "sense_id": "2ae99624-045f-3ab2-ac17-b182b75775c4",
                                                "text": "His mood varies by the hour."
                                            },
                                            {
                                                "example_id": "69a5998a-7a0e-47f3-9de8-adc22542fa78",
                                                "sense_id": "2ae99624-045f-3ab2-ac17-b182b75775c4",
                                                "text": "The sine function varies between −1 and 1."
                                            },
                                            {
                                                "example_id": "e8a4bf5a-c34d-4093-8821-7095e8cb70b1",
                                                "sense_id": "2ae99624-045f-3ab2-ac17-b182b75775c4",
                                                "text": "While fear and anger, with alternate grace, / Pant in her breast, and vary in her face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fc1202-9e37-3d4a-8934-3b663283ea0d",
                                        "entry_id": "37024b3b-ad5e-3fc0-bb7e-cef9c75e73b8",
                                        "glosses": [
                                            "To display differences."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "354ba698-6b0a-4324-baa6-bde622cff048",
                                                "sense_id": "11fc1202-9e37-3d4a-8934-3b663283ea0d",
                                                "text": "The sprouting tendency of potatoes varies between cultivars, years and places of growing."
                                            },
                                            {
                                                "example_id": "bb7d92c2-daaa-472f-9567-30a243e0034a",
                                                "sense_id": "11fc1202-9e37-3d4a-8934-3b663283ea0d",
                                                "text": "In the new layout, it is proposed to provide three island platforms with six platform faces varying from 1,075 to 1,290 ft. in length and including bays."
                                            }
