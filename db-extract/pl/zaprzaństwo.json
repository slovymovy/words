                "senses": [
                    {
                        "sense_id": "38b787e8-82ae-39a9-a7b1-77862851db12",
                        "entry_id": "9dbfae87-1950-3fcc-9614-ad99b841b440",
                        "glosses": [
                            "wyparcie się swojej ojczyzny, religii, rodziny itp."
                        ],
                        "tags": [
                            "obsolete",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b9e3ef21-e8ca-4d54-8f90-9f12a9694c2b",
                                "sense_id": "38b787e8-82ae-39a9-a7b1-77862851db12",
                                "text": "Zbawiciel wtedy radził mu czuwać i modlić się, by nie uległ pokusie. Lecz Piotr czuł się od niej bezpieczny i właśnie dlatego popełnił tak okropny i obrzydliwy grzech zaprzaństwa"
                            },
                            {
                                "example_id": "f601eda7-22c3-4318-8b12-fe63309dc2a8",
                                "sense_id": "38b787e8-82ae-39a9-a7b1-77862851db12",
                                "text": "(…) autorzy deklarują swą przynależność do obozu, postrzegającego ostatnie dwudziestolecie nie jako ciąg zdrad, spisków, zaprzaństw, katastrof i afer, lecz jako gigantyczny sukces Polaków, którego wciąż nie potrafimy docenić"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
