                "senses": [
                    {
                        "sense_id": "d645a364-ec8b-343d-ae6d-4095c1a225fb",
                        "entry_id": "c596f6f2-2644-333c-8298-03eb3a7cf8be",
                        "glosses": [
                            "fester, dicker und kompakter werden, wie Hornhaut oder eine Schwiele"
                        ],
                        "tags": [
                            "über Haut"
                        ],
                        "examples": [
                            {
                                "example_id": "7e56d227-7af2-4f21-84a4-b7f3d8eb2251",
                                "sense_id": "d645a364-ec8b-343d-ae6d-4095c1a225fb",
                                "text": "„Die Herzmuskulatur war im Anschluß an den Penetrationskanal derb verschwielt.“"
                            },
                            {
                                "example_id": "f4e2bcc1-d19c-482c-90cd-e1c7d7757261",
                                "sense_id": "d645a364-ec8b-343d-ae6d-4095c1a225fb",
                                "text": "„Oft schalten wir die selbstsüchtigen Gecken, welche, um sich nur reden zu hören, stundenlang darüber selbädern können, woher jeder Sturm brause und wohin er wüthe; aber nie ihre Hände dadurch verschwielen mögen, daß sie Stöcke zu Blumen fügen und Stüzen an schwache Bäume binden.“ (1799)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
