                "senses": [
                    {
                        "sense_id": "c315ea42-3d4f-3e44-b57e-543767235906",
                        "entry_id": "3f6f3a3e-beea-32d0-8eb6-ea810ed46e34",
                        "glosses": [
                            "Extrêmement connu. Souvent avec nuance péjorative : trop connu, ressassé."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f7ecf155-f9c3-4c43-9e8b-e933e3334af3",
                                "sense_id": "c315ea42-3d4f-3e44-b57e-543767235906",
                                "text": "Pauvre Beethoven ! Il y a de quoi te rendre sourd une seconde fois. Ces œuvres, archiconnues, archicélèbres, devraient être traitées avec plus de respect."
                            },
                            {
                                "example_id": "ddfb0f7f-07b5-4245-b111-20981e9e63e0",
                                "sense_id": "c315ea42-3d4f-3e44-b57e-543767235906",
                                "text": "Je scrutais tous les coins et recoins : Rien. Rien que des choses connues et archiconnues : des meubles, des coffres, la lampe, le tableau, l’horloge sur le mur… mes vieux amis fidèles et inanimés."
                            }
                        ]
                    }
