                "senses": [
                    {
                        "sense_id": "585a3dd9-a8f9-3ade-a3b7-1e3adeb52cec",
                        "entry_id": "4fa88060-d90c-3bf3-b369-2631780dd598",
                        "glosses": [
                            "Leiter des Ministeriums für wirtschaftliche Zusammenarbeit und Entwicklung, dessen Ziel – in Zusammenarbeit mit anderen Industriestaaten – die Unterstützung von Entwicklungs- und Schwellenländern ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a07c2c9a-8401-4dc3-9dd7-cab30b17519b",
                                "sense_id": "585a3dd9-a8f9-3ade-a3b7-1e3adeb52cec",
                                "text": "„Der bisherige Parlamentarische Staatssekretär im Agrarministerium, Gerd Müller (CSU) soll Entwicklungsminister in der schwarz-roten Koalition werden.“"
                            },
                            {
                                "example_id": "8eee8193-098f-4705-9c90-15ed55261837",
                                "sense_id": "585a3dd9-a8f9-3ade-a3b7-1e3adeb52cec",
                                "text": "„Die früheren Entwicklungsminister Bahr, Eppler und Wieczorek-Zeul werden nicht zur 50-Jahr-Feier ihres alten Ministeriums kommen. Grund ist die Arbeit ihres Nachfolgers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
