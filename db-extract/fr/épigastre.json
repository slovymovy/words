                                        "entry_id": "c7d35de5-8460-31d0-a908-83f696378ca3",
                                        "glosses": [
                                            "The upper middle region of the abdomen, between the umbilical and hypochondriac regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a690a2-0325-43da-a226-8c07ea799567",
                                                "sense_id": "5e9f66ad-8a25-3d84-b1fc-dc580dc5fa0b",
                                                "text": "In cases of extreme thickening of the coats of the stomach, of a scirrhoid character, where the suffering patients are almost worn out with constant pain, such remedies, applied over the epigastrium, most materially alleviate the distress."
                                            }
                                        ]
                                    }
                                ]
