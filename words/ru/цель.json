                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "глагольная форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'to aim'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aim",
                                "target_lang_sense_clarification": "To point a weapon or direct one's focus toward a specific point."
