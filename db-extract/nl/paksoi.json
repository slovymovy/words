                        "glosses": [
                            "Brassica rapa var. chinensis een langbladige open Chinese kool met groene bladeren en spierwitte bladstelen van Aziatische origine. De groente is het gehele jaar verkrijgbaar en vaak afkomstig van Nederlandse glasteelt, maar ze komt ook uit Aziatische landen, Israël en Zuid-Europa. Paksoi behoort tot de kruisbloemenfamilie en is daarmee dus een koolsoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60812a1-bbc6-4f96-ba24-897b41495a85",
                                "sense_id": "46b8c860-e3f6-3d38-90b0-0861f7c10389",
                                "text": "In de glastuinbouw teelt men ook in Nederland paksoi."
                            }
                        ]
                    }
