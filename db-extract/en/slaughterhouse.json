                                    {
                                        "sense_id": "6c31f3e2-e4f0-34e6-98f4-335a15360b33",
                                        "entry_id": "3f4431f7-8dea-3f83-9760-e077022ec378",
                                        "glosses": [
                                            "перен. жестокая кровопролитная бойня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0579512-6f4e-4fce-86d2-bb289674065b",
                                                "sense_id": "6c31f3e2-e4f0-34e6-98f4-335a15360b33",
                                                "text": "Немногие вышли живыми из этой мясорубки."
                                            }
                                        ]
