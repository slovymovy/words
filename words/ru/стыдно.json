                {
                    "sense_id": "721c8eba-2f10-3cdf-abab-72daa7548ad6",
                    "sense_definition": "О чувстве стыда, неловкости или вины, испытываемом кем-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне стало <w>стыдно</w> за свои грубые слова.",
                            "target_lang_translations": {
                                "en": "I felt <w>ashamed</w> of my rude words.",
                                "tr": "Kaba sözlerimden dolayı <w>utandım</w>.",
                                "es": "Me sentí <w>avergonzado</w> por mis palabras groseras.",
                                "fr": "J'ai eu <w>honte</w> de mes paroles blessantes.",
                                "nl": "Ik <w>schaamde</w> me voor mijn grove woorden.",
                                "pl": "Poczułem <w>wstyd</w> z powodu moich grubiańskich słów.",
                                "de": "Ich habe mich für meine groben Worte <w>geschämt</w>.",
                                "it": "Mi sono <w>vergognato</w> delle mie parole sgarbate.",
                                "cs": "Bylo mi <w>trapně</w> za má hrubá slova.",
                                "zh": "因为我说的那些粗鲁的话，我感到很<w>羞愧</w>。"
                            }
                        },
                        {
                            "text": "Ему было <w>стыдно</w> смотреть ей в глаза.",
                            "target_lang_translations": {
                                "en": "He was <w>ashamed</w> to look her in the eyes.",
                                "tr": "Onun gözlerinin içine bakmaya <w>utanıyordu</w>.",
                                "es": "Le daba <w>vergüenza</w> mirarla a los ojos.",
                                "fr": "Il avait <w>honte</w> de la regarder dans les yeux.",
                                "nl": "Hij <w>schaamde</w> zich om haar in de ogen te kijken.",
                                "pl": "Było mu <w>wstyd</w> spojrzeć jej w oczy.",
                                "de": "Er hat sich <w>geschämt</w>, ihr in die Augen zu schauen.",
                                "it": "Si <w>vergognava</w> di guardarla negli occhi.",
                                "cs": "<w>Styděl se</w> podívat se jí do očí.",
                                "zh": "他感到很<w>不好意思</w>直视她的眼睛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "неловко",
                        "неудобно",
                        "совестно",
                        "позорно"
                    ],
                    "common_phrases": [
                        "мне стыдно",
                        "как не стыдно",
                        "стало стыдно",
                        "стыдно сказать"
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding a feeling of shame, awkwardness, or guilt experienced by someone.",
                        "tr": "Birinin hissettiği utanç, mahcubiyet veya suçluluk duygusu hakkında.",
                        "es": "Sobre el sentimiento de vergüenza, incomodidad o culpa experimentado por alguien.",
                        "fr": "Concerne un sentiment de honte, de gêne ou de culpabilité éprouvé par quelqu'un.",
                        "nl": "Betrekking hebbend op een gevoel van schaamte, ongemak of schuld dat door iemand wordt ervaren.",
                        "pl": "Dotyczy uczucia wstydu, zażenowania lub winy odczuwanego przez kogoś.",
                        "de": "Bezieht sich auf ein Gefühl von Scham, Verlegenheit oder Schuld, das jemand empfindet.",
                        "it": "Si riferisce a un sentimento di vergogna, imbarazzo o colpa provato da qualcuno.",
                        "cs": "Vyjadřuje pocit studu, rozpaků nebo viny, který někdo prožívá.",
                        "zh": "指某人因做错事或感到尴尬而产生的羞愧、内疚或不安的情绪。"
                    },
