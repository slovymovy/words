                ],
                "senses": [
                    {
                        "sense_id": "10d3b07c-df71-33b2-85dd-8d7c98cc1be5",
                        "entry_id": "e772d0d9-23bf-340a-a617-4e080705a176",
                        "glosses": [
                            "das partielle Herausziehen von Alkohol aus alkoholischen Getränken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1cc6196-8923-4ca9-86cb-69cba999745c",
                                "sense_id": "10d3b07c-df71-33b2-85dd-8d7c98cc1be5",
                                "text": "„Mostkonzentration, gentechnisch veränderte Hefen, Entalkoholisierung, künstliche Holzung – viele Weintrinker ahnen nicht, was sie schon heute trinken.“"
                            },
                            {
                                "example_id": "4616a33c-bce8-4cea-b717-93b127a7f413",
                                "sense_id": "10d3b07c-df71-33b2-85dd-8d7c98cc1be5",
                                "text": "„Bei der Entalkoholisierung von Wein spielt die selektive Extraktion des Alkohols bei vollem Erhalt der Aromen die entscheidende Rolle.“"
                            },
                            {
                                "example_id": "70a3bd29-6419-4f23-a75c-55d4fd33f587",
                                "sense_id": "10d3b07c-df71-33b2-85dd-8d7c98cc1be5",
                                "text": "„So wurde die Konzentrierung durch Kälte, die Entschwefelung durch physikalische Verfahren, die Entalkoholisierung und die Behandlung mit Elektrodialyse oder mit Kationentauschern zur Weinstabilisierung verboten.“"
                            },
                            {
                                "example_id": "af24d746-9f35-4a5e-b71f-7e4787a872ba",
                                "sense_id": "10d3b07c-df71-33b2-85dd-8d7c98cc1be5",
                                "text": "„Teilweise Entalkoholisierung, Konzentration und Verwendung von Eichenholzstücken ist bei Prädikatswein nicht erlaubt.“"
                            },
                            {
                                "example_id": "32d2bc57-451b-4c82-90e0-a5cd4fb3c83d",
                                "sense_id": "10d3b07c-df71-33b2-85dd-8d7c98cc1be5",
                                "text": "Die Entalkoholisierung von Wein wird in Frankreich wesentlicher häufiger betrieben als in Deutschland."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
