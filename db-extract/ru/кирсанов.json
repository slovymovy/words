                "senses": [
                    {
                        "sense_id": "def007c0-c7b8-3f83-b7e8-80d7cb0e37c5",
                        "entry_id": "abd8ac04-4095-3795-847d-332c0edb8acc",
                        "glosses": [
                            "город в России (Тамбовская область)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "660e3a9a-7a2a-4758-b56b-2dd02bd11911",
                                "sense_id": "def007c0-c7b8-3f83-b7e8-80d7cb0e37c5",
                                "text": "Проехали через города Мичуринск, Тамбов, Кирсанов, Ртищево и везде видели ту же полынь и сурепку."
                            },
                            {
                                "example_id": "7583c5e5-6536-484e-a803-8de2f27d39a8",
                                "sense_id": "def007c0-c7b8-3f83-b7e8-80d7cb0e37c5",
                                "text": "По профессии Иван Васильевич был кожевенником, начинал когда-то у хозяина в городе Кирсанове, но уже с 1926 года, когда его выдвинули на директора фабрики ― маленькой, реквизированной у нэпмана фабричонки на Марьиной роще, ― он двинулся по линии административной."
                            }
                        ]
                    }
                ],
