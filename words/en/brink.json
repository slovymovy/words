{
    "word_family": [
        "brinkmanship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecfb50e2-e1d4-3b67-938b-72ab38a2164b",
                    "sense_definition": "The point at which something, especially something very good or very bad, is about to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two nations were on the <w>brink</w> of war after the border incident.",
                            "target_lang_translations": {
                                "ru": "После пограничного инцидента две страны оказались на <w>грани</w> войны."
                            }
                        },
                        {
                            "text": "After years of hard work, the scientist was on the <w>brink</w> of success with her new invention.",
                            "target_lang_translations": {
                                "ru": "После многих лет упорной работы ученая была на <w>пороге</w> успеха со своим новым изобретением."
                            }
                        }
                    ],
                    "synonyms": [
                        "verge",
                        "threshold",
                        "edge"
                    ],
                    "common_phrases": [
                        "on the brink of",
                        "back from the brink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Момент, когда что-то (особенно очень хорошее или очень плохое) вот-вот произойдет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грань",
                                "target_lang_sense_clarification": "предел или граница состояния"
                            },
                            {
                                "target_lang_word": "порог",
                                "target_lang_sense_clarification": "начало нового этапа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25fe7aa4-a69d-34d0-bf9c-34d3111ab0aa",
                    "sense_definition": "The physical edge or margin of a steep place, such as a cliff or the bank of a river.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers stood at the <w>brink</w> of the precipice, looking down at the valley below.",
                            "target_lang_translations": {
                                "ru": "Туристы стояли у самого <w>края</w> пропасти, глядя вниз на долину."
                            }
                        },
                        {
                            "text": "The small cottage was built right on the <w>brink</w> of the river.",
                            "target_lang_translations": {
                                "ru": "Маленький коттедж был построен прямо на <w>берегу</w> реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "edge",
                        "rim",
                        "verge",
                        "margin"
                    ],
                    "antonyms": [
                        "center",
                        "middle"
                    ],
                    "common_phrases": [
                        "brink of a river",
                        "brink of a cliff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический край или обрыв крутого места, например, скалы или берега реки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "внешняя граница обрыва или берега"
                            },
                            {
                                "target_lang_word": "обрыв",
                                "target_lang_sense_clarification": "крутой склон"
                            },
                            {
                                "target_lang_word": "кромка",
                                "target_lang_sense_clarification": "узкий край чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7dfef938-51b0-33b6-b2c0-eac53bba4c7b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Mr. <w>Brink</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа мистера <w>Бринка</w>."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Brink</w> family to discuss the property sale.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с семьей <w>Бринк</w>, чтобы обсудить продажу недвижимости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English and Dutch origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бринк",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}