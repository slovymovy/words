{
    "word_family": [
        "oaken",
        "oaky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4abb9afc-0120-36f0-85c8-35e528da378d",
                    "sense_definition": "A deciduous tree with distinctive deeply lobed leaves, acorns, and notably strong wood.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>oak</w> in the park provides shade for everyone during the summer.",
                            "target_lang_translations": {
                                "ru": "Старый <w>дуб</w> в парке дает тень всем желающим летом.",
                                "zh": "公园里那棵老<w>橡树</w>在夏天为每个人提供阴凉。"
                            }
                        },
                        {
                            "text": "Squirrels were busy burying acorns beneath the large <w>oak</w> tree.",
                            "target_lang_translations": {
                                "ru": "Белки были заняты тем, что закапывали желуди под большим <w>дубом</w>.",
                                "zh": "松鼠们正忙着在那棵大<w>橡树</w>下埋藏橡子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mighty oak",
                        "oak tree",
                        "ancient oak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лиственное дерево с характерными глубоко лопастными листьями, желудями и особо прочной древесиной.",
                        "zh": "一种落叶乔木，具有深裂的叶子、橡子和非常坚硬的木材。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуб",
                                "target_lang_sense_clarification": "дерево"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡树",
                                "target_lang_sense_clarification": "树木"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0882a096-4091-3498-815f-62f9c147e857",
                    "sense_definition": "The hard, durable timber obtained from an oak tree, used for furniture and building.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dining table is made of solid <w>oak</w> and is very heavy.",
                            "target_lang_translations": {
                                "ru": "Обеденный стол сделан из цельного <w>дуба</w> и очень тяжелый.",
                                "zh": "这张餐桌是用实心<w>橡木</w>做的，非常沉。"
                            }
                        },
                        {
                            "text": "We chose a light <w>oak</w> for the flooring in the living room.",
                            "target_lang_translations": {
                                "ru": "Мы выбрали светлый <w>дуб</w> для напольного покрытия в гостиной.",
                                "zh": "我们为客厅的地板选择了浅色<w>橡木</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "solid oak",
                        "oak floor",
                        "oak furniture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердая, прочная древесина, получаемая из дуба, используемая для мебели и строительства.",
                        "zh": "从橡树上获得的坚硬耐用的木材，常用于家具和建筑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуб",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "древесина дуба",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡木",
                                "target_lang_sense_clarification": "材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15371b46-c9cd-3333-95c9-7b9bcfbb5296",
                    "sense_definition": "A rich brown color, similar to that of oak wood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a shade of <w>oak</w> to paint the background of the portrait.",
                            "target_lang_translations": {
                                "ru": "Художник использовал оттенок <w>дуба</w>, чтобы написать фон портрета.",
                                "zh": "艺术家用一种<w>橡木色</w>来绘制肖像画的背景。"
                            }
                        },
                        {
                            "text": "She decided to dye the fabric a deep <w>oak</w> to match the room's decor.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить ткань в глубокий <w>цвет дуба</w>, чтобы он сочетался с декором комнаты.",
                                "zh": "她决定把布料染成深<w>橡木色</w>，以搭配房间的装饰。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dark oak",
                        "light oak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насыщенный коричневый цвет, похожий на цвет древесины дуба.",
                        "zh": "一种浓郁的棕色，类似于橡木的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет дуба",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "дубовый оттенок",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡木色",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bbf11f5-a5d1-38ec-8b18-d95ace005331",
                    "sense_definition": "The distinct flavor imparted to wine or spirits by storage in oak barrels.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This Chardonnay has a strong hint of <w>oak</w> that some people find overpowering.",
                            "target_lang_translations": {
                                "ru": "У этого Шардоне сильный <w>привкус дуба</w>, который некоторые находят чрезмерным.",
                                "zh": "这款霞多丽葡萄酒有很浓的<w>橡木味</w>，有些人觉得太重了。"
                            }
                        },
                        {
                            "text": "The whiskey is known for its subtle <w>oak</w> and vanilla notes.",
                            "target_lang_translations": {
                                "ru": "Этот виски известен своими тонкими нотками <w>дуба</w> и ванили.",
                                "zh": "这款威士忌以其微妙的<w>橡木味</w>和香草气息而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hint of oak",
                        "toasted oak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный привкус, придаваемый вину или спиртным напиткам при выдержке в дубовых бочках.",
                        "zh": "葡萄酒或烈酒因在橡木桶中陈酿而产生的独特风味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привкус дуба",
                                "target_lang_sense_clarification": "вкус"
                            },
                            {
                                "target_lang_word": "дубовые нотки",
                                "target_lang_sense_clarification": "вкус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡木味",
                                "target_lang_sense_clarification": "风味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb8364cb-58cc-3818-8621-1fd56dd1be33",
                    "sense_definition": "The outer lockable door of a set of rooms in a college or university.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_door",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student decided to sport his <w>oak</w> so he could study without interruption.",
                            "target_lang_translations": {
                                "ru": "Студент решил запереть свою <w>дубовую дверь</w>, чтобы заниматься без помех.",
                                "zh": "学生决定关上<w>学院外门</w>，这样他就能不受打扰地学习。"
                            }
                        },
                        {
                            "text": "He closed his <w>oak</w> to signal to his friends that he was not available.",
                            "target_lang_translations": {
                                "ru": "Он закрыл свою <w>дубовую дверь</w>, чтобы дать понять друзьям, что он занят.",
                                "zh": "他关上了<w>学院外门</w>，向朋友们示意他现在没空。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sporting door"
                    ],
                    "common_phrases": [
                        "sport one's oak"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "university context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наружная запираемая дверь в наборе комнат в колледже или университете.",
                        "zh": "大学宿舍或学院房间的坚固外门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубовая дверь",
                                "target_lang_sense_clarification": "университетский сленг"
                            },
                            {
                                "target_lang_word": "наружная дверь",
                                "target_lang_sense_clarification": "университетский сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学院外门",
                                "target_lang_sense_clarification": "大学俚语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28750e4b-f729-3a48-80a0-cd0b3cda4e14",
                    "sense_definition": "Made of oak wood or timber.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They installed a beautiful <w>oak</w> door at the front of the house.",
                            "target_lang_translations": {
                                "ru": "Они установили красивую <w>дубовую</w> дверь на входе в дом.",
                                "zh": "他们在房子前面安装了一扇漂亮的<w>橡木</w>门。"
                            }
                        },
                        {
                            "text": "The library was filled with heavy <w>oak</w> shelves holding thousands of books.",
                            "target_lang_translations": {
                                "ru": "Библиотека была заполнена тяжелыми <w>дубовыми</w> полками с тысячами книг.",
                                "zh": "图书馆里摆满了沉重的<w>橡木</w>书架，上面放着成千上万本书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "oaken"
                    ],
                    "common_phrases": [
                        "oak table",
                        "oak beam",
                        "oak paneling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из древесины дуба.",
                        "zh": "由橡木制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубовый",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡木制的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dddc80f8-4885-3fe0-9985-1665f2b0d1eb",
                    "sense_definition": "Having a rich brown color, like that of oak wood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted in warm <w>oak</w> tones to make the room feel cozy.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в теплые <w>дубовые</w> тона, чтобы сделать комнату уютной.",
                                "zh": "墙壁被漆成温暖的<w>橡木色</w>，让房间感觉很温馨。"
                            }
                        },
                        {
                            "text": "He wore an <w>oak</w> jacket that matched his boots perfectly.",
                            "target_lang_translations": {
                                "ru": "На нем была куртка <w>дубового цвета</w>, которая идеально подходила к его ботинкам.",
                                "zh": "他穿了一件<w>橡木色</w>的夹克，和他的靴子非常搭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oak brown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий насыщенный коричневый цвет, как у древесины дуба.",
                        "zh": "具有像橡木一样的浓郁棕色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубовый",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "цвета дуба",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡木色的",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc6e5956-b429-342e-a053-69438f275702",
                    "sense_definition": "To expose wine or spirits to oak wood to impart a specific flavor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winemaker chose to <w>oak</w> the red wine for twelve months.",
                            "target_lang_translations": {
                                "ru": "Винодел решил <w>выдержать в дубе</w> красное вино в течение двенадцати месяцев.",
                                "zh": "酿酒师决定将红酒进行十二个月的<w>橡木桶陈酿</w>。"
                            }
                        },
                        {
                            "text": "If you <w>oak</w> the spirit for too long, the wood flavor becomes too strong.",
                            "target_lang_translations": {
                                "ru": "Если <w>выдерживать в дубе</w> спирт слишком долго, вкус древесины станет слишком сильным.",
                                "zh": "如果你对烈酒进行<w>橡木桶陈酿</w>的时间太长，木头的味道会变得太浓。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oak the wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдерживать вино или спиртные напитки в дубовых бочках для придания специфического вкуса.",
                        "zh": "将葡萄酒或烈酒放入橡木桶中陈酿以赋予其特定风味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдерживать в дубе",
                                "target_lang_sense_clarification": "виноделие"
                            },
                            {
                                "target_lang_word": "настаивать на дубе",
                                "target_lang_sense_clarification": "виноделие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡木桶陈酿",
                                "target_lang_sense_clarification": "酿酒工艺"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}