                    {
                        "sense_id": "6a6a1b68-5f0b-38a2-b7a9-0e5f187391c7",
                        "entry_id": "72ce90fe-ab7b-3e9c-81f4-2db4e34ecbc8",
                        "glosses": [
                            "auf welcher Sache"
                        ],
                        "tags": [
                            "interrogativ"
                        ],
                        "examples": [
                            {
                                "example_id": "8a5d9990-e1af-4edd-b0ab-70f1dd9c7b63",
                                "sense_id": "6a6a1b68-5f0b-38a2-b7a9-0e5f187391c7",
                                "text": "Worauf hast du gestanden? Auf einer Brücke?"
                            },
                            {
                                "example_id": "288c8771-312c-496b-8d98-2b33534f5709",
                                "sense_id": "6a6a1b68-5f0b-38a2-b7a9-0e5f187391c7",
                                "text": "Worauf stützen sich deine Behauptungen?"
                            },
                            {
                                "example_id": "cd80fb77-852f-4f20-9cc7-f2863d9b7684",
                                "sense_id": "6a6a1b68-5f0b-38a2-b7a9-0e5f187391c7",
                                "text": "„Hohe Rendite steht für hohes Risiko, darüber sollten sich Kapitalanleger bewusst sein. Statt auf die Höhe der Rendite zu schielen, sollte man daher besser prüfen, worauf die Berechnungen basieren und ob die Annahmen auch langfristig gelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9b967c3a-a74f-3386-98a0-853a62a6c75a",
                        "entry_id": "72ce90fe-ab7b-3e9c-81f4-2db4e34ecbc8",
                        "glosses": [
                            "auf welcher genannten Sache"
                        ],
                        "tags": [
                            "relativ"
                        ],
                        "examples": [
                            {
                                "example_id": "e82785b2-9945-42b8-b772-5fcc98356832",
                                "sense_id": "9b967c3a-a74f-3386-98a0-853a62a6c75a",
                                "text": "Der Ast, worauf er saß, brach ab."
                            },
                            {
                                "example_id": "f1cc88eb-8bc8-497a-acfc-80842cd29822",
                                "sense_id": "9b967c3a-a74f-3386-98a0-853a62a6c75a",
                                "text": "Die Quelle, worauf er seine Anschuldigung stützte, erwies sich als frei erfunden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
