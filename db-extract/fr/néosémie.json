                    {
                        "sense_id": "f0001f10-cda5-3b81-b35b-6cc444cc445c",
                        "entry_id": "5a013d2d-12b2-35f6-a72f-7a2f306ccabe",
                        "glosses": [
                            "Création de nouveaux sens pour des lexies existantes qui a pour effet d’augmenter leur polysémie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832fa9d8-c089-4f26-9548-e0e178ff7180",
                                "sense_id": "f0001f10-cda5-3b81-b35b-6cc444cc445c",
                                "text": "La néosémie est une innovation sémantique dont témoignent les emplois"
                            },
                            {
                                "example_id": "989fcaf3-802b-4322-a8b3-ab7dc0528412",
                                "sense_id": "f0001f10-cda5-3b81-b35b-6cc444cc445c",
                                "text": "Un emprunt toxique, dans un nouveau sens pour « toxique », est une néosémie."
                            },
                            {
                                "example_id": "18997153-0fe8-4a1c-b24e-24a11a8e2c3d",
                                "sense_id": "f0001f10-cda5-3b81-b35b-6cc444cc445c",
                                "text": "Les mot « tablette » et « tactile » sont polysémiques. L’emploi de ces deux mots, « tablette » et « tactile », dans l’expression « tablette tactile » ou, par ellipse, « tablette » pour traduire « tablet computer » et désigner une catégorie nouvelle de produits est une double néosémie."
                            },
                            {
                                "example_id": "ddb88540-0852-447e-ae48-ad40fcf05c46",
                                "sense_id": "f0001f10-cda5-3b81-b35b-6cc444cc445c",
                                "text": "Lexies ayant donné lieu à des néosémies : adouber, ardoise, caviar, innovateur, innovation, innover, tablette, tactile, toxique, tsunami…"
                            },
                            {
                                "example_id": "78eacca6-5828-4ac9-be67-911769ce35a2",
                                "sense_id": "f0001f10-cda5-3b81-b35b-6cc444cc445c",
                                "text": "« Les dinosaures du parti », un exemple de néosémie."
                            }
                        ]
                    }
