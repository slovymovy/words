                                    {
                                        "sense_id": "e1c5767e-c7c9-3f65-b56b-9274886d52fe",
                                        "entry_id": "68cfc3d8-b7cc-3d4f-8215-6866221cd8f8",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52fe63c4-392b-494d-ad84-333dc9373c24",
                                                "sense_id": "e1c5767e-c7c9-3f65-b56b-9274886d52fe",
                                                "text": "Airy, fairy Lilian, / Flitting, fairy Lilian, / When I ask her if she loves me, / Claps her tiny hands above me, / Laughing all she can."
                                            },
                                            {
                                                "example_id": "f8f23e04-4c11-4086-969e-303ad4fbc670",
                                                "sense_id": "e1c5767e-c7c9-3f65-b56b-9274886d52fe",
                                                "text": "When it was my turn Roger told the crowd that my romanised second and third name, if written as one word in Pinyin, as is now the custom, was exactly like the English girl's name Lilian and he therefore proposed to leave it like that, Lilian being a very pretty name, he said."
                                            },
                                            {
                                                "example_id": "5d8783c8-a2bb-4b76-92b1-ef2109fc12e5",
                                                "sense_id": "e1c5767e-c7c9-3f65-b56b-9274886d52fe",
                                                "text": "These behaviors and mindsets contrast with mindful eating, which means using all your physical and emotional senses to experience and enjoy the food choices you make without judgment, said Lilian Cheung, a lecturer and director of health promotion and communication in the nutrition department at Harvard T.H. Chan School of Public Health, via email."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c88deede-cc5f-46d5-b2ae-80ca8ac3015a",
                        "source_entry_id": "b6ccc1ac-a8ca-38cc-a1a1-795bd4e2da41",
                        "source_sense_id": "493d61b2-bfb3-3336-b58c-f42772a76c62",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Lillian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lillian",
