                    {
                        "translation_id": "3bd176af-16db-49bb-bdc9-90717c30f19d",
                        "source_entry_id": "673d6892-9a08-308e-a303-f69dae85bca6",
                        "source_sense_description": "(transitive) To tease someone in a kindly fashion",
                        "target_lang_word": "разы́грывать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "разы́грывать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ff17ce23-b2f7-383a-abeb-a263ff9ddffa",
                                        "entry_id": "9ba1755d-8c70-32a0-979b-e327bbd31604",
                                        "glosses": [
                                            "театр. устраивать представление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db57494e-b614-4db2-840b-7a5d225e55ae",
                                                "sense_id": "ff17ce23-b2f7-383a-abeb-a263ff9ddffa",
                                                "text": "Некоторые группы предпочитают своим выступлением рассказывать историю — например, изображать себя путешествующими танцовщицами или разыгрывать сценку из жизни деревни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9223e3a6-5e08-30ff-94f2-b75a36be9cc7",
                                        "entry_id": "9ba1755d-8c70-32a0-979b-e327bbd31604",
                                        "glosses": [
                                            "шутить над кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d3f275-32f3-49c1-8b20-12b19a8a4a3c",
                                                "sense_id": "9223e3a6-5e08-30ff-94f2-b75a36be9cc7",
                                                "text": "Традиции шутить и разыгрывать друзей, коллег по работе или сотрудников существуют ещё с давних времен, но в разных странах имеются свои традиции поздравления с 1 апреля."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f7bb259-2398-3b52-8010-8c4a9447bf38",
                                        "entry_id": "9ba1755d-8c70-32a0-979b-e327bbd31604",
                                        "glosses": [
                                            "спорт. развивать игровую комбинацию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f920437-7450-4e3c-a3ce-e8ec68b383a1",
                                                "sense_id": "0f7bb259-2398-3b52-8010-8c4a9447bf38",
                                                "text": "Команды подолгу разыгрывали шайбу в своей зоне, в связи с чем до по-настоящему опасных моментов дело не доходило."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851f5b14-86df-3dd9-b5ba-431541ce19fa",
                                        "entry_id": "9ba1755d-8c70-32a0-979b-e327bbd31604",
                                        "glosses": [
                                            "предоставлять в качестве приза в какой-либо игре или соревновании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504b1743-a4f7-4fb1-853c-7915221f32e7",
                                                "sense_id": "851f5b14-86df-3dd9-b5ba-431541ce19fa",
                                                "text": "Завтра в эту лотерею будут разыгрывать автомобиль."
                                            },
                                            {
                                                "example_id": "bbce4876-4a1f-47b6-a0a9-a7f31883defb",
                                                "sense_id": "851f5b14-86df-3dd9-b5ba-431541ce19fa",
                                                "text": "Команды будут разыгрывать между собой кубок области."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
