{
    "word_family": [
        "stability",
        "stabilization",
        "stabilizer",
        "unstabilized",
        "destabilize"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73926dd2-95ca-339e-b6c4-49d8115163f3",
                    "sense_definition": "To make something steady, firm, or unlikely to change or fail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor worked quickly to <w>stabilize</w> the patient's condition before the ambulance arrived.",
                            "target_lang_translations": {
                                "ru": "Врач быстро работал, чтобы <w>стабилизировать</w> состояние пациента до приезда скорой помощи."
                            }
                        },
                        {
                            "text": "Jody managed to <w>stabilize</w> the table by putting a thick book under the short leg.",
                            "target_lang_translations": {
                                "ru": "Джоди удалось <w>укрепить</w> стол, подложив толстую книгу под короткую ножку."
                            }
                        }
                    ],
                    "synonyms": [
                        "steady",
                        "secure",
                        "fix"
                    ],
                    "antonyms": [
                        "destabilize",
                        "upset",
                        "weaken"
                    ],
                    "common_phrases": [
                        "stabilize the situation",
                        "stabilize the economy",
                        "stabilize the patient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо устойчивым, прочным или менее подверженным изменениям или сбоям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стабилизировать",
                                "target_lang_sense_clarification": "приводить в устойчивое состояние"
                            },
                            {
                                "target_lang_word": "укрепить",
                                "target_lang_sense_clarification": "сделать более прочным"
                            },
                            {
                                "target_lang_word": "зафиксировать",
                                "target_lang_sense_clarification": "сделать неподвижным или неизменным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8f42e99-699f-36ca-bbc3-a9bd1a8d4ae3",
                    "sense_definition": "To become steady, firm, or constant after a period of change or fluctuation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists hope that the stock market will <w>stabilize</w> after the next election ends.",
                            "target_lang_translations": {
                                "ru": "Экономисты надеются, что фондовый рынок <w>стабилизируется</w> после завершения следующих выборов."
                            }
                        },
                        {
                            "text": "After a few days of heavy rain, the water levels in the river began to <w>stabilize</w>.",
                            "target_lang_translations": {
                                "ru": "После нескольких дней сильного дождя уровень воды в реке начал <w>выравниваться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "settle",
                        "balance"
                    ],
                    "antonyms": [
                        "fluctuate",
                        "waver"
                    ],
                    "common_phrases": [
                        "prices begin to stabilize",
                        "stabilize over time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать устойчивым, прочным или постоянным после периода изменений или колебаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стабилизироваться",
                                "target_lang_sense_clarification": "становиться стабильным"
                            },
                            {
                                "target_lang_word": "установиться",
                                "target_lang_sense_clarification": "прийти в норму, перестать меняться"
                            },
                            {
                                "target_lang_word": "выровняться",
                                "target_lang_sense_clarification": "стать ровным или постоянным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}