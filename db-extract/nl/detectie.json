                                "example_id": "421e3ebe-ceb1-4846-a021-a87998db52d4",
                                "sense_id": "164a7277-6dce-3687-93d0-8df2a677f700",
                                "text": "Voor de detectie van resten van explosieven wordt hightech apparatuur gebruikt."
