                "senses": [
                    {
                        "sense_id": "3a31c1fa-cedd-3e57-97d3-21300414e9e8",
                        "entry_id": "7c599062-9eaf-3540-98f3-92b6fad05003",
                        "glosses": [
                            "katholischer Pfarrer in Frankreich"
                        ],
