                ],
                "senses": [
                    {
                        "sense_id": "b31a7536-5566-330a-9428-02abe808dd9f",
                        "entry_id": "409b40fc-cf18-33cf-ad8e-84e0d7edb862",
                        "glosses": [
                            "Porte d'appartement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868344d9-db0d-4ad1-b12f-99d59de1cbab",
                                "sense_id": "b31a7536-5566-330a-9428-02abe808dd9f",
                                "text": "Vergiss bitte nicht, die Wohnungstür zuzuschließen, wenn du weggehst.",
                                "translation": "N’oublie pas de fermer à clé la porte de l’appartement quand tu pars."
                            },
                            {
                                "example_id": "c469d6a1-b3e3-4ff8-84a2-908e8aab0c9b",
                                "sense_id": "b31a7536-5566-330a-9428-02abe808dd9f",
                                "text": "Ich war mehr als erleichtert, als ich die Wohnungstür hinter mir schloss. Zur Sicherheit schob ich den Türriegel vor.",
                                "translation": "J'étais plus que soulagé lorsque j'ai refermé la porte de l’appartement derrière moi. Par mesure de sécurité, j'ai poussé le verrou de la porte."
                            },
                            {
                                "example_id": "01dc30d0-c028-48e9-82f9-59e0932d3ca8",
                                "sense_id": "b31a7536-5566-330a-9428-02abe808dd9f",
                                "text": "Sie stand vor der Wohnungstür ihrer Schwester und klingelte nun schon zum zweiten Mal, lange und verärgert.",
                                "translation": "Elle sonna pour la seconde fois à la porte de l’appartement de sa sœur, longtemps, avec agacement."
                            }
                        ]
                    }
                ],
