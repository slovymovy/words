                            {
                                "target_word": "collective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbcc3c76-6489-31ea-82da-423ba6dfce43",
                                        "entry_id": "664003ac-66de-305b-bdd6-0664ea048220",
                                        "glosses": [
                                            "A farm owned by a collection of people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "016c6c65-29cf-3d84-b8dc-a61d83111c79",
                                        "entry_id": "664003ac-66de-305b-bdd6-0664ea048220",
                                        "glosses": [
                                            "One of more farms managed and owned, through the state, by the community."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28b37000-6ec5-36b5-9710-83db273fb9d6",
                                        "entry_id": "664003ac-66de-305b-bdd6-0664ea048220",
                                        "glosses": [
                                            "A collective noun or name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a75bfde7-80bf-3374-819f-cab1a8f17424",
                                        "entry_id": "664003ac-66de-305b-bdd6-0664ea048220",
                                        "glosses": [
                                            "A group dedicated to a particular cause or interest."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a83bbd3c-d1c1-4ff9-9802-419af54a8e0d",
                                                "sense_id": "a75bfde7-80bf-3374-819f-cab1a8f17424",
                                                "text": "Critical Art Ensemble is one of many art collectives operating on the principle that information is power and that it is most effectively made available through a combination of science and aesthetics."
                                            },
                                            {
                                                "example_id": "4dcbbea9-a975-4c26-997f-b789aafe227a",
                                                "sense_id": "a75bfde7-80bf-3374-819f-cab1a8f17424",
                                                "text": "There are, however, a number of contemporary artists and art collectives that have defined their practice precisely around the facilitation of dialogue among diverse communities."
                                            },
                                            {
                                                "example_id": "bc3577d4-268b-4f57-a2d9-bed2984b9bc6",
                                                "sense_id": "a75bfde7-80bf-3374-819f-cab1a8f17424",
                                                "text": "Today’s collectives create together, tour together, exhibit together, live together, survive together, eat together, sleep together, march together, fight together and party together, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "515a3298-50ec-34a6-8b38-cb92becf97f0",
                                        "entry_id": "664003ac-66de-305b-bdd6-0664ea048220",
                                        "glosses": [
                                            "The flight control used to control a helicopter's ascent or descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3fef912-f622-49e5-bc2e-fccb5bd734bc",
                                                "sense_id": "515a3298-50ec-34a6-8b38-cb92becf97f0",
                                                "text": "A pilot normally holds the collective stationary until the helicopter stops; however, to get more braking action, lower the collective slightly. Keep in mind that, due to the increased ground friction when the collective is lowered or[…]"
                                            },
                                            {
                                                "example_id": "0f45a375-d5a7-4232-a20a-01ebbbc73fed",
                                                "sense_id": "515a3298-50ec-34a6-8b38-cb92becf97f0",
                                                "text": "Hover height, rate of ascent, and the rate of descent are controlled by using the collective. Helicopter position and the direction of travel are controlled by the cyclic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
