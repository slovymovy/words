                        "examples": [
                            {
                                "example_id": "5df84a86-b957-4412-971d-656b34564e77",
                                "sense_id": "b6764bd8-30fb-35a1-92f8-25ac9466c218",
                                "text": "Папаша побрился, поводил у себя по лысине гребнем, оделся поприличнее и отправился «пожалеть единственного сына»."
                            }
                        ]
                    },
                    {
                        "sense_id": "2abb5ed7-d6c3-3b59-91fb-245209538c65",
                        "entry_id": "6855f2e5-293a-34c4-b93c-e0f0d67f1ca5",
