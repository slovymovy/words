                        "sense_id": "1c158b68-85d7-320a-9741-1783782ef096",
                        "entry_id": "c6516ccc-b5e7-304e-948e-de7a1a1bac79",
                        "glosses": [
                            "Verminderung der Abfallmenge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8802d024-1f73-4f2b-aaa2-d17ac08620e8",
                                "sense_id": "1c158b68-85d7-320a-9741-1783782ef096",
                                "text": "„Für die Abfallentsorgung an der TU Dresden gelten die Grundsätze der Abfallvermeidung, der Abfallverminderung, der Abfallverwertung und der sicheren Abfallbeseitigung.“"
                            },
                            {
                                "example_id": "378dec01-1e8c-4ded-bcb6-5283c5a7e8dc",
                                "sense_id": "1c158b68-85d7-320a-9741-1783782ef096",
                                "text": "„Durch unterschiedliche Organisationen wird die Einführung von Mehrwegpfandsystemen für die Abfallverminderung, den Ressourcenschutz und Klimaschutz gefordert – jedoch müssen auch solche Systeme Nachhaltigkeitskriterien in Folge ihrer Ökobilanz unterliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
