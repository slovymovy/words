                                "zh": "我们打算在<w>节日</w>期间去探望祖父母。"
                            }
                        },
                        {
                            "text": "Happy <w>holidays</w> to you and your family!",
                            "target_lang_translations": {
                                "ru": "С <w>праздниками</w> вас и вашу семью!",
                                "zh": "祝你和你的家人<w>节日</w>快乐！"
                            }
                        }
                    ],
                    "synonyms": [
                        "festive season"
                    ],
                    "common_phrases": [
