                    "sense_id": "0c2ba9a3-25a4-3b6f-b07e-2b84fd067caa",
                    "sense_definition": "simple past and past participle of <w>clobber</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm <w>clobbered</w> the coastal town, causing widespread power outages.",
                            "target_lang_translations": {
                                "ru": "Шторм <w>обрушился</w> на прибрежный город, вызвав массовые отключения электроэнергии."
                            }
                        },
                        {
                            "text": "Our team got <w>clobbered</w> in the final minutes of the championship game.",
                            "target_lang_translations": {
                                "ru": "Нашу команду <w>разгромили</w> на последних минутах финальной игры чемпионата."
                            }
