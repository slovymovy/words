                                "example_id": "6ed889aa-772c-4dc5-87d6-559842bc5c20",
                                "sense_id": "65139bd7-6911-3a59-87e6-ef0feb38519c",
                                "text": "One has to look sharp to see the vegetable garden within the border of roses, delphinia, and gladioli."
                            },
                            {
                                "example_id": "53c4a2ee-8b28-4d70-923d-894d65a63834",
                                "sense_id": "65139bd7-6911-3a59-87e6-ef0feb38519c",
                                "text": "I took Paulette’s bouquet from the carton—a loose-stemmed spray of delphinia, coquette roses, white lilacs and Queen Anne’s lace—and placed it in her arms."
                            },
                            {
                                "example_id": "a708dd04-e6a7-4046-bfc4-6e2f56855d00",
                                "sense_id": "65139bd7-6911-3a59-87e6-ef0feb38519c",
                                "text": "Evers shut his eyes and saw zinnias, roses, hollyhocks, snapdragons, gladioli, delphinia, meadow rue and petunias with soft, downturned petals and beads of yellow in their middles."
                            }
                        ]
                    }
