                                "target_senses": [
                                    {
                                        "sense_id": "cf9ab932-20ed-3f9a-b3b5-2151dc457cb4",
                                        "entry_id": "931ca018-cf39-319c-855d-01ac16b52511",
                                        "glosses": [
                                            "To discard; to get rid of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcbbcba0-a102-48c4-be2f-f1013dda563d",
                                                "sense_id": "cf9ab932-20ed-3f9a-b3b5-2151dc457cb4",
                                                "text": "The party plans to scrap the military-drafted constitution, and bring the army's many business interests under the Ministry of Finance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3091bc86-a06c-3ad2-8b8f-1e5cdde78d29",
                                        "entry_id": "931ca018-cf39-319c-855d-01ac16b52511",
                                        "glosses": [
                                            "To stop working on indefinitely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0551842a-ade9-3e3a-82d5-5cbea4016dbf",
                                        "entry_id": "931ca018-cf39-319c-855d-01ac16b52511",
                                        "glosses": [
                                            "To scrapbook; to create scrapbooks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14b1884b-a421-3648-a6d1-f69e002dc3f9",
                                        "entry_id": "931ca018-cf39-319c-855d-01ac16b52511",
                                        "glosses": [
                                            "To dispose of at a scrapyard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa22841a-461e-490a-95f1-c9ba6462ef81",
                                                "sense_id": "14b1884b-a421-3648-a6d1-f69e002dc3f9",
                                                "text": "Northern made much of the scrapping of the first of the Pacers (142005), and to date 35 of its Class 142s have been scrapped, with a further 11 off-lease at Gascoigne Wood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15de6c0f-1dc9-30a9-a996-29e6dae0732d",
                                        "entry_id": "931ca018-cf39-319c-855d-01ac16b52511",
                                        "glosses": [
                                            "To make into scrap."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ade365-de6e-487c-9809-0207bb6cf0dd",
                                                "sense_id": "15de6c0f-1dc9-30a9-a996-29e6dae0732d",
                                                "text": "Standing on the mountain above Caerphilly, one may reflect upon the gap where once stood Llanbradach Viaduct, and look near at hand upon the restored ruins of Caerphilly Castle; man labours to rebuild the mediaeval whilst he ruthlessly scraps the modern."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a52d5ec-2a63-39f1-be1b-c37057c6da8b",
                                        "entry_id": "8c1cc094-d673-3d44-8061-a973e9119eae",
                                        "glosses": [
                                            "A fight, tussle, skirmish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd2acad-73ce-45ed-a1e7-44b355e48a4f",
                                                "sense_id": "4a52d5ec-2a63-39f1-be1b-c37057c6da8b",
                                                "text": "We got in a little scrap over who should pay the bill."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "342dc9af-fea6-3700-adfb-b946a7200702",
                                        "entry_id": "04255c80-b666-326d-a009-86453b54af98",
                                        "glosses": [
                                            "to fight"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8f093f-37a8-4061-bd5f-d2c28fe18047",
                                                "sense_id": "342dc9af-fea6-3700-adfb-b946a7200702",
                                                "text": "Oh yeah! Keep it spicy! You know I love a good tussle, Gonzales! Keep on scrappin', son! 'Course, it ain't gonna do you much good in the end."
                                            }
