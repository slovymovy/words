                "senses": [
                    {
                        "sense_id": "68554904-5981-3bef-8fad-625fe88aa943",
                        "entry_id": "7759404e-31b2-37c1-a9de-bf06f04e50c9",
                        "glosses": [
                            "Kurzwort, das durch Kürzung eines längeren Wortes entstanden ist und bei dem eine oder mehr mittlere Silbe(n) des gekürzten Wortes erhalten blieb(en)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d70b41-b524-4b6a-9ac5-f9a2ae8e43a0",
                                "sense_id": "68554904-5981-3bef-8fad-625fe88aa943",
                                "text": "\"Lisa\" (für \"Elisabeth\"), \"Basti\" (für \"Sebastian\") sind Rumpfwörter im Deutschen. Beispiele für Rumpfwörter findet man bei Eigennamen."
                            },
                            {
                                "example_id": "3574e55a-738c-4a80-bcc3-d9f1414e601e",
                                "sense_id": "68554904-5981-3bef-8fad-625fe88aa943",
                                "text": "„Sie werden hier analog zu HENZENS Terminus »Rumpfformen«(…) als RUMPFWÖRTER bezeichnet.“"
                            },
                            {
                                "example_id": "7d830350-9ff3-4ac5-bec0-a1eab59eb27f",
                                "sense_id": "68554904-5981-3bef-8fad-625fe88aa943",
                                "text": "„Relativ selten sind sogenannte RUMPFWÖRTER wie Lisa (‹— Elisabeth), die meistens bei Namen vorkommen.“"
                            },
                            {
                                "example_id": "d45e0b90-5856-4478-bbd3-1e3e6b763a32",
                                "sense_id": "68554904-5981-3bef-8fad-625fe88aa943",
                                "text": "„Sie sind also nach BELLMANNS Definition »unisegmentale finale Kurzwörter«, nach KOBLER-TRILL »unisegmentale Rumpfwörter«…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
