                        "cross_references": [
                            {
                                "target_word": "coup de couteau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb146028-571e-3baa-84ef-3576ae7be93c",
                                        "entry_id": "7c3a9dfc-c465-370e-815c-2d458c85c2ab",
                                        "glosses": [
                                            "Action de poignarder avec un couteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e895ca-4d47-4a48-844a-fcaf4ecf7c07",
                                                "sense_id": "cb146028-571e-3baa-84ef-3576ae7be93c",
                                                "text": "Enfin, vers 1 heure, dans la nuit de dimanche à lundi, un homme de 21 ans a été victime d’un coup de couteau dans le ventre à Compans-Caffarelli. Il est parvenu à se réfugier chez un ami. Son agresseur a pris la fuite. Une enquête est ouverte."
                                            },
                                            {
                                                "example_id": "8b8d98bd-4496-4129-afd1-aa12443f2864",
                                                "sense_id": "cb146028-571e-3baa-84ef-3576ae7be93c",
                                                "text": "Un homme a été tué par le tir d’un policier au pied du pont de pierre à Bordeaux ce mercredi 10 avril, confirme le parquet de Bordeaux. Il venait de tuer un autre homme d’un coup de couteau."
                                            },
                                            {
                                                "example_id": "bb9bf164-6416-43a6-a2e6-a3c2be81ba80",
                                                "sense_id": "cb146028-571e-3baa-84ef-3576ae7be93c",
                                                "text": "Dans l'Aveyron, en Occitanie, un homme a été tué ce samedi 16 mars de plusieurs coups de couteau devant un supermarché à Onet-le-Château, a appris BFMTV de sources policières, confirmant une information de Centre Presse Aveyron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
