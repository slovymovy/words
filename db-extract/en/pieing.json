                            {
                                "example_id": "168c8586-9f40-4e19-a8c8-14d6171b093b",
                                "sense_id": "46200b70-2995-3ac6-a9e6-f10817fa53f7",
                                "text": "The Canadian prime minister was the victim of a pieing."
                            }
                        ]
                    }
