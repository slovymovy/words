                        "examples": [
                            {
                                "example_id": "a8253200-0c5f-4ff5-8cd8-250fbeda37bf",
                                "sense_id": "0a077aea-be44-30ad-ac99-f2786fbac470",
                                "text": "Inwoners van een plaatsje in Californië pinken op dit moment een traantje weg - dankzij een fabriek in de buurt die chilisaus maakt. Het stadsbestuur wil de chili-fabriek sluiten - omdat mensen letterlijk tranen in de ogen krijgen van de dampen die uit de fabriek komen."
                            },
                            {
                                "example_id": "dc225f17-0692-4d58-b2b6-4295bff0dbdb",
                                "sense_id": "0a077aea-be44-30ad-ac99-f2786fbac470",
                                "text": "Een van de caissières probeerde hem nog tegen te houden, maar hij gaf haar een klap op de borst. Zij pakte daarop een bak met de zeer scherpe chilisaus en gooide het over de man heen. Die ging onmiddellijk naar de grond en kon even later door de gealarmeerde politie worden aangehouden."
                            }
                        ]
                    }
