                "senses": [
                    {
                        "sense_id": "86779d64-ab4d-3089-8745-63eabd18da27",
                        "entry_id": "2d8ce796-b09a-3935-9590-32ecdaa0c185",
                        "glosses": [
                            "A six-point score occurring when the ball enters possession of a team's player in the opponent's end zone."
                        ],
                        "tags": [
                            "Canadian",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "15d9f167-7c6a-4753-aee4-cb2a4c7c93e8",
                                "sense_id": "86779d64-ab4d-3089-8745-63eabd18da27",
                                "text": "Today I scored my first touchdown."
                            },
                            {
                                "example_id": "989446be-e456-4063-bed6-a8179efe0505",
                                "sense_id": "86779d64-ab4d-3089-8745-63eabd18da27",
                                "text": "“I must have caught 45 or 50 touchdowns in that right corner,” he told The Baltimore Sun in 2009. “It was sloped some, a little downhill, which helped me speedwise. I wasn’t all that fast.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "40034090-7809-3d5d-9aaa-0896672fd5b1",
                        "entry_id": "2d8ce796-b09a-3935-9590-32ecdaa0c185",
                        "glosses": [
                            "A defensive action of grounding the ball in the team's own in-goal to stop the play."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "43029e23-b727-3b46-8749-1c73a9abf928",
                        "entry_id": "2d8ce796-b09a-3935-9590-32ecdaa0c185",
                        "glosses": [
                            "A try (scoring play of grounding the ball in the opposing team's in-goal)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc4164bb-3a65-417c-ad03-b7a149d4cdf7",
                                "sense_id": "43029e23-b727-3b46-8749-1c73a9abf928",
                                "text": "A first Test try by Fergus McFadden and a Tomas O'Leary touchdown helped Ireland to a 15-12 half-time lead."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d4e917f-bcfb-3f51-97b6-7bf1627e093e",
                        "entry_id": "2d8ce796-b09a-3935-9590-32ecdaa0c185",
                        "glosses": [
                            "The moment when an aircraft or spacecraft makes first or final contact with the ground during a landing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "17fee861-3b80-4ed5-8e80-f6ccf0b783df",
                                "sense_id": "3d4e917f-bcfb-3f51-97b6-7bf1627e093e",
                                "text": "The passengers audibly relaxed at touchdown."
                            },
                            {
                                "example_id": "c41c93fc-53a0-4332-9ea6-9000963fdd51",
                                "sense_id": "3d4e917f-bcfb-3f51-97b6-7bf1627e093e",
                                "text": "And I think it's gonna be a long, long time / 'Til touchdown brings me 'round again to find / I'm not the man they think I am at home / Oh, no, no, no[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "cc74df15-aa8f-3128-b0ee-3e4359eb15fa",
                        "entry_id": "2d8ce796-b09a-3935-9590-32ecdaa0c185",
                        "glosses": [
                            "The moment of contact of a tornado with the ground."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eced98d8-ea84-4ef2-ad7b-954fe86a7495",
                                "sense_id": "cc74df15-aa8f-3128-b0ee-3e4359eb15fa",
                                "text": "The American Red Cross sent me to Alabama within twenty-four hours of the tornado's touchdown, and I visited the communities of Oak Grove and Rock Creek four subsequent times."
                            }
                        ]
                    }
                ],
