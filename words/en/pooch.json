{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22e95ee8-8f5f-3c93-9cd9-55dd40ea450b",
                    "sense_definition": "A dog.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The friendly <w>pooch</w> wagged its tail when it saw its owner coming home.",
                            "target_lang_translations": {
                                "pl": "Przyjazny <w>psiak</w> merdał ogonem, gdy zobaczył, że jego właściciel wraca do domu."
                            }
                        },
                        {
                            "text": "Taking the <w>pooch</w> for a walk in the park is a great way to exercise.",
                            "target_lang_translations": {
                                "pl": "Zabranie <w>pieska</w> na spacer do parku to świetny sposób na ćwiczenia."
                            }
                        }
                    ],
                    "synonyms": [
                        "dog",
                        "hound"
                    ],
                    "common_phrases": [
                        "happy pooch"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a dog."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Potoczne określenie psa."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "piesek",
                                "target_lang_sense_clarification": "zdrobnienie od słowa pies, często używane w kontekście przyjaznego zwierzęcia"
                            },
                            {
                                "target_lang_word": "psiak",
                                "target_lang_sense_clarification": "potoczne, czułe określenie psa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e63f0001-b1a4-3a13-b030-7ae78a93ee62",
                    "sense_definition": "A dog of mixed breed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She adopted a cute little <w>pooch</w> from the local animal shelter last month.",
                            "target_lang_translations": {
                                "pl": "W zeszłym miesiącu adoptowała uroczego <w>kundelka</w> z lokalnego schroniska dla zwierząt."
                            }
                        },
                        {
                            "text": "That scruffy <w>pooch</w> has a very unique look because of its mixed heritage.",
                            "target_lang_translations": {
                                "pl": "Ten zaniedbany <w>kundel</w> ma bardzo unikalny wygląd ze względu na swoje mieszane pochodzenie."
                            }
                        }
                    ],
                    "synonyms": [
                        "mongrel",
                        "mutt"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a mixed-breed dog."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pies nierasowy, mieszaniec."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kundel",
                                "target_lang_sense_clarification": "pies niebędący przedstawicielem żadnej konkretnej rasy"
                            },
                            {
                                "target_lang_word": "mieszaniec",
                                "target_lang_sense_clarification": "pies pochodzący z krzyżówki różnych ras"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44f18e45-6cb8-3a11-b435-2a723c5a3ec8",
                    "sense_definition": "To swell or extend beyond normal limits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "swell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fabric began to <w>pooch</w> out where the seam was starting to tear.",
                            "target_lang_translations": {
                                "pl": "Materiał zaczął się <w>wybrzuszać</w> w miejscu, gdzie szew zaczynał pękać."
                            }
                        },
                        {
                            "text": "If you overfill the bag, the sides will <w>pooch</w> and eventually break.",
                            "target_lang_translations": {
                                "pl": "Jeśli przepełnisz torbę, boki zaczną <w>odstawać</w> i w końcu pękną."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulge",
                        "protrude",
                        "swell"
                    ],
                    "common_phrases": [
                        "pooch out"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wypychać się, wybrzuszać, odstawać."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wybrzuszać się",
                                "target_lang_sense_clarification": "o materiale lub powierzchni, która traci płaski kształt"
                            },
                            {
                                "target_lang_word": "odstawać",
                                "target_lang_sense_clarification": "o części ubrania lub przedmiotu, która nie przylega płasko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6044971d-fd96-370c-8955-dfed3c7573e2",
                    "sense_definition": "A bulge or an enlarged part.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "swell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a noticeable <w>pooch</w> in the plastic container where it melted.",
                            "target_lang_translations": {
                                "pl": "Na plastikowym pojemniku widać wyraźne <w>wybrzuszenie</w> w miejscu, gdzie się stopił."
                            }
                        },
                        {
                            "text": "The uneven <w>pooch</w> on the wall indicates that the plaster is loose.",
                            "target_lang_translations": {
                                "pl": "Nierówna <w>wypukłość</w> na ścianie wskazuje, że tynk jest luźny."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulge",
                        "protrusion"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wybrzuszenie, wypukłość."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wybrzuszenie",
                                "target_lang_sense_clarification": "miejsce, w którym powierzchnia jest wypukła"
                            },
                            {
                                "target_lang_word": "wypukłość",
                                "target_lang_sense_clarification": "fragment przedmiotu wystający ponad jego powierzchnię"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}