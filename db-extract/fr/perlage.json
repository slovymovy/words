                "senses": [
                    {
                        "sense_id": "bf656bf1-76df-3876-abc5-b9d1df2a9b2c",
                        "entry_id": "3c59609f-b9df-322b-b399-940bdee22e80",
                        "glosses": [
                            "Pratique consistant à décorer un vêtement avec des perles cousues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c98a7d-c12e-46ae-922d-8ea592d194d5",
                                "sense_id": "bf656bf1-76df-3876-abc5-b9d1df2a9b2c",
                                "text": "Les Xhosa sont connus pour leur travail de perlage sur les vêtements et les éléments de parure."
                            },
                            {
                                "example_id": "76203a82-b708-4ec2-b889-5bcc60e50445",
                                "sense_id": "bf656bf1-76df-3876-abc5-b9d1df2a9b2c",
                                "text": "La résidente de la communauté autochtone de Mashteuiatsh, qui longe une partie du Pekuakami (lac Saint-Jean), consacre tous ses temps libres au perlage. C’est la première chose qu’elle fait le matin et la dernière avant d’aller au lit."
                            }
                        ]
                    },
                    {
                        "sense_id": "34e411d0-f310-3e02-8fe2-dea300be55be",
                        "entry_id": "3c59609f-b9df-322b-b399-940bdee22e80",
                        "glosses": [
                            "Motif de perles cousues décorant un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03d7c00b-acc6-4bf1-a611-b3a96263a659",
                                "sense_id": "34e411d0-f310-3e02-8fe2-dea300be55be",
                                "text": "Son bustier était drapé sur le haut, plissé, orné d’une broderie et d’un perlage ivoire et argent, et sa jupe était décorée et parsemée de paillettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "a33b775c-dcae-3dc0-accc-85c6da628978",
                        "entry_id": "3c59609f-b9df-322b-b399-940bdee22e80",
                        "glosses": [
                            "Transformation de l’orge brut en orge perlé afin de le rendre comestible, consistant à en retirer les glumes et le son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e676a7e4-7a29-481f-9b2f-d3c3822a876f",
                                "sense_id": "a33b775c-dcae-3dc0-accc-85c6da628978",
                                "text": "Le grain d’orge est utilisé dans l’alimentation des humains, principalement à l’état de gruau ou après mondage ou perlage, et, plus souvent, dans l’alimentation du bétail."
                            }
                        ]
                    }
