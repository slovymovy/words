                "senses": [
                    {
                        "sense_id": "dcf2f9ed-5486-3ab2-a33d-9b109edc2f2b",
                        "entry_id": "44d1b352-93dd-3118-b579-a31a0c619e36",
                        "glosses": [
                            "Donner un caractère neuneu à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b6ac876-de95-4f0a-a7a5-ea26db491487",
                                "sense_id": "dcf2f9ed-5486-3ab2-a33d-9b109edc2f2b",
                                "text": "Vous pouvez continuer à neuneuiser tant que vous voulez et ou vous voulez."
                            },
                            {
                                "example_id": "c4f295aa-f7fa-4284-afb0-13f288a5b11b",
                                "sense_id": "dcf2f9ed-5486-3ab2-a33d-9b109edc2f2b",
                                "text": "Plus ça ira et plus on fera en sorte de neuneuiser (oui le verbe correspond au terme neuneu, tu as bien compris) les enfants."
                            },
                            {
                                "example_id": "5c6d0857-b43c-4722-bde1-0f01c1e59daa",
                                "sense_id": "dcf2f9ed-5486-3ab2-a33d-9b109edc2f2b",
                                "text": "Eh les neuneus! évitez de trop vous neuneuiser, il parait que c'est contagieux..."
                            }
                        ]
                    }
