                "senses": [
                    {
                        "sense_id": "8133b3f0-4cc0-3bff-b9f4-20f9b6dae14d",
                        "entry_id": "69860259-b198-3556-9708-a5a5d93a697f",
                        "glosses": [
                            "Säugetier (Ordnung Rodentia) mit langen, ständig nachwachsenden Schneidezähnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde98422-d283-4fb8-b714-08887952dc3b",
                                "sense_id": "8133b3f0-4cc0-3bff-b9f4-20f9b6dae14d",
                                "text": "Mäuse, Hamster und Eichhörnchen sind Nagetiere."
                            },
                            {
                                "example_id": "ac4be09b-90d5-40c2-88da-333caf4d7901",
                                "sense_id": "8133b3f0-4cc0-3bff-b9f4-20f9b6dae14d",
                                "text": "Auch Nagetiere haben das Problem der schwerverdaulichen Pflanzennahrung, das die meisten – ausgenommen etwa Siebenschläfer – wie die Hasentiere durch Caecotrophie, die doppelte Verdauung, lösen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
