                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "baa3fe2e-189a-3a85-85a6-22e0e1c49e99",
                                        "entry_id": "e1509f6c-af03-3598-ad19-1004243d9d6c",
                                        "glosses": [
