                                "sense_id": "327dc97c-1b54-3ac1-ba1a-90a721ca13c5",
                                "text": "Large, red-poll’d, blowzy hard two-handed jades"
                            },
                            {
                                "example_id": "557be26e-9537-4c8b-b097-e5ef2eb25551",
                                "sense_id": "327dc97c-1b54-3ac1-ba1a-90a721ca13c5",
                                "text": "She feels a sudden desire possessing her to make Hermine look as ugly as possible, and she knows she can do it with very little effort : she has only to bring down those heavy masses of hair further on to that alrady low forehead, and instead of Kriemhilde, Hermine will like a common-place blowzy dairymaid."
                            },
                            {
                                "example_id": "8916caec-26c2-41bf-8d1e-1d33b423d17d",
                                "sense_id": "327dc97c-1b54-3ac1-ba1a-90a721ca13c5",
                                "text": "Blowzy night-frumps vex'd Jack Q."
                            }
                        ]
                    }
