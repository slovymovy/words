                                    {
                                        "sense_id": "de1a3a46-e2e7-3bba-9d15-5278929e09c6",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A path that something or someone moves along.",
                                            "The direction of movement of a vessel at any given moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9f0da8-3e50-46de-94e3-4c73fba141e4",
                                                "sense_id": "de1a3a46-e2e7-3bba-9d15-5278929e09c6",
                                                "text": "The ship changed its course 15 degrees towards south."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d1b25e9-0f65-3caa-8a4b-05c7afeca7f0",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A path that something or someone moves along.",
                                            "The intended passage of voyage, such as a boat, ship, airplane, spaceship, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ddc44af-ec84-467c-abf4-1370014e5585",
                                                "sense_id": "8d1b25e9-0f65-3caa-8a4b-05c7afeca7f0",
                                                "text": "A course was plotted to traverse the ocean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64082704-8621-3b80-b992-ebed7ff1ef07",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A path that something or someone moves along.",
                                            "The drive usually frequented by Europeans at an Indian station."
                                        ],
                                        "tags": [
                                            "India",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5dfbc62-e849-44d1-b5ed-39eb3b1de68d",
                                                "sense_id": "64082704-8621-3b80-b992-ebed7ff1ef07",
                                                "text": "It was curious to Oakfield to be back on the Ferozepore course, after a six months' interval, which seemed like years. How much had happened in these six months!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94960421-7aed-3d05-a4c1-0caf40f9086a",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "The lowest square sail in a fully rigged mast, often named according to the mast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b7a125-2f89-4d7e-961f-1392cccad1a2",
                                                "sense_id": "94960421-7aed-3d05-a4c1-0caf40f9086a",
                                                "text": "Main course and mainsail are the same thing in a sailing ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2094a5a-b40e-34d2-8fff-caff4a27e9a8",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "Menses."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "in-plural",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd1adcc-c82b-4278-8e2f-9b9cfeaa6d1e",
                                                "sense_id": "e2094a5a-b40e-34d2-8fff-caff4a27e9a8",
                                                "text": "The bleeding body signifies as a shameful token of uncontrol, as a failure of physical self-mastery particularly associated with woman in her monthly \"courses\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb5d350b-19ef-31b6-8406-898cb95ecbd8",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A row or file of objects.",
                                            "A row of bricks or blocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be2a14c-1886-451b-861c-9959cd831149",
                                                "sense_id": "bb5d350b-19ef-31b6-8406-898cb95ecbd8",
                                                "text": "On a building that size, two crews could only lay two courses in a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3171c249-04b4-3a50-9925-057e40b18f48",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A row or file of objects.",
                                            "A row of material that forms the roofing, waterproofing or flashing system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f75bcce8-ae8c-3c9e-95a2-1de00e1f1e91",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A row or file of objects.",
                                            "In weft knitting, a single row of loops connecting the loops of the preceding and following rows."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9e935f6-5f00-30da-aaff-08546f9ed777",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "One or more strings on some musical instruments (such as the guitar, lute or vihuela): if multiple, then closely spaced, tuned in unison or octaves and intended to be played together."
                                        ],
