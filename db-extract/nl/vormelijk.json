                                "target_senses": [
                                    {
                                        "sense_id": "2c3f4afc-b4a8-3e2a-a386-6841e608afee",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "In accordance with established forms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9876f7bc-c184-4dfe-9f99-994f8d19b71b",
                                                "sense_id": "2c3f4afc-b4a8-3e2a-a386-6841e608afee",
                                                "text": "She spoke formal English, without any dialect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49576cc-06fa-3300-b982-8d291e2bb1d6",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "Official."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58fc270-170c-4bc3-b8a3-7ed1b3f2305e",
                                                "sense_id": "e49576cc-06fa-3300-b982-8d291e2bb1d6",
                                                "text": "I'd like to make a formal complaint."
                                            },
                                            {
                                                "example_id": "2798fb2a-5c43-4aa2-bbd2-69d27ee89134",
                                                "sense_id": "e49576cc-06fa-3300-b982-8d291e2bb1d6",
                                                "text": "Despite efforts by limnologists and freshwater biologists to create a formal definition of “pond”, there is still no universal distinction between a “pond” and a “lake.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b953c9e-fdeb-31ec-b642-d369e00984f5",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "Relating to the form or structure of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a5644d-9ae7-49b7-ac72-35fc2d80ec29",
                                                "sense_id": "1b953c9e-fdeb-31ec-b642-d369e00984f5",
                                                "text": "Formal linguistics ignores the vocabulary of languages and focuses solely on their grammar."
                                            },
                                            {
                                                "example_id": "9b9b8461-1caa-492a-b945-2488dee79798",
                                                "sense_id": "1b953c9e-fdeb-31ec-b642-d369e00984f5",
                                                "text": "THE THREE DOMINANT FORMS IN METALSMITHING […] At present, there are but three basic volumetric forms dominating the work of metalsmiths, the spherical (usually in its most practical form, the domical), the cylindrical, and the cubical. […] The possibilities for further variations on them are all but exhausted, there being little chance to express new and unusual ideas within the framework of such limited choices. As a result, much of twentieth-century metalsmithing has relied on surface enrichment rather than formal development for its originality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdc9ec40-3b50-38c2-8eff-069244b7c60a",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "Relating to formation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "943c784d-8561-4d64-aaa0-2102b9dea4dd",
                                                "sense_id": "bdc9ec40-3b50-38c2-8eff-069244b7c60a",
                                                "text": "The formal stage is a critical part of any child's development."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "579fe18e-32c5-39d8-a63e-5cda81f29e02",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "Ceremonial or traditional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4095f44d-381d-4c69-a81a-2b08b03b571a",
                                                "sense_id": "579fe18e-32c5-39d8-a63e-5cda81f29e02",
                                                "text": "Formal wear must be worn at my wedding!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd9914ea-f580-31e4-a89a-fa5cafa87db8",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "Proper, according to strict etiquette; not casual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b8d9ca-e3f3-4d5c-9a0d-1be20cc47490",
                                                "sense_id": "cd9914ea-f580-31e4-a89a-fa5cafa87db8",
                                                "text": "He's always very formal, and I wish he'd relax a bit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae1a1e6-8ab1-3d45-b837-6a6b21985886",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "Organized; well-structured and planned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ff41f0-2643-4ce5-913d-e1a3f6555529",
                                                "sense_id": "4ae1a1e6-8ab1-3d45-b837-6a6b21985886",
                                                "text": "When they became a formal club the rowers built a small boathouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6bb68a-e565-3826-98cb-84a3a8487d73",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "In accordance with a methodological framework with well-defined rules or laws; rigorous."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51aa602-e8dc-4bd4-970e-b4a7f2ba8f59",
                                                "sense_id": "5c6bb68a-e565-3826-98cb-84a3a8487d73",
                                                "text": "A set of words can be formal cognates only if they can be derived from a common ancestor by regular sound laws."
                                            },
                                            {
                                                "example_id": "3cb10181-a02a-4879-a9cf-e4de075e0e0c",
                                                "sense_id": "5c6bb68a-e565-3826-98cb-84a3a8487d73",
                                                "text": "Only formal proofs, which derive theorems logically from their given axioms, are considered satisfactory in modern mathematics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e50fa05-c009-36ca-b701-34f7882aa28b",
                                        "entry_id": "86fdcfc4-3a93-3c1f-8e34-b011606e4e5f",
                                        "glosses": [
                                            "Relating to mere manipulation and construction of strings of symbols, without regard to their meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a77dbf1-1b5b-41c7-a087-5a9be6fb33e3",
                                                "sense_id": "3e50fa05-c009-36ca-b701-34f7882aa28b",
                                                "text": "Formal series are defined without any reference to convergence."
                                            }
                                        ]
                                    }
                                ]
                            },
