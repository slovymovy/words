                                "target_senses": [
                                    {
                                        "sense_id": "c390ad6c-eaa1-3481-b85c-ead4892ae1be",
                                        "entry_id": "54df0190-5f92-3ef3-8188-de934158a2b7",
                                        "glosses": [
                                            "Espèce de mouche, Musca domestica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e6e327-019a-4e0d-95c3-d682af05e2bf",
                                                "sense_id": "c390ad6c-eaa1-3481-b85c-ead4892ae1be",
                                                "text": "Les mouches ont des habitudes de vie variables suivant leur organisation. […]. Certaines, telles que les mouches domestiques, qui sont si répandues, et les stomoxes vont indistinctement sur les matières mortes, sur les cadavres et sur les individus vivants."
                                            },
                                            {
                                                "example_id": "2b538903-5b83-44d1-8af5-ede719a75a7e",
                                                "sense_id": "c390ad6c-eaa1-3481-b85c-ead4892ae1be",
                                                "text": "Notre banale mouche domestique (Musca domestica) se rit du D.D.T. sur presque toute la surface de la Terre, au même titre que certaines espèces d’Anophèles, responsables du paludisme."
                                            },
                                            {
                                                "example_id": "e4d2d24f-2074-42ae-94f4-c0e743f0367c",
                                                "sense_id": "c390ad6c-eaa1-3481-b85c-ead4892ae1be",
                                                "text": "Savais-tu que la mouche domestique «entend» avec ses pattes, qu'elle «goûte» avec ses pieds et sa trompe et qu'elle «sent» avec ses antennes ? que chacun de ses grands yeux est composé d'environ 4000 facettes ? […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
