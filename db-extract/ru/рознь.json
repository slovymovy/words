                                    {
                                        "sense_id": "0f13c51b-e831-3a44-aa04-07a22dc57732",
                                        "entry_id": "2f50358d-eae5-37be-8e5b-4f3fe0e7ea75",
                                        "glosses": [
                                            "Lack of concord, agreement, harmony; disaccord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a614192e-1815-4cab-9877-0e05306d77e1",
                                                "sense_id": "0f13c51b-e831-3a44-aa04-07a22dc57732",
                                                "text": "A false witnesse that speaketh lies; and him that soweth discord among brethren."
                                            },
                                            {
                                                "example_id": "12552804-c273-420e-94f2-8eac71a02e8e",
                                                "sense_id": "0f13c51b-e831-3a44-aa04-07a22dc57732",
                                                "text": "The proposition is peace. Not peace through the medium of war; not peace to be hunted through the labyrinth of intricate and endless negotiations; not peace to arise out of universal discord, fomented from principle, in all parts of the empire; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79977b35-1026-3e1f-8c8e-d0547e9f42cd",
                                        "entry_id": "2f50358d-eae5-37be-8e5b-4f3fe0e7ea75",
                                        "glosses": [
                                            "Tension or strife resulting from a lack of agreement; dissension."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fa9c8ba-3df6-3996-9c59-6a55da872a2c",
                                        "entry_id": "2f50358d-eae5-37be-8e5b-4f3fe0e7ea75",
                                        "glosses": [
                                            "Any harsh noise, or confused mingling of sounds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f7c523-bb1e-47e4-88ad-a535ae7705a9",
                                                "sense_id": "7fa9c8ba-3df6-3996-9c59-6a55da872a2c",
                                                "text": "[…] For a Diſcord it ſelfe is but a Harſhneſſe of Diuers Sounds Meeting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c956c9ad-8468-3cb8-9d9f-ca927f8c282c",
