                "senses": [
                    {
                        "sense_id": "fe6df90c-d5d7-3ccb-8eda-e507ebc9fd13",
                        "entry_id": "9b899d6c-0ee8-3ebf-81bb-0db24ca4225e",
                        "glosses": [
                            "Gesamtheit der Rechtsnormen, die für die Gemeinschaft schädliches Verhalten unter Strafe stellen"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "861bef9a-e2ef-4ebd-9cc3-a11d225527d0",
                                "sense_id": "fe6df90c-d5d7-3ccb-8eda-e507ebc9fd13",
                                "text": "Das Strafrecht müsste in diesem Punkt deutlich verschärft werden."
                            },
                            {
                                "example_id": "03b7967e-a1f0-49e5-b1a1-fc56d3f7dc53",
                                "sense_id": "fe6df90c-d5d7-3ccb-8eda-e507ebc9fd13",
                                "text": "„Kritisch äußert sich die Höchstrichterin zur Forderung nach einer Verschärfung des Strafrechts.“"
                            },
                            {
                                "example_id": "62e544e0-0b6e-4b07-9b8e-e9769f5f52b5",
                                "sense_id": "fe6df90c-d5d7-3ccb-8eda-e507ebc9fd13",
                                "text": "„Das Strafrecht schließt als Amt und Aufgabe der richterlichen Gewalt das Staatsrecht ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
