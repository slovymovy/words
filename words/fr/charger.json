                        "charger un accusé"
                    ]
                },
                {
                    "sense_id": "66f42271-1469-389e-a28c-3fa1c91a2a9e",
                    "sense_definition": "Exagérer les traits d'une description, surjouer un rôle ou amplifier excessivement les effets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exageration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comédien a tendance à trop <w>charger</w> son personnage dans cette scène comique."
                        },
                        {
                            "text": "Son récit était captivant, bien qu'il ait un peu <w>chargé</w> les détails pour impressionner l'auditoire."
                        }
                    ],
                    "synonyms": [
                        "accentuer",
                        "amplifier",
                        "exagérer",
                        "surjouer"
