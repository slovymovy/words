{
    "word_family": [
        "задротство",
        "задротить"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c88e90c-89ce-3590-9416-a9e3d573eae1",
                    "sense_definition": "Неудачник, обычно робкий юноша без личной жизни.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_outcast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все считали его <w>задротом</w> из-за того, что он никогда не ходил на вечеринки.",
                            "target_lang_translations": {
                                "en": "Everyone thought he was a <w>loser</w> because he never went to parties."
                            }
                        },
                        {
                            "text": "Он чувствовал себя полным <w>задротом</w>, когда смотрел на счастливые пары в парке.",
                            "target_lang_translations": {
                                "en": "He felt like a total <w>loser</w> when he watched happy couples in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "неудачник"
                    ],
                    "common_phrases": [
                        "полный задрот"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "грубое, пренебрежительное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A loser, typically a shy young man with no social life."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loser",
                                "target_lang_sense_clarification": "A person who is socially inept or unsuccessful."
                            },
                            {
                                "target_lang_word": "nerd",
                                "target_lang_sense_clarification": "Often used to describe someone socially awkward or uncool."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87345e49-a9fb-3a75-a24f-a81173fdaeeb",
                    "sense_definition": "Человек, чрезмерно увлеченный чем-либо, часто компьютерными играми или учебой.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obsessive_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он стал настоящим компьютерным <w>задротом</w>, проводя за монитором по десять часов в сутки.",
                            "target_lang_translations": {
                                "en": "He became a real computer <w>geek</w>, spending ten hours a day in front of the monitor."
                            }
                        },
                        {
                            "text": "В университете его называли <w>задротом</w>, потому что он никогда не отрывался от учебников.",
                            "target_lang_translations": {
                                "en": "In university, they called him a <w>nerd</w> because he never looked up from his textbooks."
                            }
                        }
                    ],
                    "synonyms": [
                        "ботан",
                        "гик"
                    ],
                    "common_phrases": [
                        "компьютерный задрот"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "неодобрительное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person excessively obsessed with something, often computer games or studies."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "geek",
                                "target_lang_sense_clarification": "Someone obsessed with a specific hobby or technology."
                            },
                            {
                                "target_lang_word": "nerd",
                                "target_lang_sense_clarification": "Someone overly focused on academic or intellectual pursuits."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5f03342-277b-3245-996a-a5f578936d0f",
                    "sense_definition": "Излишне въедливый человек, который дотошно выясняет детали.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obsessive_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш начальник — настоящий <w>задрот</w>, он проверяет каждую запятую в отчёте.",
                            "target_lang_translations": {
                                "en": "Our boss is a real <w>nitpicker</w>; he checks every comma in the report."
                            }
                        },
                        {
                            "text": "Не будь таким <w>задротом</w>, просто подпиши документы и пойдём обедать.",
                            "target_lang_translations": {
                                "en": "Don't be such a <w>pedant</w>, just sign the documents and let's go to lunch."
                            }
                        }
                    ],
                    "synonyms": [
                        "зануда"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "неодобрительное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An overly pedantic person who meticulously investigates details."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nitpicker",
                                "target_lang_sense_clarification": "Someone who focuses too much on trivial details."
                            },
                            {
                                "target_lang_word": "pedant",
                                "target_lang_sense_clarification": "Someone who is excessively concerned with minor rules or details."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ba3ff7f-e165-3805-b8ad-d3a405deea0c",
                    "sense_definition": "Оскорбительное ругательство в адрес человека.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он в ярости крикнул ему в лицо, что тот последний <w>задрот</w>.",
                            "target_lang_translations": {
                                "en": "In a rage, he shouted in his face that he was a total <w>jerk</w>."
                            }
                        },
                        {
                            "text": "— Отвали, <w>задрот</w>! — крикнул хулиган и толкнул парня в очках.",
                            "target_lang_translations": {
                                "en": "“Get lost, <w>dickhead</w>!” the bully shouted, shoving the guy in glasses."
                            }
                        }
                    ],
                    "synonyms": [
                        "идиот",
                        "кретин"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "бранное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An offensive insult directed at a person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jerk",
                                "target_lang_sense_clarification": "A general derogatory term for an unpleasant person."
                            },
                            {
                                "target_lang_word": "dickhead",
                                "target_lang_sense_clarification": "A vulgar, highly offensive insult."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}