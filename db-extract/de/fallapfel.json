                "senses": [
                    {
                        "sense_id": "1d148869-feba-3487-b803-d33c93c1665b",
                        "entry_id": "280c1082-354c-384a-92dd-9d444510e97d",
                        "glosses": [
                            "Apfel, der ohne (erkennbaren) äußeren Anstoß vom Baum gefallen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33d6f83-3345-463f-b7ac-3efa64c82ee9",
                                "sense_id": "1d148869-feba-3487-b803-d33c93c1665b",
                                "text": "Falläpfel zählen auch zum Fallobst."
                            },
                            {
                                "example_id": "7f41ff88-13a3-4083-8392-46de9b88ebb9",
                                "sense_id": "1d148869-feba-3487-b803-d33c93c1665b",
                                "text": "„In einer anderen Ecke des Gartens sammelte eine Frau Falläpfel ein.“"
                            },
                            {
                                "example_id": "88efbb7d-be6c-4e0c-a524-0d4592e5ac22",
                                "sense_id": "1d148869-feba-3487-b803-d33c93c1665b",
                                "text": "„Die Hängematte war zwischen zwei Apfelbäumen geknotet, unter mir lagen die Falläpfel, über mir hingen die reifen Klaräpfel, neben mir standen die Büsche mit den roten, weißen und schwarzen Johannisbeeren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f9c03e8-477e-4c22-a692-b08bce946f4b",
                        "source_entry_id": "280c1082-354c-384a-92dd-9d444510e97d",
                        "source_sense_id": "1d148869-feba-3487-b803-d33c93c1665b",
                        "source_sense_description": "Apfel, der ohne (erkennbaren) äußeren Anstoß vom Baum gefallen ist",
                        "target_lang_word": "pomme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pomme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55115e15-af87-37cb-a431-7ce46704802f",
                                        "entry_id": "3721629a-f6e7-36f3-8f3c-d7cb67675bd1",
                                        "glosses": [
                                            "Fruit du pommier, de forme ronde, à la chair ferme et de saveur diverse."
                                        ],
                                        "tags": [],
                                        "note": "C’est un faux-fruit au sens botanique",
                                        "examples": [
                                            {
                                                "example_id": "67fcaaec-371b-42ee-a131-22ef96dc836e",
                                                "sense_id": "55115e15-af87-37cb-a431-7ce46704802f",
                                                "text": "La pomme est un fruit charnu à 5 loges cartilagineuses, issues des 5 carpelles du pistil floral et contenant les pépins, anciens ovules fécondés et futures graines."
                                            },
                                            {
                                                "example_id": "d7b4a7c4-2159-4e87-a730-13d68a49abbd",
                                                "sense_id": "55115e15-af87-37cb-a431-7ce46704802f",
                                                "text": "Comment se priver d’un fruit riche en vitamines, en sucres, en sels minéraux et en acides organiques… ? […] « Une pomme chaque jour éloigne le médecin »."
                                            },
                                            {
                                                "example_id": "eaf154c5-0661-4350-bc25-9f66346adb59",
                                                "sense_id": "55115e15-af87-37cb-a431-7ce46704802f",
                                                "text": "Un jour ils le mandèrent au salon et lui dirent, avec toute la douceur et la bienveillance possible, que la veille, dînant au château voisin, ils avaient mangé des pommes et des poires si parfumées, si savoureuses, si exquises, que tous les convives en avaient exprimé leur admiration."
                                            },
                                            {
                                                "example_id": "b67fc818-36ab-4040-90f7-3627df2ef791",
                                                "sense_id": "55115e15-af87-37cb-a431-7ce46704802f",
                                                "text": "Je vais m’étendre dans la prairie, sous un pommier aux pommes vertes et dures. Je peux dormir au-dessous d’elles, je peux les contempler sans crainte, et même sans l’appréhension d’avoir à inventer, l’une tombant, les lois du monde."
                                            },
                                            {
                                                "example_id": "26f41a75-cee7-40a8-b546-994e28611ff8",
                                                "sense_id": "55115e15-af87-37cb-a431-7ce46704802f",
                                                "text": "[…] mais l’on n’était qu’en juin et, sauf pour les poires de moisson qui mûrissent en août, il fallait encore attendre longtemps avant de savourer concurremment les pommes du verger et la vengeance désirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4096c70c-3121-310d-9cd7-79f11f66d4f2",
                                        "entry_id": "3721629a-f6e7-36f3-8f3c-d7cb67675bd1",
                                        "glosses": [
                                            "Tout objet en forme de pomme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c6d9417-b9a5-4e52-96ec-48ea21cb1b4d",
                                                "sense_id": "4096c70c-3121-310d-9cd7-79f11f66d4f2",
                                                "text": "Petit, la mine chafouine, pareille à une pomme de canne curieusement taillée en tête de Polichinelle, Aristide furetait, fouillait partout, peu scrupuleux, pressé de jouir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "583c09ba-bdf4-3daf-a9ea-e931efebf2fd",
                                        "entry_id": "3721629a-f6e7-36f3-8f3c-d7cb67675bd1",
                                        "glosses": [
                                            "Tout objet en forme de pomme.",
                                            "Partie d’un arrosoir, souvent amovible, par laquelle l’eau s’échappe en pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002aaca5-6c85-497f-8860-ef5040a0d5d1",
                                                "sense_id": "583c09ba-bdf4-3daf-a9ea-e931efebf2fd",
                                                "text": "La pomme d’arrosoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3845409c-9516-3419-95d0-3220c4eb6223",
                                        "entry_id": "3721629a-f6e7-36f3-8f3c-d7cb67675bd1",
                                        "glosses": [
                                            "Tout objet en forme de pomme.",
                                            "Partie d’une douche, percée et arrondie, fixée au bout d’un flexible de douche, pour se laver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
