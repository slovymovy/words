                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3017a625-00cc-4511-9d7f-991590c7ec0c",
                                "sense_id": "8d07b0a5-a768-3399-a621-975e53a1b078",
                                "text": "Z powodu artretyzmu musiałam nieraz brać całą garść leków przeciwbólowych, aż doznałam uszkodzenia żołądka i nerek."
                            }
                        ],
