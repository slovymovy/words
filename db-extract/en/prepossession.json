                "senses": [
                    {
                        "sense_id": "869fddf9-3273-3cfa-befc-3e6b0842fd7d",
                        "entry_id": "9cd39a28-3ba8-36b4-a9e2-1cfcac07fb6c",
                        "glosses": [
                            "Preoccupation; having possession beforehand."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d41b8d8-4c2f-481d-97e0-737f42ed2579",
                                "sense_id": "869fddf9-3273-3cfa-befc-3e6b0842fd7d",
                                "text": "I am fully sensible to the greatness of that freedom, which I take with you on the present occasion; a liberty which seemed to me scarcely allowable, when I reflected on that distinguished and dignified station in which you stand, and the almost general prejudice and prepossession, which is so prevalent in the world against those of my complexion."
                            },
                            {
                                "example_id": "e64fbfbf-e39e-4f43-aa88-b05c360eee90",
                                "sense_id": "869fddf9-3273-3cfa-befc-3e6b0842fd7d",
                                "text": "It opens his designs to his family, it introduces you among them, it diffuses through the party those pleasantest feelings of our nature, eager curiosity and warm prepossession."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b182d25-2ff0-3cbb-89a5-290a28076da6",
                        "entry_id": "9cd39a28-3ba8-36b4-a9e2-1cfcac07fb6c",
                        "glosses": [
                            "A preconceived opinion, or previous impression; bias, prejudice."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "d114b348-29a6-4687-9f9a-34793d992957",
                                "sense_id": "8b182d25-2ff0-3cbb-89a5-290a28076da6",
                                "text": "The spontaneous intellect of man always defines the divine which it feels in ways that harmonise with its temporary intellectual prepossessions."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
