{
    "word_family": [
        "entailment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "392d846d-c15c-36a2-b13c-729500dbc77d",
                    "sense_definition": "to involve something as a necessary or inevitable part or consequence",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "necessitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new project will <w>entail</w> careful attention to detail and a lot of overtime.",
                            "target_lang_translations": {
                                "ru": "Этот новый проект <w>потребует</w> пристального внимания к деталям и большого количества сверхурочной работы."
                            }
                        },
                        {
                            "text": "The job <w>entails</w> frequent travel to several different countries every month.",
                            "target_lang_translations": {
                                "ru": "Работа <w>влечет за собой</w> частые поездки в несколько разных стран каждый месяц."
                            }
                        }
                    ],
                    "synonyms": [
                        "involve",
                        "require",
                        "necessitate"
                    ],
                    "antonyms": [
                        "exclude"
                    ],
                    "common_phrases": [
                        "entails frequent travel",
                        "entail a risk",
                        "entail significant costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "влечь за собой что-либо как необходимое или неизбежное следствие; требовать определенных условий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влечь за собой",
                                "target_lang_sense_clarification": "вызывать последствия"
                            },
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "обуславливать необходимость"
                            },
                            {
                                "target_lang_word": "предусматривать",
                                "target_lang_sense_clarification": "включать в себя как часть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "985daa19-ddde-30a0-ba62-736868d98cbf",
                    "sense_definition": "to limit the inheritance of property to a specific line of heirs so that it cannot be sold",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family estate was <w>entailed</w> on the eldest male heir to keep the land together.",
                            "target_lang_translations": {
                                "ru": "Семейное поместье было <w>передано без права отчуждения</w> старшему наследнику мужского пола, чтобы сохранить целостность земель."
                            }
                        },
                        {
                            "text": "Because the property was <w>entailed</w>, he could not sell it to pay off his debts.",
                            "target_lang_translations": {
                                "ru": "Поскольку имущество было <w>неотчуждаемым</w>, он не мог продать его, чтобы выплатить долги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "entailed estate",
                        "entail the property"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ограничивать наследование имущества определенным кругом наследников без права продажи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налагать запрет на отчуждение",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "передавать по наследству",
                                "target_lang_sense_clarification": "без права продажи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db7092cc-b766-3475-81da-742b81b22065",
                    "sense_definition": "to cut or carve something in an ornamental or decorative way",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient wooden chest was <w>entailed</w> with curious and intricate patterns.",
                            "target_lang_translations": {
                                "ru": "Древний деревянный сундук был <w>украшен резьбой</w> с причудливыми и сложными узорами."
                            }
                        },
                        {
                            "text": "Artisans would <w>entail</w> the stone pillars with images of mythical creatures.",
                            "target_lang_translations": {
                                "ru": "Мастера <w>вырезали</w> на каменных колоннах изображения мифических существ."
                            }
                        }
                    ],
                    "synonyms": [
                        "carve",
                        "engrave"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вырезать или гравировать декоративные узоры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырезать",
                                "target_lang_sense_clarification": "орнамент"
                            },
                            {
                                "target_lang_word": "гравировать",
                                "target_lang_sense_clarification": "декоративно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49582e40-98cb-3f5c-b00f-b1e7fe4a2e0b",
                    "sense_definition": "a legal settlement that limits the inheritance of an estate to a specific sequence of heirs",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict <w>entail</w> meant that the daughters could not inherit their father's house.",
                            "target_lang_translations": {
                                "ru": "Строгий <w>порядок наследования</w> означал, что дочери не могли унаследовать дом своего отца."
                            }
                        },
                        {
                            "text": "He spent years trying to break the <w>entail</w> so he could sell the family lands.",
                            "target_lang_translations": {
                                "ru": "Он потратил годы, пытаясь отменить <w>запрет на отчуждение</w>, чтобы иметь возможность продать семейные земли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "law of entail",
                        "break the entail"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "порядок наследования имущества, ограничивающий круг наследников (обычно по мужской линии)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "майорат",
                                "target_lang_sense_clarification": "неотчуждаемое имение"
                            },
                            {
                                "target_lang_word": "заповедное имение",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5240243a-8bd1-348d-ad2e-1bff19141b34",
                    "sense_definition": "ornamental carvings or delicately worked decorative patterns",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral doors were famous for their rich <w>entail</w> and gold leaf.",
                            "target_lang_translations": {
                                "ru": "Двери собора славились своей богатой <w>резьбой</w> и сусальным золотом."
                            }
                        },
                        {
                            "text": "The knight wore armor decorated with a beautiful <w>entail</w> of vines.",
                            "target_lang_translations": {
                                "ru": "Рыцарь носил доспехи, украшенные красивым <w>орнаментом</w> из виноградных лоз."
                            }
                        }
                    ],
                    "synonyms": [
                        "intaglio",
                        "carving"
                    ],
                    "common_phrases": [
                        "rich entail"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "декоративная резьба или тонко выполненные орнаменты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резьба",
                                "target_lang_sense_clarification": "декоративная"
                            },
                            {
                                "target_lang_word": "орнамент",
                                "target_lang_sense_clarification": "вырезанный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}