                                                "sense_id": "97d741ee-fd63-3cf0-a750-42a52805e761",
                                                "text": "The politician had a bagful of humorous anecdotes she could interject into any spur of the moment stump speech."
                                            },
                                            {
                                                "example_id": "1fbff5a8-2932-4c45-9262-253b646d78b8",
                                                "sense_id": "97d741ee-fd63-3cf0-a750-42a52805e761",
                                                "text": "They each had, it seemed, a bagful of sermons often preached with great authority, and brought souls low before the altar—like so many ears of corn lopped off by the hired laborer in his daily work […]"
                                            }
                                        ]
