                        "examples": [
                            {
                                "example_id": "0319c958-f91d-4828-a3a7-1290a6e84d85",
                                "sense_id": "5f3487cd-c400-3701-8e58-c84932008f56",
                                "text": "Wie verhält sich die Leibhaftigkeit der Kirche zu ihrer geschichtlichen Wirklichkeit?",
                                "translation": "What is the materiality of the Church to its historical reality?",
                                "english": "What is the materiality of the Church to its historical reality?"
                            },
                            {
                                "example_id": "52085adf-483a-4c9f-a60e-c4108f5e541a",
                                "sense_id": "5f3487cd-c400-3701-8e58-c84932008f56",
                                "text": "Hermann Volk sieht also das \"Herz\" als einen typisch menschlichen Begriff, der den Leib und die Leibhaftigkeit voraussetzt.",
                                "translation": "Hermann Volk therefore sees the \"heart\" as a typical human concept, which presupposes the body and corporeality.",
                                "english": "Hermann Volk therefore sees the \"heart\" as a typical human concept, which presupposes the body and corporeality."
                            },
                            {
                                "example_id": "affc9c3c-ebdc-4226-b16b-810b195d7cef",
                                "sense_id": "5f3487cd-c400-3701-8e58-c84932008f56",
                                "text": "Andererseits aber ist die Leibhaftigkeit unseres Lebens auch etwas, was in das Bild der Welt in ihrem zeitlichen Verlaufe hineingehört.",
                                "translation": "On the other hand, the corporeality of our life is also something that comes into the picture of the world in your temporary course.",
                                "english": "On the other hand, the corporeality of our life is also something that comes into the picture of the world in your temporary course."
                            }
                        ]
                    }
