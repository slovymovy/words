                        "zh": [
                            {
                                "target_lang_word": "舞会",
                                "target_lang_sense_clarification": "正式的舞会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52a8f781-ad7e-3ea8-8d90-ec9c3dc8e56b",
                    "sense_definition": "A very enjoyable or fun experience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>ball</w> at the concert even though it was raining.",
                            "target_lang_translations": {
                                "ru": "Мы отлично <w>повеселились</w> на концерте, несмотря на дождь.",
                                "zh": "虽然下着雨，我们在演唱会上还是玩得非常开心。"
                            }
                        },
                        {
                            "text": "The kids had a <w>ball</w> playing in the mud all afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети получили огромное <w>удовольствие</w>, весь день играя в грязи.",
                                "zh": "孩子们整个下午都在泥里玩，玩得特别开心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blast",
                        "whale of a time"
                    ],
                    "common_phrases": [
                        "have a ball"
                    ],
                    "traits": [
