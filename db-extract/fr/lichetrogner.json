                "senses": [
                    {
                        "sense_id": "a24c61ec-df30-3881-afdc-5a3677839e0b",
                        "entry_id": "3926571b-ec4a-32bd-8da2-78089d405140",
                        "glosses": [
                            "Licher, boire."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "17aa5a49-0c47-4be8-953c-eaf6bf35ce9a",
                                "sense_id": "a24c61ec-df30-3881-afdc-5a3677839e0b",
                                "text": "Bébé qui lichote, qui lichaille, qui lichecaille, qui lichetrogne, dans une confusion radieuse, un contentement inépuisable."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1adb44b-9ee8-3226-9a27-8cf303e32d39",
                        "entry_id": "3926571b-ec4a-32bd-8da2-78089d405140",
                        "glosses": [
                            "boire goulûment."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "89456847-1fb5-446d-b3a1-2cb656c354f7",
                                "sense_id": "f1adb44b-9ee8-3226-9a27-8cf303e32d39",
                                "text": "[…] nous ^([1]) ne nous arrêtâmes de lichetrogner qu’après avoir fait un sort à deux bouteilles et demi de Brouilly et à un sublime marc de Bourgogne."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4940c4c-84af-3824-8ba0-75bd05a5fc26",
                        "entry_id": "3926571b-ec4a-32bd-8da2-78089d405140",
                        "glosses": [
                            "Utiliser au mieux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "af7e48ef-d0be-459c-ba8e-7cb1bdcaccf6",
                                "sense_id": "b4940c4c-84af-3824-8ba0-75bd05a5fc26",
                                "text": "Bravo au compositeur-parolier qui sait lichetrogner la rime jusqu’à la lie !"
                            }
                        ]
                    }
