{
    "word_family": [
        "pusher",
        "pushy",
        "pushover",
        "pushchair",
        "pushup",
        "push-button"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4cb934f-06c4-31bf-88b9-67dec7578d15",
                    "sense_definition": "To apply force to an object such that it moves away from the person or thing applying the force.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>push</w> the door hard to open it.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно сильно <w>толкнуть</w> дверь, чтобы открыть её.",
                                "tr": "Açmak için kapıyı güçlüce <w>itmen</w> gerekiyor.",
                                "zh": "你需要用力<w>推</w>门才能打开它。"
                            }
                        },
                        {
                            "text": "He <w>pushed</w> his bike up the steep hill.",
                            "target_lang_translations": {
                                "ru": "Он <w>толкал</w> свой велосипед вверх по крутому склону.",
                                "tr": "Bisikletini dik yokuştan yukarı <w>itti</w>.",
                                "zh": "他<w>推</w>着自行车上了陡坡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shove",
                        "press",
                        "thrust"
                    ],
                    "antonyms": [
                        "pull",
                        "draw",
                        "tug"
                    ],
                    "common_phrases": [
                        "push the button",
                        "push the door",
                        "push a cart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применять силу к объекту, чтобы отодвинуть его от человека или предмета, прилагающего силу.",
                        "tr": "Bir nesneye, onu uygulayan kişiden veya şeyden uzaklaşacak şekilde kuvvet uygulamak.",
                        "zh": "对物体施加力量，使其远离施力者或物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкать",
                                "target_lang_sense_clarification": "применять физическую силу (несов. вид)"
                            },
                            {
                                "target_lang_word": "толкнуть",
                                "target_lang_sense_clarification": "применить физическую силу (сов. вид)"
                            },
                            {
                                "target_lang_word": "пихать",
                                "target_lang_sense_clarification": "грубо толкать (разг.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "itmek",
                                "target_lang_sense_clarification": "fiziksel güç uygulayarak uzaklaştırmak"
                            },
                            {
                                "target_lang_word": "itelemek",
                                "target_lang_sense_clarification": "üst üste veya sürekli itmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推",
                                "target_lang_sense_clarification": "施加物理力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7a7b833-94ed-3c5a-bf66-8dacfd607fdf",
                    "sense_definition": "To continually attempt to persuade a person into a particular course of action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents always <w>push</w> me to study harder.",
                            "target_lang_translations": {
                                "ru": "Мои родители всегда <w>подталкивают</w> меня учиться усерднее.",
                                "tr": "Ailem her zaman daha çok çalışmam için beni <w>zorluyor</w>.",
                                "zh": "我父母总是<w>催促</w>我更加努力学习。"
                            }
                        },
                        {
                            "text": "We are being <w>pushed</w> for an answer by the committee.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>торопит</w> нас с ответом.",
                                "tr": "Komite tarafından yanıt vermemiz için <w>sıkıştırılıyoruz</w>.",
                                "zh": "委员会一直在<w>逼迫</w>我们给出答复。"
                            }
                        }
                    ],
                    "synonyms": [
                        "urge",
                        "pressure",
                        "force",
                        "encourage",
                        "prompt"
                    ],
                    "common_phrases": [
                        "push someone to do something",
                        "push for an answer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно пытаться убедить человека совершить определенное действие.",
                        "tr": "Bir kişiyi belirli bir eyleme ikna etmek için sürekli çaba göstermek.",
                        "zh": "持续试图说服某人采取特定行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подталкивать",
                                "target_lang_sense_clarification": "побуждать к действию"
                            },
                            {
                                "target_lang_word": "давить",
                                "target_lang_sense_clarification": "оказывать психологическое давление"
                            },
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "требовать выполнения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zorlamak",
                                "target_lang_sense_clarification": "baskı yapmak"
                            },
                            {
                                "target_lang_word": "teşvik etmek",
                                "target_lang_sense_clarification": "cesaretlendirmek"
                            },
                            {
                                "target_lang_word": "sıkıştırmak",
                                "target_lang_sense_clarification": "acele ettirmek, baskı kurmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "催促",
                                "target_lang_sense_clarification": "促使某人行动"
                            },
                            {
                                "target_lang_word": "逼迫",
                                "target_lang_sense_clarification": "施加压力要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a593b69-b65a-3c14-b402-a592f53057bd",
                    "sense_definition": "To continually exert oneself in order to achieve a goal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>push</w> yourself if you want to succeed.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>заставлять себя</w>, если хочешь добиться успеха.",
                                "tr": "Başarılı olmak istiyorsan <w>kendini zorlamalısın</w>.",
                                "zh": "如果你想成功，就必须<w>鞭策</w>自己。"
                            }
                        },
                        {
                            "text": "Don't <w>push</w> too hard or you might get injured.",
                            "target_lang_translations": {
                                "ru": "Не <w>усердствуй</w> слишком сильно, иначе можешь получить травму.",
                                "tr": "Çok fazla <w>zorlama</w> yoksa sakatlanabilirsin.",
                                "zh": "别太<w>拼搏</w>了，否则可能会受伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strive",
                        "drive",
                        "exert"
                    ],
                    "common_phrases": [
                        "push oneself",
                        "push the limits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно прилагать усилия, заставлять себя работать на пределе для достижения цели.",
                        "tr": "Bir hedefe ulaşmak için kendini sürekli zorlamak.",
                        "zh": "为了实现目标而不断努力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заставлять себя",
                                "target_lang_sense_clarification": "принуждать себя к действию"
                            },
                            {
                                "target_lang_word": "напрягаться",
                                "target_lang_sense_clarification": "прилагать усилия"
                            },
                            {
                                "target_lang_word": "усердствовать",
                                "target_lang_sense_clarification": "проявлять рвение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kendini zorlamak",
                                "target_lang_sense_clarification": "sınırlarını zorlamak"
                            },
                            {
                                "target_lang_word": "çabalamak",
                                "target_lang_sense_clarification": "yoğun gayret göstermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞭策",
                                "target_lang_sense_clarification": "督促自己努力"
                            },
                            {
                                "target_lang_word": "拼搏",
                                "target_lang_sense_clarification": "全力以赴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8356d089-4d00-33cc-a194-eeeef8b73b4d",
                    "sense_definition": "To continually promote a point of view or a product for sale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>pushing</w> its new perfume aggressively.",
                            "target_lang_translations": {
                                "ru": "Компания агрессивно <w>продвигает</w> свои новые духи.",
                                "tr": "Şirket yeni parfümünü agresif bir şekilde <w>öne çıkarıyor</w>.",
                                "zh": "该公司正在积极<w>推销</w>其新款香水。"
                            }
                        },
                        {
                            "text": "Stop <w>pushing</w> the issue because I am not interested.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>педалировать</w> эту тему, потому что мне это не интересно.",
                                "tr": "İlgilenmediğim için bu konuyu <w>dayatmaktan</w> vazgeç.",
                                "zh": "别再<w>力推</w>这件事了，因为我不感兴趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "advertise"
                    ],
                    "common_phrases": [
                        "push a product",
                        "push an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Активно продвигать точку зрения или товар на продажу.",
                        "tr": "Bir görüşü veya satılık bir ürünü sürekli öne çıkarmak, tanıtmak.",
                        "zh": "积极推广某种观点或销售产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвигать",
                                "target_lang_sense_clarification": "способствовать распространению"
                            },
                            {
                                "target_lang_word": "рекламировать",
                                "target_lang_sense_clarification": "объявлять о товаре"
                            },
                            {
                                "target_lang_word": "проталкивать",
                                "target_lang_sense_clarification": "настойчиво продвигать (разг.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öne çıkarmak",
                                "target_lang_sense_clarification": "tanıtımını yapmak"
                            },
                            {
                                "target_lang_word": "pazarlamak",
                                "target_lang_sense_clarification": "satışını teşvik etmek"
                            },
                            {
                                "target_lang_word": "dayatmak",
                                "target_lang_sense_clarification": "fikri sürekli vurgulamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推销",
                                "target_lang_sense_clarification": "推广产品"
                            },
                            {
                                "target_lang_word": "力推",
                                "target_lang_sense_clarification": "极力推广"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd882b5-8f14-3f66-aadd-eb28f12f812a",
                    "sense_definition": "To approach or come close to a specific age, number, or limit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "approach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My old car is <w>pushing</w> 200,000 miles.",
                            "target_lang_translations": {
                                "ru": "Пробег моей старой машины <w>приближается к</w> 200 000 миль.",
                                "tr": "Eski arabam 200.000 mile <w>dayandı</w>.",
                                "zh": "我的旧车里程数快要<w>接近</w>二十万英里了。"
                            }
                        },
                        {
                            "text": "He is <w>pushing</w> sixty but still looks very young.",
                            "target_lang_translations": {
                                "ru": "Ему <w>под</w> шестьдесят, но он все еще выглядит очень молодо.",
                                "tr": "Altmışına <w>yaklaşıyor</w> ama hâlâ çok genç görünüyor.",
                                "zh": "他快<w>接近</w>六十岁了，但看起来依然很年轻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "approach",
                        "near"
                    ],
                    "common_phrases": [
                        "pushing forty",
                        "pushing sixty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приближаться к определенному возрасту, числу или пределу.",
                        "tr": "Belirli bir yaşa, sayıya veya sınıra yaklaşmak.",
                        "zh": "接近特定的年龄、数字或极限。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приближаться к",
                                "target_lang_sense_clarification": "подходить к значению"
                            },
                            {
                                "target_lang_word": "подходить к",
                                "target_lang_sense_clarification": "быть близким к"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dayanmak",
                                "target_lang_sense_clarification": "sayı veya yaş sınırına yaklaşmak"
                            },
                            {
                                "target_lang_word": "yaklaşmak",
                                "target_lang_sense_clarification": "bir sınıra yakın olmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接近",
                                "target_lang_sense_clarification": "靠近数值或年龄"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a789d159-ea93-30d4-bb2c-ef011fe31adc",
                    "sense_definition": "To add a data item to the top of a stack.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function <w>pushes</w> the value onto the stack.",
                            "target_lang_translations": {
                                "ru": "Функция <w>помещает</w> значение в стек.",
                                "tr": "Fonksiyon, değeri yığına <w>ekler</w>.",
                                "zh": "该函数将数值<w>压入</w>栈中。"
                            }
                        },
                        {
                            "text": "When you <w>push</w> data, it is stored for later retrieval.",
                            "target_lang_translations": {
                                "ru": "Когда вы <w>помещаете</w> данные, они сохраняются для последующего извлечения.",
                                "tr": "Veriyi <w>eklediğinizde</w>, daha sonra geri çağrılmak üzere saklanır.",
                                "zh": "当你<w>压入</w>数据时，它会被存储以供后续检索。"
                            }
                        }
                    ],
                    "antonyms": [
                        "pop"
                    ],
                    "common_phrases": [
                        "push onto the stack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять элемент данных на вершину стека.",
                        "tr": "Bir veri ögesini yığının (stack) en üstüne eklemek.",
                        "zh": "将数据项添加到栈的顶部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помещать",
                                "target_lang_sense_clarification": "класть в стек"
                            },
                            {
                                "target_lang_word": "записывать",
                                "target_lang_sense_clarification": "сохранять данные"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eklemek",
                                "target_lang_sense_clarification": "yığına veri koymak"
                            },
                            {
                                "target_lang_word": "itmek",
                                "target_lang_sense_clarification": "yığın veri yapısına veri eklemek (terim)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压入",
                                "target_lang_sense_clarification": "计算机术语，将数据存入栈"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cf57d0b-4b41-31fb-8eaf-43b222df5909",
                    "sense_definition": "A short, directed application of force; an act of pushing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give the door a hard <w>push</w> if it sticks.",
                            "target_lang_translations": {
                                "ru": "Сильно <w>толкни</w> дверь, если она заедает.",
                                "tr": "Kapı sıkışırsa sert bir <w>itme</w> yap.",
                                "zh": "如果门卡住了，用力<w>推</w>一下。"
                            }
                        },
                        {
                            "text": "With one strong <w>push</w>, the car started moving.",
                            "target_lang_translations": {
                                "ru": "От одного сильного <w>толчка</w> машина начала двигаться.",
                                "tr": "Güçlü bir <w>itişle</w> araba hareket etmeye başladı.",
                                "zh": "用力<w>推</w>了一下，车子就开始移动了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shove",
                        "thrust"
                    ],
                    "antonyms": [
                        "pull",
                        "tug"
                    ],
                    "common_phrases": [
                        "give a push",
                        "a gentle push"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое направленное применение силы; акт толкания.",
                        "tr": "Kısa ve yönlendirilmiş bir kuvvet uygulaması; itme eylemi.",
                        "zh": "短促、有方向的施力动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "резкое движение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "itme",
                                "target_lang_sense_clarification": "itme eylemi"
                            },
                            {
                                "target_lang_word": "itiş",
                                "target_lang_sense_clarification": "fiziksel itme hareketi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推",
                                "target_lang_sense_clarification": "一次推的动作"
                            }
                        ]
                    }
