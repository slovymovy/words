                        "examples": [
                            {
                                "example_id": "e8f073c4-9bf9-4101-a776-87d6b4cc23e5",
                                "sense_id": "ec1f16db-c150-30e5-bc2e-229fdc89797d",
                                "text": "GPT is part of Intel's EFI specification, but GPT can be used on computers that don't use EFI, and GPT is the preferred partitioning system for disks bigger than 2TiB."
                            }
                        ]
                    },
                    {
                        "sense_id": "de120187-257d-3c6c-b432-565b2bff02fc",
                        "entry_id": "47e5cc5b-b5c2-3069-a6a2-8d9443b4b307",
                        "glosses": [
                            "Initialism of generative pretrained transformer."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f132513-9bae-41aa-8769-28c40641f626",
                                "sense_id": "de120187-257d-3c6c-b432-565b2bff02fc",
                                "text": "GPT-3 belongs to a category of deep learning known as a large language model, a complex neural net that has been trained on a titanic data set of text: in GPT-3’s case, roughly 700 gigabytes of data drawn from across the web, including Wikipedia, supplemented with a large collection of text from digitized books. GPT-3 is the most celebrated of the large language models, and the most publicly available, but Google, Meta (formerly known as Facebook) and DeepMind have all developed their own L.L.M.s in recent years."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6e770e4-7870-3753-9f7d-2ea12555754d",
                        "entry_id": "47e5cc5b-b5c2-3069-a6a2-8d9443b4b307",
                        "glosses": [
                            "A saved chat, project, or (especially) agentic persona within a gen AI workspace, functioning as a reusable and sharable tool."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "285d3066-7db5-4c8c-a0ed-a27805792add",
                                "sense_id": "f6e770e4-7870-3753-9f7d-2ea12555754d",
                                "text": "In today's session I'll be showing you how you can create GPTs that are tailored to your own work."
                            },
                            {
                                "example_id": "2cfed5e3-0d24-408b-a81c-834f49cc61a2",
                                "sense_id": "f6e770e4-7870-3753-9f7d-2ea12555754d",
                                "text": "We will use a 345M parameter GPT-2 transformer in TensorFlow from OpenAI's repository. We must get our hands dirty to understand GPT models."
                            }
                        ]
                    },
