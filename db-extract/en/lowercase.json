                    }
                ],
                "senses": [
                    {
                        "sense_id": "f473c0a2-af95-3626-a620-fd4d3fb472a2",
                        "entry_id": "e1b98b56-f5a4-3026-8091-0501653b821d",
                        "glosses": [
                            "To convert (text) to lower case."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "eb7d0e45-ecab-4b47-9ca5-ec775dd2816c",
                                "sense_id": "f473c0a2-af95-3626-a620-fd4d3fb472a2",
                                "text": "Sister Jadallah apologizes for being unable to bring her readers facts and figures on Palestinian Lesbianism (forgive my capital \"L\" in Lesbianism, but like my Black brothers I cannot bring myself to lower-casing our recently empowering accoutrements of our Gay identities)"
                            },
                            {
                                "example_id": "3e4fc6d6-38dd-4d1f-b2ed-dc0c7aea0da1",
                                "sense_id": "f473c0a2-af95-3626-a620-fd4d3fb472a2",
                                "text": "I never asked Rob e. Hanson why he lowercased his middle initial; I suppose he figured a man just shouldn’t accumulate too much capital."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab66d35c-461e-4603-b23f-88124f49262d",
                        "source_entry_id": "e1b98b56-f5a4-3026-8091-0501653b821d",
                        "source_sense_id": "f473c0a2-af95-3626-a620-fd4d3fb472a2",
                        "source_sense_description": "To convert (text) to lower case.",
                        "target_lang_word": "minusculiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minusculiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4851208-fd71-37a9-ac8e-628baabbea80",
                                        "entry_id": "ca717561-172e-33ed-83a9-ea6294001e25",
                                        "glosses": [
                                            "Faire passer une lettre de majuscule à minuscule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a46953-5c1e-4859-a4e5-e0c64a715ab8",
                                                "sense_id": "f4851208-fd71-37a9-ac8e-628baabbea80",
                                                "text": "D'aucuns majusculisent : Monsieur Antoine Blondin Directeur général\nD'autres minusculisent : Monsieur Louis Bonhôte conseiller national\nLes subtils majusculisent ou minusculisent, suivant l'importance du titre ou de la profession: Directeur, mais « sous-directeurs »."
                                            },
                                            {
                                                "example_id": "67fed01a-416a-4b21-9f95-06aeeb01bc59",
                                                "sense_id": "f4851208-fd71-37a9-ac8e-628baabbea80",
                                                "text": "Dans l’Enfer rabelaisien, puisque le but consiste à rabaisser les grandeurs usurpées, l'artifice sera par exemple de minusculiser les noms qui caractérisent l'usurpation."
                                            },
                                            {
                                                "example_id": "2a4076c3-48a0-4001-b5a4-6b60ffdc6732",
                                                "sense_id": "f4851208-fd71-37a9-ac8e-628baabbea80",
                                                "text": "Je commence par minusculiser sa lettre initiale ; et puis je goûte... à la manière des vignerons tourangeaux et sans idées préconçues ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c3e0ec-7c1d-301a-b69a-b42747592b44",
                                        "entry_id": "ca717561-172e-33ed-83a9-ea6294001e25",
                                        "glosses": [
                                            "Rabaisser à une taille minuscule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7015f2de-5ca8-436a-82b0-69c1b4424538",
                                                "sense_id": "81c3e0ec-7c1d-301a-b69a-b42747592b44",
                                                "text": "Celle qui consiste à minimiser, que dis-je ? à minusculiser, voire à néantiser complètement... les films, du moins les films traditionnellement dits « expérimentaux », par commodité et métaphore, c’est-à-dire les films qui entraient vraiment dans la problématique choisie, les films où se donne à voir réellement le « va-et-vient » peinture-cinéma-peinture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
