    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f88b20b-d621-3c77-b7a0-f478660db9ff",
                    "sense_definition": "Физически захватить или поднять предмет рукой.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>взял</w> корзину с продуктами.",
                            "target_lang_translations": {
                                "pl": "<w>Wziąłem</w> koszyk z zakupami.",
                                "de": "Ich <w>nahm</w> den Einkaufskorb."
                            }
                        },
                        {
                            "text": "Он аккуратно <w>взял</w> книгу с полки.",
                            "target_lang_translations": {
                                "pl": "Ostrożnie <w>wziął</w> książkę z półki.",
                                "de": "Er <w>nahm</w> das Buch vorsichtig aus dem Regal."
                            }
                        }
                    ],
                    "synonyms": [
                        "схватить",
                        "поднять"
                    ],
                    "antonyms": [
                        "положить",
                        "оставить"
                    ],
                    "common_phrases": [
                        "взять в руки"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uchwycić coś lub podnieść ręką.",
                        "de": "Einen Gegenstand mit der Hand physisch greifen oder anheben."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wziąć",
                                "target_lang_sense_clarification": "podnieść lub chwycić dłonią"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nehmen",
                                "target_lang_sense_clarification": "einen Gegenstand greifen oder an sich nehmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06fbd785-b2ba-3f0d-ac57-ea40eba8e6ec",
                    "sense_definition": "Приобрести товар за деньги.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Может быть, вы <w>возьмёте</w> этой колбаски попробовать?",
                            "target_lang_translations": {
                                "pl": "Może <w>weźmie</w> pan trochę tej kiełbasy na próbę?",
                                "de": "Möchten Sie vielleicht etwas von dieser Wurst zum Probieren <w>nehmen</w>?"
                            }
                        },
                        {
                            "text": "Я <w>возьму</w> два билета в кино.",
                            "target_lang_translations": {
                                "pl": "<w>Wezmę</w> dwa bilety do kina.",
                                "de": "Ich <w>nehme</w> zwei Kinokarten."
                            }
                        }
                    ],
                    "synonyms": [
                        "купить"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nabyć towar, kupić (potocznie).",
                        "de": "Eine Ware gegen Bezahlung erwerben; kaufen (umgangssprachlich)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wziąć",
                                "target_lang_sense_clarification": "kupić, zdecydować się na zakup"
                            },
                            {
                                "target_lang_word": "kupić",
                                "target_lang_sense_clarification": "nabyć za pieniądze"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nehmen",
                                "target_lang_sense_clarification": "etwas kaufen oder auswählen"
                            },
                            {
                                "target_lang_word": "kaufen",
                                "target_lang_sense_clarification": "gegen Bezahlung erwerben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dec4823a-fa20-3667-bd28-2a9abb4b46b3",
                    "sense_definition": "Захватить контроль над объектом или территорией.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Армии не удалось <w>взять</w> город штурмом.",
                            "target_lang_translations": {
                                "pl": "Armii nie udało się <w>zdobyć</w> miasta szturmem.",
                                "de": "Der Armee gelang es nicht, die Stadt im Sturm zu <w>nehmen</w>."
                            }
                        },
                        {
                            "text": "Альпинисты <w>взяли</w> вершину горы.",
                            "target_lang_translations": {
                                "pl": "Alpiniści <w>zdobyli</w> szczyt góry.",
                                "de": "Die Bergsteiger haben den Berggipfel <w>bezwungen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "захватить",
                        "оккупировать"
                    ],
                    "common_phrases": [
                        "взять штурмом"
                    ],
                    "target_lang_definitions": {
                        "pl": "Opanować, zdobyć kontrolę nad obiektem, terenem lub szczytem.",
                        "de": "Die Kontrolle über ein Objekt, ein Gebiet oder einen Berggipfel erlangen."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdobyć",
                                "target_lang_sense_clarification": "opanować miasto, szczyt"
                            },
                            {
                                "target_lang_word": "zająć",
                                "target_lang_sense_clarification": "przejąć kontrolę nad terenem"
                            },
                            {
                                "target_lang_word": "wziąć",
                                "target_lang_sense_clarification": "np. szturmem"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einnehmen",
                                "target_lang_sense_clarification": "militärisch erobern oder besetzen"
                            },
                            {
                                "target_lang_word": "erobern",
                                "target_lang_sense_clarification": "eine Stadt, ein Gebiet oder einen Gipfel bezwingen"
                            },
                            {
                                "target_lang_word": "besteigen",
                                "target_lang_sense_clarification": "einen Berggipfel bezwingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e84cb0c-c217-3db4-a522-e5b6328fc61d",
                    "sense_definition": "Задержать или арестовать преступника.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция <w>взяла</w> преступника с поличным.",
                            "target_lang_translations": {
                                "pl": "Policja <w>złapała</w> przestępcę na gorącym uczynku.",
                                "de": "Die Polizei hat den Täter auf frischer Tat <w>ertappt</w>."
                            }
                        },
                        {
                            "text": "Его <w>взяли</w> прямо на выходе из банка.",
                            "target_lang_translations": {
                                "pl": "<w>Zgarnęli</w> go zaraz przy wyjściu z banku.",
                                "de": "Man hat ihn direkt am Ausgang der Bank <w>geschnappt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "арестовать",
                        "задержать"
                    ],
                    "common_phrases": [
                        "взять с поличным",
                        "взять под стражу"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zatrzymać lub aresztować podejrzanego.",
                        "de": "Einen Kriminellen oder Verdächtigen festnehmen oder verhaften."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zgarnąć",
                                "target_lang_sense_clarification": "zatrzymać przestępcę (potocznie)"
                            },
                            {
                                "target_lang_word": "aresztować",
                                "target_lang_sense_clarification": "zatrzymać pod zarzutem przestępstwa"
                            },
                            {
                                "target_lang_word": "zatrzymać",
                                "target_lang_sense_clarification": "ująć przez policję"
                            },
                            {
                                "target_lang_word": "dorwać",
                                "target_lang_sense_clarification": "schwytać na gorącym uczynku"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "festnehmen",
                                "target_lang_sense_clarification": "von der Polizei in Gewahrsam nehmen"
                            },
                            {
                                "target_lang_word": "schnappen",
                                "target_lang_sense_clarification": "einen Kriminellen fassen (umgangssprachlich)"
                            },
                            {
                                "target_lang_word": "verhaften",
                                "target_lang_sense_clarification": "unter Arrest stellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49e756b5-0007-3a88-ad83-9d305144c6d6",
                    "sense_definition": "Используется для описания внезапного или неожиданного действия.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unexpected_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>взял</w> да и уехал без предупреждения.",
                            "target_lang_translations": {
                                "pl": "<w>Wziął i</w> wyjechał bez uprzedzenia.",
                                "de": "Er ist <w>einfach</w> ohne Vorwarnung abgereist."
                            }
                        },
                        {
                            "text": "Медведь <w>взял</w> и съел всю еду.",
                            "target_lang_translations": {
                                "pl": "Niedźwiedź po prostu <w>wziął i</w> zjadł całe jedzenie.",
                                "de": "Der Bär hat <w>einfach</w> das ganze Essen aufgefressen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "взять да и"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Używane posiłkowo dla podkreślenia nagłości lub niespodziewanego charakteru czynności.",
                        "de": "Dient als Hilfsverb zur Hervorhebung einer plötzlichen, unüberlegten oder unerwarteten Handlung."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wziąć i",
                                "target_lang_sense_clarification": "zrobić coś niespodziewanie lub bez namysłu"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einfach",
                                "target_lang_sense_clarification": "plötzlich und ohne Weiteres eine Handlung vollziehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}