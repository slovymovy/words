                "translations": [
                    {
                        "translation_id": "a28e7def-bbbb-4f0d-9319-52f53836ea98",
                        "source_entry_id": "0316120c-50f0-384e-b4da-0a3c6c4cc0fa",
                        "source_sense_id": "254d2a86-aba5-32c6-84a4-0c76f6512e31",
                        "target_lang_word": "purple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29c40a63-6250-3353-9b7a-4ff8d2ef9515",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "A colour between red and blue; violet, though often closer to magenta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05490dd9-20ff-452c-90bf-b549d887ce49",
                                                "sense_id": "29c40a63-6250-3353-9b7a-4ff8d2ef9515",
                                                "text": "Arraying with reflected Purple and Gold / The Clouds that on his Weſtern Throne attend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef14dc30-2e55-3dd1-b5bf-63cbe320c161",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Any non-spectral colour on the line of purples on a colour chromaticity diagram or a colour wheel between violet and red."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad5e4e79-0200-3d29-a8d7-e4fbb7f071cf",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Cloth, or a garment, dyed a purple colour; especially, a purple robe, worn as an emblem of rank or authority; specifically, the purple robe or mantle worn by Ancient Roman emperors as the emblem of imperial dignity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48764fe0-b1e7-45e7-a3bc-d9a4b19e6622",
                                                "sense_id": "ad5e4e79-0200-3d29-a8d7-e4fbb7f071cf",
                                                "text": "to put on the imperial purple"
                                            },
                                            {
                                                "example_id": "887e7a8e-808b-407b-84f6-c98f5e2200cd",
                                                "sense_id": "ad5e4e79-0200-3d29-a8d7-e4fbb7f071cf",
                                                "text": "Thy head as Carmelus: and the heares of thy head as a kings purple tyed to cundite pipes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd71c139-8d9c-3d5a-8c1c-9eb860232dbd",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Imperial power."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3cf1c35-77d3-4e17-b050-85f23a130b11",
                                                "sense_id": "fd71c139-8d9c-3d5a-8c1c-9eb860232dbd",
                                                "text": "1776-1788, Edward Gibbon, The History of the Decline and Fall of the Roman Empire\nHe was born in the purple."
                                            },
                                            {
                                                "example_id": "91782d23-1fce-4e53-aa53-51807ccf7063",
                                                "sense_id": "fd71c139-8d9c-3d5a-8c1c-9eb860232dbd",
                                                "text": "When we picture to ourselves his [Napoleon’s] dawning military genius at Toulon—his daring and decided politics in the storms of the Revolution—his Cæsarian ambition in assuming the purple—[…]"
                                            },
                                            {
                                                "example_id": "aed457c9-bad8-4fcc-a427-e0242c7f5e90",
                                                "sense_id": "fd71c139-8d9c-3d5a-8c1c-9eb860232dbd",
                                                "text": "The immediate successors of Augustus indulged in appalling cruelties towards senators and towards possible competitors for the purple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4e72a32-74ea-32f7-929e-0e137b4c266b",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Any of various species of mollusks from which Tyrian purple dye was obtained, especially the common dog whelk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b87de08-6540-30cb-8ae9-b86692ef6a73",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "The purple haze cultivar of cannabis in the kush family, either pure or mixed with others, or by extension any variety of smoked marijuana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce385db9-461a-42f7-8ebf-6d3cf99df5d1",
                                                "sense_id": "2b87de08-6540-30cb-8ae9-b86692ef6a73",
                                                "text": "\"Sure, some purple Owlsley.\""
                                            },
                                            {
                                                "example_id": "0cfde23b-61e4-4b27-9205-0433fefdccf0",
                                                "sense_id": "2b87de08-6540-30cb-8ae9-b86692ef6a73",
                                                "text": "“Purple smoke is no joke. Especially when it is real purple. The smell, taste, and high is easily one of the best in the world. One bowl of some purple Kush, and I'm done for a couple of hours."
                                            },
                                            {
                                                "example_id": "d32e44ac-593d-4358-807c-23d2fc2a8ac0",
                                                "sense_id": "2b87de08-6540-30cb-8ae9-b86692ef6a73",
                                                "text": "She preferred to smoke some good purple, but getting high wasn't an option."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f8e2ee1-47de-33ee-8976-d1e2ffd80b77",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Purpura."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a99431d-24c1-3b0d-89c9-fccf8380f380",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Earcockle, a disease of wheat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b9f1f15-9359-3ae6-b3ca-c48ff61ee50e",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Any of the species of large butterflies, usually marked with purple or blue, of the genus Basilarchia (formerly Limenitis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "370061b2-bc88-4a02-99c2-e5b81212e666",
                                                "sense_id": "0b9f1f15-9359-3ae6-b3ca-c48ff61ee50e",
                                                "text": "the banded purple"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63159d5-d989-3a41-b085-4f3b30774d83",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "A cardinalate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f3afb7e-1355-3a86-9406-d4d2a018841f",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Ellipsis of purple drank."
                                        ],
                                        "tags": [
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa39b99-c89d-4234-a645-7765bf10b444",
                                                "sense_id": "5f3afb7e-1355-3a86-9406-d4d2a018841f",
                                                "text": "Fishtailing out the parking lot leaving Magic / Sipping on the purple and the yellow, drinking magic"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd3b6f70-59f0-3544-8ceb-f253071a2bd7",
                                        "entry_id": "e82c79dc-a6d2-3896-a058-c33584fdb030",
                                        "glosses": [
                                            "Synonym of snakebite and black."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "purple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10217b62-9064-3fe0-8b8e-141376698193",
                                        "entry_id": "779eeda0-38a2-3e5b-b13a-fe9e67804ca9",
                                        "glosses": [
                                            "Of a purple hue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b08da7-9123-459f-8fb2-259e930e27d1",
                                                "sense_id": "10217b62-9064-3fe0-8b8e-141376698193",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad6be02-35b2-3627-8d19-9d4bebb06309",
                                        "entry_id": "779eeda0-38a2-3e5b-b13a-fe9e67804ca9",
                                        "glosses": [
                                            "Not predominantly red or blue, but having a mixture of Democrat and Republican support."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26c0e5f2-9fec-485d-bc79-e88fbfda9754",
                                                "sense_id": "cad6be02-35b2-3627-8d19-9d4bebb06309",
                                                "text": "purple state"
                                            },
                                            {
                                                "example_id": "43998164-be4f-4ffd-9dc6-588018b678de",
                                                "sense_id": "cad6be02-35b2-3627-8d19-9d4bebb06309",
                                                "text": "purple city"
                                            },
                                            {
                                                "example_id": "eeb084ae-f9e6-46ef-b184-e098d6d52cb0",
                                                "sense_id": "cad6be02-35b2-3627-8d19-9d4bebb06309",
                                                "text": "In the end, Nevada remained the quintessential purple state. On the maps that television used to illustrate political trends, Republican states were red and Democratic blue. Nevada blended the colors. It had a bright blue core in the heart of Las Vegas, surrounded by a purple suburban belt. Most of the rest of the state was bright red, especially in the rural counties."
                                            },
                                            {
                                                "example_id": "ff9c0785-3988-4ef8-ba9c-fbd61b6a7c04",
                                                "sense_id": "cad6be02-35b2-3627-8d19-9d4bebb06309",
                                                "text": "As Mr. Friedlander conceived it, Reason was neither strictly right-wing libertarian nor strictly left — in modern parlance, neither red nor blue but a purple amalgam of the two."
                                            },
                                            {
                                                "example_id": "a98bfe69-deab-4a75-80ef-6c830eafe642",
                                                "sense_id": "cad6be02-35b2-3627-8d19-9d4bebb06309",
                                                "text": "Political colorists can be promiscuous in calling states purple, but my state is true to that hue. I speak of North Carolina, and I have receipts: While our junior senator, Ted Budd, is a Republican who won election to a first term in 2022 by about three percentage points, our governor, Roy Cooper, is a Democrat who won election to a second term in 2020 by more than four."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c0c8447-6c30-3e18-98b2-a4bce0d9c252",
                                        "entry_id": "779eeda0-38a2-3e5b-b13a-fe9e67804ca9",
                                        "glosses": [
                                            "Mixed between social democrats and liberals."
                                        ],
                                        "tags": [
                                            "in Netherlands and Belgium"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b466037-5116-3250-975b-2d9b74c4b938",
                                        "entry_id": "779eeda0-38a2-3e5b-b13a-fe9e67804ca9",
                                        "glosses": [
                                            "Imperial; regal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c91e84c-3123-4964-8250-f6d5336521e2",
                                                "sense_id": "1b466037-5116-3250-975b-2d9b74c4b938",
                                                "text": "Grovel on the earth: aye, hide / In the dust thy purple pride!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf54d2d-786f-38ad-8784-3c6bf50dd0a2",
                                        "entry_id": "779eeda0-38a2-3e5b-b13a-fe9e67804ca9",
                                        "glosses": [
                                            "Blood-red; bloody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f032804-8501-4fd0-bf71-12da6b3382bd",
                                                "sense_id": "0bf54d2d-786f-38ad-8784-3c6bf50dd0a2",
                                                "text": "O may ſuch purple teares be alway ſhed"
                                            },
                                            {
                                                "example_id": "c9903590-5666-4dea-b821-81c7f437ddf1",
                                                "sense_id": "0bf54d2d-786f-38ad-8784-3c6bf50dd0a2",
                                                "text": "Wars, horrid Wars I view; a field of Blood; / And Tyber rolling with a Purple Flood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfea25b7-1b51-318e-9f82-511f4bb6de47",
                                        "entry_id": "779eeda0-38a2-3e5b-b13a-fe9e67804ca9",
                                        "glosses": [
                                            "Extravagantly ornate, like purple prose."
                                        ],
                                        "tags": [
                                            "of language"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ca312be-cd5b-4edc-9b4d-2954d34df3df",
                                                "sense_id": "bfea25b7-1b51-318e-9f82-511f4bb6de47",
                                                "text": "Near-synonyms: flowery, overwrought"
                                            },
                                            {
                                                "example_id": "d295ced3-f557-45d0-9330-43fa7ac6d8ad",
                                                "sense_id": "bfea25b7-1b51-318e-9f82-511f4bb6de47",
                                                "text": "A writer who has made a career of churning out thick novels may be expected to write too quickly to notice that patches of her writing are unbearably purple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a62f6b3-9779-3629-8e81-4fa293f13f50",
                                        "entry_id": "779eeda0-38a2-3e5b-b13a-fe9e67804ca9",
                                        "glosses": [
                                            "Completed in the fastest time so far in a given session."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "purple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "368167e2-9402-3d65-a720-32170e578d75",
                                        "entry_id": "26f5d54b-be49-3ca1-8b34-7a601a00a871",
                                        "glosses": [
                                            "To turn purple in colour."
