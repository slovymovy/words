{
    "word_family": [
        "deep",
        "deepen",
        "deepness",
        "depth"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f2302d19-c9cd-39cf-a5fa-aec9e931fc59",
                    "sense_definition": "To a great extent or degree; very much.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>deeply</w> concerned about the impact of these changes on the local community.",
                            "target_lang_translations": {
                                "ru": "Я <w>глубоко</w> обеспокоен влиянием этих изменений на местное сообщество.",
                                "zh": "我<w>深深地</w>担忧这些变化对当地社区的影响。"
                            }
                        },
                        {
                            "text": "He said he <w>deeply</w> regretted his behavior during the meeting yesterday.",
                            "target_lang_translations": {
                                "ru": "Он сказал, что <w>глубоко</w> сожалеет о своем поведении на вчерашнем собрании.",
                                "zh": "他说他<w>深深地</w>后悔昨天会议上的表现。"
                            }
                        }
                    ],
                    "antonyms": [
                        "slightly"
                    ],
                    "common_phrases": [
                        "deeply concerned",
                        "deeply regret",
                        "deeply moved"
                    ],
                    "target_lang_definitions": {
                        "ru": "В значительной степени или мере; очень сильно.",
                        "zh": "在很大程度上或程度上；非常。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "о чувствах или убеждениях"
                            },
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "о степени обеспокоенности"
                            },
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "о степени воздействия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深深地",
                                "target_lang_sense_clarification": "用于表达强烈的情感或态度"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "用于强调程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e08b4b0-17fe-3817-a9e5-dc393d6147f3",
                    "sense_definition": "In large volume or with a lot of air or liquid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient to breathe <w>deeply</w> while he listened to her lungs.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента дышать <w>глубоко</w>, пока он слушал ее легкие.",
                                "zh": "医生让病人<w>深</w>呼吸，以便听诊她的肺部。"
                            }
                        },
                        {
                            "text": "After the long race, he began to drink <w>deeply</w> from his water bottle.",
                            "target_lang_translations": {
                                "ru": "После долгого забега он начал <w>жадно</w> пить из своей бутылки с водой.",
                                "zh": "长跑结束后，他开始<w>大口地</w>喝水。"
                            }
                        }
                    ],
                    "antonyms": [
                        "shallowly"
                    ],
                    "common_phrases": [
                        "breathe deeply",
                        "drink deeply"
                    ],
                    "target_lang_definitions": {
                        "ru": "В большом объеме, захватывая много воздуха или жидкости.",
                        "zh": "以大容量或包含大量空气或液体的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "о дыхании или глотках"
                            },
                            {
                                "target_lang_word": "жадно",
                                "target_lang_sense_clarification": "о питье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深",
                                "target_lang_sense_clarification": "用于呼吸或吸气"
                            },
                            {
                                "target_lang_word": "大口地",
                                "target_lang_sense_clarification": "用于描述喝水或进食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1949c01a-b39c-391c-a0ae-31a8ec64d4e9",
                    "sense_definition": "In a profound or serious manner, rather than superficially.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat by the window and thought <w>deeply</w> about the problem for several hours.",
                            "target_lang_translations": {
                                "ru": "Она сидела у окна и <w>глубоко</w> размышляла над проблемой в течение нескольких часов.",
                                "zh": "她坐在窗边，针对这个问题<w>深入地</w>思考了几个小时。"
                            }
                        },
                        {
                            "text": "The students were encouraged to think <w>deeply</w> about the ethical implications of the experiment.",
                            "target_lang_translations": {
                                "ru": "Студентов призывали <w>серьезно</w> задуматься об этических последствиях эксперимента.",
                                "zh": "老师鼓励学生<w>深入地</w>思考该实验的伦理影响。"
                            }
                        }
                    ],
                    "antonyms": [
                        "superficially"
                    ],
                    "common_phrases": [
                        "think deeply",
                        "ponder deeply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основательно или серьезно, а не поверхностно.",
                        "zh": "以深刻或严肃的方式，而非肤浅地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "о размышлениях"
                            },
                            {
                                "target_lang_word": "серьезно",
                                "target_lang_sense_clarification": "об обдумывании"
                            },
                            {
                                "target_lang_word": "основательно",
                                "target_lang_sense_clarification": "о подходе к вопросу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深入地",
                                "target_lang_sense_clarification": "用于思考或研究"
                            },
                            {
                                "target_lang_word": "认真地",
                                "target_lang_sense_clarification": "用于对待问题的态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6434721-9656-3179-8dbb-7c250ca99372",
                    "sense_definition": "In a way that extends far down from the surface or far into the interior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient surface of the moon is <w>deeply</w> cratered from millions of years of impacts.",
                            "target_lang_translations": {
                                "ru": "Древняя поверхность Луны <w>глубоко</w> изрыта кратерами в результате миллионов лет столкновений.",
                                "zh": "月球古老的表面因数百万年的撞击而布满了<w>深</w>坑。"
                            }
                        },
                        {
                            "text": "The roots of the old oak tree grow <w>deeply</w> into the soil.",
                            "target_lang_translations": {
                                "ru": "Корни старого дуба уходят <w>глубоко</w> в почву.",
                                "zh": "那棵老橡树的根<w>深</w>扎进土壤里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deep"
                    ],
                    "antonyms": [
                        "shallowly"
                    ],
                    "common_phrases": [
                        "deeply rooted",
                        "deeply buried"
                    ],
                    "target_lang_definitions": {
                        "ru": "На большом расстоянии от поверхности или глубоко внутри чего-либо.",
                        "zh": "以从表面向内延伸很远的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "физическое расположение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深",
                                "target_lang_sense_clarification": "用于物理位置或深度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72cd8693-862b-3db1-ae1f-ba5ea08a5c61",
                    "sense_definition": "In a sound or heavy manner, especially regarding sleep.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby was sleeping so <w>deeply</w> that even the loud thunder did not wake him.",
                            "target_lang_translations": {
                                "ru": "Младенец спал так <w>крепко</w>, что даже сильный гром не разбудил его.",
                                "zh": "婴儿睡得太<w>沉</w>了，连响雷都没把他吵醒。"
                            }
                        },
                        {
                            "text": "After the exhausting hike, they all slept <w>deeply</w> until noon the next day.",
                            "target_lang_translations": {
                                "ru": "После изнурительного похода они все <w>глубоко</w> спали до полудня следующего дня.",
                                "zh": "精疲力竭的徒步旅行后，他们一直<w>沉</w>睡到第二天中午。"
                            }
                        }
                    ],
                    "antonyms": [
                        "lightly"
                    ],
                    "common_phrases": [
                        "sleep deeply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепко или беспробудно, особенно в отношении сна.",
                        "zh": "以沉稳或沉重的方式，尤指睡眠。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "о состоянии сна"
                            },
                            {
                                "target_lang_word": "крепко",
                                "target_lang_sense_clarification": "о сне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉",
                                "target_lang_sense_clarification": "用于描述睡眠状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d261554-eb17-3329-8cd3-dce1ccce7155",
                    "sense_definition": "In a rich or intense way, often referring to color or flavor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a <w>deeply</w> flavoured curry using a secret blend of spices.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил карри с <w>насыщенным</w> вкусом, используя секретную смесь специй.",
                                "zh": "厨师用秘制香料调配出味道<w>浓郁</w>的咖喱。"
                            }
                        },
                        {
                            "text": "Her <w>deeply</w> hennaed hair looked almost black in the dim light of the room.",
                            "target_lang_translations": {
                                "ru": "Ее <w>густо</w> окрашенные хной волосы казались почти черными в тусклом свете комнаты.",
                                "zh": "在昏暗的房间里，她那染得<w>深</w>红的头发看起来几乎是黑色的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "faintly"
                    ],
                    "common_phrases": [
                        "deeply flavoured",
                        "deeply colored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насыщенно или интенсивно, часто о цвете или вкусе.",
                        "zh": "以浓郁或强烈的方式，常指颜色或味道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "об интенсивности цвета"
                            },
                            {
                                "target_lang_word": "насыщенно",
                                "target_lang_sense_clarification": "о вкусе или цвете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浓郁",
                                "target_lang_sense_clarification": "用于味道"
                            },
                            {
                                "target_lang_word": "深",
                                "target_lang_sense_clarification": "用于颜色"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}