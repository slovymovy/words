                "senses": [
                    {
                        "sense_id": "4be15dfb-a0e7-3c21-adac-098b8815e475",
                        "entry_id": "30329cd6-e83f-3e99-ba01-a16d3a5d3165",
                        "glosses": [
                            "Nom d’un des alcaloïdes de l’opium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8006cf31-ae60-41b5-8b44-067c3dba8437",
                                "sense_id": "4be15dfb-a0e7-3c21-adac-098b8815e475",
                                "text": "La thébaïne, désignée également sous le nom de paramorphine, a été découverte par Thibouméry, et examinée par Pelletier et Couerbe."
                            },
                            {
                                "example_id": "d1febf55-1d10-42dc-8b39-ef7582b154da",
                                "sense_id": "4be15dfb-a0e7-3c21-adac-098b8815e475",
                                "text": "On l’obtient en mélangeant la thébaïne avec une petite quantité d’alcool et ajoutant une solution alcoolique d’acide chlorhydrique jusqu’à ce qu'elle soit entièrement dissoute, on abandonne la liqueur, qui ne doit pas renfermer un excès d’acide."
                            }
                        ]
                    }
                ],
