                    }
                ],
                "senses": [
                    {
                        "sense_id": "66403acf-874d-3fd3-a1b5-160d56293466",
                        "entry_id": "58fba852-f639-3daf-ad58-fcc9a273772b",
                        "glosses": [
                            "een karaktereigenschap ontstaan door beheersing van een vurig temperament of door de afwezigheid van een al te hartstochtelijk karakter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32845151-aede-47e9-a67c-0a2169f67c93",
                                "sense_id": "66403acf-874d-3fd3-a1b5-160d56293466",
                                "text": "‘De kroonprins en zijn vader blijven erop hameren dat het nieuwe Saoedi-Arabië een land van vrijheid en gematigdheid is en dat de creatie van de anticorruptiecommissie slechts een stap in de goede richting is.’"
                            },
                            {
                                "example_id": "d758c964-8ab3-4151-8b04-292d3b99fe54",
                                "sense_id": "66403acf-874d-3fd3-a1b5-160d56293466",
                                "text": "Moord in Pakistan op de gematigdheid: Pakistan raakt steeds verder ontwricht. Gisteren werd de gematigde leider Salman Taseer door een politieman vermoord, na zijn kritiek op de strenge blasfemiewet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4b1f497-df97-42a7-9bea-62fc75ed67ab",
                        "source_entry_id": "58fba852-f639-3daf-ad58-fcc9a273772b",
                        "source_sense_id": "66403acf-874d-3fd3-a1b5-160d56293466",
                        "source_sense_description": "bedaardheid",
                        "target_lang_word": "measure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "measure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90f965b8-0d4c-34c9-a53c-92710540d2a6",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "A prescribed quantity or extent.",
                                            "Moderation, temperance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3353e24f-0651-4a24-adae-3f81bebbff8b",
                                                "sense_id": "90f965b8-0d4c-34c9-a53c-92710540d2a6",
                                                "text": "I will correct thee in measure, and will not leaue thee altogether vnpunished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4f5046-fb7f-3ab9-968e-8b80144e636e",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "A prescribed quantity or extent.",
                                            "A limit that cannot be exceeded; a bound. (Now chiefly in set phrases.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56dfcbbb-f953-43f1-b6b6-fb9d01536836",
                                                "sense_id": "4b4f5046-fb7f-3ab9-968e-8b80144e636e",
                                                "text": "Mom's rage has no measure."
                                            },
                                            {
                                                "example_id": "09d55798-a5ba-415a-949a-d45ea1e18d98",
                                                "sense_id": "4b4f5046-fb7f-3ab9-968e-8b80144e636e",
                                                "text": "Full to the utmost measure of what bliss Human desires can seek or apprehend."
                                            },
                                            {
                                                "example_id": "c16ec4bb-8dd2-40b1-9dce-ea207dda260a",
                                                "sense_id": "4b4f5046-fb7f-3ab9-968e-8b80144e636e",
                                                "text": "but there is never found a foolish man who knows the measure of his stomach"
                                            },
                                            {
                                                "example_id": "03953b82-d5f4-4705-b9fd-61b5c4b8fa41",
                                                "sense_id": "4b4f5046-fb7f-3ab9-968e-8b80144e636e",
                                                "text": "They have gloried to this day, the tedious interminable big-screen replays of that golden summer irritating beyond measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9459c858-80b9-331a-818e-1486f973593d",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "A prescribed quantity or extent.",
                                            "An (unspecified) portion or quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a1a3ef-b2c4-450f-a417-e5095dc834e5",
                                                "sense_id": "9459c858-80b9-331a-818e-1486f973593d",
                                                "text": "It ended up being a bittersweet night for England, full of goals to send the crowd home happy, buoyed by the news that Montenegro and Poland had drawn elsewhere in Group H but also with a measure of regret about what happened to Danny Welbeck and what it means for Roy Hodgson's team going into a much more difficult assignment against Ukraine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287b30a1-4d29-304e-a2f7-8ffaebc1f5ae",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "A receptacle or vessel of a standard size, capacity etc. as used to deal out specific quantities of some substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d550d5a6-6c8e-432c-93f9-67818692130e",
                                                "sense_id": "287b30a1-4d29-304e-a2f7-8ffaebc1f5ae",
                                                "text": "a measure of salt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552804f0-5e35-3a03-ba6f-6a8864984601",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "A standard against which something can be judged; a criterion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a2fc79-93bd-4a98-849c-9b2b94761d5c",
                                                "sense_id": "552804f0-5e35-3a03-ba6f-6a8864984601",
                                                "text": "Honesty is the true measure of a man."
                                            },
                                            {
                                                "example_id": "ead7281e-a1fb-4566-93c2-2c6d7218245d",
                                                "sense_id": "552804f0-5e35-3a03-ba6f-6a8864984601",
                                                "text": "City were also the victors on that occasion 56 years ago, winning 5-0, but this visit was portrayed as a measure of their progress against the 19-time champions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01fdf23-e05a-3038-8d6e-2d41ed662cc9",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "Any of various standard units of capacity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8945d2-63c6-4180-8365-5ab3fa66c21b",
                                                "sense_id": "e01fdf23-e05a-3038-8d6e-2d41ed662cc9",
                                                "text": "The villagers paid a tithe of a thousand measures of corn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb275bb2-c708-3a48-a8f8-fe4eef5b5246",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "A unit of measurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5adffd-09b4-4d46-84a6-5d9955dfe5b5",
                                                "sense_id": "cb275bb2-c708-3a48-a8f8-fe4eef5b5246",
                                                "text": "The fragments shrank by increments of about three kilodaltons (a measure of molecular weight)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0edfd464-3911-377b-bfa0-e01a94e74daf",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "The size of someone or something, as ascertained by measuring. (Now chiefly in make to measure.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9b60106-fa24-4f1b-9f42-16486da5097c",
                                                "sense_id": "0edfd464-3911-377b-bfa0-e01a94e74daf",
                                                "text": "The measure thereof is longer than the earth, and broader than the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c0b4e09-a546-34cc-ad61-9f1ef94773c5",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "The act or process of measuring."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "542b0541-e0f9-39be-8eee-17c3ca9aec75",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "A ruler, measuring stick, or graduated tape used to take measurements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be1d269e-782b-342d-8e58-55082a80a928",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "A bed or stratum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0618f966-1d64-4f13-816a-ed009c73789d",
                                                "sense_id": "be1d269e-782b-342d-8e58-55082a80a928",
                                                "text": "coal measures; lead measures"
                                            },
                                            {
                                                "example_id": "328db917-2ceb-43c0-81d7-b76eda986ca1",
                                                "sense_id": "be1d269e-782b-342d-8e58-55082a80a928",
                                                "text": "For many years the coal measures on the shores of Lough Allen were worked only in the most primitive fashion, and the coal was transported laboriously in the inevitable ass carts of the Irish peasant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa540d6-aa3d-3efd-85db-664bce954f6d",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "A number which is contained in a given number a number of times without a remainder; a divisor or factor."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2129d3a-93fe-4877-924a-97ad29112055",
                                                "sense_id": "afa540d6-aa3d-3efd-85db-664bce954f6d",
                                                "text": "the greatest common measure of two or more numbers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8959909-394d-3a78-8fc3-8dd74a9a6097",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "The act or result of measuring.",
                                            "A function which obeys a particular set of formal conditions, created to generalize and rigorize the notions of length, volume, and probability. Formally, a non-negative, countably additive set function on a sigma-algebra; see Measure (mathematics) on Wikipedia.Wikipedia"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0da70bb-4e4c-348e-8bf3-21f5fe5ba68e",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "Metrical rhythm.",
                                            "A melody."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1047c51b-06b4-3f6c-8e08-ea3f8c4c823a",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "Metrical rhythm.",
                                            "A dance."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14291155-51a0-45d1-a64c-7ddee8f0cc17",
                                                "sense_id": "1047c51b-06b4-3f6c-8e08-ea3f8c4c823a",
                                                "text": "He took her soft hand, ere her mother could bar,— / \"Now tread we a measure!\" said young Lochinvar."
                                            },
                                            {
                                                "example_id": "c58f7b0d-504f-49f5-aa4c-c4481f8f58e8",
                                                "sense_id": "1047c51b-06b4-3f6c-8e08-ea3f8c4c823a",
                                                "text": "They danced on silently, softly. Their feet played tricks to the beat of the tireless measure, that exquisitely asinine blare which is England's punishment for having lost America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f8f57ef-7d98-35e2-bf96-8e5f5c53f362",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "Metrical rhythm.",
                                            "The manner of ordering and combining the quantities, or long and short syllables; meter; rhythm; hence, a metrical foot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c187fc27-9aaf-4ba5-8c3b-e74ef90d40e1",
                                                "sense_id": "0f8f57ef-7d98-35e2-bf96-8e5f5c53f362",
                                                "text": "a poem in iambic measure"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f3832b2-c713-3841-aa0b-1c121ac57490",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "Metrical rhythm.",
                                            "A musical designation consisting of all notes and or rests delineated by two vertical bars; an equal and regular division of the whole of a composition; a bar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d6ebbcc-a99b-3230-8089-0c7afa1b958d",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "A course of action.",
                                            "Actions designed to achieve some purpose; plans."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c26ac1e-0049-443e-8d5c-be3ab8afc0ce",
                                                "sense_id": "4d6ebbcc-a99b-3230-8089-0c7afa1b958d",
                                                "text": "The president said the measures involve a ban on all visitors to the country via all ports of entry who aren't residents or diplomats. El Salvadorans or residents who return to El Salvador will be quarantined for 30 days.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0e16c9c-3729-3a6f-b94e-5024ab6753fe",
                                        "entry_id": "d575454e-9814-3670-b44a-a83f87868cda",
                                        "glosses": [
                                            "A course of action.",
                                            "A piece of legislation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2803d1c-f4ee-4aa6-b975-71ff076a7654",
                                                "sense_id": "c0e16c9c-3729-3a6f-b94e-5024ab6753fe",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "measure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32fd08dc-e242-316b-ac18-8c23ff1dd116",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To ascertain the quantity of a unit of material via calculated comparison with respect to a standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62be951-52d6-428f-8624-10b34648b631",
                                                "sense_id": "32fd08dc-e242-316b-ac18-8c23ff1dd116",
                                                "text": "We measured the temperature with a thermometer. You should measure the angle with a spirit level."
                                            },
                                            {
                                                "example_id": "6ea4bf4f-4854-4b03-ba89-06606ab84d2e",
                                                "sense_id": "32fd08dc-e242-316b-ac18-8c23ff1dd116",
                                                "text": "This park is the first large-scale public park in Taiwan. It is located on the border of Nantzu District in Kaohsiung City and Chiaotou village, Kaohsiung County and this park measures 95 hectares."
                                            },
                                            {
                                                "example_id": "08445a2c-7991-49c2-b7f7-fa026f908997",
                                                "sense_id": "32fd08dc-e242-316b-ac18-8c23ff1dd116",
                                                "text": "But poverty’s scourge is fiercest below $1.25 (the average of the 15 poorest countries’ own poverty lines, measured in 2005 dollars and adjusted for differences in purchasing power): people below that level live lives that are poor, nasty, brutish and short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d4dc9ea-f796-3150-9b45-82765d3d40cf",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To be of (a certain size), to have (a certain measurement)"
                                        ],
                                        "tags": [
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da90a3c5-a1df-45b0-9be1-28a785996101",
                                                "sense_id": "3d4dc9ea-f796-3150-9b45-82765d3d40cf",
                                                "text": "The window measured two square feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "352b3b2f-945e-390b-8dc8-0deee6c564cf",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To estimate the unit size of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776ae4fa-36ef-4799-a5d2-3eceac4b65c1",
                                                "sense_id": "352b3b2f-945e-390b-8dc8-0deee6c564cf",
                                                "text": "I measure that at 10 centimetres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cbc25af-00d8-32c4-98d5-59a0b7d3cff0",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To judge, value, or appraise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f90986-2eff-40d0-bbea-ef6d45425046",
                                                "sense_id": "1cbc25af-00d8-32c4-98d5-59a0b7d3cff0",
                                                "text": "ſince they meaſure our deſerts so meane,\nThat in conceit beare Empires on our ſpeares,\nAffecting thoughts coequall with the cloudes,\nThey ſhalbe kept our forced followers,\nTil with their eies they view vs Emperours."
                                            },
                                            {
                                                "example_id": "21b45dc7-4cd0-4964-9f9a-9ac69a59fd6d",
                                                "sense_id": "1cbc25af-00d8-32c4-98d5-59a0b7d3cff0",
                                                "text": "Great are thy works, Jehovah, infinite / Thy power! what thought can measure thee?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166ebdbb-9864-3d8a-922e-fd153c61fd53",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To obtain or set apart; to mark in even increments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ce39170-c7a3-3a5c-8fcc-cfa794171ebd",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To traverse, cross, pass along; to travel over."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a186e27f-889d-4c84-b94a-bdd4997239c3",
                                                "sense_id": "8ce39170-c7a3-3a5c-8fcc-cfa794171ebd",
                                                "text": "A true devoted pilgrim is not weary / To measure kingdoms with his feeble steps."
                                            },
                                            {
                                                "example_id": "a23978c5-7c0a-48bc-b612-9372fcc05ead",
                                                "sense_id": "8ce39170-c7a3-3a5c-8fcc-cfa794171ebd",
                                                "text": "\"And for a very sensible reason; there never was but one like her; or, that is, I have always thought so until to-day,\" replied the tar, glancing toward Natalie; \"for my old eyes have seen pretty much everything they have got in this little world. Ha! I should like to see the inch of land or water that my foot hasn't measured.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1160dff-7508-3303-8552-36ab19792a92",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To adjust by a rule or standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ae2ec5-8e0b-4463-b507-aec0f9f9e6ad",
                                                "sense_id": "d1160dff-7508-3303-8552-36ab19792a92",
                                                "text": "To secure a contented spirit, you must measure your desires by your fortune and condition, not your fortunes by your desires"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a180cf24-030a-3f85-9983-5042049b4071",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To allot or distribute by measure; to set off or apart by measure; often with."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a4b89e5-da9a-4a63-bff4-0c672318c57a",
                                                "sense_id": "a180cf24-030a-3f85-9983-5042049b4071",
                                                "text": "With what measure ye mete, it shall be measured to you again."
                                            },
                                            {
                                                "example_id": "0a4b4c96-116d-431b-8a1a-f0451261e5a3",
                                                "sense_id": "a180cf24-030a-3f85-9983-5042049b4071",
                                                "text": "That portion of eternity which is called time, measured out by the sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ab3be0-9387-3949-ae23-3cb741aa6611",
                                        "entry_id": "975c41ec-6bdb-3d57-a374-3494399d2763",
                                        "glosses": [
                                            "To regulate or control (one's actions, speech, etc.), as if one were carefully measuring their length or quantity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8881a012-de8a-4df2-acf8-63d65bb8a2b8",
                                                "sense_id": "d5ab3be0-9387-3949-ae23-3cb741aa6611",
                                                "text": "To measure one’s own activity, to make it conform to these standards of clearness, brevity and truth, is practically a very difficult matter."
                                            },
                                            {
                                                "example_id": "a55de43b-1f5f-47f1-8d40-c02ee0d7dbf2",
                                                "sense_id": "d5ab3be0-9387-3949-ae23-3cb741aa6611",
                                                "text": "In its opening portrait of Madame Caillaux, the rightist and anti-Caillaux Illustration asked its readers to imagine not a wronged victim or a female ruled by emotion but a careful player who measured her every word."
                                            },
                                            {
                                                "example_id": "27f01af9-7cd0-47f4-9560-90720d6e3404",
                                                "sense_id": "d5ab3be0-9387-3949-ae23-3cb741aa6611",
                                                "text": "He measured his actions with a critical eye and was an exemplary citizen and householder. He was, the author explained, a simple, good man, and like all simple, good men he had an ideal […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "428418f3-f525-4a42-bad0-a79705570045",
                        "source_entry_id": "58fba852-f639-3daf-ad58-fcc9a273772b",
                        "source_sense_id": "66403acf-874d-3fd3-a1b5-160d56293466",
                        "source_sense_description": "bedaardheid",
                        "target_lang_word": "modesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa111ba-e157-3804-8328-483b46f1c26b",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "The quality of being modest; having a limited and not overly high opinion of oneself and one's abilities."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a91821-dcfd-466d-84ae-c66850791baa",
                                                "sense_id": "0aa111ba-e157-3804-8328-483b46f1c26b",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "174e3b69-ffe2-34e2-a038-a80f346051fa",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "Moderate behaviour; reserve."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c402cf68-4e85-3f8c-be2a-22eaa5b69ffa",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "Pudency, avoidance of sexual explicitness."
                                        ],
                                        "tags": [
                                            "specifically",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b203066-537c-4b5a-aa64-ccc3d0417121",
                                                "sense_id": "c402cf68-4e85-3f8c-be2a-22eaa5b69ffa",
                                                "text": "... but the cars of chaste women have either coverings thrown over them, or white sheets hung over; for instance, on the cars of the female part of the family of the deceased Nawabs Khanduran and Muzaffar Khan, there used generally to be fastened thick dirty white cloths, and in like manner also on their palanquins—although one brother was the chief treasurer, and the other a commander of seven thousand men. And most assuredly this is a requirement of modesty; for one whose palanquin or cart is turned out with much splendour, verily the idea comes to the minds of the sight-seers and common people, that in it there must be some lovely one, bright as the morning, the envy of the fairies. Hence, for the cars or palanquins for women to ride in to be greatly embroidered is, in the opinion of certain men of standing, who are worthy to be trusted, of great infamy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
