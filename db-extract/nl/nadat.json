                "forms": [],
                "senses": [
                    {
                        "sense_id": "4810d054-f4d6-33f6-bc62-d4be8b2d3022",
                        "entry_id": "9faff02b-63fe-3250-823c-417ebc92586a",
                        "glosses": [
                            "geeft onderschikkend het voorafgaande aan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1db284aa-a6c1-4d01-938f-206d47e42e80",
                                "sense_id": "4810d054-f4d6-33f6-bc62-d4be8b2d3022",
                                "text": "Hij droogde zich af nadat hij zich had gedoucht."
                            },
                            {
                                "example_id": "fa943521-9091-4434-a39c-5aa5e7cacdba",
                                "sense_id": "4810d054-f4d6-33f6-bc62-d4be8b2d3022",
                                "text": "Nadat hij zich had gedoucht droogde hij zich af."
                            },
                            {
                                "example_id": "73d29184-e395-45dc-a4a7-f0e44e2f674a",
                                "sense_id": "4810d054-f4d6-33f6-bc62-d4be8b2d3022",
                                "text": "Nadat ik wat gedronken had sprong ik het meer in met al mijn kleren om het zweet en het stof van me af te wassen."
                            },
                            {
                                "example_id": "1cb56293-8c7e-44a3-8cfb-f80702d5122f",
                                "sense_id": "4810d054-f4d6-33f6-bc62-d4be8b2d3022",
                                "text": "Het was zwaar geweest voor de drie broers, vooral de eerste zomer nadat hun vader en oom vermist waren op zee, toen moesten de jongens werken tot ze er letterlijk bij neervielen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3a29a9d-66c0-49c5-9961-4466a6b98cb3",
                        "source_entry_id": "9faff02b-63fe-3250-823c-417ebc92586a",
                        "source_sense_id": "4810d054-f4d6-33f6-bc62-d4be8b2d3022",
                        "target_lang_word": "after",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "after",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6b66ebf-4cfc-3706-a4d4-adaf2185b7ba",
                                        "entry_id": "ae9051b6-d22a-321c-9b43-466a23460329",
                                        "glosses": [
                                            "Behind; later in time; following."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "827ccc31-99d9-4a1e-b8f5-a634021193a2",
                                                "sense_id": "a6b66ebf-4cfc-3706-a4d4-adaf2185b7ba",
                                                "text": "I left the room, and the dog bounded after."
                                            },
                                            {
                                                "example_id": "2f8f60f0-bca6-4d97-95da-dd870f81b8c6",
                                                "sense_id": "a6b66ebf-4cfc-3706-a4d4-adaf2185b7ba",
                                                "text": "They lived happily ever after."
                                            },
                                            {
                                                "example_id": "bdbe05e3-c85b-44d0-b99b-dc54ee067c4d",
                                                "sense_id": "a6b66ebf-4cfc-3706-a4d4-adaf2185b7ba",
                                                "text": "I might come next month, or the month after."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "after",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Subsequently to; following in time; later than."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c21de216-7643-4e78-998a-90d4c9d56fd8",
                                                "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                                "text": "We had a few beers after the game."
                                            },
                                            {
                                                "example_id": "3fe82c7b-7538-471e-b308-998fae208216",
                                                "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                                "text": "The time is a quarter after eight."
                                            },
                                            {
                                                "example_id": "2499870f-ea47-4290-b464-1fbeab178b64",
                                                "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                                "text": "The Cold War began shortly after WWII."
                                            },
                                            {
                                                "example_id": "e659c438-fafb-42df-9d65-7609c9ef94e8",
                                                "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                                "text": "After you with the salt and pepper."
                                            },
                                            {
                                                "example_id": "03c09165-0c21-4843-b0c5-3e6b164454fe",
                                                "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                                "text": "I was about to say that I had known the Celebrity from the time he wore kilts. But I see I will have to amend that, because he was not a celebrity then, nor, indeed, did he achieve fame until some time after I left New York for the West."
                                            },
                                            {
                                                "example_id": "3a0f0c17-ec9d-4660-861c-91cb06fa363d",
                                                "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                                "text": "After early sparring, Spurs started to take control as the interval approached and twice came close to taking the lead. Terry blocked Rafael van der Vaart's header on the line and the same player saw his cross strike the post after Adebayor was unable to apply a touch."
                                            },
                                            {
                                                "example_id": "9e5ef54e-166f-49eb-8920-9180f130b167",
                                                "sense_id": "ea1c4846-d08e-339f-9cc8-8c229d2fae62",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a780b68-d9cb-39b8-adaf-78cdeca85c0d",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Subsequently to; following in time; later than.",
                                            "Subsequently to and as a result of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e74cf9be-ee25-4cd0-bfcb-30499fdb0126",
                                                "sense_id": "8a780b68-d9cb-39b8-adaf-78cdeca85c0d",
                                                "text": "After your bad behaviour, you will be punished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91519749-bdea-38cb-b597-e28d4c25a720",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Subsequently to; following in time; later than.",
                                            "Subsequently to and considering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6e5c07-a229-4208-8187-0a7ceae27b03",
                                                "sense_id": "91519749-bdea-38cb-b597-e28d4c25a720",
                                                "text": "I’m not putting you in charge again after the last disaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56d6b11a-d283-3e7b-bcbc-f5668d20ed29",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Subsequently to; following in time; later than.",
                                            "Subsequently to and in spite of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6fb5577-2b2c-4700-a7f6-ab91a0bcd95c",
                                                "sense_id": "56d6b11a-d283-3e7b-bcbc-f5668d20ed29",
                                                "text": "After all that has happened, he is still my friend."
                                            },
                                            {
                                                "example_id": "8acc885e-df5c-4b03-b86f-50d6cada205a",
                                                "sense_id": "56d6b11a-d283-3e7b-bcbc-f5668d20ed29",
                                                "text": "I can’t believe that, after all our advice against gambling, you walked into that casino!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98360018-d7e9-3175-97ae-dae63057045e",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Subsequently to; following in time; later than.",
                                            "Subsequently to the actions of (someone), in order to remedy a situation."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d432d7fa-fc4d-44b8-a0c5-03b463d50f45",
                                                "sense_id": "98360018-d7e9-3175-97ae-dae63057045e",
                                                "text": "I'm tired of picking up after you. Why can't you clean your own messes?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31bfb36a-4409-3be7-b044-c32b93978de3",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Subsequently to; following in time; later than.",
                                            "Repeatedly, seemingly in a sequence without end."
                                        ],
                                        "tags": [
                                            "in reduplicative expressions"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c33c97b1-d6be-4365-afc4-116f4c8b0394",
                                                "sense_id": "31bfb36a-4409-3be7-b044-c32b93978de3",
                                                "text": "day after day, time after time, mile after mile, beer after beer, smile after smile"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b149ce19-40ed-3e0a-b5fb-0de4473d9193",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Subsequently to; following in time; later than.",
                                            "Used to indicate recent completion of an activity."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Newfoundland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d3700d-c887-41d0-9dbf-5ae0ac6a75fa",
                                                "sense_id": "b149ce19-40ed-3e0a-b5fb-0de4473d9193",
                                                "text": "I was after finishing my dinner when there was a knock on the door. [= I had just finished my dinner when ...]"
                                            },
                                            {
                                                "example_id": "689d966f-e309-46fb-a2b4-b185f96f3a1e",
                                                "sense_id": "b149ce19-40ed-3e0a-b5fb-0de4473d9193",
                                                "text": "He was after walking on the Thursday, Friday, and Saturday before, all the way from the County Limerick, where his brother, Father John, has a parish; and you may believe, the poor man was tired"
                                            },
                                            {
                                                "example_id": "8515de21-e04d-4ee5-afe6-d003db7f81bd",
                                                "sense_id": "b149ce19-40ed-3e0a-b5fb-0de4473d9193",
                                                "text": "Mother: Let him get away out of this now, himself and his share of songs. Look at the way he has your bib destroyed that I was after washing in the morning!"
                                            },
                                            {
                                                "example_id": "3995eef1-4fdc-4c2a-b2fd-2e8ed65d5db4",
                                                "sense_id": "b149ce19-40ed-3e0a-b5fb-0de4473d9193",
                                                "text": "When I woke up it was black-dark and the music was after stopping. I could taste the bread I was after eating in the dream, as sweet and luscious as any I ever knew"
                                            },
                                            {
                                                "example_id": "bce1d678-9431-43f2-846e-89c138857c63",
                                                "sense_id": "b149ce19-40ed-3e0a-b5fb-0de4473d9193",
                                                "text": "He asked directions to the dairy those milk cans had shown up late at. Corrigan pointed back the way he'd come and explained, “You'd have been after riding past their loading platform because they don't have their sign overlooking where the train would be after stopping."
                                            },
                                            {
                                                "example_id": "09aea863-abe9-4cc8-916b-a71416640ba3",
                                                "sense_id": "b149ce19-40ed-3e0a-b5fb-0de4473d9193",
                                                "text": "\"Yes. And where were you when the flood broke loose?\" / \"I would be most of the way to the Old House then. O'Loughlin was after running in wild to tell me he was hearing the Banshee out at The Old House, […].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b0e534-c5a6-318f-aafb-7722ad46ca02",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Behind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9639a586-faa9-4fb2-b287-6bf546d282d6",
                                                "sense_id": "e3b0e534-c5a6-318f-aafb-7722ad46ca02",
                                                "text": "He will leave a trail of destruction after him."
                                            },
                                            {
                                                "example_id": "adb5ac9b-e518-4e86-9b09-5a14c52dade6",
                                                "sense_id": "e3b0e534-c5a6-318f-aafb-7722ad46ca02",
                                                "text": "I told her to shut the door after her."
                                            },
                                            {
                                                "example_id": "d755e783-1320-4f76-bac3-d43125dc2456",
                                                "sense_id": "e3b0e534-c5a6-318f-aafb-7722ad46ca02",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa05242f-2aee-3e30-b0b9-09b8b3cf56b3",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "In pursuit of, seeking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6eec844-a64f-430d-9850-743f96597c37",
                                                "sense_id": "aa05242f-2aee-3e30-b0b9-09b8b3cf56b3",
                                                "text": "He’s after a job; run after him; inquire after her health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cd7242b-06b2-333f-8e01-b2b4954682f7",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "In allusion to, in imitation of; following or referencing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a564b6bd-afa5-41e8-9e31-e3ee97b1aa29",
                                                "sense_id": "3cd7242b-06b2-333f-8e01-b2b4954682f7",
                                                "text": "We named him after his grandfather."
                                            },
                                            {
                                                "example_id": "6b760643-b1bf-4fb5-9a57-2398d36a96d7",
                                                "sense_id": "3cd7242b-06b2-333f-8e01-b2b4954682f7",
                                                "text": "This painting is after Leonardo da Vinci."
                                            },
                                            {
                                                "example_id": "2ad64acd-ec4b-40df-97a9-3fe5874b0938",
                                                "sense_id": "3cd7242b-06b2-333f-8e01-b2b4954682f7",
                                                "text": "Work your horse in a calade, after the Italian way; ride him straight, and then you make good use of the calade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a5f222-291d-3a08-a543-ba521ae367f1",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Below, often next below, in importance or rank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640bd158-53e5-4c46-920f-72c48ceb22c3",
                                                "sense_id": "65a5f222-291d-3a08-a543-ba521ae367f1",
                                                "text": "The princess is next in line to the throne after the prince."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1660fa38-69ca-3159-9b8e-8c45ae4378d0",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "Denoting the aim or object; concerning; in relation to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d83579d-8c3f-4430-9f6c-19f457860fdf",
                                                "sense_id": "1660fa38-69ca-3159-9b8e-8c45ae4378d0",
                                                "text": "to look after workmen; to enquire after a friend; to thirst after righteousness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3da9784-57de-3e4b-aac8-4e7bd98e22ab",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "According to (an author or text)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bcbc590-533c-3306-8464-7debd747364a",
                                        "entry_id": "bc1896c9-8fa2-36e6-b888-9d4bfb82034a",
                                        "glosses": [
                                            "According to the direction and influence of; in proportion to; befitting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b2c793-eb62-4da2-96d2-aad80d7d2fad",
                                                "sense_id": "3bcbc590-533c-3306-8464-7debd747364a",
                                                "text": "He takes greatness of kingdoms according to bulk and currency, and not after their intrinsic value."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "after",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b712aef-a2b9-388e-b0d6-bdde334d4446",
                                        "entry_id": "0267d97c-986f-3d36-aa29-ad3772f15c13",
                                        "glosses": [
                                            "Signifies that the action of the clause it starts takes place before the action of the other clause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b59af03-87e7-4e1e-89d3-3f3617d7342e",
                                                "sense_id": "3b712aef-a2b9-388e-b0d6-bdde334d4446",
                                                "text": "The show ends after the fat lady sings."
                                            },
                                            {
                                                "example_id": "15505e79-dc99-4cac-90aa-5422bb7c11a4",
                                                "sense_id": "3b712aef-a2b9-388e-b0d6-bdde334d4446",
                                                "text": "After we had decided to call it a day, I went home."
                                            },
                                            {
                                                "example_id": "63844f5c-4ade-4338-8be5-88d9eb475514",
                                                "sense_id": "3b712aef-a2b9-388e-b0d6-bdde334d4446",
                                                "text": "It is never possible to settle down to the ordinary routine of life at sea until the screw begins to revolve. There is an hour or two, after the passengers have embarked, which is disquieting and fussy."
                                            },
                                            {
                                                "example_id": "1c7ec203-fdf4-4ff3-80e2-88329caa1712",
                                                "sense_id": "3b712aef-a2b9-388e-b0d6-bdde334d4446",
                                                "text": "1991, Donald \"Shadow\" Rimgale (character), Robert DeNiro (actor), Backdraft\nSo you punched out a window for ventilation. Was that before or after you noticed you were standing in a lake of gasoline?"
                                            },
                                            {
                                                "example_id": "f0dcb34a-a79c-4823-a0d6-2dd043c5c318",
                                                "sense_id": "3b712aef-a2b9-388e-b0d6-bdde334d4446",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, […]. In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "after",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b068e173-48a4-3e3e-ba3b-76bccb5cea7b",
                                        "entry_id": "e11fbb3a-fc06-3833-b76b-aa4ce4c64be9",
                                        "glosses": [
                                            "Later; second (of two); next, following, subsequent"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0956c4f-fd4a-4db9-96a5-bc3123056cb6",
                                                "sense_id": "b068e173-48a4-3e3e-ba3b-76bccb5cea7b",
                                                "text": "I did verily believe in my own mind, that I couldn't fight in that way at all; but my after experience convinced me that this was all a notion."
                                            },
                                            {
                                                "example_id": "3d04252f-d305-43aa-a6ba-a948d89384c8",
                                                "sense_id": "b068e173-48a4-3e3e-ba3b-76bccb5cea7b",
                                                "text": "The amends he had made in after life were lost sight of in the dramatic glare of the original act."
                                            },
                                            {
                                                "example_id": "12b1ab2f-74e8-4483-8215-e5748083cd78",
                                                "sense_id": "b068e173-48a4-3e3e-ba3b-76bccb5cea7b",
                                                "text": "In the old days, […] he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […] and therefore my lack of detection of his promise may in some degree be pardoned. But he had then none of the oddities and mannerisms which I hold to be inseparable from genius, and which struck my attention in after days when I came in contact with the Celebrity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc16c451-beb8-3ad5-839a-8d432c17b5f4",
                                        "entry_id": "e11fbb3a-fc06-3833-b76b-aa4ce4c64be9",
                                        "glosses": [
                                            "At or towards the stern of a ship or the rear of an aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e393195-8ac1-4736-a3fb-110e3129053a",
                                                "sense_id": "cc16c451-beb8-3ad5-839a-8d432c17b5f4",
                                                "text": "Caspian led them down a ladder into the after hatch."
                                            },
                                            {
                                                "example_id": "79d467e0-1470-4da1-ab63-7db6d456de51",
                                                "sense_id": "cc16c451-beb8-3ad5-839a-8d432c17b5f4",
                                                "text": "The after gun is mounted aft."
                                            },
                                            {
                                                "example_id": "831133da-8819-4299-8ffc-bfb3433e1e47",
                                                "sense_id": "cc16c451-beb8-3ad5-839a-8d432c17b5f4",
                                                "text": "The after gun is abaft the forward gun."
                                            },
                                            {
                                                "example_id": "076773b1-cea0-41d8-85fb-7974041508f5",
                                                "sense_id": "cc16c451-beb8-3ad5-839a-8d432c17b5f4",
                                                "text": "The aircraft provided an after cabin for two radar operators."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "after",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c9ebf48-1398-3c1e-bcd5-b140593c1b04",
                                        "entry_id": "ef427abe-fa65-32b9-8a40-bdf4196d1b80",
                                        "glosses": [
                                            "Of before-and-after images: the one that shows the difference after a specified treatment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a25fc52-f2dd-4901-b2c1-2e86cefd756a",
                                                "sense_id": "8c9ebf48-1398-3c1e-bcd5-b140593c1b04",
                                                "text": "In the ‘before’ shots, she’ll look like an ordinary suburban housewife; but we know she acts in community theater musicals sometimes, so the ‘afters’ will give her a glamorous starlet image, starting with a very revealing bathing suit shot."
                                            },
                                            {
                                                "example_id": "b51abf15-a877-42ab-9195-766b03cfb155",
                                                "sense_id": "8c9ebf48-1398-3c1e-bcd5-b140593c1b04",
                                                "text": "Did any of the before pictures remind you of yourself, and did any of the afters show what you hoped your results might be?"
                                            },
                                            {
                                                "example_id": "a8e8aebe-b087-451e-991f-96db8a4ab8fe",
                                                "sense_id": "8c9ebf48-1398-3c1e-bcd5-b140593c1b04",
                                                "text": "So with that in mind, we thought it might be helpful to put some pictures where our mouths are, and include some less-than-flattering photos of our first house after we’d lived there eight whole months. Spoiler alert: We were miiiles away from the “afters” that we shared on pages 6 and 7."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6edb3108-20c9-4816-afaf-58acae62ab3c",
                        "source_entry_id": "9faff02b-63fe-3250-823c-417ebc92586a",
                        "source_sense_id": "4810d054-f4d6-33f6-bc62-d4be8b2d3022",
