                                "ru": "Многие наши продукты поступают <w>из</w>-за границы.",
                                "pl": "Wiele naszych produktów pochodzi <w>z</w> zagranicy.",
                                "de": "Viele unserer Produkte kommen <w>aus</w> dem Ausland.",
                                "fr": "Beaucoup de nos produits viennent <w>de</w> l'étranger.",
                                "it": "Molti dei nostri prodotti provengono <w>dall'</w>estero.",
                                "cs": "Mnoho našich produktů pochází <w>ze</w> zahraničí.",
                                "tr": "Ürünlerimizin çoğu yurt dışından <w>gelmektedir</w>.",
                                "es": "Muchos de nuestros productos <w>provienen</w> del extranjero.",
                                "zh": "我们的许多产品都是<w>从</w>国外进口的。"
                            }
