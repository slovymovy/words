{
    "word_family": [
        "onwards",
        "onwardness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2f867404-a7ca-39d7-a325-6b8500578325",
                    "sense_definition": "In a forward direction; forward in time or space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers decided to press <w>onward</w> despite the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Путешественники решили упорно двигаться <w>вперёд</w>, несмотря на проливной дождь."
                            }
                        },
                        {
                            "text": "We must look <w>onward</w> to the future and not dwell on past mistakes.",
                            "target_lang_translations": {
                                "ru": "Мы должны смотреть <w>вперёд</w>, в будущее, а не зацикливаться на прошлых ошибках."
                            }
                        }
                    ],
                    "synonyms": [
                        "onwards"
                    ],
                    "antonyms": [
                        "backward",
                        "backwards"
                    ],
                    "common_phrases": [
                        "press onward",
                        "march onward",
                        "move onward"
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении вперед; вперед во времени или пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "в направлении движения или в будущее"
                            },
                            {
                                "target_lang_word": "дальше",
                                "target_lang_sense_clarification": "продолжая движение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9e40a2e0-f7bf-32d7-8417-570008b46022",
                    "sense_definition": "Moving forward or continuing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was an <w>onward</w> rush of excited fans as soon as the gates opened.",
                            "target_lang_translations": {
                                "ru": "Как только ворота открылись, хлынул <w>стремительный</w> поток взволнованных фанатов."
                            }
                        },
                        {
                            "text": "The company's <w>onward</w> march toward success seemed unstoppable.",
                            "target_lang_translations": {
                                "ru": "<w>Поступательное</w> движение компании к успеху казалось неудержимым."
                            }
                        }
                    ],
                    "antonyms": [
                        "backward"
                    ],
                    "common_phrases": [
                        "onward movement",
                        "onward march",
                        "onward journey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся вперед или продолжающийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направленный вперёд",
                                "target_lang_sense_clarification": "о движении"
                            },
                            {
                                "target_lang_word": "поступательный",
                                "target_lang_sense_clarification": "о развитии или движении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f76691a-beaf-3393-a000-df1e1e54dc8c",
                    "sense_definition": "Advanced in a forward direction or toward an end.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was pleased to see how <w>onward</w> the preparations for the festival were.",
                            "target_lang_translations": {
                                "ru": "Он был рад видеть, насколько <w>продвинулись</w> приготовления к фестивалю."
                            }
                        },
                        {
                            "text": "The project is now in an <w>onward</w> state of development.",
                            "target_lang_translations": {
                                "ru": "Проект сейчас находится на <w>продвинутой</w> стадии разработки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продвинувшийся вперед или приближающийся к завершению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвинутый",
                                "target_lang_sense_clarification": "находящийся на поздней стадии"
                            },
                            {
                                "target_lang_word": "успешный",
                                "target_lang_sense_clarification": "о ходе подготовки или развития"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3cfc467-1d7b-3f7e-87db-f5d06ea2350b",
                    "sense_definition": "To pass something onward; to forward.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documents were received at the local office before being <w>onwarded</w> to the main headquarters.",
                            "target_lang_translations": {
                                "ru": "Документы были получены в местном офисе перед тем, как их <w>переслали</w> в главный штаб."
                            }
                        },
                        {
                            "text": "They took the damaged cargo and patched it up before <w>onwarding</w> it to the final destination.",
                            "target_lang_translations": {
                                "ru": "Они забрали поврежденный груз и подлатали его перед тем, как <w>отправить дальше</w> в конечный пункт назначения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать что-либо дальше; пересылать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересылать",
                                "target_lang_sense_clarification": "дальше по назначению"
                            },
                            {
                                "target_lang_word": "отправлять дальше",
                                "target_lang_sense_clarification": "перенаправлять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13d98553-7f07-30a8-80b8-0d067fbd953a",
                    "sense_definition": "To keep going; to progress or persevere.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small group of hikers <w>onwarded</w> directly up the steep mountain trail.",
                            "target_lang_translations": {
                                "ru": "Небольшая группа туристов <w>направилась</w> прямо вверх по крутой горной тропе."
                            }
                        },
                        {
                            "text": "Despite the difficulties, the team <w>onwarded</w> through the storm to reach safety.",
                            "target_lang_translations": {
                                "ru": "Несмотря на трудности, команда <w>продолжала идти</w> сквозь бурю, чтобы добраться до безопасного места."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать идти; продвигаться вперед или упорно продолжать путь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвигаться вперёд",
                                "target_lang_sense_clarification": "упорно продолжать путь"
                            },
                            {
                                "target_lang_word": "идти дальше",
                                "target_lang_sense_clarification": "несмотря на трудности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}