                                "sense_id": "417445b7-5dcf-3b54-8927-fec149d15b6f",
                                "text": "Meine Schwester war in der Schule immer weitaus besser als ich."
                            },
                            {
                                "example_id": "815702dd-80a0-4417-87ff-3cb68aa4fb5e",
                                "sense_id": "417445b7-5dcf-3b54-8927-fec149d15b6f",
                                "text": "Hagen ist der weitaus erfahrenste Bergführer, den wir haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
