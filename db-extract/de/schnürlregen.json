                        "examples": [
                            {
                                "example_id": "bad5cdd9-e891-423a-82bf-cf9e018b2876",
                                "sense_id": "6af31867-6446-34b3-90b7-b5a41f2984c1",
                                "text": "„Den Festzug-Teilnehmern in den Wägen fiel das Lächeln und Winken im Nieselregen nicht immer leicht, die Musikanten spielten oft mit klammen Händen. Immerhin: Als der Festzug der Wiesnwirte in die Leopoldstraße einbog, ließ der Schnürlregen ein wenig nach.“"
                            },
                            {
                                "example_id": "d6e718e6-c388-4d61-99fc-a296e210807b",
                                "sense_id": "6af31867-6446-34b3-90b7-b5a41f2984c1",
                                "text": "„Der riesige Park, an einem idyllischen See gelegen, lädt zum Flanieren ein, bei Schnürlregen begnügt man sich mit einer Mußestunde unter den Arkaden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
