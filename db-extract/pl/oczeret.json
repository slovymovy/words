                                        "entry_id": "11d037a4-421b-3d30-88a1-ba72daf8f9e2",
                                        "glosses": [
                                            "Any of a number of large freshwater sedges of western North America formerly classified in the genus Scirpus, but now mostly as Schoenoplectus"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a470ad17-42f3-47a0-bb0a-c9f1f7219d33",
                                                "sense_id": "bd9960a8-f038-3671-9850-ce0b4dd33a28",
                                                "text": "This consisted of a two-room house built of chittim poles, with no floor, a thatched roof of tules, and a windbreak of buffalo and cowhides to the north of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "217dcc30-5685-3dba-9ac5-0403b82533c1",
