                        "examples": [
                            {
                                "example_id": "94bdd12a-f3fe-4855-89e0-5e9f06a0fb6f",
                                "sense_id": "27f50a78-e3be-32b3-9663-3b846894f22a",
                                "text": "Ook Heerenveen heeft een relatie met een Chinese stad: de miljoenenstad Hefei. Chinese investeerders hebben inmiddels een meerderheidsaandeel in kindervoedingproducent Ausnutria verkregen. Het bedrijfscomplex in Heerenveen wordt nu in omvang verdubbeld."
                            },
                            {
                                "example_id": "de0cefed-ee87-4c83-828e-ed1f56cdd940",
                                "sense_id": "27f50a78-e3be-32b3-9663-3b846894f22a",
                                "text": "Volgens DPA is ook een bedrijfscomplex in de buurt van de stad Brjansk aangevallen. Die ligt op zo'n 80 kilometer van de grens met Oekraïne. Wat daar gebeurt is staatsgeheim, schrijft DPA. Het doelwit was een brandstofreservoir dat leeg zou hebben gestaan."
                            }
