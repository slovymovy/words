                "senses": [
                    {
                        "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                        "entry_id": "f5a262a9-217a-3030-8258-634870d7c7e7",
                        "glosses": [
                            "Angehöriger der englischen Kirche oder einer ihrer Tochterkirchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9fe8c1c-bf3d-4de8-a113-2fdaf9c4885d",
                                "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                                "text": "Sein Großvater war Anglikaner."
                            },
                            {
                                "example_id": "e727a68d-6f77-42b5-bb32-7e377115dcff",
                                "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                                "text": "„In Großbritannien stehen rund sechs Millionen Katholiken etwa 25 Millionen Anglikanern gegenüber.“"
                            },
                            {
                                "example_id": "1bb10305-ec0a-4824-a836-841bc32156fd",
                                "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                                "text": "„Die eine geriet 1948 mit ihrem Liebhaber Peter Fitzwilliam in einen Gewittersturm, nachdem sie den Zorn ihrer tiefkatholischen Mutter heraufbeschworen hatte, indem sie einen Anglikaner geheiratet hatte; der andere starb 1944, als sein Bomber auf dem Weg zu einer heroischen, selbstmörderischen Geheimmission über England explodierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
