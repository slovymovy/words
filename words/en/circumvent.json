{
    "word_family": [
        "circumvention",
        "circumventor",
        "circumventive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1a20e85-e0fa-3130-ba16-6bcf0e9c2524",
                    "sense_definition": "to avoid or get around something, such as a rule or an obstacle, often by using cleverness",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new road was built to <w>circumvent</w> the town and reduce heavy traffic in the center.",
                            "target_lang_translations": {
                                "ru": "Новая дорога была построена, чтобы <w>обойти</w> город и уменьшить интенсивное движение в центре."
                            }
                        },
                        {
                            "text": "Some companies try to <w>circumvent</w> tax laws by moving their headquarters to other countries.",
                            "target_lang_translations": {
                                "ru": "Некоторые компании пытаются <w>обходить</w> налоговое законодательство, перенося свои штаб-квартиры в другие страны."
                            }
                        }
                    ],
                    "synonyms": [
                        "bypass",
                        "evade",
                        "sidestep",
                        "skirt"
                    ],
                    "antonyms": [
                        "confront",
                        "follow",
                        "obey"
                    ],
                    "common_phrases": [
                        "circumvent the law",
                        "circumvent the problem",
                        "circumvent the rules"
                    ],
                    "target_lang_definitions": {
                        "ru": "избегать или обходить что-либо (например, правило или препятствие), часто проявляя хитрость или находчивость"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обходить",
                                "target_lang_sense_clarification": "закон, правила или препятствие"
                            },
                            {
                                "target_lang_word": "обойти",
                                "target_lang_sense_clarification": "совершить действие по обходу препятствия или закона"
                            },
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "от соблюдения правил или налогов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d94a60ff-170f-37c0-b4c1-fe28113ca6d5",
                    "sense_definition": "to outwit or outsmart someone by being more clever or deceptive",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy managed to <w>circumvent</w> his pursuers by changing his disguise in the crowded market.",
                            "target_lang_translations": {
                                "ru": "Шпиону удалось <w>обхитрить</w> своих преследователей, сменив маскировку на многолюдном рынке."
                            }
                        },
                        {
                            "text": "He felt a sense of triumph in <w>circumventing</w> those who doubted his intelligence.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал триумф, <w>обведя вокруг пальца</w> тех, кто сомневался в его способностях."
                            }
                        }
                    ],
                    "synonyms": [
                        "outwit",
                        "outsmart",
                        "overreach"
                    ],
                    "target_lang_definitions": {
                        "ru": "перехитрить или оставить в дураках кого-либо, будучи более умным или коварным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обхитрить",
                                "target_lang_sense_clarification": "оказаться умнее противника"
                            },
                            {
                                "target_lang_word": "обойти",
                                "target_lang_sense_clarification": "превзойти кого-либо в хитрости"
                            },
                            {
                                "target_lang_word": "перехитрить",
                                "target_lang_sense_clarification": "добиться успеха за счет смекалки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abb1d5a3-4947-3aa9-a14e-65871de8e9a4",
                    "sense_definition": "to surround or besiege an area or a group of people",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army moved quickly to <w>circumvent</w> the enemy fortress and cut off their supplies.",
                            "target_lang_translations": {
                                "ru": "Армия действовала быстро, чтобы <w>окружить</w> вражескую крепость и отрезать их от снабжения."
                            }
                        },
                        {
                            "text": "In ancient warfare, the goal was often to <w>circumvent</w> the city walls entirely.",
                            "target_lang_translations": {
                                "ru": "В войнах древности целью часто было полностью <w>обойти</w> городские стены."
                            }
                        }
                    ],
                    "synonyms": [
                        "encircle",
                        "besiege",
                        "encompass"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "окружать или осаждать территорию или группу людей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "брать в кольцо"
                            },
                            {
                                "target_lang_word": "обойти",
                                "target_lang_sense_clarification": "совершить маневр по окружению с флангов"
                            },
                            {
                                "target_lang_word": "оцеплять",
                                "target_lang_sense_clarification": "создавать преграду вокруг чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}