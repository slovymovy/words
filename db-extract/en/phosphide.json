    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0ca06424-9645-3eb2-8bb2-f90cc5e147a4",
                "word": "phosphide",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3c33f88b-2e78-4bae-bac1-d3329791f8b2",
                        "entry_id": "0ca06424-9645-3eb2-8bb2-f90cc5e147a4",
                        "tags": [
                            "plural"
                        ],
                        "form": "phosphides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79884889-2f28-3417-8763-d47bd3381088",
                        "entry_id": "0ca06424-9645-3eb2-8bb2-f90cc5e147a4",
                        "glosses": [
                            "Any binary compound of phosphorus, especially one in oxidation state −3."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "937cc8f2-3e95-4b7c-a105-ad4744fa7200",
                                "sense_id": "79884889-2f28-3417-8763-d47bd3381088",
                                "text": "The new fulminate consists of a mixture of chlorate of potash, with the prussiates, soluble or unsoluble, the hyposulphites, the hypophosphites, the phosphides, the amorphous phosphorus, alone or combined."
                            },
                            {
                                "example_id": "51bbd72b-eb5d-4e0b-a9eb-8ee834ab9266",
                                "sense_id": "79884889-2f28-3417-8763-d47bd3381088",
                                "text": "These two metals were then melted in magnesia crucibles and cooled slowly, in order to find how much phosphide would separate during solidification."
                            },
                            {
                                "example_id": "aa8b25b4-b394-4624-933c-5dc51f3e18d3",
                                "sense_id": "79884889-2f28-3417-8763-d47bd3381088",
                                "text": "Colani (1907b) prepared uranium arsenide and antimonide by methods similar to the one he used for the preparation of phosphide."
                            },
                            {
                                "example_id": "6c59201e-15ec-4054-9e59-05642f20d291",
                                "sense_id": "79884889-2f28-3417-8763-d47bd3381088",
                                "text": "So you took the bottle of phosphide and you poured a good dose into your sister’s cup."
                            },
                            {
                                "example_id": "01457fba-2ad1-4a3a-bfbe-3d1377ee9b71",
                                "sense_id": "79884889-2f28-3417-8763-d47bd3381088",
                                "text": "On the other hand, too much phosphide may render the iron brittle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7339145d-e2b9-4a90-9c2a-ea035fe8d6b5",
                        "source_entry_id": "0ca06424-9645-3eb2-8bb2-f90cc5e147a4",
                        "source_sense_id": "79884889-2f28-3417-8763-d47bd3381088",
                        "source_sense_description": "binary compound of phosphorus",
                        "target_lang_word": "phosphure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
