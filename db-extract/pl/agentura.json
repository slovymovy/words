                ],
                "senses": [
                    {
                        "sense_id": "6d53456c-849e-3700-9623-874260a8b7e5",
                        "entry_id": "a0046533-48f7-35b6-9c1a-9458cba4fe59",
                        "glosses": [
                            "część wywiadu złożona z kilku agentów na terytorium innego państwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7018870f-a444-4c38-ac90-9bdc9c5d3215",
                                "sense_id": "6d53456c-849e-3700-9623-874260a8b7e5",
                                "text": "W związku z tym postawiono przed oddziałami operacyjnymi wywiadu wojskowego zadanie sformułowania koncepcji utrzymania bezpiecznej łączności między centralą a agenturą działającą w krajach zachodnich"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "140cd99c-dffc-3790-a166-ca9da3eecb44",
                        "entry_id": "a0046533-48f7-35b6-9c1a-9458cba4fe59",
                        "glosses": [
                            "przedstawicielstwo rządu, organizacji lub przedsiębiorstwa na obcym terenie, poza siedzibą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0738cd1c-d67f-4ecc-a595-8ddfa21e6868",
                                "sense_id": "140cd99c-dffc-3790-a166-ca9da3eecb44",
                                "text": "U diabła, na dziesięciu spotkanych na ulicy sześciu jest świeżo przybyłych i zakładających agentury, a dziewięciu chcących zrobić miliony"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "718d5851-ebf9-49ed-a9e2-702321f47d8a",
                        "source_entry_id": "a0046533-48f7-35b6-9c1a-9458cba4fe59",
                        "source_sense_id": "6d53456c-849e-3700-9623-874260a8b7e5",
                        "target_lang_word": "Agentur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agentur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5631172e-d35d-392f-9ca0-3e24c89f070a",
                                        "entry_id": "8fb2d451-e90d-3e8b-8815-1cf59699230d",
                                        "glosses": [
                                            "Büro, das Vermittlungsdienstleistungen erbringt oder die Interessenvertretung für seine Kunden übernimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46758814-dfe7-4140-8e59-74aea5bbef61",
                                                "sense_id": "5631172e-d35d-392f-9ca0-3e24c89f070a",
                                                "text": "„Draußen auf der Straße ging der Buchbinder vorüber, der neben seinem Geschäft im Dorf auch die Agentur der Lebens- und Feuerversicherung führte.“"
                                            },
                                            {
                                                "example_id": "31d73787-5023-4423-ae44-ddf56cef1f4d",
                                                "sense_id": "5631172e-d35d-392f-9ca0-3e24c89f070a",
                                                "text": "„Vor Weihnachten hatte ich jemanden besorgt, der für mich bei den Agenturen einsprang, und hatte Hadley geschrieben, sie solle kommen, dann könnten wir über die Feiertage zusammen Ski laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fc45c4b-81dd-3cca-9aa6-882f09648d84",
                                        "entry_id": "8fb2d451-e90d-3e8b-8815-1cf59699230d",
                                        "glosses": [
                                            "Nachrichten- oder Presseagentur"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781ae3b3-3db8-42bc-965f-895b8e1fa010",
                                                "sense_id": "3fc45c4b-81dd-3cca-9aa6-882f09648d84",
                                                "text": "Verschiedene Agenturen brachten zeitgleich die Meldung über den Rücktritt des Ministerpräsidenten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "56ef87d1-83aa-3bfc-9d90-b6c5cb6684de",
                                        "entry_id": "8fb2d451-e90d-3e8b-8815-1cf59699230d",
                                        "glosses": [
                                            "Bundesanstalt oder eine ihrer Filialen"
                                        ],
                                        "tags": [
                                            "seit etwa 2000 in Deutschland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c374617b-60e7-4ed1-b707-f416ab53e597",
                                                "sense_id": "56ef87d1-83aa-3bfc-9d90-b6c5cb6684de",
                                                "text": "Was früher anschaulich „Bundesschuldenverwaltung“ hieß, wurde zunächst in den Euphemismus „Bundeswertpapierverwaltung“ umbenannt und wird jetzt in der „Bundesrepublik Deutschland Finanzagentur GmbH“ mit erledigt."
                                            },
                                            {
                                                "example_id": "3f7fbddf-0d54-4fa2-904c-e923e216a762",
                                                "sense_id": "56ef87d1-83aa-3bfc-9d90-b6c5cb6684de",
                                                "text": "„In Neuköllner und Reinickendorfer Arbeitsagenturen haben Hartz-IV-Empfänger die Möglichkeit, das Geld per Chipkarte an Kassenautomaten in den Agenturen zu ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
