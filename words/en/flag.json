{
    "word_family": [
        "flagpole",
        "flagship",
        "flagstone",
        "unflagging"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33708aea-f158-3fa4-b419-43f4bdfeab18",
                    "sense_definition": "A piece of cloth, often decorated with an emblem or specific colors, used as a visual signal, symbol of a country, or decoration.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sem_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national <w>flag</w> was flying high above the government building.",
                            "target_lang_translations": {
                                "zh": "国<w>旗</w>在政府大楼上方高高飘扬。"
                            }
                        },
                        {
                            "text": "She waved a small white <w>flag</w> to show that she surrendered.",
                            "target_lang_translations": {
                                "zh": "她挥动了一面小白<w>旗</w>以示投降。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "national flag",
                        "white flag",
                        "raise the flag",
                        "flag pole"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种带有图案或特定颜色的布，用作视觉信号、国家象征或装饰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "旗帜",
                                "target_lang_sense_clarification": "指代旗帜的正式名称"
                            },
                            {
                                "target_lang_word": "旗子",
                                "target_lang_sense_clarification": "指代旗帜的通用口语名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5de899-5eda-3d9c-b480-5cd7669506e6",
                    "sense_definition": "A variable or marker in a computer system that indicates a specific status, condition, or option (often true or false).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer set a <w>flag</w> to indicate that the process was complete.",
                            "target_lang_translations": {
                                "zh": "程序员设置了一个<w>标志</w>来表明进程已完成。"
                            }
                        },
                        {
                            "text": "If the error <w>flag</w> is active, the software will not save the file.",
                            "target_lang_translations": {
                                "zh": "如果错误<w>标志</w>被激活，软件将不会保存文件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Boolean",
                        "switch",
                        "option"
                    ],
                    "common_phrases": [
                        "set a flag",
                        "feature flag",
                        "red flag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "计算机系统中用于指示特定状态、条件或选项的变量或标记。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "标志",
                                "target_lang_sense_clarification": "计算机编程中用于状态判断的标记"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a10af04-10b3-3c33-a45b-4d4d2dec1b3a",
                    "sense_definition": "A flat slab of stone used for paving; a flagstone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sem_stone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked across the cold stone <w>flags</w> of the castle courtyard.",
                            "target_lang_translations": {
                                "zh": "我们走过城堡庭院里冰冷的<w>石板</w>。"
                            }
                        },
                        {
                            "text": "The gardener replaced a broken <w>flag</w> on the patio path.",
                            "target_lang_translations": {
                                "zh": "园丁更换了露台小径上一块破损的<w>石板</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "paving flag",
                        "stone flag"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于铺路的扁平石板。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "石板",
                                "target_lang_sense_clarification": "铺路用的扁平石块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3743de18-20c5-3dfb-a35f-8b47a6bf7531",
                    "sense_definition": "A plant with long, sword-shaped leaves, such as an iris, that typically grows in wet places.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sem_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild <w>flag</w> grows abundantly near the river bank.",
                            "target_lang_translations": {
                                "zh": "野生的<w>鸢尾</w>在河岸边生长得非常茂盛。"
                            }
                        },
                        {
                            "text": "She planted a beautiful purple <w>flag</w> in her water garden.",
                            "target_lang_translations": {
                                "zh": "她在水景花园里种了一株美丽的紫色<w>鸢尾</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "yellow flag",
                        "blue flag"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种叶片细长如剑的植物，如鸢尾，通常生长在潮湿的地方。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸢尾",
                                "target_lang_sense_clarification": "指代鸢尾属植物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a812d4e8-12df-3bdb-95a9-fcdfad5198db",
                    "sense_definition": "To mark or identify something for attention, treatment, or a specific purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sem_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system will <w>flag</w> any suspicious activity on your bank account.",
                            "target_lang_translations": {
                                "zh": "系统会自动<w>标记</w>您银行账户中的任何可疑活动。"
                            }
                        },
                        {
                            "text": "I need to <w>flag</w> this email so I remember to reply to it later.",
                            "target_lang_translations": {
                                "zh": "我需要<w>标记</w>这封邮件，以便稍后记得回复。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flag for review",
                        "flag as inappropriate",
                        "flag an issue"
                    ],
                    "target_lang_definitions": {
                        "zh": "为了引起注意、进行处理或特定目的而对某事进行标记。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "标记",
                                "target_lang_sense_clarification": "对某项内容进行标注以便后续处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d85b40d-8752-34d3-9b96-a7c4bedd9b8a",
                    "sense_definition": "To signal to a vehicle or person to stop, usually by waving one's arm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We tried to <w>flag</w> down a passing car to get help with the flat tire.",
                            "target_lang_translations": {
                                "zh": "我们试图<w>招手</w>拦下一辆过往车辆，以寻求帮助处理爆胎。"
                            }
                        },
                        {
                            "text": "It took twenty minutes to <w>flag</w> a taxi in the heavy rain.",
                            "target_lang_translations": {
                                "zh": "在大雨中，我们花了二十分钟才<w>招手</w>拦到一辆出租车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flag down",
                        "flag a taxi"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过挥动手臂等方式示意车辆或行人停下。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "招手",
                                "target_lang_sense_clarification": "示意车辆停下的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cbc8ced-9ca7-33d8-93c1-27cba9ca72ac",
                    "sense_definition": "To become tired, weak, or less enthusiastic; to lose energy or vigor.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her energy began to <w>flag</w> after running for ten miles.",
                            "target_lang_translations": {
                                "zh": "跑了十英里后，她的体力开始<w>衰退</w>。"
                            }
                        },
                        {
                            "text": "The conversation started to <w>flag</w> as the night went on.",
                            "target_lang_translations": {
                                "zh": "随着夜色渐深，谈话开始变得<w>减弱</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interest flagged",
                        "energy flagged",
                        "spirits flagged"
                    ],
                    "target_lang_definitions": {
                        "zh": "变得疲惫、虚弱或热情减退；失去活力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "衰退",
                                "target_lang_sense_clarification": "指精力或兴趣逐渐减弱"
                            },
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指活力或势头下降"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e70ecc54-8e1d-3fed-a121-14233f011f5c",
                    "sense_definition": "To penalize a player for breaking the rules in a game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sem_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee <w>flagged</w> the defender for unsportsmanlike conduct.",
                            "target_lang_translations": {
                                "zh": "裁判因防守队员的不道德行为对其进行了<w>判罚</w>。"
                            }
                        },
                        {
                            "text": "He was <w>flagged</w> immediately after the illegal tackle.",
                            "target_lang_translations": {
                                "zh": "他在那次非法擒抱后立即受到了<w>判罚</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flagged for holding",
                        "flagged for foul"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在比赛中因违规而对球员进行处罚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "判罚",
                                "target_lang_sense_clarification": "体育比赛中对违规行为的裁定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6235aecd-c170-3ed6-b113-e9f33ca16fff",
                    "sense_definition": "To cover a surface with flat stones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sem_stone_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They plan to <w>flag</w> the garden path before summer arrives.",
                            "target_lang_translations": {
                                "zh": "他们计划在夏天到来之前用石板<w>铺设</w>花园小径。"
                            }
                        },
                        {
                            "text": "The workers <w>flagged</w> the entire courtyard in just two days.",
                            "target_lang_translations": {
                                "zh": "工人们仅用了两天时间就用石板<w>铺设</w>了整个庭院。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用扁平的石板覆盖地面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "铺设",
                                "target_lang_sense_clarification": "用石板铺地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}