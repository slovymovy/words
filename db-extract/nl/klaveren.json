                                            "Orden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce2f4794-a21e-4144-ba45-07a4f2f0f951",
                                                "sense_id": "669d707b-3777-34d1-bcf4-2a38775f591f",
                                                "text": "Auch seinem Bruder wurde posthum das Kreuz verliehen."
                                            },
                                            {
                                                "example_id": "8d7be443-7d42-459a-99ab-34b2ebe277a8",
                                                "sense_id": "669d707b-3777-34d1-bcf4-2a38775f591f",
                                                "text": "„Endlich befreite sie ein Herr, der das Kreuz der Ehrenlegion trug; und nachdem sie ihre Namen, Vornamen und Wohnort angegeben hatten, zogen sie ab mit dem Versprechen, in Zukunft vorsichtiger zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "506822aa-5a66-3e9c-a922-08ecd3a66ac6",
                                        "entry_id": "f61d8fd2-04b0-3c65-a3fd-9653af4d7b3e",
                                        "glosses": [
