                "senses": [
                    {
                        "sense_id": "ba41db12-c48f-32c0-9578-0d19baa7d4de",
                        "entry_id": "f9885d0a-04d1-36d6-82b3-6506c5a81c7d",
                        "glosses": [
                            "Material for making scarves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66948f07-a30e-4cc6-9200-2b9d353c2b9a",
                                "sense_id": "ba41db12-c48f-32c0-9578-0d19baa7d4de",
                                "text": "The Ascot scarfs may be arranged in regularity as shown, or they may each be displayed differently so as to bring out the colorings and designs in the scarfings."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2a6f31e-27c7-3f3d-b7f9-e2638e6e96a9",
                        "entry_id": "f9885d0a-04d1-36d6-82b3-6506c5a81c7d",
                        "glosses": [
                            "A scarf joint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10dc9f87-24ef-4cbc-89f0-9c15e11129d2",
                                "sense_id": "a2a6f31e-27c7-3f3d-b7f9-e2638e6e96a9",
                                "text": "The scarfings of the piece must be kept clear of each other (that is, the points of junction in one piece must be as far as possible from those in another piece), and equally distributed in the mast."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5ba922b-bd99-3862-b905-f67e03a9fa68",
                        "entry_id": "f9885d0a-04d1-36d6-82b3-6506c5a81c7d",
                        "glosses": [
                            "A scarf; a covering."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e3365c96-c7f7-41c7-b1c2-f3429ebd83a5",
                                "sense_id": "f5ba922b-bd99-3862-b905-f67e03a9fa68",
                                "text": "Mais personne ne lui répondit. Il se leva anxieux et entra dans l’appartement, qu’il trouva vide et silencieux, et où les voiles de Zoumourroud et ses écharpes gisaient sur le sol."
                            },
                            {
                                "example_id": "99446bf0-26d9-4543-8933-9dffeb3bc236",
                                "sense_id": "f5ba922b-bd99-3862-b905-f67e03a9fa68",
                                "text": "High on the deck, under the cream-coloured sail and the flutter of pink scarfings and flags, stands Ulysses waving a defiant torch at Polyphemus, who, colossal through mist, claws at his wound, himself tall as a pyramid and vast as an Alp."
                            },
                            {
                                "example_id": "92b4b294-94b0-46b9-b8cd-ef7b746994aa",
                                "sense_id": "f5ba922b-bd99-3862-b905-f67e03a9fa68",
                                "text": "He asked her to remove her scarfing, her neck-a-tee and her mauve pelerine."
                            }
                        ]
                    }
                ],
