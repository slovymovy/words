                "entry_id": "ddde0781-77cd-3e06-ad59-13b819bfb1f7",
                "word": "kipkap",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "543ee842-9dc8-3233-ae9a-a1cac4d54b66",
                        "entry_id": "ddde0781-77cd-3e06-ad59-13b819bfb1f7",
                        "glosses": [
                            "haksel van meestal varkensvlees, maar ook van andere dieren, van voornamelijk de kop, staart en de oren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a6c756-f2d7-4d36-ac89-a6e3bb08ec56",
                                "sense_id": "543ee842-9dc8-3233-ae9a-a1cac4d54b66",
                                "text": "Er bestaan tal van varianten, ook in de benaming: hoofdvlees of preskop (Vlaanderen), kopvlees (informeler), frut, zure zult, varkenskop, kipkap (Zuid-Limburg), geperste kop, postekop (Zeeuws), huré, of uufflakke (Gents)."
                            },
                            {
                                "example_id": "13d939bb-16f5-4f0f-a9da-b611832b7bd0",
                                "sense_id": "543ee842-9dc8-3233-ae9a-a1cac4d54b66",
                                "text": "In het kader van de campagne 'Tafelen in Nederland' serveren deze maand restaurants en instellingen in het hele land Noordbrabantse gerechten. Op de kaart staan onder meer Kipkap, Zevenbergse kabeljauw met potjebraaiers en Bredase turfjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "30f4a0b5-ec6e-35ca-a5f0-3a792b719011",
                        "entry_id": "ddde0781-77cd-3e06-ad59-13b819bfb1f7",
                        "glosses": [
                            "onsamenhangend gepraat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53739872-73ec-4a0b-b70d-a43bafaeefad",
                                "sense_id": "30f4a0b5-ec6e-35ca-a5f0-3a792b719011",
                                "text": "mikmak is kipkap, mengeling van suikerkoekskens; onnoozele praat; duistere boel;"
                            }
                        ]
                    }
                ],
