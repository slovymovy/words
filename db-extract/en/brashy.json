                "senses": [
                    {
                        "sense_id": "1d07d58f-1de3-3abe-9a08-fddf6a88e0ca",
                        "entry_id": "57901264-90e5-34b3-ae3d-acdd6dceea5e",
                        "glosses": [
                            "brash, stormy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c43264-93ee-44ff-9acc-bfb3a599931d",
                                "sense_id": "1d07d58f-1de3-3abe-9a08-fddf6a88e0ca",
                                "text": "Several skuas seen--three seals up in our Bay--several off Pram Point in the shelter of Horse Shoe Bay. A great many fish on sea ice--mostly small, but a second species 5 or 6 inches long: imagine they are chased by seals and caught in brashy ice where they are unable to escape."
                            },
                            {
                                "example_id": "6be12a81-6cd4-4521-aa20-0bda24e758bd",
                                "sense_id": "1d07d58f-1de3-3abe-9a08-fddf6a88e0ca",
                                "text": "The sea was little encumbered with ice, it being now late in June, so that our progress was not at all impeded by the few soft, brashy floes that we encountered, none of them hard enough to do a ship's hull any damage."
                            }
                        ]
                    },
                    {
                        "sense_id": "932f321b-d6b4-3f4c-963b-7681d336841a",
                        "entry_id": "57901264-90e5-34b3-ae3d-acdd6dceea5e",
                        "glosses": [
                            "brittle, crumbly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd657b48-b158-4da3-96e0-6834040691ab",
                                "sense_id": "932f321b-d6b4-3f4c-963b-7681d336841a",
                                "text": "It was after noon, for the sun was past the meridian, and very hot for the time of year, when the face of the country began to change; and instead of the short sward of the open down, sprinkled with tiny white snail-shells, the ground was brashy with flat stones, and divided up into tillage fields."
                            },
                            {
                                "example_id": "320e7845-9d06-4811-8647-64f39a10ac3a",
                                "sense_id": "932f321b-d6b4-3f4c-963b-7681d336841a",
                                "text": "On either side the cliffs rose higher, and the walls of Jurassic rock, above the brashy steeps, more towering, precipitous, and fantastic."
                            }
                        ]
                    }
                ],
