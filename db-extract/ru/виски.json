                                        "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                        "entry_id": "ef831678-7c7b-3274-bae1-31b1ecb7bba5",
                                        "glosses": [
                                            "alkoholisches Getränk, das aus Gerste oder Malz durch Fermentierung und Destillation gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "274da876-22ee-416c-9677-d019c6447563",
                                                "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                                "text": "Ein Glas Whisky, bitte!"
                                            },
                                            {
                                                "example_id": "7efbb84c-5330-4d42-8060-2a0bf08b5909",
                                                "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                                "text": "„Lady Death bekam ihren Whisky, kippte ihn und wandte sich an Céline.“"
                                            },
                                            {
                                                "example_id": "51ac2d4a-8476-4ce7-94aa-e619031a7443",
                                                "sense_id": "0d6f2ae7-3452-33d7-9861-2d8eb7d99e70",
                                                "text": "„Der eine trank Whisky, der andere aß Eis mit Schlagsahne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ffd72f6-660d-4e93-8afb-9d242b9e958d",
                        "source_entry_id": "a9aaa70b-55fc-3507-bad4-0a4e33ca052d",
                        "source_sense_id": "4ba3fcc8-4d97-3fb4-a9c7-dd714f38c4bd",
                        "target_lang_word": "whisky",
