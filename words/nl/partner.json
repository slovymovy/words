                    "sense_id": "a9de0634-6f6f-3d5e-9ffe-687af698f269",
                    "sense_definition": "Iemand met wie men een vaste romantische relatie heeft of getrouwd is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>partner</w> en ik gaan volgend jaar samenwonen.",
                            "target_lang_translations": {
                                "en": "My <w>partner</w> and I are moving in together next year.",
                                "ru": "Мой <w>партнёр</w> и я собираемся жить вместе в следующем году.",
                                "pl": "Mój <w>partner</w> i ja zamieszkamy razem w przyszłym roku.",
                                "de": "Mein <w>Partner</w> und ich ziehen nächstes Jahr zusammen.",
                                "fr": "Mon <w>partenaire</w> et moi allons emménager ensemble l'année prochaine.",
                                "it": "Il mio <w>partner</w> e io andremo a convivere l'anno prossimo.",
                                "cs": "Můj <w>partner</w> a já budeme příští rok bydlet spolu.",
                                "tr": "<w>Partnerim</w> ve ben önümüzdeki yıl birlikte yaşamaya başlayacağız.",
                                "es": "Mi <w>pareja</w> y yo nos vamos a vivir juntos el año que viene."
                            }
                        },
                        {
                            "text": "Zij stelde haar nieuwe <w>partner</w> voor aan de familie.",
                            "target_lang_translations": {
                                "en": "She introduced her new <w>partner</w> to the family.",
                                "ru": "Она представила своего нового <w>партнёра</w> семье.",
                                "pl": "Przedstawiła rodzinie swojego nowego <w>partnera</w>.",
                                "de": "Sie stellte der Familie ihren neuen <w>Partner</w> vor.",
                                "fr": "Elle a présenté son nouveau <w>compagnon</w> à la famille.",
                                "it": "Ha presentato il suo nuovo <w>compagno</w> alla famiglia.",
                                "cs": "Představila rodině svého nového <w>partnera</w>.",
                                "tr": "Yeni <w>partnerini</w> ailesiyle tanıştırdı.",
                                "es": "Ella presentó a su nueva <w>pareja</w> a la familia."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vaste partner",
                        "mijn partner"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone with whom one has a steady romantic relationship or is married to",
                        "ru": "Человек, с которым состоят в постоянных романтических отношениях или браке",
                        "pl": "Osoba, z którą jest się w stałym związku romantycznym lub małżeństwie",
                        "de": "Jemand, mit dem man eine feste romantische Beziehung hat oder verheiratet ist",
                        "fr": "Quelqu'un avec qui l'on a une relation amoureuse stable ou avec qui l'on est marié",
                        "it": "Qualcuno con cui si ha una relazione romantica stabile o con cui si è sposati",
                        "cs": "Někdo, s kým má člověk trvalý romantický vztah nebo s kým je ženatý/vdaná",
                        "tr": "Kişinin düzenli bir romantik ilişkisi olduğu veya evli olduğu kimse",
                        "es": "Persona con la que se tiene una relación romántica estable o con la que se está casado."
