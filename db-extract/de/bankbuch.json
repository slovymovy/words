                "senses": [
                    {
                        "sense_id": "40b71fae-99fa-3d7b-a95e-876ec0db812d",
                        "entry_id": "b92b7b70-0e75-3c0e-a784-018f67f69f3e",
                        "glosses": [
                            "Auflistung der Finanztransaktionen eines Geldinstituts, mit denen nicht die Absicht eines Handelsgewinns verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab02dfa-415b-48a4-9050-6e7caaf9cdba",
                                "sense_id": "40b71fae-99fa-3d7b-a95e-876ec0db812d",
                                "text": "„Aber europäische Staatsanleihen, die bis zur Endfälligkeit und damit im Bankbuch gehalten werden, bleiben außen vor.“"
                            },
                            {
                                "example_id": "249dc5df-93ce-4aea-bbf3-70e5af799393",
                                "sense_id": "40b71fae-99fa-3d7b-a95e-876ec0db812d",
                                "text": "„Diese Banken waren ursprünglich reine Girobanken, sie beruhten darauf, daß eine Anzahl bedeutender Unternehmer erhebliche Summen bar in den Kellern der Bank deponierten, worüber ihnen ein Folium in dem Bankbuche eröffnet wurde, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
