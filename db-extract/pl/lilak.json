                                        "glosses": [
                                            "stark duftender Blütenstrauch aus der Familie der Ölbaumgewächse: Syringa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269a7d78-8f84-4192-8de5-d73e67643c6b",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "In unserem Garten steht ein großer, lilafarbener Flieder."
                                            },
                                            {
                                                "example_id": "60d1a53e-b024-4204-a78a-b5d100a214e0",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "„An einem Bach stand eine verfallene Mühle, von blühendem Flieder umgeben.“"
                                            },
                                            {
                                                "example_id": "0545831d-f254-45ac-83bc-4f08b5834e69",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "„Als sie die große Parkwiese zweimal umschritten hatten, war Cécile müde geworden und nahm auf einer von Flieder und Goldregen überwachsenen Bank PLatz, die zum großen Teil im Schatten lag.“"
                                            },
                                            {
                                                "example_id": "89f4c8a3-d4bc-4ee3-8d06-36f2f1819b1e",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "„Clerfayt sah eine Vase mit weißem Flieder und einen langen Zweig flacher, weißer Orchideen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0210c72c-25c2-3f35-9867-685c3bef3f42",
