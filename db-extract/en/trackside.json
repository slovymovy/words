                                "example_id": "01bd48f1-5406-4016-9b0c-26ce0e75a8c3",
                                "sense_id": "346c92e4-f8af-385b-9ee3-1b97004b8b7a",
                                "text": "Many workers were killed as they squeezed into a trackside niche or the narrow space between tracks to get out of the way of an oncoming train […]"
                            },
                            {
                                "example_id": "2cb66282-8904-4f98-9f60-dc2e013a0f7f",
                                "sense_id": "346c92e4-f8af-385b-9ee3-1b97004b8b7a",
                                "text": "Over the past two years, particularly in 2018, Network Rail has come under fire about its approaches to trackside tree-felling across its 52,000-hectare estate. Conservationists accused it of wanton destruction."
                            }
                        ]
