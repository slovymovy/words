                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c23f36b-c92a-44a8-af35-4dcdd8f9cdeb",
                                "sense_id": "dd9c46fc-aa62-3f76-a3a1-fd48c8742051",
                                "text": "Naczelny wódz zwrócił się z odezwą do szeregowych żołnierzy."
