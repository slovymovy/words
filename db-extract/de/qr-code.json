                        ],
                        "form": "den QR-Code"
                    },
                    {
                        "form_id": "30495866-8ac2-4e7a-a431-3ab73064e962",
                        "entry_id": "9cd2d92b-fc85-33d2-9916-02bc5ea5bd9a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die QR-Codes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                        "entry_id": "9cd2d92b-fc85-33d2-9916-02bc5ea5bd9a",
                        "glosses": [
                            "ein Muster von schwarz-weißen Quadraten, das auf etwas gedruckt oder auf einem Display dargestellt wird und von einem Smartphone gelesen werden kann, um dem Benutzer Informationen zur Verfügung zu stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31582f70-aba5-48f0-8ae0-6dc6a351608e",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„QR-Codes können etwa 7.000 Ziffern oder rund 4.000 Zeichen speichern, einschließlich Satz- und Sonderzeichen.“"
                            },
                            {
                                "example_id": "9d609c66-c4c2-496b-b477-688c7a5bd830",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„Viele neuere Smartphone-Modelle können auch ohne eine externe App QR-Codes scannen. Dies geht ganz einfach mit der Kamera.“"
                            },
                            {
                                "example_id": "a00b64d9-3219-4042-a9a1-77ea1bf61948",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„Der 1994 erfundene QR-Code wurde zunächst zur Verfolgung von Fahrzeugen und Fahrzeug-Teilen im Fertigungsprozess verwendet.“"
                            },
                            {
                                "example_id": "80f333bb-55ce-467b-ac71-74c718f312ce",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„Das QR-Codes sich recht robust gegenüber Zerstörungen verhalten, ermöglicht es, in die Mitte ein beliebiges Logo oder Bild zu setzen.“"
                            },
                            {
                                "example_id": "2a882e42-5d1d-4660-bc95-8464302dd2d0",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„QR-Codes auf Grabsteinen sollen das Gedenken an einen verstorbenen Menschen aufrecht erhalten.“"
                            },
                            {
                                "example_id": "f4c063ea-77a7-40b3-a1fb-df260edee53f",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "[Rollerfahren in der Stadt:] „Zuerst laden sie sich die App des Betreibers herunter und scannen den QR-Code des Rollers. Dann kann‘s losgehen: mit dem Fuß abstoßen, rechts Gas geben, links bremsen.“"
                            },
                            {
                                "example_id": "1b928716-b092-4e23-8482-908b040876a1",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„Viele besondere Steine, Bäume und andere Pflanzen sind mit QR-Codes gekennzeichnet, über die sich Informationen abrufen lassen. Die Zielgruppe ist klar: junge Menschen.“"
                            },
                            {
                                "example_id": "f70754da-5c46-4c11-a2ba-387201390061",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„Möchten Sie Informationen einfach und bequem mit anderen Menschen teilen, können Sie dafür praktische QR-Codes erstellen.“"
                            },
                            {
                                "example_id": "951e1bee-6f3d-460b-bf05-ed3dcd51cff6",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„Künftig ist auch in Frankreich der Nachweis einer Corona-Impfung oder einer Genesung per QR-Code notwendig, um Einkaufszentren, Cafés, Restaurants oder kulturelle Veranstaltungen besuchen zu können.“"
                            },
                            {
                                "example_id": "6f2479dd-2c5f-4f4f-acd0-bb9b06fdd820",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„In Deutschland sind es zumeist immer noch die Apotheken, die digitale Impfzertifikate, QR-Codes, ausstellen.“"
                            },
                            {
                                "example_id": "782f5a2d-4063-4511-a730-d5d76c1c9871",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„Außerdem gibt es zu jedem Rezept im Buch einen QR-Code. Der führt zum entsprechenden Kochvideo auf den Online-Seiten des DW-Specials, so dass sich der Nutzer die Zubereitung der Rezepte Schritt für Schritt ansehen kann.“"
                            },
                            {
                                "example_id": "7c5a56d3-5654-4b88-b8cb-9ff979991fea",
                                "sense_id": "362a3ee2-523b-33ba-8da4-0e93213ddb84",
                                "text": "„In der Sendung entdeckten die Ermittler neben einem sogenannten Polenböller, Batterien und einer Metalldose voller Nägel einen mit einem QR-Code verschlüsselten Erpresserbrief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
