                "senses": [
                    {
                        "sense_id": "5b2cc9f8-831b-3dc1-96b1-7de8327046f9",
                        "entry_id": "72110d67-d4ce-3284-bc64-e936145db992",
                        "glosses": [
                            "Of or pertaining to Archimedes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2f37ca-dce1-4e1b-a3d6-535b058e6cc9",
                                "sense_id": "5b2cc9f8-831b-3dc1-96b1-7de8327046f9",
                                "text": "1629, William Bastian, “To the Authour” in Francis Malthus (translator), A Treatise of Artificial Fire-Works, London: Richard Hawkins,\nThy Archimedean hand hath learnt to frame\nCelestiall Meteors out of Nitrous flame:"
                            },
                            {
                                "example_id": "8c84d85a-d95b-4e44-8f53-52d35f905b73",
                                "sense_id": "5b2cc9f8-831b-3dc1-96b1-7de8327046f9",
                                "text": "[…] sporting Nature, to amuse us,\nDid startling Novelties produce us;\nMocking our Archimedean Sons\nOf Art with strange Phænomenons,"
                            },
                            {
                                "example_id": "4d43fb52-58a0-4c03-8b7d-4cfbad21541e",
                                "sense_id": "5b2cc9f8-831b-3dc1-96b1-7de8327046f9",
                                "text": "Whoever should behold me now, I wist\nWould think I were a mighty mechanist\nBent with sublime Archimedean art\nTo breathe a soul into the iron heart\nOf some machine portentous,"
                            },
                            {
                                "example_id": "5626d5cd-9ff7-4196-a6cd-0dc70846d303",
                                "sense_id": "5b2cc9f8-831b-3dc1-96b1-7de8327046f9",
                                "text": "[…] we are leaving the Campbell house for the train station, and I have my Archimedean experience: Elm Street . . . . . then . . . . . elm trees!"
                            }
                        ]
                    },
                    {
                        "sense_id": "0d595a24-da9e-38f2-82a0-30880af0d82f",
