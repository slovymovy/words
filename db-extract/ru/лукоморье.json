                                "target_senses": [
                                    {
                                        "sense_id": "8a0196ec-6bc2-3d9d-877c-de896f817107",
                                        "entry_id": "c2d5aef2-8ccc-328f-85f6-a49e74c7afd7",
                                        "glosses": [
                                            "ins Land hineinreichende rundliche Meeresfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddcd6d63-6f0d-4f8f-859a-af1e79fe54af",
                                                "sense_id": "8a0196ec-6bc2-3d9d-877c-de896f817107",
                                                "text": "„Er landete in der Stadt Amsterdam an der großen Meeresbucht, die in Holland eindringt und von den Holländern Zuidersee genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
