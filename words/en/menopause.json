{
    "word_family": [
        "menopausal",
        "perimenopause",
        "postmenopause"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2382210d-dadd-3775-b5c4-3eb803871bb8",
                    "sense_definition": "The period of natural cessation of menstruation, typically occurring between ages 45 and 55, accompanied by hormonal changes and physical symptoms.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many women experience hot flashes and sleep disturbances during <w>menopause</w>.",
                            "target_lang_translations": {
                                "zh": "许多女性在<w>更年期</w>会经历潮热和睡眠障碍。"
                            }
                        },
                        {
                            "text": "She spoke to her doctor about potential treatments for common <w>menopause</w> symptoms.",
                            "target_lang_translations": {
                                "zh": "她向医生咨询了针对常见<w>更年期</w>症状的潜在治疗方法。"
                            }
                        }
                    ],
                    "antonyms": [
                        "menarche"
                    ],
                    "common_phrases": [
                        "early menopause",
                        "onset of menopause",
                        "reach menopause",
                        "menopause symptoms"
                    ],
                    "target_lang_definitions": {
                        "zh": "妇女通常在45至55岁之间经历的月经自然终止时期，伴随激素水平变化和身体症状；更年期。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "更年期",
                                "target_lang_sense_clarification": "指女性绝经前后的生理过渡时期及相关生理阶段"
                            },
                            {
                                "target_lang_word": "绝经期",
                                "target_lang_sense_clarification": "医学上指月经终止的阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b2bbe36-f35d-34ff-92aa-22614e7be107",
                    "sense_definition": "The final menstrual period of a woman, marking the permanent end of fertility and ovulation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medically speaking, a woman has reached <w>menopause</w> when twelve full months have passed without a menstrual cycle.",
                            "target_lang_translations": {
                                "zh": "从医学上讲，当女性连续整整十二个月没有月经周期时，就达到了<w>绝经</w>。"
                            }
                        },
                        {
                            "text": "The exact date of <w>menopause</w> can only be determined retrospectively.",
                            "target_lang_translations": {
                                "zh": "确切的<w>绝经</w>日期只能在事后才能确定。"
                            }
                        }
                    ],
                    "antonyms": [
                        "menarche"
                    ],
                    "target_lang_definitions": {
                        "zh": "女性最后一次月经，标志着生育能力和排卵的永久性终止；绝经。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绝经",
                                "target_lang_sense_clarification": "指最后一次月经的事件或月经永久停止"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c17e211b-f9ec-3bc4-9b2a-fbfbc5d2c5a6",
                    "sense_definition": "To undergo or experience the menopause.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists studied how female primates age and whether certain species <w>menopause</w> like humans do.",
                            "target_lang_translations": {
                                "zh": "科学家研究了雌性灵长类动物如何衰老，以及某些物种是否会像人类一样<w>绝经</w>。"
                            }
                        },
                        {
                            "text": "She noticed bodily changes and wondered if she was starting to <w>menopause</w>.",
                            "target_lang_translations": {
                                "zh": "她注意到了身体的变化，想知道自己是否正在<w>进入更年期</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "经历绝经或更年期阶段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绝经",
                                "target_lang_sense_clarification": "动词用法，经历月经停止"
                            },
                            {
                                "target_lang_word": "进入更年期",
                                "target_lang_sense_clarification": "开始经历更年期过渡"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}