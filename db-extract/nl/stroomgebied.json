                        "cross_references": [
                            {
                                "target_word": "catchment area",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "775e0a5b-d681-31e7-8048-0df24791a974",
                                        "entry_id": "89bdcc49-c096-3084-9e54-34275b3808c5",
                                        "glosses": [
                                            "An area from which water drains into a particular lake, river, etc.; the catchment area of a large river includes its tributaries."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06db9e25-9b0e-3ab4-b299-70891626d13a",
                                        "entry_id": "89bdcc49-c096-3084-9e54-34275b3808c5",
                                        "glosses": [
                                            "The area served by a local institution, such as a hospital or school, or by extension, a railway station."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f3e5ef7-c1a8-416d-a051-fcbbb907db48",
                                                "sense_id": "06db9e25-9b0e-3ab4-b299-70891626d13a",
                                                "text": "As well as the new station, the funding will allow the building of the Chelmsford North East bypass, enhancing access to and the catchment area of the station."
                                            },
                                            {
                                                "example_id": "d135165e-7655-4d05-aa06-f294c7cb0713",
                                                "sense_id": "06db9e25-9b0e-3ab4-b299-70891626d13a",
                                                "text": "Wealthy parents buying into preferred catchment areas is nothing new and for years families have been moving to Kent for the grammar schools."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb646468-d85c-4d8a-b410-1c923a8fdef1",
                        "source_entry_id": "d0118260-b825-3281-9f04-95c987908e74",
                        "source_sense_id": "e5ccd364-b04d-3595-bace-bb214efd2000",
                        "target_lang_word": "bassin versant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bassin versant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ede7fa1e-46e1-3643-a50d-0ea1b517202e",
                                        "entry_id": "70be34da-1b4f-3753-8498-00c8c1a4c51e",
                                        "glosses": [
                                            "Ensemble des territoires dont les eaux se déversent dans un cours d’eau donné."
                                        ],
                                        "tags": [
                                            "Géographie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4d60201-5c35-4ccc-942d-06e8900d3f4e",
                                                "sense_id": "ede7fa1e-46e1-3643-a50d-0ea1b517202e",
                                                "text": "La mesure de la teneur en humidité d'un sol et la force de rétention de l'eau par celui-ci revêtent une grande importance pour l'aménagement des bassins versants et l'hydrologie."
                                            },
                                            {
                                                "example_id": "7be801dd-45ca-48a8-a09b-369d7cb923ac",
                                                "sense_id": "ede7fa1e-46e1-3643-a50d-0ea1b517202e",
                                                "text": "Le court métrage le voyage de l’eau, entièrement réalisé par quatre classes du bassin versant du Chavanon dans le cadre d’un projet pédagogique avec le PNR de Millevaches et le vidéaste Arnaud Jamin, a été présenté en avant-première."
                                            },
                                            {
                                                "example_id": "d491a552-e623-4e0e-be99-daad7b8cbafa",
                                                "sense_id": "ede7fa1e-46e1-3643-a50d-0ea1b517202e",
                                                "text": "Plusieurs bassins versants sont concernés dans le Médoc, la Haute Gironde, le Libournais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
