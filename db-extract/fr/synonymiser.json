                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synonymize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c31f1fb9-bdd2-344b-a11e-6adcaa51aaeb",
                                        "entry_id": "63992b9b-11bc-38d9-9fd9-aa7ed327aeaa",
                                        "glosses": [
                                            "To express by a synonym or synonyms."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "717ef400-2bc1-4ddd-ac3c-36a117ff19bc",
                                                "sense_id": "c31f1fb9-bdd2-344b-a11e-6adcaa51aaeb",
                                                "text": "This word fortis we may synonymize after all these fashions: stout, hardy, valiant, doughty, courageous, adventurous, brave, bold, daring, intrepid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35e2fc1d-0959-3cd9-a964-d97b60c9f654",
                                        "entry_id": "63992b9b-11bc-38d9-9fd9-aa7ed327aeaa",
                                        "glosses": [
                                            "To identify two taxonomic terms as synonyms, thus equating two potentially disparate categories."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
