                        "sense_id": "1c34318f-96b2-301c-897e-6b46cfebcccf",
                        "entry_id": "66777496-840d-33d1-9344-f59bde8238c2",
                        "glosses": [
                            "Formation naturelle du diamant en agrégat polycristallin d’éléments microscopiques de 2 à 40 microns de taille, très poreux et dont la couleur varie du noir, vert au jaune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959f37b0-5ce0-4d72-a022-960487bb233f",
                                "sense_id": "1c34318f-96b2-301c-897e-6b46cfebcccf",
                                "text": "Il existe plusieurs hypothèses concernant l’origine du carbonado."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f716aa24-cd83-43be-a7ab-e912f4cf4ed4",
                        "source_entry_id": "66777496-840d-33d1-9344-f59bde8238c2",
                        "source_sense_id": "1c34318f-96b2-301c-897e-6b46cfebcccf",
