                "senses": [
                    {
                        "sense_id": "1f6945e2-ee57-3b72-9150-e6c2277b944e",
                        "entry_id": "aca79b1f-9b41-3c7b-9ec8-5a71d63e0169",
                        "glosses": [
                            "Person, die (beruflich) Fahrschüler zum Führen von Kraftfahrzeugen ausbildet und sie auf die Führerscheinprüfung vorbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "978d0278-9b6b-4d43-b67e-222346cb83fc",
                                "sense_id": "1f6945e2-ee57-3b72-9150-e6c2277b944e",
                                "text": "Dein Fahrlehrer verlangt den doppelten Preis für eine Übungsstunde."
                            },
                            {
                                "example_id": "cf10c4da-81f3-4661-b14a-1b0a6aa7edb9",
                                "sense_id": "1f6945e2-ee57-3b72-9150-e6c2277b944e",
                                "text": "Der Fahrlehrer drückte auf die Bremse, als er merkte, dass der Fahrschüler das Fahrrad nicht sah."
                            },
                            {
                                "example_id": "3fbf5ded-f270-49b2-aba0-30eb77b55477",
                                "sense_id": "1f6945e2-ee57-3b72-9150-e6c2277b944e",
                                "text": "„Wenn der Fahrlehrer nur auf Fehler fokussiert, besteht jemand zwar am Ende vielleicht die Führerscheinprüfung, ist aber trotzdem überzeugt: Ich bin zu blöd zum Autofahren.“"
                            },
                            {
                                "example_id": "f1784b20-b176-4412-9e27-285357cdd4be",
                                "sense_id": "1f6945e2-ee57-3b72-9150-e6c2277b944e",
                                "text": "„150.000 Jobs in Deutschland bedroht - neben dem besonders betroffenen Taxi- und Mietwagengewerbe bangen auch Hunderte Fahrlehrer um ihren Broterwerb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
