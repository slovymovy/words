                        "source_sense_description": "ein Zugtau, mit dem ein Schiff vom Ufer aus stromaufwärts gezogen wird",
                        "target_lang_word": "traîne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traîne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc95a3a1-efdb-3da9-8254-b18e03c1ed8b",
                                        "entry_id": "c0a5959a-9149-3da8-9c67-e3bc3d5d0fd3",
                                        "glosses": [
                                            "Action de traîner, de tirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a48e4f-9972-4850-9288-4b868c4385f7",
                                                "sense_id": "fc95a3a1-efdb-3da9-8254-b18e03c1ed8b",
                                                "text": "Pêcher à la traîne."
                                            },
                                            {
                                                "example_id": "33e6487f-87de-40d8-929b-404e1982c5d4",
                                                "sense_id": "fc95a3a1-efdb-3da9-8254-b18e03c1ed8b",
                                                "text": "Des perdreaux qui sont en traîne, Des perdreaux qui ne peuvent pas encore voler, ni se séparer de leur mère."
                                            },
                                            {
                                                "example_id": "4830533d-d100-461d-9349-2e0fb62a5638",
                                                "sense_id": "fc95a3a1-efdb-3da9-8254-b18e03c1ed8b",
                                                "text": "Un bateau qui est à la traîne, Un bateau amarré à l’arrière d’un bâtiment et que celui-ci traîne dans sa marche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0db48e-72d6-3c8b-b1aa-80f316a74d6b",
                                        "entry_id": "c0a5959a-9149-3da8-9c67-e3bc3d5d0fd3",
                                        "glosses": [
                                            "Queue traînante d’une robe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945a2ae6-d45e-4ccc-b218-a05a14d7fb8c",
                                                "sense_id": "1f0db48e-72d6-3c8b-b1aa-80f316a74d6b",
                                                "text": "Madame d’Espanet voulait absolument avoir une robe à traîne pour cacher ses pieds un peu forts, […]"
                                            },
                                            {
                                                "example_id": "e1b7d3c5-30e1-435f-a477-f8f340f8ecec",
                                                "sense_id": "1f0db48e-72d6-3c8b-b1aa-80f316a74d6b",
                                                "text": "Raoule portait, ce soir-là, une robe de gaze blanche vaporeuse, à traîne de cour, sans un bijou, sans une fleur."
                                            },
                                            {
                                                "example_id": "7a7de24e-06c6-4dc0-8547-db2f4e828e50",
                                                "sense_id": "1f0db48e-72d6-3c8b-b1aa-80f316a74d6b",
                                                "text": "J’étais dans une île enchantée ; et devant ces femmes qui tournaient la traîne de leurs robes, comme des sirènes dans nos livres de mythologie tournaient leur queue, je pensais à Circé et à Hélène."
                                            },
                                            {
                                                "example_id": "8e0b6708-5417-442b-b965-859a1cd4164d",
                                                "sense_id": "1f0db48e-72d6-3c8b-b1aa-80f316a74d6b",
                                                "text": "— Une belle robe avec une petite traîne, continua Mme Bretoneux.\n— Je suis en deuil.\n— Mais le deuil n’empêche pas de porter une robe à traîne."
                                            },
                                            {
                                                "example_id": "a60a05af-cd85-4a2a-ac03-f7645a7520eb",
                                                "sense_id": "1f0db48e-72d6-3c8b-b1aa-80f316a74d6b",
                                                "text": "Elle portait d’un air d’ennui sur son bras gauche la traîne de son amazone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9110eb22-73fa-3eb4-9204-28178b805ac5",
                                        "entry_id": "c0a5959a-9149-3da8-9c67-e3bc3d5d0fd3",
                                        "glosses": [
                                            "Longues tiges pendantes d’une plante grimpante."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "305d8430-8736-40b0-be09-ab952b01d62e",
                                                "sense_id": "9110eb22-73fa-3eb4-9204-28178b805ac5",
                                                "text": "Ils organisèrent une battue méthodique, fouillant chaque buisson, écartant les lourdes traînes de lierre enroulées autour du fût des colonnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a8022f-b209-365c-87cb-dc066fd698fd",
                                        "entry_id": "c0a5959a-9149-3da8-9c67-e3bc3d5d0fd3",
                                        "glosses": [
                                            "(Régionalisme berrichon) Chemin creux ombragé par des arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a140ac63-cd86-48ec-9548-ff6e26c6e51d",
                                                "sense_id": "62a8022f-b209-365c-87cb-dc066fd698fd",
                                                "text": "Ils suivaient un de ces petits chemins verts qu’on appelle, en langage villageois, traînes ; chemin si étroit que l’étroite voiture touchait de chaque côté les branches des arbres qui le bordaient!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4672645-cddb-3b77-a86c-4a924f5eaff4",
                                        "entry_id": "c0a5959a-9149-3da8-9c67-e3bc3d5d0fd3",
                                        "glosses": [
                                            "Traîneau."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8596a5f8-4843-42e7-9e65-15cc9c456544",
                                                "sense_id": "c4672645-cddb-3b77-a86c-4a924f5eaff4",
                                                "text": "Ils l’ont chargé sur leur traîne et rapporté à leur tente, et ils l’ont soigné."
                                            },
                                            {
                                                "example_id": "eb5877ef-3d9a-43e0-9da3-01202119730b",
                                                "sense_id": "c4672645-cddb-3b77-a86c-4a924f5eaff4",
                                                "text": "François est parti seul, à raquette, avec ses couvertes et des provisions sur une petite traîne…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c786ed-96ab-33ee-858d-f774d6890fa3",
                                        "entry_id": "c0a5959a-9149-3da8-9c67-e3bc3d5d0fd3",
                                        "glosses": [
                                            "Filet qu'on passe sur un court en terre battue pour y enlever les traces de pieds et les impacts de balles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a48e0b7-65da-3acc-85b5-00700f556bba",
                                        "entry_id": "c0a5959a-9149-3da8-9c67-e3bc3d5d0fd3",
                                        "glosses": [
                                            "Zone située à la suite du passage d’un front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "406a663b-2312-4a5b-8d50-230682ac183a",
                                                "sense_id": "0a48e0b7-65da-3acc-85b5-00700f556bba",
                                                "text": "Après le passage du grain de traîne qui clôt la tempête, une voûte de mercure tremblote au-dessus de la ville."
                                            }
                                        ]
                                    }
                                ]
                            },
