                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "6304aec4-f2d2-48cf-8060-6b847cd3c5fb",
                                "sense_id": "23f9bf30-7f20-395d-9857-87d7d445d302",
                                "text": "Quand il se trouvait, par hasard, qu’un d’entre eux fût compromis, en classe, dans une affaire de bavardage, discussion ou jeu défendu, il arrivait toujours, prenant un air de sainte-nitouche, à s’en tirer sain et sauf, tandis que les copains, eux, ne manquaient pas d’écoper pour lui."
                            }
                        ]
                    }
