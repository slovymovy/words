                        "glosses": [
                            "Particularly expressive of or affected by emotion."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9bc996f1-5762-47e3-9ca5-c7f5f1a7c303",
                                "sense_id": "507b9db8-4dcf-30d4-a809-51029b7cde0a",
                                "text": "His was the genuine Celtic temperament—poetic, excitable, emotionable, unreasoning."
                            },
                            {
                                "example_id": "51a510a6-56cc-425e-9c46-e89696ccf11d",
                                "sense_id": "507b9db8-4dcf-30d4-a809-51029b7cde0a",
                                "text": "Delicat and subtle are the dealings of nature\nwhereby the emotionable sense secretly is touch'd\nto awareness"
                            },
                            {
                                "example_id": "95a9f57a-3341-437e-a4ef-d1c8043b33f8",
                                "sense_id": "507b9db8-4dcf-30d4-a809-51029b7cde0a",
                                "text": "Consequently man was an emotionable being and this emotion was the basis for morality."
                            }
                        ]
                    }
