                                                "sense_id": "533be132-a90a-3539-a9aa-a5bc83e1cb63",
                                                "text": "Holonyms: pocket money, spending money, walk-around money, walking-around money; pin money"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0d7f01-d464-39f4-9b28-7fafa0f9691e",
                                        "entry_id": "d63a424d-ee78-364c-8d05-f6ff76e94546",
                                        "glosses": [
                                            "A minor or insignificant amount of money."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a3cdb6-f7a4-49f0-93fb-fa330dd6fab1",
                                                "sense_id": "1e0d7f01-d464-39f4-9b28-7fafa0f9691e",
                                                "text": "The cost of toothpaste is small change compared to the cost of dental work."
                                            },
                                            {
                                                "example_id": "a544bc29-1d4d-48a7-a53e-1152c1a4ce37",
                                                "sense_id": "1e0d7f01-d464-39f4-9b28-7fafa0f9691e",
                                                "text": "'Cousin Tom,' said mother, and trying to get so that Annie and I could not hear her; 'it would be a sad and unkinlike thing for you to despise our dwelling-house. We cannot entertain you, as the lordly inns on the road do; and we have small change of victuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f59c99f2-51b7-31e2-aca7-556ff1a51bcd",
                                        "entry_id": "d63a424d-ee78-364c-8d05-f6ff76e94546",
                                        "glosses": [
                                            "A person or thing of little importance or value."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
