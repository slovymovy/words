                "senses": [
                    {
                        "sense_id": "1131f615-f603-3476-aa7b-b8efa943a915",
                        "entry_id": "d97c372f-5cac-30bf-a344-733223e1f90d",
                        "glosses": [
                            "Zug mit besonders komfortabler Ausstattung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4116de7-5674-43dc-a7b1-6899052804b3",
                                "sense_id": "1131f615-f603-3476-aa7b-b8efa943a915",
                                "text": "„›Ich habe ihn gefragt, was für ein Job das wäre, auf dieser Zugfahrt. Er sagte, er würde eine Holländerin begleiten, die ihn als Personenschützer engagiert habe, es habe sich mal wieder ausgezahlt, dass er seine Karte überall hinterlassen habe. Der Oberkellner des Cape Grace Hotels habe ihn empfohlen. Die Frau reiste mit Rovos Mail nach Pretoria, das wäre dieser Luxuszug, und er würde sein eigenes Abteil bekommen und alles. Und sie würde ihm auch noch gutes Geld für seine Dienste zahlen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
