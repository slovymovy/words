                "senses": [
                    {
                        "sense_id": "ef9236e5-3989-3644-a1ef-cccde4924bf3",
                        "entry_id": "3e0a8aca-d043-3e0a-bca7-dd3baf59dbc4",
                        "glosses": [
                            "Obtenir des pouvoirs publics ou administratifs, en vertu d’une demande, d’une requête, un titre, un privilège."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c96bccd5-a605-4232-8601-d1b6e4b8ffde",
                                "sense_id": "ef9236e5-3989-3644-a1ef-cccde4924bf3",
                                "text": "Et me fut dit que le sire de la Trémoille étoit envoyé de par le duc et les seigneurs au roi, à Paris, pour savoir son plaisir, et pour impétrer que on les pût combattre."
                            },
                            {
                                "example_id": "4e51e5ae-bc82-4ebc-a215-8291da5c775a",
                                "sense_id": "ef9236e5-3989-3644-a1ef-cccde4924bf3",
                                "text": "Elle [la Vierge] protège l'innocence,\nAccueille la résipiscence,\nEt, debout quand tous à genoux,\nImpètre le pardon du Père\nPour le pécheur qui désespère …"
                            }
                        ]
                    }
