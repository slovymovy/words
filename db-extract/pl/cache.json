                                    {
                                        "sense_id": "9fc71bcf-18e2-367a-bf2c-3ac84f333618",
                                        "entry_id": "9d4e2f86-d78d-395f-bd13-f828a4c127f4",
                                        "glosses": [
                                            "A store, protected or hidden in some way, of things that may be required in the future, such that they can be retrieved rapidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "907d3a09-21fb-495f-942b-b958a4881426",
                                                "sense_id": "9fc71bcf-18e2-367a-bf2c-3ac84f333618",
                                                "text": "Members of the 29-man Discovery team laid down food caches to allow the polar team to travel light, hopping from food cache to food cache on their return journey."
                                            },
                                            {
                                                "example_id": "5052bd9f-ebc9-43a1-b546-7a3092455679",
                                                "sense_id": "9fc71bcf-18e2-367a-bf2c-3ac84f333618",
                                                "text": "I came across a cache of old photos / And invitations to teenage parties"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09939fdc-d4d5-3e57-a425-33b46911b499",
                                        "entry_id": "9d4e2f86-d78d-395f-bd13-f828a4c127f4",
                                        "glosses": [
                                            "A fast temporary storage where recently or frequently used information is stored to avoid having to reload it from a slower storage medium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb91441b-4242-3623-a5b6-a244f865be3a",
                                        "entry_id": "9d4e2f86-d78d-395f-bd13-f828a4c127f4",
                                        "glosses": [
                                            "A container containing treasure in a global treasure-hunt game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
