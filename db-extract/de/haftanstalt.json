                "senses": [
                    {
                        "sense_id": "684f7584-3f67-3163-98c9-e2c503057fbf",
                        "entry_id": "adb74a1a-dd61-3149-b5dd-78dadd9fc426",
                        "glosses": [
                            "Gebäudekomplex, in dem mutmaßliche und verurteilte Straftäter verwahrt werden"
                        ],
                        "tags": [
                            "Exekutive"
                        ],
                        "examples": [
                            {
                                "example_id": "8ad7df06-df3d-4f6a-9eb2-7eeb9e964748",
                                "sense_id": "684f7584-3f67-3163-98c9-e2c503057fbf",
                                "text": "„Die Konfliktparteien im Jemen gaben sich gegenseitig die Schuld: Wie die von den schiitischen Huthi-Rebellen kontrollierte Nachrichtenagentur Saba berichtete, stürmten Al-Kaida-Kämpfer und mit ihr verbündete Milizen am Samstag die Haftanstalt. Aus anderen Sicherheitskreisen verlautete hingegen, Huthis und deren Verbündete hätten die Gefangenen befreit.“"
                            },
                            {
                                "example_id": "d09fec03-1b40-47fb-b2de-0f273a0a5102",
                                "sense_id": "684f7584-3f67-3163-98c9-e2c503057fbf",
                                "text": "„Die schlimmsten landeten in geschlossenen Haftanstalten.“"
                            },
                            {
                                "example_id": "6cf69b5e-4020-4c77-a53d-5051d0bc3460",
                                "sense_id": "684f7584-3f67-3163-98c9-e2c503057fbf",
                                "text": "„Roths Kaserne war ein »Höllenloch« und noch eine Woche zuvor eine Haftanstalt für afro-amerikanische Sträflinge gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e49038c-490b-4d96-849d-f2c440fba2f7",
                        "source_entry_id": "adb74a1a-dd61-3149-b5dd-78dadd9fc426",
                        "source_sense_id": "684f7584-3f67-3163-98c9-e2c503057fbf",
                        "source_sense_description": "Exekutive: Gebäudekomplex, in dem mutmaßliche und verurteilte Straftäter verwahrt werden",
                        "target_lang_word": "detention centre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detention centre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86f26d1c-1578-31d4-af0d-87ef908857f9",
                                        "entry_id": "6431a905-aa30-3d4f-9c00-f34b730b8376",
                                        "glosses": [
                                            "A facility in which people are detained (held in custody); a jail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498aa09d-a564-46a8-9485-e939c4ac77da",
                                                "sense_id": "86f26d1c-1578-31d4-af0d-87ef908857f9",
                                                "text": "2002, Russell Hogg, Chapter 1: Prisoners and the Penal Estate in Australia, David Brown, Meredith Wilkie (editors), Prisoners as Citizens: Human Rights in Australian Prisons, page 3,\nAll jurisdictions have their own prison systems, although the Australia Capital Territory (ACT) has only one remand centre and one periodic detention centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3a5f5a0-81f1-390d-acba-33ae5cc76a13",
                                        "entry_id": "6431a905-aa30-3d4f-9c00-f34b730b8376",
                                        "glosses": [
                                            "An immigration detention facility; a facility in which people who have attempted to enter Australia without prior authorisation are detained, pending a decision on whether they are to be accepted as refugees or returned to their country of origin."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ea62174-1a1d-425e-be33-16ca17ad1e98",
                                                "sense_id": "d3a5f5a0-81f1-390d-acba-33ae5cc76a13",
                                                "text": "New detention centres were opened, all in remote areas — at Woomera in the South Australian desert in November 1999, and the Curtin Detention Centre at Derby in Western Australia in February 2000."
                                            },
                                            {
                                                "example_id": "69b1f6fe-5e7f-44ee-9741-bd15fcdd91b9",
                                                "sense_id": "d3a5f5a0-81f1-390d-acba-33ae5cc76a13",
                                                "text": "One of the main features of Australia′s ‘Pacific Solution’ is that it involves the use of the Australian Navy to prevent boat people from landing on mainland Australia. The boat people are then transferred to detention centres on offshore Australian Territories which have been excised from the country′s migration zone where regular immigration rules are in application.⁷⁸ Detention centres for such transfers have also been set up on Nauru and Manus Island (Papua New Guinea).⁷⁹"
                                            },
                                            {
                                                "example_id": "9b7291cd-e2db-4a62-996b-f617dcaf9217",
                                                "sense_id": "d3a5f5a0-81f1-390d-acba-33ae5cc76a13",
                                                "text": "People landing on these islands could also be transferred to detention centres on Nauru or Manus Island and had no access to Australia′s legal system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a57c71-d877-36b3-8fe7-231b417d0671",
                                        "entry_id": "6431a905-aa30-3d4f-9c00-f34b730b8376",
                                        "glosses": [
                                            "A concentration camp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69450936-3a43-4600-b832-96f51df2f660",
                        "source_entry_id": "adb74a1a-dd61-3149-b5dd-78dadd9fc426",
                        "source_sense_id": "684f7584-3f67-3163-98c9-e2c503057fbf",
