                    {
                        "sense_id": "ec7a5b6e-f52c-3316-bbb8-1c3b5f887ab5",
                        "entry_id": "4130ef43-e9c6-3d2c-ad0e-06f9c3ee2fbb",
                        "glosses": [
                            "Variante de baroufle."
                        ],
                        "tags": [
