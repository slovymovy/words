                    {
                        "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                        "entry_id": "4b3af614-fe92-3764-96ad-23f86226170f",
                        "glosses": [
                            "Arbeiter, der seinen beruflichen Aufgaben in einem Binnen- oder Seehafen nachgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92f9ccd2-cad1-4e75-a39f-d6a5c140be42",
                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                "text": "„Ein Streik der Hafenarbeiter legt den Ladeverkehr in den Häfen der Westküste der Vereinigten Staaten lahm.“"
                            },
                            {
                                "example_id": "8c3bb82f-4488-460d-886e-6527a91a9719",
                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                "text": "„Zu unseren Leuten gehörten Soldaten, Matrosen und Hafenarbeiter.“"
                            },
                            {
                                "example_id": "0f69a8a1-1df7-4960-907e-4fc5f15f4a78",
                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                "text": "„Die anderen Hafenarbeiter riefen immer dann nach Kostas, dem Mechaniker, wenn mal wieder eine Kurbel klemmte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
