                        "glosses": [
                            "Qui a une teinte vermillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50a2a978-b246-4a9c-918a-50c299f07380",
                                "sense_id": "8f04f22e-3bcf-337f-9388-9fe1532331de",
                                "text": "Voyez la sœur de Lazare tendant ses belles mains potelées, avec son ample cou satiné sous son riche menton et ses joues vermillonnantes, sa jupe de satin bleu intense, luisant sous sa chape d’or damasquiné ; quelle maîtresse bonne et savoureusement complaisante ! Rien ne surpasse les Flamands, sauf les Vénitiens."
                            }
                        ]
