                        "translation_id": "f78b3a59-7b64-48f3-af26-4045cd7aff5d",
                        "source_entry_id": "cfc325b0-c438-3711-aedf-706758acbc52",
                        "source_sense_id": "723df91d-1dfc-3efc-9a09-ac861179c75b",
                        "target_lang_word": "algique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "algique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8de0ca7-bac6-3a9e-b9f4-5064d69d505d",
                                        "entry_id": "f6242ba0-821b-37ff-8187-52596dcd779b",
                                        "glosses": [
                                            "Douloureux, qui ressent de la douleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21730b73-fae8-4331-904f-3683af63e755",
                                                "sense_id": "d8de0ca7-bac6-3a9e-b9f4-5064d69d505d",
                                                "text": "Si le patient est algique, le médecin doit chercher la cause de la douleur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "algique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cfa5b7f-9eb1-36bc-9fc3-ceec6794ae22",
                                        "entry_id": "1d0b25b8-6c43-334a-9b1d-dad864a70ece",
                                        "glosses": [
                                            "Relatif à une famille des langues amérindiennes dont la majorité sont des langues algonquiennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd103dd-cd10-4011-a0bd-a71c4c0cbf54",
                                                "sense_id": "8cfa5b7f-9eb1-36bc-9fc3-ceec6794ae22",
                                                "text": "La langue des Micmacs partage certaines caractéristiques avec celle des Cris, la langue la plus répandue du groupe algique, ainsi qu’avec celle des Arapahos des plaines centrales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "175e5c48-fbbc-395c-992c-472a13fc92e6",
                                        "entry_id": "1d0b25b8-6c43-334a-9b1d-dad864a70ece",
                                        "glosses": [
                                            "Relatif aux peuples parlant traditionnellement des langues dites algiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52015b8d-f79a-4e7e-a733-db8808047270",
                                                "sense_id": "175e5c48-fbbc-395c-992c-472a13fc92e6",
                                                "text": "Quatre ans plus tard, un ancien de la tribu algique des Onontchataronons raconte au père Lalemant que sa mère disait qu’étant jeune, les Wendats chassèrent leur peuple de l’île de Montréal […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "610109a3-6465-3659-a1c5-91615545dc69",
                                        "entry_id": "1d0b25b8-6c43-334a-9b1d-dad864a70ece",
                                        "glosses": [
                                            "Synonyme d'algonquien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4d5136-4e21-4387-8738-69810479fcc2",
                                                "sense_id": "610109a3-6465-3659-a1c5-91615545dc69",
                                                "text": "Les Algonquins étaient une nation, qui vivait le long de l'Outaouais et appartenait à la famille algonkienne, dite aussi famille algique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99758702-460c-4372-bfbb-b249d150a0a0",
                        "source_entry_id": "cfc325b0-c438-3711-aedf-706758acbc52",
                        "source_sense_id": "723df91d-1dfc-3efc-9a09-ac861179c75b",
                        "target_lang_word": "болевой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
