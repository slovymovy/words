            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75fefbac-9e7a-3bb5-9846-206c8a381262",
                    "sense_definition": "Avoir une pointure donnée, porter des chaussures d'une taille déterminée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon fils a grandi vite et il <w>chausse</w> maintenant du quarante-deux."
                        },
                        {
                            "text": "Je cherche ces baskets mais je ne sais pas si vous <w>chaussez</w> du trente-huit."
                        }
                    ],
                    "common_phrases": [
                        "chausser du quarante",
                        "chausser grand"
                    ]
                },
                {
                    "sense_id": "5461c8a2-526f-35ef-9631-5320d523fe6a",
                    "sense_definition": "Mettre à ses propres pieds des chaussures, des bottes, des patins ou des skis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de descendre la piste enneigée, elle <w>chausse</w> ses skis avec soin."
                        },
                        {
                            "text": "Il a rapidement <w>chaussé</w> de gros souliers de marche pour aller dans la forêt."
                        }
                    ],
                    "common_phrases": [
                        "chausser ses bottes",
                        "chausser ses skis"
                    ]
                },
                {
                    "sense_id": "dc3eaff2-f937-38e3-8d74-bea9f882dfa4",
                    "sense_definition": "Mettre des chaussures ou des chaussettes aux pieds de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les matins, la mère aide à habiller et <w>chausser</w> son jeune enfant."
                        },
                        {
                            "text": "Le grand-père a du mal à se pencher, il faut souvent le <w>chausser</w>."
                        }
                    ],
                    "common_phrases": [
                        "chausser un enfant"
                    ]
                },
                {
                    "sense_id": "b996e76f-8a47-30ed-a3b0-dff1b8e65561",
                    "sense_definition": "En parlant d'une chaussure, s'adapter confortablement et précisément à la forme du pied.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce cuir est très souple, ces bottines vous <w>chaussent</w> parfaitement."
                        },
                        {
                            "text": "Ce modèle élégant <w>chausse</w> bien sans comprimer les orteils."
                        }
                    ],
                    "common_phrases": [
                        "chausser bien"
                    ]
                },
                {
                    "sense_id": "e7b7f4d2-fcc2-3b5c-9946-2a3184e24527",
                    "sense_definition": "Fournir des souliers à quelqu'un, fabriquer ou vendre des chaussures pour lui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artisan réputé <w>chausse</w> les membres de cette famille depuis deux générations."
                        },
                        {
                            "text": "La boutique propose des articles de qualité pour <w>chausser</w> toute la clientèle."
                        }
                    ],
                    "common_phrases": [
                        "chausser toute la famille"
                    ]
                },
                {
                    "sense_id": "8eea7a32-f34f-3f24-a62d-645e81baca4e",
                    "sense_definition": "Entourer de terre le pied d'un arbre ou d'une plante pour stimuler son développement ou le protéger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier préfère <w>chausser</w> les jeunes plants avant les premières gelées de l'hiver."
                        },
                        {
                            "text": "Il faut <w>chausser</w> un arbre pour renforcer ses racines dans ce terrain meuble."
                        }
                    ],
                    "synonyms": [
                        "enchausser"
                    ],
                    "common_phrases": [
                        "chausser un arbre",
                        "chausser une plante"
                    ]
                }
            ]
        }
    ]
}