                    {
                        "form_id": "b534ff42-716c-4a4c-a197-2d3e9adadafe",
                        "entry_id": "4ca5e598-5f4e-3060-bcf3-11ca9b98e46e",
                        "tags": [],
                        "form": "mixer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "820ce202-559d-3fba-a6fe-c034b13b3a06",
                        "entry_id": "4ca5e598-5f4e-3060-bcf3-11ca9b98e46e",
                        "glosses": [
                            "Robot de cuisine pour broyer, hacher et mélanger les aliments."
                        ],
                        "tags": [
                            "Électroménager"
                        ],
                        "examples": [
                            {
                                "example_id": "55d06304-88b7-429e-92b6-2d0ca8e27e0b",
                                "sense_id": "820ce202-559d-3fba-a6fe-c034b13b3a06",
                                "text": "L’entreprise, qui devient le leader du petit électroménager, inonde les cuisines de ses robots, de ses mixeurs, de ses minifours, de ses hachoirs, et, à la fin des années 1970, de ses fours à micro-ondes."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c47f2a9-3470-37d1-8615-433fd5d5638c",
                        "entry_id": "4ca5e598-5f4e-3060-bcf3-11ca9b98e46e",
                        "glosses": [
                            "Appareil pour le mixage des bandes son, vidéos ou cinématographiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0331793-87a0-45be-b417-0a7a8ecb3acc",
                                "sense_id": "1c47f2a9-3470-37d1-8615-433fd5d5638c",
                                "text": "Mon but est de mapper les entrées line in et CD de mon mixeur sur mon clavier multimédia."
                            }
                        ]
                    },
                    {
                        "sense_id": "e330fc1d-5053-308d-8188-4c4709dee9e9",
                        "entry_id": "4ca5e598-5f4e-3060-bcf3-11ca9b98e46e",
                        "glosses": [
                            "Spécialiste du mixage."
                        ],
                        "tags": [
                            "Métier",
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "d105caa5-7cd3-417e-97f5-c7911d2f2e2d",
                                "sense_id": "e330fc1d-5053-308d-8188-4c4709dee9e9",
                                "text": "L’ingénieure du son et la mixeuse travaillent le son du film sur un mixeur de réenregistrement pour combiner les pistes de dialogue, de bruitage et celle de musique."
                            }
                        ]
                    },
                    {
                        "sense_id": "450e6066-cf24-3086-bd89-0f2e5fa793b5",
                        "entry_id": "4ca5e598-5f4e-3060-bcf3-11ca9b98e46e",
                        "glosses": [
                            "Moyen de masquer l'origine douteuse de fonds crypto-actifs."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "873655d6-3b6a-41bb-85f9-2bc906296638",
                                "sense_id": "450e6066-cf24-3086-bd89-0f2e5fa793b5",
                                "text": "En pratique, les mixeurs permettent de mélanger des fonds de crypto potentiellement identifiables avec d’autres afin de renforcer l’anonymat de leur détenteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5464756-de32-474b-b8ea-a83d1c5e7997",
                        "source_entry_id": "4ca5e598-5f4e-3060-bcf3-11ca9b98e46e",
                        "source_sense_id": "820ce202-559d-3fba-a6fe-c034b13b3a06",
