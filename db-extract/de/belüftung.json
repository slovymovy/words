                "senses": [
                    {
                        "sense_id": "510aa493-78f9-33ec-8446-1054bd9c4b72",
                        "entry_id": "97c392a5-ed56-3da0-98a1-4caf0bd31c74",
                        "glosses": [
                            "das Belüften von Räumen zur Lufterneuerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c69f3f5-d0b0-4285-8bb4-e5119a357a65",
                                "sense_id": "510aa493-78f9-33ec-8446-1054bd9c4b72",
                                "text": "„Optimale Wintergarten Belüftung: Belüftung ist wichtiger Bestandteil der Wintergarten-Planung durch den Fachbetrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b244f071-fb43-3d90-84ca-fe64646e6ea4",
                        "entry_id": "97c392a5-ed56-3da0-98a1-4caf0bd31c74",
                        "glosses": [
                            "herstellen eines atmosphärischen Druckausgleich im Abwasserkanal, damit das Abwasser fließen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a70d4e9-a22a-47bc-a3c2-09ff63d55f24",
                                "sense_id": "b244f071-fb43-3d90-84ca-fe64646e6ea4",
                                "text": "„Bei unzureichender Belüftung werden Siphons leer gesaugt und es entstehen Geruchsbelästigungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40e0345b-267a-4b78-8ee2-131ba99e843c",
                        "source_entry_id": "97c392a5-ed56-3da0-98a1-4caf0bd31c74",
                        "source_sense_id": "510aa493-78f9-33ec-8446-1054bd9c4b72",
