                "senses": [
                    {
                        "sense_id": "c9b198ee-660c-3b3b-ba0c-e345d185bc41",
                        "entry_id": "020ee474-e4e7-3cb7-b645-357b19adaa73",
                        "glosses": [
                            "voter"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "f8167665-a178-4037-8b82-2146544d44d4",
                                "sense_id": "c9b198ee-660c-3b3b-ba0c-e345d185bc41",
                                "text": "Alle kiezers moeten hun stem uitbrengen tijdens de verkiezingen.",
                                "translation": "All voters must cast their vote during the elections.",
                                "english": "All voters must cast their vote during the elections."
                            },
                            {
                                "example_id": "c54ed7b2-3670-464a-ad7d-ae5c50766b44",
                                "sense_id": "c9b198ee-660c-3b3b-ba0c-e345d185bc41",
                                "text": "De politieke partijen proberen de kiezers te overtuigen met hun verkiezingsprogramma.",
                                "translation": "The political parties try to persuade the voters with their election program.",
                                "english": "The political parties try to persuade the voters with their election program."
                            },
                            {
                                "example_id": "6076b400-cd86-4c46-9c1e-b8106314fcef",
                                "sense_id": "c9b198ee-660c-3b3b-ba0c-e345d185bc41",
                                "text": "Elke kiezer heeft het recht om zijn stem uit te brengen volgens zijn overtuiging.",
                                "translation": "Every voter has the right to cast his vote according to his conviction.",
                                "english": "Every voter has the right to cast his vote according to his conviction."
                            },
                            {
                                "example_id": "ed797fe1-8779-4f11-879d-b60331c7e409",
                                "sense_id": "c9b198ee-660c-3b3b-ba0c-e345d185bc41",
                                "text": "De kiezers gingen massaal naar de stembureaus om hun stem uit te brengen.",
                                "translation": "The voters went massively to the polling stations to cast their vote.",
                                "english": "The voters went massively to the polling stations to cast their vote."
                            }
                        ]
                    }
                ],
