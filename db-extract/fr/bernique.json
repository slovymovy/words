        "fr-extract.jsonl": [
            {
                "entry_id": "220117b7-a737-324d-8589-2945597a02d2",
                "word": "bernique",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "847c1b5e-b5e6-364d-af14-3786534d0079",
                        "entry_id": "220117b7-a737-324d-8589-2945597a02d2",
                        "glosses": [
                            "Non, rien."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9c478752-ba83-4c1d-92fa-bc99606c42c3",
                                "sense_id": "847c1b5e-b5e6-364d-af14-3786534d0079",
                                "text": "Lucienne. — Aussi bien ai-je agi envers vous, comme je voudrais qu’on agisse avec moi si jamais mon mari…\nRedillon, avec découragement. — Oh ! oui !… mais lui, bernique !"
                            },
                            {
                                "example_id": "24b69720-94a7-42e0-9e6b-dd57ce557a40",
                                "sense_id": "847c1b5e-b5e6-364d-af14-3786534d0079",
                                "text": "Une petite balle là-dedans, et tu auras beau implorer les mânes de ton père… bernique ! pas un sou pour la Josette !"
                            },
                            {
                                "example_id": "3c7bdcab-80ec-492d-b743-fcb6aef891bf",
                                "sense_id": "847c1b5e-b5e6-364d-af14-3786534d0079",
                                "text": "Je leur donnais des cigares et ils n’aimaient pas le tabac. Alors, bernique, c’est fini. Plus de cadeaux."
                            },
                            {
                                "example_id": "d4ca0a09-6d78-419d-9806-672cf4c0028c",
                                "sense_id": "847c1b5e-b5e6-364d-af14-3786534d0079",
                                "text": "C’est alors qu’on entrevoit ce qu’on aurait pu être, s’il n’avait pas fallu être ce qu’on est, et ce n’est pas tous les jours qu’il est donné de couper en quatre un cheveu de cette qualité. Car du moment que l’on vit, bernique."
                            },
                            {
                                "example_id": "8642cad8-5aae-465a-b088-bec808e7578c",
                                "sense_id": "847c1b5e-b5e6-364d-af14-3786534d0079",
                                "text": "10 juin 1940 – Elle m’a déjà fait essayer beaucoup de pentes quand nous faisions du ski mais quant à essayer la vie pour lui dire quel goût elle a, bernique ! Qu’elle s’y frotte et s’y pique."
                            },
                            {
                                "example_id": "cdfa67b2-81c7-4373-9d75-5c11558fa6d7",
                                "sense_id": "847c1b5e-b5e6-364d-af14-3786534d0079",
                                "text": "Oh, certes, elle se fût fouillé d’une pièce ou deux et vous les eût plantées, l’affaire achevée, dans la paume avec un mot de grâces et une mine dégoûtée, mais quant à vous allouer mieux, bernique."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cf24a589-b23a-30d2-9026-5da88d332c13",
                "word": "bernique",
