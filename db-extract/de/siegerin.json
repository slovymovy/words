                "senses": [
                    {
                        "sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                        "entry_id": "507adfc2-3ef7-32b0-ba59-c928bc2c98a5",
                        "glosses": [
                            "weibliche Person oder Mannschaft, die einen Sieg erringt; weibliche Person, die einen Kampf oder Wettkampf gewinnt oder gewonnen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed64c4ef-009a-4962-a3cb-624acd5064a9",
                                "sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                                "text": "Die Siegerin des heutigen Spiels wird nächste Woche gegen die Weltmeisterin antreten."
                            },
                            {
                                "example_id": "52f5ce31-79cb-4e9a-9014-ed767e368714",
                                "sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                                "text": "So interpretiert die islamistische Hamas das Wahlergebnis und sieht sich als heimliche Siegerin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe9742b-f119-47c2-bec7-f9309b28b012",
                        "source_entry_id": "507adfc2-3ef7-32b0-ba59-c928bc2c98a5",
                        "source_sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                        "source_sense_description": "weibliche Person oder Mannschaft, die einen Sieg erringt",
                        "target_lang_word": "winner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aeb983a-0c4b-35cc-99f2-7f0b65036ff4",
                                        "entry_id": "bc4bd296-b09f-36f5-90cf-6f31c4b6f31d",
                                        "glosses": [
                                            "One who has won or often wins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010799f3-1fba-4626-a555-4f29c2b686f4",
                                                "sense_id": "2aeb983a-0c4b-35cc-99f2-7f0b65036ff4",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            },
                                            {
                                                "example_id": "9c88eb86-7252-4e11-bf48-780c89618376",
                                                "sense_id": "2aeb983a-0c4b-35cc-99f2-7f0b65036ff4",
                                                "text": "Remember Rappin' Duke? Duh-ha, duh-ha\nYou never thought that hip-hop would take it this far\nNow I'm in the limelight 'cause I rhyme tight\nTime to get paid, blow up like the World Trade\nBorn sinner, the opposite of a winner\nRemember when I used to eat sardines for dinner"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdf4118-7c24-339d-813b-af2374903664",
                                        "entry_id": "bc4bd296-b09f-36f5-90cf-6f31c4b6f31d",
                                        "glosses": [
                                            "A point or goal that wins a competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25090263-76bf-4d3b-b2d8-4fd34c86d9f0",
                                                "sense_id": "4fdf4118-7c24-339d-813b-af2374903664",
                                                "text": "It was a fitting scoreline on the club's landmark anniversary, and appropriate that Van Persie should get the winner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f49c2cc6-d7a0-4010-9169-d788e57b1468",
                        "source_entry_id": "507adfc2-3ef7-32b0-ba59-c928bc2c98a5",
                        "source_sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                        "source_sense_description": "weibliche Person oder Mannschaft, die einen Sieg erringt",
                        "target_lang_word": "victor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "victor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "683a231a-541d-3fb9-a51e-dac3084795c0",
                                        "entry_id": "93be6433-a31b-3286-bdd9-d37de13f6418",
                                        "glosses": [
                                            "The winner in a fight or contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a90492-8165-40f8-89c7-ce428f297efb",
                                                "sense_id": "683a231a-541d-3fb9-a51e-dac3084795c0",
                                                "text": "City were also the victors on that occasion 56 years ago, winning 5-0, but this visit was portrayed as a measure of their progress against the 19-time champions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e5c5c6-b5f4-3f8e-bb24-1c88bdf0461f",
                                        "entry_id": "93be6433-a31b-3286-bdd9-d37de13f6418",
                                        "glosses": [
                                            "Alternative letter-case form of Victor from the NATO/ICAO Phonetic Alphabet."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbefead4-5a74-4378-ab43-507518a8b1f1",
                        "source_entry_id": "507adfc2-3ef7-32b0-ba59-c928bc2c98a5",
                        "source_sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                        "source_sense_description": "weibliche Person oder Mannschaft, die einen Sieg erringt",
                        "target_lang_word": "vainqueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vainqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a27b357-c413-3848-94ca-23e9146bf969",
                                        "entry_id": "d58be418-be1a-37f5-a9f9-ce6670b38aef",
                                        "glosses": [
                                            "Personne ayant remporté une bataille ou une guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431b40c3-a8bc-4aaf-9251-aa17cb8828f6",
                                                "sense_id": "3a27b357-c413-3848-94ca-23e9146bf969",
                                                "text": "Tant que l’homme ne fut pas capable de produire plus que le strict nécessaire à sa survivance, les vainqueurs ne pouvaient que mettre en fuite et massacrer les vaincus, et s’emparer des aliments récoltés."
                                            },
                                            {
                                                "example_id": "124c756c-4606-44ed-93bd-59dc6610f84f",
                                                "sense_id": "3a27b357-c413-3848-94ca-23e9146bf969",
                                                "text": "En aviation, c’est comme à la guerre: celui qui tient le plus longtemps est le vainqueur certain."
                                            },
                                            {
                                                "example_id": "f53ae56a-ef84-42c4-ba37-8c367c21cde5",
                                                "sense_id": "3a27b357-c413-3848-94ca-23e9146bf969",
                                                "text": "Si, lors de la distribution des dépouilles, les vainqueurs ont appliqué aux vaincus la brutale formule du væ victis, cela ne veut pas dire que dans leur camp même le principe égalitaire ait été respecté."
                                            },
                                            {
                                                "example_id": "4818f788-81ad-4ba6-9444-d01aeefdc56e",
                                                "sense_id": "3a27b357-c413-3848-94ca-23e9146bf969",
                                                "text": "En général, les vainqueurs refusent le mariage légal avec les vaincus, sinon avec quelques membres de l’élite des vaincus pour favoriser sa résignation."
                                            },
                                            {
                                                "example_id": "59b38b43-ebbb-4a03-b059-44064bdfc821",
                                                "sense_id": "3a27b357-c413-3848-94ca-23e9146bf969",
                                                "text": "L’histoire est toujours écrite par les vainqueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a082fd-7a1d-360d-9871-1640bedbce9e",
                                        "entry_id": "d58be418-be1a-37f5-a9f9-ce6670b38aef",
                                        "glosses": [
                                            "Personne ayant remporté une course, une compétition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d25354-1b4c-4cce-84e4-09ee9a8fa0a8",
                                                "sense_id": "61a082fd-7a1d-360d-9871-1640bedbce9e",
                                                "text": "Rivaux comme tous bons chasseurs, c’était à qui raserait à l’autre le lièvre indiqué, et le roulé subissait naturellement les quolibets du vainqueur."
                                            },
                                            {
                                                "example_id": "d11845a9-057d-4bad-82a6-f5628ff10857",
                                                "sense_id": "61a082fd-7a1d-360d-9871-1640bedbce9e",
                                                "text": "Les flûtes, l’une après l’autre, inventent et modulent de gracieuses variations, comme pour célébrer joyeusement la virtuosité du vainqueur."
                                            },
                                            {
                                                "example_id": "81be9df8-17bd-4b75-bea2-47117ff8c2b6",
                                                "sense_id": "61a082fd-7a1d-360d-9871-1640bedbce9e",
                                                "text": "Non, non, généralement les mecs ont été : soit vainqueur du rallye automobile de Tataouine-les-Bains ; soit vainqueur du critérium de Trifouillis-les-Oies ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc386a1-5eb5-31aa-9037-c0b3d352b74e",
                                        "entry_id": "d58be418-be1a-37f5-a9f9-ce6670b38aef",
                                        "glosses": [
                                            "Personne qui surmonte des obstacles, qui dompte des passions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37d6895-c479-44ca-91f3-85c297aa77c6",
                                                "sense_id": "fbc386a1-5eb5-31aa-9037-c0b3d352b74e",
                                                "text": "Le vainqueur laisse au loin la tourbe des lassables, ceux qui ont admis des murailles et que l’empêchement arrête ; seul, il a droit à nos palpitantes pitiés, car lui aussi se fatigua mais bien davantage; […]."
                                            },
                                            {
                                                "example_id": "81e03f71-2bae-48af-bfd2-9ad22fd1205f",
                                                "sense_id": "fbc386a1-5eb5-31aa-9037-c0b3d352b74e",
                                                "text": "Le sage est vainqueur de ses passions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vainqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfbaa598-6210-3282-85bc-49ac28227542",
                                        "entry_id": "9a92234e-c202-3447-9436-a38c42eceab8",
                                        "glosses": [
                                            "Qui a vaincu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ae12cc-3025-4b78-9612-bb0202f85ba2",
                                                "sense_id": "cfbaa598-6210-3282-85bc-49ac28227542",
                                                "text": "Plusieurs blâmaient la cruauté de Flamiuius, qui, pour emporter la gloire de quelque grand acte , comme il lui semblait, avait été cause de faire mourir un homme déjà tout cassé de vieillesse, qui n’eût désormais plus su porter aucun dommage à leur chose publique vainqueresse presque de toutes nations."
                                            },
                                            {
                                                "example_id": "75f2bb92-b96d-4ea3-9527-e5ea0d95e0ac",
                                                "sense_id": "cfbaa598-6210-3282-85bc-49ac28227542",
                                                "text": "Après la guerre, le traité de Versailles avait alors contraint l’Allemagne à céder ses colonies aux nations vainqueurs."
                                            },
                                            {
                                                "example_id": "45ffa914-0990-4518-9f71-064c2bf2a454",
                                                "sense_id": "cfbaa598-6210-3282-85bc-49ac28227542",
                                                "text": "Les représentants des pays vainqueurs mettent en place les décisions prises pour la nouvelle Europe lors du Congrès de Vienne. Le Traité de Paris du 20 novembre 1815 redessine les frontières de la France qui est contrainte de verser une indemnité aux pays vainqueurs."
                                            },
                                            {
                                                "example_id": "266391ae-e836-4195-b81a-c6aa190dc209",
                                                "sense_id": "cfbaa598-6210-3282-85bc-49ac28227542",
                                                "text": "En Brabant wallon, c’est donc l’école communale de Rebecq qui s’en est sortie vainqueuse."
                                            },
                                            {
                                                "example_id": "3d77848b-cc8d-4126-92b9-fd735427f975",
                                                "sense_id": "cfbaa598-6210-3282-85bc-49ac28227542",
                                                "text": "Un charme vainqueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddaf43ba-ad66-3f20-bbfe-8cd6d0f09759",
                                        "entry_id": "9a92234e-c202-3447-9436-a38c42eceab8",
                                        "glosses": [
                                            "Qualifie un port ou un air de suffisance, de satisfaction ou de triomphe."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54b0d180-612a-4427-a05e-c3664c0047d3",
                                                "sense_id": "ddaf43ba-ad66-3f20-bbfe-8cd6d0f09759",
                                                "text": "En vain je parcourais les promenades d’un petit air vainqueur ; je me dandinais, je frappais l’air de ma badine d’ébène, j’arrangeais mes cheveux, je dérangeais ma cravate ; en un mot, je me donnais des grâces : rien n’y faisait."
                                            },
                                            {
                                                "example_id": "97747e89-3459-499e-833f-3f7d232fd9c7",
                                                "sense_id": "ddaf43ba-ad66-3f20-bbfe-8cd6d0f09759",
                                                "text": "Non que j’aie le dernier mot : d’habitude, avec déférence, je le leur laisse, mais alors ils savent eux-mêmes que c’est un mot et se composent un visage vainqueur à si grand renfort de tics que c’en est pitié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25a56f91-516c-4f03-9733-366600e8f572",
                        "source_entry_id": "507adfc2-3ef7-32b0-ba59-c928bc2c98a5",
                        "source_sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                        "source_sense_description": "weibliche Person oder Mannschaft, die einen Sieg erringt",
                        "target_lang_word": "победительница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "победительница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98926c43-4e21-3768-bcac-3c415dd4ea2f",
                                        "entry_id": "5344803e-cdf1-399f-ab47-2a4fb557a3f9",
                                        "glosses": [
                                            "женск. к победитель — та, кто побеждает, одерживает верх или добивается успеха в борьбе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540c3517-d516-4e51-95b5-344ef6fd70a6",
                                                "sense_id": "98926c43-4e21-3768-bcac-3c415dd4ea2f",
                                                "text": "И победительница была известна заранее, потому что — корона проплачена."
                                            },
                                            {
                                                "example_id": "c8af223f-c89b-4fa6-ac77-11e0dbccb23e",
                                                "sense_id": "98926c43-4e21-3768-bcac-3c415dd4ea2f",
                                                "text": "Девочка, победительница международной олимпиады по биологии, торопится заявить со сцены: из России я никуда не уеду, если здесь буду востребована."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62d97ce0-a5bd-461e-bddc-106e89b91b7f",
                        "source_entry_id": "507adfc2-3ef7-32b0-ba59-c928bc2c98a5",
                        "source_sense_id": "af677aea-9d85-3268-84d7-c67e925fe667",
                        "source_sense_description": "weibliche Person oder Mannschaft, die einen Sieg erringt",
                        "target_lang_word": "vítězka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
