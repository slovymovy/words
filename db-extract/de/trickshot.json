                "senses": [
                    {
                        "sense_id": "ca0c62f6-935e-3cb2-85aa-7288f28ca99d",
                        "entry_id": "843f2dfd-f501-3157-ad89-bdf60f384707",
                        "glosses": [
                            "unkonventioneller Stoß, Schlag oder Schuss, der einen hohen Unterhaltungswert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5fb109-5f25-48a6-a6cc-ec301c21dd81",
                                "sense_id": "ca0c62f6-935e-3cb2-85aa-7288f28ca99d",
                                "text": "„Mal wieder hat Dustin Brown mit einem Trickshot für Furore gesorgt.“"
                            },
                            {
                                "example_id": "6c00da41-8f7e-4ef1-8dc4-9c532dc31763",
                                "sense_id": "ca0c62f6-935e-3cb2-85aa-7288f28ca99d",
                                "text": "„Die Fußball-Stars üben sich weiter in Trickshots: Tore aus unmöglichen Positionen.“"
                            },
                            {
                                "example_id": "c9284117-6560-48be-a7f5-46c17c348140",
                                "sense_id": "ca0c62f6-935e-3cb2-85aa-7288f28ca99d",
                                "text": "„Als er einen ausgefeilten Trickshot mit Bravour meistert, ist er sogar von sich selbst ein wenig überrascht […].“"
                            },
                            {
                                "example_id": "bd96d855-1acf-4bc2-8958-5692e06566f2",
                                "sense_id": "ca0c62f6-935e-3cb2-85aa-7288f28ca99d",
                                "text": "„Wie bei jedem Trickshot, bedarf es an Konzentration und Geduld. Einige Tricks sind schnell im Kasten, andere jedoch sind manchmal sehr nervenraubend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
