                                        "entry_id": "84143cce-aa88-33da-b186-9c6f4291ece9",
                                        "glosses": [
                                            "na geruime tijd opnieuw zien"
                                        ],
                                        "tags": [
                                            "formal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecac613d-b4f4-481f-9ad9-14c5cb2a5dbf",
                                                "sense_id": "3d7b9a16-b1c0-3b46-a864-a9bf9ce5d69a",
                                                "text": "Redenen te meer om zijn vertrek niet langer uit te stellen, opdat hij althans zijn andere familieleden zou kunnen weerzien, voordat het lot verdere slagen had uitgedeeld."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weerzien",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "42015359-beb1-3dc5-a329-a24045d659d8",
                                        "entry_id": "edcba561-c872-30e3-8768-9094cd59f417",
                                        "glosses": [
                                            "ontmoeting lang na de voorgaande ontmoeting met dezelfde persoon"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24ce623-4f7f-4479-b8aa-57a49ef9807a",
                                                "sense_id": "42015359-beb1-3dc5-a329-a24045d659d8",
                                                "text": "Hij had een aangenaam weerzien met zijn oude liefde."
                                            },
                                            {
                                                "example_id": "97b06fa8-58ed-412c-b523-21d885b0d742",
                                                "sense_id": "42015359-beb1-3dc5-a329-a24045d659d8",
                                                "text": "„Sommige gezichten zijn nieuw, met anderen is het een weerzien,” vertelt de burgemeester. Als wethouder was hij in 2001 verantwoordelijk voor de wederopbouw van de Enschedese wijk. Nu is hij terug als burgervader. Hij kent het verhaal, hij kent het litteken. De mensen vertrekken bij het monument. Het is weer stil in Roombeek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
