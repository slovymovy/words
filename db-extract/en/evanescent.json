    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                "word": "evanescent",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9dcf5719-dc35-4ef8-aa75-20c01b3fb59b",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more evanescent"
                    },
                    {
                        "form_id": "37d37578-31e7-41c9-b44f-70d5853bb4ca",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most evanescent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bae414a4-0a80-3ed9-93cc-2babc911dfe8",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "glosses": [
                            "Disappearing, vanishing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a479e76-99da-45d5-a52d-af43113485b9",
                                "sense_id": "bae414a4-0a80-3ed9-93cc-2babc911dfe8",
                                "text": "He cannot ſuppreſs his diſapprobation […] of thoſe evaneſcent echoes of ſchool philoſophy, faint-warbling through the grove of letters, to the injury of natural and ſcientific knowledge, and the annoyance of English literature."
                            },
                            {
                                "example_id": "9b434511-0d09-4809-89f2-3affd6c19251",
                                "sense_id": "bae414a4-0a80-3ed9-93cc-2babc911dfe8",
                                "text": "The sea was each little bird's great playmate. […] In their airy flutterings, they seemed to rest on the evanescent spray."
                            },
                            {
                                "example_id": "d840733e-06a5-4b2d-8e00-d9a5f16ef1d2",
                                "sense_id": "bae414a4-0a80-3ed9-93cc-2babc911dfe8",
                                "text": "I trust your love which will work wonders; and I trust my own, which sprang at a look but only gathered strength and permanence when I found that the soul of the man I love bettered his outward attractions, making the ideal of my foolish girlhood seem as unsubstantial and evanescent as a dream in the glowing noontide."
                            }
                        ]
                    },
                    {
                        "sense_id": "4610f339-cdf3-3a07-a418-2ecec132e702",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "glosses": [
                            "Disappearing, vanishing.",
                            "Of an oscillating electric or magnetic field: not propagating as an electromagnetic wave but having its energy spatially concentrated in the vicinity of its source."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af57dd35-10e2-4de5-951f-504279b78ec8",
                                "sense_id": "4610f339-cdf3-3a07-a418-2ecec132e702",
                                "text": "Consequently, the electromagnetic fields have plane-wave characteristics in local regions, except immediately adjacent to a caustic where there is a rapid transition from the wavelike behavior of the local plane-wave fields to the evanescent behavior beyond the ray path."
                            },
                            {
                                "example_id": "9bee0406-b9ad-4a13-ba8c-c00ecaa436cf",
                                "sense_id": "4610f339-cdf3-3a07-a418-2ecec132e702",
                                "text": "The analyte directly affects the optical properties of a waveguide, such as evanescent waves (electromagnetic waves generated in the medium outside the optical waveguide when light is reflected from within) or surface plasmons (resonances induced by an evanescent wave in a thin film deposited on a waveguide surface)."
                            }
                        ]
                    },
                    {
                        "sense_id": "a221575d-4699-3b4b-bb05-fc312e61dec3",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "glosses": [
                            "Disappearing, vanishing.",
                            "Of a number or value: diminishing to the point of reaching zero as a limit; infinitesimal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e6b302-d5e1-4273-93a7-57e75dc0d503",
                                "sense_id": "a221575d-4699-3b4b-bb05-fc312e61dec3",
                                "text": "[…] I choſe rather to reduce the demonſtrations of the following propoſitions to the firſt and laſt ſums and ratio's of naſcent and evaneſcent quantities, that is, to the limits of thoſe ſums and ratio's; […] Perhaps it may be objected, that there is no ultimate proportion of evaneſcent quantities; becauſe the proportion, before the quantities have vaniſhed, is not the ultimate, and when they are vaniſhed, is none. […] [B]y the ultimate ratio of evaneſcent quantities is to be underſtood the ratio of the quantities, not before they vaniſh, nor afterwards, but with which they vaniſh."
                            },
                            {
                                "example_id": "0397552e-0b2f-4c39-8666-05328eac6dee",
                                "sense_id": "a221575d-4699-3b4b-bb05-fc312e61dec3",
                                "text": "And what are theſe Fluxions? The Velocities of evaneſcent Increments? And what are theſe ſame evaneſcent Increments? They are neither finite Quantities, nor Quantities infinitely ſmall, nor yet nothing. May we not call them the Ghoſts of departed Quantities?"
                            },
                            {
                                "example_id": "e52d2cf8-e7c5-47b5-8be4-24abf49a8eec",
                                "sense_id": "a221575d-4699-3b4b-bb05-fc312e61dec3",
                                "text": "Some hold the evaneſcent increments to be real quantities, ſome to be nothings, ſome to be limits. As many Men, ſo many minds: Each differing one from another, and all from Sir Iſaac Newton."
                            },
                            {
                                "example_id": "791e1216-0fb4-4e4c-8087-7cb1e6a565f0",
                                "sense_id": "a221575d-4699-3b4b-bb05-fc312e61dec3",
                                "text": "[Leonhard] Euler emphasized that the derivative is the ratio of the evanescent differentials and said that the integral calculus was concerned with finding the function itself."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "glosses": [
                            "Barely there; almost imperceptible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb779bc-b687-4529-ad74-625e36efaef0",
                                "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                                "text": "If the Fluids moving in an Evaneſcent Artery [i.e., a capillary] appear Globular, I ſuppose its becauſe the Canal is round, which alters the Caſe much."
                            },
                            {
                                "example_id": "d446d5c6-88b0-40ca-bff5-7c870f80c586",
                                "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                                "text": "Here are Sholes and Sholes, of various Characters, and of the moſt diverſified Sizes; from the gigantic Whale, whoſe flouncings \"tempeſt the Ocean,\" to the evaneſcent Anchovy, whoſe Subſtance diſſolves in the ſmalleſt Fircaſſee."
                            },
                            {
                                "example_id": "e2a8b8ee-99d8-4f53-b2e4-fb774492ed11",
                                "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                                "text": "Her face too was fresh in colour, but it was of a totally different quality—soft and evanescent, like the light under a heap of rose-petals."
                            },
                            {
                                "example_id": "d3f275df-f0be-4e82-bb44-498431e165e4",
                                "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                                "text": "While he was speaking the hands on the face of the clock behind the great man's back—a heavy, glistening affair of massive scrolls in the same dark marble as the mantelpiece, and with a ghostly, evanescent tick—had moved through the space of seven minutes."
                            },
                            {
                                "example_id": "a454e9d5-10aa-4411-b1e8-022a5604f7ec",
                                "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                                "text": "If in the middle of summer the water of Turkey Creek […] is whipped and beaten with a stick, and then if a fire-brand is passed over, a mist is enkindled and a faint evanescent flame runs over the entire width of the brook."
                            },
                            {
                                "example_id": "71c90825-7276-4045-898c-79123c2d36d4",
                                "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                                "text": "And I was pale, and clear, and evanescent, like the light, and they were dark, and close, and constant, like the shadow."
                            },
                            {
                                "example_id": "28a81c56-1a73-42cf-bbe1-e5905074e6ea",
                                "sense_id": "8a339dd0-55c8-3b2c-b1b0-fca85fe1b833",
                                "text": "If we could remove everything from a piece of space, […] then there would still be quantum fluctuations of fields and virtual particles, bouncing to and fro against the wall of nothing. Ironically enough, this piece of space, filled with so many evanescent entities, is nowadays called vacuum. However, this vacuum is not nothing. It is a quantum vacuum to which the argument of the Ancient Greeks does not apply."
                            }
                        ]
                    },
                    {
                        "sense_id": "abbf0d95-dbff-3566-9c03-bc8717da951c",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "glosses": [
                            "Ephemeral, fleeting, momentary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a844a78-fdf6-4628-b3ce-bcd46a321b94",
                                "sense_id": "abbf0d95-dbff-3566-9c03-bc8717da951c",
                                "text": "It is to be obſerved, farther, that when we annihilate any thing in our Mind, we conſider it as ſomething evaneſcent, and removed out of Sight; […]"
                            },
                            {
                                "example_id": "80853b17-bab2-4aa2-ac44-d2c81a0386ca",
                                "sense_id": "abbf0d95-dbff-3566-9c03-bc8717da951c",
                                "text": "But alas! how momentary was the bliss!—the evaneſcent viſion ſoon fled, and the youthful queen [Mary, Queen of Scots] was arrayed in the melancholy garb of widowhood!"
                            },
                            {
                                "example_id": "5519a8ed-5379-44e6-9f71-a7a6b21da355",
                                "sense_id": "abbf0d95-dbff-3566-9c03-bc8717da951c",
                                "text": "She comforted him by words of the happiest import, uttered in low tones—but words that sealed their impress on the memory and the heart; but she was now so worn, and appeared so evanescent, that every instant he feared she would expire before him. Isabella saw his suffering, and suggested that \"he had better depart—she would herself remain.\""
                            },
                            {
                                "example_id": "149030cb-e95d-4275-ac15-295c59ef80ef",
                                "sense_id": "abbf0d95-dbff-3566-9c03-bc8717da951c",
                                "text": "In times of strong emotion mankind disdain all base considerations; but such times are evanescent. The permanent constitutional condition of the manufactured man, thought Ahab, is sordidness."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac190206-fd9b-3264-b5e7-e423a9b16771",
                        "entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "glosses": [
                            "Ephemeral, fleeting, momentary.",
                            "Of plant parts: shed after a period."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6314a877-68c2-400b-a1bf-f984a40422ca",
                                "sense_id": "ac190206-fd9b-3264-b5e7-e423a9b16771",
                                "text": "Upward it [the \"apennine adonis\", probably the Pyrenean pheasant's eye (Adonis pyrenaica)] is of a pale green, with ſome Tinge of yellowiſh; and it is all the Way duſted with little grey tranſparent Globules. Theſe are the Extremities of ſo many round evaneſcent ſecretory Ducts; as the Hairs of other Plants are the more permanent Extremities of theirs."
                            },
                            {
                                "example_id": "816bf508-a1ef-4555-affa-98f7ddcae7e3",
                                "sense_id": "ac190206-fd9b-3264-b5e7-e423a9b16771",
                                "text": "Per[ianth]. Berry from the receptacle elongated into a cup globular, ſucculent, gaging at the top, colour'd, at length waſting from dryneſs, evaneſcent."
                            },
                            {
                                "example_id": "301f1722-2f7f-4d3d-98fa-c7723513a8c3",
                                "sense_id": "ac190206-fd9b-3264-b5e7-e423a9b16771",
                                "text": "Leaves solitary or numerous, sometimes evanescent or rarely wanting, radical or cauline, alternate or occasionally whorled, simple, varying from a sheathing bract to a definite blade which is membranaceous, papyraceous, coriaceous or fleshy, flat or plicate, usually parallel-veined."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da5cfb8d-2a7d-46d1-a168-8d6af6adeab6",
                        "source_entry_id": "04062e8b-936a-3ac4-9277-ec2abb1ea0c3",
                        "source_sense_description": "disappearing, vanishing — see also disappearing, vanishing",
                        "target_lang_word": "évanescent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évanescent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71072d14-f9ea-3f99-a026-dd9df5b64ed6",
                                        "entry_id": "964058db-2032-3fe6-a228-0b753c955a7b",
                                        "glosses": [
                                            "Susceptible de facilement disparaître, de s’évanouir sans cesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e707bd-a1e4-43d5-a516-2407947264de",
                                                "sense_id": "71072d14-f9ea-3f99-a026-dd9df5b64ed6",
                                                "text": "Amroth vit la rive évanescente à présent basse derrière la houle."
                                            },
                                            {
                                                "example_id": "f61ad0c8-69b6-4d71-b887-a8f05d536ff3",
                                                "sense_id": "71072d14-f9ea-3f99-a026-dd9df5b64ed6",
                                                "text": "Notre personnalité était dans un état évanescent, avec des sursauts brusques de la mémoire, un appel lointain des sens, des irradiations du subconscient, des appétits dégénérés, une lassitude insidieuse."
                                            },
                                            {
                                                "example_id": "6b68489e-bf32-4364-bddc-4607d0b9ac79",
                                                "sense_id": "71072d14-f9ea-3f99-a026-dd9df5b64ed6",
                                                "text": "La fumée de sa cigarette stagne un moment, arrêtée par le bord de son chapeau, l’enveloppe d’un nimbe évanescent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf25508-1dda-3894-9ef2-c09493eb928b",
                                        "entry_id": "964058db-2032-3fe6-a228-0b753c955a7b",
                                        "glosses": [
                                            "Difficile à cerner, fuyant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe013304-c425-4bc8-b552-d66dbd05c9f0",
                                                "sense_id": "0cf25508-1dda-3894-9ef2-c09493eb928b",
                                                "text": "Elle fut aussi l'occasion pour les tribunaux supérieurs de se pencher, encore une fois, sur l'évanescent critère introduit dans le Code criminel : « ne pas miner la confiance du public envers l'administration de la justice »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "évanescent",
                                "target_lang_code": "fr",
                                "target_senses": [
