        "de-extract.jsonl": [
            {
                "entry_id": "d6c610f9-dc34-3702-bfb1-4f0269ce77a7",
                "word": "Hochwürden",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "869cc69c-8309-4512-b6a4-68bc4b664559",
                        "entry_id": "d6c610f9-dc34-3702-bfb1-4f0269ce77a7",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "Hochwürdens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d85706e-c5e9-39a9-982d-f362ac4450dd",
                        "entry_id": "d6c610f9-dc34-3702-bfb1-4f0269ce77a7",
                        "glosses": [
                            "ehrenvoller Titel und Anrede für (katholische) Priester sowie höhere evangelische Geistliche (auch „Euer Hochwürden“)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21461064-902a-40ef-a5f2-45718b28f218",
                                "sense_id": "2d85706e-c5e9-39a9-982d-f362ac4450dd",
                                "text": "„Und wenn sie trotzdem kommen, Hochwürden?“ (…) „Ist’s wahr, Hochwürden, was die Leute sagen?“ [S. 13]\n„Wovon, Hochwürden, sollen wir sprechen?“ (…) „Stimmt das, Hochwürden, daß ich anders bin als alle?“ [S. 56]\n„Hochwürden irren sich, glaub ich.“ (…) „Aber ich kann nicht anders, Hochwürden, es ist so.“ (…) „Und Hochwürden meinen ja auch, ich habe etwas Gehetztes.“ (…) „Was, Hochwürden, will man von mir?“ [S. 57]\n„Ich bin nicht feig – und nicht gescheiter als die andern, Hochwürden, ich will nicht, daß Hochwürden das sagen.“ [S. 58]\n„Ich hab so etwas Gehetztes, ich weiß, Hochwürden haben ganz recht.“ [S. 78]\n„Und es ist so, Hochwürden: Ich bin anders (…) Hochwürden haben gesagt, man muss das annehmen, und ich hab’s angenommen. Jetzt ist es an euch, Hochwürden, euren Jud anzunehmen.“ [S. 80]\nAus Max Frischs Drama „Andorra“ (Plural)"
                            },
                            {
                                "example_id": "76e4a17a-4583-4f79-9bf1-45a35d718983",
                                "sense_id": "2d85706e-c5e9-39a9-982d-f362ac4450dd",
                                "text": "„Natürlich, beste Frau, sagte die alte Lemballeuse, die dicht neben Hubertine stand, er ist der Sohn Hochwürdens!“ (Genitiv)"
                            },
                            {
                                "example_id": "a2e92ab4-e9d8-4f02-9e35-b66c4d647802",
                                "sense_id": "2d85706e-c5e9-39a9-982d-f362ac4450dd",
                                "text": "„Seltsam hatte sie den alten Hochwürden da angeschaut mit einem strahlenden, immerzu zuversichtlichen und einem überaus traurigen und bedrängten Auge.“ (Maskulinum)"
                            },
                            {
                                "example_id": "b212e639-e0f2-4c89-8073-ffddf5d1e1bf",
                                "sense_id": "2d85706e-c5e9-39a9-982d-f362ac4450dd",
                                "text": "„Der ehrwürdige Hochwürden hatte ein Bett einbauen lassen, […]“ (Maskulinum)"
                            },
                            {
                                "example_id": "5c34ae8c-bee9-4ac6-a727-131bf160d099",
                                "sense_id": "2d85706e-c5e9-39a9-982d-f362ac4450dd",
                                "text": "„Naja, aber die hätte es wahrscheinlich auch dann nicht gegeben, wenn Hochwürden zu Hause gewesen wären.“ (Plural)"
                            },
                            {
                                "example_id": "3461625b-288e-4662-88ad-a6b3d94e071c",
                                "sense_id": "2d85706e-c5e9-39a9-982d-f362ac4450dd",
                                "text": "„Wir überlassen es vorerst der gütlichen Vereinbarung zwischen Ehrwürdigen Hochwürden und Kaplan Krautscheidt, was und unter welchen Bedingungen eine Rückerstattung erfolgen soll.“ (Plural)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
