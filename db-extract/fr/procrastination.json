                        "sense_id": "90734f8d-e28c-37ec-b117-951c5327c9dc",
                        "entry_id": "fa6946b8-d954-3212-9e52-06667c3a1cbc",
                        "glosses": [
                            "Aufschiebung, Aufschub, Rückstellung, Verschiebung, Vertagung, Verzögerung, Zurückstellung"
                        ],
                        "tags": [
