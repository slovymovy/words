                                        "sense_id": "27b5530a-1f74-3787-a6b7-8e14649986f2",
                                        "entry_id": "98320d42-ab52-3c37-856b-3c5570fcb477",
                                        "glosses": [
                                            "Reminiscent of a volcano; explosive, violent, full of suppressed anger, energy etc."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7bce78d-5215-4887-b8d4-e19e3957c9f1",
                                                "sense_id": "27b5530a-1f74-3787-a6b7-8e14649986f2",
                                                "text": "Jo rose indignified, Vanessa following in her volcanic wake."
                                            },
                                            {
                                                "example_id": "20bb9de5-8020-4e40-a2e5-9b63a7cb921d",
                                                "sense_id": "27b5530a-1f74-3787-a6b7-8e14649986f2",
                                                "text": "With that the system was complete, and ready to have its disastrous effect on Martin Luther's volcanic temper."
                                            }
                                        ]
