                                    {
                                        "sense_id": "ae7af454-8906-3328-9203-c8d9970316b4",
                                        "entry_id": "42eeec09-66bd-3394-ba21-2cda4af03e33",
                                        "glosses": [
                                            "The study of the elderly, and of the aging process itself."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "439cb7b4-49f4-354f-86f4-2f4aa85c25a2",
                                        "entry_id": "42eeec09-66bd-3394-ba21-2cda4af03e33",
                                        "glosses": [
                                            "The branch of science that deals with the problems of aged people. It is to be distinguished from geriatrics, which is the study of the diseases of the elderly. Gerontology covers the social, psychological and biological aspects of aging."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c113129f-1653-471c-a1c1-e2fe280559a2",
                        "source_entry_id": "dec76891-1c6b-3446-b734-102bc9001317",
                        "source_sense_id": "46e6fa26-5066-32d0-93f4-8ab1227f1446",
                        "source_sense_description": "tak van wetenschap die het \"ouder worden\" bestudeert",
                        "target_lang_word": "gérontologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gérontologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69f54947-f74d-380a-ad16-06bba0d0a90b",
                                        "entry_id": "ee2beb91-df8b-3609-84fa-c6e42cd3bff3",
                                        "glosses": [
                                            "Étude du vieillissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e86280-f62a-41a5-b14c-24765498bdfb",
                                                "sense_id": "69f54947-f74d-380a-ad16-06bba0d0a90b",
                                                "text": "Le gériatre de secteur doit être une médecin qualifié en gérontologie. Ceci implique une formation médicale gériatrique d'une part, et médico-sociale d'autre part."
                                            },
                                            {
                                                "example_id": "d41aa1ff-0405-4643-9e87-e651a657d475",
                                                "sense_id": "69f54947-f74d-380a-ad16-06bba0d0a90b",
                                                "text": "En pratique, on distingue la gérontologie biologique (parfois qualifiée d’expérimentale), la gérontologie clinique (ou gériatrie), à laquelle on peut rattacher l’approche psychologique, et la gérontologie sociale."
                                            },
                                            {
                                                "example_id": "fcdf9d94-d0fd-4d16-9870-76dc9e1abb2f",
                                                "sense_id": "69f54947-f74d-380a-ad16-06bba0d0a90b",
                                                "text": "La gérontologie recouvre les disciplines et les sciences diverses s’intéressant au vieillissement : biologie, psychologie, sociologie, démographie, santé publique, économie de la santé, administration de la santé, éducation, droit, architecture…"
                                            },
                                            {
                                                "example_id": "0a058861-57c6-442a-844d-996f61ca911d",
                                                "sense_id": "69f54947-f74d-380a-ad16-06bba0d0a90b",
                                                "text": "La gérontologie est beaucoup plus vaste et englobe la gériatrie. « La gérontologie comprend toutes les disciplines qui s’intéressent au champ du vieillissement : économie de la santé, psychologie, sociologie, philosophie, socio-économie, démographie, éthique, droit… », informe le Pr Salles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
