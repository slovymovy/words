                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bafb467-1275-42e1-bc32-5d007eef8998",
                                                "sense_id": "42241fc4-7897-3055-8dcb-340c1c56ed30",
                                                "text": "The legend displacement on the basis then in use was 48,000 tons, the corresponding standard displacement as defined by the Washington Treaty being 47,540 tons."
                                            },
                                            {
                                                "example_id": "ed6b6e82-dc75-46ac-b2a0-b63c596f3dbb",
                                                "sense_id": "42241fc4-7897-3055-8dcb-340c1c56ed30",
                                                "text": "The legend and sketch designs were submitted to the Board on 27th March 1916 and, after examining a model and the drawings, the Sea Lords generally favoured proposal 'B'; the extra weight involved being acceptable."
                                            }
                                        ]
                                    }
                                ]
