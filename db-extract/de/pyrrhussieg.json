                    },
                    {
                        "translation_id": "8117b2d3-ce22-4601-b159-c1c918fd39a2",
                        "source_entry_id": "e73840cc-ae09-30ea-9cfe-bd6c25b1398f",
                        "source_sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                        "source_sense_description": "ein unter (äußerst) hohem Einsatz und unter (zu großen) Opfern errungener Erfolg",
                        "target_lang_word": "Pyrrhic victory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyrrhic victory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db15dca8-2942-3236-9f70-709d38d1e425",
                                        "entry_id": "ab83a1a4-ca63-3885-bbb8-b4c61005fcea",
                                        "glosses": [
                                            "A very costly victory, wherein the considerable losses outweigh the gain, so as to render the struggle not worth the cost."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696d6f07-253b-4f9b-961e-b163e8d3d792",
                                                "sense_id": "db15dca8-2942-3236-9f70-709d38d1e425",
                                                "text": "Tough pensions regulation designed to protect employees in final-salary occupational schemes will prove a pyrrhic victory for unions and the government, a report warned yesterday."
                                            },
                                            {
                                                "example_id": "b9411dd2-e008-4dda-8cbf-ba943f47d401",
                                                "sense_id": "db15dca8-2942-3236-9f70-709d38d1e425",
                                                "text": "We now know that it [the Six-Day War] was a Pyrrhic victory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5e715e9-d59a-4539-8b5b-6d563420690f",
                        "source_entry_id": "e73840cc-ae09-30ea-9cfe-bd6c25b1398f",
                        "source_sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                        "source_sense_description": "ein unter (äußerst) hohem Einsatz und unter (zu großen) Opfern errungener Erfolg",
                        "target_lang_word": "victoire à la Pyrrhus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "victoire à la Pyrrhus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c39aa3-bed7-36d7-a9e3-0880e07bddf5",
                                        "entry_id": "cdd88ab6-b73a-328f-803e-c6580a486524",
                                        "glosses": [
                                            "Victoire difficile, chèrement acquise, au résultat terrible pour le vainqueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7641c113-e5db-4e6e-af7e-57d544ef2542",
                                                "sense_id": "b9c39aa3-bed7-36d7-a9e3-0880e07bddf5",
                                                "text": "Les nationalistes comprirent cependant qu’ils avaient remporté une victoire à la Pyrrhus. Leurs calculs, furent, en effet, déjoués."
                                            },
                                            {
                                                "example_id": "0d3269d1-a0ad-46d5-bf61-9fd286137aef",
                                                "sense_id": "b9c39aa3-bed7-36d7-a9e3-0880e07bddf5",
                                                "text": "Vous avez l’air de croire que la victoire est désormais promise à la France, je le souhaite de tout mon cœur, vous n’en doutez pas, mais enfin depuis qu’à tort ou à raison les Alliés se croient sûrs de vaincre, (pour ma part je serais naturellement enchanté de cette solution mais je vois surtout beaucoup de victoires sur le papier, de victoire à la Pyrrhus avec un coût qui ne nous est pas dit), et que les Boches ne se croient plus sûrs de vaincre."
                                            },
                                            {
                                                "example_id": "5dc8ef6d-b148-47ef-a9fa-a2c096d1388b",
                                                "sense_id": "b9c39aa3-bed7-36d7-a9e3-0880e07bddf5",
                                                "text": "C’est une victoire à la Pyrrhus que Bruno Le Maire a remporté sur la Chambre, à l’instant T, mais pas sur l’inflation aussi véloce qu’un incendie."
                                            },
                                            {
                                                "example_id": "1e49bc35-d210-45db-9341-cb980d24bfa5",
                                                "sense_id": "b9c39aa3-bed7-36d7-a9e3-0880e07bddf5",
                                                "text": "Victoire à la Pyrrhus pour les Bleus. Malgré le succès historique (96-0) acquis par le XV de France contre la Namibie, la sortie sur blessure du maître à jouer Antoine Dupont, victime d’une fracture à la mâchoire, obscurcit l’horizon des Bleus pour la suite de la compétition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
