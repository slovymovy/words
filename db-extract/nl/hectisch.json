                        "examples": [
                            {
                                "example_id": "d5a1f1fd-f454-4a6d-8adc-5614b7d05b6a",
                                "sense_id": "51a89863-ade9-30ed-ac6c-b6e00ff7cfae",
                                "text": "De periode rond de verkiezingen was een zeer hectische tijd voor de politicus."
                            },
                            {
                                "example_id": "ea6c43e3-cadb-4f1a-819e-cd7e2c97bc29",
                                "sense_id": "51a89863-ade9-30ed-ac6c-b6e00ff7cfae",
                                "text": "De vroege ochtend is een hectische tijd in het huisgezin met 4 kleine kinderen en beide ouders die werken."
                            },
                            {
                                "example_id": "111d58ae-81d2-4995-abfb-6817dc7e6ca0",
                                "sense_id": "51a89863-ade9-30ed-ac6c-b6e00ff7cfae",
                                "text": "Maar deze wekelijkse bezoeken aan de kerk vormden een onderbreking in mijn hectische week en gaven me de gelegenheid om een pauze in te lassen en na te denken over mijn familie en vrienden."
                            }
                        ]
