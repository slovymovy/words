                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handgemenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
