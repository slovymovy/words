                                "ru": "Учитель <w>разрешил</w> использование словарей во время контрольной.",
                                "pl": "Nauczyciel <w>pozwolił</w> na używanie słowników podczas sprawdzianu.",
                                "de": "Der Lehrer hat die Verwendung von Wörterbüchern während der Prüfung <w>erlaubt</w>.",
                                "fr": "Le professeur a <w>autorisé</w> l'utilisation de dictionnaires pendant l'examen.",
                                "it": "L'insegnante ha <w>consentito</w> l'uso dei dizionari durante la verifica.",
                                "cs": "Učitel <w>povolil</w> používání slovníků během testu.",
                                "tr": "Öğretmen, sınav sırasında sözlük kullanımına <w>izin verdi</w>.",
                                "es": "El profesor ha <w>permitido</w> el uso de diccionarios durante el examen.",
                                "zh": "老师<w>允许</w>在考试期间使用词典。"
                            }
                        },
                        {
                            "text": "Mijn ouders hebben mij nooit <w>toegestaan</w> om laat thuis te komen.",
                            "target_lang_translations": {
