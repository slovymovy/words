                        "examples": [
                            {
                                "example_id": "a1be5cbb-47fb-4647-80d7-a2a521d4a740",
                                "sense_id": "66524f75-0a60-35e2-8ba6-1ada103341f2",
                                "text": "Bierbrouwer Heineken bevestigt met carnaval altijd een behoorlijke piek in de verkoop te zien. Maar als het feest weer is afgelopen hebben veel mensen toch behoefte aan wat balansdagen. Want de dip in de bieromzet direct na carnaval is ook significant, weet Heineken te melden."
                            },
                            {
                                "example_id": "1ca20991-a0e5-47eb-ab37-e3db9eaea6c5",
                                "sense_id": "66524f75-0a60-35e2-8ba6-1ada103341f2",
                                "text": "De bieromzet steeg overal, behalve in West-Europa. De groei zit vooral in Afrika (plus 17 procent), Latijns-Amerika en in Azië (plus 7,5 procent). In West-Europa was een daling te zien van 2,4 procent. Vooral in Portugal, Ierland en Nederland bleef de omzet achter."
                            }
                        ]
