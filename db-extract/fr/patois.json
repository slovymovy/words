                                                "example_id": "6f6cba93-68f5-4490-8dc2-4f9118869727",
                                                "sense_id": "36f7ee19-2c34-3342-ac40-c9a1e715b545",
                                                "text": "Marek mówi gwarą podhalańską."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "021ee425-0561-37a1-b3b6-db4a907a4679",
                                        "entry_id": "8f198ecd-ac27-36cd-8c37-65392acaab6d",
                                        "glosses": [
                                            "żargon określonego środowiska zawodowego lub społecznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00128d7f-6618-4162-8755-046dca8bb4b0",
                                                "sense_id": "021ee425-0561-37a1-b3b6-db4a907a4679",
                                                "text": "Nawet żeglarze mają swoją specyficzną gwarę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8309a5a7-e2b6-4d29-8050-d87afb57bf00",
                        "source_entry_id": "1909f53e-425a-3c6f-87ae-bfdbcb195045",
                        "target_lang_word": "говор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "говор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc46b8f2-79c7-3bfa-b364-d681262765b7",
                                        "entry_id": "002e3356-e4c2-3235-aa73-32b8a8ca981b",
                                        "glosses": [
                                            "лингв. наименьшая территориальная разновидность языка; местная разновидность территориального диалекта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff30efea-6ff4-4c03-9c2c-fac6399f0805",
                                                "sense_id": "dc46b8f2-79c7-3bfa-b364-d681262765b7",
                                                "text": "В говоре касимовских татар имеется гортанный взрывной (coup de glotte), развившийся из общетюркского k; любопытно, что ту же эволюцию проделало и общеславянское k в рожанском (розентальском) говоре словенского языка (в Каринтии) и общегерманское k в некоторых голландских говорах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c14bdf7-14ce-3adf-82dc-10ea39da73d7",
                                        "entry_id": "002e3356-e4c2-3235-aa73-32b8a8ca981b",
                                        "glosses": [
                                            "характер, манера произносить звуки, слова языка; особенность произношения, интонирования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98a3836-212e-48b9-9440-4c6d509422bc",
                                                "sense_id": "7c14bdf7-14ce-3adf-82dc-10ea39da73d7",
                                                "text": "Читая свои воспоминания вслух, он умело воспроизводил интонации крестьянского говора, даже немного утрируя их."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d21495b3-79e2-3f67-b3a3-e7e3da19fe86",
                                        "entry_id": "002e3356-e4c2-3235-aa73-32b8a8ca981b",
                                        "glosses": [
                                            "разг., ед. ч. разговор; звуки разговора, речи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2623f4-feb0-4aa3-a746-38fb8eb78b72",
                                                "sense_id": "d21495b3-79e2-3f67-b3a3-e7e3da19fe86",
                                                "text": "Женский оживлённый говор слышался отдалённо в комнате."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28becedf-64e5-3478-9587-56d9e2dc1fcc",
                                        "entry_id": "002e3356-e4c2-3235-aa73-32b8a8ca981b",
                                        "glosses": [
                                            "перен., ед. ч. молва, слухи, толки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da88d0c6-475f-4f70-8a01-b01b9560970b",
                                                "sense_id": "28becedf-64e5-3478-9587-56d9e2dc1fcc",
                                                "text": "Пошли пересуды и говор, и всё это как было и с прибавлениями дошло, наконец, своим путём в канцелярию."
                                            },
                                            {
                                                "example_id": "03c97fa5-4c35-4007-8daf-fb18b4e5b0f9",
                                                "sense_id": "28becedf-64e5-3478-9587-56d9e2dc1fcc",
                                                "text": "И кто-то заговорил первым, а кто-то поддержал. И говор разгорался все сильнее и сильнее набирал обороты, словно его бильярдным шаром пустили по огромной спирали. Потом приезжали журналисты и милиция. И тех и других долго не отпускали ― каждый взахлеб рассказывал, что видел и чего не видел."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5abf5e8-bce7-3a5a-acfb-4f798a4486b8",
                                        "entry_id": "002e3356-e4c2-3235-aa73-32b8a8ca981b",
                                        "glosses": [
                                            "перен., разг. щебетанье, гомон птиц"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "322d2830-4d5d-3e1e-9fe8-7a23a6a106aa",
                                        "entry_id": "002e3356-e4c2-3235-aa73-32b8a8ca981b",
                                        "glosses": [
                                            "перен., поэт. шум, гул, напоминающий человеческую речь (например, журчание воды)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5750046f-6533-41d3-abe6-406fe01b03d7",
                                                "sense_id": "322d2830-4d5d-3e1e-9fe8-7a23a6a106aa",
                                                "text": "На помосте толпятся живые люди, сильные звуки древнего языка сливаются с говором волн, — оратор в белой одежде с венцом на главе поднимает руки…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
