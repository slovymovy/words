                        "examples": [
                            {
                                "example_id": "8888156b-18e2-4662-94ed-ed2b3fe338f6",
                                "sense_id": "e5b626d3-22ed-30e2-b24a-d31734f96235",
                                "text": "Проводник завозят к месту крепления, закладывают в канифас и возвращают обратно на судно, где крепят за конец основного троса так, чтобы огон последнего был свободен для закладывания на пал или за рым."
                            }
                        ]
