                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0eb61aa-ff70-4e93-b046-537698f2e154",
                        "source_entry_id": "c0b87404-73eb-3635-9041-61d6d1717010",
                        "source_sense_id": "6d609e8f-626d-357a-97a9-2761905ec56d",
                        "source_sense_description": "Rüpelhaftigkeit, Tollpatschigkeit, Dummheit, Einfalt",
                        "target_lang_word": "Rüpelhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rüpelhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9735e8b5-da32-34a4-8ac2-3b513066bfd7",
                                        "entry_id": "1393d827-7646-32c8-96f6-5c3072831f4e",
                                        "glosses": [
                                            "Eigenschaft, rüpelhaft zu sein, rüpelhaftes Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fece8b0-f7e8-43e0-b396-2be7460c966d",
                                                "sense_id": "9735e8b5-da32-34a4-8ac2-3b513066bfd7",
                                                "text": "„›Aber ein Verhandlungsgespräch anzufangen mit der offenen Drohung, unser lang anhaltendes Arrangement zu zerstören, das ist genau die Rüpelhaftigkeit, die dir immer vorgeworfen wird.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b9871f4-79d8-33f5-b928-04a0006245af",
                                        "entry_id": "1393d827-7646-32c8-96f6-5c3072831f4e",
                                        "glosses": [
                                            "rüpelhafte Tat, Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e6c355e-e7a9-400b-a344-c9bb347adad2",
                        "source_entry_id": "c0b87404-73eb-3635-9041-61d6d1717010",
                        "source_sense_id": "6d609e8f-626d-357a-97a9-2761905ec56d",
                        "source_sense_description": "Rüpelhaftigkeit, Tollpatschigkeit, Dummheit, Einfalt",
                        "target_lang_word": "Tollpatschigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tollpatschigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91b4b7f5-3f3f-3602-aae3-efd20c7f2384",
                                        "entry_id": "44f9a969-388d-35d7-b1ed-61cefa8ea456",
                                        "glosses": [
                                            "Eigenschaft, ungeschickt (tollpatschig) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea990333-ffbe-487f-8578-2df602b4f096",
                                                "sense_id": "91b4b7f5-3f3f-3602-aae3-efd20c7f2384",
                                                "text": "„Ich blickte auf und freute mich schon in dein Gesicht gucken zu können, vielleicht würdest du wieder einen Witz über meine Tollpatschigkeit reißen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dd69c36-d2ff-3c04-8b5c-cfc262e82e27",
                                        "entry_id": "44f9a969-388d-35d7-b1ed-61cefa8ea456",
                                        "glosses": [
                                            "Aktion, die von [1] geprägt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1419f255-5b68-41da-a8fb-b9dfb0b3c092",
                                                "sense_id": "5dd69c36-d2ff-3c04-8b5c-cfc262e82e27",
                                                "text": "„Nicht, dass Schauspieler Adam Sandler nicht bekannt wäre für seine Tollpatschigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c640c1-772c-461e-8785-a7e60d66210e",
                        "source_entry_id": "c0b87404-73eb-3635-9041-61d6d1717010",
                        "source_sense_id": "6d609e8f-626d-357a-97a9-2761905ec56d",
                        "source_sense_description": "Rüpelhaftigkeit, Tollpatschigkeit, Dummheit, Einfalt",
                        "target_lang_word": "Dummheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dummheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                        "entry_id": "671dab56-74b1-3546-9f8d-60cd937f7ffd",
                                        "glosses": [
                                            "mangelnde geistige Fähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86177dfa-f70b-4f14-84f3-bc2865393a1f",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Nichts gibt so sehr das Gefühl der Unendlichkeit als wie die Dummheit.“"
                                            },
                                            {
                                                "example_id": "3654cd0c-bf67-4cfe-bfa3-2f0d44a357e8",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Erst werden die Menschen unters Joch gezwungen und dann als knechtisch verachtet, unterdrückt und dann von oben herab behandelt, verdummt und ihrer Dummheit wegen verhöhnt, versklavt und als Sklaven geschmäht.“"
                                            },
                                            {
                                                "example_id": "37905582-81e4-49a5-8d46-86276c85a236",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Hinter der Dummheit des Sprechers scheinen Gefühle auf, die ihm unvorstellbar bleiben müssem, und bald darauf leitet er eine Intrige ein.“"
                                            },
                                            {
                                                "example_id": "82457246-b329-40c2-81b0-c778cc28860c",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Die Dummheit einer Dienerin ist viel gefährlicher als ihre Bosheit und belastet den Herrn weit mehr, denn eine Bösartige kann man mit Recht bestrafen, eine Dumme aber nicht; man kann sie nur fortschicken und sich damit abfinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dfbe3c0-4cb9-3bb7-b561-b492337bd7a4",
                                        "entry_id": "671dab56-74b1-3546-9f8d-60cd937f7ffd",
                                        "glosses": [
                                            "unüberlegte, dumme Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be88419-3233-40a3-9f43-016dbba12588",
                                                "sense_id": "9dfbe3c0-4cb9-3bb7-b561-b492337bd7a4",
                                                "text": "„Plötzlich duckt er sich über den Tisch weg und keucht: Ich habe dich unterschätzt, Gatt. Was verlangst du? Daß du dich stellst. Wann? Sofort. Stille. Mach keine Dummheiten. Ich verständige die Volkspolizei.“"
                                            },
                                            {
                                                "example_id": "1f091ea7-960f-46cf-a714-5bb22733e5e1",
                                                "sense_id": "9dfbe3c0-4cb9-3bb7-b561-b492337bd7a4",
                                                "text": "Das, was du da getan hast, war eine Dummheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caeaf6c0-23df-40bb-abd7-fef7168a3a7d",
                        "source_entry_id": "c0b87404-73eb-3635-9041-61d6d1717010",
                        "source_sense_id": "6d609e8f-626d-357a-97a9-2761905ec56d",
                        "source_sense_description": "Rüpelhaftigkeit, Tollpatschigkeit, Dummheit, Einfalt",
                        "target_lang_word": "Einfalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einfalt",
