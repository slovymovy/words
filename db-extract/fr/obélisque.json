        "fr-extract.jsonl": [
            {
                "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                "word": "obélisque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b59cf52e-59ff-4153-ae01-836734249649",
                        "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                        "tags": [
                            "plural"
                        ],
                        "form": "obélisques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "757cace8-80cc-3afd-904d-403f11c232a6",
                        "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                        "glosses": [
                            "Monument quadrangulaire en forme d’aiguille, élevé sur un piédestal et ordinairement monolithe."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "01f0f7cd-13f8-4282-9925-ba451ae4a9ea",
                                "sense_id": "757cace8-80cc-3afd-904d-403f11c232a6",
                                "text": "Entre l’obélisque de Paris et son frère resté à Louxor, il n’y a plus de ressemblance aucune, et c’est miracle que le nôtre ait su prendre une beauté nouvelle en abandonnant sur la terre égyptienne tout ce qui lui donnait signification et grandeur."
                            },
                            {
                                "example_id": "27fcee14-338d-4ae3-b4fb-91425cd718d0",
                                "sense_id": "757cace8-80cc-3afd-904d-403f11c232a6",
                                "text": "Cherchez à prononcer entre celui qui a gravé des canards sur les obélisques égyptiens et celui qui a bostonné pendant vingt ans avec du Bousquet, monsieur de Valois, mademoiselle Cormon, le Président du Tribunal, le Procureur du Roi, l’abbé de Sponde, madame Granson, e tutti quanti ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee917101-9d5f-39f9-bbf3-9ac00287e6a2",
                        "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                        "glosses": [
                            "Monument moderne ayant la même forme."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "9a4c8e25-2a1e-441d-a624-fc9b199bdd6b",
                                "sense_id": "ee917101-9d5f-39f9-bbf3-9ac00287e6a2",
                                "text": "Obélisque indiquant un rendez-vous de chasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "edc20d22-86e6-36e9-b3b0-5d1de2bfcd4b",
                        "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                        "glosses": [
                            "Meuble représentant le monument du même nom dans les armoiries."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2f146117-bd82-4a58-8c7f-5306027bf047",
                                "sense_id": "edc20d22-86e6-36e9-b3b0-5d1de2bfcd4b",
                                "text": "D’azur à l’obélisque d’argent accosté de deux grues affrontées du même, au chef de gueules aux deux otelles d’argent posées l’une sur l’autre, l’une en bande, l’autre en barre accostées d’une demi-croix de Toulouse d’or, le tout accosté de deux lions affrontés du même issant des flancs, à la fasce ondée d’argent brochant sur le trait de la partition chargée d’un roc d’échiquier d’or, qui est de la commune de Roques de Midi-Pyrénées → voir illustration « armoiries avec un obélisque »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb5487cf-8d7c-4b15-aad3-a27566d3ed57",
                        "source_entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                        "target_lang_word": "Obelisk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obelisk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                        "entry_id": "3cc3cdb8-300b-3fe1-aca6-2c14a747f4f2",
                                        "glosses": [
                                            "rechteckiger Steinpfeiler mit aufgesetzter pyramidenförmiger Spitze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c81f13-535e-4273-a01d-890551430bd6",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "Der Obelisk von Luxor war ein Geschenk ägyptischen Königs Muhammad Ali Pascha an den französischen König Louis Philippe."
                                            },
                                            {
                                                "example_id": "2aa535f2-d964-4774-984b-cee8448d5cc1",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "Der Name des Steinmetzes Obelix wird gewöhnlich als Wortspiel mit dem französischen Wort obélisque (Obelisk) angesehen."
                                            },
                                            {
                                                "example_id": "4de31c97-8fbf-4b8b-85d2-50e8918cd4c1",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„Eine griechische Inschrift, die man auf einem Sockel in der Nähe des Obelisken gefunden hatte, legte die Vermutung nahe, der Obelisk sei im Namen von Ptolemaios und Kleopatra geweiht gewesen.“"
                                            },
                                            {
                                                "example_id": "0306e91f-01eb-4e72-90db-3f8ca8fc7258",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„Er stellt in zierlichen Bildern die ägyptischen Obelisken dar, die Papst Sixtus V. zu Rom mit großen Kosten hatte aufrichten lassen.“"
                                            },
                                            {
                                                "example_id": "0c0c58d1-f695-4fa8-82ab-97bb4e6085a7",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„In Erwartung von etwas Russisch-Orthodoxem, von etwas Üppigem mit Kreuzen und Gold fährt man hinunter, und dann findet man nur Obelisken mit einem roten Stern auf der Spitze.“"
                                            },
                                            {
                                                "example_id": "bd981ce4-d0db-49eb-b8cf-87d71a6cf632",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„Was sie suchte, befand sich im Hinterhof. Ein kleiner Obelisk aus schwarzem Granit, ein Säulenschaft, der etwa vier Fuß hoch war und sich auf einem großen, soliden Sockel erhob, auf dem die Inschrift angebracht werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74bc68a8-f497-45d9-9906-c20623c7d92e",
                        "source_entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                        "target_lang_word": "obelisk",
                        "target_lang_code": "en",
