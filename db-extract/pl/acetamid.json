                "senses": [
                    {
                        "sense_id": "dc9e0c83-ccd0-3584-82fc-d5855d1c0148",
                        "entry_id": "a7629943-93df-3679-934a-d6fd43c57bc8",
                        "glosses": [
                            "Azetamid, Acetamid"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27ac8474-bcf9-4cd2-8d23-360b74107cdd",
                        "source_entry_id": "a7629943-93df-3679-934a-d6fd43c57bc8",
                        "source_sense_id": "dc9e0c83-ccd0-3584-82fc-d5855d1c0148",
                        "source_sense_description": "Chemie: Azetamid, Acetamid",
                        "target_lang_word": "Azetamid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Azetamid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92032ab6-8252-30b1-b9c2-0b7d2a0068c3",
                                        "entry_id": "30ceec07-7a4a-3329-897a-4597f72f4eb1",
                                        "glosses": [
                                            "Amid der Essigsäure, das als farbloser kristalliner Körper vorkommt, als Lösungsmittel sowie für die Herstellung von Kunststoffen, Lacken und Sprengstoffen verwendet wird"
                                        ],
                                        "tags": [
                                            "Plural nur für die Stoffgruppe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c07864e-c486-4c31-8b2e-83389b08535b",
                                                "sense_id": "92032ab6-8252-30b1-b9c2-0b7d2a0068c3",
                                                "text": "„Hippursäure und Carbaminsäureäthylester wirkten nicht so gut, während Harnstoff (43% N), Azetamid (23,7% N) und Glykokoll (18,6% N) fast die Wirkung von Malzkeimen erreichten. Als organischer Düngerersatz konnte also nur Blutmehl in Betracht gezogen werden.“",
                                                "translation": "mit Plural:"
                                            },
                                            {
                                                "example_id": "2531f310-e903-4ac9-bf08-4ad98a2eee8c",
                                                "sense_id": "92032ab6-8252-30b1-b9c2-0b7d2a0068c3",
                                                "text": "Mit zunehmender Maischestandzeit nehmen in den entsprechenden Weinen die Gehalte der Fettsäuren und deren Ethylester sowie die Essigsäureester (Azetate) der höheren Alkohole ab. Ein entgegengesetztes Verhalten zeigen die Azetamide."
                                            },
                                            {
                                                "example_id": "7c54368b-dbc5-4a34-9524-42f3c90717e5",
                                                "sense_id": "92032ab6-8252-30b1-b9c2-0b7d2a0068c3",
                                                "text": "„Vergleicht man einen der so ermittelten Querschnitte, etwas den von 20,5 Å², der für die Fettsäuren auf Wasser, ferner für die Amine, Amide, die basischen Ester, Methylketone, Triglyzeride, Azetamide (unterhalb der kritischen Temperatur) und Harnstoffe (über der kritischen Temperatur) der gleiche ist, mit dem aus Röntgenuntersuchungen an Kristallen der gleichen Stoffe gefundenen Wert von 18,4 Å², so erkennt man einen kleinen, aber außerhalb der Fehlergrenzen liegenden Unterschied.“"
                                            },
                                            {
                                                "example_id": "43a4cf3f-407f-4543-b131-75d28f20d415",
                                                "sense_id": "92032ab6-8252-30b1-b9c2-0b7d2a0068c3",
                                                "text": "„Die Azetamide werden unterſchieden durch Bild. von Iſonitrilgeruch beim Erh. von 0,05g Subſt. mit etwas NaOCl und KOH.“"
                                            },
                                            {
                                                "example_id": "75577b81-dc51-4533-9f02-d21af5077770",
                                                "sense_id": "92032ab6-8252-30b1-b9c2-0b7d2a0068c3",
                                                "text": "„Nachdem sich diese Körper sowie die entsprechenden Derivate entweder als unwirksam erwiesen hatten oder wegen der zutage tretenden unangenehmen Nebenwirkungen ausgeschlossen werden mussten, wandten Fuchs und Schultze ihre Aufmerksamkeit der Untersuchung substituierter Azetamide zu.“"
                                            },
                                            {
                                                "example_id": "25ca47da-b155-4086-8415-5dcb88cf14b4",
                                                "sense_id": "92032ab6-8252-30b1-b9c2-0b7d2a0068c3",
                                                "text": "„Wir behalten uns vor, über weitere Untersuchungen der Azetamide, bzw. ihrer Bromderivate, demnächst zu berichten, falls die von uns noch zu ermittelnden Ergebnisse eine Publikation gerechtfertigt erscheinen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5000c7d-b79b-4779-be72-6f259d471f2d",
                        "source_entry_id": "a7629943-93df-3679-934a-d6fd43c57bc8",
                        "source_sense_id": "dc9e0c83-ccd0-3584-82fc-d5855d1c0148",
                        "source_sense_description": "Chemie: Azetamid, Acetamid",
                        "target_lang_word": "Acetamid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Acetamid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                        "entry_id": "d6c3905b-0722-3f1a-a488-1acc898a86cf",
                                        "glosses": [
                                            "Amid der Essigsäure, das als farbloser kristalliner Körper vorkommt, als Lösungsmittel sowie für die Herstellung von Kunststoffen, Lacken und Sprengstoffen verwendet wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cfeabd3-6cf2-4bb3-96d4-ec922baf5a41",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Die Herstellung von T. erfolgt durch Einwirkung von Phosphor(V)-sulfid auf Acetamid.“"
                                            },
                                            {
                                                "example_id": "1d771ace-34af-45cc-ba0f-0f27bd5ccd26",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Auch andere Säureamide (z.B. Acetamid, Isobutylamid, Crotonamid) können mit diesem Enzym erzeugt werden.“"
                                            },
                                            {
                                                "example_id": "1a739541-10d8-4962-b1d9-aa55c59942b7",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Synthetisch kann es durch die Nitrilsynthese nach Kolbe aus Methyliodid und Alkalicyaniden, durch Dehydratisierung von Acetamid bzw. Acetaldehydoxim und aus Acetylen und Ammoniak hergestellt werden.“"
                                            },
                                            {
                                                "example_id": "7203ca05-d0a5-49a6-a354-bc398babfdce",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Praktische Bedeutung hat besonders das Anfangsglied der Reihe, das Keten H2C=C=O, u. a. zur Herstellung von Acetanhydrid, Essigester, Acetylchlorid und Acetamid.“"
                                            },
                                            {
                                                "example_id": "f73f38ba-4fc1-4369-bc14-59414dc58093",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„A. ist eine sehr reaktive Verbindung, die mit Ammoniak zu Acetamid, mit Alkoholen zu Essigsäureestern und mit primären und sekundären Aminen zu N-substituierten Acetamiden reagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                        "entry_id": "d6c3905b-0722-3f1a-a488-1acc898a86cf",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "336ca606-c817-4858-80f7-05927cc59f16",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Diphenamid ist eine chemische Verbindung aus der Gruppe der Acetamide und ein Herbizid.“"
                                            },
                                            {
                                                "example_id": "ee30eefc-2eb9-458c-8e4a-0040646d40f5",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Wie weitere Funde in der Literatur bestätigen, eignet sich die diskontinuierliche LSE (d-LSE) für die chemische Gruppe der Acetamide am besten.“"
                                            },
                                            {
                                                "example_id": "70eaa0a7-8798-4f02-99f4-62c32630c6b8",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Phenacetin und Methacetin sind chemisch sehr ähnliche Verbindungen, die beide zur Gruppe der Acetamide gehören.“"
                                            },
                                            {
                                                "example_id": "edb2412f-a500-44e6-8bdb-d03addaa04fb",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„In dieser Doktorarbeit wurden die Strukturen und die Dynamik von zwei Formamiden, fünf Acetamiden und zwei Propionamiden untersucht, wobei der Fokus auf die Effekte der internen Rotation und der Quadrupolkopplung gelegt wurde.“"
                                            },
                                            {
                                                "example_id": "030efe23-b40d-45ef-8aa0-ee3592c7f8fe",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Daneben lässt sich Paracetamol auch als Acetamid, also als Amid der Essigsäure auffassen, woraus sich der nach IUPAC-Regularien vergebene Name N-(4-Hydroxyphenyl)acetamid ergibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
