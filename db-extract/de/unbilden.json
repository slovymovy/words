                ],
                "senses": [
                    {
                        "sense_id": "699670e7-4355-302c-98b0-759b0232025d",
                        "entry_id": "c9e98872-b0e7-3755-9608-026a54ed2d01",
                        "glosses": [
                            "negative Erscheinungen, Lasten, Mühen, Unbequemlichkeiten, Unannehmlichkeiten, Widrigkeiten – gerade auch durch Kräfte, gegen die der Mensch wenig Macht hat, wie Jahreszeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02dd6df-2ff3-4131-a954-276818a1661b",
                                "sense_id": "699670e7-4355-302c-98b0-759b0232025d",
                                "text": "„Kein anderes Möbel strahlt eine solche Zufriedenheit aus, kein anderes definiert das Zuhause-Sein seit Jahrhunderten so gut wie der große Sessel mit den Ohrenbacken, die seinen Insassen vor den Unbilden der Welt abschirmen.“"
                            },
                            {
                                "example_id": "2eb3fc9e-1ce5-4901-b8d5-916f7840f958",
                                "sense_id": "699670e7-4355-302c-98b0-759b0232025d",
                                "text": "„Keiner von ihnen hatte jemals so eine Winterwanderung gemacht, aber Auftrag war nun einmal Auftrag, und so kämpften sie sich gegen die Unbilden des Wetters über die Grenze.“"
                            },
                            {
                                "example_id": "b9fa8d7d-0453-43bd-b6fb-f43eb44d94aa",
                                "sense_id": "699670e7-4355-302c-98b0-759b0232025d",
                                "text": "„Ihr Fleisch war von den Unbilden des Stadtlebens gut durchtrainiert und zäh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
