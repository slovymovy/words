                        "entry_id": "29b8c208-e384-3d61-9020-58fec78bee47",
                        "glosses": [
                            "Teil des Lymphsystems, verdickte Stelle von 5-10mm der Lymphgefäße, wo Filtrierung der Lymphflüssigkeit stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe9eef8-074f-4736-9a5f-b14b991fcb7a",
                                "sense_id": "0d031d14-3e0d-32b3-978f-4b364d267111",
                                "text": "Die Lymphknoten sind etwas angeschwollen."
                            },
                            {
                                "example_id": "c5da3315-64c6-4182-8647-bb5261a4f7a8",
                                "sense_id": "0d031d14-3e0d-32b3-978f-4b364d267111",
                                "text": "„Im Frühjahr dieses Jahres erkrankte Ethel an Zungenkrebs, der bereits auf den Rachen und die Lymphknoten übergegriffen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
