{
    "word_family": [
        "active",
        "action",
        "activate",
        "activation",
        "activist",
        "activism",
        "actor",
        "actress",
        "interact",
        "interaction",
        "reactive",
        "reaction",
        "proactive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88cfa8ff-dd6a-3b7f-ba4b-a806955ffdba",
                    "sense_definition": "Something done for enjoyment, exercise, or as part of a specific purpose, often involving movement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Swimming is a healthy physical <w>activity</w> that strengthens the whole body.",
                            "target_lang_translations": {
                                "ru": "Плавание — это полезная физическая <w>активность</w>, которая укрепляет всё тело.",
                                "zh": "游泳是一种有益健康的体育<w>活动</w>，能增强整个身体。"
                            }
                        },
                        {
                            "text": "The school offers a wide range of after-school <w>activities</w> for students.",
                            "target_lang_translations": {
                                "ru": "Школа предлагает широкий выбор внеклассных <w>занятий</w> для учеников.",
                                "zh": "学校为学生提供各种各样的课外<w>活动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pursuit",
                        "hobby",
                        "pastime"
                    ],
                    "common_phrases": [
                        "physical activity",
                        "leisure activity",
                        "outdoor activity",
                        "social activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что делается ради удовольствия, упражнения или с определенной целью, часто предполагающее движение.",
                        "zh": "为了娱乐、锻炼或某种特定目的而进行的事情，常常涉及身体动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занятие",
                                "target_lang_sense_clarification": "времяпрепровождение, увлечение или урок"
                            },
                            {
                                "target_lang_word": "активность",
                                "target_lang_sense_clarification": "физическая нагрузка или подвижность"
                            },
                            {
                                "target_lang_word": "деятельность",
                                "target_lang_sense_clarification": "активные действия или работа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活动",
                                "target_lang_sense_clarification": "一般指为娱乐、锻炼或某种目的而进行的事情"
                            },
                            {
                                "target_lang_word": "运动",
                                "target_lang_sense_clarification": "强调身体锻炼、运动时常用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d46a7f0b-dffc-3b48-a783-38a25881d816",
                    "sense_definition": "The state or situation in which a lot of things are happening or people are moving around.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city center was full of noise and <w>activity</w> during the festival.",
                            "target_lang_translations": {
                                "ru": "Во время фестиваля центр города был полон шума и <w>оживления</w>.",
                                "zh": "节日期间，市中心到处都是喧闹声，一片<w>热闹</w>。"
                            }
                        },
                        {
                            "text": "There was a sudden burst of <w>activity</w> when the manager arrived.",
                            "target_lang_translations": {
                                "ru": "Когда приехал менеджер, произошел внезапный всплеск <w>активности</w>.",
                                "zh": "经理一到，大家突然一阵<w>忙碌</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "rest",
                        "passivity"
                    ],
                    "common_phrases": [
                        "buzz with activity",
                        "flurry of activity",
                        "sign of activity",
                        "burst of activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором происходит много событий или наблюдается оживленное движение людей.",
                        "zh": "很多事情正在发生或很多人在来回走动的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "суета, движение, бурная жизнь"
                            },
                            {
                                "target_lang_word": "активность",
                                "target_lang_sense_clarification": "энергичные действия или интенсивность событий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "热闹",
                                "target_lang_sense_clarification": "指人来人往、事情很多的热闹状态"
                            },
                            {
                                "target_lang_word": "忙碌",
                                "target_lang_sense_clarification": "强调突然变得很忙、事情集中发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f88e3a7-3129-39d7-ab2d-4131f364a5a9",
                    "sense_definition": "A specific action, task, or function that is performed to achieve a result.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police are investigating suspicious <w>activity</w> reported in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует подозрительную <w>деятельность</w>, о которой сообщили в районе.",
                                "zh": "警方正在调查社区里上报的可疑<w>活动</w>。"
                            }
                        },
                        {
                            "text": "The report details the economic <w>activity</w> of the region over the last year.",
                            "target_lang_translations": {
                                "ru": "В отчете подробно описывается экономическая <w>деятельность</w> региона за последний год.",
                                "zh": "这份报告详细说明了该地区过去一年的经济<w>活动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "undertaking",
                        "endeavor",
                        "venture",
                        "enterprise"
                    ],
                    "common_phrases": [
                        "criminal activity",
                        "economic activity",
                        "business activity",
                        "illegal activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное действие, задача или функция, выполняемая для достижения результата.",
                        "zh": "为实现某种结果而进行的具体行为、任务或运作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деятельность",
                                "target_lang_sense_clarification": "работа, функционирование (экономическая, преступная)"
                            },
                            {
                                "target_lang_word": "действия",
                                "target_lang_sense_clarification": "поступки или операции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活动",
                                "target_lang_sense_clarification": "指为达到某种结果而进行的具体行为或运作，如经济活动、犯罪活动"
                            },
                            {
                                "target_lang_word": "行为",
                                "target_lang_sense_clarification": "强调具体做法、举动时可用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d081127-0004-3e7f-88fd-e8b37600e383",
                    "sense_definition": "The rate at which the atoms of a radioactive substance break down.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists measured the <w>activity</w> of the sample using a sensitive device.",
                            "target_lang_translations": {
                                "ru": "Ученые измерили <w>активность</w> образца с помощью чувствительного прибора.",
                                "zh": "科学家用一台灵敏的仪器测量了该样品的<w>活度</w>。"
                            }
                        },
                        {
                            "text": "The high level of <w>activity</w> near the reactor core required special shielding.",
                            "target_lang_translations": {
                                "ru": "Высокий уровень <w>активности</w> рядом с активной зоной реактора требовал специальной защиты.",
                                "zh": "反应堆堆芯附近很高的<w>活度</w>需要特殊的屏蔽措施。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "physics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорость распада атомов радиоактивного вещества.",
                        "zh": "放射性物质的原子发生衰变的速率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активность",
                                "target_lang_sense_clarification": "радиоактивность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活度",
                                "target_lang_sense_clarification": "物理学中指放射性物质单位时间内衰变的强度"
                            },
                            {
                                "target_lang_word": "放射性活度",
                                "target_lang_sense_clarification": "较完整的专业说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a37aae4-3fc6-3379-9fc2-d12af04e82a2",
                    "sense_definition": "The ability of a chemical substance to react with other substances.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The catalytic <w>activity</w> of the metal increases with higher temperatures.",
                            "target_lang_translations": {
                                "ru": "Каталитическая <w>активность</w> металла возрастает при повышении температуры.",
                                "zh": "这种金属的催化<w>活性</w>会随着温度升高而增强。"
                            }
                        },
                        {
                            "text": "Gold is known for its very low chemical <w>activity</w>.",
                            "target_lang_translations": {
                                "ru": "Золото известно своей очень низкой химической <w>активностью</w>.",
                                "zh": "黄金以其极低的化学<w>活性</w>而闻名。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность химического вещества вступать в реакцию с другими веществами.",
                        "zh": "化学物质与其他物质发生反应的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активность",
                                "target_lang_sense_clarification": "химическая реакционная способность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活性",
                                "target_lang_sense_clarification": "化学中指物质与其他物质发生反应的能力"
                            },
                            {
                                "target_lang_word": "反应活性",
                                "target_lang_sense_clarification": "强调反应能力时使用的较完整说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d3bad11-2177-303c-8086-993e83f52056",
                    "sense_definition": "A category of verbs or predicates describing an action that changes over time without a natural end point.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistic_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this theory, an <w>activity</w> differs from an accomplishment because it has no culmination.",
                            "target_lang_translations": {
                                "ru": "В этой теории <w>деятельность</w> отличается от свершения тем, что не имеет кульминации.",
                                "zh": "在这一理论中，<w>活动</w>类事件不同于达成类事件，因为它没有自然终点。"
                            }
                        },
                        {
                            "text": "Verbs of <w>activity</w> like 'running' behave differently in the progressive aspect.",
                            "target_lang_translations": {
                                "ru": "Глаголы <w>деятельности</w>, такие как «бегать», ведут себя иначе в длительном аспекте.",
                                "zh": "像“跑步”这样的<w>活动</w>动词在进行体中的表现不同。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Категория глаголов, описывающих действие, изменяющееся во времени без естественного конца.",
                        "zh": "语言学中指一类表示随时间进行、但没有自然终点的动作的动词或谓词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деятельность",
                                "target_lang_sense_clarification": "лингвистический термин (глаголы деятельности)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活动",
                                "target_lang_sense_clarification": "语言学中指一种无自然终点、随时间展开的动作类型"
                            },
                            {
                                "target_lang_word": "活动类",
                                "target_lang_sense_clarification": "用于说明这类动词或谓词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}