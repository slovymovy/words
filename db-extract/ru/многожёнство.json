                ],
                "translations": [
                    {
                        "translation_id": "68688653-532a-4147-aa6b-7b4ff14feb16",
                        "source_entry_id": "ed66c6dc-ae19-3a6c-8851-53bf8542b76d",
                        "source_sense_id": "ba4d2e02-22da-3434-b5a8-28b5609148e1",
                        "target_lang_word": "polygyny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygyny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b46ddf3e-afed-3f48-88ce-33b9d31f7f68",
                                        "entry_id": "cb8cc510-479e-3c3e-87c7-e5bb7fbc9966",
                                        "glosses": [
                                            "The state or practice of having several wives at the same time; plurality of wives; marriage to several wives."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9ead6dd-594d-4eb6-b3ad-d51f1c3f3dcb",
                                                "sense_id": "b46ddf3e-afed-3f48-88ce-33b9d31f7f68",
                                                "text": "We may infer that in most cases where polygyny exists, monogamy co-exists to a greater extent, and in all other cases to a considerable extent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f6c7ef-d715-3d3f-b386-3fe4825bcf04",
                                        "entry_id": "cb8cc510-479e-3c3e-87c7-e5bb7fbc9966",
                                        "glosses": [
                                            "The condition of an ant colony that has multiple egg-laying queens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "735adf8f-9813-3c9a-8ea7-01b2ee3cd5cd",
                                        "entry_id": "cb8cc510-479e-3c3e-87c7-e5bb7fbc9966",
                                        "glosses": [
                                            "Synonym of polygamy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07e15f22-c173-481c-b5de-da598ff94a4b",
                        "source_entry_id": "ed66c6dc-ae19-3a6c-8851-53bf8542b76d",
                        "source_sense_id": "ba4d2e02-22da-3434-b5a8-28b5609148e1",
                        "target_lang_word": "polygamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba66faf3-6bf3-3e28-b7ee-042184594313",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "The condition of having more than one spouse or marriage partner at one time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d4a3cd-4495-4f67-8e0b-bb0c3290985b",
                                                "sense_id": "ba66faf3-6bf3-3e28-b7ee-042184594313",
                                                "text": "Are there countries where polygamy is legal for both men and women?"
                                            },
                                            {
                                                "example_id": "e3804f52-81b4-47e6-a246-f548e8d35e93",
                                                "sense_id": "ba66faf3-6bf3-3e28-b7ee-042184594313",
                                                "text": "Miss Griffin was a model of propriety, and I am at a loss to imagine what the feelings of the virtuous woman would have been, if she had known, when she paraded us down the Hampstead Road two and two, that she was walking with a stately step at the head of Polygamy and Mahomedanism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd92742-110f-3c27-84c4-14f975a2c4de",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "Synonym of polygyny (“marriage of a man to more than one wife, the practice of having several wives at the same time”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe671a3-19e0-45fa-9662-828b9bd3016f",
                                                "sense_id": "bfd92742-110f-3c27-84c4-14f975a2c4de",
                                                "text": "Though Islam allows polygamy, it is frowned upon in many contemporary Muslim societies."
                                            },
                                            {
                                                "example_id": "754179c2-7e27-46ec-bd3e-6bc5f2b932b9",
                                                "sense_id": "bfd92742-110f-3c27-84c4-14f975a2c4de",
                                                "text": "Because Mormon polygamy was an unusual family form in nineteenth-century America […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e7f698-9ab0-3b8b-87db-aaff238ca34f",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "The state or habit of having more than one sexual mate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e515f38-ac55-4099-84ae-8b3b8839ed8b",
                                                "sense_id": "10e7f698-9ab0-3b8b-87db-aaff238ca34f",
                                                "text": "An insect queen actually practices polygamy only one day, while for an alpha-male defending his harem is the very essence of both his status and polygamy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95dfaae-84a0-3131-8785-cb581d5a4a23",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "The condition or state of a plant which bears both perfect and unisexual flowers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
