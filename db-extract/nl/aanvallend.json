                "senses": [
                    {
                        "sense_id": "df36b46f-2945-35fc-9268-2785d7c94193",
                        "entry_id": "d9ad9c9c-740b-382a-9009-78e87126b5d2",
                        "glosses": [
                            "gericht op de aanval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd57f4b-4987-4a50-9098-740d30acf62b",
                                "sense_id": "df36b46f-2945-35fc-9268-2785d7c94193",
                                "text": "Zeker is wel dat Heerenveen straks nóg een spits haalt die de concurrentie met Odgaard moet aangaan, net als een aanvallende middenvelder die Vlap moet opvolgen."
                            },
                            {
                                "example_id": "f41c83e9-3b00-4e79-82a2-e5fa08c13e03",
                                "sense_id": "df36b46f-2945-35fc-9268-2785d7c94193",
                                "text": "Ook probeerde hij haar deze zomer uit de tent te lokken door te opperen dat Duitsland aan de vooravond van een nieuwe vluchtelingencrisis stond. Deze aanvallende tactiek werkte echter averechts, toen verschillende Duitse media focusten op een fout cijfer uit Schulz' speech en Merkel zich niet uit haar tent liet lokken. HP de Tijd 11/09"
                            }
                        ]
                    }
