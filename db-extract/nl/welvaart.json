        "nl-extract.jsonl": [
            {
                "entry_id": "b377f246-7206-3432-b351-62752fa5ecdd",
                "word": "welvaart",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                        "entry_id": "b377f246-7206-3432-b351-62752fa5ecdd",
                        "glosses": [
                            "de mate waarin de behoeften met de beschikbare middelen kunnen worden bevredigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704f53d1-1803-48c4-97bf-10e62f5eed4c",
                                "sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                                "text": "Het overgrote deel van de gegeneerde welvaart komt echter niet bij de eilandbewoners terecht, maar wordt teruggepompt in de immer uitdijende toerisme-industrie."
                            },
                            {
                                "example_id": "51e6fa10-3a79-4120-8a04-647ab4076001",
                                "sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                                "text": "In de jaren 1950 is de welvaart enorm toegenomen, maar soms ging dat ten kost van het welzijn."
                            },
                            {
                                "example_id": "0fca3c74-8ef6-4e13-945e-adfbae733236",
                                "sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                                "text": "De Nobelprijs voor Economie gaat dit jaar naar de Turks-Amerikaanse Daron Acemoglu, de Brits-Amerikaanse Simon Johnson en de Brit James A. Robinson. Ze krijgen de prijs voor hun onderzoek naar hoe het verschil in welvaart tussen landen ontstaat."
                            },
                            {
                                "example_id": "56f8a310-818d-4752-9456-3c24ac88a185",
                                "sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                                "text": "\"VU, hef niet je aardwetenschappen-afdeling op!\", schrijft hoofdgeoloog van de Geologische Dienst Nederland, Michiel van der Meulen van TNO, in een oproep op LinkedIn. \"Als ze dit besluit doorzetten, keren ze hun rug naar de samenleving en de toekomst\", gaat hij verder. \"Of het nou voor een beter milieu is, meer welvaart of grotere autonomie - voor Nederland, Europa of de wereld: aardwetenschappers leveren een essentiële bijdrage.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b9b9ac9-37b0-4eed-8f3b-7d93b4fb7d9b",
                        "source_entry_id": "b377f246-7206-3432-b351-62752fa5ecdd",
                        "source_sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                        "target_lang_word": "Wohlstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohlstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                        "entry_id": "6adaf4c7-7944-34ef-8691-a5644d2d727a",
                                        "glosses": [
                                            "gute wirtschaftliche Lage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892e4235-dafe-44b1-bc42-749ec08c4c02",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Ich neide anderen Menschen ihren Wohlstand nicht.“"
                                            },
                                            {
                                                "example_id": "4d81d02d-216e-4395-8663-a7f67a4f7a0d",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Dieser Hof verschaffte ihr Wohlstand und Einfluss.“"
                                            },
                                            {
                                                "example_id": "2fd30c53-19b9-4581-864e-fbddd6195b45",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Bei Renate war der Wohlstand ausgebrochen.“"
                                            },
                                            {
                                                "example_id": "2550827d-5f5b-4dc2-9bc7-92088ed0e782",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Der neue Wohlstand und die Macht von Addis Abeba untergraben den Einfluss der Provinzfürsten zusätzlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b80fea6b-d5b8-401c-97ec-9249707a1d43",
                        "source_entry_id": "b377f246-7206-3432-b351-62752fa5ecdd",
                        "source_sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                        "target_lang_word": "prosperity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosperity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                        "entry_id": "2b72211a-5cad-32f7-90f0-e17398ea335f",
                                        "glosses": [
                                            "The condition of being prosperous: having good fortune and a fortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0927d78-62df-4d6a-b391-45a4171fdb37",
                                                "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                                "text": "Near-synonym: thriving"
                                            },
                                            {
                                                "example_id": "3d281ed2-658e-4d33-89ed-37980f85246b",
                                                "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                                "text": "“Eating meat means prosperity in the coming year,” the roastery wrote on Weibo on February 5, days before the Lunar New Year began."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8ec95df-ba46-42c5-94ce-a19572628403",
                        "source_entry_id": "b377f246-7206-3432-b351-62752fa5ecdd",
                        "source_sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                        "target_lang_word": "welfare",
