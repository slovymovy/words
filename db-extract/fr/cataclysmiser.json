                "senses": [
                    {
                        "sense_id": "ac711322-9592-3733-99d3-7435f877d9bd",
                        "entry_id": "5c3645b1-0f4c-3ab8-8953-6920cac0965a",
                        "glosses": [
                            "Donner un caractère cataclysmique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd27dde-3707-410c-8749-5b030042c629",
                                "sense_id": "ac711322-9592-3733-99d3-7435f877d9bd",
                                "text": "Faire peur, cataclysmiser les discours et culpabiliser est une démarche qui reprend les techniques de ceux qui veulent le pouvoir pour le pouvoir."
                            },
                            {
                                "example_id": "47c09db4-af09-4edd-92a6-16e22159bf7b",
                                "sense_id": "ac711322-9592-3733-99d3-7435f877d9bd",
                                "text": "Mais nous avons de quoi nous consoler parce que, à la une, on nous dit chaque jour que ça pourrait être pire : ailleurs, ils se font exploser, charcuter, violer, emprisonner, voler, séquestrer, « cataclysmiser »."
                            },
                            {
                                "example_id": "b5a2a7c6-9f35-4fdf-ad66-f9591eab8a4b",
                                "sense_id": "ac711322-9592-3733-99d3-7435f877d9bd",
                                "text": "A sa mort, l'équilibre d'Azeroth est perturbé et boom le gros lézard en profite pour cataclysmiser le monde"
                            }
                        ]
                    }
                ],
