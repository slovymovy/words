                ],
                "senses": [
                    {
                        "sense_id": "573c7348-7c5e-340c-affb-4b8d0ae28677",
                        "entry_id": "9f335d34-323c-3755-8436-2d01505ba056",
                        "glosses": [
                            "Menge von Zeichen einer bestimmten Art"
                        ],
                        "tags": [
                            "Semiotik"
                        ],
                        "examples": [
                            {
                                "example_id": "898a7c82-c831-4633-9e9d-040bab7b9a41",
                                "sense_id": "573c7348-7c5e-340c-affb-4b8d0ae28677",
                                "text": "„So verhält es sich auch bezüglich der Größe des Zeicheninventars resp. bezüglich der oben angeschnittenen Frage, ob ein Schriftsystem in dem Maße besser wird, wie die Zahl seiner Elemente abnimmt.“"
                            },
                            {
                                "example_id": "da271b49-f4d2-4aed-b44b-462cbbcd3ac3",
                                "sense_id": "573c7348-7c5e-340c-affb-4b8d0ae28677",
                                "text": "Jedes Teilsystem der Sprache hat sein eigenes Zeicheninventar."
                            },
                            {
                                "example_id": "d5e9998e-109d-4a8e-b38c-d45cd450a8cd",
                                "sense_id": "573c7348-7c5e-340c-affb-4b8d0ae28677",
                                "text": "„Im Mittelpunkt stehen die Einheiten auf dem dritten Stratum, die in Anlehnung an die etablierte Terminologie aus der Gestenforschung als Embleme bezeichnet werden und das Zeicheninventar des untersuchten Zeichensystems bilden…Das aus 477 Emblemen bestehende Zeicheninventar wird in einer Datenbank erfasst.“"
                            },
                            {
                                "example_id": "574a584f-4835-4f63-bd51-3d1d1383734b",
                                "sense_id": "573c7348-7c5e-340c-affb-4b8d0ae28677",
                                "text": "„Zu diesem Zweck wird das spezielle Zeicheninventar des Comics hinsichtlich der Informationsvergabe durch das Bild, den Text und andere Codes analysiert.“"
                            },
                            {
                                "example_id": "325a1149-3e77-465f-be38-6a860d286932",
                                "sense_id": "573c7348-7c5e-340c-affb-4b8d0ae28677",
                                "text": ": \"Sie [die Wörter] gelten daher als sprachliche Zeichen, die zu einem bestimmten Zeicheninventar, einem Wortschatz oder Lexikon, gehören und aufgrund bestimmter Kombinationsregeln zu neuen Wörtern, Sätzen und Texten verkettet werden können.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
