            {
                "entry_id": "6f12cb23-c6ce-3937-a175-b06f5d94a252",
                "word": "villégiature",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f29e6a9-67f0-4423-b89e-b71c7034119e",
                        "entry_id": "6f12cb23-c6ce-3937-a175-b06f5d94a252",
                        "tags": [
                            "plural"
                        ],
                        "form": "villégiatures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb0a8c4b-d0cd-3782-8a4f-d01d854b8b00",
                        "entry_id": "6f12cb23-c6ce-3937-a175-b06f5d94a252",
                        "glosses": [
                            "Séjour à la campagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59511f53-e773-4cb9-8e5a-f58cd23545e5",
                                "sense_id": "fb0a8c4b-d0cd-3782-8a4f-d01d854b8b00",
                                "text": "Des caprices de pin-up, des croqueuses de diamants qui se déhanchent pour le milliardaire du jour, des vedettes américaines en villégiature à Cinecittà qui veulent en montrer aux jeunes Romains, des gigolos qui se lancent dans des kazatchoks pour impressionner la cliente, oui."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e36c1b0-3acb-3f9a-95d0-521c7ac59d8d",
                        "entry_id": "6f12cb23-c6ce-3937-a175-b06f5d94a252",
                        "glosses": [
                            "Lieu de séjour à la campagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5923b028-3d9e-4bbe-a686-4ef40f956f8e",
                                "sense_id": "9e36c1b0-3acb-3f9a-95d0-521c7ac59d8d",
                                "text": "J’étais allé passer quelques jours dans la villégiature de ma famille, – cent vingt et un habitants, – et assez fatigué j’avais écrit à mes amies de venir m’attendre au Jardin de Paris où je viendrais me remettre un peu en descendant du train."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9efbce82-79bd-445b-9caf-b3e303d5fa6c",
                        "source_entry_id": "6f12cb23-c6ce-3937-a175-b06f5d94a252",
                        "source_sense_description": "Séjour à la campagne",
                        "target_lang_word": "Sommerfrische",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommerfrische",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
                                        "entry_id": "123b6bf3-d35e-32dc-a488-31b8b88a1039",
                                        "glosses": [
                                            "Zeit, in der man die Arbeit ruhen lässt, sich an einen Ort mit angenehmem Klima begibt, und der Ort, an dem man sich erholt"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001cfb23-64c7-4360-a707-9b82bea0d06c",
                                                "sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
                                                "text": "Wir freuten uns immer auf die Sommerfrische."
                                            },
                                            {
                                                "example_id": "8cf45a79-ea4c-401d-b430-abbac8781a16",
                                                "sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
                                                "text": "„Denn die meisten Familien waren verreist und verbrachten die Sommerfrische in Bath oder Cheltenham.“"
                                            },
                                            {
                                                "example_id": "31d1febe-e49b-4f04-857c-aebcd525ef8a",
                                                "sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
                                                "text": "„In die Berge bekommt mich zur Zeit der Sommerfrische niemand mehr hin, denn seitdem ich gelesen habe, daß man in der reizenden Bergstadt Grund im Harz den pittoresken Hübichenstein durch ein Riesenmedaillon und einen Adler für 5000 Mk. - wird was Rechtes sein - verschönern will, habe ich Grund genug, dort nicht mehr hinzugehen.“"
                                            },
                                            {
                                                "example_id": "a9042977-eac7-4934-9b51-1dda30eee285",
                                                "sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
                                                "text": "„Er soll den Fremden mit der Landschaft, den Sommerfrischen samt ihren Unterkunftsmöglichkeiten bekannt machen.“"
                                            },
                                            {
                                                "example_id": "a6f7d404-ceb0-4a4c-b5d1-84184430051a",
                                                "sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
                                                "text": "„Vor einem unmittelbar bevorstehenden europäischen Krieg jedoch fürchtete sich Hugo Stinnes Mitte Juli 1914 nicht: Er genoss seine Sommerfrische.“"
                                            },
                                            {
                                                "example_id": "cd314514-01f2-4b1f-baae-d4946025a194",
                                                "sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
                                                "text": "„Zeitgleich hat die Werbung die Sommerfrische für sich entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4c40165-9763-42ae-8dd6-7674c7f684e5",
                        "source_entry_id": "6f12cb23-c6ce-3937-a175-b06f5d94a252",
                        "source_sense_description": "Séjour à la campagne",
