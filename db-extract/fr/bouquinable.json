                        "examples": [
                            {
                                "example_id": "7eed5969-7481-41c1-8465-ebd7ea17dd34",
                                "sense_id": "9523cc93-87a6-37fe-82b8-0defb9d7d099",
                                "text": "Quand, par envie de connaître son semblable, on demande au bouquineur ce qu’il bouquine, on sait d’avance que ce ne sera pas Montaigne, Virgile ou Dostoïevski, mais un auteur bouquinable."
                            },
                            {
                                "example_id": "ee17e142-6fa5-40f3-afb9-8a6777dd835f",
                                "sense_id": "9523cc93-87a6-37fe-82b8-0defb9d7d099",
                                "text": "Sinon j'aime bien passer mon temps à faire du piano (low lever crois pas) et bouquiner tout ce qui est bouquinable, du manga genre City Hunter au magazine historique et juridique de l’Étudiant ou la Semaine Juridique, très utile quand on fait une FAC de droit."
                            }
                        ]
                    }
