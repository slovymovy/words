                    "frequency": "High",
                    "semantic_group_id": "recit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les soirs, le père lit une <w>histoire</w> à ses enfants avant de dormir."
                        },
                        {
                            "text": "Elle nous a raconté une <w>histoire</w> drôle qui a fait rire toute la classe."
                        }
