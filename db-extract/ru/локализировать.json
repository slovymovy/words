                                "target_senses": [
                                    {
                                        "sense_id": "30b386c5-dd9c-3c6e-a77a-1bd44c9d2297",
                                        "entry_id": "f56888ec-5ff5-34af-ad97-5e313b43b63e",
                                        "glosses": [
                                            "die Lage von etwas genau bestimmen"
                                        ],
                                        "tags": [
                                            "formal",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da2e2c55-09a8-4cd4-885e-b8fca56490f7",
                                                "sense_id": "30b386c5-dd9c-3c6e-a77a-1bd44c9d2297",
                                                "text": "Können sie den Schmerz lokalisieren?"
                                            },
                                            {
                                                "example_id": "5b0562d4-0c07-482f-b22f-1abbd9505cc2",
                                                "sense_id": "30b386c5-dd9c-3c6e-a77a-1bd44c9d2297",
                                                "text": "„Fündig wurden die Kollegen in Wentorf: In der Hauptstraße und in der Hamburger Landstraße nahmen ihre Suchgeräte einen leichten Gasgeruch wahr. Um die Lecks genau zu lokalisieren, legte man die Gasrohre nach und nach frei.“"
                                            },
                                            {
                                                "example_id": "5b76a087-0f8b-48a4-a4f1-fec11096ffc7",
                                                "sense_id": "30b386c5-dd9c-3c6e-a77a-1bd44c9d2297",
                                                "text": "„Mithilfe von Satellitenbildern konnten die Geoforscher den Ort lokalisieren, an dem die Katastrophe ihren Ursprung nahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d088a011-be79-3bbf-91f9-1ae10fbe9756",
                                        "entry_id": "f56888ec-5ff5-34af-ad97-5e313b43b63e",
                                        "glosses": [
                                            "auf einen Ort begrenzen, beschränken, eine Ausbreitung verhindern"
                                        ],
                                        "tags": [
                                            "formal",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f78acb8-ce9e-46c8-95f0-60b77d6c695b",
                                                "sense_id": "d088a011-be79-3bbf-91f9-1ae10fbe9756",
                                                "text": "Man muss die Infektion auf den Herd lokalisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0bfb9919-7518-3688-8634-73c97a390aae",
                                        "entry_id": "f56888ec-5ff5-34af-ad97-5e313b43b63e",
                                        "glosses": [
                                            "ein Produkt oder eine Dienstleistung in eine bestimmte Sprache oder Kultur unter Berücksichtigung der lokalen Verhältnisse übertragen"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38625852-779c-4fa1-8c7b-e7551acaa800",
                                                "sense_id": "0bfb9919-7518-3688-8634-73c97a390aae",
                                                "text": "Bei der Entwicklung dieser Anwendung wurde darauf geachtet, dass sie einfach lokalisiert werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
