                        "glosses": [
                            "gebrek aan energie; situatie waarbij de vraag naar energie groter is dan het aanbod"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d42f35-73ca-41b3-a60d-8e2b5dca89a9",
                                "sense_id": "a7026fad-be3f-37da-87a3-abf9aa23a098",
                                "text": "Nu de winter invalt, vreest België een energietekort. Vanwege de kou stijgt de vraag naar energie. Door problemen in twee van de zeven kerncentrales zijn de Belgen voor een groot deel afhankelijk van stroom uit Nederland."
                            },
                            {
                                "example_id": "6e276387-20b3-4d27-a582-4b4cc5036328",
                                "sense_id": "a7026fad-be3f-37da-87a3-abf9aa23a098",
                                "text": "Schaliegas is geen structurele oplossing voor het energietekort. Er zou voor hooguit 10 jaar gas uit de bodem kunnen worden gehaald. Vooral in Noord-Brabant en Flevoland zou schaliegas te winnen zijn. Minister Kamp heeft eerder gezegd dat alleen zal worden besloten tot proefboringen als vaststaat dat die veilig zijn."
                            }
                        ]
