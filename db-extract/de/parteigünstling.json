                        "glosses": [
                            "Person, die von einer Partei eine bevorzugende Behandlung erfährt, sodass die Person davon profitiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b67696-49bf-4e8e-9e51-c879eef38db1",
                                "sense_id": "1ca3792f-9f2a-3535-a023-f61e283599cc",
                                "text": "„Parteigünstlinge erhalten millionenschwere Staatsaufträge — und führen sie häufig nicht aus.“"
                            },
                            {
                                "example_id": "614f6373-a0a1-4430-9e55-a1766589bfec",
                                "sense_id": "1ca3792f-9f2a-3535-a023-f61e283599cc",
                                "text": "„Die Machtergreifung der Nazis begrüßte Reusch anfangs und drängte bei Hitler auf die Besetzung der für die Wirtschaft wichtigen Ministerien mit Fachleuten anstatt Parteigünstlingen.“"
                            }
