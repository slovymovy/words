                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a491b545-9e41-4c83-965a-bf2eb4e8836d",
                                                "sense_id": "78ae06d3-fdaf-314a-bad0-bf4ab2032461",
                                                "text": "„Ich wollte das ehemalige Idyll deutscher Hochkultur und Zivilisationskritik nicht nur erhalten und modernisieren, sondern auch säkularisieren und amerikanisieren.“"
                                            }
