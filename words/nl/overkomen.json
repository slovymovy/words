{
    "word_family": [
        "overkomelijk",
        "overkomelijkheid",
        "overkomst",
        "overkomer",
        "komen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f1a5f74-ed41-344a-9919-abd66d6193e2",
                    "sense_definition": "Iets meemaken of ervaren doordat het plaatsvindt, vaak onverwacht of buiten de eigen controle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "happen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is mij nog nooit <w>overkomen</w>.",
                            "target_lang_translations": {
                                "en": "That has never <w>happened to</w> me.",
                                "ru": "Со мной такого никогда не <w>случалось</w>.",
                                "fr": "Cela ne m'est jamais <w>arrivé</w>."
                            }
                        },
                        {
                            "text": "Het kan iedereen <w>overkomen</w>, dus voel je niet schuldig.",
                            "target_lang_translations": {
                                "en": "It can <w>happen to</w> anyone, so don't feel guilty.",
                                "ru": "Это может <w>случиться</w> с каждым, так что не чувствуй себя виноватым.",
                                "fr": "Cela peut <w>arriver</w> à n'importe qui, alors ne te sens pas coupable."
                            }
                        },
                        {
                            "text": "Hem <w>overkwam</w> een vreselijk ongeluk tijdens de vakantie.",
                            "target_lang_translations": {
                                "en": "A terrible accident <w>happened to</w> him during the holiday.",
                                "ru": "В отпуске с ним <w>произошел</w> ужасный несчастный случай.",
                                "fr": "Un terrible accident lui est <w>arrivé</w> pendant les vacances."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebeuren",
                        "treffen"
                    ],
                    "common_phrases": [
                        "iemand overkomen",
                        "het beste dat me is overkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To occur to someone or be experienced by someone, often unexpectedly or beyond their control.",
                        "ru": "Происходить или случаться с кем-либо, часто неожиданно или помимо чьей-либо воли.",
                        "fr": "Survenir ou se produire, souvent de manière inattendue ou indépendante de la volonté de quelqu'un."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "happen to",
                                "target_lang_sense_clarification": "to occur to someone"
                            },
                            {
                                "target_lang_word": "befall",
                                "target_lang_sense_clarification": "formal or literary; usually regarding something negative"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "происходить с кем-либо"
                            },
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "иметь место, совершаться"
                            },
                            {
                                "target_lang_word": "стрястись",
                                "target_lang_sense_clarification": "разг.; случиться (обычно о чем-то неприятном)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "arriver",
                                "target_lang_sense_clarification": "se produire, survenir (souvent impersonnel)"
                            },
                            {
                                "target_lang_word": "survenir",
                                "target_lang_sense_clarification": "arriver de façon imprévue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc804866-f97d-31ed-be68-87f7eddc5d3e",
                    "sense_definition": "Van een andere plaats naar de spreker toe komen, vaak voor een bezoek.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn ouders zijn speciaal voor mijn verjaardag <w>overgekomen</w>.",
                            "target_lang_translations": {
                                "en": "My parents <w>came over</w> especially for my birthday.",
                                "ru": "Мои родители специально <w>приехали</w> на мой день рождения.",
                                "fr": "Mes parents sont <w>venus</w> spécialement pour mon anniversaire."
                            }
                        },
                        {
                            "text": "<w>Kom</w> je vanavond even <w>over</w> om een film te kijken?",
                            "target_lang_translations": {
                                "en": "Are you <w>coming over</w> tonight to watch a movie?",
                                "ru": "Ты <w>зайдешь</w> сегодня вечером посмотреть фильм?",
                                "fr": "Tu <w>passes</w> ce soir pour regarder un film ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "langskomen"
                    ],
                    "common_phrases": [
                        "laten overkomen",
                        "uit het buitenland overkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To travel from another place to where the speaker is, usually for a visit.",
                        "ru": "Приезжать или приходить к говорящему из другого места, часто с визитом.",
                        "fr": "Se déplacer d'un lieu vers l'endroit où se trouve le locuteur, généralement pour une visite."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come over",
                                "target_lang_sense_clarification": "to visit someone at their location"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "приезжать",
                                "target_lang_sense_clarification": "прибывать (обычно транспортом или издалека)"
                            },
                            {
                                "target_lang_word": "приходить",
                                "target_lang_sense_clarification": "прибывать (пешком или в общем смысле)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "venir",
                                "target_lang_sense_clarification": "se rendre vers le locuteur"
                            },
                            {
                                "target_lang_word": "passer",
                                "target_lang_sense_clarification": "rendre une courte visite"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1bac14b-43b5-33e5-9807-118d71128c6a",
                    "sense_definition": "Een bepaalde indruk wekken op iemand anders.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "seem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn grapje <w>kwam</w> bij de collega's verkeerd <w>over</w>.",
                            "target_lang_translations": {
                                "en": "His joke <w>came across</w> wrong to his colleagues.",
                                "ru": "Его шутка была неправильно <w>воспринята</w> коллегами.",
                                "fr": "Sa blague a été mal <w>perçue</w> par ses collègues."
                            }
                        },
                        {
                            "text": "Ze <w>komt</w> heel zelfverzekerd <w>over</w> tijdens presentaties.",
                            "target_lang_translations": {
                                "en": "She <w>comes across</w> as very confident during presentations.",
                                "ru": "На презентациях она <w>производит впечатление</w> очень уверенного человека.",
                                "fr": "Elle <w>donne</w> une impression de grande assurance lors des présentations."
                            }
                        },
                        {
                            "text": "Ik hoop dat mijn bericht niet onbeleefd <w>overkomt</w>.",
                            "target_lang_translations": {
                                "en": "I hope my message doesn't <w>come across</w> as rude.",
                                "ru": "Надеюсь, мое сообщение не <w>покажется</w> грубым.",
                                "fr": "J'espère que mon message ne <w>paraît</w> pas impoli."
                            }
                        }
                    ],
                    "synonyms": [
                        "lijken",
                        "schijnen"
                    ],
                    "common_phrases": [
                        "verkeerd overkomen",
                        "goed overkomen",
                        "raar overkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a particular impression on others; to be perceived in a certain way.",
                        "ru": "Производить определенное впечатление на других; быть воспринятым определенным образом.",
                        "fr": "Donner une impression particulière aux autres ; être perçu d'une certaine manière."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come across",
                                "target_lang_sense_clarification": "to give a specific impression"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "производить впечатление",
                                "target_lang_sense_clarification": "создавать мнение о себе"
                            },
                            {
                                "target_lang_word": "восприниматься",
                                "target_lang_sense_clarification": "быть понятым определенным образом"
                            },
                            {
                                "target_lang_word": "казаться",
                                "target_lang_sense_clarification": "выглядеть каким-либо образом"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "donner l'impression de",
                                "target_lang_sense_clarification": "paraître d'une certaine façon"
                            },
                            {
                                "target_lang_word": "être perçu comme",
                                "target_lang_sense_clarification": "la manière dont on est compris par autrui"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cadeb040-ee7e-3855-aebd-8305d4c56b12",
                    "sense_definition": "De andere kant van iets bereiken, zoals een rivier, grens of obstakel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cross",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zijn de rivier veilig <w>overgekomen</w> met de boot.",
                            "target_lang_translations": {
                                "en": "We safely <w>crossed</w> the river by boat.",
                                "ru": "Мы благополучно <w>переправились</w> через реку на лодке.",
                                "fr": "Nous avons <w>traversé</w> la rivière en toute sécurité en bateau."
                            }
                        },
                        {
                            "text": "Het zware onweer is de stad inmiddels <w>overgekomen</w>.",
                            "target_lang_translations": {
                                "en": "The heavy thunderstorm has <w>passed over</w> the city by now.",
                                "ru": "Сильная гроза уже <w>прошла</w> над городом.",
                                "fr": "Le violent orage a désormais <w>passé</w> la ville."
                            }
                        }
                    ],
                    "synonyms": [
                        "oversteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach the other side of an obstacle, boundary, or area.",
                        "ru": "Пересекать препятствие, границу или территорию, достигая другой стороны.",
                        "fr": "Atteindre l'autre côté d'un obstacle, d'une frontière ou d'une zone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "to go from one side to the other"
                            },
                            {
                                "target_lang_word": "get across",
                                "target_lang_sense_clarification": "to succeed in reaching the other side"
                            },
                            {
                                "target_lang_word": "pass over",
                                "target_lang_sense_clarification": "to move over an area (e.g., a storm)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переправляться",
                                "target_lang_sense_clarification": "пересекать водную преграду или препятствие"
                            },
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "двигаться над или через область (напр. о шторме)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "traverser",
                                "target_lang_sense_clarification": "passer d'un côté à l'autre"
                            },
                            {
                                "target_lang_word": "passer",
                                "target_lang_sense_clarification": "franchir un obstacle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}