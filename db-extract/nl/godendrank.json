                "senses": [
                    {
                        "sense_id": "5309c51b-5010-3cdb-88d5-7b25a463b639",
                        "entry_id": "19c2c572-05fb-32b6-b33e-7a0fb34fe136",
                        "glosses": [
                            "de drank die de goden zouden drinken en meestal zoet is en alcohol bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae2b69c-8978-4f6a-846b-c8131468a320",
                                "sense_id": "5309c51b-5010-3cdb-88d5-7b25a463b639",
                                "text": "De Egyptenaren noemden hem Nes Desher, 'de rode', en associeerden hem met Reshef, god van plagen en bliksem. In het oude China was hij 'de vurige' die symbool stond voor moord. De Indiërs hebben het in hun Vedische geschriften over Rudra — alweer 'de rode' —, die het vee laat sterven en te veel godendrank drinkt. Bij de Azteken heette hij Tezcatlipoca, eveneens een onverbeterlijke snoodaard."
                            },
                            {
                                "example_id": "c6386e6a-1a76-44f6-a273-6870f4b732ab",
                                "sense_id": "5309c51b-5010-3cdb-88d5-7b25a463b639",
                                "text": "Volgens de hindoeïstische mythologie vochten goden en demonen om een kruik met godendrank. Tijdens dat gevecht vielen er druppels van de drank op de Indiase steden Allahabad, Nashik, Ujjain en Haridwar. In die plaatsen wordt het festijn afwisselend gehouden."
                            }
                        ]
                    }
                ],
