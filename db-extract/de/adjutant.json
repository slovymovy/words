                "senses": [
                    {
                        "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                        "entry_id": "d167015f-59cb-3532-833c-84139fdbfdb6",
                        "glosses": [
                            "einem ranghöheren Befehlshaber beigeordneter Offizier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79259dba-4eb4-4205-ab11-e20593f7ac61",
                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                "text": "Im Oktober 1856 wurde er zum Leutnant befördert und in der Folge vielfach als Adjutant verwendet."
                            },
                            {
                                "example_id": "e9c62e12-7e31-4439-8757-09733d509ec5",
                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                "text": "„Zwei Tage später wurde ich vom persönlichen Adjutanten Ihrer Majestät empfangen.“"
                            },
                            {
                                "example_id": "31502705-1399-4b2f-a164-ab2b2a952e9a",
                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                "text": "„Wo sein Adjutant geblieben war, wußte man nicht.“"
                            },
                            {
                                "example_id": "ec31791c-966e-44ee-8cbc-632e06a44658",
                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                "text": "„Der Adjutant kam in scharfem Trab geritten.“"
                            },
                            {
                                "example_id": "0e2a4ac9-5267-43d1-a39a-e3824576ad1f",
                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                "text": "„In den Privaträumen nebenan tranken die Sekretärinnen und Adjutanten anschließend einen Schluck auf das frisch getraute Paar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a585f55-48c1-4159-aa68-974813ff30a1",
                        "source_entry_id": "d167015f-59cb-3532-833c-84139fdbfdb6",
                        "source_sense_id": "712644a4-6474-3190-8834-114772f39ae8",
