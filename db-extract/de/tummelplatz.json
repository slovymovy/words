                "senses": [
                    {
                        "sense_id": "217aeef8-796b-3913-9356-18d0cf446a42",
                        "entry_id": "c07bf283-b3a9-33f8-ba07-25a3a3e01e0c",
                        "glosses": [
                            "Ort, an dem sich Leute ähnlicher Interessen gern und oft aufhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e9af13-2c2d-4f4b-8c37-81205b2c7e47",
                                "sense_id": "217aeef8-796b-3913-9356-18d0cf446a42",
                                "text": "„Zu Zeiten der Anfänge Dürrenmatts und Frischs war das Café Odeon ein beliebter Tummelplatz liberaler und linker Geister, junge Künstler stießen auf alte Emigranten, die hier, wie in der Kronenhalle, verkehrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20136732-7759-494c-8305-da412b00f0bb",
                        "source_entry_id": "c07bf283-b3a9-33f8-ba07-25a3a3e01e0c",
                        "source_sense_id": "217aeef8-796b-3913-9356-18d0cf446a42",
                        "source_sense_description": "Ort, an dem sich Leute ähnlicher Interessen gern und oft aufhalten",
                        "target_lang_word": "terrain de jeu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrain de jeu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea3d01a-1f87-37ae-ab5c-1eee9be15ea8",
                                        "entry_id": "056a2c40-6afc-3308-affe-8578c339cf71",
                                        "glosses": [
                                            "Terrain spécialement aménagé pour la pratique d’un sport."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022c9a76-dd3f-4143-8268-372f8da28999",
                                                "sense_id": "8ea3d01a-1f87-37ae-ab5c-1eee9be15ea8",
                                                "text": "La balle ne doit pas être immobilisée longtemps inutilement dans le terrain de jeu ainsi que contre la bordure du terrain […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa34242-94dc-3542-b81d-29e91a3c7ec1",
                                        "entry_id": "056a2c40-6afc-3308-affe-8578c339cf71",
                                        "glosses": [
                                            "Lieu ou domaine délimité dans lequel s’exerce une activité."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a33d867-6124-44a2-ae40-3fbcc3c8587e",
                                                "sense_id": "1aa34242-94dc-3542-b81d-29e91a3c7ec1",
                                                "text": "Le terrain de jeu qui rassemble les pays riches et les pays pauvres est tout sauf équitable."
                                            },
                                            {
                                                "example_id": "9a268a10-b7ba-4a31-b519-29677b865b7b",
                                                "sense_id": "1aa34242-94dc-3542-b81d-29e91a3c7ec1",
                                                "text": "A Paris, Berlin, Moscou, Melbourne, New York, Stockholm et Bombay, le toit des métros est alors redevenu un terrain de jeu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1e89a4d-31d4-4f8f-b44d-fc8121e61e17",
                        "source_entry_id": "c07bf283-b3a9-33f8-ba07-25a3a3e01e0c",
                        "source_sense_id": "217aeef8-796b-3913-9356-18d0cf446a42",
                        "source_sense_description": "Ort, an dem sich Leute ähnlicher Interessen gern und oft aufhalten",
                        "target_lang_word": "haut lieu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haut lieu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7604e279-c423-3615-b740-2ae8e17f74ab",
                                        "entry_id": "dfc8bb76-ed5f-3940-80e6-a6d49a2cbb88",
                                        "glosses": [
                                            "Rang social élevé."
                                        ],
                                        "tags": [
                                            "dated",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45376609-d724-44fd-b9e0-2d42d5c2489f",
                                                "sense_id": "7604e279-c423-3615-b740-2ae8e17f74ab",
                                                "text": "Les uns sont convaincus que la liberté doit s'allier avec des formes qui long-temps ont semblé la proscrire, qu'elle peut être à la fois d'allure populaire et d'origine de haut lieu, qu'elle reste enfin une noble affranchie et continue le passé qu'elle modifie. Ce sont les légitimistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2603a2ed-7f0d-3c38-8df0-609c0915ddae",
                                        "entry_id": "dfc8bb76-ed5f-3940-80e6-a6d49a2cbb88",
                                        "glosses": [
                                            "La cour, chez le souverain."
                                        ],
                                        "tags": [
                                            "especially",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9cb2087-2300-4ef6-9dbd-7524c3d68ac5",
                                                "sense_id": "2603a2ed-7f0d-3c38-8df0-609c0915ddae",
                                                "text": "Lambert se fit long-temps un malin plaisir de se jouer des gens de haut lieu. Il ne regardait pas à laisser. échapper de belles recettes, ni aux risques de perdre pensions et protecteurs quand il s’agissait de mettre un grand seigneur dans l’embarras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f61c68e-a2b5-3524-8d11-e856f91e65c2",
                                        "entry_id": "dfc8bb76-ed5f-3940-80e6-a6d49a2cbb88",
                                        "glosses": [
                                            "Les sphères élevées d’une nation ; les personnes qui composent le gouvernement."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e94ecde3-5b97-4bc9-b5de-1415549f5e89",
                                                "sense_id": "8f61c68e-a2b5-3524-8d11-e856f91e65c2",
                                                "text": "C’est qu’il a une faveur à me demander : celle d’intercéder pour lui auprès de l’omnipotent grand vizir. Car il paraît qu’il est assez mal noté en haut lieu et il craint de perdre son poste."
                                            },
                                            {
                                                "example_id": "bafbb6cf-3500-4e5f-8db1-b066053460d1",
                                                "sense_id": "8f61c68e-a2b5-3524-8d11-e856f91e65c2",
                                                "text": "Mais je fus prévenu de Belgrade (du plus haut lieu) que je serais déporté si j’arrêtais la publication du journal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ebad50e-0cab-3fc8-9700-0f181aea8c5e",
                                        "entry_id": "dfc8bb76-ed5f-3940-80e6-a6d49a2cbb88",
                                        "glosses": [
                                            "Lieu remarquable dans l’imaginaire d’une collectivité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e1c09f-9ab7-4b50-8551-2a373a0fb788",
                                                "sense_id": "1ebad50e-0cab-3fc8-9700-0f181aea8c5e",
                                                "text": "Il était donc logique qu’en juillet 1958, je termine mon voyage de noce en ce haut lieu (châteaux de la Loire en 2 CV et guitoune de camping) avec pour chauffeur mon tout nouveau beau-frère, car je ne savais pas encore conduire."
                                            },
                                            {
                                                "example_id": "d7f8c068-0863-475a-af06-cb665e881039",
                                                "sense_id": "1ebad50e-0cab-3fc8-9700-0f181aea8c5e",
                                                "text": "Certaines places urbaines relèvent du haut lieu. La définition la plus concise du haut lieu est la suivante : un lieu doté d’une saillance dans l’espace et d’une prégnance dans le temps. La saillance dans l’espace, c’est son caractère physique aisément reconnaissable, identifiable. Quant à la prégnance dans le temps, c’est le fait d’avoir joué un rôle pivot à un moment donné de l’Histoire."
                                            },
                                            {
                                                "example_id": "370dbf42-c132-4d3d-9195-e3d77cf7254b",
                                                "sense_id": "1ebad50e-0cab-3fc8-9700-0f181aea8c5e",
                                                "text": "Ces vagabondages dans les hauts lieux littéraires de Moscou avaient un caractère délicieusement chaotique. Dans l’ancienne ruelle Hendrikov, ils pénétraient à l’intérieur de la cour de l’immeuble où, croyaient-ils à tort, Maïakovski s’était suicidé, […]."
                                            },
                                            {
                                                "example_id": "b9c88548-527c-42fc-80b6-cdfc1aa87ede",
                                                "sense_id": "1ebad50e-0cab-3fc8-9700-0f181aea8c5e",
                                                "text": "Afin de donner à la piste une longueur de 2 500 mètres, un bout de la colline Anne-Marie a été raboté, même si elle fait partie de ces 46 hauts lieux de la bataille auxquels on ne peut en théorie toucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "273da505-1347-3429-860f-632089c43f88",
                                        "entry_id": "dfc8bb76-ed5f-3940-80e6-a6d49a2cbb88",
                                        "glosses": [
                                            "Endroit particulièrement spécialisé dans une fonction ; aussi terrain de jeu (au sens étendu)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f296b5-51b4-4e70-8c27-b88a24cd0274",
                                                "sense_id": "273da505-1347-3429-860f-632089c43f88",
                                                "text": "Me fondant sur des textes d’époque aussi bien que sur ma propre expérience de moine dans ce haut lieu du bouddhisme, je voudrais vous présenter ici un tableau vivant de la vie quotidienne à Drépung, […]."
                                            },
                                            {
                                                "example_id": "788836d5-b4e4-45f0-8c78-33d514735d1b",
                                                "sense_id": "273da505-1347-3429-860f-632089c43f88",
                                                "text": "Il ne s’était pas diverti à paraître dans les salons, hauts lieux du papillonnage, où paonnaient des sots éventés et des sirènes plâtrées, et où cancanaient des caillettes d'alcôve et des potiches au ventre rembourré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
