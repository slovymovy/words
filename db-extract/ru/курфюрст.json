                    },
                    {
                        "translation_id": "8ba32759-6fa3-4273-814f-1c25793a4d92",
                        "source_entry_id": "a1045ecc-6511-3c8f-a54b-d802fec81205",
                        "source_sense_id": "e19d1899-3a08-3906-a9c1-bc89f1768a08",
                        "target_lang_word": "Kurfürst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurfürst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                        "entry_id": "328e34e8-d1be-3fe6-a753-c2de7cdb3a4c",
                                        "glosses": [
                                            "ein Reichsfürst des Heiligen Römischen Reiches Deutscher Nation, der das Recht hatte, an der Wahl des römisch-deutschen Königs teilzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8695ddca-b908-4747-b5fb-e2782a266209",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„In § 1 werden zunächst die Kurfürsten verpflichtet, ihren Mitkurfürsten oder deren Wahlgesandten auf Verlangen sicheres Geleit durch ihr Gebiet und, sofern sie dazu imstande sind, auch darüber hinaus zu gewähren.“"
                                            },
                                            {
                                                "example_id": "1abc5334-8701-4461-bfbf-af9bdd4a6698",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„So sehr Kurfürst Friedrich Wilhelm nun auch bestrebt war, die durch den Krieg verursachten wirtschaftlichen Schäden zu heilen, konnte er doch dem Lande neue Lasten nicht ersparen.“"
                                            },
                                            {
                                                "example_id": "3ec1a8cb-6203-412b-a6c9-07017d9f263a",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„Jedenfalls musste der Kurfürst Truppen einsetzen, um die Rebellion niederzuschlagen.“"
                                            },
                                            {
                                                "example_id": "03e0c0cd-20e7-465e-9375-6ef1ae0f7f4e",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„Die Erzbischöfe von Köln waren mächtige Leute, Kanzler und Kurfürsten des Heiligen Römischen Reiches Deutscher Nation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
