                ],
                "senses": [
                    {
                        "sense_id": "dc7af46b-8a9e-3676-a3a0-a7997543acc3",
                        "entry_id": "3d5004ce-5afd-3456-8bd4-a57be3fdd621",
                        "glosses": [
                            "mit Altersflecken bedeckt, fleckig aufgrund hohen Alters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f4d9e04-bc5a-4e95-b4b2-4b7ec82c1a36",
                                "sense_id": "dc7af46b-8a9e-3676-a3a0-a7997543acc3",
                                "text": "„Johnson Meechum saß auf dem erhöhten Sitz im Bug des Bootes an den Schalt- und Steuerknüppeln, und seine Frau Mabel saß im Heck unmittelbar vor dem Propeller, sodass ihr für gewöhnlich sorgfältig frisiertes blaues Haar unkontrolliert über ihren altersfleckigen Schädel geblasen wurde.“"
                            },
                            {
                                "example_id": "decfc0e5-24db-4240-bbb1-b999a4ee6925",
                                "sense_id": "dc7af46b-8a9e-3676-a3a0-a7997543acc3",
                                "text": "„Als Woodbine seine Hände aus den Taschen zieht, sind sie weder abgearbeitet noch altersfleckig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
