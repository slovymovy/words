                    {
                        "sense_id": "bb639869-e4d1-324f-b4c0-49c7325e3ad9",
                        "entry_id": "614eea02-b5d8-348b-beb0-bd5978ea99e9",
                        "glosses": [
                            "Either rear half of a side of beef, mutton, veal, lamb or by extension from another edible mammal."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dc244cfd-c190-3983-8afa-909bad5805f5",
                        "entry_id": "614eea02-b5d8-348b-beb0-bd5978ea99e9",
                        "glosses": [
                            "The hind biped (leg) of a quadruped, or all body parts situated behind the hind legs' trunk-attachment."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0c344dcb-c219-4857-a4c7-29bf9bdeca2f",
                                "sense_id": "dc244cfd-c190-3983-8afa-909bad5805f5",
                                "text": "While Major was speaking four large rats had crept out of their holes and were sitting on their hindquarters, listening to him."
                            }
                        ]
                    },
                    {
                        "sense_id": "be4b3d77-ad56-384a-8a08-f4a95b457505",
                        "entry_id": "614eea02-b5d8-348b-beb0-bd5978ea99e9",
                        "glosses": [
                            "Human behind, butt."
                        ],
                        "tags": [
                            "derogatory",
                            "metonymically",
                            "plural-normally"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f747a9a-2b2f-471f-97bd-03a9601c04e1",
                        "source_entry_id": "614eea02-b5d8-348b-beb0-bd5978ea99e9",
                        "source_sense_description": "rear half of a side of an animal",
                        "target_lang_word": "achtereinde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achtereinde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a8e4c8e9-e6d5-3830-bd02-fa2824ce1e7a",
                                        "entry_id": "92d5c1e7-4c47-3c35-b630-3a2844918ff3",
                                        "glosses": [
                                            "het achterste deel van een voorwerp dat een voorkant en achtereinde heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b03958b-2e65-4875-b11e-7bb443d9ae3c",
                                                "sense_id": "a8e4c8e9-e6d5-3830-bd02-fa2824ce1e7a",
                                                "text": "“De verdenking bestond eruit dat onderzoek uitwees dat aannemelijk was geworden dat de brand in de cel van de gewezen verdachte is ontstaan. Hij verklaarde zelf dat hij een brandende sigaret of shagje in de richting van het achtereinde van zijn bed heeft weggeschoten en dat hij daar ook vlammen heeft gezien. Verdachte heeft dan ook zelf op niet onaanzienlijke wijze bijgedragen aan het ontstaan van de verdenking.”"
                                            },
                                            {
                                                "example_id": "b2351ed8-c085-4b46-b51b-47e533e6ff04",
                                                "sense_id": "a8e4c8e9-e6d5-3830-bd02-fa2824ce1e7a",
                                                "text": "Achtereinde van een ezel. Dat is wat je krijgt als je Balkenende uit het Engels terugvertaalt. Op de foto zie je - als je goed kijkt - dat Bush er nog altijd een beetje om moet nagrinniken. Van zijn media-adviseurs hoefde hij de lach niet eens van zijn gezicht te vegen. Bush grinnikt dag en nacht een beetje na. Ook jouw pr-team deed zijn werk niet kwaad, Balk. Je stáát er. Weliswaar als de bruidegom op een Siciliaanse trouwfoto, geschoten door de baas van de lokale fotowinkel, maar je staat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b60e02fe-1f40-48a5-80e6-011913ec5a4d",
                        "source_entry_id": "614eea02-b5d8-348b-beb0-bd5978ea99e9",
                        "source_sense_description": "rear half of a side of an animal",
                        "target_lang_word": "achterhand",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
