                                                "sense_id": "91028285-cf6c-38f9-a89c-e49b0eb9ae3c",
                                                "text": "Le vocalisme du français est riche."
                                            },
                                            {
                                                "example_id": "e3436817-d09a-4c99-b2d2-01afe178bc90",
                                                "sense_id": "91028285-cf6c-38f9-a89c-e49b0eb9ae3c",
                                                "text": "La richesse du vocalisme médiéval était encore accrue par une floraison de diphtongues dont il ne reste plus rien en dehors des parlers régionaux."
                                            }
                                        ]
                                    }
                                ]
                            }
