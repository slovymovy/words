                                "example_id": "fe3cb632-7cbc-4d81-b12a-f44378de8dfa",
                                "sense_id": "39d3d9b4-f801-3663-87cb-0501043617db",
                                "text": "Het ruimteschip zal het zonnestelsel verlaten.",
                                "translation": "The spaceship will leave the solar system.",
                                "english": "The spaceship will leave the solar system."
                            },
                            {
                                "example_id": "b9a87c47-d199-42f5-ac17-e53eaea72a82",
                                "sense_id": "39d3d9b4-f801-3663-87cb-0501043617db",
                                "text": "De bemanning van het ruimteschip maakte contact met buitenaardse wezens.",
                                "translation": "The crew of the spaceship made contact with aliens.",
                                "english": "The crew of the spaceship made contact with aliens."
                            },
                            {
                                "example_id": "b8710d75-562f-4ef2-84fa-9f9804cf4fcb",
                                "sense_id": "39d3d9b4-f801-3663-87cb-0501043617db",
                                "text": "Het ruimtescheepje was ontworpen voor korte missies.",
                                "translation": "The small spaceship was designed for short missions.",
                                "english": "The small spaceship was designed for short missions."
                            }
                        ]
                    }
