{
    "word_family": [
        "attestation",
        "attestor",
        "attester"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ad11112-cae0-3c78-9241-854be8592f20",
                    "sense_definition": "To declare or confirm that something is true, genuine, or correct, often based on personal experience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "testify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anyone who has traveled there can <w>attest</w> that the mountain roads are quite dangerous.",
                            "target_lang_translations": {
                                "ru": "Любой, кто бывал там, может <w>подтвердить</w>, что горные дороги весьма опасны."
                            }
                        },
                        {
                            "text": "The appraiser will <w>attest</w> to the authenticity of the ancient oil painting.",
                            "target_lang_translations": {
                                "ru": "Оценщик <w>подтвердит</w> подлинность старинной картины, написанной маслом."
                            }
                        }
                    ],
                    "synonyms": [
                        "confirm",
                        "vouch",
                        "verify"
                    ],
                    "antonyms": [
                        "deny",
                        "refute"
                    ],
                    "common_phrases": [
                        "attest to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявлять или подтверждать, что что-либо является истинным, подлинным или правильным, часто основываясь на личном опыте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "истинность или факт"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "давать подтверждение чему-либо"
                            },
                            {
                                "target_lang_word": "ручаться",
                                "target_lang_sense_clarification": "за истинность или качество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "404c0ef1-1f08-3c46-b513-c3ba29e6ff50",
                    "sense_definition": "To serve as clear evidence of something; to demonstrate or show.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "testify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her rapid promotion clearly <w>attests</w> to her dedication and leadership skills.",
                            "target_lang_translations": {
                                "ru": "Её быстрое повышение по службе явно <w>свидетельствует</w> о её преданности делу и лидерских качествах."
                            }
                        },
                        {
                            "text": "The long lines outside the new bakery <w>attest</w> its immediate popularity among locals.",
                            "target_lang_translations": {
                                "ru": "Длинные очереди перед новой пекарней <w>говорят</w> о её мгновенной популярности среди местных жителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "demonstrate",
                        "evidence",
                        "indicate"
                    ],
                    "antonyms": [
                        "disprove",
                        "belie"
                    ],
                    "common_phrases": [
                        "attest to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить явным свидетельством или доказательством чего-либо; демонстрировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "о наличии чего-либо, служить признаком"
                            },
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "о чём-либо, указывать"
                            },
                            {
                                "target_lang_word": "доказывать",
                                "target_lang_sense_clarification": "служить подтверждением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3511ed54-0cd7-31e5-9419-20e6b20d5489",
                    "sense_definition": "To formally authenticate or certify a document by signature, seal, or oath.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "certify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A certified notary had to <w>attest</w> the signature on the legal document.",
                            "target_lang_translations": {
                                "ru": "Дипломированный нотариус должен был <w>заверить</w> подпись на юридическом документе."
                            }
                        },
                        {
                            "text": "You must <w>attest</w> your will in order for it to be valid in court.",
                            "target_lang_translations": {
                                "ru": "Вы должны официально <w>удостоверить</w> завещание, чтобы оно имело юридическую силу в суде."
                            }
                        }
                    ],
                    "synonyms": [
                        "certify",
                        "authenticate",
                        "witness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально заверять или удостоверять подлинность документа подписью, печатью или клятвой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заверять",
                                "target_lang_sense_clarification": "документ или подпись"
                            },
                            {
                                "target_lang_word": "удостоверять",
                                "target_lang_sense_clarification": "подлинность юридически"
                            },
                            {
                                "target_lang_word": "скреплять подписью",
                                "target_lang_sense_clarification": "в качестве свидетеля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1022ad93-5da5-3655-95ce-ecb00e4eb6a2",
                    "sense_definition": "To call upon as a witness, or to invoke.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "invoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his solemn prayer, the king <w>attested</w> heaven to witness his pure intentions.",
                            "target_lang_translations": {
                                "ru": "В своей торжественной молитве король <w>призвал</w> небеса в свидетели своих чистых намерений."
                            }
                        },
                        {
                            "text": "The ancient hero <w>attests</w> the gods before entering the perilous battle.",
                            "target_lang_translations": {
                                "ru": "Древний герой <w>призывает в свидетели</w> богов перед тем, как вступить в смертельную битву."
                            }
                        }
                    ],
                    "synonyms": [
                        "invoke"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in archaic or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Призывать кого-либо или что-либо в свидетели (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призывать в свидетели",
                                "target_lang_sense_clarification": "богов, высшие силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82d14385-e3d0-3877-b615-844b052672aa",
                    "sense_definition": "To place someone under oath.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "certify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magistrate will <w>attest</w> the recruits before they assume their official duties.",
                            "target_lang_translations": {
                                "ru": "Магистрат <w>приведёт к присяге</w> новобранцев, прежде чем они приступят к исполнению своих служебных обязанностей."
                            }
                        },
                        {
                            "text": "The court officer was instructed to <w>attest</w> each juror before trial began.",
                            "target_lang_translations": {
                                "ru": "Судебному приставу было поручено <w>привести к присяге</w> каждого присяжного до начала судебного процесса."
                            }
                        }
                    ],
                    "synonyms": [
                        "swear"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить кого-либо к присяге (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводить к присяге",
                                "target_lang_sense_clarification": "официально"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}