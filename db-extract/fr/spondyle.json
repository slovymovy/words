                        "entry_id": "8e8ffa2e-eeef-346d-8839-fd08a523433c",
                        "glosses": [
                            "Mollusque bivalve hérissé de piquants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89ad58b-4d73-423f-bd18-de0f70f1a8c9",
                                "sense_id": "1d8a94a1-1f6f-35a1-8984-a7dc512fb729",
                                "text": "De la nacre de spondyle rose et violette."
                            },
                            {
                                "example_id": "ff99d0d1-84b2-4cdd-bd80-f90cfc92f023",
                                "sense_id": "1d8a94a1-1f6f-35a1-8984-a7dc512fb729",
                                "text": "Les écrits des Espagnols qui ont colonisé le Pérou indiquent qu'un serviteur devait créer un tapis rouge, fait de coquilles de spondyles pulvérisées, sous les pas du souverain."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f1b3759-f0e9-3d2f-8c83-712dc551e1a8",
                        "entry_id": "8e8ffa2e-eeef-346d-8839-fd08a523433c",
                        "glosses": [
                            "Synonyme savant de vertèbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c2a2a77-6d78-4493-af4e-220380bc00b6",
                                "sense_id": "0f1b3759-f0e9-3d2f-8c83-712dc551e1a8",
                                "text": "Par contre, le spondyle est fréquemment atteint ainsi que l'arc postérieur. Les abcès paravertébraux et épiduraux sont fréquents et bien démontrés par l'IRM."
                            }
                        ]
                    }
