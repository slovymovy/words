                        "glosses": [
                            "ruimte in een voertuig waarin bagage van de passagiers vervoert wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3effd92d-834f-470c-886e-5eb3152df095",
                                "sense_id": "925b8d93-23a3-3ebe-bb0e-afe17fc5a461",
                                "text": "Het zou gaan om handbagage waar geen plek meer voor is in de cabine, die noodgedwongen is opgeslagen in het bagageruim."
                            },
                            {
                                "example_id": "6377b063-aed4-48ce-bb4f-cefbe617a4d2",
                                "sense_id": "925b8d93-23a3-3ebe-bb0e-afe17fc5a461",
                                "text": "De dood van Senna komt hard aan in de Formule 1-wereld, waar de veiligheidsmaatregelen sindsdien flink zijn opgeschroefd. In Brazilië is het verdriet immens. De kist met Senna wordt tijdens de vlucht naar zijn vaderland niet - zoals gebruikelijk - in het bagageruim vervoerd, maar in de business class. De Braziliaanse regering besluit tot een staatsbegrafenis en kondigt drie dagen van nationale rouw af."
                            }
                        ]
                    }
