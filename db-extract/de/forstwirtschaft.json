                "senses": [
                    {
                        "sense_id": "3582f74f-0540-33cb-8224-8a15153511ce",
                        "entry_id": "42bcbdec-547b-3c5b-b5b3-0e14d418444f",
                        "glosses": [
                            "planmäßiges Handeln des wirtschaftenden Menschen im Wald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "005e80bc-b5ea-4d24-a8b8-cebd6d64969d",
                                "sense_id": "3582f74f-0540-33cb-8224-8a15153511ce",
                                "text": "Die Forstwirtschaft konzentriert sich nicht mehr so wie früher auf Monokulturen."
                            },
                            {
                                "example_id": "f4cfd05b-b413-4700-bed6-1e688fcae27c",
                                "sense_id": "3582f74f-0540-33cb-8224-8a15153511ce",
                                "text": "„Das wenige, was die Landwirtschaft in diesem rauhen Klima hervorbrachte, wurde durch Forstwirtschaft und Tierhaltung, Handel und die Herstellung von Sieben ergänzt.“"
                            },
                            {
                                "example_id": "0765a2bb-02d7-41b6-a8c7-efa3f54ff2f5",
                                "sense_id": "3582f74f-0540-33cb-8224-8a15153511ce",
                                "text": "„Noch immer sind Forstwirtschaft und Holzindustrie ihre wichtigsten Wirtschaftszweige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
