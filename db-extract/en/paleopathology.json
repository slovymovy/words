                                    {
                                        "sense_id": "ba67ea3b-839b-3bb7-b44f-1f0cc48a3483",
                                        "entry_id": "2d04b0bc-4e40-33dc-a5bb-7ebd3fc49d91",
                                        "glosses": [
                                            "Étude des pathologies, des symptômes et des maladies des populations du passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34e8024-7113-4632-85d1-b8f0123f74f8",
                                                "sense_id": "ba67ea3b-839b-3bb7-b44f-1f0cc48a3483",
                                                "text": "En archéo-anthropologie, les données liées à la mortalité, à la paléopathologie, à la stature et à l’alimentation sont accessibles pour déterminer un état de la santé des populations anciennes ; elles ont été utilisées au couvent des Jacobins."
                                            },
                                            {
                                                "example_id": "f91d6a3e-5cd1-4bb1-9b25-1a22d4a0373a",
                                                "sense_id": "ba67ea3b-839b-3bb7-b44f-1f0cc48a3483",
                                                "text": "L’apport de l’anthropologie et de la paléopathologie à la compréhension des traditions funéraires et à une meilleure connaissance des populations du passé n’est plus à démontrer."
                                            },
                                            {
                                                "example_id": "66ee2a98-3043-4cc6-8e16-3b915d2b9ad0",
                                                "sense_id": "ba67ea3b-839b-3bb7-b44f-1f0cc48a3483",
                                                "text": "La paléopathologie associe dans une démarche commune la pathologie, l’anthropologie, l’archéologie et l’histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
