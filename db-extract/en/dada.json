                    {
                        "translation_id": "9033d6f7-675f-4f7f-9f04-e70f55b383ba",
                        "source_entry_id": "0cde378c-5f3b-36f4-972b-ad528124dccd",
                        "source_sense_id": "63302d01-90c7-3ae4-9c70-5eca7f8415f8",
                        "source_sense_description": "cultural movement — see also dadaism",
                        "target_lang_word": "Dadaismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dadaismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "601858e8-8580-31f0-97aa-6ca107e19905",
                                        "entry_id": "c7a34c6d-35b5-3d6d-accc-948679b66350",
                                        "glosses": [
                                            "literarische und künstlerische Bewegung, unter dem Einfluss der Geschehnisse einsetzend während des 1. Weltkrieges, die sich gegen die bürgerliche Kultur stellt, um einen neuen Anfang zu ermöglichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "354dba0a-ab84-4bd8-8012-caf258ac2559",
                                                "sense_id": "601858e8-8580-31f0-97aa-6ca107e19905",
                                                "text": "Eine wichtige Präsentationsform des Dadaismus waren gerade die Kabaretts."
                                            },
                                            {
                                                "example_id": "81057966-8401-4d46-9574-54b8362f3f4b",
                                                "sense_id": "601858e8-8580-31f0-97aa-6ca107e19905",
                                                "text": "„Es ist das Besondere des Dadaismus, daß er nicht nur die Kunstrichtungen, sondern auch die Kunst überwand, in dem Sinne, daß die Kunst mit den anderen Sicherheitsventilen des Menschen - und diesmal waren es Menschen in Not - in eine Reihe gestellt wurde.“"
                                            },
                                            {
                                                "example_id": "546978a6-33bf-4058-87d9-a0438d949b24",
                                                "sense_id": "601858e8-8580-31f0-97aa-6ca107e19905",
                                                "text": "„Ganz fälschlich hat man den Dadaismus als eine künstlerisch oder eine philosophisch eindeutig definierbare Weltanschauung ausgegeben, während sich der echte Dadaist gerade dadurch von andern unterschied, daß er überhaupt keine hatte…“"
                                            },
                                            {
                                                "example_id": "7bab4ff6-3232-4381-bf6c-9370f986e9f1",
                                                "sense_id": "601858e8-8580-31f0-97aa-6ca107e19905",
                                                "text": "„In den Wirren des zu Ende gehenden Ersten Weltkrieges war Mehring dabei, als der Dadaismus in Berlin aus der Taufe gehoben wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
