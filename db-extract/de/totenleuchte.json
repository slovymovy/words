                "senses": [
                    {
                        "sense_id": "f7090b99-8f1a-33b9-8692-fae1a8bfd336",
                        "entry_id": "f710878c-dfec-3564-bfe1-9f7d332fd487",
                        "glosses": [
                            "freistehender Pfeiler oder Säule mit mehrseitig geöffneter Laterne, an oder innerhalb von Kirchfriedhöfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0cd9f5-7421-4639-8e8a-2d9f90cc5600",
                                "sense_id": "f7090b99-8f1a-33b9-8692-fae1a8bfd336",
                                "text": "„Totenleuchten, auch Lichtsäulen oder Armenseelenleuchten genannt, sind Denkmale aus dem christlichen Bestattungsbrauchtum und stehen in funktionaler Beziehung mit den meist nahe gelegenen Beinhäusern (Karner).“"
                            },
                            {
                                "example_id": "4357e475-3d9a-40c4-b43a-d4fff4d6b14f",
                                "sense_id": "f7090b99-8f1a-33b9-8692-fae1a8bfd336",
                                "text": "„Die freistehende \"Totenleuchte\" bestand aus einem mehr oder weniger hohen Pfeiler aus Stein, der an seinem oberen Ende ein zur Aufnahme des sogenannten \"Arme-Seelenlichtes\" bestimmtes Gehäuse trug.“"
                            },
                            {
                                "example_id": "e4eed7fb-8337-40de-ae21-c843be3167b0",
                                "sense_id": "f7090b99-8f1a-33b9-8692-fae1a8bfd336",
                                "text": "„Die Totenleuchte, im französischen Stil, wurde im 13. Jh. wahrscheinlich nach einem schon bestehenden Vorbild in Viktring errichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
