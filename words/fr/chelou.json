                    "sense_definition": "Qui sort de l'ordinaire de façon surprenante ou déconcertante ; bizarre, étrange.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "étrangeté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai entendu un bruit <w>chelou</w> venant de la cave en pleine nuit.",
                            "target_lang_translations": {
                                "en": "I heard a <w>weird</w> noise coming from the cellar in the middle of the night.",
                                "ru": "Посреди ночи из подвала доносился <w>странный</w> шум.",
                                "nl": "Ik hoorde midden in de nacht een <w>vreemd</w> geluid uit de kelder komen.",
                                "de": "Mitten in der Nacht habe ich aus dem Keller ein <w>seltsames</w> Geräusch gehört.",
                                "pl": "W środku nocy z piwnicy dochodził <w>dziwny</w> hałas.",
                                "it": "Ho sentito un rumore <w>strano</w> venire dalla cantina in piena notte.",
                                "cs": "Uprostřed noci jsem slyšel <w>divný</w> zvuk ze sklepa.",
                                "tr": "Gecenin bir yarısında mahzenden <w>garip</w> bir ses geldiğini duydum.",
                                "es": "Escuché un ruido <w>raro</w> que venía del sótano en plena noche.",
                                "zh": "半夜里我听到地窖里传来一阵<w>奇怪</w>的声音。"
                            }
                        },
                        {
                            "text": "Cette situation est vraiment <w>cheloue</w>, je ne comprends rien à ses explications.",
                            "target_lang_translations": {
                                "en": "This situation is really <w>weird</w>, I don't understand a thing from his explanations.",
                                "ru": "Эта ситуация и правда <w>странная</w>, я ничего не понимаю из его объяснений.",
                                "nl": "Deze situatie is echt <w>raar</w>, ik begrijp niets van zijn uitleg.",
                                "de": "Diese Situation ist wirklich <w>komisch</w>, ich verstehe kein Wort von seinen Erklärungen.",
                                "pl": "Ta sytuacja jest naprawdę <w>dziwna</w>, nic nie rozumiem z jego wyjaśnień.",
                                "it": "Questa situazione è davvero <w>strana</w>, non capisco niente delle sue spiegazioni.",
                                "cs": "Ta situace je opravdu <w>divná</w>, z jeho vysvětlení nechápu vůbec nic.",
                                "tr": "Bu durum gerçekten <w>garip</w>, onun anlattıklarından hiçbir şey anlamıyorum.",
                                "es": "Esta situación es realmente <w>rara</w>, no entiendo nada de sus explicaciones.",
                                "zh": "这种情况真<w>古怪</w>，他的解释我一点也听不懂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bizarre",
                        "étrange",
                        "zarbi",
                        "curieux"
