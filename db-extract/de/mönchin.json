                ],
                "senses": [
                    {
                        "sense_id": "7e926077-d5b6-3de3-ac8c-e3f22ec7c23b",
                        "entry_id": "2ef5c6c5-7776-3259-83f4-0fda42ad8f62",
                        "glosses": [
                            "Mitglied eines Frauenordens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d018f5d-3c62-4a5c-a815-191b057a4694",
                                "sense_id": "7e926077-d5b6-3de3-ac8c-e3f22ec7c23b",
                                "text": "„Dieses Institut gienge auch sogar zu den Nonnen über, und wurden daher die verschleierte Jungfrauen in Mönchinnen und Canonissinnen abgetheilet: ….“"
                            },
                            {
                                "example_id": "7be9bc6e-554b-4121-bad4-7f19ef6c7d66",
                                "sense_id": "7e926077-d5b6-3de3-ac8c-e3f22ec7c23b",
                                "text": "„Die Mönchin unterscheidet sich vom Mönche nur durch den Schleier, …“"
                            },
                            {
                                "example_id": "39a47564-3112-46dc-9d37-0b99fc0921f4",
                                "sense_id": "7e926077-d5b6-3de3-ac8c-e3f22ec7c23b",
                                "text": "„Wir erzählen die Geschichte Helenes, der einzelnen einsamen Nonne, der Mönchin.“"
                            },
                            {
                                "example_id": "4563bd11-ed1e-4086-abab-73684fa68c81",
                                "sense_id": "7e926077-d5b6-3de3-ac8c-e3f22ec7c23b",
                                "text": "„Die kleine Mönchin sah mit hochgezogener Augenbraue zu ihnen herüber und wandte sich dann wieder ihrem Buch zu.“"
                            },
                            {
                                "example_id": "a3b3dbde-8db8-45a7-b71f-753204b65887",
                                "sense_id": "7e926077-d5b6-3de3-ac8c-e3f22ec7c23b",
                                "text": "„»Die Mönchin überlasst mir«, verkündete sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
