    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4af58fd1-89e0-32e6-8280-43a91d0b5eca",
                "word": "intubation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cbdb259f-df72-4bec-ae4f-675c8702caec",
                        "entry_id": "4af58fd1-89e0-32e6-8280-43a91d0b5eca",
                        "tags": [
                            "plural"
                        ],
                        "form": "intubations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "187590c5-db0a-3556-9211-00ba03ddfe2b",
                        "entry_id": "4af58fd1-89e0-32e6-8280-43a91d0b5eca",
                        "glosses": [
                            "The introduction of a tube into an organ to keep it open, as into the larynx in cases of croup."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d75fa62e-44ae-4f17-9007-f83709da1f59",
                                "sense_id": "187590c5-db0a-3556-9211-00ba03ddfe2b",
                                "text": "Intubation, it is now claimed, offers these advantages. Since the revival of this procedure by Dr. O'Dwyer a little more than a year ago, it has been tested in many cases"
                            },
                            {
                                "example_id": "06017b0d-d42d-4327-bf26-2681e3bed0f7",
                                "sense_id": "187590c5-db0a-3556-9211-00ba03ddfe2b",
                                "text": "Before proceeding to demonstrate the method of practising intubation of the larynx on this little cadaver, I will pass around for your inspection a few of the principal varieties of tubes devised to overcome obstruction in the larynx in croup and other forms of stenosis. They will serve to show the different stages of development through which this operation has passed from its inception in January 1880 to the present time."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eebf1946-4d7a-413f-9026-79ea45eaf60a",
                        "source_entry_id": "4af58fd1-89e0-32e6-8280-43a91d0b5eca",
                        "source_sense_id": "187590c5-db0a-3556-9211-00ba03ddfe2b",
                        "source_sense_description": "introduction of a tube into an organ to keep it open",
                        "target_lang_word": "tubage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tubage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd5a117-4994-375a-982d-4dfae4d7427e",
                                        "entry_id": "6faa1fe6-d7c4-33cf-8ad7-f92c6cc64c7f",
                                        "glosses": [
                                            "Action d'introduire un tube souple ou rigide dans un conduit ou une cavité pour alimenter, prélever, examiner ou soigner un patient. → voir intubation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b047d127-f255-425e-9bcb-928da085f17f",
                                                "sense_id": "1dd5a117-4994-375a-982d-4dfae4d7427e",
                                                "text": "Faire un tubage, nourrir par tubage."
                                            },
                                            {
                                                "example_id": "cba67f81-b4a6-4c60-bf50-811a4d95f5e0",
                                                "sense_id": "1dd5a117-4994-375a-982d-4dfae4d7427e",
                                                "text": "un tubage du duodénum, du larynx, de l'estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f062a5e-45dd-3392-9f17-50f0c4fe4c11",
                                        "entry_id": "6faa1fe6-d7c4-33cf-8ad7-f92c6cc64c7f",
                                        "glosses": [
                                            "Introduction de tubes dans un forage, un puits, etc. pour en soutenir les parois : cuvelage."
                                        ],
                                        "tags": [
                                            "Industrie pétrolière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cb88762-813f-47e7-bc2b-f89bb09a9d83",
                                                "sense_id": "7f062a5e-45dd-3392-9f17-50f0c4fe4c11",
                                                "text": "Le tubage du trou de sondage a évité les éboulements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f2e05c-4700-3913-b497-4750cdee46c1",
                                        "entry_id": "6faa1fe6-d7c4-33cf-8ad7-f92c6cc64c7f",
                                        "glosses": [
                                            "L'ensemble de ces tubes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5b6e7b7-76cf-4f3f-952b-ac1e3a0eb77e",
                                                "sense_id": "33f2e05c-4700-3913-b497-4750cdee46c1",
                                                "text": "Le forage est protégé par un tubage métallique sur toute sa hauteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8000ec19-73a1-3876-a9ec-f68c13ba4c5d",
                                        "entry_id": "6faa1fe6-d7c4-33cf-8ad7-f92c6cc64c7f",
                                        "glosses": [
                                            "Remplissage d’un tube de cigarette avec du tabac à l’aide d’une tubeuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed34768-8d8e-40e6-9b6a-d070619e37a5",
                                                "sense_id": "8000ec19-73a1-3876-a9ec-f68c13ba4c5d",
                                                "text": "D’une simple pression de doigt, réalisez le tubage de votre cigarette. 5 niveaux de densité sont disponibles sur cette machine à tuber électrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9039e1-a758-3a77-bd15-466e262cbe62",
                                        "entry_id": "6faa1fe6-d7c4-33cf-8ad7-f92c6cc64c7f",
                                        "glosses": [
                                            "Mise en place d'un tube, d'un tuyau dans une cavité, un passage, ou un conduit déjà existant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133b1b07-fffe-4f04-a856-9e379b791326",
                                                "sense_id": "5e9039e1-a758-3a77-bd15-466e262cbe62",
                                                "text": "Faire le tubage d'un conduit de cheminée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05c31531-2443-3ec6-9fbf-8f63091c2a34",
                                        "entry_id": "6faa1fe6-d7c4-33cf-8ad7-f92c6cc64c7f",
                                        "glosses": [
                                            "Extraction des bouchons de liège de la bande."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
