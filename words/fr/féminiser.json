                    ]
                },
                {
                    "sense_id": "0269e5c3-a092-38d6-b96f-60b90c0781dc",
                    "sense_definition": "Prendre ou conférer un caractère, une tonalité ou une sensibilité associés aux femmes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a souhaité <w>féminiser</w> le récit en accordant une place prépondérante aux émotions."
                        },
                        {
                            "text": "Ce genre littéraire s'est progressivement <w>féminisé</w> tout au long du dix-neuvième siècle."
