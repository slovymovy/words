                        "entry_id": "eb28fdc6-73a6-3e6c-90e7-d0c9111e7e50",
                        "glosses": [
                            "Qui est en forme de cloche."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "987b89e4-22b6-40cd-9134-716b0b0dff1a",
                                "sense_id": "6c939a43-5349-3b70-a9c9-cf8048be388e",
                                "text": "Si les stries sont d’influence grecque, leur base, campaniforme, est d’inspiration égyptienne."
                            },
                            {
                                "example_id": "3bbae1b3-4e4f-4268-8db9-3d77f078c668",
                                "sense_id": "6c939a43-5349-3b70-a9c9-cf8048be388e",
                                "text": "CAMPANIFORME, adject., campaniformis ; glockenförmig (all.) ; accampanato (it.). (campana, cloche, forma, forme) ; qui a la forme d’une cloche. Se dit d’un calice ou d’une corolle monopétale régulière qui, n’ayant pas de tube, va en s’évasant insensiblement ; de la base au sommet, de manière à imiter la forme d’une cloche. Ex. Campanula Trachelium."
                            }
                        ]
                    }
