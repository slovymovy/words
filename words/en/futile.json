{
    "word_family": [
        "futility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                    "sense_definition": "Incapable of producing any useful result; doomed to fail or not worth attempting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All his <w>futile</w> attempts to fix the broken engine only made the situation worse.",
                            "target_lang_translations": {
                                "de": "All seine <w>vergeblichen</w> Versuche, den kaputten Motor zu reparieren, machten die Situation nur noch schlimmer.",
                                "ru": "Все его <w>тщетные</w> попытки починить сломанный двигатель только ухудшили ситуацию.",
                                "es": "Todos sus <w>inútiles</w> intentos de arreglar el motor averiado solo empeoraron la situación."
                            }
                        },
                        {
                            "text": "It is <w>futile</w> to argue with someone who refuses to listen to reason.",
                            "target_lang_translations": {
                                "de": "Es ist <w>zwecklos</w>, mit jemandem zu streiten, der sich der Vernunft verschließt.",
                                "ru": "<w>Бесполезно</w> спорить с тем, кто отказывается прислушиваться к голосу разума.",
                                "es": "Es <w>inútil</w> discutir con alguien que se niega a entrar en razón."
                            }
                        }
                    ],
                    "synonyms": [
                        "useless",
                        "fruitless",
                        "pointless",
                        "vain"
                    ],
                    "antonyms": [
                        "effective",
                        "worthwhile"
                    ],
                    "common_phrases": [
                        "futile attempt",
                        "futile effort"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht imstande, ein nützliches Ergebnis zu erzielen; von vornherein zum Scheitern verurteilt oder sinnlos zu versuchen.",
                        "ru": "Не приносящий полезного результата; обреченный на неудачу или бессмысленный.",
                        "es": "Incapaz de producir un resultado útil; condenado al fracaso o que no merece la pena intentar."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vergeblich",
                                "target_lang_sense_clarification": "ohne den erhofften Erfolg bleibend"
                            },
                            {
                                "target_lang_word": "sinnlos",
                                "target_lang_sense_clarification": "ohne jeden vernünftigen Zweck"
                            },
                            {
                                "target_lang_word": "zwecklos",
                                "target_lang_sense_clarification": "kein brauchbares Ergebnis versprechend"
                            },
                            {
                                "target_lang_word": "aussichtslos",
                                "target_lang_sense_clarification": "ohne jede Chance auf Gelingen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тщетный",
                                "target_lang_sense_clarification": "безрезультатный, напрасный"
                            },
                            {
                                "target_lang_word": "бесполезный",
                                "target_lang_sense_clarification": "не дающий нужного результата"
                            },
                            {
                                "target_lang_word": "напрасный",
                                "target_lang_sense_clarification": "сделанный зря, впустую"
                            },
                            {
                                "target_lang_word": "бесплодный",
                                "target_lang_sense_clarification": "не приносящий плодов или успехов"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "inútil",
                                "target_lang_sense_clarification": "que no produce ningún resultado o beneficio"
                            },
                            {
                                "target_lang_word": "vano",
                                "target_lang_sense_clarification": "sin fruto, efecto ni trascendencia"
                            },
                            {
                                "target_lang_word": "infructuoso",
                                "target_lang_sense_clarification": "que no da el fruto o el éxito esperado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a0728a3-2f94-302a-babb-77cbc376a9b2",
                    "sense_definition": "Lacking importance or seriousness; trivial and frivolous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee spent hours discussing <w>futile</w> details that had no impact on the final decision.",
                            "target_lang_translations": {
                                "de": "Der Ausschuss verbrachte Stunden damit, über <w>nichtige</w> Details zu diskutieren, die keinen Einfluss auf die endgültige Entscheidung hatten.",
                                "ru": "Комитет потратил часы на обсуждение <w>пустячных</w> деталей, которые никак не влияли на окончательное решение.",
                                "es": "El comité pasó horas debatiendo detalles <w>fútiles</w> que no tuvieron ningún impacto en la decisión final."
                            }
                        },
                        {
                            "text": "He was tired of the <w>futile</w> gossip that filled their daily conversations.",
                            "target_lang_translations": {
                                "de": "Er war des <w>müßigen</w> Klatsches überdrüssig, der ihre täglichen Gespräche bestimmte.",
                                "ru": "Ему надоели <w>пустые</w> сплетни, наполнявшие их ежедневные разговоры.",
                                "es": "Estaba cansado de los chismes <w>triviales</w> que llenaban sus conversaciones diarias."
                            }
                        }
                    ],
                    "synonyms": [
                        "idle",
                        "inane"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne Bedeutung oder Ernsthaftigkeit; belanglos, nichtig und oberflächlich.",
                        "ru": "Лишенный важности или серьезности; пустой, пустячный или легкомысленный.",
                        "es": "Carente de importancia o seriedad; trivial, frívolo o sin sustancia."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nichtig",
                                "target_lang_sense_clarification": "völlig unbedeutend oder belanglos"
                            },
                            {
                                "target_lang_word": "belanglos",
                                "target_lang_sense_clarification": "ohne nennenswerte Wichtigkeit"
                            },
                            {
                                "target_lang_word": "müßig",
                                "target_lang_sense_clarification": "überflüssig und unnütz"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "лишенный серьезного содержания, пустяковый"
                            },
                            {
                                "target_lang_word": "пустячный",
                                "target_lang_sense_clarification": "мелкий, незначительный"
                            },
                            {
                                "target_lang_word": "ничтожный",
                                "target_lang_sense_clarification": "не имеющий никакого значения"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fútil",
                                "target_lang_sense_clarification": "de poco o ningún aprecio o importancia"
                            },
                            {
                                "target_lang_word": "trivial",
                                "target_lang_sense_clarification": "que no reviste importancia ni seriedad"
                            },
                            {
                                "target_lang_word": "insignificante",
                                "target_lang_sense_clarification": "que carece de relevancia o entidad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}