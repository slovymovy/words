                        "examples": [
                            {
                                "example_id": "c01c05f3-89c1-45a4-9619-5380373047d2",
                                "sense_id": "f7319e01-6819-359b-9839-47e691db6c34",
                                "text": "Die Straße war durch einen Absperrbalken blockiert."
                            },
                            {
                                "example_id": "e1af2e47-1315-4960-82ae-c3aa164eb9ed",
                                "sense_id": "f7319e01-6819-359b-9839-47e691db6c34",
                                "text": "Ein Absperrbalken ist eine Latte, welche in verschiedenen Innen- und Außenanlagen eingesetzt werden kann, um bestimmte Bereiche zu kennzeichnen."
                            },
                            {
                                "example_id": "4f3f7646-aaaf-46d4-a8ca-b153bc7e385e",
                                "sense_id": "f7319e01-6819-359b-9839-47e691db6c34",
                                "text": "Heutzutage besteht ein Absperrbalken aus Polyester (Kunststoff). Es gibt auch eine Variante, bei welcher der Absperrbalken zusätzlich mit Glasfaser verstärkt ist."
                            }
                        ],
