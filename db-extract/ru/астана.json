                ],
                "translations": [
                    {
                        "translation_id": "2925f64c-37a8-4528-8eef-663768e75c4d",
                        "source_entry_id": "5a31f52c-7364-3cf9-86bc-f9537aca6696",
                        "source_sense_id": "331c1411-44d0-3231-bbd5-6491889bf009",
                        "target_lang_word": "Astana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26a356dd-77c6-3950-85c2-dd65cf4b1a85",
                                        "entry_id": "74bf4f3c-ffce-3591-855b-1f1934597ff7",
                                        "glosses": [
                                            "The capital city of Kazakhstan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c7ca2f-55d1-4d25-970f-25afd1e45ccd",
                                                "sense_id": "26a356dd-77c6-3950-85c2-dd65cf4b1a85",
                                                "text": "At a signing ceremony in the Kazakh capital, Astana, on May 29, the presidents of Russia, Belarus, and Kazakhstan ratified the Eurasian Economic Union (EEU) into existence. An EEU modeled on the European Union was first mooted back in 1994 by Kazakh President Nursultan Nazarbayev, but took off only after his Russian counterpart, Vladimir Putin, seized upon its potential as a Moscow-centered, Asia-oriented alternative to the EU."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d351de9d-ad78-4850-b5c2-a9f1d7e26934",
                        "source_entry_id": "5a31f52c-7364-3cf9-86bc-f9537aca6696",
                        "source_sense_id": "331c1411-44d0-3231-bbd5-6491889bf009",
                        "target_lang_word": "Astana",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astana",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                        "entry_id": "867e2c96-b778-3b96-8e74-dbb88a7bf41b",
                                        "glosses": [
                                            "Hauptstadt Kasachstans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58defa69-ebf6-494f-9740-aa449478c685",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "„Astana liegt in einer großräumigen Steppenlandschaft im Übergangsbereich zwischen dem russisch geprägten Norden Kasachstans und dem extrem dünn besiedelten Landeszentrum am Fluss Ischim.“"
                                            },
                                            {
                                                "example_id": "c5272a47-d5ce-4a39-9458-61aa874f9232",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "„Der Bahnhof von Astana ist ein wichtiger Verkehrsknotenpunkt im Eisenbahnverkehr sowohl in Nord-Süd- (von Petropawl nach Almaty und Taschkent) als auch in Ost-West-Richtung (von Moskau nach China)“."
                                            },
                                            {
                                                "example_id": "ae4666fe-eb41-4801-87b9-0c9ff5f1137c",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "Abenteuerlich war der Transport des in der Havelberger Schiffswerft gebauten Wassercabrios in seinen Heimathafen Astana in Kasachstan.“"
                                            },
                                            {
                                                "example_id": "6c8289c2-41cd-4ce1-b6e2-d2aec8caf0ab",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "„Manfred Kern beobachtet in Astana die Kasachen, die am 7. September (20.30 Uhr) in Salzburg erster Gegner der Österreicher sein werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
