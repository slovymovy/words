                "senses": [
                    {
                        "sense_id": "1b2834b0-2eec-32b3-a012-157177bf701d",
                        "entry_id": "3fc33d1d-f89a-3c75-88df-20f57102447d",
                        "glosses": [
                            "Réapparaître à la surface après un trajet souterrain, en parlant d’une rivière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3ba115-a3c9-4c00-adf4-c9ba69d42b99",
                                "sense_id": "1b2834b0-2eec-32b3-a012-157177bf701d",
                                "text": "Comme un oiseau choisit la bonne place dans l’arbre où il veut vivre, mon village a choisi son coin dans l’argile lourde où se couline l’Aisne nonchalante, ramassant au passage l’eau des sources qui « résurgent » de ce sol imperméable."
                            },
                            {
                                "example_id": "b013e5ba-c311-44bd-adcd-4b0c79825032",
                                "sense_id": "1b2834b0-2eec-32b3-a012-157177bf701d",
                                "text": "A l’inverse du Vidourle supérieur ou du Gard inférieur qui se perdent chaque été pour résurger à de grosses sources karstiques (M. Ricolvi 19G8; G. Farre 1972 b), la Cèze disparait rarement totalement."
                            },
                            {
                                "example_id": "001cebe2-b6bb-4251-b633-fd01dd718fac",
                                "sense_id": "1b2834b0-2eec-32b3-a012-157177bf701d",
                                "text": "Ce nostos natal résurge dans l'amour."
                            }
                        ]
                    }
                ],
