                        "entry_id": "a229599b-c9a9-3bdb-a7a5-348df82b47e6",
                        "glosses": [
                            "Person, die Machtinteresse den Vorrang gegenüber der Moral gibt, sich bei Entscheidungen und Handlungen am Machiavellismus orientiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6bb24cf-4cce-4b75-a243-6b8578477a00",
                                "sense_id": "2a4cd8e7-2b9b-3710-96c2-818a8dfd90c3",
                                "text": "„Werde ich zum skrupellosen Machiavellisten, frei von Empathie und einzig auf mein Ziel fixiert?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
