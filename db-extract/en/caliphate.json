                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d449eb2-2065-3c52-a1ef-cf3ead2ac4e7",
                                        "entry_id": "b4145fee-310c-374c-82e5-c54d66a8f2ee",
                                        "glosses": [
                                            "gebied onder bestuur van een kalief"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e36b14b-8405-4401-ae47-e78ec315909b",
                                                "sense_id": "0d449eb2-2065-3c52-a1ef-cf3ead2ac4e7",
                                                "text": "Twee Nederlandse gezinnen zijn naar Syrië vertrokken om zich te vestigen in het kalifaat van de terreurbeweging Islamitische Staat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed708a39-d03c-4a5f-bc36-dae284917caf",
                        "source_entry_id": "4d9fdd8b-43a9-31d5-a0d0-b81441355775",
                        "source_sense_id": "b9d9711c-6db0-3eba-8702-8d8ff6f8b343",
                        "source_sense_description": "Islamic government",
                        "target_lang_word": "califat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "califat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79ff0b12-8070-335f-b967-a30daa8b325f",
                                        "entry_id": "1ab0c053-33bb-3266-bae2-c2fb09afb875",
                                        "glosses": [
                                            "Dignité de calife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08675348-e5c1-44d2-8c89-4a9a92d60551",
                                                "sense_id": "79ff0b12-8070-335f-b967-a30daa8b325f",
                                                "text": "Iznogoud, simple vizir, visait le califat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0a2cb7-02d4-385f-a8ea-85bc484dfa99",
                                        "entry_id": "1ab0c053-33bb-3266-bae2-c2fb09afb875",
                                        "glosses": [
                                            "Gestion des affaires musulmanes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5c2b8c7-5942-4a33-ae07-807b818074df",
                                                "sense_id": "0d0a2cb7-02d4-385f-a8ea-85bc484dfa99",
                                                "text": "Les moutakallimounes (les savants du kalâm) articulent leurs réflexions sur trois principaux thèmes : la déité, qui concerne la recherche des preuves de l'existence de l'Être divin et ses attributs; la prophétie, c'est-à-dire l'inviolabilité et les privilèges des prophètes, et le califat ou la gestion des affaires musulmanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee87b434-623c-3f4d-a3a9-ec7782da0c2d",
                                        "entry_id": "1ab0c053-33bb-3266-bae2-c2fb09afb875",
                                        "glosses": [
                                            "Période pendant laquelle un calife exerce son autorité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50a29c5b-884b-323b-8c83-e10f27a8474a",
                                        "entry_id": "1ab0c053-33bb-3266-bae2-c2fb09afb875",
                                        "glosses": [
                                            "Pouvoir exercé par un calife pendant son règne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f73f38a-3013-4ebe-9eb8-56414d1b899d",
                                                "sense_id": "50a29c5b-884b-323b-8c83-e10f27a8474a",
                                                "text": "La faiblesse du califat permit aux gouverneurs de provinces et autres satrapes d'usurper le pouvoir et de fonder ainsi, à leur gré, des dynasties de courte ou de longue durée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e93462cb-1a26-373b-a219-e23d8ac0d072",
                                        "entry_id": "1ab0c053-33bb-3266-bae2-c2fb09afb875",
                                        "glosses": [
                                            "Territoires sur lesquels s'exerce l'autorité d'un calife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a872b79-11c4-424a-9eca-e11c8f25a49b",
                                                "sense_id": "e93462cb-1a26-373b-a219-e23d8ac0d072",
                                                "text": "Le califat de Cordoue."
                                            },
                                            {
                                                "example_id": "8fe816eb-21d3-4887-8797-9603e8531c9e",
                                                "sense_id": "e93462cb-1a26-373b-a219-e23d8ac0d072",
                                                "text": "L’établissement de plusieurs califats en Arabie et en Syrie, la chute de la dynastie des Ommiades et l’élévation de celle des Abassides, remplirent la Judée de troubles et de malheurs pendant plus de deux cents ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92835a0-69dc-3981-a79b-432339adbf13",
                                        "entry_id": "1ab0c053-33bb-3266-bae2-c2fb09afb875",
                                        "glosses": [
                                            "Régime s'exerçant sur un territoire donné sous l'autorité d'un calife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5333357-6372-4748-a478-0d728bf9c7a6",
                                                "sense_id": "c92835a0-69dc-3981-a79b-432339adbf13",
                                                "text": "Il fallut pourtant attendre la proclamation du califat de Daesh, en juin 2014, et les incitations explicites au jihad sur le territoire européen qui en résultèrent pour que les autorités prissent la mesure d'un phénomène qui, six mois après, déclencherait le cataclysme à Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc39d06-eb06-3f92-a172-786e6dfbb7be",
                                        "entry_id": "1ab0c053-33bb-3266-bae2-c2fb09afb875",
                                        "glosses": [
                                            "Despotisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e27a90a-5cbe-4e90-8250-ca733a149d53",
                                                "sense_id": "1bc39d06-eb06-3f92-a172-786e6dfbb7be",
                                                "text": "Après l’aristocratie de la naissance, c’était maintenant l’aristocratie de l’argent ; c’était le califat des comptoirs, le despotisme de la rue du Sentier, la tyrannie du commerce aux idées vénales et étroites, aux instincts vaniteux et fourbes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42f538c0-dc90-478d-8280-f658924d3f8e",
                        "source_entry_id": "4d9fdd8b-43a9-31d5-a0d0-b81441355775",
                        "source_sense_id": "b9d9711c-6db0-3eba-8702-8d8ff6f8b343",
                        "source_sense_description": "Islamic government",
                        "target_lang_word": "Kalifat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalifat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69c0bde6-1151-38f2-a200-c426a9559e75",
                                        "entry_id": "75d733a7-67b3-3196-a013-5679f291c85c",
                                        "glosses": [
                                            "islamische Regierungsform, deren Oberhaupt ein Kalif ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "144e47f9-5498-4be5-b722-db22614acf97",
                                                "sense_id": "69c0bde6-1151-38f2-a200-c426a9559e75",
                                                "text": "„Die Ereignisse der frühen Geschichte des Islam erinnern moderne Islamisten an eine Welt, in der das Kalifat das mächtigste und fortschrittlichste Gemeinwesen des gesamten eurasischen Raums war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2a626ca-6792-3c52-964b-11b42545e88b",
                                        "entry_id": "75d733a7-67b3-3196-a013-5679f291c85c",
                                        "glosses": [
                                            "ein islamisches Reich, dessen Oberhaupt ein Kalif ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfdc2272-aa79-4a46-a758-317304e1b3d1",
                                                "sense_id": "a2a626ca-6792-3c52-964b-11b42545e88b",
                                                "text": "Ein bekanntes Kalifat war das der Umayyaden."
                                            },
                                            {
                                                "example_id": "fb0aaf7a-21e9-4bf9-9ffd-1a7fe1c901bd",
                                                "sense_id": "a2a626ca-6792-3c52-964b-11b42545e88b",
                                                "text": "„Selbst der oströmische Kaiser sowie der Herrscher des östlichen Kalifats schicken Gesandte an die Schlei, um sich mit Sklaven einzudecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "75a44e03-a2f1-3d2b-b6d4-bea4d8bbf860",
                                        "entry_id": "75d733a7-67b3-3196-a013-5679f291c85c",
                                        "glosses": [
                                            "Amt oder Amtszeit eines Kalifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7454ca8-f3c3-4a43-80e6-30873c15a4e0",
                                                "sense_id": "75a44e03-a2f1-3d2b-b6d4-bea4d8bbf860",
                                                "text": "(Über Yazid I., den zweiten Umayyaden-Kalifen:) Sein Kalifat war durch den Tod von Mohammeds Enkel Husain ibn Ali und den Beginn der Krise gekennzeichnet, die als zweite Fitna bekannt ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
