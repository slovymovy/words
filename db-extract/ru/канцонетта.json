                    },
                    {
                        "translation_id": "13d1c2cf-eaa0-439a-b8bf-42dc6888e61a",
                        "source_entry_id": "c262e095-1fcb-33e4-8285-bdc15e918c88",
                        "source_sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
                        "target_lang_word": "canzonetta",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canzonetta",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8c46a839-5b3f-3930-ada6-b5e90d0eea7a",
                                        "entry_id": "983e3e46-1746-3836-9737-bba462f252a4",
                                        "glosses": [
                                            "instrumentaal deel van een muziekstuk dat lijkt op een lied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "623a8cf3-2d21-40ab-9a09-6804ff648255",
                                                "sense_id": "8c46a839-5b3f-3930-ada6-b5e90d0eea7a",
                                                "text": "Niettemin werd opus 35 een van de grote uitdagingen voor iedere topviolist. Niet alleen het onstuimige, hartstochtelijke Allegro waarmee het concert begint. Of de virtuoze Finale waarmee het eindigt. Maar ook het middendeel, het intieme Canzonetta. Volgens Jansen het hart van het concert: „Voor mij gaat er niets boven dat moment van rust, waarin Tsjaikovski diepe emoties aan een gevoel van ruimte en eenvoud koppelt.”"
                                            },
                                            {
                                                "example_id": "4accab31-7b63-4648-ae55-93dea0a35e64",
                                                "sense_id": "8c46a839-5b3f-3930-ada6-b5e90d0eea7a",
                                                "text": "Van Buxtehude klinken diens Praeludium d (BuxWV 140) en Canzonetta G (BuxWV 171). Van Böhm speelt Ardesch het koraalvoorspel ”Herr Jesu Christ, dich zu uns wend’” en het Praeludium, Fuga en Postludium g."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eea031e8-8f5f-40f8-9ad8-0407dda42b04",
                        "source_entry_id": "c262e095-1fcb-33e4-8285-bdc15e918c88",
                        "source_sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
                        "target_lang_word": "canzonetta",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "289fb969-8fc2-423c-9d64-c8512dd0fa10",
                        "source_entry_id": "c262e095-1fcb-33e4-8285-bdc15e918c88",
                        "source_sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
                        "target_lang_word": "canzonetta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canzonetta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd72fec5-5da3-3e9f-90c8-f59f4f0cae02",
                                        "entry_id": "ce20a601-4da5-3a4a-84b1-0fcf38ad6bbe",
                                        "glosses": [
                                            "Chansonnette d’origine italienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1cae606-4577-4e3c-a7e5-678b5d3e5614",
                                                "sense_id": "bd72fec5-5da3-3e9f-90c8-f59f4f0cae02",
                                                "text": "En ces derniers temps, surtout pendant notre séjour à Pau, mon maître m’avait fait travailler la harpe, et je commençais à ne pas trop mal jouer quelques morceaux qu’il m’avait appris. Il y avait entre autres une canzonetta napolitaine que je chantais en m’accompagnant de la harpe et qui me valait toujours des applaudissements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
