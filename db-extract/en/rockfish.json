                            {
                                "example_id": "86bfad97-64da-43b2-a2df-7b52d3748a70",
                                "sense_id": "0c4d4d9f-929d-3aa4-9c1a-1fe52808c11f",
                                "text": "Yet another Rockfish goes under. ¶ Young Deejion was playin some hoop with some homies by da riva, wen de backetbaw fell in da river."
                            },
                            {
                                "example_id": "95907933-216a-48e4-9852-5fc0893914e0",
                                "sense_id": "0c4d4d9f-929d-3aa4-9c1a-1fe52808c11f",
                                "text": "Three nigger teenaper sows join rockfish parade. Three nigger \"teens\" reportedly drowned when the stolen car they were driving careened into a pond"
                            },
                            {
                                "example_id": "ed279e9d-52f5-49cd-a8f1-720c53f52a11",
                                "sense_id": "0c4d4d9f-929d-3aa4-9c1a-1fe52808c11f",
                                "text": "Everyone knows niggers don't surf, they sink -- like the rockfish they are"
                            }
                        ]
                    }
