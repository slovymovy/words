            "senses": [
                {
                    "sense_id": "75725955-afe0-36fc-a870-22d3b12876bb",
                    "sense_definition": "praten over onbelangrijke zaken of onzin verkopen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit toch niet zo te <w>leuteren</w> en vertel gewoon wat er echt gebeurd is.",
                            "target_lang_translations": {
                                "de": "Sitz nicht so herum und <w>labere</w>, sondern erzähl einfach, was wirklich passiert ist."
                            }
                        },
                        {
                            "text": "Hij <w>leuterde</w> urenlang over koetjes en kalfjes zonder tot de kern van de zaak te komen.",
                            "target_lang_translations": {
                                "de": "Er <w>faselte</w> stundenlang über Gott und die Welt, ohne auf den Punkt zu kommen."
                            }
                        }
                    ],
                    "synonyms": [
                        "babbelen",
                        "keuvelen",
                        "kletsen",
                        "kwebbelen"
                    ],
                    "common_phrases": [
                        "zitten te leuteren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "über unwichtige Dinge reden, faseln oder Quatsch erzählen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "faseln",
                                "target_lang_sense_clarification": "Unsinn oder wirres Zeug reden"
                            },
                            {
                                "target_lang_word": "schwatzen",
                                "target_lang_sense_clarification": "viel und belanglos reden"
                            },
                            {
                                "target_lang_word": "labern",
                                "target_lang_sense_clarification": "umgangssprachlich: belangloses Zeug reden"
                            },
                            {
                                "target_lang_word": "quasseln",
                                "target_lang_sense_clarification": "umgangssprachlich: unaufhörlich drauflosreden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86c60cb8-2845-3d7d-abe1-cfc0efca09cb",
                    "sense_definition": "onproductief bezig zijn of de tijd verdoen door te treuzelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "treuzelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als we nu niet opschieten en blijven <w>leuteren</w>, missen we gegarandeerd de laatste trein.",
                            "target_lang_translations": {
                                "de": "Wenn wir uns jetzt nicht beeilen und weiter <w>trödeln</w>, verpassen wir garantiert den letzten Zug."
                            }
                        },
                        {
                            "text": "Zij <w>leuterde</w> zo lang bij het inpakken van haar koffer dat ze bijna te laat op het vliegveld aankwam.",
                            "target_lang_translations": {
                                "de": "Sie <w>bummelte</w> beim Packen ihres Koffers so lange herum, dass sie fast zu spät am Flughafen ankam."
                            }
                        }
                    ],
                    "synonyms": [
                        "dralen",
                        "talmen",
                        "teuten"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "unproduktiv sein, trödeln oder Zeit vergeuden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "trödeln",
                                "target_lang_sense_clarification": "sehr langsam machen, Zeit vertrödeln"
                            },
                            {
                                "target_lang_word": "bummeln",
                                "target_lang_sense_clarification": "nicht vorankommen, zögern"
                            },
                            {
                                "target_lang_word": "herumtrödeln",
                                "target_lang_sense_clarification": "die Zeit mit Nichtigkeiten vertun"
                            }
                        ]
                    }
                }
            ]
        }
    ]
