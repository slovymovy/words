                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2f0687b-0760-3fbd-962e-74af4afa1c32",
                        "entry_id": "5b806fc3-e404-3559-8072-d03379b4b3e3",
                        "glosses": [
                            "Personne qui possède des herbages, élève des bestiaux dans des herbages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf37659-6f79-40fa-ad50-63d6bc05894b",
                                "sense_id": "d2f0687b-0760-3fbd-962e-74af4afa1c32",
                                "text": "Avant la guerre, les Loutre étaient un ménage d’herbagers, sans enfant, qui peinait pour élever quelques vaches et vendre du lait au village."
                            },
                            {
                                "example_id": "f62aab37-b7da-4436-8612-63f04f803b5f",
                                "sense_id": "d2f0687b-0760-3fbd-962e-74af4afa1c32",
                                "text": "Un de nos proches voisins était herbager, nous lui achetions notre lait. Il mettait ses vaches dans une vaste prairie attenante à sa ferme."
                            },
                            {
                                "example_id": "fbe6bb8d-a626-4f71-a7ba-3181cb7e0ccf",
                                "sense_id": "d2f0687b-0760-3fbd-962e-74af4afa1c32",
                                "text": "Il était accroupi dans les cendres de l’âtre et faisait chauffer un godet de cidre doux pendant que je finissais un marché avec un herbager de Carente (Carentan)."
                            }
                        ]
                    }
                ],
                "translations": [],
