                                        "entry_id": "a9c6262b-198f-355e-8ee1-a53f8c2df2e9",
                                        "glosses": [
                                            "Plante herbacée aromatique bisannuelle potagère de la famille des Apiacées de nom scientifique Apium graveolens dont il existe trois cultigroupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada0e1ed-80b4-4292-aed0-165b79ce72b3",
                                                "sense_id": "ae7b5f66-6129-3734-9489-b952b84a3207",
                                                "text": "À la limite des légumes et des plantes aromatiques, le céleri (Apium graveolens) a déjà été mentionné à propos de la forme tubéreuse qui descend de l’ache, plante vivace des montagnes européennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb96f4bf-1dd9-3f6d-8ff9-918a9b5bdeba",
                                        "entry_id": "a9c6262b-198f-355e-8ee1-a53f8c2df2e9",
                                        "glosses": [
                                            "Céleri-branche (Apium graveolens var. dulce) dont on mange le pétiole et l'hypocotyle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9df265b-7b26-43e1-81fc-80a5921450af",
                                                "sense_id": "bb96f4bf-1dd9-3f6d-8ff9-918a9b5bdeba",
                                                "text": "L’éminent gastronome Grimod de la Reynière fait chorus, qui déconseille le céleri aux timides, mais le recommande chaudement aux célibataires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e47938fe-ce0e-3d07-b279-6f8419ddf3e6",
                                        "entry_id": "a9c6262b-198f-355e-8ee1-a53f8c2df2e9",
                                        "glosses": [
                                            "Céleri-rave ou céleri boule ou Apium graveolens var. rapaceum dont on mange la tige tubérisée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0a70d0f-06e5-4266-8f5b-5234c89691cb",
                                                "sense_id": "e47938fe-ce0e-3d07-b279-6f8419ddf3e6",
                                                "text": "Mélangez céleri et sauce avant de servir."
                                            }
                                        ]
                                    }
                                ]
