    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f00ab556-e56c-3c0d-a827-6220ec87c37d",
                    "sense_definition": "Odczuwać niepokój, lęk lub smutek z powodu jakiejś sytuacji lub w trosce o kogoś.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflexive_worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie musisz się <w>martwić</w> o pieniądze, bo mamy spore oszczędności.",
                            "target_lang_translations": {
                                "ru": "Тебе не нужно <w>беспокоиться</w> о деньгах, потому что у нас большие сбережения.",
                                "en": "You don't need to <w>worry</w> about money, because we have considerable savings."
                            }
                        },
                        {
                            "text": "Zacząłem się <w>martwić</w> o zdrowie ojca, gdy przestał wychodzić z domu.",
                            "target_lang_translations": {
                                "ru": "Я начал <w>беспокоиться</w> о здоровье отца, когда он перестал выходить из дома.",
                                "en": "I started to <w>worry</w> about my father's health when he stopped leaving the house."
                            }
                        }
                    ],
                    "synonyms": [
                        "trapić się",
                        "gw. (Śląsk Cieszyński) frasować się, tropić",
                        "gw. (Śląsk Cieszyński) starzać",
                        "niepokoić się",
                        "gryźć się."
                    ],
                    "antonyms": [
                        "cieszyć się",
                        "uspokajać się"
                    ],
                    "common_phrases": [
                        "nie martw się",
                        "martwić się o zdrowie",
                        "martwić się na zapas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать беспокойство, страх или грусть из-за какой-либо ситуации или из-за заботы о ком-то.",
                        "en": "To feel anxiety, fear, or sadness because of a situation or out of concern for someone."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоиться",
                                "target_lang_sense_clarification": "испытывать тревогу"
                            },
                            {
                                "target_lang_word": "волноваться",
                                "target_lang_sense_clarification": "быть неспокойным"
                            },
                            {
                                "target_lang_word": "переживать",
                                "target_lang_sense_clarification": "сильно беспокоиться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "worry",
                                "target_lang_sense_clarification": "to feel anxious or concerned"
                            },
                            {
                                "target_lang_word": "be worried",
                                "target_lang_sense_clarification": "to be in a state of anxiety"
                            },
                            {
                                "target_lang_word": "fret",
                                "target_lang_sense_clarification": "to worry or be anxious continually"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9f71774-c28e-38c9-bfbb-5663473e8aba",
                    "sense_definition": "Powodować u kogoś zły nastrój, smutek lub poczucie zagrożenia.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transitive_worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twoje słabe oceny w szkole zaczynają mnie poważnie <w>martwić</w>.",
                            "target_lang_translations": {
                                "ru": "Твои плохие оценки в школе начинают меня серьёзно <w>беспокоить</w>.",
                                "en": "Your poor grades at school are starting to seriously <w>worry</w> me."
                            }
                        },
                        {
                            "text": "Sytuacja polityczna w kraju <w>martwi</w> wielu obywateli.",
                            "target_lang_translations": {
                                "ru": "Политическая ситуация в стране <w>беспокоит</w> многих граждан.",
                                "en": "The political situation in the country <w>worries</w> many citizens."
                            }
                        }
                    ],
                    "synonyms": [
                        "gw. (Śląsk Cieszyński) starzać"
                    ],
                    "antonyms": [
                        "cieszyć",
                        "uspokajać",
                        "pocieszać"
                    ],
                    "common_phrases": [
                        "to mnie martwi",
                        "martwić rodziców",
                        "martwić swoim zachowaniem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо плохое настроение, грусть или чувство опасности.",
                        "en": "To cause someone to be in a bad mood, feel sad, or feel a sense of threat."
                    },
