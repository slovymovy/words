                        ]
                    },
                    {
                        "translation_id": "bbc9612f-597d-4de9-b782-43f1f9e01776",
                        "source_entry_id": "c297144b-ce8b-3533-be1b-a53cd3cab34c",
                        "source_sense_id": "de904815-257d-324f-a326-88f7a7bb114e",
                        "source_sense_description": "een half cirkelvormige vallei gevormd door de erosie die een gletsjer veroorzaakt",
                        "target_lang_word": "Talkessel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Talkessel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f41a30c6-06ca-3102-b552-4db9079848a2",
                                        "entry_id": "86cc35c5-aaac-37a0-b149-64860a151e78",
                                        "glosses": [
                                            "eher rundes, von Bergen eingeschlossenes Tal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4d546b-c239-4cb7-b51c-582a669f36ba",
                                                "sense_id": "f41a30c6-06ca-3102-b552-4db9079848a2",
                                                "text": "„Der Mitterpinzgau ist ein Talkessel zwischen Kitzbühler Alpen, Leoganger Steinbergen und Steinernem Meer.“"
                                            },
                                            {
                                                "example_id": "6d6aedf7-678d-4a1a-a9de-7604b2708d0d",
                                                "sense_id": "f41a30c6-06ca-3102-b552-4db9079848a2",
                                                "text": "„Talweitungen entstehen durch stärkere Erosion in Talabschnitten, die von weicheren Gesteinsschichten begleitet sind; Talkessel sind weite Ausräume, die bei ungefähr konzentrischem Zusammenfließen von Flüssen zu einem meist kurzen Hauptfluss gebildet werden.“"
                                            },
                                            {
                                                "example_id": "844bc5b6-a8b3-4428-8488-6700bd3f9a3a",
                                                "sense_id": "f41a30c6-06ca-3102-b552-4db9079848a2",
                                                "text": "„So konzentrierte sich die Armee auf den Talkessel von Kabul, die große Ringstraße und die wenigen Städte, während die Mujahedin schätzungsweise 80 bis 90 Prozent des Landes kontrollierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edec5cb4-47bb-4864-8ada-5a94945ff7f2",
                        "source_entry_id": "c297144b-ce8b-3533-be1b-a53cd3cab34c",
                        "source_sense_id": "de904815-257d-324f-a326-88f7a7bb114e",
                        "source_sense_description": "een half cirkelvormige vallei gevormd door de erosie die een gletsjer veroorzaakt",
                        "target_lang_word": "cirque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a638af24-f24c-36cf-ac08-e4426104a3c6",
                                        "entry_id": "d8b27f8b-d2b1-38d0-a691-a188867fc5ab",
                                        "glosses": [
                                            "A Roman circus."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7657ce6e-790d-4059-a019-d19c1a08ef5d",
                                                "sense_id": "a638af24-f24c-36cf-ac08-e4426104a3c6",
                                                "text": "Nero exhibited theſe Spectacles in his own Gardens, impiouſly joining to them the Diverſions of the Cirque, and appearing himſelf publicly in the Habit of a Charioteer, ſitting in his Chariot[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25ddf7a-b8db-3483-a687-1fbb8bd2757f",
                                        "entry_id": "d8b27f8b-d2b1-38d0-a691-a188867fc5ab",
                                        "glosses": [
                                            "A curved depression or natural amphitheatre, especially one in a mountainside at the end of a valley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c7592e5-51b8-4ee9-836e-2c511bd7dc10",
                                                "sense_id": "a25ddf7a-b8db-3483-a687-1fbb8bd2757f",
                                                "text": "Whose savage trample thus could pad the dank / Soil to a plash? toads in a poisoned tank, / Or wild cats in a red-hot iron cage— / The fight must so have seemed in that fell cirque."
                                            },
                                            {
                                                "example_id": "56c5a0ee-b0ff-411f-adc1-491987747bc5",
                                                "sense_id": "a25ddf7a-b8db-3483-a687-1fbb8bd2757f",
                                                "text": "Of course it's going to be bad whenever the clouds let loose, but up here pussyfooting along the perimeter of toothy cirques and dead drops of anywhere from eighty to three hundred feet, it would be a disaster."
                                            },
                                            {
                                                "example_id": "00fd7021-fbeb-4dda-9959-b0a2fbbb09c3",
                                                "sense_id": "a25ddf7a-b8db-3483-a687-1fbb8bd2757f",
                                                "text": "When the soldiers were not lost among tattered skeins of fog, they could see far out into the cirque, as if it were a bay of black water."
                                            },
                                            {
                                                "example_id": "0f6b7352-4fdc-42c7-a870-46bad25f18ee",
                                                "sense_id": "a25ddf7a-b8db-3483-a687-1fbb8bd2757f",
                                                "text": "Only a few lichens and mosses colonize the rocky walls of cirques and nunataks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "931b2f61-3728-3596-8646-6f80eb1154d7",
                                        "entry_id": "d8b27f8b-d2b1-38d0-a691-a188867fc5ab",
                                        "glosses": [
                                            "Something in the shape of a circle or ring."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebbdb812-6114-49c5-b5fb-28e12e93af3e",
                                                "sense_id": "931b2f61-3728-3596-8646-6f80eb1154d7",
                                                "text": "Saturn has supplied to the Greeks and Romans the source of a beautiful personification; they have represented him as Time, […] thus with his scythe is he considered to cut down in endless succession every ripened race of man; and as the serpent is annually renewed by the cast of its skin, so is every falling race of man held to be renewed by a young and succeeding progeny; from hence arose the fiction, that Saturn devoured his own children, and hence also is the continuous cirque of imposts at Stonehenge an apt representation of this well imagined emblem."
                                            },
                                            {
                                                "example_id": "86275bbb-086b-42c6-b2ac-776de48a5cc8",
                                                "sense_id": "931b2f61-3728-3596-8646-6f80eb1154d7",
                                                "text": "[T]here our camp / Lay pitched that day beneath the sun's wide glare, / Amid the omnipresent desert wastes, / And few men stirred abroad. […] [A]nd the tents / Sagged lifeless all around their dusky cirque, / Whose every rope shone burnished in the glare, / And every tent-pin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
