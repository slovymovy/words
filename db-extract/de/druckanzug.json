                "senses": [
                    {
                        "sense_id": "2b923c57-76c1-38fd-b8c9-244f5bf03444",
                        "entry_id": "fa644968-ac12-3777-bb88-064843ca7f4e",
                        "glosses": [
                            "vollständig geschlossene Bekleidung für bestimmte Berufsgruppen, die den Mensch vor zu hohem oder zu niedrigem Luftdruck schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c44791-02e3-4ef7-b8d0-f6320c7af8fe",
                                "sense_id": "2b923c57-76c1-38fd-b8c9-244f5bf03444",
                                "text": "„Der Rover soll 6 Meter lang, 5,2 Meter breit und 3,8 Meter hoch sein. In den 13 Kubikmetern Innenvolumen sollen sich zwei Menschen ohne Druckanzug aufhalten können, im Notfall auch vier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88642f82-a347-4bb8-966d-568063a15851",
                        "source_entry_id": "fa644968-ac12-3777-bb88-064843ca7f4e",
                        "source_sense_id": "2b923c57-76c1-38fd-b8c9-244f5bf03444",
                        "source_sense_description": "vollständig geschlossene Bekleidung, die den Mensch vor zu hohem oder zu niedrigem Luftdruck schützt",
                        "target_lang_word": "pressure suit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressure suit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08973160-203a-34b8-84fd-4f71e504a97c",
                                        "entry_id": "d7e9ff6a-894f-36c6-9737-3a7c95a1c57c",
                                        "glosses": [
                                            "A sealed, full-body garment, usually with an attachable helmet, which maintains air pressure or mechanical pressure around the body of an astronaut or aviator to compensate for the low density of the air at high altitudes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98da86c-47ae-4960-ac6d-c6c4a1b34967",
                                                "sense_id": "08973160-203a-34b8-84fd-4f71e504a97c",
                                                "text": "Have you fur pressure-suits?"
                                            },
                                            {
                                                "example_id": "f82449f0-17a4-4042-8ea4-c584e0cfd60d",
                                                "sense_id": "08973160-203a-34b8-84fd-4f71e504a97c",
                                                "text": "The chances for survival would be greatly increased if one member of the crew in a punctured ship was wearing a pressure suit."
                                            },
                                            {
                                                "example_id": "9c1d65f9-7477-4219-80c8-14c0b517b360",
                                                "sense_id": "08973160-203a-34b8-84fd-4f71e504a97c",
                                                "text": "In 1947 he had taken a de Havilland Vampire jet fighter to a then world record height of 59,460 feet, without a pressure suit,"
                                            },
                                            {
                                                "example_id": "c9b2009e-9766-42d4-91d4-c4ca04cb8c35",
                                                "sense_id": "08973160-203a-34b8-84fd-4f71e504a97c",
                                                "text": "Alan Shepard, the first American in space, famously relieved himself inside his silver pressure suit while waiting out the countdown in his tiny Mercury capsule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe326e29-f7f1-4017-a09a-532071463047",
                        "source_entry_id": "fa644968-ac12-3777-bb88-064843ca7f4e",
                        "source_sense_id": "2b923c57-76c1-38fd-b8c9-244f5bf03444",
                        "source_sense_description": "vollständig geschlossene Bekleidung, die den Mensch vor zu hohem oder zu niedrigem Luftdruck schützt",
