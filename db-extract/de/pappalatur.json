                ],
                "senses": [
                    {
                        "sense_id": "2a76dffa-8620-3036-bd0c-3912113129b9",
                        "entry_id": "20305d4e-744d-353d-8bb1-b6a6db516899",
                        "glosses": [
                            "Körperöffnung in der unteren Hälfte des Gesichts, die zur Nahrungsaufnahme und (vor allem zur) Lauterzeugung fähig ist"
                        ],
                        "tags": [
                            "Austrian German",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "423f13cd-f058-40d6-a23d-57f1f40915e3",
                                "sense_id": "2a76dffa-8620-3036-bd0c-3912113129b9",
                                "text": "„Sie sei froh, dass sie mit dieser Pappalatur gesegnet sei.“"
                            },
                            {
                                "example_id": "ae977922-6f1d-4da6-b81a-6822622a5b03",
                                "sense_id": "2a76dffa-8620-3036-bd0c-3912113129b9",
                                "text": "„Die Pappalatur läuft schon am frühen Nachmittag wie geschmiert, auch wenn weit und breit kein Kernöl zu sehen ist.“"
                            },
                            {
                                "example_id": "379e76af-6b7b-4881-b9c9-21f12879ffca",
                                "sense_id": "2a76dffa-8620-3036-bd0c-3912113129b9",
                                "text": "„Die Wienerinnen in ihrem Kopf würden übrigens durchaus aus Klischeebildern gespeist, sie sehe jedenfalls ein ‚goschertes Mädel‘ vor sich, ‚mit großer Pappalatur, aber intelligent genug, ihre Verehrer in die Schranken zu weisen und auf eine frivole Art das Leben zu meistern.‘“"
                            },
                            {
                                "example_id": "a79428f3-4ef6-4e7d-898a-4debbd05b358",
                                "sense_id": "2a76dffa-8620-3036-bd0c-3912113129b9",
                                "text": "„Als ich mit der 84-jährigen Sextherapeutin Ruth Westheimer einmal einen Nachmittag in Wien verbrachte, hing mir die Zunge wie ein roter Wollschal aus der Pappalatur.“"
                            },
                            {
                                "example_id": "8aef81b2-1c09-42ab-b7de-7902d793b935",
                                "sense_id": "2a76dffa-8620-3036-bd0c-3912113129b9",
                                "text": "„Permanent die Pappalatur offen, man muss froh sein, wenn er sich zwischendurch mal eine anzündet – die einzige Chance, kurz zu Wort zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
