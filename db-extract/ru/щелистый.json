                                    },
                                    {
                                        "sense_id": "85f88318-c0dc-3001-b8b5-d35404e59f47",
                                        "entry_id": "105348e8-f0bb-3f2a-b835-a4cd6417b2bb",
                                        "glosses": [
                                            "Possessing attributes of, or similar to, an East Asian person or an East Asian style or culture."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chinky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb4b5a5-b4f9-3fc4-a512-a7a27c86b596",
                                        "entry_id": "cb960a33-95af-313b-b46d-6ca1818a0815",
                                        "glosses": [
                                            "A Chinese takeaway restaurant."
                                        ],
                                        "tags": [
                                            "UK",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a23b87-7ed0-4754-8c71-2a560b45db29",
                                                "sense_id": "bdb4b5a5-b4f9-3fc4-a512-a7a27c86b596",
                                                "text": "What this means for young Chinese people growing up and serving behind the counter is captured in Pui Fan Lee’s autobiographical play Short, Fat, Ugly and Chinese, broadcast on Radio 5 in 1992. She remembers her childhood: ‘But most of all I hated the shop. The takeaway. Or, as the locals called it, “The Chinky”[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93f1b632-2497-3f1e-b99a-6ff4710c1f4c",
                                        "entry_id": "cb960a33-95af-313b-b46d-6ca1818a0815",
                                        "glosses": [
                                            "A meal of Chinese food."
                                        ],
                                        "tags": [
                                            "UK",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05ecef00-afc7-410f-9e43-8758ac8c8483",
                                                "sense_id": "93f1b632-2497-3f1e-b99a-6ff4710c1f4c",
                                                "text": "I've had a Chinky, a Chic Murray and, afore ye came tae collect me, I had some fuckin' fancy Italian pasta dish. It was pure dead brilliant, by the way!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eb9efe1-866b-38cd-b804-b997b4380bdd",
                                        "entry_id": "cb960a33-95af-313b-b46d-6ca1818a0815",
                                        "glosses": [
                                            "A Chinese person."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d92b4a0-9016-3568-9ecb-cfdff5c17dd4",
                                        "entry_id": "cb960a33-95af-313b-b46d-6ca1818a0815",
                                        "glosses": [
                                            "An East Asian person."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ceb497f-3be9-4ce6-a2a6-7d0251aeebdd",
                                                "sense_id": "9d92b4a0-9016-3568-9ecb-cfdff5c17dd4",
                                                "text": "Oh my chinky she's so kinky got me hot like Nagasaki"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d39a7c8-69e5-31a2-a438-b0e5b22b0a3c",
                                        "entry_id": "cb960a33-95af-313b-b46d-6ca1818a0815",
                                        "glosses": [
                                            "A person from Northeast India."
                                        ],
                                        "tags": [
                                            "India",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24cedde-4863-4e3e-b5f2-8e3f11bd0c41",
                                                "sense_id": "5d39a7c8-69e5-31a2-a438-b0e5b22b0a3c",
                                                "text": "Since I come from the North-eastern part of India myself and belong to a minority race, I too have suffered from racism, at least in its milder forms. I’ve been called \"chinky\", \"momo\", \"chowmein\", and more."
                                            },
                                            {
                                                "example_id": "2a60499c-318f-4eb0-98f3-365bfe0fe395",
                                                "sense_id": "5d39a7c8-69e5-31a2-a438-b0e5b22b0a3c",
                                                "text": "However, what matters to them is the intention of such a question, especially when they are invectively referred to as chinky and other remarks that are considered to be derogatory"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
