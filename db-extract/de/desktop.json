                                                "sense_id": "cc437e0c-1807-3acd-ae28-23fc3f9bd378",
                                                "text": "Laptops are often more expensive than desktops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6de3877-c688-3bf8-b28a-146b1246dd96",
