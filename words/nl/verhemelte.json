                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "palate",
                                "target_lang_sense_clarification": "anatomical term for the roof of the mouth"
                            },
                            {
                                "target_lang_word": "roof of the mouth",
                                "target_lang_sense_clarification": "common descriptive term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b29949-9764-3656-b716-1dabd516a6b6",
                    "sense_definition": "een decoratieve overdekking boven een bed, troon of preekstoel",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meubilair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Boven de koninklijke troon hing een prachtig zijden <w>verhemelte</w>.",
                            "target_lang_translations": {
                                "en": "A beautiful silk <w>canopy</w> hung above the royal throne."
                            }
                        },
                        {
                            "text": "Het antieke <w>verhemelte</w> <w>bed</w> stond al generaties lang in de slaapkamer van het kasteel.",
                            "target_lang_translations": {
                                "en": "The antique <w>canopy</w> bed had been in the castle bedroom for generations."
                            }
                        }
                    ],
                    "synonyms": [
                        "baldakijn",
                        "hemel"
                    ],
                    "common_phrases": [
