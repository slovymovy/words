                                    {
                                        "sense_id": "4718f437-8514-3c55-a8ac-3b86fcdf21e0",
                                        "entry_id": "c2b444f6-cb7a-34dd-83da-f735438453e9",
                                        "glosses": [
                                            "Cadena montañosa que se encuentra entre China y la India. En ella se encuentra el Everest, el pico más alto del mundo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b339ba93-2203-4b48-903f-69e1445feb27",
                        "source_entry_id": "d514689e-a750-33f9-9b7d-574c6d777304",
                        "source_sense_id": "716e34c8-281e-37d7-a347-547d7b07d220",
                        "target_lang_word": "Himalaja",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Himalaja",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe829ea7-2019-3dae-b201-3157b463cff5",
                                        "entry_id": "ddc4abea-efb4-3f64-82b6-4a09f2bc5bc9",
                                        "glosses": [
                                            "Hochgebirge in Asien, das sich zwischen dem Indischen Subkontinent und dem Tibetischen Hochland erstreckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b1b110b-7ab2-4595-ae6c-62751f72f51b",
                                                "sense_id": "fe829ea7-2019-3dae-b201-3157b463cff5",
                                                "text": "„Ins Basislager am Fuß des Bergs begleiteten ihn sein Bruder Vincent und sein Vater Alfred, der als junger Mann Touren im Himalaja unternommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9351c4e-e1c3-48b1-ac87-ce2aa2f05679",
                        "source_entry_id": "d514689e-a750-33f9-9b7d-574c6d777304",
                        "source_sense_id": "716e34c8-281e-37d7-a347-547d7b07d220",
                        "target_lang_word": "Гималаи",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Гималаи",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ad46f54f-f58e-3a13-9e55-5f2d898c4a3a",
                                        "entry_id": "bd039f8b-b3d0-37b7-b287-4b75d91dace4",
                                        "glosses": [
                                            "геогр. высочайшая горная система земного шара, расположенная на территории Индии, Китая (Тибетский автономный район), Непала, Пакистана и Бутана, между Тибетским нагорьем на севере и Индо-Гангской равниной на юге; включает в себя высшую точку Земли — гору Джомолунгма (Эверест)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd9abc6-679b-4393-a204-d03dd708ed4c",
                                                "sense_id": "ad46f54f-f58e-3a13-9e55-5f2d898c4a3a",
                                                "text": "Я уже с неделю живу на гурдварской ярмарке, в сборном месте индийских племен, на берегах Ганга, у подошвы Гималаев."
                                            },
                                            {
                                                "example_id": "b08bee51-91d6-43d4-bac3-c4fb5399bc8d",
                                                "sense_id": "ad46f54f-f58e-3a13-9e55-5f2d898c4a3a",
                                                "text": "Вся область Гималаев представляет исключительное поле для научных исследований."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
