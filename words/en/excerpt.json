{
    "word_family": [
        "excerption",
        "excerptible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7d89c7d-ca49-375b-9716-8d74f1ceb6a1",
                    "sense_definition": "A short passage or extract taken from a larger work such as a book, document, or film.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher read a short <w>excerpt</w> from the novel to the class.",
                            "target_lang_translations": {
                                "ru": "Учитель прочитал классу короткий <w>отрывок</w> из романа."
                            }
                        },
                        {
                            "text": "You can find a brief <w>excerpt</w> of the interview on our website.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти краткую <w>выдержку</w> из интервью на нашем сайте."
                            }
                        }
                    ],
                    "synonyms": [
                        "extract",
                        "passage",
                        "snippet",
                        "clip"
                    ],
                    "common_phrases": [
                        "brief excerpt",
                        "short excerpt",
                        "excerpt from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий отрывок или фрагмент, взятый из более крупного произведения, такого как книга, документ или фильм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрывок",
                                "target_lang_sense_clarification": "часть литературного или музыкального произведения"
                            },
                            {
                                "target_lang_word": "выдержка",
                                "target_lang_sense_clarification": "цитата или выписка из текста"
                            },
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "небольшая часть чего-либо целого"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "631e1feb-ff23-32dc-90a8-e416be7e9fff",
                    "sense_definition": "To select or copy a passage or sample material from a larger work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to <w>excerpt</w> several paragraphs for the magazine article.",
                            "target_lang_translations": {
                                "ru": "Редактор решил <w>выбрать</w> несколько абзацев для статьи в журнале."
                            }
                        },
                        {
                            "text": "The following particulars were <w>excerpted</w> from the original report.",
                            "target_lang_translations": {
                                "ru": "Следующие подробности были <w>взяты</w> из оригинального отчета."
                            }
                        }
                    ],
                    "synonyms": [
                        "extract",
                        "select",
                        "quote"
                    ],
                    "common_phrases": [
                        "excerpted from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбирать или копировать отрывок или образец материала из более крупного произведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать выдержки",
                                "target_lang_sense_clarification": "выписывать фрагменты из текста"
                            },
                            {
                                "target_lang_word": "цитировать",
                                "target_lang_sense_clarification": "приводить отрывок в качестве цитаты"
                            },
                            {
                                "target_lang_word": "выбирать отрывки",
                                "target_lang_sense_clarification": "отбирать части для публикации или анализа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}