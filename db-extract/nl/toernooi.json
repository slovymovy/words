                                        "glosses": [
                                            "A series of games; either the same game played many times, or a succession of games related by a single theme; played competitively to determine a single winning team or individual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ca10c8-1884-491e-8607-763452915834",
                                                "sense_id": "c3dc22a0-7206-3cc2-bfe6-f0d0882d7f6b",
                                                "text": "England secured their place at Euro 2012 with a scrambled draw in Montenegro - but Wayne Rooney was sent off and will miss the start of the tournament."
