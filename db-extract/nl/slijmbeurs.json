                    },
                    {
                        "translation_id": "3a2f591c-aff1-49c0-93b6-f19fbda9a33c",
                        "source_entry_id": "486bda20-9c75-3125-86f7-ac6d870e8d9d",
                        "source_sense_id": "099b0508-d2ec-3cb5-ac32-93315ddafd46",
                        "source_sense_description": "een met vocht gevuld 'kussentje' tussen een pees en de onderliggende botstructuur bij een gewricht, dicht bij de aanhechting van de pees op het bot",
                        "target_lang_word": "bursa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bursa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "910703b6-edf6-31b5-b110-722d29404bed",
                                        "entry_id": "7f7f28c7-69b1-3acc-9cc0-82a654ee7d64",
                                        "glosses": [
                                            "Any of the many small fluid-filled sacs located at the point where a muscle or tendon slides across bone. These sacs serve to reduce friction between the two moving surfaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff08a4fa-8749-49d9-a122-cb9199b9b8c2",
                                                "sense_id": "910703b6-edf6-31b5-b110-722d29404bed",
                                                "text": "A bursa over the anterior aspect of the upper end of the tibia, between the patellar tendon and the tubercle of the tibia, is sometimes enlarged, and may be mistaken for synovitis of the joint."
                                            },
                                            {
                                                "example_id": "2d2cb73c-9555-4119-b3ee-c7ca6c7eb73f",
                                                "sense_id": "910703b6-edf6-31b5-b110-722d29404bed",
                                                "text": "Bursitis is inflammation of a bursa, which results in pain, tenderness, and stiffness and in some cases, swelling and redness."
                                            },
                                            {
                                                "example_id": "3691fd0b-49e6-46cb-b244-bc52bfea915c",
                                                "sense_id": "910703b6-edf6-31b5-b110-722d29404bed",
                                                "text": "A bursa may be present deep to coracobrachialis tendon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "566566d4-21bc-359d-b145-8e2ec89739e0",
                                        "entry_id": "7f7f28c7-69b1-3acc-9cc0-82a654ee7d64",
                                        "glosses": [
                                            "A diverticulum on the cloaca of young birds, which serves as a lymphatic organ and as part of the immune system, but which atrophies as the bird ages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d7be2a-ee98-48af-a9d5-e5df518a76f3",
                                                "sense_id": "566566d4-21bc-359d-b145-8e2ec89739e0",
                                                "text": "The general relations of the bursa to the cloaca are shown in the two accompanying figures."
                                            },
                                            {
                                                "example_id": "41dc892a-234d-41ad-b490-85b56880e2a2",
                                                "sense_id": "566566d4-21bc-359d-b145-8e2ec89739e0",
                                                "text": "The dark, crescentic area is the opening of the bursa, from which the covering membrane is temporarily withdrawn."
                                            },
                                            {
                                                "example_id": "2b674eda-0cba-4677-8fc2-90e6435990bc",
                                                "sense_id": "566566d4-21bc-359d-b145-8e2ec89739e0",
                                                "text": "The bursa is located near the terminal portion of the cloaca and, like the thymus, is a lymphoepithelial organ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653941bb-da52-3c80-9f32-bcbb4fc896a8",
                                        "entry_id": "7f7f28c7-69b1-3acc-9cc0-82a654ee7d64",
                                        "glosses": [
                                            "Any of various pouch-like organs for storing semen prior to copulation in the male or for receiving semen in the female."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d54d7f9-f996-46f2-8403-e5d8192a4e66",
                                                "sense_id": "653941bb-da52-3c80-9f32-bcbb4fc896a8",
                                                "text": "That portion of the dilated vas deferens which lies outside the cavity of the genital bursa is called the external seminal vesicle ."
                                            },
                                            {
                                                "example_id": "0ec5edf1-8a53-4367-a1ae-46192de1c664",
                                                "sense_id": "653941bb-da52-3c80-9f32-bcbb4fc896a8",
                                                "text": "In other groups, all members of each clade lack a bursa copulatrix. Conversely, some taxa such as many Dendronotina may lack a receptaculum but possess a bursa."
                                            },
                                            {
                                                "example_id": "a3fe4db5-1d16-4ac7-ac3b-1e399b33f63a",
                                                "sense_id": "653941bb-da52-3c80-9f32-bcbb4fc896a8",
                                                "text": "The vagina extends anteriorly over the dorsal side of seminal vesicle to the sperm-filled seminal bursa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000d2780-9ad7-3ae8-997c-af3cf0ba5b06",
                                        "entry_id": "7f7f28c7-69b1-3acc-9cc0-82a654ee7d64",
                                        "glosses": [
                                            "A parament about twelve inches square in which the folded corporal is kept in for reasons of reverence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8de2df-436a-40d1-b1dc-dcd471a472bc",
                                                "sense_id": "000d2780-9ad7-3ae8-997c-af3cf0ba5b06",
                                                "text": "In solemn mass the deacon brings the book of the Missal to the side of the epistle, then goes backward behind the celebrant; the sub-deacon, indeed, goes to the gospel side, where he cleanses the chalice, fits it with the purifacatory, covers it with the paten and pall, folds the corporal, replaces it in the bursa, and puts it in the chalice covered with a veil, which he places on the altar or over the credentia, as before."
                                            },
                                            {
                                                "example_id": "55d3aa27-835c-4821-b76e-6524ef07d94e",
                                                "sense_id": "000d2780-9ad7-3ae8-997c-af3cf0ba5b06",
                                                "text": "It is forbidden to leave the corporal, when not in use, exposed upon the altar, or to carry it in one's hands without a covering. A bursa is always to be used for that purpose ."
                                            },
                                            {
                                                "example_id": "7a4de704-1eba-4cce-a07f-edf4ea1f01e5",
                                                "sense_id": "000d2780-9ad7-3ae8-997c-af3cf0ba5b06",
                                                "text": "Just like relics, the Eucharist was taken, enclosed in a bursa or pendula as a means of protection not only on journeys overland but - and especially - when travellers ventured onto the whimsical sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
