                        "glosses": [
                            "Of or relating to the Cabeiri, or to their mystical worship."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "195d47f8-6e1e-4e76-bee1-e2e0b3b1d68b",
                                "sense_id": "4602a464-5498-3c67-8df8-e5c06a3f5c9c",
                                "text": "Processional marches not a few our world has seen; Roman triumphs and ovations, Cabiric cymbal-beatings, Royal progresses, Irish funerals: but this of the French Monarchy marching to its bed remained to be seen."
                            },
                            {
                                "example_id": "9618c8bf-2192-4963-9407-ce81eebfa451",
                                "sense_id": "4602a464-5498-3c67-8df8-e5c06a3f5c9c",
                                "text": "It is, indeed, part of the ritual of the candidate for adeptship into the British mysteries, resembling that for the neophyte into the Osirian, Cabiric or Orphean mysteries."
                            }
                        ]
                    }
