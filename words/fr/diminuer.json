            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77b48434-b306-3ed1-ba2d-95eb0b5ea7ea",
                    "sense_definition": "Devenir plus petit ou moins important en quantité, en intensité ou en volume.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "baisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La température commence à <w>diminuer</w> dès que le soleil se couche.",
                            "target_lang_translations": {
                                "en": "The temperature starts to <w>drop</w> as soon as the sun goes down.",
                                "ru": "Температура начинает <w>понижаться</w>, как только садится солнце.",
                                "de": "Die Temperatur beginnt zu <w>sinken</w>, sobald die Sonne untergeht.",
                                "es": "La temperatura empieza a <w>bajar</w> en cuanto se pone el sol.",
                                "zh": "太阳一落山，气温就开始<w>下降</w>。"
                            }
                        },
                        {
                            "text": "Avec ce nouveau traitement médical, ses douleurs <w>diminuent</w> de jour en jour.",
                            "target_lang_translations": {
                                "en": "With this new medical treatment, the pain is <w>lessening</w> day by day.",
                                "ru": "С этим новым лечением боли день ото дня <w>ослабевают</w>.",
                                "de": "Mit dieser neuen medizinischen Behandlung <w>lassen</w> seine Schmerzen von Tag zu Tag <w>nach</w>.",
                                "es": "Con este nuevo tratamiento médico, sus dolores <w>disminuyen</w> día a día.",
                                "zh": "采用这种新的治疗方法后，他的疼痛一天比一天<w>减弱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "baisser",
                        "décroître"
                    ],
                    "antonyms": [
                        "augmenter"
                    ],
                    "common_phrases": [
                        "diminuer de moitié",
                        "diminuer progressivement"
                    ],
                    "target_lang_definitions": {
