    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5df5101b-d8c2-39b2-8ab3-856c36714a3f",
                    "sense_definition": "Recommander ou indiquer à quelqu'un ce qu'il est bon de faire ou d'éviter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "guidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a <w>conseillé</w> de boire beaucoup d'eau chaque jour."
                        },
                        {
                            "text": "Je vous <w>conseille</w> vivement de visiter ce musée pendant votre séjour."
                        }
                    ],
                    "antonyms": [
                        "déconseiller"
                    ],
                    "common_phrases": [
                        "conseiller vivement",
                        "conseiller fortement"
                    ]
                },
                {
