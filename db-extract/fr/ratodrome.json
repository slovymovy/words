                "senses": [
                    {
                        "sense_id": "7049e4d9-940b-37fa-981e-3ba1cc0c81c0",
                        "entry_id": "42e403c5-31d9-3521-b4dc-c346df7b5f8d",
                        "glosses": [
                            "Lieu aménagé pour organiser des combats « chien contre rats »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7d5e3a-2546-4966-ac19-bd030673c1da",
                                "sense_id": "7049e4d9-940b-37fa-981e-3ba1cc0c81c0",
                                "text": "Donio, le dresseur de chiens, Sans-dos, le tenancier du ratodrome de Villejuif, ou P’tit Vélo, le roi du pédalo de Joinville — autant de sorties, autant de journées de bonheur, autant d’heures d’apprentissage."
                            },
                            {
                                "example_id": "524661f0-5ed0-4baf-9a15-508d7b54b57b",
                                "sense_id": "7049e4d9-940b-37fa-981e-3ba1cc0c81c0",
                                "text": "C’est porte Maillot (16ᵉ) que Gustave Krouet, chasseur de rats, installa le premier « ratodrome » qui fut dans les années 1910 célèbre dans tout Paris."
                            },
                            {
                                "example_id": "778f48dd-d382-4e18-b491-78da0be7536a",
                                "sense_id": "7049e4d9-940b-37fa-981e-3ba1cc0c81c0",
                                "text": "Les baraques et les jardins zoniers se multipliaient, et dans les terrains vagues des énergumènes découvraient les sports. À l'angle de l'avenue de Chaillot, un ratodrome satisfaisait les goûts d'une clientèle de voyous, d'amateurs des chiens et de gens riches."
                            },
                            {
                                "example_id": "bfc9751e-fd0b-425e-b77d-4ad7384de956",
                                "sense_id": "7049e4d9-940b-37fa-981e-3ba1cc0c81c0",
                                "text": "C’était là le ratodrome où, peu auparavant, Zizi avait annoncé à la petite bonne Adèle qu’il allait avoir sans doute l’occasion de rencontrer son amant Bec-de-Gaz."
                            }
                        ]
                    }
