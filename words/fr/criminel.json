                        "porter au criminel"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                    "sense_definition": "Qui constitue un crime ou qui enfreint gravement les lois ou la morale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nature_crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs ont conclu que cet incendie était le résultat d'un acte <w>criminel</w>."
                        },
                        {
                            "text": "Cette organisation <w>criminelle</w> opérait secrètement dans plusieurs pays européens."
                        }
                    ],
                    "antonyms": [
                        "innocent"
                    ],
                    "common_phrases": [
                        "acte criminel",
                        "organisation criminelle",
                        "comportement criminel"
                    ]
                },
                {
                    "sense_id": "0cb5c8f7-0a06-32b0-b22c-646bd290900a",
                    "sense_definition": "Qui a commis un crime ou qui en est légalement coupable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "auteur_crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le procès de cette mère <w>criminelle</w>, accusée d'avoir empoisonné son mari, s'ouvre demain."
                        },
                        {
                            "text": "Tous les suspects arrêtés par la police ne sont pas nécessairement <w>criminels</w>."
                        }
                    ],
                    "antonyms": [
                        "innocent"
                    ]
                },
                {
                    "sense_id": "7e1ce058-1f0a-357a-81ba-c40fe49cf109",
                    "sense_definition": "Relatif aux infractions graves, à leur jugement et aux procédures de la justice pénale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice_penale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs de la brigade <w>criminelle</w> ont été immédiatement envoyés sur les lieux."
                        },
                        {
                            "text": "Ce professeur réputé enseigne le droit <w>criminel</w> à l'université depuis vingt ans."
                        }
                    ],
                    "common_phrases": [
                        "brigade criminelle",
                        "droit criminel",
                        "casier criminel"
                    ]
                },
                {
                    "sense_id": "45d13191-ecd1-3602-9ead-de71e0f1a422",
                    "sense_definition": "Qui manifeste des intentions perverses ou qui appartient à un criminel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nature_crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une main <w>criminelle</w> a volontairement saboté les installations électriques du bâtiment."
                        },
                        {
                            "text": "Il fixa son complice avec un regard <w>criminel</w> rempli d'une sombre résolution."
