                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "29907c99-9d93-42ef-85cf-bb9630b3b82d",
                                "sense_id": "67530118-d935-36d4-9af2-5b9bf81c6c58",
                                "text": "От неё оставалось лишь легчайшее фиалковое веяние, листопадное эхо той нимфетки.",
                                "translation": "Tout ce qui restait d'elle était le plus léger parfum de violette, l'écho éphémère de cette nymphette."
                            }
                        ]
