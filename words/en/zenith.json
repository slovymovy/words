{
    "word_family": [
        "zenithal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88a30709-300c-372b-a894-b2855bdc5eb0",
                    "sense_definition": "The highest point or state of success or power.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "peak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the gold medal was the <w>zenith</w> of her professional career.",
                            "target_lang_translations": {
                                "tr": "Altın madalya kazanmak, onun profesyonel kariyerinin <w>zirvesiydi</w>."
                            }
                        },
                        {
                            "text": "The company reached the <w>zenith</w> of its influence during the late nineties.",
                            "target_lang_translations": {
                                "tr": "Şirket, etkisinin <w>doruk noktasına</w> doksanların sonlarında ulaştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "acme",
                        "culmination",
                        "pinnacle",
                        "apex"
                    ],
                    "antonyms": [
                        "nadir"
                    ],
                    "common_phrases": [
                        "zenith of career",
                        "reached the zenith"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başarı veya güçte ulaşılan en yüksek nokta, en üst aşama."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zirve",
                                "target_lang_sense_clarification": "başarı veya güçte ulaşılan en üst aşama"
                            },
                            {
                                "target_lang_word": "doruk",
                                "target_lang_sense_clarification": "başarı veya güçte en üst derece"
                            },
                            {
                                "target_lang_word": "doruk noktası",
                                "target_lang_sense_clarification": "en yüksek aşama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61b90208-2be9-3264-9d95-5459f1ec33fa",
                    "sense_definition": "The highest point in the sky reached by a celestial body like the sun.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "peak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun was at its <w>zenith</w> when we finally reached the desert oasis.",
                            "target_lang_translations": {
                                "tr": "Çöl vahasına nihayet vardığımızda güneş tam <w>tepedeydi</w>."
                            }
                        },
                        {
                            "text": "As the sun climbed to the <w>zenith</w>, the shadows on the ground disappeared.",
                            "target_lang_translations": {
                                "tr": "Güneş <w>tepe noktasına</w> tırmandıkça yerdeki gölgeler kayboldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "apogee"
                    ],
                    "antonyms": [
                        "nadir"
                    ],
                    "common_phrases": [
                        "sun at zenith"
                    ],
                    "target_lang_definitions": {
                        "tr": "Güneş gibi bir gök cisminin gökyüzünde ulaştığı en yüksek tepe noktası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tepe noktası",
                                "target_lang_sense_clarification": "gök cisminin gökyüzünde çıktığı en yüksek konum"
                            },
                            {
                                "target_lang_word": "doruk noktası",
                                "target_lang_sense_clarification": "gök cisminin en yüksek konumu"
                            },
                            {
                                "target_lang_word": "zenit",
                                "target_lang_sense_clarification": "gök cisminin en tepe konumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9f2d7e4-f6ed-34fc-9a2b-0483a0f982b9",
                    "sense_definition": "The point in the sky directly above an observer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "peak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The star was positioned almost exactly at the <w>zenith</w> tonight.",
                            "target_lang_translations": {
                                "tr": "Yıldız bu gece neredeyse tam olarak <w>başucu noktasında</w> konumlanmıştı."
                            }
                        },
                        {
                            "text": "Astronomers measured the angle from the horizon to the <w>zenith</w>.",
                            "target_lang_translations": {
                                "tr": "Gökbilimciler ufuktan <w>başucu noktasına</w> kadar olan açıyı ölçtüler."
                            }
                        }
                    ],
                    "antonyms": [
                        "nadir"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gökyüzünde, bir gözlemcinin tam tepesinde bulunan doğrultudaki nokta."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "başucu noktası",
                                "target_lang_sense_clarification": "gözlemcinin tam düşey üstündeki gök noktası"
                            },
                            {
                                "target_lang_word": "zenit",
                                "target_lang_sense_clarification": "astronomide başucu noktası"
                            },
                            {
                                "target_lang_word": "başucu",
                                "target_lang_sense_clarification": "tam tepe hizası"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}