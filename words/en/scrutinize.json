                            },
                            {
                                "target_lang_word": "внимательно осматривать",
                                "target_lang_sense_clarification": "искать детали или изъяны"
                            },
                            {
                                "target_lang_word": "подвергать тщательному анализу",
                                "target_lang_sense_clarification": "глубоко исследовать"
                            }
                        ]
                    }
                },
                {
