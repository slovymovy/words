                "senses": [
                    {
                        "sense_id": "608f7d18-f5b2-3503-823c-78482f3efe22",
                        "entry_id": "961376d6-dcb9-398b-8132-37f52602364f",
                        "glosses": [
                            "истор., воен. кожаная сумочка (небольшая сумка) на перевязи, в снаряжении гусар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a499932a-b5e9-461d-a493-ac95178ccba5",
                                "sense_id": "608f7d18-f5b2-3503-823c-78482f3efe22",
                                "text": "Нет курильниц, может статься, // Зато трубка с табаком; // Нет картин, да заменятся // Ташкой с царским вензелём!"
                            }
                        ]
                    },
                    {
                        "sense_id": "dc2a7647-d600-30f9-aa93-09719a899197",
                        "entry_id": "961376d6-dcb9-398b-8132-37f52602364f",
                        "glosses": [
                            "устар. подвесная охотничья сума"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "917b20bc-9fc9-3446-aebc-2063b0d45497",
                        "entry_id": "961376d6-dcb9-398b-8132-37f52602364f",
                        "glosses": [
                            "устар. ноша, беремя, охапка"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb434384-95ca-3a5c-8d1d-0021543230be",
                        "entry_id": "961376d6-dcb9-398b-8132-37f52602364f",
