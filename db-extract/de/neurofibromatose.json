                    {
                        "sense_id": "967b56e4-4a40-3e8f-afbd-3048cd86488d",
                        "entry_id": "d582afb8-a8be-330a-ae91-3d4b1ad46c81",
                        "glosses": [
                            "Gruppe erblich bedingter Krankheiten, die meist gutartige Tumoren (Neurofibrome) am Nervensystem verursachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9af94a73-a221-496a-82bf-d2fba6709ae2",
                                "sense_id": "967b56e4-4a40-3e8f-afbd-3048cd86488d",
                                "text": "Neurofibromatose kann schon in den ersten Lebensjahren auftreten."
                            },
                            {
                                "example_id": "6f3bd9b5-e552-4c41-975b-a7028a3344fe",
                                "sense_id": "967b56e4-4a40-3e8f-afbd-3048cd86488d",
                                "text": "Bei der Neurofibromatose entstehen aus diesen Zellen Gewebeknoten an den Nervenenden unter der Haut oder es kommt zu gutartigen Gewebsneubildungen an Nerven."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
