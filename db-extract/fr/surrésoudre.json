                        "glosses": [
                            "Résoudre plus qu’il n’est nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da74c0dd-c1aa-4da4-84cc-b69c177e7a83",
                                "sense_id": "799cf361-e922-35aa-8e9e-48e9a206b200",
                                "text": "Il suffirait que toutes les PME emploient un chômeur pour que le problème de l'emploi soit surrésolu et qu'on ait même un problème pour trouver ce qu'il faut sur le marché du travail."
                            },
                            {
                                "example_id": "6e36614a-f798-4f11-91b2-416aafe4245d",
                                "sense_id": "799cf361-e922-35aa-8e9e-48e9a206b200",
                                "text": "L'histoire de la bourse est tout de même très bizarre : pourquoi surrésoudre ce qui est dramatiquement résolu ?"
