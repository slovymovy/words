                    {
                        "translation_id": "d2b680ec-a784-4676-b8bc-8723383d7324",
                        "source_entry_id": "f36b8fc2-af28-3d8e-abe4-f0629edfa3bf",
                        "source_sense_id": "a5b5aa50-e59d-3e49-a5b8-fecfdb6420f1",
