                        ],
                        "examples": [
                            {
                                "example_id": "06d8c210-ce23-4bdc-8d42-dd1851c1f652",
                                "sense_id": "8ec1871d-da5b-363c-9538-64ec1b4306fa",
                                "text": "\"Eat Leekes in Lide, and Ramsins in May, / And all the yeare after Physitians may play.\""
                            },
                            {
                                "example_id": "6b00e674-0314-42a8-9598-0bd8c0ddf7bf",
                                "sense_id": "8ec1871d-da5b-363c-9538-64ec1b4306fa",
                                "text": "I have heard this archaism only among tinners, where it exists in such sayings as this: 'Ducks wānt lay until they've a drink'd lide water.'"
                            },
                            {
                                "example_id": "6659d08a-85a4-4951-9f36-31168b858fc0",
                                "sense_id": "8ec1871d-da5b-363c-9538-64ec1b4306fa",
                                "text": "Bullokar's spelling is retained: bardes, glinne (\"glen\"), leede (\"lide\"), narre, palliard, palliardise, sprent, viands, whilome"
                            },
                            {
                                "example_id": "2c0cc48e-72dc-453e-a388-9d240ccc307f",
                                "sense_id": "8ec1871d-da5b-363c-9538-64ec1b4306fa",
                                "text": "And so it was that in the month of Lide (the villagers' name for Martius) a great wolf hunt was to be held in Suuremõisa once again, as soon as the ice across the strait of Soela had begun to thin and could no longer bear so much as a wolf's paw, […]"
                            }
                        ]
                    }
