                                            {
                                                "example_id": "76f3776a-8df5-4f24-9558-eb420e9ca9e8",
                                                "sense_id": "e8cec86e-b7d4-3b03-a7bd-b49f3ff8aad6",
                                                "text": "Il était sans conteste du côté des plus forts, mais il avait souvent un sens démagogique assez poussé et il savait faire la part des choses."
                                            },
                                            {
                                                "example_id": "da218095-3fcc-4811-9d4d-5cae778da566",
                                                "sense_id": "e8cec86e-b7d4-3b03-a7bd-b49f3ff8aad6",
                                                "text": "Ce discours frappe par la complaisance démagogique qui émane de l’opposition entre l’ignorant avisé et les incapables hommes de science."
                                            }
