                "senses": [
                    {
                        "sense_id": "c3a84cc2-2a85-32ef-a690-f512bb21506a",
                        "entry_id": "a0cabfc1-e051-30a4-b7c7-b27fd265eb7d",
                        "glosses": [
                            "collar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ca2774-49a0-4563-b19c-5c6936294b0a",
                                "sense_id": "c3a84cc2-2a85-32ef-a690-f512bb21506a",
                                "text": "Нави́сший с кра́я кру́чи сугро́б, растрево́женный паде́нием Ники́ты, насыпа́лся на него́ и засы́пал ему́ сне́гу за ши́ворот.",
                                "translation": "The snowdrift hanging over the edge of the precipice, disturbed by Nikita's fall, sifted down on him (and got) inside his collar.",
                                "english": "The snowdrift hanging over the edge of the precipice, disturbed by Nikita's fall, sifted down on him (and got) inside his collar."
                            }
                        ]
                    },
                    {
                        "sense_id": "220e5107-cdef-300d-b3f4-dd1eecd24d8f",
                        "entry_id": "a0cabfc1-e051-30a4-b7c7-b27fd265eb7d",
                        "glosses": [
                            "collar, scruff of the neck"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "eccf7cbb-e390-4bf6-a3a7-d55040c2878c",
                                "sense_id": "220e5107-cdef-300d-b3f4-dd1eecd24d8f",
                                "text": "схвати́ть за ши́ворот",
                                "translation": "seize by the scruff of the neck, grab by the collar",
                                "english": "seize by the scruff of the neck, grab by the collar"
                            },
                            {
                                "example_id": "366721c2-36ce-417c-ab58-c770b95470dc",
                                "sense_id": "220e5107-cdef-300d-b3f4-dd1eecd24d8f",
                                "text": "вы́тащить за ши́ворот",
                                "translation": "drag out by the collar",
                                "english": "drag out by the collar"
                            },
                            {
                                "example_id": "2c61a2ba-49c3-4984-91bb-efc4dee97c5a",
                                "sense_id": "220e5107-cdef-300d-b3f4-dd1eecd24d8f",
                                "text": "Он чу́вствовал себя́ в положе́нии того́ щенка́, кото́рый ду́рно вел себя́ в ко́мнатах и кото́рого хозя́ин, взяв за ши́ворот, ты́чет но́сом в ту га́дость, кото́рую он сде́лал.",
                                "translation": "He felt himself in the position of a puppy, who has behaved badly in its owner's apartment, and which the owner, seizing it by the scruff of the neck, sticks its nose in the mess that it made.",
                                "english": "He felt himself in the position of a puppy, who has behaved badly in its owner's apartment, and which the owner, seizing it by the scruff of the neck, sticks its nose in the mess that it made."
                            }
                        ]
                    }
