    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "96f831ab-df54-3c7a-b157-51c5a547b196",
                    "sense_definition": "Без волнения, шума или резких движений; тихо и мирно",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель говорил <w>спокойно</w> и уверенно, объясняя новую тему.",
                            "target_lang_translations": {
                                "en": "The teacher spoke <w>calmly</w> and confidently while explaining the new topic.",
                                "zh": "老师在讲解新课题时，说话<w>平静</w>而自信。"
                            }
                        },
                        {
                            "text": "Ребёнок <w>спокойно</w> играл в своей комнате с игрушками.",
                            "target_lang_translations": {
                                "en": "The child was playing <w>quietly</w> in his room with toys.",
                                "zh": "孩子在房间里<w>安静</w>地玩着玩具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "тихо",
                        "безмятежно",
                        "невозмутимо",
                        "бесстрастно",
                        "мирно"
                    ],
                    "antonyms": [
                        "беспокойно",
                        "тревожно",
                        "взволнованно",
                        "возбуждённо",
                        "бурно",
                        "порывисто"
                    ],
                    "common_phrases": [
                        "вести себя спокойно",
                        "спать спокойно",
                        "говорить спокойно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a calm, peaceful, or quiet manner; without agitation or noise",
                        "zh": "以平静、和平或安静的方式；没有激动或噪音"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "calmly",
                                "target_lang_sense_clarification": "without excitement or agitation"
                            },
                            {
                                "target_lang_word": "quietly",
                                "target_lang_sense_clarification": "without making noise"
                            },
                            {
                                "target_lang_word": "peacefully",
                                "target_lang_sense_clarification": "in a serene manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平静地",
                                "target_lang_sense_clarification": "没有激动或不安"
                            },
                            {
                                "target_lang_word": "安静地",
                                "target_lang_sense_clarification": "没有制造噪音"
                            },
                            {
                                "target_lang_word": "平和地",
                                "target_lang_sense_clarification": "以宁静的方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0a172ee-50cc-3796-bb9d-b477f85c1c69",
                    "sense_definition": "Легко, без затруднений или усилий",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>спокойно</w> успели на последний автобус до дома.",
                            "target_lang_translations": {
                                "en": "We <w>easily</w> made it to the last bus home.",
                                "zh": "我们<w>轻松</w>地赶上了回家的末班车。"
                            }
                        },
                        {
                            "text": "Он <w>спокойно</w> может поднять этот тяжёлый ящик одной рукой.",
                            "target_lang_translations": {
                                "en": "He can <w>easily</w> lift this heavy box with one hand.",
                                "zh": "他可以<w>从容</w>地单手提起这个沉重的箱子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "легко",
                        "запросто",
                        "без труда"
                    ],
                    "common_phrases": [
                        "совершенно спокойно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "implies doing something without effort"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Without difficulty, effort, or stress",
                        "zh": "没有困难、费力或压力"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "easily",
                                "target_lang_sense_clarification": "without difficulty"
                            },
                            {
                                "target_lang_word": "without any trouble",
                                "target_lang_sense_clarification": "phrase indicating lack of difficulty"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻松地",
                                "target_lang_sense_clarification": "没有困难"
                            },
                            {
                                "target_lang_word": "从容地",
                                "target_lang_sense_clarification": "不慌不忙，毫不费力"
                            }
                        ]
                    }
                }
            ]
        },
        {
