                                        "glosses": [
                                            "Anfertigen einer Kopie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7abd8b9-0a78-4ac8-bd56-11ad349eba4f",
                                                "sense_id": "6b79fdbd-d102-3647-ace9-b6d830e0ca94",
                                                "text": "Die Musikindustrie verbietet meist die Vervielfältigung von Tondatenträgern."
                                            },
                                            {
                                                "example_id": "2f5d5cc1-48b2-4c91-8718-55c2c94bac7d",
                                                "sense_id": "6b79fdbd-d102-3647-ace9-b6d830e0ca94",
                                                "text": "„Für den Bereich der reprographischen Vervielfältigung (»Vervielfältigungen auf Papier oder ähnlichem Träger«) bleibt die private Vervielfältigung nicht nur erlaubt, sondern das Gesetz gewährt in § 95b Abs. 1 Ziff. 6. UrhG sogar ein Recht hierauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c5e3d9a-f4d8-348b-b39b-8a66f6df5924",
                                        "entry_id": "d76a01f8-c1eb-3c4d-972d-05a2d9f5bc64",
                                        "glosses": [
                                            "durch Kopieren entstandenes Werk; Kopie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4168971-86fe-4300-9004-82a3f5495e2d",
                                                "sense_id": "1c5e3d9a-f4d8-348b-b39b-8a66f6df5924",
                                                "text": "„Für den Bereich der reprographischen Vervielfältigung (»Vervielfältigungen auf Papier oder ähnlichem Träger«) bleibt die private Vervielfältigung nicht nur erlaubt, sondern das Gesetz gewährt in § 95b Abs. 1 Ziff. 6. UrhG sogar ein Recht hierauf.“"
                                            },
                                            {
                                                "example_id": "6130ec71-5392-4257-80ad-58842a02f421",
                                                "sense_id": "1c5e3d9a-f4d8-348b-b39b-8a66f6df5924",
                                                "text": "„Er [der Rechtinhaber] kann außerdem verlangen, dass unrechtmäßige Vervielfältigungen des Werkes vernichtet oder gegen ein angemessenes Entgelt überlassen werden (§98 UrhG).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
