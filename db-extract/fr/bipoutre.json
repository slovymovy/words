                "senses": [
                    {
                        "sense_id": "c7d8f379-53fd-3134-882d-cecff5bac6a2",
                        "entry_id": "0c78ca87-3da7-378a-b305-0f14f7b442e3",
                        "glosses": [
                            "Qualifie un type d’avions dont l’empennage est relié aux ailes par deux longerons (appelés « poutres »), au lieu de faire corps avec le fuselage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299084a9-f259-4ff9-8628-f224e4403b90",
                                "sense_id": "c7d8f379-53fd-3134-882d-cecff5bac6a2",
                                "text": "La disposition bipoutre assure naturellement une meilleure efficacité des double dérives, des gouvernes de direction et du plan de profondeur qui est encastré entre les deux poutres."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a325247-b05d-3b31-9c81-a9fece839668",
                        "entry_id": "0c78ca87-3da7-378a-b305-0f14f7b442e3",
                        "glosses": [
                            "Qualifie un pont dont le tablier est soutenu par deux poutres métalliques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd168ce1-7ff4-44ce-9115-58cca8e8b668",
                                "sense_id": "6a325247-b05d-3b31-9c81-a9fece839668",
                                "text": "Les ponts mixtes bipoutres constituent actuellement une solution économique pour des franchissements routiers et ferroviaires de portée supérieure à 25 m."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4c6ee5c-1592-3cc8-a6ae-f90534e9d0b4",
                        "entry_id": "0c78ca87-3da7-378a-b305-0f14f7b442e3",
                        "glosses": [
                            "Qualifie un pont roulant comprenant deux poutres (rails), au-dessus desquelles circule le palan."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "93f9961d-3af3-46b6-a2c1-d507bc5ac206",
                                "sense_id": "d4c6ee5c-1592-3cc8-a6ae-f90534e9d0b4",
                                "text": "L’atelier de charpente est desservi par trois ponts roulants — type bipoutre — de 5 tonnes, portée 13 mètres; la solution bipoutre s’imposait pour avoir une hauteur de levée maximum."
                            }
                        ]
                    }
