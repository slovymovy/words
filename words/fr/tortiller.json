    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d61875ce-3bb1-3ac9-aa6e-8c584e583fd8",
                    "sense_definition": "Tordre ou rouler plusieurs fois sur lui-même un objet souple comme un fil, du papier ou des cheveux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il écoutait distraitement la réunion en <w>tortillant</w> une mèche de cheveux entre ses doigts."
                        },
                        {
                            "text": "Elle continuait de <w>tortiller</w> son mouchoir avec anxiété pendant que le médecin parlait."
                        }
                    ],
                    "synonyms": [
                        "entortiller",
                        "tordre"
                    ],
                    "antonyms": [
                        "détordre"
                    ],
                    "common_phrases": [
                        "tortiller une mèche",
                        "tortiller un fil"
                    ]
                },
                {
                    "sense_id": "5b8831da-6b64-3535-8da9-ca9f277c818e",
                    "sense_definition": "S'agiter ou se tordre dans tous les sens par gêne, douleur ou impatience.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ver de terre continuait de se <w>tortiller</w> sur le sol humide du jardin."
                        },
                        {
                            "text": "L'enfant n'arrivait pas à rester calme et commençait à se <w>tortiller</w> sur sa chaise."
                        }
                    ],
                    "synonyms": [
                        "frétiller",
                        "gigoter"
                    ],
                    "common_phrases": [
                        "se tortiller sur sa chaise",
                        "se tortiller de douleur"
                    ]
                },
                {
                    "sense_id": "e4c7f98d-b455-38da-b125-808ada68f162",
                    "sense_definition": "Marcher en balançant exagérément le bassin ou les hanches.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle avançait au milieu de la salle en <w>tortillant</w> des hanches au son de la musique."
                        },
                        {
                            "text": "Le danseur semblait <w>tortiller</w> son corps de manière tout à fait spectaculaire."
                        }
                    ],
                    "synonyms": [
                        "se déhancher"
                    ],
                    "common_phrases": [
                        "tortiller des hanches"
                    ]
                },
                {
                    "sense_id": "1304bff6-b445-389d-b0d7-77c45912d45c",
                    "sense_definition": "Chercher des prétextes ou des subterfuges pour retarder une décision ou éviter de répondre directement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'y a pas à <w>tortiller</w>, nous devons prendre une décision immédiate face à ce problème."
                        },
                        {
                            "text": "Arrête de <w>tortiller</w> et dis-moi enfin ce qui s'est réellement passé hier soir."
                        }
                    ],
                    "synonyms": [
                        "hésiter",
                        "tergiverser"
                    ],
                    "antonyms": [
                        "foncer"
                    ],
                    "common_phrases": [
                        "pas à tortiller"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à la forme négative"
                        }
                    ]
                }
            ]
        }
