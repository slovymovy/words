                        "entry_id": "88ce9df8-28bd-3928-9656-349e6b8ef6d4",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отобра́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fee0c423-b42d-325d-820f-7c29e391fbf9",
                        "entry_id": "88ce9df8-28bd-3928-9656-349e6b8ef6d4",
                        "glosses": [
                            "взять обратно, также взять у кого-либо вопреки его желанию; отнять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "337af002-bbf5-42f7-89f4-f9c983319e4f",
                                "sense_id": "fee0c423-b42d-325d-820f-7c29e391fbf9",
                                "text": "Я просто от себя говорю: что если бы царь сказал: отобрать от помещиков землю и отдать мужикам, ― как бы вы сделали?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4a902aca-c943-36df-a457-bf6477c577bd",
                        "entry_id": "88ce9df8-28bd-3928-9656-349e6b8ef6d4",
                        "glosses": [
                            "выделить, выбрать по какому-нибудь признаку из общего числа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f51aef3-e855-484d-ad52-25a00c8348dc",
                                "sense_id": "4a902aca-c943-36df-a457-bf6477c577bd",
                                "text": "Я и гляжу в книгу, да вижу фигу, а ты мне отбери товарцу на свою совесть."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8897f3c-3c66-37a1-94b4-24f5cc42ff35",
                        "entry_id": "88ce9df8-28bd-3928-9656-349e6b8ef6d4",
                        "glosses": [
                            "устар. о сведениях, мнениях и т. п. — собрать, получить путём опроса"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca699390-a39a-4a41-a16d-5868233e6c7f",
                        "source_entry_id": "88ce9df8-28bd-3928-9656-349e6b8ef6d4",
                        "source_sense_description": "выделить, выбрать",
                        "target_lang_word": "select",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "select",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "896b5ce8-538c-3874-9d46-31d10340b42a",
                                        "entry_id": "1bf1e3da-3971-38d0-89da-441ba2a61a7e",
                                        "glosses": [
                                            "Privileged, specially selected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666779e9-4b57-4c6f-9ff6-bafa8aa24c1c",
                                                "sense_id": "896b5ce8-538c-3874-9d46-31d10340b42a",
                                                "text": "Only a select few were allowed into the premiere."
                                            },
                                            {
                                                "example_id": "4dee8e90-026a-4423-847a-3c43c520d0e2",
                                                "sense_id": "896b5ce8-538c-3874-9d46-31d10340b42a",
                                                "text": "A few select spirits had separated from the crowd, and formed a fit audience round a far greater teacher."
                                            },
                                            {
                                                "example_id": "33560f25-5452-4e01-a7e4-3719802b9165",
                                                "sense_id": "896b5ce8-538c-3874-9d46-31d10340b42a",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78d8516d-2dfc-3a37-b525-ce1045b8c8c2",
                                        "entry_id": "1bf1e3da-3971-38d0-89da-441ba2a61a7e",
                                        "glosses": [
                                            "Of high quality; top-notch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a43955-0e84-4b19-b60c-b8134f79f46c",
                                                "sense_id": "78d8516d-2dfc-3a37-b525-ce1045b8c8c2",
                                                "text": "This is a select cut of beef."
                                            },
                                            {
                                                "example_id": "0495608d-8895-4277-adda-1fac5257ba3e",
                                                "sense_id": "78d8516d-2dfc-3a37-b525-ce1045b8c8c2",
                                                "text": "The two sisters at once called on Mrs. Bolton, in a newish house in a row, quite select for Tevershall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "select",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17d9a57f-e67c-342e-829a-eb5ed48b7919",
                                        "entry_id": "7e8251c7-0606-3241-9d7f-66e80fa7ad3f",
                                        "glosses": [
                                            "To choose one or more elements of a set, especially a set of options."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c7e39d-dd13-4b70-8843-21a2f382cd52",
                                                "sense_id": "17d9a57f-e67c-342e-829a-eb5ed48b7919",
                                                "text": "He looked over the menu, and selected the roast beef."
                                            },
                                            {
                                                "example_id": "64e5c2a9-0ab7-4c65-bb86-ef1f1bcb2fdf",
                                                "sense_id": "17d9a57f-e67c-342e-829a-eb5ed48b7919",
                                                "text": "The program computes all the students' grades, then selects a random sample for human verification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ac5d615-e86b-320f-a9a7-273f173f925e",
                                        "entry_id": "7e8251c7-0606-3241-9d7f-66e80fa7ad3f",
                                        "glosses": [
                                            "To obtain a set of data from a database using a query."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d7da68a-c189-4d0c-af1f-fa56f52f8dfd",
                        "source_entry_id": "88ce9df8-28bd-3928-9656-349e6b8ef6d4",
                        "source_sense_description": "выделить, выбрать",
                        "target_lang_word": "single out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "single out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80b6ccce-298a-3802-984a-86391e8c81b8",
                                        "entry_id": "7aa941b4-40ec-3942-bffd-1dda3a5d4ecc",
                                        "glosses": [
                                            "To select (someone or something) from a group and highlight them or treat them differently."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb3fef1-2199-4d1d-b0ad-cf917e2a8369",
                                                "sense_id": "80b6ccce-298a-3802-984a-86391e8c81b8",
                                                "text": "Yvonne always wondered why Ernest had singled her out of the group of giggling girls she hung around with."
                                            },
                                            {
                                                "example_id": "b4e0169f-c967-4a1a-be3e-fbe09c9bd798",
                                                "sense_id": "80b6ccce-298a-3802-984a-86391e8c81b8",
                                                "text": "For quotations using this term, see Citations:single out."
