                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d09a98-bad9-4f27-b173-ce9d08604572",
                                                "sense_id": "07235631-b85a-3dc7-96d3-578b5d118375",
                                                "text": "Jetzt noch rechtzeitig zum Vorstellungsbeginn ins Theater zu kommen, kannst du dir abschminken."
                                            },
                                            {
                                                "example_id": "372e64ed-d187-4dcf-b9eb-f67e2e7c0d11",
                                                "sense_id": "07235631-b85a-3dc7-96d3-578b5d118375",
                                                "text": "Eine Einladung zu einem Vorstellungsgespräch habe ich mir schon abgeschminkt."
                                            }
