                "senses": [
                    {
                        "sense_id": "52efb657-f395-3221-bed9-a7e60c472b1f",
                        "entry_id": "74d43068-85d2-303a-95f7-1b987fa10e51",
                        "glosses": [
                            "weergaven van het geluid van een luidende klok"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fbcebd-6c96-4073-acb6-878e1a1a8c5f",
                                "sense_id": "52efb657-f395-3221-bed9-a7e60c472b1f",
                                "text": "⧖ De koster trok ook eens even bombam aan het klokkezeel; de buren stopten haastig den kuil. Alleen de oude pastoor heeft uit het diepste zijns harten voor de ongelukkige lijderes gebeden."
                            },
                            {
                                "example_id": "6188a5df-a121-4a12-94e3-a48c1450f8ce",
                                "sense_id": "52efb657-f395-3221-bed9-a7e60c472b1f",
                                "text": "⧖ Want als ik ter kerken ga en de klok bombam hoor luiden, soo werd de hamer bewogen, oft de klepel, welke de logt door de klok hene slaat, soo dat ieder deeltjen der klok bewogen werd, waar door de omstaande logt, als gezegt is, mede bewogen word, en by gevolg onse ooren."
                            }
                        ]
                    }
                ],
