                            "past"
                        ],
                        "form": "наткну́вшийся"
                    },
                    {
                        "form_id": "40a4fc3b-6e7c-4462-a475-13437cc28f4b",
                        "entry_id": "0aa253dd-d89d-318a-ab0a-9a53c8f672db",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "наткну́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8677e576-13b4-39ce-bf23-17caba9f5c88",
                        "entry_id": "0aa253dd-d89d-318a-ab0a-9a53c8f672db",
                        "glosses": [
                            "наскочить, напороться на что-либо острое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75467eae-12f7-4d75-893a-7d635f3a7c83",
                                "sense_id": "8677e576-13b4-39ce-bf23-17caba9f5c88",
                                "text": "Был хмелен, да наткнулся на какой-то сук."
                            },
                            {
                                "example_id": "e27a3ed3-b45b-42ba-82b4-f6b1d5053d38",
                                "sense_id": "8677e576-13b4-39ce-bf23-17caba9f5c88",
                                "text": "Наткнувшись на острый предмет, мы сразу же испытываем резкую боль."
                            }
                        ]
                    },
                    {
                        "sense_id": "1050e090-a9a1-3f07-a0ac-b2662cf65674",
                        "entry_id": "0aa253dd-d89d-318a-ab0a-9a53c8f672db",
                        "glosses": [
                            "двигаясь, неожиданно натолкнуться на кого-либо, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab746fb9-7337-4597-9ed1-12b8e3fcb002",
                                "sense_id": "1050e090-a9a1-3f07-a0ac-b2662cf65674",
                                "text": "Раза два я наткнулся на плетень, раз чуть не свалился в канаву, чуть не споткнулся о лежавшую на земле крестьянскую лошаденку…"
                            },
                            {
                                "example_id": "9831ed78-af46-442f-92de-6fef4d327d0a",
                                "sense_id": "1050e090-a9a1-3f07-a0ac-b2662cf65674",
                                "text": "Но минут через десять, когда служба кончилась, дьячок, выходя из церкви, встретил на пути своём препятствие. ― На человека наткнулся! ― крикнул он, ― ишь, пьяница, растянулся!"
                            },
                            {
                                "example_id": "67c7b76b-f338-4f94-909b-f2fb7f2c90e5",
                                "sense_id": "1050e090-a9a1-3f07-a0ac-b2662cf65674",
                                "text": "Сделав шаг от плиты, я наткнулся на другой предмет… И представьте мой ужас! Это был деревянный крест…"
                            },
                            {
                                "example_id": "24a0ff68-3fa8-4538-8f76-eca2d299ef90",
                                "sense_id": "1050e090-a9a1-3f07-a0ac-b2662cf65674",
                                "text": "Через минуту зонд наткнулся на твёрдое препятствие."
                            }
                        ]
                    },
                    {
                        "sense_id": "366ff9be-cd1b-3a39-87f4-2774b2ba9152",
                        "entry_id": "0aa253dd-d89d-318a-ab0a-9a53c8f672db",
                        "glosses": [
                            "разг. случайно или неожиданно обнаружить что-либо, встретиться с кем-, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17da22c-3729-4dc3-84d7-715ebc054eea",
                                "sense_id": "366ff9be-cd1b-3a39-87f4-2774b2ba9152",
                                "text": "И тут, как в игре в жмурки, французы наткнулись на наш авангард."
                            },
                            {
                                "example_id": "b5df756f-3054-49c0-9449-565829384ac3",
                                "sense_id": "366ff9be-cd1b-3a39-87f4-2774b2ba9152",
                                "text": "Вышедши на улицу, он наткнулся на какого-то прохожего и спросил, не знает ли он, где живет учитель Леонтий Козлов."
                            },
                            {
                                "example_id": "7f91c7b7-552d-4ee4-9e35-fb57ae6d3ebe",
                                "sense_id": "366ff9be-cd1b-3a39-87f4-2774b2ba9152",
                                "text": "Шёл за прозой, а наткнулся на поэзию…"
                            },
                            {
                                "example_id": "6be934f6-8f3a-41ce-96bd-3555c758b61b",
                                "sense_id": "366ff9be-cd1b-3a39-87f4-2774b2ba9152",
                                "text": "Перебирая свой архив, я наткнулся на снимки, выполненные 60 лет назад."
                            }
                        ]
                    },
                    {
                        "sense_id": "804a946d-b2f0-31cf-9161-11251c4879dd",
                        "entry_id": "0aa253dd-d89d-318a-ab0a-9a53c8f672db",
                        "glosses": [
                            "встретить препятствие, противодействие своим замыслам, планам, своей деятельности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59d14aa3-b5d1-4c6f-b0b3-4c5bb0550473",
                                "sense_id": "804a946d-b2f0-31cf-9161-11251c4879dd",
                                "text": "― Я вам говорю, я приехала и прямо на интригу наткнулась."
                            },
                            {
                                "example_id": "495d2b39-b687-42e2-a433-36fac6f32544",
                                "sense_id": "804a946d-b2f0-31cf-9161-11251c4879dd",
                                "text": "Но тут, помимо моих скудных сведений, я наткнулся на полную невозможность ставить диагнозы, потому что признаки болезни у всех моих пациентов были всегда одни и те же: «в середине болит» и «ни есть, ни пить не можу»."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
