        "fr-extract.jsonl": [
            {
                "entry_id": "7eb35b99-a0df-3801-8581-70fbeb137fba",
                "word": "sequin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "669f6d97-471e-497b-8f40-7ae01073b8bf",
                        "entry_id": "7eb35b99-a0df-3801-8581-70fbeb137fba",
                        "tags": [
                            "plural"
                        ],
                        "form": "sequins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8deea024-4a86-3dd8-a193-c835028a5a19",
                        "entry_id": "7eb35b99-a0df-3801-8581-70fbeb137fba",
                        "glosses": [
                            "Ancienne monnaie d’or de Venise qui avait cours surtout dans le Levant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea01545-d8de-4018-a638-80d854b910f7",
                                "sense_id": "8deea024-4a86-3dd8-a193-c835028a5a19",
                                "text": "Pas un sequin, pas un penny d’argent, pas un sou ; puisse le Dieu d’Abraham me secourir ! dit le juif se tordant les mains."
                            },
                            {
                                "example_id": "478afc4e-20b2-48e8-b522-b2e3d157f776",
                                "sense_id": "8deea024-4a86-3dd8-a193-c835028a5a19",
                                "text": "J'examinai mes registres de vente et d’achat, et, trouvant que j'avais doublé mon fonds, c'est-à-dire que j'étais riche de deux mille sequins, je lui en donnai la moitié."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dd9d491-c861-396c-a2b8-ed15f278b56f",
                        "entry_id": "7eb35b99-a0df-3801-8581-70fbeb137fba",
                        "glosses": [
                            "Petite paillette ronde brodée sur un tissu."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "3f18a02f-328c-478a-8a80-600148ac6173",
                                "sense_id": "3dd9d491-c861-396c-a2b8-ed15f278b56f",
                                "text": "Des tziganes cuivrés passaient : de lourds sequins leur tiraient les oreilles. Elles riaient de leurs dents de louve, de leurs seins secoués dans les camisoles crevées."
                            },
                            {
                                "example_id": "45034e27-862b-4907-aa8d-a3f4433e0007",
                                "sense_id": "3dd9d491-c861-396c-a2b8-ed15f278b56f",
                                "text": "Tels ces 6097 € misés, en juin 2001, pour une minirobe en sequins noirs de Paco Rabanne."
                            },
                            {
                                "example_id": "d9a7c0a0-afc0-4b30-8040-1a8f4a353bdd",
                                "sense_id": "3dd9d491-c861-396c-a2b8-ed15f278b56f",
                                "text": "bouclier d'écaillés aux motifs de marguentes en sequins rebrodés."
                            },
                            {
                                "example_id": "52cd7369-1e46-43d7-9067-f0c3c394fb25",
                                "sense_id": "3dd9d491-c861-396c-a2b8-ed15f278b56f",
                                "text": "Les portières en ailes de papillon pailletées, aussi brillantes que les sequins du costume Las Vegas d’Elvis Presley dans sa période pattes d’éph’."
                            },
                            {
                                "example_id": "1e5bb58b-f90b-40cd-b903-7dd75c2ac63d",
                                "sense_id": "3dd9d491-c861-396c-a2b8-ed15f278b56f",
                                "text": "Quel effet ça t'a fait, de devoir quitter les lieux pour te retrouver sous la neige, n'ayant nulle part où aller, toute seule dans la nuit avec ton maquillage de pro et ta robe à sequins ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b3d5fee-3968-46af-aea6-32c26d564ece",
                        "source_entry_id": "7eb35b99-a0df-3801-8581-70fbeb137fba",
                        "source_sense_description": "monnaie d’or",
                        "target_lang_word": "Zechine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zechine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92fc0178-1cf4-3adb-96da-7fd960aa4af1",
                                        "entry_id": "4dd9e6c6-9fb0-3b12-aa23-5124e806a4de",
                                        "glosses": [
                                            "venezianische Goldmünze"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3961410c-afc4-4c15-9950-c09d3bcf2c28",
                                                "sense_id": "92fc0178-1cf4-3adb-96da-7fd960aa4af1",
                                                "text": "„Das ist der elfte Teil einer Zechine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff00a8e0-5e23-43f1-8e20-69bd0524968f",
                        "source_entry_id": "7eb35b99-a0df-3801-8581-70fbeb137fba",
                        "source_sense_description": "monnaie d’or",
                        "target_lang_word": "sequin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sequin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e208883-c155-3f86-9eb0-55cd21345d86",
                                        "entry_id": "7f87a036-8aa0-3ff9-8bb0-b77a88bba798",
                                        "glosses": [
                                            "Any of various small gold coins minted in Italy and Turkey."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c81807c-6e1b-4223-967d-973393dfa069",
                                                "sense_id": "9e208883-c155-3f86-9eb0-55cd21345d86",
                                                "text": "‘Let him receive as many robes of honour and thousands of sequins of gold as he hath spoken words.’"
                                            },
                                            {
                                                "example_id": "2547edb8-2d66-472e-b13a-52f9c20b2404",
                                                "sense_id": "9e208883-c155-3f86-9eb0-55cd21345d86",
                                                "text": "English, French, Spanish, Portuguese, Georges, and Louises, doubloons and double guineas and moidores and sequins, the pictures of all the kings of Europe for the last hundred years, strange Oriental pices stamped with what looked like wisps of string or its of spider's web, round pieces and square pieces, and pieces bored through the middle, as if to ware them round your neck - nearly every variety of money in the world must, I think, have found a place in that collection..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9869898e-1974-3345-855b-affcb5738d09",
                                        "entry_id": "7f87a036-8aa0-3ff9-8bb0-b77a88bba798",
                                        "glosses": [
                                            "A sparkling spangle used for the decoration of ornate clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92dd83cd-7d1d-462d-bc8b-e4d4046e0690",
                                                "sense_id": "9869898e-1974-3345-855b-affcb5738d09",
                                                "text": "His ideas of music-hall costumes had never gone beyond short skirts, a swirl of lace, and glittering sequins; but Miss Antonia had expressed herself on that subject in no uncertain terms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sequin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96e476fc-2831-33b1-a262-173d4ee41121",
                                        "entry_id": "b176ddec-253f-3b2a-9a04-65bb04a7a1ad",
                                        "glosses": [
                                            "To decorate with sequins."
                                        ],
                                        "tags": [
