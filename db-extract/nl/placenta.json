                                        "examples": [
                                            {
                                                "example_id": "99b80445-f696-4082-a072-11c174fd068b",
                                                "sense_id": "91ea6a5e-3741-36d9-8309-07fc25d9bb13",
                                                "text": "Der Mutterkuchen versorgt den Fetus über die Nabelschnur."
                                            },
