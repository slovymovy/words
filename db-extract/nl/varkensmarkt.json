                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd5fd79a-32bc-40f7-b2ed-9d6ee664e85a",
                                "sense_id": "a2f1ca56-3c82-3ef6-9bba-0ae9d9e62146",
                                "text": "Varkensmarkten zijn al sinds de jaren zestig verboden. Nederland telt nu nog acht grote veemarkten, die per jaar 1,5 miljoen runderen, kalveren en schapen verhandelen."
                            }
                        ]
                    },
