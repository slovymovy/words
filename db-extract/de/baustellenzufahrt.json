                "senses": [
                    {
                        "sense_id": "42351124-958c-3a60-a552-a82cae3549b9",
                        "entry_id": "d62caf9f-9437-3c0d-af4b-6c4f392ab685",
                        "glosses": [
                            "Straße, die zu einem Baustellengelände führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd32012b-ff14-4441-b276-9940b349d476",
                                "sense_id": "42351124-958c-3a60-a552-a82cae3549b9",
                                "text": "„Die Deutsche und ihre beiden Töchter kletterten über die Betonleitwand, welche die Baustellenzufahrt von der Hauptfahrbahn trennt.“"
                            },
                            {
                                "example_id": "0afdb088-ce88-463f-949d-0f0554ccc665",
                                "sense_id": "42351124-958c-3a60-a552-a82cae3549b9",
                                "text": "Die Baustellenzufahrt wurde neu angelegt."
                            },
                            {
                                "example_id": "14062ace-fa5e-4d64-abdf-33ae1f56b29f",
                                "sense_id": "42351124-958c-3a60-a552-a82cae3549b9",
                                "text": "„Im Streit um die Baustellenzufahrt mitten durch die autofreie Siedlung Weißenburg haben sich die Grünen eingeschaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
