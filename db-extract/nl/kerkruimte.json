                        "sense_id": "bf1fc1ba-54be-3ce1-957e-54a32edf362c",
                        "entry_id": "a6ebf591-7f65-32fb-9204-cc4d003b3d58",
                        "glosses": [
                            "ruimte geschikt voor het houden van een mis of eredienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a400559-b294-4fd9-9b74-be452139d894",
                                "sense_id": "bf1fc1ba-54be-3ce1-957e-54a32edf362c",
                                "text": "De bovengalerijen werden dichtgemetseld en in het oostelijk dwarsschip werd een provisorisch plafond aangebracht, waardoor een afgesloten ruimte ontstond die diende als kerkruimte voor zo'n 350 kerkgangers."
                            },
                            {
                                "example_id": "9e5d3d6f-b0ac-43d4-9ef9-42c716680bc2",
                                "sense_id": "bf1fc1ba-54be-3ce1-957e-54a32edf362c",
                                "text": "De keizerin trok zich terug in een kapel die met tapijten behangen was, maar de prinses verkoos in de kerkruimte te blijven omdat het daar koeler was; en natuurlijk ook omdat zij van daaruit Tirant beter in het oog kon houden."
                            },
                            {
                                "example_id": "0aef4661-03f3-41d3-afb3-975fd3d5c5b2",
                                "sense_id": "bf1fc1ba-54be-3ce1-957e-54a32edf362c",
                                "text": "De krijgsgevangenen kregen strafvermindering toegezegd voor hun werk aan het kolossale monument. Het bestaat uit een 260 meter lange kerkruimte uitgehouwen in een granieten rotswand. Op de tombe staat ook nog eens een betonnen kruis van 150 meter hoogte."
                            }
                        ]
                    }
