                "senses": [
                    {
                        "sense_id": "433b0a85-e54a-3573-a2ef-5aa3793452f4",
                        "entry_id": "a72159d4-bee8-3d67-b542-238022b78ee2",
                        "glosses": [
                            "Angelrolle, bei der sich die Spule, mit Hilfe einer Übersetzung, schneller dreht als sich die Kurbel bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "951f2e55-bfaa-4f9b-b3f1-2726bcb4af85",
                                "sense_id": "433b0a85-e54a-3573-a2ef-5aa3793452f4",
                                "text": "Im Gegensatz zur Stationärrolle, liegt bei der Multirolle die Spulenachse quer zur Achse der Angelrute und der Spulenkörper bewegt sich bei der Schnuraufnahme."
                            },
                            {
                                "example_id": "e7d4f8ec-13ac-49d5-8d65-40e7f892394a",
                                "sense_id": "433b0a85-e54a-3573-a2ef-5aa3793452f4",
                                "text": "„Die Multiplikatorrolle (kurz Multirolle) ist eine Weiterentwicklung der Nottinghamrolle (Fliegenrolle).“"
                            },
                            {
                                "example_id": "115e838c-170c-4a0c-9299-1d8d7160a20d",
                                "sense_id": "433b0a85-e54a-3573-a2ef-5aa3793452f4",
                                "text": "„Auf dem Markt gibt es unzählige Multirollen in jedem Preissegment, aber wie immer liegt der Teufel im Detail.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
