                    {
                        "sense_id": "08f4a434-0740-37e6-befe-0570dfe16871",
                        "entry_id": "63b1423b-dd0f-3bcd-b81e-1f436fc5b344",
                        "glosses": [
                            "specjalista w zakresie racjonalnego żywienia, opracowujący diety dostosowane do potrzeb ludzi zdrowych oraz do różnych schorzeń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e57f0d60-f7ed-4839-8b73-c12bbaa2040d",
                                "sense_id": "08f4a434-0740-37e6-befe-0570dfe16871",
                                "text": "Mój dietetyk zabronił mi pić kawę."
                            },
                            {
                                "example_id": "27eb533e-cc2a-4ca0-bc8c-27324e308d3e",
                                "sense_id": "08f4a434-0740-37e6-befe-0570dfe16871",
                                "text": "Ulryk jest dietetykiem, który właśnie wydał książkę ze stoma wegańskimi i wegetariańskimi przepisami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
