                        "entry_id": "55c79fd1-2f5f-3d11-9801-1cd2427ea9bb",
                        "glosses": [
                            "Textilwesen, ohne Plural, selten und veraltet: Technik zur Herstellung von textilen Flächengebilden, bei dem mindestens zwei Fadensysteme rechtwinklig verkreuzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2d91a05-2d2a-4055-8596-b9bb1dda89e5",
                                "sense_id": "7dd0757c-2b07-3f54-94e4-0d36898886b8",
                                "text": "Die Weberei wurde im Kloster zur höchsten Vervollkommnung gebracht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a800d2c-5f58-35e8-b97f-cf8918164666",
