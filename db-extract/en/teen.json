                                "target_senses": [
                                    {
                                        "sense_id": "48762ff8-7ef0-3d52-b563-82140ef32b9f",
                                        "entry_id": "a50a5107-1b07-3af6-ab8d-4e1fd9bfb7b5",
                                        "glosses": [
                                            "книжн. большое несчастье; тяжёлая, катастрофическая ситуация связанная с материальным ущербом или/и человеческими жертвами, резко нарушающая привычный уклад жизни людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "069c4d2e-6ab6-4768-a510-6e622252faaa",
                                                "sense_id": "48762ff8-7ef0-3d52-b563-82140ef32b9f",
                                                "text": "Горе же беременным и питающим сосцами в те дни; ибо великое будет бедствие на земле и гнев на народ сей…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3354082a-6f5a-482e-8e60-cc5b3237b866",
                        "source_entry_id": "5ae8a530-b264-3f1f-8bac-050b2e2f6df0",
                        "source_sense_description": "grief, sorrow, suffering",
                        "target_lang_word": "го́ре",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "го́ре",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d154bed7-c743-3cf2-9d8a-104fcd63abdf",
                                        "entry_id": "34eceae0-644d-3d32-ac25-3a6d795ab671",
                                        "glosses": [
                                            "сильная глубокая печаль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51095fb-9451-4998-8891-a1cab5c4868c",
                                                "sense_id": "d154bed7-c743-3cf2-9d8a-104fcd63abdf",
                                                "text": "Его горю не было предела."
                                            },
                                            {
                                                "example_id": "84161400-afe4-4c4c-885b-a706cd011d63",
                                                "sense_id": "d154bed7-c743-3cf2-9d8a-104fcd63abdf",
                                                "text": "Выпьем, добрая подружка // Бедной юности моей, // Выпьем с горя; где же кружка? // Сердцу будет веселей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62caf330-9ab6-35ef-9877-bd772930ccfa",
                                        "entry_id": "34eceae0-644d-3d32-ac25-3a6d795ab671",
                                        "glosses": [
                                            "несчастье, причина или источник горя в значении [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133679b6-195a-4565-abfc-420f70621802",
                                                "sense_id": "62caf330-9ab6-35ef-9877-bd772930ccfa",
                                                "text": "Ты моё горе."
                                            },
                                            {
                                                "example_id": "d8f009e7-0605-4601-bfdd-c20794c1207f",
                                                "sense_id": "62caf330-9ab6-35ef-9877-bd772930ccfa",
                                                "text": ".. Велика беда, не спорю; // Но могу помочь я горю."
                                            },
                                            {
                                                "example_id": "34bf7570-ded2-4966-8b4c-750e2598ff4a",
                                                "sense_id": "62caf330-9ab6-35ef-9877-bd772930ccfa",
                                                "text": "На двадцать первом году .. Ольгу Сергеевну постигло горе: у ней скончался муж."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "го́ре",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "08af2224-7ad2-3002-9951-26c3e703ba2d",
                                        "entry_id": "e5a1b397-f169-3523-9e11-a35b596a3767",
                                        "glosses": [
                                            "устар., высок. вверх, кверху"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d622af6b-6be0-4f39-a316-e18c865501ae",
                                                "sense_id": "08af2224-7ad2-3002-9951-26c3e703ba2d",
                                                "text": "— О друг мой, — вещал Янька пророческим голосом и воздевши очи горе́, — о Иосиф! ты погиб!"
                                            },
                                            {
                                                "example_id": "085181e8-431a-4677-8874-8ca2b3b62878",
                                                "sense_id": "08af2224-7ad2-3002-9951-26c3e703ba2d",
                                                "text": "— И Николь, эффектно воздев руки горе́, ловко упала на колени перед постелью Машеньки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f449ca3e-061c-3502-bfb4-0c5486b5ccb1",
                                        "entry_id": "e5a1b397-f169-3523-9e11-a35b596a3767",
                                        "glosses": [
                                            "устар., поэт. высоко, в вышине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae77ed78-a1cd-45ba-8588-cf61a492f07e",
                                                "sense_id": "f449ca3e-061c-3502-bfb4-0c5486b5ccb1",
                                                "text": "Горе́ пред ним орел парит."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "го́ре",
                                "target_lang_code": "ru",
                                "target_senses": [
