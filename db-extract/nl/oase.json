                    },
                    {
                        "sense_id": "24741b0c-f2e7-3a04-b717-759362009860",
                        "entry_id": "76a5bea6-531d-3770-a057-d6d637f39166",
                        "glosses": [
                            "plaats waar men soelaas vindt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "eeefbb25-34ad-4c06-b4d1-0eb3e77494f8",
                                "sense_id": "24741b0c-f2e7-3a04-b717-759362009860",
                                "text": "Een oase van rust in de drukke stad."
                            },
                            {
                                "example_id": "b95bcdbc-be5d-4bb3-bb28-29dd267f18b7",
                                "sense_id": "24741b0c-f2e7-3a04-b717-759362009860",
                                "text": "Kennedy Meadows is een soort oase die je als een draaikolk kan opslokken en waar je veel te lang in kunt blijven hangen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e9c996c-6186-4ba0-bac3-b9e25e727d4a",
                        "source_entry_id": "76a5bea6-531d-3770-a057-d6d637f39166",
                        "source_sense_id": "95db24ee-debb-316c-bc7a-e1320769730f",
                        "source_sense_description": "plek in een woestijn waar water voorhanden is en vegetatie groeit.",
                        "target_lang_word": "Oase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8654a2b6-c24c-3d06-b6b5-00b282fe5757",
                                        "entry_id": "2e9f6bbb-c58c-3f56-a8ea-5ac86fefd84f",
                                        "glosses": [
                                            "Bereich innerhalb einer Wüste, in der es Wasser und Pflanzen gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb1aa5b-2a09-43ce-b79a-f6679c388df3",
                                                "sense_id": "8654a2b6-c24c-3d06-b6b5-00b282fe5757",
                                                "text": "War es der Wassermangel oder eine Fata Morgana, die ihn inmitten der Wüste eine Oase sehen ließ?"
                                            },
                                            {
                                                "example_id": "d5ae96ab-db2a-46eb-a0a1-7957677efe22",
                                                "sense_id": "8654a2b6-c24c-3d06-b6b5-00b282fe5757",
                                                "text": "„Ich war ein wenig enttäuscht von dem Anblick, denn ich hatte bereits die ersten grünen Vorboten der Oase erwartet.“"
                                            },
                                            {
                                                "example_id": "53d505d5-a9e2-4545-a795-c304f9f061d4",
                                                "sense_id": "8654a2b6-c24c-3d06-b6b5-00b282fe5757",
                                                "text": "„Die Reise verlief von Mesched aus nach Norden, durch die Oasen der Karakumwüste, über eine Entfernung von 550 Kilometern, von denen er höchstens zwanzig pro Tag zurücklegen konnte.“"
                                            },
                                            {
                                                "example_id": "16f89e51-a3a8-4714-81d6-3a09df34b924",
                                                "sense_id": "8654a2b6-c24c-3d06-b6b5-00b282fe5757",
                                                "text": "„Ägypten besaß zur Zeit der Pharaonen eine hohe Weinbaukultur, die edlen Weine aus dem Nildelta und den Oasen hatten einen sehr guten Ruf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3dc3781-2bd6-38a8-bf70-e1474df3e45d",
                                        "entry_id": "2e9f6bbb-c58c-3f56-a8ea-5ac86fefd84f",
                                        "glosses": [
                                            "positiver Gegenpart zum negativen sonstigen Zustand"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6538f1-483d-4412-adb9-92372e035c72",
                                                "sense_id": "c3dc3781-2bd6-38a8-bf70-e1474df3e45d",
                                                "text": "Unser Kurort ist eine Oase in der modernen Stressgesellschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8881e81e-8c9e-44e1-8b41-853a2fb08119",
                        "source_entry_id": "76a5bea6-531d-3770-a057-d6d637f39166",
                        "source_sense_id": "95db24ee-debb-316c-bc7a-e1320769730f",
                        "source_sense_description": "plek in een woestijn waar water voorhanden is en vegetatie groeit.",
                        "target_lang_word": "oasis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oasis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                        "entry_id": "7b1314d6-becb-38d8-acc9-9d031c9665ee",
                                        "glosses": [
                                            "Lieu, espace qui, dans le désert offre de la végétation souvent florissante parce que cultivée, le plus souvent par des populations sédentaires."
                                        ],
                                        "tags": [
                                            "Ethnobiologie",
                                            "Hydrobiologie",
                                            "Mésologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f42224-3105-4fab-a48a-bf90de6fa8da",
                                                "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                                "text": "Cependant lorsque avec des peines extrêmes on a fait six lieues dans ces solitudes embrasées, l’œil se repose avec délice sur une splendide oasis qui semble tout à coup surgir du sein des sables."
                                            },
                                            {
                                                "example_id": "20c5ba2f-3df2-434e-a913-4b83ac6473a2",
                                                "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                                "text": "Hama Srir entra dans l’oasis et découvrit un taleb qui, pour quelques sous, écrivit la lettre."
                                            },
                                            {
                                                "example_id": "24c942cf-40ee-4d99-bfa6-2bf88d2ab138",
                                                "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                                "text": "J’aurai atteint cet oasis à travers bien des peines et des privations"
                                            },
                                            {
                                                "example_id": "e7d6a858-6f4b-4c92-b511-ca14728d6fee",
                                                "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                                "text": "Arrivée à l’oasis de Tsabit, la plus septentrionale du groupe d’oasis désigné sous le nom collectif de Touât, la caravane fit halte devant le premier kçar que l'on rencontra, c'était celui de Arian-el-Raz."
                                            },
                                            {
                                                "example_id": "e96fbe30-b127-46d3-adad-36cd4937ce98",
                                                "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                                "text": "Dans une petite oasis voisine du rivage campaient plusieurs troupes d’Islandais qui allaient à Eyrarbakki acheter des marchandises; ils s'abritaient sous de petites tentes de vadmel, pendant que leurs chevaux paissaient alentour."
                                            },
                                            {
                                                "example_id": "0482b673-8bad-428e-822f-4e52e89b72d4",
                                                "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                                "text": "Le désert s’étend jusqu’aux environs d’Ouzoun-Ada, et les stations du railway forment autant de petites oasis, créées par la main de l’homme."
                                            },
                                            {
                                                "example_id": "a4a92c6b-fea4-46fb-82e3-f28fa50be8cb",
                                                "sense_id": "49065a0c-02a3-3997-8daa-0545c183da48",
                                                "text": "En quittant Gaoshang, le voyageur passe par Korla, un important nœud routier, Karachar (Yanqi), Kucha (Jiuci) et Aksu (Gumo), au nord du Taklamakan et au pied des monts Tian Shan, une localité connue pour ses pastèques et ses vergers fruitiers, pour arriver enfin à l’oasis de Kachgar, l’ancienne Shule des Han, la dernière place d’importance stratégique de la route de la soie avant Pamir et point de jonction des itinéraires méridional et central."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4ab96d5-6099-3a66-9e86-a1b8dcc72fe4",
                                        "entry_id": "7b1314d6-becb-38d8-acc9-9d031c9665ee",
                                        "glosses": [
                                            "Lieu qui offre un repos, une détente."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80bc61ab-ae70-4d90-888f-23a3e0033aa5",
                                                "sense_id": "a4ab96d5-6099-3a66-9e86-a1b8dcc72fe4",
                                                "text": "Toute ma défense est […] dans ce maintien pour nous d’un oasis"
                                            },
                                            {
                                                "example_id": "910f02fd-38f1-4dc2-b1a3-e7f29c95f457",
                                                "sense_id": "a4ab96d5-6099-3a66-9e86-a1b8dcc72fe4",
                                                "text": "Un Français savoyard sympathique avait réussi à y créer un oasis, gai, attirant, de fleurs et de verdure."
                                            },
                                            {
                                                "example_id": "7e6638f0-9d6e-4a6e-a920-e4deae6a5762",
                                                "sense_id": "a4ab96d5-6099-3a66-9e86-a1b8dcc72fe4",
                                                "text": "Le télétravail donne maintenant à plusieurs personnes l’occasion de s’offrir une oasis de paix, loin du vacarme des villes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
