                },
                {
                    "sense_id": "f471031a-7f76-3e9a-8f4f-d3921bd4a95a",
                    "sense_definition": "Публичное устное выступление перед аудиторией.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "public_speaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Президент произнёс торжественную <w>речь</w> перед народом.",
                            "target_lang_translations": {
                                "en": "The president delivered a solemn <w>speech</w> to the people.",
                                "zh": "总统向民众发表了庄严的<w>演讲</w>。"
                            }
                        },
                        {
                            "text": "Его вступительная <w>речь</w> была короткой, но очень эмоциональной.",
                            "target_lang_translations": {
                                "en": "His opening <w>speech</w> was short but very emotional.",
                                "zh": "他的开场<w>发言</w>虽然简短，但非常感人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "выступление",
                        "доклад",
                        "спич"
