                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e36907e-1a3a-4633-85e6-aa0b4b3ede01",
                                "sense_id": "4241552c-64e2-3965-8ae8-24c5e3646a23",
                                "text": "„Bald zogen sie das Segel auf; das Schifflein drehte sich und folgte dem Kanal in östlicher Richtung.“"
                            },
                            {
                                "example_id": "3ce9ff40-d6da-468b-9d18-ff673c89edca",
                                "sense_id": "4241552c-64e2-3965-8ae8-24c5e3646a23",
                                "text": "„Ein anderes Schifflein war uns bestimmt, vermutlich der klapprige Kasten, den jeden Monat die Transports Maritimes nach Martinique schickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
