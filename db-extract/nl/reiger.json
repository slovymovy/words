                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fde52557-a63a-34e3-a504-7fd2ba1e1281",
                                        "entry_id": "31ea8cc9-ca63-3bf7-b9ef-3d4f4aee70ba",
                                        "glosses": [
                                            "hochbeiniger Schreitvogel mit langem Hals und Schnabel, kleinem Kopf und rauer, krächzender Stimme; lebt monogam in größeren Gesellschaften am Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e113bc26-24ef-4b69-89e6-d65bb2e93ac1",
                                                "sense_id": "fde52557-a63a-34e3-a504-7fd2ba1e1281",
                                                "text": "Der Graureiher lebt kolonieweise auf Bäumen."
                                            },
                                            {
                                                "example_id": "2dba78b7-d057-4d77-98f6-819128c20123",
                                                "sense_id": "fde52557-a63a-34e3-a504-7fd2ba1e1281",
                                                "text": "Reiher stehen unter Naturschutz."
                                            },
                                            {
                                                "example_id": "a7f4bc3d-86a4-4def-8efc-4503c11b293b",
                                                "sense_id": "fde52557-a63a-34e3-a504-7fd2ba1e1281",
                                                "text": "„Die Nacht war erfüllt vom Flattern der Fledermäuse, dem Zirpen der Insekten, den Rufen der Reiher und dem Rascheln der Flusspferde, die unter meiner Schlafplattform im Schilf weideten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daa47b73-97c6-4a21-9277-e37fcb737af7",
                        "source_entry_id": "eaeff9a6-1cca-3bd8-8682-8e3af76d1de4",
                        "source_sense_id": "c10e9b15-983b-3764-b9e4-35c401defacd",
