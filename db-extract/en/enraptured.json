                    {
                        "translation_id": "1390a628-4797-4015-b15f-aebdf80559bd",
                        "source_entry_id": "6e82d2fc-14f8-30b4-b138-b2e6e29e883b",
                        "source_sense_id": "55f0b7d6-c670-35d7-a355-15fa3197eb79",
