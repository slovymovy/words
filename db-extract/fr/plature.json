                                    {
                                        "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                        "entry_id": "a1017224-f23f-3399-8701-e9b29361fe1f",
                                        "glosses": [
                                            "Shallow."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c99583b-112f-4c0b-8311-f9dcde7c9b2b",
                                                "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                                "text": "shoal water"
                                            },
                                            {
                                                "example_id": "4fae0ef4-c6ba-40a5-8d75-4e8f8b9102c3",
                                                "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                                "text": "But that part of the coast being shoal and bare, / And rough with reefs which ran out many a mile, / His port lay on the other side o' the isle."
                                            },
                                            {
                                                "example_id": "b8a4e46c-4f3f-485b-a25e-73e5ccddb591",
                                                "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                                "text": "All told, we had scarce two miles to run; but the navigation was delicate, the entrance to this northern anchorage was not only narrow and shoal, but lay east and west, so that the schooner must be nicely handled to be got in."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e39e736-7761-3b9a-afc0-f80ce737b239",
                                        "entry_id": "c3ed6d60-0bc8-3d2a-8f48-858cacb2794e",
                                        "glosses": [
                                            "A sandbank or sandbar creating a shallow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f718e96-4950-4be5-8c3c-a90c0346bbe1",
                                                "sense_id": "0e39e736-7761-3b9a-afc0-f80ce737b239",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            },
                                            {
                                                "example_id": "f7546fd2-22f1-48e1-a20d-d9b19518bef9",
                                                "sense_id": "0e39e736-7761-3b9a-afc0-f80ce737b239",
                                                "text": "The god himself with ready trident stands, / And opes the deep, and spreads the moving sands, / Then heaves them off the shoals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c12978cd-7113-3658-8cd1-59a02c7d7621",
                                        "entry_id": "c3ed6d60-0bc8-3d2a-8f48-858cacb2794e",
                                        "glosses": [
                                            "A shallow in a body of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c79feede-0824-440b-8adb-01edae3e9e67",
                                                "sense_id": "c12978cd-7113-3658-8cd1-59a02c7d7621",
                                                "text": "The depth of your pond should be six feet; and on the sides some shoals for the fish to sun themselves in and to lay their spawn."
                                            },
                                            {
                                                "example_id": "486ab3ba-eebe-42e8-a95c-2600a22c7f7e",
                                                "sense_id": "c12978cd-7113-3658-8cd1-59a02c7d7621",
                                                "text": "Wolsey, that once trod the ways of glory, / And sounded all the depths and shoals of honour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79de8ab5-3cb9-3964-be42-d349c6fecf2b",
