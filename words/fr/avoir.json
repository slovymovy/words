{
    "word_family": [
        "ravoir",
        "ayant-droit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3b1194e-c191-32e8-8173-1a4b76cbfb2f",
                    "sense_definition": "Être en possession de quelque chose, détenir un bien matériel ou abstrait.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>ai</w> une petite maison avec un grand jardin fleuri."
                        },
                        {
                            "text": "Nous <w>avons</w> beaucoup d'amis dans cette ville."
                        }
                    ],
                    "synonyms": [
                        "posséder"
                    ],
                    "common_phrases": [
                        "avoir le temps",
                        "avoir confiance",
                        "avoir raison"
                    ]
                },
                {
                    "sense_id": "aa720099-3654-3263-9db0-451c1e0fe7a3",
                    "sense_definition": "Auxiliaire employé avec le participe passé pour former les temps composés de la plupart des verbes.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hier soir, nous <w>avons</w> mangé dans un très bon restaurant."
                        },
                        {
                            "text": "Tu <w>as</w> déjà terminé ton travail pour demain matin."
                        }
                    ]
                },
                {
                    "sense_id": "6ec083a4-7d11-356f-a278-0e1193f61b66",
                    "sense_definition": "Ressentir une sensation physique, une émotion ou éprouver un besoin physiologique.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "etat_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants <w>ont</w> très faim après cette longue marche en montagne."
                        },
                        {
                            "text": "Mets ton manteau chaud si tu <w>as</w> froid dehors."
                        }
                    ],
                    "common_phrases": [
                        "avoir faim",
                        "avoir soif",
                        "avoir froid",
                        "avoir chaud",
                        "avoir peur"
                    ]
                },
                {
                    "sense_id": "faee1414-7dff-3ce5-b749-1e7af281d6b1",
                    "sense_definition": "Être âgé d'un certain nombre d'années.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma sœur <w>a</w> vingt ans depuis le mois dernier."
                        },
                        {
                            "text": "Quel âge <w>avez</w>-vous exactement, si ce n'est pas indiscret ?"
                        }
                    ],
                    "common_phrases": [
                        "avoir vingt ans"
                    ]
                },
                {
                    "sense_id": "78955c86-5f74-34a8-a0ca-e4e3908e7140",
                    "sense_definition": "Obtenir, parvenir à se procurer quelque chose.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle espère <w>avoir</w> une place pour ce concert exceptionnel."
                        },
                        {
                            "text": "Nous pouvons <w>avoir</w> ces billets à un tarif très avantageux."
                        }
                    ],
                    "common_phrases": [
                        "avoir la parole"
                    ]
                },
                {
                    "sense_id": "8de033d6-fdbc-3122-bc5a-76b15284238b",
                    "sense_definition": "Tromper, duper ou berner quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention aux arnaques sur internet pour ne pas te faire <w>avoir</w>."
                        },
                        {
                            "text": "Ce commerçant malhonnête m'a bien <w>eu</w> avec ce faux bijou."
                        }
                    ],
                    "common_phrases": [
                        "se faire avoir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langage familier"
                        }
                    ]
                },
                {
                    "sense_id": "14d1056a-da42-345a-a18f-a2b63a32d5db",
                    "sense_definition": "Être tenu de, devoir accomplir une action.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>ai</w> plusieurs dossiers urgents à relire avant demain midi."
                        },
                        {
                            "text": "Nous <w>avons</w> à prendre une décision cruciale pour notre avenir."
                        }
                    ],
                    "common_phrases": [
                        "avoir à faire"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f1d6f44-d2fd-347e-96b6-8c4c7b99c719",
                    "sense_definition": "Somme d'argent ou bon d'achat reconnu par un commerçant ou une banque au bénéfice d'un client.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance_credit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le magasin m'a remis un <w>avoir</w> valable pendant une durée de six mois."
                        },
                        {
                            "text": "Vous disposez d'un <w>avoir</w> de cinquante euros sur votre compte client."
                        }
                    ],
                    "synonyms": [
                        "note de crédit"
                    ],
                    "antonyms": [
                        "débit",
                        "doit"
                    ]
                },
                {
                    "sense_id": "22601ab2-7a90-38c9-a1e0-24ba28c876f4",
                    "sense_definition": "Ensemble des biens, richesses et capitaux appartenant à une personne ou une collectivité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "patrimoine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a ordonné le gel de tous les <w>avoirs</w> de cette entreprise suspecte."
                        },
                        {
                            "text": "Il a investi une grande part de son <w>avoir</w> dans des projets immobiliers."
                        }
                    ]
                },
                {
                    "sense_id": "c5644019-32e4-34b2-ba41-70015294fe16",
                    "sense_definition": "Fait ou désir de posséder des biens matériels, par opposition à l'existence et à la spiritualité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre société de consommation moderne privilégie trop souvent l'<w>avoir</w> au détriment de l'être."
                        },
                        {
                            "text": "Dans sa démarche philosophique, il cherchait à se détacher complètement de l'<w>avoir</w>."
                        }
                    ]
                }
            ]
        }
    ]
}