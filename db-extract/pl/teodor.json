                        "translation_id": "097a51d7-8847-489d-a916-67d55d189bb5",
                        "source_entry_id": "d64d3d30-5737-35d8-92d6-3f078304ff5e",
                        "source_sense_id": "0bce5eda-6548-3aa1-8bc6-2fc10bbac8d7",
