                    {
                        "sense_id": "c7d0e693-e4e4-3920-979f-85c3fe7f921a",
                        "entry_id": "91e94ac6-334f-3742-9b5f-2b2dbfd727bf",
                        "glosses": [
                            "Qui est tolérable, qu’on peut supporter,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c821e681-33bd-48e4-8ee2-9734970e028f",
                                "sense_id": "c7d0e693-e4e4-3920-979f-85c3fe7f921a",
                                "text": "Ces robes-sacs n'étaient supportables que sur de très jeunes, très minces et très jolies femmes qui, à Berlin comme ailleurs, n'étaient pas la majorité."
                            }
                        ]
                    },
                    {
                        "sense_id": "971d5d8a-ea09-3d01-a3ae-5ac409d1a947",
                        "entry_id": "91e94ac6-334f-3742-9b5f-2b2dbfd727bf",
                        "glosses": [
                            "Qui est excusable, qu’on peut tolérer, admettre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7233d72d-6e97-43bc-8e18-6a4c06e7f301",
                                "sense_id": "971d5d8a-ea09-3d01-a3ae-5ac409d1a947",
                                "text": "D’un jeune homme à un vieillard, un tel procédé n’est pas supportable."
                            },
                            {
                                "example_id": "45d3debf-fdaa-4504-b764-ebe5737b63c4",
                                "sense_id": "971d5d8a-ea09-3d01-a3ae-5ac409d1a947",
                                "text": "Cela n’est pas supportable pour un homme de son âge."
                            }
                        ]
                    }
                ],
