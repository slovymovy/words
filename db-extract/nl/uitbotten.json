        "nl-extract.jsonl": [
            {
                "entry_id": "d9e191b4-7816-3ea2-9417-309637f691a2",
                "word": "uitbotten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "25a5bfbf-7607-30c7-9012-27cdd1140986",
                        "entry_id": "d9e191b4-7816-3ea2-9417-309637f691a2",
                        "glosses": [
                            "weer beginnen te groeien van bomen en struiken na de winter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d834eeef-1b7c-4257-bedb-c51027915caa",
                                "sense_id": "25a5bfbf-7607-30c7-9012-27cdd1140986",
                                "text": "In een grote bak branden de kaarsjes. Op een standaard ligt de Bijbel, opengeslagen bij Lukas 21: „Hij vertelde hun een gelijkenis. Kijk naar de vijgenboom of naar een andere boom. Zodra u ze ziet uitbotten, weet u vanzelf dat de zomer in aantocht is.”"
                            },
                            {
                                "example_id": "6c6d541a-fc8f-426d-abde-4081ea8916af",
                                "sense_id": "25a5bfbf-7607-30c7-9012-27cdd1140986",
                                "text": "Natuurliefhebbers bloeien op nu allerlei bloemen en planten gaan uitbotten."
                            }
                        ]
                    },
                    {
                        "sense_id": "67b758bf-4332-376b-80ce-d921c2109434",
                        "entry_id": "d9e191b4-7816-3ea2-9417-309637f691a2",
                        "glosses": [
                            "volwassen worden; tot bloei komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3e21ce-598c-4870-b9cd-970eb00ab7f5",
                                "sense_id": "67b758bf-4332-376b-80ce-d921c2109434",
                                "text": "Die strip is een commercieel succes, en daar doet gemor onder traditionele liefhebbers niet aan af. Striphistoricus Hans Matla zei toentertijd dat Willy Vandersteen zich in zijn graf zou omdraaien. Voor iedereen die nu treurt om de veranderingen is er één troost: zelfs nu Wiske uitbot tot jonge vrouw zwaait ze nog met haar lappenpop Schanulleke."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dda84f9-624d-4c7f-bfb8-1e83618cc967",
                        "source_entry_id": "d9e191b4-7816-3ea2-9417-309637f691a2",
                        "source_sense_id": "25a5bfbf-7607-30c7-9012-27cdd1140986",
                        "target_lang_word": "bud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19c22244-64ed-3c2e-803b-aacd8dfbbc9f",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "A newly sprouted leaf or blossom that has not yet unfolded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62483fd7-b93a-49a7-823e-cd11e7f6e66b",
                                                "sense_id": "19c22244-64ed-3c2e-803b-aacd8dfbbc9f",
                                                "text": "After a long, cold winter, the trees finally began to produce buds."
                                            },
                                            {
                                                "example_id": "bf57a552-6837-4eb9-807a-8a464845d9e3",
                                                "sense_id": "19c22244-64ed-3c2e-803b-aacd8dfbbc9f",
                                                "text": "Among Turks, pills consisting of hemp buds, muscat nuts, saffron, and honey were a popular aphrodisiac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b895860-7d59-359b-ad58-1d4d486b96bf",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "Something that has begun to develop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c79b33-51b3-4bfc-93f1-fa51a4dee4c3",
                                                "sense_id": "1b895860-7d59-359b-ad58-1d4d486b96bf",
                                                "text": "breast buds"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34fe358-5439-300d-96b0-a39783f6c109",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "A small rounded body in the process of splitting from an organism, which may grow into a genetically identical new organism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7d12c7-6996-48bd-850d-6ad2a9b9b64e",
                                                "sense_id": "f34fe358-5439-300d-96b0-a39783f6c109",
                                                "text": "In this slide, you can see a yeast cell forming buds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96db38b-1e6b-3ba6-8a8f-419d4b4968db",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "Potent cannabis taken from the flowering part of the plant (the \\\"bud\\\"), or marijuana generally.",
                                            "Cannabis that has been taken from the flowering part of the plant intended to be smoked."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "countable",
                                            "plural-normally",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa2cef03-ab67-438b-8b80-74a183ed9f21",
                                                "sense_id": "c96db38b-1e6b-3ba6-8a8f-419d4b4968db",
                                                "text": "You got any buds?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa03f54a-b487-38f9-90b4-3df07317ac0f",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "Potent cannabis taken from the flowering part of the plant (the \\\"bud\\\"), or marijuana generally.",
                                            "Marijuana."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9c5e3d-dcfb-4a1b-a37e-c8d026ec0e16",
                                                "sense_id": "fa03f54a-b487-38f9-90b4-3df07317ac0f",
                                                "text": "Hey bro, want to smoke some bud?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb28fd90-a822-3ee9-b646-1e69fa306609",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "A weaned calf in its first year, so called because the horns are then beginning to bud."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "991f35f6-ecf2-34b3-8a24-9a13cdff6945",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "A pretty young girl."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4acee86-f127-46fe-9c49-9087c98f8671",
                                                "sense_id": "991f35f6-ecf2-34b3-8a24-9a13cdff6945",
                                                "text": "My pretty bud was unfolding and I was not there to see it. She was developing so rapidly, I felt I could not be from her a day without missing some sweetness that could never come again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6648309-031c-3386-bb33-ec184302fc1e",
                                        "entry_id": "52023157-8dc6-3557-abbf-85b15124482d",
                                        "glosses": [
                                            "To form buds."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274cb2da-988f-4713-92d1-f5745c901a7b",
                                                "sense_id": "f6648309-031c-3386-bb33-ec184302fc1e",
                                                "text": "The trees are finally starting to bud."
                                            },
                                            {
                                                "example_id": "ed196f31-40cd-4622-89c0-b2c2d642927e",
                                                "sense_id": "f6648309-031c-3386-bb33-ec184302fc1e",
                                                "text": "And it came to pass, that on the morrow Moses went into the tabernacle of witness; and, behold, the rod of Aaron for the house of Levi was budded, and brought forth buds, and bloomed blossoms, and yielded almonds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0088f724-6faa-3691-b2bb-f4c66097df84",
                                        "entry_id": "52023157-8dc6-3557-abbf-85b15124482d",
                                        "glosses": [
                                            "To reproduce by splitting off buds."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7c94428-fe67-4701-a109-8de1a260a07c",
                                                "sense_id": "0088f724-6faa-3691-b2bb-f4c66097df84",
                                                "text": "Yeast reproduces by budding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06a922f8-79cc-370b-9dc0-a808ca74b62d",
                                        "entry_id": "52023157-8dc6-3557-abbf-85b15124482d",
                                        "glosses": [
                                            "To begin to grow, or to issue from a stock in the manner of a bud, as a horn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd830c4-1d01-41a9-a43c-c1a64725a366",
                                                "sense_id": "06a922f8-79cc-370b-9dc0-a808ca74b62d",
                                                "text": "Seeds of dissent were budding among the recruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a61fbf32-a44c-3ac1-bb55-278e06cda76c",
                                        "entry_id": "52023157-8dc6-3557-abbf-85b15124482d",
                                        "glosses": [
                                            "To be like a bud in respect to youth and freshness, or growth and promise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e3823dd-977b-45fe-97e1-996d6f7f78fc",
                                                "sense_id": "a61fbf32-a44c-3ac1-bb55-278e06cda76c",
                                                "text": "Young budding virgin, fair and fresh and sweet, / Whither away, or where is thy abode?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0ec7ea-5369-38c7-970c-0e5f1de1b733",
                                        "entry_id": "52023157-8dc6-3557-abbf-85b15124482d",
                                        "glosses": [
                                            "To put forth as a bud."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e222c09-7b76-4d83-9d24-77681ca54b8d",
                                                "sense_id": "aa0ec7ea-5369-38c7-970c-0e5f1de1b733",
                                                "text": "What appeared the same to us really wasn't. Every day was different, if we looked closely enough. Like the topiary tree that finally budded a rose after Terrence died: […]"
                                            },
                                            {
                                                "example_id": "26fe502b-8360-4cb0-af72-5b20f2531e35",
                                                "sense_id": "aa0ec7ea-5369-38c7-970c-0e5f1de1b733",
                                                "text": "Once, he was put on a course of potent hormone pills, coming off them when he woke up one morning to discover he was budding breasts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040f682a-6631-3988-9c5b-db437c967f58",
                                        "entry_id": "52023157-8dc6-3557-abbf-85b15124482d",
