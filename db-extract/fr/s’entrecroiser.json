                        "sense_id": "d4cac755-b4b4-313c-8154-ed4e9edfa6ec",
                        "entry_id": "7388de1f-2e85-3102-b85e-31a25ef241d0",
                        "glosses": [
                            "Se croiser l’un l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3033e5-9342-4f9a-9b0b-c6608b01211f",
                                "sense_id": "d4cac755-b4b4-313c-8154-ed4e9edfa6ec",
                                "text": "On eût dit les morceaux d’un arc-en-ciel brisé par une main puissante, et qui s’entrecroisaient sur le sol."
                            },
                            {
                                "example_id": "069058e6-e51d-463c-81f7-cd5b9acd34d1",
                                "sense_id": "d4cac755-b4b4-313c-8154-ed4e9edfa6ec",
                                "text": "Proches de la vague, ils la tangentent, la déchirent légèrement et remontent décrire à nouveau leurs cercles qui s’entrecroisent."
                            }
                        ]
                    }
