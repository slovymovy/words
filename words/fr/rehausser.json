            "senses": [
                {
                    "sense_id": "3be0e4a4-502a-37a1-be08-72daf903ee62",
                    "sense_definition": "Rendre plus haut ou placer à une plus grande hauteur dans l'espace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers doivent <w>rehausser</w> le mur du jardin pour préserver notre intimité."
                        },
                        {
                            "text": "Il a fallu <w>rehausser</w> la table pour que les enfants puissent s'asseoir confortablement."
                        }
                    ],
                    "synonyms": [
                        "surélever",
                        "élever",
                        "hausser"
                    ],
                    "antonyms": [
                        "abaisser"
                    ],
                    "common_phrases": [
