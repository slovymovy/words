                "senses": [
                    {
                        "sense_id": "87d8e792-fb7a-3a49-a66d-f10e84471be7",
                        "entry_id": "f01c0268-f055-3c8b-9c1d-3d59c7d96269",
                        "glosses": [
                            "Rendre casher, ou rendre propre à une utilisation casher (quelque chose qui a servi de façon non casher)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b76f6f-d8fe-4382-adcb-73d5ac5393f6",
                                "sense_id": "87d8e792-fb7a-3a49-a66d-f10e84471be7",
                                "text": "Est-il possible de cachériser une vaisselle de porcelaine ancienne ?"
                            },
                            {
                                "example_id": "9e3681df-2c7f-4acd-b342-61d8fdca6e02",
                                "sense_id": "87d8e792-fb7a-3a49-a66d-f10e84471be7",
                                "text": "Pour cachériser un four pyrolyse, il faudra le mettre en marche un peu plus d'une heure et bien le nettoyer."
                            },
                            {
                                "example_id": "41e3f810-7828-463b-b362-090b893f58f5",
                                "sense_id": "87d8e792-fb7a-3a49-a66d-f10e84471be7",
                                "text": "Nous avons décidés de manger cacher. Est-ce que vous pouvez m'aider à cachériser ma maison ?"
                            }
                        ]
                    }
