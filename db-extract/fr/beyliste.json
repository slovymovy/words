                ],
                "senses": [
                    {
                        "sense_id": "58a15f4e-892a-3450-a6eb-8a2c28899df6",
                        "entry_id": "c0073053-6bec-3f05-bc00-bc31053c45f2",
                        "glosses": [
                            "Celui, celle qui se conforme aux principes de Stendhal ou du héros stendhalien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041abfe3-60d9-4a25-9663-184a68a0731a",
                                "sense_id": "58a15f4e-892a-3450-a6eb-8a2c28899df6",
                                "text": "La période de l’Empire permit au beyliste de mettre à l’épreuve ses maximes et sa politique."
                            },
                            {
                                "example_id": "b29fe48b-de25-45de-8011-65b45a18788b",
                                "sense_id": "58a15f4e-892a-3450-a6eb-8a2c28899df6",
                                "text": "Il reste que cet appel à l’émotion vécue expose le beyliste aux faiblesses de la sensibilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d43fd41-c110-3de3-95e6-38ebdde6a72a",
                        "entry_id": "c0073053-6bec-3f05-bc00-bc31053c45f2",
                        "glosses": [
                            "Spécialiste de Stendhal et de son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c3588bf-7bd1-4ddc-8ee1-166f6d928e2c",
                                "sense_id": "4d43fd41-c110-3de3-95e6-38ebdde6a72a",
                                "text": "Ah ! me suis-je dit, qu’il faut le louer et l’encourager, cet acharné beyliste, ce Casimir Stryienski ! Quelle reconnaissance déjà nous lui devons avoir !"
                            },
                            {
                                "example_id": "5506d1cf-0089-482b-bba3-b4b16bac4e4b",
                                "sense_id": "4d43fd41-c110-3de3-95e6-38ebdde6a72a",
                                "text": "De ce postulat, Philippe Berthier, grand beyliste, universitaire et orateur hors pair (ses élèves en savent quelque chose), a composé une biographie où l’amour des femmes et de la musique lyrique occupe le devant de la scène, cour et jardin."
                            }
                        ]
                    }
                ],
