                        "glosses": [
                            "Trappe donnant accès à un grenier ou à une cave."
                        ],
                        "tags": [
                            "Dauphiné",
                            "Franche-Comté",
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "b2946189-0e25-40fd-91ab-6b9aab31d9cf",
                                "sense_id": "bc7adfd9-ae67-3de9-9c34-75a54d0c9d64",
                                "text": "… à la suite de la porte d'entrée est un trapon de cave avec une rampe en pierre servant à l'encavage …"
                            },
                            {
                                "example_id": "5cdc2966-e340-46a9-b12a-13391f987090",
                                "sense_id": "bc7adfd9-ae67-3de9-9c34-75a54d0c9d64",
                                "text": "Et maintenant, pour monter au grenier, je me retrouve avec un trapon , pas grand de reste, au plafond de la salle d'eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc7f7168-5ff2-368d-be2d-a9c9d7148f9e",
                        "entry_id": "f5f750a9-b56a-3a3d-a8b9-b4588ad2ec2a",
                        "glosses": [
                            "Pièce qui ferme le bout de deux banches parallèles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e0a353-ecec-48e3-8ede-dbb132da2490",
                                "sense_id": "bc7f7168-5ff2-368d-be2d-a9c9d7148f9e",
                                "text": "Quand on commence un mur, ou quand un des côtés du moule doit être perpendiculaire, on le ferme avec un closoir ou trapon, qui est une planche formée comme les banches qu'on assujettit au reste du moule avec un ou deux sergens de menuisier."
                            }
                        ]
                    }
