                        "glosses": [
                            "Lying or resting on something else; overlying."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15d7d31-c7c6-4ff4-8f49-15d452ee94f2",
                                "sense_id": "68e23be1-faa7-33a1-a6e4-cc5e7b8f103f",
                                "text": "As the vapour cooled the water would be precipitated, and an ocean would surround the spherical nucleus with a superincumbent atmosphere."
                            },
                            {
                                "example_id": "392e8cf8-3c63-4ce2-b324-83875260dddd",
                                "sense_id": "68e23be1-faa7-33a1-a6e4-cc5e7b8f103f",
                                "text": "[…] alas, on the contrary, what troops and populations of Phantasms, not God-Veracities but Devil-Falsities, down to the very lowest stratum, — which now, by such superincumbent weight of Unveracities, lies enchanted in St. Ives’ Workhouses, broad enough, helpless enough!"
                            },
                            {
                                "example_id": "733369eb-e157-4201-9cd2-9517b98f9b01",
                                "sense_id": "68e23be1-faa7-33a1-a6e4-cc5e7b8f103f",
                                "text": "Then a superincumbent bundle rolled down, with a whisking noise, flames elongated, and bent themselves about with a quiet roar, but no crackle."
                            },
                            {
                                "example_id": "cf7261ea-0cb8-45e8-92cd-5b4da9dfe653",
                                "sense_id": "68e23be1-faa7-33a1-a6e4-cc5e7b8f103f",
                                "text": "The older Verrucano must have travelled to its present position as it slid and ground its way on the back of the oppressed Lochseiten limestone, which buckled and churned under the superincumbent load."
                            }
                        ]
                    }
