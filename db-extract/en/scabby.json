                "senses": [
                    {
                        "sense_id": "e862e014-4188-31d4-a254-3a0d8dc8b519",
                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                        "glosses": [
                            "Affected with scabs; full of scabs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c687e8ff-c32b-4b79-b24f-9fec1dbcbfa2",
                                "sense_id": "e862e014-4188-31d4-a254-3a0d8dc8b519",
                                "text": "Her wrizled skin, as rough as maple rind,\nSo scabby was, that would have loath'd all womankind."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c3bcdb0-7562-31b2-9b4b-725bccc3d8f5",
                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                        "glosses": [
                            "Diseased with the scab (mange): mangy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d646372c-c496-3105-8554-7521d6fb25c5",
                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                        "glosses": [
                            "Having a blotched, uneven appearance."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "20eaa06f-e7ca-3427-9953-76757813cd2e",
                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                        "glosses": [
                            "Injured by the attachment of barnacles to the carapace of a shell."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                        "glosses": [
                            "Working against union policies, working to bust unions; in particular, being a scab (worker who crosses a union picket line)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d57727d-43f0-41ef-a274-6365e3660dd2",
                                "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                                "text": "The police, the governor, and the \"scabby\" Hearst Examiner \"received a tremendous razzing,\" according to the Waterfront Worker, while all along the line of march \"the workers on the sidelines cheered[…]\""
                            },
                            {
                                "example_id": "18afe15a-610d-4778-b7d0-ac272237f87e",
                                "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                                "text": "[They're a] scabby right-to-work company and they don't care how much the sharp edges on that dust screw up a guy's lungs."
                            },
                            {
                                "example_id": "0cffd8e6-e152-4909-b21b-27b88e7fc5de",
                                "sense_id": "1a0d276e-34ab-36e6-b88f-634f61459d3b",
                                "text": "Hoochie's dad said, “All eight drivers are former 'scabby' employees who couldn't get hired by any reputable union trucking companies.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                        "entry_id": "9c20444e-ed5b-3e49-b329-25449c14609e",
                        "glosses": [
                            "Stingy; scrounging."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ba3270ce-ca53-41d7-b86e-f7ebfc9c4bbf",
                                "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                                "text": "The chipper was a bit scabby on the vinegar today."
                            },
                            {
                                "example_id": "ca27037e-9f43-4850-9ee3-2b5cd0ec9e3e",
                                "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                                "text": "I lent you a fiver last week and you still haven’t paid me back, you scabby bastard!"
                            },
                            {
                                "example_id": "430d1b25-6fd9-4b85-8027-edee85e60a11",
                                "sense_id": "66a90eb8-5072-3434-b90d-cb6f3a757ae4",
                                "text": "You never bring you’re own pen but always ask to borrow mine, you scabby git!"
                            }
                        ]
                    }
                ],
