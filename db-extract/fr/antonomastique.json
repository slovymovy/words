                        "entry_id": "2dc80b19-b5fa-34d4-956d-1a57409d975e",
                        "glosses": [
                            "Relatif à l’antonomase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "456b18df-331b-4e8d-aead-190837a33c59",
                                "sense_id": "b3ef31af-bac0-32a1-a743-6d770297a596",
                                "text": "Un procédé antonomastique."
                            },
                            {
                                "example_id": "e2727041-09e1-482f-8d26-41fefbe48bc8",
                                "sense_id": "b3ef31af-bac0-32a1-a743-6d770297a596",
                                "text": "Les vocables qui ont comme origine un inventeur ou un initiateur sont à classer parmi les néologismes antonomastiques."
                            },
                            {
                                "example_id": "2ec12ad2-ac7a-4dab-926c-7e796bc7c8d4",
                                "sense_id": "b3ef31af-bac0-32a1-a743-6d770297a596",
                                "text": "La répétition est en effet une caractéristique marquée des chahuts parlementaires autour des fraudes. Ce sont les cris traditionnels de « tricheurs ! » et « magouilleurs ! », comme les « insultes antonomastiques » - « Tiberi ! », « Chirac ! », « Paris ! » - scandées à plusieurs reprises lors d’une même séance, mais aussi lors de plusieurs séances sur une même période."
                            }
                        ]
                    }
