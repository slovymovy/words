                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собраться",
                                "target_lang_sense_clarification": "сойтись воедино, сосредоточиться в одном месте"
                            }
                        ]
                    }
                }
            ]
        }
