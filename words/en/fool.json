{
    "word_family": [
        "foolish",
        "foolishness",
        "foolery",
        "befool"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93ee616d-9962-393f-bd26-7e2274b1b40c",
                    "sense_definition": "A person with poor judgment or little intelligence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_stupidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>fool</w> and listen to what I say.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>дураком</w> и послушай, что я говорю.",
                                "zh": "别那么<w>傻</w>，听我说。"
                            }
                        },
                        {
                            "text": "He felt like a complete <w>fool</w> after realizing his mistake.",
                            "target_lang_translations": {
                                "ru": "Осознав свою ошибку, он почувствовал себя полным <w>идиотом</w>.",
                                "zh": "意识到自己的错误后，他觉得自己像个彻头彻尾的<w>笨蛋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "imbecile",
                        "dunce",
                        "simpleton",
                        "blockhead"
                    ],
                    "antonyms": [
                        "sage"
                    ],
                    "common_phrases": [
                        "act like a fool",
                        "make a fool of",
                        "play the fool",
                        "no fool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с плохим суждением или низким интеллектом; глупец.",
                        "zh": "指判断力差或智力低下的人；傻瓜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "общее название для глупого человека"
                            },
                            {
                                "target_lang_word": "глупец",
                                "target_lang_sense_clarification": "более книжный вариант"
                            },
                            {
                                "target_lang_word": "идиот",
                                "target_lang_sense_clarification": "разговорное, часто оскорбительное"
                            },
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "бестолковый человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "指愚蠢的人，常用词"
                            },
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "指愚笨的人，口语常用"
                            },
                            {
                                "target_lang_word": "蠢货",
                                "target_lang_sense_clarification": "指愚蠢的人，带有贬义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25b5eeed-96b2-33fa-8440-e51a65f897d0",
                    "sense_definition": "Someone who has been made a fool of or tricked.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_stupidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will not be made a <w>fool</w> of by your lies.",
                            "target_lang_translations": {
                                "ru": "Я не позволю выставить себя <w>дураком</w> из-за твоей лжи.",
                                "zh": "我不会被你的谎言<w>愚弄</w>。"
                            }
                        },
                        {
                            "text": "He was just a <w>fool</w> in their elaborate scheme to steal the money.",
                            "target_lang_translations": {
                                "ru": "Он был всего лишь <w>пешкой</w> в их хитроумном плане кражи денег.",
                                "zh": "在他们窃取钱财的周密计划中，他不过是个<w>受骗者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dupe",
                        "victim",
                        "sucker"
                    ],
                    "common_phrases": [
                        "take for a fool",
                        "make a fool of someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кого обманули, одурачили или выставили в глупом свете.",
                        "zh": "被欺骗或被戏弄的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "в значении одураченного человека"
                            },
                            {
                                "target_lang_word": "простофиля",
                                "target_lang_sense_clarification": "наивный, легко обманываемый человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受骗者",
                                "target_lang_sense_clarification": "指被欺骗的人"
                            },
                            {
                                "target_lang_word": "冤大头",
                                "target_lang_sense_clarification": "指容易上当受骗的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "803924b6-6ead-315f-b2df-ef5afb08357c",
                    "sense_definition": "A jester; a person whose role was to entertain a sovereign and the court.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_entertainer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king laughed heartily at the jokes of his court <w>fool</w>.",
                            "target_lang_translations": {
                                "ru": "Король от души смеялся над шутками своего придворного <w>шута</w>.",
                                "zh": "国王被他宫廷<w>弄臣</w>的笑话逗得开怀大笑。"
                            }
                        },
                        {
                            "text": "In medieval times, a <w>fool</w> could often speak the truth when others could not.",
                            "target_lang_translations": {
                                "ru": "В Средние века <w>шут</w> часто мог говорить правду, когда другие не могли.",
                                "zh": "在中世纪，当别人不敢说真话时，<w>弄臣</w>往往能说出真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jester",
                        "clown",
                        "buffoon"
                    ],
                    "common_phrases": [
                        "court fool"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to a historical role"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шут; человек, чья роль заключалась в развлечении правителя и двора.",
                        "zh": "小丑；古代宫廷中负责娱乐君主和朝臣的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шут",
                                "target_lang_sense_clarification": "придворный комик"
                            },
                            {
                                "target_lang_word": "скоморох",
                                "target_lang_sense_clarification": "исторический странствующий актер на Руси"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄臣",
                                "target_lang_sense_clarification": "指古代宫廷中供君主取乐的臣子"
                            },
                            {
                                "target_lang_word": "小丑",
                                "target_lang_sense_clarification": "指表演滑稽戏的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca0a445d-442e-3fc6-a28b-79ac2eae6c35",
                    "sense_definition": "Someone who derives pleasure from something specified.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_enthusiast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a <w>fool</w> for romantic comedies and watch them every weekend.",
                            "target_lang_translations": {
                                "ru": "Я <w>фанат</w> романтических комедий и смотрю их каждые выходные.",
                                "zh": "我是浪漫喜剧的<w>迷</w>，每个周末都会看。"
                            }
                        },
                        {
                            "text": "She admits she is a <w>fool</w> for old cars and buys every one she sees.",
                            "target_lang_translations": {
                                "ru": "Она признает, что <w>неравнодушна</w> к старым автомобилям и покупает каждый, который видит.",
                                "zh": "她承认自己对老式汽车非常<w>着迷</w>，见到一辆就买一辆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fan"
                    ],
                    "common_phrases": [
                        "fool for love",
                        "fool for something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, питающий большую слабость или страсть к чему-либо.",
                        "zh": "对某事物有极大热情或偏爱的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любитель",
                                "target_lang_sense_clarification": "человек, увлекающийся чем-либо"
                            },
                            {
                                "target_lang_word": "фанат",
                                "target_lang_sense_clarification": "страстный поклонник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迷",
                                "target_lang_sense_clarification": "指对某事物极其热爱的人"
                            },
                            {
                                "target_lang_word": "狂热爱好者",
                                "target_lang_sense_clarification": "指对某事物非常着迷的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfba47ac-8301-39a5-a229-f80cae01349b",
                    "sense_definition": "A particular card in a tarot deck, representing a jester.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_tarot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fool</w> represents new beginnings and potential in the tarot deck.",
                            "target_lang_translations": {
                                "ru": "<w>Шут</w> в колоде Таро олицетворяет новые начинания и потенциал.",
                                "zh": "在塔罗牌中，<w>愚者</w>代表新的开始和潜力。"
                            }
                        },
                        {
                            "text": "He drew the <w>fool</w> card during the reading, which surprised the fortune teller.",
                            "target_lang_translations": {
                                "ru": "Во время гадания он вытянул карту <w>Шут</w>, что удивило гадалку.",
                                "zh": "他在占卜时抽到了<w>愚者</w>牌，这让占卜师感到惊讶。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "The Fool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особая карта в колоде Таро, изображающая шута.",
                        "zh": "塔罗牌中的一张牌，象征小丑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шут",
                                "target_lang_sense_clarification": "название карты Таро"
                            },
                            {
                                "target_lang_word": "Дурак",
                                "target_lang_sense_clarification": "альтернативное название карты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "愚者",
                                "target_lang_sense_clarification": "塔罗牌中该牌的标准译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37a79a02-b11b-3a1e-a543-fd0c95bac287",
                    "sense_definition": "A type of dessert made of puréed fruit and custard or cream.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dessert, we served a traditional gooseberry <w>fool</w> with biscuits.",
                            "target_lang_translations": {
                                "ru": "На десерт мы подали традиционный крыжовенный <w>фул</w> с печеньем.",
                                "zh": "作为甜点，我们供应了传统的醋栗<w>水果奶油甜点</w>和饼干。"
                            }
                        },
                        {
                            "text": "She made a delicious raspberry <w>fool</w> using fresh cream and fruit from the garden.",
                            "target_lang_translations": {
                                "ru": "Она приготовила вкусный малиновый <w>десерт</w> из свежих сливок и фруктов из сада.",
                                "zh": "她用新鲜奶油和花园里的水果制作了一道美味的覆盆子<w>水果奶油甜点</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gooseberry fool",
                        "fruit fool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Десерт из протертых фруктов и заварного крема или сливок.",
                        "zh": "一种由水果泥和奶油或蛋奶糊制成的甜点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фул",
                                "target_lang_sense_clarification": "название десерта (транслитерация)"
                            },
                            {
                                "target_lang_word": "фруктовый крем",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水果奶油甜点",
                                "target_lang_sense_clarification": "描述性翻译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f5fa970-8173-39c7-aa17-f34ec9a9d3a6",
                    "sense_definition": "An informal greeting akin to buddy, dude, or man.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>fool</w>, are you coming to the party tonight or what?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>чувак</w>, ты идешь сегодня на вечеринку или как?",
                                "zh": "嘿<w>伙计</w>，你今晚来参加派对吗？"
                            }
                        },
                        {
                            "text": "What's up <w>fool</w>, I haven't seen you in ages.",
                            "target_lang_translations": {
                                "ru": "Как дела, <w>братан</w>, сто лет тебя не видел.",
                                "zh": "怎么了<w>哥们</w>，好久不见。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "what up fool"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное приветствие или обращение, похожее на «приятель» или «чувак».",
                        "zh": "非正式的称呼，类似于“伙计”或“哥们”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувак",
                                "target_lang_sense_clarification": "сленговое обращение"
                            },
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "дружеское обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伙计",
                                "target_lang_sense_clarification": "非正式的称呼"
                            },
                            {
                                "target_lang_word": "哥们",
                                "target_lang_sense_clarification": "口语中对朋友的称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7804c8cb-1b7a-3b18-bcf1-52de1851d53d",
                    "sense_definition": "To trick; to deceive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You cannot <w>fool</w> me with that disguise; I know who you are.",
                            "target_lang_translations": {
                                "ru": "Тебе не <w>одурачить</w> меня этой маскировкой; я знаю, кто ты.",
                                "zh": "你那身伪装可<w>骗</w>不了我，我知道你是谁。"
                            }
                        },
                        {
                            "text": "Don't be <w>fooled</w> by the low price, because the quality is actually very poor.",
                            "target_lang_translations": {
                                "ru": "Не дай себя <w>обмануть</w> низкой ценой, потому что качество на самом деле очень плохое.",
                                "zh": "别被低价<w>欺骗</w>了，因为质量其实很差。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "deceive",
                        "mislead",
                        "dupe",
                        "cheat",
                        "con"
                    ],
                    "common_phrases": [
                        "fool someone",
                        "be fooled by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать; вводить в заблуждение.",
                        "zh": "欺骗；误导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурачить",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            },
                            {
                                "target_lang_word": "одурачить",
                                "target_lang_sense_clarification": "обмануть, оставить в дураках"
                            },
                            {
                                "target_lang_word": "надувать",
                                "target_lang_sense_clarification": "разг. обманывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欺骗",
                                "target_lang_sense_clarification": "指用谎言或手段使人上当"
                            },
                            {
                                "target_lang_word": "愚弄",
                                "target_lang_sense_clarification": "指戏弄或欺骗他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23557d14-a923-33d3-b0a2-50519c4ca380",
                    "sense_definition": "To act in an idiotic manner; to act foolishly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>fooling</w> around and finish your homework before dinner.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>дурачиться</w> и закончи домашнюю работу до ужина.",
                                "zh": "别再<w>胡闹</w>了，晚饭前把作业写完。"
                            }
                        },
                        {
                            "text": "He likes to <w>fool</w> around in class instead of listening to the teacher.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>валять дурака</w> на уроках вместо того, чтобы слушать учителя.",
                                "zh": "他喜欢在课堂上<w>瞎搞</w>，而不是听老师讲课。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mess around",
                        "play around"
                    ],
                    "common_phrases": [
                        "fool around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя глупо; дурачиться.",
                        "zh": "行为愚蠢；胡闹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурачиться",
                                "target_lang_sense_clarification": "вести себя несерьезно"
                            },
                            {
                                "target_lang_word": "валять дурака",
                                "target_lang_sense_clarification": "фразеологизм: бездельничать или паясничать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胡闹",
                                "target_lang_sense_clarification": "指行为不负责任或荒唐"
                            },
                            {
                                "target_lang_word": "瞎搞",
                                "target_lang_sense_clarification": "指不认真地做事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24d51c41-3048-3994-9021-32d7ce00dadf",
                    "sense_definition": "Foolish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_stupidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <w>fool</w> mistake to make when you knew the risks.",
                            "target_lang_translations": {
                                "ru": "Это была <w>глупая</w> ошибка, учитывая, что ты знал о рисках.",
                                "zh": "既然你知道风险，犯下那样的错误真是太<w>愚蠢</w>了。"
                            }
                        },
                        {
                            "text": "He went on a <w>fool</w> errand to find a store that doesn't exist.",
                            "target_lang_translations": {
                                "ru": "Он отправился на <w>бессмысленные поиски</w> магазина, которого не существует.",
                                "zh": "他去寻找一家根本不存在的商店，真是<w>荒唐</w>的差事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foolish",
                        "silly",
                        "stupid"
                    ],
                    "common_phrases": [
                        "fool thing",
                        "fool errand"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
