                "senses": [
                    {
                        "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                        "entry_id": "56832ea2-b85c-362d-b874-5385538375f8",
                        "glosses": [
                            "Person, die am meisten von etwas (meist Negativem) betroffen oder in Mitleidenschaft gezogen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7e2bee-86f8-4714-b030-d8add28d915d",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "Die Hauptbetroffenen durch die Belästigung durch Fluglärm sind die Anwohner in der Einflugschneise."
                            },
                            {
                                "example_id": "9f3497ad-4bd0-4882-b45e-09b4cf4f2f61",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "[Isralischer Krieg im Gazastreifen 2023 - 2025:] „Die Zivilbevölkerung in Gaza hungert. Hauptbetroffene sind Kinder.“"
                            },
                            {
                                "example_id": "e53873e7-74d0-47a4-a568-11cf26498497",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "[Kriegsgewalt infolge des russischen Angriffskriegs auf die Ukraine 2022:] „Diese Form von Gewalt umfasst Vergewaltigungen und andere sexuelle Übergriffe wie unerwünschtes Anfassen, Zwangsprostitution und Menschenhandel. Frauen und Mädchen sind die Hauptbetroffenen, jedoch können auch queere Menschen, nicht-binäre und trans Personen sowie Männer und Jungen Opfer sein.“"
                            },
                            {
                                "example_id": "9c192378-de58-49e6-9625-0a19b822851f",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "[Schwimmbäder in Berlin:] „Hauptbetroffene der Schließung sind Frauen mit kleinen Kindern, aus Neukölln, mit Migrationshintergrund, die nicht verreisen oder mal eben mit dem SUV an einen See fahren können.“"
                            },
                            {
                                "example_id": "19c3c39d-2649-40c9-acbc-c667be3ad0c2",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "„Hauptbetroffene dieses Umsiedlungsgesetzes waren die fünf zivilisierten Stämme im Süden – die Cherokee, Creek, Chickasaw, Choctaw und Seminole.“"
                            },
                            {
                                "example_id": "47026328-997c-418f-92c0-57322111911a",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "[Nach einer Todesnachricht:] „Unterstützung von anderen Angehörigen gibt dem Hauptbetroffenen die Möglichkeit, seine eigenen Gefühle zu kontrollieren […].“"
                            },
                            {
                                "example_id": "4846b32e-2e68-4a57-b852-39a9b1ad4e45",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "„»Durch die örtlich massiven Überschwemmungen ist das Gras teilweise so verschmutzt, dass man es nur noch in die Biogasanlage kippen kann«. In diesem Fall [sind] die Landwirte im östlichen Bereich des Landkreises die Hauptbetroffenen, da dort das Hochwasser am schlimmsten gewütet [hat].“"
                            },
                            {
                                "example_id": "18850758-725b-448a-b989-0942fe049d92",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "„Unabhängig von der Ideologie gleichen sich die Methoden staatlicher Repression. […] Hauptbetroffene sind in der Regel Intellektuelle, besonders schriftstellerisch und journalistisch tätige Personen sowie Rechtsanwälte, gewerkschaftlich und in Menschenrechtsorganisationen Aktive, aber auch Angehörige religiöser und ethnischer Minderheiten.“"
                            },
                            {
                                "example_id": "729a9372-1929-4b85-b52d-6e3444317cfa",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "„Hauptbetroffene der Geldentwertung waren Festbesoldete, die ihre Einkommen in den von den Fürsten und Städten verschlechterten Münzsorten erhielten, während die Erzeuger landwirtschaftlicher und gewerblicher Produkte eine Bezahlung in harter Währung verlangen konnten.“"
                            },
                            {
                                "example_id": "afa1e6e1-a729-4292-bee7-8d9e85830e33",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "„Klimaschützer weisen schon seit langem darauf hin, dass Afrika zu den Hauptbetroffenen des Klimawandels gehört, obwohl es nur zu einem geringen Teil zu der gefährlichen Erderwärmung beigetragen hat.“"
                            },
                            {
                                "example_id": "713075fd-ce83-46fe-8084-c250c004cdd5",
                                "sense_id": "df439bb1-5f0e-3980-80d5-49f35f296a6f",
                                "text": "[Zollpolitik des amerikanischen Präsidenten D. Trump 2025:] „Stefan Bruckbauer, Chefökonom der Bank Austria, sieht vor allem die Steiermark und Oberösterreich als Hauptbetroffene […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
