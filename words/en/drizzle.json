{
    "word_family": [
        "drizzly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94f4dc66-f573-320d-ad7d-5f13642e39b0",
                    "sense_definition": "Light rain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to cancel our walk because of the persistent <w>drizzle</w>.",
                            "target_lang_translations": {
                                "de": "Wir mussten unseren Spaziergang wegen des anhaltenden <w>Nieselregens</w> absagen."
                            }
                        },
                        {
                            "text": "The <w>drizzle</w> made the roads slippery for the morning commute.",
                            "target_lang_translations": {
                                "de": "Der <w>Sprühregen</w> machte die Straßen für den morgendlichen Berufsverkehr rutschig."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprinkle"
                    ],
                    "common_phrases": [
                        "light drizzle",
                        "steady drizzle"
                    ],
                    "target_lang_definitions": {
                        "de": "Leichter, feiner Regen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Nieselregen",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für sehr feinen, leichten Regen."
                            },
                            {
                                "target_lang_word": "Sprühregen",
                                "target_lang_sense_clarification": "Synonym zu Nieselregen, betont die feine Verteilung der Tropfen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb2bf7d7-9af3-3567-80a0-c083eee2b593",
                    "sense_definition": "A cake topped with icing, honey, or syrup in an artistic manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She baked a delicious lemon <w>drizzle</w> for the afternoon tea party.",
                            "target_lang_translations": {
                                "de": "Sie hat einen köstlichen Zitronenkuchen mit <w>Zuckerguss</w> für die Teeparty am Nachmittag gebacken."
                            }
                        },
                        {
                            "text": "The bakery is famous for its signature orange <w>drizzle</w>.",
                            "target_lang_translations": {
                                "de": "Die Bäckerei ist berühmt für ihren charakteristischen Orangenkuchen mit <w>Guss</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lemon drizzle"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Kuchen, der kunstvoll mit Zuckerguss, Honig oder Sirup überzogen ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gusskuchen",
                                "target_lang_sense_clarification": "Ein Kuchen, der mit einem flüssigen Überzug versehen ist."
                            },
                            {
                                "target_lang_word": "Zitronenkuchen",
                                "target_lang_sense_clarification": "Spezifisch für den häufigen 'lemon drizzle cake'."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31a062ff-e88c-3803-bb0c-7bd0dcc61b79",
                    "sense_definition": "To rain lightly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It started to <w>drizzle</w> just as we arrived at the park.",
                            "target_lang_translations": {
                                "de": "Es fing an zu <w>nieseln</w>, gerade als wir im Park ankamen."
                            }
                        },
                        {
                            "text": "Although it was <w>drizzling</w> all morning, we still enjoyed the outdoor market.",
                            "target_lang_translations": {
                                "de": "Obwohl es den ganzen Morgen <w>nieselte</w>, genossen wir den Markt unter freiem Himmel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drizzling all day"
                    ],
                    "target_lang_definitions": {
                        "de": "Leicht regnen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nieseln",
                                "target_lang_sense_clarification": "Das Verb für das Fallen von Nieselregen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fddc1e0-e59e-363a-8fbf-3641122aacda",
                    "sense_definition": "To pour liquid slowly and evenly over food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>drizzle</w> olive oil over the salad before serving.",
                            "target_lang_translations": {
                                "de": "Du solltest vor dem Servieren Olivenöl über den Salat <w>träufeln</w>."
                            }
                        },
                        {
                            "text": "Carefully <w>drizzle</w> the honey over the warm pancakes.",
                            "target_lang_translations": {
                                "de": "Lasse den Honig vorsichtig über die warmen Pfannkuchen <w>träufeln</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dribble"
                    ],
                    "common_phrases": [
                        "drizzle oil",
                        "drizzle honey"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Flüssigkeit langsam und gleichmäßig über Speisen gießen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "träufeln",
                                "target_lang_sense_clarification": "Das gezielte, tropfenweise oder in dünnem Strahl Auftragen von Flüssigkeiten."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}