                "senses": [
                    {
                        "sense_id": "5f3e4cca-a17a-31d4-8e99-40055ad133ad",
                        "entry_id": "a4a52fd2-b5b1-3460-b92d-96763d49a29a",
                        "glosses": [
                            "женск. к парижанин; жительница или уроженка Парижа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3f0426-e33d-48f8-bc31-16362e6f2946",
                                "sense_id": "5f3e4cca-a17a-31d4-8e99-40055ad133ad",
                                "text": "Мадлен, как истая парижанка, радовалась возвращению в Париж."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f47ef59c-a371-4d77-a0c3-667b653aab83",
                        "source_entry_id": "a4a52fd2-b5b1-3460-b92d-96763d49a29a",
                        "source_sense_id": "5f3e4cca-a17a-31d4-8e99-40055ad133ad",
                        "target_lang_word": "Parisienne",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parisienne",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ceebb11-c156-3fca-aee5-971f90cbc614",
                                        "entry_id": "911d253a-5ea2-3446-a7c2-e703eaf8440b",
                                        "glosses": [
                                            "A woman from Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c94740-e7a8-4bfb-be2c-52e1a06a317b",
                                                "sense_id": "4ceebb11-c156-3fca-aee5-971f90cbc614",
                                                "text": "It is so natural to a Parisienne, even when passion has almost mastered her, to hesitate and pause before taking the plunge."
                                            },
                                            {
                                                "example_id": "cc6d3d8f-9067-429a-b801-08146cbbd708",
                                                "sense_id": "4ceebb11-c156-3fca-aee5-971f90cbc614",
                                                "text": "It was at most but a vague hint dropped by a certain notorious Parisienne in a jealous mood that had caused suspicion to rest upon the lieutenant."
                                            },
                                            {
                                                "example_id": "d22315ef-7e46-45d8-af90-0bc730e863d8",
                                                "sense_id": "4ceebb11-c156-3fca-aee5-971f90cbc614",
                                                "text": "Proclaiming taste to be a learned as much as an inborn trait, they sought to establish themselves as aesthetic educators of the vulnerable, unschooled Parisienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c42de87e-5674-407d-9de4-e159439074cc",
                        "source_entry_id": "a4a52fd2-b5b1-3460-b92d-96763d49a29a",
                        "source_sense_id": "5f3e4cca-a17a-31d4-8e99-40055ad133ad",
                        "target_lang_word": "Parisian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "547089c2-375b-38c4-a316-1469e214691b",
                                        "entry_id": "d6cf8ff7-a3d2-30e7-abbb-840ca9128a41",
                                        "glosses": [
                                            "A native, citizen and/or inhabitant of Paris, France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b528304-dcf2-49f7-9195-ccc48ea35aa8",
                                                "sense_id": "547089c2-375b-38c4-a316-1469e214691b",
                                                "text": "Not all of France was inundated by the nationalist wave – it was predominantly young, intelligent Parisians who embraced the new bellicism […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Parisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32537e1b-c081-3156-8282-12a510a74c2c",
                                        "entry_id": "de66880e-b0bb-3ee9-908b-758355ca22ab",
                                        "glosses": [
                                            "Of, relating, or pertaining to Paris, France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42138cde-4ae1-42e0-ae49-e37b1176438b",
                                                "sense_id": "32537e1b-c081-3156-8282-12a510a74c2c",
                                                "text": "He lived in Paris for ten years, and became more Parisian than the natives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
