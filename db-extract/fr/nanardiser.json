                "senses": [
                    {
                        "sense_id": "6698fe48-9fed-3deb-982a-c91aa1bf2148",
                        "entry_id": "eff69118-599e-3ae8-94ca-dd54e2d64504",
                        "glosses": [
                            "Donner un caractère de nanard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0817cecf-df66-48cc-87ae-3280f7a897ab",
                                "sense_id": "6698fe48-9fed-3deb-982a-c91aa1bf2148",
                                "text": "Bruno Mattei demeure une énigme qui défie l'entendement. Comment ce type peut-il nanardiser à ce point tout projet qui lui passe entre les mains ?"
                            },
                            {
                                "example_id": "b6c96127-dcf6-4df6-b5c0-0e857c41eaf0",
                                "sense_id": "6698fe48-9fed-3deb-982a-c91aa1bf2148",
                                "text": "Rappelons-nous également la grandiloquence du Cléopâtre de Manquiewicz (1963) ou des Dix commandements de Cecil B. De Mille (1956) que François Forestier n’hésite pas à nanardiser pour comprendre que viser la grandeur peut vouer au ridicule."
                            },
                            {
                                "example_id": "aafd3166-1c5e-499a-a9ba-761f6be31f7a",
                                "sense_id": "6698fe48-9fed-3deb-982a-c91aa1bf2148",
                                "text": "On ne peut pas nier que le film soit devenu un peu kitsch aujourd’hui et que ce genre de production ait tendance à se nanardiser avec le temps."
                            }
                        ]
                    }
                ],
