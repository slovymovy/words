                                        "sense_id": "a4d57ac4-4465-3b90-b3d5-cbb0d897f1d4",
                                        "entry_id": "4d7aa6ee-2eb8-3b07-88c1-9c3492927c6c",
                                        "glosses": [
                                            "A colour morph of the common pill-bug (Armadillidium vulgare), characterised by a mostly white body that is dotted with yellow and black spots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81cf4bf0-6026-49a6-ab5a-a682734ddf98",
                                                "sense_id": "a4d57ac4-4465-3b90-b3d5-cbb0d897f1d4",
                                                "text": "Magic potions are probably my favorite isopod[s]. I got some from Eddie recently. So far they are pretty easy- can’t wait for them to grow up a bit and reproduce."
                                            },
                                            {
                                                "example_id": "8f2c5f31-9d1d-4530-ba39-b3fcea845c2f",
                                                "sense_id": "a4d57ac4-4465-3b90-b3d5-cbb0d897f1d4",
                                                "text": "So, my magic potions have been struggling since i got them, they were very inactive, and some were suiciding themselves by escaping. I knew they needed good air flow, a drink source, and food, as well as proper temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
