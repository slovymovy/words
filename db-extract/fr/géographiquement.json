        "fr-extract.jsonl": [
            {
                "entry_id": "634a1ca5-9cc3-38a1-b32d-7beec418ef78",
                "word": "géographiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ccde630e-021f-3c2e-90c6-1651660d15ef",
                        "entry_id": "634a1ca5-9cc3-38a1-b32d-7beec418ef78",
                        "glosses": [
                            "D’une manière géographique, selon les principes de la géographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a82dcb5-1d92-43d6-8c71-177441c0937a",
                                "sense_id": "ccde630e-021f-3c2e-90c6-1651660d15ef",
                                "text": "Les espèces géographiquement les plus voisines sont en Afrique et dans l’Inde, mais n'ont pas de parenté rapprochée avec les européennes, […]."
                            },
                            {
                                "example_id": "1f6c5593-1990-4af3-930f-a217e97ae134",
                                "sense_id": "ccde630e-021f-3c2e-90c6-1651660d15ef",
                                "text": "Cette première esquisse d'une chronologie de l'art rupestre au Yémen est fondée sur une étude limitée géographiquement, essentiellement à la région de Saada, augmentée de quelques relevés aux alentours de Rad' et dans le Wadi Dahr (…)."
                            },
                            {
                                "example_id": "18b9238b-31e2-4f5e-bcba-30124cf9fdcd",
                                "sense_id": "ccde630e-021f-3c2e-90c6-1651660d15ef",
                                "text": "Avancer est chose impossible dans la position où nous nous trouvons [au fond de l’Italie] ; cela est vrai, moralement et géographiquement parlant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af73af2e-dc69-403b-bc3e-2f46c90bcd00",
                        "source_entry_id": "634a1ca5-9cc3-38a1-b32d-7beec418ef78",
                        "source_sense_id": "ccde630e-021f-3c2e-90c6-1651660d15ef",
                        "target_lang_word": "geographically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geographically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b608d5e8-6aec-3cc9-a4d6-ec44ea764a6a",
                                        "entry_id": "ec6579b9-f95c-33dc-b2c9-faaf84f6f5bc",
                                        "glosses": [
                                            "In terms of geography."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23cd2fd8-57b5-447d-b8cf-7330061f490e",
                                                "sense_id": "b608d5e8-6aec-3cc9-a4d6-ec44ea764a6a",
                                                "text": "I don’t like geostates (I don’t think many people truly do), but I think geographically localized governance is effective because it reduces interaction by people with contradictory conceptions about good behavior and so reduces conflict while supporting order."
                                            },
                                            {
                                                "example_id": "a8ba514f-1e12-46fe-b414-836d2a1df904",
                                                "sense_id": "b608d5e8-6aec-3cc9-a4d6-ec44ea764a6a",
                                                "text": "South West London and Surrey may be geographically close to the airport, but there is no way of reaching Heathrow by rail, short of travelling via central London."
                                            }
                                        ]
                                    }
                                ]
                            }
