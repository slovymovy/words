        "fr-extract.jsonl": [
            {
                "entry_id": "17ca661b-2b6a-3769-a3f1-f7a3018a2d28",
                "word": "monogame",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9922c6e4-978d-4e7f-ac97-e3709aa20839",
                        "entry_id": "17ca661b-2b6a-3769-a3f1-f7a3018a2d28",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "monogames"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                        "entry_id": "17ca661b-2b6a-3769-a3f1-f7a3018a2d28",
                        "glosses": [
                            "Qui n’a qu’un seul partenaire sexuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04a3b3c-0f02-42e2-bce3-75f27b74dcad",
                                "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                                "text": "– Plus monogames que nous quatre, ça n’existe nulle part."
                            },
                            {
                                "example_id": "1628e698-9894-4f7a-ac04-e501f670d0ea",
                                "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                                "text": "Cet apôtre de la liberté sexuelle est radicalement monogame, et toujours sa Marcelle lui suffira."
                            },
                            {
                                "example_id": "b20cb848-6e3b-43f5-a5f9-53800329e769",
                                "sense_id": "697b2696-ec1f-3389-87c9-c7635f14c11c",
                                "text": "Elle a de ces arrondis qui rendraient le roi Salomon monogame à vie, et elle a ce genre de santé qui ferait passer cette poule romaine, Junon, pour une phtisique au dernier degré."
                            }
                        ]
                    },
                    {
                        "sense_id": "9af9eee7-a0d3-3c40-a759-05824597fc83",
                        "entry_id": "17ca661b-2b6a-3769-a3f1-f7a3018a2d28",
                        "glosses": [
                            "Qui a le caractère de monogamie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85a13f88-f773-464f-b959-394d524fe6d8",
                        "source_entry_id": "17ca661b-2b6a-3769-a3f1-f7a3018a2d28",
                        "target_lang_word": "monogamous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monogamous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51fd041f-e163-3bab-afa8-a91cbb33e1f2",
                                        "entry_id": "3b586ecd-4034-3b93-88a0-5aeb03cdfc07",
                                        "glosses": [
                                            "Being married to one person at a time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f89ce76f-4a45-4121-b30d-bae2db711d9e",
                                                "sense_id": "51fd041f-e163-3bab-afa8-a91cbb33e1f2",
                                                "text": "Suppose, for example, that if polygamy were legal, 10 percent of adult men would take an average of three wives apiece and that all remaining marriages would be monogamous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0387d00b-3e4d-3573-a3b1-22c9ec1d706d",
                                        "entry_id": "3b586ecd-4034-3b93-88a0-5aeb03cdfc07",
                                        "glosses": [
                                            "Being exclusively committed to one significant other at a time."
                                        ],
                                        "tags": [
