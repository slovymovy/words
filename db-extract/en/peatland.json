                    }
                ],
                "senses": [
                    {
                        "sense_id": "0be781c4-fdb4-31e9-bd5b-44db5e154286",
                        "entry_id": "f334690c-bf3d-3217-8889-6c4266805d89",
                        "glosses": [
                            "Land with peat soil, such as an active or former bog."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9406425-f2d8-483f-b948-8b6a62737e0b",
                                "sense_id": "0be781c4-fdb4-31e9-bd5b-44db5e154286",
                                "text": "Scientists have shown that palm oil is linked to such large-scale rainforest and peatland destruction that it can be hundreds of times worse for the climate than burning fossil fuels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "405077ca-d8d2-4f52-82aa-3b5f52190111",
                        "source_entry_id": "f334690c-bf3d-3217-8889-6c4266805d89",
                        "source_sense_id": "0be781c4-fdb4-31e9-bd5b-44db5e154286",
                        "source_sense_description": "Translations",
                        "target_lang_word": "tourbière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourbière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b7db72b-4a04-3808-93e2-4093a9787e61",
                                        "entry_id": "e3d4d7b3-f9b4-3c90-abdb-d125531f2052",
                                        "glosses": [
                                            "Endroit d’où l’on extrait de la tourbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f138ff3e-a4de-4d34-9db9-c89be7707fbb",
                                                "sense_id": "6b7db72b-4a04-3808-93e2-4093a9787e61",
                                                "text": "Que de fois son père lui avait-il parlé de ces tourbières et de leurs entailles, c’est-à-dire des grands étangs que l’eau a remplis après que la tourbe a été enlevée, qui sont l’originalité de la vallée de la Somme."
                                            },
                                            {
                                                "example_id": "dc9a752c-cfb3-4cce-ac1e-98bcad1b1699",
                                                "sense_id": "6b7db72b-4a04-3808-93e2-4093a9787e61",
                                                "text": "On a pu suivre d'une façon précise l'histoire post-glaciaire dans le Nord de l'Europe, où de nombreux végétaux à demi fossilisés des tourbières ont permis de suivre couche par couche l’évolution des végétaux principaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "650c3863-4721-3ac8-926a-3ddf91c97525",
                                        "entry_id": "e3d4d7b3-f9b4-3c90-abdb-d125531f2052",
                                        "glosses": [
                                            "Sol formé de tourbe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4bc8b52-cfd9-4682-a054-a7dadbcd8859",
                                                "sense_id": "650c3863-4721-3ac8-926a-3ddf91c97525",
                                                "text": "Au bord des petits lacs des Alpes, plus ou moins comblés, se forment des tourbières appelées fagnes ; pour le touriste elles se signalent par les élégantes houppes blanches des Linaigrettes."
                                            },
                                            {
                                                "example_id": "74f005f1-4b4d-4b1a-a49f-d76044c182dc",
                                                "sense_id": "650c3863-4721-3ac8-926a-3ddf91c97525",
                                                "text": "« La tendance n’est pas, non plus, à planter des résineux : on va même en enlever qui n’ont plus de valeur économique, en septembre, sur une tourbière à Argol », ajoute Marielle Chaumien, responsable communication du PNRA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c18705a-1250-3376-9fe3-c82e3cbc6d2d",
                                        "entry_id": "e3d4d7b3-f9b4-3c90-abdb-d125531f2052",
                                        "glosses": [
                                            "Celle qui extrait la tourbe."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd4bc63d-d0e8-4316-a222-f51bb235050a",
                                                "sense_id": "5c18705a-1250-3376-9fe3-c82e3cbc6d2d",
                                                "text": "[…] ouvrière tourbière qui déchargeait les brouettés de tourbe […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tourbière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d430ddac-0b03-36d5-9986-2577e426c01b",
                                        "entry_id": "cb6f2750-397d-380e-87bd-ca2e7c5dbfd8",
                                        "glosses": [
                                            "Féminin singulier de tourbier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f96645-b1b8-4d1c-aa20-0d1ee202add7",
                                                "sense_id": "d430ddac-0b03-36d5-9986-2577e426c01b",
                                                "text": "Spécialisée dans l’industrie tourbière, l’entreprise québécoise Premier Tech est récemment devenue copropriétaire de l’équipe Astana après avoir été l’un de ses fidèles commanditaires pendant plusieurs années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56ae0d80-d0f6-4793-acbd-058db7134e3e",
                        "source_entry_id": "f334690c-bf3d-3217-8889-6c4266805d89",
                        "source_sense_id": "0be781c4-fdb4-31e9-bd5b-44db5e154286",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Moor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                        "entry_id": "459f0c30-9f1a-35f7-9d2a-4b187123aaca",
                                        "glosses": [
                                            "Sumpf, dessen Grund aus Torf besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63964f3-a41e-4fb0-bba7-8af67467f0dc",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "Moore trockenzulegen ist aus heutiger Sicht ein großer Fehler gewesen."
                                            },
                                            {
                                                "example_id": "aff9c147-91e4-4eef-98c6-859b5f9e8acb",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Die Pflanzen und Tiere, die im Moor leben, haben sich auf diesen besonderen Le- bensraum spezialisiert. Wenn es das Moor nicht mehr gibt, werden viele Pflanzen und Tiere aussterben.“"
                                            },
                                            {
                                                "example_id": "02def2d8-03c1-470b-855c-3f0950734275",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„[…] aus trockenen Mooren und solchen, in denen Torf abgebaut wird, entweichen jährlich Millionen Tonnen CO2.“"
                                            },
                                            {
                                                "example_id": "3ae6fb42-4685-4807-8f08-12e2bf555f94",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Wichtige Moor-Grundstücke wurden schon in den Siebzigerjahren aufgekauft, es wurden Dämme errichtet, Wasser wurde gestaut, das Moor wiedervernässt.“"
                                            },
                                            {
                                                "example_id": "82874d66-d64f-4329-bf3a-887634436346",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„[…] der Umweltminister weiß auch, dass Versprechen und das Werben der Naturschutzbehörden für den Schutz der Moore allzu oft völlig wirkungslos bleiben.“"
                                            },
                                            {
                                                "example_id": "99b4f4e6-ab2f-45be-9b76-880b3ce94658",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Dann rennen fast alle Frauen ins Moor hinaus, um sich irgendwo im Buschwerk zu verstecken.“"
                                            },
                                            {
                                                "example_id": "5b2a2731-5189-47de-b467-333300f37f43",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Kurz vor dem winzigen Bad Salomonsbrunn (Bagni di Salomone) führt die Straße durch ein verlandetes Moor, die Rasner Möser.“"
                                            },
                                            {
                                                "example_id": "6c8ca6b9-1786-4245-98a3-c4bd1f1740e3",
                                                "sense_id": "5b8f9c0d-9315-3412-a684-3e76e0253707",
                                                "text": "„Moore sind wertvolle Lebensräume für seltene Tiere und Pflanzen und speichern viel ⁠CO2⁠.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65059efe-1afc-316c-a3e9-8d6c2ebe805b",
                                        "entry_id": "459f0c30-9f1a-35f7-9d2a-4b187123aaca",
                                        "glosses": [
                                            "Torfschlamm für Heilzwecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4152bbee-654c-4753-b811-f98d44943192",
                                                "sense_id": "65059efe-1afc-316c-a3e9-8d6c2ebe805b",
                                                "text": "Sie ließ sich Bäder aus Moor verschreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
