{
    "word_family": [
        "miracle",
        "miraculous"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                    "sense_definition": "In a way that is very surprising, fortunate, or difficult to explain, as if caused by a miracle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver <w>miraculously</w> survived the crash without any serious injuries.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>чудом</w> выжил в аварии без серьезных травм.",
                                "fr": "Le conducteur a <w>miraculeusement</w> survécu à l'accident sans blessure grave.",
                                "zh": "司机在车祸中<w>奇迹般地</w>幸存下来，没有受严重的伤。"
                            }
                        },
                        {
                            "text": "She <w>miraculously</w> recovered from the illness when the doctors had given up hope.",
                            "target_lang_translations": {
                                "ru": "Она <w>чудесным образом</w> выздоровела, когда врачи уже потеряли надежду.",
                                "fr": "Elle a guéri <w>par miracle</w> de sa maladie alors que les médecins avaient perdu tout espoir.",
                                "zh": "在医生都放弃希望时，她<w>奇迹般地</w>康复了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amazingly",
                        "incredibly",
                        "wonderfully",
                        "magically",
                        "inexplicably"
                    ],
                    "antonyms": [
                        "naturally",
                        "predictably",
                        "unsurprisingly"
                    ],
                    "common_phrases": [
                        "miraculously survived",
                        "miraculously recovered",
                        "miraculously escaped",
                        "miraculously saved"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удивительным, счастливым или необъяснимым образом, словно в результате чуда.",
                        "fr": "D'une manière très surprenante, heureuse ou difficile à expliquer, comme sous l'effet d'un miracle.",
                        "zh": "奇迹般地；不可思议且极其幸运地（仿佛有奇迹发生一样）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудом",
                                "target_lang_sense_clarification": "невероятно, к счастью (часто о спасении)"
                            },
                            {
                                "target_lang_word": "чудесным образом",
                                "target_lang_sense_clarification": "необъяснимо, как по волшебству"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "miraculeusement",
                                "target_lang_sense_clarification": "d'une façon miraculeuse ou extraordinaire"
                            },
                            {
                                "target_lang_word": "par miracle",
                                "target_lang_sense_clarification": "grâce à une chance incroyable, de manière inespérée"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇迹般地",
                                "target_lang_sense_clarification": "像出现奇迹一样，通常修饰动词"
                            },
                            {
                                "target_lang_word": "奇迹般",
                                "target_lang_sense_clarification": "常作状语，用于描写不可思议的幸运事件"
                            },
                            {
                                "target_lang_word": "神奇地",
                                "target_lang_sense_clarification": "令人难以置信地、奇妙地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}