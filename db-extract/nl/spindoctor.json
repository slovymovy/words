        "nl-extract.jsonl": [
            {
                "entry_id": "a4c789c0-c532-35b5-9333-36d745b95c6c",
                "word": "spindoctor",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "922b68d4-a777-41b3-80ca-d5342b52d2c4",
                        "entry_id": "a4c789c0-c532-35b5-9333-36d745b95c6c",
                        "tags": [
                            "plural"
                        ],
                        "form": "spindoctors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a0ec644-1fa9-3db0-85a1-0c7318438b84",
                        "entry_id": "a4c789c0-c532-35b5-9333-36d745b95c6c",
                        "glosses": [
                            "adviseur of voorlichter van een politieke partij of een ambtsdrager die de opdracht heeft het beleid van zijn politieke opdrachtgever zo positief mogelijk te presenteren en te verdedigen of hem of haar daarin te coachen"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "f815aee3-b024-40af-b8b9-0d8ac5e93544",
                                "sense_id": "7a0ec644-1fa9-3db0-85a1-0c7318438b84",
                                "text": "De populariteitsprijs werd in Den Haag als inferieur beschouwd. Als journalist moest je juist gevreesd durven worden. Veronique Anker liet zich nooit door een spindoctor in de luren leggen. Morten had eens geobserveerd hoe ze door de Tweede Kamer holde, van de ene fractievoorzitter naar de andere, al telefonerend, om zo telkens een brokje nieuwe informatie binnen te harken, waardoor zij een bijnacrisis in het kabinet had kunnen reconstrueren. Eén bron is geen bron. Gelukkig waren er nog steeds veel journalisten die dat principe hanteerden."
                            },
                            {
                                "example_id": "85239e2f-6f25-4095-ab8c-5a50e2a174d8",
                                "sense_id": "7a0ec644-1fa9-3db0-85a1-0c7318438b84",
                                "text": "Hij wilde zich wel met het blad bemoeien, maar dat leek me alleen maar ijdelheid. Dat hij zich een beetje op de borst wilde kloppen en tegen zijn medeprofiteurs wilde zeggen dat hij onze spindoctor was of zo."
                            },
                            {
                                "example_id": "6f4d304f-871e-43d7-9df3-4c33cf3d3268",
                                "sense_id": "7a0ec644-1fa9-3db0-85a1-0c7318438b84",
                                "text": "Hoe anders is dat in Catalonië. Minister-president Carles Puigdemont heeft zelfs een speciale spindoctor voor buitenlandse media, die de correspondenten via WhatsApp van een constante stroom van informatie voorziet. Hij stuurt de agenda van Puigdemont, vertaalt teksten van speeches in het Engels en het Frans, kondigt manifestaties aan, maar verspreidt ook beelden van Spaanse agenten die inslaan op ‘onschuldige’ stemmers."
                            },
                            {
                                "example_id": "8142d30f-ab5f-48ad-9b97-1d14d8e893ef",
                                "sense_id": "7a0ec644-1fa9-3db0-85a1-0c7318438b84",
                                "text": "Senator McCarthy en zijn spindoctor Roy Cohn organiseerden een heksenjacht op vermeende communisten op basis van verzonnen geruchten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d91030a4-0c6d-4b84-9d4e-df538902b7ef",
                        "source_entry_id": "a4c789c0-c532-35b5-9333-36d745b95c6c",
                        "source_sense_id": "7a0ec644-1fa9-3db0-85a1-0c7318438b84",
                        "source_sense_description": "voorlichter",
                        "target_lang_word": "spin doctor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spin doctor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68f60a68-f3e5-3564-a830-07b15f9c36bf",
                                        "entry_id": "c1e7649e-a1a0-3ddc-bc07-7a5750221ad8",
                                        "glosses": [
                                            "A person employed to gloss over a poor public image (or present it in a better light) in business and politics, especially after unfavourable results have been achieved. A lobbyist; PR person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671c21ea-508d-495d-bbbc-f4d38ad748a1",
                                                "sense_id": "68f60a68-f3e5-3564-a830-07b15f9c36bf",
                                                "text": "Many believed that the reduction in public spending was a disaster but the spin doctors presented it as a triumph for lower taxation."
                                            },
                                            {
                                                "example_id": "9213e492-c988-4e49-a98d-eb9ed84a3fb0",
                                                "sense_id": "68f60a68-f3e5-3564-a830-07b15f9c36bf",
                                                "text": "A dozen men in good suits and women in silk dresses will circulate smoothly among the reporters, spouting confident opinions. They won't be just press agents trying to impart a favorable spin to a routine release. They'll be the Spin Doctors, senior advisers to the candidates, and they'll be playing for very high stakes."
                                            },
                                            {
                                                "example_id": "e6b3926d-aa4b-491c-bacf-dd6e7bb0567d",
                                                "sense_id": "68f60a68-f3e5-3564-a830-07b15f9c36bf",
                                                "text": "Now that the cold war has ended and political ideologies have been replaced by pollsters and spin doctors, Machiavelli's cleareyed assessments of power dynamics and pragmatic advantage are suddenly in vogue."
                                            },
                                            {
                                                "example_id": "fea6ce1b-1c89-48cb-a094-909448236ba5",
                                                "sense_id": "68f60a68-f3e5-3564-a830-07b15f9c36bf",
                                                "text": "William Hague, shadow foreign secretary, said the Williams document was \"further evidence that spin doctors, not intelligence analysts, were leading from the first in deciding what the British people were told about Iraq's weapons of mass destruction\"."
                                            },
                                            {
                                                "example_id": "d6a49d59-261c-467e-9fe7-46426f34f579",
                                                "sense_id": "68f60a68-f3e5-3564-a830-07b15f9c36bf",
                                                "text": "Lord Steel, the former Liberal leader, has launched a despairing attack on the prevalence of spin doctors in politics, noting that he is given \"daily outpourings of tweets to circulate\" and bombarded by email with \"lines to take\" on current issues."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spin doctor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d219220-e335-3f47-b0f1-977c19e6c024",
                                        "entry_id": "e3846986-224e-38e3-91de-a0076b8148e3",
                                        "glosses": [
                                            "To generate spin (favourable interpretation or bias)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
