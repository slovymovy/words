                            {
                                "example_id": "3fa836f2-40d1-4f62-9af8-ec9c3929fef2",
                                "sense_id": "b0fa749e-a31d-3b68-bb11-6b44d021ea31",
                                "text": "„Schnaufend wechselt der Fette den Platz.“"
                            },
                            {
                                "example_id": "c0cdb7f6-48f7-47f0-b3cb-221ce449844e",
                                "sense_id": "b0fa749e-a31d-3b68-bb11-6b44d021ea31",
                                "text": "„Übergewichtige dagegen haben stabile Abwehrkräfte, einen gut funktionierenden Kreislauf und sie haut so schnell keine Grippewelle um. Allerdings in einem gesunden Rahmen, denn krankhaft Fette sind schon prädestiniert für Wohlstandskrankheiten.“"
                            }
                        ],
