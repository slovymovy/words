                                        "glosses": [
                                            "A people living in Nigeria and part of Niger."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Hausa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2902fb59-2b59-3ac8-a006-af56ddb25bb2",
                                        "entry_id": "713f6b04-9264-3061-868b-0f2282fb4b26",
                                        "glosses": [
                                            "The Chadic language spoken by these people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62c4bbbb-d4ca-4267-be0b-2e9b0a51b080",
                                                "sense_id": "2902fb59-2b59-3ac8-a006-af56ddb25bb2",
                                                "text": "She tells me she’s been intensively studying Hausa these past weeks, that it’s such a unique and precise language, one that you write the way you speak it, very historical and more Arabian than she’d thought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1009d42e-58ec-4bb5-a497-9f2d64235797",
                        "source_entry_id": "27613eb5-16c1-3d51-b17a-8e427e9222e1",
                        "source_sense_id": "18d70639-7d07-3d00-bc3a-f9d2d2ff4fe0",
                        "source_sense_description": "taal die wordt gesproken door meer dan 85 miljoen mensen, vooral in Niger en Nigeria",
                        "target_lang_word": "haoussa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haoussa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fc9c72f-4c83-358c-bfc4-f33d15458d7d",
                                        "entry_id": "fde33b67-b42c-3805-82c4-b9b9af3f75f6",
                                        "glosses": [
                                            "Langue tchadique, parlée en Afrique occidentale, principalement au Niger et au Nigeria ; une des principales langues commerciales d’Afrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd25a30c-8af9-4067-9776-0ebc239f7ce9",
                                                "sense_id": "9fc9c72f-4c83-358c-bfc4-f33d15458d7d",
                                                "text": "[…], enfin Moussa, jeune Nigérien, bavard et sympathique. Il fera ma cuisine et me servira d’interprète dans ce pays où l'on parle le haoussa principalement et d'autres dialectes, mais non l’arabe, à part quelques chefs et quelques marabouts."
                                            },
                                            {
                                                "example_id": "c10ae3ce-7c64-45cb-abc3-90d9007389eb",
                                                "sense_id": "9fc9c72f-4c83-358c-bfc4-f33d15458d7d",
                                                "text": "En Inde, en Afrique, nombre de langues qui ont pourtant résisté à la colonisation sont aujourd’hui menacées par les grandes langues indiennes ou africaines, comme le swahili, le peul (en Afrique centrale), le haoussa (au Niger et au Cameroun) ou le ouolof (au Sénégal), particulièrement dangereuses parce qu’elles ne sont pas suspectes d’être des langues de l’étranger et possèdent le prestige des grandes langues africaines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
