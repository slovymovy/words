                        "glosses": [
                            "Dispositif médical censé aspirer le venin injecté par un animal ou une plante."
                        ],
                        "tags": [
                            "Secourisme"
                        ],
                        "examples": [
                            {
                                "example_id": "a4cbefb3-2242-4126-a34b-b072af85c99b",
                                "sense_id": "05ec258e-ef9b-3e25-86f6-c1e9d0b59226",
                                "text": "L’aspivenin est un système breveté de premier secours en cas de piqûre d’insecte. C’est un outil réutilisable et indispensable aux apiculteurs qui manipulent les abeilles régulièrement, à placer dans la trousse à pharmacie familiale."
                            },
                            {
                                "example_id": "add767d2-c19e-47cf-b6c7-10f90dab83e4",
                                "sense_id": "05ec258e-ef9b-3e25-86f6-c1e9d0b59226",
                                "text": "L’aspivenin est peu efficace; il a surtout un effet psychologique pour rassurer la victime."
                            }
                        ]
                    }
