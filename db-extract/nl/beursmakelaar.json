                    {
                        "translation_id": "b3bff11d-422c-45f2-b8cc-49458ad4bf53",
                        "source_entry_id": "bdb6256b-b5d4-387f-bb22-cf9809371ebc",
                        "source_sense_id": "fa746444-9b65-31c1-be3e-f93820927d04",
                        "source_sense_description": "een makelaar aan de beurs",
                        "target_lang_word": "Börsenmakler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Börsenmakler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "305a7239-ec98-3b9c-ac59-5aa821ffd474",
                                        "entry_id": "18e0c45e-9cce-3843-97e8-1a81815aad82",
                                        "glosses": [
                                            "nicht vereidigter Makler, der an einer Börse mit Aktien handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01941c37-d598-4e62-85dd-3c1663754c96",
                                                "sense_id": "305a7239-ec98-3b9c-ac59-5aa821ffd474",
                                                "text": "Um eine Lizenz als Börsenmakler zu bekommen, bedarf es einer ausreichenden Berufsausbildung sowie finanzieller Mittel als Sicherheit."
                                            },
                                            {
                                                "example_id": "c4b5a2fb-bbf5-4775-83d1-cb8b20e2bf1e",
                                                "sense_id": "305a7239-ec98-3b9c-ac59-5aa821ffd474",
                                                "text": "„Er kam in die Stuben der Börsenmakler, saß mit anderen Kunden um die Tische und starrte fieberisch gespannt die Glastafeln an, auf denen Zahlen leuchteten, die Notierungen, verloschen, wieder aufleuchteten…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07f60231-77ed-4933-8839-74c9133a4233",
                        "source_entry_id": "bdb6256b-b5d4-387f-bb22-cf9809371ebc",
                        "source_sense_id": "fa746444-9b65-31c1-be3e-f93820927d04",
                        "source_sense_description": "een makelaar aan de beurs",
                        "target_lang_word": "stockbroker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stockbroker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8880e437-4c28-34f2-b829-2628477dad31",
                                        "entry_id": "acb90d8d-a59f-3594-b8b6-0f20fce727e0",
                                        "glosses": [
                                            "A person who buys and sells shares (stock) on a stock exchange on behalf of clients. May also provide investment advice and/or company information, depending on the level of service offered (or chosen by the client)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ef61a6d-c948-49cc-b3b2-28d5d73acd1f",
                        "source_entry_id": "bdb6256b-b5d4-387f-bb22-cf9809371ebc",
                        "source_sense_id": "fa746444-9b65-31c1-be3e-f93820927d04",
                        "source_sense_description": "een makelaar aan de beurs",
                        "target_lang_word": "agent de change",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agent de change",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be981c04-1e2a-3918-ad70-bda71a891dbf",
                                        "entry_id": "ee42207d-82e9-3019-ad47-f1bdd32325a6",
                                        "glosses": [
                                            "Officier public par l’intermédiaire duquel doit s’opérer la négociation des valeurs de bourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "809c32d3-b3bd-45ee-a79f-cebae1052ecd",
                                                "sense_id": "be981c04-1e2a-3918-ad70-bda71a891dbf",
                                                "text": "C’était un homme de moyenne taille, assez gras, rieur qui avait la tournure, les manières d’un agent de change, et qui paraissait n’être doué que d’un esprit fort ordinaire, je ne l’avais pas encore remarqué."
                                            },
                                            {
                                                "example_id": "c441dc73-deb8-4a21-9758-d3114db16d20",
                                                "sense_id": "be981c04-1e2a-3918-ad70-bda71a891dbf",
                                                "text": "J'allai trouver M. J. N., agent de change, qui voulait absolument que je jouasse à la baisse, mais je me gardai bien d'écouter ses conseils. J’opérai à 53, et un peu plus tard je réalisai à 62."
                                            },
                                            {
                                                "example_id": "2a940832-dc30-42ec-8954-a6b7af946260",
                                                "sense_id": "be981c04-1e2a-3918-ad70-bda71a891dbf",
                                                "text": "Gênés par le monopole des agents de change, les coulissiers de la Bourse sont aussi des prolétaires financiers, et parmi eux se rencontre plus d'un socialiste admirateur de Jaurès."
                                            },
                                            {
                                                "example_id": "51b9ead6-f9f6-491d-b05c-fac253794fc4",
                                                "sense_id": "be981c04-1e2a-3918-ad70-bda71a891dbf",
                                                "text": "Peu avant la guerre, Michel avait résolu de se passer de son agent de change habituel, dont les conseils lui avaient paru décevants, et de placer lui-même la plus grande partie des sommes provenant de la vente du Mont-Noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06d2ed41-d2de-3a49-84d5-965011d7074e",
                                        "entry_id": "ee42207d-82e9-3019-ad47-f1bdd32325a6",
                                        "glosses": [
                                            "Bonbon pour la gorge, souvent à la réglisse."
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c673c6c-36c6-446e-b6f3-d4095528c230",
                                                "sense_id": "06d2ed41-d2de-3a49-84d5-965011d7074e",
                                                "text": "— Merci du remède, dit Lachaille, qui mangeait distraitement les agents de change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "036cfa74-b0da-4f1e-bbae-9952e11b4d88",
                        "source_entry_id": "bdb6256b-b5d4-387f-bb22-cf9809371ebc",
                        "source_sense_id": "fa746444-9b65-31c1-be3e-f93820927d04",
                        "source_sense_description": "een makelaar aan de beurs",
                        "target_lang_word": "boursier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boursier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a2cec0-ad26-36cd-ab37-5ea4acce17a6",
                                        "entry_id": "f2e6c211-0ac6-3183-8472-672c13a47c66",
                                        "glosses": [
                                            "Qui concerne la bourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041f7301-d206-4b18-9f5e-84a1609378db",
                                                "sense_id": "d9a2cec0-ad26-36cd-ab37-5ea4acce17a6",
                                                "text": "Les griots de la nouvelle économie ont déchanté. La hausse continue des marchés boursiers a laissé place à un effondrement spectaculaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boursier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddafe83e-3a8a-3fbd-8e82-5fb65a5a3954",
                                        "entry_id": "5afe94cd-d7ab-3e6f-bb89-f7d1ed5b4d6b",
                                        "glosses": [
                                            "Celui qui est bénéficiaire d’une bourse d’études."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b50e907f-a42b-4b8b-92e4-ce2a08c51da4",
                                                "sense_id": "ddafe83e-3a8a-3fbd-8e82-5fb65a5a3954",
                                                "text": "Fils de petits fonctionnaires, anciens boursiers, garçons intelligents et ambitieux mais pleins de fiel, ils me flattaient sans m’aimer."
                                            },
                                            {
                                                "example_id": "f9a7c116-9087-46d4-8feb-5764aba98952",
                                                "sense_id": "ddafe83e-3a8a-3fbd-8e82-5fb65a5a3954",
                                                "text": "À votre tour comprenez le sauvage, qui vint à Paris comme boursier, et gagna sa vie à enseigner la Libre Pensée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69cad7e6-384e-30cd-84ce-7d4f04f2d649",
                                        "entry_id": "5afe94cd-d7ab-3e6f-bb89-f7d1ed5b4d6b",
                                        "glosses": [
                                            "Celui qui fréquente la bourse, par obligation professionnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aba3498-34ca-4a3d-a666-316860f5be63",
                                                "sense_id": "69cad7e6-384e-30cd-84ce-7d4f04f2d649",
                                                "text": "Banquiers, boursiers, courtiers, tripoteurs, faiseurs d’or ;\nEt tous les éclopés admirant ces rapines..."
                                            },
                                            {
                                                "example_id": "215b7e6b-4707-4440-bc6c-f5cbc7109a75",
                                                "sense_id": "69cad7e6-384e-30cd-84ce-7d4f04f2d649",
                                                "text": "Leur aisance à propos de tout me glace, criticaillent la prof, et ridiculisent une boursière de la campagne dieppoise qui a gardé des mots normands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a795a30f-6d42-36b0-ad67-c6c97f5ee472",
                                        "entry_id": "5afe94cd-d7ab-3e6f-bb89-f7d1ed5b4d6b",
                                        "glosses": [
                                            "Ouvrier ou artisan qui fait et vend des bourses."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "862e04aa-4f65-3a18-9e64-bffe51d98791",
                                        "entry_id": "5afe94cd-d7ab-3e6f-bb89-f7d1ed5b4d6b",
                                        "glosses": [
                                            "Celui qui tient la bourse commune, la trésorerie d’une ou d’une association."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
