        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "f5880a60-2ad3-36d5-b30e-8717bb7c609e",
                    "sense_definition": "geeft een reden aan voor wat volgt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oorzaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gezien</w> het regent, blijven we vandaag liever de hele middag binnen.",
                            "target_lang_translations": {
                                "en": "<w>Since</w> it is raining, we would rather stay inside all afternoon today."
                            }
