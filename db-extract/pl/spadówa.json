                        "source_sense_id": "f16c9a2a-8ea5-3b10-a115-bd9535b6acae",
                        "target_lang_word": "buzz off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buzz off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f99e628-a961-39b1-a968-5c83e99a8cf0",
                                        "entry_id": "a247d320-ffb4-3034-aca2-efa6ffe53449",
                                        "glosses": [
                                            "go away."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380a2c8d-a386-456b-931e-6b7d836c5927",
                                                "sense_id": "8f99e628-a961-39b1-a968-5c83e99a8cf0",
                                                "text": "The bouncer shouted “Buzz off!” and kicked me out of the establishment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buzz off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d05cb06d-01a8-3474-907b-2aaecd102492",
                                        "entry_id": "dd521e6f-e2b1-38fc-b0b1-26d5579e6850",
                                        "glosses": [
                                            "To leave with a buzzing sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e268124c-3057-4af0-b4c9-60f93216c209",
                                                "sense_id": "d05cb06d-01a8-3474-907b-2aaecd102492",
                                                "text": "The bee was flying around my head, but then it buzzed off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "016c3bcc-a9a3-33fd-bf3c-4375d277e2f2",
                                        "entry_id": "dd521e6f-e2b1-38fc-b0b1-26d5579e6850",
                                        "glosses": [
                                            "To leave (especially busily), take off, go away."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc848f7-6c95-4edc-aae2-b719c16ec0a6",
                                                "sense_id": "016c3bcc-a9a3-33fd-bf3c-4375d277e2f2",
                                                "text": "“Where's Daddy?” Phyllis asked. “He suddenly decided to go to London,” said Bobbie. “To London?” “That's what he said.” “Why?” “He didn't tell me.” “I must go and see him,” said Phyllis, and buzzed off. [...] “He's asking for his dinner, the sweet little angel. All right, darling, Mother's coming,” she fluted, and buzzed off on the errand of mercy. [...] “That's life,” she said, and buzzed off to keep her vigil, leaving me kicking myself because I'd forgotten to say anything about the quality of mercy not being strained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8de6b388-9ec6-38c9-b3f6-2b22e17d4fdb",
                                        "entry_id": "dd521e6f-e2b1-38fc-b0b1-26d5579e6850",
                                        "glosses": [
                                            "To interrupt and/or disqualify (someone) by means of a buzzer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7de23d-ea8a-43d8-ae2b-91eeb9d43593",
                                                "sense_id": "8de6b388-9ec6-38c9-b3f6-2b22e17d4fdb",
                                                "text": "He went to this talent show, but they buzzed him off after twenty seconds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79153b0c-ea46-4833-86c9-397aad059a7c",
                        "source_entry_id": "1cbaca95-14b2-39cf-bf2a-d2433c5d7946",
                        "source_sense_id": "f16c9a2a-8ea5-3b10-a115-bd9535b6acae",
                        "target_lang_word": "get lost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "get lost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2db89de1-a42c-370a-926d-3a404f100748",
                                        "entry_id": "6fc6ecdd-2535-389c-aafa-21614f7e04ab",
                                        "glosses": [
                                            "Used to rudely tell somebody to go away or leave one alone."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "impolite"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "get lost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To lose one's way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f2c442c-5259-4d72-9e4e-8109ab84d037",
                                                "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                                "text": "Don't you have a map? How did we get lost?"
                                            },
                                            {
                                                "example_id": "a77828cd-8144-4d3c-90a6-7f254c4d307b",
                                                "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                                "text": "I got lost in his reasoning."
                                            },
                                            {
                                                "example_id": "aaef4327-f9c6-43b5-a80a-edcbb546320a",
                                                "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                                "text": "\"But the Civil Aviation Authority is very worried about 'flyaway' - if someone has bought a GPS jammer on eBay because they don't want drones near their house, it can cause drones to get completely lost and shoot off in a random direction until they run out of battery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af12309-29af-3d52-a32d-e10296abdba1",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To go missing; to be in a location unknown to someone who is looking for it."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ec17ce-8704-4a6e-8a0d-e1f4cf139aa3",
                                                "sense_id": "7af12309-29af-3d52-a32d-e10296abdba1",
                                                "text": "My keys got lost while I was out today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e35b2341-8910-3597-94d1-7f56635800d3",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To be absent, to seem to be absent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b993aa-da09-454f-8398-a1ce5d9dec3a",
                                                "sense_id": "e35b2341-8910-3597-94d1-7f56635800d3",
                                                "text": "The violins get lost with the rest of the music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To exit from the scene."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21440b7d-77ff-4c74-84fd-48a123f8ab42",
                                                "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                                "text": "I don't want to have to tell you again: Get lost!"
                                            },
                                            {
                                                "example_id": "af0e9a58-00cb-47c2-929c-5ec8977e2cbf",
                                                "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                                "text": "They had a row and Fred told Jack to get lost."
                                            },
                                            {
                                                "example_id": "adc15df0-8cc8-48b9-adfb-ab43042bc7e5",
                                                "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                                "text": "Jack did a good job of getting lost: nobody saw him for 4 years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
