                                        "sense_id": "44e14c5f-dc1c-33e8-83a4-322517964a7f",
                                        "entry_id": "d325d3e0-a0f1-30c3-91a7-e74534e01c07",
                                        "glosses": [
                                            "gewählter Angehöriger eines bürgerlichen Parlaments"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d7eb06-f0c5-467b-ba10-5a7d1ac84f19",
                                                "sense_id": "44e14c5f-dc1c-33e8-83a4-322517964a7f",
                                                "text": "„Nun müssen wir Thüringer uns nur noch mit seiner und den leistungslosen Pensionen der übrigen Parlamentsmitglieder befassen.“"
                                            }
