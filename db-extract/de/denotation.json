                    },
                    {
                        "form_id": "54992ae7-efb3-4abd-b995-db15010cc166",
                        "entry_id": "31881722-1215-3351-9af2-3dea355cd354",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Denotation"
                    },
                    {
                        "form_id": "01349e1c-c9a6-491f-9b9b-85819520c4d8",
                        "entry_id": "31881722-1215-3351-9af2-3dea355cd354",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Denotationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6133f0a-2f21-36f9-8ead-e9d673a008b6",
                        "entry_id": "31881722-1215-3351-9af2-3dea355cd354",
                        "glosses": [
                            "Bedeutung eines Wortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bafb7caa-82a7-4487-8c92-d4cd99c2c101",
                                "sense_id": "c6133f0a-2f21-36f9-8ead-e9d673a008b6",
                                "text": "Denotation wird in der Linguistik unter anderem als Gegenbegriff für Konnotation verwendet."
                            },
                            {
                                "example_id": "713f67e9-8894-426d-b94a-e2de66ee15dc",
                                "sense_id": "c6133f0a-2f21-36f9-8ead-e9d673a008b6",
                                "text": "„Soll auf solche Besonderheiten hingewiesen werden, so unterscheidet man zwischen der Denotation (der Bedeutung im eigentlichen Sinn) und der Konnotation (dem Beiklang, den Assoziationen).“"
                            },
                            {
                                "example_id": "d9507e4b-880f-4f30-9719-216ed2fe4be3",
                                "sense_id": "c6133f0a-2f21-36f9-8ead-e9d673a008b6",
                                "text": "„An diesen und anderen Beispielen des Wortgebrauchs wird deutlich, daß es hier nicht so sehr um Denotationen, um kontext- und situationsunabhängige kognitive Benennungen, sondern um Konnotationen, um kontext- und situationsabhängige Zugriffe geht.“"
                            },
                            {
                                "example_id": "723d70a2-97d1-4e92-a2a1-0490b5ce887d",
                                "sense_id": "c6133f0a-2f21-36f9-8ead-e9d673a008b6",
                                "text": "„Zwischen dem Anglizismus und dem einheimischen Wort bestehen zwar identische Denotationen, aber unterschiedliche Konnotationen.“"
                            },
                            {
                                "example_id": "cadc2c6f-0bb1-448f-a483-fbceb61bd464",
                                "sense_id": "c6133f0a-2f21-36f9-8ead-e9d673a008b6",
                                "text": "„Denotation und Konnotation spielen schon beim Namenerwerb eine Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86e2a645-50cc-32c8-9498-bbd1768e3846",
                        "entry_id": "31881722-1215-3351-9af2-3dea355cd354",
                        "glosses": [
                            "Beziehung zwischen einem Wort und dem, was es bezeichnet"
                        ],
