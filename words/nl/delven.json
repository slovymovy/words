                            }
                        },
                        {
                            "text": "De archeoloog begon voorzichtig te <w>delven</w> in de hoop een graf te vinden.",
                            "target_lang_translations": {
                                "en": "The archaeologist began to <w>excavate</w> carefully in the hope of finding a grave."
                            }
                        }
                    ],
                    "synonyms": [
