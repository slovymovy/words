                    {
                        "translation_id": "bb137f03-f5a6-42fe-b62b-43bc39811009",
                        "source_entry_id": "ffb00a55-28b5-36de-83eb-dec31b11b8d5",
                        "source_sense_id": "dd46cb63-92fc-3210-902e-69b9eaa274d1",
                        "target_lang_word": "Feldflasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldflasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b119b1b6-e337-3f56-ab71-461d7146d15b",
                                        "entry_id": "d10aba67-e17c-3dc8-bd09-62b6c66f2d0c",
                                        "glosses": [
                                            "Aufbewahrungsgefäß für Flüssigkeiten, das vor allem zur Ausrüstung eines Soldaten gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d40a24-48d6-4d0d-823b-6b5273f3d4cc",
                                                "sense_id": "b119b1b6-e337-3f56-ab71-461d7146d15b",
                                                "text": "Ist deine Feldflasche noch voll?"
                                            },
                                            {
                                                "example_id": "fca1b4da-c7d6-4970-9f17-fce82f512c65",
                                                "sense_id": "b119b1b6-e337-3f56-ab71-461d7146d15b",
                                                "text": "„Goldstein richtete sich schließlich auf und tastete nach seiner Feldflasche.“"
                                            },
                                            {
                                                "example_id": "b4c59af9-b16d-4490-a073-72a8247f2e37",
                                                "sense_id": "b119b1b6-e337-3f56-ab71-461d7146d15b",
                                                "text": "„Der Küfer, der seine Sorte wohl kannte, steckte einen Trichter in dieses Ungeheuer von Feldflasche und füllte es mit einem fast schwarzen Rotwein an.“"
                                            },
                                            {
                                                "example_id": "a1cf1ff2-ffd1-4599-a16b-8a07e8143bb4",
                                                "sense_id": "b119b1b6-e337-3f56-ab71-461d7146d15b",
                                                "text": "„Er nestelte an seinem Koppel und brachte die Feldflasche hervor und reichte sie herum.“"
                                            },
                                            {
                                                "example_id": "78b8aa60-ea71-4a23-8c14-722422f906a6",
                                                "sense_id": "b119b1b6-e337-3f56-ab71-461d7146d15b",
                                                "text": "„Sie nahm die Feldflasche, trank und schüttelte sich, als sie den puren Whisky schluckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ef422cf-7034-4f4a-a077-81021b8cb02f",
                        "source_entry_id": "ffb00a55-28b5-36de-83eb-dec31b11b8d5",
