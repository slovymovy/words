                    {
                        "translation_id": "11f2601f-8471-4d42-b5aa-849b84ebef3d",
                        "source_entry_id": "adcc00e7-9dda-380f-883b-110962925dba",
                        "source_sense_id": "ac015ea7-546e-38fd-98f2-1069066d5f67",
