{
    "word_family": [
        "recite",
        "recital",
        "recitative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bec46379-3395-3de6-8111-6a23b33e95cf",
                    "sense_definition": "The act of speaking something aloud from memory in front of an audience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student gave a moving <w>recitation</w> of the poem during the school assembly.",
                            "target_lang_translations": {
                                "zh": "学生在学校集会上<w>朗诵</w>了那首诗，非常感人。"
                            }
                        },
                        {
                            "text": "Her <w>recitation</w> of the historical speech was flawless and very impressive.",
                            "target_lang_translations": {
                                "zh": "她对那篇历史演讲的<w>背诵</w>完美无瑕，令人印象深刻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "declamation",
                        "delivery"
                    ],
                    "common_phrases": [
                        "public recitation"
                    ],
                    "target_lang_definitions": {
                        "zh": "在观众面前背诵或朗诵某段文字的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "朗诵",
                                "target_lang_sense_clarification": "指有感情地背诵或宣读文学作品。"
                            },
                            {
                                "target_lang_word": "背诵",
                                "target_lang_sense_clarification": "指凭记忆复述文字。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1052be93-a836-3c5e-80c0-8748a4a84c9b",
                    "sense_definition": "A small class session where students discuss material previously presented in a lecture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students must attend the weekly <w>recitation</w> to review the complex physics problems.",
                            "target_lang_translations": {
                                "zh": "学生必须参加每周的<w>辅导课</w>来复习复杂的物理题。"
                            }
                        },
                        {
                            "text": "The professor led a lively <w>recitation</w> to clarify the main points of the lecture.",
                            "target_lang_translations": {
                                "zh": "教授主持了一场生动的<w>讨论课</w>，以澄清讲座的要点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tutorial",
                        "seminar"
                    ],
                    "common_phrases": [
                        "recitation section"
                    ],
                    "target_lang_definitions": {
                        "zh": "大学里针对讲座内容进行讨论或练习的小型辅导课。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辅导课",
                                "target_lang_sense_clarification": "指针对课程内容进行复习和答疑的小班教学。"
                            },
                            {
                                "target_lang_word": "讨论课",
                                "target_lang_sense_clarification": "指学生参与讨论和练习的教学环节。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49a7fec8-1350-3871-a6dc-e256b77a6373",
                    "sense_definition": "A section of a song where the lyrics are spoken instead of being sung.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The song features a dramatic <w>recitation</w> in the middle that adds emotional depth.",
                            "target_lang_translations": {
                                "zh": "这首歌中间有一段戏剧性的<w>念白</w>，增加了情感深度。"
                            }
                        },
                        {
                            "text": "The artist chose a spoken <w>recitation</w> to emphasize the importance of the lyrics.",
                            "target_lang_translations": {
                                "zh": "艺术家选择用<w>念白</w>来强调歌词的重要性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "歌曲中以说话方式而非演唱方式呈现的段落。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "念白",
                                "target_lang_sense_clarification": "指音乐或戏剧中以说话语调呈现的台词。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d40a80bc-8173-33e8-8a8e-36300fd3e499",
                    "sense_definition": "The specific text or words that are being spoken aloud.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He practiced the <w>recitation</w> until he knew every word by heart.",
                            "target_lang_translations": {
                                "zh": "他练习那段<w>台词</w>，直到能背下每一个字。"
                            }
                        },
                        {
                            "text": "The actor struggled to memorize the long <w>recitation</w> for the final scene.",
                            "target_lang_translations": {
                                "zh": "演员费力地背诵着最后一幕的长<w>台词</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "script",
                        "text"
                    ],
                    "target_lang_definitions": {
                        "zh": "被背诵或朗诵的具体文字内容。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "台词",
                                "target_lang_sense_clarification": "指演员需要背诵和表演的文字。"
                            },
                            {
                                "target_lang_word": "诵读内容",
                                "target_lang_sense_clarification": "指需要背诵的特定文本。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22cde048-06f0-3d97-a014-b9e59c534d2f",
                    "sense_definition": "A detailed list or account of facts or items.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "listing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report included a dry <w>recitation</w> of the company's financial losses over the year.",
                            "target_lang_translations": {
                                "zh": "报告中枯燥地<w>列举</w>了公司全年的财务亏损。"
                            }
                        },
                        {
                            "text": "His <w>recitation</w> of the events was accurate but lacked any personal insight.",
                            "target_lang_translations": {
                                "zh": "他对事件的<w>陈述</w>虽然准确，但缺乏个人见解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enumeration",
                        "listing",
                        "account"
                    ],
                    "target_lang_definitions": {
                        "zh": "对事实或项目进行的详细列举或陈述。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "陈述",
                                "target_lang_sense_clarification": "指对事实的叙述。"
                            },
                            {
                                "target_lang_word": "列举",
                                "target_lang_sense_clarification": "指逐一罗列事实或数据。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}