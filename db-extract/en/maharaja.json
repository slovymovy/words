                                        "entry_id": "600f50d2-a55d-38b8-865a-11e90bdde4f0",
                                        "glosses": [
                                            "Roi en Inde, suzerain d’autres rajas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f932c8dd-e001-4be4-bb7e-9147a8b487e4",
                                                "sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                                                "text": "Le maharaja de Mysore."
                                            },
                                            {
                                                "example_id": "45f40a32-50d8-4d51-a9d9-542753bf1fdf",
                                                "sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                                                "text": "Le maharaja n’avait pas 30 ans ; il avait été l’élève ; de Rachmaninov, mais il avait dû renoncer à une carrière de pianiste pour succéder à son père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60210c23-1d07-46ed-ba5f-989c5be99b94",
                        "source_entry_id": "db6918e1-eddd-308b-9e7d-0b83c9399501",
                        "source_sense_id": "27519dde-ab61-34d4-ae61-e2aaeefddd5f",
                        "source_sense_description": "a Hindu prince ranking above a raja",
                        "target_lang_word": "Maharadscha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maharadscha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef94fd27-5853-37fc-b798-f83cf7b7ea34",
                                        "entry_id": "8f620fa0-0bfa-355f-b31b-ad85edbedff7",
                                        "glosses": [
                                            "Herrschertitel eines indischen Großfürsten"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3062e080-713c-41e0-bd8b-c88fa3cc80be",
                                                "sense_id": "ef94fd27-5853-37fc-b798-f83cf7b7ea34",
                                                "text": "Der Maharaja regiert einen Fürstenstaat."
                                            },
                                            {
                                                "example_id": "949a9f75-fc18-4772-a3a0-b5f79cf60c53",
                                                "sense_id": "ef94fd27-5853-37fc-b798-f83cf7b7ea34",
                                                "text": "„Er bekam kein Bakschisch. – Auf dem Bahnsteig empfing mich der Zugführer selbst, ein sehr höflicher Herr. »Wie? Der Sahib wollen Mittelklasse fahren? Bitte, steigen Sie ein in die erste Klasse. Sie ist ganz leer. Kein Mensch fährt je darin, außer denen, die nichts bezahlen, und hie und da einmal der Vizekönig oder ein Maharadscha. Zwanzig Rupien bis Delhi –«. Das Angebot war verlockend.“"
                                            },
                                            {
                                                "example_id": "2d79fa50-ddc8-4b20-bc5a-f87156c8164a",
                                                "sense_id": "ef94fd27-5853-37fc-b798-f83cf7b7ea34",
                                                "text": "„Durch seine Wahl zum Maharadscha von ganz Bhutan 1907 wurde das Land vereint, unabhängig und in eine erbliche Monarchie umgewandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8119f311-458c-34a1-82c2-8442acdd39f7",
                                        "entry_id": "8f620fa0-0bfa-355f-b31b-ad85edbedff7",
                                        "glosses": [
                                            "Träger des unter [1] beschriebenen Titels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b58dce2-a623-4c43-8063-0884e51d93e2",
                                                "sense_id": "8119f311-458c-34a1-82c2-8442acdd39f7",
                                                "text": "„Bis 1947 war Kaschmir das größte von rund 500 \"Fürstentümern\" unter britischer Herrschaft. Die Bevölkerung war vorwiegend muslimisch, Herrscher aber war der Hindu Maharadscha Hari Singh.“"
                                            },
                                            {
                                                "example_id": "ef227054-818d-4aad-911d-d0b625d534bc",
                                                "sense_id": "8119f311-458c-34a1-82c2-8442acdd39f7",
                                                "text": "„Für den Maharadscha von Alwar und die anderen 20 Fürsten, die die britische Seite unterstützt hatten, spielte der Übergang vom privaten zum staatlichen Imperialismus keine große Rolle.“"
                                            },
                                            {
                                                "example_id": "f9daa3bc-f1d0-4e0a-8024-045a6b8040fa",
                                                "sense_id": "8119f311-458c-34a1-82c2-8442acdd39f7",
                                                "text": "„Auf Platz 8 saß der Maharadscha eines kleinen indischen Staates, der vermutlich sein im Krieg gewonnenes Sterling-Vermögen im Hintergrund hatte.“"
                                            },
                                            {
                                                "example_id": "5ddaec44-8c9e-4166-b566-fa82b73bba9b",
                                                "sense_id": "8119f311-458c-34a1-82c2-8442acdd39f7",
                                                "text": "„Adam schaute und sah, daß Mary neben dem Maharadscha von Pukkapore saß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
