                    {
                        "sense_id": "4c064291-6111-3d9c-9459-1029951f6f9f",
                        "entry_id": "5cddcf1d-ef0b-3384-a3e0-d95f876189a6",
                        "glosses": [
                            "To use again something that is considered past its usefulness (usually for something else)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10b31df5-4bef-401a-ae05-0393fa5ba0c0",
                                "sense_id": "4c064291-6111-3d9c-9459-1029951f6f9f",
                                "text": "The students reused empty plastic bottles in their science experiment."
                            }
                        ]
                    },
                    {
                        "sense_id": "81da86e7-33d1-3507-932b-84e96d8323f7",
                        "entry_id": "5cddcf1d-ef0b-3384-a3e0-d95f876189a6",
                        "glosses": [
                            "To use again, or in another place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9067a248-17c0-42fa-b2d3-ddca9d043f7e",
                                "sense_id": "81da86e7-33d1-3507-932b-84e96d8323f7",
                                "text": "The estimated 2.7 million cubic metres of chalk and flint excavated from each tunnel (and then mixed with water to create slurry) will be treated and then reused to landscape the site and create a 127-hectare chalk grassland habitat."
                            }
                        ]
                    }
