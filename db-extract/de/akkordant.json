                            {
                                "example_id": "7334906b-4e42-44cb-8e2d-e5368cbbf7fa",
                                "sense_id": "f8c010a9-d7a3-37a0-8fb9-02758f1fab3c",
                                "text": "„Bei der Berechnung der notwendigen Taglöhner und Akkordanten muß von vorneherein ein Unterschied nach den Jahreszeiten gemacht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
