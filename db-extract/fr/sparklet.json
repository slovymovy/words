                        "entry_id": "3f043506-f329-36a2-afd4-b00b1efd29c0",
                        "glosses": [
                            "Sparclette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ab9b8c7-e62a-4c9b-8b2d-1a4ec96a849d",
                                "sense_id": "f4a30c82-da06-3f2d-a2e7-87bdb023d2c3",
                                "text": "Mais il est à noter que pour les extincteurs à pression constante, ils n'ont pas besoin d'un sparklet à gaz."
                            },
                            {
                                "example_id": "80f1b6a0-3638-44a2-93f7-d07520ba6503",
                                "sense_id": "f4a30c82-da06-3f2d-a2e7-87bdb023d2c3",
                                "text": "Il est formé tout simplement d'un ballon en caoutchouc dans lequel on introduit, au moyen d'un sparklet, de l'acide carbonique qu'on fait dégager ensuite dans la narine."
                            },
                            {
                                "example_id": "6f944685-5773-40d2-9daa-c9b9ab2fba66",
                                "sense_id": "f4a30c82-da06-3f2d-a2e7-87bdb023d2c3",
                                "text": "A chaque extrémité du fusible est placé un sparklet dont le bouchon fond sous l'influence de l'arc qui se forme dès que le fusible a sauté. L'explosion du sparklet a pour effet d'éteindre l'arc aussitôt."
                            }
                        ]
                    }
