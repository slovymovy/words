                "senses": [
                    {
                        "sense_id": "03b3a488-fd26-36ef-b80b-4209eddcb76d",
                        "entry_id": "1805b3ab-61ca-3da3-b2a8-8bf22c3b0e08",
                        "glosses": [
                            "erneute Beurteilung oder Einschätzung (Bewertung), oft aufgrund neuer Informationen oder veränderter Umstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f05ebc7-53f0-4877-8239-a76752cb27e2",
                                "sense_id": "03b3a488-fd26-36ef-b80b-4209eddcb76d",
                                "text": "„Die Neubewertung ist nun in zweierlei Hinsicht unabdingbar.“"
                            },
                            {
                                "example_id": "8bfa3ba4-8516-4701-8762-34368856378b",
                                "sense_id": "03b3a488-fd26-36ef-b80b-4209eddcb76d",
                                "text": "„Jede Druck- oder Temperaturänderung, jede Veränderung eines Verbrauchers führt zwangsläufig zu einer Neubewertung der Transportsituation und damit zu einem potenziellen Engpass.“"
                            },
                            {
                                "example_id": "f68e25fe-fdba-47ce-a7de-6c9722622e6b",
                                "sense_id": "03b3a488-fd26-36ef-b80b-4209eddcb76d",
                                "text": "„Für die Neubewertung der Grundstücke wird eine Grundsteuererklärung von jedem Eigentümer eines Grundstücks oder Immobilie benötigt.“"
                            },
                            {
                                "example_id": "88207800-4f29-4727-82e8-7b3fb1836786",
                                "sense_id": "03b3a488-fd26-36ef-b80b-4209eddcb76d",
                                "text": "„Wenn die gewählte Lösung nicht die gewünschten Ergebnisse bringt, kann eine Neubewertung und Änderung des Ansatzes erforderlich sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
