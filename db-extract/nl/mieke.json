                                "example_id": "44e19639-160e-47c8-9d56-c062206827f5",
                                "sense_id": "51c0a52d-d3e4-3110-a3d4-24a9ba471a6d",
                                "text": "\"Wij zouden om de haverklap een klacht kunnen indienen omdat er een mieke in ons gat knijpt.\"https://www.demorgen.be/nieuws/sergio-en-sam-gooris-wij-zouden-om-de-haverklap-een-klacht-kunnen-indienen-omdat-er-een-mieke-in-ons-gat-knijpt~bfa7b536/",
                                "translation": "\"We could file a complaint every time a girl squeezes our bums.\"",
                                "english": "\"We could file a complaint every time a girl squeezes our bums.\""
                            },
                            {
                                "example_id": "4ef42781-4242-4fdc-885d-b62f177bf16a",
                                "sense_id": "51c0a52d-d3e4-3110-a3d4-24a9ba471a6d",
                                "text": "\"Het is een mieke, dus die hebben we niet nodig.\"https://www.humo.be/nieuws/veel-mannelijke-dj-s-zien-ons-als-stielbedervers-jonge-leeuwen-dj-duo-2empress-uit-the-sky-is-the-limit~bf5dd15d/",
                                "translation": "\"It's a girl so we don't need her.\"",
                                "english": "\"It's a girl so we don't need her.\""
                            },
                            {
                                "example_id": "d4e65e3d-ce80-4e47-89ef-b308bdeb374f",
                                "sense_id": "51c0a52d-d3e4-3110-a3d4-24a9ba471a6d",
                                "text": "\"Een schoon mieke en ze is nog zo jong.\"https://www.standaard.be/cnt/dmf20200624_05000595",
                                "translation": "\"She's a beautiful girl and still so young.\"",
                                "english": "\"She's a beautiful girl and still so young.\""
                            }
                        ]
                    }
