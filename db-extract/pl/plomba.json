                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f342285-bb3a-3f7d-92ac-de0c818fe983",
                                        "entry_id": "c4493a5b-5695-3cb5-9a36-4cf8d8304989",
                                        "glosses": [
                                            "Zahnfüllung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45359b91-4667-4875-a5bb-0dbdf1392b5b",
                                                "sense_id": "8f342285-bb3a-3f7d-92ac-de0c818fe983",
                                                "text": "Der Zahnarzt erneuerte die Plombe des Weisheitszahns."
                                            },
                                            {
                                                "example_id": "071e58f9-3049-447a-825d-a5cce52f3d59",
                                                "sense_id": "8f342285-bb3a-3f7d-92ac-de0c818fe983",
                                                "text": "„Der Wirt schmeckt an seiner Plombe, man muß den Stieglitz mehr ans Fenster rücken, solch Tierchen will auch ein bißchen Licht.“"
                                            },
                                            {
                                                "example_id": "a88088be-771b-4187-85fb-d7a1941ca01c",
                                                "sense_id": "8f342285-bb3a-3f7d-92ac-de0c818fe983",
                                                "text": "„Wenn man ihn sah, erschrak man sofort über seinen riesigen aufgerissenen Mund mit den zahlreichen Plomben im Gebiß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
