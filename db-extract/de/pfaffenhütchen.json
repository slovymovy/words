                "senses": [
                    {
                        "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                        "entry_id": "ac3d6c4f-a0d1-3473-a3b3-851de96f4e2b",
                        "glosses": [
                            "einige giftige Sträucher aus der Pflanzengattung Euonymus, insbesondere Euonymus europaeus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "599f76fe-1216-4563-a343-f774522c439c",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "Dort steht ein Pfaffenhütchen am Wegesrand."
                            },
                            {
                                "example_id": "883e49b5-816b-429d-adf7-5df56dcb4458",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "„[…] Haselnuss und Pfaffenhütchen genügt ein halbschattiger Standort […].“"
                            },
                            {
                                "example_id": "e3dce721-321d-452b-b761-39aa88cf5314",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "„Das Pfaffenhütchen ist einer unserer häufigsten heimischen Sträucher. Aus seinem zähen Holz wurden früher Orgelpfeifen, Schuhnägel und Stricknadeln hergestellt.“"
                            },
                            {
                                "example_id": "9d1264e9-a768-431d-8109-8977e37cef18",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "„[…] ein fruchtendes Pfaffenhütchen [braucht] absolut keinen Vergleich mit teuren Exoten oder Zuchtformen zu scheuen.“"
                            },
                            {
                                "example_id": "b7636759-52b1-4405-b1bc-cc9e816279f6",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "„Die giftigen Pfaffenhütchen sind sehr dekorativ, es sollte aber darauf geachtet werden, das Kinder die Früchte nicht essen.“"
                            },
                            {
                                "example_id": "4194e8df-7b4d-43fd-9852-93c09ee59d72",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "„Der Gewöhnliche Spindelstrauch (Pfaffenhütchen) erreicht als […] Strauch Wuchshöhen von bis zu 3 m, als kleiner Baum auch bis zu 6 m. Die Pflanzenteile sind giftig.“"
                            },
                            {
                                "example_id": "103015ed-7bf0-4b2d-a9de-d0d527dda4fa",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "„Wenn die Farben im Garten so langsam verblassen leuchten die Früchte des Pfaffenhütchens noch bis in den Winter in Rosa-Orange-Rottönen und locken eine große Zahl gefiederter Besucher an.“"
                            },
                            {
                                "example_id": "793d5e65-8ed5-436a-b69f-37c32f6ff191",
                                "sense_id": "3466d025-7076-393a-9f4c-c98a8fcc04c0",
                                "text": "„Das für Menschen äußerst giftige Pfaffenhütchen (Achtung bei Kleinkindern!) ist für Rotkehlchen eine beliebte Winternahrung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
