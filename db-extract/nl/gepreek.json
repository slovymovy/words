                "senses": [
                    {
                        "sense_id": "9d7ee559-8247-386c-a27f-0e9472f95896",
                        "entry_id": "aa1d043f-11c0-3f71-ae35-1ed07f58cfb2",
                        "glosses": [
                            "aanhoudend iemand of een groep van mensen vermanend toespreken; aanhoudend mensen de les lezen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9c551fed-7fca-4f9e-b9f3-3214f9e5f77d",
                                "sense_id": "9d7ee559-8247-386c-a27f-0e9472f95896",
                                "text": "En ook het gepreek, waar zijn vader zo beroemd om was, is hem niet vreemd: zo houdt hij een tirade tegen de Nigeriaanse regering, gevolgd door een liefdesverklaring aan marihuana ('plant the seed and let it grow')."
                            },
                            {
                                "example_id": "229a4f37-8cc9-4e60-abba-b20f3a254358",
                                "sense_id": "9d7ee559-8247-386c-a27f-0e9472f95896",
                                "text": "Diezelfde politici zijn kennelijk vergeten, dat er veel essentiële overheids- en zorgtaken zijn overgeheveld naar de gemeenten. En, nu komt de beroemde aap uit de mouw: de goed opgeleide Nederlander heeft geen gepreek meer nodig van deze Haagse regenten."
                            }
                        ]
                    }
