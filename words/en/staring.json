{
    "word_family": [
        "stare",
        "starer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c5d298d-253b-3b6b-a5ec-0d5a0294d525",
                    "sense_definition": "Present participle and gerund of <w>stare</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>staring</w> out the window and did not hear me enter the room.",
                            "target_lang_translations": {
                                "ru": "Она <w>пристально смотрела</w> в окно и не услышала, как я вошел в комнату.",
                                "fr": "Elle <w>fixait</w> la fenêtre et ne m'a pas entendu entrer dans la pièce."
                            }
                        },
                        {
                            "text": "It is rude to keep <w>staring</w> at people you do not know.",
                            "target_lang_translations": {
                                "ru": "Невежливо продолжать <w>глазеть</w> на людей, которых вы не знаете.",
                                "fr": "Il est impoli de continuer à <w>fixer</w> les gens que vous ne connaissez pas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "staring at",
                        "staring into space",
                        "staring blankly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола stare (пристально смотреть).",
                        "fr": "Participe présent et gérondif du verbe « stare » (fixer du regard)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристально смотреть",
                                "target_lang_sense_clarification": "смотреть внимательно, не отрываясь"
                            },
                            {
                                "target_lang_word": "уставиться",
                                "target_lang_sense_clarification": "смотреть в упор (часто разговорное)"
                            },
                            {
                                "target_lang_word": "глазеть",
                                "target_lang_sense_clarification": "смотреть с праздным любопытством (разговорное)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "fixer",
                                "target_lang_sense_clarification": "regarder intensément"
                            },
                            {
                                "target_lang_word": "dévisager",
                                "target_lang_sense_clarification": "regarder quelqu'un avec insistance"
                            },
                            {
                                "target_lang_word": "lorgner",
                                "target_lang_sense_clarification": "regarder avec curiosité ou envie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d894f00e-92f9-39af-834a-1a5bf44bfdd2",
                    "sense_definition": "Looking fixedly with wide-open eyes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doll had large, <w>staring</w> eyes that seemed to follow me around the room.",
                            "target_lang_translations": {
                                "ru": "У куклы были большие, <w>широко раскрытые</w> глаза, которые, казалось, следили за мной по всей комнате.",
                                "fr": "La poupée avait de grands yeux <w>écarquillés</w> qui semblaient me suivre dans la pièce."
                            }
                        },
                        {
                            "text": "He gave me a <w>staring</w> look that made me feel very uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Он бросил на меня <w>пристальный</w> взгляд, от которого мне стало очень не по себе.",
                                "fr": "Il m'a lancé un regard <w>fixe</w> qui m'a mis très mal à l'aise."
                            }
                        }
                    ],
                    "synonyms": [
                        "unblinking",
                        "fixed",
                        "gazing"
                    ],
                    "common_phrases": [
                        "staring eyes",
                        "staring look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смотрящий пристально, с широко открытыми глазами.",
                        "fr": "Qui regarde fixement avec les yeux grands ouverts."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристальный",
                                "target_lang_sense_clarification": "о взгляде"
                            },
                            {
                                "target_lang_word": "широко раскрытый",
                                "target_lang_sense_clarification": "о глазах"
                            },
                            {
                                "target_lang_word": "немигающий",
                                "target_lang_sense_clarification": "о неподвижном взгляде"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "fixe",
                                "target_lang_sense_clarification": "se dit d'un regard immobile"
                            },
                            {
                                "target_lang_word": "écarquillé",
                                "target_lang_sense_clarification": "se dit des yeux grands ouverts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "342ad1ff-2817-395c-b201-98decf22142f",
                    "sense_definition": "Shining; vivid, garish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "visual_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted in a <w>staring</w> white that hurt my eyes in the sunlight.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в <w>ослепительно</w> белый цвет, от которого на солнце болели глаза.",
                                "fr": "Les murs étaient peints d'un blanc <w>éblouissant</w> qui me faisait mal aux yeux au soleil."
                            }
                        },
                        {
                            "text": "She wore a <w>staring</w> red dress that attracted attention from everyone in the hall.",
                            "target_lang_translations": {
                                "ru": "На ней было <w>кричащее</w> красное платье, привлекавшее внимание всех в зале.",
                                "fr": "Elle portait une robe rouge <w>criarde</w> qui a attiré l'attention de tout le monde dans la salle."
                            }
                        }
                    ],
                    "synonyms": [
                        "garish",
                        "gaudy",
                        "loud"
                    ],
                    "antonyms": [
                        "dull",
                        "muted"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий, бросающийся в глаза, кричащий (о цвете).",
                        "fr": "Brillant, vif, criard (en parlant d'une couleur)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "чрезмерно яркий, безвкусный"
                            },
                            {
                                "target_lang_word": "ослепительный",
                                "target_lang_sense_clarification": "очень яркий"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "раздражающий глаз"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "criard",
                                "target_lang_sense_clarification": "couleur trop vive et désagréable"
                            },
                            {
                                "target_lang_word": "éblouissant",
                                "target_lang_sense_clarification": "très brillant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4daca37a-d2f9-3d18-97e6-d8c732afeba9",
                    "sense_definition": "Sensational, lurid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "visual_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper published a <w>staring</w> headline about the scandal to boost sales.",
                            "target_lang_translations": {
                                "ru": "Газета опубликовала <w>кричащий</w> заголовок о скандале, чтобы поднять продажи.",
                                "fr": "Le journal a publié un titre <w>sensationnel</w> sur le scandale pour augmenter les ventes."
                            }
                        },
                        {
                            "text": "He refused to listen to another <w>staring</w> story about the local ghosts.",
                            "target_lang_translations": {
                                "ru": "Он отказался слушать очередную <w>сенсационную</w> историю о местных привидениях.",
                                "fr": "Il a refusé d'écouter une autre histoire <w>sensationnelle</w> sur les fantômes locaux."
                            }
                        }
                    ],
                    "synonyms": [
                        "sensational",
                        "lurid"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сенсационный, вызывающий (о заголовках или историях).",
                        "fr": "Sensationnel, provocateur (en parlant de titres ou d'histoires)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "привлекающий внимание (о заголовках)"
                            },
                            {
                                "target_lang_word": "сенсационный",
                                "target_lang_sense_clarification": "рассчитанный на внешний эффект"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sensationnel",
                                "target_lang_sense_clarification": "qui cherche à faire sensation"
                            },
                            {
                                "target_lang_word": "provocateur",
                                "target_lang_sense_clarification": "qui attire l'attention de manière insistante"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24557218-2c48-3811-8ae6-40f8ac9aa247",
                    "sense_definition": "The act of one who stares.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>starings</w> during the meeting made his colleagues feel self-conscious.",
                            "target_lang_translations": {
                                "ru": "Его постоянное <w>глазение</w> во время собрания заставляло коллег чувствовать себя неловко.",
                                "fr": "Ses <w>regards fixes</w> constants pendant la réunion ont mis ses collègues mal à l'aise."
                            }
                        },
                        {
                            "text": "The awkward <w>starings</w> between the two strangers lasted until the train arrived.",
                            "target_lang_translations": {
                                "ru": "Неловкие <w>переглядывания</w> между двумя незнакомцами продолжались до прибытия поезда.",
                                "fr": "Les <w>regards fixes</w> gênants entre les deux inconnus ont duré jusqu'à l'arrivée du train."
                            }
                        }
                    ],
                    "synonyms": [
                        "gazing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие того, кто пристально смотрит; пристальный взгляд.",
                        "fr": "L'action de fixer quelqu'un ou quelque chose du regard."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристальный взгляд",
                                "target_lang_sense_clarification": "процесс или результат смотрения"
                            },
                            {
                                "target_lang_word": "глазение",
                                "target_lang_sense_clarification": "разговорное, неодобрительное"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "regard fixe",
                                "target_lang_sense_clarification": "action de regarder sans bouger"
                            },
                            {
                                "target_lang_word": "fixation",
                                "target_lang_sense_clarification": "action de fixer du regard"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
