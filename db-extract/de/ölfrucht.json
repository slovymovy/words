                ],
                "senses": [
                    {
                        "sense_id": "271b24e3-3313-3560-a7b5-8d771670bbae",
                        "entry_id": "b4ba5020-2063-3e7e-a749-2c7aebca16eb",
                        "glosses": [
                            "Teil einer Pflanze, aus dem Speiseöl gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43bfd451-c5ff-4d0f-9ced-1680389f9847",
                                "sense_id": "271b24e3-3313-3560-a7b5-8d771670bbae",
                                "text": "Die Karriere der Sojabohne, so zeigt Langthaler, bewegte sich stets in einem Spannungsfeld zwischen ihrer Nutzung als Gemüse bzw. Ölfrucht."
                            },
                            {
                                "example_id": "115de960-38a2-4ec8-8e30-3d19336cedc9",
                                "sense_id": "271b24e3-3313-3560-a7b5-8d771670bbae",
                                "text": "Sehr empfehlenswert sind rohe oder geröstete Nüsse, Nussmuse, Ölsamen und Ölfrüchte, allerdings in mäßigen Mengen im Rahmen der empfohlenen Gesamtfettaufnahme."
                            },
                            {
                                "example_id": "ca033cfc-e80c-4206-a2a1-7a2060a04503",
                                "sense_id": "271b24e3-3313-3560-a7b5-8d771670bbae",
                                "text": "Ölfrüchte oder Textilpflanzen bringen dem Exportland Devisen, ohne die es keine Lebensmittel importieren könnte, ohne die es noch mehr Schulden machen müßte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
