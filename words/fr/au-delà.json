    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "abb4ee46-3202-331d-91ac-a530ba155fa0",
                    "sense_definition": "Plus loin que, de l'autre côté d'une limite spatiale ou figurative.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espace_et_limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le village s'étend bien <w>au-delà</w> de la colline que l'on aperçoit."
                        },
                        {
                            "text": "Cette décision a des conséquences qui vont <w>au-delà</w> de nos espérances."
                        }
                    ],
                    "antonyms": [
                        "en deçà"
                    ],
                    "common_phrases": [
                        "au-delà des frontières",
                        "au-delà des limites",
                        "au-delà des espérances"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fdaafc7c-6970-36ed-a39c-b657ce077921",
                    "sense_definition": "À une plus grande distance dans l'espace ou dans le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_et_limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous pensions nous arrêter ici, mais le sentier continue bien <w>au-delà</w>."
                        },
                        {
                            "text": "Il se rappelle ses cinq ans, mais ses souvenirs ne remontent pas <w>au-delà</w>."
                        }
                    ],
                    "antonyms": [
