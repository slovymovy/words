                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "88ba9211-e7e4-47c6-8f02-cf5e31769e03",
                        "entry_id": "0b757476-cd5c-320d-a17b-87e4c60b49a8",
