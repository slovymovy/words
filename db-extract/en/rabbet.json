                        "target_lang_word": "Falz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "014e9949-3c3f-3a58-afe9-64c3fbea80d3",
                                        "entry_id": "5804682a-615e-3c9b-ac34-03e64ce1794a",
                                        "glosses": [
                                            "Kante, die entsteht, wo ein Blatt Papier oder Ähnliches gefaltet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633d3c60-7080-4714-a4d4-fc8407531154",
                                                "sense_id": "014e9949-3c3f-3a58-afe9-64c3fbea80d3",
                                                "text": "Am besten ist es, wenn man mit dem Lineal noch einmal über den Falz streicht, damit dieser auch scharf wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46d9ae3a-d0b6-35ab-87c8-369b4999b992",
                                        "entry_id": "5804682a-615e-3c9b-ac34-03e64ce1794a",
                                        "glosses": [
                                            "senkrechte Vertiefung, wo Buchdeckel auf Buchrücken trifft"
                                        ],
                                        "tags": [
                                            "Buchbinderei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd22f2f1-4e15-4e89-b95f-7a0f51cdd062",
                                                "sense_id": "46d9ae3a-d0b6-35ab-87c8-369b4999b992",
                                                "text": "Schau mal, diese Rille hier, das ist der Falz, er ist nur 5 mm breit und verläuft völlig parallel zum Buchrücken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6610c00c-7e7b-3a63-b095-e86ffee80acd",
                                        "entry_id": "5804682a-615e-3c9b-ac34-03e64ce1794a",
                                        "glosses": [
                                            "Wulst, die entsteht, wo zwei Blechteile aneinandergefügt sind, zum Beispiel oben und unten an einer Blechdose"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ea2b95-46b8-4099-b24f-34cbb13c7074",
                                                "sense_id": "6610c00c-7e7b-3a63-b095-e86ffee80acd",
                                                "text": "An einem Auto gibte es viele Falze zu entdecken, also gefalzte Blechkanten an den Anbauteilen wie Türen, Motorhaube oder Heckdeckel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c2661f60-b468-313a-9069-e99f430b2157",
                                        "entry_id": "5804682a-615e-3c9b-ac34-03e64ce1794a",
                                        "glosses": [
                                            "Stufe im Rand eines flachen Körpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12733990-a918-4d97-bf7f-82bc14669177",
                                                "sense_id": "c2661f60-b468-313a-9069-e99f430b2157",
                                                "text": "„Der Glasfalz ist zweyerley; entweder bildet derselbe eine wirkliche Rinne (ganzer Glasfalz), oder nur einen halben Falz […], in welch letzterem Falle jedoch die Glastafeln verkittet werden müssen, daher man diesen auch Kittfalz nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "61302ef3-eaa5-3a89-bf7f-7e6f9dfe7b85",
                                        "entry_id": "5804682a-615e-3c9b-ac34-03e64ce1794a",
                                        "glosses": [
                                            "kleiner, schmaler Pergaminpapierstreifen, der mit einer Gummierung versehen ist und mit dem man Briefmarken auf einer Unterlage, zum Beispiel auf Karton oder Papier in einem Album, befestigen kann"
                                        ],
                                        "tags": [
                                            "Philatelie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef0c129-c160-4980-af7e-bd2a9f505d8f",
                                                "sense_id": "61302ef3-eaa5-3a89-bf7f-7e6f9dfe7b85",
                                                "text": "Briefmarkensammler vermeiden es heutzutage, Falze zu benutzen, da sie den Wert von Briefmarken beeinträchtigen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
