                                    {
                                        "sense_id": "07940b59-1ef9-314d-b95d-28388c0ce1c8",
                                        "entry_id": "19deb1bb-02c9-34b1-94bf-f7ce01f80d1e",
                                        "glosses": [
                                            "Qui est avant l’époque glaciaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aa51a6f-6bbc-4dce-8200-f61eed156bb8",
                                                "sense_id": "07940b59-1ef9-314d-b95d-28388c0ce1c8",
                                                "text": "Le climat sous l’influence duquel se développaient ces types primitifs de l’humanité était tempéré et préglaciaire, c’est-à-dire précédant le froid et l’humidité de l’époque glaciaire qui suivit."
                                            },
                                            {
                                                "example_id": "39d79258-5d5c-4851-ade8-dcc3dd12ee09",
                                                "sense_id": "07940b59-1ef9-314d-b95d-28388c0ce1c8",
                                                "text": "La description de Ch. Depéret touchant le cône d'alluvions préglaciaires se soudant vers l'amont aux dépôts morainiques de Vancia et se dirigeant à l'aval vers la vallée de Tassin doit être complétée."
                                            }
                                        ]
                                    }
                                ]
