                "senses": [
                    {
                        "sense_id": "995593d0-338e-3ba2-809f-239fb717b4e2",
                        "entry_id": "6eceed06-2f32-345d-994d-d6a74eff3786",
                        "glosses": [
                            "Bautechniker, der militärische Bauwerke plant und baut, die dann vom Militär genutzt werden"
                        ],
                        "tags": [
                            "Berufsbezeichnung veraltet"
                        ],
                        "examples": [
                            {
                                "example_id": "c68fd8e6-4278-4857-acbd-ccd51e5cfc6a",
                                "sense_id": "995593d0-338e-3ba2-809f-239fb717b4e2",
                                "text": "„Ausgebaut wurde die Feste Luxemburg durch den Militärbaumeister des französischen Sonnenkönigs, Sébastien le Prestre de Vauban.“"
                            },
                            {
                                "example_id": "0bf94e16-ac22-4ea4-aa69-fda54f38d70f",
                                "sense_id": "995593d0-338e-3ba2-809f-239fb717b4e2",
                                "text": "„Das für die Pläne zuständige preußische königliche Ingenieurkomitee Berlin orientierten sich an belgische Festungsbauten und an französische Inselforts des 17. Jahrhunderts, vor allem an den Bauten des Militärbaumeisters Vauban.“"
                            },
                            {
                                "example_id": "c27b3b0d-0911-4b73-81a7-f3e72d619003",
                                "sense_id": "995593d0-338e-3ba2-809f-239fb717b4e2",
                                "text": "„In den Jahren 1707 bis 1718 machte sich Maximilian Welsch, bis dahin Militärbaumeister in Diensten des Mainzer Kurfürsten, daran, diese Idee zu verwirklichen.“"
                            },
                            {
                                "example_id": "22a0b10e-b6d1-41a9-95e2-f8be64ad9c1e",
                                "sense_id": "995593d0-338e-3ba2-809f-239fb717b4e2",
                                "text": "„Er ließ den Herangewachsenen zum Militärbaumeister ausbilden und eine Familie gründen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
