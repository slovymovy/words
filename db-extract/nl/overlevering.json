                                    },
                                    {
                                        "sense_id": "42241fc4-7897-3055-8dcb-340c1c56ed30",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "The design and specification of a vessel."
                                        ],
                                        "tags": [
