            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2bdae190-098b-389c-94aa-39e8808d7d52",
                    "sense_definition": "czynić coś silniejszym, intensywniejszym lub bardziej odczuwalnym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensyfikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stres i brak snu tylko <w>potęgują</w> zmęczenie u pracowników.",
                            "target_lang_translations": {
                                "ru": "Стресс и недосыпание только <w>усиливают</w> усталость у сотрудников."
                            }
                        },
                        {
                            "text": "Cały krajobraz miał charakter strasznej martwoty, którą <w>potęgowały</w> gorąco i cisza.",
                            "target_lang_translations": {
                                "ru": "Весь пейзаж дышал жуткой мертвенностью, которую <w>усугубляли</w> жара и тишина."
                            }
                        }
                    ],
                    "synonyms": [
                        "wzmagać",
                        "wzmacniać",
                        "nasilać"
                    ],
                    "common_phrases": [
                        "potęgować strach",
                        "potęgować ból",
                        "potęgować wrażenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать что-либо сильнее, интенсивнее или ощутимее"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать сильнее"
                            },
                            {
                                "target_lang_word": "усугублять",
                                "target_lang_sense_clarification": "обострять негативное состояние"
                            },
                            {
                                "target_lang_word": "наращивать",
                                "target_lang_sense_clarification": "увеличивать интенсивность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57a916ff-3d13-33f0-9d63-a7d5a3aa321b",
                    "sense_definition": "podnosić liczbę lub wyrażenie algebraiczne do potęgi",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matematyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dzisiejszej lekcji matematyki nauczyciel pokazał nam, jak poprawnie <w>potęgować</w> ułamki zwykłe.",
                            "target_lang_translations": {
                                "ru": "На сегодняшнем уроке математики учитель показал нам, как правильно <w>возводить в степень</w> обыкновенные дроби."
                            }
                        },
                        {
                            "text": "Kiedy <w>potęgujesz</w> liczbę ujemną przez parzysty wykładnik, wynik jest zawsze dodatni.",
                            "target_lang_translations": {
                                "ru": "Когда <w>возводишь в степень</w> отрицательное число с чётным показателем, результат всегда положительный."
                            }
                        }
                    ],
                    "antonyms": [
                        "pierwiastkować"
                    ],
                    "common_phrases": [
                        "potęgować liczbę",
                        "potęgować do kwadratu"
                    ],
                    "target_lang_definitions": {
                        "ru": "возводить число или алгебраическое выражение в степень"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возводить в степень",
                                "target_lang_sense_clarification": "математическое действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c2e12e9-4942-370e-add8-21b295a3c4b7",
                    "sense_definition": "stawać się silniejszym, intensywniejszym lub gwałtowniejszym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensyfikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wraz z wiekiem u wielu osób <w>potęguje</w> <w>się</w> sztywność stawów.",
                            "target_lang_translations": {
                                "ru": "С возрастом у многих людей <w>усиливается</w> тугоподвижность суставов."
                            }
                        },
                        {
                            "text": "Niepokój w całym mieście <w>potęgował</w> <w>się</w> z każdą kolejną godziną oczekiwania.",
                            "target_lang_translations": {
                                "ru": "Тревога во всем городе <w>нарастала</w> с каждым новым часом ожидания."
                            }
                        }
                    ],
                    "synonyms": [
                        "nasilać się",
                        "wzmagać się",
                        "narastać"
                    ],
                    "common_phrases": [
                        "potęgować się z czasem",
                        "hałas potęguje się"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться сильнее, интенсивнее или острее"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливаться",
                                "target_lang_sense_clarification": "становиться сильнее"
                            },
                            {
                                "target_lang_word": "нарастать",
                                "target_lang_sense_clarification": "постепенно увеличиваться"
                            },
                            {
                                "target_lang_word": "усугубляться",
                                "target_lang_sense_clarification": "обостряться"
                            }
                        ]
                    }
