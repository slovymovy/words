                        "entry_id": "3999150a-e427-3063-a515-fa4b2ef6d608",
                        "glosses": [
                            "technika malarska polegająca na różnicowaniu natężenia światła i eksponowaniu jego kontrastów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac9c7ae-76ec-4de9-becd-051f14eb377d",
                                "sense_id": "bfb8f8b1-d983-34d7-9cf6-2087a06f3ec2",
                                "text": "Zastosowanie światłocienia daje wrażenie trójwymiarowości ukazywanych przedmiotów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cea6bf23-1c9a-3241-8565-9d2847f81607",
                        "entry_id": "3999150a-e427-3063-a515-fa4b2ef6d608",
                        "glosses": [
                            "efekt zastosowania światłocienia (1.1), rozłożenie światła i cienia na obrazie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60170f3e-e670-4040-9e13-ce7506f38231",
                                "sense_id": "cea6bf23-1c9a-3241-8565-9d2847f81607",
                                "text": "Światłocienie skupiają się na twarzy oraz nóżkach"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0cda11a5-0d1f-3245-bb1f-1bba8860a504",
                        "entry_id": "3999150a-e427-3063-a515-fa4b2ef6d608",
                        "glosses": [
                            "niejasność, brak wyrazistości"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "effa35f0-c949-4ac3-ab79-3d8e207e1b9d",
                                "sense_id": "0cda11a5-0d1f-3245-bb1f-1bba8860a504",
                                "text": "Do tych, co mają tak za tak, nie za nie — / Bez światłocienia, / Tęskno mi, Panie"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
