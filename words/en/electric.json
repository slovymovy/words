{
    "word_family": [
        "electricity",
        "electrician",
        "electrify",
        "electrification",
        "electronic",
        "electronics"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ddae64ab-d91f-33ee-b36c-4ddc395ca563",
                    "sense_definition": "Operated by, producing, or relating to electricity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "power_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to buy a new <w>electric</w> kettle for the kitchen.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новый <w>электрический</w> чайник на кухню.",
                                "nl": "We moeten een nieuwe <w>elektrische</w> waterkoker voor de keuken kopen."
                            }
                        },
                        {
                            "text": "The company plans to sell only <w>electric</w> cars by next year.",
                            "target_lang_translations": {
                                "ru": "Компания планирует продавать только <w>электрические</w> автомобили к следующему году.",
                                "nl": "Het bedrijf is van plan om tegen volgend jaar alleen nog maar <w>elektrische</w> auto's te verkopen."
                            }
                        }
                    ],
                    "synonyms": [
                        "electrical"
                    ],
                    "common_phrases": [
                        "electric car",
                        "electric light",
                        "electric power",
                        "electric shock",
                        "electric current"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работающий на электричестве, производящий его или относящийся к нему.",
                        "nl": "Werkend op, geproduceerd door of gerelateerd aan elektriciteit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электрический",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "elektrisch",
                                "target_lang_sense_clarification": "algemene term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56e229eb-2441-3ab5-a4bc-83be278c64c2",
                    "sense_definition": "Relating to a musical instrument that uses electricity to produce sound, rather than doing so naturally.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He plays the <w>electric</w> guitar in a famous rock band.",
                            "target_lang_translations": {
                                "ru": "Он играет на <w>электрической</w> гитаре в известной рок-группе.",
                                "nl": "Hij speelt <w>elektrische</w> gitaar in een bekende rockband."
                            }
                        },
                        {
                            "text": "An <w>electric</w> piano is much lighter than a traditional one.",
                            "target_lang_translations": {
                                "ru": "<w>Электрическое</w> пианино намного легче традиционного.",
                                "nl": "Een <w>elektrische</w> piano is veel lichter dan een traditionele."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric guitar",
                        "electric bass",
                        "electric piano"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыкальному инструменту, использующему электричество для усиления звука.",
                        "nl": "Met betrekking tot een muziekinstrument dat elektriciteit gebruikt om geluid te produceren, in plaats van dit op natuurlijke wijze te doen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электрический",
                                "target_lang_sense_clarification": "о музыкальных инструментах"
                            },
                            {
                                "target_lang_word": "электро-",
                                "target_lang_sense_clarification": "приставка в сложных словах (напр. электрогитара)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "elektrisch",
                                "target_lang_sense_clarification": "over muziekinstrumenten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "896c98a2-d31e-31bb-8df8-959ff45eb9a8",
                    "sense_definition": "Full of strong emotion, excitement, or tension; thrilling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion_excitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The atmosphere in the stadium was <w>electric</w> before the match began.",
                            "target_lang_translations": {
                                "ru": "Атмосфера на стадионе была <w>наэлектризованной</w> перед началом матча.",
                                "nl": "De sfeer in het stadion was <w>geladen</w> voordat de wedstrijd begon."
                            }
                        },
                        {
                            "text": "Her performance was <w>electric</w> and the audience cheered wildly.",
                            "target_lang_translations": {
                                "ru": "Ее выступление было <w>зажигательным</w>, и публика неистово аплодировала.",
                                "nl": "Haar optreden was <w>elektriserend</w> en het publiek juichte wild."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric atmosphere",
                        "electric performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный сильными эмоциями, возбуждением или напряжением; волнующий.",
                        "nl": "Vol sterke emotie, opwinding of spanning; zinderend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наэлектризованный",
                                "target_lang_sense_clarification": "об атмосфере или напряжении"
                            },
                            {
                                "target_lang_word": "зажигательный",
                                "target_lang_sense_clarification": "о выступлении или событии"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "geladen",
                                "target_lang_sense_clarification": "over sfeer of spanning"
                            },
                            {
                                "target_lang_word": "elektriserend",
                                "target_lang_sense_clarification": "over een optreden of sfeer"
                            },
                            {
                                "target_lang_word": "zinderend",
                                "target_lang_sense_clarification": "vol spanning en opwinding"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c6272f1-8044-387d-9a4c-8447703c48c9",
                    "sense_definition": "The supply of electric current to a building or area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "power_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>electric</w> went out during the heavy storm last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером во время сильной грозы отключилось <w>электричество</w>.",
                                "nl": "De <w>stroom</w> viel gisteravond uit tijdens de hevige storm."
                            }
                        },
                        {
                            "text": "How much do you usually pay for the <w>electric</w> each month?",
                            "target_lang_translations": {
                                "ru": "Сколько вы обычно платите за <w>электричество</w> каждый месяц?",
                                "nl": "Hoeveel betaal je meestal per maand voor <w>elektriciteit</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the electric",
                        "electric bill"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used instead of 'electricity'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подача электрического тока в здание или район.",
                        "nl": "De levering van elektrische stroom aan een gebouw of gebied."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электричество",
                                "target_lang_sense_clarification": "электроснабжение"
                            },
                            {
                                "target_lang_word": "свет",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "stroom",
                                "target_lang_sense_clarification": "elektriciteit, informeel"
                            },
                            {
                                "target_lang_word": "elektriciteit",
                                "target_lang_sense_clarification": "stroomvoorziening"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b77d3f1-45ad-35f9-86fe-b959a784e5e6",
                    "sense_definition": "A vehicle or machine that is powered by electricity, especially a train or car.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "power_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old steam trains were replaced by modern <w>electrics</w>.",
                            "target_lang_translations": {
                                "ru": "Старые паровозы были заменены современными <w>электровозами</w>.",
                                "nl": "De oude stoomtreinen werden vervangen door moderne <w>elektrische treinen</w>."
                            }
                        },
                        {
                            "text": "Many drivers are switching to <w>electrics</w> to help the environment.",
                            "target_lang_translations": {
                                "ru": "Многие водители переходят на <w>электромобили</w>, чтобы помочь окружающей среде.",
                                "nl": "Veel automobilisten stappen over op <w>elektrische auto's</w> om het milieu te helpen."
                            }
                        }
                    ],
                    "antonyms": [
                        "steam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство или машина, работающая на электричестве.",
                        "nl": "Een voertuig of machine die wordt aangedreven door elektriciteit, met name een trein of auto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электромобиль",
                                "target_lang_sense_clarification": "автомобиль"
                            },
                            {
                                "target_lang_word": "электровоз",
                                "target_lang_sense_clarification": "локомотив"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "elektrische auto",
                                "target_lang_sense_clarification": "voertuig"
                            },
                            {
                                "target_lang_word": "elektrische trein",
                                "target_lang_sense_clarification": "locomotief"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}