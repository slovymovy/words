                        "entry_id": "41f640f6-f401-3d1d-8c8e-bcbec44840a2",
                        "glosses": [
                            "Hauptgang bei einem ausgedehntem Mittag- oder Abendessen, der nach der Vorspeise und vor dem Nachtisch serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "558ec8a5-73d2-4133-b415-07b58f31ddc3",
                                "sense_id": "6f2729e1-cdf4-3a1b-8c95-e18e73fa89ca",
                                "text": "Als Hauptspeise gibt es Schweinebraten mit Knödeln."
                            },
                            {
                                "example_id": "27ee3c50-6731-4648-87bf-2c7088fbaba8",
                                "sense_id": "6f2729e1-cdf4-3a1b-8c95-e18e73fa89ca",
                                "text": "„Nach der Hauptspeise ergriff sie dann das Mikrofon.“"
                            }
