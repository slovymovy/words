                "senses": [
                    {
                        "sense_id": "5bcc23b3-edb3-31be-9a50-afda30ba613d",
                        "entry_id": "26cf24b0-5755-314d-8273-12539b021867",
                        "glosses": [
                            "Faire perdre son caractère diplomatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c924e811-377e-4194-8236-ad7faee89850",
                                "sense_id": "5bcc23b3-edb3-31be-9a50-afda30ba613d",
                                "text": "Cette méthode de travail permettait de « dédiplomatiser », au moins partiellement, le choix des manifestations artistiques proposées aux partenaires étrangers, privilégiant a contrario une professionnalisation qui convenait mieux au ministère technique."
                            },
                            {
                                "example_id": "cead66a1-67ce-44d8-beb7-b89fd3e705ad",
                                "sense_id": "5bcc23b3-edb3-31be-9a50-afda30ba613d",
                                "text": "La délégation mexicaine proposa certains changements radicaux, entre autres l’instauration d’une représentation spéciale au lieu de la représentation diplomatique, en vue de la « dédiplomatiser », comme le déclara le délégué mexicain."
                            }
                        ]
                    }
