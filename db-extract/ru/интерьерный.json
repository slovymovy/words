                "senses": [
                    {
                        "sense_id": "11a0af26-89ff-3506-a651-1f78cad13097",
                        "entry_id": "9d5f5b40-5ce5-3408-998f-bd735009bf65",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным интерьер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63fb7d5d-1572-43cc-b37e-2393ea3d2288",
                                "sense_id": "11a0af26-89ff-3506-a651-1f78cad13097",
                                "text": "В гипсовый раствор погружается плотная ткань, и ею покрывается ваза или интерьерный экран"
                            },
                            {
                                "example_id": "3b9b4b26-fe5e-4cfe-9e12-5fce891960d8",
                                "sense_id": "11a0af26-89ff-3506-a651-1f78cad13097",
                                "text": "Следует отметить, что печать УФ-отверждаемыми чернилами одинаково пригодна как для интерьерного, так и для наружного использования."
                            }
                        ]
                    }
