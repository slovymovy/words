                    },
                    {
                        "translation_id": "6abbfa28-dd79-4663-bf21-da20d902c77b",
                        "source_entry_id": "96cd9955-ea79-33f4-93f5-591d095ef7a2",
                        "source_sense_id": "7af3b29e-1544-3969-bbb8-44f9eaf5005a",
                        "source_sense_description": "gekörnter Feststoff; Substanz die durch Granulieren in kleinere Körnchen zerkleinert wurde",
                        "target_lang_word": "granulaat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "granulaat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b85b21cc-7566-3f0d-95e9-a8ee13de2a5f",
                                        "entry_id": "80097b53-2f95-3780-8a00-5bbba82919c4",
                                        "glosses": [
                                            "materiaal in korrelvorm, of in de vorm van korrelig poeder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19e02c2-01ec-47a0-95d1-93102cd09c00",
                                                "sense_id": "b85b21cc-7566-3f0d-95e9-a8ee13de2a5f",
                                                "text": "Als het aan de fractie van Burgerbelangen Enschede ligt, bestempelt de gemeente per direct alle kunstgrasvelden met rubbergranulaat als verboden terrein. Aanleiding voor dat verzoek zijn de nieuwe onthullingen van het onderzoeksprogramma Zembla van woensdagavond."
                                            },
                                            {
                                                "example_id": "f1a2742e-8471-4235-8b84-31dfb01a0a40",
                                                "sense_id": "b85b21cc-7566-3f0d-95e9-a8ee13de2a5f",
                                                "text": "De nieuwe buitenmanege krijgt vier lagen. „We hebben de toplaag afgegraven en en de onderstelaag menggranulaat aangebracht. Daarop komt een scheidingsdoek voor de afwatering en daar bovenop een 20 centimeter dikke, open menggranulaat ook weer voor de afwatering."
                                            },
                                            {
                                                "example_id": "376d683e-42b8-4577-a606-8da7352d39af",
                                                "sense_id": "b85b21cc-7566-3f0d-95e9-a8ee13de2a5f",
                                                "text": "Neleman wil met zijn initiatief deze kurkbossen in stand houden en wil ook bijdragen aan een duurzamere wereld. De kurk die nu wordt ingezameld zal tot granulaat worden verwerkt. Deze granulaat kan gebruik worden als isolatiemateriaal in de ruimtevaart en voor ecologische bouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
