                                "target_senses": [
                                    {
                                        "sense_id": "38f36747-c06d-3f31-a456-4bf4c2cc35d0",
                                        "entry_id": "f81f9333-9d15-32e0-bcd3-d4d3dca605a0",
                                        "glosses": [
                                            "The state of being brothers or a brother (also figuratively)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3d55458-53da-4280-8893-eda0a4919f0a",
                                                "sense_id": "38f36747-c06d-3f31-a456-4bf4c2cc35d0",
                                                "text": "brotherdom"
                                            },
                                            {
                                                "example_id": "d470359b-f31c-43c2-849d-01aabcf47fc2",
                                                "sense_id": "38f36747-c06d-3f31-a456-4bf4c2cc35d0",
                                                "text": "\"Read lips: Without gas or without you? Without you. Without light or without you? Without you. Without water or without you? Without you. Without food or without you? Without you.\n\"Cold, hunger, darkness and thirst are not as terrible and deadly for us as your \"friendship and brotherhood.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e2df012-9f5c-3eea-b1b0-e02bfb2f0607",
                                        "entry_id": "f81f9333-9d15-32e0-bcd3-d4d3dca605a0",
                                        "glosses": [
                                            "An association of people for any purpose, such as a society of monks; a fraternity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7ab05f-422f-4dd5-ba2d-d26c08ce41f8",
                                                "sense_id": "5e2df012-9f5c-3eea-b1b0-e02bfb2f0607",
                                                "text": "James formed a kind of brotherhood for ex-pats who were working in Valencia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff0241f-885b-3a83-8417-5f5af87533ce",
                                        "entry_id": "f81f9333-9d15-32e0-bcd3-d4d3dca605a0",
                                        "glosses": [
                                            "All the people engaged in the same business, especially those of the same profession"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
