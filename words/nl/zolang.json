                    "semantic_group_id": "tijdsduur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je mag hier blijven wonen <w>zolang</w> je de huur op tijd betaalt.",
                            "target_lang_translations": {
                                "en": "You may continue to live here <w>as long as</w> you pay the rent on time.",
                                "ru": "Ты можешь продолжать жить здесь, <w>пока</w> вовремя платишь за аренду.",
                                "pl": "Możesz tu mieszkać, <w>dopóki</w> płacisz czynsz na czas.",
                                "de": "Du darfst hier wohnen bleiben, <w>solange</w> du die Miete pünktlich zahlst.",
                                "fr": "Tu peux continuer à habiter ici <w>tant que</w> tu paies le loyer à temps.",
                                "it": "Puoi continuare a vivere qui <w>finché</w> paghi l'affitto in tempo.",
                                "cs": "Můžeš tu bydlet, <w>dokud</w> budeš platit nájem včas.",
                                "tr": "Kirayı zamanında ödediğin <w>sürece</w> burada yaşamaya devam edebilirsin.",
                                "es": "Puedes seguir viviendo aquí <w>siempre que</w> pagues el alquiler a tiempo.",
                                "zh": "<w>只要</w>你按时交房租，就可以继续住在这里。"
                            }
                        },
                        {
                            "text": "De kinderen mogen buiten spelen <w>zolang</w> het licht is en het niet regent.",
                            "target_lang_translations": {
                                "en": "The children may play outside <w>as long as</w> it is light and it is not raining.",
                                "ru": "Детям можно играть на улице, <w>пока</w> светло и нет дождя.",
                                "pl": "Dzieci mogą bawić się na dworze, <w>dopóki</w> jest jasno i nie pada.",
                                "de": "Die Kinder dürfen draußen spielen, <w>solange</w> es hell ist und es nicht regnet.",
                                "fr": "Les enfants peuvent jouer dehors <w>tant qu'</w>il fait jour et qu'il ne pleut pas.",
                                "it": "I bambini possono giocare fuori <w>finché</w> c'è luce e non piove.",
                                "cs": "Děti si mohou hrát venku, <w>dokud</w> je světlo a neprší.",
                                "tr": "Çocuklar hava aydınlık olduğu ve yağmur yağmadığı <w>sürece</w> dışarıda oynayabilirler.",
                                "es": "Los niños pueden jugar fuera <w>mientras</w> haya luz y no llueva.",
                                "zh": "<w>只要</w>天还亮着且没下雨，孩子们就可以在外面玩。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "zolang het licht is",
                        "zolang het duurt",
                        "zolang mogelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "during the time that a certain situation continues; provided that",
                        "ru": "в течение того времени, пока продолжается определенная ситуация; при условии, что",
                        "pl": "przez czas, w którym trwa określona sytuacja; pod warunkiem, że",
                        "de": "während der Zeit, in der eine bestimmte Situation andauert; unter der Bedingung, dass",
                        "fr": "pendant la durée où une situation donnée se poursuit ; à condition que",
                        "it": "durante il tempo in cui una determinata situazione continua; a condizione che",
                        "cs": "po dobu, kdy určitá situace trvá; za předpokladu, že",
                        "tr": "Bir durumun devam ettiği süre boyunca; bir şeyin gerçekleşmesi şartıyla.",
                        "es": "durante el tiempo que una situación continúa; con la condición de que",
                        "zh": "在某种情况持续的时间内；只要"
