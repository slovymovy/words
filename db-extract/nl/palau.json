                    {
                        "translation_id": "3f76fa42-74d0-478b-94ef-cc4ca1331ba4",
                        "source_entry_id": "0f15959d-768b-38d9-8874-dd8a8fc2c05a",
                        "source_sense_id": "88550ae9-3833-3a92-a6d2-f0e5c5034832",
                        "source_sense_description": "een eilandenstaat in Oceanië",
                        "target_lang_word": "Palau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palau",
