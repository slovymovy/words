                "senses": [
                    {
                        "sense_id": "ab5189d5-24b8-3853-9803-93641b08bd77",
                        "entry_id": "827ba6f2-ba44-315f-af47-854c5d8c860a",
                        "glosses": [
                            "Boisson alcoolisée sucrée obtenue par mélange de moût de raisin frais (jus de raisin non fermenté, aussi appelé vin doux) et d’alcool pour obtenir un assemblage titrant entre 15 et 22 degrés, et consommée habituellement en apéritif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "788dc641-09a2-44c3-809d-737a18862b07",
                                "sense_id": "ab5189d5-24b8-3853-9803-93641b08bd77",
                                "text": "Seul le Jura est plus ou moins connu pour son fameux vin de paille, son vin d’Arbois, son crémant, ainsi que son macvin, qui n’est qu’une mistelle."
                            }
                        ]
                    }
                ],
