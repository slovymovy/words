                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Journalisten <w>spekulieren</w> seit Tagen über die Gründe für den überraschenden Rücktritt des Ministers."
                        },
                        {
                            "text": "Solange die Testergebnisse noch fehlen, können die Ärzte über die genaue Ursache nur <w>spekulieren</w>."
                        }
                    ],
                    "synonyms": [
