    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f74075f-2e36-39f4-a376-8e3b105e55e8",
                    "sense_definition": "Rendre une personne ou un groupe attentif et réceptif à un problème ou à une cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'association organise des ateliers dans les écoles pour <w>sensibiliser</w> les jeunes aux enjeux environnementaux."
                        },
                        {
                            "text": "Cette campagne d'information a pour but de <w>sensibiliser</w> le public aux dangers de la vitesse."
                        }
                    ],
                    "synonyms": [
                        "conscientiser"
                    ],
                    "common_phrases": [
                        "sensibiliser les jeunes",
                        "sensibiliser le public",
                        "sensibiliser aux risques"
                    ]
                },
                {
                    "sense_id": "e70df53f-b63c-30f6-9939-50d9698f7d1b",
                    "sense_definition": "Rendre une surface, un corps ou une émulsion réactif à un agent physique ou chimique, notamment à la lumière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe doit soigneusement <w>sensibiliser</w> la plaque avant de l'exposer à la lumière dans son atelier."
                        },
                        {
                            "text": "Certains produits chimiques permettent de <w>sensibiliser</w> le papier lors du développement artisanal."
                        }
                    ],
                    "common_phrases": [
