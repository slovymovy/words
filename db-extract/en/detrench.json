                ],
                "senses": [
                    {
                        "sense_id": "8547d2d8-85e0-3ec4-9de0-2fe89f172b9d",
                        "entry_id": "9e25201d-0786-36da-a4db-8224b798a76c",
                        "glosses": [
                            "To dig out and remove from a trench."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b40f6bc7-036c-4fe0-9ecf-58bc8c30c7d2",
                                "sense_id": "8547d2d8-85e0-3ec4-9de0-2fe89f172b9d",
                                "text": "In some cases these cables still become damaged and this results in lengths of cable having to be detrenched."
                            },
                            {
                                "example_id": "4dec03f7-3b47-4cbc-a53d-52564b138fb0",
                                "sense_id": "8547d2d8-85e0-3ec4-9de0-2fe89f172b9d",
                                "text": "Ultimately, the system would have the capability to carry out the complete intervention process, from detrenching a pipeline to final inspection and corrosion protection."
                            },
                            {
                                "example_id": "02cc1c9f-7c46-4880-b48a-f107c7ab1e37",
                                "sense_id": "8547d2d8-85e0-3ec4-9de0-2fe89f172b9d",
                                "text": "If a buried cable is damaged it will be necessary to detrench it before repair can be undertaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4a9f920-eb47-38a9-87d0-7ef591ad835b",
                        "entry_id": "9e25201d-0786-36da-a4db-8224b798a76c",
                        "glosses": [
                            "To force (an army) out of trenches, or to be so forced out."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5835999d-817c-4d40-973e-91d814300b9d",
                                "sense_id": "c4a9f920-eb47-38a9-87d0-7ef591ad835b",
                                "text": "Verey lights, no longer needed by the detrenched army, soared with them, descending in wavy pools of radiance."
                            },
                            {
                                "example_id": "0cb6f51f-974c-4563-ac85-ceaf2f77b70e",
                                "sense_id": "c4a9f920-eb47-38a9-87d0-7ef591ad835b",
                                "text": "There was particularly heavy fighting in the Smolensk direction, where our units detrenched the enemy from their positions with a succession of counterattacks."
                            },
                            {
                                "example_id": "d56e76bd-aca6-4bab-8f6c-1df289425b93",
                                "sense_id": "c4a9f920-eb47-38a9-87d0-7ef591ad835b",
                                "text": "keep the defense on the move and force them to detrench, defending stack at a time, to ensure a quick success for the TOP-UP infantry attack."
                            }
                        ]
                    }
