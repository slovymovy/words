                                        "entry_id": "fe6316cb-7769-3ed7-9082-993ff0ca9fc4",
                                        "glosses": [
                                            "The hypothetical principle that animates all living organisms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a30866-1782-4f14-ae42-178b9f116f28",
                                                "sense_id": "c44f2b05-a91e-37f4-83e0-09b62966bbf3",
                                                "text": "The human tribe partakes of the mana or life-force of the animal, and is strengthened[.]"
                                            },
                                            {
                                                "example_id": "033672d3-83c7-4665-9570-77512323c4ba",
                                                "sense_id": "c44f2b05-a91e-37f4-83e0-09b62966bbf3",
                                                "text": "\"Yes, I'm beating it!\" he cried. \"Ever since Felkin held his first consultation with Atkinson I have felt the life-force stealing back into me.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73626fb4-e6f6-3813-b26d-f8cbd0d92885",
                                        "entry_id": "fe6316cb-7769-3ed7-9082-993ff0ca9fc4",
                                        "glosses": [
                                            "An impulse or influence that gives something life or vitality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
