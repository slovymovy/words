                    {
                        "sense_id": "400e76ee-58e0-3ed5-916f-0436c8158d91",
                        "entry_id": "958bdade-8408-3d5c-8e3b-ef885a1c3c02",
                        "glosses": [
                            "Diminutif de seul."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "42efe646-3e4e-4831-a947-80b87e1046fb",
                                "sense_id": "400e76ee-58e0-3ed5-916f-0436c8158d91",
                                "text": "Oui, j’éprouve le besoin de vous exprimer l’admiration d’une pauvre fille de province, seulette dans son coin, et dont tout le bonheur est de lire vos poésies."
                            },
                            {
                                "example_id": "2592e560-54d6-42be-b19d-2b4218a6f8e0",
                                "sense_id": "400e76ee-58e0-3ed5-916f-0436c8158d91",
                                "text": "Ô mourir de cette mort seulette\nQue s’en vont, cher amour qui t’épeures,\nBalançant jeunes et vieilles heures !\nÔ mourir de cette escarpolette !"
                            }
                        ]
                    }
