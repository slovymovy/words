{
    "word_family": [
        "brutaliteit",
        "brutaliseren",
        "brutaaltje"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3eae44d6-2b7f-33be-b6c6-8e8861d23612",
                    "sense_definition": "geen respect hebbend voor anderen, vaak op een directe of onbeleefde manier",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onbeleefdheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat ben jij toch een arrogante en <w>brutale</w> jongen!",
                            "target_lang_translations": {
                                "en": "What an arrogant and <w>rude</w> boy you are!"
                            }
                        },
                        {
                            "text": "Het is erg <w>brutaal</w> om zomaar iemands dagboek te lezen zonder toestemming.",
                            "target_lang_translations": {
                                "en": "It is very <w>disrespectful</w> to just read someone's diary without permission."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeschoft",
                        "vrijpostig",
                        "onbeleefd",
                        "lomp"
                    ],
                    "antonyms": [
                        "beleefd",
                        "bescheiden",
                        "gehoorzaam"
                    ],
                    "common_phrases": [
                        "een brutale mond",
                        "brutaal gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "having no respect for others, often in a direct or rude manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "general lack of manners"
                            },
                            {
                                "target_lang_word": "disrespectful",
                                "target_lang_sense_clarification": "lacking respect"
                            },
                            {
                                "target_lang_word": "insolent",
                                "target_lang_sense_clarification": "insulting or arrogant"
                            },
                            {
                                "target_lang_word": "impudent",
                                "target_lang_sense_clarification": "boldly disrespectful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf454677-5ff2-3efd-bf1f-fffc19db932c",
                    "sense_definition": "vrij in het uiten van een mening of gevoel, vaak zonder angst voor autoriteit",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vrijpostigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>brutale</w> man vertelde al zijn kritiek direct aan de rijke koning.",
                            "target_lang_translations": {
                                "en": "The <w>bold</w> man told all his criticism directly to the wealthy king."
                            }
                        },
                        {
                            "text": "Zij stelde een <w>brutale</w> vraag aan de directeur tijdens de grote vergadering.",
                            "target_lang_translations": {
                                "en": "She asked the director a <w>cheeky</w> question during the big meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijpostig",
                        "openhartig",
                        "vrijmoedig"
                    ],
                    "antonyms": [
                        "verlegen",
                        "terughoudend"
                    ],
                    "common_phrases": [
                        "een brutale vraag"
                    ],
                    "target_lang_definitions": {
                        "en": "free in expressing an opinion or feeling, often without fear of authority"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bold",
                                "target_lang_sense_clarification": "daring or forward"
                            },
                            {
                                "target_lang_word": "cheeky",
                                "target_lang_sense_clarification": "playfully impudent"
                            },
                            {
                                "target_lang_word": "audacious",
                                "target_lang_sense_clarification": "recklessly daring"
                            },
                            {
                                "target_lang_word": "frank",
                                "target_lang_sense_clarification": "bluntly honest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9492b771-0e0a-3610-ad8c-76603b2b7875",
                    "sense_definition": "extreem gewelddadig of beestachtig van aard",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geweld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie onderzoekt de <w>brutale</w> moord die gisteravond in het park plaatsvond.",
                            "target_lang_translations": {
                                "en": "The police are investigating the <w>brutal</w> murder that took place in the park last night."
                            }
                        },
                        {
                            "text": "Het leger gebruikte <w>brutaal</w> geweld om de vreedzame demonstratie uit elkaar te drijven.",
                            "target_lang_translations": {
                                "en": "The army used <w>vicious</w> violence to disperse the peaceful demonstration."
                            }
                        }
                    ],
                    "synonyms": [
                        "beestachtig",
                        "wreed",
                        "gewelddadig"
                    ],
                    "antonyms": [
                        "zachtaardig",
                        "humaan"
                    ],
                    "common_phrases": [
                        "brutaal geweld",
                        "een brutale moord"
                    ],
                    "target_lang_definitions": {
                        "en": "extremely violent or beastly in nature"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brutal",
                                "target_lang_sense_clarification": "extremely violent"
                            },
                            {
                                "target_lang_word": "vicious",
                                "target_lang_sense_clarification": "cruel and violent"
                            },
                            {
                                "target_lang_word": "savage",
                                "target_lang_sense_clarification": "fierce and uncontrolled"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}