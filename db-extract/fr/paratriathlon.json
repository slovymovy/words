                    {
                        "sense_id": "31383e7f-47e6-330d-97ab-e33cc9b3f737",
                        "entry_id": "896578e7-48c4-32f2-8ee2-79daae4365c8",
                        "glosses": [
                            "Variante du triathlon pour les athlètes ayant un handicap physique."
                        ],
                        "tags": [
                            "Handisport",
                            "Triathlon"
                        ],
                        "examples": [
                            {
                                "example_id": "e7f98833-8daf-4c16-9f15-b7114abe718d",
                                "sense_id": "31383e7f-47e6-330d-97ab-e33cc9b3f737",
                                "text": "Championne du monde de paratriathlon en 2016, quatrième des Jeux de Tokyo 2021 à la longueur, cette toute jeune maman veut saisir toutes les chances qu’offre le doublé Mondiaux 2023 puis les jeux paralympiques, en août 2024."
                            },
                            {
                                "example_id": "df717c09-b16a-47d6-bedf-a5a4c3081c7a",
                                "sense_id": "31383e7f-47e6-330d-97ab-e33cc9b3f737",
                                "text": "Tous les acteurs l’assurent : les épreuves de triathlon, paratriathlon, et de nage en eau libre (marathon) pourront se dérouler dans la Seine."
                            },
                            {
                                "example_id": "f6fc4e64-c5dd-4d71-92a8-ac69e2d115e9",
                                "sense_id": "31383e7f-47e6-330d-97ab-e33cc9b3f737",
                                "text": "« Cela concerne la natation marathon, le triathlon, le paratriathlon, le cyclisme sur route, le paracyclisme sur route, le marathon, le paramarathon, et la marche athlétique », précise l’équipe communication de Paris 2024."
                            }
                        ]
                    }
