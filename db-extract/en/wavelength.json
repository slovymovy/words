                                                "example_id": "3b8f26b5-1a63-436d-97b8-f5e22adfd2a5",
                                                "sense_id": "a8c99d54-a67a-3992-9ead-f8c193ad6ce4",
                                                "text": "Волна новостей."
                                            },
