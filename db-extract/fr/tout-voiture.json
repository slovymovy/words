                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd2358fd-b7f5-3609-afcd-834dc9e8048c",
                        "entry_id": "1487f855-b3fd-3694-82ae-2cb06ff4478f",
                        "glosses": [
                            "Environnement dans lequel tout est fait avec la voiture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8569c56f-c824-464e-a658-527a2e3daad7",
                                "sense_id": "bd2358fd-b7f5-3609-afcd-834dc9e8048c",
                                "text": "On incite de plus en plus au tout-voiture, mais au tout-voiture écologique ! Les volumes de marchandises sont toujours plus importants et transportés sur de plus en plus grandes distances, au nom de l'équité sociale (qui fait aussi partie du développement durable)!"
                            },
                            {
                                "example_id": "39b2fe4b-a66a-4e6f-8e2d-bdae3bd6d92b",
                                "sense_id": "bd2358fd-b7f5-3609-afcd-834dc9e8048c",
                                "text": "Avec les longues distances et un urbanisme qui favorisent le tout-voiture, on n'imaginait pas que ce pays parviendrait à développer comme il le fait l'électrique, et pourtant regardez la part qu'est en train de prendre Tesla."
                            },
                            {
                                "example_id": "d3476f85-f89d-4604-b15d-581750d9a74a",
                                "sense_id": "bd2358fd-b7f5-3609-afcd-834dc9e8048c",
                                "text": "Pourtant, la morphologie des villes, le tout-voiture, l'emplacement des commerces et des services ne favorisent pas partout leur répartition équitable. Il existe des centres-villes quasi dépourvus de commerces sauf ceux destinés aux touristes, […]."
                            }
                        ]
                    }
