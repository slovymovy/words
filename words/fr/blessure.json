                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a soigneusement nettoyé sa <w>blessure</w> avant de poser un bandage propre."
                        },
                        {
                            "text": "L'athlète a dû abandonner la compétition à cause d'une grave <w>blessure</w> à la cheville."
                        }
                    ],
                    "synonyms": [
                        "plaie",
                        "lésion"
                    ],
                    "common_phrases": [
                        "grave blessure",
                        "soigner une blessure",
                        "blessure par balle"
                    ]
                },
                {
                    "sense_id": "a4a77645-5559-3d88-a76c-b4c6ff453791",
                    "sense_definition": "Atteinte douloureuse à l'amour-propre, aux sentiments ou à la réputation d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses propos désobligeants ont rouvert une vieille <w>blessure</w> qu'il croyait oubliée."
                        },
                        {
                            "text": "Ce refus public a représenté une cruelle <w>blessure</w> pour son amour-propre."
                        }
                    ],
                    "common_phrases": [
                        "rouvrir une blessure",
                        "blessure morale"
                    ]
                },
                {
                    "sense_id": "e64fa792-0ba7-3207-9e66-224ae5fdba88",
                    "sense_definition": "Traumatisme psychologique durable, souvent lié à l'enfance, affectant la personnalité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un travail avec un psychologue peut aider à cicatriser une profonde <w>blessure</w> d'enfance."
                        },
                        {
                            "text": "La perte soudaine de ses repères a provoqué une véritable <w>blessure</w> dans sa construction personnelle."
