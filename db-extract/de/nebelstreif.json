                        "examples": [
                            {
                                "example_id": "0e6b765e-5dcf-4289-8de4-4f25d98593a0",
                                "sense_id": "211d236e-c47e-3c6e-b99d-6040decfc224",
                                "text": "Mein Sohn, was birgst du so bang dein Gesicht?\nSiehst, Vater, du den Erlkönig nicht!\nDen Erlenkönig mit Kron' und Schweif?\nMein Sohn, es ist ein Nebelstreif.",
                                "translation": "My son, why are you hiding your face so fearfully?\nFather, don’t you see the Alder King!\nThe Alder King with crown and ermine?\nMy son, 'tis but a wisp of fog.",
                                "english": "My son, why are you hiding your face so fearfully?\nFather, don’t you see the Alder King!\nThe Alder King with crown and ermine?\nMy son, 'tis but a wisp of fog."
                            }
                        ]
                    }
