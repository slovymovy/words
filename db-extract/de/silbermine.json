                ],
                "senses": [
                    {
                        "sense_id": "4588deff-5c00-3cab-81e3-e64705da7cb1",
                        "entry_id": "eaa70f0b-e1ab-3f7e-8d03-bc34792460bf",
                        "glosses": [
                            "Bergwerk, in dem Silber abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4117a2a-4f77-40b3-ac2a-79cb598598fa",
                                "sense_id": "4588deff-5c00-3cab-81e3-e64705da7cb1",
                                "text": "Viele Kinder mussten in den Silberminen schuften."
                            },
                            {
                                "example_id": "90857120-1c06-4cbc-ad8b-55cece408da8",
                                "sense_id": "4588deff-5c00-3cab-81e3-e64705da7cb1",
                                "text": "Nachdem die Silbermine erschöpft war, wurde sie verlassen."
                            },
                            {
                                "example_id": "c656eed7-4a0b-4d04-ab41-a4446ff75048",
                                "sense_id": "4588deff-5c00-3cab-81e3-e64705da7cb1",
                                "text": "„Seit dem Versiegen der zentralasiatischen Silberminen im 10. Jahrhundert hatte in der arabischen Welt des Nahen und Mittleren Ostens ein akuter Silbermangel geherrscht.“"
                            },
                            {
                                "example_id": "075aabf6-8b46-4ab1-8767-6116a9e52a61",
                                "sense_id": "4588deff-5c00-3cab-81e3-e64705da7cb1",
                                "text": "„An einer Silbermine in Alaska haben eine Bärin und zwei Jungtiere einen 18-jährigen Arbeiter getötet.“"
                            },
                            {
                                "example_id": "83c20e85-727b-465e-a82d-f9ebbccc344c",
                                "sense_id": "4588deff-5c00-3cab-81e3-e64705da7cb1",
                                "text": "„Das zuverlässigste Kriterium dafür, wer welchen Platz im städtischen Statussystem einnahm, war nicht der Besitz an Silbermünzen, nicht einmal der an Silberminen, sondern wer wen heiraten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
