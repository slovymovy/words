        "fr-extract.jsonl": [
            {
                "entry_id": "48271e34-78ab-3861-bf6f-d693458e1ab0",
                "word": "paléontologue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43cd4d3e-0c7b-4499-aafe-0ebbf9f68f62",
                        "entry_id": "48271e34-78ab-3861-bf6f-d693458e1ab0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "paléontologues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b90bbb2a-b3a6-376b-aece-d792d9532299",
                        "entry_id": "48271e34-78ab-3861-bf6f-d693458e1ab0",
                        "glosses": [
                            "Scientifique qui étudie les restes et autres traces fossilisées des êtres vivants du passé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acb6836c-aa3e-48eb-8c7a-2d197da5f587",
                                "sense_id": "b90bbb2a-b3a6-376b-aece-d792d9532299",
                                "text": "On voit dès lors qu'il n'est point indifférent de représenter une coquille d'une manière ou d'une autre, et qu'il importe au zoologiste ou au paléontologue de donner aux géologues des points de comparaison sur lesquels ceux-ci puissent s'appuyer pour reconnaître l'état des couches à l'instant où les êtres qui y sont enfermés ont été recouvert de nouveaux dépôts."
                            },
                            {
                                "example_id": "6dbca4b1-e103-45d7-9d1c-f6a10f0cecfc",
                                "sense_id": "b90bbb2a-b3a6-376b-aece-d792d9532299",
                                "text": "C’était avant les travaux du paléontologue Jack Cooper de l’Université de Bristol et de collègues de l’Université de Swansea."
                            },
                            {
                                "example_id": "3a93cd69-1fcb-4109-9dcb-65d418a5bec9",
                                "sense_id": "b90bbb2a-b3a6-376b-aece-d792d9532299",
                                "text": "Bien que l’équipe soit formée de paléontologues, c’est dans une revue scientifique spécialisée en entomologie, Systematic Entomology, qu’a été publié le fruit de son travail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9011de39-b114-4c81-9146-a4b48ee9f689",
                        "source_entry_id": "48271e34-78ab-3861-bf6f-d693458e1ab0",
                        "source_sense_id": "b90bbb2a-b3a6-376b-aece-d792d9532299",
                        "source_sense_description": "Scientifique",
                        "target_lang_word": "paleontologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paleontologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2039c432-d69b-33a3-8809-d8fcca0aa9a7",
                                        "entry_id": "1fa8e8b2-7e09-3c23-b5d4-84e7bc609715",
                                        "glosses": [
                                            "One who studies paleontology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e58a20-f15d-4933-abac-cb162ca3ee30",
                                                "sense_id": "2039c432-d69b-33a3-8809-d8fcca0aa9a7",
                                                "text": "An alternative approach is to break down cultures into ab-\n stract elements and to establish, between elements of the same\n type in different cultures, rather than between cultures themselves,\n the same kind of relationships of historical descent and progressive\n differentiation which the paleontologist sees in the evolution of\n species."
                                            },
                                            {
                                                "example_id": "871a0cf9-32c3-4108-ac8b-4c476e93e38d",
                                                "sense_id": "2039c432-d69b-33a3-8809-d8fcca0aa9a7",
                                                "text": "In the late nineteenth century, paleontologists began to catalog the many curious correspondences exhibited by fossils gathered on different continents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
