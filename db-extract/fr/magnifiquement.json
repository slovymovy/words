                                        "sense_id": "597856c4-3d2c-370c-92e9-28768dc0e781",
                                        "entry_id": "8576c2ba-a3cb-3ac1-a743-ff55cc144209",
                                        "glosses": [
                                            "sich deutlich vom Standard positiv abhebend, im Sinne von besonders gut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50730b85-49a6-42ab-bfd3-671a6ca338e0",
                                                "sense_id": "597856c4-3d2c-370c-92e9-28768dc0e781",
                                                "text": "Ottokar ist ein hervorragender Klavierspieler."
                                            },
                                            {
                                                "example_id": "be4e4fa2-3cb7-4072-ae50-5f0c3cccd13b",
                                                "sense_id": "597856c4-3d2c-370c-92e9-28768dc0e781",
                                                "text": "Dein Abschlusszeugnis ist hervorragend."
                                            }
                                        ],
