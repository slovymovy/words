                        "entry_id": "01e39d2f-bcea-39c3-977c-723c4e65f546",
                        "glosses": [
                            "A small stoppered glass bottle, often used for keeping perfume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "390b4a91-b17f-45df-b4b0-86746187f389",
                                "sense_id": "47c90f01-3ed1-34fd-b0b3-d0fb9e6c2327",
                                "text": "October 24, 1872, Henry Wadsworth Longfellow, letter to G. W. Greene\ntwo glass flacons for the ink"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96131346-8d53-46b3-a4a6-29d2385370c0",
                        "source_entry_id": "01e39d2f-bcea-39c3-977c-723c4e65f546",
                        "source_sense_id": "47c90f01-3ed1-34fd-b0b3-d0fb9e6c2327",
                        "source_sense_description": "small bottle",
                        "target_lang_word": "Flakon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flakon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cec814fa-5a76-3a03-a8f8-bd71375541ea",
                                        "entry_id": "b2ff6bbd-5f27-3124-987f-1558e0d78d57",
                                        "glosses": [
                                            "kleine, meist besonders geformte (bunte) Glasflasche, vor allem Behältnis für Parfüm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ec56d2-969b-4992-b439-cc2dc23b100c",
                                                "sense_id": "cec814fa-5a76-3a03-a8f8-bd71375541ea",
                                                "text": "Das beste an diesem Parfüm ist der kunstvoll gestaltete Flakon."
                                            },
                                            {
                                                "example_id": "49623d9a-9d9f-40b8-aebe-fff43abcfb19",
                                                "sense_id": "cec814fa-5a76-3a03-a8f8-bd71375541ea",
                                                "text": "„Aber im nächsten Augenblick riß sie der Mama den Flakon aus der Hand und goß es sich über Hals und Nacken.“"
                                            },
                                            {
                                                "example_id": "b4950eff-99a5-41d2-b0a0-0648a1ed7103",
                                                "sense_id": "cec814fa-5a76-3a03-a8f8-bd71375541ea",
                                                "text": "„Sie nahm die Flakons, als wolle sie eine religiöse Handlung ausüben.“"
                                            },
                                            {
                                                "example_id": "765e6a7f-8373-417d-affb-8f5b32f2e428",
                                                "sense_id": "cec814fa-5a76-3a03-a8f8-bd71375541ea",
                                                "text": "„Mit zitternden Fingern holte Estrella aus ihrer Krokodilledertasche einen goldenen Flakon hervor und schraubte ihn auf.“"
                                            },
                                            {
                                                "example_id": "6ba25540-1b95-4583-b056-ebd69532fe0b",
                                                "sense_id": "cec814fa-5a76-3a03-a8f8-bd71375541ea",
                                                "text": "„Er riss das Siegel ab und öffnete den Flakon, hielt ihn sich an die Nase und roch daran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6b511e7-97df-4f67-ba13-fae550fe5e0d",
