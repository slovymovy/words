    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "96503e99-1d30-30fc-bb78-8fc53d73b78b",
                "word": "dustup",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6cab2f9e-0256-4791-8344-7ccd3a7c5852",
                        "entry_id": "96503e99-1d30-30fc-bb78-8fc53d73b78b",
                        "tags": [
                            "plural"
                        ],
                        "form": "dustups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d59fdcf-893c-3f98-99a0-ca58d258bd0a",
                        "entry_id": "96503e99-1d30-30fc-bb78-8fc53d73b78b",
                        "glosses": [
                            "A scuffle or fight."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "dab364c6-718c-4684-af39-9363ccf81648",
                                "sense_id": "8d59fdcf-893c-3f98-99a0-ca58d258bd0a",
                                "text": "Mik looked at his arm and knew this wouldn't work for another dustup with the she-hemoth that was hot on his heels. He put his shield on the damaged arm. It felt strange since he usually wore it on his left."
                            }
                        ]
                    },
                    {
                        "sense_id": "4efe4dcc-771a-3c50-ad5b-726a635e34b4",
                        "entry_id": "96503e99-1d30-30fc-bb78-8fc53d73b78b",
                        "glosses": [
                            "An argument or dispute."
                        ],
                        "tags": [
                            "broadly",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7f30cb97-db31-4cb6-9a3f-2c73a830c8ae",
                                "sense_id": "4efe4dcc-771a-3c50-ad5b-726a635e34b4",
                                "text": "The incident followed other dustups between the two parties over the conduct of the war on terrorism."
                            },
                            {
                                "example_id": "350c4cc5-9f86-4fbe-950a-a52bc13719ec",
                                "sense_id": "4efe4dcc-771a-3c50-ad5b-726a635e34b4",
                                "text": "“Look at us. I plumb forgot what this dustup's even about. Now, what I'm-what I'm... what I'm trying to say here is, hoo, boy, we all need to stop fightin'.”"
                            },
                            {
                                "example_id": "91d219ca-a0a9-435b-941a-ec929f65a988",
                                "sense_id": "4efe4dcc-771a-3c50-ad5b-726a635e34b4",
                                "text": "And given how few Netflix subscribers appear to have canceled their subscriptions during last year’s dust-up with Mr. Chappelle, Spotify can probably breathe easy on this front for now."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ade2ccf1-1da1-4368-bbcd-9782a5a46494",
                        "source_entry_id": "96503e99-1d30-30fc-bb78-8fc53d73b78b",
                        "source_sense_description": "dispute",
                        "target_lang_word": "différend",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "différend",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39214bfb-7437-3427-b86e-2763b15f1aaf",
                                        "entry_id": "8117b0e6-26cb-351a-82c9-b093d22bbb87",
                                        "glosses": [
                                            "Différence entre le prix demandé et le prix offert, dans une transaction commerciale."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae497248-96a3-33fd-9082-8acf972423ae",
                                        "entry_id": "8117b0e6-26cb-351a-82c9-b093d22bbb87",
                                        "glosses": [
                                            "Débat entre deux ou plusieurs personnes à propos d’opinions, de questions d’intérêt, etc., sur lesquelles elles ne sont pas d’accord."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b92a01-2dc2-47f4-8295-ccb09185f94b",
                                                "sense_id": "ae497248-96a3-33fd-9082-8acf972423ae",
                                                "text": "Avant 1789, les gentilshommes verriers ne sortaient jamais sans leur épée, c'était toujours cette arme à la main qu'en présence de deux témoins se vidaient les querelles et différends qui souvent s'élevaient entre ces hommes, susceptibles et chatouilleux."
                                            },
                                            {
                                                "example_id": "160b8818-26f1-4457-8707-f3bced5b781c",
                                                "sense_id": "ae497248-96a3-33fd-9082-8acf972423ae",
                                                "text": "Il aurait fallu cautériser, à défaut de recoudre, comme son oncle le faisait pour le petit bétail qui se blessait aux clôtures ou qui s’encornait pour régler un différend de pâture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51ef4fca-537b-4436-b820-bbe001d16e47",
                        "source_entry_id": "96503e99-1d30-30fc-bb78-8fc53d73b78b",
                        "source_sense_description": "dispute",
                        "target_lang_word": "Auseinandersetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auseinandersetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61edf618-f70f-3570-bcd4-0f1198172638",
                                        "entry_id": "d0ac07f4-5dc7-33cc-a18f-a730864dc32b",
                                        "glosses": [
                                            "eingehende kritische Beschäftigung (mit etwas)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f0b238b-b35d-48d8-8a8d-9902aa230f5d",
                                                "sense_id": "61edf618-f70f-3570-bcd4-0f1198172638",
                                                "text": "„Es ist nicht die erste Auseinandersetzung über das deutsche Selbstbild seit 1945.“"
                                            },
                                            {
                                                "example_id": "aeb0ec91-aa51-4907-ae4e-1bf3ffcb3275",
                                                "sense_id": "61edf618-f70f-3570-bcd4-0f1198172638",
                                                "text": "„Erst durch diese Auseinandersetzung schien es möglich, auch das Leid der deutschen Kriegskinder ins Blickfeld zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dce792b-8061-3715-adaf-b11f18b3ed42",
                                        "entry_id": "d0ac07f4-5dc7-33cc-a18f-a730864dc32b",
                                        "glosses": [
                                            "heftig und kontrovers geführtes Gespräch, mit Worten ausgetragener heftiger Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "914731c0-ad4c-440d-9231-ddc47159dc2f",
                                                "sense_id": "5dce792b-8061-3715-adaf-b11f18b3ed42",
                                                "text": "Die Auseinandersetzung mit dem Schulleiter blieb ohne nennenswertes Ergebnis."
                                            },
                                            {
                                                "example_id": "2e8f0087-bcc1-4440-bb8f-dbce3f88069a",
                                                "sense_id": "5dce792b-8061-3715-adaf-b11f18b3ed42",
                                                "text": "„Nun stehen Gabriel neue Auseinandersetzungen bevor.“"
                                            },
                                            {
                                                "example_id": "1844f2ba-f2fe-4299-a412-c25d54930e77",
                                                "sense_id": "5dce792b-8061-3715-adaf-b11f18b3ed42",
                                                "text": "„In seinen letzten Lebensmonaten und -wochen war die Auseinandersetzung um die psychiatrische Versorgung zwischen Griesinger und den Anstaltspsychiatern in ihre schärfste Phase getreten.“"
                                            },
                                            {
                                                "example_id": "c846dcff-7911-4318-a0f4-15f9890232bc",
                                                "sense_id": "5dce792b-8061-3715-adaf-b11f18b3ed42",
                                                "text": "„Er schien eine Auseinandersetzung hinter sich zu haben.“"
                                            },
                                            {
                                                "example_id": "7c630c23-ae0e-4f4e-912a-0f736dd5c057",
                                                "sense_id": "5dce792b-8061-3715-adaf-b11f18b3ed42",
                                                "text": "„Gaismair war 1512 Sekretär der Fugger in Schwaz gewesen, als es zur Auseinandersetzung zwischen der Bergwerksleitung und den Grubenarbeitern kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6fdbf24b-d1c5-38ce-931b-64a8384f88ae",
                                        "entry_id": "d0ac07f4-5dc7-33cc-a18f-a730864dc32b",
                                        "glosses": [
                                            "mit Gewalt ausgetragener Konflikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ebe1ea-6cd4-439f-b555-602f74ce6527",
                                                "sense_id": "6fdbf24b-d1c5-38ce-931b-64a8384f88ae",
                                                "text": "Danach kam es zu blutigen Auseinandersetzungen."
                                            },
                                            {
                                                "example_id": "aceadaec-d8ea-4575-851d-47385943e59f",
                                                "sense_id": "6fdbf24b-d1c5-38ce-931b-64a8384f88ae",
                                                "text": "„Es war eine unrealistische Forderung, die zur kriegerischen Auseinandersetzung führen musste.“"
                                            },
                                            {
                                                "example_id": "bdd19ea4-3f95-4c07-8e22-6d3dd56ac4ee",
                                                "sense_id": "6fdbf24b-d1c5-38ce-931b-64a8384f88ae",
                                                "text": "„Es folgte eine von Bürgerkriegen und inneren Auseinandersetzungen geprägte Zeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "532a98af-ed72-41c5-849b-00012e597102",
                        "source_entry_id": "96503e99-1d30-30fc-bb78-8fc53d73b78b",
                        "source_sense_description": "dispute",
                        "target_lang_word": "Streit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                        "entry_id": "0c892b97-7b19-36f1-b1a7-78b2b8b23b4b",
                                        "glosses": [
                                            "heftig ausgetragene Kollision von Interessen oder Meinungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7498b0b-d1e3-4ae3-b6f7-f637bf2f357f",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "Der Streit um die politische Ausrichtung und das qualitative Niveau des Spiegels geht weiter. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "724f7c77-bf39-4c70-974e-b9ec7f300857",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Als wir gehen, gibt es Streit, der zweite an diesem Abend.“"
                                            },
                                            {
                                                "example_id": "74433d4d-a708-4b36-afb1-c5da44e98ec9",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Jacques stand in der Tür und hatte den Streit ebenso durch das Fenster gehört.“"
                                            },
                                            {
                                                "example_id": "a5836f49-0410-421f-9970-56059ac4037a",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Eine Frau hat bei einem Streit immer das letzte Wort.“"
                                            },
                                            {
                                                "example_id": "be0e455e-a17d-40af-a246-c7b42a8964c1",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Ein scharfer, schneller Streit entstand plötzlich vor dem Café .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
