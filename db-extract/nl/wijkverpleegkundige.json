                        "sense_id": "76eb311c-7675-32ff-b3bb-4769318e41d6",
                        "entry_id": "2d48fac6-ff01-3b3a-af98-a55612a797d9",
                        "glosses": [
                            "verpleegkundige die patiënten in hun eigen huis verzorgt; thuiszorg medewerker"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "c1df7b83-0c26-43ed-a252-79c9a8cc8199",
                                "sense_id": "76eb311c-7675-32ff-b3bb-4769318e41d6",
                                "text": "De wijkverpleegkundigen komen in actie. Ze zijn wel blij dat bepaalde bezuinigingen niet doorgaan, maar dat is ze niet genoeg. Er moet een plan komen om meer armslag te krijgen in de zorg zelf en dan om te beginnen door minder administratieve druk."
                            },
                            {
                                "example_id": "0cfa243f-76db-4bd9-8053-10333c1c9779",
                                "sense_id": "76eb311c-7675-32ff-b3bb-4769318e41d6",
                                "text": "Wijkverpleegkundigen krijgen meer lucht, zodat ze meer tijd over houden voor hun daadwerkelijke werk. Ze moesten tot dusverre per vijf minuten registreren wat ze uitvoerden bij cliënten. Door deze tijdrovende administratieve last wordt een streep gezet."
                            }
                        ]
                    }
