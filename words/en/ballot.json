{
    "word_family": [
        "balloting",
        "balloter",
        "reballot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b58e2c45-5ee9-3273-a75e-dfcc501054cb",
                    "sense_definition": "A piece of paper, card, or other device used to cast a vote in an election.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "voting_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She marked her choice clearly on the <w>ballot</w> before placing it in the box.",
                            "target_lang_translations": {
                                "ru": "Она чётко отметила свой выбор в <w>бюллетене</w>, прежде чем опустить его в урну.",
                                "zh": "她在<w>选票</w>上清楚地标明了自己的选择，然后将其投入票箱。"
                            }
                        },
                        {
                            "text": "Many citizens requested an absentee <w>ballot</w> so they could vote by mail.",
                            "target_lang_translations": {
                                "ru": "Многие граждане запросили <w>бюллетень</w> для заочного голосования, чтобы проголосовать по почте.",
                                "zh": "许多公民申请了缺席<w>选票</w>，以便通过邮寄方式投票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ballot paper",
                        "voting slip"
                    ],
                    "common_phrases": [
                        "cast a ballot",
                        "absentee ballot",
                        "paper ballot",
                        "spoil a ballot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лист бумаги, карточка или иное устройство, используемое для подачи голоса на выборах.",
                        "zh": "用于在选举中投票的纸张、卡片或其他工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избира́тельный бюллете́нь",
                                "target_lang_sense_clarification": "документ для голосования"
                            },
                            {
                                "target_lang_word": "бюллете́нь",
                                "target_lang_sense_clarification": "листок для голосования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选票",
                                "target_lang_sense_clarification": "用于投票的纸张"
                            },
                            {
                                "target_lang_word": "投票单",
                                "target_lang_sense_clarification": "投票用的单据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fa69bef-381f-37e8-ac35-c0bfd690d2ab",
                    "sense_definition": "The system or process of voting, usually done in secret.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "voting_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chairman was elected by a secret <w>ballot</w> of the committee members.",
                            "target_lang_translations": {
                                "ru": "Председатель был избран тайным <w>голосованием</w> членов комитета.",
                                "zh": "主席是由委员会成员通过秘密<w>投票</w>选出的。"
                            }
                        },
                        {
                            "text": "The union held a <w>ballot</w> to decide whether to go on strike.",
                            "target_lang_translations": {
                                "ru": "Профсоюз провёл <w>голосование</w>, чтобы решить, начинать ли забастовку.",
                                "zh": "工会举行了一次<w>投票</w>，以决定是否进行罢工。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "secret ballot",
                        "hold a ballot",
                        "strike ballot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система или процесс голосования, обычно тайного.",
                        "zh": "投票的制度或过程，通常是秘密进行的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голосова́ние",
                                "target_lang_sense_clarification": "процесс волеизъявления"
                            },
                            {
                                "target_lang_word": "баллотиро́вка",
                                "target_lang_sense_clarification": "устаревшее или официальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投票",
                                "target_lang_sense_clarification": "进行表决的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0918d3e-1ded-3501-849d-3c5dae9ece55",
                    "sense_definition": "A list of candidates or issues to be voted on in an election.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "voting_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were five different candidates for mayor on the <w>ballot</w>.",
                            "target_lang_translations": {
                                "ru": "В <w>бюллетене</w> было пять разных кандидатов на пост мэра.",
                                "zh": "<w>候选人名单</w>上有五位不同的市长竞选人。"
                            }
                        },
                        {
                            "text": "Her name did not appear on the official <w>ballot</w> due to a filing error.",
                            "target_lang_translations": {
                                "ru": "Её имени не оказалось в официальном <w>бюллетене</w> из-за ошибки при регистрации.",
                                "zh": "由于登记错误，她的名字没有出现在正式的<w>候选人名单</w>上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the ballot",
                        "ballot access"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список кандидатов или вопросов, вынесенных на голосование.",
                        "zh": "选举中供投票选择的候选人或议题列表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюллете́нь",
                                "target_lang_sense_clarification": "список кандидатов в документе"
                            },
                            {
                                "target_lang_word": "спи́сок кандида́тов",
                                "target_lang_sense_clarification": "перечень для выбора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "候选人名单",
                                "target_lang_sense_clarification": "选举中的参选人列表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9d5f131-25c1-3a87-8e02-1eca133a2b95",
                    "sense_definition": "The total number of votes cast in an election.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voting_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final <w>ballot</w> showed a clear victory for the incumbent president.",
                            "target_lang_translations": {
                                "ru": "Окончательные <w>итоги голосования</w> показали явную победу действующего президента.",
                                "zh": "最终的<w>投票结果</w>显示现任总统大获全胜。"
                            }
                        },
                        {
                            "text": "Officials worked through the night to count the <w>ballot</w> from the rural districts.",
                            "target_lang_translations": {
                                "ru": "Чиновники работали всю ночь, подсчитывая <w>голоса</w> из сельских округов.",
                                "zh": "官员们通宵工作，清点来自农村地区的<w>票数</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее количество голосов, поданных на выборах.",
                        "zh": "选举中投出的票数总和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ито́ги голосова́ния",
                                "target_lang_sense_clarification": "результат выборов"
                            },
                            {
                                "target_lang_word": "голоса́",
                                "target_lang_sense_clarification": "количество поданных бюллетеней"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投票结果",
                                "target_lang_sense_clarification": "选举的最终统计"
                            },
                            {
                                "target_lang_word": "票数",
                                "target_lang_sense_clarification": "投出的选票数量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8fa93003-f91f-3187-a923-66299bb06fc5",
                    "sense_definition": "To ask a group of people to vote on a proposal or issue.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "voting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trade union decided to <w>ballot</w> its members regarding the new pay offer.",
                            "target_lang_translations": {
                                "ru": "Профсоюз решил <w>провести голосование</w> среди своих членов по поводу нового предложения о зарплате.",
                                "zh": "工会决定就新的薪资提议向成员<w>组织投票</w>。"
                            }
                        },
                        {
                            "text": "Management will <w>ballot</w> the workforce next week on the proposed changes.",
                            "target_lang_translations": {
                                "ru": "Руководство <w>проведёт голосование</w> среди сотрудников на следующей неделе по предложенным изменениям.",
                                "zh": "管理层下周将就拟议的变更向员工<w>组织投票</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ballot members",
                        "ballot the workforce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просить группу людей проголосовать по какому-либо предложению или вопросу.",
                        "zh": "要求一群人就某项提议或议题进行投票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводи́ть голосова́ние",
                                "target_lang_sense_clarification": "организовывать опрос мнений"
                            },
                            {
                                "target_lang_word": "анкети́ровать",
                                "target_lang_sense_clarification": "опрашивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "组织投票",
                                "target_lang_sense_clarification": "发起投票活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a35b3d0-b2ab-3494-a916-653509d0d8da",
                    "sense_definition": "To cast a vote or decide something by using a ballot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee members will <w>ballot</w> for the new chairperson tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Члены комитета будут <w>голосовать</w> за нового председателя завтра утром.",
                                "zh": "委员会成员将于明早为新主席进行<w>投票</w>。"
                            }
                        },
                        {
                            "text": "They agreed to <w>ballot</w> secretly to ensure everyone felt free to choose.",
                            "target_lang_translations": {
                                "ru": "Они договорились <w>голосовать</w> тайно, чтобы каждый чувствовал свободу выбора.",
                                "zh": "他们同意秘密<w>投票</w>，以确保每个人都能自由选择。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ballot for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Голосовать или принимать решение посредством подачи бюллетеней.",
                        "zh": "通过投票来表达意愿或做出决定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голосова́ть",
                                "target_lang_sense_clarification": "отдавать голос"
                            },
                            {
                                "target_lang_word": "баллоти́роваться",
                                "target_lang_sense_clarification": "участвовать в выборах (реже в значении голосовать)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投票",
                                "target_lang_sense_clarification": "参与表决"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}