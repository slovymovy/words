                                        "entry_id": "8bc359a6-c448-33ed-9cf7-25916ae5f52a",
                                        "glosses": [
                                            "A short note; a memorandum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b46ded01-8d4d-4bac-b12d-4384ddea0575",
                                                "sense_id": "7bca29a6-ea3e-3d88-96f1-4ebe39d6dd64",
                                                "text": "According to yet another leaked memo, Powell responded the next day. Powell's leaked memo conceded that al Qaeda were not POWs, and that the Taliban individually or as a group might also lose their entitlement to that status."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdb501e6-6ea1-3d8e-89e2-a88dd9f4e1fa",
                                        "entry_id": "8bc359a6-c448-33ed-9cf7-25916ae5f52a",
                                        "glosses": [
                                            "A record of partial results that can be reused later without recomputation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1511c18-47aa-4287-bf75-572d346bbbd4",
                                                "sense_id": "fdb501e6-6ea1-3d8e-89e2-a88dd9f4e1fa",
                                                "text": "The first is that the recursive call finds its subproblem solution in the memo and returns immediately."
                                            }
                                        ]
                                    }
                                ]
                            },
