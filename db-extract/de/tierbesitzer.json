                "senses": [
                    {
                        "sense_id": "017d05ab-c469-34cc-9c0e-35a0060e5e76",
                        "entry_id": "0dbc128f-d354-35d5-bcad-94a935334b12",
                        "glosses": [
                            "Person, die die tatsächliche Herrschaft über ein Tier ausübt"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "9ab78fcf-a275-4b45-91d9-403cb80390fb",
                                "sense_id": "017d05ab-c469-34cc-9c0e-35a0060e5e76",
                                "text": "Die Tierbesitzerin bzw. der Tierbesitzer hat dafür zu sorgen, dass für Rinder zum Zeitpunkt des innerstaatlichen Inverkehrbringens entsprechende veterinärbehördliche Gesundheitsbescheinigungen vorliegen."
                            },
                            {
                                "example_id": "5c345ff7-3468-4518-a288-5aaf41a6d0de",
                                "sense_id": "017d05ab-c469-34cc-9c0e-35a0060e5e76",
                                "text": "Verbringungen, Verenden, Töten oder Schlachten von Sentineltieren sind vom Betriebsinhaber bzw. Tierbesitzer unverzüglich der zuständigen Bezirksverwaltungsbehörde zu melden."
                            },
                            {
                                "example_id": "98251ed2-84d7-41d7-89db-beac1729d49a",
                                "sense_id": "017d05ab-c469-34cc-9c0e-35a0060e5e76",
                                "text": "Besorgen sich Tierbesitzer Medikamente ohne Verordnung durch den Tierarzt, kann das die Gesundheit des Tieres gefährden."
                            },
                            {
                                "example_id": "c7e6b71b-8fd9-4027-a2b4-cb137f29347c",
                                "sense_id": "017d05ab-c469-34cc-9c0e-35a0060e5e76",
                                "text": "Das Thema Corona beschäftigt auch Tierbesitzer. Wohin mit dem eigenen Tier, wenn man an Covid-19 erkrankt oder als Kontaktperson eines Erkrankten in Quarantäne muss?"
                            },
                            {
                                "example_id": "62137153-8561-46f9-83b2-9d0eaa6389e8",
                                "sense_id": "017d05ab-c469-34cc-9c0e-35a0060e5e76",
                                "text": "Unverständnis und mangelndes Mitgefühl der Öffentlichkeit verleiten nicht wenige trauernde Tierbesitzer dazu, an ihren eigenen, realen Gefühlen zu zweifeln und gegen sie anzukämpfen."
                            },
                            {
                                "example_id": "dae6d4f0-9e96-44eb-8681-302f6e2bbeee",
                                "sense_id": "017d05ab-c469-34cc-9c0e-35a0060e5e76",
                                "text": "Für den Tierbesitzer ist es das Naheliegendste, sein geliebtes Tier im Garten oder in der Natur, etwa im Wald zu begraben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
