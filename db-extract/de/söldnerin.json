                ],
                "senses": [
                    {
                        "sense_id": "fa582b30-cb77-30f3-b2e0-0808a8c2484f",
                        "entry_id": "29169da3-1b84-3092-b810-3a1c07ab8e14",
                        "glosses": [
                            "gegen Bezahlung angeworbene, zeitlich (und vertraglich) befristet dienende Angehörige einer aus freiwilligen, zumeist fremdländischen Soldaten bestehenden Truppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5737783f-a43f-4394-b50f-0df2d74963ff",
                                "sense_id": "fa582b30-cb77-30f3-b2e0-0808a8c2484f",
                                "text": "„Die Söldnerin rannte durch einen engen Korridor, erreichte die Hintertür und durchquerte anschließend einen trostlosen Hinterhof.“"
                            },
                            {
                                "example_id": "e54d242b-01f4-400e-b833-d02fd2be8435",
                                "sense_id": "fa582b30-cb77-30f3-b2e0-0808a8c2484f",
                                "text": "„Alle drei Leichen streckten der Söldnerin den Mittelfinger entgegen, um sie zu beleidigen.“"
                            },
                            {
                                "example_id": "ccf4621c-96db-4685-a739-cfb4e289deee",
                                "sense_id": "fa582b30-cb77-30f3-b2e0-0808a8c2484f",
                                "text": "„Die Söldnerin versuchte, sich von der Panik zu befreien, schaute auf den Magier, der an Tempo gewann, und schöpfte wieder ein wenig Hoffnung.“"
                            },
                            {
                                "example_id": "b81053aa-b46e-41a5-a530-73f6790a602b",
                                "sense_id": "fa582b30-cb77-30f3-b2e0-0808a8c2484f",
                                "text": "„Ashborn stöhnt neben ihr also kümmert sich die Söldnerin erstmal um den bewusstlosen Thorben bringt ihn in eine stabile Seitenlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
