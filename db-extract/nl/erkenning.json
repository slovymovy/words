                        "sense_id": "a0230799-d84e-3e5c-96c8-dd86f3671429",
                        "entry_id": "bd84343c-d9de-37e4-acb8-a86633b9cb7e",
                        "glosses": [
                            "een bevestiging van de juistheid of geldigheid van iets"
