                    {
                        "sense_id": "4b510e52-ae1a-3e23-9759-d8652a6de7cc",
                        "entry_id": "241bcde5-f8dc-3cf0-b51b-0a092b738aae",
                        "glosses": [
                            "A manufacturing process; a particular industry or part of an industry."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4f165d8d-b577-4140-8cc2-4959e4e046e7",
                                "sense_id": "4b510e52-ae1a-3e23-9759-d8652a6de7cc",
                                "text": "The manufactory of sugar is generally in German hands."
                            }
                        ]
                    },
                    {
                        "sense_id": "da0c76f0-b7a5-3f59-82f8-23ea610be084",
                        "entry_id": "241bcde5-f8dc-3cf0-b51b-0a092b738aae",
                        "glosses": [
                            "A plant where something is manufactured; a factory."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c33d2b-758c-44ff-bc76-bcbc34ae6a6c",
                                "sense_id": "da0c76f0-b7a5-3f59-82f8-23ea610be084",
                                "text": "Smalt from the King of France's porcelain manufactory at Sevres fused into a mass, and resigned its colour."
                            },
                            {
                                "example_id": "f168a807-577e-4978-9034-df7f9498522c",
                                "sense_id": "da0c76f0-b7a5-3f59-82f8-23ea610be084",
                                "text": "We have just changed horses at Birmingham where I was two years ago and we visited the manufactories which are very curious."
                            },
                            {
                                "example_id": "6842fbbb-ffb0-48bd-a7c2-f919d3b202ff",
                                "sense_id": "da0c76f0-b7a5-3f59-82f8-23ea610be084",
                                "text": "The furnaces of the manufactory must be fed."
                            },
                            {
                                "example_id": "14176817-2e04-4d6b-b2e3-256b3ab8627b",
                                "sense_id": "da0c76f0-b7a5-3f59-82f8-23ea610be084",
                                "text": "Bradshaw is always ready to talk 'manufactories', and here he confides that the town [Basingstoke] \"carried on a rather considerable business in druggets, which has since fallen off\"."
                            }
                        ]
                    }
