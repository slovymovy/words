                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac3b5c8-94e7-4d60-8ffb-3c5b34fef5bc",
                                "sense_id": "affea42b-8383-35d7-bb4b-d9c9ca54e5bc",
                                "text": "„Mir fallen die Treffen der Vertriebenenverbände ein, wo alte Menschen Breslaus, Königsbergs, Ostpreußens und Schlesiens gedenken, aber kaum einer würde die Koffer packen und zurückwollen.“"
                            },
                            {
                                "example_id": "c9365919-fb98-439d-a0b3-0a710c3efb7f",
                                "sense_id": "affea42b-8383-35d7-bb4b-d9c9ca54e5bc",
                                "text": "„Während die Vertriebenenverbände lange Zeit versuchten, dem Stimmungsumschwung zu trotzen, machte sich bei vielen Betroffenen relativ früh Resignation breit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
