                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf8c3cc3-f698-322b-9547-486b21646305",
                        "entry_id": "929187d3-5857-37ac-a3f3-7fdec169b4bc",
                        "glosses": [
                            "Gerät zur Umwandlung von Gleichspannung in Wechselspannung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600f8599-e38a-4ba8-930f-d1cb4e4a98b1",
                                "sense_id": "cf8c3cc3-f698-322b-9547-486b21646305",
                                "text": "Der Aufbau eines Wechselrichters hängt stark von der Stromstärke ab, für die er ausgelegt ist."
                            },
                            {
                                "example_id": "9880e8f0-1291-465f-835f-f38e4e5d4cb6",
                                "sense_id": "cf8c3cc3-f698-322b-9547-486b21646305",
                                "text": "„Vom Erfolg ermutigt, vergrößerte sie die Anlage und installierte aus Solarmodulen, Akkus und Wechselrichtern ein komplettes Sonnenkraftwerk, das mittlerweile ihren gesamten Haushalt mit Strom versorgt.“"
                            },
                            {
                                "example_id": "cd6d7a72-e3c0-4679-acd4-dbf219724ea9",
                                "sense_id": "cf8c3cc3-f698-322b-9547-486b21646305",
                                "text": "„Die eigentlichen Solarzellen müssen auf Tragestrukturen montiert werden, Kabel werden gebraucht, ein Wechselrichter, der den Gleichstrom aus den Zellen in 220-Volt-Wechselstrom umwandelt, und Landfläche, sofern nicht das Dach benutzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
