                "senses": [
                    {
                        "sense_id": "51977cad-2d47-302d-8dc9-20b4269f4fa9",
                        "entry_id": "858cb06a-e06e-37c5-a639-cf3d8f3885d6",
                        "glosses": [
                            "Faire une feuillure dans une pièce de bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a411d171-2b90-446c-bed4-7a7c3a9f5df5",
                                "sense_id": "51977cad-2d47-302d-8dc9-20b4269f4fa9",
                                "text": "Feuiller une planche."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f24057d-28e7-3310-9aca-26d61bec9e57",
                        "entry_id": "858cb06a-e06e-37c5-a639-cf3d8f3885d6",
                        "glosses": [
                            "Couvrir de feuilles fraîches le fourneau où se préparera le charbon de bois."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9c578c3d-ba02-4f36-b140-be6bed1a88ba",
                                "sense_id": "2f24057d-28e7-3310-9aca-26d61bec9e57",
                                "text": "On voit que ces Charbonniers, pressés dans le travail, ne peuvent feuiller & couvrir de terre que la plus petite partie de leurs fourneaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "c822ca6e-40e1-36aa-b631-1f48ad77835f",
                        "entry_id": "858cb06a-e06e-37c5-a639-cf3d8f3885d6",
                        "glosses": [
                            "Dans un dessin, représenter le feuillage des arbres."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "70e8eee8-27a1-332b-a872-e6f564271e7c",
                        "entry_id": "858cb06a-e06e-37c5-a639-cf3d8f3885d6",
                        "glosses": [
                            "Se couvrir de feuilles, en parlant d’un arbre ou d’un arbuste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c5218f-ed5a-40d7-8785-a7ddb15c4c51",
                                "sense_id": "70e8eee8-27a1-332b-a872-e6f564271e7c",
                                "text": "Ainsi, parmi les plantes ligneuses, le sureau et la plupart des chèvres-feuilles sont toujours les premières qui feuillent ; parmi les plantes vivaces, le safran et la tulipe."
                            }
                        ]
                    }
