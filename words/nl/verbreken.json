                    "sense_definition": "fysiek kapotmaken of een bestaande verbinding beëindigen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke_scheiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij aarzelde om het zegel van de brief te <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "He hesitated to <w>break</w> the seal of the letter.",
                                "ru": "Он колебался, прежде чем <w>вскрыть</w> печать на письме.",
                                "pl": "Wahał się, czy <w>zerwać</w> pieczęć na liście.",
                                "de": "Er zögerte, das Siegel des Briefes zu <w>brechen</w>.",
                                "fr": "Il a hésité à <w>briser</w> le sceau de la lettre.",
                                "it": "Esitò a <w>rompere</w> il sigillo della lettera.",
                                "cs": "Váhal, zda <w>porušit</w> pečeť na dopise.",
                                "tr": "Mektubun mührünü <w>açmak</w> için tereddüt etti.",
                                "es": "Él dudó en <w>romper</w> el sello de la carta.",
                                "zh": "他犹豫着要不要<w>拆开</w>信上的火漆封印。"
                            }
                        },
                        {
                            "text": "De storm kon de verbinding tussen de twee schepen gemakkelijk <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "The storm could easily <w>sever</w> the connection between the two ships.",
                                "ru": "Шторм мог легко <w>разорвать</w> связь между двумя кораблями.",
                                "pl": "Sztorm mógł łatwo <w>przerwać</w> połączenie między dwoma statkami.",
                                "de": "Der Sturm konnte die Verbindung zwischen den beiden Schiffen leicht <w>trennen</w>.",
                                "fr": "La tempête pouvait facilement <w>rompre</w> la connexion entre les deux navires.",
                                "it": "La tempesta poteva facilmente <w>interrompere</w> il collegamento tra le due navi.",
                                "cs": "Bouře mohla snadno <w>přerušit</w> spojení mezi oběma loděmi.",
                                "tr": "Fırtına, iki gemi arasındaki bağlantıyı kolayca <w>koparabilirdi</w>.",
                                "es": "La tormenta pudo <w>cortar</w> fácilmente la conexión entre los dos barcos.",
                                "zh": "暴风雨很容易就能<w>切断</w>两艘船之间的联系。"
                            }
                        }
                    ],
