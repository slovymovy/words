                                                "example_id": "73b3d3bb-7aad-4142-8cb4-86239bfaa4cf",
                                                "sense_id": "73a8effb-27ac-3033-8137-4a49a3c05dba",
                                                "text": "He twisted his ankle sliding into the sack at second."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                                        "entry_id": "18bd51ad-7ae4-3186-8b9c-f77a1d62a82f",
                                        "glosses": [
                                            "Dismissal from employment, or discharge from a position."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46984046-5282-4709-9cb5-5442fa9e614d",
                                                "sense_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                                                "text": "give (someone) the sack"
                                            },
                                            {
                                                "example_id": "21d0e446-ec06-457b-a9b1-b5c07469962e",
                                                "sense_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                                                "text": "get the sack"
                                            },
                                            {
                                                "example_id": "762359b8-3342-4711-b8f5-b6afbccac341",
                                                "sense_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                                                "text": "The boss is gonna give her the sack today."
                                            },
                                            {
                                                "example_id": "d43ffe94-a5ba-4a4e-ace2-b8000a9925f8",
                                                "sense_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                                                "text": "He got the sack for being late all the time."
                                            },
                                            {
                                                "example_id": "14020665-da59-4eea-9217-90c7c4a04b6d",
                                                "sense_id": "f2f394be-9072-3d9b-8d1b-5d9c94b2bfaa",
                                                "text": "A climate researcher has been threatened with the sack by his employer after refusing to fly back to Germany at short notice after finishing fieldwork on Bougainville in the Solomon Islands archipelago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99be67b5-e891-3967-b412-32e407480ce5",
                                        "entry_id": "18bd51ad-7ae4-3186-8b9c-f77a1d62a82f",
                                        "glosses": [
                                            "Bed."
                                        ],
                                        "tags": [
                                            "US",
