                "senses": [
                    {
                        "sense_id": "2c15d07f-51d1-3a5a-9bc7-9833dcc062d1",
                        "entry_id": "ce9b1846-2500-3c36-8092-1cbeeb9e1991",
                        "glosses": [
                            "woman who bakes prosphora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b146b40-dafc-45cd-9edc-5e5e5b27fc62",
                                "sense_id": "2c15d07f-51d1-3a5a-9bc7-9833dcc062d1",
                                "text": "— Все грусти́т по му́же, — говори́л ста́роста, ука́зывая на неё просви́рне в кладби́щенской це́ркви, куда́ ка́ждую неде́лю приходи́ла моли́ться и пла́кать безуте́шная вдова́.",
                                "translation": "“She’s still in mourning for her husband,” said the elder, pointing her out to the woman who baked the communion wafer at the cemetery church, where the inconsolable widow went every week to pray and weep.",
                                "english": "“She’s still in mourning for her husband,” said the elder, pointing her out to the woman who baked the communion wafer at the cemetery church, where the inconsolable widow went every week to pray and weep."
                            }
                        ]
                    }
