                    {
                        "sense_id": "94d0e656-b639-3bc8-aabb-22d37e02a5f0",
                        "entry_id": "aae65633-b30e-3271-9a09-058eca3a2dd4",
                        "glosses": [
                            "Fenster (samt Rahmen und Sprossen), das im Wesentlichen aus Kunststoff und Glas besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8fbed7-d78e-4cb0-95bf-a92630147b44",
                                "sense_id": "94d0e656-b639-3bc8-aabb-22d37e02a5f0",
                                "text": "„Zusätzlich wurden die alten Fenster durch neue Kunststofffenster mit einer Doppelverglasung erneuert.“"
                            },
                            {
                                "example_id": "8b3c25d5-f57e-40a5-af03-53888f7d9ba4",
                                "sense_id": "94d0e656-b639-3bc8-aabb-22d37e02a5f0",
                                "text": "„Zu dieser Zeit produzierten und vertrieben lediglich zwei Mitarbeiter Kunststofffenster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
