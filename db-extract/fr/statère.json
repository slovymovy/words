                        "entry_id": "eeebee22-f4aa-3c00-b3ad-39237b3a7cd3",
                        "glosses": [
                            "Monnaie d’argent de la Grèce antique valant entre deux et quatre drachmes selon les régions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c36810b9-b5b3-4b3b-bb5e-e5890ec977b6",
                                "sense_id": "5da124cb-6fc7-307f-94d0-aa66c4e0b48e",
                                "text": "Ce sont des imitations tout d'abord assez fidèles du statère de Philippe II de Macédoine, qui représentent au droit la tête d’Apollon et au revers un char tiré par deux chevaux."
                            },
                            {
                                "example_id": "de5e4097-1e79-4b83-86fd-90ab4e901615",
                                "sense_id": "5da124cb-6fc7-307f-94d0-aa66c4e0b48e",
                                "text": "Les Gaulois contrefirent les statères macédoniens."
                            }
                        ]
