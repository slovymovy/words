                },
                {
                    "sense_id": "b180c766-c82d-3e62-bcd9-122fdb264398",
                    "sense_definition": "Supporting or representing extreme political or social reform from the root level.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She joined a <w>radical</w> political group that demanded immediate social equality.",
                            "target_lang_translations": {
                                "ru": "Она вступила в <w>радикальную</w> политическую группу, которая требовала немедленного социального равенства.",
                                "zh": "她加入了一个要求立即实现社会平等的<w>激进</w>政治团体。"
                            }
                        },
                        {
                            "text": "His <w>radical</w> ideas about education were often criticized by the conservative board.",
                            "target_lang_translations": {
                                "ru": "Его <w>радикальные</w> идеи об образовании часто подвергались критике со стороны консервативного совета.",
                                "zh": "他关于教育的<w>激进</w>思想经常受到保守派董事会的批评。"
                            }
                        }
