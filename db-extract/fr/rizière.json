        "fr-extract.jsonl": [
            {
                "entry_id": "3568c499-9111-31f2-b583-e21d3b712c11",
                "word": "rizière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8b722400-9593-477c-a934-964d44f6f8d6",
                        "entry_id": "3568c499-9111-31f2-b583-e21d3b712c11",
                        "tags": [
                            "plural"
                        ],
                        "form": "rizières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "653d5005-bd79-3e37-9806-620408a59f1c",
                        "entry_id": "3568c499-9111-31f2-b583-e21d3b712c11",
                        "glosses": [
                            "Champ de riz."
                        ],
                        "tags": [
                            "Agronomie",
                            "Ethnobiologie",
                            "Hydrobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cca0da54-0927-410c-bb8f-de89e9327ffa",
                                "sense_id": "653d5005-bd79-3e37-9806-620408a59f1c",
                                "text": "L'ennemi réel n'était pas le pauvre nhaqué enfoui dans la boue des rizières, le chleuh retrouvant son moukkala, le fellaga terré dans son djebel."
                            },
                            {
                                "example_id": "95ffee07-883a-4381-8633-b6d496d3ad10",
                                "sense_id": "653d5005-bd79-3e37-9806-620408a59f1c",
                                "text": "Blaise regarde son ancien champ de manioc, transformé en zone de reboisement, en espérant que l'eau reviendra. Ce paysan d’Ampitabe, au centre de Madagascar, a cédé le terrain qu'il cultivait à sa communauté. À vrai dire, le sol épuisé ne donnait plus rien. Pour planter, la forêt qui recouvrait sa parcelle a été brûlée depuis longtemps. Les arbres n’ont plus joué leur rôle d’éponge naturelle de l’eau de pluie. La petite rizière située en contrebas s’assèche désormais à vue d'œil."
                            },
                            {
                                "example_id": "1afe10de-0d51-4c33-a6f8-d9027d0cc0e3",
                                "sense_id": "653d5005-bd79-3e37-9806-620408a59f1c",
                                "text": "Ce système, très ancien, ne suppose aucun aménagement hydraulique. Il repose sur l'utilisation de variétés locales de «riz flottant» capable de surmonter une submersion de trois mètres. La rizière est située en fonction de la hauteur de crue espérée par le riziculteur qui se fie à son expérience et peut déplacer son champ chaque année."
                            },
                            {
                                "example_id": "615f4574-070f-4504-b724-9bf06d46b52d",
                                "sense_id": "653d5005-bd79-3e37-9806-620408a59f1c",
                                "text": "Dans cette région ombreuse se succèdent de petites montagnes aux épaisses forêts de conifères, dont le vert profond contraste avec celui, pâle, des vaporeux bambous du fond des vallées, où grondent des torrents et s’échelonnent des rizières en terrasses."
                            },
                            {
                                "example_id": "348dac0e-99ab-49ee-9175-a8651370e3e3",
                                "sense_id": "653d5005-bd79-3e37-9806-620408a59f1c",
                                "text": "À la hauteur de Nonthaburi le tissu urbain s’effilocha, nous aperçûmes les premières rizières. Des buffles immobiles dans la boue suivaient l’autocar du regard, exactement comme l’auraient fait des vaches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7866f738-8e33-4a56-88d4-78d8c7d5f2d8",
                        "source_entry_id": "3568c499-9111-31f2-b583-e21d3b712c11",
                        "source_sense_id": "653d5005-bd79-3e37-9806-620408a59f1c",
                        "target_lang_word": "Reisfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reisfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                                        "entry_id": "aa3cf350-f6ca-3323-97be-ac938e0e2b47",
                                        "glosses": [
                                            "Feld, auf dem Reis angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d2ecd2-5598-40bb-aaff-60eee29366f7",
                                                "sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                                                "text": "„Überflutete Reisfelder setzen einen Großteil des Treibhausgases Methan frei.“"
                                            },
                                            {
                                                "example_id": "5f0d89e3-0317-43b9-80d2-174a20fc9315",
                                                "sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                                                "text": "„Wenn alles vorbei war, kehrten sie auf ihre Reisfelder zurück, als wäre nichts geschehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58dbdef8-7f01-4aa4-979f-f9c6a2d27728",
                        "source_entry_id": "3568c499-9111-31f2-b583-e21d3b712c11",
