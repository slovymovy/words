                                    {
                                        "sense_id": "0c02ee97-83c2-37d1-9bed-a9fbc8e7c23f",
                                        "entry_id": "b3020827-2386-3312-ad07-fb0dfb7a666d",
                                        "glosses": [
                                            "ein Gewürz, das aus den Samenkörnern des Schwarzen (Brassica nigra), Braunen (Brassica juncea) und Weißen Senfs (Sinapis alba) hergestellt wird. Für Speisesenf werden die Senfkörner gemahlen und mit Essig, Wein und anderen Gewürzen vermischt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "076baaad-389d-4595-8aa9-5e50d8b18b4b",
                                                "sense_id": "0c02ee97-83c2-37d1-9bed-a9fbc8e7c23f",
                                                "text": "Möchten sie die Bratwurst mit Senf oder Ketchup?"
                                            },
                                            {
                                                "example_id": "9bb801ed-cebc-4632-b736-9e051792d9a2",
                                                "sense_id": "0c02ee97-83c2-37d1-9bed-a9fbc8e7c23f",
                                                "text": "„Der Senf glänzte in der Mittagssonne wie flüssiges Gold.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1b3aab8-3ffc-39c0-b3e5-55b4bb8eea85",
                                        "entry_id": "b3020827-2386-3312-ad07-fb0dfb7a666d",
                                        "glosses": [
                                            "Pflanze der Gattung Sinapis (Familie der Kreuzblütler)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6988e01d-fa18-47c7-b2b6-428fc20fc8bb",
                                                "sense_id": "f1b3aab8-3ffc-39c0-b3e5-55b4bb8eea85",
                                                "text": "Der Senf (Sinapis alba) gehört zur Familie der Kreuzblütler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9492b306-6249-3c1f-b95b-cb4b6063c1b8",
                                        "entry_id": "b3020827-2386-3312-ad07-fb0dfb7a666d",
                                        "glosses": [
                                            "unpassende Bemerkung, die ein Dritter zu einem Gespräch von anderen Personen beisteuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a01b96-75ef-4d06-8cd5-cc18bef9f35d",
                                                "sense_id": "9492b306-6249-3c1f-b95b-cb4b6063c1b8",
                                                "text": "Musst du immer ungefragt deinen Senf dazugeben?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
