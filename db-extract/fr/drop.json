                                        "entry_id": "8f5beaa4-0070-340a-bf74-33c7e1e13100",
                                        "glosses": [
                                            "A kick of the ball through the uprights and over the crossbar (not after a touchdown). It scores 3 points."
                                        ],
                                        "tags": [
                                            "Canadian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9153882-beba-4893-8102-84eac98edd04",
                                                "sense_id": "3716c83f-14ff-3723-b565-a9982c738986",
                                                "text": "He kicked a 33 yard field goal just before the half."
                                            },
                                            {
                                                "example_id": "ea15bacc-6243-47ae-97da-0eed0c884d00",
                                                "sense_id": "3716c83f-14ff-3723-b565-a9982c738986",
                                                "text": "Sure, Homer and Marge being caught naked in front of the town is funny, but why not make it total humiliation? Why not have Homer dragged ass-first over a church’s glass ceiling and force the pastor to give praise to God’s floors? Why not have Homer’s rear end block a game-winning field goal?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38f5a8e-d581-3938-8a0c-40919ef8d701",
                                        "entry_id": "8f5beaa4-0070-340a-bf74-33c7e1e13100",
                                        "glosses": [
                                            "A shot that is scored while the ball is in play (i.e. not a free throw)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0466ed66-2d44-4e5c-b41a-29d18e1128d9",
                                                "sense_id": "a38f5a8e-d581-3938-8a0c-40919ef8d701",
                                                "text": "He got six field goals in the first half, two from three-point land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26060acc-b6f7-3413-8122-006a2faa23eb",
                                        "entry_id": "8f5beaa4-0070-340a-bf74-33c7e1e13100",
                                        "glosses": [
                                            "A goal scored where a ball that is in play but on the ground is kicked through the uprights and over the crossbar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
