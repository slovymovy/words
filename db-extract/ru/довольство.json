                ],
                "senses": [
                    {
                        "sense_id": "883bb220-5d35-3d69-afdf-ce0047a7a32e",
                        "entry_id": "604b1345-0e31-3fe7-b80d-ffc85ea59f08",
                        "glosses": [
                            "материальный достаток, зажиточность"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c53cccf7-7a0c-34c4-b359-a4e1e36299a4",
                        "entry_id": "604b1345-0e31-3fe7-b80d-ffc85ea59f08",
                        "glosses": [
                            "удовлетворение, удовлетворённое состояние"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fdd0042-d3bd-4b3e-8110-4164dc12e52e",
                        "source_entry_id": "604b1345-0e31-3fe7-b80d-ffc85ea59f08",
                        "source_sense_description": "материальный достаток",
                        "target_lang_word": "aisance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aisance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "Liberté de corps et d’esprit dans le travail, dans les mouvements, dans les manières, dans le commerce de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b171f4e5-fa88-4c49-9581-3e51aeced1d9",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "Avec une aisance qui confond —une aisance, une force d’élément— il menait de front quatre livres, des pièces de théâtre, des polémiques de journal, des affaires de toutes sortes."
                                            },
                                            {
                                                "example_id": "48ddb4c5-df08-43c0-9239-db1e559dfb76",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "Mmes Daudoird et Clara Lemonnier, dont la première portait l’habit noir avec un chic et une aisance qui auraient damé le pion au clubman le plus élégant."
                                            },
                                            {
                                                "example_id": "acc6b150-fd0e-4969-8d68-faf433ac844f",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "L’aisance avec laquelle les poètes juifs maniaient le vers français permet de supposer que leur talent a dû s’exercer dans les genres les plus variés."
                                            },
                                            {
                                                "example_id": "59ece4f3-91b2-4597-a132-b4d1e38cf818",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "Ils manient avec une élégante aisance les mètres latins les plus compliqués et les vocables les plus choisis de la mythologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "État de fortune suffisant pour se procurer les commodités de la vie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc95ecd6-6358-4039-99a0-433cf3e8096c",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "Elle vit l’opulence & les richesses succéder à l’aisance ; & son père , avant tout cela , avoit connu le mésaise & presque la pauvreté."
                                            },
                                            {
                                                "example_id": "7e6f9885-369d-4885-bb5d-4d39228f1251",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "Aussi, dès qu’un paysan a réalisé une minime aisance, fait-il badigeonner d’ocre la façade et les murs intérieurs de son réduit : […]"
                                            },
                                            {
                                                "example_id": "4103bc40-ad86-4dd2-bb5e-4b70f1315608",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "[…] moi, mon rêve est de me retirer dans quelques années d’ici, au fond de l’une de nos belles provinces mexicaines avec une modeste aisance, vous voyez que je ne suis pas ambitieux."
                                            },
                                            {
                                                "example_id": "978af20e-9c51-4411-aad2-6d2f302f23c3",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "Le fait, d’ailleurs, est patent, incontesté, affirmé de tous côtés : l’aisance s’est énormément développée parmi les ruraux des Côtes-du-Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "Espace forestier dans lequel les villageois pouvaient tirer leur subsistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099cb134-bcea-4143-82f4-0e0f55c561c7",
                                                "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                                "text": "Il sera permis à tous et chacun de nos sujets, manants dudit village, de sartager chaque année un demi journal d’aisance, pour y semer du dur grain et ensuite une avoine tant seulement."
                                            },
                                            {
                                                "example_id": "606115d4-935a-45c2-a4ee-6b4de102ae66",
                                                "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                                "text": "[…] ; à quoi Sa Sérénissime Éminence voulant pourvoir, fait défense sérieuse à tous un chacun de sartager les voies herdales et aisances communes, comme aussi de faire fendre ni labourer en aucune manière le gazon commun, sans enseignement et permission expresse compétente, à peine d’une amende de dix florins d'or pour chaque fois, […]."
                                            },
                                            {
                                                "example_id": "2719f098-5c50-4148-866b-22e77e7c576b",
                                                "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                                "text": "Aux premiers temps, l'exploitation avait comme seule et unique règle : les besoins: on ne prenait en forêt que ce qui était utile (les « aisances » ou « commodités ») et on laissait sur place tout le reste. Chacun se servait là où bon lui semblait, et coupait les arbres qui lui convenaient: la forêt était le domaine de la liberté, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "Lieu pratiqué dans une maison pour y satisfaire les besoins naturels."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed24481-63f3-4526-9b4b-116912f3adcf",
                                                "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                                "text": "Lieux d’aisances."
                                            },
                                            {
                                                "example_id": "b89ceb81-4b62-436c-9b06-5e832dc30437",
                                                "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                                "text": "Cabinet d’aisances."
                                            },
                                            {
                                                "example_id": "bea0f13d-9990-4cb3-b874-5cb4b127053e",
                                                "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                                "text": "Fosse d’aisances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4d3a2d6-4406-4074-bc97-312fc158c0c4",
                        "source_entry_id": "604b1345-0e31-3fe7-b80d-ffc85ea59f08",
                        "source_sense_description": "удовлетворение, удовлетворённое состояние",
                        "target_lang_word": "satisfaction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satisfaction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Contentement, plaisir que nous éprouvons quand les choses sont telles que nous pouvons les souhaiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5e510d-8c84-4990-8521-9811874399f6",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "À plusieurs reprises, il s’était frotté joyeusement les mains, ce qui, chez lui, ne pouvait passer pour une satisfaction banale."
                                            },
                                            {
                                                "example_id": "921ff455-b957-4587-be79-0b4aed2d239f",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Et il savait que la satisfaction de ses désirs d’un moment ne méritait point qu’il s’engageât toute sa vie."
                                            },
                                            {
                                                "example_id": "8e3940a8-8e0d-409d-a389-7d1ef1914bec",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Vois-tu, dans le monde entier, question rigolade et satisfaction, il n’y a que Paris qui compte, et dans Paris, Montmartre."
                                            },
                                            {
                                                "example_id": "5f115236-b8c5-4369-b259-a112730405c9",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Ce prologue le fatiguait, mais il ne pouvait l’écourter. L’éloquence fait partie de la fonction ; et il en avait trop complaisamment composé les périodes pour se priver de la satisfaction de s’entendre les phraser et de jouir de ces cadences étudiées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Réponse à un besoin de sorte qu’il ne soit plus nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9686134b-48f0-44eb-afb9-460c22772cb2",
                                                "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                                "text": "Satisfaction des besoins naturels."
                                            },
                                            {
                                                "example_id": "53860a98-f80a-4bbf-bbd1-5dbd405b5f41",
                                                "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                                "text": "Attendu que la société Cometik fait grief à l’arrêt d’anéantir les effets du contrat, de la condamner à rembourser à Mme X... les sommes par elle versées en exécution de celui-ci et de rejeter ses demandes, alors, selon le moyen, que l’objet d’un contrat entre dans le champ de l’activité principale du professionnel lorsqu’il participe à la satisfaction des besoins de l’activité professionnelle ; que la cour d’appel a elle-même retenu que le contrat conclu le 17 juillet 2014 par Mme X... portait « notamment sur la création d’un site Internet dédié à son activité » ; qu’en retenant pourtant que ce contrat n’entre pas dans le champ de l’activité principale du professionnel, la cour d’appel n’a pas tiré les conséquences légales de ses propres constatations et a violé l’article L. 121-16-1, III, du code de la consommation, dans sa rédaction applicable en la cause ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6730d9c0-920f-3a5e-8158-4dd0a4486137",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Action de satisfaire quelqu’un en réparation de l’offense qu’on lui a faite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e652c61e-54cf-4212-8ba2-d8dbf784fca2",
                                                "sense_id": "6730d9c0-920f-3a5e-8158-4dd0a4486137",
                                                "text": "Il faut que la satisfaction soit proportionnée à l’offense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d42219c-fdd4-3e15-97b8-ec17a6a9ab38",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Ce qu’on est obligé de faire à l’égard de Dieu, en réparation des péchés qu’on a commis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03046292-1163-4eb8-b06d-1369e6251ebf",
                                                "sense_id": "3d42219c-fdd4-3e15-97b8-ec17a6a9ab38",
                                                "text": "La satisfaction fait partie du sacrement de Pénitence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30fd80a7-9f4d-46f9-a2a4-75782bc9c9d0",
                        "source_entry_id": "604b1345-0e31-3fe7-b80d-ffc85ea59f08",
                        "source_sense_description": "удовлетворение, удовлетворённое состояние",
                        "target_lang_word": "contentement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contentement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                        "entry_id": "bae069b4-4746-37ee-8f44-264f6440d099",
                                        "glosses": [
                                            "État de celui qui est content, satisfait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd699e5-af68-42b7-96bb-37093c3db741",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "[…], mais on peut aussi être tout à la fois très riche et très malheureux, car l’argent ne donne ni la santé, ni le contentement de soi-même, et il ne préserve pas de l’ennui, cette plaie des oisifs opulents."
                                            },
                                            {
                                                "example_id": "1c28fd9c-4961-4174-ad23-014dac9491bd",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Rougon lui-même se laissa prendre à ce contentement de l’homme illettré qui voit ses enfants devenir plus savants que lui."
                                            },
                                            {
                                                "example_id": "14ff22fb-a36c-4eb4-a579-e65302d7fcf3",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Un chaud contentement lui venait, grâce à cette demi-bouteille de Pouilly."
                                            },
                                            {
                                                "example_id": "3d142dd1-1bce-4d5f-be79-24408e99acc2",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Angelo avait surveillé avec grand soin l’ébullition de l’eau pour le thé. Il montra aussi beaucoup de contentement personnel du sac de farine de maïs, de la cassonade et de douze œufs durs qu’il avait eu l’esprit de faire préparer."
                                            },
                                            {
                                                "example_id": "575337ba-3285-467f-9ea7-bebdccb51e8b",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "– Y a qu’la cavalerie ! Ça, c’est quelque chose ! T’as un cheval à toi, c’est ton compagnon, et si tu l’soignes bien, si tu l’dresses comme il faut, sans brutalité, avec lui t’as que des contentements."
                                            },
                                            {
                                                "example_id": "1b3519d9-10cd-44f6-9f10-8f87a26ad2f8",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Une sorte de contentement donnait à son teint une lueur presque phosphorescente."
                                            },
                                            {
                                                "example_id": "cc12210f-4529-473c-9dbc-f6d53b6b4385",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": ". Immobiles, calmes et droits, nous étions enfin capables de comprendre pourquoi il émanait des chats au carreau cette gravité des êtres parvenus au contentement intégral, synonyme de la vie réussie, antipode de l’inquiétude humaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
