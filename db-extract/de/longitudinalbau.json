                                "example_id": "4e1de767-f468-41fc-a27d-834cb847a02e",
                                "sense_id": "3d209015-07ef-39e2-8453-dca896b633a7",
                                "text": "Die Kirche Santa Maria Maggiore in Rom ist ein deutlich erkennbarer Longitudinalbau mit breitem Mittelschiff und zwei fensterlosen, ungewölbten Seitenschiffen."
                            },
