                        "examples": [
                            {
                                "example_id": "4d7b63b0-2741-4b35-81d8-11cbd6bd9dee",
                                "sense_id": "8616b7e2-3bfa-32e9-8d5c-3152d6910f55",
                                "text": "Quand Brissac eut donné tout loisir aux dames de s’éloigner et de ne pouvoir entendre le retour des gardes, il les fit reposter."
                            },
                            {
                                "example_id": "6acf31da-99b3-4b4e-b87e-2f12fcc496d7",
                                "sense_id": "8616b7e2-3bfa-32e9-8d5c-3152d6910f55",
                                "text": "La serveuse s’était repostée derrière le bar avec l’air d’avoir été décérébrée la veille."
                            }
                        ]
                    }
