                                            {
                                                "example_id": "2d22ce17-22e8-4e07-a27a-be5e85598b01",
                                                "sense_id": "e425013a-bd3d-31a4-9c63-3bae1bdd1e04",
                                                "text": "Zij maakten een inspannende fietstocht door de Bordeaux."
