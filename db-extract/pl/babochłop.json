                                "target_senses": [
                                    {
                                        "sense_id": "02e36d6c-8998-3b18-b061-16a67a5332f5",
                                        "entry_id": "b4281e89-18f0-391c-a5d2-bb45c90cac2d",
                                        "glosses": [
                                            "Frau, die sich wie ein Mann verhält oder so aussieht"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
