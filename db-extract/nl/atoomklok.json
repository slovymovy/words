                    {
                        "sense_id": "5167f1ff-5f2a-3d53-b0ce-249c90316b5b",
                        "entry_id": "748f5114-035d-3453-886d-790424e220b6",
                        "glosses": [
                            "apparaat voor zeer nauwkeurige tijdmeting, berustend op de trillingen van atomen bijvoorbeeld van cesium, kwik, ytterbium, of strontium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492004bd-3eec-46e5-b130-cf09ec03b779",
                                "sense_id": "5167f1ff-5f2a-3d53-b0ce-249c90316b5b",
                                "text": "Nieuwe atoomklok verbreekt wereldrecords"
                            },
                            {
                                "example_id": "fbda3413-7a68-4980-b778-4c19628cac77",
                                "sense_id": "5167f1ff-5f2a-3d53-b0ce-249c90316b5b",
                                "text": "Lasers zijn waarschijnlijk niet het eerste waaraan je denkt bij een klok, maar ze vormen een cruciaal onderdeel van ’s werelds nauwkeurigste uurwerken: optische atoomklokken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85df3b3f-4e19-46ae-abd0-9df11a36e755",
                        "source_entry_id": "748f5114-035d-3453-886d-790424e220b6",
                        "source_sense_id": "5167f1ff-5f2a-3d53-b0ce-249c90316b5b",
                        "target_lang_word": "Atomuhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atomuhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fe254ea-d338-385c-98fa-23ce3a7800a5",
                                        "entry_id": "2494d8dd-af36-3926-aecf-6ec4b4f6b936",
                                        "glosses": [
                                            "Uhr, deren Zeittakt mit atomaren Schwingungszuständen abgeglichen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8451818-949f-4b52-b9cc-4b63d63ded30",
                                                "sense_id": "8fe254ea-d338-385c-98fa-23ce3a7800a5",
                                                "text": "Aus den Messwerten von über 260 Atomuhren an über 60 weltweit verteilten Instituten legt das „Bureau International des Poids et Mesures“ (BIPM) in Paris die „Internationale Atomzeit“ (TAI) als Referenzzeit fest."
                                            },
                                            {
                                                "example_id": "a43b9f4c-9fb3-470f-85ab-16417f79aa0b",
                                                "sense_id": "8fe254ea-d338-385c-98fa-23ce3a7800a5",
                                                "text": "„Atomuhren bestimmen unseren Alltag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c7f4844-45d8-4e12-aa6b-f5405ed9e53d",
                        "source_entry_id": "748f5114-035d-3453-886d-790424e220b6",
                        "source_sense_id": "5167f1ff-5f2a-3d53-b0ce-249c90316b5b",
