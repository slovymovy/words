            "senses": [
                {
                    "sense_id": "78660d59-7655-3f4e-b97c-37b05a541aa3",
                    "sense_definition": "Désigne une personne ou une chose en opposition ou en corrélation avec une autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils se connaissent très bien et se soutiennent constamment <w>l'un</w> l'autre."
                        },
                        {
                            "text": "Nous devons choisir <w>l'un</w> ou l'autre de ces deux projets dès demain."
                        }
                    ],
                    "common_phrases": [
                        "l'un l'autre",
                        "l'un ou l'autre",
                        "ni l'un ni l'autre",
                        "l'un après l'autre"
                    ]
                },
                {
                    "sense_id": "237f6598-944e-3ab7-8bbe-a0f5dbd05b64",
                    "sense_definition": "Désigne un élément ou une personne au sein d'un ensemble, généralement suivi de la préposition de.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune médecin est considéré comme <w>l'un</w> des meilleurs de sa génération."
                        },
                        {
                            "text": "Elle a récemment rencontré <w>l'un</w> de ses anciens camarades de classe à la gare."
                        }
                    ],
                    "common_phrases": [
                        "l'un de",
                        "l'un des plus",
                        "l'un d'entre eux"
                    ]
                }
            ]
        },
        {
