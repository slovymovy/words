{
    "word_family": [
        "butchery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00a982e3-d6e9-3dcf-b494-ee0c0a06dc10",
                    "sense_definition": "A person who prepares and sells meat (and sometimes also slaughters the animals).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meat_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went to the <w>butcher</w> to buy some fresh steaks for dinner.",
                            "target_lang_translations": {
                                "ru": "Я пошел к <w>мяснику</w>, чтобы купить свежих стейков на ужин.",
                                "zh": "我去了<w>屠夫</w>那里买些新鲜牛排做晚餐。"
                            }
                        },
                        {
                            "text": "The <w>butcher</w> sharpened his knife before cutting the large piece of beef.",
                            "target_lang_translations": {
                                "ru": "<w>Мясник</w> наточил свой нож перед тем, как отрезать большой кусок говядины.",
                                "zh": "<w>屠夫</w>在切那大块牛肉前磨了磨刀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the local butcher",
                        "butcher shop",
                        "at the butcher's"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который разделывает и продает мясо (иногда также забивает животных).",
                        "zh": "从事肉类加工和销售的人（有时也负责屠宰动物）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мясник",
                                "target_lang_sense_clarification": "профессия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠夫",
                                "target_lang_sense_clarification": "职业"
                            },
                            {
                                "target_lang_word": "肉贩",
                                "target_lang_sense_clarification": "卖肉的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fb50cd1-4033-3fa3-9527-e376bf93c8bb",
                    "sense_definition": "A brutal or indiscriminate killer.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "killing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator was known as the <w>butcher</w> of the revolution due to his cruelty.",
                            "target_lang_translations": {
                                "ru": "Диктатор был известен как <w>мясник</w> революции из-за своей жестокости.",
                                "zh": "由于其残暴行径，这位独裁者被称为革命的<w>屠夫</w>。"
                            }
                        },
                        {
                            "text": "History will remember him not as a leader, but as a ruthless <w>butcher</w>.",
                            "target_lang_translations": {
                                "ru": "История запомнит его не как лидера, а как безжалостного <w>мясника</w>.",
                                "zh": "历史记住的将不是他的领袖身份，而是一个冷酷无情的<w>屠夫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slayer"
                    ],
                    "common_phrases": [
                        "butcher of innocent people",
                        "bloodthirsty butcher"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестокий или беспорядочный убийца.",
                        "zh": "残忍或滥杀无辜的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мясник",
                                "target_lang_sense_clarification": "перен. жестокий человек"
                            },
                            {
                                "target_lang_word": "палач",
                                "target_lang_sense_clarification": "перен. мучитель"
                            },
                            {
                                "target_lang_word": "убийца",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠夫",
                                "target_lang_sense_clarification": "比喻残忍的人"
                            },
                            {
                                "target_lang_word": "刽子手",
                                "target_lang_sense_clarification": "比喻杀人者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64eacc83-6177-3173-a4e5-19ecc59d0031",
                    "sense_definition": "A look.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's have a <w>butchers</w> at that new car you bought.",
                            "target_lang_translations": {
                                "ru": "Давай <w>взглянем</w> на ту новую машину, которую ты купил.",
                                "zh": "让我们<w>看</w>一眼你买的那辆新车。"
                            }
                        },
                        {
                            "text": "Take a <w>butchers</w> at this report and tell me what you think.",
                            "target_lang_translations": {
                                "ru": "<w>Взгляни</w> на этот отчет и скажи мне, что ты думаешь.",
                                "zh": "<w>看</w>一下这份报告，告诉我你的想法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a butchers",
                        "take a butchers"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Cockney rhyming slang (short for 'butcher's hook')."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взгляд (на что-либо).",
                        "zh": "看一眼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1abd456-5f23-3ad5-9300-db1cea33f67a",
                    "sense_definition": "To slaughter (animals) and prepare (meat) for market.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meat_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers often <w>butcher</w> their own livestock before the winter sets in.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто сами <w>забивают</w> свой скот перед наступлением зимы.",
                                "zh": "农民通常在入冬前自己<w>屠宰</w>牲畜。"
                            }
                        },
                        {
                            "text": "They plan to <w>butcher</w> the pig and cure the meat for ham.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>разделать</w> свинью и засолить мясо для ветчины.",
                                "zh": "他们打算<w>宰杀</w>那头猪，并把肉腌制成火腿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slaughter"
                    ],
                    "common_phrases": [
                        "butcher a cow",
                        "butcher livestock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забивать (животных) и разделывать (мясо) для продажи.",
                        "zh": "屠宰（动物）并加工（肉类）以供销售。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "убивать скот"
                            },
                            {
                                "target_lang_word": "разделывать",
                                "target_lang_sense_clarification": "тушу"
                            },
                            {
                                "target_lang_word": "резать",
                                "target_lang_sense_clarification": "разг. убивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠宰",
                                "target_lang_sense_clarification": "杀牲畜"
                            },
                            {
                                "target_lang_word": "宰杀",
                                "target_lang_sense_clarification": "杀并处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec772910-6512-3e21-830f-4f6ab2a3452d",
                    "sense_definition": "To mess up hopelessly; to botch; to distort beyond recognition.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry if I <w>butcher</w> your name during the introduction.",
                            "target_lang_translations": {
                                "ru": "Прошу прощения, если я <w>исковеркаю</w> ваше имя во время представления.",
                                "zh": "如果我在介绍时把你的名字<w>糟蹋</w>了，我很抱歉。"
                            }
                        },
                        {
                            "text": "The amateur band completely <w>butchered</w> our favorite song last night.",
                            "target_lang_translations": {
                                "ru": "Любительская группа вчера вечером полностью <w>испортила</w> нашу любимую песню.",
                                "zh": "那个业余乐队昨晚彻底<w>糟蹋</w>了我们最喜欢的歌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "butcher the pronunciation",
                        "butcher a song",
                        "butcher the language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безнадежно испортить; исковеркать; исказить до неузнаваемости.",
                        "zh": "彻底搞砸；拙劣地处理；歪曲到无法辨认。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исковеркать",
                                "target_lang_sense_clarification": "язык, имя"
                            },
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "песню, дело"
                            },
                            {
                                "target_lang_word": "изуродовать",
                                "target_lang_sense_clarification": "сильно исказить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟蹋",
                                "target_lang_sense_clarification": "毁坏或浪费"
                            },
                            {
                                "target_lang_word": "搞砸",
                                "target_lang_sense_clarification": "处理得很差"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8c0143e-4d67-34bb-be69-a6b9b719ca03",
                    "sense_definition": "To kill brutally.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "killing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invading army <w>butchered</w> thousands of innocent civilians in the village.",
                            "target_lang_translations": {
                                "ru": "Вторгшаяся армия <w>вырезала</w> тысячи невинных мирных жителей в деревне.",
                                "zh": "入侵军队在村子里<w>屠杀</w>了数千名无辜平民。"
                            }
                        },
                        {
                            "text": "He was accused of <w>butchering</w> his rivals to secure his power.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он <w>зверски убил</w> своих соперников, чтобы укрепить свою власть.",
                                "zh": "他被指控为了巩固权力而<w>残杀</w>竞争对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slaughter",
                        "massacre",
                        "murder",
                        "slay"
                    ],
                    "common_phrases": [
                        "butcher civilians",
                        "butcher the innocent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестоко убивать; устраивать резню.",
                        "zh": "残忍地杀害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырезать",
                                "target_lang_sense_clarification": "массово убивать"
                            },
                            {
                                "target_lang_word": "устраивать резню",
                                "target_lang_sense_clarification": "учинять бойню"
                            },
                            {
                                "target_lang_word": "зверски убивать",
                                "target_lang_sense_clarification": "с особой жестокостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠杀",
                                "target_lang_sense_clarification": "大规模杀戮"
                            },
                            {
                                "target_lang_word": "残杀",
                                "target_lang_sense_clarification": "残酷地杀害"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e2439b3e-f2b9-36d2-b4b1-ff7a96a7e064",
                    "sense_definition": "A surname originating as an occupation for a butcher.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Butcher</w> has lived in this neighborhood for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бутчер</w> живет в этом районе уже более двадцати лет.",
                                "zh": "<w>布彻</w>先生在这个社区已经住了二十多年了。"
                            }
                        },
                        {
                            "text": "We have a meeting with Ms. <w>Butcher</w> tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У нас встреча с мисс <w>Бутчер</w> завтра утром.",
                                "zh": "我们明天早上要和<w>布彻</w>女士开会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от профессии мясника.",
                        "zh": "源自屠夫职业的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бутчер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布彻",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc5bbd7a-f03e-3cc7-872b-4de0305bfe9a",
                    "sense_definition": "Comparative form of <w>butch</w>: more butch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to adopt a <w>butcher</w> style with her new haircut and clothing.",
                            "target_lang_translations": {
                                "ru": "Она решила выбрать более <w>мужеподобный</w> стиль с новой стрижкой и одеждой.",
                                "zh": "她决定通过新的发型和服装来展现一种<w>更男性化</w>的风格。"
                            }
                        },
                        {
                            "text": "He tried to look <w>butcher</w> than he actually felt.",
                            "target_lang_translations": {
                                "ru": "Он пытался выглядеть <w>брутальнее</w>, чем чувствовал себя на самом деле.",
                                "zh": "他试图让自己看起来比实际感觉<w>更男性化</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень от butch: более мужеподобный.",
                        "zh": "butch 的比较级：更具男性化特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более мужеподобный",
                                "target_lang_sense_clarification": "о женщине"
                            },
                            {
                                "target_lang_word": "брутальнее",
                                "target_lang_sense_clarification": "о внешнем виде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更男性化",
                                "target_lang_sense_clarification": "形容风格"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}