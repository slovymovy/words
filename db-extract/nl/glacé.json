                        "entry_id": "36561b8d-6133-36b9-bfef-74f9fcd3816f",
                        "glosses": [
                            "een zachte soepele, glanzend gemaakte leersoort oorspronkelijk van hertenleer gemaakt tegenwoordig vaker van schaapsleer"
                        ],
