                                            "žena vykonávající pomocné práce v domácnosti za úplatu"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41c091a7-e9c9-4fc0-954a-ee016012c502",
                        "source_entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                        "source_sense_description": "domestic servant",
                        "target_lang_word": "прислу́га",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прислу́га",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "служанка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd33c6c9-ed32-46a4-87d4-f9d1cd77fd07",
                                                "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                                "text": "Их встретила в прихожей новая прислуга — кругленькая девица, сразу протянувшая им красную, непропорционально большую руку."
                                            },
                                            {
                                                "example_id": "5ed01212-fff6-4f3c-b946-036a1d0ed15a",
                                                "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                                "text": "В доме Галерана жили, кроме него, шофер Груббе и девушка Тирса, сестра шофера, исполняющая обязанности прислуги и экономки."
                                            },
                                            {
                                                "example_id": "09e15a84-9aa8-460d-b07c-c89f35da6827",
                                                "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                                "text": "Сводились эти слухи к одному: он принудил прислугу к сожительству, законным образом этого сожительства в загсе не зарегистрировал; она от него забеременела; он ее бессовестно бросил; она теперь где-то такое скрывает свой позор и в конце февраля собирается рожать ребенка, а покуда торгует в Замоскворечье папиросами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "собир. слуги, дворня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e26940-31d0-4917-b22a-ad6ee794229f",
                                                "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                                "text": "На дворе возилось человек десять прислуги, мужской и женской…"
                                            },
                                            {
                                                "example_id": "ae847888-6182-4e48-8e93-98f3b919da2a",
                                                "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                                "text": "Как это было в прошлом и в третьем году, стали играть в короли, а вся прислуга, сколько её было в двух этажах, столпилась в дверях, чтобы поглядеть на игру."
                                            },
                                            {
                                                "example_id": "a86c91ba-9d6c-4c2d-b127-d8dae35afc65",
                                                "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                                "text": "Кругло говоря, и Никитушка и Марина Абрамовна были отживающие типы той старой русской прислуги, которая рабски-снисходительно относилась к своим господам и гордилась своею им преданностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834150cd-04ac-3072-9d8d-4ab9faff6494",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "собир., устар. работники, обслуживающие железнодорожный состав, станцию, пароход и т. п. || бойцы, обслуживающие орудие, миномет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2fc533-4104-42e4-af2e-c968b07cebbf",
                                                "sense_id": "834150cd-04ac-3072-9d8d-4ab9faff6494",
                                                "text": "Даже, говорят, прислуги на некоторых железных дорогах порядочной нет; администрации чуть-чуть сносной в какой-нибудь компании пароходов устроить, говорят, никак невозможно."
                                            },
                                            {
                                                "example_id": "7c873c3c-c018-40e4-af56-a9815997d61b",
                                                "sense_id": "834150cd-04ac-3072-9d8d-4ab9faff6494",
                                                "text": "Кроме того, в Оренбургском гарнизоне была отобрана пехотная рота (160 человек); ей были приданы четыре 3-фунтовых орудия с прислугой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "893f9de1-9d6b-328a-9419-71f8243a3879",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "собир., воен. бойцы, обслуживающие орудие, пулемёт, миномёт"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fc9ee4d-39c1-3c34-9edd-688d9f64e308",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "устар. оказание услуг, услужение, обслуживание кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddcdec97-6902-4b5a-9ce9-8c6097193b84",
                        "source_entry_id": "8635b32a-ac5b-366f-94ec-2543c452058b",
                        "source_sense_description": "domestic servant",
                        "target_lang_word": "служа́нка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "служа́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9c55dbe2-1dd3-3fbf-9bc6-5331a2c56afa",
                                        "entry_id": "2c53c78c-2df1-33ed-a249-8d56cedcdfbf",
                                        "glosses": [
                                            "устар. женская прислуга, домашняя работница; женщина, выполняющая хозяйственные услуги по дому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c26e515-bba6-4375-81f5-dc91446b9941",
                                                "sense_id": "9c55dbe2-1dd3-3fbf-9bc6-5331a2c56afa",
                                                "text": "Она езжала по работам, // Солила на зиму грибы, // Вела расходы, брила лбы, // Ходила в баню по субботам, // Служанок била осердясь — // Все это мужа не спросясь."
                                            },
                                            {
                                                "example_id": "b6476f2c-8ed8-497c-9629-8462e08d9758",
                                                "sense_id": "9c55dbe2-1dd3-3fbf-9bc6-5331a2c56afa",
                                                "text": "Господа откушали, — отвечала служанка; встают изо стола."
                                            },
                                            {
                                                "example_id": "589f1d53-ead5-47f3-be70-0a84b9e1cc05",
                                                "sense_id": "9c55dbe2-1dd3-3fbf-9bc6-5331a2c56afa",
                                                "text": "Служанка несла за нею два узла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ecf6134-d03b-353f-bf8d-ee63f532d7b2",
                                        "entry_id": "2c53c78c-2df1-33ed-a249-8d56cedcdfbf",
                                        "glosses": [
                                            "книжн., перен. что-либо имеющее лишь подсобное, служебное значение для чего-либо более важного, значимого и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c4f5d9d-efbb-4176-adb3-5c91c02322c3",
                                                "sense_id": "7ecf6134-d03b-353f-bf8d-ee63f532d7b2",
                                                "text": "Философия долго была служанкой теологии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
