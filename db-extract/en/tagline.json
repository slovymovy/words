                ],
                "translations": [
                    {
                        "translation_id": "53d24d00-b90d-4071-8a97-86ae894a503b",
                        "source_entry_id": "c3a3bf3f-5ed8-351a-a02c-bba7db8a795b",
                        "source_sense_description": "punch line",
                        "target_lang_word": "Pointe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pointe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                        "entry_id": "eaf63d28-c20c-3d6f-8557-8e1144d59d1a",
                                        "glosses": [
                                            "aufschlussreicher, unvorhergesehener Gipfel/Kulminationspunkt einer Erzählung/Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80cac55b-dcd2-4e7f-bb3e-91a67b26377e",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Schon die erste Pointe, eigentlich war es nur eine Anspielung, wurde durch ein Gelächter vorweggenommen, das mich erschreckte.“"
                                            },
                                            {
                                                "example_id": "e6187fab-5064-43d7-8d23-e5ddbff48908",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Er schwieg, wartete auf die Pointe.“"
                                            },
                                            {
                                                "example_id": "93c921aa-8ff1-4653-9ea8-019b29a80b30",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Dieser Punkt ist nicht so bekannt wie die Pointe.“"
                                            },
                                            {
                                                "example_id": "236df982-cfd7-4a41-831c-38526ea60759",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Meine Großmutter kniff mir während der Pointe immer in den Oberarm und wiederholte sie mindestens drei Mal.“"
                                            },
                                            {
                                                "example_id": "7b6600ed-2f5b-49df-b3ca-9b47ebec84a0",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Der Witzerzähler kann zwar die Witzfabel ändern, doch die Pointe muß stimmen und ist nur bedingt variierbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c149b75-16ef-446c-9e47-9cd2ea8f865d",
                        "source_entry_id": "c3a3bf3f-5ed8-351a-a02c-bba7db8a795b",
