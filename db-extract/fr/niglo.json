                    },
                    {
                        "translation_id": "e5a79e49-f93d-4d7b-8670-4f7b12ce29e2",
                        "source_entry_id": "0c9a3b0d-6dc1-3af7-94ce-9765ac662f54",
                        "source_sense_id": "913da032-37c1-39e3-a11a-bb7d1357d344",
                        "target_lang_word": "hedgehog",
