                ],
                "senses": [
                    {
                        "sense_id": "ac78d789-afff-3a73-a5ae-9b49787be960",
                        "entry_id": "c068aa4c-e9e1-3e54-9427-3291b95980e0",
                        "glosses": [
                            "Form der Malkunst, bei der eine Wand als Grund verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e3e11e-7b58-4835-9e51-396ebf6ac772",
                                "sense_id": "ac78d789-afff-3a73-a5ae-9b49787be960",
                                "text": "Die Wandmalerei ist eine der ältesten überlieferten Kulturleistungen der Menschheit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d39b548e-f2f3-3bff-8ac2-d0938216a005",
                        "entry_id": "c068aa4c-e9e1-3e54-9427-3291b95980e0",
                        "glosses": [
                            "das durch [1] entstandene Gemälde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e66bf6-51e3-45ee-aa90-709de76a6db9",
                                "sense_id": "d39b548e-f2f3-3bff-8ac2-d0938216a005",
                                "text": "Die Wänder des Gebäudes waren überzogen von Wandmalereien."
                            },
                            {
                                "example_id": "38573344-b45f-47d7-8b3f-41b5396928ce",
                                "sense_id": "d39b548e-f2f3-3bff-8ac2-d0938216a005",
                                "text": "„Der Aufstieg der Stadt spiegelt sich außer in den urbanen Großvillen mit ihren figürlichen Wandmalereien und Fußbodenmosaiken in den Grabmälern wider, die einst die Ausfallstraßen vor der Stadtmauer säumten.“"
                            },
                            {
                                "example_id": "f8465d3f-5056-4927-b861-00ad40bd87c0",
                                "sense_id": "d39b548e-f2f3-3bff-8ac2-d0938216a005",
                                "text": "„An der nächstliegenden Mauer zeigten sich noch vielfach gut erhaltene Spuren einer Wandmalerei, die sich wie ein Bilderfries um den Raum zog.“"
                            },
                            {
                                "example_id": "0aec0b2c-6dcd-40c5-b98d-0d31d6de7663",
                                "sense_id": "d39b548e-f2f3-3bff-8ac2-d0938216a005",
                                "text": "„Oder sie können sich in den Kreuzgang und ins Refektorium des Frankfurter Karmeliterklosters begeben und die Wandmalerei bewundern, die heute als größtes erhaltenes Werk ihrer Art aus dieser Zeit gilt.“"
                            },
                            {
                                "example_id": "f75e6107-d07d-4ffe-ac18-776381888ab0",
                                "sense_id": "d39b548e-f2f3-3bff-8ac2-d0938216a005",
                                "text": "„Mein Studium ging voran, ich lernte, wie man alte Handschriften ausbesserte und Wandmalereien restaurierte, und obwohl ich weniger zum Lesen kam, da Philip das für eine unnütze Zeitverschwendung hielt und lieber fernsah, war ich zufrieden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
