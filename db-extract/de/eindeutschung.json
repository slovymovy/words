                "senses": [
                    {
                        "sense_id": "98d1d73d-e5d2-35ba-a354-0a3e1cbc010c",
                        "entry_id": "2d5dee90-7338-3748-8d09-152bbce6c63c",
                        "glosses": [
                            "Ersetzung eines Ausdrucks, der aus einer anderen Sprache stammt, durch einen, der mit den Mitteln der deutschen Sprache gebildet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0501b2-c3ec-429e-a96d-812811a9602b",
                                "sense_id": "98d1d73d-e5d2-35ba-a354-0a3e1cbc010c",
                                "text": "„Liebe Sprachfreunde, es ist ziemlich leicht, solche und ähnliche Eindeutschungen vorzuschlagen, aber die genaueren Konsequenzen werden dabei oft nicht bedacht.“"
                            },
                            {
                                "example_id": "e7ed0678-d88e-402b-b08f-238ddca1c3c3",
                                "sense_id": "98d1d73d-e5d2-35ba-a354-0a3e1cbc010c",
                                "text": "„Solche Eindeutschungen glücken Anfängern auch in fleißig gelerntem Französisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1565dd6c-44a7-30eb-baef-33fb5c259d03",
                        "entry_id": "2d5dee90-7338-3748-8d09-152bbce6c63c",
                        "glosses": [
                            "lautliche und/oder orthographische Anpassung eines Ausdrucks fremdsprachiger Herkunft ans Deutsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd67de36-0668-418c-9c33-b8088c62fbb8",
                                "sense_id": "1565dd6c-44a7-30eb-baef-33fb5c259d03",
                                "text": "„Der Grad der Eindeutschung fremder Wörter hängt aber nicht oder nur zum Teil davon ab, wie lange ein fremdes Wort schon in der Muttersprache gebraucht wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ec2ddb4e-0ca5-3a99-976c-ec88d2a50202",
                        "entry_id": "2d5dee90-7338-3748-8d09-152bbce6c63c",
