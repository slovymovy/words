                                "target_senses": [
                                    {
                                        "sense_id": "7107f325-7d3e-3f82-bf37-fb680af4b397",
                                        "entry_id": "62843bfd-13e2-3b18-8de9-6a8b2c821817",
                                        "glosses": [
                                            "weibliche Angehörige des iranischen Volkes der Paschtunen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce40319e-322f-4623-8e5e-5f2722746c84",
                                                "sense_id": "7107f325-7d3e-3f82-bf37-fb680af4b397",
                                                "text": "„Sie selbst ist Paschtunin, ihr Ehepartner gehört zu den Hazara, seine Volksgruppe wird in Afghanistan verfolgt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
