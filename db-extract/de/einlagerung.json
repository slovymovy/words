                "senses": [
                    {
                        "sense_id": "2df73a4d-e031-3b60-a00e-8b5a6de650b5",
                        "entry_id": "ad60c0c9-4824-32a0-a39b-90730dd7a743",
                        "glosses": [
                            "Verwahrung von Dingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0f3dea-b70e-496b-a9f2-ae3be04cc900",
                                "sense_id": "2df73a4d-e031-3b60-a00e-8b5a6de650b5",
                                "text": "Die Einlagerung der Möbel übernimmt das Umzugsunternehmen für uns."
                            },
                            {
                                "example_id": "6e3fb88b-6ae6-4ddc-9e20-e16cf86ffbda",
                                "sense_id": "2df73a4d-e031-3b60-a00e-8b5a6de650b5",
                                "text": "Die unterirdische Einlagerung von Atommüll ist immer wieder Anlass zu Diskussionen und Demonstrationen."
                            },
                            {
                                "example_id": "1a09fa88-a27b-4671-ada6-0f6e196e40f3",
                                "sense_id": "2df73a4d-e031-3b60-a00e-8b5a6de650b5",
                                "text": "„Seit elf Jahren ist die unterirdische Einlagerung von Klimagasen in Deutschland mit so hohen Hürden versehen, dass sie faktisch verboten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40aed0ec-422f-48e3-ac0b-087bedf31784",
                        "source_entry_id": "ad60c0c9-4824-32a0-a39b-90730dd7a743",
                        "source_sense_id": "2df73a4d-e031-3b60-a00e-8b5a6de650b5",
                        "source_sense_description": "Verwahrung von Dingen",
                        "target_lang_word": "storage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aaeb86f-91fe-3e40-a900-8d280ea71812",
                                        "entry_id": "e2dcbf1f-fc72-3bc7-8559-17fda0d80ed3",
                                        "glosses": [
                                            "The act of storing goods; the state of being stored."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b89c9d0c-c663-43b6-8a5a-62bc16064f7e",
                                                "sense_id": "4aaeb86f-91fe-3e40-a900-8d280ea71812",
                                                "text": "There's a lot of storage in the loft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d751ed-6998-3e5f-b40b-09490f75d448",
                                        "entry_id": "e2dcbf1f-fc72-3bc7-8559-17fda0d80ed3",
                                        "glosses": [
                                            "An object or place in which something is stored."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f5cec0-6c52-43bf-890c-014d5dcd98d9",
                                                "sense_id": "b4d751ed-6998-3e5f-b40b-09490f75d448",
                                                "text": "Melbourne's water storages plunged by 0.7 per cent in a week, down to 33.1 per cent capacity, as Victoria recorded its second-driest January on record."
                                            },
                                            {
                                                "example_id": "6a08779b-193e-48fc-b3e5-c207cdbd3883",
                                                "sense_id": "b4d751ed-6998-3e5f-b40b-09490f75d448",
                                                "text": "2011 (2008), Wan Renpu, Petroleum Industry Press (translator), Advanced Well Completion Engineering, page 115,\nUnderground natural gas storages are underground facilities for storing natural gas. At present, there are three types of underground natural gas storages worldwide, which include depleted oil and gas reservoir gas storages, salt-cave gas storages and aquifer storages."
                                            },
                                            {
                                                "example_id": "efab9e27-e2da-4736-9430-e5f31576fb98",
                                                "sense_id": "b4d751ed-6998-3e5f-b40b-09490f75d448",
                                                "text": "2012, A. Grinham, B. Gibbes, D. Gale, M. Watkinson, M. Bartow (University of Queensland), Extreme rainfall and drinking water quality: a regional perspective, C. A. Brebbia, Water Pollution XI, page 187,\nLow impact storages included the northern and southern region′s Cooloolabin Dam, Baroon Pocket Dam, Leslie Harrison Dam, Hinze Dam and Little Nerang Dam. Highly impacted storages included central region′s Wivenhoe Dam, Somerset Dam and North Pine Dam (Fig. 2), where TSS concentrations in these central storages where more than double compared to northern and southern storages (Fig. 2A)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b7128a4-d535-391e-8d70-855c072871da",
                                        "entry_id": "e2dcbf1f-fc72-3bc7-8559-17fda0d80ed3",
                                        "glosses": [
                                            "Any computer device, including such as a disk, on which data is stored for a longer term than main memory."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e4aa57c-afc0-4267-8912-f6e329ee4cdf",
                                                "sense_id": "3b7128a4-d535-391e-8d70-855c072871da",
                                                "text": "I′d recommend backing up these files to storage before reinstalling the operating system."
                                            },
                                            {
                                                "example_id": "f5c51b54-ddfd-44cb-b3c9-4ffb9d9bf2e9",
                                                "sense_id": "3b7128a4-d535-391e-8d70-855c072871da",
                                                "text": "Secondary storages are used to store system programs (viz; operating system, assembler, interpreter, compiler and so on), data files, software packages and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14396ffb-78a9-3444-b654-183870cbad34",
                                        "entry_id": "e2dcbf1f-fc72-3bc7-8559-17fda0d80ed3",
                                        "glosses": [
                                            "The price charged for storing goods."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
