                "senses": [
                    {
                        "sense_id": "5c8c6e9a-56b1-3434-9c4e-f783ea6f23e6",
                        "entry_id": "60bc4d27-13fa-30fe-8dfb-15b27ead1a21",
                        "glosses": [
                            "Anregung, Anstoß, Aufruf zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2bca88f-881c-4c68-bd7b-c94f765fd5c5",
                                "sense_id": "5c8c6e9a-56b1-3434-9c4e-f783ea6f23e6",
                                "text": "„Bei den spielzentrierten, situationsbezogenen Arbeitsmethoden […] sollen aus Spielinitiativen ·der Kinder heraus umfassende Spielprojekte entstehen, die auch die Aufteilung des Kindergartenhalbtags in Freispiel und strukturiertes Lernangebot überwinden können.“"
                            },
                            {
                                "example_id": "53c7e2f7-f45d-4028-9aeb-8027622cb9d7",
                                "sense_id": "5c8c6e9a-56b1-3434-9c4e-f783ea6f23e6",
                                "text": "„Paulina wirkte still und zurückgezogen; sie zeigte kaum Explorationslust oder Spielinitiative.“"
                            },
                            {
                                "example_id": "0b468a12-b607-429e-a055-60ed18e9313b",
                                "sense_id": "5c8c6e9a-56b1-3434-9c4e-f783ea6f23e6",
                                "text": "„Die sich durchsetzten gegenüber Mitspielern und Gegnern, weil der Ball ihnen Untertan, ihr Bewegungsgefühl optimal und ihr Bewußtsein sie Spielinitiative vorausahnen ließ.“"
                            },
                            {
                                "example_id": "24dca0b5-efed-4523-ac5b-5f0ad8e11179",
                                "sense_id": "5c8c6e9a-56b1-3434-9c4e-f783ea6f23e6",
                                "text": "„Margrit Stamm ist emeritierte Professorin für Pädagogische Psychologie und Erziehungswissenschaft. Im Interview verlangt sie eine Schweizer Spielinitiative.“"
                            },
                            {
                                "example_id": "447f0477-343f-4234-94f2-832f4cac9770",
                                "sense_id": "5c8c6e9a-56b1-3434-9c4e-f783ea6f23e6",
                                "text": "„Initiator der ungewöhnlichen Aktion ist die Spielinitiative Marzahn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
