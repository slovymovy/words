                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb4babe-0d6a-4f2d-bd8b-a69d9a8d939f",
                                "sense_id": "457d9df1-0b58-3d07-b380-4e882a659687",
                                "text": "„Er parierte die Stöße mit seinem langen Korbdegen oder wich ihnen mit wunderbarer Behendigkeit aus, führte auch zwischendurch einmal einen Seitenhieb auf seine Gegner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05c020f1-c24d-3b5f-8baf-79cd0d97638b",
                        "entry_id": "24c7ed87-3e20-3641-8111-021777be51ca",
                        "glosses": [
                            "Kritik, spöttische Bemerkung, die nicht Hauptinhalt der Äußerung ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "73be0de8-9eb4-41b8-a070-70788491064e",
                                "sense_id": "05c020f1-c24d-3b5f-8baf-79cd0d97638b",
                                "text": "„Einen Seitenhieb auf die Schwesterpartei konnte sich Huber nicht verkneifen und beklagte, es habe keinen Rückenwind aus der Bundespolitik gegeben.“"
                            }
                        ],
