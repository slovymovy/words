                                "example_id": "71e67630-6d61-47a4-b4ab-bb9584f8bd36",
                                "sense_id": "cc38bdd6-7dd0-3711-a068-e2763baad4e2",
                                "text": "sinon je vais encore m'ulcériser l'estomac, le coeur et le cerveau ..."
