                    {
                        "sense_id": "f7f3e404-217c-3960-8944-872943ae0bd6",
                        "entry_id": "8128340c-50c0-3336-b5ce-4cc568bdd354",
                        "glosses": [
                            "Personne responsable en même temps que d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f67234-2e70-47a8-801b-cede77fd52c2",
                                "sense_id": "f7f3e404-217c-3960-8944-872943ae0bd6",
                                "text": "Le critère de la répartition de la contribution à la réparation du dommage entre les coresponsables donne lieu à des solutions variées."
                            },
                            {
                                "example_id": "98b86231-a984-431a-824b-0c0e78fa1f24",
                                "sense_id": "f7f3e404-217c-3960-8944-872943ae0bd6",
                                "text": "« L’évaluation normative par les notes incite à la comparaison et au classement des élèves, dont au mal-être de certains », souligne Agnès Florin, coresponsable du Cnesco."
                            },
                            {
                                "example_id": "0efb0ed7-e85a-4e1b-b774-0d4e3e8a57b8",
                                "sense_id": "f7f3e404-217c-3960-8944-872943ae0bd6",
                                "text": "Et ceux qui obtiennent des mauvaises notes régulièrement « risquent de développer un sentiment d’impuissance », estime André Tricot, coresponsable du Cnesco."
                            }
                        ]
                    }
