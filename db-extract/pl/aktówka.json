                                        "glosses": [
                                            "In Microsoft Windows, a folder that supports file synchronization between itself and another folder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c638064e-767d-4035-9d0b-64927cf2b975",
                                                "sense_id": "22bfebed-e7ba-3525-bd7c-abebf284c809",
                                                "text": "You create a briefcase called Files where you store all your important documents. The briefcase is stored on your Tablet PC's C: drive, and the source files reside on your server."
                                            }
