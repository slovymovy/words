                "senses": [
                    {
                        "sense_id": "e7038b02-7567-3065-b449-de4a3106cf42",
                        "entry_id": "fdac62ef-8616-315b-8b88-613b175dfce0",
                        "glosses": [
                            "Verein, dessen Mitglieder sich auf dem Fußballplatz zum Fußballspielen treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e04285-a77c-4d15-a13e-01e4dbb712ee",
                                "sense_id": "e7038b02-7567-3065-b449-de4a3106cf42",
                                "text": "Ich bin Mitglied im Fußballverein."
                            },
                            {
                                "example_id": "3eef0fef-d1ea-46ba-8626-d167e00d77e5",
                                "sense_id": "e7038b02-7567-3065-b449-de4a3106cf42",
                                "text": "Von welchem Fußballverein bist Du Fan?"
                            },
                            {
                                "example_id": "d3782dc8-dcdb-415e-bb24-398ec610046b",
                                "sense_id": "e7038b02-7567-3065-b449-de4a3106cf42",
                                "text": "„Der Konsum von Rauschmitteln wird von jungen Isländern mindestens genauso gewissenhaft betrieben wie die Mitgliedschaft im Fußballverein.“"
                            },
                            {
                                "example_id": "4aaea3f7-2dad-4d32-ad21-c005a3d253be",
                                "sense_id": "e7038b02-7567-3065-b449-de4a3106cf42",
                                "text": "„Er antwortete, dass er vorhatte, Kapitän des heimischen Fußballvereins zu werden und dann in der Firma seines Vaters einzusteigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
