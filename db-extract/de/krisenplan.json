                "senses": [
                    {
                        "sense_id": "1a5ca858-1b41-34c2-9ada-6f6e8f0d6e08",
                        "entry_id": "550b23c5-e26c-3e09-94c4-0c2b1b6b1530",
                        "glosses": [
                            "Plan, der Verhaltensanweisungen für den Krisenfall beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f380117-7f3b-4b40-af55-ad9d9d1b5364",
                                "sense_id": "1a5ca858-1b41-34c2-9ada-6f6e8f0d6e08",
                                "text": "„Neuer Stab im Ministerium, neuer Krisenplan und Betreuungsmodus für Kranke in Wien – und bald kommt ein neuer Test: Wie man sich auf eine Krise einstellt, die wohl Monate dauern wird.“"
                            },
                            {
                                "example_id": "1339ef77-c752-4c1f-9f6f-fc4aa8e0fc90",
                                "sense_id": "1a5ca858-1b41-34c2-9ada-6f6e8f0d6e08",
                                "text": "„Das bedeutet, dass Europa sich auf sich selbst besinnen und zügig einen eigenen Krisenplan ausarbeiten muss.“"
                            },
                            {
                                "example_id": "be2696e1-e48f-47a6-98b8-f5b259722b9a",
                                "sense_id": "1a5ca858-1b41-34c2-9ada-6f6e8f0d6e08",
                                "text": "„Sein Programm erlaube jeder hessischen Stadt, einen individuellen Krisenplan zu erstellen, sagte Jung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
