                {
                    "sense_id": "30fb7602-9eb3-3c8d-9106-80d11c5aeb00",
                    "sense_definition": "Donner plus de vivacité, d'intensité ou de contraste à une couleur ou à une image.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensification_visuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe utilise un logiciel pour <w>renforcer</w> les contrastes de cette image sombre.",
                            "target_lang_translations": {
                                "en": "The photographer uses software to <w>enhance</w> the contrast of this dark image.",
                                "ru": "Фотограф использует программу, чтобы <w>усилить</w> контрасты этого тёмного изображения.",
                                "de": "Der Fotograf verwendet eine Software, um die Kontraste dieses dunklen Bildes <w>zu verstärken</w>.",
                                "es": "El fotógrafo usa un programa para <w>realzar</w> los contrastes de esta imagen oscura.",
                                "zh": "摄影师用一款软件来<w>增强</w>这张昏暗照片的对比度。"
                            }
                        },
                        {
                            "text": "Il est nécessaire de <w>renforcer</w> cette teinte pour équilibrer la composition du tableau.",
                            "target_lang_translations": {
                                "en": "It is necessary to <w>intensify</w> this shade to balance the composition of the painting.",
                                "ru": "Необходимо <w>усилить</w> этот оттенок, чтобы уравновесить композицию картины.",
                                "de": "Es ist notwendig, diesen Farbton <w>zu intensivieren</w>, um die Komposition des Gemäldes auszugleichen.",
                                "es": "Es necesario <w>intensificar</w> este tono para equilibrar la composición del cuadro.",
                                "zh": "有必要<w>加深</w>这种色调，以平衡画面的构图。"
                            }
                        }
                    ],
                    "antonyms": [
