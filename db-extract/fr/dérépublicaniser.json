                "senses": [
                    {
                        "sense_id": "c5ed880c-fd7f-326d-b081-fdc46bde1738",
                        "entry_id": "ccd46852-ab28-3f63-a0d4-7c1cf6adc2d9",
                        "glosses": [
                            "Faire perdre son caractère républicain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1953bf85-2cc7-4cf8-b430-815de40ebdf8",
                                "sense_id": "c5ed880c-fd7f-326d-b081-fdc46bde1738",
                                "text": "Il s’agirait de dépersonnaliser, “déflorentiniser”, “dérépublicaniser” le débat sur le recrutement d’une infanterie propre."
                            },
                            {
                                "example_id": "fa32f9f3-ca4c-4808-b8c8-06ac62268eaa",
                                "sense_id": "c5ed880c-fd7f-326d-b081-fdc46bde1738",
                                "text": "Péguy, cela ne date pas d’hier, en 1911 dans Notre Jeunesse, l’avait pourtant déclarée morte : « le dreyfusisme fut notre dernier sursaut républicain », et plus loin, « la France se dérépublicanise comme elle se déchristianise »."
                            }
                        ]
                    }
