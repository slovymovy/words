                                                "example_id": "4b88dc50-7cae-434e-a33e-2b7b01c77e50",
                                                "sense_id": "b9484400-4261-3824-bd09-9e5504a537c7",
                                                "text": "Congregations consist mainly of Mandarin-speaking refugees from the mainland but Taiwanese are not excluded. Student centers were established at Taipei, Panchiao, and Tainan for Bible study, fellowship, and personal counseling."
                                            },
                                            {
                                                "example_id": "557e2e02-2c46-4064-8ce2-6e78da888cb7",
                                                "sense_id": "b9484400-4261-3824-bd09-9e5504a537c7",
                                                "text": "Taiwan was the touchstone for both sides. We felt that we should not and could not abandon the Taiwanese; we were committed to Taiwan's right to exist as an independent nation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Taiwanese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75ecdda5-79ff-34f3-832c-3964f9088398",
                                        "entry_id": "6ba8965d-47e0-3da4-816a-de2cccee5eab",
                                        "glosses": [
                                            "The variant of Hokkien spoken in Taiwan, the native language of the Hoklo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e30f99-25fd-4693-9d70-fe159d095c13",
                                                "sense_id": "75ecdda5-79ff-34f3-832c-3964f9088398",
                                                "text": "Language. Mandarin is the official language, but many people speak Taiwanese (a variant of a southern Chinese dialect) and Japanese. The younger generation and those engaged in the tourist trade speak some English."
                                            },
                                            {
                                                "example_id": "748d156c-b071-4f98-819c-3511b794f1f9",
                                                "sense_id": "75ecdda5-79ff-34f3-832c-3964f9088398",
                                                "text": "The gay and lesbian movement in Taiwan is composed largely of students and other intellectuals and therefore is largely Mandarin-speaking, middle-class, and young. Koa-a-hi actresses, by contrast, almost always speak Taiwanese as their primary language, are rarely educated beyond elementary school, and can barely make ends meet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
