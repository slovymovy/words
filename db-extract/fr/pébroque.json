                        "form": "pébroc"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                        "entry_id": "4a789eb9-6384-30bd-b2aa-df28d273148e",
                        "glosses": [
                            "Parapluie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6336cdef-50e3-4293-a5c2-fc4412daac99",
                                "sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                                "text": "Il était affublé de grosses bacchantes noires, d’un melon, d’un pébroque et de larges tatanes."
                            },
                            {
                                "example_id": "40d3396b-0da1-47fc-95ff-9bd75ae59fa0",
                                "sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                                "text": "On se demandait comment elle arrivait à vivre. Des pébroques, elle en vendait pas des gerbes… elle faisait quelques réparations."
                            },
                            {
                                "example_id": "a9415123-b851-4423-a79d-351c361ec015",
                                "sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                                "text": "Nous marchons en silence vers la villa « Magdala », partiellement à l'abri sous nos pébroques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70931486-500b-458f-af8e-93cdcd33c5c3",
                        "source_entry_id": "4a789eb9-6384-30bd-b2aa-df28d273148e",
                        "source_sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                        "target_lang_word": "Regenschirm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenschirm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26c958cc-941d-3386-9a25-b36685688a75",
                                        "entry_id": "f197d233-15c4-3bb2-995f-5455701e417c",
                                        "glosses": [
                                            "zusammenklappbarer Schutzschirm gegen Regen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a01ce4-917c-438b-9aea-744ba250fac0",
                                                "sense_id": "26c958cc-941d-3386-9a25-b36685688a75",
                                                "text": "Einen Regenschirm hat man im Herbst gerne dabei."
                                            },
                                            {
                                                "example_id": "e2a6b840-37d5-4124-a1ff-8eb5fb398a4a",
                                                "sense_id": "26c958cc-941d-3386-9a25-b36685688a75",
                                                "text": "„Der Stoff bauschte sich wie ein Regenschirm um ihre Taille.“"
                                            },
                                            {
                                                "example_id": "4360205c-aecb-45b9-b110-0dc6f8cfa9cd",
                                                "sense_id": "26c958cc-941d-3386-9a25-b36685688a75",
                                                "text": "„Ein violetter Regenschirm ist an ihrem Koffer festgeschnallt.“"
                                            },
                                            {
                                                "example_id": "aab3f1d4-a538-4693-b9ac-0848bea709ec",
                                                "sense_id": "26c958cc-941d-3386-9a25-b36685688a75",
                                                "text": "„Wir spannen die Regenschirme gegen die Sonne auf.“"
                                            },
                                            {
                                                "example_id": "3e73fd73-8e60-43ff-8319-8299bd2bb6f4",
                                                "sense_id": "26c958cc-941d-3386-9a25-b36685688a75",
                                                "text": "„Sie hält den Regenschirm in die Luft und geht voran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83a5822a-be6b-43b1-83f9-1cab8c45213e",
                        "source_entry_id": "4a789eb9-6384-30bd-b2aa-df28d273148e",
                        "source_sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                        "target_lang_word": "brolly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brolly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                        "entry_id": "5838043c-5376-3124-8e89-2da9b5e3c046",
                                        "glosses": [
                                            "Alternative form of brelly."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c7fd19-cd8b-4871-910a-68e2f670f1c5",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "It's going to rain today – you'd better take your brolly."
                                            },
                                            {
                                                "example_id": "ee238ed0-a97f-4bc0-be8e-815891dcd26a",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "“The young lady’s hi,” he said suddenly, holding out the umbrella, “is fixed on this here. I am well aware that it is not for the lowest of the low to carry a gentleman’s brolly, and I ask your ladyship’s pardon for the liberty. I come by it accidental-like, and should be glad of a reasonable offer from any gentleman in want of a honest article.”"
                                            },
                                            {
                                                "example_id": "18161e2d-4865-4f1b-a06c-3f9479d79afd",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "The only brolly that's in sight / Is the mini one that's in my drink / JD, coke and lime / This is how I want to spend my time"
                                            },
                                            {
                                                "example_id": "1f5b9e3f-9398-489e-90e6-ebabbf916e66",
                                                "sense_id": "07f4eaef-74ff-32ca-858b-7f698b5236e5",
                                                "text": "Look! The Gnome Girl believed the letter you sent and brought the magic brolly! […] Now, we just wait for the Wretch to eat her and we can finally grab it!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ef229a9-0357-4e7b-bf61-5e74b7eb0887",
                        "source_entry_id": "4a789eb9-6384-30bd-b2aa-df28d273148e",
                        "source_sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                        "target_lang_word": "gamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75aaebd4-277c-3916-8c48-b44e9de98be3",
                                        "entry_id": "e84d5109-e6d4-3ae0-b9f4-02dcad556e50",
                                        "glosses": [
                                            "An umbrella."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82036710-f3a5-4bc0-a191-6bfc8e212f87",
                                                "sense_id": "75aaebd4-277c-3916-8c48-b44e9de98be3",
                                                "text": "It was the last day of the match, and owing to rain it was really unfit to play, but the promoters insisted upon our doing so, to satisfy the spectators, who stood round the ground with their umbrellas up. […] One gentleman sat with his gamp up on some rails near the railway."
                                            },
                                            {
                                                "example_id": "a0177ee7-8171-4c44-b01e-88168e5887b5",
                                                "sense_id": "75aaebd4-277c-3916-8c48-b44e9de98be3",
                                                "text": "And it was early morning, and the world was moist, when the crystal-gazer's husband, a freak in knickerbockers with an open coppish and a sabbath gamp, came over the stones outside his house to meet the holy travellers."
                                            },
                                            {
                                                "example_id": "808bbb33-ec43-4421-8a28-5ffb327fec49",
                                                "sense_id": "75aaebd4-277c-3916-8c48-b44e9de98be3",
                                                "text": "In his hand he waved – an appropriate symbol of disapprobation – his London gamp meticulously rolled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e67f56a-9244-32c1-909a-660aa040aaad",
                                        "entry_id": "90e18c21-8bfa-3331-86d8-ea443dcbcde7",
                                        "glosses": [
                                            "A gynandromorphophile, a tranny chaser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9462fbfe-0ac6-49c7-ac3a-b10b52834831",
                        "source_entry_id": "4a789eb9-6384-30bd-b2aa-df28d273148e",
                        "source_sense_id": "69cbce32-8164-34ec-aa03-75b9fcbbfe99",
                        "target_lang_word": "paraplu",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paraplu",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "876b64e6-f2f8-3319-8b9e-9ee6c57d26ad",
                                        "entry_id": "c9bed37b-d654-3cc6-b5a9-1bb299265aaa",
                                        "glosses": [
                                            "een scherm waarover een waterdichte stof is gespannen om zich te beschermen tegen de regen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761cae9c-8978-4f6f-8a41-b8e33aece2b9",
                                                "sense_id": "876b64e6-f2f8-3319-8b9e-9ee6c57d26ad",
                                                "text": "Met zulke donkere wolken buiten zou ik maar een paraplu meenemen."
                                            },
                                            {
                                                "example_id": "be63dbbb-bf38-41ff-8af9-0ad57f8e6a5a",
                                                "sense_id": "876b64e6-f2f8-3319-8b9e-9ee6c57d26ad",
                                                "text": "Een zwart-wit beeld uit de jaren vijftig van de vorige eeuw: regen op het Lodewijk Napoleonplein in Assen, een man met een paraplu laat zijn honden uit, huizen van baksteen onder steile driehoekige daken. Er is maar een verbinding met het beeld van de schamele behuizingen in Tutwiler, Mississippi: de blues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0863d03b-c725-388f-84f4-5bbf4f29e59b",
                                        "entry_id": "c9bed37b-d654-3cc6-b5a9-1bb299265aaa",
                                        "glosses": [
                                            "iets met de vorm van het bij [1] genoemde, maar met een andere functie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17d9f6d-7772-4555-af8d-09a440b7e7c8",
                                                "sense_id": "0863d03b-c725-388f-84f4-5bbf4f29e59b",
                                                "text": "Er was weinig tot geen beschutting tegen de bloedhete zon en ik klapte al snel mijn zilveren paraplu uit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f884002-b561-3e92-ac7d-2a014ee68302",
