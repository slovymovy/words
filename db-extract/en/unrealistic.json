                                                "sense_id": "af3e358a-b844-3889-bf84-5a9c4c1e30ef",
                                                "text": "Een onrealistisch schilderij."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3af2d6b6-c12f-35a8-a22a-167146f8c558",
                                        "entry_id": "5c5d1f05-49ef-38be-ad49-158733156696",
                                        "glosses": [
