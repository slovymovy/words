                                        "entry_id": "4cbf7f4e-22f9-376c-b27e-b03426de885c",
                                        "glosses": [
                                            "To be the tantamount to; to reach up to the level of."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91198246-bcf5-4a1a-b7cc-12764e0d5a49",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "His response amounted to gross insubordination."
                                            },
                                            {
                                                "example_id": "d10c5ba7-9274-47d4-a662-67c87e26e86b",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "He was a pretty good student, but never amounted to much professionally."
                                            },
                                            {
                                                "example_id": "47f7f294-11e9-44d7-b70b-4cc434669a49",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "It was, however, J.R.R. Tolkien who pointed out the close relationship in language as well as spelling, almost amounting to identity, between the Corpus MS of the Ancrene Riwle (A) and the Bodley MS of the Katherine Group (B)."
                                            },
                                            {
                                                "example_id": "9e355bcb-eafb-4c5b-a352-e9e6c95db1bb",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "\"The breadth of this LPR system is spectacular and amounts to a warrantless search.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5336aba-6544-3076-a79a-879ba39f1982",
                                        "entry_id": "4cbf7f4e-22f9-376c-b27e-b03426de885c",
                                        "glosses": [
                                            "To go up; to ascend."
                                        ],
