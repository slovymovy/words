                    {
                        "sense_id": "feb5b1b8-ccc1-3a06-8005-04a3b60fcb6f",
                        "entry_id": "feafe52f-3146-3ad3-93ab-e27ce11d48ed",
                        "glosses": [
                            "Type de moteur à réaction périodique servant à propulser certains aéronefs, breveté en France et en Allemagne vers 1930, et développé spécialement par cette dernière durant la Seconde Guerre mondiale à des fins militaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a661d655-d1b1-44ae-8e19-cc18b73ce629",
                                "sense_id": "feb5b1b8-ccc1-3a06-8005-04a3b60fcb6f",
                                "text": "Le pulsoréacteur fut tant bien que mal installé dans la gangue métallique de l’avion expérimental."
                            },
                            {
                                "example_id": "9d450c04-5535-4c61-8349-cf693c851ddb",
                                "sense_id": "feb5b1b8-ccc1-3a06-8005-04a3b60fcb6f",
                                "text": "Le V1 était un avion sans pilote, propulsé par un pulsoréacteur (un moteur sans pièce mobile où le carburant est directement injecté dans le réacteur et où c’est la vitesse qui comprime l’air)."
                            }
                        ]
                    }
