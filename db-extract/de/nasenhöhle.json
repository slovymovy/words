                        "cross_references": [
                            {
                                "target_word": "fosse nasale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "584b8c25-2af7-3a1b-b67a-5202c75712f0",
                                        "entry_id": "47a0b9e4-3acf-379e-ae80-a00a642e0a0c",
                                        "glosses": [
                                            "Chacune des deux cavités situées derrière le nez au milieu de la face, creusées dans l’os maxillaire, séparées de la cavité buccale par le palais, et remplies d’air, permettant le réchauffement et l’assainissement de l’air inhalé ainsi que l’olfaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05280d8d-81b8-4a59-a1d3-73f369c8e34b",
                                                "sense_id": "584b8c25-2af7-3a1b-b67a-5202c75712f0",
                                                "text": "Déviation en S de la cloison qui du côté gauche arrive au contact du cornet inférieur et obstrue presque complètement la fosse nasale de ce côté."
                                            },
                                            {
                                                "example_id": "f8f58531-a0cb-4aa8-88a2-3930619f3662",
                                                "sense_id": "584b8c25-2af7-3a1b-b67a-5202c75712f0",
                                                "text": "Les voix diffèrent selon la dimension des plis vocaux et selon l’impact des résonateurs que sont la gorge, la bouche et les fosses nasales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
