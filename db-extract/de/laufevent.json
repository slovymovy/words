                ],
                "senses": [
                    {
                        "sense_id": "89c52847-d4d1-31b5-a96b-516225d2528c",
                        "entry_id": "3208adb9-62dd-320d-934f-a28ffc8e1003",
                        "glosses": [
                            "organisierte, meist öffentliche Laufveranstaltung – zum Beispiel ein Wettkampf oder ein Stadtlauf mit großer Beteiligung"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "eb383f73-88db-478b-ba8d-6a2e4f98f64a",
                                "sense_id": "89c52847-d4d1-31b5-a96b-516225d2528c",
                                "text": "„In Bamberg ist blöderweise an dem Tag großes Laufevent.“"
                            },
                            {
                                "example_id": "b504e9bb-3fa9-473c-a3cf-66c82fad73c7",
                                "sense_id": "89c52847-d4d1-31b5-a96b-516225d2528c",
                                "text": "„In den vergangenen Jahren haben rund 6.000 Sportlerinnen und Sportler an diesem Laufevent teilgenommen.“"
                            },
                            {
                                "example_id": "4d6d9dae-3a21-44a9-b215-bd9c7edaf055",
                                "sense_id": "89c52847-d4d1-31b5-a96b-516225d2528c",
                                "text": "„‚Wir sind überzeugt davon, dass die jungen Läuferinnen und Läufer in Hannover zum Auftakt der neuen Serie die Atmosphäre eines der größten Laufevents in Deutschlands fast wie die Elite-Athleten und -Athletinnen erleben werden‘, sagt Steffi Eichel, Race-Direktorin des Marathons in Hannover.“"
                            },
                            {
                                "example_id": "44d254b7-0259-4dbc-9835-caa28d318590",
                                "sense_id": "89c52847-d4d1-31b5-a96b-516225d2528c",
                                "text": "„Die 10 Besten Frauen und Männer werden bei einem größeren Laufevent alle um die 3min/km laufen und teils schon nach weniger als 30 Minuten ins Ziel kommen.“"
                            },
                            {
                                "example_id": "9837c191-9f53-4f93-a107-bdfc5ba2efc2",
                                "sense_id": "89c52847-d4d1-31b5-a96b-516225d2528c",
                                "text": "„Und wer sich beim Laufen gleich noch eine Medaille sichern will, kann sich auch bei den vielen Laufevents im Harz anmelden und sich mit den lokalen Laufcrews messen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
