                ],
                "senses": [
                    {
                        "sense_id": "cddd2344-b434-32bc-9516-ab88cfe4c7d1",
                        "entry_id": "26e8612c-4ba4-3465-bd41-dbbeee5cd3c0",
                        "glosses": [
                            "op een onterechte wijze geknecht en in de vrijheid beknot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d04023b-5c4f-4cd2-8c29-4e9db8f27f6f",
                                "sense_id": "cddd2344-b434-32bc-9516-ab88cfe4c7d1",
                                "text": "De onderdrukte slaafgemaakten hebben zich na een lange strijd bevrijd."
                            },
                            {
                                "example_id": "ea58ffaf-335d-4309-90be-ffdd9902e590",
                                "sense_id": "cddd2344-b434-32bc-9516-ab88cfe4c7d1",
                                "text": "'Ah, nou, maar het is anders een prachtig verhaal' reageerde hij met een brede grijns. 'De mooie onderdrukte maagd die naar het koninklijk paleis komt, de jaloerse stiefzusters, het glazen muiltje dat niet past...'"
                            }
                        ]
                    },
                    {
                        "sense_id": "51afdf1e-9395-3310-85a6-8850098df1c4",
                        "entry_id": "26e8612c-4ba4-3465-bd41-dbbeee5cd3c0",
                        "glosses": [
                            "ingehouden, zodat het niet hard klinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cebc5554-23f1-45f8-9d11-82c6a243be26",
                                "sense_id": "51afdf1e-9395-3310-85a6-8850098df1c4",
                                "text": "Maar alles wat er aan die mond ontsnapte was een gekreun of onderdrukt gebrul, waarin geen woorden meer te herkennen waren."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
