                                        "sense_id": "2734c0dd-f503-3382-860e-11a17002bdd2",
                                        "entry_id": "73b0af5f-a1ff-32ab-9321-37d096a6adc9",
                                        "glosses": [
                                            "Relatif à l’ordre monastique chrétien défini à l’abbaye de Cîteaux par Robert de Molesme en 1098."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b303264-72da-4d0d-98ad-5ed80e8e4961",
                                                "sense_id": "2734c0dd-f503-3382-860e-11a17002bdd2",
                                                "text": "Notre-Dame de Boschaud est l’une des quatre abbayes cisterciennes de Dordogne."
                                            },
                                            {
                                                "example_id": "7ca51ade-d5af-450f-a8ae-5588a9668643",
                                                "sense_id": "2734c0dd-f503-3382-860e-11a17002bdd2",
                                                "text": "En 1098, avec la fondation de l’abbaye de Cîteaux par Robert de Molesme, la réforme dite cistercienne se veut plus stricte que la règle bénédictine. Elle vise le retour aux sources et prône l’idéal monastique : rupture avec le monde, pauvreté, discipline, silence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cistercien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68b13041-4afa-3140-845f-f8dd4505b53c",
                                        "entry_id": "c6908f4f-a93f-3675-9987-169b14f0d1ce",
                                        "glosses": [
                                            "Moine, moniale de l’ordre monastique chrétien fondé à l’abbaye de Cîteaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b33f4e6-ef8e-42d2-8c2a-99d3106b6063",
                                                "sense_id": "68b13041-4afa-3140-845f-f8dd4505b53c",
                                                "text": "Les hérétiques n’étaient sans doute pas plus nombreux en Languedoc qu’ailleurs, l’offensive de l’Église s’est focalisée sur la région sous l’action des cisterciens, dans le contexte du regain d’attention pour ces régions de la part de Louis VII, mais aussi des intérêts d’Henri II."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
