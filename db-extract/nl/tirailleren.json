                "senses": [
                    {
                        "sense_id": "2bee3a01-4cd6-3171-8744-fa6749aa90da",
                        "entry_id": "437ca2b1-b11a-3fb9-ae53-bff82317a975",
                        "glosses": [
                            "in verspreide gevechtsorde strijden"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "04d2b948-3714-4d63-9c6b-257e64d728e4",
                                "sense_id": "2bee3a01-4cd6-3171-8744-fa6749aa90da",
                                "text": "De Generaal gaf bevel om de brug der Hulppoort, welke slechts voor een gedeelte afgebroken was, geheel te slechten; voorts werd er gedurende den geheelen dag sterk getirailleerd,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ba38a67-59b3-4ceb-9e73-5b67c0d38f00",
                        "source_entry_id": "437ca2b1-b11a-3fb9-ae53-bff82317a975",
                        "source_sense_id": "2bee3a01-4cd6-3171-8744-fa6749aa90da",
                        "target_lang_word": "tirailler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tirailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f166149-a611-3193-9b5f-ca45043ed80d",
                                        "entry_id": "9d0f5c65-ec13-311b-ba33-7cc96615922b",
                                        "glosses": [
                                            "Tirer une personne à diverses reprises, avec importunité ou avec violence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421b96c4-c65e-4820-ad25-bbe86afb1bdb",
                                                "sense_id": "0f166149-a611-3193-9b5f-ca45043ed80d",
                                                "text": "Il y a une heure qu’ils ne font que me tirailler."
                                            },
                                            {
                                                "example_id": "a9ffa212-eee2-4a7f-9a78-24bea580b6c9",
                                                "sense_id": "0f166149-a611-3193-9b5f-ca45043ed80d",
                                                "text": "J’ai dormi par terre un peu de temps ; mais mon chien m’a tant tiraillée qu’il m’a réveillée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d003d624-bf3a-351a-80be-5d08277b54b9",
                                        "entry_id": "9d0f5c65-ec13-311b-ba33-7cc96615922b",
                                        "glosses": [
                                            "Importuner, harceler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d774201-53f0-4ae1-a589-fdf04bdf360e",
                                                "sense_id": "d003d624-bf3a-351a-80be-5d08277b54b9",
                                                "text": "Des importuns sont venus me tirailler de tous les côtés."
                                            },
                                            {
                                                "example_id": "4a457b74-7378-4a57-892e-0d6460120009",
                                                "sense_id": "d003d624-bf3a-351a-80be-5d08277b54b9",
                                                "text": "Tiraillé d’un côté, menacé de l’autre, il sent le sol se dérober sous ses pas."
                                            },
                                            {
                                                "example_id": "d5a8abdc-3f9a-491d-bbed-ee0906f5d7ff",
                                                "sense_id": "d003d624-bf3a-351a-80be-5d08277b54b9",
                                                "text": "Il lui semblait que s’il avait eu de quoi manger et boire, il aurait fait volontiers quelques fagots de plus. Mais la faim et la soif lui tiraillaient la gorge et l’estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "288b00cf-9a8f-318f-b0a1-3fee3b793e69",
                                        "entry_id": "9d0f5c65-ec13-311b-ba33-7cc96615922b",
                                        "glosses": [
                                            "Tirer dans tous les sens sur quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9503d131-2f6c-4e4f-80fa-d369588c1b61",
                                                "sense_id": "288b00cf-9a8f-318f-b0a1-3fee3b793e69",
                                                "text": "Le Russe tiraillait le bec-de-cane de la porte, qui ne s’ouvrait pas."
                                            },
                                            {
                                                "example_id": "874c08d6-5611-4269-864c-3512cee91bf2",
                                                "sense_id": "288b00cf-9a8f-318f-b0a1-3fee3b793e69",
                                                "text": "Il tiraillait son grand nez."
                                            },
                                            {
                                                "example_id": "455f76da-2922-4348-bb33-fd8d277d45be",
                                                "sense_id": "288b00cf-9a8f-318f-b0a1-3fee3b793e69",
                                                "text": "Alicia tiraillait une mèche de cheveux le long de sa joue, en parlant : […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb31eab-1c40-3a0e-9490-6ebc8c9fb93c",
                                        "entry_id": "9d0f5c65-ec13-311b-ba33-7cc96615922b",
                                        "glosses": [
                                            "Tirer d’une arme à feu à diverses reprises, sans ordre et souvent sans effet."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfed0a02-1a0f-4252-9610-fbd957337d01",
                                                "sense_id": "3eb31eab-1c40-3a0e-9490-6ebc8c9fb93c",
                                                "text": "Il y a longtemps qu’ils ne font que tirailler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ef2b3c-212b-309c-820f-f66e0dec0f64",
                                        "entry_id": "9d0f5c65-ec13-311b-ba33-7cc96615922b",
                                        "glosses": [
                                            "Commencer l’attaque par un feu irrégulier et à volonté, en parlant des soldats qui sont dispersés en avant d’une colonne."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54e4ecaa-d7b2-409d-828c-c93cf5815e50",
                                                "sense_id": "89ef2b3c-212b-309c-820f-f66e0dec0f64",
                                                "text": "Le lendemain, de bonne heure, en marchant sur Weissenfelds, il fallut tirailler contre les Westphaliens, qui nous suivirent jusqu’au village d’Eglaystadt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
