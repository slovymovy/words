                "senses": [
                    {
                        "sense_id": "e44e126d-212d-3037-8854-a195e81036d3",
                        "entry_id": "ca4b6a56-9a55-3704-8cd7-4c2e28e359c2",
                        "glosses": [
                            "Débarrasser de l’influence de la famille Trabelsi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe97fcd6-ae87-4c13-81ba-a1f38a143e34",
                                "sense_id": "e44e126d-212d-3037-8854-a195e81036d3",
                                "text": "Il faut remettre à plat les appels d'offres publics douteux et autres salaires/contrats indus afin de \"détrabelsiser\" notre économie."
                            },
                            {
                                "example_id": "ef780afb-a6ce-4801-a6f9-5330f3514f3c",
                                "sense_id": "e44e126d-212d-3037-8854-a195e81036d3",
                                "text": "Quelles que soient les réponses possibles, une gymnastique intellectuelle délicate et difficile s’avère nécessaire pour faire le point sur les actes importants, les décisions prises ou non prises, ainsi que pour décortiquer et analyser le processus entamé afin de \"débenaliser\" la politique et \"détrabelsiser\" l’économie du pays."
                            },
                            {
                                "example_id": "2b622888-a167-4e7b-a609-04e9f89ebad2",
                                "sense_id": "e44e126d-212d-3037-8854-a195e81036d3",
                                "text": "Détrabelsiser. Il y a de fortes chances pour que votre correcteur orthographique souligne le mot d'un trait ondulé rouge."
                            }
                        ]
                    }
                ],
