                        "glosses": [
                            "de leer van de mechanische verzameling en verwerking van informatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e76c458-4ca5-435e-8444-f55055541319",
                                "sense_id": "013b7e26-5755-35d9-85e3-7dd8244174da",
                                "text": "Ik studeer al twee jaar informatica aan de Universiteit Leiden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55a9ddcc-319d-4734-b270-d259d7d2418e",
                        "source_entry_id": "761c1f4f-19c8-34d7-b57b-513fbc6d8582",
                        "source_sense_id": "013b7e26-5755-35d9-85e3-7dd8244174da",
                        "source_sense_description": "de leer van de mechanische verzameling en verwerking van informatie",
                        "target_lang_word": "Informatik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Informatik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb9213d-9adc-375e-8943-a481ceb1d47d",
                                        "entry_id": "d2dbdad1-a852-33ce-b589-eed9d357d8b3",
                                        "glosses": [
                                            "Strukturwissenschaft, die sich mit der Information und deren automatischer Verarbeitung befasst"
                                        ],
                                        "tags": [
                                            "Strukturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "094aedb7-36d3-46d5-a065-ff16f95ce1e3",
                                                "sense_id": "dbb9213d-9adc-375e-8943-a481ceb1d47d",
                                                "text": "\"In der Informatik geht es genauso wenig um Computer wie in der Astronomie um Teleskope.\" (Edsger Dijkstra)"
                                            },
                                            {
                                                "example_id": "5128a586-4db1-474e-8bd2-66f30dcedd58",
                                                "sense_id": "dbb9213d-9adc-375e-8943-a481ceb1d47d",
                                                "text": "Die Inhalte der Theoretischen Informatik sind nicht so direkt anwendbar wie viele Inhalte der Grundvorlesungen über Programmierung, Rechnerarchitektur, Hardware, Datenstrukturen und den Entwurf effizienter Algorithmen."
                                            },
                                            {
                                                "example_id": "cde5657c-74fa-4033-be40-e3255e571c0a",
                                                "sense_id": "dbb9213d-9adc-375e-8943-a481ceb1d47d",
                                                "text": "„Ein völlig anderes Interessengebiet aber, das sich quasi in ihm bereits im Kleinkindalter etabliert hatte, war die Informatik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03439d9f-7ecb-4c9f-978b-43d5e3663725",
                        "source_entry_id": "761c1f4f-19c8-34d7-b57b-513fbc6d8582",
                        "source_sense_id": "013b7e26-5755-35d9-85e3-7dd8244174da",
