                    {
                        "translation_id": "aabd55f1-a50b-4050-915a-39d30118b8c2",
                        "source_entry_id": "7a4e4d53-dec3-33b0-abea-8e0ee451726f",
                        "source_sense_id": "b075a030-6be4-3df3-9694-ca908629970d",
                        "source_sense_description": "Geschäft, welches gegen Annahme von Wertgegenständen Darlehen vergibt",
                        "target_lang_word": "mont-de-piété",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mont-de-piété",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19a75c7e-4bf8-39b9-aa7d-146dec2f2931",
                                        "entry_id": "ea1b809b-b077-3c6f-b2ad-35c21f945076",
                                        "glosses": [
                                            "Établissement où l’on prête sur gages et à intérêts."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d313a530-7060-4edf-ae42-7774f52ca32c",
                                                "sense_id": "19a75c7e-4bf8-39b9-aa7d-146dec2f2931",
                                                "text": "Où les trouver, ces quatre pièces de cent sous ? Mme Coupeau, qui autrefois avait fait le ménage d’une petite actrice du théâtre des Batignolles, parla la première du mont-de-piété."
                                            },
                                            {
                                                "example_id": "096db8ac-b62d-465a-ac71-07293e428cf9",
                                                "sense_id": "19a75c7e-4bf8-39b9-aa7d-146dec2f2931",
                                                "text": "Toutes sortes d’objets venus avec notre héritage quittaient le logement pour une destination à vrai dire non mystérieuse, car les mots de mont-de-piété revenaient dans nos entretiens avec une familiarité obsédante."
                                            },
                                            {
                                                "example_id": "c5a0af3e-aaa8-4d58-a3bf-59a531b30c13",
                                                "sense_id": "19a75c7e-4bf8-39b9-aa7d-146dec2f2931",
                                                "text": "Charlie Parker passera la fin de son existence entre des clubs, des coins de rues sordides où l’attendaient un dealer, un flic, ou les deux à la fois, et le mont-de-piété où vingt fois il déposa son saxophone."
                                            },
                                            {
                                                "example_id": "0da5e3df-9747-40b4-aa52-a00117341894",
                                                "sense_id": "19a75c7e-4bf8-39b9-aa7d-146dec2f2931",
                                                "text": "Il alla placer la bague au mont-de-piété. Depuis l’armistice, on disait Crédit municipal, ça sonnait plus républicain."
                                            },
                                            {
                                                "example_id": "91af15b3-c129-4c3b-8979-fecb8e00b08a",
                                                "sense_id": "19a75c7e-4bf8-39b9-aa7d-146dec2f2931",
                                                "text": "Un peu plus tard il avait trouvé chez elle \"une indication\" du mont-de-piété qui prouvait qu’elle avait engagé deux bracelets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
