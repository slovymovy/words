                    },
                    {
                        "translation_id": "41df081d-95f8-4fae-8d93-0284962f16dd",
                        "source_entry_id": "b28955f5-5f33-3724-a585-ed521a1a1c3f",
                        "source_sense_id": "fc300052-abfb-35fe-948d-9f9486300ace",
                        "target_lang_word": "ocarina",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ocarina",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e62e2cea-e03a-3e39-b1a0-75150e768a11",
                                        "entry_id": "00e2b864-f1ef-3902-a47e-ca99d9de489e",
                                        "glosses": [
                                            "Un instrumento de música hecho de arcilla o de cerámica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f50f0b5-4f63-4faf-baf0-fe458f2ab6f2",
                                                "sense_id": "e62e2cea-e03a-3e39-b1a0-75150e768a11",
                                                "text": "Sale otro Buu del humo del Buu bueno\nAcabarás en forma de tableta o caramelo\nUno, dos, tres: ¡Fusión!\nEl ego de Gotenks, la ocarina de Tapión"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "390e38a7-ad23-4808-a8ec-2007ae7c9948",
                        "source_entry_id": "b28955f5-5f33-3724-a585-ed521a1a1c3f",
                        "source_sense_id": "fc300052-abfb-35fe-948d-9f9486300ace",
                        "target_lang_word": "Okarina",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okarina",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "257ee98a-b335-361d-a86c-0a2385452032",
                                        "entry_id": "7f37cd33-c67e-3769-b9da-387fd171b9c3",
                                        "glosses": [
                                            "kleines flötenähnliches Blasinstrument aus Ton oder Keramik mit acht oder zehn Grifflöchern (davon befinden sich zwei, die Daumenlöcher, immer auf der Unterseite des Instruments) mit einem Schnabel zum Anblasen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3314b6b2-e040-4d7b-9387-17d0f328875e",
                                                "sense_id": "257ee98a-b335-361d-a86c-0a2385452032",
                                                "text": "Um 1970 entwickelte Josef Plaschke aus Südtirol eine neuartige Okarina, welche heute in der deutsch-österreichischen Volksmusik eingesetzt wird. (Quelle: Wikipedia, Artikel Okarina)"
                                            },
                                            {
                                                "example_id": "cde59946-1a7d-4f6e-aa32-289d672c0fda",
                                                "sense_id": "257ee98a-b335-361d-a86c-0a2385452032",
                                                "text": "Der Wirt holte ganz in Gedanken seine Okarina hervor und pfiff ein Lied, das er seit sechzig Jahren nicht mehr gepfiffen hatte. (Max Dauthendey, Die Auferstehung allen Fleisches, z.n. Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1a901d4-afba-4af8-8d88-34ef72c97ffb",
                        "source_entry_id": "b28955f5-5f33-3724-a585-ed521a1a1c3f",
                        "source_sense_id": "fc300052-abfb-35fe-948d-9f9486300ace",
                        "target_lang_word": "окарина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "окарина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "05dbbb8d-9a59-31bf-93e7-2125b0033bdf",
                                        "entry_id": "e4047033-be2d-3659-a7cc-b8896e5df58c",
                                        "glosses": [
                                            "муз. духовой музыкальный инструмент, род свистковой сосудообразной флейты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6f0b9a-8795-4d1f-b7dd-d5cbfbd84203",
                                                "sense_id": "05dbbb8d-9a59-31bf-93e7-2125b0033bdf",
                                                "text": "Но Сашка здоровой рукой вынул из кармана какой-то небольшой, в ладонь величиной, продолговатый чёрный инструмент с отростком, вставил этот отросток в рот и, весь изогнувшись налево, насколько ему это позволяла изуродованная, неподвижная рука, вдруг засвистел на окарине оглушительно весёлого «Чабана»."
                                            },
                                            {
                                                "example_id": "9739bd47-59ab-49e2-991c-edbba5005fdd",
                                                "sense_id": "05dbbb8d-9a59-31bf-93e7-2125b0033bdf",
                                                "text": "И вдруг все враз к фортке головы повернули: из-за колодца, из садовой чащобы не весть на чем, — не дудка, не окарина, не весть кто «Лебединую прохладу» насвистывает…"
                                            },
                                            {
                                                "example_id": "015533df-af71-43d6-9b41-5133cc431931",
                                                "sense_id": "05dbbb8d-9a59-31bf-93e7-2125b0033bdf",
                                                "text": "Я беспомощно вертел в руках глиняного соловья, прикладывал гузку к губам, трогал дульце кончиком языка, то втягивал, то выдувал, отрывая поочередно пальцы, пытаясь нащупать хотя бы малейший признак гаммы… В глухом, неподъёмном тоне окарины мне чудилось пение недр."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
