                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e3448a-a7ea-337f-8583-f3368318cf57",
                                        "entry_id": "afd966c7-2bf9-3e2f-b703-8c24c2da992b",
                                        "glosses": [
                                            "das einander Entgegenwirken/Entgegenstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e93198c1-bb09-40e6-898f-35deda1c7c59",
                                                "sense_id": "b1e3448a-a7ea-337f-8583-f3368318cf57",
                                                "text": "In Wahlzeiten wird der Antagonismus der Parteien besonders betont."
                                            },
                                            {
                                                "example_id": "28f4bf8b-01a2-4e89-b361-d8cce3ef3987",
                                                "sense_id": "b1e3448a-a7ea-337f-8583-f3368318cf57",
                                                "text": "„Damit begann eine Phase des Antagonismus zwischen Pompeius und dem Senat, die ein Jahrzehnt dauern sollte und einen entscheidenden Anteil am Zusammenbruch der Senatsherrschaft hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df9e9e06-1075-41b3-95e6-1a65151feaea",
                        "source_entry_id": "22bf9820-7667-3001-8088-fc303d2067d5",
                        "source_sense_id": "cdcdbb6e-2579-3cb0-be10-79d9af5b5e32",
                        "source_sense_description": "strong dislike",
                        "target_lang_word": "Gegensatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegensatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9fe1728-6ddf-30a6-8dff-a275b0674fb8",
                                        "entry_id": "f2d570b3-e2c8-3f79-8b5f-84d1bee9fd00",
                                        "glosses": [
                                            "Entgegenstellung, Kontrast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc62e50-9387-46c3-835b-7c902fad521f",
                                                "sense_id": "d9fe1728-6ddf-30a6-8dff-a275b0674fb8",
                                                "text": "„Beim Motorfliegen kommt es im Gegensatz zum Segelfliegen mehr darauf an, fliegerische, navigatorische und technische Aufgaben zu meistern.“"
                                            },
                                            {
                                                "example_id": "42f6b39e-bebe-476c-ab41-2cb0f26c9097",
                                                "sense_id": "d9fe1728-6ddf-30a6-8dff-a275b0674fb8",
                                                "text": "„Im Gegensatz zum veräußerlichten Gipfelsammler fasziniert den beschaulichen Berggeher mehr das Auf-dem-Weg-Sein in der Vertikalen.“"
                                            },
                                            {
                                                "example_id": "116820ec-585e-4d32-ab7c-347837389b51",
                                                "sense_id": "d9fe1728-6ddf-30a6-8dff-a275b0674fb8",
                                                "text": "Sein Handeln steht im Gegensatz zu dem was er sagt."
                                            },
                                            {
                                                "example_id": "0735d9b1-5cfe-4d03-8fbd-7a4e5b37c043",
                                                "sense_id": "d9fe1728-6ddf-30a6-8dff-a275b0674fb8",
                                                "text": "Während die Ansprüche an Kitas kontinuierlich steigen, verzichtet Deutschland im Gegensatz zu anderen OECD-Ländern auf einheitliche Qualitäts- und Finanzierungsstandards."
                                            },
                                            {
                                                "example_id": "359b0cc0-80f6-44b9-94a5-9ee7526c1310",
                                                "sense_id": "d9fe1728-6ddf-30a6-8dff-a275b0674fb8",
                                                "text": "„Eine Umfrage des Marktforschungsinstituts Ipsos […] kam 2018 zu dem Ergebnis, dass 94 Prozent der chinesischen Jugendlichen optimistisch gestimmt waren, was die Zukunft des eigenen Landes anging, im Gegensatz zu 64 Prozent in den USA und 56 Prozent in Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f8295af-dafc-3cd6-87e3-629cff8ca83d",
                                        "entry_id": "f2d570b3-e2c8-3f79-8b5f-84d1bee9fd00",
                                        "glosses": [
                                            "Komplement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5fbac8e-6636-4107-8057-45614dccc0f4",
                                                "sense_id": "5f8295af-dafc-3cd6-87e3-629cff8ca83d",
                                                "text": "Konträre Gegensätze liegen dann vor, wenn zwei positive Gegebenheiten sich innerhalb eines bestimmten Bezugssystems ausschließen, wie „schwarz“ und „weiß“, „rund“ und „eckig“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "918964ab-b766-3c49-bd96-baf88f26fb11",
                                        "entry_id": "f2d570b3-e2c8-3f79-8b5f-84d1bee9fd00",
                                        "glosses": [
                                            "ein Widerspruch"
                                        ],
