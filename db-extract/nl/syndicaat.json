                        "sense_id": "be1e5e68-5bd4-3232-8591-c3aaf52a52ce",
                        "entry_id": "d6cf28e2-f1a6-35e1-b438-14c618181973",
                        "glosses": [
                            "organisatie van zakenlieden, opgericht voor industriële of commerciële doeleinden"
