    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48924089-c52d-3704-b7df-9f1415e78495",
                    "sense_definition": "Страшный, мучительный сон, вызывающий чувство страха.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bad_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Под утро ему приснился страшный <w>кошмар</w>.",
                            "target_lang_translations": {
                                "en": "Towards morning he had a scary <w>nightmare</w>.",
                                "pl": "Nad ranem przyśnił mu się straszny <w>koszmar</w>."
                            }
                        },
                        {
                            "text": "Этот ночной <w>кошмар</w> заставил меня проснуться в холодном поту.",
                            "target_lang_translations": {
                                "en": "This <w>nightmare</w> made me wake up in a cold sweat.",
                                "pl": "Ten nocny <w>koszmar</w> sprawił, że obudziłem się zlany zimnym potem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ночной кошмар",
                        "приснился кошмар",
                        "видеть кошмар"
                    ],
                    "target_lang_definitions": {
                        "en": "A frightening or unpleasant dream.",
                        "pl": "Przerażający, męczący sen wywołujący silne uczucie lęku."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nightmare",
                                "target_lang_sense_clarification": "bad dream"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "koszmar",
                                "target_lang_sense_clarification": "zły, przerażający sen"
                            },
                            {
                                "target_lang_word": "zły sen",
                                "target_lang_sense_clarification": "nieprzyjemny sen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97743f35-8517-3203-8684-117fe2a15f4d",
                    "sense_definition": "Нечто крайне неприятное, тягостное или ужасное (о ситуации, событии).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bad_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поездка на работу в час пик превратилась в настоящий <w>кошмар</w>.",
                            "target_lang_translations": {
                                "en": "The commute during rush hour turned into a real <w>nightmare</w>.",
                                "pl": "Dojazd do pracy w godzinach szczytu zamienił się w prawdziwy <w>koszmar</w>."
                            }
                        },
                        {
                            "text": "Этот ремонт был сплошным <w>кошмаром</w>: всё время что-то ломалось.",
                            "target_lang_translations": {
                                "en": "This renovation was a complete <w>nightmare</w>: something kept breaking all the time.",
                                "pl": "Ten remont był istnym <w>koszmarem</w>: cały czas coś się psuło."
                            }
                        }
                    ],
                    "synonyms": [
                        "ужас"
                    ],
                    "common_phrases": [
                        "настоящий кошмар",
                        "превратиться в кошмар",
                        "сплошной кошмар"
                    ],
                    "target_lang_definitions": {
                        "en": "An extremely unpleasant, difficult, or terrible situation or experience.",
                        "pl": "Coś niezwykle nieprzyjemnego, uciążliwego lub przerażającego (o sytuacji, zdarzeniu)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nightmare",
                                "target_lang_sense_clarification": "terrible situation"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "koszmar",
                                "target_lang_sense_clarification": "straszna, uciążliwa sytuacja"
                            },
                            {
                                "target_lang_word": "horror",
                                "target_lang_sense_clarification": "potocznie o dramatycznej lub uciążliwej sytuacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "8180b0dd-447d-319c-8ba8-d02bc9e2843b",
                    "sense_definition": "Возглас, выражающий ужас, сильное возмущение или удивление чем-то неприятным.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Кошмар</w>, как же здесь холодно!",
                            "target_lang_translations": {
                                "en": "<w>It's a nightmare</w>, how cold it is here!",
                                "pl": "<w>Koszmar</w>, jak tu zimno!"
                            }
                        },
                        {
                            "text": "Ты видел цены на билеты? Просто <w>кошмар</w>!",
                            "target_lang_translations": {
                                "en": "Did you see the ticket prices? It's just a <w>nightmare</w>!",
                                "pl": "Widziałeś ceny biletów? Po prostu <w>koszmar</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "ужас",
                        "жуть"
                    ],
