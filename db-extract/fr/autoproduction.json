        "fr-extract.jsonl": [
            {
                "entry_id": "e10dd926-f159-3736-9c35-4df6f1c8b1d4",
                "word": "autoproduction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "942cc624-2e34-4cb3-b336-40fc05edc761",
                        "entry_id": "e10dd926-f159-3736-9c35-4df6f1c8b1d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "autoproductions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f67ce23f-b49e-30ce-9ea6-c10bebab94e0",
                        "entry_id": "e10dd926-f159-3736-9c35-4df6f1c8b1d4",
                        "glosses": [
                            "Production de biens ou de services par une personne physique ou morale dont ce n’est pas l’activité professionnelle, généralement à des fins d’autoconsommation."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "938c64ec-39bc-42a6-998e-8dd4f5b5fe67",
                                "sense_id": "f67ce23f-b49e-30ce-9ea6-c10bebab94e0",
                                "text": "Le taux d’autoproduction est votre niveau d’autonomie par rapport au réseau. S’il est égal à 70 %, cela signifie que vous produisez 70 % de l’énergie que vous consommez."
                            },
                            {
                                "example_id": "e2b9d615-718e-4295-a8b2-f1cc72b86a9e",
                                "sense_id": "f67ce23f-b49e-30ce-9ea6-c10bebab94e0",
                                "text": "Ce 13 décembre 2021, en Tunisie, le gouvernement a confirmé une refonte complète du cadre législatif et réglementaire régissant la production d’électricité à partir de sources renouvelables, afin d’en simplifier et d’en accélérer le déploiement, en particulier les centrales photovoltaïques en autoproduction."
                            },
                            {
                                "example_id": "b68be964-b0fa-4888-aae4-aec9b54c6821",
                                "sense_id": "f67ce23f-b49e-30ce-9ea6-c10bebab94e0",
                                "text": "Entre autres, développer les ateliers participatifs avec le public : « Savoir cultiver ses vers de farine ou construire son kit d’autoproduction en cultivant des champignons ou encore des endives »."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e59597c-4594-38e6-85e8-a87c76c7d437",
                        "entry_id": "e10dd926-f159-3736-9c35-4df6f1c8b1d4",
                        "glosses": [
                            "Production d’un ouvrage musical ou audiovisuel par les artistes mêmes, sans passer par une ou des entreprises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d55d01-6d2b-4130-ad29-67c1ff42f8b8",
                                "sense_id": "0e59597c-4594-38e6-85e8-a87c76c7d437",
                                "text": "A cause d’Internet, de ses plateformes communautaires et notamment du financement participatif, un vent nouveau souffle sur l’autoproduction. Pour un artiste, l’envie de prendre tout en main, de conduire son projet de A à Z semble désormais accessible."
                            },
                            {
                                "example_id": "0520499d-ad0a-44d7-aa1c-6935350a070d",
                                "sense_id": "0e59597c-4594-38e6-85e8-a87c76c7d437",
                                "text": "Revenue à l’autoproduction, Agathe est de retour sur scène cet été avec un nouveau style, de la pop urbaine, à découvrir avec un premier single, La Flemme."
                            },
                            {
                                "example_id": "c5acb161-8bde-4fc4-becc-a7fabe66e5fa",
                                "sense_id": "0e59597c-4594-38e6-85e8-a87c76c7d437",
                                "text": "Réalisé en autoproduction, « fait maison », cet EP a également été possible grâce aux nombreux soutiens que Triskill a reçus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c316011-2d70-4123-9ae8-e89dc8aec7e4",
                        "source_entry_id": "e10dd926-f159-3736-9c35-4df6f1c8b1d4",
