                        "examples": [
                            {
                                "example_id": "8f2a9ff5-60bf-46d4-a11b-db8e1726ebb7",
                                "sense_id": "0cb09fcd-a1e0-32ea-944f-4a64afab9a91",
                                "text": "На Уралмаше есть оказывается цех фрезеровочный, где только глухонемые работают."
                            },
                            {
                                "example_id": "aed923ab-5fed-41fc-8a82-db06bb6863d3",
                                "sense_id": "0cb09fcd-a1e0-32ea-944f-4a64afab9a91",
                                "text": "Фрезеровочная (фрезерная) машина, или фрезер, представляет собой ручной электроинструмент для фигурной обработки кромок, выборки пазов и сверления отверстий в древесине."
                            }
                        ]
                    }
