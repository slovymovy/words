                            {
                                "example_id": "f881eb6a-ff1a-4582-85ac-2fd2be366fc8",
                                "sense_id": "e1543e62-5a20-313e-a92e-729258635f9a",
                                "text": "„Von 1939 bis 1945 arbeitete er für die Kunststoffabteilung Farbwerke Hoechst, bevor er ab 1945 als Privatdozent in Freiburg tätig war.“"
                            },
                            {
                                "example_id": "6cf63ef3-53d0-4322-b267-f319c16cede3",
                                "sense_id": "e1543e62-5a20-313e-a92e-729258635f9a",
                                "text": "„Die Kunststoffabteilung wurde in die ehemalige Schlosserwerkstatt verlegt – nahe an die Stahlfertigung.“"
