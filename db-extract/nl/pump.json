                                    {
                                        "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                        "entry_id": "65ed485c-8853-3569-b2a8-dd47c98be65d",
                                        "glosses": [
                                            "weit ausgeschnittener, sonst aber geschlossener Damenhalbschuh ohne Verschluss mit flacher Sohle und einem modebedingten formvariierenden Absatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48cdd33a-de22-4b72-a78d-83a89265f6b9",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "Pumps, wie wir sie heute noch kennen, kamen im 17./18. Jahrhundert auf und wurden mit weißen Kniestrümpfen zu Kniebundhosen von männlichen Hoflakaien getragen."
                                            },
                                            {
                                                "example_id": "ae58878b-0409-44a5-bc60-2fa041d5d509",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "\"Besonders Ballerinas und Pumps aus Veloursleder mit Schleife (159 Euro) werden hier zur Zeit gerne gekauft.\""
                                            },
                                            {
                                                "example_id": "c5d7731d-c703-4022-b5ee-49d7747e94bd",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "„Meine Großmutter trug bis zu ihrem neunzigsten Geburtstag bei besonderen Anlässen marineblaue Pumps mit Absätzen.“"
                                            },
                                            {
                                                "example_id": "2e0706d4-d966-44c6-ad28-2cf3fdcb58fe",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "„Sisi, an hohe Absätze nicht gewöhnt, konnte mit den glänzenden, silbernen Pumps kaum das Gleichgewicht halten, schwenkte aber ihren Po, wie sie es bei Models gesehen hatte.“"
                                            },
                                            {
                                                "example_id": "03a56ee4-14f5-41ab-927d-626c1c5ea3c1",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "„Sie senkte den Kopf und sah Cyprians rote Pumps an ihren Füßen, dann hob sie ihn wieder und begegnete Adriennes ruhigem, aufmunterndem Blick.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3597a4d-3824-47c0-b7d5-4c4a7490a651",
