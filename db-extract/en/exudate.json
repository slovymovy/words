                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "65279171-9a99-4fe3-955c-20149d268f26",
                        "entry_id": "f7aba54a-0967-3abf-87d1-d603a3c05852",
                        "tags": [
                            "plural"
                        ],
                        "form": "exudates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7038f302-d3ea-30df-80ab-a9b1710ae1fc",
                        "entry_id": "f7aba54a-0967-3abf-87d1-d603a3c05852",
                        "glosses": [
                            "A fluid that has exuded from somewhere; especially one that has exuded from a pore of an animal or plant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dcdb9fa-e8f8-47e7-aa17-6b2ba91fe963",
                                "sense_id": "7038f302-d3ea-30df-80ab-a9b1710ae1fc",
                                "text": "The whitish lines of exudate seem at times to penetrate even between the straight tubes . . ."
                            },
                            {
                                "example_id": "30142722-d2ea-44a2-93ca-5859e07c1af8",
                                "sense_id": "7038f302-d3ea-30df-80ab-a9b1710ae1fc",
                                "text": "When this is done, one should leave the poppy for some time, then return to it and gather any further exudate."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81cacc47-6969-4fe3-83bd-c4245cdbcec9",
                        "source_entry_id": "f7aba54a-0967-3abf-87d1-d603a3c05852",
                        "source_sense_id": "7038f302-d3ea-30df-80ab-a9b1710ae1fc",
                        "source_sense_description": "a fluid that has exuded from somewhere",
                        "target_lang_word": "exsudat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exsudat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de51a4ff-1e1e-3daa-97e2-1009130acd4e",
                                        "entry_id": "76269b79-18d2-3439-8d11-b766eed203e5",
                                        "glosses": [
                                            "Blastème produit en des conditions pathologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fac17af-0b4e-4589-9743-d1e12772c1be",
                                                "sense_id": "de51a4ff-1e1e-3daa-97e2-1009130acd4e",
                                                "text": "La fibrine prédomine dans tous les exsudats du tissu conjonctif; chaque tissu fournit quelques éléments qui détruisent l’uniformité de ces épanchements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a28350-9570-32f9-915f-6034a5ad9e33",
                                        "entry_id": "76269b79-18d2-3439-8d11-b766eed203e5",
                                        "glosses": [
                                            "Liquide suintant d’un végétal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58e14ab-da4e-47a4-b451-eaf7c6dd060f",
                                                "sense_id": "d5a28350-9570-32f9-915f-6034a5ad9e33",
                                                "text": "La pomme de terre, par l’émission de ses exsudats racinaires, fait germer la menthe."
                                            },
                                            {
                                                "example_id": "0eac8f0b-ac18-49c4-b9e2-a5aaf17b8540",
                                                "sense_id": "d5a28350-9570-32f9-915f-6034a5ad9e33",
                                                "text": "Appelée aussi gomme arabique, la gomme d’acacia provient de l’exsudat de l’acacia, un arbre qui pousse à l’état sauvage en Afrique, dans le sud du Sahel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
