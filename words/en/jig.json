                            },
                            {
                                "target_lang_word": "zingen",
                                "target_lang_sense_clarification": "een vrolijk wijsje zingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08d2f365-04f8-3c94-b00c-dd5c638757ad",
                    "sense_definition": "To wash, sieve, or separate mineral ore in water using a jigging machine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miners had to <w>jig</w> the crushed rock to extract the heavier ore.",
                            "target_lang_translations": {
                                "nl": "Mijnwerkers moesten het vergruisde gesteente <w>zetten</w> om het zwaardere erts te winnen."
                            }
                        },
                        {
                            "text": "Workers learned how to <w>jig</w> the gravel efficiently.",
                            "target_lang_translations": {
                                "nl": "Arbeiders leerden hoe ze het grind efficiënt konden <w>wassen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Erts wassen, zeven of scheiden in water met behulp van een zetmachine."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zetten",
                                "target_lang_sense_clarification": "erts scheiden met zetmachine"
                            },
                            {
                                "target_lang_word": "wassen",
                                "target_lang_sense_clarification": "erts spoelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd41c479-4e59-390e-b1bb-bd015cd95ad7",
                    "sense_definition": "To shape or cut a workpiece using a guiding jig or specialized tool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machinist needed to <w>jig</w> the metal piece carefully to ensure precise drilling.",
                            "target_lang_translations": {
                                "nl": "De machinist moest het metalen onderdeel zorgvuldig <w>in een mal plaatsen</w> om nauwkeurig te kunnen boren."
                            }
                        },
                        {
                            "text": "They will <w>jig</w> the steel components according to the technical blueprint.",
                            "target_lang_translations": {
                                "nl": "Ze zullen de stalen onderdelen volgens de technische bouwtekening <w>met een mal bewerken</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een werkstuk bewerken of snijden met behulp van een mal of gespecialiseerd gereedschap."
                    },
                    "translations": {
