                "senses": [
                    {
                        "sense_id": "6a15b242-0a8b-399b-a416-bfb00f32999f",
                        "entry_id": "457ab0bf-0d62-3465-82ec-c8930b92236c",
                        "glosses": [
                            "Qualifie un type d’acide gras mono-insaturé, l’acide érucique, que l’on trouve dans le colza, des plantes du genre Erysimum, et les graines de moutarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "371cda46-66dd-43f9-91b8-f39f150bcdcd",
                                "sense_id": "6a15b242-0a8b-399b-a416-bfb00f32999f",
                                "text": "En cet état, cet acide cristallise en aiguilles ; d’après les analyses de M. Darby, il possède une composition qui s’accorde avec la formule. Cette formule et le point de fusion font de cet acide gras un acide nouveau, que l’auteur appelle acide érucique."
                            }
                        ]
                    },
                    {
                        "sense_id": "04a84757-4c43-3558-b532-e9c6d65bb441",
                        "entry_id": "457ab0bf-0d62-3465-82ec-c8930b92236c",
                        "glosses": [
                            "Qui contient de l’acide érucique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83721bef-4c1a-45b0-afd3-85d830cd49c6",
                                "sense_id": "04a84757-4c43-3558-b532-e9c6d65bb441",
                                "text": "Les ravageurs, en particulier la grosse altise, se sont quant à eux goinfrés dans les colzas éruciques et alimentaires, y pondant des larves qui y ont largement prospéré durant ce printemps 2016 pluvieux."
                            }
                        ]
                    }
