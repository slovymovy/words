                },
                {
                    "sense_id": "0cf3614b-9c72-3ba4-93f1-a6bc7556c278",
                    "sense_definition": "Niet voorzien van een remmechanisme (met name bij voertuigen of aanhangers).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het maximale gewicht van een <w>ongeremde</w> aanhanger is wettelijk beperkt. Hij reed een <w>ongeremde</w> trailer naar de camping.",
                            "target_lang_translations": {
                                "en": "The maximum weight of an <w>unbraked</w> trailer is restricted by law. He drove an <w>unbraked</w> trailer to the campsite."
                            }
                        },
                        {
                            "text": "Hij reed met een <w>ongeremde</w> trailer over de snelweg.",
                            "target_lang_translations": {
                                "en": "He drove on the highway with an <w>unbraked</w> trailer."
                            }
