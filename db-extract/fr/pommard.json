                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ebb989-d27c-480b-90b8-798f0ccdfd98",
                                "sense_id": "e2e13c59-5f7c-353f-8c92-dd3001267a10",
                                "text": "Mon lieutenant, faites-moi servir une bouteille de pommard... Du meilleur..."
                            },
                            {
                                "example_id": "17be2330-905c-4ae1-b20c-c35ed46e2065",
                                "sense_id": "e2e13c59-5f7c-353f-8c92-dd3001267a10",
                                "text": "Anne Desbaresdes boit, et ça ne cesse pas, le Pommard continue d’avoir ce soir la saveur anéantissante des lèvres inconnues d’un homme de la rue."
                            },
                            {
                                "example_id": "79e7d0f4-0907-4985-ba4f-bde704c7dd7c",
                                "sense_id": "e2e13c59-5f7c-353f-8c92-dd3001267a10",
                                "text": "Elle répertoria un margaux, quatre sauternes, deux château-d’yquem, trois rieslings et un pommard, mais pas de romanée-conti."
                            }
                        ]
