{
    "word_family": [
        "welfarism",
        "welfarist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8772cac-7435-3234-ad9e-5b47b1416352",
                    "sense_definition": "Health, safety, happiness, and prosperity; well-being in any respect.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer checked on the <w>welfare</w> of the elderly residents during the storm.",
                            "target_lang_translations": {
                                "ru": "Полицейский проверил <w>благополучие</w> пожилых жителей во время шторма.",
                                "zh": "暴风雨期间，警官查看了老年居民的<w>安康</w>状况。"
                            }
                        },
                        {
                            "text": "Her primary concern is the <w>welfare</w> of her students, both inside and outside the classroom.",
                            "target_lang_translations": {
                                "ru": "Её главная забота — <w>благополучие</w> её учеников как в классе, так и за его пределами.",
                                "zh": "她最关心的是学生在课堂内外的<w>福祉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "child welfare",
                        "animal welfare",
                        "social welfare",
                        "concern for welfare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здоровье, безопасность, счастье и процветание; благополучие в любом отношении.",
                        "zh": "指健康、安全、幸福和繁荣；在任何方面的安康或福祉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благополучие",
                                "target_lang_sense_clarification": "спокойное и счастливое состояние, жизнь без нарушений"
                            },
                            {
                                "target_lang_word": "благосостояние",
                                "target_lang_sense_clarification": "обеспеченность материальными и духовными благами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "福祉",
                                "target_lang_sense_clarification": "指生活安宁、幸福的状态"
                            },
                            {
                                "target_lang_word": "安康",
                                "target_lang_sense_clarification": "指身体健康、生活平安"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a782f46-e1d1-3f74-af6a-3530961048fc",
                    "sense_definition": "Financial support or other assistance given to people in need, typically by the government.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing his job, he had to rely on <w>welfare</w> to pay for rent and groceries.",
                            "target_lang_translations": {
                                "ru": "Потеряв работу, он был вынужден полагаться на <w>социальное пособие</w>, чтобы платить за аренду и продукты.",
                                "zh": "失业后，他不得不依靠<w>社会救济</w>来支付房租和购买食品。"
                            }
                        },
                        {
                            "text": "The government is planning to reform the <w>welfare</w> system to help more families.",
                            "target_lang_translations": {
                                "ru": "Правительство планирует реформировать систему <w>социального обеспечения</w>, чтобы помочь большему количеству семей.",
                                "zh": "政府计划改革<w>社会福利</w>制度，以帮助更多的家庭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "public assistance",
                        "social security",
                        "income support",
                        "welfare assistance"
                    ],
                    "common_phrases": [
                        "on welfare",
                        "welfare state",
                        "welfare system",
                        "welfare benefits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовая поддержка или иная помощь нуждающимся, обычно предоставляемая государством.",
                        "zh": "通常由政府提供给有需要的人的经济支持或其他援助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "социальное пособие",
                                "target_lang_sense_clarification": "денежная выплата от государства"
                            },
                            {
                                "target_lang_word": "социальная помощь",
                                "target_lang_sense_clarification": "поддержка нуждающихся граждан"
                            },
                            {
                                "target_lang_word": "социальное обеспечение",
                                "target_lang_sense_clarification": "система государственной поддержки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社会福利",
                                "target_lang_sense_clarification": "政府为保障公民基本生活而提供的援助"
                            },
                            {
                                "target_lang_word": "社会救济",
                                "target_lang_sense_clarification": "针对贫困或受灾人群的紧急或长期经济援助"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31c6e646-abbc-3f26-b790-7ce663fb6278",
                    "sense_definition": "To provide with welfare or aid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local charity is dedicated to <w>welfaring</w> the homeless population in the city.",
                            "target_lang_translations": {
                                "ru": "Местная благотворительная организация посвятила себя тому, чтобы <w>оказывать помощь</w> бездомному населению города.",
                                "zh": "当地慈善机构致力于为城市里的无家可归者提供<w>救济</w>。"
                            }
                        },
                        {
                            "text": "They spent years <w>welfaring</w> those who had been displaced by the conflict.",
                            "target_lang_translations": {
                                "ru": "Они потратили годы, <w>заботясь</w> о тех, кто был вынужден переселиться из-за конфликта.",
                                "zh": "他们多年来一直致力于<w>资助</w>那些因冲突而流离失所的人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать благополучие или оказывать помощь.",
                        "zh": "为某人提供福利或援助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оказывать помощь",
                                "target_lang_sense_clarification": "предоставлять поддержку"
                            },
                            {
                                "target_lang_word": "заботиться",
                                "target_lang_sense_clarification": "проявлять беспокойство о чьем-либо благополучии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "救济",
                                "target_lang_sense_clarification": "提供物质上的帮助以缓解困境"
                            },
                            {
                                "target_lang_word": "资助",
                                "target_lang_sense_clarification": "提供资金或物资支持"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}