                "senses": [
                    {
                        "sense_id": "c245cf96-0327-39aa-ace2-0768fac47473",
                        "entry_id": "a2f1f975-ad04-3776-8594-840539935efc",
                        "glosses": [
                            "свойство по значению прилагательного сплочённый"
                        ],
