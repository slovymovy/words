        "nl-extract.jsonl": [
            {
                "entry_id": "52abab89-63b4-3aad-aa5a-586b1b0aa022",
                "word": "stilheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4fa3a543-7046-3472-9b4a-a55526040365",
                        "entry_id": "52abab89-63b4-3aad-aa5a-586b1b0aa022",
                        "glosses": [
                            "de stilte, de rust, de kalmte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b07aa8f9-7c5f-48b5-98a0-9257ed8b97db",
                                "sense_id": "4fa3a543-7046-3472-9b4a-a55526040365",
                                "text": "Een fascinerend woest landschap, waar de koeien grazen op weilanden die tot aan zee strekken, diezelfde zee op andere plekken tegen de kliffen beukt, slingerweggetjes die van het ene gehucht naar het andere voeren en soms onmetelijke stilheid. Een dreigende grijze lucht boven zee. Het einde van de wereld. Heerlijk."
                            },
                            {
                                "example_id": "860a7637-4957-44d1-87bd-8b0505273a20",
                                "sense_id": "4fa3a543-7046-3472-9b4a-a55526040365",
                                "text": "Terwijl de goddelozen bloeien en triomferen, dienen Gods kinderen de sleutels van de mond –zoals de profeet zegt– te bewaren in stilheid, en geduldig af te wachten totdat God hun mond opent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "194c3f98-9f2b-4a1b-8479-4327a1ed0076",
                        "source_entry_id": "52abab89-63b4-3aad-aa5a-586b1b0aa022",
                        "source_sense_id": "4fa3a543-7046-3472-9b4a-a55526040365",
                        "target_lang_word": "silence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "The absence of any sound."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9bcd0c-9eb5-4a42-8cc6-9c844d0617e5",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "When the motor stopped, the silence was almost deafening."
                                            },
                                            {
                                                "example_id": "55f6e3a1-ad11-465b-8d1e-32a0b17508d3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "Words like violence break the silence / Come crashing in into my little world"
                                            },
                                            {
                                                "example_id": "f11718a4-2404-489e-9b2a-eb196fdc5117",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "deadly silence"
                                            },
                                            {
                                                "example_id": "4c778e96-2828-4717-a7f5-491620ff76b3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "in silence"
                                            },
                                            {
                                                "example_id": "1402b33c-c922-47e2-bd6e-3316b118f6a3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "total silence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "The act of refraining from speaking."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a4d136-34e0-4fec-a582-41819f990e2b",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "\"You have the right to silence,\" said the police officer."
                                            },
                                            {
                                                "example_id": "e38411d7-6f70-40ec-a029-1b668c373688",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            },
                                            {
                                                "example_id": "5f8e0dcd-8df2-4fc8-90e0-9974119d6c83",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "1832, Daniel Webster, \"a convention\", quoted in The History of the Union, and of the Constitution by Charles Chauncey Burr\nThe administration itself keeps a profound silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8ec1e9-32ee-387d-8b3c-8788b5cfd486",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "Refraining from speaking, for purposes of prayer or meditation; especially, a form of worship practiced by the Society of Friends (Quakers) during meetings."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17096e73-6e24-4588-8f91-aab14aa09f14",
                                                "sense_id": "ed8ec1e9-32ee-387d-8b3c-8788b5cfd486",
                                                "text": "During silence a message came to me that there was that of God in every person."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ca1bef-0bba-326b-b09d-7e6768927a71",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To make (someone or something) silent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2e0b35-6617-4043-a25a-200d9f863d09",
                                                "sense_id": "a8ca1bef-0bba-326b-b09d-7e6768927a71",
                                                "text": "Can you silence the crowd, so we can start the show?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f2d8b6c-68c1-3d3d-9ac5-948a0b72d637",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To repress the expression of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a04f3a-f79b-43be-a841-8802eb939503",
                                                "sense_id": "4f2d8b6c-68c1-3d3d-9ac5-948a0b72d637",
                                                "text": "Women, as well as children, have their thoughts or emotions routinely silenced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To suppress criticism, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d57b6d-8215-490a-8606-c89f43a97eb2",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "Silence the critics."
                                            },
                                            {
                                                "example_id": "c8d49075-a871-4704-990b-c82bb381132b",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "Silence the doubters."
                                            },
                                            {
                                                "example_id": "fadea5db-5b6e-4724-b010-18bc1ec516ce",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "A state ideology, mixing nationalism, and basic Marxist economics, going under the name \"Juche\", was constructed, and Kim Il-sung effectively silenced, disposed of and cleared away any opposition, isolating the country and exercising an iron grip on the military, the state media and the government and party organs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eddaa1e-dda3-3515-8efa-538a35bf9294",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To block gene expression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "675239fb-397f-36c9-a893-402323f248c0",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To murder."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a563b42b-754c-460d-b62d-0122ed55464b",
                                                "sense_id": "675239fb-397f-36c9-a893-402323f248c0",
                                                "text": "They, and others through the years, believed Ruby must have acted on his own since there was no logic to the supposition that anyone could trust an uncontrollable, unreliable loudmouth like Ruby to silence Oswald."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                        "entry_id": "565984bd-5465-331e-b152-f00c679e5a31",
                                        "glosses": [
                                            "Be silent."
                                        ],
                                        "tags": [
                                            "imperative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7762bc1f-2471-4b82-ae6b-0bd15df27f94",
                                                "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                                "text": "Silence! Enough of your insolence!"
                                            },
                                            {
                                                "example_id": "628a136e-3da6-475a-a532-29daac5f5485",
                                                "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                                "text": "(in response to laughter from the audience)\nSilence! I kill you!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6680405-8053-4db2-b588-408f10af134c",
                        "source_entry_id": "52abab89-63b4-3aad-aa5a-586b1b0aa022",
                        "source_sense_id": "4fa3a543-7046-3472-9b4a-a55526040365",
                        "target_lang_word": "quiet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quiet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "With little or no sound; free of disturbing noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700153ea-437b-413a-a3ec-dd454e8f7a82",
                                                "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                                "text": "I can't hear the music; it is too quiet."
                                            },
                                            {
                                                "example_id": "58e377eb-327d-46c9-8466-b855fe69d442",
                                                "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                                "text": "On the light streets, better streetcleaners, more trees, more police, and quieter buses were the most popular improvements, followed by cutting down the number of cars and improving children's play space."
                                            },
                                            {
                                                "example_id": "2ab0e4c1-fbcd-4951-ba88-6c7269a18e60",
                                                "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                                "text": "Before long, the unsuspecting salesman was earnestly pitching him \"the quietest noisemaker on the market.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Having little motion or activity; calm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9618ffa7-2c47-4227-b50b-f0b64a626c49",
                                                "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                                "text": "the sea was quiet"
                                            },
                                            {
                                                "example_id": "3bb5d4bd-6fa4-4b57-a5c4-7d6f293ac62b",
                                                "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                                "text": "a quiet night at home"
                                            },
                                            {
                                                "example_id": "799893e0-b26f-49c1-a07d-0bc8b05095a9",
                                                "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                                "text": "all quiet on the Western front"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Not busy, of low quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa6a745d-180f-4f63-a354-cd3b3478d758",
                                                "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                                "text": "The traffic was quiet for a Monday morning."
                                            },
                                            {
                                                "example_id": "bd9b2a3e-1dbd-40a6-8bb0-0765303606be",
                                                "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                                "text": "Business was quiet for the season."
                                            },
                                            {
                                                "example_id": "5a045a00-d36a-4bc3-9669-538e9e3b9c64",
                                                "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2de6eb5-cedc-3d11-a34a-097b7b2fff03",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Not talking much or not talking loudly; reserved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328676c2-238d-48ad-b78b-95383d319906",
                                                "sense_id": "a2de6eb5-cedc-3d11-a34a-097b7b2fff03",
                                                "text": "He's a very quiet man usually, but is very chatty after a few beers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62902a5f-89c6-3445-9ce7-ed353a036dfc",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Not showy; undemonstrative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d72d3f1-2549-4d52-a55b-c42918e31af2",
                                                "sense_id": "62902a5f-89c6-3445-9ce7-ed353a036dfc",
                                                "text": "a quiet dress"
                                            },
                                            {
                                                "example_id": "f47ff175-622a-4199-9e4e-149a1520ddf0",
                                                "sense_id": "62902a5f-89c6-3445-9ce7-ed353a036dfc",
                                                "text": "quiet colours"
                                            },
                                            {
                                                "example_id": "5882badf-cad9-46bb-9838-76966f129c60",
                                                "sense_id": "62902a5f-89c6-3445-9ce7-ed353a036dfc",
                                                "text": "a quiet movement"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4310ee-7f1b-3992-a56f-f57e0b47cef4",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Requiring little or no interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef5fe82-9004-41c6-b5df-1e4d3c8d09db",
                                                "sense_id": "ad4310ee-7f1b-3992-a56f-f57e0b47cef4",
                                                "text": "a quiet install"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quiet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08dd73fc-3e6c-37a7-bc83-9a93b8c15e26",
                                        "entry_id": "d0e07c3f-5933-34ec-a127-b8dd3e4e1cbb",
                                        "glosses": [
                                            "To cause (someone or something) to become quiet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18360512-2141-46d7-8c91-9e0c0b71e143",
                                                "sense_id": "08dd73fc-3e6c-37a7-bc83-9a93b8c15e26",
                                                "text": "Can you quiet your child? He’s making lots of noise."
                                            },
                                            {
                                                "example_id": "204aa744-ab65-4a12-b08f-969cb334c73e",
                                                "sense_id": "08dd73fc-3e6c-37a7-bc83-9a93b8c15e26",
                                                "text": "The umpire quieted the crowd so the game could continue in peace."
                                            },
                                            {
                                                "example_id": "2c403377-0c2c-4d55-aa0b-c12085839b9b",
                                                "sense_id": "08dd73fc-3e6c-37a7-bc83-9a93b8c15e26",
                                                "text": "For thou haſt created us for thy ſelfe, and our heart cannot be quieted till it may fine repoſe in thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240a229f-4f17-3fae-83f0-79107bad97a0",
                                        "entry_id": "d0e07c3f-5933-34ec-a127-b8dd3e4e1cbb",
                                        "glosses": [
                                            "To become quiet or calm."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acda0236-00e8-4c81-a268-5533d3c575c4",
                                                "sense_id": "240a229f-4f17-3fae-83f0-79107bad97a0",
                                                "text": "When you quiet, we can start talking."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quiet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a98f81-bc70-3521-9d47-c1635b1b730b",
                                        "entry_id": "7a115691-d685-3775-8e41-2f7be917967e",
                                        "glosses": [
                                            "The absence of sound; quietness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daaffcfc-c706-459d-8f30-16b32972f054",
                                                "sense_id": "d6a98f81-bc70-3521-9d47-c1635b1b730b",
                                                "text": "There was a strange quiet in the normally very lively plaza."
                                            },
                                            {
                                                "example_id": "14c2e813-88e6-45e0-ac02-ed0001e336bb",
                                                "sense_id": "d6a98f81-bc70-3521-9d47-c1635b1b730b",
                                                "text": "We need a bit of quiet before we can start the show."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "612daef3-560f-3e4c-972e-9a5eba11d8fe",
                                        "entry_id": "7a115691-d685-3775-8e41-2f7be917967e",
                                        "glosses": [
                                            "The absence of movement; stillness, tranquility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be0a6102-88e4-3c60-8105-aaf25daba428",
                                        "entry_id": "7a115691-d685-3775-8e41-2f7be917967e",
                                        "glosses": [
                                            "The absence of disturbance or trouble; peace, security."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e63b337-58b5-43e2-b2ca-eb979927439a",
                                                "sense_id": "be0a6102-88e4-3c60-8105-aaf25daba428",
                                                "text": "The King & his Nobles thinke they may ſleepe in quiet,\nNow they haue giuen vs a little holy water at the Court,\nBut thers no ſuch matter, we be no ſuch fooles,\nTo be bobd out with words and after come to hanging: […]"
                                            }
