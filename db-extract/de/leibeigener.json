                "senses": [
                    {
                        "sense_id": "2183418c-4f87-3517-af15-fe57ca0a396d",
                        "entry_id": "2361f8bc-3182-32c6-b8be-3af3322cddf2",
                        "glosses": [
                            "unfreie Person, die in einem feudalistischen System einem Grundherren zu Frondiensten verpflichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df056da1-7fae-43ac-bb4d-00b2c1ba02c8",
                                "sense_id": "2183418c-4f87-3517-af15-fe57ca0a396d",
                                "text": "im Bauernkrieg erhoben sich die Leibeigenen gegen ihre Grundherren."
                            },
                            {
                                "example_id": "89984a50-df7f-41b1-be2c-81c0aeaaa6de",
                                "sense_id": "2183418c-4f87-3517-af15-fe57ca0a396d",
                                "text": "„Und zumindest auf dem Papier hat es Veränderungen am umstrittenen Kafala-System gegeben, das die Arbeiter quasi zu Leibeigenen der Firmen machte, für die sie schuften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
