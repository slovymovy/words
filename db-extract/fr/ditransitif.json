                        "glosses": [
                            "Se dit d’un verbe qui a besoin d’un objet direct et d’un objet indirect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3ce696-810b-40a4-885d-753b8600f234",
                                "sense_id": "537e1e59-90a8-3cd4-8a4c-a40b15797741",
                                "text": "Cette classification [SOV, SVO, VSO, VOS, OVES et OSV] est limitée dans la mesure où elle ne prend en compte ni les verbes intransitifs (« monoactanciels ») ni les verbes ditransitifs (ou « triactanciels »)."
                            }
                        ]
