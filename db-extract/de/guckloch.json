                        "form": "das Guckloch"
                    },
                    {
                        "form_id": "b24adde0-3b39-478d-bc8a-ae01abe34a02",
                        "entry_id": "38e5245c-2816-3d43-9cde-f57170c15a1d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gucklöcher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7aca977-222b-3ba6-be37-287513a08d23",
                        "entry_id": "38e5245c-2816-3d43-9cde-f57170c15a1d",
                        "glosses": [
                            "umgangssprachlich: (oft mit geeigneten Linsen versehenes) kleines Loch in einer Tür, durch das man sehen kann, ohne selbst gesehen zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0640d8-bbe6-4b49-8678-85bec3994a99",
                                "sense_id": "d7aca977-222b-3ba6-be37-287513a08d23",
                                "text": "„Das Guckloch in der Tür war besetzt.“"
                            },
                            {
                                "example_id": "e2321fc1-b9f5-4aa2-9446-d8f808f330ab",
                                "sense_id": "d7aca977-222b-3ba6-be37-287513a08d23",
                                "text": "„Aber in dem Zimmer sind Gucklöcher durch die Tür.“"
                            },
                            {
                                "example_id": "2694fd1c-468f-4ba4-8d4f-19aa52b14282",
                                "sense_id": "d7aca977-222b-3ba6-be37-287513a08d23",
                                "text": "„Er rutscht von der Treppe und späht durchs Guckloch in den Laden, und er sieht, daß Frauen im Laden sind, die da einkaufen, und ehe sichs die Mutter versieht, sind die Biertrinker wieder im Laden.“"
                            },
                            {
                                "example_id": "fa782e5e-04c7-48e3-8a5d-52fbcefba0ae",
                                "sense_id": "d7aca977-222b-3ba6-be37-287513a08d23",
                                "text": "„Er feuchtete mit der Zunge die Fingerspitze und mit der Fingerspitze vorsichtig eine Stelle des Pergaments der Fensterfüllung an, bis sich die Stelle erweichte und zum Guckloch auftat.“"
                            },
                            {
                                "example_id": "dd60f4ad-ee7c-41e9-903d-94fb18c3a17f",
                                "sense_id": "d7aca977-222b-3ba6-be37-287513a08d23",
                                "text": "„»Haben Sie nun Zeit gehabt, sich zu überlegen, was Sie essen wollen?« rief die rauhe Stimme meines Kerkermeisters mir durch das Guckloch zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4029db4a-42cb-42e9-83d7-420780888d8d",
                        "source_entry_id": "38e5245c-2816-3d43-9cde-f57170c15a1d",
                        "source_sense_id": "d7aca977-222b-3ba6-be37-287513a08d23",
