                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zelfkastijding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8a63712c-58e5-3c61-8ad0-682b51bfc5b9",
                                        "entry_id": "00579e6d-3d8b-3ed4-86a1-9daaf7622262",
                                        "glosses": [
                                            "het zichzelf bestraffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832758d8-d612-48a3-827d-32d3fe1bb747",
                                                "sense_id": "8a63712c-58e5-3c61-8ad0-682b51bfc5b9",
                                                "text": "De vraag is of je op deze manier als FNV je doel niet voorbij schiet met je ‘gesponsorde bericht’. Het lijkt immers meer een publieke vorm van zelfkastijding."
                                            },
                                            {
                                                "example_id": "363ce91f-3db0-4ad1-ab72-edcc208612ea",
                                                "sense_id": "8a63712c-58e5-3c61-8ad0-682b51bfc5b9",
                                                "text": "FN-burgemeester Franck Briffaut haalde zich veel woede op de hals toen hij op de radio verklaarde: 'Die geest van boetedoening en permanente zelfkastijding, we beginnen er moe van te worden'. Mensenrechtenorganisaties en vakbonden hebben het initiatief genomen voor de 'alternatieve' herdenking."
                                            },
                                            {
                                                "example_id": "9c00aecf-bd27-4b5b-b33b-b93e82782e1c",
                                                "sense_id": "8a63712c-58e5-3c61-8ad0-682b51bfc5b9",
                                                "text": "Waarom zijn we zo dol zijn op zelfkastijding, zoals vasten, kou lijden of extreme sporten? Neem plaats op de sofa van Irene van den Berg. Zij analyseert iedere week ons economisch gedrag."
                                            },
                                            {
                                                "example_id": "c5699ebf-b94c-4c0e-9a47-f6193dcc8bd7",
                                                "sense_id": "8a63712c-58e5-3c61-8ad0-682b51bfc5b9",
                                                "text": "Van een vastenperiode tot voedingsmiddelen die verboden worden verklaard, en van tatoeageceremonies tot zelfkastijding: het zijn allemaal pogingen om het lichaam op de proef te stellen, en intussen de geest te disciplineren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
