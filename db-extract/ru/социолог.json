                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4583932b-b607-3925-9536-897fcea99df6",
                                        "entry_id": "a12395e0-92e5-3eeb-b703-7e9551515b24",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit dem Zusammenleben der Menschen in der Gesellschaft (Soziologie) befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55d96a0-17d6-4301-b187-4eba2ea58bf7",
                                                "sense_id": "4583932b-b607-3925-9536-897fcea99df6",
                                                "text": "Nicht nur Banker, auch die deutschen Soziologen fragen nach den Ursachen der Finanzkatastrophe."
                                            },
                                            {
                                                "example_id": "86a39964-af76-4824-889c-fb08f1153544",
                                                "sense_id": "4583932b-b607-3925-9536-897fcea99df6",
                                                "text": "„Um dem abzuhelfen, machten sich Soziologen, Analytiker, Gynäkologen, Psychologen und diverse Sachbuchautoren an die Arbeit.“"
                                            },
                                            {
                                                "example_id": "37638a9f-4f4b-47cf-ad37-6ba77762304d",
                                                "sense_id": "4583932b-b607-3925-9536-897fcea99df6",
                                                "text": "„Soziologen und Kulturwissenschaftler befassten sich mit der DDR.“"
                                            },
                                            {
                                                "example_id": "d5547bee-bacb-4f91-b294-cc8740f0e428",
                                                "sense_id": "4583932b-b607-3925-9536-897fcea99df6",
                                                "text": "„Bereits 1891 untersuchte der Soziologe Herbert Spencer, welche Themen in den Medien besonders hysterisch und aufgeregt behandelt wurden und welche Relevanz sie nach dem damaligen Stand der Forschung tatsächlich hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
