                "senses": [
                    {
                        "sense_id": "e8e427a8-b724-3bb5-9292-c9218fc1331d",
                        "entry_id": "646d9939-5e41-3130-8ecb-0066a96f93e9",
                        "glosses": [
                            "ubóstwiony heros, patron żeglarzy i żołnierzy, syn Tyndareosa (lub Zeusa) i Ledy, przeniesiony (wraz z bratem Polideukesem) na firmament jako gwiazdozbiór Bliźniąt; ,"
                        ],
                        "tags": [
                            "Ancient-Greek",
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "4f48deb6-8e74-45ba-a24a-e267afda3b75",
                                "sense_id": "e8e427a8-b724-3bb5-9292-c9218fc1331d",
                                "text": "Kastor i Polideukes (Polluks) uchodzili za opiekunów żeglarzy, zwłaszcza jako najjaśniejsze gwiazdy w gwiazdozbiorze Bliźniąt wskazujące kierunek żeglugi albo jako ognie świętego Elma."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8fd77fba-f0e0-320b-ab6b-6c41c410f630",
                        "entry_id": "646d9939-5e41-3130-8ecb-0066a96f93e9",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40fa23ea-2b31-443b-a8c0-5ff49cc9f7e9",
                                "sense_id": "8fd77fba-f0e0-320b-ab6b-6c41c410f630",
                                "text": "Mam na imię Kastor i jestem marynarzem z Gdańska."
                            },
                            {
                                "example_id": "a210d678-f1da-41aa-a37b-81c6714b884d",
                                "sense_id": "8fd77fba-f0e0-320b-ab6b-6c41c410f630",
                                "text": "Kastorowie imieniny obchodzą 13 lutego."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
