                "forms": [
                    {
                        "form_id": "d7342656-72ee-4d6a-b39b-b84beb0faa4e",
                        "entry_id": "18984d1d-5f58-367c-8b7b-2903bd2f857b",
                        "tags": [
                            "plural"
                        ],
                        "form": "goulags"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efb53322-ec2e-3d5a-8c36-8b18cfdeb0e6",
                        "entry_id": "18984d1d-5f58-367c-8b7b-2903bd2f857b",
                        "glosses": [
                            "Système concentrationnaire soviétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78206432-8603-4e4b-8f8d-f33b7d4eed34",
                                "sense_id": "efb53322-ec2e-3d5a-8c36-8b18cfdeb0e6",
                                "text": "L’évolution du goulag a suivi l’histoire du pays. (Wikipédia, Goulag)"
                            },
                            {
                                "example_id": "1b7ac17a-3c86-4baa-98df-e04b89b1c702",
                                "sense_id": "efb53322-ec2e-3d5a-8c36-8b18cfdeb0e6",
                                "text": "Le goulag a forcé Soljenitsyne à réfléchir sur son expérience et à l'évaluer à partir d'une perspective plus vaste."
                            }
                        ]
                    },
                    {
                        "sense_id": "80f8e655-e139-3e08-ba84-f0a5727cb56e",
                        "entry_id": "18984d1d-5f58-367c-8b7b-2903bd2f857b",
                        "glosses": [
                            "Camp de concentration en URSS."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ed8247-446e-468d-970c-b277ed7de958",
                                "sense_id": "80f8e655-e139-3e08-ba84-f0a5727cb56e",
                                "text": "Nombre de révolutionnaires communistes ont été déportés dans un goulag lors des Grandes Purges : la Révolution mangeait ses propres enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "faaa8848-da06-3f08-9839-aeed5c0f797c",
                        "entry_id": "18984d1d-5f58-367c-8b7b-2903bd2f857b",
                        "glosses": [
                            "Système concentrationnaire communiste, camp de concentration de prisonniers politiques d’un régime communiste autoritariste."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "45b2a1ba-0f06-4ddc-b695-06534b9261b3",
                                "sense_id": "faaa8848-da06-3f08-9839-aeed5c0f797c",
                                "text": "Le goulag chinois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1d3ce5b-8a48-4a82-993d-be4dd406b7c6",
                        "source_entry_id": "18984d1d-5f58-367c-8b7b-2903bd2f857b",
                        "target_lang_word": "gulag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gulag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "882cde2e-afed-3e8d-912d-f7744b7895d0",
                                        "entry_id": "0ef7bd1b-df29-36c1-a5c1-297d7154b4f3",
                                        "glosses": [
                                            "Also GULAG: the system of all Soviet labour camps and prisons in use, especially during the Stalinist period (1930s–1950s)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849c85f0-a1ce-49f0-91fb-cb709d9c2493",
                                                "sense_id": "882cde2e-afed-3e8d-912d-f7744b7895d0",
                                                "text": "One important difference between the GULAG system and the Nazi concentration camps was that a person sentenced to five years of hard labor in a Soviet labor camp could expect, assuming he or she survived, to be released at the end of the sentence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a007af-3f96-3697-a24b-a9aa7d933f26",
                                        "entry_id": "0ef7bd1b-df29-36c1-a5c1-297d7154b4f3",
                                        "glosses": [
                                            "A prison camp, especially one used to hold political prisoners."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb7ba699-416d-4d56-9717-defa88351c79",
                                                "sense_id": "e0a007af-3f96-3697-a24b-a9aa7d933f26",
                                                "text": "Nevertheless, the Trump administration has continued to insist that Abrego Garcia is a dangerous gang member in order to justify sending him to an overseas Gulag that has been accused of torturing inmates."
                                            },
                                            {
                                                "example_id": "0749d5e6-3767-4e15-ad30-b0a004e1eeff",
                                                "sense_id": "e0a007af-3f96-3697-a24b-a9aa7d933f26",
                                                "text": "The subtext of Knowles’s tweet was also clear: [Nayib] Bukele has partnered with the Trump administration to hold immigrants deported from America, with no due process, in El Salvador’s most notorious gulag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80a3246-6bc0-31d6-a38d-93f88f2edb69",
                                        "entry_id": "0ef7bd1b-df29-36c1-a5c1-297d7154b4f3",
                                        "glosses": [
                                            "A place where, or political system in which, people with dissident views are routinely oppressed."
                                        ],
                                        "tags": [
                                            "also",
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gulag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                        "entry_id": "7c6749b9-5808-37e6-8068-a5ae2be51843",
                                        "glosses": [
                                            "To compel (someone) into a forced labour camp or a similar place of confinement or exile."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "232611f4-7de1-43db-9c89-7506c8ac2e41",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "Regulative censorships can be amended or revolutionized in ways that raise or lower bodycounts, numbers of books banned or citizens ghettoed or gulaged."
                                            },
                                            {
                                                "example_id": "31c41205-da0d-40b3-8841-442bb1a4a5df",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "The marriage would be the last good thing in [Spencer] Haywood's life for a long time. He was gulaged to basketball Siberia—the now-defunct New Orleans franchise—for his failure to resurrect the Knicks, but at [Kareem Abdul-]Jabbar's urging the Lakers acquired him in 1980."
                                            },
                                            {
                                                "example_id": "fc0b3e0c-5288-48e5-8ae3-bd7c75ad93bf",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "Such a situation touches off in the reader a powerful sense of historical déjà vu: witch hunts, Gestapo roundups, the McCarthy era, Argentinian death squads, [Francisco] Franco and the murder of [Federico] Garcia Lorca, the KGB and the disappearance of Isaac Babel, the gulagging of Osip Mandelstam and Anna Akhmatova, to name just a few."
                                            },
                                            {
                                                "example_id": "18d2186a-7868-485a-86bb-34bee84940be",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "[Abraham Michael] Rosenthal's reign was described by many as a period of paranoia and terror at the [New York] Times—one reporter said, \"He was like the Czar; people would get gulaged at the drop of a hat.\""
                                            },
                                            {
                                                "example_id": "deadb2f5-1adb-45bb-8fd5-32a1bfa442b1",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "He wanted American Christians to pay reverence to the greater glory of the USSR, which, in his mind, was not a nation blowing up churches, gulaging the religious, shooting priests, locking up nuns with prostitutes—declaring nus \"whores to Christ\"—and pursuing what Mikhail Gorbachev later correctly described as a \"war on religion.\""
                                            },
                                            {
                                                "example_id": "5127d909-db16-4300-bb5e-c1451c038754",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "Knowledge that does not serve the state ideological apparatus or the dominant ruling, economic, intellectual or political force is knowledge or ideas that are consciously suppressed and \"gulaged\"."
                                            },
                                            {
                                                "example_id": "4c69aa47-baaf-45f6-9f4e-4299ecbc4b2f",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "The kids of high socioeconomic status were on the fifth floor, the lowest on the ground floor. The Technical Arts building had the Cape Verdeans and the Haitians … all of whom were Gulagged there in a building which they not-so-ironically called \"the island.\""
                                            },
                                            {
                                                "example_id": "b7136290-99fc-43b3-a14d-3ae58448aac1",
                                                "sense_id": "84bc3847-ba88-33aa-a0a5-6d85b3b2558b",
                                                "text": "For Dad, home had been pulverized, reduced repeatedly to its nuclear constituents. As if he'd been gulagged to the Big Bang of belonging. An imaginary time, without boundary, without beginning or end."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
