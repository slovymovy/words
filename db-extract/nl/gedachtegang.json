                        ],
                        "examples": [
                            {
                                "example_id": "afc941bc-d4ed-4027-96c4-4080b4e01abf",
                                "sense_id": "fe1d05a0-2c46-3dfc-b91f-0291b1a0feb2",
                                "text": "Ik volg zijn gedachtegang niet.",
                                "translation": "I don't follow his line of reasoning.",
                                "english": "I don't follow his line of reasoning."
                            },
                            {
                                "example_id": "8dedc35d-edec-4219-b080-0461a2821ee8",
                                "sense_id": "fe1d05a0-2c46-3dfc-b91f-0291b1a0feb2",
                                "text": "Haar unieke gedachtegang maakt haar tot een briljante onderzoeker.",
                                "translation": "Her unique way of thinking makes her a brilliant researcher.",
                                "english": "Her unique way of thinking makes her a brilliant researcher."
                            },
                            {
                                "example_id": "95da6705-53e4-40a1-af28-659c068590cd",
                                "sense_id": "fe1d05a0-2c46-3dfc-b91f-0291b1a0feb2",
                                "text": "Ik ben het niet eens met je gedachtegang.",
                                "translation": "I disagree with your reasoning.",
                                "english": "I disagree with your reasoning."
                            }
                        ]
                    }
