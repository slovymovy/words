                    "sense_definition": "enkelvoud tegenwoordige tijd van <w>bulten</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>bult</w> de zakken met zand op in de schuur.",
                            "target_lang_translations": {
                                "fr": "Il <w>entasse</w> les sacs de sable dans la remise."
                            }
                        },
                        {
                            "text": "De machine <w>bult</w> het materiaal tot een hoop.",
                            "target_lang_translations": {
                                "fr": "La machine <w>entasse</w> le matériau en un tas."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
