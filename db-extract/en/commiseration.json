                                                "sense_id": "ab2077e1-bf83-3d78-9e58-d8fd2ceb7856",
                                                "text": "Po stracie psa dzieci płakały z żalu cały dzień."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "8c005f2f-60f3-3707-a90f-c357d0b0bdd1",
