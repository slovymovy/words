                {
                    "sense_id": "39ed6e20-a3d2-3e90-a597-cf2aec3d222c",
                    "sense_definition": "Een dood lichaam, in het bijzonder van een mens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "corpse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie vond gisteren een <w>lijk</w> in het verlaten huis.",
                            "target_lang_translations": {
                                "en": "The police found a <w>corpse</w> in the abandoned house yesterday.",
                                "ru": "Вчера полиция нашла <w>труп</w> в заброшенном доме.",
                                "de": "Die Polizei fand gestern eine <w>Leiche</w> in dem verlassenen Haus."
                            }
                        },
                        {
                            "text": "Hij riep dat hij dat nooit zou doen, alleen over zijn <w>lijk</w>.",
                            "target_lang_translations": {
                                "en": "He shouted that he would never do that, only over his <w>dead body</w>.",
                                "ru": "Он кричал, что никогда этого не сделает, только через его <w>труп</w>.",
                                "de": "Er rief, dass er das niemals tun würde, nur über seine <w>Leiche</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoffelijk overschot",
                        "dode"
                    ],
                    "common_phrases": [
                        "over mijn lijk",
                        "een lijk in de kast",
                        "levend lijk"
                    ],
                    "target_lang_definitions": {
                        "en": "A dead body, especially of a human.",
                        "ru": "Мёртвое тело, особенно человека.",
                        "de": "Ein toter Körper, insbesondere eines Menschen."
                    },
                    "translations": {
