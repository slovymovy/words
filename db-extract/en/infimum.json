                                    {
                                        "sense_id": "75394358-855a-350d-832f-54f67c55ca44",
                                        "entry_id": "dbc9f8d3-10db-386a-9900-89d9b5c1aa2b",
                                        "glosses": [
                                            "Superlativo irregular de inferior: sumamente inferior o muy bajo. Se aplica al nivel, cantidad o intensidad de algo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04eda12b-1025-4c1e-bd2c-7fa520beaf00",
                                                "sense_id": "75394358-855a-350d-832f-54f67c55ca44",
                                                "text": "«Este movimiento está directamente relacionado con la temperatura, de modo que, a temperaturas bajas, es ínfimo el número de moléculas reactantes que tienen suficiente energía como para pasar al estado activado»."
                                            },
                                            {
                                                "example_id": "8fef0628-0bdf-40e2-a0b0-2d5d66778bff",
                                                "sense_id": "75394358-855a-350d-832f-54f67c55ca44",
                                                "text": "«Hay cinco o seis mil estrellas más brillantes que Urano en el cielo y el hecho que nadie lo descubriera a simple vista muestra que nunca alguien conoció el cielo hasta el más ínfimo detalle y lo revisó periódicamente»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
