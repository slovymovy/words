                ],
                "senses": [
                    {
                        "sense_id": "8f08b79c-d6cf-3e3b-a229-444027c7de91",
                        "entry_id": "1dbb0f35-6cc6-3f5d-b8a0-f30d0e2638a9",
                        "glosses": [
                            "Todesfälle (Anzahl der gestorbenen Personen) in der untersuchten Gruppe von Erkrankten (oft auf 1 Jahr bezogen); Todesfälle im Verhältnis zur Anzahl Neuinfizierter"
                        ],
                        "tags": [
                            "Epidemiologie",
                            "ganz korrekt",
                            "aber selten außerhalb der Fachwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "2a27d6ca-bae1-4d70-99f7-78d8284e8164",
                                "sense_id": "8f08b79c-d6cf-3e3b-a229-444027c7de91",
                                "text": "Die Letalitätsrate hat keine Einheit, sie berechnet sich aus der Zahl der Verstorbenen, geteilt durch die Zahl der klinisch Erkrankten."
                            },
                            {
                                "example_id": "68aeaad4-cfdb-4c82-919a-772ba2fbba38",
                                "sense_id": "8f08b79c-d6cf-3e3b-a229-444027c7de91",
                                "text": "„Die standardisierte Letalitätsrate betrug für die Gesamtheit aller Patienten 0,80 (99%-Konfidenzintervall 0,74–0,88).“"
                            },
                            {
                                "example_id": "4e5b58d5-4a2f-45e4-b02c-124513e38002",
                                "sense_id": "8f08b79c-d6cf-3e3b-a229-444027c7de91",
                                "text": "Wundstarrkrampf hat eine hohe Letalitätsrate, weil die Infektion sehr gefährlich ist, aber da die Fälle nicht so verbreitet sind, ist die entsprechende Mortalitätsrate gering. Es sterben jährlich nicht so viele Menschen am Wundstarrkrampf."
                            },
                            {
                                "example_id": "0e7647ac-c2ac-46b6-9d01-0ca7cca24c77",
                                "sense_id": "8f08b79c-d6cf-3e3b-a229-444027c7de91",
                                "text": "in Prozent angegeben: „Die Letalitätsrate [Spanische Grippe] lag je nach Versorgungssituation zwischen 0,7 und 6 Prozent, im polynesischen Samoa starb wegen des Fehlens jedweder Grippe-Immunität gar ein Fünftel der Bevölkerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
