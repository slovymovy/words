                                "target_senses": [
                                    {
                                        "sense_id": "1a4afb4d-6ba7-3e08-908b-652ea14e2a99",
                                        "entry_id": "44edba50-2732-3fc1-83a2-8ec1607dd473",
                                        "glosses": [
                                            "Of or pertaining to polyandry; engaging in polyandry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096a674a-c68d-4182-a617-eee3d1da094f",
                                                "sense_id": "1a4afb4d-6ba7-3e08-908b-652ea14e2a99",
                                                "text": "Why, she goes on, meeting another husband, lays another batch of eggs, leaves them and goes on her polyandrous way, flirting, fighting - oh, out on the razzle-dazzle generally."
                                            },
                                            {
                                                "example_id": "efe1f307-cdf4-46b6-8c71-98fadfd58e5f",
                                                "sense_id": "1a4afb4d-6ba7-3e08-908b-652ea14e2a99",
                                                "text": "Nestled in this remote area of northwestern Nepal is a tiny settlement of ethnic Tibetan Buddhists, the land of the Nyinba, where UCLA anthropologist Nancy Levine found one of the last flourishing polyandrous populations, a society where women marry several men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2052eb01-c70c-305b-99dc-87bd2984e8c9",
                                        "entry_id": "44edba50-2732-3fc1-83a2-8ec1607dd473",
                                        "glosses": [
                                            "Belonging to the class Polyandria; having many stamens inserted in the receptacle."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d8e59de-ce26-4a53-be55-882612d6ba07",
                        "source_entry_id": "75819a55-bd4b-3ecd-b7bb-539ea42099a9",
                        "source_sense_id": "5e9936f0-1dc6-303c-8a27-6664636c98fa",
