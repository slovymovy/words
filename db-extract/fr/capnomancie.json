                        "glosses": [
                            "Divination par la fumée des autels."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "e4e9ff74-2fe2-4ea3-b6c6-4f166499e288",
                                "sense_id": "b719003c-22d8-34b1-a701-4cc072cea47b",
                                "text": "Comme on le voit ici, la capnomancie consistait à observer de quelle manière et à quelle hauteur s’élevait la fumée , dans quelle direction elle était chassée par le vent, etc."
                            }
                        ]
