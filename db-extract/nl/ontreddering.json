                "senses": [
                    {
                        "sense_id": "527915c4-d271-33ec-b14a-82e54d94fd4b",
                        "entry_id": "71b46eb7-e0e0-3202-a39e-16196c22a58f",
                        "glosses": [
                            "uitzichtloze wanhoop en verdriet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9974c6-1641-452b-8512-ce72ff75b88d",
                                "sense_id": "527915c4-d271-33ec-b14a-82e54d94fd4b",
                                "text": "Koning Willem-Alexander is diep onder de indruk van de schade die orkaan Irma heeft veroorzaakt op het eiland Sint Maarten. ,,Dit tart al het voorstellingsvermogen. Dit heb ik nog nooit gezien, overal waar je kijkt zie je vernieling en ontreddering. Het gaat alle verbeelding te boven.\""
                            },
                            {
                                "example_id": "e7b84cb0-a6a6-49ce-a1ff-71fd151dc108",
                                "sense_id": "527915c4-d271-33ec-b14a-82e54d94fd4b",
                                "text": "De 'ontreddering'die hij zag op Sint Maarten, Saba en Sint Eustatius, na de orkaan Irma in september en 'de moedige aanzetten tot wederopbouw', hebben bij de koning gezorgd voor 'beelden en verhalen die me niet loslaten'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efdac8d1-08aa-49ca-9d3e-15d9c40ca33d",
                        "source_entry_id": "71b46eb7-e0e0-3202-a39e-16196c22a58f",
                        "source_sense_id": "527915c4-d271-33ec-b14a-82e54d94fd4b",
                        "target_lang_word": "upheaval",
