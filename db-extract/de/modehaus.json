                                        "sense_id": "54f2e2c6-6206-3d64-b072-796d724e6bce",
                                        "entry_id": "fcbf3bdb-1e5a-3790-af00-6c6eed68fd60",
                                        "glosses": [
                                            "een winkel waar men (dames)kleding kan kopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4d206c-81f3-43be-a189-e159bad80dad",
                                                "sense_id": "54f2e2c6-6206-3d64-b072-796d724e6bce",
                                                "text": "Ze herinnert zich hoe ze in de jaren zestig met haar moeder en drie oudere zussen naar het modehuis Meddens in Den Haag ging om handschoenen te kopen. De Van den Borns waren „een beetje een kakfamilie, zal ik maar zeggen” - en volgens haar ging Meddens speciaal voor hen open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c378582d-170c-3c85-9950-34277ae6a6a2",
                                        "entry_id": "fcbf3bdb-1e5a-3790-af00-6c6eed68fd60",
                                        "glosses": [
                                            "bedrijf dat modekleding ontwerpt en maakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50408bc6-b101-4df6-8bff-b0634b89d8f4",
                                                "sense_id": "c378582d-170c-3c85-9950-34277ae6a6a2",
                                                "text": "Collega-topmodel Emily Ratajkowski verscheen in een Versace-jurk die in 1992 de catwalk sierde. Een duurzaam statement kwam ook van zangeres Billie Eilish met haar Victoriaans ogende jurk van Gucci, gemaakt van stoffen die het modehuis eerder gebruikte of over had."
                                            }
