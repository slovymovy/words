                "senses": [
                    {
                        "sense_id": "e1b2f27f-7a57-3c2c-98b6-759c98027eda",
                        "entry_id": "b223276f-bb2a-3c09-bd45-ab8b6125a39b",
                        "glosses": [
                            "十二進法の。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5495ea-949b-41c5-9c23-d3fc281ff682",
                                "sense_id": "e1b2f27f-7a57-3c2c-98b6-759c98027eda",
                                "text": "The duodecimal number 26 is equivalent to thirty, or the decimal 30.",
                                "translation": "十二進法の26は三十、つまり十進法の30に相当する。"
                            },
                            {
                                "example_id": "31b87b1d-2837-431a-8740-dd75d170553e",
                                "sense_id": "e1b2f27f-7a57-3c2c-98b6-759c98027eda",
                                "text": "The decimal 3/144 is written as 3/100 in the duodecimal fraction system.",
                                "translation": "十進法の3/144は、十二進法の分数では3/100と表記される。"
                            },
                            {
                                "example_id": "7f76c71b-dcfd-43ee-9699-de2af3739c9a",
                                "sense_id": "e1b2f27f-7a57-3c2c-98b6-759c98027eda",
                                "text": "The decimal \"21 years and 10 months\" can be expressed as the duodecimal \"19 years and A months\"; or \"19A months\", equivalent to the decimal \"262 months\".",
                                "translation": "十進法の「21年10ヶ月」は、十二進法で「19年Aヶ月」、あるいは「19Aヶ月」として表せる。後者は十進法の「262ヶ月」に相当する。"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
