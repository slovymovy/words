                "senses": [
                    {
                        "sense_id": "1f011aaf-00c3-385c-8104-553b35f67372",
                        "entry_id": "4ca032e0-2677-3340-a174-c4d307a962a2",
                        "glosses": [
                            "Vorrichtung zur Luftbehandlung in Anlagen oder zum Schadstoffabbau in beaufschlagenden Räumen; Ionisator"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fb05aac-a3e8-4b8d-8e55-9afb340742cc",
                                "sense_id": "1f011aaf-00c3-385c-8104-553b35f67372",
                                "text": "„ Ionisierungsvorrichtung für Luftbehandlungsanlagen mit zwei Elektroden, die mit einer eine Wechselspannung erzeugenden Hochspannungsquelle verbindbar sind “"
                            },
                            {
                                "example_id": "87dfd4e3-e51e-45cd-a5cc-15652f9cd0f4",
                                "sense_id": "1f011aaf-00c3-385c-8104-553b35f67372",
                                "text": "„Erfindungsgemäß ist vorgesehen, dass ein Behälter […] als integrierte Ionisierungseinrichtung und einer Ionisierungsvorrichtung bereitgestellt wird.“"
                            },
                            {
                                "example_id": "6f795d8a-6da9-4c3d-b584-56b037a02999",
                                "sense_id": "1f011aaf-00c3-385c-8104-553b35f67372",
                                "text": "„Verfahren zur Ansteuerung einer Ionisierungsvorrichtung (7), insbesondere einer Ionisierungsvorrichtung (7) zur Ionisierung von Luft (L) zur Belüftung von Innenräumen (5), bevorzugt von Kraftfahrzeuginnenräumen (5), wobei die Ionisierungsvorrichtung (7) zumindest zeitweise (14) Ionen (8) eines ersten Ionentyps (8) freisetzt, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
