                "senses": [
                    {
                        "sense_id": "3b7fb0f0-cc80-32f9-9b11-3f6acd606636",
                        "entry_id": "31c048ca-09df-34f2-ab52-5de6ac61a949",
                        "glosses": [
                            "Tout procédé qui permet à un énonciateur d’exprimer un sentiment ou une appréciation sur ce dont il parle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af056d11-2b5e-437a-bc56-ae56cd265612",
                                "sense_id": "3b7fb0f0-cc80-32f9-9b11-3f6acd606636",
                                "text": "la modalisation étant définie comme l’opération énonciative qui consiste à affecter une ou plusieurs modalité(s) à l’énoncé. … Il reste que les opérations de modalisation sont constantes dans les activités langagières et qu’elles peuvent être réalisées par des moyens non verbaux."
                            },
                            {
                                "example_id": "cc711da8-d219-4873-9d9a-a439bd7ead86",
                                "sense_id": "3b7fb0f0-cc80-32f9-9b11-3f6acd606636",
                                "text": "La modalisation est le fait d’introduire de la subjectivité dans ce que l’on dit, en faisant part d’un sentiment de doute ou de certitude, d’un jugement de valeur, etc."
                            },
                            {
                                "example_id": "dbae6f37-f620-42c4-9ccf-0131b5b42717",
                                "sense_id": "3b7fb0f0-cc80-32f9-9b11-3f6acd606636",
                                "text": "- \"Qu’on peut envisager\" : utilisation d’un verbe de modalisation, cela signifie que la prise de décision demeure hypothétique."
                            }
                        ]
                    }
                ],
