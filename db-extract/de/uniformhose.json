                ],
                "senses": [
                    {
                        "sense_id": "4cd54efa-533d-3ae7-a0fd-21dfb91bf98b",
                        "entry_id": "98a8f725-5570-39bc-8b67-e647a35723ce",
                        "glosses": [
                            "Hose, die Bestandteil einer Uniform ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1df0572-5639-4275-a35f-680377cd56b2",
                                "sense_id": "4cd54efa-533d-3ae7-a0fd-21dfb91bf98b",
                                "text": "„Ein Beispiel von vielen: Aus der Uniformhose eines amerikanischen Soldaten schneiderte Maria Wekerle 1946 die Bärin ‚Brummhilde‘ für ihre Tochter Traudl, die ein Jahr zuvor zur Welt gekommen war.“"
                            },
                            {
                                "example_id": "8e2ccd7b-dc83-42d9-9e7b-5c50ae602671",
                                "sense_id": "4cd54efa-533d-3ae7-a0fd-21dfb91bf98b",
                                "text": "„Es geht um eine Uniformhose im Wert von 60 Franken und – was einschneidender ist – ein Imbusschlüsselset sowie einen Generalschlüssel.“"
                            },
                            {
                                "example_id": "d3f8a8b5-b733-4f5c-a1f7-db50f70408b9",
                                "sense_id": "4cd54efa-533d-3ae7-a0fd-21dfb91bf98b",
                                "text": "„Einer Aufstellung, die kürzlich dem Ausschuss des amerikanischen Repräsentantenhauses vorgelegt wurde, ist zu entnehmen, dass die amerikanische Armee 666000 Dollar, also über zweieinhalb Millionen DM, allein durch den kühnen Entschluss eingespart hat, an den Uniformhosen keine Uhrentäschchen mehr anzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
