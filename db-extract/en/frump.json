                                "target_senses": [
                                    {
                                        "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                        "entry_id": "fcb529e5-6c67-3032-9d12-cea3332f04cd",
                                        "glosses": [
                                            "oblečení"
                                        ],
                                        "tags": [
                                            "multiplicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d8019d-a55e-45ed-935c-cde738ed33a1",
                                                "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                                "text": "Vybírám kus od kusu. Něco může být 'vintaged' a 'funky', ale zbytek jsou staromódní hadry."
                                            },
                                            {
                                                "example_id": "b527504e-9179-42ff-9649-f57a3d531e8a",
                                                "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                                "text": "Hadry, které měla na sobě, byly staré, špinavé, propocené, nicméně tělo, které halily, zcela jistě patřilo dobře živené, zdravé dívce."
                                            },
                                            {
                                                "example_id": "d3a10852-7a9d-4630-a880-70014429ae9f",
                                                "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                                "text": "Takže chlap si chce užít, na holku v ten moment přijdou krámy, chlápek má utrum, zbije holku na srágoru, lohne jí šaty a hadry a vezme roha,\" rekapituluje si to Kaoru."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef4c5323-e9d3-30ee-9a90-378757a1e95c",
                                        "entry_id": "fcb529e5-6c67-3032-9d12-cea3332f04cd",
                                        "glosses": [
                                            "hadrářská nemoc (nemoc vznikající při třídění hadrů)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
