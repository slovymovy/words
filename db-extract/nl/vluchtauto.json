                        "examples": [
                            {
                                "example_id": "31ccd102-fdc6-4b2a-a0a7-748f1b93cee0",
                                "sense_id": "77f0767d-8f8c-3086-a103-d3a8feb2a410",
                                "text": "Onderzoeker Jelle van Buuren, van het Haagse Centrum voor Terrorisme en Contraterrorisme, acht het goed mogelijk dat Amri inderdaad de dader is. Van Buuren wijst erop dat in de vluchtauto van de aanslagplegers op het kantoor van het Franse satirische tijdschrift Charlie Hebdo ook ID-papieren van een dader werden gevonden. „We onderschatten soms hoe chaotisch zo’n aanslag kan verlopen. Er zou sprake zijn geweest van een vechtpartij met de Poolse chauffeur, waarbij het ID-bewijs kan zijn gevallen”, zegt Van Buuren. Hij wijst erop dat de dader die papieren mogelijk bij zich had om door politiecontroles te komen."
                            }
                        ]
