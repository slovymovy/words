                    {
                        "translation_id": "e6eeb354-d0d9-4707-85b3-13ebcf3e8bd1",
                        "source_entry_id": "47e8db9f-f0e0-3780-b30d-5633fbd06ba6",
                        "source_sense_id": "a0a30df6-0d4d-360f-bedb-972ab7cc226a",
                        "source_sense_description": "een kamer waar maaltijden worden genuttigd",
                        "target_lang_word": "Esszimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esszimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9befe4c-c9f1-3859-89ae-65b161d4ad90",
                                        "entry_id": "1aa64261-d7b8-3771-9b31-29c9a8ab15ca",
                                        "glosses": [
                                            "Zimmer, das als Aufenthaltsort während der Einnahme von Mahlzeiten dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3643572-77e8-4da0-9233-26e32b1fbef5",
                                                "sense_id": "f9befe4c-c9f1-3859-89ae-65b161d4ad90",
                                                "text": "Der Tisch in unserem Esszimmer ist fast immer übersät mit Büchern und Aktenordnern."
                                            },
                                            {
                                                "example_id": "c77cc7a6-1729-4a68-82fc-47506403db69",
                                                "sense_id": "f9befe4c-c9f1-3859-89ae-65b161d4ad90",
                                                "text": "„Am nächsten Tag um elf empfing mich ein opulentes Frühstück im Esszimmer der Pension.“"
                                            },
                                            {
                                                "example_id": "79c20acc-11eb-40f2-87e8-326e9a16e8b5",
                                                "sense_id": "f9befe4c-c9f1-3859-89ae-65b161d4ad90",
                                                "text": "„Von einer großzügigen Eingangshalle mit gewundener Treppe gelangt man in ein knappes Dutzend Räume, darunter ein Salon, ein Esszimmer, ein Raucherzimmer, ein Arbeitszimmer plus Bibliothek und im Obergeschoss mindestens fünf Schlafräume.“"
                                            },
                                            {
                                                "example_id": "4eba991c-3d4e-4c80-8042-903e420c8693",
                                                "sense_id": "f9befe4c-c9f1-3859-89ae-65b161d4ad90",
                                                "text": "„In einem spießbürgerlich möblierten Esszimmer servierte man ihr Avocados, an den Wänden hingen Lithografien mit englischen Landschaften.“"
                                            },
                                            {
                                                "example_id": "e12d44be-5c3f-4c96-a72c-e32ece667a05",
                                                "sense_id": "f9befe4c-c9f1-3859-89ae-65b161d4ad90",
                                                "text": "„Das Esszimmer war im Parterre, das weiß ich, auch der Salon, in der ersten Etage die Bibliothek und Steins Arbeitszimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d98fcbbd-dbc6-34c6-8a5e-7004d5ad8d9a",
                                        "entry_id": "1aa64261-d7b8-3771-9b31-29c9a8ab15ca",
                                        "glosses": [
                                            "Einrichtung für ein Esszimmer^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fdbcf078-78a3-3be7-a9a7-b819ccf9130c",
                                        "entry_id": "1aa64261-d7b8-3771-9b31-29c9a8ab15ca",
                                        "glosses": [
                                            "Mund"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5f6ef1-bd85-41cb-90d5-07cb78e8baf9",
                        "source_entry_id": "47e8db9f-f0e0-3780-b30d-5633fbd06ba6",
                        "source_sense_id": "a0a30df6-0d4d-360f-bedb-972ab7cc226a",
