                        "glosses": [
                            "een getal waarmee een pagina geïdentificeerd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d648b08a-dd9b-472a-8afc-bf7713456c03",
                                "sense_id": "1f9f6754-9a95-338b-a324-3c469d450c81",
                                "text": "De blaadjes met de bankafschriften hebben geen paginanummer! Alle andere vellen in het dossier wel."
                            },
                            {
                                "example_id": "9e4e28cf-cff8-4692-8f56-55596f345c61",
                                "sense_id": "1f9f6754-9a95-338b-a324-3c469d450c81",
                                "text": "Hij zegt in de eerste jaren van het medium ook wel eens een paar seconden een persoonlijke boodschap op de pagina's te hebben gezet. \"Dan was mijn vader jarig en dan zette ik een felicitatie op een pagina die niet werd gebruikt. Dan belde ik hem op en zei tegen hem welke pagina hij moest intoetsen. Als hij hem dan gevonden had, haalde ik de pagina gauw weg. Dan kon niemand die meer oproepen, maar mijn vader had hem dan wel op zijn eigen tv staan. Net zolang tot hij een ander paginanummer intoetste of de tv uitschakelde.\""
                            }
                        ]
                    }
