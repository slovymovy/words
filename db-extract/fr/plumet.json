                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ba191eb-36aa-30a6-8d54-c49b29512cb1",
                                        "entry_id": "786ae6dc-ea35-3f20-b574-133ce50d04aa",
                                        "glosses": [
                                            "A plate with rows of pointed needles used to blend or straighten hair."
                                        ],
