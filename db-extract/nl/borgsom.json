                                    {
                                        "sense_id": "4d16b774-41e9-30fe-bbaf-b11cade97795",
                                        "entry_id": "6fb58263-70ce-3415-9486-420e78c42c98",
                                        "glosses": [
                                            "To hand over personal property to be held temporarily by another as a bailment."
