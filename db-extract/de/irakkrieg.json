                "senses": [
                    {
                        "sense_id": "2d1021f1-8bc5-3d6f-880b-d2db822b3805",
                        "entry_id": "23fc352c-ee15-3c35-b788-0ca2b900756b",
                        "glosses": [
                            "ein Krieg im oder um den Irak, Invasion des Irak durch die Streitkräfte der Vereinigten Staaten und anderer, die vom 20. März bis zum 1. Mai 2003 dauerte"
                        ],
                        "tags": [
                            "insbesondere (Zweiter Irakkrieg oder Dritter Golfkrieg)"
                        ],
                        "examples": [
                            {
                                "example_id": "a348a41a-5499-4645-b71c-a28ec86a7dc6",
                                "sense_id": "2d1021f1-8bc5-3d6f-880b-d2db822b3805",
                                "text": "„Als Begründung für den Irakkrieg 2003 gab die angreifende ‚Koalition der Willigen‘ unter der Führung der USA vor allem eine akute Bedrohung durch Massenvernichtungsmittel seitens des irakischen Diktators Saddam Hussein an. Diese und weitere Begründungen waren vor dem Irakkrieg stark umstritten.“"
                            },
                            {
                                "example_id": "b65a95cd-703d-4cb1-a6a3-e1ead65c21cf",
                                "sense_id": "2d1021f1-8bc5-3d6f-880b-d2db822b3805",
                                "text": "„Dann kam der zweite Irakkrieg, und ich dachte: Jetzt aber, jetzt zeigen die Deutschen, was sie können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
