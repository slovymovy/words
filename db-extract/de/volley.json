            {
                "entry_id": "d3d71665-ad0c-3969-adf5-23434b82083b",
                "word": "volley",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                        "entry_id": "d3d71665-ad0c-3969-adf5-23434b82083b",
                        "glosses": [
                            "aus der Luft (angenommen und direkt kraftvoll abgespielt), ohne dass eine Bodenberührung des Sportgeräts vorher stattgefunden hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2758e369-ae05-4eba-be79-6a817b8ed951",
                                "sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                                "text": "„Nach einer Ecke hatte ich als Mittelstürmer den Ball erwischt und ihn volley ins Netz geschossen.“"
                            },
                            {
                                "example_id": "2c2dce7e-6689-4fec-8aed-5e3637b689ba",
                                "sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                                "text": "„Rivolta, der Linksaußen, erwischt den aufhüpfenden Ball. Dicht vor Heiner Stuhlfauth jagt der ihn ‚volley‘ auf die linke Ecke, wie aus einem Rohr abgefeuert, peitscht er voran.“"
                            },
                            {
                                "example_id": "224fb17a-69dc-4710-8fa4-ebfdad844fbd",
                                "sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                                "text": "„In Sport spielten wir Sitzfußball, und mir gelang ein Torschuß, volley und unhaltbar, den ich abends im Hobbyraum nachspielte.“"
                            },
                            {
                                "example_id": "de088f20-9d02-4f6b-8cce-26b9e6c6b9df",
                                "sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                                "text": "„Nachdem Sinan Akdag abgezogen hatte, nahm der Kanadier den Puck volley und netzte drei Sekunden vor der Sirene zum 2:2 ein.“"
                            },
                            {
                                "example_id": "a34bf813-e7ee-4ad9-9975-31c150a22325",
                                "sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                                "text": "„Es wird im Doppel und Mixed gespielt, Einzel fast nie. Der Ball darf nicht auftippen, sondern muss volley gespielt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5338c7d-68c2-4c3c-9abe-0f03547af969",
                        "source_entry_id": "d3d71665-ad0c-3969-adf5-23434b82083b",
                        "source_sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                        "source_sense_description": "aus der Luft angenommen und abgespielt, ohne vorherige Bodenberührung des Sportgeräts",
                        "target_lang_word": "at the volley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf7ea636-8749-4927-8394-c945c6de213b",
                        "source_entry_id": "d3d71665-ad0c-3969-adf5-23434b82083b",
                        "source_sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                        "source_sense_description": "aus der Luft angenommen und abgespielt, ohne vorherige Bodenberührung des Sportgeräts",
                        "target_lang_word": "on the volley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a8bb8fc3-1233-48a7-8223-054e49596cb2",
                        "source_entry_id": "d3d71665-ad0c-3969-adf5-23434b82083b",
                        "source_sense_id": "29b69137-d3d3-3b2d-b81c-eb4c4f242e42",
                        "source_sense_description": "aus der Luft angenommen und abgespielt, ohne vorherige Bodenberührung des Sportgeräts",
                        "target_lang_word": "à la volée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la volée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a765afff-cb4e-39e9-b6d8-ccdf075928c3",
                                        "entry_id": "dd29c859-8ec7-3ea5-afba-4cd9ab032e83",
                                        "glosses": [
                                            "En l’air, au vol, durant le vol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644e9683-e46d-4d7d-a980-9978ae258e15",
                                                "sense_id": "a765afff-cb4e-39e9-b6d8-ccdf075928c3",
                                                "text": "Cette vieille femme semble tenir à ce gosse comme à la prunelle de ses yeux. Mais elle a bien du mal à le défendre quand il s’agit de batailler pour accéder à la nourriture jetée à la volée par les soldats du fort, un peu comme du grain dans un poulailler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c6f9bf-28db-310c-bd2f-9105529be006",
                                        "entry_id": "dd29c859-8ec7-3ea5-afba-4cd9ab032e83",
                                        "glosses": [
                                            "Rapidement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4dd2b39-506d-46c2-a354-3deddbd00408",
                                                "sense_id": "90c6f9bf-28db-310c-bd2f-9105529be006",
                                                "text": "Tout ce qu'elle arrivait à savoir aurait pu stupéfier à aussi bon droit que l'état avancé de certaines connaissances chez les anciens, vu les moyens presque nuls d'information qu'ils possédaient (les siens n'étaient pas plus nombreux ; c'était quelques propos, formant à peine le vingtième de notre conversation à dîner, recueillis à la volée par le maître d'hôtel et inexactement transmis à l'office)."
                                            },
                                            {
                                                "example_id": "a52a3034-94a6-48e3-9432-718639a4dd9b",
                                                "sense_id": "90c6f9bf-28db-310c-bd2f-9105529be006",
                                                "text": "A ce moment, la porte s’ouvrit à la volée et Nicolas surgit, brusque et rieur. Il avait toujours l’air de monter à l’abordage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da88d68-c642-3691-8903-dfc49b25211d",
                                        "entry_id": "dd29c859-8ec7-3ea5-afba-4cd9ab032e83",
                                        "glosses": [
                                            "En une seule fois ; en un seul passage ; au fur et à mesure."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab0d2dea-4373-4ee5-b8e2-0d4d1aad101f",
                                                "sense_id": "8da88d68-c642-3691-8903-dfc49b25211d",
                                                "text": "Le patron sert des cafés à la volée. Face à lui, deux, puis trois, puis quatre clients s’assoient au comptoir, enserrant leur tasse pour réchauffer des doigts parfois bien engourdis."
                                            },
                                            {
                                                "example_id": "73d195c3-dd1b-4a5f-91b4-67b7fbd23e6f",
                                                "sense_id": "8da88d68-c642-3691-8903-dfc49b25211d",
                                                "text": "Un interprète traduit un discours à la volée, sans en attendre la fin pour commencer, alors qu’un traducteur agit avec plus de recul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f9f1a8-3176-35b8-a2b6-927a1383a1fa",
                                        "entry_id": "dd29c859-8ec7-3ea5-afba-4cd9ab032e83",
                                        "glosses": [
                                            "Inconsidérément, étourdiment, sans réflexion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa4f0603-9edb-486b-a9c1-d98a37fe5ad2",
                                                "sense_id": "d4f9f1a8-3176-35b8-a2b6-927a1383a1fa",
                                                "text": "Abraham se retrouva au centre du laager, envoyant sa sagaie à la volée, sans discernement. La rage et l’instinct de survie animaient son bras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af5fcd7d-8ffc-3319-802b-69296cd60659",
                                        "entry_id": "dd29c859-8ec7-3ea5-afba-4cd9ab032e83",
                                        "glosses": [
                                            "En continu, en parlant des cloches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea3508b-1abb-40f4-ad37-1b0c6e626ef9",
                                                "sense_id": "af5fcd7d-8ffc-3319-802b-69296cd60659",
                                                "text": "La cloche de l’Angélus sonne, puis la grosse cloche tinte six fois pour un homme, quatre fois seulement pour une femme, suivie de nouveau d’une nouvelle sonnerie à la volée de la cloche de l’Angélus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
