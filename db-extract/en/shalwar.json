                    },
                    {
                        "translation_id": "8fbf5887-4a20-4b46-bfb5-013867851882",
                        "source_entry_id": "10a96898-a268-3a9f-9177-beb45dfbf7d2",
                        "source_sense_id": "16abd939-6c17-344d-b21e-353c263c8f22",
                        "source_sense_description": "garment",
                        "target_lang_word": "шарова́ры",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шарова́ры",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1baf2b9-030c-31a8-9945-40f55d85d11b",
                                        "entry_id": "ffaec06f-a56f-3f95-872a-cf987de28510",
                                        "glosses": [
                                            "широкие штаны особого покроя, обычно заправляемые в сапоги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49e5aee-40f0-46d0-9002-aaac24dfc94f",
                                                "sense_id": "c1baf2b9-030c-31a8-9945-40f55d85d11b",
                                                "text": "Он был в красной рубахе, в киргизском халате и в казацких шароварах."
                                            },
                                            {
                                                "example_id": "3873191e-99c9-422f-b3cd-51673d7a8bc8",
                                                "sense_id": "c1baf2b9-030c-31a8-9945-40f55d85d11b",
                                                "text": "Этот человек ходил и зиму и лето в желтоватом нанковом кафтане немецкого покроя, но подпоясывался кушаком; носил синие шаровары и шапку со смушками, подаренную ему, в весёлый час, разорившимся помещиком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c229d8c7-e06a-363e-835c-73786d4a6bf7",
