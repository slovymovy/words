                                "target_senses": [
                                    {
                                        "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                        "entry_id": "29fc594e-b901-3af1-9524-746c0799ed8e",
                                        "glosses": [
                                            "Of, or pertaining to an organism whose genome has been changed by the addition of a gene from another species; (of an organism) whose genome has been changed by such addition, genetically modified."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "befe3467-4372-43d9-89a3-35d01ff51b82",
                                                "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                                "text": "The third type are human transgenic embryos, made by injecting a segment of animal DNA into a human egg."
                                            },
                                            {
                                                "example_id": "385d57bb-8594-454c-b65f-b13d3c91746b",
                                                "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                                "text": "Common ingredients like corn, vegetable oil, maltodextrin, soy protein, lecithin, monosodium glutamate, cornstarch, yeast extract, sugar and corn syrup are almost always produced from transgenic crops."
                                            }
                                        ]
                                    }
                                ]
                            },
