                        "glosses": [
                            "Qui a des attitudes de statue ; qui a un port de statue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6dd60ff-be8d-41d5-815b-46dd02e9e7b5",
                                "sense_id": "3457b817-f364-3cb2-b078-55c6398204ee",
                                "text": "Mais j’ai été pris par cet air de froide et statuesque tranquillité."
                            },
                            {
                                "example_id": "774785f7-4b5f-4b61-ab54-ac36e46df3ff",
                                "sense_id": "3457b817-f364-3cb2-b078-55c6398204ee",
                                "text": "Il y avait Pleure-moi une rivière qu’avait chanté avec fièvre la voluptueuse et statuesque Julie London."
                            },
                            {
                                "example_id": "6a8d0bdc-4898-43b4-a902-96f5189af558",
                                "sense_id": "3457b817-f364-3cb2-b078-55c6398204ee",
                                "text": "Une femme Kling admirablement drapée, glissant sur le chemin avec une aisance parfaite dans sa beauté statuesque, soutenant de sa belle main et de son bras admirablement modelé une amphore posée sur sa petite tête, est vraiment un bel objet classique dans sa forme, exquis dans ses mouvements, d’un coloris artistique, une création du soleil tropical."
                            }
                        ]
                    }
                ],
