                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83b60bbe-4391-4fd3-a16b-0a7b5d2e64e3",
                        "source_entry_id": "47bdb431-9791-3e20-b445-7e1835c74c44",
                        "source_sense_id": "c4c2e673-5da0-3039-90f6-c8fd7f5f4f49",
                        "target_lang_word": "belle-sœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belle-sœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91520b1a-5fb8-3c6c-afc3-1383a4e940f4",
                                        "entry_id": "d140b5a0-83fb-3809-94b9-5a3c47268c8a",
                                        "glosses": [
                                            "Sœur du conjoint ou de la conjointe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528b0747-2349-4525-8154-6bac87e031d1",
                                                "sense_id": "91520b1a-5fb8-3c6c-afc3-1383a4e940f4",
                                                "text": "Le duc de Guise reconduisit sa belle-sœur, la duchesse de Nevers, en son hôtel qui était situé rue du Chaume, en face de la rue de Brac, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8879e161-1ffa-368f-b7fa-1eb784773e69",
                                        "entry_id": "d140b5a0-83fb-3809-94b9-5a3c47268c8a",
                                        "glosses": [
                                            "Épouse du frère ou de la sœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e1e093-1f75-4722-a42e-c28fe0bb6bbf",
                                                "sense_id": "8879e161-1ffa-368f-b7fa-1eb784773e69",
                                                "text": "— Il me semble cependant, dit lord de Winter, que s’il y a quelque mesure à prendre contre la comtesse, cela me regarde ; c’est ma belle-sœur."
                                            },
                                            {
                                                "example_id": "7ea81f45-1635-4ac6-b932-41fb864971fb",
                                                "sense_id": "8879e161-1ffa-368f-b7fa-1eb784773e69",
                                                "text": "Il dut quitter le salon jaune, après avoir montré le poing à sa belle-sœur, en la traitant de vieille gueuse et en la menaçant de revenir bientôt."
                                            },
                                            {
                                                "example_id": "8a26deb4-bc75-417b-b253-f074e811d306",
                                                "sense_id": "8879e161-1ffa-368f-b7fa-1eb784773e69",
                                                "text": "Un nommé Jean Imbert, de Clerlande (Puy-de-Dôme), soldat libéré du 134ᵉ de ligne avait rapporté chez lui trois cartouches Lebel, qu’il avait probablement dérobées au tir. Il en donna une à son frère; mais sa belle-sœur, qui lui voulait du mal, est allé le dénoncer ; Jean Imbert a été arrêté et mis à la disposition de la justice militaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03e50fa3-f746-36ca-aa9a-8da8838691de",
                                        "entry_id": "d140b5a0-83fb-3809-94b9-5a3c47268c8a",
                                        "glosses": [
                                            "Tout parent féminin en liaison généalogique par une séquence quelconque de liens de fraternité et d’alliance, comme par exemple la conjointe du beau-frère, ou de la belle-sœur, c’est-à-dire l’épouse du frère ou de la sœur du conjoint."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0f7338-f954-4be1-b420-0ad4d0929781",
                                                "sense_id": "03e50fa3-f746-36ca-aa9a-8da8838691de",
                                                "text": "Antoine et ma belle-sœur jouaient bien leur jeu ; ils se montraient, à mon égard, pitoyables, ils ne procédaient que par des allusions contristées. J'étais presque leur dupe, mais non pas entièrement !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8afb90a-aa47-4bd6-889b-0de738a302ab",
                        "source_entry_id": "47bdb431-9791-3e20-b445-7e1835c74c44",
