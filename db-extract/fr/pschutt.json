                            {
                                "example_id": "ab9301e7-6d67-41e8-9d41-94fe936d4585",
                                "sense_id": "2a5a5504-cc31-3343-bbf0-52dfe98d88d4",
                                "text": "Elle [la maison] avait un pschutt énorme, comme dit aussitôt Lalie en parcourant le salon …"
                            },
                            {
                                "example_id": "50127080-0f79-45a7-8b61-9ebb18bbcdeb",
                                "sense_id": "2a5a5504-cc31-3343-bbf0-52dfe98d88d4",
                                "text": "Le murmure bienveillant des salons mondains où tant de riches héritières juives, devenues duchesses ou marquises, donnaient le ton, décidaient du pschutt et du vlan."
                            }
                        ]
                    },
                    {
