                        ]
                    },
                    {
                        "translation_id": "6686d1b7-642e-4c2a-8df8-51298a49e89e",
                        "source_entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
                        "source_sense_description": "Paeonia genus of flowering plants",
                        "target_lang_word": "pioenroos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pioenroos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                                        "entry_id": "c25cf24d-3876-311e-9184-9ffe67da4526",
                                        "glosses": [
                                            "Paeonia lactiflora vaste tuinplant met grote purperrode bloemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c07a447-6dff-4d20-8a70-ba84583cefde",
                                                "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                                                "text": "Scheerder vertelt dat er al decennia onderzoek naar wordt gedaan, maar dat wordt niet heel goed gecommuniceerd. Zo blijken mensen die lavendel ruiken, eerder geneigd geld met elkaar te delen. En rood en geel geven hoop, dat is zo overduidelijk dat de pioenroos en de zonnebloem al buiten onderzoek worden gehouden."
                                            },
                                            {
                                                "example_id": "df5fd4d4-7abf-4bb9-a83f-0d307cb17642",
                                                "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                                                "text": "De Wogmeer is 680 hectare groot. Het meeste land wordt gebruikt voor bloembollenteelt, akkerbouw en voedselwinning ten behoeve van de veeteelt. Vooral de pioenroos doet het hier fantastisch gezien de vele kwekerijen."
                                            },
                                            {
                                                "example_id": "bd661fb1-813c-4155-b5ae-617eb4b1dd7a",
                                                "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                                                "text": "PostNL heeft ter gelegenheid van het 25 jubileum van Janneke, wier tekeningen al jaren de postzegels ten bate van het Nationaal Ouderenfonds sieren, een zilveren postzegel met een pioenroos uitgebracht. „Daar ben ik heel blij mee”, aldus de kunstenares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c9438d7-e911-454f-91c7-dc5d8b458cf5",
                        "source_entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
                        "source_sense_description": "Paeonia genus of flowering plants",
                        "target_lang_word": "pivoine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pivoine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e40eedc4-9b4a-37c7-aa6f-90821058b8a4",
                                        "entry_id": "c3256ab6-588e-34bc-ad92-0c097d275134",
                                        "glosses": [
                                            "Plante de la famille des Renonculacées, à grosses fleurs rouges, panachées ou blanches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81fa11e-4302-428e-9712-88fb6080c22b",
                                                "sense_id": "e40eedc4-9b4a-37c7-aa6f-90821058b8a4",
                                                "text": "La Cétoine dorée ou Émeraudine de Geoffroy est très commune; à l'état parfait, elle est essentiellement floricole, elle fréquente depuis la fin de mai jusqu'au commencement de l'automne, dans les champs, les fleurs des Ombellifères et des Chardons, et dans les jardins, les Roses, les Pivoines et les Lilas."
                                            },
                                            {
                                                "example_id": "9881b4a3-d5a2-4504-8e4e-88f2169d16f8",
                                                "sense_id": "e40eedc4-9b4a-37c7-aa6f-90821058b8a4",
                                                "text": "La pivoine, sanguine en son premier mois, pousse d’un tel jet que ses hampes, ses feuilles à peine dépliées traversent, emportent et suspendent dans l’air leur suprême croûte de terre comme un toit crevé."
                                            },
                                            {
                                                "example_id": "38ba4d4b-f287-4abd-8f7c-0f764674efd5",
                                                "sense_id": "e40eedc4-9b4a-37c7-aa6f-90821058b8a4",
                                                "text": "Mais la pivoine vous attend toujours au détour d’un buisson, et l’on risque aussitôt l’outrage aux bonnes mœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a48f4775-10b0-32d8-ac49-904e0a18813a",
                                        "entry_id": "c3256ab6-588e-34bc-ad92-0c097d275134",
                                        "glosses": [
                                            "En rapport avec la couleur de la plante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b147169-bc11-42d8-a004-cc57d2439e34",
                                                "sense_id": "a48f4775-10b0-32d8-ac49-904e0a18813a",
                                                "text": "Il est devenu rouge comme une pivoine, Il a fortement rougi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e6eee8f-be8a-43e7-8e22-576d910f70a8",
                        "source_entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
                        "source_sense_description": "Paeonia genus of flowering plants",
                        "target_lang_word": "Pfingstrose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfingstrose",
                                "target_lang_code": "de",
