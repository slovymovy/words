                    },
                    {
                        "sense_id": "2917ea41-1e1f-3495-a891-743e8a7d0139",
                        "entry_id": "83a92404-31e2-3c3e-8bcd-2a28e87cf997",
                        "glosses": [
                            "Non affilié à une organisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "424b6575-370c-4c16-9a7b-3e10c0d6c747",
                                "sense_id": "2917ea41-1e1f-3495-a891-743e8a7d0139",
                                "text": "Sous peine de déchaîner, dans des masses inorganisées, une xénophobie et une anarchie dangereuses pour tout l’univers."
                            }
                        ]
                    }
