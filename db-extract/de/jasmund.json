                "senses": [
                    {
                        "sense_id": "06f37762-456d-3410-b253-6a31caa3f9c6",
                        "entry_id": "e2bc4b8b-8c12-396a-9adf-2c9b4a11fdeb",
                        "glosses": [
                            "Halbinsel im Nordosten von Rügen in Deutschland"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "e60c8e13-61b1-4c67-800b-54daeb948e9f",
                                "sense_id": "06f37762-456d-3410-b253-6a31caa3f9c6",
                                "text": "„An ganz wenigen Orten erlebt man den Frühsommer so spektakulär wie auf der Halbinsel Jasmund auf Rügen.“"
                            },
                            {
                                "example_id": "d3db0684-9f4f-485d-b5c1-c889571705db",
                                "sense_id": "06f37762-456d-3410-b253-6a31caa3f9c6",
                                "text": "„Im oberen Bereich ist die Halbinsel Jasmund zu erkennen, durch die die Nehrung Schmale Heide mit der Kerninsel verbunden.“"
                            },
                            {
                                "example_id": "3aa108bc-fa82-4778-a97a-27d2a364ef44",
                                "sense_id": "06f37762-456d-3410-b253-6a31caa3f9c6",
                                "text": "„Wir schnüren dazu unsere Wanderstiefel, packen die Regenjacke ein und begeben uns auf die Halbinsel Jasmund im Nordosten von Rügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ecf8990-07ea-31a4-94fe-c1f9b10c99f6",
                        "entry_id": "e2bc4b8b-8c12-396a-9adf-2c9b4a11fdeb",
                        "glosses": [
                            "Nationalpark im Nordosten von Rügen in Deutschland"
                        ],
                        "tags": [
                            "Naturschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "8ab8a481-d73d-48cb-8eca-19cf55a58384",
                                "sense_id": "3ecf8990-07ea-31a4-94fe-c1f9b10c99f6",
                                "text": "„Am kleinsten ist der Nationalpark Jasmund auf der Ostsee-Insel Rügen mit 30 Quadratkilometern. “"
                            },
                            {
                                "example_id": "2035c817-d135-490d-80b6-66b636a8e631",
                                "sense_id": "3ecf8990-07ea-31a4-94fe-c1f9b10c99f6",
                                "text": "„Wie das Umweltministerium Mecklenburg-Vorpommerns am Mittwoch mitteilte, brachte eine Gen-Probe in Folge eines Wildtierrisses im Nationalpark Jasmund den Beweis.“"
                            },
                            {
                                "example_id": "6e37bdcd-8ec7-4340-bd2b-3191a677130e",
                                "sense_id": "3ecf8990-07ea-31a4-94fe-c1f9b10c99f6",
                                "text": "„Vom Nationalpark Jasmund ist es gar nicht weit bis nach Sassnitz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
