                                    {
                                        "sense_id": "dc3bed40-e77d-3aca-88b5-2065a32d9688",
                                        "entry_id": "23851150-3355-346c-addc-c54a596e909a",
                                        "glosses": [
                                            "A dish of sautéed pieces of beef (or a substitute) served in a sauce with sour cream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b747b8-ae67-461c-98a6-e6ae6548d1c4",
                                                "sense_id": "dc3bed40-e77d-3aca-88b5-2065a32d9688",
                                                "text": "With its creamy texture and unique taste, our version is certain to win over even the most diehard stroganoff fans."
                                            },
                                            {
                                                "example_id": "96464d35-0a7f-42fe-9c58-584b6b67ea8c",
                                                "sense_id": "dc3bed40-e77d-3aca-88b5-2065a32d9688",
                                                "text": "For an unusual kidney stroganoff, saute them in a casserole with chopped onions, celery and carrot, then stew in wine, beer, cider or stock till tender, and stir in a little cream before serving."
                                            }
                                        ]
                                    }
                                ]
