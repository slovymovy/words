                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "86ddd392-9b48-40a2-9a0a-869a74f0de2b",
                        "source_entry_id": "2b18c160-b435-33a5-b3f8-719ee4cd5bbd",
