                        "translation_id": "cbd087ad-3c3d-4b06-bc4a-9b8932470e94",
                        "source_entry_id": "00203a1c-fee1-3303-869a-32c33d110754",
                        "source_sense_id": "b2ca7e13-fc8e-31f4-849d-314edcc26cb9",
                        "source_sense_description": "Literatur: Vertreter des Akmeismus",
                        "target_lang_word": "Acmeist",
