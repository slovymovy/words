                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "Римский император Септимий <w>Север</w> правил в конце второго века.",
                            "target_lang_translations": {
                                "de": "Der römische Kaiser Septimius <w>Severus</w> regierte Ende des zweiten Jahrhunderts."
                            }
                        },
                        {
                            "text": "Историк изучал биографию правителей из династии <w>Северов</w>.",
