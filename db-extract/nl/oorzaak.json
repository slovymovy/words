                    }
                ],
                "senses": [
                    {
                        "sense_id": "1db5d4e3-2051-33a2-9d54-82fc7fc6c307",
                        "entry_id": "da161cf6-1ff0-3f30-aec9-8eb816495d92",
                        "glosses": [
                            "datgene wat noodzakelijk en voldoende is om een zeker gevolg te hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d03577-cf69-4471-a96b-fe78a12791d5",
                                "sense_id": "1db5d4e3-2051-33a2-9d54-82fc7fc6c307",
                                "text": "Ze wisten niet dat ik een zoon had die in coma lag en dat ik de confrontatie zou aangaan met de vrouw die daar de oorzaak van was."
                            },
                            {
                                "example_id": "11d488d3-051f-4799-93f4-580f8113a21d",
                                "sense_id": "1db5d4e3-2051-33a2-9d54-82fc7fc6c307",
                                "text": "Zulke magnetische trillingen zouden de oorzaak kunnen zijn van de ongehoord hoge temperatuur van de corona - één tot twee miljoen graden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af412a5a-c61e-41a5-8b74-c9c9008c6977",
                        "source_entry_id": "da161cf6-1ff0-3f30-aec9-8eb816495d92",
                        "source_sense_id": "1db5d4e3-2051-33a2-9d54-82fc7fc6c307",
                        "target_lang_word": "Ursache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ursache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc303352-ac7d-33ef-9c5f-097352c5e2d4",
                                        "entry_id": "ae8c6b82-a66f-3b33-b9ac-f20450c33487",
                                        "glosses": [
                                            "vorhergehender Sachverhalt, der einen momentanen Sachverhalt wesentlich bestimmt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bccd4f7b-7c6d-4930-adaf-ec0019e9c366",
                                                "sense_id": "cc303352-ac7d-33ef-9c5f-097352c5e2d4",
                                                "text": "Die Ursache ihrer Krankheit war ein schlechter Zahn."
                                            },
                                            {
                                                "example_id": "ce4920fd-570a-4d15-b828-9ee707928818",
                                                "sense_id": "cc303352-ac7d-33ef-9c5f-097352c5e2d4",
                                                "text": "„»Setz dich wieder«, sagte Benno, eine Aufforderung, der Hawa nur widerwillig nachkam. Der Vorschlag lautete, man wolle die Ursache des Brandes der Kartonagefabrik auf sich beruhen lassen, für das Verstummen irgendwelcher damit zusammenhängender und umlaufender Gerüchte Sorge tragen, ja notfalls durch Aussagen von Augenzeugen die Zufälligkeit des Brandausbruchs, höchstens durch reinste Fahrlässigkeit beim Präparieren von Drogenstoffen entstanden, bestätigen lassen, allerdings nur, falls durch den Brand obdachlos gewordene Menschen in ihrer neuen Heimstätte, der sogenannten Wagenburg auf dem ehemaligen Sportplatz von TuS 95 bei den Blauen Bergen, von allen Seiten unbehelligt bleiben dürfen. Für immer?“"
                                            },
                                            {
                                                "example_id": "b1047434-23ea-4b41-a825-e6153c22520b",
                                                "sense_id": "cc303352-ac7d-33ef-9c5f-097352c5e2d4",
                                                "text": "Der Golfstrom ist wichtig für das milde Klima in Westeuropa. Nun deutet eine Studie darauf hin, dass sich die Strömung abschwächt. Ursache sei der Klimawandel, vermuten die Forscher."
                                            },
                                            {
                                                "example_id": "3dd041c9-3213-4096-a09a-a09cdbc75db2",
                                                "sense_id": "cc303352-ac7d-33ef-9c5f-097352c5e2d4",
                                                "text": "„Nicht nur im Motorflug, sondern auch im Segelflug finden sich überzogene Flugzustände oder gar Trudeln regelmäßig als Ursache von Unfällen in den Statistiken der BfU."
                                            },
                                            {
                                                "example_id": "0d4021bd-51d3-43c4-b51c-52aed95f1082",
                                                "sense_id": "cc303352-ac7d-33ef-9c5f-097352c5e2d4",
                                                "text": "„In Wirklichkeit gibt es keine Ursachen für den Brand Moskaus in dem Sinne, dass man diesen Brand einem oder auch mehreren einzelnen Menschen zur Last legen könnte, und konnte sie auch nicht geben.“"
                                            },
                                            {
                                                "example_id": "8b6a4db9-d4a6-46c0-bb8b-55da66a9dcbc",
                                                "sense_id": "cc303352-ac7d-33ef-9c5f-097352c5e2d4",
                                                "text": "„Am Tag nach dem Feuer auf einem mit Öl beladenen Tankschiff auf der Ostsee beginnt die Suche nach der Ursache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8605e1e0-f8c3-498c-80d0-d99f1cfe500d",
                        "source_entry_id": "da161cf6-1ff0-3f30-aec9-8eb816495d92",
                        "source_sense_id": "1db5d4e3-2051-33a2-9d54-82fc7fc6c307",
                        "target_lang_word": "cause",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cause",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e881c0a1-9fa0-3478-92b1-ebddac115f32",
                                        "entry_id": "2cb60d64-6866-3cc1-be01-61750487e477",
                                        "glosses": [
                                            "The source of, or reason for, an event or action; that which produces or effects a result."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f9fdd10-4877-476e-b72e-d9fc5f01cbec",
                                                "sense_id": "e881c0a1-9fa0-3478-92b1-ebddac115f32",
                                                "text": "They identified a burst pipe as the cause of the flooding."
                                            },
                                            {
                                                "example_id": "b345f8c1-fcdf-4153-9dbc-3b893f0a2669",
                                                "sense_id": "e881c0a1-9fa0-3478-92b1-ebddac115f32",
                                                "text": "We thanke you both, yet one but flatters vs,\nAs well appeareth by the cauſe you come,\nNamely, to appeale each other of high treaſon."
                                            },
                                            {
                                                "example_id": "c0f4aa03-7916-41df-8c1c-b05ed56f9a0d",
                                                "sense_id": "e881c0a1-9fa0-3478-92b1-ebddac115f32",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73eb58a-7b8f-3b2a-8864-550e36f7f22a",
                                        "entry_id": "2cb60d64-6866-3cc1-be01-61750487e477",
                                        "glosses": [
                                            "Sufficient reason."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8af73fea-af7c-4fa6-a461-ead84f21af83",
                                                "sense_id": "c73eb58a-7b8f-3b2a-8864-550e36f7f22a",
                                                "text": "There is no cause for alarm."
                                            },
                                            {
                                                "example_id": "13beec53-27f9-4f14-89fa-53cf83a614cc",
                                                "sense_id": "c73eb58a-7b8f-3b2a-8864-550e36f7f22a",
                                                "text": "The end of the war was a cause for celebration."
                                            },
                                            {
                                                "example_id": "fc676ae6-f41e-4ecc-9129-85b5b4dfec5d",
                                                "sense_id": "c73eb58a-7b8f-3b2a-8864-550e36f7f22a",
                                                "text": "He has no cause to do that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d835954-6e89-3155-81f2-510890bdc01e",
                                        "entry_id": "2cb60d64-6866-3cc1-be01-61750487e477",
                                        "glosses": [
                                            "A goal, aim or principle, especially one which transcends purely selfish ends."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d091e5-fb0e-4946-a5a9-4078ca14a5f2",
                                                "sense_id": "2d835954-6e89-3155-81f2-510890bdc01e",
                                                "text": "God befriend us, as our cause is just."
                                            },
                                            {
                                                "example_id": "0c9e26d4-e520-4b55-9461-0c37b27aaeb9",
                                                "sense_id": "2d835954-6e89-3155-81f2-510890bdc01e",
                                                "text": "The part they take against me is from zeal to the cause."
                                            },
                                            {
                                                "example_id": "837b4056-ee92-4ec8-989c-79d90036fd72",
                                                "sense_id": "2d835954-6e89-3155-81f2-510890bdc01e",
                                                "text": "I'm not fighting for anything anymore, except myself. I'm the only cause I'm interested in."
                                            },
                                            {
                                                "example_id": "0001a742-7436-45a3-bb7f-6d6d84631e62",
                                                "sense_id": "2d835954-6e89-3155-81f2-510890bdc01e",
                                                "text": "There is much to regret about America's failure in Vietnam. The reasons are etched in black marble on the Washington Mall. But we had believed the cause that America had asked us to serve in Vietnam was a worthy one, and millions who defended it had done so honorably."
                                            },
                                            {
                                                "example_id": "1914998c-cdc3-495e-8c1f-bcd5a4a8d7e4",
                                                "sense_id": "2d835954-6e89-3155-81f2-510890bdc01e",
                                                "text": "\"I thought you were loyal to the cause, Paul.\"\n“I was,” Grayson answered. “Then I saw the kind of people who share your vision, and I had a change of heart.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae97e34-7038-36db-8e3e-8e93762b9973",
                                        "entry_id": "2cb60d64-6866-3cc1-be01-61750487e477",
                                        "glosses": [
                                            "Sake; interest; advantage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c10c03-181f-4c8e-a5e5-6439388fadc7",
                                                "sense_id": "2ae97e34-7038-36db-8e3e-8e93762b9973",
                                                "text": "I did it not for his cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52354b46-fd87-302f-8705-a7c66acdb9cc",
                                        "entry_id": "2cb60d64-6866-3cc1-be01-61750487e477",
                                        "glosses": [
                                            "Any subject of discussion or debate; a matter; an affair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76eca101-8b51-4ff0-b6f9-3950bcea357a",
                                                "sense_id": "52354b46-fd87-302f-8705-a7c66acdb9cc",
                                                "text": "What counsel give you in this weighty cause?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea16edd5-6d61-3d37-8dcd-6e026e3f9774",
                                        "entry_id": "2cb60d64-6866-3cc1-be01-61750487e477",
                                        "glosses": [
                                            "A suit or action in court; any legal process by which a party endeavors to obtain his claim, or what he regards as his right; case; ground of action."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cause",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42f07553-092f-3eee-bc8d-97392079b01b",
                                        "entry_id": "19808c2b-6d78-3754-b004-5e2bbdc1529d",
                                        "glosses": [
                                            "To set off an event or action; to bring about; to produce."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b39f8ce8-b1c9-4e6c-87e4-95781c0eb8f2",
                                                "sense_id": "42f07553-092f-3eee-bc8d-97392079b01b",
                                                "text": "The lightning caused thunder."
                                            },
                                            {
                                                "example_id": "3dd74a8f-122e-48a6-b72d-4f2b3e533d24",
                                                "sense_id": "42f07553-092f-3eee-bc8d-97392079b01b",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes.[…]She put back a truant curl from her forehead where it had sought egress to the world, and looked him full in the face now, drawing a deep breath which caused the round of her bosom to lift the lace at her throat."
                                            },
                                            {
                                                "example_id": "39b93ca0-9699-4333-a100-d663945d84de",
                                                "sense_id": "42f07553-092f-3eee-bc8d-97392079b01b",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic[…]real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "678612ab-a6d2-393b-8080-4ace3d53d037",
                                        "entry_id": "19808c2b-6d78-3754-b004-5e2bbdc1529d",
                                        "glosses": [
                                            "To actively produce as a result, by means of force or authority."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13ab2605-240c-4a44-8cf4-02017049a176",
                                                "sense_id": "678612ab-a6d2-393b-8080-4ace3d53d037",
                                                "text": "His dogged determination caused the fundraising to be successful."
                                            },
                                            {
                                                "example_id": "c98c750a-22b2-4673-8244-d14787027c33",
                                                "sense_id": "678612ab-a6d2-393b-8080-4ace3d53d037",
                                                "text": "I will cause it to rain upon the earth forty days."
                                            },
                                            {
                                                "example_id": "5d7d85c0-7f6a-43f3-b230-7f6a3289e03f",
                                                "sense_id": "678612ab-a6d2-393b-8080-4ace3d53d037",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them. Soft heartedness caused more harm than good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2beadbb8-4e3b-3858-b95f-560252b2280b",
                                        "entry_id": "19808c2b-6d78-3754-b004-5e2bbdc1529d",
                                        "glosses": [
                                            "To assign or show cause; to give a reason; to make excuse."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4875e9ed-70b7-46f8-9056-4d5d07c09af0",
                                                "sense_id": "2beadbb8-4e3b-3858-b95f-560252b2280b",
                                                "text": "He, to shifte their curious request, / Gan causen why she could not come in place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cause",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d90abe-2a78-35f6-9cb3-0328ab5b7407",
                                        "entry_id": "5c170d16-968c-35d3-8886-d0890fa8cd01",
                                        "glosses": [
                                            "Alternative form of 'cause; because"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8f7a16e-8c6d-46a9-948f-31cfd8d10d66",
                                                "sense_id": "e2d90abe-2a78-35f6-9cb3-0328ab5b7407",
                                                "text": "Why not? Cause I don't wanna."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
