                        "examples": [
                            {
                                "example_id": "577ee438-0f2b-42b0-8695-34502d31158f",
                                "sense_id": "d13585c8-03ab-3189-8108-238cabcb5141",
                                "text": "Przy freeridzie chętnie korzystam ze sprzętu wspinaczkowego, zjeżdżam na linie w rynnach, aby dotrzeć do najlepszego puchu"
                            },
                            {
                                "example_id": "500798ee-2ace-4376-8bcc-4c85346f0985",
                                "sense_id": "d13585c8-03ab-3189-8108-238cabcb5141",
                                "text": "Formalnie rozgrywaną odmianą freeride’u jest slopestyle"
                            },
                            {
                                "example_id": "eca494bd-f78f-456d-a1a4-66ca67ffb582",
                                "sense_id": "d13585c8-03ab-3189-8108-238cabcb5141",
                                "text": "Wyrażenie „freeride” stosowane jest również w windsurfingu, snowboardzie, narciarstwie do określenia ekstremalnej „jazdy” w trudnym terenie – duże zafalowanie, poza przygotowanymi trasami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
