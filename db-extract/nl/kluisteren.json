                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47c985fa-5054-3e41-a480-c865c55ba138",
                                        "entry_id": "4e6322a0-93da-3e83-8225-ad50c7db5db5",
                                        "glosses": [
                                            "To obligate."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722e119c-a59f-4c8a-9ec7-ee6fadf23a70",
                                                "sense_id": "47c985fa-5054-3e41-a480-c865c55ba138",
                                                "text": "I miss when Game Of Thrones was wide open, but even then, the writers were chained to a narrative they didn’t yet know the ending of and feared straying too far from."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4dcdfad-b4d0-321a-b8eb-7d74c7039fdc",
                                        "entry_id": "4e6322a0-93da-3e83-8225-ad50c7db5db5",
                                        "glosses": [
                                            "To relate data items with a chain of pointers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84bf203a-0fab-3928-a9db-20ea541dde34",
                                        "entry_id": "4e6322a0-93da-3e83-8225-ad50c7db5db5",
                                        "glosses": [
                                            "To be chained to another data item."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86deb85b-96c6-478d-ad04-2e99038fea51",
                                                "sense_id": "84bf203a-0fab-3928-a9db-20ea541dde34",
                                                "text": "You don’t need to maintain state, or partition execution into different objects that then you can chain together (one executes the other on completion — chained continuations)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f871a6a8-567b-342d-a216-d6f6097987b7",
                                        "entry_id": "4e6322a0-93da-3e83-8225-ad50c7db5db5",
                                        "glosses": [
                                            "To measure a distance using a 66-foot long chain, as in land surveying."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e013a21e-128c-4e6e-b6ab-7d9e37ec9f9f",
                                                "sense_id": "f871a6a8-567b-342d-a216-d6f6097987b7",
                                                "text": "As the line was surveyed - a sufficient length being first chained by a surveyor, who was followed by axemen - trees had to be felled and a certain width maintained, which was specified in the contract, for drays had to follow, and the trees might have fallen upon the line and broken it down at the very outset."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f497aa10-9d79-30f1-83d2-3f97e23a2481",
                                        "entry_id": "4e6322a0-93da-3e83-8225-ad50c7db5db5",
                                        "glosses": [
                                            "To load and automatically run (a program)."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29eef31e-d8fa-4648-9b2c-1fcee83390a4",
                                                "sense_id": "f497aa10-9d79-30f1-83d2-3f97e23a2481",
                                                "text": "How do you get one program to chain another? I want to run DrawWorks2 then !Draw but as soon as you run Drawworks2 it finishes the batch file and doesn't go on to the next instruction! Is there a way without loading one of these automatic loaders?"
                                            },
                                            {
                                                "example_id": "c2648546-bf80-444a-8aa3-1b3e29b48cc8",
                                                "sense_id": "f497aa10-9d79-30f1-83d2-3f97e23a2481",
                                                "text": "You can do LOAD \"\" or CHAIN \"\" to load or chain the next program if I remember correctly (it's been a loooong time since I've used a tape on an Acorn!)"
                                            },
                                            {
                                                "example_id": "298c582c-a806-4c2d-8b8b-f1a3f66c6205",
                                                "sense_id": "f497aa10-9d79-30f1-83d2-3f97e23a2481",
                                                "text": "Recent versions of AntiSpam no longer use the Config file but have a Settings file instead, so when I updated the Config file to chain SpamStamp it had no effect as it was a redundant file."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
