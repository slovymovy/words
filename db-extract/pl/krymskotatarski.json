                    {
                        "translation_id": "3d977cad-08ae-475c-bb40-ecb6335755ce",
                        "source_entry_id": "305c1f6c-7f5a-384f-b7f6-c5e182ab3fdb",
                        "source_sense_id": "c15a6521-d8a6-3d46-a167-d285fe2a06f2",
                        "target_lang_word": "krimtatarisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krimtatarisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83b57a0c-d275-3021-97c4-5ff871e61977",
                                        "entry_id": "3f82953b-89fe-3125-a751-fc8eb3661918",
                                        "glosses": [
                                            "die Krimtataren, ihre Kultur oder Sprache betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02e517f-c664-46fa-bc54-ba5b66ff34c5",
                                                "sense_id": "83b57a0c-d275-3021-97c4-5ff871e61977",
                                                "text": "Die Bezeichnung Krim verschwand aus dem offiziellen Sprachgebrauch, um die Erinnerung an die krimtatarische Vergangenheit zu tilgen."
                                            },
                                            {
                                                "example_id": "7c3eb180-1b67-4502-9c79-dfca62dc3ebf",
                                                "sense_id": "83b57a0c-d275-3021-97c4-5ff871e61977",
                                                "text": "Er reduzierte 1929 die Bedeutung der krimtatarischen Sprache und begrenzte die territoriale Autonomie der Region."
                                            },
                                            {
                                                "example_id": "4e0b8831-4b71-40f6-8006-2718d9b9629a",
                                                "sense_id": "83b57a0c-d275-3021-97c4-5ff871e61977",
                                                "text": "Doch unter russischer und später sowjetischer Herrschaft wurden die Krimtataren und Krimtatarinnen immer mehr zu Fremden im eigenen Land, bis Stalin schließlich 1944 die gesamte krimtatarische Bevölkerung von der Halbinsel deportieren ließ."
                                            },
                                            {
                                                "example_id": "7bb55488-e3f6-4440-9c10-5f1b9bd8712d",
                                                "sense_id": "83b57a0c-d275-3021-97c4-5ff871e61977",
                                                "text": "Etwa 40.000 krimtatarische Familien wurden verhaftet oder nach Sibirien deportiert."
                                            },
                                            {
                                                "example_id": "a63e7e41-5999-435b-911d-2ed00e2069f5",
                                                "sense_id": "83b57a0c-d275-3021-97c4-5ff871e61977",
                                                "text": "ATR ist ein ukrainisch-krimtatarischer Fernsehsender, der 2006 von Lenur İslâmov gegründet wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
