                ],
                "senses": [
                    {
                        "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                        "entry_id": "91500c7b-6fb7-3187-a763-20435da4d91e",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6782c2ce-36b5-494d-a835-cbe5f3b64be3",
                                "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                                "text": "Frau Würth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "efdb5b98-6dd8-42be-b2b0-fb5889febdb6",
                                "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                                "text": "Herr Würth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ce0e9669-89f3-4462-88ff-7dc7e7028748",
                                "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                                "text": "Die Würths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c0a09558-a881-4ff6-865f-814fbfa8d14b",
                                "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                                "text": "Der Würth trägt nie die Schals, die die Würth ihm strickt."
                            },
                            {
                                "example_id": "c7bcb363-fcc8-4cdf-b772-be8c236181db",
                                "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Würth kommt, geht der Herr Würth.“"
                            },
                            {
                                "example_id": "a9fb5d9c-4cc3-4b9d-81c9-b509cb62fa4e",
                                "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                                "text": "Würth kommt und geht."
                            },
                            {
                                "example_id": "16359a14-905c-44cc-aa38-917c76d5cdeb",
                                "sense_id": "af6f4e76-538a-3979-ba7e-6557c5b7fed1",
                                "text": "Würths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
