                    },
                    {
                        "translation_id": "ba42a341-76ac-4232-bf12-7f0d7eddb5cd",
                        "source_entry_id": "b9fbb742-cb81-3d55-888c-0c13e98c0e4d",
                        "source_sense_id": "d21d464b-d1d4-3733-97d7-0bd72bf6336d",
                        "source_sense_description": "hoge witte muts",
                        "target_lang_word": "toque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83578148-9f75-3416-aca3-81462754152e",
                                        "entry_id": "f94cebee-c733-3ffb-accd-1561ea2f8d76",
                                        "glosses": [
                                            "Couvre-chef sans bords ou à très petits bords."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a3e3ae-d912-49d6-b861-99a7bb891a3c",
                                                "sense_id": "83578148-9f75-3416-aca3-81462754152e",
                                                "text": "Les Cent Suisses de la Garde du Roi portent des toques de velours noir."
                                            },
                                            {
                                                "example_id": "3f2e02db-3211-491e-aba6-2d7293c70592",
                                                "sense_id": "83578148-9f75-3416-aca3-81462754152e",
                                                "text": "Tout en faisant route, les archers remarquèrent qu’Othon n’avait point de plumes à sa toque, ce qui était contre l’uniforme."
                                            },
                                            {
                                                "example_id": "80949a99-4132-401b-886c-efe77ce76547",
                                                "sense_id": "83578148-9f75-3416-aca3-81462754152e",
                                                "text": "En voyant entrer chez lui une femme élégamment vêtue, le pharmacien vint au-devant d’elle en soulevant sa toque de velours bleu."
                                            },
                                            {
                                                "example_id": "2d48096e-890d-41de-a4d9-0e31c67ea47f",
                                                "sense_id": "83578148-9f75-3416-aca3-81462754152e",
                                                "text": "Elle avait une toque plate qui descendait assez bas sur ses yeux, leur donnant ce même regard « en dessous », rêveur et fourbe que je lui avais vu la première fois à Combray."
                                            },
                                            {
                                                "example_id": "38ca4bf5-7435-4bb6-a7bc-fb40ae23fef3",
                                                "sense_id": "83578148-9f75-3416-aca3-81462754152e",
                                                "text": "Quand les couturiers Carven et Balenciaga leur dessinaient de mignonnettes jupettes au-dessus du genou et de seyantes toques sur leurs cheveux, les « prunes » glissées par leurs doigts de fée sur les pare-brise avaient un autre goût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b55202c-fc55-3d64-b7f5-fa40bd5de064",
                                        "entry_id": "f94cebee-c733-3ffb-accd-1561ea2f8d76",
                                        "glosses": [
                                            "Cuisinier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccd7acda-24e9-4b05-ae98-ffb49de1452c",
                                                "sense_id": "8b55202c-fc55-3d64-b7f5-fa40bd5de064",
                                                "text": "Les douze plus grandes toques du moment furent conviées à préparer, chacune, leur plat d'excellence pour une tablée de cinquante gastronomes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f642c2-8b12-3a87-a95f-e880fe10fd3c",
                                        "entry_id": "f94cebee-c733-3ffb-accd-1561ea2f8d76",
                                        "glosses": [
                                            "Insigne récompensant la gastronomie, l'art de la table des restaurants et dess auberges."
                                        ],
                                        "tags": [
                                            "Gastronomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec87f3dc-0521-4671-9422-2b98811c0f36",
                                                "sense_id": "58f642c2-8b12-3a87-a95f-e880fe10fd3c",
                                                "text": "Le temps n'est plus où les critiques des restaurants n'étaient le fait que d'une petite équipe parisienne relayée par une poignée d'amis provinciaux. […] Mais, précise-t-on à la rédaction du guide, les deux et trois toques ne sont accordées que par les maîtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686bd05c-cc55-33bd-8d81-2bd0d4be6d8a",
                                        "entry_id": "f94cebee-c733-3ffb-accd-1561ea2f8d76",
                                        "glosses": [
                                            "Tocarde, femme sans beauté ni grâce, cageot."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae3306c3-4d89-493c-8c97-aa0051a95ab5",
                                                "sense_id": "686bd05c-cc55-33bd-8d81-2bd0d4be6d8a",
                                                "text": "Question pastiquette, il se branche, comme Freud il est intarissable... Pendant sa jeunesse, ce qu'il s'est cloqué sur le bout ! Des chouettes, des toques, des petites, des grosses... tout ce qui se présentait devant sa trique toujours en l'air. \"On m'appelait Buffalo-Bite !\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daeeca84-a4a1-35ea-93e3-e06741dae0e8",
                                        "entry_id": "f94cebee-c733-3ffb-accd-1561ea2f8d76",
                                        "glosses": [
                                            "Bonnet."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e4d43f1-2436-461d-a6a0-619c6c3d4a99",
                                                "sense_id": "daeeca84-a4a1-35ea-93e3-e06741dae0e8",
                                                "text": "[…] je vais me fourrer sous les couvertures jusqu'au cou, après avoir eu soin d'enfoncer ma toque de laine sur mes oreilles, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
