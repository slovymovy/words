                        "examples": [
                            {
                                "example_id": "3997cd9a-f225-4cf9-91b9-b581914fe2eb",
                                "sense_id": "fe37c3e2-c2f5-3e76-8829-3d0f2cfd8610",
                                "text": "Pourquoi ces libéraux qui s'opposent au statut pénal de la femme continuent-ils de proclamer l’inabrogeabilité du Coran ?"
                            },
                            {
                                "example_id": "c8130bf0-3c50-48ec-9758-53fa446431b5",
                                "sense_id": "fe37c3e2-c2f5-3e76-8829-3d0f2cfd8610",
                                "text": "Sur le plan du droit encore, l’inabrogeabilité juridiquement posée de la Constitution n'a pas d'autre prétention que de disqualifier en droit le renversement éventuel et toujours possible de l'ordre constitutionnel existant par un nouvel ordre."
                            }
                        ]
