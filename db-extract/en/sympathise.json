                "senses": [
                    {
                        "sense_id": "afcd4f4d-e7ba-3b0e-bb8b-0940963ed27c",
                        "entry_id": "57b5062e-d1ec-3fc6-ad0d-c5571966a821",
                        "glosses": [
                            "συμπονώ, συμμερίζομαι, λυπάμαι, συμπάσχω με κάποιον"
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "58707ca0-23d9-4790-ae4a-9c37a22a3bbd",
                                "sense_id": "afcd4f4d-e7ba-3b0e-bb8b-0940963ed27c",
                                "text": "I sympathise with you on your loss.",
                                "translation": "Συμπονώ μαζί σου για την απώλειά σου."
                            },
                            {
                                "example_id": "9fc62bdd-7fd5-4c40-818a-c40a842b3f28",
                                "sense_id": "afcd4f4d-e7ba-3b0e-bb8b-0940963ed27c",
                                "text": "We sympathise with your anxiety.",
                                "translation": "Συμμεριζόμαστε την αγωνία σου."
                            },
                            {
                                "example_id": "96ee0f30-f1b3-4bcc-8ea3-157c1151a9c8",
                                "sense_id": "afcd4f4d-e7ba-3b0e-bb8b-0940963ed27c",
                                "text": "I sympathise with the poor guy but there’s nothing I can do.",
                                "translation": "Τον λυπάμαι τον καημένο αλλά δεν μπορώ να κάνω τίποτα."
                            },
                            {
                                "example_id": "2fd9a900-ca9b-476f-8410-99b2d6ad9ace",
                                "sense_id": "afcd4f4d-e7ba-3b0e-bb8b-0940963ed27c",
                                "text": "I sympathise with you but I can’t help you with anything.",
                                "translation": "Συμπάσχω μαζί σου αλλά δεν μπορώ να σε βοηθήσω σε τίποτα."
                            }
                        ]
                    },
                    {
                        "sense_id": "80a4e539-ee3b-3734-ad9d-febfde661d21",
                        "entry_id": "57b5062e-d1ec-3fc6-ad0d-c5571966a821",
                        "glosses": [
                            "συμμερίζομαι, συμφωνώ και υποστηρίζω"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7f4abdef-1cb5-4083-b6db-33ff33bb5053",
                                "sense_id": "80a4e539-ee3b-3734-ad9d-febfde661d21",
                                "text": "I sympathise with her point of view/ideas.",
                                "translation": "Συμφωνώ με/Συμμερίζομαι την άποψη/τις ιδέες της."
                            }
                        ]
                    }
