                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miasma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "140cd4b4-3dcc-3088-8f1d-dd47c1887ad5",
                                        "entry_id": "43723d6e-cf95-3638-abf7-73e938376154",
                                        "glosses": [
                                            "A noxious atmosphere or emanation once thought to originate from swamps and waste, and to cause disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6adc4cf7-9d1b-4017-a4ff-5cbaacf81616",
                                                "sense_id": "140cd4b4-3dcc-3088-8f1d-dd47c1887ad5",
                                                "text": "There was an earthy smell, as of some dry miasma, which came through the fouler air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a8e47a-e176-36d6-972c-7a10892d103b",
                                        "entry_id": "43723d6e-cf95-3638-abf7-73e938376154",
                                        "glosses": [
                                            "A noxious atmosphere or influence, an ominous environment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871ed58a-e4f0-4757-8cb9-41cb3972e762",
                                                "sense_id": "f8a8e47a-e176-36d6-972c-7a10892d103b",
                                                "text": "It was into this lossy compression miasma that aptX was born."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "484cf429-d351-4240-80f8-89e88365a6b8",
                        "source_entry_id": "38147688-b384-34b4-b4db-3ed77ea2785a",
                        "source_sense_description": "испарение",
                        "target_lang_word": "effluvium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effluvium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                        "entry_id": "7cbfa824-9ab5-3348-97ce-380973a512ec",
                                        "glosses": [
                                            "A gaseous or vaporous emission, especially a foul-smelling one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456df088-3871-4653-8cdb-0c0b25d0ddc9",
                                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                                "text": "She was now bending over a huge light wood blaze, with a pipe of rude structure and no small dimensions in her mouth, from which the occasional puff went forth, filling the apartment with the unpleasant effluvia of the vilest leaf-tobacco."
                                            },
                                            {
                                                "example_id": "fa370c07-f907-4605-87fb-5ce1b3aad590",
                                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                                "text": "It was the mere effluvium of the flame, the subtle ether that it cast off as it passed, working on us, and making us feel strong as giants and swift as eagles."
                                            },
                                            {
                                                "example_id": "b86ac18b-229e-444a-8fe2-30e8dc60af29",
                                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                                "text": "And he breathed the breath of the house—a dank savour rather than a smell—a cold, musty effluvium as from underground vaults mingled with the reeking exhalations of linoleum and mildewed and rotten woodwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7506bccf-7fe1-3d8e-92ad-5bd8df0543af",
                                        "entry_id": "7cbfa824-9ab5-3348-97ce-380973a512ec",
                                        "glosses": [
                                            "A condition causing the shedding of hair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9546931-c23b-4d00-82df-d78a273f8cc8",
                                                "sense_id": "7506bccf-7fe1-3d8e-92ad-5bd8df0543af",
                                                "text": "Reversible hair loss or effluvium occurs following either endogenous or exogenous damage to anagen hair follicles[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4e1ccb7-e272-4693-84b2-82b6d90147f9",
                        "source_entry_id": "38147688-b384-34b4-b4db-3ed77ea2785a",
                        "source_sense_description": "испарение",
                        "target_lang_word": "mephitis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mephitis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29a78e37-e588-369c-a0e3-666ad17c00d6",
                                        "entry_id": "299e0e5a-a606-3484-b1b2-dd8f94671435",
                                        "glosses": [
                                            "A poisonous or foul-smelling gas, especially as emitted from the earth; an unpleasant smell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "652436d5-5793-481f-88c2-5bf4bb7f51c4",
                                                "sense_id": "29a78e37-e588-369c-a0e3-666ad17c00d6",
                                                "text": "The Abbe had, in the district of Latera, observed that in a mephitis of hydrogenous sulphurated or hepatic gas, a slow combustion of phosphorus took place, with the same resplendence as in the atmospheric air."
                                            },
                                            {
                                                "example_id": "5082029f-9ef8-400c-87ad-ed1f3e291c27",
                                                "sense_id": "29a78e37-e588-369c-a0e3-666ad17c00d6",
                                                "text": "He attempted several times to fire inflammable gas, with electric sparks, in the mephitic vapor, by means of the conductor of the electrophus; but, notwithstanding his utmost endeavors to animate the electricity, he could never obtain a single spark, the non-conductor becoming a conductor the moment it entered into the mephitis, on account of the humidity which adhered to its surface."
                                            },
                                            {
                                                "example_id": "25bc60fc-6dc6-4314-aedf-e915a22f7634",
                                                "sense_id": "29a78e37-e588-369c-a0e3-666ad17c00d6",
                                                "text": "and not seldom did the fire which the torch of his prophecy had kindled upon her altar, kindle again that torch, when some bitter wind of evil words, or mephitis of human perversity, or thunder rain of foiled charity, […]"
                                            },
                                            {
                                                "example_id": "0c19a0ba-d769-47ea-b5ac-d953713fb6b0",
                                                "sense_id": "29a78e37-e588-369c-a0e3-666ad17c00d6",
                                                "text": "[…] conveyancing of property to a background of ships loading or discharging and the clanging of wharf cranes, but in August, when the tide was low, the River Lyle's gum-like, perspiring mud banks released a mephitis […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02720f3c-b005-31a5-9076-ac4d276acdc7",
                                        "entry_id": "299e0e5a-a606-3484-b1b2-dd8f94671435",
                                        "glosses": [
                                            "A dilution of fluids derived from skunks or polecats."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0569fc50-137a-4de3-8ecc-4ed9fbd15c20",
                                                "sense_id": "02720f3c-b005-31a5-9076-ac4d276acdc7",
                                                "text": "Mephitis, in water, did not at first relieve the cough, so that I was compelled to prescribe another remedy; but after taking this for a short time, the father averred that he thought the first remedy, Mephitis, had a better effect than the last."
                                            },
                                            {
                                                "example_id": "0bdaf55c-3315-42ab-b3cd-913d874e9c7f",
                                                "sense_id": "02720f3c-b005-31a5-9076-ac4d276acdc7",
                                                "text": "I do not see why Dr. Hensley should object to the internal administration of Variolinum any more than to that of lachesis, mephitis, etc."
                                            },
                                            {
                                                "example_id": "68caf25f-9c36-401a-9fe0-d041973d41d0",
                                                "sense_id": "02720f3c-b005-31a5-9076-ac4d276acdc7",
                                                "text": "Mephitis, a highly prized remedy of the Homeopaths, is prepared by taking one part. in weight, of the characteristic fluid expelled by the pole-cat and dissolving it in ninety parts of alcohol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
