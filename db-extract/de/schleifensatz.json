                "senses": [
                    {
                        "sense_id": "fc183daa-8b50-3220-8592-0df309bebedb",
                        "entry_id": "8347aa2b-4953-3f78-a412-fcbd0b1e9186",
                        "glosses": [
                            "Satz über die Eigenschaft bestimmter Sprachklassen, ab einer gewissen Wortlänge nur Wörter mit beliebig wiederholbaren Teilstrings zu enthalten"
                        ],
                        "tags": [
                            "Theorie formaler Sprachen"
                        ],
                        "examples": [
                            {
                                "example_id": "8f8f3fc8-a7ef-4819-b5b9-999f32528fe1",
                                "sense_id": "fc183daa-8b50-3220-8592-0df309bebedb",
                                "text": "Für reguläre Sprachen und für kontextfreie Sprachen gilt jeweils ein spezieller Schleifensatz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "208c42c9-288f-43d4-89d0-ccb3c0b4d011",
                        "source_entry_id": "8347aa2b-4953-3f78-a412-fcbd0b1e9186",
                        "source_sense_id": "fc183daa-8b50-3220-8592-0df309bebedb",
                        "target_lang_word": "pumping lemma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pumping lemma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4b3887-0782-30bd-bc00-170c9d567dc0",
                                        "entry_id": "2f28975b-bf13-3dd6-ad7d-f75ea392e91a",
                                        "glosses": [
                                            "A lemma which states that for a language to be a member of a language class any sufficiently long string in the language contains a section that can be removed or repeated any number of times with the resulting string remaining in the language, used to determine if a particular language is in a given language class (e.g. not regular)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df74a2d8-e1cd-404e-9d94-45991e864078",
                                                "sense_id": "6d4b3887-0782-30bd-bc00-170c9d567dc0",
                                                "text": "There is a pumping lemma for CFLs similar to the one for regular sets. It can be used in the same way to show that certain sets are not context-free."
                                            },
                                            {
                                                "example_id": "b2e5dc1a-a25a-4f80-9f49-51b1619c03a5",
                                                "sense_id": "6d4b3887-0782-30bd-bc00-170c9d567dc0",
                                                "text": "In the literature one finds many pumping lemmas which describe the ability to repeat (pump) certain words repeatedly in some languages, under different circumstances."
                                            },
                                            {
                                                "example_id": "61748446-3d12-4fde-999f-149aee970211",
                                                "sense_id": "6d4b3887-0782-30bd-bc00-170c9d567dc0",
                                                "text": "String-language hierarchies are usually proven using formalism-specific pumping lemmata."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
