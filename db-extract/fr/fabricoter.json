                "senses": [
                    {
                        "sense_id": "a36caa14-32cd-3ce0-916c-83c126cb66a3",
                        "entry_id": "2b6a7dbf-4b47-342b-8682-7be44118d1cd",
                        "glosses": [
                            "Fabriquer."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8f82d8f0-5cbf-4f77-8386-68bc99ef9ea9",
                                "sense_id": "a36caa14-32cd-3ce0-916c-83c126cb66a3",
                                "text": "En bas, la salle de café était déserte. Presque : la patronne fabricotait quelque chose derrière la caisse."
                            },
                            {
                                "example_id": "25476894-7d98-41ae-b08f-2efbcb6373f4",
                                "sense_id": "a36caa14-32cd-3ce0-916c-83c126cb66a3",
                                "text": "Mais, si tu préfères, je vais te fabricoter une mixture savante où il y a du sirop de canne… du sucre… de l’orange… de l’ananas… de l’angélique…"
                            },
                            {
                                "example_id": "78c4e1b2-32d6-456b-be64-89c067fc78d5",
                                "sense_id": "a36caa14-32cd-3ce0-916c-83c126cb66a3",
                                "text": "On ne plante pas un chêne comme on fabricote un gouvernement, fût-il fédéral."
                            }
                        ]
                    }
                ],
