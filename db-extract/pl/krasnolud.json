                    },
                    {
                        "sense_id": "040b0c10-9bdc-3991-a8f4-007b52fd1919",
                        "entry_id": "f5ff94be-bb99-3112-ab57-b79dcea19002",
                        "glosses": [
                            "przedstawiciel fantastycznej rasy pochodzącej od krasnoludów (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e252b7-a28b-4b15-8408-7e90a5e76ec0",
                                "sense_id": "040b0c10-9bdc-3991-a8f4-007b52fd1919",
                                "text": "Krasnolud łypnął na niego i uśmiechnął się przebiegle"
                            },
                            {
                                "example_id": "e28c183a-f405-46b8-b9e6-4c19a47e0c96",
                                "sense_id": "040b0c10-9bdc-3991-a8f4-007b52fd1919",
                                "text": "Gry pełniły ważną rolę w historii zarówno krasnoludów, jak i trolli"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "2aaa5ec5-f0cc-3765-b48f-a7213e8dcdd6",
                        "entry_id": "f5ff94be-bb99-3112-ab57-b79dcea19002",
