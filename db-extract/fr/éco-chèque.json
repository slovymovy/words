                        "sense_id": "f5d2a422-fbf2-364b-a114-71fc39c58ac6",
                        "entry_id": "6700ed96-bc68-3232-a9fe-1039230008b9",
                        "glosses": [
                            "Chèque fourni à un particulier pour des dépenses qui participent à un but écologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ebe6995-f71b-4c89-9636-e3fe8a62b224",
                                "sense_id": "f5d2a422-fbf2-364b-a114-71fc39c58ac6",
                                "text": "Un éco-chèque est destiné à tous les travaux permettant un gain énergétique de 25% d’un montant supérieur ou égal à 1500 euros pour les propriétaires occupants et 1000 euros pour les propriétaires bailleurs."
                            },
                            {
                                "example_id": "d733cfb3-d9de-4de2-8db5-01223bccc7f3",
                                "sense_id": "f5d2a422-fbf2-364b-a114-71fc39c58ac6",
                                "text": "l’octroi de l’éco-chèque doit être prévu par une convention collective de travail conclue au niveau du secteur ou de l’entreprise ou, si la conclusion d’une convention collective n’est pas possible, par une convention individuelle écrite étant entendu que, dans une entreprise occupant des travailleurs, le même régime doit s’appliquer tant aux dirigeants d’entreprise qu’aux travailleurs;"
                            }
                        ]
                    }
                ],
