                        "source_entry_id": "d2dd9905-ed93-3dab-b386-9a78c1061179",
                        "source_sense_id": "355f7857-6c8d-3b3a-902c-7cd3d4917a80",
                        "target_lang_word": "sprong",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprong",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5ff00060-5b22-3569-b15d-cbf33621deee",
                                        "entry_id": "ce1390f9-ca02-3f07-a245-1377ed7669c3",
                                        "glosses": [
                                            "met het lichaam een beweging in opwaartse richting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8a7b20-8516-4545-9f16-ad7274cdccec",
                                                "sense_id": "5ff00060-5b22-3569-b15d-cbf33621deee",
                                                "text": "Na zijn sprong voelde hij weer hoe de zuigende onderstroom hem naar beneden wilde trekken."
                                            },
                                            {
                                                "example_id": "0a8bb566-a7ab-4416-98e8-2a7b47d14e79",
                                                "sense_id": "5ff00060-5b22-3569-b15d-cbf33621deee",
                                                "text": "'Eruit! Snel! Het huis stort in!' Met één grote sprong was Van Oortmerssen uit bed en bij het raam, terwijl hij de vloer onder zijn voeten voelde wegglijden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db862485-f24c-36f5-9d67-fbe4b3ae94a0",
                                        "entry_id": "ce1390f9-ca02-3f07-a245-1377ed7669c3",
                                        "glosses": [
                                            "een afwijking van de normale volgorde waarbij een aantal tussenliggende zaken overgeslagen worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cad34ab-f0aa-4f22-9d30-2b6d43cc464d",
                                                "sense_id": "db862485-f24c-36f5-9d67-fbe4b3ae94a0",
                                                "text": "Maar de geest is van elastiek, dus dacht ik aan Lawrie en nam ik een voortijdige sprong naar de toekomst."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sprong",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "09eee1e0-d002-3cbe-a93a-f0c5c83b2ab6",
                                        "entry_id": "d9a7a02b-e4ff-3f2e-a64f-d72fa3b69f68",
                                        "glosses": [
                                            "enkelvoud verleden tijd van springen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "246c4a39-c99f-4dc3-a41a-b70b1d20be7a",
                                                "sense_id": "09eee1e0-d002-3cbe-a93a-f0c5c83b2ab6",
                                                "text": "Ik sprong."
                                            },
                                            {
                                                "example_id": "13655048-0b0f-46d9-ab5b-1bb63a9b9db4",
                                                "sense_id": "09eee1e0-d002-3cbe-a93a-f0c5c83b2ab6",
                                                "text": "Jij sprong."
                                            },
                                            {
                                                "example_id": "52865423-3c77-48e7-ae8a-4635f7bb90c4",
                                                "sense_id": "09eee1e0-d002-3cbe-a93a-f0c5c83b2ab6",
                                                "text": "Hij, zij, het sprong."
                                            },
                                            {
                                                "example_id": "a939e23c-e52f-43c6-9f3a-2267dec5964c",
                                                "sense_id": "09eee1e0-d002-3cbe-a93a-f0c5c83b2ab6",
                                                "text": "De bodem sprong er gewoon uit en de champagne stroomde bruisend over de vloer tussen ons in."
                                            },
                                            {
                                                "example_id": "dd68f956-761e-421e-a657-ee3d5e12a9b6",
                                                "sense_id": "09eee1e0-d002-3cbe-a93a-f0c5c83b2ab6",
                                                "text": "Kun jij daar wat aan doen?' Opgelucht sprong ik op."
                                            },
                                            {
                                                "example_id": "69de3bb7-9c9f-4658-a68d-0fddf06ad552",
                                                "sense_id": "09eee1e0-d002-3cbe-a93a-f0c5c83b2ab6",
                                                "text": "Nadat ik wat gedronken had sprong ik het meer in met al mijn kleren om het zweet en het stof van me af te wassen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
