                                                "sense_id": "c569873a-cdb2-3d85-acf6-22eef1c1dc06",
                                                "text": "[…] maybe two or three twenties, a dozen tens, and twenty or thirty fins. The rest is all aces and silver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "141a27ff-63e7-3e02-a7f6-cc9995bffe51",
                                        "entry_id": "b4ec4e71-cd5e-3117-8695-f062bcd331a6",
