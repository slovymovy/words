                "senses": [
                    {
                        "sense_id": "2f0d6a9b-a014-3c1c-87ec-4e0eb532b0e6",
                        "entry_id": "06d254e7-a0bb-3f54-87ca-a13692d338d9",
                        "glosses": [
                            "Douceur, indulgence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c2d40ad-0601-4ef0-b662-8a485e4cd20e",
                                "sense_id": "2f0d6a9b-a014-3c1c-87ec-4e0eb532b0e6",
                                "text": "Trop de lénité envers le coupable pris en flagrant délit."
                            },
                            {
                                "example_id": "b2ae198f-14a6-4a4f-bf10-4ad079703b50",
                                "sense_id": "2f0d6a9b-a014-3c1c-87ec-4e0eb532b0e6",
                                "text": "En me rencontrant dans le vestibule de la poste, il m'appela discrètement à l'écart, et avec des formes d'une extrême délicatesse, il m'annonça qu'il avait une mission pénible à remplir vis-à-vis de moi, que le procureur-général Ogden lui avait transmis par la dernière malle l'ordre de m'arrêter sur accusation pour crime de haute trahison, et qu'il désirait n'exécuter ses instructions qu'avec toute la lénité convenable, afin d'alarmer ma famille le moins possible et de me ménager les occasions de remédier aux ennuis de la triste position qui m'était ainsi faite."
                            },
                            {
                                "example_id": "a9a6f669-50d7-46d5-b2f5-8542e7ee2dfb",
                                "sense_id": "2f0d6a9b-a014-3c1c-87ec-4e0eb532b0e6",
                                "text": "C’est donc pour l’âge adulte, pour celui de la lénité des rapports conjugaux et de la douceur du mariage, plus que pour tout autre, qu’ont été écrites les considérations qui précèdent."
                            }
                        ]
                    }
                ],
