                        "sense_id": "82e4e4bb-a598-3545-96af-8399b885dc7e",
                        "entry_id": "88962927-a476-3773-a0d7-e347724eafc9",
                        "glosses": [
                            "Relatif au cens électoral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da857c56-5e5c-4e18-8c9c-7507fa597064",
                                "sense_id": "82e4e4bb-a598-3545-96af-8399b885dc7e",
                                "text": "Suffrage censitaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "414a0f92-c64b-3bc9-a4b8-24504ceae5d1",
                        "entry_id": "88962927-a476-3773-a0d7-e347724eafc9",
                        "glosses": [
                            "Qui paie le cens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ce3d1b-8d73-4271-a66d-64a2c4be4ef7",
                                "sense_id": "414a0f92-c64b-3bc9-a4b8-24504ceae5d1",
                                "text": "Ils [les libéraux] représentaient le « pays légal », les électeurs censitaires, c'est-à-dire deux cent milliers de personnes en tout."
                            }
                        ]
                    },
                    {
                        "sense_id": "27f25fe9-86d5-37c5-86cd-8eb747568091",
                        "entry_id": "88962927-a476-3773-a0d7-e347724eafc9",
                        "glosses": [
                            "Réservé à ceux qui payent pour avoir le droit de vote."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b0a628b9-3774-45ee-b4eb-2275562cb0de",
                                "sense_id": "27f25fe9-86d5-37c5-86cd-8eb747568091",
                                "text": "\"Je suis contre l'idée de faire payer aux Parisiens le sacre de notre candidat\", affirme-t-elle, n'hésitant pas à comparer le processus de désignation à un \"vote censitaire\"."
                            },
                            {
                                "example_id": "445ec06c-83e2-4d58-9f96-0af9a61d3d44",
                                "sense_id": "27f25fe9-86d5-37c5-86cd-8eb747568091",
                                "text": "Même si [le Conseil des chefs d’État] est censé statuer à l’unanimité, c’est en réalité un véritable suffrage censitaire qui le régit : l’Allemagne et la France y ont un poids énorme et rares sont ceux (…) qui osent s’opposer à ce condominium."
                            }
                        ]
                    }
