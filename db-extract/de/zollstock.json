                "senses": [
                    {
                        "sense_id": "86ea8c3d-95d9-31e3-b1b3-fb9b90159cc9",
                        "entry_id": "1a0e8bba-b35e-3014-95b5-2d5b8c78bf64",
                        "glosses": [
                            "Gliedermaßstab, ein zusammenlegbarer Maßstab"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f5e06a-d4df-45e8-9e44-b5a8079d002e",
                                "sense_id": "86ea8c3d-95d9-31e3-b1b3-fb9b90159cc9",
                                "text": "Mit dem Zollstock maß er die Größe des Raumes aus."
                            },
                            {
                                "example_id": "71a61169-19b8-482a-9a95-3c552a68f011",
                                "sense_id": "86ea8c3d-95d9-31e3-b1b3-fb9b90159cc9",
                                "text": "Der Zollstock in der schwarzen Cord-Arbeitshose weist ihn als Zimmermann aus."
                            },
                            {
                                "example_id": "f34ddfe4-f6ed-4344-96fe-d11d7f8f0508",
                                "sense_id": "86ea8c3d-95d9-31e3-b1b3-fb9b90159cc9",
                                "text": "„Mit dem Zollstock misst er aus, wo der Bettvorleger zu liegen habe, das Futter für den Kanarienvogel wiegt er mit der Briefwaage ab, Inbegriff von Preußenzucht, Militarismus und Vaterlandstreue.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
