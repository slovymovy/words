                ],
                "senses": [
                    {
                        "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                        "entry_id": "852f20a9-33ae-37a4-9cf1-8ab3a71b8f76",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6a80a9-1a6a-4ff2-b031-4e87324979d0",
                                "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                                "text": "Frau Härle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3e8d21c0-02f1-4c53-8dbb-446a109c9cd7",
                                "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                                "text": "Herr Härle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b448d779-0964-4103-8b0e-8adb49e69e6e",
                                "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                                "text": "Die Härles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e24dcc5d-e6fb-4cbe-9529-c4213ffaaee4",
                                "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                                "text": "Der Härle trägt nie die Schals, die die Härle ihm strickt."
                            },
                            {
                                "example_id": "1d631dd4-dde4-483a-a346-0afb752d416c",
                                "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Härle kommt, geht der Herr Härle.“"
                            },
                            {
                                "example_id": "d789928e-282d-4adc-befc-7878872b6379",
                                "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                                "text": "Härle kommt und geht."
                            },
                            {
                                "example_id": "1017db8b-f5c5-4a5b-aaae-1406ecac5dfd",
                                "sense_id": "cb78d5f5-fc3c-32ac-abca-dacfa642c61d",
                                "text": "Härles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
