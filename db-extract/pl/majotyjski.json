                        "source_entry_id": "b4aadb17-5b14-3abf-9e92-45cac68f7216",
                        "source_sense_id": "146b1150-4479-3dfc-92c0-523d445c0f40",
                        "target_lang_word": "mahorais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mahorais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acc6ae03-b6cf-3b4e-bbc7-522133f6e4f8",
                                        "entry_id": "ce2dd284-8306-36e8-b1b1-39b1f880fdf1",
                                        "glosses": [
                                            "Relatif à Mayotte et à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f452795a-29aa-4979-99b3-b0c3786c3ad8",
                                                "sense_id": "acc6ae03-b6cf-3b4e-bbc7-522133f6e4f8",
                                                "text": "Des « collectifs citoyens » mahorais se sont associés au mouvement en appelant la population à se rassembler à Mamoudzou, le chef-lieu du département, où quelque 200 personnes ont manifesté, arborant des salouvas, le pagne traditionnel, aux couleurs de Mayotte."
                                            },
                                            {
                                                "example_id": "f2e2f165-cdd5-4816-8c48-d0abe99b83ad",
                                                "sense_id": "acc6ae03-b6cf-3b4e-bbc7-522133f6e4f8",
                                                "text": "Elle est chef du pôle enfance de l'association Tama — en shimaoré, la langue mahoraise, ce mot signifie « espoir »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mahorais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7af1493-7134-316c-bb28-70687fba596e",
                                        "entry_id": "c74a0848-81ee-3e7d-9b73-40b83aa18ab2",
                                        "glosses": [
                                            "Langue indigène parlée sur l’île de Mayotte, dialecte du swahili."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "358cddf3-856a-4b87-babf-2484fb0d33cd",
                                                "sense_id": "f7af1493-7134-316c-bb28-70687fba596e",
                                                "text": "Une de ses originalités est la place faite aux femmes qui plaident en mahorais la cause de l’intégration de l’île à la France."
                                            },
                                            {
                                                "example_id": "19e93c75-7c6f-44bf-ba52-4bfa75449289",
                                                "sense_id": "f7af1493-7134-316c-bb28-70687fba596e",
                                                "text": "C’est donc en mahorais qu’elle plaide avec passion la cause de la France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
