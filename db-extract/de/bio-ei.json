                "senses": [
                    {
                        "sense_id": "e6beedcc-8dcb-324a-8412-9e6583463d90",
                        "entry_id": "c340e3fa-bbd6-3a78-8154-8c1c19951e73",
                        "glosses": [
                            "zum Verzehr gedachtes Ei aus ökologischer Erzeugung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a1f3e5-2b3d-478e-a4f8-4558bce11317",
                                "sense_id": "e6beedcc-8dcb-324a-8412-9e6583463d90",
                                "text": "„Erst im Herbst 2012 hatte es schon einmal schlechte Schlagzeilen über Bio-Eier gegeben. Damals war giftiges Dioxin in Bio-Eiern gefunden worden.“"
                            },
                            {
                                "example_id": "85a993e2-cb98-4cd4-8649-8c19f3e9805d",
                                "sense_id": "e6beedcc-8dcb-324a-8412-9e6583463d90",
                                "text": "„Bio-Eier stammen von Hühnern, die artgerecht gehalten werden.“"
                            },
                            {
                                "example_id": "f29b5610-8422-4a70-9dbf-93b191cb3080",
                                "sense_id": "e6beedcc-8dcb-324a-8412-9e6583463d90",
                                "text": "„Es gibt jetzt überall in den Märkten ein differenziertes Eiersortiment: Das Standard-Käfig-Ei in grauer Pappe, Eier aus Bodenhaltung, Freiland-Eier und schließlich das Bio-Ei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
