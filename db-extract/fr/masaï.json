                "senses": [
                    {
                        "sense_id": "b1ea3e25-d619-310e-a087-7e8877152d91",
                        "entry_id": "7c235869-5c04-363a-902f-c225e3c81fe9",
                        "glosses": [
                            "Race mixte de zébus, originaires de l’Afrique de l’Est (Kenya), à cornes courtes et à robe variable."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8872365-70fb-469d-a8db-958634fec45f",
                        "source_entry_id": "7c235869-5c04-363a-902f-c225e3c81fe9",
                        "source_sense_id": "b1ea3e25-d619-310e-a087-7e8877152d91",
                        "target_lang_word": "Massai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                                        "entry_id": "02e51e2f-cf6c-3a32-b7ee-1c09e36dda2a",
                                        "glosses": [
                                            "ein Nomadenvolk, das im Süden Kenias und im Norden Tansanias (Ostafrika) lebt und Maa spricht"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7997e6b0-4b15-412a-b96f-26413f991b36",
                                                "sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                                                "text": "„Die Massai jagen so gut wie gar nicht. Sie ernähren sich hauptsächlich von dem Fleisch ihrer Schafe und Ziegen.“"
                                            },
                                            {
                                                "example_id": "93b7f78a-4fc7-464d-a269-6dc437d89b5e",
                                                "sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                                                "text": "„Längst passen die Moral- und Ehrbegriffe der Massai nicht mehr in die moderne Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bde38cb0-ebf6-314c-8e52-a01b063bfb2e",
                                        "entry_id": "02e51e2f-cf6c-3a32-b7ee-1c09e36dda2a",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen Nomadenvolks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de17ea0-1e3d-4fbf-b653-1b7722e1c57d",
                                                "sense_id": "bde38cb0-ebf6-314c-8e52-a01b063bfb2e",
                                                "text": "„Von Anfang an dolmetschte mir ein junger Massai, so dass ich den Inhalt der Reden jedes Mal erfassen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Massai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cffa8e6-e2ac-35d2-99a9-0e73dc788778",
                                        "entry_id": "396824b9-e567-3240-91ec-0c181e1e88c9",
                                        "glosses": [
                                            "Angehörige des gleichnamigen Nomadenvolks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9866ab8-b9e2-49ad-8a92-c4d0466af08c",
                                                "sense_id": "4cffa8e6-e2ac-35d2-99a9-0e73dc788778",
                                                "text": "„Eine Massai musste damit rechnen, ohne die eigene Zustimmung verheiratet zu werden, eine Ehefrau teilte ihren Mann fast immer mit mehreren anderen Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Massai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e02283-38ed-3577-8d99-80b1dd2d2b10",
                                        "entry_id": "7ec8c871-d058-3658-bdb5-75810f3603a1",
                                        "glosses": [
                                            "eine nilotische Sprache, die vor allem in Ostafrika vom gleichnamigen Volk gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91c7767-02d5-4327-986d-cb321311d831",
                                                "sense_id": "e8e02283-38ed-3577-8d99-80b1dd2d2b10",
                                                "text": "„Sind jene Gruppe der Niloten, die eine dem Massai verwandte Sprache sprechen.“"
                                            },
                                            {
                                                "example_id": "d77ec6bb-d2cd-430e-81ba-50be2322b659",
                                                "sense_id": "e8e02283-38ed-3577-8d99-80b1dd2d2b10",
                                                "text": "„Durch ihn wissen wir jetzt genau, daß die Wandorobo das Massai sprechen wie ihre Herren und daß alle ihre sonstigen in die Augen springenden Merkmale jenen der Massai gleich sind.“"
                                            },
                                            {
                                                "example_id": "9bffec84-7526-475a-a44e-84b35b7fda49",
                                                "sense_id": "e8e02283-38ed-3577-8d99-80b1dd2d2b10",
                                                "text": "„ein Pariavolk unter den Massai und südlichen Galla, der Physis nach Hamiten, jedoch kleiner als die Massai und mit echter Negersprache, die sie unter einander gebrauchen, während sie sonst das Massai sprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
