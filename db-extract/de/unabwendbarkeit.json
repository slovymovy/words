                ],
                "senses": [
                    {
                        "sense_id": "171ce6c7-b435-36e5-8898-247f55e59558",
                        "entry_id": "cbc03635-6918-32eb-b779-392c077df1d2",
                        "glosses": [
                            "die Tatsache, nicht vermeidbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b8e280-99c3-4a4c-b79d-1143eaa97355",
                                "sense_id": "171ce6c7-b435-36e5-8898-247f55e59558",
                                "text": "„‚Es ist kein akutes Risiko‘, betont Anders Levermann, ‚aber es zeigt die Unabwendbarkeit des Meeresspiegelanstiegs.‘“"
                            },
                            {
                                "example_id": "34450b5a-9988-41e1-a7fb-8daec033ffff",
                                "sense_id": "171ce6c7-b435-36e5-8898-247f55e59558",
                                "text": "„Wenn die Tragödie die Nothwendigkeit der göttlichen Weltordnung und die Unabwendbarkeit des Schicksals darstellte, so spottete die Komödie jener Nothwendigkeit als einer albernen Einrichtung und verhöhnte die Idee des Schicksals durch die Feier der schicksallosen Nullität.“"
                            },
                            {
                                "example_id": "ec22bf5a-fba5-4bd7-b2b7-d69ee217742e",
                                "sense_id": "171ce6c7-b435-36e5-8898-247f55e59558",
                                "text": "„Hinzu kommt, daß nach der Formulierung des § 7 StVG die Haftung die Regel, die Unabwendbarkeit hingegen die Ausnahme ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
