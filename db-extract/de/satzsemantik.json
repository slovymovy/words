                "senses": [
                    {
                        "sense_id": "9cc9d118-5eb9-3762-a1cd-d276a64905d0",
                        "entry_id": "4c01a0e6-dc2b-3e60-a690-8843ad343d5b",
                        "glosses": [
                            "Oberbegriff für verschiedene Ansätze der Semantik, die Bedeutung eines Satzes zu erfassen"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "b5965320-079d-41f3-a38f-ce57e2bc7098",
                                "sense_id": "9cc9d118-5eb9-3762-a1cd-d276a64905d0",
                                "text": "Polenz definiert Satzsemantik als „Die Lehre beziehungsweise das System, in der/dem man beschreibt und erklärt, wie sich der Inhalt von Sätzen beziehungsweise seine Teile zum Satzausdruck beziehungsweise seinen Teilen verhalten.“"
                            },
                            {
                                "example_id": "3e78b65f-3ded-4f70-b21c-baf5abe5c63f",
                                "sense_id": "9cc9d118-5eb9-3762-a1cd-d276a64905d0",
                                "text": "„Neuere semantische Theorien sind dagegen oft schwergewichtig Theorien der Kompositionalität und beschäftigen sich mit dem regulären Aufbau der Bedeutung komplexer Ausdrücke, insbesondere von Sätzen. Man kann das Satzsemantik nennen.“"
                            },
                            {
                                "example_id": "5146cd48-8516-4eb9-9b0c-a5500f927851",
                                "sense_id": "9cc9d118-5eb9-3762-a1cd-d276a64905d0",
                                "text": "„Während sich viele Probleme der Satzsemantik am ehesten mit Hilfe der strukturalistischen, generativen und syntagmatischen Semantik lösen lassen, sind die Wortbedeutungen am besten mit der Methode der paradigmatischen Semantik zu analysieren…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
