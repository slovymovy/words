{
    "word_family": [
        "eventualiteit"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "54a97255-59f4-3969-9215-37854236a908",
                    "sense_definition": "iets wat mogelijk is of zou kunnen gebeuren, maar niet zeker is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mogelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten ons goed voorbereiden op <w>eventuele</w> problemen tijdens de reis.",
                            "target_lang_translations": {
                                "en": "We must prepare well for <w>possible</w> problems during the trip.",
                                "ru": "Мы должны хорошо подготовиться к <w>возможным</w> проблемам во время поездки."
                            }
                        },
                        {
                            "text": "De <w>eventuele</w> kosten voor het parkeren zijn niet bij de prijs inbegrepen.",
                            "target_lang_translations": {
                                "en": "Any <w>potential</w> parking costs are not included in the price.",
                                "ru": "<w>Возможные</w> расходы на парковку не включены в стоимость."
                            }
                        }
                    ],
                    "antonyms": [
                        "zeker"
                    ],
                    "common_phrases": [
                        "eventuele kosten",
                        "eventuele problemen"
                    ],
                    "target_lang_definitions": {
                        "en": "something that is possible or could happen, but is not certain",
                        "ru": "что-то, что возможно или может произойти, но не является определенным"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "possible",
                                "target_lang_sense_clarification": "able to happen but not certain"
                            },
                            {
                                "target_lang_word": "potential",
                                "target_lang_sense_clarification": "existing in possibility; latent"
                            },
                            {
                                "target_lang_word": "any",
                                "target_lang_sense_clarification": "used in contexts like 'any problems' to imply possibility"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "возможный",
                                "target_lang_sense_clarification": "который может произойти"
                            },
                            {
                                "target_lang_word": "потенциальный",
                                "target_lang_sense_clarification": "скрытый, но способный проявиться"
                            },
                            {
                                "target_lang_word": "вероятный",
                                "target_lang_sense_clarification": "имеющий шансы на осуществление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75f11992-0956-3383-86e6-4005bdb5da6b",
                    "sense_definition": "wat af en toe of bij bepaalde gelegenheden voorkomt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "frequentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naast zijn vaste baan heeft hij nog enkele <w>eventuele</w> opdrachten als adviseur.",
                            "target_lang_translations": {
                                "en": "In addition to his permanent job, he has some <w>occasional</w> assignments as a consultant.",
                                "ru": "Помимо основной работы, у него есть несколько <w>эпизодических</w> поручений в качестве консультанта."
                            }
                        },
                        {
                            "text": "De <w>eventuele</w> bezoeker zal merken dat het dorp erg rustig is.",
                            "target_lang_translations": {
                                "en": "The <w>occasional</w> visitor will notice that the village is very quiet.",
                                "ru": "<w>Случайный</w> посетитель заметит, что в деревне очень тихо."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "occurring occasionally or on certain occasions",
                        "ru": "то, что случается время от времени или в определенных случаях"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "occasional",
                                "target_lang_sense_clarification": "happening from time to time"
                            },
                            {
                                "target_lang_word": "incidental",
                                "target_lang_sense_clarification": "occurring by chance or as a minor consequence"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "эпизодический",
                                "target_lang_sense_clarification": "происходящий время от времени"
                            },
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "нерегулярный, зависящий от случая"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6d4c4fc5-0ff3-38ad-ba62-ba8a2a2e1775",
                    "sense_definition": "indien nodig of als het zo uitkomt; misschien",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mogelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt <w>eventueel</w> een handschoen gebruiken tijdens het tanken.",
                            "target_lang_translations": {
                                "en": "You can <w>if necessary</w> use a glove while refueling.",
                                "ru": "Вы можете <w>при необходимости</w> использовать перчатку во время заправки."
                            }
                        },
                        {
                            "text": "Als je wilt, kunnen we <w>eventueel</w> morgenochtend afspreken.",
                            "target_lang_translations": {
                                "en": "If you want, we could <w>possibly</w> meet tomorrow morning.",
                                "ru": "Если хочешь, мы <w>возможно</w> могли бы встретиться завтра утром."
                            }
                        }
                    ],
                    "synonyms": [
                        "evt.",
                        "mogelijk",
                        "misschien"
                    ],
                    "common_phrases": [
                        "kan eventueel",
                        "eventueel later"
                    ],
                    "target_lang_definitions": {
                        "en": "if necessary or if it suits the situation; perhaps",
                        "ru": "при необходимости или если это удобно; возможно"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "if necessary",
                                "target_lang_sense_clarification": "used to suggest an alternative if needed"
                            },
                            {
                                "target_lang_word": "possibly",
                                "target_lang_sense_clarification": "perhaps; maybe"
                            },
                            {
                                "target_lang_word": "potentially",
                                "target_lang_sense_clarification": "with the capacity to happen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "при необходимости",
                                "target_lang_sense_clarification": "если того потребует ситуация"
                            },
                            {
                                "target_lang_word": "в случае чего",
                                "target_lang_sense_clarification": "разговорный вариант для обозначения возможности"
                            },
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "выражает вероятность или предложение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd993200-5bc1-3d3f-9a23-7b02cd07578d",
                    "sense_definition": "bij gelegenheid of wanneer de situatie zich voordoet",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "frequentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij komt <w>eventueel</w> langs als hij in de buurt van de stad is.",
                            "target_lang_translations": {
                                "en": "He might <w>possibly</w> stop by if he is near the city.",
                                "ru": "Он <w>при случае</w> заглянет, если будет проездом рядом с городом."
                            }
                        },
                        {
                            "text": "We kunnen <w>eventueel</w> stoppen bij een restaurant als we honger krijgen.",
                            "target_lang_translations": {
                                "en": "We can <w>if the occasion arises</w> stop at a restaurant if we get hungry.",
                                "ru": "Мы можем <w>если что</w> остановиться в ресторане, если проголодаемся."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "occasionally or when the situation arises",
                        "ru": "при случае или когда возникнет подходящая ситуация"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "if the occasion arises",
                                "target_lang_sense_clarification": "when a specific situation occurs"
                            },
                            {
                                "target_lang_word": "possibly",
                                "target_lang_sense_clarification": "depending on the circumstances"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "при случае",
                                "target_lang_sense_clarification": "когда представится возможность"
                            },
                            {
                                "target_lang_word": "если получится",
                                "target_lang_sense_clarification": "в зависимости от обстоятельств"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}