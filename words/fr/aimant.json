                    "frequency": "High",
                    "semantic_group_id": "magnetisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'amuse à ramasser des trombones métalliques à l'aide d'un petit <w>aimant</w>."
                        },
                        {
                            "text": "Ce tournevis est équipé d'un puissant <w>aimant</w> fort pratique pour retenir les vis."
                        }
                    ],
                    "common_phrases": [
