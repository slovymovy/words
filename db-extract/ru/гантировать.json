                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b593d86b-f193-4dee-9588-6501299894cc",
                                "sense_id": "972ed0b7-674a-32bb-be62-efcd6c68baa2",
                                "text": "Её рядят, её гантируют, её возят на гулянья, она танцует, она кушает конфетки, наружно принимают её как царицу, и мужчина перед ней наружно во прахе."
                            }
                        ]
