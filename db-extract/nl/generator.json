                    {
                        "sense_id": "cc66a4b1-3405-3ff1-bcb1-d7f9df07dbc5",
                        "entry_id": "7e2e4979-de73-36c9-b706-f789cd266949",
                        "glosses": [
                            "een machine die mechanische energie, binnenkomend via een draaiende as, omzet in elektrische energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c196a032-518c-41fe-bd1e-42f51329836d",
                                "sense_id": "cc66a4b1-3405-3ff1-bcb1-d7f9df07dbc5",
                                "text": "Om in dit afgelegen gebied toch over stroom te beschikken, hadden zij vroeger een generator, maar nu zijn ze overgestapt op zonnepanelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8988776d-28a5-39a2-a9c6-5685a30e0440",
                        "entry_id": "7e2e4979-de73-36c9-b706-f789cd266949",
                        "glosses": [
                            "toestel tot het verkrijgen van gas"
                        ],
                        "tags": [],
