                    {
                        "translation_id": "6379e2d3-d7d7-411a-b192-e6d18132040a",
                        "source_entry_id": "72d80e0e-7118-3ea1-a3c3-09f524cb0ad3",
                        "source_sense_id": "a2567b3a-ff79-378e-8e3e-49879b5876fb",
                        "target_lang_word": "Marseille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marseille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5045fee0-f651-3861-92fe-67cd0987c859",
                                        "entry_id": "552ebfce-ddab-33c1-a0fc-305d3a6b5583",
