{
    "word_family": [
        "nose"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "675fb2c0-5089-3336-a098-f345434de09f",
                    "sense_definition": "A steep downward flight path of an aircraft.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "flight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot corrected the <w>nosedive</w> just before the plane hit the ground.",
                            "target_lang_translations": {
                                "cs": "Pilot vyrovnal <w>střemhlavý let</w> těsně předtím, než letadlo narazilo na zem."
                            }
                        },
                        {
                            "text": "The fighter jet went into a sudden <w>nosedive</w> during the air show.",
                            "target_lang_translations": {
                                "cs": "Stíhačka přešla během letecké přehlídky do náhlého <w>střemhlavého letu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dive"
                    ],
                    "common_phrases": [
                        "into a nosedive"
                    ],
                    "target_lang_definitions": {
                        "cs": "Strmý let letadla směrem dolů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strmý střemhlavý let",
                                "target_lang_sense_clarification": "letecký manévr"
                            },
                            {
                                "target_lang_word": "střemhlavý let",
                                "target_lang_sense_clarification": "obecný termín pro prudký sestup"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "548c2319-74e8-3269-9b30-ab4fdbbdeb70",
                    "sense_definition": "A sudden and significant decline in value, price, or success.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's stock took a <w>nosedive</w> after the poor quarterly report.",
                            "target_lang_translations": {
                                "cs": "Akcie společnosti zaznamenaly po špatné čtvrtletní zprávě <w>prudký propad</w>."
                            }
                        },
                        {
                            "text": "Public support for the policy went into a <w>nosedive</w> following the scandal.",
                            "target_lang_translations": {
                                "cs": "Veřejná podpora politiky po skandálu <w>prudce klesla</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slump",
                        "crash",
                        "plummet"
                    ],
                    "antonyms": [
                        "surge",
                        "boom"
                    ],
                    "common_phrases": [
                        "take a nosedive"
                    ],
                    "target_lang_definitions": {
                        "cs": "Náhlý a výrazný pokles hodnoty, ceny nebo úspěchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prudký propad",
                                "target_lang_sense_clarification": "ekonomický nebo metaforický pokles"
                            },
                            {
                                "target_lang_word": "strmý pád",
                                "target_lang_sense_clarification": "výrazný úpadek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420db052-2a02-3471-a719-cdf56a4df054",
                    "sense_definition": "A fall or jump made headfirst.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver performed a perfect <w>nosedive</w> into the deep pool.",
                            "target_lang_translations": {
                                "cs": "Skokan předvedl perfektní <w>skok po hlavě</w> do hlubokého bazénu."
                            }
                        },
                        {
                            "text": "He tripped and took a <w>nosedive</w> onto the soft grass.",
                            "target_lang_translations": {
                                "cs": "Zakopl a <w>padl po hlavě</w> do měkké trávy."
                            }
                        }
                    ],
                    "synonyms": [
                        "dive"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pád nebo skok provedený hlavou napřed."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skok po hlavě",
                                "target_lang_sense_clarification": "úmyslný pohyb do vody"
                            },
                            {
                                "target_lang_word": "pád po hlavě",
                                "target_lang_sense_clarification": "neúmyslný pohyb na zem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f34758c4-3e60-30c5-8fed-e0873bc43e23",
                    "sense_definition": "To move downward at a very steep angle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "flight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird began to <w>nosedive</w> toward the water to catch a fish.",
                            "target_lang_translations": {
                                "cs": "Pták začal <w>střemhlav letět</w> k hladině, aby chytil rybu."
                            }
                        },
                        {
                            "text": "The plane started to <w>nosedive</w> when the engine failed.",
                            "target_lang_translations": {
                                "cs": "Letadlo začalo <w>střemhlav padat</w>, když selhal motor."
                            }
                        }
                    ],
                    "synonyms": [
                        "dive",
                        "plummet"
                    ],
                    "antonyms": [
                        "soar",
                        "climb"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se směrem dolů pod velmi strmým úhlem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "letět střemhlav",
                                "target_lang_sense_clarification": "pohyb vzduchem"
                            },
                            {
                                "target_lang_word": "řítit se dolů",
                                "target_lang_sense_clarification": "rychlý sestup"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e3d7fe-f380-382b-9fcf-626c8aa91442",
                    "sense_definition": "To decrease rapidly in price, value, or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Profits began to <w>nosedive</w> as competition increased in the market.",
                            "target_lang_translations": {
                                "cs": "Zisky začaly <w>prudce klesat</w>, jak se na trhu zvyšovala konkurence."
                            }
                        },
                        {
                            "text": "The value of the currency started to <w>nosedive</w> overnight.",
                            "target_lang_translations": {
                                "cs": "Hodnota měny začala přes noc <w>prudce klesat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plummet",
                        "slump",
                        "crash"
                    ],
                    "antonyms": [
                        "soar",
                        "skyrocket"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle klesat v ceně, hodnotě nebo kvalitě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prudce klesat",
                                "target_lang_sense_clarification": "ekonomický kontext"
                            },
                            {
                                "target_lang_word": "propadnout se",
                                "target_lang_sense_clarification": "náhlý pokles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}