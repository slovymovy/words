                        ],
                        "form": "paparazzi"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d613f02-ca72-381c-99e0-e085d2f1bdbd",
                        "entry_id": "aecd91ca-1c81-3661-a815-37c578a2a83a",
                        "glosses": [
                            "Photographe qui a pour domaine de prédilection la vie privée des célébrités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045029fc-17a5-46b4-88db-d9baad43828e",
                                "sense_id": "7d613f02-ca72-381c-99e0-e085d2f1bdbd",
                                "text": "Jusqu’au coup de téléphone d’un paparazzo à Paris-Match, à la fin de l'été. — J’ai un scoop terrible, lance le photographe. — Viens montrer."
                            },
                            {
                                "example_id": "2b6b812f-261e-4290-81f4-75d7fb598aff",
                                "sense_id": "7d613f02-ca72-381c-99e0-e085d2f1bdbd",
                                "text": "Pour protéger le prince George du harcèlement d’un paparazzo et empêcher celui-ci de photographier l’enfant, âgé de 14 mois, ses parents, le duc et la duchesse de Cambridge, n’ont pas hésité à mobiliser leurs avocats."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f65ac04f-130c-44f1-9ab7-0e147c78e861",
                        "source_entry_id": "aecd91ca-1c81-3661-a815-37c578a2a83a",
                        "source_sense_id": "7d613f02-ca72-381c-99e0-e085d2f1bdbd",
                        "target_lang_word": "Paparazzo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paparazzo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ac0bcd-1d6d-3b5f-8440-889cc1e4f755",
                                        "entry_id": "b54eb3fd-c328-3b86-9ce8-6aa0411ae35e",
                                        "glosses": [
                                            "zumeist als Plural gebraucht (umgangssprachlich, oft abwertend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bffdb1e-0c98-4d39-9f81-541106b4b8a0",
                                                "sense_id": "c8ac0bcd-1d6d-3b5f-8440-889cc1e4f755",
                                                "text": "„Der Paparazzo, 25 Jahre jung und irgendwie sympathisch, sitzt im Fernsehstudio und erzählt, wie er Sharon Stone beim Knutschen, Cindy Crawford beim Joggen und Liz Taylor beim Futtern \"abgeschossen\" hat.“"
                                            },
                                            {
                                                "example_id": "4bff3bfc-9890-40af-907f-8cae0cd18b60",
                                                "sense_id": "c8ac0bcd-1d6d-3b5f-8440-889cc1e4f755",
                                                "text": "„In einem anderen Land wäre mein Vater bestimmt Paparazzo geworden.“"
                                            },
                                            {
                                                "example_id": "0b5982b4-a4ac-412b-be96-ad7b0174bac9",
                                                "sense_id": "c8ac0bcd-1d6d-3b5f-8440-889cc1e4f755",
                                                "text": "„Vor meinem Haus hinter Büschen hocken Paparazzi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fdcde66-2a3a-36c6-aa65-1d847c6828da",
                                        "entry_id": "b54eb3fd-c328-3b86-9ce8-6aa0411ae35e",
                                        "glosses": [
                                            "zumeist als Plural gebraucht (umgangssprachlich, oft abwertend)",
                                            "Pressefotograf, der sich darauf spezialisiert hat, aus sensationslüsternen Beweggründen als berühmt erachtete Persönlichkeiten in aufdringlicher Art und Weise nachzustellen um diese in indiskreten Situationen zu fotografieren"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "dd5e099e-cc30-3977-a28f-bc25c8e5fda0",
                                        "entry_id": "b54eb3fd-c328-3b86-9ce8-6aa0411ae35e",
                                        "glosses": [
                                            "zumeist als Plural gebraucht (umgangssprachlich, oft abwertend)",
                                            "Reporter, der mit reißerischen Berichten sensationslüstern vermeintlich skandalöse Ereignisse aufzubauschen sucht, um somit die Gunst der Leser-, Zuhörer- oder Zuschauerschaft zu erlangen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efe24c4e-48e3-49fb-8f5a-9161d28135ff",
                        "source_entry_id": "aecd91ca-1c81-3661-a815-37c578a2a83a",
                        "source_sense_id": "7d613f02-ca72-381c-99e0-e085d2f1bdbd",
                        "target_lang_word": "paparazzo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paparazzo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac61cc8b-6c88-36a6-9dfd-88471977e4ce",
                                        "entry_id": "6927a3ab-4330-3622-a0da-7495ecb0ab57",
                                        "glosses": [
                                            "A freelance photographer who sells photographs of celebrities to the media, especially one who pursues celebrities and attempts to obtain candid photographs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2404458-01ea-4582-b264-bd3bcf7b199c",
                                                "sense_id": "ac61cc8b-6c88-36a6-9dfd-88471977e4ce",
                                                "text": "That man with the camera over there is a paparazzo."
                                            },
                                            {
                                                "example_id": "4975ef5a-bbe5-419c-9e0c-919152e3b4cc",
                                                "sense_id": "ac61cc8b-6c88-36a6-9dfd-88471977e4ce",
                                                "text": "You may decide to shove the lens down the throat of your aggressor, in the style of an aggrieved celebrity seeking primal redress against a mischievous paparazzo; but then again, most ecstatic rituals are pacific in intent and you may find such violence inappropriate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2503386a-f93c-48be-94e5-768ba8695af5",
                        "source_entry_id": "aecd91ca-1c81-3661-a815-37c578a2a83a",
                        "source_sense_id": "7d613f02-ca72-381c-99e0-e085d2f1bdbd",
                        "target_lang_word": "paparazzi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paparazzi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e1d2940-219d-31db-b59b-263814486930",
                                        "entry_id": "6b1a577f-9f2a-36cd-b5f7-80957fa7039a",
                                        "glosses": [
                                            "plural of paparazzo"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4265972a-969e-41cb-9e86-0915f9738add",
                                                "sense_id": "0e1d2940-219d-31db-b59b-263814486930",
                                                "text": "A number of paparazzi had gate-crashed, as had a famous tennis-player and a couple of pop-singers."
                                            },
                                            {
                                                "example_id": "172a6a59-5ca6-453d-89f8-7ce7963dd3e3",
                                                "sense_id": "0e1d2940-219d-31db-b59b-263814486930",
                                                "text": "A number of paparazzi were there to take pictures, clearly having received a further tip-off about the party’s movements."
                                            },
                                            {
                                                "example_id": "237a1b6f-901a-4f1e-8e52-d91c17d837d7",
                                                "sense_id": "0e1d2940-219d-31db-b59b-263814486930",
                                                "text": "“Do you know how many paparazzi stalk those midtown hotels? […]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paparazzi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dadd52b-f15c-349e-9426-9abb4a401e2b",
                                        "entry_id": "ed8879eb-5d38-336e-bca4-9c1526bc6273",
                                        "glosses": [
                                            "A paparazzo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd88b21-3999-4841-b074-6a3e5037835e",
                                                "sense_id": "5dadd52b-f15c-349e-9426-9abb4a401e2b",
                                                "text": "The job of a paparazzi is, roughly, to ‘reveal the truth’ about the rich and the famous."
                                            },
                                            {
                                                "example_id": "910604a6-5a9f-411e-bd18-abfa42c262f0",
                                                "sense_id": "5dadd52b-f15c-349e-9426-9abb4a401e2b",
                                                "text": "A paparazzi is investigating the lives of a Royal couple."
                                            },
                                            {
                                                "example_id": "d5278440-888e-4c40-8aa5-f5c779305caf",
                                                "sense_id": "5dadd52b-f15c-349e-9426-9abb4a401e2b",
                                                "text": "What if someone I know sees me? Or what if a paparazzi is lurking somewhere?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9624f310-c607-380d-8273-6acaed9ca8ac",
                                        "entry_id": "ed8879eb-5d38-336e-bca4-9c1526bc6273",
                                        "glosses": [
                                            "Paparazzi taken as a group."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8dd37a5-d979-4a20-b9de-1eb6167eab10",
                                                "sense_id": "9624f310-c607-380d-8273-6acaed9ca8ac",
                                                "text": "“Tell Page that PAPARAZZI is here, in my apartment. And then tell her that their offices are right across from us …”"
                                            },
                                            {
                                                "example_id": "9e262f6c-73c5-4d66-ad29-f48dbd924766",
                                                "sense_id": "9624f310-c607-380d-8273-6acaed9ca8ac",
                                                "text": "Rather, the business paparazzi is armoring itself for a backlash campaign against the entrepreneurial big mouths."
                                            },
                                            {
                                                "example_id": "138baa92-0864-46a2-bcfb-326114619994",
                                                "sense_id": "9624f310-c607-380d-8273-6acaed9ca8ac",
                                                "text": "Nelishia—You are a special lady with an enormous heart with skills that are off the chains!!! You go girl!!! A definite multi-tasking Diva!! Get your Chanel shades paparazzi is lurking…lol"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
