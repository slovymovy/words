                        "sense_id": "fe5ad7c7-d049-309f-91f8-36ea20d46aea",
                        "entry_id": "0e68ffa0-819a-3374-ac87-788444cb17f0",
                        "glosses": [
                            "lichte, fijne as die door met de rookgassen door de schoorsteen ontsnapt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298d6edb-455d-41cd-bc1c-0af4161a4040",
                                "sense_id": "fe5ad7c7-d049-309f-91f8-36ea20d46aea",
                                "text": "In de jaren 90 kwam de Amercentrale enkele keren in het nieuws vanwege gevaarlijke stoffen. In november 1994 lekten tienduizenden liters zware stookolie weg. Dat gebeurde tijdens een test van de oliestookinstallatie. 2 jaar eerder kwam een elektriciteitsproductie-eenheid stil te liggen. Dat was nodig nadat een hoeveelheid stoom en vliegas was ontsnapt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae8ebde3-3f9b-4ea6-9ec3-18c216404fab",
                        "source_entry_id": "0e68ffa0-819a-3374-ac87-788444cb17f0",
                        "source_sense_id": "fe5ad7c7-d049-309f-91f8-36ea20d46aea",
                        "target_lang_word": "fly ash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fly ash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9399b15a-bb8a-3d13-859d-977619846b05",
                                        "entry_id": "63957219-1ba1-34c3-b2ac-755b3f06bc97",
                                        "glosses": [
                                            "A residue generated in the combustion of powdered coal or other materials, comprising the fine particles that rise with the flue gases; when generated industrially it is usually captured and can be recycled for use in construction materials."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27635d65-01be-4928-bcb9-ef6fda2270c5",
                                                "sense_id": "9399b15a-bb8a-3d13-859d-977619846b05",
                                                "text": "Heat exchangers should be kept free of debris to minimize the possibility of fire. Fly ash deposited in heat exchangers may cause nonuniform temperatures. Therefore, the exchangers should be disconnected and cleaned out regularly."
                                            },
                                            {
                                                "example_id": "7440cb9f-c3b6-420a-b548-004faa4743ec",
                                                "sense_id": "9399b15a-bb8a-3d13-859d-977619846b05",
                                                "text": "Among new freight vehicles was a prototype 21-ton wagon with pressure discharge for the conveyance of fly ash from power stations, […]"
                                            },
                                            {
                                                "example_id": "d00c98dc-e71f-46da-8b1c-89ea621b1aba",
                                                "sense_id": "9399b15a-bb8a-3d13-859d-977619846b05",
                                                "text": "Furnaces and boilers with horizontal heating surfaces require frequent cleaning, because fly ash (fine powdery ash) collects on these surfaces."
                                            },
                                            {
                                                "example_id": "0b2c7646-ddc0-4fbf-88f0-ad6821919b74",
                                                "sense_id": "9399b15a-bb8a-3d13-859d-977619846b05",
                                                "text": "Besides our sending out of cement by rail, we also bring in pulverised fly-ash, typically once a week, which comes from Drax Power Station and is used in the cement manufacturing process, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
