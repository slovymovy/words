                                "example_id": "afbc13a1-e2dd-4375-a9f3-4b94368396c0",
                                "sense_id": "8c0b5706-990b-3636-adec-ed66c8fefd70",
                                "text": "In de bijbel wordt het duizendjarig vredesrijk voorspeld na de dag des oordeels."
                            },
                            {
                                "example_id": "e45669e7-e951-4cf8-83a7-9401aed769cb",
                                "sense_id": "8c0b5706-990b-3636-adec-ed66c8fefd70",
                                "text": "Het duizendjarige rijk van de Nazi's heeft 12 jaar bestaan."
                            },
                            {
                                "example_id": "0386e3b0-4a13-4291-85c9-814a15745cdf",
                                "sense_id": "8c0b5706-990b-3636-adec-ed66c8fefd70",
                                "text": "Later in de geschiedenis veranderde de naam van het geslacht in de Chantery en de laatste in de mannelijke lijn van deze duizendjarige familie ben jij."
                            }
                        ]
