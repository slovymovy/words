                "senses": [
                    {
                        "sense_id": "610ab005-4a11-30d1-bee4-3fcd4c6ea4ad",
                        "entry_id": "8d5b934f-15c9-3b9a-a452-8cd2e6e2b9ab",
                        "glosses": [
                            "Munir un vaisseau d’engins de guerre."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d2256579-f740-4058-bd59-0178831f70f9",
                                "sense_id": "610ab005-4a11-30d1-bee4-3fcd4c6ea4ad",
                                "text": "De ma part, je fais toutes diligences pour artiller les six vaisseaux de Hollande."
                            },
                            {
                                "example_id": "a9d07c54-ed67-4c45-9885-5cfd128305cf",
                                "sense_id": "610ab005-4a11-30d1-bee4-3fcd4c6ea4ad",
                                "text": "Parce que je vous garantis, messieurs, qu'on va naviguer jusqu'à Montréal artillés comme des porte-avions."
                            }
                        ]
                    },
                    {
                        "sense_id": "f76d7703-269c-3307-9cb7-2a9fa782b000",
                        "entry_id": "8d5b934f-15c9-3b9a-a452-8cd2e6e2b9ab",
                        "glosses": [
                            "Travailler dur."
                        ],
                        "tags": [
                            "intransitive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "838c2f13-3462-4c10-b85f-5d79e568bacb",
                                "sense_id": "f76d7703-269c-3307-9cb7-2a9fa782b000",
                                "text": "La précédente nuit n’ayant pas dû être farineuse, ces courageuses, entendaient rebecqueter leur moyenne et, à en juger par l’équipement polaire que certaines avaient revêtu, artiller si besoin est jusqu’aux aurores."
                            }
                        ]
                    }
