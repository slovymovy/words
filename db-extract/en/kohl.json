                    {
                        "translation_id": "0d013cad-8f77-464a-81cb-7f35a72eecdc",
                        "source_entry_id": "3b10a04a-5156-36dc-9ac2-51f8029351a6",
                        "source_sense_id": "2f88fe52-7ac0-3736-8c9a-aba076c6f038",
                        "source_sense_description": "makeup",
                        "target_lang_word": "Kajal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kajal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7d5c06-cb8e-36e5-b80f-cc80d87f613a",
                                        "entry_id": "86fe656e-f845-3831-bf97-3d24d1ebc9c8",
                                        "glosses": [
                                            "ursprünglich aus teilweise giftigen dunkelfarbigen Mineralstoffen (Bleisulfid, Antimonsulfid, Mangandioxid), später aus dem Ruß verbrannten Butterschmalzes hergestellte schwarze Farbe zum Schminken der Augenränder, heute hauptsächlich als Stift für den Lidstrich benutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80599117-d182-4487-b667-92ecc0e4f64b",
                                                "sense_id": "ea7d5c06-cb8e-36e5-b80f-cc80d87f613a",
                                                "text": "„In Ägypten wurde der Kajal in Form eines schwarzen Pulvers verwendet, das in Alabasterschälchen aufbewahrt und mit einem dünnen Stäbchen aus Silber, Elfenbein, Horn oder Holz aufgetragen wurde.“"
                                            },
                                            {
                                                "example_id": "50e71922-c2a4-4ad7-b425-1e00abc20307",
                                                "sense_id": "ea7d5c06-cb8e-36e5-b80f-cc80d87f613a",
                                                "text": "„Ihre dick mit Kajal umrandeten Augen wirkten riesig in dem Gesicht mit dem hellen Teint und ließen sie wie einen Pandabär aussehen.“"
                                            },
                                            {
                                                "example_id": "5ee85a0d-6b50-4039-8dd3-92920ef3b704",
                                                "sense_id": "ea7d5c06-cb8e-36e5-b80f-cc80d87f613a",
                                                "text": "„Wie immer trug sie schwarzen Kajal, heute war sie aber ordentlich angezogen.“"
                                            },
                                            {
                                                "example_id": "d97b5a82-79a2-4d64-ad54-4fb37264b848",
                                                "sense_id": "ea7d5c06-cb8e-36e5-b80f-cc80d87f613a",
                                                "text": "„Thomas Gottschalk hat wieder mal mit dem Kajal übertrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe9bae98-dd38-36c6-9932-f32e9d487feb",
                                        "entry_id": "86fe656e-f845-3831-bf97-3d24d1ebc9c8",
                                        "glosses": [
                                            "Kurzform für Kajalstift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9dfa750-c4ef-4103-bdba-d1b30bbffd4a",
                                                "sense_id": "fe9bae98-dd38-36c6-9932-f32e9d487feb",
                                                "text": "„Beim Kauf des Kajals sollte man jedoch unbedingt darauf achten, dass der Stift nicht zu hart ist.“"
                                            },
                                            {
                                                "example_id": "f5857425-fe39-4aa7-8bac-2159f8eaf974",
                                                "sense_id": "fe9bae98-dd38-36c6-9932-f32e9d487feb",
                                                "text": "„Sie beschreibt ausführlich, wie Sisi sie um den Kajal gebeten hatte, weil sie ihren eigenen nicht finden konnte und nicht ohne Make-up zur Arbeit gehen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
