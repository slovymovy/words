                    },
                    {
                        "translation_id": "4e8bff69-4f41-486b-af8b-66572b49ef92",
                        "source_entry_id": "842e3563-d48d-3d34-aaca-008dccc3141f",
                        "source_sense_id": "0809e9b1-d219-3f24-8d1e-d38490e873aa",
                        "target_lang_word": "heucheln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heucheln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "304a4a77-0bef-3606-9c9a-23292f7fed7a",
                                        "entry_id": "30383baa-aaba-3acc-82b6-a5827e23c158",
                                        "glosses": [
                                            "sein wahres Ich verbergen und ein anderes Bild vortäuschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57088ddd-8622-491c-b1b6-cc2b38de251f",
                                                "sense_id": "304a4a77-0bef-3606-9c9a-23292f7fed7a",
                                                "text": "Du heuchelst hier den liebenden Vater und im Hotel wartet deine Geliebte!"
                                            },
                                            {
                                                "example_id": "224345a5-5427-4c0d-ab1e-5c607e0240fd",
                                                "sense_id": "304a4a77-0bef-3606-9c9a-23292f7fed7a",
                                                "text": "Niemand schien zu wissen, was er daraus machen sollte. Schließlich lachte man verlegen und heuchelte den Mutigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a37343d2-610b-3a66-8535-23543e98de63",
                                        "entry_id": "30383baa-aaba-3acc-82b6-a5827e23c158",
                                        "glosses": [
                                            "Anteilnahme oder auch andere Gefühle vortäuschen, oftmals trotz des inneren Gefühls der Gleichgültigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04bdb033-7c3c-4d83-be40-1ed198ff61e6",
                                                "sense_id": "a37343d2-610b-3a66-8535-23543e98de63",
                                                "text": "Sie heuchelte Zuneigung, wo bitterer Haß in ihrem Herzen wohnte."
                                            },
                                            {
                                                "example_id": "10b5b77f-53d2-4e2b-9fe8-f581248c073b",
                                                "sense_id": "a37343d2-610b-3a66-8535-23543e98de63",
                                                "text": "Du musst hier nicht Trauer und Betroffenheit heucheln."
                                            },
                                            {
                                                "example_id": "6232e484-3803-4685-9ea4-db73eac7fc04",
                                                "sense_id": "a37343d2-610b-3a66-8535-23543e98de63",
                                                "text": "„Sie sah Kurt Interesse heucheln, den Gesichtsausdruck kannte sie gut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
