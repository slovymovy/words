                "senses": [
                    {
                        "sense_id": "2dee3f85-047a-35fb-ad51-8b68723492f3",
                        "entry_id": "7f8bd877-a695-3177-aea6-d2da901846de",
                        "glosses": [
                            "abgegrenzter Bereich, der nicht von jedem nach Belieben betreten/befahren werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4a8953-f0ac-411f-a834-ff8c36b9bcf8",
                                "sense_id": "2dee3f85-047a-35fb-ad51-8b68723492f3",
                                "text": "„Kiebitze hatten sich längst aus der Sperrzone verzogen, ebenso waren die Fasane ausgewandert und die wilden, auf Stille angewiesenen Kaninchen.“"
                            },
                            {
                                "example_id": "7873128c-ae2b-43a4-863c-2a5749365bf7",
                                "sense_id": "2dee3f85-047a-35fb-ad51-8b68723492f3",
                                "text": "Die japanischen Behörden haben einen Teil der Sperrzone um das havarierte Atomkraftwerk Fukushima aufgehoben."
                            },
                            {
                                "example_id": "ede27d5d-774e-487f-a89f-121173ee2421",
                                "sense_id": "2dee3f85-047a-35fb-ad51-8b68723492f3",
                                "text": "„Das Schloss wurde zur Sperrzone erklärt, die Kunstschätze wurden sichergestellt und beschlagnahmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "183278ff-b16e-456d-8229-fb6be298f93f",
                        "source_entry_id": "7f8bd877-a695-3177-aea6-d2da901846de",
                        "source_sense_id": "2dee3f85-047a-35fb-ad51-8b68723492f3",
                        "source_sense_description": "abgegrenzter Bereich, der nicht von jedem nach Belieben betreten/befahren werden darf",
                        "target_lang_word": "exclusion zone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exclusion zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2ab8e79-a407-30db-a2f0-a456d29ba9b7",
                                        "entry_id": "f8d2d9a0-5eb9-38c5-bcba-7e481f2147e0",
                                        "glosses": [
                                            "A geographic area in which some sanctioning authority prohibits specific activities, see also Restricted Area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62f40a9e-d023-45b5-931e-feec4959b80d",
                                                "sense_id": "e2ab8e79-a407-30db-a2f0-a456d29ba9b7",
                                                "text": "Although the exclusion zone around each test case is the same for all inputs, the area of each zone decreases with successive attempts."
                                            },
                                            {
                                                "example_id": "cc4b1a3f-e1db-4e2c-80ed-6e8906046012",
                                                "sense_id": "e2ab8e79-a407-30db-a2f0-a456d29ba9b7",
                                                "text": "On 7 April, Britain declared a maritime exclusion zone (subsequently upgraded to a total exclusion zone on 28 April) of 200 nautical miles around the Islands."
                                            },
                                            {
                                                "example_id": "09f707d2-1a07-4a5a-a154-7cdde33af860",
                                                "sense_id": "e2ab8e79-a407-30db-a2f0-a456d29ba9b7",
                                                "text": "If the demolition is to use explosives, an exclusion zone must be established at a distance from and surrounding the structure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ada3c8fe-1b8e-4507-b22b-945dd01c2451",
                        "source_entry_id": "7f8bd877-a695-3177-aea6-d2da901846de",
                        "source_sense_id": "2dee3f85-047a-35fb-ad51-8b68723492f3",
