        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b0bb34f-160a-328a-8dc8-0ea69e72fc35",
                    "sense_definition": "Discussion or negotiation between two or more parties intended to reach an agreement, especially over terms of trade or employment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The union engaged in collective <w>bargaining</w> to secure fair wages for workers.",
                            "target_lang_translations": {
                                "nl": "De vakbond hield zich bezig met collectieve <w>onderhandelingen</w> om eerlijke lonen voor werknemers te waarborgen."
                            }
                        },
                        {
                            "text": "After weeks of intense <w>bargaining</w>, the two companies finally signed the deal.",
                            "target_lang_translations": {
                                "nl": "Na weken van intensieve <w>onderhandelingen</w> ondertekenden de twee bedrijven uiteindelijk de overeenkomst."
                            }
                        }
                    ],
                    "synonyms": [
                        "negotiation",
                        "haggling"
                    ],
                    "common_phrases": [
                        "collective bargaining",
                        "bargaining chip",
                        "bargaining power",
                        "bargaining position",
                        "bargaining table"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het overleg of de onderhandelingen tussen partijen om tot een overeenkomst te komen, met name over handels- of arbeidsvoorwaarden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onderhandelingen",
                                "target_lang_sense_clarification": "het proces van overleggen over voorwaarden"
                            },
                            {
                                "target_lang_word": "het afdingen",
                                "target_lang_sense_clarification": "het pogen een lagere prijs te krijgen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
