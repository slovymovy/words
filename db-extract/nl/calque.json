                        ]
                    },
                    {
                        "sense_id": "d6040d78-4adf-32f3-b403-9d7985fc03a5",
                        "entry_id": "2ce472be-eec1-3577-b51c-eedbb305ad9e",
                        "glosses": [
                            "een woord of woordgroep die is gevormd door middel van een één-op-één vertaling van de elementen uit een andere taal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2784cb2f-bbbf-42de-be6b-5f8ac9a4627f",
                                "sense_id": "d6040d78-4adf-32f3-b403-9d7985fc03a5",
                                "text": "Men kan opteren voor een lexicale vertaling of voor een calque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc260e54-eaea-42d1-a9d6-8f0aed7ecde7",
                        "source_entry_id": "2ce472be-eec1-3577-b51c-eedbb305ad9e",
                        "source_sense_id": "d6040d78-4adf-32f3-b403-9d7985fc03a5",
                        "source_sense_description": "een woord of woordgroep die is gevormd door middel van een één-op-één vertaling...",
                        "target_lang_word": "Lehnübersetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehnübersetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                        "entry_id": "c2497007-c934-362e-a5b6-91cebbc10a92",
                                        "glosses": [
                                            "ein (auch zusammengesetztes) Wort, das nach einem Fremdwort gebildet wurde, indem ein Ausgangswort (oder dessen Bestandteile, einzeln) übersetzt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1e91ad-b2c7-48f1-81d6-485605fc6fe7",
                                                "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                                "text": "Lehnübersetzungen und Lehnübertragungen sind eine gute Möglichkeit, eine Sprache zu bereichern, ohne als Fremdwort erkennbare und meist beim ersten Hören unverständliche Fremdwörter einzuführen."
                                            },
                                            {
                                                "example_id": "77768ce2-9552-487d-ae64-48443b3783ed",
                                                "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                                "text": "Ein Beispiel für eine Lehnübersetzung ist das deutsche Wort \"Halbwelt\", das eine genaue Übersetzung des französischen \"demi-monde\" darstellt."
                                            },
                                            {
                                                "example_id": "57c77560-87cf-4594-a620-d087710e8140",
                                                "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                                "text": "„Seit dem Mittelalter gibt es im Deutschen die Bezeichnung ‚Löwenzahn‘. Beide Wortbestandteile entsprechen - wenn auch in umgekehrter Reihenfolge - genau dem mittellateinischen ‚dens leonis‘ und dem altfranzösischen ‚dent de lion‘; daher sprechen wir hier von einer Lehnübersetzung.“"
                                            },
                                            {
                                                "example_id": "6a40d304-7c11-49c3-8211-1dec046af4a7",
                                                "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                                "text": "„Eine besondere Gruppe unter den Neuwörtern bilden die Lehnübersetzungen, also die Neuwörter, welche das Fremdwort wörtlich übersetzen…“"
                                            },
                                            {
                                                "example_id": "e06ffb5c-7b5b-453f-8ac7-370fc2c5ed22",
                                                "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                                "text": "„Dieser Purismus lexikalischer Art hat zur Folge, daß Bezeichnungen für neue Dinge oder für fremdsprachliche Ausdrücke mittels Lehnübersetzungen oder -prägungen in der Regel aus dem alten heimischen Wortmaterial (oder Teilen davon) gebildet werden müssen.“"
                                            },
                                            {
                                                "example_id": "064797ee-ee85-4ff5-befa-187aad558300",
                                                "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                                "text": "„Darüber hinaus haben Lehnübersetzungen und Lehnsyntax nach hebräischen Vorbildern die grammatische Struktur der Sprache in grundlegender Weise geprägt.“"
                                            },
                                            {
                                                "example_id": "b626943a-54f9-427d-b2aa-918d5f5ee074",
                                                "sense_id": "b80c1053-5b59-30be-bea7-ba60e3058897",
                                                "text": "„Die Wörter des Deutschen könnten denen des Englischen durchaus nachgebildet sein, sie wären dann Lehnübersetzungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41efc00d-ae9d-4079-8d50-c9142a761ed9",
                        "source_entry_id": "2ce472be-eec1-3577-b51c-eedbb305ad9e",
                        "source_sense_id": "d6040d78-4adf-32f3-b403-9d7985fc03a5",
                        "source_sense_description": "een woord of woordgroep die is gevormd door middel van een één-op-één vertaling...",
                        "target_lang_word": "calque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd7dcc1-0692-3a75-be12-8f6499b7eee4",
                                        "entry_id": "ba13fc45-cc69-3bd2-8cec-336bd461d1b3",
                                        "glosses": [
                                            "A word or phrase in a language formed by word-for-word or morpheme-by-morpheme translation of a word in another language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6930a94d-cf11-4e15-ae8a-7025ea675b7d",
                                                "sense_id": "1fd7dcc1-0692-3a75-be12-8f6499b7eee4",
                                                "text": "David S. Powers, professor of Islamic history and law at Cornell, says he thinks that the word as used today is in the nature of what linguists call a calque, a borrowing from another language in literal translation […]"
                                            },
                                            {
                                                "example_id": "7420839a-aa29-43b1-87f8-175876c50794",
                                                "sense_id": "1fd7dcc1-0692-3a75-be12-8f6499b7eee4",
                                                "text": "Those phrases, translated from Spanish, are known as calques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "450ea817-4129-373e-ac73-4735cbafa30e",
                                        "entry_id": "f2776b1f-9659-34f6-90d0-b5096add74e0",
                                        "glosses": [
                                            "To adopt (a word or phrase) from one language to another by semantic translation of its parts."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db6c554-48fe-4123-9ff7-012af8d2fdd5",
                                                "sense_id": "450ea817-4129-373e-ac73-4735cbafa30e",
                                                "text": "Terms like \"cloud computing\" have been calqued into multiple languages, making it easier for global audiences to grasp complex technological concepts. […] For example, translating Shakespeare's works into other languages often involves calquing phrases to maintain the rhythm and metaphorical richness of the original."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99fedc00-269c-4c2f-9d77-4eae966507d3",
                        "source_entry_id": "2ce472be-eec1-3577-b51c-eedbb305ad9e",
                        "source_sense_id": "d6040d78-4adf-32f3-b403-9d7985fc03a5",
