                                        "entry_id": "ea3c0d24-aa2b-3cb4-b495-0b6adf717860",
                                        "glosses": [
                                            "A service that mixes potentially identifiable or 'tainted' cryptocurrency funds with others, so as to obscure the audit trail; used for money laundering."
                                        ],
                                        "tags": [],
