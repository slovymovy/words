                        "entry_id": "e05c6024-54fd-3c11-bbb1-a7633e7f24f0",
                        "glosses": [
                            "Qui concerne l’ordinal ou la fraction cent-un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cc583be-8552-43e8-84a3-8f7e004f2385",
                                "sense_id": "c246a221-6478-36f9-90d7-cca4fe49694b",
                                "text": "Le cent-unième anniversaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b60f3e2-7312-4500-bbb1-fbbaf1133257",
                        "source_entry_id": "e05c6024-54fd-3c11-bbb1-a7633e7f24f0",
                        "source_sense_id": "c246a221-6478-36f9-90d7-cca4fe49694b",
                        "source_sense_description": "Ordinal",
                        "target_lang_word": "hunderterste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunderterste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52443f69-9069-35e3-806c-d349f6aa18ba",
                                        "entry_id": "8b272570-873e-38be-a537-1b0c4cc7e161",
                                        "glosses": [
                                            "nach dem oder der hundertsten kommend; in einer Reihenfolge an Stelle hunderteins"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97a9579f-3ed9-4057-8c64-7aacf3d85320",
                                                "sense_id": "52443f69-9069-35e3-806c-d349f6aa18ba",
                                                "text": "„Dort ist es üblich, in der Angst vor Tod und Verdammnis die hunderterste Sure zu beten.“"
                                            },
                                            {
                                                "example_id": "ff0eaabb-fbec-49c5-9057-4da776c58996",
                                                "sense_id": "52443f69-9069-35e3-806c-d349f6aa18ba",
                                                "text": "„Wenn Sie tatsächlich irgendetwas hundertmal vergeblich geäußert haben, angeordnet, bemäkelt oder was weiß ich, dann können Sie sich das hunderterste Mal beruhigt schenken.“"
                                            },
                                            {
                                                "example_id": "2ae3005d-ff8f-4fcb-8ccc-c99c610700ce",
                                                "sense_id": "52443f69-9069-35e3-806c-d349f6aa18ba",
                                                "text": "„Der hundertste der Gehenkten erhielt einen weißen Blumenstrauß, weil er der hundertste war. Der hunderterste der Gehenkten war sehr unglücklich, daß er nicht der hundertste geworden war.“"
                                            },
                                            {
                                                "example_id": "6a446c96-c128-42e4-a1e5-bff390db6f7c",
                                                "sense_id": "52443f69-9069-35e3-806c-d349f6aa18ba",
                                                "text": "„Bücher sollen nicht ausgestellt, nicht verkauft werden dürfen, auch an hundert Erwachsene nicht, weil der hunderterste Käufer ein Jugendlicher sein könnte!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
