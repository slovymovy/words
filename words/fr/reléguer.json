{
    "word_family": [
        "relégation",
        "relégable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d79c2510-5846-39ea-bc93-38acf757f71d",
                    "sense_definition": "Rejeter ou maintenir une personne ou une idée dans une fonction subalterne ou au second plan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle stratégie risque de <w>reléguer</w> notre projet prioritaire au second plan."
                        },
                        {
                            "text": "Après la restructuration de l'entreprise, la direction l'a <w>relégué</w> à des tâches administratives sans intérêt."
                        }
                    ],
                    "synonyms": [
                        "rétrograder",
                        "marginaliser",
                        "subordonner"
                    ],
                    "antonyms": [
                        "promouvoir",
                        "valoriser"
                    ],
                    "common_phrases": [
                        "reléguer au second plan",
                        "reléguer en division inférieure"
                    ]
                },
                {
                    "sense_id": "2d53a249-4cec-3f2d-9d34-2656ba5c3799",
                    "sense_definition": "Mettre à l'écart un objet dans un endroit retiré, abandonné ou obscur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons décidé de <w>reléguer</w> ces vieux meubles au grenier pour faire de la place."
                        },
                        {
                            "text": "Il <w>relègue</w> souvent ses tableaux inachevés dans un débarras sombre au fond du jardin."
                        }
                    ],
                    "synonyms": [
                        "remiser",
                        "entasser"
                    ],
                    "antonyms": [
                        "exposer",
                        "arborer"
                    ],
                    "common_phrases": [
                        "reléguer au grenier",
                        "reléguer au fond d'un placard"
                    ]
                },
                {
                    "sense_id": "b109b20f-9067-323e-83e4-fc7596568014",
                    "sense_definition": "Envoyer une personne en exil ou la confiner dans un lieu éloigné et isolé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'Ancien Régime, le monarque pouvait <w>reléguer</w> ses opposants sur une île lointaine."
                        },
                        {
                            "text": "L'empereur a <w>relégué</w> le poète rebelle aux frontières les plus hostiles de la province."
                        }
                    ],
                    "synonyms": [
                        "exiler",
                        "bannir",
                        "déporter"
                    ],
                    "antonyms": [
                        "rapatrier",
                        "rappeler"
                    ],
                    "common_phrases": [
                        "reléguer dans une île",
                        "être relégué en exil"
                    ]
                }
            ]
        }
    ]
}