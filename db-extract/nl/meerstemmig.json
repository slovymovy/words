                        ],
                        "examples": [
                            {
                                "example_id": "5981c8e8-3a2c-46de-b12d-a91de52c1b09",
                                "sense_id": "6c85cd3f-92e8-390a-8cf8-b013d210beb2",
                                "text": "Subtiel en meerstemmig verbeeldt Lanoye hoe zijn moeder hem steunde, in haar greep had en dwong om zich van haar te ontdoen. (...) Opvallend is hoe de auteur in zijn kroniek de diepste lagen van zijn gevoel niet in woorden giet en zich schijnbaar afhoudt van zijn verdriet over haar overlijden. (...) Lanoye kiest heel geslaagd voor de barokke schijnbeweging, voor cirkels rond de lege kern."
                            }
                        ]
                    }
