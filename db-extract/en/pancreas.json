        "de-extract.jsonl": [
            {
                "entry_id": "21f7d37d-9293-3388-93f3-b829fadfd1ce",
                "word": "pancreas",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96a804dd-4ddb-3a5a-886e-fa3eca7b81b2",
                        "entry_id": "21f7d37d-9293-3388-93f3-b829fadfd1ce",
                        "glosses": [
                            "Bauchspeicheldrüse, Pankreas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae631ca8-95ea-4cab-b897-0815f3f885c5",
                                "sense_id": "96a804dd-4ddb-3a5a-886e-fa3eca7b81b2",
                                "text": "\"Our recognition of neoplasms of the pancreas has markedly increased in frequency in the last 60 years. They account for nearly one third of all pancreatic diseases.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e84e812a-5abd-4113-b83e-05ae3a13d7d9",
                        "source_entry_id": "21f7d37d-9293-3388-93f3-b829fadfd1ce",
                        "source_sense_id": "96a804dd-4ddb-3a5a-886e-fa3eca7b81b2",
                        "source_sense_description": "Anatomie: Bauchspeicheldrüse, Pankreas",
                        "target_lang_word": "Bauchspeicheldrüse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauchspeicheldrüse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                        "entry_id": "7fb5ea63-2e93-3068-ab85-0fca14e35d21",
                                        "glosses": [
                                            "exokrine, Verdauungsenzyme produzierende, dem Stoffwechsel dienende und endokrine, zur Regulation des Glukosehaushaltes Hormone ausschüttende Drüse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c688483-db88-40b1-a9af-2596aff77752",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Die Bauchspeicheldrüse produziert während der Liebkosung verstärkt Insulin und die Nebenniere Adrenalin.“"
                                            },
                                            {
                                                "example_id": "6ed5bd7f-71f4-4eb0-9cb1-0cbb6f4b408d",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Die Nebennieren produzieren mehr Adrenalin und die Bauchspeicheldrüse mehr Insulin.“"
                                            },
                                            {
                                                "example_id": "c2a05661-9768-420a-bb12-17f40c7acd96",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Krebs der Bauchspeicheldrüse hat eine ungemein schlechte Prognose.“"
                                            },
                                            {
                                                "example_id": "ace995ce-f779-4b83-a2ee-ca8eb0835419",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Trotzdem hatte im 17. Jahrhundert Decker zwanzig Dekaliter pro Tag verordnet, um den Sumpf der Bauchspeicheldrüse zu reinigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45f55461-4a5a-4773-8b03-d03f2e4558a3",
                        "source_entry_id": "21f7d37d-9293-3388-93f3-b829fadfd1ce",
                        "source_sense_id": "96a804dd-4ddb-3a5a-886e-fa3eca7b81b2",
                        "source_sense_description": "Anatomie: Bauchspeicheldrüse, Pankreas",
                        "target_lang_word": "Pankreas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pankreas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                        "entry_id": "ea086a87-d1af-3db4-8712-9cedd33526b3",
                                        "glosses": [
                                            "exokrine, Verdauungsenzyme produzierende, dem Stoffwechsel dienende und endokrine, zur Regulation des Glukosehaushaltes Hormone ausschüttende Drüse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d7c21c-5651-4b16-9f3c-74719ba81649",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Das Pankreas ist 80-120 g schwer und ca. 20 cm lang."
                                            },
                                            {
                                                "example_id": "94728e96-07a7-44b3-a21c-f512d6594603",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Merke: Das Pankreas gliedert sich in Kopf (mit Processus uncinatus), Körper und Schwanz. Der Schwanz \"leckt am Milz-Hilum\"."
                                            },
                                            {
                                                "example_id": "07dda4e7-b5ea-432a-9f48-2795159afdcf",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Eine häufige Erkrankung des Pankreas ist der Diabetes mellitus, gefolgt von Pankreatitis, Pankreaskarzinom und Mukoviszidose."
                                            },
                                            {
                                                "example_id": "447e78d6-f398-454b-9209-f9c1509a7e20",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Tatsächlich zeigten die Mäuse ohne funktionierendes p16 zwar im Alter vergleichsweise muntere Zellen in Pankreas, Knochenmark und Hirn, litten und starben aber viel häufiger an Krebs."
                                            },
                                            {
                                                "example_id": "8547e202-d8fb-4af6-8dc3-37e2111e685a",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Von allen Krebserkrankungen an der Bauchspeicheldrüse (Pankreas) könnten nur 20 Prozent operiert werden, und von diesen Patienten wiederum lebten fünf Jahre später nur noch 20 Prozent, erklärte Issels."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
