                "senses": [
                    {
                        "sense_id": "aa4a1074-cd52-3aba-ab63-496cd06195e6",
                        "entry_id": "e182d957-a033-3862-b594-e5fb763c5fc0",
                        "glosses": [
                            "in één stap groter kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07030654-f1c7-40d7-9f3b-f7b21d4abcbf",
                                "sense_id": "aa4a1074-cd52-3aba-ab63-496cd06195e6",
                                "text": "Als je denkt dat het niet nóg gekker kan dan een broodrooster, een toevoer voor olijfolie en een aluminium wastafel, dan zijn de volgende snufjes misschien wel het toppunt voor de ultieme keuken. Zo is er een lade voor diverse kruiden, een pastamachine, een slow-cooker en heeft de wagen zelfs een uitklapbaar tafelblad ínclusief kookplaten, dat ook als eettafel gebruikt kan worden."
                            },
                            {
                                "example_id": "85dfd724-68c1-4de7-841b-d24b5d2df6c7",
                                "sense_id": "aa4a1074-cd52-3aba-ab63-496cd06195e6",
                                "text": "De miniplayer is ook uitklapbaar. Hierdoor worden de hoezen van cd's zichtbaar."
                            },
                            {
                                "example_id": "18dddf95-12eb-4f87-8a42-25c60119b830",
                                "sense_id": "aa4a1074-cd52-3aba-ab63-496cd06195e6",
                                "text": "Toen de agenten de man en zijn auto controleerden, troffen ze een uitklapbaar mes en patronen - oftewel munitie - aan. Ook bleek de man niet in het bezit van een geldig rijbewijs en had hij een geldboete openstaan van enkele honderden euro's."
                            }
                        ]
                    }
