                    {
                        "sense_id": "4270811c-5946-3d70-b473-3891435b6832",
                        "entry_id": "bc1d3ae5-82e2-3ba6-a4ab-f88a985cadb1",
                        "glosses": [
                            "das Ändern der Grundtonart eines Musikstücks"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "a14fc2b9-4e41-47ef-8abe-f330e6032b57",
                                "sense_id": "4270811c-5946-3d70-b473-3891435b6832",
                                "text": "Die Transposition kann z. B. dem Zweck dienen, dem Spieler das Spielen mehrerer gleichartiger Instrumente, die in verschiedenen Stimmungen gebaut sind, zu erleichtern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f9d1b217-8076-3320-be5b-a2e3c0f432cd",
                        "entry_id": "bc1d3ae5-82e2-3ba6-a4ab-f88a985cadb1",
                        "glosses": [
                            "das Erzeugen einer neuen Bezeichnungsklasse mit Hilfe der Ableitung; Überführung von einer Wortklasse in eine andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf3ad0b-84a2-4305-8db5-e18178037245",
                                "sense_id": "f9d1b217-8076-3320-be5b-a2e3c0f432cd",
                                "text": "Die folgenden Wortartwechsel sind Beispiele für Transpositionen: prüfen → Prüfung, Angst → sich ängstigen, schön → verschönern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "df68ab13-acd0-3e42-bc19-5806e7e878df",
                        "entry_id": "bc1d3ae5-82e2-3ba6-a4ab-f88a985cadb1",
                        "glosses": [
                            "Umstellung/Vertauschung von Lauten"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "d9e5334d-3c73-40ca-aa32-44a1ea0d568c",
                                "sense_id": "df68ab13-acd0-3e42-bc19-5806e7e878df",
                                "text": "Das Wort „Born“ ist durch Transposition (Metathese) des aus dem Wort „Brunnen“ hervorgegangen."
                            }
                        ],
                        "sense_index_json": "\"3\""
