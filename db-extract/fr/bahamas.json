                                                "sense_id": "33262a8e-f5fe-3695-817b-835df805370c",
                                                "text": "Wir fahren auf die Bahamas."
                                            },
                                            {
                                                "example_id": "fbed0906-c2ec-4ae8-bbe6-9563caf4c729",
                                                "sense_id": "33262a8e-f5fe-3695-817b-835df805370c",
                                                "text": "„Haupterwerbszweig der Bahamas ist der Tourismus, in dem etwa 60 % der erwerbstätigen Bevölkerung beschäftigt sind.“"
                                            },
                                            {
                                                "example_id": "6774c068-e429-4944-9bc3-14fb4372226b",
                                                "sense_id": "33262a8e-f5fe-3695-817b-835df805370c",
                                                "text": "Nassau ist die Hauptstadt der Bahamas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
