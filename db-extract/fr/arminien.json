                ],
                "senses": [
                    {
                        "sense_id": "3a40db2b-7396-3f58-90b6-ce8c59bda285",
                        "entry_id": "4db7ee6a-1ba6-3f8d-8c89-0982a2188dc5",
                        "glosses": [
                            "Celui qui suit la doctrine de l'arminianisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3282d2c-8f9d-49fe-a0eb-1c15c8021fca",
                                "sense_id": "3a40db2b-7396-3f58-90b6-ce8c59bda285",
                                "text": "L'arminianisme évangélique est fondé sur les cinq points des Remontrants. Un arminien évangélique est quelqu’un qui croit que Dieu, en Christ, étend son amour à tous les hommes et que chacun est responsable personnellement de son attitude par rapport à cet amour."
                            },
                            {
                                "example_id": "faa4ca5e-3b05-480f-bb4f-f050d3460517",
                                "sense_id": "3a40db2b-7396-3f58-90b6-ce8c59bda285",
                                "text": "L’arminien qui a cherché à examiner les dogmes du christianisme a donc rapproché insensiblement ces dogmes des idées que la raison nous fournit."
                            }
                        ]
                    }
                ],
