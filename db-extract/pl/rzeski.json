                    {
                        "sense_id": "e067b06a-a190-336e-8136-089c374dfa1a",
                        "entry_id": "9c6d3e25-acfa-3125-b1d3-0b66195eadc4",
                        "glosses": [
                            "mit dem Reich, meist mit dem Deutschen Reich zusammenhängend; reichisch, Reichs-"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6a260534-750b-4533-bf6f-1e10fce9e234",
                                "sense_id": "e067b06a-a190-336e-8136-089c374dfa1a",
                                "text": "„Dwakroć jeździł na sejm rzeski do Kwedlimburgu.“"
                            },
                            {
                                "example_id": "40a2e2b6-aa1c-448f-8876-f024799e36fc",
                                "sense_id": "e067b06a-a190-336e-8136-089c374dfa1a",
                                "text": "„ Przezacni panowie! nie czyńcie z królestwa polskiego niemieckiego rzeskiego miasta;“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f09161d-6d7b-4c87-88b5-c155c2e2408b",
                        "source_entry_id": "9c6d3e25-acfa-3125-b1d3-0b66195eadc4",
                        "source_sense_id": "e067b06a-a190-336e-8136-089c374dfa1a",
                        "source_sense_description": "veraltet, Politik: mit dem Reich, meist mit dem Deutschen Reich zusammenhängend; reichisch, Reichs-",
                        "target_lang_word": "reichisch",
