                    {
                        "sense_id": "8c345d21-b827-3815-83cf-81e61daa2fc2",
                        "entry_id": "167e3841-3acd-3d2a-ad71-af8e9d68ae8c",
                        "glosses": [
                            "light year (astronomical distance taking a year at light speed)"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "76423b86-ebda-4f15-b4a5-229e08a1e4f9",
                                "sense_id": "8c345d21-b827-3815-83cf-81e61daa2fc2",
                                "text": "Die ster staat vijf lichtjaren van ons vandaan.",
                                "translation": "That star is five light years away from us.",
                                "english": "That star is five light years away from us."
                            },
                            {
                                "example_id": "a0aa40b0-2f18-42d8-956f-976317514762",
                                "sense_id": "8c345d21-b827-3815-83cf-81e61daa2fc2",
                                "text": "Een lichtjaar is een enorme afstand in de ruimte.",
                                "translation": "A light year is an immense distance in space.",
                                "english": "A light year is an immense distance in space."
                            },
                            {
                                "example_id": "dcf397ab-876e-4d0d-b3b9-f6ea509e45d3",
                                "sense_id": "8c345d21-b827-3815-83cf-81e61daa2fc2",
                                "text": "De dichtstbijzijnde ster is meer dan vier lichtjaren weg.",
                                "translation": "The nearest star is more than four light years away.",
                                "english": "The nearest star is more than four light years away."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
