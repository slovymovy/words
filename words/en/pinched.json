{
    "word_family": [
        "pinch",
        "pincher"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b7221d63-ca50-3fa9-8047-501a51d710c0",
                    "sense_definition": "Very thin or drawn together in appearance",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy had a <w>pinched</w> face from not eating enough food.",
                            "target_lang_translations": {
                                "nl": "De jongen had een <w>ingevallen</w> gezicht omdat hij niet genoeg te eten kreeg."
                            }
                        },
                        {
                            "text": "She looked at him with a <w>pinched</w> expression of worry.",
                            "target_lang_translations": {
                                "nl": "Ze keek hem aan met een <w>getekende</w> uitdrukking van zorg."
                            }
                        }
                    ],
                    "synonyms": [
                        "gaunt",
                        "haggard",
                        "thin"
                    ],
                    "antonyms": [
                        "plump",
                        "full"
                    ],
                    "common_phrases": [
                        "pinched face"
                    ],
                    "target_lang_definitions": {
                        "nl": "Erg mager of ingevallen van uiterlijk"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ingevallen",
                                "target_lang_sense_clarification": "vaak gebruikt voor een gezicht dat mager of vermoeid oogt"
                            },
                            {
                                "target_lang_word": "mager",
                                "target_lang_sense_clarification": "algemene term voor dun of tenger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28a76808-872e-33fc-8145-9775c41365c5",
                    "sense_definition": "Tense and pale due to cold, worry, or hunger",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>pinched</w> features showed how much the cold winter had affected him.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>bleke, gespannen</w> gelaatstrekken lieten zien hoeveel de koude winter hem had aangegrepen."
                            }
                        },
                        {
                            "text": "After days of stress, she had a <w>pinched</w> look on her face.",
                            "target_lang_translations": {
                                "nl": "Na dagen van stress had ze een <w>getekende</w> blik op haar gezicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "drawn",
                        "pale",
                        "wan"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gespannen en bleek door kou, zorgen of honger"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "getekend",
                                "target_lang_sense_clarification": "wanneer iemands gezicht sporen van stress of lijden vertoont"
                            },
                            {
                                "target_lang_word": "bleek",
                                "target_lang_sense_clarification": "vanwege kou of ziekte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5642296b-6df0-3253-965e-a47cdf5698e9",
                    "sense_definition": "Compressed or squeezed, often referring to a nerve",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor said he had a <w>pinched</w> nerve in his lower back.",
                            "target_lang_translations": {
                                "nl": "De dokter zei dat hij een <w>beknelde</w> zenuw in zijn onderrug had."
                            }
                        },
                        {
                            "text": "She felt pain in her shoulder from a <w>pinched</w> nerve.",
                            "target_lang_translations": {
                                "nl": "Ze voelde pijn in haar schouder door een <w>beknelde</w> zenuw."
                            }
                        }
                    ],
                    "synonyms": [
                        "compressed",
                        "squeezed"
                    ],
                    "common_phrases": [
                        "pinched nerve"
                    ],
                    "target_lang_definitions": {
                        "nl": "Samengedrukt of bekneld, vaak gebruikt bij een zenuw"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bekneld",
                                "target_lang_sense_clarification": "specifiek voor een zenuw die vastzit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcb784ec-417d-3f02-8d06-2868c391bb78",
                    "sense_definition": "Experiencing financial hardship or lack of money",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families are feeling <w>pinched</w> by the rising cost of living.",
                            "target_lang_translations": {
                                "nl": "Veel gezinnen zitten <w>krap bij kas</w> door de stijgende kosten van levensonderhoud."
                            }
                        },
                        {
                            "text": "The company is <w>pinched</w> for cash after the recent market crash.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf zit <w>krap bij kas</w> na de recente beurscrash."
                            }
                        }
                    ],
                    "synonyms": [
                        "strapped",
                        "broke"
                    ],
                    "antonyms": [
                        "wealthy",
                        "prosperous"
                    ],
                    "common_phrases": [
                        "pinched for cash"
                    ],
                    "target_lang_definitions": {
                        "nl": "Financiële moeilijkheden ervarend of geldgebrek hebbend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "krap bij kas",
                                "target_lang_sense_clarification": "idiomatische uitdrukking voor geldgebrek"
                            },
                            {
                                "target_lang_word": "financieel onder druk",
                                "target_lang_sense_clarification": "formelere beschrijving van geldnood"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b2219b8-b7f2-3478-9ec7-853d605399ed",
                    "sense_definition": "Past tense and past participle of <w>pinch</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pinched</w> his arm to make sure he was not dreaming.",
                            "target_lang_translations": {
                                "nl": "Hij <w>kneep</w> in zijn arm om er zeker van te zijn dat hij niet droomde."
                            }
                        },
                        {
                            "text": "The thief was <w>pinched</w> by the police while trying to escape.",
                            "target_lang_translations": {
                                "nl": "De dief werd door de politie <w>gepakt</w> terwijl hij probeerde te ontsnappen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van knijpen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kneep",
                                "target_lang_sense_clarification": "verleden tijd van knijpen"
                            },
                            {
                                "target_lang_word": "geknepen",
                                "target_lang_sense_clarification": "voltooid deelwoord van knijpen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}