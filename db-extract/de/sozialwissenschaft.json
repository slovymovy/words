                "senses": [
                    {
                        "sense_id": "3063556b-85b2-3da0-a7d6-9c0c35d3dba5",
                        "entry_id": "de5ae74b-c262-3bc1-9b44-92e0eb9a48b3",
                        "glosses": [
                            "Wissenschaft, die Phänomene des gesellschaftlichen Zusammenlebens der Menschen untersucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e8c349-8099-4d5e-ad70-2f08eba43c0d",
                                "sense_id": "3063556b-85b2-3da0-a7d6-9c0c35d3dba5",
                                "text": "Weit davon entfernt, sich hemmungslos ausbreiten zu dürfen, steht der wissenschaftliche Fortschritt unter Generalverdacht. \"Werte\" sind nicht im Niedergang, wohl aber die Paradigmen der Sozialwissenschaften. Diese messen Kirchenaustritte, sinkende Mitgliedszahlen in Gewerkschaften oder die Zunahme von Ehescheidungen und folgern, in der Gesellschaft wachse soziale Atomisierung."
                            },
                            {
                                "example_id": "6ab8cf54-c864-4554-af95-9320ba84edfc",
                                "sense_id": "3063556b-85b2-3da0-a7d6-9c0c35d3dba5",
                                "text": "Nachdem er Theologie und Sozialwissenschaft studiert hatte, war er neben seiner Priestertätigkeit auch journalistisch tätig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6080b206-541d-47c2-9cd7-59362bd3dd50",
                        "source_entry_id": "de5ae74b-c262-3bc1-9b44-92e0eb9a48b3",
                        "source_sense_id": "3063556b-85b2-3da0-a7d6-9c0c35d3dba5",
                        "source_sense_description": "Wissenschaft, die Phänomene des gesellschaftlichen Zusammenlebens der Menschen untersucht",
                        "target_lang_word": "social science",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "social science",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8459a067-3be2-3887-a637-0ff439d168a2",
                                        "entry_id": "0e3ca57c-13d7-389f-b3a6-e9010ef67478",
                                        "glosses": [
                                            "A branch of science that studies the society and human behavior in it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d625e5-b63b-4dc8-8c1f-a9af8f4aabff",
                                                "sense_id": "8459a067-3be2-3887-a637-0ff439d168a2",
                                                "text": "During the late 1950s and throughout the 1960s, this commitment brought him into frequent critical confrontation with entrenched forms of conservative thinking (in academic areas from history and social science to the more abstract domains of ethical and political philosophy)[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7784ccec-c495-4d07-8d56-8cb4cba87c59",
                        "source_entry_id": "de5ae74b-c262-3bc1-9b44-92e0eb9a48b3",
                        "source_sense_id": "3063556b-85b2-3da0-a7d6-9c0c35d3dba5",
