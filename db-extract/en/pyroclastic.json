                        "target_lang_word": "pyroklastisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyroklastisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "309460a6-6591-30dc-a0c4-5ede4238f162",
                                        "entry_id": "b0211384-2623-342d-9c1b-c53ff27a2ae2",
                                        "glosses": [
                                            "aus heißen, rasend schnell talwärts strömenden Gasen, Asche und klastischem Gestein (Trümmergestein) vulkanischen Ursprungs bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4322f229-972b-4319-8c8c-8565cf36bcb9",
                                                "sense_id": "309460a6-6591-30dc-a0c4-5ede4238f162",
                                                "text": "Typische Vertreter von pyroklastischen Gesteinen sind Tuff und Bimsstein."
                                            },
                                            {
                                                "example_id": "4876e51f-235c-4f33-8cba-638d22a6f363",
                                                "sense_id": "309460a6-6591-30dc-a0c4-5ede4238f162",
                                                "text": "Schon an der nördlichen Stadtmauer Pompejis liefen die beiden in die nächste Attacke des Vulkans: Die kollabierende Eruptionssäule drückte pyroklastische Ströme die Hänge des Vesuv hinab – glutheiße Gasschwaden, gemischt mit zersprühter Lava, deren Wucht ganze Mauern um Meter versetzte."
                                            },
                                            {
                                                "example_id": "624f4308-c4be-4a54-b504-45557fe53574",
                                                "sense_id": "309460a6-6591-30dc-a0c4-5ede4238f162",
                                                "text": "Diese pyroklastischen Ströme sind über 800 Grad heiß und schneller als ein Formel-1-Rennwagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
