                                    {
                                        "sense_id": "5f905607-03b5-3211-b06c-31549158f1ab",
                                        "entry_id": "f61d137c-a91b-3da2-a7b0-514ba883a748",
                                        "glosses": [
                                            "rasa psów o niskim wzroście, długim tułowiu i krótkich nogach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44728aa0-b0c7-4068-be74-18cd26cc7284",
                                                "sense_id": "5f905607-03b5-3211-b06c-31549158f1ab",
                                                "text": "Głośno szczekający jamnik bywa nieufny wobec obcych."
                                            },
                                            {
                                                "example_id": "6e689894-99e4-4834-9ec0-ccaddf7b40a5",
                                                "sense_id": "5f905607-03b5-3211-b06c-31549158f1ab",
                                                "text": "W ogóle rasy typu pekińczyk czy ratlerek odeszły w zapomnienie, mamy za to miniatury jamnika (to już obłęd, żeby z czegoś tak małego robić jeszcze ekstrakt), boksera, terriera."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "2833492d-9ae9-3c9b-868f-f1c384d32b4c",
                                        "entry_id": "f61d137c-a91b-3da2-a7b0-514ba883a748",
                                        "glosses": [
                                            "pies rasy jamnik (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89c0cc4-714c-4660-952f-948bdba8644b",
                                                "sense_id": "2833492d-9ae9-3c9b-868f-f1c384d32b4c",
                                                "text": "Na wycieraczce załatwił się jamnik naszych sąsiadów."
                                            },
                                            {
                                                "example_id": "a241f718-2bf4-498d-b51b-ffb6a38b60ae",
                                                "sense_id": "2833492d-9ae9-3c9b-868f-f1c384d32b4c",
                                                "text": "Jego żona, która również od czasu do czasu w zastępstwie wyprowadzała jamnika, miała dla męża nieskończoną cierpliwość, wpasowała się w jego życie na takiej samej zasadzie, jak towarzyszki marynarzy muszą zaakceptować okresy wielomiesięcznej rozłąki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "c51123be-bb73-3934-905f-269ee5c748bc",
