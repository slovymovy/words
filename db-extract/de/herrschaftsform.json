                "senses": [
                    {
                        "sense_id": "a0956b76-58d2-3994-a406-8a6db3e2874b",
                        "entry_id": "3af2a1ad-f8ae-3480-a876-235818687d7d",
                        "glosses": [
                            "Form einer Herrschaft, die danach bestimmt wird, wer sie ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815b727d-4a01-4bb6-a2b3-60f6a90820d3",
                                "sense_id": "a0956b76-58d2-3994-a406-8a6db3e2874b",
                                "text": "„(…) Im weitaus größeren Teil Germaniens hingegen war die Herrschaftsform eine Demokratie, welche allerdings gemäßigt und reguliert wurde (…)“ (gutenberg.spiegel.de)"
                            },
                            {
                                "example_id": "334488b8-7782-48fa-8be1-2fc888439b66",
                                "sense_id": "a0956b76-58d2-3994-a406-8a6db3e2874b",
                                "text": "„Typische Herrschaftsform für die Galater war eine Tetrarchie (Viererherrschaft)…“"
                            },
                            {
                                "example_id": "fe7a7694-fdf6-4d68-b693-713cecf62812",
                                "sense_id": "a0956b76-58d2-3994-a406-8a6db3e2874b",
                                "text": "„Politik unterliegt hier im Wesentlichen autoritären, kaum transparenten oder rechenschaftspflichtigen Herrschaftsformen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
