                "senses": [
                    {
                        "sense_id": "13c02f42-7411-3767-a383-2e0acec17ec7",
                        "entry_id": "386be3e9-6ae1-37f9-9da5-63c8ca921a61",
                        "glosses": [
                            "Bergwerk, in dem Lithiumerze abgebaut werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26aad488-bb43-489e-be88-d98d6dc734b3",
                                "sense_id": "13c02f42-7411-3767-a383-2e0acec17ec7",
                                "text": "„Die Anwohner der Lithiummine Olaroz haben schon einen Lizenzvertrag mit der Firma unterschrieben.“"
                            },
                            {
                                "example_id": "160bd150-72db-4644-b40d-e343b209017c",
                                "sense_id": "13c02f42-7411-3767-a383-2e0acec17ec7",
                                "text": "„Weitere 85 Menschen sollen in der Lithiummine Arbeit finden.“"
                            },
                            {
                                "example_id": "d4ba8116-63b2-4c03-8491-a68c33e20b45",
                                "sense_id": "13c02f42-7411-3767-a383-2e0acec17ec7",
                                "text": "„Livent ist eine Ansammlung von Lithiumminen und Verarbeitungsstätten, die teilweise noch vor dem Zweiten Weltkrieg von FMC erstellt wurden.“"
                            }
                        ],
