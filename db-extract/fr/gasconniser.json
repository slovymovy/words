                "senses": [
                    {
                        "sense_id": "a7cd7253-edb0-329a-955a-97ec7707fd22",
                        "entry_id": "4521971d-9cd9-3a08-a161-14727c72d768",
                        "glosses": [
                            "Donner un caractère gascon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5690161-fc85-41cc-91f2-dd43d4b1777e",
                                "sense_id": "a7cd7253-edb0-329a-955a-97ec7707fd22",
                                "text": "S'il fallait gasconniser le mot, c'est de ce côté qu'il faudrait se pencher et ainsi le redoubler."
                            },
                            {
                                "example_id": "8662524d-c675-426f-9138-6dafb4360e2b",
                                "sense_id": "a7cd7253-edb0-329a-955a-97ec7707fd22",
                                "text": "Le domaine des Burgondi devint Bourgougnague grâce à cette extraordinaire capacité qu'ont les peuples sudistes d'absorber les étrangers et de les gasconniser un max."
                            },
                            {
                                "example_id": "49dbd736-1d0d-4c34-a4d8-2f2ecf176e7d",
                                "sense_id": "a7cd7253-edb0-329a-955a-97ec7707fd22",
                                "text": "Interdiction toutefois de changer les noms des personnages principaux ou de les « gasconniser »."
                            }
                        ]
                    }
