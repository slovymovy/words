            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a48574b-766d-3da4-b09c-6f257062364d",
                    "sense_definition": "Former un tout en entrant dans sa composition ou représenter quelque chose par sa nature.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces documents <w>constituent</w> une preuve essentielle pour comprendre l'histoire de la région."
                        },
                        {
                            "text": "La hausse imprévue des prix <w>constitue</w> un obstacle majeur pour tous les ménages."
                        }
                    ],
                    "synonyms": [
                        "composer",
                        "former",
                        "représenter"
                    ],
                    "common_phrases": [
                        "constituer un danger",
                        "constituer une menace",
                        "constituer un obstacle"
                    ]
                },
                {
                    "sense_id": "34516bb7-89dd-3cc5-98eb-5ff4020ad397",
                    "sense_definition": "Rassembler des éléments ou des personnes pour former un groupe, un ensemble ou un fonds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le responsable souhaite <w>constituer</w> une équipe solide pour gérer ce nouveau projet ambitieux."
                        },
                        {
                            "text": "Au fil des années, ce collectionneur a réussi à <w>constituer</w> une réserve impressionnante de tableaux anciens."
                        }
                    ],
                    "synonyms": [
                        "créer",
                        "établir",
                        "rassembler"
                    ],
                    "antonyms": [
                        "dissoudre",
                        "disperser"
                    ],
                    "common_phrases": [
                        "constituer une équipe",
                        "constituer un dossier",
                        "constituer une réserve"
                    ]
                },
                {
                    "sense_id": "6c886596-9d52-3cb5-aa9c-19b908092f0a",
                    "sense_definition": "Attribuer une qualité légale à quelqu'un ou prendre soi-même un statut juridique particulier.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs jours de fuite, le suspect a décidé de se <w>constituer</w> prisonnier au commissariat."
                        },
                        {
                            "text": "La victime a choisi de se <w>constituer</w> partie civile pour obtenir réparation de son dommage."
                        }
                    ],
                    "common_phrases": [
                        "se constituer prisonnier",
                        "se constituer partie civile"
                    ]
                },
                {
                    "sense_id": "91eef125-a66c-3cb9-8a52-12227cad1064",
                    "sense_definition": "Établir ou affecter formellement un bien, une rente ou un capital de manière durable.",
