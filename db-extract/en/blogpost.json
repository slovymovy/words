                                                "example_id": "38369cfe-6a83-42a8-a64a-159124daa934",
                                                "sense_id": "74cec057-0910-3da5-a52f-6b7fb2354008",
                                                "text": "In een blogpost heeft Amazon de nieuwe plannen bekendgemaakt."
                                            },
                                            {
                                                "example_id": "73832ba7-58bb-43a2-bc9a-6a46f8549add",
                                                "sense_id": "74cec057-0910-3da5-a52f-6b7fb2354008",
                                                "text": "\"We hebben gezien dat valse beweringen over coronavaccins overlopen in verkeerde informatie over vaccins in het algemeen\", schrijft het videoplatform in een blogpost. \"Volgens het bedrijf is het nu \"belangrijker dan ooit\" om dit beleid verder uit te breiden."
                                            }
                                        ]
