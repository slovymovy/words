                "senses": [
                    {
                        "sense_id": "5bee882e-92a0-39c6-9467-c13bd3e050b9",
                        "entry_id": "fe1509f9-ce30-382b-ac82-0c8999c77742",
                        "glosses": [
                            "Investmentfonds, der gleichzeitig in mehrere verschiedene Anlageklassen investiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4058e32f-1f95-4b40-8b77-18cb2a7ae65b",
                                "sense_id": "5bee882e-92a0-39c6-9467-c13bd3e050b9",
                                "text": "„Ihm zufolge werden vor allem zwei Produktgruppen heuer verstärkt nachgefragt. Nämlich einerseits Mischfonds, bei denen Anleger in mehrere Vermögensklassen wie Aktien, Anleihen und Gold investieren, aber auch Nachhaltigkeitsfonds seien derzeit sehr beliebt.“"
                            },
                            {
                                "example_id": "70f1dc0c-0345-40da-a0bc-85b08290477f",
                                "sense_id": "5bee882e-92a0-39c6-9467-c13bd3e050b9",
                                "text": "„In den vergangenen Jahren haben heimische Fondsinvestoren ein neues Lieblingsprodukt für sich entdeckt: Mischfonds.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
