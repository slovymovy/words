                ],
                "senses": [
                    {
                        "sense_id": "c9ade0b4-5d3c-3032-bf63-8e838a0d194d",
                        "entry_id": "735f4e4b-008e-373b-b41b-1ac8106f6804",
                        "glosses": [
                            "(meist frühzeitiges) Ende einer Koalition aus SPD, FDP und Grünen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0781d49-912c-42ec-8259-d12a001c6b07",
                                "sense_id": "c9ade0b4-5d3c-3032-bf63-8e838a0d194d",
                                "text": "„Der CDU-Chef drängte bereits kurz nach Bekanntwerden des Ampel-Aus auf eine Vertrauensfrage des Bundeskanzlers in den kommenden Tagen.“"
                            },
                            {
                                "example_id": "9a7e66c1-c589-4ffb-91a6-9c2b4acca5fe",
                                "sense_id": "c9ade0b4-5d3c-3032-bf63-8e838a0d194d",
                                "text": "„Die Partei habe bei internen Treffen einen Plan entworfen und gezielt auf das Ampel-Aus hingearbeitet, so lautet der Vorwurf, der Lindner und die FDP im anlaufenden Wahlkampf vor ein Problem stellen könnte.“"
                            },
                            {
                                "example_id": "5f27fdfb-6f6b-4865-99fc-35eacd78565a",
                                "sense_id": "c9ade0b4-5d3c-3032-bf63-8e838a0d194d",
                                "text": "„Nachdem sich das Ende der Ampelkoalition schon seit längerer Zeit angedeutet hatte, kam es am 6. November 2024 zum ‚Ampel-Aus‘.“"
                            },
                            {
                                "example_id": "3df6efff-abf1-438c-ac58-341ae05dc1d3",
                                "sense_id": "c9ade0b4-5d3c-3032-bf63-8e838a0d194d",
                                "text": "„Bürgergeldempfänger müssen sich auch nach dem Ampel-Aus keine Sorgen um die Auszahlung der Gelder machen.“"
                            },
                            {
                                "example_id": "db382497-e207-40fe-8285-1341b0cb3c9b",
                                "sense_id": "c9ade0b4-5d3c-3032-bf63-8e838a0d194d",
                                "text": "„Schweizer schütteln den Kopf über das Ampel-Aus in Deutschland und den Parteienstreit in Österreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
