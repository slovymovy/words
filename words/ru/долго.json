                            }
                        },
                        {
                            "text": "Я не могу так <w>долго</w> ждать твоего ответа.",
                            "target_lang_translations": {
                                "en": "I cannot wait that <w>long</w> for your answer.",
                                "es": "No puedo esperar <w>tanto tiempo</w> por tu respuesta.",
