                                "target_lang_word": "рваться",
                                "target_lang_sense_clarification": "о нити, веревке"
                            },
                            {
                                "target_lang_word": "разрываться",
                                "target_lang_sense_clarification": "о ткани, канате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d88872d1-6f1b-3868-b34e-7a56e8fd06f7",
                    "sense_definition": "poruszać się, biec lub jechać bardzo szybko i gwałtownie do przodu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spłoszone konie natychmiast <w>rwały</w> przed siebie przez otwarte pole.",
                            "target_lang_translations": {
                                "ru": "Испуганные лошади тут же <w>помчались</w> вперёд по открытому полю."
                            }
                        },
                        {
                            "text": "Kolarz z całych sił <w>rwie</w> do przodu tuż przed samą metą wyścigu.",
                            "target_lang_translations": {
                                "ru": "Велогонщик изо всех сил <w>несётся</w> вперёд у самого финиша гонки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rwać do przodu",
                        "rwać przed siebie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w odniesieniu do dynamicznego ruchu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "очень быстро и стремительно двигаться, бежать или ехать вперед"
