                        "form": "sulap"
                    },
                    {
                        "form_id": "af442070-15d9-47ee-835d-2095227d9107",
                        "entry_id": "1a353c84-b103-3779-8b99-cdb7f638e1ae",
                        "tags": [],
                        "form": "salop"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de6197fd-d6a2-30dc-a448-02726c3b517c",
                        "entry_id": "1a353c84-b103-3779-8b99-cdb7f638e1ae",
                        "glosses": [
                            "Fécule principalement constituée d'amidon, renfermant aussi diverses gommes et de la bassorine et servant d’excipient qu’on tire des racines bulbeuses et mucilagineuses de certains orchis."
                        ],
                        "tags": [],
                        "note": "le produit, dans la cuisine occidentale, a été substitué par le tapioca et la fécule de pomme de terre",
                        "examples": [
                            {
                                "example_id": "bedb95df-bea4-4c7f-9626-edc0425d4761",
                                "sense_id": "de6197fd-d6a2-30dc-a448-02726c3b517c",
                                "text": "Quant à la manière de se servir du salep, voici ce qui en est dit dans une lettre sur cette drogue, que le sieur Andri, droguiste de Paris, a fait mettre au Journal de Médecine, Septembre 1759. Suivant Albert Seba, les Chinois & les Persans en prennent la poudre, à la dose d’un gros, deux fois le jour dans du vin ou du chocolat."
                            },
                            {
                                "example_id": "0c8917af-d756-4d47-a138-15556c4f6a78",
                                "sense_id": "de6197fd-d6a2-30dc-a448-02726c3b517c",
                                "text": "Gelée, poudre de salep."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b86fafb-ad4a-3ff2-b457-42f44dc16103",
                        "entry_id": "1a353c84-b103-3779-8b99-cdb7f638e1ae",
                        "glosses": [
                            "Boisson faite avec cette fécule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585cb5f4-b9fb-4ea7-a87a-e3f429d00f95",
                                "sense_id": "3b86fafb-ad4a-3ff2-b457-42f44dc16103",
                                "text": "Nous vivions à la grecque. Je déjeunais d'une tasse de salep, je dînais d'un plat de viande avec beaucoup d'olives et de poisson sec."
                            },
                            {
                                "example_id": "e80b74de-fd41-48fd-8c89-a8968b7bbcd4",
                                "sense_id": "3b86fafb-ad4a-3ff2-b457-42f44dc16103",
                                "text": "Ka aima l’air mystérieux que le jeune garçon arborait. Ils se retirèrent jusque devant le Buffet moderne, célèbre dans le monde entier pour ses boissons sucrées et son salep."
                            },
                            {
                                "example_id": "47c58fee-26b4-45e0-9ca8-2ca47d1405e8",
                                "sense_id": "3b86fafb-ad4a-3ff2-b457-42f44dc16103",
                                "text": "Le salep est utilisé par les Orientaux comme reconstituant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "708ee351-027b-4f03-9c6f-3bb69b94adcb",
                        "source_entry_id": "1a353c84-b103-3779-8b99-cdb7f638e1ae",
                        "target_lang_word": "Salep",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c09054ba-6cf6-43d7-a7dc-8cdea33248b2",
                        "source_entry_id": "1a353c84-b103-3779-8b99-cdb7f638e1ae",
                        "target_lang_word": "salep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd3457a-1b60-30c3-88d1-25a41a92f48f",
                                        "entry_id": "557aed7c-2635-30ae-9ac4-246934a4f4bd",
                                        "glosses": [
                                            "A starch or jelly made out of plants in the Orchidaceae family, such as early-purple orchids (Orchis mascula)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9233f85-2a50-4b4d-9f2a-b31bfc451703",
                                                "sense_id": "0dd3457a-1b60-30c3-88d1-25a41a92f48f",
                                                "text": "Where finally the draining of marſhy grounds can not be effected at a reſponſible expence, ſome plants may perhaps be cultivated with profit to the cultivator; as in ſome ſituations the feſtica fluitans, floating feſcue, callitriche, ſtar-graſs; or in others the orchis for the purpoſe of making ſaloop by drying the peeled roots in an oven."
                                            },
                                            {
                                                "example_id": "812af02d-85d2-4769-a49b-9f95e954ef74",
                                                "sense_id": "0dd3457a-1b60-30c3-88d1-25a41a92f48f",
                                                "text": "In Turkey, Iran, and Syria salep is popular as a restorative and also as a provocative to amatory activity."
                                            },
                                            {
                                                "example_id": "6e39cefb-f389-4a35-8cd3-4b106c38aef9",
                                                "sense_id": "0dd3457a-1b60-30c3-88d1-25a41a92f48f",
                                                "text": "The tubers of one [orchid] species, Orchis mascula, produce a flour called salep, which was made into a drink known as \"saloop\" in 18th-century London, as an alternative to coffee (Charles Lamb thought it the ideal breakfast for chimney sweeps). Salep is a Turkish word with an even more precise derivation (it's from the Arabic for \"fox's testicles\"). Despite this, the Turks still use it to make a strange elastic ice cream, eaten with a knife and fork, which carries a pungent aftertaste compared by one commentator to the scent of \"goats on a rainy day\". Salep ice cream is so popular that O. mascula is now a protected species in Turkey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e442d6a1-8e65-3ab3-84d0-7462bef28b87",
                                        "entry_id": "557aed7c-2635-30ae-9ac4-246934a4f4bd",
                                        "glosses": [
                                            "Alternative form of saloop (“aromatic drink originally made with salep”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
