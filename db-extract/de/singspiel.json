                        ],
                        "form": "das Singspiel"
                    },
                    {
                        "form_id": "a93d836e-de8e-43ea-9f83-43532ade15c8",
                        "entry_id": "c9510638-ae55-37c9-b53d-aee413844e93",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Singspiele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17a5cdab-c9fa-38c8-971a-5702bcc4331b",
                        "entry_id": "c9510638-ae55-37c9-b53d-aee413844e93",
                        "glosses": [
                            "Kinderspiel, bei dem (meist im Reigen) getanzt und gesungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68964ac-bdc1-49f8-bc3a-741b50c9145d",
                                "sense_id": "17a5cdab-c9fa-38c8-971a-5702bcc4331b",
                                "text": "„Andere Spiele mit Regeln, Bewegungsspiele, alle Kreis-, Lauf- und Singspiele können in unserer Darstellung nicht mit erfasst werden, da diese Breite den Rahmen der beabsichtigten Darlegungen sprengen würde.“"
                            },
                            {
                                "example_id": "f5e3f428-c142-418c-bb27-45d56cbccbce",
                                "sense_id": "17a5cdab-c9fa-38c8-971a-5702bcc4331b",
                                "text": "„Gewiß haben die Kindergärten und deren Lehr- und Hilfsbücher einen wesentlichen Anteil an der Überlieferung der Kreis- und Singspiele.“"
                            },
                            {
                                "example_id": "fdea367e-dab8-4320-b29b-3f0c955a19a6",
                                "sense_id": "17a5cdab-c9fa-38c8-971a-5702bcc4331b",
                                "text": "„Der Plumpsack ist ein uraltes Kinderspiel; über Generationen spielten es Mädchen wie Jungen bis in den Schulanfang hinein gern auch als Singspiel.“"
                            },
                            {
                                "example_id": "8112d558-5dfa-4d5a-b172-a90f4e1c2562",
                                "sense_id": "17a5cdab-c9fa-38c8-971a-5702bcc4331b",
                                "text": "„Im Saal proben Kinder ein Singspiel für das Purimfest.“"
                            },
                            {
                                "example_id": "80f0a1bc-6f7f-497d-b1d5-219ba64f49f6",
                                "sense_id": "17a5cdab-c9fa-38c8-971a-5702bcc4331b",
                                "text": "„Singspiele der Kinder, Bauernrevolte und Epidemien sind Teil dieses englischen Geschichtsbildes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86be9290-d358-356f-8e58-74dc6a350315",
                        "entry_id": "c9510638-ae55-37c9-b53d-aee413844e93",
                        "glosses": [
                            "Schauspiel mit musikalischen Einlagen wie Liedern, Tänzen oder Instrumentalsätzen, Gattung des Musiktheaters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd47b3e-c149-4b23-908a-ae941eab8c07",
                                "sense_id": "86be9290-d358-356f-8e58-74dc6a350315",
                                "text": "„Damals wurde unter anderem Mozarts Singspiel Bastien und Bastienne gezeigt.“"
                            },
                            {
                                "example_id": "4d7a1883-ff4d-4026-bd6b-56a226c4a683",
                                "sense_id": "86be9290-d358-356f-8e58-74dc6a350315",
                                "text": "„Und weil die Entführung als Singspiel förmlich dazu einlädt, der konventionellen Erzählung des Stücks nicht zu folgen, sondern sie mit neuen Texten und Lars Eidinger als eigens hineingeschriebener Figur (nicht Bassa Selim!) gleichsam poetisch aufzuladen.“"
                            },
                            {
                                "example_id": "b69801f8-438e-4334-8689-05eb8c501362",
                                "sense_id": "86be9290-d358-356f-8e58-74dc6a350315",
                                "text": "„Er ist bekannt für seine Filme wie Wer früher stirbt, ist länger tot - und seine Inszenierung des Singspiels beim Starkbieranstich auf dem Nockherberg.“"
                            },
                            {
                                "example_id": "43173089-b31a-4575-bec0-005474d19fcc",
                                "sense_id": "86be9290-d358-356f-8e58-74dc6a350315",
                                "text": "„Aber fragt man zehn Intendanten, was sie von Bastien halten, dürften neun das Singspiel nicht einmal kennen.“"
                            },
                            {
                                "example_id": "af715411-f3be-43c6-96ae-925bc8a8b76b",
                                "sense_id": "86be9290-d358-356f-8e58-74dc6a350315",
                                "text": "„Gemeinsam mit Mihanovic spielte er im vergangenen Oktober in München in einer Neuinszenierung des Singspiels Im weißen Rössl.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
