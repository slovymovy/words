                "senses": [
                    {
                        "sense_id": "cc5a74aa-2b2d-372f-8ca6-ce1556f4c6a1",
                        "entry_id": "3c0614cf-c07f-3699-a034-a97cbbf06a7f",
                        "glosses": [
                            "Nom vernaculaire de Sium sisarum, plante potagère de la famille des Apiacées (Apiaceae) dont la racine légèrement sucrée est comestible. Il est originaire des régions entourant la mer Caspienne et la mer Noire"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6fd10942-f743-3519-8b6d-4ca77c6ed09e",
                        "entry_id": "3c0614cf-c07f-3699-a034-a97cbbf06a7f",
                        "glosses": [
                            "La racine de cette plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e7ae69-7f11-499f-a079-35955e0e0eb4",
                                "sense_id": "6fd10942-f743-3519-8b6d-4ca77c6ed09e",
                                "text": "Pierre-Antoine Jacques recommande le chervis, une racine qui ressemble à une petite carotte. Des saveurs de persil, de céleri-rave et de panais se côtoient en bouche, avec des notes sucrées et une saveur rappelant le tzatziki et la menthe, selon Stelio Perombelon."
                            },
                            {
                                "example_id": "6665eaa2-f7be-4937-b76e-525a463fbe07",
                                "sense_id": "6fd10942-f743-3519-8b6d-4ca77c6ed09e",
                                "text": "Le chervis a une saveur douce et aromatique."
                            }
                        ]
                    }
