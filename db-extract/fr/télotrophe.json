                        "glosses": [
                            "Qualifie un ovariole dont les cellules nourricières sont situées à une extrémité, et transfèrent les nutriments aux ovocytes via des cordons nourriciers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4c4839-10a2-4f9a-af6a-f5f2f814d7e2",
                                "sense_id": "3105a74c-6abc-3565-ad74-94164357075c",
                                "text": "...ont mis en évidence la présence de deux types d'ovaires : méroïstique polytrophe, chez les Adephaga, et méroïstique télotrophe chez les Polyphaga."
                            }
                        ]
                    },
                    {
                        "sense_id": "60fb64ba-f948-3c08-a746-7451121b3f8a",
                        "entry_id": "cb3c9860-b827-3e00-8449-475ba35315d8",
                        "glosses": [
                            "Qualifie un insecte dont les différents stades de développement (larve, nymphe, adulte) exploitent des ressources alimentaires ou des hôtes différents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa78376-63dc-4daf-a38b-fbe65fbb1dc4",
                                "sense_id": "60fb64ba-f948-3c08-a746-7451121b3f8a",
                                "text": "Les tiques télotrophes parasitent divers hôtes au stade larvaire et nymphal, puis se spécialisent à l’âge adulte."
                            }
                        ]
                    }
                ],
