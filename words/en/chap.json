                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the first <w>chap</w> of the textbook for tomorrow.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте первую <w>главу</w> учебника к завтрашнему дню."
                            }
                        },
                        {
                            "text": "The final <w>chap</w> of the book explains everything clearly.",
                            "target_lang_translations": {
                                "ru": "Последняя <w>глава</w> книги всё ясно объясняет."
                            }
