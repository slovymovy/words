                "senses": [
                    {
                        "sense_id": "0a6c124b-d478-3b47-9957-a6bd60ea965f",
                        "entry_id": "e591bbb9-3ef8-3906-9a9c-3efbc3731187",
                        "glosses": [
                            "iets dat geen waarde of belang heeft; iemand zonder waarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "215970f0-7456-4788-bc6a-727ade44f02a",
                                "sense_id": "0a6c124b-d478-3b47-9957-a6bd60ea965f",
                                "text": "'Een grote schande, het toppunt van een journalistieke nulliteit', reageert echtgenoot Frank Vanhecke. 'Dit is journalistiek van de laagste soort, compleet onaanvaardbaar. Dat vinden ook de ouders van Rooske.'"
                            },
                            {
                                "example_id": "eea2c190-2920-4f44-b1b4-6772a634de21",
                                "sense_id": "0a6c124b-d478-3b47-9957-a6bd60ea965f",
                                "text": "Qilaatersorneq, het plichtwerk van Soren Nils Eichberg, dat bij andere violisten al eens naar new age-nulliteit fladdert, kreeg een beklijvende uitvoering."
                            },
                            {
                                "example_id": "f542c341-3974-4f93-b2ba-a87443822830",
                                "sense_id": "0a6c124b-d478-3b47-9957-a6bd60ea965f",
                                "text": "„Nog steeds gebruik ik archaïsche woorden die ik van hem leerde. Als ik iets niet zo van belang vind, dan noem ik dat ‘een nulliteit’."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ef49d5c-9342-36f9-b2f8-ba2c54fb4019",
                        "entry_id": "e591bbb9-3ef8-3906-9a9c-3efbc3731187",
