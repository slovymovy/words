                "senses": [
                    {
                        "sense_id": "ebb3d82c-0d9b-3f59-ae1b-2235a6d9dffc",
                        "entry_id": "381ef18e-a634-382e-81f7-d33366ae1668",
                        "glosses": [
                            "защита от ветра; совокупность средств, защищающих от ветра"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a859e33d-0375-42a6-bc15-38bdce428579",
                                "sense_id": "ebb3d82c-0d9b-3f59-ae1b-2235a6d9dffc",
                                "text": "Вскоре над кромкой леса показались шар ветрозащиты «Тамары», антенны радиостанции и древней РЛС."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9f725d2-1f93-4720-af9b-a3397a219ba0",
                        "source_entry_id": "381ef18e-a634-382e-81f7-d33366ae1668",
                        "source_sense_id": "ebb3d82c-0d9b-3f59-ae1b-2235a6d9dffc",
                        "target_lang_word": "windbreak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windbreak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f913bd8b-5746-3cdf-a6d5-5ef33d8394a1",
                                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                                        "glosses": [
                                            "A hedge, fence or row of trees positioned to reduce wind damage to crops."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                                        "glosses": [
                                            "A sheet or stack of material used to protect people or fire from wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6085be42-aec6-4987-8367-598072573d22",
                                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                                "text": "I built my windbreak on a second-story wooden deck, as you can see above, but it would work just as well at ground level."
                                            },
                                            {
                                                "example_id": "7f3df31c-5d77-41d8-bd4d-cad960480918",
                                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                                "text": "Although Birdibil was warm in his family wungkurr or windbreak that night, lying next to a crackling fire and covered with some paperbark blankets (kawan), he had little sleep."
                                            },
                                            {
                                                "example_id": "6ae7bdfc-29b9-4dc9-803b-7f8823fe60ae",
                                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                                "text": "A wide range of materials was used for windbreaks, including rigid bark sheets inserted in sand, piles of grass or foliage, and stone walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                                        "glosses": [
                                            "The act of breaking wind; flatulence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8478b154-9c4f-4944-93d4-e50e41d86ffc",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "(chapter title for chapter on flatulence)"
                                            },
                                            {
                                                "example_id": "134f05a7-fb41-4aad-a2eb-890500225562",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "(see chapter title)"
                                            },
                                            {
                                                "example_id": "1658470f-b4bb-45b4-91d3-aa5da3247039",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "(see title)"
                                            },
                                            {
                                                "example_id": "e6c3dcd2-f50d-465f-a3f8-a6227978a914",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "Another of Roy's room-clearing wind breaks snapped my head back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e7d2898-df70-489c-a667-cc18e5bdaf15",
                        "source_entry_id": "381ef18e-a634-382e-81f7-d33366ae1668",
                        "source_sense_id": "ebb3d82c-0d9b-3f59-ae1b-2235a6d9dffc",
                        "target_lang_word": "windshield",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windshield",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e842380c-3363-32e8-a969-f104a3623b1d",
                                        "entry_id": "1c5f2ee8-4075-3f2f-95f8-4419e532a01e",
                                        "glosses": [
                                            "A transparent screen made of glass, located at the front and back of a vehicle in front of its occupants to protect them from the wind force generated by the vehicle's speed and inclement weather."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c56764-47c9-4b7e-bd43-5396b547cb99",
                                                "sense_id": "e842380c-3363-32e8-a969-f104a3623b1d",
                                                "text": "The freezing rain covered our windshield with ice and we couldn't see a thing."
                                            },
                                            {
                                                "example_id": "fa75b849-0069-49e8-b93d-a8ea1dbb1d8d",
                                                "sense_id": "e842380c-3363-32e8-a969-f104a3623b1d",
                                                "text": "For example, when trailers containing new automobiles were first piggybacked two areas of potential damage became evident: (1) diesel locomotive exhaust left a film of oil on the new autos; and (2) auto windshields could be scarred or cracked by the metal-tipped \"tell-tales\" which warn men atop trains of oncoming bridges or tunnels."
                                            },
                                            {
                                                "example_id": "8ce14288-fbc3-481a-9aad-e87a722dfa2a",
                                                "sense_id": "e842380c-3363-32e8-a969-f104a3623b1d",
                                                "text": "I was at Park Safari Africa in Canada on the Canadian border. This was years ago outside of Plattsburgh, New York. And I had a new car at the time, and I was driving through, going through the monkey area. And they said 'beware of the monkeys.' So about ten of them circled my car. And this one special one, like he was the leader of the pack, jumped up on the hood and came right up to the windshield and looked in. So I was like making faces at him. [garbled] 'don't do that!' And believe it or not, he made like a face back. He jumped off the car. He took his fingernails and he peeled all the chrome on both sides of my car off. Picked it up, jumped on the hood, dropped it and left- looked at me and left."
                                            },
                                            {
                                                "example_id": "395ee376-6126-49ef-b6c2-d6bb981b0630",
                                                "sense_id": "e842380c-3363-32e8-a969-f104a3623b1d",
                                                "text": "The new report said 413 million yuan spent on train windshields was wasted when design specifications were changed in March 2011, three months before the line opened.[…]\nIt found that Beichen district government in Tianjin had 340 million yuan in its own accounts instead of being paid promptly in compensation for land procured for the railway."
                                            },
                                            {
                                                "example_id": "ed1c5ddd-9933-48eb-8e25-1234211982a9",
                                                "sense_id": "e842380c-3363-32e8-a969-f104a3623b1d",
                                                "text": "Using her hands like windshield wipers, she tried to flick snow away from her mouth. When she clawed at her chest and neck, the crumbs maddeningly slid back onto her face. She grew claustrophobic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c136a6-655d-39d3-b89a-abbdcca5ba3d",
                                        "entry_id": "1c5f2ee8-4075-3f2f-95f8-4419e532a01e",
                                        "glosses": [
                                            "A cover for a microphone to exclude airy noises such as wind and breathing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11a766aa-4be1-356d-ac78-cf75c5f5e3c3",
                                        "entry_id": "1c5f2ee8-4075-3f2f-95f8-4419e532a01e",
                                        "glosses": [
                                            "A lightweight aerodynamic fairing mounted on the nose of an armor-piercing shell to reduce drag and increase range."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "windshield",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c84a3496-3666-3b45-a67f-a3cf3fbd8ba2",
                                        "entry_id": "a6504562-3b66-3c67-be74-b8f53b9fc7bc",
                                        "glosses": [
                                            "To install a windshield on."
                                        ],
