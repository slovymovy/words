                "senses": [
                    {
                        "sense_id": "2eca6d5d-f56b-349c-a827-9fc69e974e77",
                        "entry_id": "6c1f144a-7284-3c9a-84a1-d06e99b3c569",
                        "glosses": [
                            "Bezahlung, die vor Erhalt der Ware geleistet wird"
                        ],
                        "tags": [
                            "kaufmannssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "e1a93ef4-e0a0-491a-b336-07356a8d90f4",
                                "sense_id": "2eca6d5d-f56b-349c-a827-9fc69e974e77",
                                "text": "Weil Herr Möller in den letzten Monaten ein schlechter Zahler war, fordern seine Lieferanten in Vorkasse zu gehen."
                            },
                            {
                                "example_id": "cecf0c49-e795-47a8-be3b-96c6dee776dd",
                                "sense_id": "2eca6d5d-f56b-349c-a827-9fc69e974e77",
                                "text": "Krankenhäuser und Reha-Kliniken klagen über die schlechte Zahlungsmoral von Medizintouristen aus Arabien. Die Scheichs werden vielerorts nur noch gegen Vorkasse behandelt."
                            },
                            {
                                "example_id": "c87e65a7-c929-47da-92ab-62abc5bdb1ee",
                                "sense_id": "2eca6d5d-f56b-349c-a827-9fc69e974e77",
                                "text": "„Für den zivilen Konsum wurde dagegen kaum mehr hergestellt, und wenn, dann nur gegen Vorkasse oder Nachnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
