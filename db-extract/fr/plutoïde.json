                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b69ccb83-2e5c-460b-92c9-3aad0542d4d5",
                                "sense_id": "4089b5b3-a7bf-3c47-8c31-b765f5d85499",
                                "text": "Contrairement à ce que pourrait laisser croire le nom de ce plutoïde obscur, il n’est pire endroit en l’Univers soupira le vieillard, alors que mes hordes et moi-même, harnachés en nos capsules, en pénétrions l’atmosphère hostile."
                            }
                        ]
