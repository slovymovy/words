{
    "word_family": [
        "adapt",
        "adaptable",
        "adaptability",
        "adaptive",
        "adapter",
        "adaptor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8f5fdb1-225a-365b-9611-e37fc14009b0",
                    "sense_definition": "The process of adjusting or modifying something to fit a new situation or use.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>adaptation</w> to a new climate can be difficult for some people.",
                            "target_lang_translations": {
                                "ru": "<w>Адаптация</w> к новому климату может быть трудной для некоторых людей."
                            }
                        },
                        {
                            "text": "Successful lifestyle <w>adaptation</w> requires a lot of patience and flexibility.",
                            "target_lang_translations": {
                                "ru": "Успешное <w>приспособление</w> к новому образу жизни требует много терпения и гибкости."
                            }
                        }
                    ],
                    "synonyms": [
                        "adjustment",
                        "modification",
                        "accommodation"
                    ],
                    "antonyms": [
                        "maladaptation"
                    ],
                    "common_phrases": [
                        "lifestyle adaptation",
                        "process of adaptation",
                        "social adaptation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс приспособления или изменения чего-либо для соответствия новой ситуации или использованию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адаптация",
                                "target_lang_sense_clarification": "процесс привыкания"
                            },
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "к новым условиям"
                            },
                            {
                                "target_lang_word": "подстройка",
                                "target_lang_sense_clarification": "под ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "681aa9c8-5b57-3d4a-a4b2-42b06db3a24f",
                    "sense_definition": "A movie, book, or play that has been changed from its original form to a different medium.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "artistic_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film <w>adaptation</w> of the novel was much better than I expected.",
                            "target_lang_translations": {
                                "ru": "<w>Экранизация</w> этого романа оказалась гораздо лучше, чем я ожидал."
                            }
                        },
                        {
                            "text": "Critics praised the latest screen <w>adaptation</w> for its faithful storytelling.",
                            "target_lang_translations": {
                                "ru": "Критики похвалили последнюю <w>киноадаптацию</w> за верность оригиналу."
                            }
                        }
                    ],
                    "synonyms": [
                        "version",
                        "interpretation",
                        "remake"
                    ],
                    "common_phrases": [
                        "film adaptation",
                        "screen adaptation",
                        "theatrical adaptation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фильм, книга или пьеса, форма которых была изменена для представления в другом виде искусства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экранизация",
                                "target_lang_sense_clarification": "перенос на экран"
                            },
                            {
                                "target_lang_word": "адаптация",
                                "target_lang_sense_clarification": "переработка произведения"
                            },
                            {
                                "target_lang_word": "постановка",
                                "target_lang_sense_clarification": "театральная или сценическая версия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2210881e-eb5c-3a80-92c2-242a918935c4",
                    "sense_definition": "A change in the structure or behavior of an organism that helps it survive in its environment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fur of the polar bear is a biological <w>adaptation</w> to the cold.",
                            "target_lang_translations": {
                                "ru": "Густой мех белого медведя — это биологическая <w>адаптация</w> к холоду."
                            }
                        },
                        {
                            "text": "Scientists study evolutionary <w>adaptation</w> to understand how species survive over millions of years.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают эволюционную <w>адаптацию</w>, чтобы понять, как виды выживают на протяжении миллионов лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "acclimatization",
                        "evolution"
                    ],
                    "common_phrases": [
                        "evolutionary adaptation",
                        "biological adaptation",
                        "genetic adaptation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение в структуре или поведении организма, помогающее ему выживать в окружающей среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адаптация",
                                "target_lang_sense_clarification": "биологический процесс"
                            },
                            {
                                "target_lang_word": "приспособляемость",
                                "target_lang_sense_clarification": "способность выживать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}