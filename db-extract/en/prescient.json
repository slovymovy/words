                                    {
                                        "sense_id": "35a61862-6dd9-3f85-ad0f-fe1262bb88e4",
                                        "entry_id": "6e34307e-d276-3350-8b88-3c82ec92c6fe",
                                        "glosses": [
                                            "Qui a la prescience d’une chose, des événements futurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db3afc7-e31e-4d8e-969d-a20201547218",
                                                "sense_id": "35a61862-6dd9-3f85-ad0f-fe1262bb88e4",
                                                "text": "S’il voit les biens et les iniquités à son miroer prescient, pardurable…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "237c6f64-9956-4e73-8252-60663a0f7dc2",
                        "source_entry_id": "345baf99-78b7-3ded-a8ac-72c3185609c7",
                        "source_sense_id": "ac86d629-684a-39ff-8375-a7b4fafb84cd",
                        "source_sense_description": "exhibiting or possessing prescience",
                        "target_lang_word": "hellsichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hellsichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97e1f55f-7d1f-3fcf-b06e-24b2adbe0fd7",
                                        "entry_id": "57c0f86b-1fda-3dcb-9ebc-95f9aa73a660",
                                        "glosses": [
                                            "einen wachen, sofort das Wesentliche erfassenden und durchschauenden Intellekt besitzend und erkennen lassend, der dazu befähigt, frühzeitig künftige Entwicklungen und Erfordernisse richtig vorauszusehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2b1edb-0b5e-47c2-9017-3261b3103c6b",
                                                "sense_id": "97e1f55f-7d1f-3fcf-b06e-24b2adbe0fd7",
                                                "text": "„Diese außergewöhnlich hellsichtige Reaktion der Bürger auf Medienmanipulationen ist eine der Lehren, die die jüngsten Ereignisse bereithalten.“"
                                            },
                                            {
                                                "example_id": "8497af36-b6a3-42f5-b762-05be3459c976",
                                                "sense_id": "97e1f55f-7d1f-3fcf-b06e-24b2adbe0fd7",
                                                "text": "„Was viele schon wieder vergessen haben: Marx war nicht nur der Prophet der «Globalisierung», sondern zugleich ihr erster und hellsichtigster Kritiker.“"
                                            },
                                            {
                                                "example_id": "bb4f6b39-e665-4fd8-b38b-a4c316aeaaad",
                                                "sense_id": "97e1f55f-7d1f-3fcf-b06e-24b2adbe0fd7",
                                                "text": "„Hellsichtig analysiert Fanon auch die Zukunft der dekolonisierten Länder, in denen eine ‚(un-)authentische nationale Bourgeoisie‘ die Macht an sich reißt und dem Volk ‚das intellektuelle und technische Kapital‘ vorenthält.“"
                                            },
                                            {
                                                "example_id": "d991c735-6b40-450d-8819-030b85d14edd",
                                                "sense_id": "97e1f55f-7d1f-3fcf-b06e-24b2adbe0fd7",
                                                "text": "„Gewisse Ähnlichkeiten zwischen dem islamischen Fundamentalismus und seinem ideologischen Gegner, der europäischen Anti-Islam-Bewegung, waren den hellsichtigeren Beobachtern immer schon aufgefallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d54dd5f1-3ddf-423b-93d5-6a19646a7b0b",
                        "source_entry_id": "345baf99-78b7-3ded-a8ac-72c3185609c7",
                        "source_sense_id": "ac86d629-684a-39ff-8375-a7b4fafb84cd",
                        "source_sense_description": "exhibiting or possessing prescience",
                        "target_lang_word": "vorausschauend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorausschauend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba3eaba-0577-3d34-81f0-2bac20325de8",
                                        "entry_id": "7dbd6f8e-63f0-3c20-8005-e533d15a922c",
                                        "glosses": [
                                            "mit Blick in die Zukunft agierend, sich durch Weitsichtigkeit auszeichnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56d7a52-18ae-40f2-b285-e6873f38f52d",
                                                "sense_id": "9ba3eaba-0577-3d34-81f0-2bac20325de8",
                                                "text": "Vorausschauend ist es, bei einer Bergbesteigung vorher den Wetterbericht zu hören."
                                            },
                                            {
                                                "example_id": "4b7af03a-fc06-4667-be05-ac562f7bb27c",
                                                "sense_id": "9ba3eaba-0577-3d34-81f0-2bac20325de8",
                                                "text": "Wähler in Deutschland sind in der Regel gut informiert, gebildet, rational und gehen vorausschauend vor."
                                            },
                                            {
                                                "example_id": "e0a4de08-dde8-4c81-9d64-f83ed2295b35",
                                                "sense_id": "9ba3eaba-0577-3d34-81f0-2bac20325de8",
                                                "text": "„Komplexe dynamische soziale Beziehungsgeflechte zu durchschauen, abzuspeichern und die für sich selbst vorteilhafteste und erfolgversprechendste Strategie zum Erreichen eines Ziels (Nahrung, Sexualpartner) vorausschauend zu ermitteln, scheint für die Entwicklung der Intelligenz von entscheidender Bedeutung gewesen zu sein.“"
                                            },
                                            {
                                                "example_id": "7433c066-a032-4b63-a131-554900af55b6",
                                                "sense_id": "9ba3eaba-0577-3d34-81f0-2bac20325de8",
                                                "text": "Napoleons Flucht aus dem Exil auf Elba und sein Siegeszug nach Paris in nur drei Wochen waren noch ein Beleg für die meisterhafte Fähigkeit des \"petit corporal\", vorausschauend und schnell das Richtige zu tun. Doch diese Gabe verlässt ihn in Waterloo, wo Napoleon zum Zauderer wird."
                                            },
                                            {
                                                "example_id": "9ea8865e-0559-4c35-8928-b318b57c5551",
                                                "sense_id": "9ba3eaba-0577-3d34-81f0-2bac20325de8",
                                                "text": "Noch sind wir von militärischen Stärken wie zu Zeiten des Kalten Krieges weit entfernt, als sich in Mitteleuropa Millionen von Soldaten gegenüberstanden. Die NATO muss aber vorausschauend planen und auf alles vorbereitet sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
