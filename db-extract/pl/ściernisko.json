                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ceadaf1-c9fb-458b-adfc-c36d7ee04682",
                        "source_entry_id": "da014878-b5d6-37dd-82ea-9c03cd787572",
                        "source_sense_id": "6e4220c8-a025-3164-9649-a89d4f416c1f",
                        "target_lang_word": "stubble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stubble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8060c6-cb4a-300f-9172-ef70401dbab9",
                                        "entry_id": "7bf7b71e-884b-3bbc-bd3f-ac57600b0d2f",
                                        "glosses": [
                                            "Short, coarse hair, especially on a man’s face."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e7068dc-8e02-37c6-83ea-9ca25d5e28df",
                                        "entry_id": "7bf7b71e-884b-3bbc-bd3f-ac57600b0d2f",
                                        "glosses": [
                                            "The short stalks left in a field after crops have been harvested."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9174b569-79d8-4254-90ba-24387a565469",
                                                "sense_id": "3e7068dc-8e02-37c6-83ea-9ca25d5e28df",
                                                "text": "Lord (ſayth he) Put them as a wheele and a ſtoble before the face of the wynde. For as the ſtoble, whyle the wynde bloweth wauereth and flyethe aboue in the ayre, nowe hygh nowe lowe, but anone as the wynde paſſeth it falleth adowne to the erthe and lyeth there ſtylle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stubble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63fb92fa-2c0a-36da-b3aa-7e28b63867c7",
                                        "entry_id": "0b70bd7a-1fd3-3809-9b8b-b9f2a4e07333",
                                        "glosses": [
                                            "To produce a crop in a field of stubble that remains after a preceding crop is removed, either by sowing a second crop or by allowing shoots to sprout from the roots of the stubble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a37889ed-ca3a-463c-a6bc-98d9009df3e0",
                                                "sense_id": "63fb92fa-2c0a-36da-b3aa-7e28b63867c7",
                                                "text": "Here a system ( if it may be called a system ) of stubbling prevails — wheat succeeding wheat for a series of years, and without any material diminution of the yield."
                                            },
                                            {
                                                "example_id": "0c196641-6b89-428c-8360-efcfd0598297",
                                                "sense_id": "63fb92fa-2c0a-36da-b3aa-7e28b63867c7",
                                                "text": "In 1919 the stubbled crop was heavier than either that fallowed or plowed."
                                            },
                                            {
                                                "example_id": "cc354e67-d27b-4972-945a-ae915a6e531c",
                                                "sense_id": "63fb92fa-2c0a-36da-b3aa-7e28b63867c7",
                                                "text": "Both spring and fall ploughing produced a crop freer from weeds than where the seed was stubbled in."
                                            },
                                            {
                                                "example_id": "ac904339-5f67-4bad-8a8c-f344591862ac",
                                                "sense_id": "63fb92fa-2c0a-36da-b3aa-7e28b63867c7",
                                                "text": "Because the biggest single expense in producing the crop is planting, good stubbling ability is prized."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6657f0d-2ff5-4356-acff-2f7dae5864db",
                        "source_entry_id": "da014878-b5d6-37dd-82ea-9c03cd787572",
                        "source_sense_id": "6e4220c8-a025-3164-9649-a89d4f416c1f",
                        "target_lang_word": "Stoppelfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoppelfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                        "entry_id": "b037cbc8-dfc0-3947-a52d-1370ac96deb2",
                                        "glosses": [
                                            "abgeerntetes Getreidefeld, auf dem noch die kurzen Strünke der Pflanzen stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34647dd-77d5-4cb9-9e3c-83b78fb353e5",
                                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                                "text": "„Ein Mann, klein, kräftig, in einer braunen Jacke, läuft über ein Stoppelfeld.“"
                                            },
                                            {
                                                "example_id": "40fa8a50-22da-43e4-99bd-7d1f54fc2575",
                                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                                "text": "„In Jorate gingen die Sensen durchs Korn, die weißen Tücher der Binderinnen hoben und senkten sich, auf den Stoppelfeldern sammelten sich die Störche.“"
                                            },
                                            {
                                                "example_id": "d74d17b3-77dd-4332-a803-2d4bcb359c28",
                                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                                "text": "„In dem Augenblick, in welchem sie nach der allgemeinen Erwartung den Hasen packen musste, schlug er wieder einen Haken und sprang auf den Grenzrain zwischen der Wintersaat und dem Stoppelfelde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47e22bda-4662-4e71-a76f-ce5fb9133ce3",
                        "source_entry_id": "da014878-b5d6-37dd-82ea-9c03cd787572",
                        "source_sense_id": "6e4220c8-a025-3164-9649-a89d4f416c1f",
                        "target_lang_word": "жнивьё",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жнивьё",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "370ed42b-6fb3-3379-b815-40f7c7465f61",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "поле, на котором сжата рожь, пшеница или другие зерновые"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5f0dcf6-8fc8-4e26-acc7-bb6d2e27a97f",
                                                "sense_id": "370ed42b-6fb3-3379-b815-40f7c7465f61",
                                                "text": "Налево от шоссе тянулось потемневшее жнивьё, и только на бугристом и близком горизонте одинокими купами поднимались невысокие разрозненные деревья и кусты."
                                            },
                                            {
                                                "example_id": "dc5dad4d-acfd-4721-847b-21442efcb380",
                                                "sense_id": "370ed42b-6fb3-3379-b815-40f7c7465f61",
                                                "text": "Туча окинула взглядом низкие запёкшиеся жнивья. Они стлались до самого горизонта. Туча легко вскинулась на дыбы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73306d6d-0ec5-347a-8b25-f649f76ca873",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "рег. солома, оставшаяся на корню после жатвы; стерня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0b2273-44cd-43d9-a6fe-7bd4f78446d6",
                                                "sense_id": "73306d6d-0ec5-347a-8b25-f649f76ca873",
                                                "text": "У Прокудинского загона Степанова жена сошла и понесла свои кувшины; а за нею по колкому жнивью, подхватывая ножонки, побежал мальчик, догладывая свою пышку."
                                            },
                                            {
                                                "example_id": "40089e68-5d9e-4e1d-9e19-a333fbe6ae3c",
                                                "sense_id": "73306d6d-0ec5-347a-8b25-f649f76ca873",
                                                "text": "Порой казалось, что вернулась зима, белая, очень белая метель заносила в полях щетину рыжих жнивий и большие свинцовые лужи, где плавали дикие утки ⟨…⟩"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "808ba41d-8a3a-3c11-aff4-0a94f32310ee",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "рег. уборка хлебов; жатва"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "320d039f-9ae8-3f1c-9f32-214e15468c92",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "рег. время такой уборки"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c120d2ef-c31f-43de-8516-49eb8639550f",
                        "source_entry_id": "da014878-b5d6-37dd-82ea-9c03cd787572",
                        "source_sense_id": "6e4220c8-a025-3164-9649-a89d4f416c1f",
                        "target_lang_word": "стерня",
