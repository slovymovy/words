        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c844be7-68e4-3b24-80b0-b4472843e395",
                    "sense_definition": "The action of breaking something into pieces violently and noisily; form of <w>smash</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "destruction_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught <w>smashing</w> the old wooden crates behind the store.",
                            "target_lang_translations": {
                                "ru": "Его застали за <w>разбиванием</w> старых деревянных ящиков позади магазина.",
                                "nl": "Hij werd betrapt bij het <w>verbrijzelen</w> van de oude houten kratten achter de winkel."
                            }
                        },
                        {
                            "text": "The sound of <w>smashing</w> glass woke the neighbors in the middle of the night.",
                            "target_lang_translations": {
                                "ru": "Звук <w>разбивающегося</w> стекла разбудил соседей посреди ночи.",
                                "nl": "Het geluid van <w>verbrijzelend</w> glas maakte de buren midden in de nacht wakker."
                            }
                        }
