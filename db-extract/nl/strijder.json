                                "sense_id": "aa535c8f-94a1-376d-bb6b-dabd5520d615",
                                "text": "Hij is een echte strijder."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dcf7e0c-9243-3808-b236-979901cc53dd",
                        "entry_id": "d13fedf6-47b3-3dc3-8270-406a95d97bca",
