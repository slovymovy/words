                    {
                        "sense_id": "bbfdcda4-c2ea-38e6-83a1-ad60c8c46932",
                        "entry_id": "73850393-b1e1-3c67-8f68-44b9a9c26bab",
                        "glosses": [
                            "szata liturgiczna prezbiterów w formie wstęgi sukna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd919f95-1ad3-4995-ab9a-942582233184",
                                "sense_id": "bbfdcda4-c2ea-38e6-83a1-ad60c8c46932",
                                "text": "Odprawiał nabożeństwo bez ornatu, w samej stule."
                            },
                            {
                                "example_id": "34590543-6850-45af-9802-4affd51b576f",
                                "sense_id": "bbfdcda4-c2ea-38e6-83a1-ad60c8c46932",
                                "text": "Różny sposób noszenia stuły przez diakona i kapłana wskazuje na różny zakres obowiązków"
                            },
                            {
                                "example_id": "fafe6546-9a6d-4b40-a9fa-45315888c834",
                                "sense_id": "bbfdcda4-c2ea-38e6-83a1-ad60c8c46932",
                                "text": "Ojciec Mieczysław ma stułę z San Giovanni Rotondo."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5bf4633-9f63-42d0-8b59-9a84ec0d749a",
                        "source_entry_id": "73850393-b1e1-3c67-8f68-44b9a9c26bab",
                        "source_sense_id": "bbfdcda4-c2ea-38e6-83a1-ad60c8c46932",
                        "target_lang_word": "stole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "720c3ea1-27ba-3759-897b-d5be48d506a1",
                                        "entry_id": "5528dd69-ec0d-3375-bb40-1fe87c2ef2f3",
                                        "glosses": [
                                            "simple past of steal"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "059a509c-5ade-4f41-82b3-2f70bb1824c9",
                                                "sense_id": "720c3ea1-27ba-3759-897b-d5be48d506a1",
                                                "text": "TransPennine Express has removed all QR codes from its 71 car parks after scammers covered up a genuine code sticker with a false one and stole £13,000 from a woman's bank account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47f51dd0-a2ac-3fc6-b837-675ee16e9129",
                                        "entry_id": "5528dd69-ec0d-3375-bb40-1fe87c2ef2f3",
                                        "glosses": [
                                            "past participle of steal"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial",
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8365163-d8bd-4d4a-b9c7-32487e99f988",
                                                "sense_id": "47f51dd0-a2ac-3fc6-b837-675ee16e9129",
                                                "text": "[…]when indeed they have ſeen nothing, but have ſtole the word of the Lord from others, and borrowed from their neighbour[…]"
                                            },
                                            {
                                                "example_id": "20f0960d-2d12-4989-bcc9-8a7e9e682e9a",
                                                "sense_id": "47f51dd0-a2ac-3fc6-b837-675ee16e9129",
                                                "text": "And glory pointed still the goal / THat fired his lay; / But now revolving time has stole / Those dreams away."
                                            },
                                            {
                                                "example_id": "7fd8b278-1a9e-46ee-bb50-61ae405902d6",
                                                "sense_id": "47f51dd0-a2ac-3fc6-b837-675ee16e9129",
                                                "text": "[…]He must have stole my gear after he ran off, licking his wounds.\" Clint spoke loudly and proudly and drew some applause."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d8e7497-0129-3d3f-bd29-4ed12cdb5b5c",
                                        "entry_id": "125a7494-58db-35f3-bc7c-2a6abb878ab4",
                                        "glosses": [
                                            "A garment consisting of a decorated band worn on the back of the neck, each end hanging over the chest, worn in ecclesiastical settings or sometimes as a part of graduation dress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a501d1-67f1-493d-b3bb-ca1420f48823",
                                                "sense_id": "5d8e7497-0129-3d3f-bd29-4ed12cdb5b5c",
                                                "text": "1994-1998, Encyclopaedia Britannica CD 98, Multimedia Edition\nCertain robes indicate a position in the hierarchy; others correspond to function and may be worn by the same individual at different times. The most important vestment among the insignia [of the clergy] is the stole, the emblem of sacerdotal status, the origin of which is the ancient pallium. The stole originally was a draped garment, then a folded one with the appearance of a scarf, and, finally, in the 4th century, a scarf. As a symbol of jurisdictionin the Roman Empire, the supreme pontiff (the pope, or bishop of Rome) conferred it upon archbishops and, later, upon bishops, as emblematic of their sharing in the papal authority."
                                            },
                                            {
                                                "example_id": "07eaca8d-b4ba-4601-bb0c-3cf1e6767a76",
                                                "sense_id": "5d8e7497-0129-3d3f-bd29-4ed12cdb5b5c",
                                                "text": "With sou'-wester under arm, and oilskin open so that God might see the stole and know that there was no deception, he chanted from a prayer-book in a tone exactly like that of a blackfellow devil-dovvening: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8e699b9-da24-3609-b780-170bc6d8853f",
                                        "entry_id": "125a7494-58db-35f3-bc7c-2a6abb878ab4",
                                        "glosses": [
                                            "A scarf-like garment, often made of fur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
