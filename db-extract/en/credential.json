                                                "sense_id": "1da1e91a-a44a-3a4e-96f4-d8698b39bf45",
                                                "text": "„Die Zugangsdaten seien bei der Analyse von Botnetzen aufgetaucht.“"
                                            },
                                            {
                                                "example_id": "22267263-8003-48c0-b23d-596acc79c918",
                                                "sense_id": "1da1e91a-a44a-3a4e-96f4-d8698b39bf45",
                                                "text": "„Im großen Stil haben Kriminelle die Zugangsdaten von Millionen Internetnutzern gestohlen, warnt das Bundesamt für Sicherheit und Informationstechnik.“"
                                            },
                                            {
                                                "example_id": "7dc65c4e-0da3-4112-ab7f-99531315b43f",
                                                "sense_id": "1da1e91a-a44a-3a4e-96f4-d8698b39bf45",
                                                "text": "„Für einige Abläufe in Ihrem Studienalltag benötigen Sie Zugangsdaten.“"
                                            },
                                            {
                                                "example_id": "3cc57a7f-d22b-4a42-8850-41bd30959797",
                                                "sense_id": "1da1e91a-a44a-3a4e-96f4-d8698b39bf45",
                                                "text": "„Der Versand der Zugangsdaten erfolgt per Brief.“"
                                            },
                                            {
                                                "example_id": "4568f28c-8ac0-4c25-a807-b18636b29d19",
                                                "sense_id": "1da1e91a-a44a-3a4e-96f4-d8698b39bf45",
                                                "text": "„Wenn Ihre Software die Einstellungen nicht automatisch für Sie vornimmt, dann können Sie hier unsere Zugangsdaten nachlesen und die Einrichtung manuell vornehmen.“"
                                            }
                                        ],
