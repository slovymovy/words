                "senses": [
                    {
                        "sense_id": "72f2ebd9-2895-362b-9631-68ddcfbf0d60",
                        "entry_id": "bfbd5255-87df-3ba0-a931-18e46d29feda",
                        "glosses": [
                            "wzrost wartości dobra lub usługi, zwykle pieniądza w systemie płynnych kursów walut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "552458a8-fbed-4e4b-b71b-20f90a70dc4e",
                                "sense_id": "72f2ebd9-2895-362b-9631-68ddcfbf0d60",
                                "text": "Wzrost popytu na polskie towary spowodował aprecjację złotego, przez co kurs euro spadł z 4,20 zł do 3,80 zł."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef1b9046-cb51-42a2-9879-535790fccf26",
                        "source_entry_id": "bfbd5255-87df-3ba0-a931-18e46d29feda",
                        "source_sense_id": "72f2ebd9-2895-362b-9631-68ddcfbf0d60",
