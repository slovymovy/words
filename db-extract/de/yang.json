                ],
                "senses": [
                    {
                        "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                        "entry_id": "3166c812-ea43-365e-82fa-311132a48582",
                        "glosses": [
                            "das männliche Prinzip in der chinesischen Naturphilosophie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ffe7934-6623-44b6-889b-70d31c2c0ca7",
                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                "text": "Soviel weiß ich allerdings: das Yin-Yang Symbol genießt in Ostasien die höchste Verehrung."
                            },
                            {
                                "example_id": "5fa92e3c-a5aa-48b2-b360-ecc619346e66",
                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                "text": "„Ich glaube daran, dass wir Yin und Yang unserer Partei zusammenbringen müssen“, erläutert der Rechtsanwalt Mark Aronchick, einer der Gründer von VoteBoth."
                            },
                            {
                                "example_id": "5db39031-9cb5-4454-8e68-4948343ed887",
                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                "text": "Dieser Gott war ein Vegetations-, beileibe aber kein Schöpfergott, die Schöpfung wurde vielmehr durch das bipolare Spiel zwischen zwei Urkräften, dem männlichen Yang und dem weiblichen Yin bestimmt. In diesem Bild repräsentiert der Himmel das Prinzip Yang, die Erde folglich Yin, wobei sich alle Momente des Kosmos in Bewegung befinden und ein gewaltiges Durcheinander entstehen kann, welches die Dinge »unter dem Himmel« in ihrem Fortbestand bedroht."
                            },
                            {
                                "example_id": "302eed06-8ce0-4648-beff-52c004faf330",
                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                "text": "Bei Dusch-Gel und Bade-Öl erleben wir überhaupt Harmonie, Yin und Yang."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65787944-703e-401c-bf4c-e8f72d0c8761",
                        "source_entry_id": "3166c812-ea43-365e-82fa-311132a48582",
                        "source_sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
