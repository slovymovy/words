                "senses": [
                    {
                        "sense_id": "4bcf9fee-f78c-37eb-a82c-644c8203e832",
                        "entry_id": "7552d679-5c00-3303-bee7-dafc65d5f4d3",
                        "glosses": [
                            "diplomatischer, staatlicher Vertreter, der im Rang unterhalb eines Botschafters steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
