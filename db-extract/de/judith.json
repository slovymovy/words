                                "example_id": "48ebb7e0-bc26-40d6-b7b1-824f9abae842",
                                "sense_id": "72d3f71f-766e-3af0-a78c-957d30e2c784",
                                "text": "Frau Judith ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c743456e-b075-4f74-a443-4d13b342f41e",
                                "sense_id": "72d3f71f-766e-3af0-a78c-957d30e2c784",
                                "text": "Herr Judith wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "eddfc531-2c4b-4a80-acd7-e25ec597030c",
                                "sense_id": "72d3f71f-766e-3af0-a78c-957d30e2c784",
                                "text": "Die Judiths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "95e2969b-cacf-4f60-88a7-f2abb64048fe",
                                "sense_id": "72d3f71f-766e-3af0-a78c-957d30e2c784",
                                "text": "Der Judith trägt nie die Schals, die die Judith ihm strickt."
                            },
                            {
                                "example_id": "767f6a00-b025-422b-a762-c6b7ad921f0d",
                                "sense_id": "72d3f71f-766e-3af0-a78c-957d30e2c784",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Judith kommt, geht der Herr Judith.“"
                            },
                            {
                                "example_id": "92d194b0-6c5f-4ed0-ad1a-b8ba12f0838e",
                                "sense_id": "72d3f71f-766e-3af0-a78c-957d30e2c784",
                                "text": "Judith kommt und geht."
                            },
                            {
                                "example_id": "7fd85ddb-3196-4649-aa76-48916a91dab7",
                                "sense_id": "72d3f71f-766e-3af0-a78c-957d30e2c784",
                                "text": "Judiths kamen, sahen und siegten."
                            }
