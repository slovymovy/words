                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e6a9a40-5d03-3236-8afc-9c823cb3d959",
                                        "entry_id": "4ba21542-4055-3dd8-9039-7dd0ed3a48e7",
                                        "glosses": [
                                            "An introduction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc53c84-0d9c-4df3-9954-df9026584bca",
                                                "sense_id": "8e6a9a40-5d03-3236-8afc-9c823cb3d959",
                                                "text": "This is but an induction: I'lldraw / The curtains of the tragedy hereafter."
                                            }
                                        ]
