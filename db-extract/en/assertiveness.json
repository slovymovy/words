                                                "example_id": "12deab99-45f4-46c8-82bd-d6687d4a38c1",
                                                "sense_id": "89052c20-9334-34c9-977b-cb9c6ea027de",
                                                "text": "C’est sur cette notion contemporaine de l’assertivité que je vais m’attarder avec le cas de Kéraban."
                                            }
