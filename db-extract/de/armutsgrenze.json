                ],
                "senses": [
                    {
                        "sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                        "entry_id": "4dc274e6-3f39-301b-b14c-ca4e1539828f",
                        "glosses": [
                            "Einkommenshöhe, unterhalb derer der Erwerb aller lebenswichtigen Ressourcen nicht möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd19120-1967-49b0-aa34-935cec147c8d",
                                "sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                                "text": "„Denn inzwischen leben elf Millionen Spanier an der Armutsgrenze – sie müssen mit weniger als 500 Euro im Monat auskommen.“"
                            },
                            {
                                "example_id": "25f9ad34-d3a2-47b5-8984-3694226389bd",
                                "sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                                "text": "„Es sind die magischen 700 Litas, umgerechnet etwas über 200 Euro, die in Litauen als Armutsgrenze gelten.“"
                            },
                            {
                                "example_id": "49e24f0b-4cd2-42d5-8bb7-a99d1cf26dfb",
                                "sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                                "text": "„[…] 16 Prozent der Menschen in Deutschland leben unterhalb der Armutsgrenze, jedes fünfte Kind wächst in Armut auf.“"
                            },
                            {
                                "example_id": "bd122e25-77c5-4f28-9644-3297605ccb35",
                                "sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                                "text": "„Ein nicht mehr junger, aber wohlhabender Witwer hält um ihre Hand an, sie jedoch verweigert sich der Tradition einer vermittelten Heirat und gibt einem völlig mittellosen Schneider den Vorzug, der ihr nur ein Leben an der Armutsgrenze bieten kann.“"
                            },
                            {
                                "example_id": "ea5a9f92-c92d-4845-9dbf-e47e4f58327d",
                                "sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                                "text": "„Wie wohlhabend der Punjab ist, wird daraus ersichtlich, dass nur ein Viertel seiner Bevölkerung unter der Armutsgrenze lebt, während dies im restlichen Pakistan ungefähr für die Hälfte der Bewohner gilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7eb9c239-aaa7-43ba-80d3-b0d3cc28711f",
                        "source_entry_id": "4dc274e6-3f39-301b-b14c-ca4e1539828f",
                        "source_sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                        "source_sense_description": "Einkommenshöhe, unterhalb derer der Erwerb aller lebenswichtigen Ressourcen nicht möglich ist",
                        "target_lang_word": "poverty line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poverty line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aaf2178-8908-3435-ac64-d852dcd33792",
                                        "entry_id": "66d8c8f9-6be8-3ec2-9e48-59f4df163ab4",
                                        "glosses": [
                                            "The threshold of poverty, below which one's income does not cover necessities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f2e3194-0ddb-475a-adbc-73dc99307bc9",
                                                "sense_id": "3aaf2178-8908-3435-ac64-d852dcd33792",
                                                "text": "America’s poverty line is $63 a day for a family of four. In the richer parts of the emerging world $4 a day is the poverty barrier. But poverty’s scourge is fiercest below $1.25 (the average of the 15 poorest countries’ own poverty lines, measured in 2005 dollars and adjusted for differences in purchasing power): people below that level live lives that are poor, nasty, brutish and short."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78f3e357-346c-49be-a9f1-9f743eb571a9",
                        "source_entry_id": "4dc274e6-3f39-301b-b14c-ca4e1539828f",
                        "source_sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                        "source_sense_description": "Einkommenshöhe, unterhalb derer der Erwerb aller lebenswichtigen Ressourcen nicht möglich ist",
                        "target_lang_word": "breadline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breadline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd1799d0-c48e-3c17-bd89-d0140a4ab14b",
                                        "entry_id": "fe66a679-a8ff-34ac-9811-4a1edc0c512d",
                                        "glosses": [
                                            "A line of people waiting to receive food from a charity."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfae7853-3a09-4b5f-aad8-2da827a0fadb",
                                                "sense_id": "cd1799d0-c48e-3c17-bd89-d0140a4ab14b",
                                                "text": "I do not think anyone of us can walk by a breadline and see even the most unkempt and raggedy man in the line without saying to himself, \"There but for the grace of God.\""
                                            },
                                            {
                                                "example_id": "dde2fb8b-5ea5-4226-81f9-d7649621d2e0",
                                                "sense_id": "cd1799d0-c48e-3c17-bd89-d0140a4ab14b",
                                                "text": "Breadlines and social agencies, while staffing women, employed more men and served more men, making women a minority in the visual landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac2d927-65d0-31ea-9c1f-296cc1a17530",
                                        "entry_id": "fe66a679-a8ff-34ac-9811-4a1edc0c512d",
                                        "glosses": [
                                            "The lowest income level at which one's most basic necessities of survival are met; poverty line or subsistence level."
                                        ],
                                        "tags": [
                                            "British",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b7345b9-1103-4799-a605-b941640236b1",
                                                "sense_id": "0ac2d927-65d0-31ea-9c1f-296cc1a17530",
                                                "text": "Every day brings new worries about falling below the breadline."
                                            },
                                            {
                                                "example_id": "b16984fb-c562-4b7f-88dd-6421c36a58d8",
                                                "sense_id": "0ac2d927-65d0-31ea-9c1f-296cc1a17530",
                                                "text": "[…] and she wasn't used to cash, living on the breadline with a kid to bring up."
                                            },
                                            {
                                                "example_id": "5d77ee09-fe86-4dd0-8731-7211fb6ea143",
                                                "sense_id": "0ac2d927-65d0-31ea-9c1f-296cc1a17530",
                                                "text": "It hurt him to see other good ex-servicemen working their socks off and making no-gooders comfortable while they remained just over the breadline."
                                            },
                                            {
                                                "example_id": "d6e6beb6-20ba-4825-abdd-26ac11156426",
                                                "sense_id": "0ac2d927-65d0-31ea-9c1f-296cc1a17530",
                                                "text": "It changed her. Having lived below the breadline, having lived with excess, was it about to change once more?"
                                            },
                                            {
                                                "example_id": "0bd8eaff-db72-4120-917b-d3500ae4353e",
                                                "sense_id": "0ac2d927-65d0-31ea-9c1f-296cc1a17530",
                                                "text": "For poor people that takes them near the breadline, but they still do it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ee7085e-f3e7-42d5-92bc-387071d03f74",
                        "source_entry_id": "4dc274e6-3f39-301b-b14c-ca4e1539828f",
                        "source_sense_id": "0af3f079-495a-37e6-bf54-c83ec8bddb94",
                        "source_sense_description": "Einkommenshöhe, unterhalb derer der Erwerb aller lebenswichtigen Ressourcen nicht möglich ist",
                        "target_lang_word": "seuil de pauvreté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seuil de pauvreté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c44c85b8-f195-3c51-a085-28334b24f102",
                                        "entry_id": "2c914d62-38ff-3500-aa76-983eb25a63b6",
                                        "glosses": [
                                            "Niveau de revenus au-dessous duquel une personne, un ménage, une population, sont considérés comme pauvres."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "186cf955-c3b8-47bb-8e0c-a4e09de2fdad",
                                                "sense_id": "c44c85b8-f195-3c51-a085-28334b24f102",
                                                "text": "Près de 10 millions de Français vivent aujourd’hui en-dessous du seuil de pauvreté. Celui-ci est défini très précisément. Mais il n’existe pas de « seuil de richesse ». C’est très relatif, chacun peut trouver que son voisin est riche."
                                            },
                                            {
                                                "example_id": "d14233e9-e233-4c8d-afae-bd7b9dc5fb1b",
                                                "sense_id": "c44c85b8-f195-3c51-a085-28334b24f102",
                                                "text": "En 2015, près d’un tiers des seniors n’ayant ni emploi ni retraite (« NER ») vivaient en dessous du seuil de pauvreté, selon une note rendue publique, mercredi 19 septembre, par la direction de la recherche, des études, de l’évaluation et des statistiques (Drees), un service rattaché à trois ministères (solidarités, travail, comptes publics)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
