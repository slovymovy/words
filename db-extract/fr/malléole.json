                "senses": [
                    {
                        "sense_id": "949d317c-8db7-3718-97ec-38caaedae895",
                        "entry_id": "f18c6e32-ddea-3043-817a-31ab8b8b1ca0",
                        "glosses": [
                            "Partie saillante du bas des os de la jambe, appelée communément la cheville (du pied) (homme et primates), ou du jarret (quadrupèdes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2330adf3-bf91-44d8-b96d-7ec120244414",
                                "sense_id": "949d317c-8db7-3718-97ec-38caaedae895",
                                "text": "Les malléoles ressortaient nettement."
                            },
                            {
                                "example_id": "859e3306-2266-450a-b9c4-43e9d5b3d21f",
                                "sense_id": "949d317c-8db7-3718-97ec-38caaedae895",
                                "text": "Milva dansa chaussée de sa nouvelle paire de Dr. Martens qui la blessa derrière le talon et à la malléole."
                            },
                            {
                                "example_id": "0084ead8-bd13-45b7-8dc1-d038be35adae",
                                "sense_id": "949d317c-8db7-3718-97ec-38caaedae895",
                                "text": "Un absent de marque, Thierry Solère, qui s’est brisé une jambe la veille. Une triple fracture de la malléole pour une glissade malencontreuse à quelques pas du QG… Solère, qui, le jour de la fameuse galette des Rois, avait repéré le premier les fèves de mauvais augure, est décidément le chat noir de cette campagne."
                            }
                        ]
                    }
