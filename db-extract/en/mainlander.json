                        "sense_id": "15a99d73-c8fa-3f35-ac41-8018fe3536f5",
                        "entry_id": "cd5cf43b-7060-3058-85b1-9af15dc9e31e",
                        "glosses": [
                            "Someone who lives in mainland Europe, as opposed to the British Isles."
                        ],
                        "tags": [],
                        "examples": []
