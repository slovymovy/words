                ],
                "senses": [
                    {
                        "sense_id": "83afa6fb-5045-3f6e-99b8-8e8cd9364b70",
                        "entry_id": "90af6071-1ae0-3a0c-bc83-25ba0366eeeb",
                        "glosses": [
                            "Bewusstsein/Einstellung über die eigene Klassenzugehörigkeit und damit verbundene Lebensumstände und Rollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa0136d-4219-4a2b-adda-d92e93ce9b23",
                                "sense_id": "83afa6fb-5045-3f6e-99b8-8e8cd9364b70",
                                "text": "„Die Briten bewahrten sich ein strenges Klassenbewusstsein: Die Soldaten und Unteroffiziere verbrachten ihre Freizeit in Bars und Bordellen, während die Offiziere auf Fuchs- oder Schakaljagd gingen.“"
                            },
                            {
                                "example_id": "3a09a9a2-2677-4c35-b7c4-8faf02c167c2",
                                "sense_id": "83afa6fb-5045-3f6e-99b8-8e8cd9364b70",
                                "text": "„In den 1920er und 1930er Jahren hatte die nationale Führung beider Seiten dieses Klassenbewustsein zwar einzudämmen versucht, vor allem die jüdische Gewerkschaftsbewegung, aber es hatte weiterhin gemeinsame Arbeitskämpfe gegen Arbeitgeber aller Art und gegenseitige Hilfe in Zeiten der Rezession und Not gegeben.“"
                            },
                            {
                                "example_id": "f94f3729-71ea-42bf-a191-2dcbaa0cbf24",
                                "sense_id": "83afa6fb-5045-3f6e-99b8-8e8cd9364b70",
                                "text": "„Die Cops von Baltimore begegnen eingefleischten Billies im Allgemeinen mit derselben Verachtung und demselben Humor wie der radikalen Ghettokultur. Das beweist im Grunde, dass eher Klassenbewusstsein als Rassismus die Cops dazu treibt, die geknechteten Massen mit einer gewissen Geringschätzung zu betrachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
