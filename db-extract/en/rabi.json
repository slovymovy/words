                        "examples": [
                            {
                                "example_id": "d1a86e04-733c-443f-b84f-a9c1fb776a66",
                                "sense_id": "e8c6c288-d50b-32d7-8b95-6acda211f62e",
                                "text": "...I made out that he would be here before the rabi harvest is ripe; the corn is green enough yet, but I thought that after work I would come over here to meet him."
                            },
                            {
                                "example_id": "0f796b24-b4ca-4d77-ac04-4c9f43f7164f",
                                "sense_id": "e8c6c288-d50b-32d7-8b95-6acda211f62e",
                                "text": "The monsoon had failed at the beginning but picked up very well later, so the rabi crop would be just fine and the wars they mentioned had taken place a year and a half ago."
                            }
