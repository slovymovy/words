                        "glosses": [
                            "Qui a la forme ou l’aspect d’un grain de riz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea3d54bc-9367-49c6-a2ee-7dc12df3e4e0",
                                "sense_id": "b952a6f4-28a5-31b1-a69f-00bcab79073a",
                                "text": "De nombreuses observations microscopiques nous ont permis de constater que la matière riziforme des déjections alvines et des vomissements est en grande partie formée d’épithélium cylindrique provenant de la portion gastro-intestinale du tube digestif."
                            },
                            {
                                "example_id": "202ee73e-a389-4583-8e8c-619119e3d1d6",
                                "sense_id": "b952a6f4-28a5-31b1-a69f-00bcab79073a",
                                "text": "Les dents surnuméraires dysmorphiques ont des formes variées : coniques, riziformes, multi-tuberculées."
                            }
                        ]
                    }
                ],
