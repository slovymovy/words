                        ],
                        "examples": [
                            {
                                "example_id": "dc2af46b-9e68-4c25-93d3-48e6ecdd2d8b",
                                "sense_id": "90993732-243e-3489-b8a6-72322a68fa2a",
                                "text": "Le Gros lui pose la main sur l'épaule. On sent, à son air lugubre, qu'il peut fort bien lui dévisser la calbombe comme une simple pomme d'escalier."
                            }
