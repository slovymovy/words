                    {
                        "sense_id": "f06ae43d-2123-3915-94c2-f5cd188ae884",
                        "entry_id": "ce31f241-d1b5-3f67-b601-455519d7a7b1",
                        "glosses": [
                            "region północnej Europy obejmujący kraje Danię, Norwegię i Szwecję"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc73e5ef-81b7-4435-a922-b934da825736",
                                "sense_id": "f06ae43d-2123-3915-94c2-f5cd188ae884",
                                "text": "Wspólną nazwą walut używanych w Skandynawii jest korona."
                            },
                            {
                                "example_id": "5604aeb2-1693-4b0c-8c02-4fd91525a587",
                                "sense_id": "f06ae43d-2123-3915-94c2-f5cd188ae884",
                                "text": "Göteborg ma największy port w Skandynawii."
                            },
                            {
                                "example_id": "3965fb32-b121-42d4-9f59-eadf227177bb",
                                "sense_id": "f06ae43d-2123-3915-94c2-f5cd188ae884",
                                "text": "W tym samym roku duńska firma otrzymała przedstawicielstwo na całą Skandynawię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
