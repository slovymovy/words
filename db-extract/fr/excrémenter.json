                "senses": [
                    {
                        "sense_id": "c7a13e2f-fb1f-3e7f-ab56-ad9f84bdd638",
                        "entry_id": "989f0e32-75cd-32fc-9aa3-6f6b5d5b5728",
                        "glosses": [
                            "Expulser sous forme d’excréments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a686dfe-4a1c-4a84-adc2-57501a26e4d4",
                                "sense_id": "c7a13e2f-fb1f-3e7f-ab56-ad9f84bdd638",
                                "text": "Tout celui pris en flagrant délit ou soupçonné de gestes impudiques, en train d’uriner, de déféquer ou d’excrémenter devant la maison communale, sera arrêté immédiatement, conformément à la loi juridictionnelle."
                            },
                            {
                                "example_id": "311cd9db-a44c-41d6-9df0-527a1ee5d390",
                                "sense_id": "c7a13e2f-fb1f-3e7f-ab56-ad9f84bdd638",
                                "text": "Ce goût fielleux que donne à l’écriture le régime de la redondance et la constante réfection d’un livre toujours à avaler, à recracher, à vomir, à ravaler, à excrémenter, et à ravaler encore, cette amertume du ressassement éternel de la parole, Jean le premier l’a ressentie dans sa bouche."
                            }
                        ]
                    }
