                        "entry_id": "e4893c88-c241-3906-9a23-8c7db3cdba59",
                        "glosses": [
                            "female equivalent of motywator (“motivator”) (one who motivates or inspires others)"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "278372b7-0ead-4e5f-8f9b-7fe94fff2526",
                                "sense_id": "44101611-fca4-335b-9e7f-22ff8533da2d",
                                "text": "Nie zmienia to faktu, że jako motywatorka wyglądała — tak jak pow inna^([sic – meaning powinna]) czyli zniewalająco.",
                                "translation": "This does not change the fact that, as a motivator, she looked — like she should, so compelling.",
                                "english": "This does not change the fact that, as a motivator, she looked — like she should, so compelling."
                            }
                        ]
