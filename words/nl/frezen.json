                    "sense_id": "51178f7d-1313-3a04-be22-6eeeec2b1ee4",
                    "sense_definition": "een verspanende bewerking uitvoeren met behulp van een roterend gereedschap, de frees",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zowel metalen als harde kunststoffen kunnen <w>gefreesd</w> worden.",
                            "target_lang_translations": {
                                "en": "Both metals and hard plastics can be <w>milled</w>."
                            }
                        },
                        {
                            "text": "De timmerman moest een diepe gleuf in het hout <w>frezen</w>.",
                            "target_lang_translations": {
                                "en": "The carpenter had to <w>rout</w> a deep groove into the wood."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hout frezen",
                        "sleuven frezen"
                    ],
                    "target_lang_definitions": {
                        "en": "to perform a machining operation using a rotating tool, the milling cutter"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mill",
                                "target_lang_sense_clarification": "to shape or cut material using a rotating cutter"
                            },
                            {
                                "target_lang_word": "rout",
                                "target_lang_sense_clarification": "to cut grooves or hollow out areas in wood"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
