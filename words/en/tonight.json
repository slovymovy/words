                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I dreamt <w>tonight</w> that I did feast with Caesar.",
                            "target_lang_translations": {
                                "ru": "Мне приснилось <w>прошлой ночью</w>, что я пировал с Цезарем.",
                                "zh": "我<w>昨晚</w>梦见自己与凯撒共进宴席。",
                                "nl": "Ik droomde <w>vannacht</w> dat ik met Caesar dineerde.",
                                "pl": "Śniło mi się <w>zeszłej nocy</w>, że ucztowałem z Cezarem.",
                                "de": "Ich träumte <w>letzte Nacht</w>, dass ich mit Cäsar speiste.",
                                "fr": "J'ai rêvé <w>cette nuit-là</w> que je festoyais avec César.",
                                "it": "Ho sognato <w>stanotte</w> di banchettare con Cesare.",
                                "cs": "Zdálo se mi <w>minulou noc</w>, že hoduji s Caesarem.",
                                "tr": "<w>Dün gece</w> Sezar ile ziyafet çektiğimi gördüm.",
                                "es": "Soñé <w>anoche</w> que festejaba con César."
                            }
                        },
                        {
                            "text": "He spoke strangely of the visions he saw <w>tonight</w>.",
                            "target_lang_translations": {
                                "ru": "Он странно говорил о видениях, которые видел <w>прошлой ночью</w>.",
                                "zh": "他神情古怪地谈论起他<w>昨晚</w>看到的幻象。",
                                "nl": "Hij sprak vreemd over de visioenen die hij <w>vannacht</w> zag.",
                                "pl": "Mówił dziwne rzeczy o wizjach, które widział <w>zeszłej nocy</w>.",
                                "de": "Er sprach seltsam von den Visionen, die er <w>letzte Nacht</w> sah.",
                                "fr": "Il a parlé étrangement des visions qu'il a eues <w>cette nuit-là</w>.",
                                "it": "Parlava in modo strano delle visioni che ha avuto <w>stanotte</w>.",
                                "cs": "Podivně mluvil o vizích, které viděl <w>minulou noc</w>.",
                                "tr": "<w>Dün gece</w> gördüğü hayallerden tuhaf bir şekilde bahsetti.",
                                "es": "Habló extrañamente de las visiones que vio <w>anoche</w>."
                            }
