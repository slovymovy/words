        "fr-extract.jsonl": [],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "9522aa32-7833-3f64-916d-ed380c4265f9",
                "word": "sowas",
                "pos": "pron",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                        "entry_id": "9522aa32-7833-3f64-916d-ed380c4265f9",
                        "glosses": [
                            "eine solche Sache, so etwas"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "58401626-aa5d-4469-bd49-900f54812080",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Da rackert man sich jahrelang ab, schiebt Überstunden, bis die Schwarte kracht, verzichtet auf einen Teil seines Urlaubs - und dann sowas!"
                            },
                            {
                                "example_id": "455ede74-6c4d-4e0e-853d-0c4cb952871c",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Sowas hätte ich nicht für möglich gehalten."
                            },
                            {
                                "example_id": "237c0ec0-9a96-486e-905c-6149237957d6",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Sowas hat mir grade noch gefehlt."
                            },
                            {
                                "example_id": "a8c93deb-a048-4a20-a026-eb5c4f8417f1",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Wer tut sowas?; (ironisierend): Wer macht denn sowas!"
                            },
                            {
                                "example_id": "2912c422-eba5-4646-8866-bc29fdcd2349",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Und sowas weißt du nicht? Schäm dich!"
                            },
                            {
                                "example_id": "d274a4b0-6858-4b50-bdb3-bd33bcc00f3f",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Hat man sowas schon gesehen!?"
                            },
                            {
                                "example_id": "c8353f5b-a68a-49b0-b9b7-645323355676",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Das fass ich nicht an, da krieg ich ja Handpilz - apropos, gibt's sowas überhaupt?"
                            },
                            {
                                "example_id": "e189f516-8148-4ccc-b784-bc53b298cd8f",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Und sowas traust du dich, hier vorzulegen?"
                            },
                            {
                                "example_id": "b7a29530-d3d9-4633-9e5d-a8180d17a926",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Sowas Dummes, wie konnte ich nur!"
                            },
                            {
                                "example_id": "cb831490-85b1-44a7-b7a3-19c4cafa0055",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Habt ihr hier auch sowas wie Senf?"
                            },
                            {
                                "example_id": "b60e15b9-afb6-43c7-bf7a-509e76649b7a",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Er hat sowas wie ‚lauter Verrückte hier‘ in seinen nicht vorhandenen Bart gemurmelt."
                            },
                            {
                                "example_id": "8095f8ec-e9e5-4d6d-a836-54b38cc6c08f",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Sie ist sowas wie ein Shooting-Star in der Freiburger Gastro-Szene."
                            },
                            {
                                "example_id": "07215df2-8ed6-457f-bc13-324207765838",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Ich hab ja mit viel gerechnet, aber nicht mit sowas!"
                            },
                            {
                                "example_id": "a43447f3-87c1-4e30-aa5f-3fb5be92fca0",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Würdet ihr sowas in eine Bewerbung schreiben?"
                            },
                            {
                                "example_id": "6637d736-0dbc-4d48-8a8d-96d6867eccdf",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Mit sowas gebe ich mich erst gar nicht ab."
                            },
                            {
                                "example_id": "6a3d3b3f-0b6c-47be-bfc4-2254183feaa4",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Sowas kann schon mal passieren, davon geht die Welt nicht unter."
                            },
                            {
                                "example_id": "3ebbc94e-c3db-46ae-bc0e-718fa5baeba8",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Sowas habe ich ja noch nie gesehen!"
                            },
                            {
                                "example_id": "b69c4a09-a278-420c-ade5-018b9b62a187",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Was war denn das für einer gerade!? - Wer denn? Ach so, das ist nur unser Herr Hartmann. Der ist sowas wie unser Maskottchen. Der Chef nennt ihn ‚unsere gute Seele‘, die anderen sagen ‚das Faktotum‘, such dir was aus."
                            },
                            {
                                "example_id": "d9fe1e22-3aa1-4813-a77e-68d86a4268a2",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Und sowas läuft hier noch frei rum? Wieso sitzt der nicht längst im Knast?"
                            },
                            {
                                "example_id": "607506e7-3ad1-454c-8fe6-ccebc98a8c70",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Völlig inkompetent, die Frau, und sowas nennt sich Fachanwältin!"
                            },
                            {
                                "example_id": "13088217-215d-49d2-9b41-6231dec0d8cf",
                                "sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
                                "text": "Das ist sowas von blöd gelaufen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e6cce95-afa2-4bfe-bf3c-1a0ca48171cf",
                        "source_entry_id": "9522aa32-7833-3f64-916d-ed380c4265f9",
                        "source_sense_id": "976997f7-42a4-363b-a2a5-b5fc84a37d88",
