                                "example_id": "06f49957-f8e3-451e-8b2b-22660fb3bb88",
                                "sense_id": "b63c3b0a-d564-339a-b8c9-297d436dff31",
                                "text": "Het bezoek aan Jeruzalem was een hele belevenis."
                            },
                            {
                                "example_id": "3bbcea96-a867-434b-ba0f-1b456fbc823d",
                                "sense_id": "b63c3b0a-d564-339a-b8c9-297d436dff31",
                                "text": "Het museumbezoek zou een hele belevenis moeten zijn."
                            },
                            {
                                "example_id": "6d0a41da-9eed-4a8a-9619-f75f31b909bb",
                                "sense_id": "b63c3b0a-d564-339a-b8c9-297d436dff31",
                                "text": "Nadat wij details over onze tragische belevenissen hadden uitgewisseld, begon er bij mij een lampje te branden."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc8caa71-ebfb-3b55-b25f-9e15d4ea9889",
                        "entry_id": "9124b60f-dde1-3e48-8e2b-105b1365b099",
                        "glosses": [
