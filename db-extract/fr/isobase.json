                        "entry_id": "d03a1454-4da1-335e-a53d-2748f6f84f7a",
                        "glosses": [
                            "Courbe reliant sur une carte tous les points d'une couche géologique donnée se trouvant à la même altitude. Courbe sur une carte reliant les points d'égal relèvement ou enfoncement d'une couche géologique donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44cd9014-d659-404d-a41b-48e8d0c2e16b",
                                "sense_id": "a2f4298e-2916-3a8c-86c1-66e807636644",
                                "text": "Il représente les lignes de base ou les lignes de dislocation dérivées en analysant les déviations dans les directions des lignes isobases, de leur étalement ou de leur compression et des écarts entre les axes de vallées."
                            },
                            {
                                "example_id": "afbf0da6-d1b6-4e70-a139-a35c5aa917f5",
                                "sense_id": "a2f4298e-2916-3a8c-86c1-66e807636644",
                                "text": "Ces courbes et 14 autres provenant d'une grande région avoisinante constituent la base principale d'un ensemble de cartes d'isobase pour l'Arctique central."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fe16f13-3510-4172-b041-a04a2b2aee67",
                        "source_entry_id": "d03a1454-4da1-335e-a53d-2748f6f84f7a",
