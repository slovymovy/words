                                        "entry_id": "17684d73-e8a1-3b4f-9d90-877f107b7bbf",
                                        "glosses": [
                                            "die zweite japanische Silbenschrift, welche meist für Fremdwörter verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
