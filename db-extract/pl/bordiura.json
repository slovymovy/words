                                "target_senses": [
                                    {
                                        "sense_id": "ac04273d-9551-3203-914f-8432c36e4f23",
                                        "entry_id": "20e65135-fd41-3c21-9fca-27d249e8f086",
                                        "glosses": [
                                            "The line or frontier area separating political or geographical regions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4271a9a6-916b-4312-82f1-d1a7bd7176ae",
                                                "sense_id": "ac04273d-9551-3203-914f-8432c36e4f23",
                                                "text": "The border between Canada and USA is the longest in the world."
                                            },
                                            {
                                                "example_id": "a752d202-322e-4669-9a73-aa91b92b6e15",
                                                "sense_id": "ac04273d-9551-3203-914f-8432c36e4f23",
                                                "text": "The identification of the border between England and Scotland always has been a source of interest to railway travellers. For many years, however, the exact points north of Berwick and Carlisle at which the Anglo-Scottish main lines passed from one country to the other were not defined, but the erection of clear and unmistakable lineside signs has put the matter beyond all doubt."
                                            },
                                            {
                                                "example_id": "a1c929f1-c492-48c0-beaf-bcfe53fc7251",
                                                "sense_id": "ac04273d-9551-3203-914f-8432c36e4f23",
                                                "text": "The Ministry of Defence said on Wednesday the men had been killed on Tuesday in the Nahr-e Saraj district of Helmand province, on the border of Kandahar just north of the provincial capital Lashkar Gah."
                                            },
                                            {
                                                "example_id": "6cd58cf8-aaad-44bb-a573-e69bd6ef8f25",
                                                "sense_id": "ac04273d-9551-3203-914f-8432c36e4f23",
                                                "text": "23 June 2018, Mattha Busb, The Independent, Jogger crosses US-Canada border by mistake, is held for two weeks in detention centre\nA French tourist who accidentally crossed the border into the US from Canada during an evening jog was sent to a detention centre 125 miles away and held for two weeks until she was released."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44bcd1f-b916-3dbd-846e-27746fc21cfb",
                                        "entry_id": "20e65135-fd41-3c21-9fca-27d249e8f086",
                                        "glosses": [
                                            "The outer edge of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e05da5cc-34fd-4abb-81d6-018389b32039",
                                                "sense_id": "d44bcd1f-b916-3dbd-846e-27746fc21cfb",
                                                "text": "the borders of the garden"
                                            },
                                            {
                                                "example_id": "1d4a7ef4-d613-4b20-9840-4f0ba3fc65dd",
                                                "sense_id": "d44bcd1f-b916-3dbd-846e-27746fc21cfb",
                                                "text": "upon the borders of these solitudes"
                                            },
                                            {
                                                "example_id": "6893610e-5c94-4be1-a827-d0838ba4d114",
                                                "sense_id": "d44bcd1f-b916-3dbd-846e-27746fc21cfb",
                                                "text": "in the borders of death"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce5d67ea-4b96-32a6-aa67-f330e7b508a1",
                                        "entry_id": "20e65135-fd41-3c21-9fca-27d249e8f086",
                                        "glosses": [
                                            "A decorative strip around the edge of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c242b7bc-5b81-424d-90e6-19c029a9d2b8",
                                                "sense_id": "ce5d67ea-4b96-32a6-aa67-f330e7b508a1",
                                                "text": "There’s a nice frilly border around the picture frame."
                                            },
                                            {
