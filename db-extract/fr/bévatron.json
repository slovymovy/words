                        "glosses": [
                            "Accélérateur de particules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b798bd6-5a3f-41bb-bb82-e31695961176",
                                "sense_id": "4d35c625-73b6-3d30-b177-6e3de281154a",
                                "text": "Il fallut construire un cyclotron nommé le « bévatron » comportant un aimant de 10 000 tonnes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f049db5b-4fe7-43b6-a821-d95030137a98",
                        "source_entry_id": "e56c96f1-4152-3ab0-b6c4-69c953171d1e",
