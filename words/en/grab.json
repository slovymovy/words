                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>grab</w> for the ball, but it slipped through his fingers.",
                            "target_lang_translations": {
