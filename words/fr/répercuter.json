    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c27663ce-08be-391b-baab-196a11b84130",
                    "sense_definition": "Transmettre ou reporter un effet, des conséquences ou des frais supplémentaires sur quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transfert_effet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant a été contraint de <w>répercuter</w> la hausse des taxes sur les prix finaux.Les décisions budgétaires vont inévitablement se <w>répercuter</w> sur les projets de recherche en cours."
                        },
                        {
                            "text": "Les entreprises préfèrent souvent <w>répercuter</w> l'augmentation des coûts de transport sur les consommateurs."
                        }
                    ],
                    "synonyms": [
                        "transmettre",
                        "reporter"
                    ],
                    "common_phrases": [
                        "répercuter la hausse",
                        "répercuter les coûts",
                        "se répercuter sur"
                    ]
                },
                {
                    "sense_id": "0f441a6e-d6cf-3a2d-8c02-c0873d74bc3d",
                    "sense_definition": "Renvoyer un son par réflexion ou sous forme d'écho.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propagation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parois rocheuses de la montagne <w>répercutent</w> le moindre bruit dans toute la vallée."
                        },
                        {
                            "text": "La haute voûte de cette ancienne cathédrale <w>répercute</w> les chants avec une grande clarté."
                        }
                    ],
                    "synonyms": [
                        "résonner",
                        "réverbérer"
                    ],
                    "common_phrases": [
                        "répercuter le son",
                        "se répercuter au loin"
                    ]
                },
                {
                    "sense_id": "94e3cede-a39a-3e26-999d-7597e961e32c",
                    "sense_definition": "Renvoyer ou réfléchir la lumière ou un rayonnement physique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "propagation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La façade en verre du gratte-ciel <w>répercute</w> les rayons du soleil couchant sur la place."
                        },
                        {
                            "text": "Ces panneaux métalliques sont conçus pour <w>répercuter</w> la lumière vers les zones ombragées."
                        }
                    ],
                    "synonyms": [
                        "refléter",
                        "réverbérer"
                    ],
                    "common_phrases": [
                        "répercuter la lumière",
                        "répercuter les rayons"
                    ]
                }
            ]
        }
