                                            {
                                                "example_id": "45d2472d-6ee2-4204-be68-b954adddb352",
                                                "sense_id": "5b04e6c5-d534-3ff5-9d70-b27cb22b0305",
                                                "text": "La actuación docente influye en el comportamiento discente directamente, seleccionando, por ejemplo, las actividades de enseñanza y aprendizaje, e, indirectamente, a través de las actitudes."
                                            }
                                        ],
