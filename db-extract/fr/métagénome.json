                        "glosses": [
                            "Ensemble des gènes contenus dans un biotope donné, toutes espèces mélangées."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "a9ea2c90-cde1-413a-899f-94307aff6911",
                                "sense_id": "b8260ba9-d366-37de-8454-f4bdca718285",
                                "text": "Le métagénome constitué du génome humain et du microbiome intestinal est nécessaire au bon déroulement de la digestion."
                            },
                            {
                                "example_id": "e9bd9cf1-09a6-4d28-949e-9ef80e58356d",
                                "sense_id": "b8260ba9-d366-37de-8454-f4bdca718285",
                                "text": "La métagénomique (Handelsman, 2004) qui considère l’ensemble des génomes d’une communauté microbienne ou d’un écosystème entier comme un seul génome appelé métagénome, est une discipline en émergence."
                            }
                        ]
