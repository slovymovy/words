                ],
                "senses": [
                    {
                        "sense_id": "bd27e246-9754-3842-a8fa-bc518bfc01aa",
                        "entry_id": "82ba8b4f-1fa2-331e-acd1-ad30143c55fd",
                        "glosses": [
                            "kleiner Topf"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "128b7a51-e2b0-4c43-aea4-5755de02baa4",
                                "sense_id": "bd27e246-9754-3842-a8fa-bc518bfc01aa",
                                "text": "„Nur wenn man mit all der Vorsicht zu Werke geht, wird man sein Kochgeschirr schonen und wird nicht bald mit zerbeulten und unangenehm aussehenden Häferln kochen müssen.“"
                            },
                            {
                                "example_id": "465fd2c9-1c04-4c83-b87c-0017fd031b57",
                                "sense_id": "bd27e246-9754-3842-a8fa-bc518bfc01aa",
                                "text": "„In ein Häferl giebt man ein halbes Seidel Bier, einige Stückchen Zucker und läßt es siedend werden.“"
                            },
                            {
                                "example_id": "cdfb9d27-98b0-4138-9ec8-9b1ce174ad04",
                                "sense_id": "bd27e246-9754-3842-a8fa-bc518bfc01aa",
                                "text": "„Auf dem Herd steht das Häferl mit dem Kathreinerkaffee, sonntags gibt's echten Bohnenkaffee.“"
                            },
                            {
                                "example_id": "ffa81763-b943-437b-b11c-3a0c1ea40057",
                                "sense_id": "bd27e246-9754-3842-a8fa-bc518bfc01aa",
                                "text": "„Und da sind oft zehn Häferln gestanden auf dem Herd.“"
                            }
                        ],
