{
    "word_family": [
        "grand",
        "grandness",
        "grandeur",
        "aggrandize"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "84035f88-0c7b-315f-87c9-ff6115b8de6e",
                    "sense_definition": "In an impressive, majestic, or ambitious manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host smiled <w>grandly</w> and welcomed each guest into the magnificent ballroom.",
                            "target_lang_translations": {
                                "it": "Il padrone di casa sorrise <w>grandiosamente</w> e accolse ogni ospite nella magnifica sala da ballo."
                            }
                        },
                        {
                            "text": "He swept his arm <w>grandly</w> across the view to show off his new estate.",
                            "target_lang_translations": {
                                "it": "Mosse il braccio <w>con fare solenne</w> verso il panorama per mostrare la sua nuova tenuta."
                            }
                        }
                    ],
                    "synonyms": [
                        "regally"
                    ],
                    "common_phrases": [
                        "gesture grandly",
                        "announce grandly"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo maestoso, imponente o solenne."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "grandiosamente",
                                "target_lang_sense_clarification": "in modo maestoso o imponente"
                            },
                            {
                                "target_lang_word": "maestosamente",
                                "target_lang_sense_clarification": "con regalità o solennità"
                            },
                            {
                                "target_lang_word": "con aria di grandezza",
                                "target_lang_sense_clarification": "con fare solenne o altezzoso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4dedd75-91fa-3dd0-9a4c-122011097d39",
                    "sense_definition": "To the greatest or most magnificent extent; exceedingly or immensely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire charitable project succeeded <w>grandly</w> beyond what the organizers had anticipated.",
                            "target_lang_translations": {
                                "it": "L'intero progetto benefico riuscì <w>alla grande</w>, ben oltre le previsioni degli organizzatori."
                            }
                        },
                        {
                            "text": "Their visionary plans failed to succeed <w>grandly</w> despite years of dedicated effort.",
                            "target_lang_translations": {
                                "it": "I loro piani visionari non riuscirono ad affermarsi <w>grandiosamente</w> nonostante anni di impegno costante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "succeed grandly",
                        "fail grandly"
                    ],
                    "target_lang_definitions": {
                        "it": "In misura straordinaria, grandiosa o immensa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "alla grande",
                                "target_lang_sense_clarification": "con enorme successo, pienamente"
                            },
                            {
                                "target_lang_word": "grandiosamente",
                                "target_lang_sense_clarification": "in misura grandiosa o eccezionale"
                            },
                            {
                                "target_lang_word": "splendidamente",
                                "target_lang_sense_clarification": "in modo magnifico o superlativo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
