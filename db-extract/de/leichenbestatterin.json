                "senses": [
                    {
                        "sense_id": "53fb20fa-1eeb-3399-ad50-70739da0595f",
                        "entry_id": "68b461b0-fba7-3103-9c6d-e84173c66523",
                        "glosses": [
                            "Unternehmerin, der verstorbene Personen beisetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b5b91b-0916-4545-a25d-b91d684ba088",
                                "sense_id": "53fb20fa-1eeb-3399-ad50-70739da0595f",
                                "text": "„Die amerikanische Schauspielerin Angelina Jolie (36) wollte eigentlich Leichenbestatterin werden.“"
                            },
                            {
                                "example_id": "0540fe3f-42e5-4567-b9b7-76dfc10743b9",
                                "sense_id": "53fb20fa-1eeb-3399-ad50-70739da0595f",
                                "text": "Eine Bekannte von mir ist Leichenbestatterin."
                            },
                            {
                                "example_id": "b07c169e-b5d5-42b1-a3c5-4e38c3c819ba",
                                "sense_id": "53fb20fa-1eeb-3399-ad50-70739da0595f",
                                "text": "„In ihrem faszinierenden Porträt eines morbiden Mädchens, das sich von klein auf für tote Körper interessiert und später als Leichenbestatterin ihre nekrophilen Neigungen auslebt, hält sie die Balance zwischen kindlicher Unschuld und Tabubruch, zwischen Sinnlichkeit und Transzendenz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
