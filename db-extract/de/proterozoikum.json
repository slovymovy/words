                "senses": [
                    {
                        "sense_id": "493df679-70b3-3e65-b0de-8246b1bd30b1",
                        "entry_id": "8157f84f-2445-3817-926f-c94e1464e6bb",
                        "glosses": [
                            "nach dem Hadaikum und dem Archaikum der dritte große geologische Äon der Erde von ca. 542 bis 2500 Millionen Jahren vor unserer Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec50643-3328-4e3e-b5cc-65168eac0719",
                                "sense_id": "493df679-70b3-3e65-b0de-8246b1bd30b1",
                                "text": "\"Kennzeichen des Proterozoikums ist das Vorhandensein einer sauerstoffhaltigen Atmosphäre.\""
                            },
                            {
                                "example_id": "10eb769f-0e06-49bc-b1cc-ef7ef4f74170",
                                "sense_id": "493df679-70b3-3e65-b0de-8246b1bd30b1",
                                "text": "\"Der Name Proterozoikum zeigt an, dass es sich um die Zeit des beginnenden tierischen Lebens handelt.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
