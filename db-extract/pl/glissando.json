                                    {
                                        "sense_id": "f542729f-bd11-3b37-b954-56d4713a6c0f",
                                        "entry_id": "538b514d-f168-3818-84d0-d6164df3b9dd",
                                        "glosses": [
                                            "Either a continuous sliding from one pitch to another (\\\"true\\\" glissando), or an incidental scale played while moving from one melodic note to another (\\\"effective\\\" glissando)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d083a0a9-4974-464a-8e99-4dc9d04bc51a",
                                                "sense_id": "f542729f-bd11-3b37-b954-56d4713a6c0f",
                                                "text": "After another alternation of the two elements, there is a more playful episode, in which flute and bassoon take up the first element, with swooping glissando on the ondes Martenot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c70806-df8b-36e9-acaf-e537982457a0",
                                        "entry_id": "538b514d-f168-3818-84d0-d6164df3b9dd",
                                        "glosses": [
                                            "A method of playing an electric guitar in which a metal bar is held at right angles across the strings and rapidly moved up and down, creating a smooth, lush sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
