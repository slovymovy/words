                ],
                "senses": [
                    {
                        "sense_id": "330a2235-7251-339e-8591-54eee938df0a",
                        "entry_id": "787ea26d-e78a-373a-94df-af9583fa11a8",
                        "glosses": [
                            "The state of being connected"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff81ccea-0781-4d93-91bc-ac93dc4b9307",
                                "sense_id": "330a2235-7251-339e-8591-54eee938df0a",
                                "text": "Since submitting our Strategic Outline Business Case to the DfT last summer, MPs, government ministers and even the new Prime Minister have started talking about our £2 billion proposals as the answer to poor rail connectivity between the East Midlands and the West Midlands."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe80364a-d198-362f-82b9-650c416b6c04",
                        "entry_id": "787ea26d-e78a-373a-94df-af9583fa11a8",
                        "glosses": [
                            "The ability to make a connection between two or more points in a network"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1697d93e-4328-39e0-9d8d-3b11e2ea8c77",
                        "entry_id": "787ea26d-e78a-373a-94df-af9583fa11a8",
                        "glosses": [
                            "In a graph, a measure of concatenated adjacency (the number of ways that points are connected to each other)"
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06fde4be-b13c-44fe-813f-13a240168c45",
                        "source_entry_id": "787ea26d-e78a-373a-94df-af9583fa11a8",
                        "source_sense_description": "state of being connected",
                        "target_lang_word": "connexité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connexité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed51f629-7feb-3197-a4b0-3522e039f026",
                                        "entry_id": "b8340785-ad56-38e9-8070-7af0dd49ff80",
                                        "glosses": [
                                            "Liaison d’une chose avec une ou plusieurs autres du même genre."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a0ea69-7597-4e84-873c-75a1dbb92ba3",
                                                "sense_id": "ed51f629-7feb-3197-a4b0-3522e039f026",
                                                "text": "Je ne crois pas devoir insister sur la connexité qui liait à cette théorie les sciences équilatérales inventées par Gall et Lavater ; elles en étaient les corollaires naturels, et tout esprit légèrement scientifique apercevra les ramifications par lesquelles s’y rattachaient nécessairement les observations phrénologiques de l’un et les documents physiognomoniques de l’autre."
                                            },
                                            {
                                                "example_id": "7875b956-e3e6-423b-af7e-f9149bfb9f71",
                                                "sense_id": "ed51f629-7feb-3197-a4b0-3522e039f026",
                                                "text": "La connexité qui existe entre ce phénomène et les phénomènes éruptifs était une fois de plus démontrée."
                                            },
                                            {
                                                "example_id": "7f57a5d1-9ca6-4277-85c4-bac1c271c000",
                                                "sense_id": "ed51f629-7feb-3197-a4b0-3522e039f026",
                                                "text": "Les thérapeutes sont souvent amenés à définir le système qu’ils recevront en fonction des divers niveaux de connexité familiale : connexité spatio-temporelle des personnes vivant sous le même toit, ou éloignées mais maintenant d’autres proximités, connexité générationnelle et transgénérationnelle, connexité émotionnelle et fantasmatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64a8d2ad-5a95-3e7c-bec5-dc171d00129f",
                                        "entry_id": "b8340785-ad56-38e9-8070-7af0dd49ff80",
                                        "glosses": [
                                            "Lien entre deux demandes lorsque celles-ci sont étroitement liées entre elles, si bien qu’en les jugeant séparément, on risque d’aboutir à une contrariété de jugements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fcaa581-5c6f-316e-865e-6e1ed8ab0b2b",
                                        "entry_id": "b8340785-ad56-38e9-8070-7af0dd49ff80",
                                        "glosses": [
                                            "Liaison spatiale entre des éléments, dans la perception visuelle des formes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3798eaff-38bb-3462-9020-d83e949721dd",
                                        "entry_id": "b8340785-ad56-38e9-8070-7af0dd49ff80",
                                        "glosses": [
                                            "Ce qui est connexe, d’un seul tenant : qualité d’un espace qui n’est pas union disjointe de deux parties fermées non vides."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13657868-f2c3-322b-b387-724f138e8292",
                                        "entry_id": "b8340785-ad56-38e9-8070-7af0dd49ff80",
                                        "glosses": [
                                            "Caractéristique de ce qui est connexe. Propriété d’être connexe ou connexe par arcs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "809c0866-30a8-379b-a3c3-e8edd508544e",
                                        "entry_id": "b8340785-ad56-38e9-8070-7af0dd49ff80",
                                        "glosses": [
                                            "Lien entre les sous-graphes connexes d’un graphe."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c592f2e6-34fd-3a88-a2e6-b896280cee44",
                                        "entry_id": "b8340785-ad56-38e9-8070-7af0dd49ff80",
                                        "glosses": [
                                            "Propriété d’un réseau de téléinformatique dans lequel il est toujours possible de relier directement ou indirectement deux équipements quelconques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
