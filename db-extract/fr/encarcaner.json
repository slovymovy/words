                                "example_id": "c2087285-e8ed-4c33-b89b-55b33d0b4d02",
                                "sense_id": "0edcb397-1bfd-33af-93c4-146b22798359",
                                "text": "S’est ajouté Tout le monde en parle, qui fait office de court débat moins encarcané... mais qui force tout de même les chefs à rester à Montréal."
                            },
                            {
                                "example_id": "5c0b048c-9d4f-4b38-aebe-75c46f574a94",
                                "sense_id": "0edcb397-1bfd-33af-93c4-146b22798359",
                                "text": "Encarcané comme tu l'es, il arrive que tu n'aies pas de réponses intelligentes à fournir aux questions posées par les journalistes, mais les boutades t'ont plutôt mal servi jusqu'à présent!"
                            }
                        ]
