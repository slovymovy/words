    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ab9a33f-e49a-3256-8128-1381cff518eb",
                    "sense_definition": "Extremely angry or enraged.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer was <w>infuriated</w> by the constant delays and poor service.",
                            "target_lang_translations": {
                                "zh": "接连不断的延误和糟糕的服务让这位顾客<w>极其愤怒</w>。"
                            }
                        },
                        {
                            "text": "She grew <w>infuriated</w> by the blatant lies they told during the meeting.",
                            "target_lang_translations": {
                                "zh": "他们在会议上明目张胆地撒谎，让她变得<w>狂怒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enraged",
                        "furious",
                        "incensed",
                        "irate"
                    ],
                    "antonyms": [
                        "calm",
                        "delighted",
                        "pleased"
                    ],
                    "common_phrases": [
                        "infuriated by",
                        "visibly infuriated"
                    ],
                    "target_lang_definitions": {
                        "zh": "极为愤怒的，极其恼火的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狂怒的",
                                "target_lang_sense_clarification": "极度愤怒"
                            },
                            {
                                "target_lang_word": "极其愤怒的",
                                "target_lang_sense_clarification": "非常生气"
                            },
                            {
                                "target_lang_word": "大怒的",
                                "target_lang_sense_clarification": "勃然大怒"
                            },
                            {
                                "target_lang_word": "气极的",
                                "target_lang_sense_clarification": "极其恼火"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0faef194-53f3-31a2-bfaa-32a081a3c91a",
                    "sense_definition": "Simple past and past participle of <w>infuriate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His arrogant attitude <w>infuriated</w> everyone in the department.",
                            "target_lang_translations": {
                                "zh": "他傲慢的态度<w>激怒</w>了部门里的每一个人。"
                            }
                        },
                        {
                            "text": "The referee's decision has <w>infuriated</w> both the players and the fans.",
                            "target_lang_translations": {
                                "zh": "裁判的判决<w>激怒</w>了球员和球迷双方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "angered",
                        "enraged",
                        "infuriated"
                    ],
                    "antonyms": [
                        "appeased",
                        "calmed",
                        "soothed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
