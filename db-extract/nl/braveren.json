                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d22485bf-00ba-46e3-b8e2-6dba86ad3e81",
                                "sense_id": "1dbaf988-8b99-35c8-9864-4d9e7b8d12f4",
                                "text": "En we galmden het uit daar op die kleine lagere school, achter de hervormde kerk: „Ons vijanden braveren/ In ’t Westen en in ’t Oost;/ Maar in de Naam des Heeren/ Ben ik hun macht getroost!” ”Braveren” is de branie uithangen, opscheppen, en ”ben ik hun macht getroost” betekent: ik verzet mij moedig tegen hun macht”, legde de meester uit."
                            }
                        ]
                    }
