                    {
                        "sense_id": "ecd396d0-0c6f-3cc6-9ccb-9224176f323c",
                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                        "glosses": [
                            "Tending to socialize or be social."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "81952557-2f84-45d1-80a7-292fb78ae087",
                                "sense_id": "ecd396d0-0c6f-3cc6-9ccb-9224176f323c",
                                "text": "He's normally pretty quiet, but he gets much more sociable around women."
                            },
                            {
                                "example_id": "1eec6999-f39c-4035-9982-d5be0ebf5156",
                                "sense_id": "ecd396d0-0c6f-3cc6-9ccb-9224176f323c",
                                "text": "Society is no comfort to one not sociable."
                            }
                        ]
                    },
                    {
                        "sense_id": "a46a9aa1-601c-3731-8781-de7cb241a8b2",
                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                        "glosses": [
                            "Offering opportunities for conversation; characterized by much conversation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d151ed-97c4-4e28-bbd4-9c0157f41c5f",
                                "sense_id": "a46a9aa1-601c-3731-8781-de7cb241a8b2",
                                "text": "a sociable party"
                            }
                        ]
                    },
                    {
                        "sense_id": "eab4bf18-9e5a-3816-bb09-5602c83c9815",
                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                        "glosses": [
                            "Capable of being, or fit to be, united in one body or company; associable."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c4f9fdc9-8a66-4ee1-85fa-eee81b464fdb",
                                "sense_id": "eab4bf18-9e5a-3816-bb09-5602c83c9815",
                                "text": "They are sociable parts united into one body."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b34f8c4-1905-311e-b4a2-3baae20efb14",
                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                        "glosses": [
                            "No longer hostile; friendly."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fe3687f3-0241-4fda-a9f5-3523260b3786",
                                "sense_id": "0b34f8c4-1905-311e-b4a2-3baae20efb14",
                                "text": "Is the King sociable And bids thee live ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "247deedc-7295-446c-81fa-33c3c69e0427",
                        "source_entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                        "source_sense_description": "tending to socialize or be social; friendly; inviting; congenial",
                        "target_lang_word": "sociable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d86728e-76fe-3cff-a1e9-85628609a4f2",
                                        "entry_id": "e2f6be8c-1bde-3261-a844-996ac550b267",
                                        "glosses": [
                                            "Qui est naturellement porté à rechercher la société, qui est destiné à vivre en société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8606ff-c216-4546-9880-b4c3afa1665f",
                                                "sense_id": "0d86728e-76fe-3cff-a1e9-85628609a4f2",
                                                "text": "Il essaya de se persuader qu’il était à l’aise et en sécurité ; mais bientôt, l’indéfinissable inquiétude de l’animal sociable, abandonné dans la solitude, le tourmenta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39830dcb-689a-3bfe-98f7-a2e538ae34c9",
                                        "entry_id": "e2f6be8c-1bde-3261-a844-996ac550b267",
                                        "glosses": [
                                            "Avec qui il est facile de vivre, qui est d’un bon et facile commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4efe9d7b-f977-420d-9ca9-9ff6a1021f26",
                                                "sense_id": "39830dcb-689a-3bfe-98f7-a2e538ae34c9",
                                                "text": "Cet enfant est sociable, il s’intègre facilement à l’école."
                                            },
                                            {
                                                "example_id": "9604fb93-f247-4535-9dd5-9bab6d5f4096",
                                                "sense_id": "39830dcb-689a-3bfe-98f7-a2e538ae34c9",
                                                "text": "Le chien de prairie est un animal sociable."
                                            },
                                            {
                                                "example_id": "49f22beb-568b-4eda-9cf3-c6e6d62cedda",
                                                "sense_id": "39830dcb-689a-3bfe-98f7-a2e538ae34c9",
                                                "text": "Je le verrais quelquefois, s’il était plus sociable."
                                            },
                                            {
                                                "example_id": "2c36114d-62a7-4a78-a6be-424b0aec004c",
                                                "sense_id": "39830dcb-689a-3bfe-98f7-a2e538ae34c9",
                                                "text": "Madame Bergeret était précisément faite pour vivre en bonne intelligence avec un compagnon qu’elle trahissait et qu’elle opprimait dans la sereine exubérance de ses forces et dans le fonctionnement naturel de ses organes. Elle était sociable par richesse de chair et par défaut de vie intérieure."
                                            },
                                            {
                                                "example_id": "68224cd1-a2f6-4c61-98e7-06d8135fb356",
                                                "sense_id": "39830dcb-689a-3bfe-98f7-a2e538ae34c9",
                                                "text": "C’est une chose étonnante comme je me sens sociable, comparé à lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac8365de-691c-3f40-b8a3-242c908b73d4",
                                        "entry_id": "e2f6be8c-1bde-3261-a844-996ac550b267",
                                        "glosses": [
                                            "Qui porte vers les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3da35fa4-d038-4afb-8315-1091dac156a3",
                                                "sense_id": "ac8365de-691c-3f40-b8a3-242c908b73d4",
                                                "text": "Une humeur, un esprit sociable."
                                            },
                                            {
                                                "example_id": "8c7175e0-56aa-4f32-98b9-051efb01812b",
                                                "sense_id": "ac8365de-691c-3f40-b8a3-242c908b73d4",
                                                "text": "Un caractère sociable."
                                            }
                                        ]
                                    }
                                ]
                            },
