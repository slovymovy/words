                        "examples": [
                            {
                                "example_id": "819c57fb-bb44-4583-9f9d-d9d0473aac18",
                                "sense_id": "03d8c53c-e30f-3199-9f89-cc7ff320a00e",
                                "text": "Cette maison n'est plus un amas de pierres superposées architectoniquement ; non, ce mot est, dans, la langue des Flâneurs, un idiotisme intraduisible."
                            },
                            {
                                "example_id": "c4e1f863-118a-45dd-8657-554a9fa89e2a",
                                "sense_id": "03d8c53c-e30f-3199-9f89-cc7ff320a00e",
                                "text": "C’est donc comme si l'intention du sens se faisant se transposait architectoniquement, par la Stiftung de l'aperception perceptive, en intentionnalité de l'aperception perceptive, c'est à dire en intention du sens intentionnel, en son acception husserlienne, […]."
                            }
                        ]
