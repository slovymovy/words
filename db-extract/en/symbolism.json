                    },
                    {
                        "translation_id": "5a212aa1-f707-44da-8992-91ef0898d4c5",
                        "source_entry_id": "29f939a2-b33e-30e8-972b-de4fb879e058",
                        "source_sense_description": "representation of a concept",
                        "target_lang_word": "symbolisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbolisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1e009f-7bbc-30cb-a8f2-f77e92bcbda0",
                                        "entry_id": "ca29d07d-686b-3c34-a95d-fa16e0f226cd",
                                        "glosses": [
                                            "Figuration par des symboles, interprétation par les symboles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66476ec6-8a1d-4631-8028-78193a6148ec",
                                                "sense_id": "aa1e009f-7bbc-30cb-a8f2-f77e92bcbda0",
                                                "text": "Son interprétation rationnelle du symbolisme scripturaire s’exerce sans critérium ni règles fixes d’herméneutique pour distinguer ce qui, dans l’Écriture, doit être pris au sens littéral ou au figuré."
                                            },
                                            {
                                                "example_id": "e2cffbcf-d554-433c-90db-a7fff4bc668b",
                                                "sense_id": "aa1e009f-7bbc-30cb-a8f2-f77e92bcbda0",
                                                "text": "Le principe du rite est, en effet, que les hommes doivent se gorger de cette liqueur pour que la terre, par l’effet sympathique de ce symbolisme, soit imbibée de pluie bienfaisante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a9f114c-905b-3e99-aaab-af302f781615",
                                        "entry_id": "ca29d07d-686b-3c34-a95d-fa16e0f226cd",
                                        "glosses": [
                                            "Mouvement poétique de la fin du dix-neuvième siècle, en réaction contre l’école parnassienne et contre l’école naturaliste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddcedf69-f8d1-4ed8-a7fa-c322b644154c",
                                                "sense_id": "0a9f114c-905b-3e99-aaab-af302f781615",
                                                "text": "Ce livre, encore que compact, ne donne pas toute l’histoire du symbolisme ; il lui manque, pour être complet, de contenir une étude détaillée de l’œuvre de chaque symboliste, et conséquemment une étude des nuances, des différences, et même des contrastes entre les nombreux écrivains qui constituent le Symbolisme."
                                            },
                                            {
                                                "example_id": "219fd4e4-9bd0-422d-9305-033968532f58",
                                                "sense_id": "0a9f114c-905b-3e99-aaab-af302f781615",
                                                "text": "Elle immobilisait mes doigts dans les siens et repartait dans une dissertation sur le symbolisme de Joyce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "567b2323-7c81-4875-9d7e-25e05e3fdddb",
                        "source_entry_id": "29f939a2-b33e-30e8-972b-de4fb879e058",
                        "source_sense_description": "representation of a concept",
                        "target_lang_word": "Symbolik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Symbolik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7a1b67e-a7a3-3dbb-91ac-3c9f283ccf83",
                                        "entry_id": "7fe759ff-4c23-3791-a3ed-2a03bf9719d4",
                                        "glosses": [
                                            "symbolische, sinnbildliche Bedeutung von etwas und ihre Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c481c27-d84a-4976-b7c6-f8192c246634",
                                                "sense_id": "c7a1b67e-a7a3-3dbb-91ac-3c9f283ccf83",
                                                "text": "„Manchmal war die Oberfläche der Predella marmoriert, um den Stein des Grabes Christi zu imitieren und damit die Symbolik des Altars zu verdoppeln.“"
                                            },
                                            {
                                                "example_id": "e1c1b875-d51b-4d97-a518-8a377d9055e1",
                                                "sense_id": "c7a1b67e-a7a3-3dbb-91ac-3c9f283ccf83",
                                                "text": "„Der Hund teilt weitestgehend die Symbolik des Wolfes, von dem er abstammt: er ist Wächter und Krieger.“"
                                            },
                                            {
                                                "example_id": "0dfd654b-203a-4ad5-9546-5d7f9831e750",
                                                "sense_id": "c7a1b67e-a7a3-3dbb-91ac-3c9f283ccf83",
                                                "text": "„Dieses Buch hilft vergessene und verborgene Sprache der Symbolik in den Werken Bachs zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06f80965-bce5-3bbe-93fc-7d5b077d5618",
                                        "entry_id": "7fe759ff-4c23-3791-a3ed-2a03bf9719d4",
                                        "glosses": [
                                            "Verwendung von symbolischen, sinnbildlichen Elementen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79a2334-6f6c-4fa8-9367-70c47463eb59",
                                                "sense_id": "06f80965-bce5-3bbe-93fc-7d5b077d5618",
                                                "text": "„Dieses Buch hilft vergessene und verborgene Sprache der Symbolik in den Werken Bachs zu erkennen.“"
                                            },
                                            {
                                                "example_id": "40bf5884-a2c4-4d1e-a7f8-6524a02f25fe",
                                                "sense_id": "06f80965-bce5-3bbe-93fc-7d5b077d5618",
                                                "text": "„Adolf Hackmack macht es sich im vorliegenden Band zur Aufgabe, die Symbolik chinesischer Teppiche zu erklären.“"
                                            },
                                            {
                                                "example_id": "25803baf-93fa-4382-8504-12425c8cb017",
                                                "sense_id": "06f80965-bce5-3bbe-93fc-7d5b077d5618",
                                                "text": "„Die Verbindung von Seelendrama und Symbolik beschäftigt beide Regisseure in unterschiedlicher Weise.“"
                                            },
                                            {
                                                "example_id": "0128ba4d-a1f5-4938-9b94-3987b8b0e1c4",
                                                "sense_id": "06f80965-bce5-3bbe-93fc-7d5b077d5618",
                                                "text": "„Denn die christliche Symbolik ist nicht nur in Texten, sondern auch in Bildern dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c5066da5-123e-3d55-a59e-350508c857ac",
                                        "entry_id": "7fe759ff-4c23-3791-a3ed-2a03bf9719d4",
                                        "glosses": [
                                            "Wissenschaft, Lehre von der Bedeutung und Verwendung von Symbolen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf93e2cf-0dc5-4158-aa37-42eda5c622c3",
                                                "sense_id": "c5066da5-123e-3d55-a59e-350508c857ac",
                                                "text": "„Der Wiederentdecker und Neubegründer der Lehre von der Traumsymbolik, der Philosoph Scherner, hat gerade von diesen Leibreizen her seine Lehre von der Symbolik aufgebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d01c6ac1-e311-37dd-8d63-aaf76892352d",
                                        "entry_id": "7fe759ff-4c23-3791-a3ed-2a03bf9719d4",
                                        "glosses": [
                                            "Teilgebiet der Theologie, das sich mit den christlichen Konfessionen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be518f5-0a19-45c6-88f6-081148b995a0",
                                                "sense_id": "d01c6ac1-e311-37dd-8d63-aaf76892352d",
                                                "text": "Die Symbolik war eine der historischen Wissenschaften im Rahmen der theologischen Disziplinen an der Hochschule."
                                            },
                                            {
                                                "example_id": "63c3cbce-d8b3-4cc2-aeb3-9c7c07b04d90",
                                                "sense_id": "d01c6ac1-e311-37dd-8d63-aaf76892352d",
                                                "text": "Symbolik stellte die dogmatischen Gegensätze der Katholiken und Protestanten an Hand ihrer öffentlichen Bekenntnisschriften dar."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
