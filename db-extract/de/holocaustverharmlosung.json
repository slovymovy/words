                ],
                "senses": [
                    {
                        "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                        "entry_id": "e0427838-39a0-3eb0-95eb-6e5e5c934888",
                        "glosses": [
                            "falsche Darstellung des Völkermordes an Juden in der Zeit des Dritten Reichs als kaum bedeutungsvoll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c420e6-297c-4664-a2d6-6cdd5db45ba1",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "[Volker Beck:] „»Der pandemischen Verbreitung von Holocaustverharmlosung durch das Impfgegnermilieu muss dringend Einhalt geboten werden.«“"
                            },
                            {
                                "example_id": "d7ce1998-8876-4935-a742-aeafb390b27c",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Ein Coronademo-Organisator muss sich am 31. August wegen des Vorwurfs der Holocaustverharmlosung in Linz vor Gericht verantworten.“"
                            },
                            {
                                "example_id": "e30b15e3-c7e5-42a1-9823-ed68ca48fcd1",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Ein Zeuge sagt, er sei es leid, dass Winklers Äußerungen, auch Holocaustverharmlosungen, ohne strafrechtliche Folgen blieben.“"
                            },
                            {
                                "example_id": "e4673361-ebfa-4863-b063-cabad33249f3",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Dann war da noch der grobschlächtige Rechtsextremist Eric Zemmour, der bis Herbst 2021 jeden Abend zur besten Sendezeit im Privatfernsehen die krudesten Ideen verbreiten durfte – von Rassenlehre bis hin zu Holocaustverharmlosung.“"
                            },
                            {
                                "example_id": "e6fb3e8e-47c6-4967-80a4-d76a3fd966a5",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Der eine verniedlicht Holocaustverharmlosung, der andere nennt Hitler einen Linken, der dritte dämonisiert die Antifa – all diesen konservativen Kolumnisten ist die Lust am Zündeln gemein.“"
                            },
                            {
                                "example_id": "262fcbaa-619e-4e4c-8f90-5fcc0dad23a2",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Trotz der eklatanten Holocaustverharmlosung von Palästinenserpräsident Mahmoud Abbas bei seinem jüngsten Besuch im Kanzleramt in Berlin hat sich der Antisemitismusbeauftragte der Bundesregierung, Felix Klein, dafür ausgesprochen, den Gesprächsfaden mit ihm nicht abreißen zu lassen.“"
                            },
                            {
                                "example_id": "4db087d5-9d81-4a48-98b0-38e227c7b118",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "[Schlagzeile:] „Nach Würdigung von SS-Mann in Kanada – Holocaustverharmlosung bei Springer“"
                            },
                            {
                                "example_id": "734b9e6e-4189-460d-ae33-47bcc9ee17ed",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Jugendliche und junge Erwachsene zeigen vergleichsweise wenig Distanz zur Holocaustverharmlosung:“ […]."
                            },
                            {
                                "example_id": "2979b0ac-2864-45f9-bc12-456dbbd2171b",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Es sind vor allem die jungen Männer, die die Holocaustverharmlosung als zutreffend empfinden (22%) und sich gegen die Erinnerungskultur aufbäumen (32%).“"
                            },
                            {
                                "example_id": "a5e0ea65-0c10-4cec-9c2e-9528d596b001",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Gleichzeitig finden sich immer wieder antisemitische Vorfälle in derselben AfD-Partei, wenn beispielsweise die Rothschilds verteufelt wurden, die angeblich die nächste Wirtschaftskrise vorbereiteten, neben Holocaustverharmlosung oder gar dessen Leugnung (Keskinkilic ebd.).“"
                            },
                            {
                                "example_id": "4c273c30-72d1-4b07-b2fb-cc5b93bad31d",
                                "sense_id": "4224af11-b949-33de-aac0-e57f66802c5a",
                                "text": "„Der Vorwurf der Holocaustverharmlosung erwies sich als gänzlich unhaltbar,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
