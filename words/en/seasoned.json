                            },
                            {
                                "target_lang_word": "obyty",
                                "target_lang_sense_clarification": "znający się na czymś dzięki praktyce"
                            },
                            {
                                "target_lang_word": "wytrawny",
                                "target_lang_sense_clarification": "biegły w czymś, zaprawiony w bojach"
