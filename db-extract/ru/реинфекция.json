                                    {
                                        "sense_id": "eaabc191-048b-3c86-b735-daa7ecb48704",
                                        "entry_id": "2a5005ff-d764-323d-abd7-4c7caa0865e1",
                                        "glosses": [
                                            "wiederholte Ansteckung eines Organismus mit denselben pathogenen Keimen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3503b08-be62-4b72-81c9-e7a73d59c830",
                                                "sense_id": "eaabc191-048b-3c86-b735-daa7ecb48704",
                                                "text": "„Wenn nach einer Behandlung erneut Kopfläuse auftreten, ist das aufgrund von Reinfektionen aus der Familie, den verbliebenen Eiern oder falscher Anwendung der Mittel.“"
                                            }
                                        ],
