                                        "entry_id": "27fa0345-f46f-3a63-82e7-492e8881a5d2",
                                        "glosses": [
                                            "The act of giving a cuddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee277997-d4bd-4f73-83e4-3d190683265c",
                                                "sense_id": "24c1daaa-10e3-3963-b39b-f924a34722f8",
                                                "text": "Una envied all children their mothers. She had been only six when her mother died, but she had some very precious memories, treasured in her soul like jewels, of twilight cuddlings and morning frolics […]"
                                            }
                                        ]
                                    }
                                ]
                            }
