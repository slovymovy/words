                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "29f2f1ca-decc-4511-b458-c160106b6763",
                        "source_entry_id": "afa63499-c072-3283-b324-a1475641529f",
                        "source_sense_id": "35f380bc-b218-30bd-87a3-1a8ab0f03f66",
                        "source_sense_description": "Quality of being hyperactive",
                        "target_lang_word": "hyperactivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperactivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f27a1ea-ff39-359b-b4d2-3e03c8358f37",
                                        "entry_id": "8c053ebe-f893-31e5-ae4b-7ca63472f209",
                                        "glosses": [
                                            "Activité intense."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30081ddd-973d-4afa-86b7-84116cfffae7",
                                                "sense_id": "4f27a1ea-ff39-359b-b4d2-3e03c8358f37",
                                                "text": "Son hyperactivité est communicative et salutaire pour cette entreprise au bord de la faillite."
                                            },
                                            {
                                                "example_id": "8960e6fb-91c6-4613-810e-1cf3358a43ef",
                                                "sense_id": "4f27a1ea-ff39-359b-b4d2-3e03c8358f37",
                                                "text": "Un type trapu, hirsute, au visage rougeaud et vif, avec des petites lunettes et une barbe en broussaille, sur tous les dessins il donne une impression d’hyperactivité permanente, de bonne volonté et de candeur inépuisables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e9dd139-0d65-32e9-a6ef-063235f87277",
                                        "entry_id": "8c053ebe-f893-31e5-ae4b-7ca63472f209",
                                        "glosses": [
                                            "Trouble comportemental marqué par de l'hyperactivité associée à un déficit de l'attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ad7ba20-fa13-4122-be46-1ab2091722ef",
                                                "sense_id": "2e9dd139-0d65-32e9-a6ef-063235f87277",
                                                "text": "Ainsi se comprend l'énigme de son hyperactivité, de sa sthénicité, de son infatigabilité malgré des régimes très light, qui n'avait jamais trouvé d'explication plus cohérente que le génie de la maladie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b679a0e2-b99a-47c3-ab0f-4611d51a64c9",
                        "source_entry_id": "afa63499-c072-3283-b324-a1475641529f",
                        "source_sense_id": "35f380bc-b218-30bd-87a3-1a8ab0f03f66",
                        "source_sense_description": "Quality of being hyperactive",
                        "target_lang_word": "Hyperaktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hyperaktivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d19f4f48-237d-343d-ae78-0447c7029ceb",
                                        "entry_id": "6757fe94-e01a-3bd2-abb4-d545d434ef3c",
                                        "glosses": [
                                            "Eigenschaft/Handlungsweise, in übersteigertem (hyper-) Maße körperliche Unruhe, Bewegung (motorische Aktivität) zu zeigen"
                                        ],
                                        "tags": [
                                            "Pädagogik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc66fbb-2f5b-49bc-8458-b730732aed98",
                                                "sense_id": "d19f4f48-237d-343d-ae78-0447c7029ceb",
                                                "text": "„Dies wiederum löst einen ungeheuren Reizstress aus und trägt wesentlich zu der körperlichen Unruhe, der Hyperaktivität bei.“"
                                            },
                                            {
                                                "example_id": "28111607-de71-47a4-8fc4-fe28b7396473",
                                                "sense_id": "d19f4f48-237d-343d-ae78-0447c7029ceb",
                                                "text": "„Dem werden wir auf den Grund gehen, indem ich erkläre was AD(H)S mit und ohne Hyperaktivität ist und welche sanften Behandlungen nach meinen Erfahrungen empfehlenswert sind.“"
                                            },
                                            {
                                                "example_id": "3743c534-5134-4cf1-992a-5a96e48a4939",
                                                "sense_id": "d19f4f48-237d-343d-ae78-0447c7029ceb",
                                                "text": "„Die extreme Steigerung der uterinen Hyperaktivität wird als Wehensturm bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "246826f8-d9f6-3eaa-95d8-edf479565836",
                                        "entry_id": "6757fe94-e01a-3bd2-abb4-d545d434ef3c",
                                        "glosses": [
                                            "psychische Störung, bei der körperliche Unruhe, mangelnde Selbstregulation, auffälliges Sozialverhalten und generell impulsives Verhalten mit Konzentrationsschwäche einhergehen"
                                        ],
                                        "tags": [
                                            "Pädagogik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca903ddf-3932-4cb2-b950-833fbf54085e",
                                                "sense_id": "246826f8-d9f6-3eaa-95d8-edf479565836",
                                                "text": "„Hintergründe und Aufklärung über eine angebliche Krankheit, die sich wie eine Seuche verbreitet: Die Hyperaktivität unserer Kinder (ADHD).“"
                                            },
                                            {
                                                "example_id": "0a20e1fe-ddcc-42f9-ab60-d026b186622c",
                                                "sense_id": "246826f8-d9f6-3eaa-95d8-edf479565836",
                                                "text": "„Hyperaktivität (als Syndrom) lässt sich auch als eine dysregulatorische Störung begreifen, bei der es dem Kind auf der physiologischen, der kognitiven und emotionalen Ebene des Verhaltens nicht gelingt, sich situativen Anforderungen jeweils anzupassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
