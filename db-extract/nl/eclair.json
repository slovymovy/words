                        "sense_id": "d1be1d53-0791-3a03-a73d-b20ae409d839",
                        "entry_id": "f8a50c5a-9713-3031-b0f6-cc090f04d5e3",
                        "glosses": [
                            "langwerpig soesje met laag chocolade of glazuur en een slagroom vulling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd815e08-41e2-4635-b4a4-d0f371c53052",
                                "sense_id": "d1be1d53-0791-3a03-a73d-b20ae409d839",
                                "text": "Voorgangers van Android KitKat kregen de namen Cupcake, Donut, Eclair, Froyo (frozen yoghurt), Gingerbread, Honeycomb, Ice Cream Sandwich en Jelly Bean. Lagerling legde aan de BBC uit dat het team uiteindelijk afzag van Key Lime Pie omdat te weinig mensen de smaak van de taart zouden kennen. 'Eén van de snacks die we in de koelkast bewaren voor de avonduren is Kitkat. Iemand zei: waarom noemen we de volgende versie niet Kitkat?' Vervolgens werd contact gelegd met Nestlé en een dag later was de afspraak rond."
                            },
                            {
                                "example_id": "837914c0-111b-4138-9931-95a2c0c38410",
                                "sense_id": "d1be1d53-0791-3a03-a73d-b20ae409d839",
                                "text": "De slagroomtaarten en soezen van de banketbakker zijn vervangen door de mille-feuille en een éclair van de patisserie. ,,We zijn van groot en veel naar klein en verfijnd gegaan”, zegt foodwatcher Anneke Ammerlaan."
                            }
                        ]
                    }
