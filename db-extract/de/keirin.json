                                        "entry_id": "2102c13d-7850-35ff-b570-c630a90e6fa3",
                                        "glosses": [
                                            "A form of track cycling originating in Japan, where riders must initially race behind a motorised pace-setter, the derny."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d22917c9-f921-40a5-8d29-fda030e25aab",
                                                "sense_id": "671a0df2-0d80-3a98-bccf-66897a809735",
                                                "text": "The keirin is one of the few track cycling events not originating in the West, having been developed in Japan. […] Keirin is extrememly popular in Japan, in particular because of gambling on the races."
                                            },
                                            {
                                                "example_id": "f825975e-9374-42db-9d7f-62f4190560cf",
                                                "sense_id": "671a0df2-0d80-3a98-bccf-66897a809735",
                                                "text": "Japan, however, has developed the distinctive cycling subculture of Keirin racing. Launched in Japanese velodromes in 1948 as a state regulated system designed to cream-off a percentage of stake money to support Japan's newly reconstituted bicycle industry […]"
                                            }
                                        ]
                                    }
