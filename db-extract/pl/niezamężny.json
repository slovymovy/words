                                "target_senses": [
                                    {
                                        "sense_id": "adc11ca2-2fa3-3486-ad7b-74ba2e4111a5",
                                        "entry_id": "b6d55b56-00c7-34ce-8625-b30d5391eefc",
                                        "glosses": [
                                            "Having no husband or wife."
                                        ],
                                        "tags": [
