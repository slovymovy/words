                "senses": [
                    {
                        "sense_id": "e115922b-2915-3cd6-8cb2-371db69c542d",
                        "entry_id": "081d923c-60ff-3907-ac28-e13a7b5bf067",
                        "glosses": [
                            "крупнейший материк на Земле, состоящий из Европы и Азии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7eea4e-2b2b-47de-9559-f039be33371b",
                                "sense_id": "e115922b-2915-3cd6-8cb2-371db69c542d",
                                "text": "На Евразию приходится 75 процентов населения Земли и 75 процентов энергетических запасов. В целом потенциальная мощь Евразии превосходит мощь США."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b273d7ac-0910-42fa-9373-bce5c1dae5cf",
                        "source_entry_id": "081d923c-60ff-3907-ac28-e13a7b5bf067",
                        "source_sense_id": "e115922b-2915-3cd6-8cb2-371db69c542d",
                        "target_lang_word": "Eurasia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eurasia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77f903c9-a04f-3bc9-8cf1-0af2f8eaeb02",
                                        "entry_id": "e1fec189-21b9-3447-bdb0-7a4ec3d23184",
                                        "glosses": [
                                            "The largest and most populous landmass on Earth, a supercontinent consisting of Europe and Asia; sometimes also including neighboring islands."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbdf9010-0fe2-3da4-8635-cc2c94f7ba7e",
                                        "entry_id": "e1fec189-21b9-3447-bdb0-7a4ec3d23184",
                                        "glosses": [
                                            "A region comprising parts of Eastern Europe, the Caucasus and Central Asia; the countries of the former Soviet Union and the sphere of influence of Russia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d980ab3b-b7dc-45c9-bd92-d440a2e48ae3",
                                                "sense_id": "cbdf9010-0fe2-3da4-8635-cc2c94f7ba7e",
                                                "text": "This bureaucratic security-minded elite has invariably weathered changes in government by maintaining the personal ties that continue to dominate political life in the newly independent states. Political patronage continues to thrive in Eurasia."
                                            },
                                            {
                                                "example_id": "1b822691-c7d8-4b6a-8ec2-4cedce930731",
                                                "sense_id": "cbdf9010-0fe2-3da4-8635-cc2c94f7ba7e",
                                                "text": "The Failure of Regionalism in Eurasia and the Western Ascendancy over Russia's Near Abroad"
                                            },
                                            {
                                                "example_id": "26367fc6-6ec4-4d41-92b4-6f02305a029c",
                                                "sense_id": "cbdf9010-0fe2-3da4-8635-cc2c94f7ba7e",
                                                "text": "Turkey is one of the regional actors with ambitions to influence regional developments in Eurasia, which is geographically a very large land mass between Eastern Europe and China."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
