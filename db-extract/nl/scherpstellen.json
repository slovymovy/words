                    },
                    {
                        "translation_id": "fec2b13d-b5c1-4c31-9570-d1246c224ad9",
                        "source_entry_id": "7311a84f-74ca-3ea4-a692-370aeea731d8",
                        "source_sense_id": "b17eee4d-c206-3622-b467-7c87ec581029",
                        "source_sense_description": "een optische instrument zo instellen dat dat een scherp beeld ontstaat",
                        "target_lang_word": "focus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "focus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ad0e62-89b8-3460-8f57-b35a4f13f7d4",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "A point at which reflected or refracted rays of light converge."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8283ff6-06e6-47cb-ab3a-3c0f4fde69e3",
                                                "sense_id": "b8ad0e62-89b8-3460-8f57-b35a4f13f7d4",
                                                "text": "The heat of sunlight at the focus of a magnifying glass can easily set dry leaves on fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688894fe-2b7f-3970-9a39-0e00475f6fd2",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "A point of a conic at which rays reflected from a curve or surface converge."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b3f67c6-8847-3e9b-93f7-c1d1cacc3ea4",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The fact of the convergence of light on the photographic medium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b03cae97-9744-435e-918a-cf3856ba5436",
                                                "sense_id": "4b3f67c6-8847-3e9b-93f7-c1d1cacc3ea4",
                                                "text": "Unfortunately, the license plate is out of focus in this image."
                                            },
                                            {
                                                "example_id": "b22ce163-c270-4dfa-b795-606e85d905ae",
                                                "sense_id": "4b3f67c6-8847-3e9b-93f7-c1d1cacc3ea4",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df78c567-dd89-38b1-92f3-a14f54d0c706",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The quality of the convergence of light on the photographic medium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeebd194-1c71-4b9a-b3f6-5566a491babe",
                                                "sense_id": "df78c567-dd89-38b1-92f3-a14f54d0c706",
                                                "text": "During this scene, the boy’s face shifts subtly from soft focus into sharp focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc05359f-0eab-3d00-9eea-f16fae0b4a9a",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "Concentration of attention."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d836dd39-1aac-4199-b1e9-34c6ed4010d2",
                                                "sense_id": "fc05359f-0eab-3d00-9eea-f16fae0b4a9a",
                                                "text": "I believe I can bring the high degree of focus required for this important job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd6c6054-6f07-36dd-8e30-3bc546668049",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "Something to which activity, attention or interest is primarily directed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3febecd-f6e6-4d2b-adbd-5c9e93eb986c",
                                                "sense_id": "dd6c6054-6f07-36dd-8e30-3bc546668049",
                                                "text": "My studies are my main focus right now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d91bd9a6-e80d-3579-95ac-81f06a14d097",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The exact point of where an earthquake occurs, in three dimensions (underneath the epicentre)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81129770-31b3-4197-8b03-327efb8aed62",
                                                "sense_id": "d91bd9a6-e80d-3579-95ac-81f06a14d097",
                                                "text": "The earthquake's focus was at exactly 37 degrees north, 18 degrees south, seventy five meters below the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32e5097-f510-3efa-98ac-5c392df3ed84",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The status of being the currently active element in a user interface, often indicated by a visual highlight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf5664ac-79ae-42a7-93ff-5ab2e6bbccef",
                                                "sense_id": "e32e5097-f510-3efa-98ac-5c392df3ed84",
                                                "text": "Text entered at the keyboard or pasted from a clipboard is sent to the component which currently has the focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08a674c-16be-3a45-a644-c219b02eba7d",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The most important word or phrase in a sentence or passage, or the one that imparts information."
                                        ],
                                        "tags": [
                                            "countable",
