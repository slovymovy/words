            "senses": [
                {
                    "sense_id": "b73faa8c-0503-3a13-b15b-7fbcadb0413f",
                    "sense_definition": "Lacking basic necessities of life, such as food, money, or shelter; living in poverty.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity works to provide food and warm clothing to <w>needy</w> families during the winter.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация работает над тем, чтобы обеспечить едой и теплой одеждой <w>нуждающиеся</w> семьи зимой."
                            }
                        },
                        {
                            "text": "They organized a fund to support <w>needy</w> students who cannot afford university tuition.",
                            "target_lang_translations": {
                                "ru": "Они организовали фонд для поддержки <w>малообеспеченных</w> студентов, которые не могут оплатить учебу в университете."
                            }
                        }
                    ],
                    "synonyms": [
