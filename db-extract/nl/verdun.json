            {
                "entry_id": "ad8d8272-74cc-3ff7-a93a-61f6a936f6d9",
                "word": "Verdun",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c52a9c0-eacb-3da3-b5a8-2d5b6872c7d2",
                        "entry_id": "ad8d8272-74cc-3ff7-a93a-61f6a936f6d9",
                        "glosses": [
                            "de naam van diverse Franse plaatjes w.o. een gemeente in het Franse departement Meuse (regio Lotharingen) die deel uitmaakt van het arrondissement Verdun, gelegen in de noord-oosthoek van Frankrijk en vooral bekend om de slag van Verdun (een van de bloedigste veldslagen uit de geschiedenis van de Eerste Wereldoorlog)"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "26a3cd7c-c253-4023-b6ab-eca66b85d99a",
                                "sense_id": "1c52a9c0-eacb-3da3-b5a8-2d5b6872c7d2",
                                "text": "Honderd jaar na de slag van Verdun, waarbij driehonderdduizend Fransen en Duitsers omkwamen, hebben de Franse president François Hollande en de Duitse bondskanselier Angela Merkel zondag een herdenking gehouden"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ab3ca35-7e7f-404f-88e5-184ae7336a98",
                        "source_entry_id": "ad8d8272-74cc-3ff7-a93a-61f6a936f6d9",
                        "source_sense_id": "1c52a9c0-eacb-3da3-b5a8-2d5b6872c7d2",
                        "target_lang_word": "Verdun",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdun",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "516ba4db-5350-383c-8b75-a73131fdf843",
                                        "entry_id": "998631b4-5987-3a87-8077-6e6ea66b4cd8",
                                        "glosses": [
                                            "Commune française, située dans le département de l’Ariège."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c244c27-9c37-377a-bc81-75b8ece52242",
                                        "entry_id": "998631b4-5987-3a87-8077-6e6ea66b4cd8",
                                        "glosses": [
                                            "Commune française, située dans le département de la Meuse et sous-préfecture de ce département."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ddf22e-17d4-4f65-931f-d3395ecfae75",
                                                "sense_id": "4c244c27-9c37-377a-bc81-75b8ece52242",
                                                "text": "Vous savez que Verdun n'est point encore au pouvoir de vos ennemis."
                                            },
                                            {
                                                "example_id": "30b333ad-f80b-4048-8f0a-050cdf8e6907",
                                                "sense_id": "4c244c27-9c37-377a-bc81-75b8ece52242",
                                                "text": "Le général Sarrail commande la place de Verdun. Le 44ᵉ régiment de R.A.T. occupe la ville."
                                            },
                                            {
                                                "example_id": "72a589c1-1dc9-48b3-b6e7-171c3df7f2f8",
                                                "sense_id": "4c244c27-9c37-377a-bc81-75b8ece52242",
                                                "text": "Il ne résiste pas à un détour par Verdun, et à Lemmes, sur la Voie sacrée, s’arrête devant un petit café-restaurant où communient dans le même souvenir des rescapés comme lui, indemnes ou terrifiantes gueules cassées."
                                            },
                                            {
                                                "example_id": "eae530e4-c7f9-4d76-90b1-84232b242658",
                                                "sense_id": "4c244c27-9c37-377a-bc81-75b8ece52242",
                                                "text": "Verdun était une ville de brume et d'air gris, engoncée dans le souvenir de ses batailles et de ses morts; son ciel, couvert de nuages métalliques ou peint de bleu horizon des poilus, recommençait le souvenir des boues et des baïonnettes, des corps grimaçants sous le feu de l'ennemi."
                                            },
                                            {
                                                "example_id": "5f0d234d-2a2e-4c42-81d1-a7d3c8c93361",
                                                "sense_id": "4c244c27-9c37-377a-bc81-75b8ece52242",
                                                "text": "Sainte-Menehould, Marne, entre Verdun et Chalons-en-Champagne, clé de la Champagne, dont le duc de Lorraine aurait voulu s'emparer. Charles de Lorraine leva le siège de cette ville, le 30 octobre, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69297c9f-3341-3eb1-af4d-6906ca3c33f5",
                                        "entry_id": "998631b4-5987-3a87-8077-6e6ea66b4cd8",
                                        "glosses": [
                                            "Nom donné à la longue et meurtrière bataille qui s'y déroula en 1916."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57d14c9e-43f5-3df9-a423-178b29e411eb",
                                        "entry_id": "998631b4-5987-3a87-8077-6e6ea66b4cd8",
                                        "glosses": [
                                            "Ancien nom de la commune française Verdun-en-Lauragais."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
