                                "target_senses": [
                                    {
                                        "sense_id": "9b75c9ab-701b-31d6-a0f3-912ca8c96988",
                                        "entry_id": "816ae482-7dd0-3420-ab79-fa9d83cb7563",
                                        "glosses": [
                                            "einer Elite angehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926cf4c5-797d-4a35-befc-9a9d56af84e9",
                                                "sense_id": "9b75c9ab-701b-31d6-a0f3-912ca8c96988",
                                                "text": "Es ist schon ein elitärer Kreis, der sich da jeden 1. Montag im Monat in der Bibliothek trifft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca90b311-7f07-34a1-9af7-9c97270bf8cf",
                                        "entry_id": "816ae482-7dd0-3420-ab79-fa9d83cb7563",
                                        "glosses": [
                                            "aufgrund der Zugehörigkeit zu einer Elite sich selbst heraushebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24a16dac-4c8f-4acb-b9ba-e6b0e2352763",
                                                "sense_id": "ca90b311-7f07-34a1-9af7-9c97270bf8cf",
                                                "text": "Manche Vereinigungen nehmen nicht jeden auf, sondern nur Menschen, von denen sie denken, dass diese eine besondere Eigenschaft besitzen. Sie sind und verhalten sich elitär."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
