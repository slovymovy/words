                                    {
                                        "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                        "entry_id": "7c3af31c-774e-3cd9-8a99-e81fea99f1b7",
                                        "glosses": [
                                            "schnelles, mittelgroßes, leicht gepanzertes Kriegsschiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ac86b1-15ea-4733-b41d-e0a74624704d",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "Die SMS Scharnhorst war ein großer Kreuzer der kaiserlichen Marine."
                                            },
                                            {
                                                "example_id": "b7dd551b-0a02-4c0a-ac6f-9f9f55e45527",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Gleich zu Beginn meiner zweiten Wache begegneten wir einem japanischen Kreuzer und einem Zerstörer auf Gegenkurs.“"
                                            },
                                            {
                                                "example_id": "da0995c6-9356-45ac-9166-65661c08d002",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Am 30. Juli 1945 wurde der amerikanische Kreuzer Indianapolis mit fast 1200 Mann Besatzung von einem japanischen Unterseeboot torpediert.“"
                                            },
                                            {
                                                "example_id": "1fa789a4-6329-4b22-a7df-c5d184804903",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Ein britischer Flottenverband, der im März aus Europa eingetroffen war, beteiligte sich mit zwei Schlachtschiffen, vier Flugzeugträgern, sechs Kreuzern und fünfzehn Zerstörern an dem Unternehmen.“"
                                            },
                                            {
                                                "example_id": "e788244c-b286-4b9b-8afb-784c8f235df3",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Zu jener Zeit schickten die englischen Kreuzer viele gekaperte amerikanische Schiffe in den Hafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a8c7f97-4f7b-3f6b-a237-17cb32410782",
                                        "entry_id": "7c3af31c-774e-3cd9-8a99-e81fea99f1b7",
                                        "glosses": [
                                            "kleine Münze, früher in Deutschland und Österreich-Ungarn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db47c61d-b991-43df-9c0d-2ab589d3611b",
                                                "sense_id": "7a8c7f97-4f7b-3f6b-a237-17cb32410782",
                                                "text": "Ein Heller sind zehn Kreuzer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
