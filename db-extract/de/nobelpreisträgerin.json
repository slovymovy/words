                        "glosses": [
                            "weibliche Person, die mit einem Nobelpreis ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "885b4939-e713-4bb2-8d09-0ceb249abf70",
                                "sense_id": "1176d3e3-638f-3e16-a6f8-10fd46daaa13",
                                "text": "Die Nobelpreisträgerin wurde als Ehrengast zum Vortrag über Nuklearphysik eingeladen."
                            },
                            {
                                "example_id": "dab0eac4-7bb0-4d95-a091-6615201c06a3",
                                "sense_id": "1176d3e3-638f-3e16-a6f8-10fd46daaa13",
                                "text": "„So wollte ich zum Beispiel mit der Nobelpreisträgerin Christiane Nüsslein-Volhard eigentlich über Freiheit in der Forschung sprechen, aber plötzlich redeten wir darüber, warum Fische schön sind und Angela Merkel besser Physikerin geblieben wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
