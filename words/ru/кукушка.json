{
    "word_family": [
        "кукушечий",
        "кукушкин",
        "куковать",
        "кукование"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db41604b-71ec-3b12-8936-d095756ccddd",
                    "sense_definition": "Лесная перелётная птица, не строящая собственного гнезда и издающая характерный звук «ку-ку».",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "птица",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В глубине весеннего леса громко куковала <w>кукушка</w>, и мы сбились со счета.",
                            "target_lang_translations": {
                                "en": "Deep in the spring woods, a <w>cuckoo</w> was calling loudly, and we lost count."
                            }
                        },
                        {
                            "text": "Серая <w>кукушка</w> подкладывает свои яйца в чужие гнезда других птиц.",
                            "target_lang_translations": {
                                "en": "The common <w>cuckoo</w> lays its eggs in the nests of other birds."
                            }
                        }
                    ],
                    "synonyms": [
                        "зозуля",
                        "зегзица"
                    ],
                    "common_phrases": [
                        "часы с кукушкой"
                    ],
                    "target_lang_definitions": {
                        "en": "A woodland migratory bird that does not build its own nest and produces a characteristic 'cuckoo' call."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cuckoo",
                                "target_lang_sense_clarification": "bird"
                            },
                            {
                                "target_lang_word": "common cuckoo",
                                "target_lang_sense_clarification": "bird species"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff4e3341-8c9e-37bd-9c39-1778bd6ddbb3",
                    "sense_definition": "Женщина или мать, которая бросила своего ребёнка или отказалась от него.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "человек",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Соседи осуждали мать, называя её бессердечной <w>кукушкой</w> из-за того, что она бросила сына.",
                            "target_lang_translations": {
                                "en": "The neighbors condemned the mother, calling her a heartless <w>deadbeat mother</w> because she had abandoned her son."
                            }
                        },
                        {
                            "text": "Эта непутёвая <w>кукушка</w> оставила новорождённого прямо в родильном доме и ушла.",
                            "target_lang_translations": {
                                "en": "That irresponsible <w>runaway mother</w> left her newborn right at the maternity hospital and walked away."
                            }
                        }
                    ],
                    "common_phrases": [
                        "мать кукушка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное неодобрительное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A woman or mother who abandons or gives up her child."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deadbeat mother",
                                "target_lang_sense_clarification": "mother who abandons her children"
                            },
                            {
                                "target_lang_word": "runaway mother",
                                "target_lang_sense_clarification": "mother who abandons her children"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c074c52f-3593-3f82-89c1-fa21f37b153a",
                    "sense_definition": "Короткий местный поезд или отдельный паровоз на второстепенных или узкоколейных путях.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "транспорт",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старая <w>кукушка</w> неторопливо везла пассажиров между маленькими дачными поселками.",
                            "target_lang_translations": {
                                "en": "The old <w>puddle jumper</w> was slowly ferrying passengers between little cottage settlements."
                            }
                        },
                        {
                            "text": "По узкоколейной железной дороге ходила небольшая <w>кукушка</w> из двух вагонов.",
                            "target_lang_translations": {
                                "en": "A small two-car <w>dinky</w> ran along the narrow-gauge railway."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное железнодорожное обозначение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small local train, tank locomotive, or light railway train on secondary or narrow-gauge tracks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "puddle jumper",
                                "target_lang_sense_clarification": "small local train"
                            },
                            {
                                "target_lang_word": "dinky",
                                "target_lang_sense_clarification": "small local or narrow-gauge locomotive/train"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab74541a-c90e-3433-92b9-3d13a978ea20",
                    "sense_definition": "Медицинская процедура промывания околоносовых пазух методом перемещения жидкости.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "медицина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач назначил пациенту курс неприятной, но эффективной <w>кукушки</w> для лечения синусита.",
                            "target_lang_translations": {
                                "en": "The doctor prescribed the patient a course of unpleasant but effective <w>displacement therapy</w> to treat sinusitis."
                            }
                        },
                        {
                            "text": "После пяти сеансов <w>кукушки</w> носовое дыхание полностью восстановилось.",
                            "target_lang_translations": {
                                "en": "After five sessions of the <w>sinus displacement procedure</w>, nasal breathing was fully restored."
                            }
                        }
                    ],
                    "common_phrases": [
                        "процедура кукушка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный медицинский термин"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A medical procedure for sinus irrigation using the fluid displacement method (Proetz displacement therapy)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Proetz displacement therapy",
                                "target_lang_sense_clarification": "sinus irrigation procedure"
                            },
                            {
                                "target_lang_word": "sinus displacement therapy",
                                "target_lang_sense_clarification": "medical nasal irrigation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f404b2e6-fc3a-3a83-95f7-2728a9978a6e",
                    "sense_definition": "Снайпер, обустроивший огневую позицию высоко на дереве.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "военное",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пехотинцы долго не могли понять, с какой ветки стреляет вражеская <w>кукушка</w>.",
                            "target_lang_translations": {
                                "en": "For a long time, the infantrymen could not tell from which branch the enemy <w>tree sniper</w> was firing."
                            }
                        },
                        {
                            "text": "Опытный снайпер снял замаскированную <w>кукушку</w> точным ответным выстрелом.",
                            "target_lang_translations": {
                                "en": "An experienced sniper took out the camouflaged <w>tree sniper</w> with an accurate return shot."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "военный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A sniper perched in a tree to shoot at enemy soldiers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tree sniper",
                                "target_lang_sense_clarification": "sniper positioned in a tree"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7b90cd0e-f6dd-3b0e-8ee4-4790f821a543",
                    "sense_definition": "Название ряда сельских населённых пунктов в различных регионах России.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "топоним",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Небольшая деревня <w>Кукушка</w> расположена вдалеке от оживленных автомобильных дорог.",
                            "target_lang_translations": {
                                "en": "The small village of <w>Kukushka</w> is located far from busy highways."
                            }
                        },
                        {
                            "text": "Почтовый фургон приезжает в <w>Кукушку</w> всего два раза в неделю.",
                            "target_lang_translations": {
                                "en": "The mail van comes to <w>Kukushka</w> only twice a week."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The name of several rural localities in various regions of Russia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Kukushka",
                                "target_lang_sense_clarification": "village name"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}