                    {
                        "translation_id": "92f37646-8501-4583-b21f-3cbdccac3415",
                        "source_entry_id": "8f4de5cb-8a57-3715-bbcd-1aff830bfbba",
                        "source_sense_id": "4ebd65d9-42bf-3964-accd-91b1ed19fc7c",
