                                "sense_id": "01c78021-938d-3d59-9783-b5f906cbdb8e",
                                "text": "„Ich kam danach mit drei Infanterieoffizieren zusammen, die bei einem Gegenstoß gefangen worden waren.“"
                            },
                            {
                                "example_id": "eba8e684-7063-42c0-bfc7-556cbc0e34f3",
                                "sense_id": "01c78021-938d-3d59-9783-b5f906cbdb8e",
                                "text": "„Und der Besitzer der männlichen Stimme, offenbar ein Infanterieoffizier, lachte laut auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
