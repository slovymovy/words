                        ],
                        "examples": [
                            {
                                "example_id": "fd4feda8-7a49-4653-8124-cc64c757274f",
                                "sense_id": "bc4a4148-4ee6-3210-a79b-8ca6552f5759",
                                "text": "Morsure d’ocre à nos membres durcis fusibles de désirs tués sur les bouches d’ouragans où l’orbe d’un cri s’effiloche à nos tempes sonnantes dans l’affligement des vents hyperboles bourrelés de remords […]"
                            },
                            {
                                "example_id": "507f3d8e-4149-4c1a-b6fb-0ba6dcd189c0",
                                "sense_id": "bc4a4148-4ee6-3210-a79b-8ca6552f5759",
                                "text": "Quel affligement ! Quelle coupure ! C’est bien l’entreprise de dévastation systématique, un rouleau compresseur du fragile et du beau, du vrai et de l’humain. Quelle catastrophe ! Quel martyre ! Quelle crucifixion !"
                            }
                        ]
                    }
