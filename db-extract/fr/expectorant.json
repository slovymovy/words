                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e900cb1a-5cf9-3fe2-9eff-223abccd30a1",
                                        "entry_id": "cf0b64bc-576f-331a-b0a9-87dbe19f0f72",
                                        "glosses": [
                                            "An agent or drug used to cause or induce the expulsion of phlegm from the lungs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f88c622-ad26-463c-aa3e-a36b6ddcfd09",
                                                "sense_id": "e900cb1a-5cf9-3fe2-9eff-223abccd30a1",
                                                "text": "The disease was regarded as pneumonia so far advanced that suppuration seemed to have supervened; bleeding, blisters, expectorants, and cathartics diminished the symptoms; the pulse continued frequent, hard, full, but always regular."
                                            },
                                            {
                                                "example_id": "00bd64e2-11c2-441a-a19d-90949d30c30e",
                                                "sense_id": "e900cb1a-5cf9-3fe2-9eff-223abccd30a1",
                                                "text": "The bedside table is littered with both OTC and prescription expectorants and pertussives and analgesics and Vitamin-C megaspansules[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "expectorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "912c8ab3-5b0b-314d-921e-74bf9bd09b56",
                                        "entry_id": "8ffa1341-6348-3c64-8908-c05224f7f32c",
                                        "glosses": [
                                            "Causing or assisting the expulsion of phlegm."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5015fd67-a3f1-4b10-993a-53b9f7755a68",
                                                "sense_id": "912c8ab3-5b0b-314d-921e-74bf9bd09b56",
                                                "text": "an expectorant preparation"
                                            },
                                            {
                                                "example_id": "c932472b-8d78-4a6e-9939-c858ba92f0c3",
                                                "sense_id": "912c8ab3-5b0b-314d-921e-74bf9bd09b56",
                                                "text": "‘Matchett says there’s old Mr P. who made all the money with ’is cought mixture—’ ‘Not Parkinsons ex . . . something?’ asked Jessamy. ‘That’s it,’ nodded Sarah, ‘ “Hexpectorant Posset”.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
