                "senses": [
                    {
                        "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                        "entry_id": "aded4397-ab15-3e61-999c-e203da7862fb",
                        "glosses": [
                            "Any of various genres of single-movement musical pieces having lyrical and narrative elements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72f625aa-c6b9-4907-9836-93cfb204d4cc",
                                "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                                "text": "Thus, when he drew up instructions in lawyer language […] his clerks […] understood him very well. If he had written a love letter, or a farce, or a ballade, or a story, no one, either clerks, or friends, or compositors, would have understood anything but a word here and a word there."
                            },
                            {
                                "example_id": "e1ce7cc2-38ef-46b3-879c-38b7a50b5b8b",
                                "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                                "text": "\"Dead and gone!\" as Andrew Lang re-echoes in a sweetly mournful ballade[…"
                            },
                            {
                                "example_id": "7ef77482-e6a3-455d-bd85-2b4e206f48e7",
                                "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                                "text": "Even a 10-minute Chopin ballade for piano, let alone Messiaen’s 75-minute “Turangalila Symphony,” tries to grapple with, activate and organize a relatively substantial span of time."
                            }
                        ]
                    },
                    {
                        "sense_id": "952c9bf3-b839-362f-ad97-f4daa77405e2",
                        "entry_id": "aded4397-ab15-3e61-999c-e203da7862fb",
                        "glosses": [
                            "A poem of one or more triplets of seven- or eight-line stanzas, each ending with the same line as refrain, and usually an envoi; more generally, any poem in stanzas of equal length."
                        ],
