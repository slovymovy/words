                "word": "indescribability",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9011d1b2-64be-4ce4-a3e9-0d7433f4a865",
                        "entry_id": "7c27e573-319b-3956-a67c-b91136bb2d70",
