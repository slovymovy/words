                "senses": [
                    {
                        "sense_id": "1c5a861c-4015-3088-b474-eec538c9069d",
                        "entry_id": "20bb11c5-e71e-3e80-ad62-853d67caea6a",
                        "glosses": [
                            "jemand, der gegen einen anderen antritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269778e7-d9e6-4eb7-8997-cc73f6c91f2b",
                                "sense_id": "1c5a861c-4015-3088-b474-eec538c9069d",
                                "text": "Der Spitzenkandidat der Partei hat seinen Herausforderer erneut geschlagen."
                            },
                            {
                                "example_id": "bab576b8-83d0-4871-9d6f-3d70c9ed55b5",
                                "sense_id": "1c5a861c-4015-3088-b474-eec538c9069d",
                                "text": "„Merkel kennt ihren Herausforderer hervorragend.“"
                            },
                            {
                                "example_id": "cd2cd6e0-b34d-4347-8bec-e684f2c90350",
                                "sense_id": "1c5a861c-4015-3088-b474-eec538c9069d",
                                "text": "„Nach Haider Alis Tod (1780) folgte ihm sein ebenso fähiger Sohn Tipu Sultan, der für die Briten zum größten Herausforderer wurde, gegen den sie drei Kriege führen mussten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03f79a25-1122-4211-b0bc-9faa2c54940a",
                        "source_entry_id": "20bb11c5-e71e-3e80-ad62-853d67caea6a",
                        "source_sense_id": "1c5a861c-4015-3088-b474-eec538c9069d",
                        "source_sense_description": "jemand, der gegen einen anderen antritt",
                        "target_lang_word": "challenger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "challenger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "347fdca3-fc05-32ce-a0c3-ceac18c9191c",
                                        "entry_id": "5e2e2828-eb65-3f23-b21f-6af0cd523f57",
                                        "glosses": [
                                            "One who challenges; especially, one who plays against the current champion of a game or contest in hopes of winning and becoming the new champion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a484c7d-6130-4378-b360-1934f1ddfe6e",
                                                "sense_id": "347fdca3-fc05-32ce-a0c3-ceac18c9191c",
                                                "text": "The champion hopes to defeat his new challenger in the game to remain undefeated."
                                            },
                                            {
                                                "example_id": "fcfd4a85-a669-43f5-ac30-08f47489915b",
                                                "sense_id": "347fdca3-fc05-32ce-a0c3-ceac18c9191c",
                                                "text": "One child stood as king of the hill, and tried to withstand the pushes and shoves of his challengers."
                                            },
                                            {
                                                "example_id": "ac87f90d-da9b-4e6f-a2b8-856c94b455dc",
                                                "sense_id": "347fdca3-fc05-32ce-a0c3-ceac18c9191c",
                                                "text": "Debates are often unpredictable, but it is especially hard to game out how this debate featuring a moderate standard-bearer and a liberal challenger will unfold and how people will process it. Hundreds of thousands of viewers, if not millions, will have been personally affected by Sunday, as public gathering spaces are shuttered, schools are closed and on Thursday the stock market plunged by the largest percentage in decades (it snapped back upward on Friday)."
                                            },
                                            {
                                                "example_id": "42ce5cf3-a269-41a3-88c9-445c252d212f",
                                                "sense_id": "347fdca3-fc05-32ce-a0c3-ceac18c9191c",
                                                "text": "Candidates for a state senate seat race in South Florida in which a spoiler appeared to help Republican challenger Ileana Garcia unseat incumbent Democrat Jose Javier Rodriguez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bead5386-254f-4190-b610-132bf72a403b",
                        "source_entry_id": "20bb11c5-e71e-3e80-ad62-853d67caea6a",
                        "source_sense_id": "1c5a861c-4015-3088-b474-eec538c9069d",
