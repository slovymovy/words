                ],
                "senses": [
                    {
                        "sense_id": "6733b21c-fc80-32c2-bede-96b7fff26ccf",
                        "entry_id": "68ed9380-8285-33cd-8128-eb6154504422",
                        "glosses": [
                            "een zeer kleine kunststof lens die men direct op de oogbol plaatst ter vervanging van een bril"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d24109-5bf5-48cf-bf41-85862fed56f3",
                                "sense_id": "6733b21c-fc80-32c2-bede-96b7fff26ccf",
                                "text": "Wil je contactlenzen of liever een bril?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5a2c1f0-4159-4b6f-94b6-6ffe4d3b5145",
                        "source_entry_id": "68ed9380-8285-33cd-8128-eb6154504422",
                        "source_sense_id": "6733b21c-fc80-32c2-bede-96b7fff26ccf",
                        "source_sense_description": "een zeer kleine glazen of kunststof lens die men direct op de oogbol plaatst ter vervanging van een bril",
                        "target_lang_word": "Kontaktlinse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontaktlinse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cff4574-1029-3184-948a-7d6819ea26ab",
                                        "entry_id": "eb0cc70d-c77c-3b7b-ba7f-9649cbe165c2",
                                        "glosses": [
                                            "als Sehhilfe anstelle einer Brille getragene, ehemals aus Glas, heutzutage aus verschiedenen Kunststoffen gefertigte kleine, dünne Linse, die direkt vor die Pupille platziert wird, wo sie durch Kontakt mit der Augenflüssigkeit haften bleibt"
                                        ],
                                        "tags": [
                                            "zumeist",
                                            "iPl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3d18553-53b0-4db1-8a61-20dc943d7cfc",
                                                "sense_id": "5cff4574-1029-3184-948a-7d6819ea26ab",
                                                "text": "„Sie ist kurzsichtig. Kontaktlinsen verträgt sie nicht, und für Brillen ist sie sich zu schön.“"
                                            },
                                            {
                                                "example_id": "ad54785e-5477-41cc-9db8-d576d86d1fb0",
                                                "sense_id": "5cff4574-1029-3184-948a-7d6819ea26ab",
                                                "text": "„Ach, ich glaube, ich brauche doch neue Kontaktlinsen.“"
                                            },
                                            {
                                                "example_id": "bee5385e-816e-41d9-bacf-48bb632306d3",
                                                "sense_id": "5cff4574-1029-3184-948a-7d6819ea26ab",
                                                "text": "„Während ich die Fischsuppe servierte, schoß ich mit der Kamera in meiner Kontaktlinse ein paar Fotos von Benoît.“"
                                            },
                                            {
                                                "example_id": "80d447da-7174-4b74-9e7c-bf03f99439ac",
                                                "sense_id": "5cff4574-1029-3184-948a-7d6819ea26ab",
                                                "text": "„Jetzt aber war ich mit einem ausgedörrten Wattemund gelandet, die Kontaktlinsen gruben sich in meine Pupillen, und meine Blase drohte bei der nächsten Bewegung zu platzen.“"
                                            },
                                            {
                                                "example_id": "0e6d62f6-670b-48e6-8dfe-cdbfd2f57357",
                                                "sense_id": "5cff4574-1029-3184-948a-7d6819ea26ab",
                                                "text": "„Auf der Iris schwammen blaue Kontaktlinsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87100410-a90c-43ba-9ab7-f95ada9ad243",
                        "source_entry_id": "68ed9380-8285-33cd-8128-eb6154504422",
                        "source_sense_id": "6733b21c-fc80-32c2-bede-96b7fff26ccf",
