                ],
                "senses": [
                    {
                        "sense_id": "a1cd2b59-678a-31f2-a8a6-eed970014035",
                        "entry_id": "850de099-2cc2-3a3a-92a6-b594b2a67161",
                        "glosses": [
                            "den beim Erwerb einer Ware oder Dienstleistung aus Kunststoff zu zahlende Geldbetrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf4e30a-c238-4df5-9119-4d5b09043765",
                                "sense_id": "a1cd2b59-678a-31f2-a8a6-eed970014035",
                                "text": "Der Rohstoff Kunststoff wird aus Erdöl hergestellt und zum börsennotierten Kunststoffpreis abgegeben."
                            },
                            {
                                "example_id": "d73f9920-299d-4193-9d4c-b5082ab5c2d5",
                                "sense_id": "a1cd2b59-678a-31f2-a8a6-eed970014035",
                                "text": "„Die Kunststoffpreise und vor allem das Wissen über die neuesten Entwicklungen am Markt sind entscheidend für Ihren geschäftlichen Erfolg!“"
                            },
                            {
                                "example_id": "fd9d73fa-a409-4568-a5ce-f6f7dc7610d1",
                                "sense_id": "a1cd2b59-678a-31f2-a8a6-eed970014035",
                                "text": "„Wie üblich mit einiger Verzögerung beginnen auch die weltweiten Kunststoffpreise den Verfall des Ölpreises zu spiegeln.“"
                            },
                            {
                                "example_id": "9ca0ebcc-da53-4f99-881f-eac707aec83a",
                                "sense_id": "a1cd2b59-678a-31f2-a8a6-eed970014035",
                                "text": "„Immer dann, wenn der Kunststoffpreis über dem vereinbarten Swappreis liegt, bekommt das Unternehmen eine Auszahlung aus dem Swap – und zwar in Höhe der Differenz zu dem ursprünglich festgelegten Niveau.“"
                            },
                            {
                                "example_id": "e0dc0b33-08c6-41e7-abeb-c79125ac1794",
                                "sense_id": "a1cd2b59-678a-31f2-a8a6-eed970014035",
                                "text": "„Grundlage der Kunststoffpreisindizes ist jeweils ein ökonometrisches Modell, basierend auf historischen Korrelationen zwischen Kostenfaktoren der Kunststofferzeugung und Nachfrageentwicklungen im Kunststoffmarkt einerseits sowie Kunststoffpreisen andererseits.“"
                            },
                            {
                                "example_id": "ce828a93-0840-4cee-8999-70d34790c11c",
                                "sense_id": "a1cd2b59-678a-31f2-a8a6-eed970014035",
                                "text": "„Die Schere zwischen Rohölpreis und Kunststoffpreis hat sich zu Lasten der Marge weiter geöffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "582bf46c-0dcd-3af0-ac21-d32e99027cfe",
                        "entry_id": "850de099-2cc2-3a3a-92a6-b594b2a67161",
                        "glosses": [
                            "eine ehrende Auszeichnung für besondere Verdienste und Leistungen zu Kunststoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d16de1-03b5-4a3e-b7f9-b6ebaef976f9",
                                "sense_id": "582bf46c-0dcd-3af0-ac21-d32e99027cfe",
                                "text": "„Chyll erhält GKV-Kunststoffpreis.“"
                            },
                            {
                                "example_id": "c90cf4b0-ed0f-488f-a157-5b7d95931c8b",
                                "sense_id": "582bf46c-0dcd-3af0-ac21-d32e99027cfe",
                                "text": "SLG Kunststoff GmbH - MAKE01 als „Produkt des Jahres 2011“ ausgezeichnet - SLG gewinnt begehrten Kunststoffpreis."
                            },
                            {
                                "example_id": "331ddee3-0c02-4f73-a93f-2d3e1ca0429e",
                                "sense_id": "582bf46c-0dcd-3af0-ac21-d32e99027cfe",
                                "text": "SLG gewinnt den begehrten Kunststoffpreis des Jahres 2011."
                            },
                            {
                                "example_id": "06af0941-2332-42fe-abc8-83a4c2827f8c",
                                "sense_id": "582bf46c-0dcd-3af0-ac21-d32e99027cfe",
                                "text": "Da ich während meiner Zeit als Vorsteher häufig Präsident bei den Technischen Tagungen des damaligen Verbands der Kunststoffindustrie der Schweiz (VKI) war, konnte ich bei einer dieser Veranstaltungen über den neuen Studienplan berichten und im Nachgang den Vorschlag machen, pro Jahr für jeweils einen Diplomanden einen Kunststoffpreis auszurichten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
