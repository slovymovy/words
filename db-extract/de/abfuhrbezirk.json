                "senses": [
                    {
                        "sense_id": "69d9914c-f0f1-3000-b349-f44bfe8cae09",
                        "entry_id": "194f6263-8260-3ea9-9811-9e8528140cdf",
                        "glosses": [
                            "Bezirk, für den eine Müllabfuhr zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac30e1df-6fd2-464e-9b7a-57288c6ea749",
                                "sense_id": "69d9914c-f0f1-3000-b349-f44bfe8cae09",
                                "text": "„Wer seinen Abfuhrbezirk nicht kennt, gelangt über das Straßenverzeichnis direkt zu seinem persönlichen Abfuhrkalender.“"
                            },
                            {
                                "example_id": "b3e6fd3b-4e56-426d-821e-abd304d3c446",
                                "sense_id": "69d9914c-f0f1-3000-b349-f44bfe8cae09",
                                "text": "„Aufgrund der Umstellung auf die Gelbe Tonne und im Zuge von Tourenoptimierungen der Müllabfuhr im Landkreis Grafschaft Bentheim ändern sich ab dem 01. Januar 2025 einige Abfuhrtage und es werden Abfuhrbezirke angepasst.“"
                            }
                        ],
