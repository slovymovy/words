    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c78db753-cd52-3560-8cd0-c159f45d93af",
                "word": "hurriedly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ce709804-0954-4016-8487-b865d87be8f5",
                        "entry_id": "c78db753-cd52-3560-8cd0-c159f45d93af",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more hurriedly"
                    },
                    {
                        "form_id": "95006c76-f1fd-4e83-9d96-76ebd42e80db",
                        "entry_id": "c78db753-cd52-3560-8cd0-c159f45d93af",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most hurriedly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                        "entry_id": "c78db753-cd52-3560-8cd0-c159f45d93af",
                        "glosses": [
                            "In a hurried manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56177ffe-cfad-4ab0-9d3b-1b11ea7234c9",
                                "sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                                "text": "The mother, Ekaterina Pavlovna, who at one time had been handsome, but now, asthmatic, depressed, vague, and over-feeble for her years, tried to entertain me with conversation about painting. Having heard from her daughter that I might come to Shelkovka, she had hurriedly recalled two or three of my landscapes which she had seen in exhibitions in Moscow, and now asked what I meant to express by them."
                            },
                            {
                                "example_id": "7b4f372b-0a25-403d-94ac-38798c65fc2f",
                                "sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                                "text": "“In a moment, he has torn the letter into long thin strips, and rolling them up into spills he thrusts them hurriedly in amongst the other spills in the vase on the mantle-piece.”"
                            },
                            {
                                "example_id": "c371a5f5-9966-465d-b8d6-242baf42a040",
                                "sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                                "text": "If the kind of network we envisage is to be established, it would be unwise to begin any of its services hurriedly with older stock, which, however admirable in its day, now has an air of faded Edwardian splendour that is out of joint with the times."
                            },
                            {
                                "example_id": "1d834ac0-2e4e-4791-98d1-57e9639ad495",
                                "sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                                "text": "But Johnson [...] hurriedly [c]hanged his plea to guilty."
                            },
                            {
                                "example_id": "6dc177aa-e99f-4982-9dbb-6815791ccc96",
                                "sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                                "text": "The result was that trains ran as normal on November 7 and 9, although there was still disruption on Saturday November 5, owing to the short notice as rosters were hurriedly rewritten. Rosters are typically agreed a week in advance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c4a70b3-bac0-43d9-a18a-7df5f42f0557",
                        "source_entry_id": "c78db753-cd52-3560-8cd0-c159f45d93af",
                        "source_sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                        "source_sense_description": "in a hurried manner",
                        "target_lang_word": "à la hâte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la hâte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                        "entry_id": "f0ec86ce-51e8-32c1-863a-6475d02b7224",
                                        "glosses": [
                                            "En se dépêchant ; sans perdre de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb942e6e-f950-47b6-b0b4-63d4b37c40e2",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "— Je me jette aussi aux pieds de Votre Majesté pour qu’elle veuille m’accorder la révocation d’une rigueur que j’ai provoquée (je l’avoue publiquement), et que je regardai peut-être trop à la hâte comme utile au repos de l’État."
                                            },
                                            {
                                                "example_id": "d5795fec-0957-4abe-bdb2-f741a5955775",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "L’édition de 1885, très incomplète, avait été composée à la hâte, en l’espace de quelques mois, dans le but de donner satisfaction à la demande de MM. de Renzis et Bodio, en présentant la nouvelle méthode au Congrès pénitentiaire international de Rome."
                                            },
                                            {
                                                "example_id": "e8022831-a04e-4f93-9ee5-7a3651179a99",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "Un oratoire (msalla), simple mur en maçonnerie blanchi à la chaux, avait été construit à la hâte sur une colline voisine, toute blanche de pâquerettes."
                                            },
                                            {
                                                "example_id": "bd82c2e2-605f-4d51-9cf3-718e7ea88204",
                                                "sense_id": "39b98fc4-fda1-3e46-a87d-7ab879dd93b2",
                                                "text": "Je ne crois pas au temps record pour la reconstruction. Je crois au bon moment, nous devons le faire rapidement mais pas à la hâte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db79d9d9-5808-41a2-aae7-9e9def7c222f",
                        "source_entry_id": "c78db753-cd52-3560-8cd0-c159f45d93af",
                        "source_sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                        "source_sense_description": "in a hurried manner",
                        "target_lang_word": "à la sauvette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la sauvette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9645ff7c-d4b8-38dc-8f1e-dd6dc165b9ff",
                                        "entry_id": "e94b77ca-f829-37c2-bee3-e09b49d5eb1d",
                                        "glosses": [
                                            "Se dit des vendeurs de rue qui ne possèdent pas de magasin ni d'autorisation officielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad0fef4-1741-422d-af53-2a2079d347bd",
                                                "sense_id": "9645ff7c-d4b8-38dc-8f1e-dd6dc165b9ff",
                                                "text": "En été, les vendeurs à la sauvette pullulent sur les plages."
                                            },
                                            {
                                                "example_id": "7552c1b8-ad5d-48f0-b55c-c4da3057194e",
                                                "sense_id": "9645ff7c-d4b8-38dc-8f1e-dd6dc165b9ff",
                                                "text": "C’était peu, mais c’était mieux que le baby-sitting, que les gardes de nuit, que la plonge, que tous les emplois dérisoires – distribution de prospectus, écritures, minutage d’émissions publicitaires, vente à la sauvette, lumpen-tapirat – traditionnellement réservés aux étudiants."
                                            },
                                            {
                                                "example_id": "a028d0fd-9cdf-4ce5-afea-29482c689e49",
                                                "sense_id": "9645ff7c-d4b8-38dc-8f1e-dd6dc165b9ff",
                                                "text": "Ensuite, ce gardien de square du XVIIIᵉ arrondissement de Paris, interpellé lors d'une ronde de police parce qu'il ne donnait pas la chasse aux vendeurs à la sauvette."
                                            },
                                            {
                                                "example_id": "7a1fe56d-2a62-496a-ad62-9d075f557d14",
                                                "sense_id": "9645ff7c-d4b8-38dc-8f1e-dd6dc165b9ff",
                                                "text": "Les vendeurs à la sauvette ouvraient une valise au lieu d'étaler par terre ou sur un tréteau."
                                            },
                                            {
                                                "example_id": "81fb7992-8014-4b5d-89f7-eaf79db43d80",
                                                "sense_id": "9645ff7c-d4b8-38dc-8f1e-dd6dc165b9ff",
                                                "text": "Il est simplement pas né du même côté de la morale — c'est tout. Y griffe des larfeuils, Orlando, comme d'autres vendent des avocats à la sauvette dans le métro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                        "entry_id": "e94b77ca-f829-37c2-bee3-e09b49d5eb1d",
                                        "glosses": [
                                            "Rapidement, précipitamment, pour ne pas être pris, ne pas être vu ou l'être le moins possible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ef7101-2882-41c4-bb83-61d5b7251105",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "Après son esbrouffe, il a préféré partir à la sauvette."
                                            },
                                            {
                                                "example_id": "468b6740-339b-477e-b9fd-da018f1b9530",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "Il a épousé depuis une héritière, il ne la trompe pas ou bien c'est en voyage et à la sauvette, bref, le plus fidèle des maris."
                                            },
                                            {
                                                "example_id": "6fa5a672-1303-4849-88c7-a1df4db59863",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "Nous prîmes place à une table, en clients sérieux, et tout en buvant un gin-fizz, j’entrepris de lui expliquer qui était Jacques, dont je ne lui avais guère parlé qu’à la sauvette."
                                            },
                                            {
                                                "example_id": "4352a774-ccf4-4a1f-91ec-2d6e2638b9e8",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "La mort est une chose trop sérieuse pour l'affronter à la sauvette."
                                            },
                                            {
                                                "example_id": "d16899ad-8615-48f3-aa8f-e63a10915798",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "Chez Pulemet, le patron réussit à évacuer le matériel sans que les ouvriers s’en aperçoivent ; un beau matin, ils trouvèrent l’usine vide, tout le matériel avait été transporté à la sauvette près de Moscou."
                                            },
                                            {
                                                "example_id": "4ccfbcdb-fb30-497d-ba2f-1bac6b269112",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "Et puis tu petit-déjeunais à la sauvette, cigarette au bec, debout dans la cuisine."
                                            },
                                            {
                                                "example_id": "b7d775d3-e20e-4b54-9c20-694edddcac00",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "Les autorités doivent agir de nuit, à la sauvette, pour arrêter Demaray et Davignon."
                                            },
                                            {
                                                "example_id": "ef37392a-bf1b-4d3a-92dd-4b95ead2d52f",
                                                "sense_id": "1bcae1b7-ee0c-3ac8-8ebd-b71dcdded054",
                                                "text": "Ça ne fonctionne pas. Ses pâles excuses signées à la sauvette n’effacent en rien ses propos méprisants de la veille sur le français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f54bcc6c-1ffe-47b4-862c-082006fa7cbd",
                        "source_entry_id": "c78db753-cd52-3560-8cd0-c159f45d93af",
                        "source_sense_id": "2ac24c1d-3519-3e69-84f6-199ddc984cc7",
                        "source_sense_description": "in a hurried manner",
                        "target_lang_word": "à la va-vite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la va-vite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c702eb6-5806-39f3-b6ae-a95eee091b99",
                                        "entry_id": "0e1b0f56-86f0-385c-b49d-2309ec2a112e",
                                        "glosses": [
                                            "De manière bâclée et pressée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea65356-a483-4e7a-a0d1-2cba13b2f285",
                                                "sense_id": "0c702eb6-5806-39f3-b6ae-a95eee091b99",
                                                "text": "Il a la manie de balayer à la va-vite."
                                            },
                                            {
                                                "example_id": "3c0e42e1-e6eb-4051-a943-4b192f7c0f1e",
                                                "sense_id": "0c702eb6-5806-39f3-b6ae-a95eee091b99",
                                                "text": "J’avais préparé le concours à la va-vite : leur culture était plus solide que la mienne, ils étaient au courant d’un tas de nouveautés que j’ignorais, ils avaient l’habitude de la discussion ; surtout, je manquais de méthode et de perspectives ; l’univers intellectuel était pour moi un vaste fatras où je me dirigeais à tâtons ; eux, leur recherche était, du moins en gros, orientée."
                                            },
                                            {
                                                "example_id": "8e7f1c94-1fb5-45c0-a782-98fd4b24f971",
                                                "sense_id": "0c702eb6-5806-39f3-b6ae-a95eee091b99",
                                                "text": "En revanche, le choix d’une star comme ambassadeur ne doit pas être fait à la va-vite."
                                            },
                                            {
                                                "example_id": "c13bbb20-f96d-48b4-95cc-01d524c2bc80",
                                                "sense_id": "0c702eb6-5806-39f3-b6ae-a95eee091b99",
                                                "text": "Au moment des départs monte une effervescence. On échange des cartes, on écrit son adresse à la va-vite sur un bout de papier, on parle de se revoir à Paris."
                                            },
                                            {
                                                "example_id": "f8af2cf2-cbd9-4843-b3b8-2e03ddbecec6",
                                                "sense_id": "0c702eb6-5806-39f3-b6ae-a95eee091b99",
                                                "text": "Couvert de sang séché et de bandages posés à la va-vite , le visage d’Ameer Al-Halbi fut l’une des images fortes de la mobilisation contre le projet de loi « sécurité globale » du 28 novembre 2020."
                                            },
                                            {
                                                "example_id": "c95d9226-47f5-4833-8428-4bbd604ef447",
                                                "sense_id": "0c702eb6-5806-39f3-b6ae-a95eee091b99",
                                                "text": "Dans quelques heures, les compartiments et les couchettes se rempliront d’enfants et de vieillards, de baluchons rassemblés à la va-vite, de chats, de chiens, et de l’immense tristesse de l’exil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
