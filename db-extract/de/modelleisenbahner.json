                "senses": [
                    {
                        "sense_id": "9a1d9a41-cb62-3b99-9d84-02ea329fc660",
                        "entry_id": "7db648a0-4bb4-3913-8e08-eb66eefef6d8",
                        "glosses": [
                            "Person, die sich hobbymäßig mit Modelleisenbahnen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9738e86d-3b7d-46f7-8a4e-3883253520c6",
                                "sense_id": "9a1d9a41-cb62-3b99-9d84-02ea329fc660",
                                "text": "„Der direkte Weg in die Kinderzimmer ist für die Modelleisenbahner nämlich nach wie vor mühsam; nur etwa zehn Prozent des Umsatzes erwirtschaftet Märklin mit Einsteigersets für Kinder.“"
                            },
                            {
                                "example_id": "73220fc6-bc9a-4ad0-b072-d3439524d0eb",
                                "sense_id": "9a1d9a41-cb62-3b99-9d84-02ea329fc660",
                                "text": "„Die Ergebnisse haben die beiden Modelleisenbahner zu einer Ausstellung verarbeitet, die am Wochenende in der Aula der Mittelschule von Mammendorf gezeigt wird.“"
                            },
                            {
                                "example_id": "7c549a61-0547-4658-9b6d-1a808b955836",
                                "sense_id": "9a1d9a41-cb62-3b99-9d84-02ea329fc660",
                                "text": "„Für den ernsthaften Modelleisenbahner ist sein Hobby kein Kinderspiel.“"
                            },
                            {
                                "example_id": "aeb0e529-c2e2-4191-b591-7d8ae0bb138c",
                                "sense_id": "9a1d9a41-cb62-3b99-9d84-02ea329fc660",
                                "text": "„Im Alten Elbtunnel verlegten die Modelleisenbahner einen 750 Meter langen Gleisparcours.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
