                ],
                "senses": [
                    {
                        "sense_id": "a26c7569-d747-3cf6-9e5e-80c36629e80f",
                        "entry_id": "53f3a4d1-a93f-3eee-a843-062b091876d4",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3977dc-243d-4cfd-81aa-b3f7214b6f94",
                                "sense_id": "a26c7569-d747-3cf6-9e5e-80c36629e80f",
                                "text": "Pan Augustyn Kowalski jest naszym sąsiadem."
                            },
                            {
                                "example_id": "73cf4da8-8967-43af-b79b-4a177e7ed6df",
                                "sense_id": "a26c7569-d747-3cf6-9e5e-80c36629e80f",
                                "text": "Według św. Augustyna: wiedzy, o którą na próżno zabiegamy przyrodzonymi władzami naszego umysłu, Bóg udziela duszy drogą oświecenia."
                            },
                            {
                                "example_id": "00130250-42a7-4acc-b79f-ee50e058ba51",
                                "sense_id": "a26c7569-d747-3cf6-9e5e-80c36629e80f",
                                "text": "I tu oczywiście stoimy przed zagadnieniem stosowanych na Śląsku wersji imion, czyli po prostu śląskich imion. Zatem przedstawimy kilka takich przykładów: JAN - Jon, Jonek, Joneczek, Jonik, Janik, Jasio, Jasiek, Jasiulek, Johan, Johanek, Hanys, Hanysek, Hanusek, Hanek, Hanuś; AGNIESZKA - Agnys , Agnysa, Agnyska, Anyszka, Neszka, Nyszka, Nysia, Nyśka; WILHELM - Wili, Wilym, Wiluś, Wilusiek; PAWEŁ - Paul, Paulek, Paulik; MARIA - Maryj, Maryjka, Marika; ANNA - Ana; PIOTR - Pioter, Pyjter; AUGUSTYN - August, Gustek, Gustel, Gustlik, Gustliczek; MAŁGORZATA - Gryjta, Gryjtka"
                            },
                            {
                                "example_id": "e4a00582-8249-437c-803a-669642c53018",
                                "sense_id": "a26c7569-d747-3cf6-9e5e-80c36629e80f",
                                "text": "W 396 roku umarł biskup Hippony Waleriusz, a Augustyn został obrany jego następcą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
