                        "source_entry_id": "2e177277-435f-32a6-8b4c-b9cca11cd3ab",
                        "source_sense_id": "72a1b2ca-27f9-3d93-ad71-18bd2e726f9b",
                        "source_sense_description": "iemand die zich beschikbaar gesteld heeft voor een baan of functie",
                        "target_lang_word": "Bewerber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewerber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "636a6eae-a2c1-3aa6-844a-9275dc46b34b",
                                        "entry_id": "10ece896-a416-3f5c-9864-aa56f83ae2b7",
                                        "glosses": [
                                            "Person, die einen Antrag stellt, um etwas zu bekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b08484-b509-42ca-8046-cb91ed935cff",
                                                "sense_id": "636a6eae-a2c1-3aa6-844a-9275dc46b34b",
                                                "text": "Wer nur Bewerber ist, weiß noch nicht, ob seine Bewerbung Erfolg haben wird."
                                            },
                                            {
                                                "example_id": "135d0f53-0043-458e-8ddd-8bb23cd04248",
                                                "sense_id": "636a6eae-a2c1-3aa6-844a-9275dc46b34b",
                                                "text": "„Trump gilt bei der im November anstehenden Präsidentschaftswahl als aussichtsreichster Bewerber der Republikaner.“"
                                            },
                                            {
                                                "example_id": "75a18c6c-2cb9-4abe-bc6e-27bfde42b82a",
                                                "sense_id": "636a6eae-a2c1-3aa6-844a-9275dc46b34b",
                                                "text": "„Der Untersuchungsausschuss will nun prüfen, ob Vettern- und Parteibuchwirtschaft den Ausschlag bei der Besetzung der Präsidentenstelle des Oberverwaltungsgerichts gab oder die Kompetenz der Bewerber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0af69cf9-f976-3fab-b3da-9ed31a10589a",
                                        "entry_id": "10ece896-a416-3f5c-9864-aa56f83ae2b7",
                                        "glosses": [
                                            "Mann, der um die Hand einer Frau anhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "013370c5-e38e-4c0b-b074-0ae42a53f386",
                                                "sense_id": "0af69cf9-f976-3fab-b3da-9ed31a10589a",
                                                "text": "Unter ihren Bewerbern war auch ein junger Mann, auf den sie bereits ein Auge geworfen hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
