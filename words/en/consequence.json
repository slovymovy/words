{
    "word_family": [
        "consequent",
        "consequential",
        "consequently",
        "inconsequence",
        "inconsequential"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a17dfe81-02c6-3ddd-b8e8-2bc8796a081d",
                    "sense_definition": "A result or effect that happens because of a specific action or condition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "result_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flood was a direct <w>consequence</w> of the heavy rain last night.",
                            "target_lang_translations": {
                                "ru": "Наводнение стало прямым <w>следствием</w> сильного дождя прошлой ночью.",
                                "zh": "这场洪水是昨晚大雨的直接<w>后果</w>。"
                            }
                        },
                        {
                            "text": "She studied hard all week, and as a <w>consequence</w>, she passed the exam with flying colors.",
                            "target_lang_translations": {
                                "ru": "Она усердно училась всю неделю, и, как <w>следствие</w>, блестяще сдала экзамен.",
                                "zh": "她整个星期都在努力学习，因此<w>结果</w>她以优异的成绩通过了考试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "repercussion",
                        "implication",
                        "result",
                        "outcome"
                    ],
                    "antonyms": [
                        "cause",
                        "origin",
                        "source"
                    ],
                    "common_phrases": [
                        "as a consequence",
                        "in consequence",
                        "direct consequence",
                        "logical consequence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат или эффект, возникающий вследствие определенного действия или условия.",
                        "zh": "某项行动或条件所产生的结果或影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следствие",
                                "target_lang_sense_clarification": "логический результат, вытекающий из причины"
                            },
                            {
                                "target_lang_word": "последствие",
                                "target_lang_sense_clarification": "то, что следует за каким-либо событием"
                            },
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "общий итог действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结果",
                                "target_lang_sense_clarification": "事物发展所产生的最终状态"
                            },
                            {
                                "target_lang_word": "后果",
                                "target_lang_sense_clarification": "由某种原因导致的结果，常指客观发生的情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91db45a7-10d8-34d6-9381-8b9259c8a44d",
                    "sense_definition": "An unpleasant or unwelcome result of an action, often involving punishment or trouble.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "result_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you break the rules, you must be ready to face the <w>consequences</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты нарушаешь правила, ты должен быть готов отвечать за <w>последствия</w>.",
                                "zh": "如果你违反了规则，就必须准备好承担<w>后果</w>。"
                            }
                        },
                        {
                            "text": "He did not think about the serious <w>consequences</w> his lies would have on his family.",
                            "target_lang_translations": {
                                "ru": "Он не думал о серьезных <w>последствиях</w>, которые его ложь принесет семье.",
                                "zh": "他没有考虑到他的谎言会给家人带来多么严重的<w>后果</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "repercussion"
                    ],
                    "common_phrases": [
                        "face the consequences",
                        "suffer the consequences",
                        "serious consequences",
                        "negative consequences"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятный или нежелательный результат действия, часто влекущий за собой наказание или проблемы.",
                        "zh": "一种令人不快或不受欢迎的结果，通常涉及惩罚或麻烦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последствие",
                                "target_lang_sense_clarification": "обычно во множественном числе, подразумевает негативный исход"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后果",
                                "target_lang_sense_clarification": "指行为带来的负面影响或代价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea668696-fe1f-3524-906c-b3d534d0b414",
                    "sense_definition": "Importance, influence, or social significance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exact color of the car is of no <w>consequence</w> to me, as long as it runs well.",
                            "target_lang_translations": {
                                "ru": "Точный цвет машины не имеет для меня никакого <w>значения</w>, лишь бы она хорошо ездила.",
                                "zh": "只要车况好，车的颜色对我来说毫无<w>重要性</w>。"
                            }
                        },
                        {
                            "text": "He wanted to become a man of <w>consequence</w> in the local business community.",
                            "target_lang_translations": {
                                "ru": "Он хотел стать <w>влиятельным</w> человеком в местном деловом сообществе.",
                                "zh": "他想成为当地商界一位有<w>地位</w>的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moment",
                        "distinction",
                        "value",
                        "rank"
                    ],
                    "antonyms": [
                        "insignificance"
                    ],
                    "common_phrases": [
                        "of no consequence",
                        "of little consequence",
                        "matter of consequence",
                        "man of consequence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Важность, влияние или общественная значимость.",
                        "zh": "重要性、影响力或社会地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значение",
                                "target_lang_sense_clarification": "важность или смысл чего-либо"
                            },
                            {
                                "target_lang_word": "важность",
                                "target_lang_sense_clarification": "значимость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重要性",
                                "target_lang_sense_clarification": "事物所具有的重大意义"
                            },
                            {
                                "target_lang_word": "地位",
                                "target_lang_sense_clarification": "指人在社会或群体中的重要程度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21909833-2fa7-3f5f-b77b-0829c68a333f",
                    "sense_definition": "To apply a penalty or negative outcome to someone, usually a child, in order to teach a lesson.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher decided to <w>consequence</w> the student for constantly disrupting the class.",
                            "target_lang_translations": {
                                "ru": "Учитель решил <w>наказать</w> ученика за постоянный срыв уроков.",
                                "zh": "老师决定对那个不断扰乱课堂纪律的学生进行<w>惩罚</w>。"
                            }
                        },
                        {
                            "text": "Parents often learn how to <w>consequence</w> bad behavior effectively without getting angry.",
                            "target_lang_translations": {
                                "ru": "Родители часто учатся эффективно <w>наказывать</w> за плохое поведение, не выходя из себя.",
                                "zh": "父母通常会学习如何在不发火的情况下有效地对不良行为进行<w>惩罚</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or educational jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Применять наказание или негативные меры к кому-либо (обычно к ребенку) в воспитательных целях.",
                        "zh": "对某人（通常是儿童）施加惩罚或负面措施，以达到教育目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказывать",
                                "target_lang_sense_clarification": "применять меры воздействия за проступок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惩罚",
                                "target_lang_sense_clarification": "对过错进行责罚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}