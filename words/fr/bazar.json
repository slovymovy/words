            "senses": [
                {
                    "sense_id": "b4dc854f-c669-310a-8fd8-cf48f228db61",
                    "sense_definition": "Grand désordre ou situation confuse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "désordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ont laissé leurs jouets partout, c'est un vrai <w>bazar</w> dans le salon.",
                            "target_lang_translations": {
                                "en": "The children have left their toys everywhere; it's a real <w>mess</w> in the living room.",
                                "ru": "Дети оставили игрушки где попало, в гостиной настоящий <w>бардак</w>.",
                                "de": "Die Kinder haben ihre Spielsachen überall liegen lassen, im Wohnzimmer ist ein richtiges <w>Durcheinander</w>.",
                                "es": "Los niños han dejado sus juguetes por todas partes; hay un verdadero <w>lío</w> en el salón.",
                                "zh": "孩子们把玩具扔得到处都是，客厅里真是一片<w>混乱</w>。"
                            }
                        },
                        {
                            "text": "Arrêtez de crier et de mettre le <w>bazar</w> pendant que nous travaillons.",
                            "target_lang_translations": {
                                "en": "Stop shouting and making a <w>mess</w> while we are working.",
                                "ru": "Перестаньте кричать и устраивать <w>бардак</w>, пока мы работаем.",
                                "de": "Hört auf zu schreien und hier ein <w>Durcheinander</w> anzurichten, während wir arbeiten.",
                                "es": "Dejen de gritar y de armar un <w>lío</w> mientras trabajamos.",
                                "zh": "别大喊大叫了，我们工作的时候别再制造<w>混乱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bordel",
                        "foutoir",
                        "pagaille"
                    ],
                    "common_phrases": [
                        "mettre le bazar",
                        "quel bazar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier très courant"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A great disorder or confused situation.",
                        "ru": "Большой беспорядок или запутанная, сбивчивая ситуация.",
                        "de": "Sehr große Unordnung oder eine verworrene Lage.",
                        "es": "Desorden grande o situación confusa.",
                        "zh": "很大的混乱或杂乱无章的状况，多用于口语。"
                    },
