                "senses": [
                    {
                        "sense_id": "30f851e2-6917-3627-bfe8-3ac583f5959f",
                        "entry_id": "b1ac8870-c25a-3d86-8495-7b833dc58547",
                        "glosses": [
                            "Modell zur Beschreibung von Wachstum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c973d08-ec0f-42f3-ae2a-ad66e8167f40",
                                "sense_id": "30f851e2-6917-3627-bfe8-3ac583f5959f",
                                "text": "„Angewandt auf die Population aller Menschen auf diesem Planeten, löste dieses sog. Wachstumsgesetz von Malthus zu Beginn des 19. Jahrhunderts heftige Diskussionen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6382878c-8d3e-3a69-af8c-071bbc6a4220",
                        "entry_id": "b1ac8870-c25a-3d86-8495-7b833dc58547",
                        "glosses": [
                            "Gesetz oder Gesetzespaket, das (wirtschaftliches) Wachstum bringen soll"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "0d45664a-e56f-4253-86cd-40ac2aca6886",
                                "sense_id": "6382878c-8d3e-3a69-af8c-071bbc6a4220",
                                "text": "„Sie wollte zwar hier und dort Steuern senken, was ja im Wachstumsgesetz vom November 2009 auch geschehen ist.“"
                            },
                            {
                                "example_id": "6aa9fa35-0dbf-490d-a93d-a5175054b089",
                                "sense_id": "6382878c-8d3e-3a69-af8c-071bbc6a4220",
                                "text": "„Auf dem Gebiet der Steuerpolitik scheint auch eigenartig, daß eines der sogenannten „Wachstumsgesetze“, nämlich die Versicherungssteuernnovelle, nun im Zuge der Budgetsanierung wieder außer Kraft gesetzt wird.“"
                            },
                            {
                                "example_id": "fe19c238-34ec-43f2-9b3b-80222470d57a",
                                "sense_id": "6382878c-8d3e-3a69-af8c-071bbc6a4220",
                                "text": "„Hier nämlich sprach der Papst nicht nur allgemein gegen eine Wirtschaftspolitik, in der Profit und Wachstumsgesetze den Lebensstandard bestimmen, sondern kritisierte unverblümt Regierungsinstitutionen, die nicht „Instrument der Unterdrückung und der Macht einer bestimmten Klassenkategorie werden dürfen.““"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
