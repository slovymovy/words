                    {
                        "translation_id": "0b9b4af1-c4f6-45a6-9510-7f83052fa2a1",
                        "source_entry_id": "18665e1e-20fe-3ec0-a55b-759197f86c01",
                        "source_sense_id": "7b1734ad-0e4b-3b16-a5db-c97de68c4121",
