                                "example_id": "af80f570-5372-449e-99c4-d90e177bfcdb",
                                "sense_id": "b1165ea4-c0ae-38b6-b178-8305de5db753",
                                "text": "This project will not be finished in the foreseeable future."
                            },
                            {
                                "example_id": "97e4ba90-f582-4cdb-aa26-c6b1a3c34de6",
                                "sense_id": "b1165ea4-c0ae-38b6-b178-8305de5db753",
                                "text": "Whatever is decided, it is clear that Crossrail 2 must be regarded as a non-starter for the foreseeable future."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43dee992-84d2-43a5-b2d7-e2030a9092cb",
