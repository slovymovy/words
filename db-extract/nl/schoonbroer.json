                                            {
                                                "example_id": "b9716af3-b41d-4587-abfb-a251cf4a9df4",
                                                "sense_id": "a93539a6-37f1-3722-9547-8ef533630ee7",
                                                "text": "Dowiedziałem się, że moja siostra się zaręczyła, więc wkrótce będę miał nowego szwagra."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "2a417c2b-d964-3d50-9b4d-e4f79a19dcfa",
                                        "entry_id": "05bbdeed-a3db-37b6-855b-f43f68608ef7",
                                        "glosses": [
                                            "mąż szwagierki (siostry męża lub żony)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b124eaf-5008-4686-9366-9931ea3b3cea",
                                                "sense_id": "2a417c2b-d964-3d50-9b4d-e4f79a19dcfa",
                                                "text": "Przyjechała do nas rodzina ze strony żony, szwagierka ze szwagrem i ich dzieci"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "94db2174-be53-3093-bd2e-bda25356ca5d",
                                        "entry_id": "05bbdeed-a3db-37b6-855b-f43f68608ef7",
                                        "glosses": [
                                            "o mężczyźnie, który sypia z tą samą kobietą co inny mężczyzna"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f10e57-f8ef-45f1-ab4a-882975301edd",
                                                "sense_id": "94db2174-be53-3093-bd2e-bda25356ca5d",
                                                "text": "Ja też poznałem Jolkę w sensie biblijnym, więc jesteśmy szwagrami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            }
                        ]
