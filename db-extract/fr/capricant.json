                "senses": [
                    {
                        "sense_id": "27565869-646d-3456-b29d-f090dcfe3eac",
                        "entry_id": "a685d025-4b38-3496-babf-375ef99e9284",
                        "glosses": [
                            "Qui se rapproche de la chèvre ou du caprin. Qui évoque les bonds fantasques de la chèvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59eef15e-9261-41a0-8555-2368a73c4fae",
                                "sense_id": "27565869-646d-3456-b29d-f090dcfe3eac",
                                "text": "Elle retint son souffle, prit son élan et, en quelques bonds capricants, parvint au premier étage avec une remarquable économie de décibels."
                            }
                        ]
                    },
                    {
                        "sense_id": "73833734-ae8c-3be9-87a9-454fa08cb7e8",
                        "entry_id": "a685d025-4b38-3496-babf-375ef99e9284",
                        "glosses": [
                            "Qui est dur et inégal, en parlant du pouls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8588e67-1dc3-4746-b5c9-6871ea9a7f84",
                                "sense_id": "73833734-ae8c-3be9-87a9-454fa08cb7e8",
                                "text": "A cette catégorie se rattache le pouls dicrote, bisferiens, dans lequel chaque impulsion artérielle est en quelque sorte double et communique au doigt un rapide et double choc : c'est ce qu'on appelait autrefois le pouls capricant et rebondissant."
                            }
                        ]
                    },
                    {
                        "sense_id": "26caf6bd-f798-3d45-9759-daa92c2bac01",
                        "entry_id": "a685d025-4b38-3496-babf-375ef99e9284",
                        "glosses": [
                            "Capricieux, fantasque, désordonné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb8a1f6-6372-402c-b7a1-667baf6c248e",
                                "sense_id": "26caf6bd-f798-3d45-9759-daa92c2bac01",
                                "text": "Une chambre capricante."
                            },
                            {
                                "example_id": "4323440f-4a2f-4d24-b656-d031823d8ea8",
                                "sense_id": "26caf6bd-f798-3d45-9759-daa92c2bac01",
                                "text": "— Quand on parle de la louve..., lui dis-je. Et la petite Primavérile s’en vient à nous, capricante, menue, les yeux luisants comme deux gouttes de café. Elle s’assied tout contre moi : sa robe, exacte aux hanches, me défend mal contre le toucher d’une chair étroite et dure."
                            },
                            {
                                "example_id": "61569766-714b-401b-b219-fb16fd1a1d79",
                                "sense_id": "26caf6bd-f798-3d45-9759-daa92c2bac01",
                                "text": "Comme elle a bien changé, la capricante et querelleuse Montespan !"
                            }
                        ]
                    }
                ],
