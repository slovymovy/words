                                        "sense_id": "fec5a0dd-805b-3ce4-a807-d861aa5fe196",
                                        "entry_id": "c084e45d-2045-346a-8bf5-7574f2ed60bf",
                                        "glosses": [
                                            "Relativo al trivio."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
