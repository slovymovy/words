                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département du Jura."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f35c1b-5a98-409d-981b-b690c8a1acf4",
                                "sense_id": "79fdd786-f9ac-3663-b56e-f098e31af98d",
                                "text": "Duchotel. — Hein ! ah ! moi ? parfaitement ! non, j’avais compris… tiens, parbleu si, j’habite Lons-le-Saunier.\nMadame Latour. — Vous devez bien vous y ennuyer ?\nDuchotel. — Mais non… le jardin public… la musique militaire…"
                            },
                            {
                                "example_id": "24957e47-0d1d-4a88-82c0-425892575941",
                                "sense_id": "79fdd786-f9ac-3663-b56e-f098e31af98d",
                                "text": "D’ailleurs, le père Dubois ne croyait guère à ces histoires de Défense Passive. Qu’est-ce que des avions pourraient bien trouver à bombarder à Lons-le-Saunier ?"
                            }
                        ]
                    }
