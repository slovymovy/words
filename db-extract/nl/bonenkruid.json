                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e39b1162-22ae-40b7-a28b-1a7102c37c14",
                                                "sense_id": "1b20f20b-4c17-3d08-a08a-1f476616876e",
                                                "text": "On Friday the pastry chef Pichet Ong will open his own cafe, with sweets and savories served at tables and a counter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "savory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e090dbe-6b21-36b8-84d7-cd0f7633e037",
                                        "entry_id": "84ecec69-1430-3f28-8a51-0ee1f7319e87",
                                        "glosses": [
                                            "Any of several Mediterranean herbs, of the genus Satureja, grown as culinary flavourings."
                                        ],
                                        "tags": [
