                "senses": [
                    {
                        "sense_id": "5fbc7adb-b13d-3079-bedc-7a656c18b6bf",
                        "entry_id": "39280b86-c700-3e3b-bf24-642b89ae6dc9",
                        "glosses": [
                            "Gesamtheit aller Personen und Unternehmen, die Fernhandel betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42dd6d9e-de96-42b0-a558-16f4254b2d08",
                                "sense_id": "5fbc7adb-b13d-3079-bedc-7a656c18b6bf",
                                "text": "„Das Fernhandelsnetz der Induskultur war weit gespannt.“"
                            },
                            {
                                "example_id": "8b442408-6f9f-4fdb-b2c3-47ff33495985",
                                "sense_id": "5fbc7adb-b13d-3079-bedc-7a656c18b6bf",
                                "text": "„Dieses Gold produzierende Reich war in die Fernhandelsnetze des Indischen Ozeans eingebunden, wie Funde in Mapungubwe belegen.“"
                            },
                            {
                                "example_id": "f2796581-c607-47ce-9798-0a05fdcbc34c",
                                "sense_id": "5fbc7adb-b13d-3079-bedc-7a656c18b6bf",
                                "text": "„Es gab aus dem Norden einen nahezu unerschöpflichen Nachschub an nomadisch lebenden Völkern, die dank des einst florierenden Fernhandelsnetzes vom zentralen Tal Kenntnis hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
