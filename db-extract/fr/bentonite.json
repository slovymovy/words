                                "sense_id": "700ca761-68bf-34ea-b9f6-2365b37e4914",
                                "text": "Nous avons étudié aussi deux échantillons de bentonite, l’un de provenance américaine et l’autre marocain."
                            },
                            {
                                "example_id": "541b662f-88fc-45df-9f95-e7f432f52818",
                                "sense_id": "700ca761-68bf-34ea-b9f6-2365b37e4914",
                                "text": "Au Maroc Nord oriental, les gisements de bentonites sont, en grande partie, liés au complexe volcanique de Gourougou."
                            }
                        ]
                    }
