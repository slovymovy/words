                            {
                                "example_id": "a097d5d0-7975-4371-8696-8086d172f027",
                                "sense_id": "6a65bcca-073f-3171-ab07-6cbc69c2ee95",
                                "text": "Comme frappée d'une illumination, Violaine se relève : — Au fait, Eric, je ne suis pas du tout d'accord sur la partouse finale."
                            },
                            {
                                "example_id": "b0979de8-c6f6-4a73-85fe-2bc19d82f5c6",
                                "sense_id": "6a65bcca-073f-3171-ab07-6cbc69c2ee95",
                                "text": "Il y a aussi le genre partouse. qui se rencontre soit dans les boîtes, soit dans les soirées privées : on fait l'amour à plusieurs, ou en série, au hasard des corps et des rencontres physiques, dans les combinaisons les plus variées."
                            }
                        ]
