                "entry_id": "1fc36d90-ff24-3038-b1e2-1e9ce13d61ac",
                "word": "Hégire",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60cea29c-572c-3337-909e-ff794e2cfa0f",
                        "entry_id": "1fc36d90-ff24-3038-b1e2-1e9ce13d61ac",
                        "glosses": [
                            "Jour du départ des premiers compagnons de Mahomet de La Mecque vers l’oasis de Yathrib, devenu Médine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b220a1cb-0d14-4d4e-a208-554a4b263dad",
                                "sense_id": "60cea29c-572c-3337-909e-ff794e2cfa0f",
                                "text": "Mais ce ne fut qu'en l'année 363 de l’hégire, sous le khalifat de Mothi l'Illah l'Abbasside, que les Sunnites et les Schiites se partagèrent pour ainsi dire en deux peuples distincts ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9492c51-a3f5-4b6e-9931-b2f4b998182f",
                        "source_entry_id": "1fc36d90-ff24-3038-b1e2-1e9ce13d61ac",
                        "source_sense_id": "60cea29c-572c-3337-909e-ff794e2cfa0f",
                        "target_lang_word": "Hidschra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hidschra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f604d5b6-0430-3338-b0ec-db724b94e95e",
                                        "entry_id": "bd8e08eb-1b01-3bb8-a963-c8a3642ae95e",
                                        "glosses": [
                                            "Übersiedlung Mohammeds von Mekka nach Medina im Jahre 622, die den Beginn der islamischen Zeitrechnung markiert"
                                        ],
                                        "tags": [
                                            "islamische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1341e6-690d-41cf-90d7-4b87fc50925a",
                                                "sense_id": "f604d5b6-0430-3338-b0ec-db724b94e95e",
                                                "text": "Mit der Hidschra beginnt die islamische Zeitrechnung."
                                            },
                                            {
                                                "example_id": "22758ee8-c385-46ad-99e3-bda1d964af0e",
                                                "sense_id": "f604d5b6-0430-3338-b0ec-db724b94e95e",
                                                "text": "„Ich fühle die Tränen des jungen Boabdil, die er an einem Tag im Monat Muharram des Jahres 897 der Hidschra angesichts der Mauren Granadas auf dem Pass über den Rihan-Berg vergossen hat.“"
                                            },
                                            {
                                                "example_id": "7f4e1e9d-ebaa-41a9-845b-db544e9986a5",
                                                "sense_id": "f604d5b6-0430-3338-b0ec-db724b94e95e",
                                                "text": "„Nach der Flucht Mohammeds nach Medina, der Hidschra, wurde Ammar bin-Jassir, einer seiner Gefährten, mitsamt seiner Familie in Mekka gefangen gesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3129d5e-bad8-4282-9a42-38a4ba89a8ec",
                        "source_entry_id": "1fc36d90-ff24-3038-b1e2-1e9ce13d61ac",
                        "source_sense_id": "60cea29c-572c-3337-909e-ff794e2cfa0f",
                        "target_lang_word": "Hedschra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hedschra",
