                        "glosses": [
                            "Bewegung, die (ausschließlich) mit dem Arm (den Armen) gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1718d1bd-04fe-4850-85cd-d1fb33b9d878",
                                "sense_id": "78924c1e-1586-38ef-a64d-1d240d2f8386",
                                "text": "„Dazu zählten vor allem das polizeiliche Vorgehen bei der Kontrolle, das Fahrverhalten der kontrollierten Diebe sowie eine rasche Armbewegung des Beifahrers, bevor dieser erschossen wurde.“"
                            },
                            {
                                "example_id": "fb903fcd-71ae-40e6-b350-6cbdd3a3116d",
                                "sense_id": "78924c1e-1586-38ef-a64d-1d240d2f8386",
                                "text": "„Der Geschäftsführer erhob sich und forderte den Chronisten mit einer einladenden Armbewegung zu einem Gang durch die gläserne Runde auf.“"
                            }
                        ],
