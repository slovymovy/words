                "senses": [
                    {
                        "sense_id": "b697fd46-a99f-3749-a534-06cd00bca4bd",
                        "entry_id": "b509fcb1-f91c-3eb6-a39f-8157e4c42640",
                        "glosses": [
                            "Qui appartient au pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b6d419-8953-4506-9e64-7975034ef640",
                                "sense_id": "b697fd46-a99f-3749-a534-06cd00bca4bd",
                                "text": "Mais ils ont aussi réclamé à François d’abroger des décrets papaux à l’origine de la « doctrine de la découverte »."
                            },
                            {
                                "example_id": "0375fb33-74be-4007-b888-3094744c20f6",
                                "sense_id": "b697fd46-a99f-3749-a534-06cd00bca4bd",
                                "text": "Les vieux d’avant la Révolution étaient morts ; les jeunes passèrent presque tous à la thèse de l’infaillibilité papale ; mais il resta encore une profonde différence entre ces ultramontains de la dernière heure et les hardis contempteurs de la scolastique et de l’église gallicane sortis de l’école de Lamennais."
                            },
                            {
                                "example_id": "23ca192d-46ef-4d34-9e12-83811e5800a4",
                                "sense_id": "b697fd46-a99f-3749-a534-06cd00bca4bd",
                                "text": "L’accident fit douze morts, dont le duc de Bretagne, et beaucoup de blessés. La tiare papale, renversée, fut endommagée et le fameux rubis (ou diamant ?) qui l’ornait roula sous les décombres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a7912d4-baa5-4bf7-adac-414425a5dc56",
                        "source_entry_id": "b509fcb1-f91c-3eb6-a39f-8157e4c42640",
                        "source_sense_id": "b697fd46-a99f-3749-a534-06cd00bca4bd",
                        "target_lang_word": "päpstlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "päpstlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b36a27a9-20f4-3e3b-bcca-d06e90c3423d",
                                        "entry_id": "9160abdf-cbaa-3e46-8f6d-8e93781a6d7b",
                                        "glosses": [
                                            "den Papst betreffend, zu ihm gehörig, in der Art des Papstes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca3544f0-eb0e-4c1b-a333-f476008b73b6",
                                                "sense_id": "b36a27a9-20f4-3e3b-bcca-d06e90c3423d",
                                                "text": "„Nach der vom englischen Parlament gebilligten „Statute of Praemunire“ dürfen englische Geistliche weder in kirchlichen noch weltlichen Fragen außerenglische oder päpstliche Stellen bemühen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
