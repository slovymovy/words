                ],
                "senses": [
                    {
                        "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                        "entry_id": "0ac14ae9-b43e-3b8a-8e89-dda89070fcf9",
                        "glosses": [
                            "Maschine mit einer schnell rotierenden Scheibe zum Trennen, Schruppen/Schleifen und Polieren (mit unterschiedlichen Scheiben) von meist harten Werkstoffen wie Metall und Stein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042d50b0-dc2a-474b-b238-51e83dd5bc24",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Die Experten mussten sogar den Trennschleifer benutzen.“"
                            },
                            {
                                "example_id": "33c878e1-c489-4d53-8da1-b920b928e07b",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Ein Tor konnte nur mit einem Trennschleifer geöffnet werden.“"
                            },
                            {
                                "example_id": "5e9839ba-e6ae-4e93-8cc6-6317a63444d1",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Die Feuerwehr musste das Metall mit einem Trennschleifer vom Betonfundament abtrennen, um den Mann ins Krankenhaus transportieren zu können.“"
                            },
                            {
                                "example_id": "e737040a-bd97-4a5c-9a48-fe52b0f5706c",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Ich mag Trennschleifer, weil die Schnitte, die sie machen, sehr wenig oder überhaupt keine Reinigung erfordern.“"
                            },
                            {
                                "example_id": "2638156c-3c20-4936-b978-9c8b07c456b6",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Einen guten Trennschleifer für Metall kann man für etwa 150 bis 200 Euro kaufen.“"
                            },
                            {
                                "example_id": "553351c3-173f-4869-b4bc-44143ac6631f",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Vergewissern sie sich vor dem Einsatz eines Trennschleifers, dass das zu schneidende Teil fest in den Maschinenschraubstock eingespannt ist, damit es nicht wegfliegt.“"
                            },
                            {
                                "example_id": "d9f013fb-5072-4e78-b55a-469f849c9a60",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Beim THW lernt man in der kostenlosen Grundausbildung unter anderem, wie man mit einer Kettensäge oder einem Trennschleifer umgeht, eine Hochleistungspumpe bedient oder wie man Holz und Metall bearbeitet.“"
                            },
                            {
                                "example_id": "8bcd3f1d-735e-4e0b-8906-eca88aadbb92",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Dann machten sie sich am Tresor zu schaffen - allerdings nicht von vorn: Sie stemmten die Wand auf, an der der Tresor stand und öffneten danach die Rückwand des Tresors mit einem Trennschleifer.“"
                            },
                            {
                                "example_id": "038989c1-29dd-4b7d-9e1e-04e389b9b6f5",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Zwei Unbekannte haben in einer Spielothek in Kitzingen eingebrochen und Bargeld in fünfstelliger Höhe erbeutet.“ […] „Mit einem Trennschleifer öffneten sie die tresorähnlichen Gehäuse.“"
                            },
                            {
                                "example_id": "351665a1-bdab-462a-b451-7259e2f42721",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Unbekannte haben im Gewerbegebiet Wittlich in mehreren Autohäusern Katalysatoren aus Autos gestohlen. Wie die Polizei mitteilte, entfernten sie die Katalysatoren mit einem Trennschleifer aus den Autos.“"
                            },
                            {
                                "example_id": "e721c54f-4919-40ea-8148-7b889831e6fb",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "[Brand bei Müllverwertung:] „Demnach könnten Wartungsarbeiten mit einem Trennschleifer das Feuer verursacht haben, sagte ein Polizeisprecher am Montag.“"
                            },
                            {
                                "example_id": "7992138a-ab11-484f-9c46-03c56a0bab06",
                                "sense_id": "a7e39321-0c01-39a3-a818-84d0402256b0",
                                "text": "„Wer also nicht öfter einen Trennschleifer mit Diamantsägeblatt benötigt und gleichfalls keinen leistungsstarken Bohr- und Meißelhammer, der sollte sich die Geräte einfach ausleihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
