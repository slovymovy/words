        "de-extract.jsonl": [
            {
                "entry_id": "fbdb96ee-26aa-3a63-a97b-25f6a3743ecf",
                "word": "psychiatrist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f62ce29-fc61-3d7e-98a1-0679bd9f6be0",
                        "entry_id": "fbdb96ee-26aa-3a63-a97b-25f6a3743ecf",
                        "glosses": [
                            "Facharzt oder Fachärztin für psychische Erkrankungen: Psychiater, Psychiaterin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33e68b28-2230-4561-acb4-3196b4eb1b81",
                                "sense_id": "7f62ce29-fc61-3d7e-98a1-0679bd9f6be0",
                                "text": "\"John Herman is a doctor, a psychiatrist at Massachusetts General Hospital, and if you ask anybody in the country who knows about this stuff, they’ll tell you he is one of the best. But even the best lose patients to suicide.\"",
                                "translation": "John Herman ist ein Arzt, ein Psychiater am Massachusetts General Hospital, und wenn Sie jemanden im Land fragen, der sich mit diesen Dingen auskennt, werden Sie die Antwort erhalten, dass er einer der besten ist. Doch selbst die besten verlieren Patienten durch Suizid."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca0e5f4e-b7b2-49ea-8980-7164370a19c9",
                        "source_entry_id": "fbdb96ee-26aa-3a63-a97b-25f6a3743ecf",
                        "source_sense_id": "7f62ce29-fc61-3d7e-98a1-0679bd9f6be0",
                        "source_sense_description": "Facharzt oder Fachärztin für psychische Erkrankungen",
                        "target_lang_word": "Psychiater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychiater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                        "entry_id": "3fc3e076-3a91-3ccb-99eb-d4b075f337ef",
                                        "glosses": [
                                            "Facharzt für Geistes- und Gemütskrankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f908a9-3fac-4d71-81a5-108bd693bd12",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "Der Psychiater hat den Kranken in das Krankenhaus für Neurologie und Psychiatrie eingewiesen."
                                            },
                                            {
                                                "example_id": "48642a70-efc8-49c2-b017-893d761cc26e",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Die Mutter einer Schizophrenen benachrichtigte den behandelnden Psychiater telefonisch, dass der Zustand ihrer Tochter sich wieder verschlechterte.“"
                                            },
                                            {
                                                "example_id": "29c0a2ef-cfec-478a-bc6a-d75d67e87920",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Ein Psychiater von heute hätte vielleicht die verschiedenartigsten narzißstischen Persönlichkeitsstörungen diagnostiziert.“"
                                            },
                                            {
                                                "example_id": "a8a3d7bc-51c1-4b5b-ac2d-4475fa64e102",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Ich wäre dann auf jeden Fall irrsinnig, aber es ist mir trotzdem nie eingefallen, zum Psychiater zu gehen.“"
                                            },
                                            {
                                                "example_id": "5cb63d82-949c-4e79-a015-b9f12d4a0fe7",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Man saß im Wartezimmer eines Psychiaters in Gesellschaft von lauter Bekloppten und fragte sich, ob man selber einer war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1375b719-3c7a-4b91-8108-a4b5c1437c9d",
                        "source_entry_id": "fbdb96ee-26aa-3a63-a97b-25f6a3743ecf",
                        "source_sense_id": "7f62ce29-fc61-3d7e-98a1-0679bd9f6be0",
                        "source_sense_description": "Facharzt oder Fachärztin für psychische Erkrankungen",
                        "target_lang_word": "Psychiaterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychiaterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64fb974d-a773-3a02-9da5-d817801bcd39",
                                        "entry_id": "a45ff522-f00c-38e3-9f8f-49cbc4955f76",
                                        "glosses": [
                                            "Fachärztin für Geistes- und Gemütskrankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611b2386-d967-4583-ac4b-a90863b7f312",
                                                "sense_id": "64fb974d-a773-3a02-9da5-d817801bcd39",
                                                "text": "„Svanhvít war Psychiaterin und, wenn man Sólmundur glauben konnte, eine der äußerst wenigen im Land, die sich mit der Psychoanalyse von Freud und Jung auseinandergesetzt hat.“"
                                            },
                                            {
                                                "example_id": "8566b3f2-2294-410b-8b06-b466f6007994",
                                                "sense_id": "64fb974d-a773-3a02-9da5-d817801bcd39",
                                                "text": "„Früher in diesem Jahr hatte Roth begonnen, mit der einunddreißigjährigen Psychiaterin Julia Golier auszugehen, die am Mount Sinai Hospital an der Upper East Side unterrichtete und im Krankenhaus der Veterans' Administration in der Bronx Vietnamveteranen mit posttraumatischer Belastungsstörung behandelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
