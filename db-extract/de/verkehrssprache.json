                                        "sense_id": "312816ba-418f-3829-a1ae-5a088248a582",
                                        "entry_id": "a5ac6491-d268-3ac5-bd1b-906a1c471f9b",
                                        "glosses": [
                                            "Langue commune à des peuples ayant des langues différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ed8381-4392-496a-a237-4792eabfa6b3",
                                                "sense_id": "312816ba-418f-3829-a1ae-5a088248a582",
                                                "text": "Les principales sciences de l’époque (théologie, droit, histoire, et disciplines scientifiques stricto sensu) leur étaient interdites faute de compétence en latin, puisque le latin était alors la langue des savants en France et en Europe, la langue véhiculaire du savoir."
                                            },
                                            {
                                                "example_id": "406de43f-27a1-4519-8e5e-65ac9dceed53",
                                                "sense_id": "312816ba-418f-3829-a1ae-5a088248a582",
                                                "text": "Une lingua franca, c'est une langue internationale, une langue véhiculaire."
                                            }
                                        ]
                                    }
                                ]
                            }
