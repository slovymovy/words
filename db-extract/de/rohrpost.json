                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8b470f4-b897-3e5d-8682-6d820b0ad6dc",
                        "entry_id": "839a9a07-2ea4-3f81-ab19-b344c2ef2cfe",
                        "glosses": [
                            "Postbeförderung durch ein System von Röhren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88dca405-5073-4d98-8aef-433ccd4ee918",
                                "sense_id": "f8b470f4-b897-3e5d-8682-6d820b0ad6dc",
                                "text": "„Eine der versiertesten und innovativsten Lösungen des Posttransportes ist seit jeher die Rohrpost, die im städtischen Bereich bis in die Gegenwart als sogenannte Hausrohrpost zum Einsatz kommt.“"
                            },
                            {
                                "example_id": "421c6f35-6624-417c-87d5-ce18e2fca6ad",
                                "sense_id": "f8b470f4-b897-3e5d-8682-6d820b0ad6dc",
                                "text": "„Per Sekunde lassen sich sechzehn dieser Granaten abfeuern; wehmütig denkt man bei ihrem Anblick an die idyllischen Tuben der heimatlichen Rohrpost.“"
                            },
                            {
                                "example_id": "8426221a-a996-4210-b782-5939e05b996a",
                                "sense_id": "f8b470f4-b897-3e5d-8682-6d820b0ad6dc",
                                "text": "„So wurden Briefmarken und postalische Einrichtungen wie die Rohrpost Gegenstand des Interesses von modernen Dichtern wie Marcel Proust, Guillaume Apollinaire oder Blaise Cendrars.“"
                            },
                            {
                                "example_id": "98d3e222-7b75-43eb-93e4-ef0416b03d91",
                                "sense_id": "f8b470f4-b897-3e5d-8682-6d820b0ad6dc",
                                "text": "„Die Briefe wurden aus ihren Ämtern auf schnellstem Wege zum Briefpostamt C 2, teils per Rohrpost, befördert und von dort in besonderen Kraftwagen zum Flugplatz Johannisthal gebracht und dort auf dem Flugfeld direkt zur Verladung den Flugzeugführern übergeben.“"
                            },
                            {
                                "example_id": "fed2305c-823e-4488-9fc1-0bb9032eb6e4",
                                "sense_id": "f8b470f4-b897-3e5d-8682-6d820b0ad6dc",
                                "text": "„Das Vineta war ein populäres Tanzbums, mit Tischtelefon, Rohrpost und ähnlichen Sachen für Provinzler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "58640fd0-8231-3fc5-9927-afcf4204b783",
                        "entry_id": "839a9a07-2ea4-3f81-ab19-b344c2ef2cfe",
                        "glosses": [
                            "durch Röhren befördertes Postgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444dfde8-2736-4333-94bd-87f6fc968266",
                                "sense_id": "58640fd0-8231-3fc5-9927-afcf4204b783",
                                "text": "„Besonders schön und selten sind Sendungen in der Kombination Rohrpost und Eilboten, bei denen das Verlangen nach Eilboten nicht vorausfrankiert wurde, diese Sendungen aber dennoch per Eilboten zugestellt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
