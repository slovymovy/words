{
    "word_family": [
        "voluminous",
        "volumize",
        "volumetric"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83f72c7e-c095-3d69-9dd7-909f9c9302bb",
                    "sense_definition": "The loudness or strength of a sound.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>turn</w> <w>down</w> the <w>volume</w> on the stereo because it is too loud.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убавь <w>громкость</w> на стереосистеме, потому что она играет слишком громко."
                            }
                        },
                        {
                            "text": "The <w>volume</w> of the music was so high that the neighbors complained.",
                            "target_lang_translations": {
                                "ru": "<w>Громкость</w> музыки была такой высокой, что соседи пожаловались."
                            }
                        }
                    ],
                    "synonyms": [
                        "loudness",
                        "amplitude"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "turn down the volume",
                        "adjust the volume",
                        "high volume",
                        "low volume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкость или сила звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громкость",
                                "target_lang_sense_clarification": "сила звучания"
                            },
                            {
                                "target_lang_word": "звук",
                                "target_lang_sense_clarification": "в контексте регулировки уровня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46a5d9b4-0aca-39f4-8b78-b898e0885b85",
                    "sense_definition": "The amount of three-dimensional space an object occupies or contains.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room is nine by twelve by eight, so its <w>total</w> <w>volume</w> is 864 cubic feet.",
                            "target_lang_translations": {
                                "ru": "Комната имеет размеры девять на двенадцать на восемь, так что её общий <w>объём</w> составляет 864 кубических фута."
                            }
                        },
                        {
                            "text": "You can calculate the <w>volume</w> of a box by multiplying its length, width, and height.",
                            "target_lang_translations": {
                                "ru": "Вы можете вычислить <w>объём</w> коробки, перемножив её длину, ширину и высоту."
                            }
                        }
                    ],
                    "synonyms": [
                        "capacity",
                        "size",
                        "bulk"
                    ],
                    "common_phrases": [
                        "total volume",
                        "calculate the volume",
                        "liquid volume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина трехмерного пространства, которое занимает или вмещает объект."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объём",
                                "target_lang_sense_clarification": "физическая величина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b456611-c618-3154-ae9f-81a09f1911b1",
                    "sense_definition": "A large quantity or amount of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>volume</w> of ticket sales decreased significantly this week compared to last month.",
                            "target_lang_translations": {
                                "ru": "<w>Объём</w> продаж билетов на этой неделе значительно снизился по сравнению с прошлым месяцем."
                            }
                        },
                        {
                            "text": "The factory produces a <w>high</w> <w>volume</w> of goods every single day.",
                            "target_lang_translations": {
                                "ru": "Завод производит большой <w>объём</w> товаров каждый божий день."
                            }
                        }
                    ],
                    "synonyms": [
                        "amount",
                        "quantity",
                        "mass"
                    ],
                    "common_phrases": [
                        "high volume",
                        "volume of sales",
                        "trading volume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или масса чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объём",
                                "target_lang_sense_clarification": "количество или масштаб чего-либо"
                            },
                            {
                                "target_lang_word": "масса",
                                "target_lang_sense_clarification": "большое количество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8d5334c-7f67-3796-8a1c-c1a94fcb0526",
                    "sense_definition": "A single book that is part of a larger series or set, such as an encyclopedia.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "books",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The information about the history of Rome was found in <w>volume</w> four of the series.",
                            "target_lang_translations": {
                                "ru": "Информация об истории Рима была найдена в четвёртом <w>томе</w> серии."
                            }
                        },
                        {
                            "text": "She has the <w>entire</w> <w>volume</w> of the encyclopedia set in her home library.",
                            "target_lang_translations": {
                                "ru": "В её домашней библиотеке есть всё <w>собрание</w> энциклопедии."
                            }
                        }
                    ],
                    "synonyms": [
                        "book",
                        "tome",
                        "edition"
                    ],
                    "common_phrases": [
                        "entire volume",
                        "first volume",
                        "bound volume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная книга, являющаяся частью более крупной серии или набора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "том",
                                "target_lang_sense_clarification": "часть многотомного издания"
                            },
                            {
                                "target_lang_word": "книга",
                                "target_lang_sense_clarification": "отдельная единица в серии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b8149a-6840-3b39-b0d5-90d8a664740f",
                    "sense_definition": "A collection of issues of a periodical, usually covering one year.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "books",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I looked at this week's copy of the magazine and saw it was <w>volume</w> 23, issue 45.",
                            "target_lang_translations": {
                                "ru": "Я посмотрел свежий номер журнала и увидел, что это <w>том</w> 23, выпуск 45."
                            }
                        },
                        {
                            "text": "The library keeps every <w>bound</w> <w>volume</w> of the local newspaper for historical research.",
                            "target_lang_translations": {
                                "ru": "Библиотека хранит каждый подшитый <w>том</w> местной газеты для исторических исследований."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bound volume",
                        "current volume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание выпусков периодического издания, обычно за один год."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "том",
                                "target_lang_sense_clarification": "годовой подшивка или выпуск"
                            },
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "периодическое издание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8907b9de-c344-3dff-8ea8-e038e59054fe",
                    "sense_definition": "A storage area on a computer disk with a single file system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operating system failed to recognize the <w>logical</w> <w>volume</w> on the external hard drive.",
                            "target_lang_translations": {
                                "ru": "Операционная система не смогла распознать логический <w>том</w> на внешнем жестком диске."
                            }
                        },
                        {
                            "text": "You need to format the <w>volume</w> before you can start saving files to it.",
                            "target_lang_translations": {
                                "ru": "Вам нужно отформатировать <w>том</w>, прежде чем вы сможете начать сохранять на него файлы."
                            }
                        }
                    ],
                    "synonyms": [
                        "partition",
                        "drive"
                    ],
                    "common_phrases": [
                        "logical volume",
                        "boot volume",
                        "mount a volume"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Область хранения на компьютерном диске с единой файловой системой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "том",
                                "target_lang_sense_clarification": "логический диск"
                            },
                            {
                                "target_lang_word": "раздел",
                                "target_lang_sense_clarification": "часть дискового пространства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e79f085-50a6-30b2-a279-dc944a765975",
                    "sense_definition": "A great deal of information or meaning conveyed without many words.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "idiomatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The look of disappointment on his face <w>spoke</w> <w>volumes</w> about how he felt.",
                            "target_lang_translations": {
                                "ru": "Разочарование на его лице <w>говорило о многом</w>."
                            }
                        },
                        {
                            "text": "Her silence during the meeting <w>spoke</w> <w>volumes</w> to everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Её молчание во время встречи <w>было красноречивее всяких слов</w> для всех присутствующих."
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak volumes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой объем информации или смысла, переданный без слов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красноречиво свидетельствовать",
                                "target_lang_sense_clarification": "говорить о многом"
                            },
                            {
                                "target_lang_word": "говорить само за себя",
                                "target_lang_sense_clarification": "быть понятным без слов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e647e3c-7a2c-3944-b0aa-b2b8eaddb2a9",
                    "sense_definition": "A roll or scroll, which was the form of ancient books.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "books",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archaeologist carefully unrolled the ancient <w>volume</w> to read the faded script.",
                            "target_lang_translations": {
                                "ru": "Археолог осторожно развернул древний <w>свиток</w>, чтобы прочитать выцветший текст."
                            }
                        },
                        {
                            "text": "In the museum, we saw a papyrus <w>volume</w> dating back to the Roman Empire.",
                            "target_lang_translations": {
                                "ru": "В музее мы видели папирусный <w>свиток</w>, датируемый временами Римской империи."
                            }
                        }
                    ],
                    "synonyms": [
                        "scroll",
                        "roll"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to ancient book formats"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свиток или рулон, представлявший собой форму древних книг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свиток",
                                "target_lang_sense_clarification": "древняя форма книги"
                            },
                            {
                                "target_lang_word": "фолиант",
                                "target_lang_sense_clarification": "старинная книга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca792ac0-c370-3e2c-b430-27e9ca31055c",
                    "sense_definition": "To move or cause to move through the air in a swelling or billowing manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smoke was <w>voluming</w> up from the chimney in thick, gray clouds.",
                            "target_lang_translations": {
                                "ru": "Дым густыми серыми клубами <w>валил</w> из трубы."
                            }
                        },
                        {
                            "text": "The wind caused the curtains to <w>volume</w> out into the room.",
                            "target_lang_translations": {
                                "ru": "Ветер заставил шторы <w>раздуваться</w> внутрь комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "billow",
                        "waft",
                        "swell"
                    ],
                    "common_phrases": [
                        "volume up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или заставлять двигаться по воздуху клубами или волнами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клубиться",
                                "target_lang_sense_clarification": "о дыме или паре"
                            },
                            {
                                "target_lang_word": "вздыматься",
                                "target_lang_sense_clarification": "о движении ткани или облаков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}