                        "examples": [
                            {
                                "example_id": "7d4ad4a1-956f-4127-903e-9e015a5e15b4",
                                "sense_id": "94d98a3d-8c81-3815-b200-50fb637d2514",
                                "text": "„Daneben steht ein vom französischen Künstler McBess gestalteter Beachcruiser, bei dessen Anblick jeder Vollblut-Hipster vor Freude einen Herzkasperl bekommt.“"
                            },
                            {
                                "example_id": "3e22221a-4f0e-4ccd-a705-bb3756cfc143",
                                "sense_id": "94d98a3d-8c81-3815-b200-50fb637d2514",
                                "text": "„Herr Hartler hatte schon zwei Mal einen Herzkasperl in den letzten paar Monaten erlitten und war lange Zeit krank geschrieben.“"
                            }
                        ],
