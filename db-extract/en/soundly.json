                                                "sense_id": "be898b95-33da-3624-b2ec-d18275d0467e",
                                                "text": "Dat onderzoek had grondiger gekund."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53dba654-b6fb-384b-8fe6-c5cbdb5443ab",
                                        "entry_id": "5ff71edc-3224-3ebc-86bc-dca097abcfd9",
                                        "glosses": [
