                    },
                    {
                        "translation_id": "246b9dcf-057f-4cea-b892-3ff04dbae07a",
                        "source_entry_id": "e4a42028-a5bd-3370-b0c6-692f90c5bafc",
                        "source_sense_id": "cc26ae3f-1d89-35ff-b745-ea3a223fd9d3",
                        "target_lang_word": "monticule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monticule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                        "entry_id": "c1e8aed1-ac7a-3df8-bc0e-bcde546e090e",
                                        "glosses": [
                                            "Petite montagne ; simple élévation de terrain ; tertre ; butte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f19653e-b648-4c90-9ba5-7163c34ce083",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "Sur les pentes de quelques monticules, le sol fut absolument raviné et la croûte blanche mise à nu."
                                            },
                                            {
                                                "example_id": "144cb64d-8568-4df1-aa57-ad464d5815e2",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "…je grimpai sur la dune la plus élevée de la région ; autour de moi, de tous côtés, je ne vis que la houle grise des monticules de sable."
                                            },
                                            {
                                                "example_id": "bec16642-7375-4581-8ed9-e405f1416326",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "Sous l'influence des courants, des vents, et des variations de température, de formidables pressions se produisent ; le soulèvement et le chevauchement de la glace donnent naissance à des monticules ou « hummocks »."
                                            },
                                            {
                                                "example_id": "6051d171-ac45-482f-94ef-c275692588d0",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "L'aspect actuel d'un monument mégalithique se dressant sur un monticule a donné à Schumacher et Karge la fausse impression que les dolmens furent construits au-dessus des tumulus."
                                            },
                                            {
                                                "example_id": "55d3cc30-aa48-423a-99f9-2494545e1fc6",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "Un solarigraphe Volochine occupait le sommet d'un monticule à 150 m à l'Est de la baraque. De ce point l'horizon était dégagé dans tous les secteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fd68a98-28ca-3a66-beb5-91992e3d9846",
                                        "entry_id": "c1e8aed1-ac7a-3df8-bc0e-bcde546e090e",
                                        "glosses": [
                                            "Petite élévation du terrain sur laquelle se place le lanceur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f62a182-5d53-4c25-9df4-d78b44fc28f9",
                                                "sense_id": "9fd68a98-28ca-3a66-beb5-91992e3d9846",
                                                "text": "Les Torontois ont laissé le partant Chase Anderson œuvrer au monticule pendant trois manches et deux tiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f13bd35d-3ffe-4e37-a343-f3358c8ba7c5",
                        "source_entry_id": "e4a42028-a5bd-3370-b0c6-692f90c5bafc",
                        "source_sense_id": "cc26ae3f-1d89-35ff-b745-ea3a223fd9d3",
                        "target_lang_word": "colline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b938da33-7268-32f0-ac9d-911d4a2f65d9",
                                        "entry_id": "50f8e628-a3da-3390-8774-6673635f8c97",
                                        "glosses": [
                                            "Petite élévation de terrain dont les pentes sont douces et arrondies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff5cbd8-0b64-4b95-bc07-9e6645776bae",
                                                "sense_id": "b938da33-7268-32f0-ac9d-911d4a2f65d9",
                                                "text": "Nous reçûmes l’ordre de côtoyer en le remontant le ruisseau de la Tourbe, qui arrose la plus triste vallée du monde, entre des collines basses, sans arbres et sans buissons."
                                            },
                                            {
                                                "example_id": "3c10a38b-5348-4727-b1e9-347046b8cd9e",
                                                "sense_id": "b938da33-7268-32f0-ac9d-911d4a2f65d9",
                                                "text": "[…] cette bande qui s’étend sur les villages de Brotte, Ailloncourt, Éhuns, Citers, etc., est représentée par des collines ou des croupes mollement ondulées de 300 mètres d’altitude moyenne […]"
                                            },
                                            {
                                                "example_id": "1673e6ca-737b-4a2f-a475-0478f506b707",
                                                "sense_id": "b938da33-7268-32f0-ac9d-911d4a2f65d9",
                                                "text": "Nous finîmes par arriver à un lac immense entouré de collines et de tori pittoresques. On venait y faire de petites excursions en bateau ou en pédalo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e40a46-e8a6-31bd-9d61-0397ef05b47c",
                                        "entry_id": "50f8e628-a3da-3390-8774-6673635f8c97",
                                        "glosses": [
                                            "Vallée."
                                        ],
                                        "tags": [
                                            "Vosges",
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3b34cef-05c8-499a-94ff-f519c01a3263",
                                                "sense_id": "06e40a46-e8a6-31bd-9d61-0397ef05b47c",
                                                "text": "Du Chitelet, revenons sur nos pas jusqu’au Rothenbach, pour rentrer à La Bresse. Le lendemain sera employé à gravir, entre les collines de Chajoux et des Feignes-sous-Vologne, la croupe rocheuse où s’étagent les chaumes du Haut-Rouan et de Champy, celle-ci presque ronde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b17511d7-e9c6-3606-8bc5-4fd62d3ea014",
                                        "entry_id": "50f8e628-a3da-3390-8774-6673635f8c97",
                                        "glosses": [
                                            "Division administrative de troisième niveau au Burundi (comprise dans une commune)."
                                        ],
                                        "tags": [
                                            "Burundi"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81b5dab4-0921-3abd-8e2e-a9bccf2ed013",
                                        "entry_id": "50f8e628-a3da-3390-8774-6673635f8c97",
                                        "glosses": [
                                            "Meuble représentant le relief du même nom dans les armoiries. Ce meuble est rarement utilisé car difficile à distinguer des autres reliefs. À rapprocher de mont, montagne et rocher."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27c652ad-147e-4a4a-aabd-14ee81807135",
                                                "sense_id": "81b5dab4-0921-3abd-8e2e-a9bccf2ed013",
                                                "text": "De gueules, au clocher-porche d’argent à dextre et au cep de vigne tigé et feuillé sur son échalas d’or, fruité de pourpre à senestre; au chef bastillé d’or chargé d’une colline isolée de sinople, qui est de la commune de Mirepoix du Gers → voir illustration « armoiries avec une colline »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
