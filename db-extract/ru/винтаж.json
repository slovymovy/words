                "senses": [
                    {
                        "sense_id": "830bf7a8-09b7-3a8a-abae-840f79321513",
                        "entry_id": "7353ee54-9d02-3990-8d0b-13c1264645e6",
                        "glosses": [
                            "неол. стилизованное направление в моде и искусстве, особенно в одежде и предметах домашнего обихода, ориентирующееся на возрождение модных направлений прошлых поколений, эпох"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eee21c4-6b14-4929-9366-efa41ac68575",
                                "sense_id": "830bf7a8-09b7-3a8a-abae-840f79321513",
                                "text": "Вот, пожалуйста, вам пример: стиль «винтаж», эту милую привычку копаться в сундуках прошлых эпох и выуживать оттуда нечто сногсшибательное, запустила в люди именно она, Кейт Мосс."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ff2fe87-8f88-4020-a1e1-d2be64e8bfc5",
                        "source_entry_id": "7353ee54-9d02-3990-8d0b-13c1264645e6",
                        "source_sense_id": "830bf7a8-09b7-3a8a-abae-840f79321513",
                        "target_lang_word": "vintage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vintage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb26e80-dbff-3b45-8b29-d5d0fe7bb621",
                                        "entry_id": "0da4e22c-1626-3f1f-bc04-68112a9afbe7",
                                        "glosses": [
                                            "Daté d’une certaine époque."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e983e6a2-1652-4fda-8d8e-dc1a96351a3b",
                                                "sense_id": "5eb26e80-dbff-3b45-8b29-d5d0fe7bb621",
                                                "text": "[…] des robes de jersey de Deneuve au look « Drôles de dames » de Judith Godrèche, le défilé vintage se révèle follement drôle."
                                            },
                                            {
                                                "example_id": "020c7d01-f245-4339-92ef-9cc982f75f67",
                                                "sense_id": "5eb26e80-dbff-3b45-8b29-d5d0fe7bb621",
                                                "text": "Ce logo est en effet authentiquement vintage : il a été créé en 1977 par José María Cruz Novillo et reste utilisé aujourd’hui par le parti, avec quelques modifications."
                                            },
                                            {
                                                "example_id": "77ddcd72-9b96-4ac8-8f19-48e06118f305",
                                                "sense_id": "5eb26e80-dbff-3b45-8b29-d5d0fe7bb621",
                                                "text": "Un travail d’orfèvre, avec des textes profonds portés par des mélodies superbes et volontiers vintage."
                                            },
                                            {
                                                "example_id": "8c49457f-9649-4808-b76d-2b3ba0493cf3",
                                                "sense_id": "5eb26e80-dbff-3b45-8b29-d5d0fe7bb621",
                                                "text": "Il y avait aussi une photo de groupe de deux garçons et deux filles, dont Katie. Elle était citée : elle disait que sa prom dress venait de « Village Vintage, à Blackheath, où on peut trouver des robes vintages sublimes à des prix abordables »."
                                            },
                                            {
                                                "example_id": "872c881e-9049-4e28-9b5d-72ef8bf2bf7b",
                                                "sense_id": "5eb26e80-dbff-3b45-8b29-d5d0fe7bb621",
                                                "text": "Il avait plus de style, avec son cartable de facteur en cuir élimé et son béret en tweed – comme quoi, la mode vintage ne date pas d’hier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vintage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc9f40f6-42b3-319a-b448-ad6d54282682",
                                        "entry_id": "dd3ee066-616b-3f27-b55b-d8f399ad21ef",
                                        "glosses": [
                                            "Ensemble de produits conformes à une mode surannée."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64d7b9d8-d5ec-4b10-a891-a1a7d5021018",
                                                "sense_id": "dc9f40f6-42b3-319a-b448-ad6d54282682",
                                                "text": "Repaire d’antiquaires, de magasins de déco et vintage, New York est aussi un lieu de prédilection pour les férus de marchés aux puces. Vous en trouverez à Manhattan bien sûr, mais aussi à Brooklyn : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
