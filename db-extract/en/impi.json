                        "examples": [
                            {
                                "example_id": "37428f51-f50f-4b05-8f8a-d34d63a94c2a",
                                "sense_id": "0b98487a-cd67-3930-bc82-265cb78b9363",
                                "text": "And in the end he, as well as three of his four children, shared Retief's fate in the massacre of Trekkers by the Zulu impis of Dingane."
                            },
                            {
                                "example_id": "5661165d-8a27-4762-85e9-b1b7611db0fe",
                                "sense_id": "0b98487a-cd67-3930-bc82-265cb78b9363",
                                "text": "But as grizzled as Chief Joyi often seemed, the decades fell off him when he spoke of the impis, or warriors, in the army of King Ngangelizwe."
                            }
                        ]
