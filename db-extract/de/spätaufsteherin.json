                "senses": [
                    {
                        "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                        "entry_id": "eb043884-3e4b-3f10-af50-c647ee4a56be",
                        "glosses": [
                            "Frau, die gewohnheitsmäßig später als üblich aufsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5695cd-0fca-4a4f-875a-d4424704e2f7",
                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                "text": "„Unsere Spätaufsteherin Christina ist am Güdisdienstag 2019 zu Krampus gestossen.“"
                            },
                            {
                                "example_id": "89ccd54f-efb0-443d-b9f3-e6c9fc3f4461",
                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                "text": "„Sie ist eher eine Spätaufsteherin und dreht erst ab ca. 23 Uhr ihre Runden durchs Gehege.“"
                            },
                            {
                                "example_id": "2c4e5d3f-13df-46e1-a28f-fef6639de401",
                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                "text": "Die Sendung läuft aber am Samstag Morgen und ich finde, das auch SpätaufsteherInnen [sic] diese fantastische Songs hören sollten.“"
                            },
                            {
                                "example_id": "ee83516c-b078-4c38-9e94-d5a42f93e826",
                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                "text": "„Bei der Untersuchung der University of Bristol wurde festgestellt, dass früh aufstehende Frauen im Vergleich zu Spätaufsteherinnen seltener Brustkrebs entwickeln.“"
                            },
                            {
                                "example_id": "1328be6b-6720-4944-bfb1-ba7217786db4",
                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                "text": "„Ich bin eine Spätaufsteherin, und nur selten gelingt es mir, einen Blick auf den Sonnenaufgang zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
