                                                "sense_id": "7fdab6c0-6ced-3654-bf2d-2f426fa03220",
                                                "text": "Sie pflegt einen eher konfrontativen Führungsstil."
                                            },
                                            {
                                                "example_id": "e87f6603-a170-47e0-8ea0-b18ad768c74a",
                                                "sense_id": "7fdab6c0-6ced-3654-bf2d-2f426fa03220",
                                                "text": "Bei dem Familientreffen soll James sich etwas mäßigen und nicht so konfrontativ auftreten."
                                            },
                                            {
                                                "example_id": "b3be4801-bd9e-4cc6-8de9-08e5d5f61850",
                                                "sense_id": "7fdab6c0-6ced-3654-bf2d-2f426fa03220",
                                                "text": "Reinhard hat einen konfrontativen Charakter und provoziert damit oft Reibereien."
                                            },
                                            {
                                                "example_id": "14e7f292-5682-4f03-8a83-9cef5552cdd4",
                                                "sense_id": "7fdab6c0-6ced-3654-bf2d-2f426fa03220",
                                                "text": "Mit einer konfrontativen Herangehensweise werden wir hier nicht weiterkommen."
                                            }
