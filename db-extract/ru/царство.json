                    {
                        "translation_id": "2a4fec25-45b2-44ee-8af5-1e31a96c9c05",
                        "source_entry_id": "41c567e1-3bc4-3368-adaf-a9efff8fb195",
                        "source_sense_description": "биологический таксон",
                        "target_lang_word": "kingdom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kingdom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44b1dee4-5861-3392-8bea-f5169360dd09",
                                        "entry_id": "e2109eff-2398-3bf9-8cab-8674e7b88092",
                                        "glosses": [
                                            "A realm having a king or queen as its actual or nominal sovereign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "390d3c25-657b-414c-a76e-67fcb5124380",
                                                "sense_id": "44b1dee4-5861-3392-8bea-f5169360dd09",
                                                "text": "In 1924 the Hashemite King Hussein was driven out of the Hedjaz by Ibn Saud, and a state of war sprang up between the new kingdoms of Saudi Arabia and Trans-Jordan."
                                            },
                                            {
                                                "example_id": "eb9aa407-7fee-4115-b9df-9616697d168f",
                                                "sense_id": "44b1dee4-5861-3392-8bea-f5169360dd09",
                                                "text": "A few other key remappings occur when you use the United Kingdom country..."
                                            },
                                            {
                                                "example_id": "2f933a49-f4ea-45f0-9b13-fd0a0db2e5a2",
                                                "sense_id": "44b1dee4-5861-3392-8bea-f5169360dd09",
                                                "text": "‘Lucknow is not a village. It is a city with a thousand years of civilization. It was the capital of the Awadh kingdom.ʼ"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "745bf5be-d5a1-354f-a873-3ffbb8706b42",
                                        "entry_id": "e2109eff-2398-3bf9-8cab-8674e7b88092",
                                        "glosses": [
                                            "A realm, region, or conceptual space where something is dominant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8f72e5-5f42-4182-9394-761100359108",
                                                "sense_id": "745bf5be-d5a1-354f-a873-3ffbb8706b42",
                                                "text": "the kingdom of thought"
                                            },
                                            {
                                                "example_id": "24ef2a47-c94b-46b9-a480-fe4727166ac5",
                                                "sense_id": "745bf5be-d5a1-354f-a873-3ffbb8706b42",
                                                "text": "the kingdom of the dead"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b5b041-e0e3-306e-9cc9-44378430cf85",
                                        "entry_id": "e2109eff-2398-3bf9-8cab-8674e7b88092",
                                        "glosses": [
                                            "A rank in the classification of organisms, below domain and above phylum; a taxon at that rank (e.g. the plant kingdom, the animal kingdom)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e938c4-91e8-4683-aa1e-fbc74c747e4e",
                                                "sense_id": "f9b5b041-e0e3-306e-9cc9-44378430cf85",
                                                "text": "The Organized and inorganized kingdoms are distinguished from each other by peculiarities of chemical composition, of form and structure, and of actions or functions."
                                            },
                                            {
                                                "example_id": "763f4602-2388-431d-9721-161648070060",
                                                "sense_id": "f9b5b041-e0e3-306e-9cc9-44378430cf85",
                                                "text": "It has micobiont from Ascomycota and Basidiomycota belonging to kingdom Fungi and photobiont from Trebouxia species."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
