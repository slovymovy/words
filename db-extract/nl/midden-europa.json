                        "source_sense_id": "221f11c0-144e-3a5f-a9a3-a7d108a773a9",
                        "target_lang_word": "Mitteleuropa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitteleuropa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                        "entry_id": "32e61c30-412a-3d1c-900b-cf68110b9849",
                                        "glosses": [
                                            "unscharf abgegrenzte Region, Naturraum und Kulturraum in Europa, der zwischen Westeuropa, Osteuropa, Südosteuropa, Südeuropa und Nordeuropa liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2265342-cd5b-4647-bdfc-43ef65009387",
                                                "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                                "text": "Mitteleuropa hat ein gemäßigtes Klima."
                                            },
                                            {
                                                "example_id": "f385f276-fbe8-4940-b6f6-4f2497b1532f",
                                                "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                                "text": "Das durch Versailles geschaffene Machtgleichgewicht würde so lange bestehenbleiben, wie Deutschland niedergehalten werden könnte – das wußten die Mächte des östlichen Mitteleuropa 1919 und 1920 sehr wohl, und daraus erklärt sich schließlich ihre auf den ersten Blick überraschende Fügsamkeit gegenüber den Alliierten."
                                            },
                                            {
                                                "example_id": "38e289eb-af3c-4fe0-99e0-c6df7be1fe21",
                                                "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                                "text": "„Das war das erste Kaffeehaus Wiens und ganz Mitteleuropas.“"
                                            },
                                            {
                                                "example_id": "c2c7f1b1-4b4a-4d71-9274-7c58efb4664c",
                                                "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                                "text": "„Für Undset und andere Forscher begann die Eisenzeit in Mitteleuropa mit der sogenannten Hallstatt-Kultur, benannt nach einem Ort im österreichischen Salzkammergut.“"
                                            },
                                            {
                                                "example_id": "506f1526-b2ee-4446-bca5-9a3cbeb023ac",
                                                "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                                "text": "„Für Reisen gen Osten wird beispielsweise Brindisi zum Hafen von Mitteleuropa.“"
                                            },
                                            {
                                                "example_id": "6a974499-f288-4042-abda-c087f427855d",
                                                "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                                "text": "„Neben die Gebirgsbildungen tritt ein weiteres wichtiges geologisches Ereignis, das Eiszeitalter, in dem Nordeuropa mehrfach von einer mächtigen Inlandeisdecke überdeckt war, die sich bis nach England, nach Mitteleuropa und in das Osteuropäische Flachland hinein erstreckte.“"
                                            },
                                            {
                                                "example_id": "74db94b7-b4cb-4844-9c80-ecdd7722fe92",
                                                "sense_id": "c0b035bb-f07f-35ba-906f-c5fd9f88d9c2",
                                                "text": "„Während der großen Kaltphase, dem glazialen Maximum, war der größte Teil Nord- und Mitteleuropas vereist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
