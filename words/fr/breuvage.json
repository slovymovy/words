                    "frequency": "Middle",
                    "semantic_group_id": "boisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue marche dans le froid, ce thé chaud est un <w>breuvage</w> réconfortant."
                        },
                        {
                            "text": "L'aubergiste servait à ses invités un <w>breuvage</w> délicieux préparé avec des fruits du verger."
                        }
                    ],
                    "synonyms": [
                        "boisson"
                    ],
                    "common_phrases": [
