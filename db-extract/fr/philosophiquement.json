        "fr-extract.jsonl": [
            {
                "entry_id": "bac7a7ce-3876-3fbd-adfe-3dade2c6e003",
                "word": "philosophiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ba03b0c-3fd8-3917-b733-f8628162ad2f",
                        "entry_id": "bac7a7ce-3876-3fbd-adfe-3dade2c6e003",
                        "glosses": [
                            "D'une manière philosophique ou en philosophe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f21ba5f-09c5-475f-b260-3ca5698535e2",
                                "sense_id": "4ba03b0c-3fd8-3917-b733-f8628162ad2f",
                                "text": "Ainsi, Charles, quoique jeune (à peine avait-il trente ans), s'était déjà philosophiquement accoutumé à voir des idées, des résultats, des moyens, là où les hommes de son âge aperçoivent des sentiments, des plaisirs et des illusions."
                            }
                        ]
                    },
                    {
                        "sense_id": "00de08fa-50a3-3bea-baa8-dd3125d0163b",
                        "entry_id": "bac7a7ce-3876-3fbd-adfe-3dade2c6e003",
                        "glosses": [
                            "Dans une attitude de sage résignation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "de84c0f6-2296-4322-b1c4-8b405d1965d7",
                                "sense_id": "00de08fa-50a3-3bea-baa8-dd3125d0163b",
                                "text": "La voyageuse avait fait cette dernière réflexion d'un ton qui prouvait qu'elle se résignait à son sort beaucoup plus philosophiquement qu'on ne l'aurait supposé."
                            },
                            {
                                "example_id": "7ab2de84-75b8-4b4f-8976-264d9d0c01e1",
                                "sense_id": "00de08fa-50a3-3bea-baa8-dd3125d0163b",
                                "text": "Pauvre Cornejo, dit-il en se bourrant philosophiquement le nez de tabac, cela devait lui arriver un jour ou l’autre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
