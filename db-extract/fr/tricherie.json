                ],
                "senses": [
                    {
                        "sense_id": "13f38e4b-2ce9-3cde-9f16-58ab218d42d8",
                        "entry_id": "7aa8b388-6798-3154-8007-052068428f0b",
                        "glosses": [
                            "Action de tricher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "491d75b6-1303-4aa8-b0ae-c06df959ad23",
                                "sense_id": "13f38e4b-2ce9-3cde-9f16-58ab218d42d8",
                                "text": "Il s’agit d’une méthode qui se corrige, se rectifie, s’auto-critique, puis localise des tricheries, pour les “défalsifier”, (les corriger), puis les excéder."
                            },
                            {
                                "example_id": "7579e229-ccc8-45bd-a6e6-25642f75c5d6",
                                "sense_id": "13f38e4b-2ce9-3cde-9f16-58ab218d42d8",
                                "text": "Certes Don Juan est un tricheur, et même il ne vit que de cela […]. Mais une tricherie constante est moins dangereuse que les faiblesses subites d'un honnête homme."
                            },
                            {
                                "example_id": "684d9a04-30f1-4f62-b9d3-4b355ca00530",
                                "sense_id": "13f38e4b-2ce9-3cde-9f16-58ab218d42d8",
                                "text": "Plus de nos jours… Ne rien cacher tout étaler… Nous c’est l’ère du bikinisme, de l’àpoilisme. Ni dissimulation ni tricherie, tout sur les antennes, les écrans et les ondes, capté par les populations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa7d0d98-582c-4f0b-914a-e6c00ecf4e9a",
                        "source_entry_id": "7aa8b388-6798-3154-8007-052068428f0b",
                        "source_sense_id": "13f38e4b-2ce9-3cde-9f16-58ab218d42d8",
                        "target_lang_word": "Betrug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                        "entry_id": "3dbab1d0-60d8-3bce-99e1-326d4cff70d9",
                                        "glosses": [
                                            "vorsätzliche Täuschung und Irreführung einer anderen Person; Täuschungshandlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c11ac65-be42-4be5-860e-57eb6b9a4a31",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "Der Betrug ist offensichtlich."
                                            },
                                            {
                                                "example_id": "81236fd4-11b1-43f7-8748-0cf90be81984",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "Er ist nur auf Betrug aus."
                                            },
                                            {
                                                "example_id": "3ad38858-2716-46d7-8b33-cfef316e651c",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "„Mary würde einen anderen Weg finden müssen, um den von ihm begangenen Betrug zu verbergen.“"
                                            },
                                            {
                                                "example_id": "665cdf9c-be3b-40d0-a836-cb4cc79c5806",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "„Trotz allem Esprit der Franzosen ist und bleibt Paris immer die Stadt, wo sich Betrug lohnt.“"
                                            },
                                            {
                                                "example_id": "a869aef2-0f65-490c-b174-1a3ad7e9ca27",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "„Zur Verhandlung kommt der zweite Betrug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
