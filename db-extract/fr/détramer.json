                        "entry_id": "9ecd68c6-93ec-3add-a81a-375f19b1d979",
                        "glosses": [
                            "Corriger l’effet indésirable produit sur (une image, un document) lié à sa numérisation, et qui produit une sorte de quadrillage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f34ae25-28aa-4b4a-9775-8f4506f11319",
                                "sense_id": "a6b70191-d99b-3d9e-be08-6cc526601e6a",
                                "text": "La fonction Détramage du pilote du scanner est donc très intéressante, car elle permet de détramer une photo lors de la numérisation."
                            },
                            {
                                "example_id": "1d5a8000-e3ed-4249-8a8e-9e8452f9d9de",
                                "sense_id": "a6b70191-d99b-3d9e-be08-6cc526601e6a",
                                "text": "Le filtrage passe-bas permet de détramer l’image."
                            }
                        ]
                    },
