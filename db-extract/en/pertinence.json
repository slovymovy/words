                                                "sense_id": "b580aedc-4ac8-3bb9-b36c-99483dc80ad7",
                                                "text": "Das ist nicht von großer Wichtigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "698373ae-4a4e-3447-98ac-c01f3b05f665",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
                                            "eine wichtige, bedeutsame Sache"
