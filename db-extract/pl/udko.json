                ],
                "senses": [
                    {
                        "sense_id": "d0523414-bf25-3d80-93ee-ced70ab7f92b",
                        "entry_id": "e57c9706-7c71-3350-a37b-8a54a61e49ae",
                        "glosses": [
                            "od: udo"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "be7805f3-50e4-4b74-b2f8-f27dd4c14c60",
                                "sense_id": "d0523414-bf25-3d80-93ee-ced70ab7f92b",
                                "text": "Wczoraj na obiad zrobiłam udka w sosie śmietanowym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "107b5849-f456-3a11-a53f-f311087755b1",
                        "entry_id": "e57c9706-7c71-3350-a37b-8a54a61e49ae",
                        "glosses": [
                            "nóżka drobiu, ptactwa lub małych zwierząt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c38514b-1f40-4786-a257-2c291f78f5c2",
                        "source_entry_id": "e57c9706-7c71-3350-a37b-8a54a61e49ae",
                        "source_sense_id": "107b5849-f456-3a11-a53f-f311087755b1",
                        "target_lang_word": "Schenkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schenkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4dc338-328b-360c-9ce7-ce934420f063",
                                        "entry_id": "982d8bd4-a000-3030-a468-c718cb0ea4a4",
                                        "glosses": [
                                            "ein Bereich der unteren Extremitäten (siehe: Ober- bzw. Unterschenkel beim Menschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbf323f-b62a-489b-8b1f-825278e2e618",
                                                "sense_id": "3e4dc338-328b-360c-9ce7-ce934420f063",
                                                "text": "„Mein Spitzbart war naß, Brillengläser angelaufen, Froschaugen entzündet, hatte rote Flecken in den Achselhöhlen und zwischen den Schenkeln, wußte das, obwohl ich das Rot nicht sehen konnte.“"
                                            },
                                            {
                                                "example_id": "2f40306d-a9fc-4ff9-aa04-1601178d1e3f",
                                                "sense_id": "3e4dc338-328b-360c-9ce7-ce934420f063",
                                                "text": "Er hat sich seine behaarten Schenkel rasiert."
                                            },
                                            {
                                                "example_id": "d2a7b639-b481-4fbe-9d96-a0e270919ff8",
                                                "sense_id": "3e4dc338-328b-360c-9ce7-ce934420f063",
                                                "text": "„Sie schlug sich dabei mit einem feuchten Küchentuch auf die Schenkel und kniff die Augen zu.“"
                                            },
                                            {
                                                "example_id": "d5655b92-1770-4876-8309-f3e9f4f20f3e",
                                                "sense_id": "3e4dc338-328b-360c-9ce7-ce934420f063",
                                                "text": "„Sie drückte ihren Schenkel an mich und hatte ungefähr zehn Kilo Übergewicht.“"
                                            },
                                            {
                                                "example_id": "86fbea9d-6aa7-4256-827c-93d6bbdba95c",
                                                "sense_id": "3e4dc338-328b-360c-9ce7-ce934420f063",
                                                "text": "„Sie zeigten sich den Anderen gegenseitig, wiesen mit ihren Fingern auf ihn und schlugen sich dann wieder auf die Schenkel vor Lachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41ced5f0-13a7-35f8-b8a2-493a8476bf7c",
                                        "entry_id": "982d8bd4-a000-3030-a468-c718cb0ea4a4",
                                        "glosses": [
                                            "ein Teil des Beines von Tieren, der oft auch dem Verzehr dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c59e4386-fea8-469d-8b1f-bf630d579d6d",
                                                "sense_id": "41ced5f0-13a7-35f8-b8a2-493a8476bf7c",
                                                "text": "Neben dem Brustfilet werden vom Huhn hauptsächlich die Schenkel verzehrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b9ef9d38-0fc7-31bd-8b07-391db1e9cdc5",
                                        "entry_id": "982d8bd4-a000-3030-a468-c718cb0ea4a4",
                                        "glosses": [
                                            "Zwei Geraden mit einem gemeinsamen Basispunkt (siehe auch: Dreieck)"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a131c3e6-8f13-4c04-ad88-273af64d9056",
                                                "sense_id": "b9ef9d38-0fc7-31bd-8b07-391db1e9cdc5",
                                                "text": "Bei einen gleichschenkligen Dreieck sind beide Schenkel gleich lang."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3ef10a95-8c2f-3e3d-a9e1-ac589728e7a5",
                                        "entry_id": "982d8bd4-a000-3030-a468-c718cb0ea4a4",
                                        "glosses": [
                                            "jeweils einer von zwei gleichen länglichen Bauteilen, die sich in einem Punkt treffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37d00fd-13d1-43f9-8425-44be01419875",
                                                "sense_id": "3ef10a95-8c2f-3e3d-a9e1-ac589728e7a5",
                                                "text": "Durch das Klopfen geraten die Schenkel der Stimmgabel in Schwingung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1ea3e83a-e439-3605-88cf-626c66f93c73",
                                        "entry_id": "982d8bd4-a000-3030-a468-c718cb0ea4a4",
                                        "glosses": [
                                            "älterer Seitentrieb der Weinrebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b43658-e5da-4032-baca-00f2e7d16913",
                                                "sense_id": "1ea3e83a-e439-3605-88cf-626c66f93c73",
                                                "text": "Die Schenkel verbleiben beim Rückschnitt am Stock."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
