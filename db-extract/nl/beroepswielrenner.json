                "senses": [
                    {
                        "sense_id": "9ec20ad9-ec0c-37bc-a577-0f21744686b4",
                        "entry_id": "8e669ab4-15f8-3d56-a926-378aa2c0a738",
                        "glosses": [
                            "iemand die geld verdient door als wielrenner mee te doen aan wedstrijden"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "0ca61200-fb18-4952-a89e-57e15b789f66",
                                "sense_id": "9ec20ad9-ec0c-37bc-a577-0f21744686b4",
                                "text": "\"In het kader van de talentontwikkeling die Lotto-Jumbo voorstaat, wordt Tolhoek en Eenkhoorn de hand gereikt om zich te ontplooien tot een voorbeeldig beroepswielrenner.\""
                            },
                            {
                                "example_id": "bc00245a-5d1c-44ac-827d-ef7c17a88991",
                                "sense_id": "9ec20ad9-ec0c-37bc-a577-0f21744686b4",
                                "text": "\"Ik was beroepswielrenner in een heel moeilijke tijd\", vertelt Kroon, \"en ik heb enorm veel respect voor mijn collega's die destijds de verleiding hebben weten te weerstaan om doping te gebruiken. Gelukkig is de sport sindsdien enorm veranderd.\""
                            },
                            {
                                "example_id": "8c29eb83-1e34-4230-88df-235ccd715dbc",
                                "sense_id": "9ec20ad9-ec0c-37bc-a577-0f21744686b4",
                                "text": "\"Ik besef ook dat dit m'n sterkste jaren zijn en dat het een goede kans is om het eens anders te doen. Het is mijn tiende jaar als beroepswielrenner en je zoekt altijd motivatie in wat je wilt bereiken. Dat heb ik daarin (een ritzege in de Tour en deelname aan de Spelen, red.) wel gevonden.\""
                            }
                        ]
                    }
