                        ],
                        "examples": [
                            {
                                "example_id": "acccf18b-04af-465b-a19c-502e11cfee8d",
                                "sense_id": "e486bcf2-212a-36a8-8785-73d2aaf07126",
                                "text": "„Er verbeugte sich sarkastisch. ›Verzeihung an die heilige Jungfrau, die dahinten mit Taubenscheiße auf dem Kopf am Straßenrand sitzt.‹“"
                            },
                            {
                                "example_id": "b14a2d1a-a38c-4951-a3e0-4ab8bf76b7df",
                                "sense_id": "e486bcf2-212a-36a8-8785-73d2aaf07126",
                                "text": "„Die ersten beiden Boxen waren bis auf Taubenscheiße und menschliche Exkremente verwaist, aber in der dritten befand sich eine kleine ausgemergelte Gestalt, die sich in die hinterste Ecke des vollgestopften Schlupflochs drückte.“"
                            }
                        ],
