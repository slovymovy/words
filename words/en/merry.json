    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5fbc767-c753-3d79-9361-e81bc2702374",
                    "sense_definition": "Cheerful, jolly, and full of high spirits.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "happiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We wish you a <w>merry</w> Christmas and a happy new year.",
                            "target_lang_translations": {
                                "ru": "Мы желаем вам <w>счастливого</w> Рождества и счастливого Нового года.",
                                "zh": "祝你圣诞<w>愉快</w>，新年快乐。"
                            }
                        },
                        {
                            "text": "The children were in a <w>merry</w> mood after receiving their gifts.",
                            "target_lang_translations": {
                                "ru": "Дети были в <w>весёлом</w> настроении после того, как получили подарки.",
                                "zh": "孩子们收到礼物后心情非常<w>愉快</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "happy",
                        "jovial",
                        "joyful"
                    ],
                    "antonyms": [
                        "miserable",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "merry Christmas",
                        "merry mood"
                    ],
                    "target_lang_definitions": {
