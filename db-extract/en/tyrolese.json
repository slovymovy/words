                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrolien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0255598-316d-38b1-ba87-e3cdf3333a7a",
                                        "entry_id": "cb1876f6-63dc-3e5f-859e-c26002b72b4c",
                                        "glosses": [
                                            "Relatif au Tyrol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c81bfa6-7671-4118-912e-ab93fd2ee7a3",
                                                "sense_id": "f0255598-316d-38b1-ba87-e3cdf3333a7a",
                                                "text": "Sa petite tête fine et brune, émergeant des fourrures, était coiffée d’un chapeau tyrolien en feutre gris, de jeune garçon. Les bords en étaient rabattus très bas sur le front."
                                            },
                                            {
                                                "example_id": "7dfd9049-48ec-4c2b-b1eb-99b705a74954",
                                                "sense_id": "f0255598-316d-38b1-ba87-e3cdf3333a7a",
                                                "text": "Nizan se spécialisait dans les portraits de Leibniz, qu’il représentait volontiers en curé, ou coiffé d’un chapeau tyrolien, et portant au derrière la marque du pied de Spinoza."
                                            },
                                            {
                                                "example_id": "4f483899-529d-4d44-aefe-0f238cbd9ace",
                                                "sense_id": "f0255598-316d-38b1-ba87-e3cdf3333a7a",
                                                "text": "Il portait un imperméable et un vieux chapeau tyrolien, piqué d'une plume d'un jaune roussi."
                                            },
                                            {
                                                "example_id": "28920b61-4378-41fb-9455-453854a4e398",
                                                "sense_id": "f0255598-316d-38b1-ba87-e3cdf3333a7a",
                                                "text": "Selon son président, Josef Hechenberger, remplacer « l’authentique lait tyrolien par du lait d’avoine » importé pour vanter les attraits des montagnes est « inacceptable »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a91c87-653d-4ddf-a5c4-e581f7ab1449",
                        "source_entry_id": "fe6cc038-ff5a-3d2c-9bd7-a102df09e063",
                        "source_sense_description": "of or relating to Tyrol",
                        "target_lang_word": "tirolerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tirolerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dac0f304-423b-39aa-918a-8dd6a493a738",
                                        "entry_id": "4a4bcbd0-ef1c-35bc-9b37-542433c3fcb7",
                                        "glosses": [
                                            "Tirol oder die Tiroler betreffend; aus Tirol oder von den Tirolern stammend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcdc03d5-00be-4c8f-99c2-0096cb746b48",
                                                "sense_id": "dac0f304-423b-39aa-918a-8dd6a493a738",
                                                "text": "Dazu reihen sich gute Innenausstattung, schöne Aussicht auf die umliegende Bergwelt und typisch tirolerische Umgebung."
                                            },
                                            {
                                                "example_id": "ec4606c9-6961-4ce2-9139-7e74fd886c49",
                                                "sense_id": "dac0f304-423b-39aa-918a-8dd6a493a738",
                                                "text": "Mitterer (lacht): Das ist der keltisch-tirolerische Schädel, der kann nicht anders."
                                            },
                                            {
                                                "example_id": "e767d93d-5034-4172-9029-a044ccc3d8c3",
                                                "sense_id": "dac0f304-423b-39aa-918a-8dd6a493a738",
                                                "text": "Jung-Chef und Mit-Inhaber August Penz sieht ein bisschen aus wie Nicolas Cage, aber er redet tirolerisch."
                                            },
                                            {
                                                "example_id": "fc6630ab-f356-4366-8f59-af5731cfd873",
                                                "sense_id": "dac0f304-423b-39aa-918a-8dd6a493a738",
                                                "text": "Hier ganz im Osten, nahe am Vintschgau und auch von Österreich nicht weit ab, wirkt die Landschaft tirolerisch."
                                            },
                                            {
                                                "example_id": "6db0408f-91db-4447-9ab0-725a913ef5fd",
                                                "sense_id": "dac0f304-423b-39aa-918a-8dd6a493a738",
                                                "text": "In der einzigen Grundschule des Tals beherrschen von 33 Kindern nur noch zehn die Sprache, die im Spätmittelalter von bayerischen und tirolerischen Siedlern und Bergknappen hergebracht wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
