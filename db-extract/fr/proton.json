                                    {
                                        "sense_id": "87944f8c-7a24-3888-b217-417990026ff9",
                                        "entry_id": "fe91ccb0-76d6-3d70-8708-14f2c467b357",
                                        "glosses": [
                                            "einfach positiv geladenes Nukleon (ein Baustein des Atomkerns), bestehend aus einem Down- und zwei Up-Quarks"
                                        ],
