                ],
                "senses": [
                    {
                        "sense_id": "eb47d38c-907d-336f-8aee-0dcca37356d6",
                        "entry_id": "51754d36-963d-3a36-839e-640f3b909972",
                        "glosses": [
                            "Kavent; Bürge, Gewährsmann"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ff69d8a-c9b5-31f7-a9b1-b57a62285fda",
                        "entry_id": "51754d36-963d-3a36-839e-640f3b909972",
                        "glosses": [
                            "besonders großes Objekt; herausragendes Exemplar einer bestimmten Art"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d7d4b536-4627-49a5-88b2-47a0f7930096",
                                "sense_id": "5ff69d8a-c9b5-31f7-a9b1-b57a62285fda",
                                "text": "„Denn dieser klingende Kaventsmann, bis vor einigen Jahren die weltweit größte frei schwingende Glocke, rüttelt wohl sogar noch in einem schwerhörigen Agnostiker spirituelle Empfindungen wach.“"
                            },
                            {
                                "example_id": "13310cb3-f8d7-4cfc-b28f-ba4f8f0456b2",
                                "sense_id": "5ff69d8a-c9b5-31f7-a9b1-b57a62285fda",
                                "text": "„Das Ding war ein Kaventsmann von einigen Kilo Gewicht, und ich hatte es den ganzen Abend auf dem Schoß.“"
                            },
                            {
                                "example_id": "aa7351c9-1189-42c5-bcf9-2ec3ea5706f4",
                                "sense_id": "5ff69d8a-c9b5-31f7-a9b1-b57a62285fda",
                                "text": "„Die spanischen Brötchen waren Kaventsmänner, doppelt so groß wie die deutschen und nur halb so teuer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0c01ba1a-f528-37da-8232-7db9cf6f3a1f",
                        "entry_id": "51754d36-963d-3a36-839e-640f3b909972",
                        "glosses": [
                            "besonders hohe Welle"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "9a81f72d-999a-4b62-976e-5ff4702b070b",
                                "sense_id": "0c01ba1a-f528-37da-8232-7db9cf6f3a1f",
                                "text": "Bis ca. 1993, als es zum ersten Mal gelang, einen Kaventsmann zu fotografieren, wurden Berichte über solche Riesenwellen als reines Seemannsgarn abgetan."
                            },
                            {
                                "example_id": "d560a631-8586-4e7c-a3f3-97a9df48a094",
                                "sense_id": "0c01ba1a-f528-37da-8232-7db9cf6f3a1f",
                                "text": "„Fasziniert starre ich auf den nächsten Kaventsmann und die riesigen Wellenberge, die ihm folgen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d24263b8-19c6-441f-a163-70e9d42d4455",
                        "source_entry_id": "51754d36-963d-3a36-839e-640f3b909972",
                        "source_sense_id": "5ff69d8a-c9b5-31f7-a9b1-b57a62285fda",
                        "source_sense_description": "umgangssprachlich: besonders großes Objekt",
                        "target_lang_word": "толстя́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "толстя́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "94d5e97c-ebf4-3dc2-ba2f-91fccbd13398",
                                        "entry_id": "a38f2149-acb6-3707-b647-6e391a6f38b9",
                                        "glosses": [
                                            "разг. толстый, полный мужчина, юноша или мальчик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ca8dea3-0ea3-4005-854d-444e88b97d5c",
                                                "sense_id": "94d5e97c-ebf4-3dc2-ba2f-91fccbd13398",
                                                "text": ".. даже единственный тихоня в классе (какой бывает в каждом классе, как бывает непременно толстяк, силач, остряк) сторонился его [Лужина] .."
                                            },
                                            {
                                                "example_id": "9f1dc114-fb34-4432-a017-b47a1aa18214",
                                                "sense_id": "94d5e97c-ebf4-3dc2-ba2f-91fccbd13398",
                                                "text": "Следом за Антоном полез грузный толстяк Жорик, по кличке Морж, и тоже прошаркал по граниту, не отрывая подошв и сгорбившись, как обезьяна, но когда спрыгнул на асфальт, ноги его подломились и он упал на колени."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45e384a9-c35f-40e9-afe8-20544927e1ae",
                        "source_entry_id": "51754d36-963d-3a36-839e-640f3b909972",
                        "source_sense_id": "0c01ba1a-f528-37da-8232-7db9cf6f3a1f",
                        "source_sense_description": "Seemannssprache: besonders hohe Welle",
                        "target_lang_word": "rogue wave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rogue wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4d6d65-8ff3-3b93-9e7a-0d10a0d89cc6",
                                        "entry_id": "09516bfd-2be4-31bc-99ad-cea615cc3520",
                                        "glosses": [
                                            "An unexpected, dangerously large wave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e16b6d7-3815-4d52-b4ef-32a2fc3e6f82",
                                                "sense_id": "0d4d6d65-8ff3-3b93-9e7a-0d10a0d89cc6",
                                                "text": "Then one giant crest spills green water over the bow and stops our 100-ton vehicle as though it had ploughed into a gargantuan hay bale. . . . The rogue wave our experimental 78-foot craft hit must have been well over 10 feet high."
                                            },
                                            {
                                                "example_id": "ee75e2ad-682c-45b2-9831-089e43ce446f",
                                                "sense_id": "0d4d6d65-8ff3-3b93-9e7a-0d10a0d89cc6",
                                                "text": "One of her owners, Mark Litchfield, was quoted by United Press International as saying a “rogue wave” might have knocked the ship over."
                                            },
                                            {
                                                "example_id": "e0e3ac2a-632d-4181-bae0-baec12425e75",
                                                "sense_id": "0d4d6d65-8ff3-3b93-9e7a-0d10a0d89cc6",
                                                "text": "Scientists still don't know exactly how rogue waves occur, nor do they know how to predict them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "670c9179-b6dc-4cf9-a3d7-fc43e6eae4a3",
                        "source_entry_id": "51754d36-963d-3a36-839e-640f3b909972",
