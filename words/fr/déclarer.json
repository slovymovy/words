{
    "word_family": [
        "déclaration",
        "déclaratif",
        "déclarant",
        "déclaratoire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4091a91b-c001-3680-97fb-f4295df63846",
                    "sense_definition": "Faire connaître ouvertement et explicitement ce que l'on pense, sait ou décide.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le porte-parole a <w>déclaré</w> que les négociations se poursuivraient toute la nuit."
                        },
                        {
                            "text": "L'équipe adverse a décidé de <w>déclarer</w> forfait en raison de nombreuses blessures."
                        }
                    ],
                    "synonyms": [
                        "annoncer",
                        "affirmer",
                        "proclamer"
                    ],
                    "antonyms": [
                        "taire",
                        "cacher",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "déclarer forfait",
                        "déclarer la guerre"
                    ]
                },
                {
                    "sense_id": "5cc17443-97e1-3b58-a458-f91ccdca69cb",
                    "sense_definition": "Faire constater officiellement auprès d'une autorité légale ou administrative.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique_administratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de <w>déclarer</w> vos revenus avant la date limite fixée par la loi."
                        },
                        {
                            "text": "Vous devez <w>déclarer</w> la naissance de votre enfant à la mairie dans les cinq jours."
                        }
                    ],
                    "synonyms": [
                        "notifier",
                        "signaler"
                    ],
                    "common_phrases": [
                        "déclarer ses impôts",
                        "déclarer un sinistre"
                    ]
                },
                {
                    "sense_id": "7aff5c69-1ef0-34e9-9504-fd234ac20023",
                    "sense_definition": "Commencer à se manifester, éclater ou se propager soudainement en parlant d'un événement fâcheux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un incendie dévastateur s'est <w>déclaré</w> dans l'immeuble voisin au milieu de la nuit."
                        },
                        {
                            "text": "Plusieurs cas de grippe ont commencé à se <w>déclarer</w> dans cette école maternelle."
                        }
                    ],
                    "synonyms": [
                        "éclater",
                        "survenir",
                        "apparaître"
                    ],
                    "antonyms": [
                        "s'éteindre",
                        "cesser"
                    ]
                },
                {
                    "sense_id": "74f4fc0a-76f9-3c62-8dd7-c9d2de6c1984",
                    "sense_definition": "Prendre ouvertement parti pour ou contre quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sénateur s'est <w>déclaré</w> favorable à la mise en œuvre de cette réforme."
                        },
                        {
                            "text": "Aucun candidat n'a encore osé se <w>déclarer</w> contre cette nouvelle proposition."
                        }
                    ],
                    "synonyms": [
                        "se prononcer",
                        "prendre parti"
                    ],
                    "common_phrases": [
                        "se déclarer favorable",
                        "se déclarer candidat"
                    ]
                },
                {
                    "sense_id": "da545f74-80f9-3635-8860-ecdd0ecf21a0",
                    "sense_definition": "Faire l'aveu explicite de ses sentiments d'amour à la personne aimée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "amour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a rassemblé tout son courage pour aller se <w>déclarer</w> à la fin de la soirée."
                        },
                        {
                            "text": "Elle attendait impatiemment qu'il vienne enfin lui <w>déclarer</w> sa flamme."
                        }
                    ],
                    "synonyms": [
                        "avouer ses sentiments"
                    ],
                    "common_phrases": [
                        "déclarer sa flamme",
                        "se déclarer à quelqu'un"
                    ]
                }
            ]
        }
    ]
}