                {
                    "sense_id": "828eddaa-dba3-30fc-ab94-8377fad2dc29",
                    "sense_definition": "voltooid deelwoord van <w>vangen</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vangen_participle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser heeft vanmorgen een grote vis <w>gevangen</w> in het meer.",
                            "target_lang_translations": {
                                "en": "The fisherman <w>caught</w> a large fish in the lake this morning."
                            }
                        },
                        {
                            "text": "De politie heeft de dief eindelijk <w>gevangen</w> na een lange achtervolging.",
                            "target_lang_translations": {
                                "en": "The police finally <w>caught</w> the thief after a long chase."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of the verb 'to catch'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "caught",
                                "target_lang_sense_clarification": "past participle of catch"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46db482e-4c51-3ad8-bc4c-6ff5b27fe9c2",
                    "sense_definition": "in hechtenis genomen of van de vrijheid beroofd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "captive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gevangen</w> soldaten werden na de oorlog weer vrijgelaten.",
                            "target_lang_translations": {
                                "en": "The <w>captive</w> soldiers were released after the war."
                            }
                        },
                        {
                            "text": "De <w>gevangen</w> vogel probeerde wanhopig uit zijn kooitje te ontsnappen.",
                            "target_lang_translations": {
                                "en": "The <w>trapped</w> bird tried desperately to escape from its cage."
                            }
                        }
                    ],
                    "synonyms": [
                        "geboeid",
                        "opgesloten"
                    ],
                    "antonyms": [
                        "vrij"
                    ],
                    "common_phrases": [
                        "gevangen zitten",
                        "gevangen houden"
                    ],
                    "target_lang_definitions": {
                        "en": "taken into custody or deprived of freedom"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "captive",
                                "target_lang_sense_clarification": "held as a prisoner"
                            },
                            {
                                "target_lang_word": "imprisoned",
                                "target_lang_sense_clarification": "kept in a prison"
                            },
                            {
                                "target_lang_word": "trapped",
                                "target_lang_sense_clarification": "unable to escape"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "334c7dd8-b4e0-370c-a1ac-cda2584f4f01",
                    "sense_definition": "gebruikt als deel van een scheidbaar werkwoord om aan te geven dat iemand zijn vrijheid verliest",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "captive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie nam de verdachte direct <w>gevangen</w> op de plaats van het delict.",
                            "target_lang_translations": {
                                "en": "The police took the suspect <w>prisoner</w> immediately at the scene of the crime."
                            }
                        },
                        {
                            "text": "Zij voelde zich <w>gevangen</w> in een ongelukkige relatie waar ze niet uit kon.",
                            "target_lang_translations": {
                                "en": "She felt <w>trapped</w> in an unhappy relationship she couldn't get out of."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gevangen nemen"
                    ],
                    "target_lang_definitions": {
                        "en": "used as part of a separable verb to indicate that someone loses their freedom"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prisoner",
                                "target_lang_sense_clarification": "as in 'to take prisoner'"
                            },
                            {
                                "target_lang_word": "captive",
                                "target_lang_sense_clarification": "as in 'to feel captive'"
                            },
                            {
                                "target_lang_word": "trapped",
                                "target_lang_sense_clarification": "feeling confined by a situation"
                            }
                        ]
                    }
                }
            ]
        },
        {
