                "senses": [
                    {
                        "sense_id": "414f53ea-3b4a-3e7d-890b-1d8332e08595",
                        "entry_id": "04cd1f86-8183-3f53-840e-b7802d4a28ca",
                        "glosses": [
                            "Faire, se faire, une microdémangeaison."
                        ],
                        "tags": [
                            "Terme spécifique à la synergologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ce7bc7a8-b478-44c9-9ddf-fa0ed7149667",
                                "sense_id": "414f53ea-3b4a-3e7d-890b-1d8332e08595",
                                "text": "Si nous considérons qu’il peut aussi bien microdémanger que microcaresser ou s’arrêter sur un membre ou un autre, 282 manières de coder ces gestes sont praticables."
                            },
                            {
                                "example_id": "11069db5-8e2f-448b-9844-ad084567042f",
                                "sense_id": "414f53ea-3b4a-3e7d-890b-1d8332e08595",
                                "text": "Voilà que l’index, que vous n’osez pas lever, craignant de faire montre d’autorité, microdémange."
                            },
                            {
                                "example_id": "55cd583e-c3b3-47c6-b8de-e30c6c7a8c06",
                                "sense_id": "414f53ea-3b4a-3e7d-890b-1d8332e08595",
                                "text": "Je me microdémange la cuisse gauche tout en échangeant avec mon interlocuteur."
                            }
                        ]
                    }
