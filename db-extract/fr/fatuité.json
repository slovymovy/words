        "fr-extract.jsonl": [
            {
                "entry_id": "dd015fb4-d680-3c80-9e0b-a7075b4acd19",
                "word": "fatuité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e0f3bd7e-4ae8-4857-b2b7-64e98d249bdf",
                        "entry_id": "dd015fb4-d680-3c80-9e0b-a7075b4acd19",
                        "tags": [
                            "plural"
                        ],
                        "form": "fatuités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                        "entry_id": "dd015fb4-d680-3c80-9e0b-a7075b4acd19",
                        "glosses": [
                            "Manière de parler et d’agir de celui qui est fat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2700daa5-8f03-4129-a6b2-dfa01847c964",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "Les traits de l’abbé captif et ses manières offraient un mélange fantasque d’orgueil blessé, de fatuité chiffonnée et de terreur évidente."
                            },
                            {
                                "example_id": "6d8a69ec-a044-4eee-8519-f70019750c5a",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "[…], mais La Brière redoutait cette entrevue, et Canalis y marchait avec une confiance pleine de fatuité."
                            },
                            {
                                "example_id": "1309fb69-52e7-437f-b76a-35b6cc171753",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "Parler des services qu’on rend est une fatuité, à mon sens, insupportable ; j’aime encore mieux les gens qui parlent de leurs qualités physiques, de leurs yeux ou de leurs cheveux."
                            },
                            {
                                "example_id": "f98dc14e-1983-4e5a-8fc0-fdf6d3589d92",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "Elle ne le frappait plus, elle ne l’achetait plus, elle le flattait, et l’homme, si abject qu’il puisse être, possède toujours, à un moment de révolte, cette virilité d’une heure qu’on appelle la fatuité."
                            },
                            {
                                "example_id": "68fafa4f-9d0b-4036-880a-d59483b4c4c3",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "Il la regardait avec une confiance qui venait moins de la fatuité commune à tous les amants que d’un besoin de dignité régulière qui était en lui. Il croyait en elle par préjugé d’éducation forte et d’intelligence simple."
                            },
                            {
                                "example_id": "44dda573-90ac-47af-a9ac-86fba0d9ea8b",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "« Après tout, j’ai peut-être mal interprété ce regard ; et n’ai-je pas comme tout le monde ma part de fatuité naturelle ? »"
                            },
                            {
                                "example_id": "aae2ebe4-b876-4a1f-a656-a1642e482f07",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "Lui que j’ai connu si sûr de lui-même, d’une fatuité toute naturelle, conscient de son bon droit, […], le voici devant moi presque timide […], tel un petit garçon qui craint d’être grondé."
                            },
                            {
                                "example_id": "6bbfa038-4b63-4186-8542-c77727b1ed31",
                                "sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                                "text": "Ils avaient des gestes identiques et synchronisés, et sur leurs deux visages flottait une expression de fatuité sensuelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab16d987-080c-41c2-8c1d-def223b16700",
                        "source_entry_id": "dd015fb4-d680-3c80-9e0b-a7075b4acd19",
                        "source_sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
                        "target_lang_word": "Überheblichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überheblichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78cac57e-a018-3132-b9a6-094a73c34467",
                                        "entry_id": "8ccb913f-223a-3739-94e3-b9a07258fa5e",
                                        "glosses": [
                                            "ungerechtfertigte Selbstüberschätzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d5cd1f7-6742-40e1-9497-85108c946f5a",
                                                "sense_id": "78cac57e-a018-3132-b9a6-094a73c34467",
                                                "text": "„Zum Kulturpessimismus besteht ebenso wenig Anlass wie zur Überheblichkeit, was unsere Fortschritte angeht.“"
                                            },
                                            {
                                                "example_id": "00cc4abf-37a7-4b8d-be3a-4466acd1ce89",
                                                "sense_id": "78cac57e-a018-3132-b9a6-094a73c34467",
                                                "text": "„Was sie dabei denkt, weiß kein Mensch - aber sie strahlt eine Selbstsicherheit aus, die schon fast an Überheblichkeit grenzt.“"
                                            },
                                            {
                                                "example_id": "4db9bbfe-d1fa-4212-940a-950aeb51402d",
                                                "sense_id": "78cac57e-a018-3132-b9a6-094a73c34467",
                                                "text": "„Diese Überheblichkeit bei einem Mann, der nichts anderes war als ein ganz gemeiner Dieb, stellte meine Geduld auf eine harte Probe.“"
                                            },
                                            {
                                                "example_id": "6bc5172e-a95c-41a1-b69e-ee2bdfcf6803",
                                                "sense_id": "78cac57e-a018-3132-b9a6-094a73c34467",
                                                "text": "„Nach westlichen Wertmaßstäben liegt die Überheblichkeit der Weißen am mangelnden Erfolg der Afrikaner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc828579-449e-4f63-ac72-d738d19404d3",
                        "source_entry_id": "dd015fb4-d680-3c80-9e0b-a7075b4acd19",
                        "source_sense_id": "28fdc3c9-99fb-35a7-b505-354796da2600",
