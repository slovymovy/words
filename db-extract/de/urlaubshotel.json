                "senses": [
                    {
                        "sense_id": "7fd75e5c-cf5f-34cf-ae22-4062476601b6",
                        "entry_id": "4d1e5d7b-9f47-3f8a-aa99-73bf052e140e",
                        "glosses": [
                            "Hotel, das für die Dauer eines Urlaubs als Unterkunft dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e5a9e37-48d2-4be2-96b8-8cedc246e4ef",
                                "sense_id": "7fd75e5c-cf5f-34cf-ae22-4062476601b6",
                                "text": "„Jeder kennt das Klischee aus dem Urlaubshotel, wo sich Senioren im Swimming Pool zu lauter Musik bei Aqua Fitness abstrampeln.“"
                            },
                            {
                                "example_id": "51465f02-6edb-4625-b1c3-9bd6bb4a121b",
                                "sense_id": "7fd75e5c-cf5f-34cf-ae22-4062476601b6",
                                "text": "„Praktisch alle Anbieter arbeiteten heute bereits mit modernen Shop-Konzepten, in denen modernste Technik eingesetzt werde. Ein Beispiel sind dreidimensionale virtuelle Rundgänge durch das Urlaubshotel.“"
                            },
                            {
                                "example_id": "0959694b-f6ec-4865-aa94-7f175340b11f",
                                "sense_id": "7fd75e5c-cf5f-34cf-ae22-4062476601b6",
                                "text": "„Noch im Laufe dieses Jahres will der Reiseveranstalter TUI per Mausklick das passende Urlaubshotel mit veganen Angeboten präsentieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
