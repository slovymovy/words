                        "glosses": [
                            "Étoiles filantes qui paraissent partir de la constellation de Persée durant une dizaine de jours au mois d’août."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03ba5b08-40d6-4600-9131-fa331c020dfb",
                                "sense_id": "314cea80-9cf2-3b7f-b55d-6e0fbd9883d6",
                                "text": "Étoiles filantes, les perséides en 1875, observations faites à l’observatoire royal de Bruxelles."
                            },
                            {
                                "example_id": "b9f4cc9c-1136-490e-8fa5-e62762b142ec",
                                "sense_id": "314cea80-9cf2-3b7f-b55d-6e0fbd9883d6",
                                "text": "Un soir d’août, sous un ciel de perséides, ils goûtèrent leur premier baiser."
                            }
                        ]
                    }
                ],
