{
    "word_family": [
        "tempowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a43f96d-09c7-3ad1-b9c7-5079daf505ff",
                    "sense_definition": "Prędkość wykonywania jakiejś czynności, przebiegu zdarzeń lub procesu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speed_rate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor zarządził nagłe zwiększenie <tempa> produkcji w fabryce.",
                            "target_lang_translations": {
                                "ru": "Директор распорядился о внезапном увеличении <w>темпа</w> производства на фабрике.",
                                "en": "The director ordered a sudden increase in the <w>rate</w> of production at the factory."
                            }
                        },
                        {
                            "text": "Musimy narzucić ostre <tempo>, żeby zdążyć przed zachodem słońca.",
                            "target_lang_translations": {
                                "ru": "Мы должны задать высокий <w>темп</w>, чтобы успеть до заката.",
                                "en": "We need to set a fast <w>pace</w> to make it before sunset."
                            }
                        }
                    ],
                    "synonyms": [
                        "szybkość",
                        "prędkość"
                    ],
                    "common_phrases": [
                        "szybkie tempo",
                        "wolne tempo",
                        "narzucić tempo",
                        "dotrzymać tempa",
                        "zawrotne tempo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорость выполнения какого-либо действия, хода событий или процесса.",
                        "en": "The speed at which an activity is performed, or the rate at which events or processes occur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темп",
                                "target_lang_sense_clarification": "скорость, ритм"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "pace",
                                "target_lang_sense_clarification": "speed of activity or progress"
                            },
                            {
                                "target_lang_word": "tempo",
                                "target_lang_sense_clarification": "rate or frequency of events"
                            },
                            {
                                "target_lang_word": "rate",
                                "target_lang_sense_clarification": "speed of change or production"
                            },
                            {
                                "target_lang_word": "speed",
                                "target_lang_sense_clarification": "rapidity of motion or action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad433cbb-cc4b-3ab9-97a2-4ef32ce6fb55",
                    "sense_definition": "Szybkość, z jaką wykonywany jest utwór muzyczny, określająca czas trwania wartości rytmicznych.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed_rate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten utwór jest skomponowany w bardzo wolnym <tempie> largo.",
                            "target_lang_translations": {
                                "ru": "Это произведение написано в очень медленном <w>темпе</w> ларго.",
                                "en": "This piece is composed in a very slow largo <w>tempo</w>."
                            }
                        },
                        {
                            "text": "Perkusista musi idealnie trzymać <tempo> przez cały koncert.",
                            "target_lang_translations": {
                                "ru": "Барабанщик должен идеально держать <w>темп</w> на протяжении всего концерта.",
                                "en": "The drummer must keep the <w>tempo</w> perfectly throughout the entire concert."
                            }
                        }
                    ],
                    "synonyms": [
                        "szybkość"
                    ],
                    "common_phrases": [
                        "w tempie",
                        "trzymać tempo",
                        "gubić tempo",
                        "zmienne tempo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорость, с которой исполняется музыкальное произведение.",
                        "en": "The speed at which a musical piece is performed, determining the duration of rhythmic values."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темп",
                                "target_lang_sense_clarification": "музыка"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "tempo",
                                "target_lang_sense_clarification": "musical speed"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}