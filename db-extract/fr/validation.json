                "senses": [
                    {
                        "sense_id": "bf47fbf0-e7d6-3458-9923-60e2fb6f1e79",
                        "entry_id": "1412aa62-db90-39f6-ab66-3b6e7fbc342d",
                        "glosses": [
                            "Action de valider, spécialement en termes de procédure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518046c9-eca5-43aa-ab4d-bcdc23733726",
                                "sense_id": "bf47fbf0-e7d6-3458-9923-60e2fb6f1e79",
                                "text": "La validation d’une élection."
                            },
                            {
                                "example_id": "e04087cb-1f87-4b4f-91ac-1c5efb65932a",
                                "sense_id": "bf47fbf0-e7d6-3458-9923-60e2fb6f1e79",
                                "text": "Cette formalité est nécessaire pour la validation de l’acte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d5374ca-85b6-424b-82fb-3b6837be23fc",
                        "source_entry_id": "1412aa62-db90-39f6-ab66-3b6e7fbc342d",
                        "source_sense_id": "bf47fbf0-e7d6-3458-9923-60e2fb6f1e79",
                        "source_sense_description": "Action de valider",
                        "target_lang_word": "Validierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Validierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "559f43dd-ca9b-3e41-a3b1-ad96dce4a9ca",
                                        "entry_id": "3f3f36c7-985b-3f59-804a-a9bc304aa978",
                                        "glosses": [
                                            "Feststellung der Wichtigkeit, des Wertes von etwas, Feststellung einer Gültigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bc174bb-a81c-4fd5-bef8-fa504d5f9359",
                                                "sense_id": "559f43dd-ca9b-3e41-a3b1-ad96dce4a9ca",
                                                "text": "„Ihre Validierung ist kaum weniger aufwendig als die von Krebsmedikamenten.“"
                                            },
                                            {
                                                "example_id": "a8d2155c-5007-4500-8464-1b8bfcde9d89",
                                                "sense_id": "559f43dd-ca9b-3e41-a3b1-ad96dce4a9ca",
                                                "text": "Verifizierung und Validierung sollte man nicht verwechseln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6c39771-63f0-374c-bf81-b28facf7a558",
                                        "entry_id": "3f3f36c7-985b-3f59-804a-a9bc304aa978",
                                        "glosses": [
                                            "Bestätigung durch Bereitstellung eines objektiven Nachweises, dass die Anforderungen für einen spezifischen Gebrauch oder eine spezifische beabsichtigte Anwendung erfüllt worden sind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a839b1-04ff-41d6-8d93-80cf32330db0",
                                                "sense_id": "c6c39771-63f0-374c-bf81-b28facf7a558",
                                                "text": "Verifizierung und Validierung sollte man nicht verwechseln."
                                            },
                                            {
                                                "example_id": "c4008280-6c14-45a5-b172-01d76d49753f",
                                                "sense_id": "c6c39771-63f0-374c-bf81-b28facf7a558",
                                                "text": "Beim Softwaretesten klärt die Verifizierung die Frage, ob das Produkt richtig entwickelt wurde, während die Validierung klärt, ob man das richtige Produkt entwickelte."
                                            },
                                            {
                                                "example_id": "ee2230d5-0051-48e5-9a10-ccd481066346",
                                                "sense_id": "c6c39771-63f0-374c-bf81-b28facf7a558",
                                                "text": "„Auch die Überprüfung der Daten (mit einer Validierung) ist so nicht lösbar.“"
                                            },
                                            {
                                                "example_id": "6bb831da-62b1-46ea-9f06-7ab126d4c3d8",
                                                "sense_id": "c6c39771-63f0-374c-bf81-b28facf7a558",
                                                "text": "„Die Validierung des Tickets erfolgt durch ein mehrstufiges Sicherheitssystem, das eine rasche Kontrolle ebenso ermöglicht wie 100%-ige Sicherheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51cdfefc-e66e-4842-88aa-dceb49734034",
                        "source_entry_id": "1412aa62-db90-39f6-ab66-3b6e7fbc342d",
                        "source_sense_id": "bf47fbf0-e7d6-3458-9923-60e2fb6f1e79",
                        "source_sense_description": "Action de valider",
                        "target_lang_word": "validation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "validation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e37b9858-9628-331d-b7ce-54d9188d536c",
                                        "entry_id": "ede7b41b-ec0f-3dd0-8cc0-3aa015f07b8d",
                                        "glosses": [
                                            "The act of validating something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f12e3ee2-c081-4d95-9d1f-bfa819cb9d1e",
                                                "sense_id": "e37b9858-9628-331d-b7ce-54d9188d536c",
                                                "text": "In reality, brains go overboard with this sort of fear validation. They love any chance to prove a fear is valid while ignoring all the reasons it's not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6dd9f5d-8594-3111-ab40-f2fd132978fc",
                                        "entry_id": "ede7b41b-ec0f-3dd0-8cc0-3aa015f07b8d",
                                        "glosses": [
                                            "Something, such as a certificate, that validates something; attestation, authentication, confirmation, proof or verification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf75207d-4984-3bdf-8d8d-0c521984973e",
                                        "entry_id": "ede7b41b-ec0f-3dd0-8cc0-3aa015f07b8d",
                                        "glosses": [
                                            "The process whereby others confirm the validity of one's emotions or perspective."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045e01a4-aa87-48aa-88d4-251e01906ca2",
                                                "sense_id": "bf75207d-4984-3bdf-8d8d-0c521984973e",
                                                "text": "Praise is a judgment. It says, “I like the way you look or perform.” Validation demonstrates acceptance. It says, “I accept who you are, independent of how you look or perform.” When people claim that we shouldn’t rely on “external validation,” they are confusing validation with praise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4add52ed-0758-39c4-a083-1cb862820e78",
                                        "entry_id": "ede7b41b-ec0f-3dd0-8cc0-3aa015f07b8d",
                                        "glosses": [
                                            "The process of identifying a new prisoner's gang affiliation."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
