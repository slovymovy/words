                                        "examples": [
                                            {
                                                "example_id": "2fdda06b-0fb2-4323-a856-83fc7752980c",
                                                "sense_id": "9f345693-bdfc-322d-ab72-381022b410b0",
                                                "text": "À titre documentaire, nous donnons ci-dessous l’inventaire de deux noues en voie d'assèchement : […]."
