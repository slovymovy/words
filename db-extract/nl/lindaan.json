                        "examples": [
                            {
                                "example_id": "98a33c38-a743-4c6b-b055-bc51e2af22be",
                                "sense_id": "552ed1d3-b311-3adf-8310-ef4a8e3617eb",
                                "text": "De vervuilingen met hexachloorcyclohexaan (HCH), een restant bij de productie van het onkruidbestrijdingsmiddel [sic!] lindaan, kwamen in de jaren tachtig aan het licht. Het bleek een omvangrijk milieuschandaal. HCH staat op de overheidslijst van Zeer Zorgwekkende Stoffen. Dit zijn stoffen die gevaarlijk zijn voor mens en milieu omdat ze bijvoorbeeld kankerverwekkend zijn, de voortplanting belemmeren of zich in de voedselketen ophopen."
                            },
                            {
                                "example_id": "eb7db755-45ac-443f-80d3-6a5a27218728",
                                "sense_id": "552ed1d3-b311-3adf-8310-ef4a8e3617eb",
                                "text": "Bij het bodemonderzoek zijn toen in de leeflaag verhoogde gehalten van schadelijke metalen, minerale olie en zogeheten polychloorbifenylen (PCB’s) aangetroffen. Van hexachloorcyclohexaan (HCH), een zeer giftig goedje dat ontstaat bij de productie van het onkruidbestrijdingsmiddel [sic!] lindaan, is zelfs een sterk verhoogd gehalte gemeten."
                            }
                        ]
