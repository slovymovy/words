                    "frequency": "Middle",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'élève a reçu un premier <w>avertissement</w> pour ses retards répétés en classe."
                        },
                        {
                            "text": "La direction a notifié un <w>avertissement</w> écrit au salarié après cet incident."
                        }
                    ],
                    "common_phrases": [
                        "avertissement disciplinaire",
                        "recevoir un avertissement"
                    ]
                },
                {
