            {
                "entry_id": "f78d55b1-344c-3851-8e24-de13aff81369",
                "word": "denim",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3b4ca102-d8ff-44a3-a522-77c077e63500",
                        "entry_id": "f78d55b1-344c-3851-8e24-de13aff81369",
                        "tags": [
                            "plural"
                        ],
                        "form": "denims"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df1edffc-97fb-37ee-b9db-c0fc7c4da7b4",
                        "entry_id": "f78d55b1-344c-3851-8e24-de13aff81369",
                        "glosses": [
                            "Tissu utilisé pour confectionner les jeans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eface693-c475-4855-a0c2-49bc7e5c0c0c",
                                "sense_id": "df1edffc-97fb-37ee-b9db-c0fc7c4da7b4",
                                "text": "Prélavez le textile, qui tend à rétrécir au lavage, et prenez-en compte ce facteur au moment de votre achat : le retrait du denim peut être important."
                            },
                            {
                                "example_id": "ce47772f-402e-4ca5-afaa-7a89d5ef385d",
                                "sense_id": "df1edffc-97fb-37ee-b9db-c0fc7c4da7b4",
                                "text": "Vous trouverez également des gilets sans manches et parmi les accessoires d’adorables escarpins en denim."
                            },
                            {
                                "example_id": "9ba83319-fe7a-462c-ab50-468e6f5461af",
                                "sense_id": "df1edffc-97fb-37ee-b9db-c0fc7c4da7b4",
                                "text": "Quand, la popularité du denim s’affolant, les adolescents le baptisent blue-jeans ou jeans (au pluriel en américain), les fabricants ne leur font pas une leçon de vocabulaire : ils adoptent eux-mêmes le mot dans leurs publicités."
                            },
                            {
                                "example_id": "8d707062-bfe5-43ee-af4c-0c0768d67582",
                                "sense_id": "df1edffc-97fb-37ee-b9db-c0fc7c4da7b4",
                                "text": "Entourés de vestons-cravates, Girard et moi détonnions dans nos vestes de denim fatiguées, arborées comme par défi à la barbe de cet obscur aréopage de diplomates culturels à la solennité empesée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f503fabe-5c00-4d1d-9d58-1d686db69e60",
                        "source_entry_id": "f78d55b1-344c-3851-8e24-de13aff81369",
                        "source_sense_id": "df1edffc-97fb-37ee-b9db-c0fc7c4da7b4",
                        "target_lang_word": "Denim",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b2f87caf-f845-4f00-9b98-048098cdf500",
                        "source_entry_id": "f78d55b1-344c-3851-8e24-de13aff81369",
                        "source_sense_id": "df1edffc-97fb-37ee-b9db-c0fc7c4da7b4",
                        "target_lang_word": "denim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                        "entry_id": "d00507c7-ab5d-3d96-89ab-3eacf5700883",
                                        "glosses": [
                                            "A textile often made of cotton with a distinct diagonal pattern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dff5bf2-f6fd-4576-b84b-84ff32fb4f73",
                                                "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                                "text": "The Mexican people want a cheaper grade of drillings, sheetings, denims, and other fabrics than are called for in our domestic markets, and purchase them in England because they can not be bought in the United States."
                                            },
                                            {
                                                "example_id": "0d60a42d-a3aa-4b55-923f-ba47fb16d1ff",
                                                "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                                "text": "Fabrics: Gamine fabrics are informal as possible. For sports: tweeds, flannels, suedes, cottons, and denims;"
                                            },
                                            {
                                                "example_id": "8f2749e9-fa7c-4440-a524-4865e46bd5cd",
                                                "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                                "text": "Indigo, a typical member of this group of dyes, is widely used on denims and other fabrics for work clothes because of its very low cost and excellent fastness to washing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad14fd90-a237-4dbb-9dc6-053feb868098",
                        "source_entry_id": "f78d55b1-344c-3851-8e24-de13aff81369",
