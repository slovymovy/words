                "senses": [
                    {
                        "sense_id": "f41e866c-5553-3c8e-8cfb-6720e5b0b8f8",
                        "entry_id": "e6b36044-0bf8-367a-877c-e538d7715250",
                        "glosses": [
                            "Femme qui copréside."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac77029b-37bd-4f1b-82d2-48bf09e15d9d",
                                "sense_id": "f41e866c-5553-3c8e-8cfb-6720e5b0b8f8",
                                "text": "Mardi, l’Association des familles d’accueil et assistants maternels des Côtes-d’Armor a organisé un atelier motricité, encadré par Laurence Paturel, responsable espace jeux, Laurence Pédron, responsable du secteur et Gaëlle Le Bourhis, coprésidente de l’association, dans le dojo du complexe sportif Louis-Auffray."
                            },
                            {
                                "example_id": "b7efc697-7329-49f2-be84-43be6dde1df2",
                                "sense_id": "f41e866c-5553-3c8e-8cfb-6720e5b0b8f8",
                                "text": "Nous faisons de plus en plus pour sensibiliser aux transidentités, détaille Anaïs Perrin-Prevelle, coprésidente d’OUTrans."
                            },
                            {
                                "example_id": "32507f88-cf2b-43ec-8f96-839cd289d9c2",
                                "sense_id": "f41e866c-5553-3c8e-8cfb-6720e5b0b8f8",
                                "text": "Mais « la mairie nous a demandé de partir », se désole Sandy Constant, l’une des deux coprésidentes de l’association."
                            }
                        ]
                    }
                ],
