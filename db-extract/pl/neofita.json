                "senses": [
                    {
                        "sense_id": "ab0869e6-adbf-370d-a6ef-800b9a149d1a",
                        "entry_id": "8b23b6c2-1a56-35e7-85d5-5354593adeea",
                        "glosses": [
                            "człowiek, który zmienił wyznanie na inne"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "da39f35d-0b4f-3637-88f1-55ce35790278",
                        "entry_id": "8b23b6c2-1a56-35e7-85d5-5354593adeea",
                        "glosses": [
                            "nowy, żarliwy wyznawca jakiejś doktryny, nauki lub ideologii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11dce2d-156e-460c-a1ed-c547e343d5cf",
                                "sense_id": "da39f35d-0b4f-3637-88f1-55ce35790278",
                                "text": "I tak jeszcze w dalszym ciągu księga ta wyjawiała tyle, ile wolno było wiedzieć neoficie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a8bc4d8-d728-4f9e-bfea-03d14631a86b",
                        "source_entry_id": "8b23b6c2-1a56-35e7-85d5-5354593adeea",
                        "source_sense_id": "ab0869e6-adbf-370d-a6ef-800b9a149d1a",
                        "target_lang_word": "neophyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neophyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65445511-ffdf-3843-a39c-2257b2155824",
                                        "entry_id": "fa736e07-9ef4-3205-ad25-0407e87a75cb",
                                        "glosses": [
                                            "A beginner; a person who is new to a subject, skill, or belief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee8ae27-afc6-4e7d-a7bb-b71896142a49",
                                                "sense_id": "65445511-ffdf-3843-a39c-2257b2155824",
                                                "text": "A convert's enthusiasm for his new religion is greater than that of a person who is born in it. Vegetarianism was then a new cult in England, and likewise for me, because, as we have seen, I had gone there a convinced meat-eater, and was intellectually converted to vegetarianism later. Full of the neophyte's zeal for vegetarianism, I decided to start a vegetarian club in my locality, Bayswater."
                                            },
                                            {
                                                "example_id": "aa545c97-23eb-4cd7-b68d-32fa05468351",
                                                "sense_id": "65445511-ffdf-3843-a39c-2257b2155824",
                                                "text": "In this scene Lupita, the neophyte, is counselled by more weathered professionals about the rules and regulations of whoring."
                                            },
                                            {
                                                "example_id": "cb5226f6-cf5f-4b13-a51c-cd6db7003f53",
                                                "sense_id": "65445511-ffdf-3843-a39c-2257b2155824",
                                                "text": "[…]everyone has to own the floors of whoever you vote for, whether they are a lying handsy narcissistic sociopath[…] or a conspiracy-pandering political neophyte with no clear understanding of how government operates and who once recorded this folk rap about the virtues of bicycling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a538788-7f32-3156-88f8-bf0d2c32f593",
                                        "entry_id": "fa736e07-9ef4-3205-ad25-0407e87a75cb",
                                        "glosses": [
                                            "A novice (recent convert); a new convert or proselyte; a new monk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb8ffee-54f3-4377-ad6c-f48875565a56",
                                                "sense_id": "1a538788-7f32-3156-88f8-bf0d2c32f593",
                                                "text": "The neophyte was given a new name in place of the baptismal one, usually of an evil and revolting character, and this was written in blood in the Devil's book, the covers of which were bound in the skin of unbaptised infants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0b1c0c-4d04-376b-8e77-99aab2f2b9c1",
                                        "entry_id": "fa736e07-9ef4-3205-ad25-0407e87a75cb",
                                        "glosses": [
                                            "Among the early Christians, and still among the Roman Catholics, one who has recently embraced the Christian faith, and been admitted to baptism, especially those converts from heathenism or Judaism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b3ba1b9-3adc-3aa5-a877-c5e553dfeb03",
                                        "entry_id": "fa736e07-9ef4-3205-ad25-0407e87a75cb",
                                        "glosses": [
                                            "A plant species recently introduced to an area (in contrast to archaeophyte, a long-established introduced species)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca09ea3d-a293-4723-a885-688fb8059df5",
                        "source_entry_id": "8b23b6c2-1a56-35e7-85d5-5354593adeea",
                        "source_sense_id": "ab0869e6-adbf-370d-a6ef-800b9a149d1a",
