    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d98fb1c8-9a68-394c-8c5b-0020517bafae",
                    "sense_definition": "Heel precies, nauwkeurig en met oog voor elk detail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kon de situatie <w>haarfijn</w> analyseren en direct de kern van het probleem benoemen.",
                            "target_lang_translations": {
                                "en": "She was able to analyze the situation <w>meticulously</w> and immediately identify the core of the problem.",
                                "fr": "Elle a pu analyser la situation <w>minutieusement</w> et identifier immédiatement le cœur du problème."
                            }
                        },
                        {
                            "text": "De getuige kon de gebeurtenissen van die avond <w>haarfijn</w> uitleggen aan de politie.",
                            "target_lang_translations": {
                                "en": "The witness was able to explain the events of that evening to the police in <w>minute detail</w>.",
                                "fr": "Le témoin a pu expliquer les événements de cette soirée à la police <w>dans les moindres détails</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "minutieus",
                        "gedetailleerd"
                    ],
                    "antonyms": [
                        "onprecies",
                        "vaag"
                    ],
                    "common_phrases": [
                        "haarfijn uitleggen",
                        "haarfijn aanvoelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Extremely precise, accurate, and with attention to every detail.",
                        "fr": "Très précis, exact et avec une attention portée à chaque détail."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "highly detailed",
                                "target_lang_sense_clarification": "referring to an analysis or explanation"
                            },
                            {
                                "target_lang_word": "meticulous",
                                "target_lang_sense_clarification": "showing great attention to detail"
                            },
                            {
                                "target_lang_word": "crystal clear",
                                "target_lang_sense_clarification": "in the context of explaining something perfectly"
                            },
                            {
                                "target_lang_word": "minute",
                                "target_lang_sense_clarification": "extremely precise and detailed"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "minutieusement",
                                "target_lang_sense_clarification": "pour décrire une analyse ou une explication très détaillée"
                            },
                            {
                                "target_lang_word": "dans les moindres détails",
                                "target_lang_sense_clarification": "pour exprimer une précision extrême"
                            },
                            {
                                "target_lang_word": "avec précision",
                                "target_lang_sense_clarification": "pour souligner l'exactitude d'une explication"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa989b25-5f33-3d5c-89ec-b5a4d4204ee5",
                    "sense_definition": "Zeer dun, fijn of subtiel, vergelijkbaar met de dikte van een haar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar maakte een <w>haarfijne</w> schets met een heel dun potlood.",
                            "target_lang_translations": {
                                "en": "The artist made a <w>hair-thin</w> sketch with a very thin pencil.",
                                "fr": "L'artiste a réalisé une esquisse <w>très fine</w> avec un crayon très fin."
                            }
                        },
                        {
                            "text": "Er zat een <w>haarfijn</w> barstje in het antieke porseleinen kopje.",
                            "target_lang_translations": {
                                "en": "There was a <w>hairline</w> crack in the antique porcelain cup.",
                                "fr": "Il y avait une <w>fissure chevelue</w> dans la tasse en porcelaine antique."
                            }
                        }
                    ],
                    "synonyms": [
                        "ragfijn"
                    ],
                    "antonyms": [
                        "grof",
                        "dik"
                    ],
                    "common_phrases": [
                        "haarfijne lijntjes",
                        "haarfijne scheurtjes"
                    ],
                    "target_lang_definitions": {
                        "en": "Very thin, fine, or subtle, comparable to the thickness of a hair.",
                        "fr": "Très fin, délicat ou subtil, comparable à l'épaisseur d'un cheveu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hairline",
                                "target_lang_sense_clarification": "referring to cracks, fractures, or very thin lines"
                            },
                            {
                                "target_lang_word": "razor-thin",
                                "target_lang_sense_clarification": "extremely thin"
                            },
                            {
                                "target_lang_word": "hair-thin",
                                "target_lang_sense_clarification": "as thin as a hair"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "très fin",
                                "target_lang_sense_clarification": "pour décrire une épaisseur minimale"
                            },
                            {
                                "target_lang_word": "chevelu",
                                "target_lang_sense_clarification": "utilisé pour des fissures extrêmement fines"
                            },
                            {
                                "target_lang_word": "délié",
                                "target_lang_sense_clarification": "pour décrire un trait ou une ligne très fine"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}