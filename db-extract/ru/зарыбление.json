                "senses": [
                    {
                        "sense_id": "1afb5b58-d3bc-3be2-8eb7-1a350fe0c44e",
                        "entry_id": "6206937c-0494-3521-89f0-f391c8c93c6e",
                        "glosses": [
                            "действие по значению гл. зарыблять, зарыбить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a365eddc-ba6c-4eff-b1cd-35271a47b42a",
                                "sense_id": "1afb5b58-d3bc-3be2-8eb7-1a350fe0c44e",
                                "text": "Самый простой и доступный способ выращивания этой рыбы — зарыбление водоема весной годовиками и вылов их осенью. К этому времени карп достигает товарной массы."
                            },
                            {
                                "example_id": "865b01cc-5549-4298-8ddc-dcd97af58698",
                                "sense_id": "1afb5b58-d3bc-3be2-8eb7-1a350fe0c44e",
                                "text": "Для сохранения численности стада судака каждый год производится зарыбление отдельных водоёмов личинками и подращенной молодью."
                            }
                        ]
                    },
                    {
                        "sense_id": "70306029-bd85-3c90-ae28-3209bfe55dfe",
