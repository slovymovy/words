                    },
                    {
                        "translation_id": "b5c4144e-dc67-43aa-aa7d-7b19964fbc61",
                        "source_entry_id": "8dc57063-f259-371a-828a-e110ad3d5ec3",
                        "source_sense_id": "55bddb6d-42fa-3683-9ab7-19abe1d6c3fd",
                        "source_sense_description": "een versnapering, iets te eten tussen de maaltijden door",
                        "target_lang_word": "en-cas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en-cas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72b0b4eb-1a4e-3c13-b88b-a4b4efd66a67",
                                        "entry_id": "fc485b68-7956-351a-bbc7-f5074c96ebef",
                                        "glosses": [
                                            "Personne ou chose gardée en réserve pour servir en cas de besoin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b11ca76-ab96-31b5-a49c-db7c91c84f93",
                                        "entry_id": "fc485b68-7956-351a-bbc7-f5074c96ebef",
                                        "glosses": [
                                            "Repas léger préparé en cas de besoin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a231a2f-515b-4bc4-a9c3-7034e1f26bb3",
                                                "sense_id": "0b11ca76-ab96-31b5-a49c-db7c91c84f93",
                                                "text": "Dans sa chambre, comme en-cas pour la nuit, on lui tenait préparée une tasse de consommé froid."
                                            },
                                            {
                                                "example_id": "96c622a1-7b5a-4a06-94bc-4512c0b2aa26",
                                                "sense_id": "0b11ca76-ab96-31b5-a49c-db7c91c84f93",
                                                "text": "Nous nous ennuyions, nous autres, sylvains aux pieds légers, entraînés à battre le pays sans voiture, et regrettant, devant le poulet froid, nos en-cas de pain frais, d’ail et de fromage."
                                            },
                                            {
                                                "example_id": "adcece36-04a5-4031-8141-063567bc2fb9",
                                                "sense_id": "0b11ca76-ab96-31b5-a49c-db7c91c84f93",
                                                "text": "Aldegonde avait dû préparer des en-cas nocturnes pour Monsieur et pour le Docteur, qui n’avait pas quitté la chambre de Madame depuis la veille au soir."
                                            },
                                            {
                                                "example_id": "6c140140-76fa-4bd8-bd92-cb529aa6afe8",
                                                "sense_id": "0b11ca76-ab96-31b5-a49c-db7c91c84f93",
                                                "text": "On apporte un somptueux en-cas, comme si on n’avait pas dîné deux heures plus tôt."
                                            },
                                            {
                                                "example_id": "fdca9fc1-758f-4dfd-a0fc-7747fff19a2e",
                                                "sense_id": "0b11ca76-ab96-31b5-a49c-db7c91c84f93",
                                                "text": "C’est le grand calme et s’il n’y a pas de restaurant sur place, on a récemment ouvert une saladerie et un salon de thé pour d’agréables en-cas."
                                            },
                                            {
                                                "example_id": "5c7ad784-927d-47fa-8239-ecb31ca47bc5",
                                                "sense_id": "0b11ca76-ab96-31b5-a49c-db7c91c84f93",
                                                "text": "L’en-cas de nuit est une collation préparée dans la chambre à coucher, ou à proximité de celle-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2609bee-e3ee-3209-bfc8-981a3ccf2a4a",
                                        "entry_id": "fc485b68-7956-351a-bbc7-f5074c96ebef",
                                        "glosses": [
                                            "Désigne le petit meuble destiné à servir ce type de repas (sens 2)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7f279d8-365d-3c11-b9cf-a265210b8b45",
                                        "entry_id": "fc485b68-7956-351a-bbc7-f5074c96ebef",
                                        "glosses": [
                                            "Goûter ; casse-croûte ; collation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89827310-7bd1-484e-8961-c914710e1072",
                                                "sense_id": "f7f279d8-365d-3c11-b9cf-a265210b8b45",
                                                "text": "En route pour l’école, après le repas du midi, tous les jours nous nous arrêtions chez ces femmes. Et toujours, nous leur achetions un en-cas: cette nourriture-là, nous l’adorions."
                                            },
                                            {
                                                "example_id": "ebdc1e78-8d9f-49b7-9b5f-95f189fcd853",
                                                "sense_id": "f7f279d8-365d-3c11-b9cf-a265210b8b45",
                                                "text": "Le pain perdu est un en-cas parfait, car il associe différents aliments rassasiants comme les œufs, le lait, mais aussi la cannelle."
                                            },
                                            {
                                                "example_id": "0909bd0f-3913-43f5-8e49-bf76de584773",
                                                "sense_id": "f7f279d8-365d-3c11-b9cf-a265210b8b45",
                                                "text": "« Au Brésil, on mange salé le matin et on réserve la gelée pour l’après-midi, comme en-cas avec un café », explique Andressa, l’une des gérantes brésiliennes de la boutique Dengo, à Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82fd8a81-255e-3c24-82a8-6c2d10942db0",
                                        "entry_id": "fc485b68-7956-351a-bbc7-f5074c96ebef",
                                        "glosses": [
                                            "Espèce de parapluie qui est plus petit que la forme ordinaire des parapluies et un peu plus grand qu’une ombrelle, et qui sert à abriter de la pluie ou du soleil."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "199787d3-d381-335a-a9ca-d2dee01d874c",
                                        "entry_id": "fc485b68-7956-351a-bbc7-f5074c96ebef",
                                        "glosses": [
                                            "Parapluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab68ceeb-2643-4b66-8f90-d5b08b8e014f",
                                                "sense_id": "199787d3-d381-335a-a9ca-d2dee01d874c",
                                                "text": "Qu’elle coure, tenant des deux mains sa jupe comme à la contredanse, qu’elle rase sans bruit les maisons, abritée sous son en-cas violet, il lui criera, engageant et léger :\n— Quarante sous et un paquet de tabac !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6c02902-c97b-47eb-8a91-497012f77e66",
                        "source_entry_id": "8dc57063-f259-371a-828a-e110ad3d5ec3",
                        "source_sense_id": "55bddb6d-42fa-3683-9ab7-19abe1d6c3fd",
