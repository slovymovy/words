                "translations": [
                    {
                        "translation_id": "65fc6027-f5b1-477c-bf3e-5a1617a86877",
                        "source_entry_id": "bbd1154b-0891-399e-a331-f4c35e2e1a53",
                        "source_sense_id": "a4976081-4ed4-3644-8195-0ba0242bb346",
                        "source_sense_description": "benaming voor vogels uit het geslacht Phalacrocorax",
                        "target_lang_word": "Kormoran",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kormoran",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e5a622-9d28-36e2-abbc-4c29b4e0c7d4",
                                        "entry_id": "3dd28227-04c2-3e89-96b0-6241062b2889",
                                        "glosses": [
                                            "Angehöriger der Vogelgattung Phalacrocorax"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46ff1b3-4069-418c-bfeb-c909349deb6e",
                                                "sense_id": "47e5a622-9d28-36e2-abbc-4c29b4e0c7d4",
                                                "text": "Die Krähenscharbe gehört zu den Kormoranen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84de0d97-0568-3534-8116-e9a281572f27",
                                        "entry_id": "3dd28227-04c2-3e89-96b0-6241062b2889",
                                        "glosses": [
                                            "speziell die Vogelart Phalacrocorax carbo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69dc176-7307-4032-aaba-438e5dd35fe2",
                                                "sense_id": "84de0d97-0568-3534-8116-e9a281572f27",
                                                "text": "Der Kormoran ist aufgrund seiner Gefräßigkeit eine Bedrohung für unsere Fischbestände."
                                            },
                                            {
                                                "example_id": "4fd050e5-da3a-4bbc-b0a9-a8d588434952",
                                                "sense_id": "84de0d97-0568-3534-8116-e9a281572f27",
                                                "text": "„Nun, an diesem ersten lauen und sonnigen Abend sehen wir Möwen, Kraniche, Reiher, Kormorane, Grau- und Ringelgänse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e89ce189-208c-43de-8ca0-320ef1421d34",
                        "source_entry_id": "bbd1154b-0891-399e-a331-f4c35e2e1a53",
                        "source_sense_id": "a4976081-4ed4-3644-8195-0ba0242bb346",
                        "source_sense_description": "benaming voor vogels uit het geslacht Phalacrocorax",
                        "target_lang_word": "cormorant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cormorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                        "entry_id": "aa85d0ef-fa46-3db5-9db2-ef677e42f8ea",
                                        "glosses": [
                                            "Any of various medium-large black seabirds of the family Phalacrocoracidae which dive into water for fish and other aquatic animals, found throughout the world except for islands in the centre of the Pacific Ocean; specifically, the great cormorant (Phalacrocorax carbo)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80a7d16-4bb9-493a-904d-3ee9fe8c62be",
                                                "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                                "text": "Th' Eele-murthering Hearne, and greedy Cormorant, / That neare the Creekes in moriſh Marſhes haunt."
                                            },
                                            {
                                                "example_id": "64fdb339-3cea-4497-bfe8-8bf089887c16",
                                                "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                                "text": "Thence up he [Satan] flew, and on the Tree of Life, / The middle Tree and higheſt there that grew, / Sat like a Cormorant; […]"
                                            },
                                            {
                                                "example_id": "d4bad70d-c3da-455e-870e-73654b81adb0",
                                                "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                                "text": "The cormorant on high / VVheels from the deep, and ſcreams along the land."
                                            },
                                            {
                                                "example_id": "1c7b6097-2801-48b1-b90f-b958d0a04ba5",
                                                "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                                "text": "I may mention, that I one day observed a cormorant playing with a fish which it had caught. Eight times successively the bird let its prey go, then dived after it, and although in deep water, brought it each time to the surface. […] I do not know of any other instance where dame Nature appears so wilfully cruel."
                                            },
                                            {
                                                "example_id": "8efc841c-509a-43e9-9b79-501466a89136",
                                                "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                                "text": "These pictures were in water colours. […] One gleam of light lifted into relief a half-submerged mast, on which sat a cormorant, dark and large, with wings flecked with foam; […]"
                                            },
                                            {
                                                "example_id": "a0b3e662-40a2-412b-a90e-68a689c0402c",
                                                "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                                "text": "The strong air would soon restore Jonathan; it has quite restored me. I have an appetite like a cormorant, am full of life, and sleep well."
                                            },
                                            {
                                                "example_id": "afacfbf0-ca9d-46ed-b223-991e4736b161",
                                                "sense_id": "a6a3f6f2-814a-3f46-9e09-7a5da1d551fa",
                                                "text": "A man was swimming out towards them, his flailing arms black and defined in the heat-hazy radiance as the wings of a cormorant that skimmed the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                        "entry_id": "aa85d0ef-fa46-3db5-9db2-ef677e42f8ea",
                                        "glosses": [
                                            "A voracious eater; also, a person who, or thing which, is aggressively greedy for wealth, etc."
                                        ],
                                        "tags": [
                                            "also",
                                            "archaic",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c634a594-450d-4ac0-8a1c-51d09d124daf",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "In lyke maner who will nat haue in extreme detestation the insatiable gloteny of Vitellius, Fabius Gurges, Apicius, and dyuers other, to whiche carmorantes, neither lande, water, ne ayre, mought be sufficient."
                                            },
                                            {
                                                "example_id": "be152ef0-80cc-4b9b-a4dd-2a6fe3c65b53",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "VVith eagre feeding foode doth choke the feeder, / Light vanitie inſatiate cormorant, / Conſuming meanes ſoone praies vpon it ſelfe: […]"
                                            },
                                            {
                                                "example_id": "551e7867-289f-4d75-b60c-1332c7e821c8",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "Let Fame, that all hunt after in their lyues, / Liue regiſtred vpon our brazen Tombes, / And then grace vs, in the diſgrace of death: / VVhen ſpight of cormorant deuouring Time, / Th[']endeavour of this preſent breath may buy: / That honour vvhich ſhall bate his ſythes keene edge, / And make vs heires of all eternitie."
                                            },
                                            {
                                                "example_id": "bd363db4-2f2b-4e39-a3ea-a426d113f46c",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "Should by the Cormorant belly be reſtrain'd, / VVho is the ſinke a th'body."
                                            },
                                            {
                                                "example_id": "2eaaa3d8-3a8c-43a7-bb2e-15e3db57f79d",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "Surfetters, and Cormorants he compared to beasts voyd of reason."
                                            },
                                            {
                                                "example_id": "2da47ffa-0c0e-4341-9c3c-0f80e216c7f9",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "VVhy, vvhat a Cormorant in Love am I! vvho not contented vvith the ſlavery of honourable Love in one place, and the pleaſure of enjoying ſome half a ſcore Miſtreſſes of my ovvn acquiring; muſt yet take Vainlove’s Buſineſs upon my hands, becauſe it lay too heavy upon his: […]"
                                            },
                                            {
                                                "example_id": "55bedf4b-41f5-4b27-87c1-4418b72985a9",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "Law is a Bottomleſs-Pit, it is a Cormorant, a Harpy, that devours every thing; […]"
                                            },
                                            {
                                                "example_id": "eaaf78a3-52dd-4db9-8dbb-e01bdf16afa3",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "His treaſur’d ſtores theſe Cormorants conſume, / VVhoſe bones, defrauded of a regal tomb / And common turf, lie naked on the plain, / Or doom’d to vvelter in the vvhelming main."
                                            },
                                            {
                                                "example_id": "7c7563d9-0671-41ed-a7f1-fdc344812dc1",
                                                "sense_id": "44d53f59-17f1-3091-8e04-98ea917bfd54",
                                                "text": "She had discovered, within a short time, that doctors were not the cormorants (often ignorant, but always insatiable) she had supposed them to be, and that certain causes produced certain effects;..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cormorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c48f6a4-ce5e-3707-933e-3fefec0156ab",
                                        "entry_id": "603d3f54-e936-3122-9b5f-060b08b93cec",
                                        "glosses": [
                                            "Voracious; aggressively greedy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3327029a-a521-48d3-bd43-63c0b3609311",
                                                "sense_id": "7c48f6a4-ce5e-3707-933e-3fefec0156ab",
                                                "text": "Anti-masonry is as cormorant as death, and will not be satisfied though one half the human race be immolated to appease its infernal appetite."
                                            },
                                            {
                                                "example_id": "cfd6ad21-ddd8-46a7-be01-67cb2295455b",
                                                "sense_id": "7c48f6a4-ce5e-3707-933e-3fefec0156ab",
                                                "text": "... the victims of fanaticism who frequent Exeter Hall, to be plucked by tax gatherers more cormorant than your own excise-men at home?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "672d9a16-0a67-440a-920c-c4cb0d3f2da2",
                        "source_entry_id": "bbd1154b-0891-399e-a331-f4c35e2e1a53",
                        "source_sense_id": "a4976081-4ed4-3644-8195-0ba0242bb346",
                        "source_sense_description": "benaming voor vogels uit het geslacht Phalacrocorax",
                        "target_lang_word": "cormoran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cormoran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1442589a-0dea-36ce-a910-3fff0b698b07",
                                        "entry_id": "8daa7ba5-5e48-334e-bc7a-b9889587aeac",
                                        "glosses": [
                                            "Oiseau palmipède aquatique qui vit ordinairement de poisson, de taille moyenne à grande, au corps allongé, au long cou généralement flexible et au bec puissant et crochu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b98e133f-fb90-474f-a86b-9246289f3ac1",
                                                "sense_id": "1442589a-0dea-36ce-a910-3fff0b698b07",
                                                "text": "Là aussi, il y avait des hommes dressés, comme les cormorans et les chiens de chasse, à rapporter à leurs maîtres le poisson et le gibier, en échange duquel on leur donnait un morceau de pain."
                                            },
                                            {
                                                "example_id": "8c3899e9-4505-4ad9-a3bf-bdd415d7e805",
                                                "sense_id": "1442589a-0dea-36ce-a910-3fff0b698b07",
                                                "text": "Ils étaient cinq, vêtus de noir, autour de ma valise ouverte. Cinq cormorans sur la grève, prêts à se disputer les entrailles d’un congre abandonné."
                                            },
                                            {
                                                "example_id": "d73a04bc-d488-4603-8ad5-d6a969410392",
                                                "sense_id": "1442589a-0dea-36ce-a910-3fff0b698b07",
                                                "text": "J'étais un bateau gigantesque.\nJ'emportais des milliers d'amants.\nJ'étais la France. Qu'est-ce qu'il en reste ?\nUn corps-mort pour des cormorans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de7c1428-057d-3559-84e7-7c76c376b775",
                                        "entry_id": "8daa7ba5-5e48-334e-bc7a-b9889587aeac",
                                        "glosses": [
                                            "(au sens étroit) Variante de grand cormoran."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
