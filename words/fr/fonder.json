                    "frequency": "High",
                    "semantic_group_id": "etablir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune couple a décidé de <w>fonder</w> un foyer dans cette petite ville paisible."
                        },
                        {
                            "text": "Ils ont réussi à <w>fonder</w> une entreprise florissante grâce à leur travail acharné."
                        }
                    ],
                    "common_phrases": [
