        "fr-extract.jsonl": [
            {
                "entry_id": "822e51f9-12f6-333c-a9cc-fdd44fe2ab5d",
                "word": "complaisamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                        "entry_id": "822e51f9-12f6-333c-a9cc-fdd44fe2ab5d",
                        "glosses": [
                            "Avec ou par complaisance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70950843-43b7-4cd4-ac8f-c710a5ba287f",
                                "sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                                "text": "La petite personne se laissa complaisamment saisir par la taille quand elle fut debout sur le bord de la voiture, […]."
                            },
                            {
                                "example_id": "fd06718d-bf80-4646-a64b-3758a1901fc8",
                                "sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                                "text": "L’incrédulité de Bert était ébranlée. Il posait des questions, et le soldat y répondait complaisamment."
                            },
                            {
                                "example_id": "c3734eca-08eb-4e06-9b71-488b3262b4f2",
                                "sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                                "text": "Ce prologue le fatiguait, mais il ne pouvait l’écourter. L’éloquence fait partie de la fonction ; et il en avait trop complaisamment composé les périodes pour se priver de la satisfaction de s’entendre les phraser et de jouir de ces cadences étudiées."
                            },
                            {
                                "example_id": "2aeedaad-85b2-4585-9ec2-07e4ee73196b",
                                "sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                                "text": "— Il parle trop complaisamment de lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bb63a01-5a48-4aa1-872f-4707d76a3b1e",
                        "source_entry_id": "822e51f9-12f6-333c-a9cc-fdd44fe2ab5d",
                        "source_sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                        "target_lang_word": "accommodatingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accommodatingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cccb8a03-6387-3b70-b90a-f0837014ce9b",
                                        "entry_id": "611078f2-7620-3be7-8c29-5fd74772c2bf",
                                        "glosses": [
                                            "In an accommodating manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d17a115-c288-4877-9d78-365d78fd3cab",
                        "source_entry_id": "822e51f9-12f6-333c-a9cc-fdd44fe2ab5d",
                        "source_sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                        "target_lang_word": "complacently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complacently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8970f513-57d7-33e3-a92c-fbc626c1a89b",
                                        "entry_id": "1da01988-448a-3e0d-9fcc-10deb3413e12",
                                        "glosses": [
                                            "In a complacent manner; overly calm and contented; not troubled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd8b81a-f05a-4276-ba04-2dd7dae70c7c",
                                                "sense_id": "8970f513-57d7-33e3-a92c-fbc626c1a89b",
                                                "text": "At work Mr. Burns spies Homer munching complacently on a donut and hisses that each donut Homer shoves into his fat face brings him one donut closer to the poisoned donut Mr. Burns has ordered thrown into the mix as a form of culinary Russian Roulette, only to learn from Smithers that the plant’s lawyers ultimately nixed the poisoned donut plan because “they consider it murder.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba0acfca-7b74-4e7d-946e-59abdb3bd91e",
                        "source_entry_id": "822e51f9-12f6-333c-a9cc-fdd44fe2ab5d",
                        "source_sense_id": "172491c5-6608-3757-956a-084ed3240e6f",
                        "target_lang_word": "kindly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de5ccf91-c18e-38cd-a03a-85d8520d4ee1",
                                        "entry_id": "1a1e5406-08e8-390e-900e-30004077cf5b",
                                        "glosses": [
                                            "Having a kind personality; kind, warmhearted, sympathetic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec3bfa8-a998-4920-a2db-fdb6259ce038",
                                                "sense_id": "de5ccf91-c18e-38cd-a03a-85d8520d4ee1",
                                                "text": "A kindly old man sits on the park bench every afternoon feeding pigeons."
                                            },
                                            {
                                                "example_id": "c230926b-0877-4e27-8d8e-7e2ae1792e72",
                                                "sense_id": "de5ccf91-c18e-38cd-a03a-85d8520d4ee1",
                                                "text": "The shade by which my life was crost, […] Has made me kindly with my kind"
                                            },
                                            {
                                                "example_id": "a4e06e68-d11e-4cb2-8660-6d395d126645",
                                                "sense_id": "de5ccf91-c18e-38cd-a03a-85d8520d4ee1",
                                                "text": "This was the first long train journey I ever took, and the details remain in my memory as sharply as if they had taken place last week. Hopping on the Circle Line to King's Cross, boarding the compartmentalised train, the kindly ticket inspectors, and every station where the Grimsby express stopped (in those days it didn't go through to Cleethorpes)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ff5b97-84a7-3d05-b589-138fb06f17d8",
                                        "entry_id": "1a1e5406-08e8-390e-900e-30004077cf5b",
                                        "glosses": [
                                            "Favourable, gentle, pleasant, tidy, auspicious, beneficent."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32a65dc0-a3bf-4228-ab65-8be4a26b337c",
                                                "sense_id": "06ff5b97-84a7-3d05-b589-138fb06f17d8",
                                                "text": "Ye Heav'ns! from high the devvy nectar pour, / And in ſoft ſilence ſhed the kindly ſhovv'r!"
                                            },
                                            {
                                                "example_id": "689d92d2-487b-4283-a2bc-f351e7cd4b40",
                                                "sense_id": "06ff5b97-84a7-3d05-b589-138fb06f17d8",
                                                "text": "His Brothers' wisdom or their love— / But calmly from the spot withdrew; / The like endeavours to renew, / should e'er a kindlier time ensue."
                                            },
                                            {
                                                "example_id": "c0483641-3769-471a-a618-5e9fd536f88e",
                                                "sense_id": "06ff5b97-84a7-3d05-b589-138fb06f17d8",
                                                "text": "Lead, kindly Light, amid th' encircling gloom, / ⁠Lead Thou me on"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc240146-1d67-3d63-be4e-472b98e09289",
                                        "entry_id": "1a1e5406-08e8-390e-900e-30004077cf5b",
                                        "glosses": [
                                            "Lawful."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1320dee7-fc0c-37b0-8696-7458c78c8445",
                                        "entry_id": "1a1e5406-08e8-390e-900e-30004077cf5b",
                                        "glosses": [
                                            "Natural; inherent to the kind or race."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3844a6-1191-4995-8e37-b2f13acc3c1a",
                                                "sense_id": "1320dee7-fc0c-37b0-8696-7458c78c8445",
                                                "text": "the kindly fruits of the earth"
                                            },
                                            {
                                                "example_id": "42ac858b-6caa-4091-9a0b-d07f7d6c0cd6",
                                                "sense_id": "1320dee7-fc0c-37b0-8696-7458c78c8445",
                                                "text": "An heard of Bulles, whom kindly rage doth sting,"
                                            },
                                            {
                                                "example_id": "820cc61e-9271-48c0-b2a5-7bb0e341a167",
                                                "sense_id": "1320dee7-fc0c-37b0-8696-7458c78c8445",
                                                "text": "[W]hatsoever as the Son of God He may do, it is kindly for Him, as the Son of Man, to save the sons of men."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kindly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62187aef-cdec-324e-8169-dd1d08422161",
                                        "entry_id": "9507eb73-12db-3c2a-be6d-432321354f70",
                                        "glosses": [
                                            "In a kind manner, out of kindness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2efc5f08-cfc8-4b3d-9d90-637491d4fd60",
                                                "sense_id": "62187aef-cdec-324e-8169-dd1d08422161",
                                                "text": "He kindly offered to take us to the station in his car."
                                            },
                                            {
                                                "example_id": "c08b3a09-bdc8-4f28-9568-be46a32317af",
                                                "sense_id": "62187aef-cdec-324e-8169-dd1d08422161",
                                                "text": "Because I could not stop for Death, / He kindly stopped for me; / The carriage held but just ourselves / And Immortality."
                                            },
                                            {
                                                "example_id": "cf0b5018-3766-4333-82dd-7a0b0fe07da2",
                                                "sense_id": "62187aef-cdec-324e-8169-dd1d08422161",
                                                "text": "She was both beautiful and young to their eyes. Her hair was a rich red in color and fell in flowing ringlets over her shoulders. Her dress was pure white but her eyes were blue, and they looked kindly upon the little girl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2401f3-d913-3336-acac-8dc02746892b",
                                        "entry_id": "9507eb73-12db-3c2a-be6d-432321354f70",
                                        "glosses": [
                                            "In a favourable way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0aef5b5-3255-4953-910e-68b91dcc3796",
                                                "sense_id": "6a2401f3-d913-3336-acac-8dc02746892b",
                                                "text": "Aguero was quick to block Hennessey's attempted clearance and the ball bounced kindly to Dzeko, who had the simplest of tasks to put City ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0b6b6ad-0f63-37b4-9226-360da9cd582b",
                                        "entry_id": "9507eb73-12db-3c2a-be6d-432321354f70",
                                        "glosses": [
                                            "Used to make a polite request: please."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e3985d-5ff9-453f-80f5-6a91a0082fdb",
                                                "sense_id": "a0b6b6ad-0f63-37b4-9226-360da9cd582b",
                                                "text": "Kindly refrain from walking on the grass."
                                            },
                                            {
                                                "example_id": "5636391c-7559-4d36-adc0-516c8709bc0d",
                                                "sense_id": "a0b6b6ad-0f63-37b4-9226-360da9cd582b",
                                                "text": "May we request that patrons kindly take their seats."
                                            },
                                            {
                                                "example_id": "63e3ed90-3e28-447e-86fc-fa7c44a107f7",
                                                "sense_id": "a0b6b6ad-0f63-37b4-9226-360da9cd582b",
                                                "text": "Well, I called me wife and I said to her: Will you kindly tell to me / Who owns that horse outside the door where my old horse should be?"
                                            },
                                            {
                                                "example_id": "e22fa299-4306-4b5a-99d8-1d9cad2bc3f1",
                                                "sense_id": "a0b6b6ad-0f63-37b4-9226-360da9cd582b",
                                                "text": "Please kindly bring your hardcopy of the Constitution to every class."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d06c34e-403e-327b-9cb5-236bb5c7d785",
                                        "entry_id": "9507eb73-12db-3c2a-be6d-432321354f70",
                                        "glosses": [
                                            "With kind acceptance; used with take."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5564526-ac2e-4641-9614-69849f9900dc",
                                                "sense_id": "8d06c34e-403e-327b-9cb5-236bb5c7d785",
                                                "text": "I don't take kindly to threats."
                                            },
                                            {
                                                "example_id": "562075d2-a377-4427-ab25-7d52098d0170",
                                                "sense_id": "8d06c34e-403e-327b-9cb5-236bb5c7d785",
                                                "text": "Aunt Daisy didn't take it kindly when we forgot her anniversary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49cde6f0-6a21-37b5-929c-73ce074cc896",
                                        "entry_id": "9507eb73-12db-3c2a-be6d-432321354f70",
                                        "glosses": [
                                            "Kind of, somewhat."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b1d4b3f-c1c4-36ef-9547-89a2a87a5f7b",
                                        "entry_id": "9507eb73-12db-3c2a-be6d-432321354f70",
                                        "glosses": [
                                            "Readily."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7023593-c374-3d41-a4e8-4cec2f89be44",
                                        "entry_id": "9507eb73-12db-3c2a-be6d-432321354f70",
                                        "glosses": [
                                            "Naturally."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
