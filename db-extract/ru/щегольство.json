                                        "sense_id": "482245a4-84e7-3aac-93e6-3fc1a9beaf6b",
                                        "entry_id": "d9248645-ebf5-3295-b1fa-d5916f9165ad",
                                        "glosses": [
                                            "The act of one who brags."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f2391f-2dfd-4f96-bc66-d511bb43dd16",
                                                "sense_id": "482245a4-84e7-3aac-93e6-3fc1a9beaf6b",
                                                "text": "[…] there was a glint of amused contempt in his black eyes — contempt, as if he listened to the braggings of children."
                                            }
