                                "example_id": "7ea0a1a4-91de-40a4-acd9-cb20ad364729",
                                "sense_id": "db5179e5-5d31-3ad8-a616-ae341eebedc2",
                                "text": "Les Rabbanistes, ou Traditionnaires, ont une si grande aversion des Caraïtes, qu'ils ne veulent point s'allier, ni même converser avec eux."
                            },
                            {
                                "example_id": "06a8f169-2e37-41fb-90ea-09f7791c2a5a",
                                "sense_id": "db5179e5-5d31-3ad8-a616-ae341eebedc2",
                                "text": "Cʼest un axiome parmi les rabbanistes que si un Caraïte et un Chrétien se noyaient simultanément , le rabbaniste doit faire un pont avec le corps du Caraïte pour sauver le Chrétien."
                            }
                        ]
                    }
