                                        "entry_id": "3680be73-6db9-3d06-9dec-311552c935c9",
                                        "glosses": [
                                            "rijksvorst in het Heilige Roomse Rijk die het recht had om de Rooms-koning, of later de keizer, te kiezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc18aa7-c875-4ae5-b4eb-bfffffe9a797",
                                                "sense_id": "0d84b15d-23f3-33c8-ad7e-02e1dbd3d24d",
                                                "text": "De keurvorst van Saksen voerde al jaren oorlog met de koning van Zweden om de Poolse troon."
                                            }
                                        ]
