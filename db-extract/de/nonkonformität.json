                            {
                                "example_id": "1c5a4f94-24be-478b-8700-9e90522e8006",
                                "sense_id": "2edeac77-65cd-39f6-9af1-a5d2a472fc30",
                                "text": "Martin ist wegen seiner Nonkonformität nicht bei allen Lehrern beliebt."
                            }
