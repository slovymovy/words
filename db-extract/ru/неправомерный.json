                "translations": [
                    {
                        "translation_id": "f3c91255-9778-4a56-a077-da139300a75f",
                        "source_entry_id": "c160a7be-5fae-3a4c-9182-b27ba6df8b71",
                        "target_lang_word": "illégal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illégal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e27468f-2709-3436-93f9-de7709e887ea",
                                        "entry_id": "f9ab8b4b-1c4f-30f4-868f-0f4ba49f865d",
                                        "glosses": [
                                            "Qui est contre la loi, qui ne respecte pas la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df0ec93-3207-4fdb-afd5-95cfb242a6fe",
                                                "sense_id": "0e27468f-2709-3436-93f9-de7709e887ea",
                                                "text": "Convention illégale. - Formes illégales. - Des actes illégaux. - Mesure illégale."
                                            },
                                            {
                                                "example_id": "d682b37f-58ff-49c4-bc82-4bf2bf7efa29",
                                                "sense_id": "0e27468f-2709-3436-93f9-de7709e887ea",
                                                "text": "Certains juristes avancent que le caractère illégal d’un mariage religieux non précédé d’un mariage civil serait discutable."
                                            },
                                            {
                                                "example_id": "835fa66b-08aa-48c4-a389-5cb0e228a3a7",
                                                "sense_id": "0e27468f-2709-3436-93f9-de7709e887ea",
                                                "text": "Nous avons même vu le Prince lui-même au volant de ce \"colosse illégal\" en Europe, ce qui montre l'engouement même des figures royales pour ce véhicule avant-gardiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "illégal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c82d43d6-55c9-3d51-8c59-9b83994f4f5c",
                                        "entry_id": "e5cd4792-8f2a-3f0e-836d-1134b848daf0",
                                        "glosses": [
                                            "Espion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76389f97-517c-4013-8e8a-c4e524f00531",
                                                "sense_id": "c82d43d6-55c9-3d51-8c59-9b83994f4f5c",
                                                "text": "Dans l’argot du renseignement, on appelle « illégaux » les espions qui agissent sous de fausses identités, sans statut diplomatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7096b52-8ddb-470f-920a-9dd6384bbb5d",
                        "source_entry_id": "c160a7be-5fae-3a4c-9182-b27ba6df8b71",
                        "target_lang_word": "illicite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illicite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3ce656d-f32a-3efd-932a-88dbcb55f3ec",
                                        "entry_id": "7efbf770-9da1-3465-982c-0a13f8352318",
                                        "glosses": [
                                            "Qui est interdit par la morale ou par la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37968dc6-1d79-4a27-9f7b-f53a542c7a4a",
                                                "sense_id": "c3ce656d-f32a-3efd-932a-88dbcb55f3ec",
                                                "text": "Plaisir illicite."
                                            },
                                            {
                                                "example_id": "65c9185a-45c3-44dd-b2a5-069780262918",
                                                "sense_id": "c3ce656d-f32a-3efd-932a-88dbcb55f3ec",
                                                "text": "Amour illicite."
                                            },
                                            {
                                                "example_id": "e047ba0d-e263-4082-8b27-066c1c7a9ba1",
                                                "sense_id": "c3ce656d-f32a-3efd-932a-88dbcb55f3ec",
                                                "text": "Conventions illicites."
                                            },
                                            {
                                                "example_id": "6f37c6fb-3669-4476-bea6-e97ffea8c7f5",
                                                "sense_id": "c3ce656d-f32a-3efd-932a-88dbcb55f3ec",
                                                "text": "Acquérir une fortune par des moyens illicites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "illicite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03451795-3630-3c58-bb7d-9e2277f837a6",
                                        "entry_id": "713a18f7-14ee-30ff-9e64-e9ac9caeba57",
                                        "glosses": [
                                            "Ce qui est interdit, ce qui n'est pas permis, ce qui est prohibé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bfac9bd-4b53-40a8-8159-6e3db3544931",
                                                "sense_id": "03451795-3630-3c58-bb7d-9e2277f837a6",
                                                "text": "Je n’avais pas encore appris mon immunité de jeune seigneur, ni combien l’illicite est un peu partout plus licite qu’on ne croit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ead22ecb-1ce0-4ebf-be72-af7f03738c45",
                        "source_entry_id": "c160a7be-5fae-3a4c-9182-b27ba6df8b71",
                        "target_lang_word": "abusif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abusif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab826ec8-29cf-3636-be7d-32c881bfb558",
                                        "entry_id": "e1dad4ce-90b3-3018-85e9-60b8e9e15d38",
                                        "glosses": [
                                            "Où il y a abus, qui est contraire à l’ordre, aux règles, aux lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e07c14a-c11a-4e59-8c0f-8d70ab0542be",
                                                "sense_id": "ab826ec8-29cf-3636-be7d-32c881bfb558",
                                                "text": "Cette association du politique et du religieux perpétua, jusqu’au milieu du XXᵉ siècle, un système féodal abusif entretenu par la noblesse et les moines."
                                            },
                                            {
                                                "example_id": "de09eb45-cc01-4ab9-8c85-41be32a48946",
                                                "sense_id": "ab826ec8-29cf-3636-be7d-32c881bfb558",
                                                "text": "Or les tribunaux grecs ont tendance à assimiler le prosélytisme abusif à la simple influence."
                                            },
                                            {
                                                "example_id": "42e5af85-452c-4692-8e45-0b75fc7f446f",
                                                "sense_id": "ab826ec8-29cf-3636-be7d-32c881bfb558",
                                                "text": "Ces dépenses injustifiées et excessives sont communément appelées, reprenant ainsi le terme de la jurisprudence des juridictions du contentieux de la tarification, abusives."
                                            },
                                            {
                                                "example_id": "37f63b1d-e5da-456f-b23d-b81ab50a225f",
                                                "sense_id": "ab826ec8-29cf-3636-be7d-32c881bfb558",
                                                "text": "Des dangers aussi puissants, voire plus, que les armes : les fake news, les discours de haine et l’utilisation abusive des réseaux sociaux », a-t-elle écrit sur X."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d1e653-423a-34a8-8638-a847085065ab",
                                        "entry_id": "e1dad4ce-90b3-3018-85e9-60b8e9e15d38",
                                        "glosses": [
                                            "Qui est trompeur, spécieux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55eb4e52-f455-3a4c-85a8-4265868ae59d",
                                        "entry_id": "e1dad4ce-90b3-3018-85e9-60b8e9e15d38",
