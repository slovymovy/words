                        ],
                        "form": "neverminded"
                    },
                    {
                        "form_id": "2d098dd4-ebd1-4404-ad3d-cb2c6168eaf0",
                        "entry_id": "de9742f1-8f72-3ea4-b683-cb3fc9816246",
                        "tags": [
                            "past"
                        ],
                        "form": "neverminded"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc1f761e-4afc-360a-acf6-b4e00d0132cb",
                        "entry_id": "de9742f1-8f72-3ea4-b683-cb3fc9816246",
                        "glosses": [
                            "To ignore."
                        ],
                        "tags": [
                            "US",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "df579eed-8144-46d4-a921-271c6cb4b08d",
                                "sense_id": "dc1f761e-4afc-360a-acf6-b4e00d0132cb",
                                "text": "Nevermind a sustainable river, a sustainable earth, like an improvident farmer who kills his only milk cow because he wants steak tonight."
                            },
                            {
                                "example_id": "e750ad32-f885-4529-b4aa-4d9af189783a",
                                "sense_id": "dc1f761e-4afc-360a-acf6-b4e00d0132cb",
                                "text": "\"Ya, that's a good idea, neverminding. Let's nevermind, huh?\""
                            }
                        ]
                    },
                    {
                        "sense_id": "d44ba42e-65e0-3f02-8b58-1927e697d2fa",
                        "entry_id": "de9742f1-8f72-3ea4-b683-cb3fc9816246",
                        "glosses": [
                            "Misspelling of never mind."
                        ],
                        "tags": [
                            "alt-of",
                            "colloquial",
                            "misspelling"
                        ],
                        "examples": [
                            {
                                "example_id": "25b7ec85-73fb-4640-be48-d9c198e7d242",
                                "sense_id": "d44ba42e-65e0-3f02-8b58-1927e697d2fa",
                                "text": "Nevermind that she didn't know him, or that he was Japanese. Nevermind that she saw herself as always alone, despite the many people in her life."
                            },
                            {
                                "example_id": "3b68e685-5a6a-4666-8711-62f164cba416",
                                "sense_id": "d44ba42e-65e0-3f02-8b58-1927e697d2fa",
                                "text": "Nevermind where the eggs & sperm came from. Nevermind how it is that all these planets & stars came from nothing."
                            }
                        ]
                    }
                ],
                "translations": [],
