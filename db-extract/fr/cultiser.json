                "senses": [
                    {
                        "sense_id": "03b5b7be-0b47-395c-bf3e-70c206cc85ea",
                        "entry_id": "a15051c3-bab7-3391-973a-9edbced97beb",
                        "glosses": [
                            "Donner un caractère culte à (culte devant être compris dans le sens figuré et non dans le sens religieux)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a47d12d-40dd-423f-bada-cc8d97c5e724",
                                "sense_id": "03b5b7be-0b47-395c-bf3e-70c206cc85ea",
                                "text": "Comme si on entendait pas assez de conneries comme ça... pourquoi récupérer et \"cultiser\" des phrases aussi ordurières??"
                            },
                            {
                                "example_id": "1c551cc1-4181-45d4-85f9-196d32f0cd46",
                                "sense_id": "03b5b7be-0b47-395c-bf3e-70c206cc85ea",
                                "text": "plus sérieusement, je ne me souvenais même pas de la musique de Full Metal Jacket, la scene du suicide de Lawrence suffit amplement à \"cultiser\" ce film"
                            },
                            {
                                "example_id": "ae6d341f-d0ff-40e6-b0b8-f831a5db706e",
                                "sense_id": "03b5b7be-0b47-395c-bf3e-70c206cc85ea",
                                "text": "Parce que les publicitaires l'ont bien compris, pour vendre il faut \"cultiser\"."
                            }
                        ]
                    }
