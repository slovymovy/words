{
    "word_family": [
        "section",
        "sectional",
        "sectioning",
        "dissection",
        "intersection",
        "midsection"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c62c9a1-1680-381b-b595-99a86b384ff8",
                    "sense_definition": "A smaller, distinct part of a larger section within a document, book, or organization.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please refer to the <w>subsection</w> on safety procedures before starting the machine.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, ознакомьтесь с <w>подразделом</w> о мерах безопасности перед запуском машины."
                            }
                        },
                        {
                            "text": "The author added a new <w>subsection</w> to the chapter to explain the recent findings.",
                            "target_lang_translations": {
                                "ru": "Автор добавил в главу новый <w>подраздел</w>, чтобы объяснить недавние открытия."
                            }
                        }
                    ],
                    "synonyms": [
                        "subdivision",
                        "part",
                        "segment"
                    ],
                    "common_phrases": [
                        "relevant subsection",
                        "following subsection",
                        "detailed subsection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая, отдельная часть более крупного раздела в документе, книге или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подраздел",
                                "target_lang_sense_clarification": "часть текста или структуры"
                            },
                            {
                                "target_lang_word": "подсекция",
                                "target_lang_sense_clarification": "отдел внутри секции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91fd3eb4-3eb5-3bfe-a5df-2ce3c77f770b",
                    "sense_definition": "A specific subpart of a legal document, law, or formal regulation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that the defendant's actions were protected under <w>subsection</w> (a) of the statute.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что действия подсудимого подпадают под защиту <w>подпункта</w> (а) данного закона."
                            }
                        },
                        {
                            "text": "According to this <w>subsection</w>, the award to that entity is required by law.",
                            "target_lang_translations": {
                                "ru": "Согласно этому <w>подпункту</w>, выплата данной организации предусмотрена законом."
                            }
                        }
                    ],
                    "synonyms": [
                        "clause",
                        "paragraph"
                    ],
                    "common_phrases": [
                        "under subsection",
                        "pursuant to subsection",
                        "provisions of subsection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная подчасть юридического документа, закона или официального регламента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпункт",
                                "target_lang_sense_clarification": "пункт внутри статьи или раздела закона"
                            },
                            {
                                "target_lang_word": "абзац",
                                "target_lang_sense_clarification": "часть статьи в юридическом контексте"
                            },
                            {
                                "target_lang_word": "подраздел",
                                "target_lang_sense_clarification": "структурная единица нормативного акта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22c5d8f0-a91f-3168-a480-fabdee966ca1",
                    "sense_definition": "A taxonomic rank used in biology that falls below a section and above a species.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "taxonomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist classified the new plant variety within a specific <w>subsection</w> of the genus.",
                            "target_lang_translations": {
                                "ru": "Ботаник классифицировал новый сорт растения в рамках определенной <w>подсекции</w> рода."
                            }
                        },
                        {
                            "text": "This <w>subsection</w> contains several closely related species found only in tropical climates.",
                            "target_lang_translations": {
                                "ru": "Эта <w>подсекция</w> содержит несколько близкородственных видов, встречающихся только в тропическом климате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "taxonomic subsection",
                        "botanical subsection"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Таксономический ранг в биологии, который находится ниже секции и выше вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсекция",
                                "target_lang_sense_clarification": "биологическая классификация"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5007e708-4fec-3385-a5ed-0c31c09248e4",
                    "sense_definition": "To divide a text or a larger part into smaller subsections.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to <w>subsection</w> the long report to make it easier for readers to navigate.",
                            "target_lang_translations": {
                                "ru": "Редактор решил <w>разбить на подразделы</w> длинный отчет, чтобы читателям было легче в нем ориентироваться."
                            }
                        },
                        {
                            "text": "When you <w>subsection</w> the document, ensure each part has a clear and descriptive heading.",
                            "target_lang_translations": {
                                "ru": "Когда вы <w>подразделяете</w> документ, убедитесь, что у каждой части есть четкий и описательный заголовок."
                            }
                        }
                    ],
                    "synonyms": [
                        "subdivide",
                        "partition"
                    ],
                    "common_phrases": [
                        "subsection the text",
                        "further subsection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять текст или крупную часть на более мелкие подразделы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подразделять",
                                "target_lang_sense_clarification": "делить на части"
                            },
                            {
                                "target_lang_word": "разбивать на подразделы",
                                "target_lang_sense_clarification": "структурировать текст"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}