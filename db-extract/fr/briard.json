                        ],
                        "form": "briards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5cdbd0f-954e-3984-b724-c426fb71abc5",
                        "entry_id": "dec1c595-7b52-34f1-a2d5-e8b7dc6d9fe0",
                        "glosses": [
                            "Synonyme de berger de Brie (race de chien)."
                        ],
                        "tags": [
                            "Zootechnie"
                        ],
                        "examples": [
                            {
                                "example_id": "df67534f-d4da-48e6-8788-ab24783eaff0",
                                "sense_id": "f5cdbd0f-954e-3984-b724-c426fb71abc5",
                                "text": "Le briard est un chien très sociable qui adore jouer."
                            },
                            {
                                "example_id": "b41f0989-64c3-4d66-93d5-0637cb69acf8",
                                "sense_id": "f5cdbd0f-954e-3984-b724-c426fb71abc5",
                                "text": "« Butor et Fanfan, dit-elle à mi-voix. Ce sont deux briards, les meilleurs gardiens de Louvigny-Cambrouse. »"
                            },
                            {
                                "example_id": "0b6dece4-59de-4542-aeba-af14121fec9a",
                                "sense_id": "f5cdbd0f-954e-3984-b724-c426fb71abc5",
                                "text": "Mais Vegas était un pur briard, une race française longtemps employée par l’armée ; ces chiens sont en effet réputés pour leur flair exceptionnel et leur remarquable capacité à déceler d’éventuelles menaces pesant sur le bétail ou les humains."
                            }
                        ]
                    }
                ],
