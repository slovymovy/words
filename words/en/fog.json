{
    "word_family": [
        "foggy",
        "fogginess",
        "befog",
        "fogbound",
        "foghorn",
        "foglight"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8665d58-529b-30fd-951b-35e33b017a36",
                    "sense_definition": "A thick cloud that forms near the ground, reducing visibility.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather_phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hardly see the road ahead through the thick <w>fog</w>.",
                            "target_lang_translations": {
                                "ru": "Мы с трудом видели дорогу впереди сквозь густой <w>туман</w>.",
                                "zh": "透过浓厚的<w>雾</w>，我们几乎看不清前方的路。"
                            }
                        },
                        {
                            "text": "The morning <w>fog</w> lifted by noon, revealing the blue sky.",
                            "target_lang_translations": {
                                "ru": "Утренний <w>туман</w> рассеялся к полудню, открыв голубое небо.",
                                "zh": "早晨的<w>雾</w>在中午散去，露出了蓝天。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mist",
                        "haze"
                    ],
                    "common_phrases": [
                        "thick fog",
                        "dense fog",
                        "heavy fog",
                        "fog lifts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Густое облако, образующееся у поверхности земли и ухудшающее видимость.",
                        "zh": "在地表附近形成的浓厚云层，会降低能见度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туман",
                                "target_lang_sense_clarification": "атмосферное явление"
                            },
                            {
                                "target_lang_word": "мгла",
                                "target_lang_sense_clarification": "дымка, помутнение воздуха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雾",
                                "target_lang_sense_clarification": "大气现象"
                            },
                            {
                                "target_lang_word": "雾气",
                                "target_lang_sense_clarification": "弥漫的雾状水汽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e08db09d-881b-3ea3-bbe7-b46562599eb5",
                    "sense_definition": "A thin layer of condensation or moisture clouding a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wiped the <w>fog</w> off the bathroom mirror to see her reflection.",
                            "target_lang_translations": {
                                "ru": "Она вытерла <w>испарину</w> с зеркала в ванной, чтобы увидеть свое отражение.",
                                "zh": "她擦掉了浴室镜子上的一层<w>水汽</w>，以便看清自己的倒影。"
                            }
                        },
                        {
                            "text": "The sudden temperature change caused a layer of <w>fog</w> on the windshield.",
                            "target_lang_translations": {
                                "ru": "Резкий перепад температуры вызвал появление слоя <w>конденсата</w> на лобовом стекле.",
                                "zh": "温度的突然变化导致挡风玻璃上蒙上了一层<w>雾气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steam",
                        "mist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий слой конденсата или влаги, затуманивающий поверхность.",
                        "zh": "覆盖在物体表面的一层薄薄的冷凝水汽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испарина",
                                "target_lang_sense_clarification": "налет влаги на поверхности"
                            },
                            {
                                "target_lang_word": "конденсат",
                                "target_lang_sense_clarification": "осевшая влага"
                            },
                            {
                                "target_lang_word": "запотевание",
                                "target_lang_sense_clarification": "процесс или результат покрытия паром"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水汽",
                                "target_lang_sense_clarification": "物体表面凝结的雾状水珠"
                            },
                            {
                                "target_lang_word": "雾气",
                                "target_lang_sense_clarification": "遮挡视线的薄雾层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b006f8ca-a030-3a9d-9412-8b840fa97ee5",
                    "sense_definition": "A state of mental confusion or lack of clarity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked around in a <w>fog</w> for days after receiving the bad news.",
                            "target_lang_translations": {
                                "ru": "Он ходил как в <w>тумане</w> несколько дней после получения плохих новостей.",
                                "zh": "收到坏消息后，他好几天都处于一种<w>迷糊</w>的状态。"
                            }
                        },
                        {
                            "text": "Lack of sleep left me in a mental <w>fog</w> during the exam.",
                            "target_lang_translations": {
                                "ru": "Недостаток сна оставил меня в ментальном <w>тумане</w> во время экзамена.",
                                "zh": "睡眠不足使我在考试时感到头脑<w>混沌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "daze",
                        "haze"
                    ],
                    "antonyms": [
                        "clarity"
                    ],
                    "common_phrases": [
                        "in a fog",
                        "brain fog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ментальной растерянности или отсутствия ясности мыслей.",
                        "zh": "一种精神恍惚或思维不清晰的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туман",
                                "target_lang_sense_clarification": "перен. неясность сознания"
                            },
                            {
                                "target_lang_word": "помутнение",
                                "target_lang_sense_clarification": "спутанность сознания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迷糊",
                                "target_lang_sense_clarification": "思维混乱的状态"
                            },
                            {
                                "target_lang_word": "混沌",
                                "target_lang_sense_clarification": "头脑不清醒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed5f5fd9-25c0-35dc-9329-04a04244c714",
                    "sense_definition": "A new growth of grass appearing on a field after it has been mowed or grazed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep were moved to the lower field to graze on the winter <w>fog</w>.",
                            "target_lang_translations": {
                                "ru": "Овец перегнали на нижнее поле пастись на зимней <w>отаве</w>.",
                                "zh": "羊群被转移到低处的田地，去吃冬天的<w>再生草</w>。"
                            }
                        },
                        {
                            "text": "Farmers rely on the <w>fog</w> to feed livestock late in the season.",
                            "target_lang_translations": {
                                "ru": "Фермеры полагаются на <w>отаву</w> для кормления скота в конце сезона.",
                                "zh": "农民依靠<w>再生草</w>在季节末期喂养牲畜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aftergrass",
                        "aftermath"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used primarily in Northern English and Scottish dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодая трава, вырастающая на поле после скашивания или выпаса.",
                        "zh": "牧草收割或放牧后重新长出的嫩草。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отава",
                                "target_lang_sense_clarification": "трава, выросшая после покоса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再生草",
                                "target_lang_sense_clarification": "收割后重新长出的草"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0aa3398b-abc6-3a10-b2db-34729ce07e41",
                    "sense_definition": "To become covered with condensation or steam, making it difficult to see through.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "condensation_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My glasses <w>fogged</w> up immediately when I entered the warm room.",
                            "target_lang_translations": {
                                "ru": "Мои очки мгновенно <w>запотели</w>, когда я вошел в теплую комнату.",
                                "zh": "我走进温暖的房间时，眼镜立刻<w>起雾</w>了。"
                            }
                        },
                        {
                            "text": "The bathroom mirror always <w>fogs</w> when someone takes a hot shower.",
                            "target_lang_translations": {
                                "ru": "Зеркало в ванной всегда <w>запотевает</w>, когда кто-то принимает горячий душ.",
                                "zh": "有人洗热水澡时，浴室的镜子总是会<w>蒙上雾气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steam",
                        "mist",
                        "cloud"
                    ],
                    "common_phrases": [
                        "fog up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться конденсатом или паром, становясь непрозрачным.",
                        "zh": "指物体表面因冷凝而覆盖上一层水汽，导致视线模糊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запотевать",
                                "target_lang_sense_clarification": "покрываться влагой (о стекле)"
                            },
                            {
                                "target_lang_word": "затуманиваться",
                                "target_lang_sense_clarification": "становиться мутным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起雾",
                                "target_lang_sense_clarification": "表面覆盖水汽"
                            },
                            {
                                "target_lang_word": "蒙上雾气",
                                "target_lang_sense_clarification": "变得模糊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d6b3832-361b-3dc4-aaa3-b2144c949aa4",
                    "sense_definition": "To spray a fine mist of chemical, such as insecticide, over an area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemical_application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city decided to <w>fog</w> the neighborhood to control the mosquito population.",
                            "target_lang_translations": {
                                "ru": "Городские власти решили <w>окурить</w> район, чтобы контролировать популяцию комаров.",
                                "zh": "市政府决定对该社区进行<w>喷雾处理</w>，以控制蚊虫数量。"
                            }
                        },
                        {
                            "text": "They <w>fogged</w> the warehouse to eliminate the pest infestation.",
                            "target_lang_translations": {
                                "ru": "Они <w>обработали туманом</w> склад, чтобы уничтожить нашествие вредителей.",
                                "zh": "他们对仓库进行了<w>熏蒸</w>，以消除虫害。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распылять мелкодисперсный химикат (например, инсектицид) над территорией.",
                        "zh": "通过喷雾方式将化学药剂（如杀虫剂）散布在特定区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окуривать",
                                "target_lang_sense_clarification": "обрабатывать дымом или аэрозолем"
                            },
                            {
                                "target_lang_word": "обрабатывать туманом",
                                "target_lang_sense_clarification": "метод дезинсекции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷雾处理",
                                "target_lang_sense_clarification": "使用雾化药剂"
                            },
                            {
                                "target_lang_word": "熏蒸",
                                "target_lang_sense_clarification": "利用烟雾或气雾进行杀虫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f587fb7-27ad-3faf-943c-98d3a9f81e29",
                    "sense_definition": "To make something confusing, obscure, or difficult to understand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "obscure_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer tried to <w>fog</w> the issue with irrelevant details.",
                            "target_lang_translations": {
                                "ru": "Адвокат пытался <w>затуманить</w> суть дела несущественными деталями.",
                                "zh": "律师试图用无关紧要的细节来<w>模糊</w>问题的焦点。"
                            }
                        },
                        {
                            "text": "Alcohol can <w>fog</w> your judgment and slow your reaction time.",
                            "target_lang_translations": {
                                "ru": "Алкоголь может <w>затуманить</w> рассудок и замедлить время реакции.",
                                "zh": "酒精会<w>混淆</w>你的判断力并减慢你的反应速度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obscure",
                        "cloud",
                        "blur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо запутанным, неясным или трудным для понимания.",
                        "zh": "使某事变得模糊、晦涩或难以理解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затуманивать",
                                "target_lang_sense_clarification": "делать неясным"
                            },
                            {
                                "target_lang_word": "напускать туману",
                                "target_lang_sense_clarification": "идиома: намеренно запутывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "使界限不清"
                            },
                            {
                                "target_lang_word": "混淆",
                                "target_lang_sense_clarification": "使人难以分辨"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}