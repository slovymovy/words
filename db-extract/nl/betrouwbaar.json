                "senses": [
                    {
                        "sense_id": "8f9fb4f9-7340-3ba3-9fac-c7b0b51737f5",
                        "entry_id": "2e7b54b9-af89-349f-8704-b65f76c9ec69",
                        "glosses": [
                            "te vertrouwen, zo dat men zich erop kan verlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75dadfb3-5e4c-4817-aef9-dffa840dc547",
                                "sense_id": "8f9fb4f9-7340-3ba3-9fac-c7b0b51737f5",
                                "text": "Ik durf best over het ijs te gaan, want het ziet er betrouwbaar uit."
                            },
                            {
                                "example_id": "b124c846-0aef-4471-b4d8-24b8c8f1bd93",
                                "sense_id": "8f9fb4f9-7340-3ba3-9fac-c7b0b51737f5",
                                "text": "Deze informatie was nog betrouwbaarder dan de soms wat verouderde opmerkingen in Guthook en gezamenlijk gaven ze voldoende informatie om met enigszins gerust hart de uitgedroogde woestijn in te trekken."
                            },
                            {
                                "example_id": "ccacf42f-5d25-4052-9953-2178a187d4da",
                                "sense_id": "8f9fb4f9-7340-3ba3-9fac-c7b0b51737f5",
                                "text": "Het is niet mijn bedoeling om het leven van de prinses te beschrijven, maar dat van mezelf, het enige verhaal dat ik uit betrouwbare bron ken."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6969447-5490-35a6-9115-5ed78595e7e8",
                        "entry_id": "2e7b54b9-af89-349f-8704-b65f76c9ec69",
                        "glosses": [
                            "geloofwaardig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8c5715-95fb-483a-9825-d282772dfd56",
                                "sense_id": "c6969447-5490-35a6-9115-5ed78595e7e8",
                                "text": "De getuige maakte een betrouwbare indruk."
                            },
                            {
                                "example_id": "01cdf258-704c-4afc-9136-657b6482584b",
                                "sense_id": "c6969447-5490-35a6-9115-5ed78595e7e8",
                                "text": "Hoewel Perry betrouwbaar overkwam, wilde ze hem niet op andere ideëen brengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1b10411-324a-3854-9fbb-459c17102bd6",
                        "entry_id": "2e7b54b9-af89-349f-8704-b65f76c9ec69",
                        "glosses": [
                            "deugdelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ce6a9b4-0b01-4b2a-8f59-3af81fd26398",
                                "sense_id": "f1b10411-324a-3854-9fbb-459c17102bd6",
                                "text": "Dit bedrijf staat bekend om de betrouwbare producten die het produceert"
                            }
                        ]
                    }
                ],
