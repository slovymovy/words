    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58f08084-db2b-3c40-8b05-a58bd9eb21d5",
                    "sense_definition": "Toucher avec la main de manière répétée et en exerçant une légère pression, notamment pour examiner ou reconnaître.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toucher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin commence par <w>palper</w> le ventre du patient pour repérer l'origine exacte de la douleur."
                        },
                        {
                            "text": "Plongé dans l'obscurité, il dut <w>palper</w> les meubles avec précaution pour avancer sans heurter un obstacle."
                        }
                    ],
                    "synonyms": [
                        "tâter",
                        "toucher"
                    ],
                    "common_phrases": [
                        "palper le ventre",
                        "palper un patient"
                    ]
                },
                {
                    "sense_id": "e39d5ab0-0aec-36a2-8d79-37078bd5ae3e",
                    "sense_definition": "Toucher une somme d'argent, percevoir un gain financier ou un salaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la signature de ce gros contrat, il espère bien <w>palper</w> une prime exceptionnelle."
                        },
                        {
                            "text": "Certains courtiers parviennent à <w>palper</w> de coquettes sommes dès leurs premiers mois d'activité."
                        }
                    ],
                    "synonyms": [
                        "toucher",
                        "encaisser",
                        "empocher"
                    ],
                    "common_phrases": [
                        "palper du fric",
                        "palper de l'argent"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "20d646f5-a9fe-3edd-a41a-33acba3cffbf",
                    "sense_definition": "Ressentir ou percevoir de manière très vive et quasi physique une émotion ou une atmosphère.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ressenti",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'ouverture du procès, on pouvait presque <w>palper</w> l'angoisse silencieuse des accusés dans la salle."
                        },
                        {
                            "text": "Après cette annonce inattendue, le journaliste a pu <w>palper</w> la stupeur mêlée d'inquiétude parmi le public."
                        }
                    ],
                    "synonyms": [
                        "percevoir",
                        "ressentir"
                    ],
                    "common_phrases": [
                        "palper la tension"
                    ]
                },
                {
                    "sense_id": "33b9e93b-4900-3efe-99b9-e2407b3eeeed",
                    "sense_definition": "Masser un tissu musculaire ou cutané en exerçant des pressions douces et successives avec les doigts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toucher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le kinésithérapeute lui <w>palpe</w> longuement le dos pour dénouer ses tensions musculaires."
                        },
                        {
                            "text": "Il est recommandé de <w>palper</w> doucement les muscles de la cuisse pour favoriser la récupération après l'effort."
                        }
                    ],
                    "synonyms": [
                        "masser",
                        "pétrir"
                    ],
                    "common_phrases": [
                        "palper un muscle"
                    ]
                }
            ]
        },
