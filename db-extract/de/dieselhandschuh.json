                ],
                "senses": [
                    {
                        "sense_id": "70df6a09-c444-3c58-a700-944557eaf06c",
                        "entry_id": "609ba249-17c7-3aaa-a0b2-cb164d24ff17",
                        "glosses": [
                            "leichter Überzug aus Polyethylen zum Schutz der Hände beim Tanken, zum einmaligen Gebrauch"
                        ],
                        "tags": [
                            "Schutzkleidung"
                        ],
                        "examples": [
                            {
                                "example_id": "843a906a-185e-44fd-8858-5bc0b5f33338",
                                "sense_id": "70df6a09-c444-3c58-a700-944557eaf06c",
                                "text": "„Und auch wenn das Tragen von Dieselhandschuhen beim Tanken nicht Pflicht ist, rät der Tüv Nord aus hygienischen und gesundheitlichen Gründen dazu.“"
                            },
                            {
                                "example_id": "a116c28b-a389-4782-a933-cbe4cea18888",
                                "sense_id": "70df6a09-c444-3c58-a700-944557eaf06c",
                                "text": "„Luftdruck, Dieselhandschuhe und Papiertücher an der Tankstelle erhalten Sie kostenlos.“"
                            },
                            {
                                "example_id": "8fffd34c-0c0e-42c0-8db2-b3b1b2eacda2",
                                "sense_id": "70df6a09-c444-3c58-a700-944557eaf06c",
                                "text": "„Beim Tanken sollten allerdings die ausgelegten Dieselhandschuhe benutzt werden, die Ihre Haut auch vor Infektionen schützen.“"
                            },
                            {
                                "example_id": "0b99ae43-6b13-4931-b954-79ec7580a7d2",
                                "sense_id": "70df6a09-c444-3c58-a700-944557eaf06c",
                                "text": "„Da es nicht kalt ist, reichen für die Hände die normalen Radhandschuhe, ansonsten ziehe ich einfach Dieselhandschuhe von der Tankstelle darüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
