                                    {
                                        "sense_id": "14e791e7-0e20-34d3-83b4-3474e8884233",
                                        "entry_id": "5b8bc1b7-523d-3adf-a8dc-231240936272",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de excuser."
                                        ],
