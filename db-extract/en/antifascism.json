                "entry_id": "6d90f12a-48b4-357a-b8d4-81e2e543e423",
                "word": "antifascism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8f771eaa-7bc8-4150-b209-342c559fa049",
                        "entry_id": "6d90f12a-48b4-357a-b8d4-81e2e543e423",
                        "tags": [
                            "plural"
                        ],
                        "form": "antifascisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46805511-abdc-3f6c-8838-2341dc08b6ce",
                        "entry_id": "6d90f12a-48b4-357a-b8d4-81e2e543e423",
                        "glosses": [
                            "Opposition to fascism"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2d14d2-6faa-46fe-b5ad-7b71de0e971e",
                                "sense_id": "46805511-abdc-3f6c-8838-2341dc08b6ce",
                                "text": "In fostering a politics that linked antifascism abroad with antiracism at home, the “radical left” (including but not restricted to Communists) thus “redefined the debate over white supremacy and hastened its end.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76c57b7b-09dc-4229-aaeb-4b66dd2ef186",
                        "source_entry_id": "6d90f12a-48b4-357a-b8d4-81e2e543e423",
                        "source_sense_id": "46805511-abdc-3f6c-8838-2341dc08b6ce",
                        "source_sense_description": "opposition to fascism",
                        "target_lang_word": "antifašismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifašismus",
