                        "examples": [
                            {
                                "example_id": "dd1f202a-1822-4eb9-8b23-e8ddb60cec8d",
                                "sense_id": "b175ca0e-c4c3-39de-9da6-fc3666c49115",
                                "text": "Elle amassa de grands trésors dont elle bâtit la troisième pyramide où elle se fit ensépulturer avec six de ses amants."
                            },
                            {
                                "example_id": "527f5025-fff2-4574-ab99-308a9ff898a5",
                                "sense_id": "b175ca0e-c4c3-39de-9da6-fc3666c49115",
                                "text": "Bientôt ils partirent pour se rendre dans la ville Sainte, où mourut l'épouse de Raoul. Elle fut honorablement ensépulturée."
                            }
                        ]
