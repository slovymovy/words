                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b4084c-8b6f-4204-b305-9c5d06f8239c",
                                "sense_id": "eb7a0c64-aba8-39db-b347-478dc6b69e87",
                                "text": "Il se pourrait fort que les plus remontés d’entre nous, les plus marqués à gauche, et je suis de ceux-là, se découvrent un lien, fût-il des plus ténus — mais l’aragne a besoin de tous les fils pour refermer son piège —, avec l’énergumène omniprésidentiel."
                            },
                            {
                                "example_id": "fe8be825-760a-4df3-871a-31e3ea29f17b",
                                "sense_id": "eb7a0c64-aba8-39db-b347-478dc6b69e87",
                                "text": "Mais la date de l’intervention omniprésidentielle à Versailles, devant le Congrès, a été modifiée."
                            }
                        ]
