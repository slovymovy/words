                    {
                        "sense_id": "89b1797a-c3f7-3989-94be-91da70b33be2",
                        "entry_id": "904f0f6e-9adc-3b1c-ba47-b5d11e32334d",
                        "glosses": [
                            "Se restaurer tout seul, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b66b46a-0b10-46ee-a711-e4a480a4409b",
                                "sense_id": "89b1797a-c3f7-3989-94be-91da70b33be2",
                                "text": "S'autorestaurer, cela implique de trouver la fuite et de la réparer."
                            },
                            {
                                "example_id": "0ae2b178-9079-458d-9346-9cbaa27eee54",
                                "sense_id": "89b1797a-c3f7-3989-94be-91da70b33be2",
                                "text": "L’alternance de pluies violentes et de périodes de sécheresse a rendu les milieux aquatiques méditerranéens très dynamiques et, en particulier, capables de « s'autorestaurer » (capacité parfois compromise par des travaux divers : digue, rétrécissement, barrage…)."
                            },
                            {
                                "example_id": "e0706076-d32f-40bf-9495-bd094af3b08c",
                                "sense_id": "89b1797a-c3f7-3989-94be-91da70b33be2",
                                "text": "Cela confère à la couche souplesse et élasticité, la rend moins sujette aux dommages et plus résistante à la lumière et à l'acide, et lui donne la capacité de s'autorestaurer après déformation."
                            }
                        ]
                    }
