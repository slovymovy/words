                "translations": [
                    {
                        "translation_id": "b8a8c2d7-96d6-4f0a-99c0-1b0a30d53faf",
                        "source_entry_id": "d9afbf21-2950-3f02-8976-acc28308caa4",
                        "source_sense_id": "2bb3e879-4efe-349b-a78d-dabeb2816ee0",
                        "source_sense_description": "een doek om de neus in te snuiten",
                        "target_lang_word": "Taschentuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschentuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                        "entry_id": "70b01a1c-f194-3468-89a2-d0b765d8e3a5",
                                        "glosses": [
                                            "ein Tuch, mit dem man sich die Nase putzen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac2beb3-df14-4eb0-a12d-56bb82d6100b",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "Brauchst du ein Taschentuch?"
                                            },
                                            {
                                                "example_id": "7d4bcdc9-e2ea-43db-803a-143dbfd802ea",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Mrs. Hawkins stand am Kamin und zerknüllte ein Taschentuch zwischen ihren Händen, und die Tränen liefen ihr über die Wangen.“"
                                            },
                                            {
                                                "example_id": "c862fd04-91cd-425c-ba8f-eacb2f8e7046",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Der Mann nahm ein Taschentuch aus einer Hosentasche und trocknete die Tränen, und dann kam er auf mich zu und wollte auch mich sofort umarmen.“"
                                            },
                                            {
                                                "example_id": "d220cd75-9fdc-44f8-ac38-1bfa214a5b18",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Und nun verstummte er und zog sein Taschentuch hervor und wischte sich die Stirn.“"
                                            },
                                            {
                                                "example_id": "2dda0bb0-abfa-4920-b162-d2c6363b3593",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Er zieht ein Taschentuch mit einer Krone heraus und wischt sich den Staub aus dem Gesicht, darauf nimmt er eine Zigarrentasche mit Krone heraus und zündet sich eine Zigarre an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b1c744d-d6a1-4476-9380-abd8f41fe8bb",
