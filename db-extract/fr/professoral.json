                "senses": [
                    {
                        "sense_id": "6adca8e0-bc2f-3481-aa79-4bea5c211c74",
                        "entry_id": "2003f0a6-60ef-3d4b-b221-8dae19f99e7d",
                        "glosses": [
                            "Relatif à la qualité ou à la condition de professeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba52d3c8-6475-4187-b712-cdb1f31057fa",
                                "sense_id": "6adca8e0-bc2f-3481-aa79-4bea5c211c74",
                                "text": "Notre moniteur avait entretenu une liaison épisodique avec Sylvia du temps où elle habitait en région parisienne. […]. Il semble que ce don Juan des courts ait profité de sa fonction professorale pour séduire un grand nombre de ses élèves."
                            },
                            {
                                "example_id": "7e7ae97e-09a6-4453-be3e-0222205ecf70",
                                "sense_id": "6adca8e0-bc2f-3481-aa79-4bea5c211c74",
                                "text": "Un ton professoral."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a8aebff-4103-4688-81ff-e7d553aca86c",
                        "source_entry_id": "2003f0a6-60ef-3d4b-b221-8dae19f99e7d",
                        "source_sense_id": "6adca8e0-bc2f-3481-aa79-4bea5c211c74",
                        "target_lang_word": "professoral",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
