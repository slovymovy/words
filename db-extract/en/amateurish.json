                                "target_senses": [
                                    {
                                        "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                        "entry_id": "b4b30a65-808b-3995-9e94-324f8a28155f",
                                        "glosses": [
                                            "wegen mangelnder Sorgfalt oder Unkenntnis schlecht ausgeführt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85da97ad-ba02-4a9f-a8cd-a5aa91e6e9df",
                                                "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                                "text": "„Das Gericht sah es als erwiesen an, dass er acht Patienten durch stümperhafte Operationen und Begleitumstände teilweise in Lebensgefahr gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "50886b99-ff35-4c2b-818f-fa049835286e",
                                                "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                                "text": "„Der erste Teil spielt 1960 in Great Falls und beschreibt, wie Dell Parsons’ Kleinbürgereltern […] dazu kamen, den stümperhaftesten Banküberfall der Literaturgeschichte zu begehen.“"
                                            },
                                            {
                                                "example_id": "b66ca995-23c7-4a13-a15a-50203aa40a10",
                                                "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                                "text": "„Weder Christodulos noch seine Frau verstehen ein Wort Deutsch, während ihr Sohn Dimitri, der Fremdenführer ist, alle Mundarten Europas versteht und stümperhaft spricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8e860a2-e4fb-4ffa-974f-e8f4dd1b0be1",
                        "source_entry_id": "aa8fddeb-0dc4-316e-a2b3-fa1073d5d174",
                        "source_sense_id": "cfec0f8c-9a6e-3165-bdd5-31410039d6b3",
                        "source_sense_description": "reflecting the efforts of an amateur",
                        "target_lang_word": "laienhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laienhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "552835ba-39f5-39ee-80dc-9b30e835da8b",
                                        "entry_id": "6f7bac73-33a3-302b-8c3e-8e8ecb21b066",
                                        "glosses": [
                                            "unkundig, fehlendes Fachwissen zeigend, in der Art eines Laien seiend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b8251b3-71f9-4e56-9afe-2ed63289e239",
                                                "sense_id": "552835ba-39f5-39ee-80dc-9b30e835da8b",
                                                "text": "Für die laienhaften Kommentare meines Bruders habe ich mich fremdgeschämt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec80c0ba-bcc5-4dd1-9195-46cb7a7daa60",
                        "source_entry_id": "aa8fddeb-0dc4-316e-a2b3-fa1073d5d174",
                        "source_sense_id": "cfec0f8c-9a6e-3165-bdd5-31410039d6b3",
                        "source_sense_description": "reflecting the efforts of an amateur",
                        "target_lang_word": "amateurhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amateurhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "487243fe-ea73-3980-b530-e749a0fea28d",
                                        "entry_id": "1cbde087-d402-307d-8851-891d7d933bee",
                                        "glosses": [
                                            "auf unprofessionelle Art und Weise ausgeführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e24c5624-2128-4407-b81d-de6b29170810",
                                                "sense_id": "487243fe-ea73-3980-b530-e749a0fea28d",
                                                "text": "„Hinter ihr an der Wand hing ein amateurhaftes Gemälde, das eine alte Dame zeigte, in einem verzierten antiken Rahmen.“"
                                            },
                                            {
                                                "example_id": "6e8ea2b6-47f1-4b2f-8933-92700d430382",
                                                "sense_id": "487243fe-ea73-3980-b530-e749a0fea28d",
                                                "text": "„Das Adrenalin rauschte durch seine Venen. Eine eher amateurhafte Regung, die ihm überhaupt nicht gefiel.“"
                                            },
                                            {
                                                "example_id": "482693cb-6a91-4ff1-b0f1-633d32cb0e40",
                                                "sense_id": "487243fe-ea73-3980-b530-e749a0fea28d",
                                                "text": "„Männer mit Maschinenpistolen bei einem derart amateurhaften Verhalten zu beobachten, hatte auf ihn in etwa dieselbe Wirkung, als ob jemand mit den Fingernägeln über eine Schiefertafel kratzte.“"
                                            },
                                            {
                                                "example_id": "51bd5833-9f77-4dcc-ab20-211a852fa81d",
                                                "sense_id": "487243fe-ea73-3980-b530-e749a0fea28d",
                                                "text": "„Der US-amerikanische Konsul zitierte Bulls Expertenmeinung: ›Die Jordanier gingen besonders amateurhaft und die Israelis besonders professionell vor.‹“"
                                            },
                                            {
                                                "example_id": "9a1ed904-cc9f-408b-ad79-5bc42e12725f",
                                                "sense_id": "487243fe-ea73-3980-b530-e749a0fea28d",
                                                "text": "„Wenn es mir gelänge, eine größere Bandbreite von Opfern zu finden, könnte ich ein gewisses Tatmuster entwickeln und würde, wenn es schließlich zum Prozess käne, keinen ganz so amateurhaften Eindruck mehr machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
