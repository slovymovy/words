                ],
                "senses": [
                    {
                        "sense_id": "bab912e1-4123-3bac-8309-01d24ad5ff0f",
                        "entry_id": "70d7c35c-baa9-36b1-ade0-bb80d89c2856",
                        "glosses": [
                            "Fleuve de l’ouest de la France."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "398dd8c5-ef51-4bb8-ae18-10ea688777bc",
                                "sense_id": "bab912e1-4123-3bac-8309-01d24ad5ff0f",
                                "text": "Au départ du petit port de Soubise, une randonnée vélo de 10 kilomètres fait cheminer le long de la Charente."
                            },
                            {
                                "example_id": "dd4cafb3-9ecb-41ed-8d96-9e670878a6a9",
                                "sense_id": "bab912e1-4123-3bac-8309-01d24ad5ff0f",
                                "text": "Les poissons qu'on trouve dans la Charente sont la tanche, la truite, l’anguille, la plie, le barbeau, le chabot, l’âton, le dard, la brème, le goujon, l’ablette et l’écrevisse. Ceux qui remontent de la mer sont la lamproie, le meuil, qui s'arrêtent le plus ordinairement à Jarnac; la gathe, et rarement l’alose."
                            },
                            {
                                "example_id": "d836f048-5b04-4698-8bfd-6d975d85eb2e",
                                "sense_id": "bab912e1-4123-3bac-8309-01d24ad5ff0f",
                                "text": "Pour l’occasion, Hajime Isayama, auteur du manga phénomène, a fait le déplacement jusqu’aux rives de la Charente."
                            }
                        ]
                    },
                    {
                        "sense_id": "30b6aaab-ef98-336f-92fb-5a8f2a331d9d",
                        "entry_id": "70d7c35c-baa9-36b1-ade0-bb80d89c2856",
                        "glosses": [
                            "Département français de la région Nouvelle-Aquitaine, et qui porte le numéro 16."
                        ],
                        "tags": [
                            "Administration",
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "730a28d4-68bc-4397-9ed0-5317d6c5b4cf",
                                "sense_id": "30b6aaab-ef98-336f-92fb-5a8f2a331d9d",
                                "text": "À partir de là, le chemin se poursuit sur une autre rando, le circuit des puits et des fontaines, menant jusqu’à Marsac, en Charente."
                            },
                            {
                                "example_id": "0529c92a-4e0c-4eb0-b51c-47b502834f31",
                                "sense_id": "30b6aaab-ef98-336f-92fb-5a8f2a331d9d",
                                "text": "Martine Clavel, nouvelle préfète de la Charente, prendra ses fonctions le mardi 23 août."
                            }
                        ]
                    }
                ],
