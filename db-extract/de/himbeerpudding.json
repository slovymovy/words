                ],
                "senses": [
                    {
                        "sense_id": "7447a331-c468-3f59-8e7d-72c8388d3933",
                        "entry_id": "7b1200dc-ade6-38af-9cfa-2ece67b25ade",
                        "glosses": [
                            "Pudding mit Himbeergeschmack"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ee4e64-7502-4e60-9aa2-a6267fca860c",
                                "sense_id": "7447a331-c468-3f59-8e7d-72c8388d3933",
                                "text": "„Durch Experimentieren bemerkten wir, dass durch Vermischen von Vanille- und Himbeerpudding ein schöner Hautton entsteht.“"
                            },
                            {
                                "example_id": "7ac05429-4ad4-4ba0-ad7e-2557883f1c1c",
                                "sense_id": "7447a331-c468-3f59-8e7d-72c8388d3933",
                                "text": "„Wackelt dort ein Himbeerpudding, der sich eilends von seinem Sockel aus dem Scheinwerferlicht ins Dunkle retten wird?“"
                            },
                            {
                                "example_id": "4b809c4c-d7cd-4e73-9afa-a436a9f08665",
                                "sense_id": "7447a331-c468-3f59-8e7d-72c8388d3933",
                                "text": "Dieser Himbeerpudding schmeckt köstlich."
                            },
                            {
                                "example_id": "b3be55d4-6c31-45ec-aa8d-70d8446e7bf8",
                                "sense_id": "7447a331-c468-3f59-8e7d-72c8388d3933",
                                "text": "„Wird der Himbeerpudding für die Mitarbeiter auch aus der Presseförderung finanziert, die \"Zur Zeit\" jetzt erhält?“"
                            },
                            {
                                "example_id": "21088882-9cf5-4743-a2c3-5683fe08da6f",
                                "sense_id": "7447a331-c468-3f59-8e7d-72c8388d3933",
                                "text": "„Aromatische Himbeeren liefern fruchtige Glücksgefühle und machen den Himbeerpudding zu einem ganz besonderen Geschmackserlebnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
