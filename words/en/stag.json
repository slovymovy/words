                },
                {
                    "sense_id": "35f75f83-c50a-3685-a33c-39515d4f3b11",
                    "sense_definition": "A bull or ram castrated late in life or improperly castrated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer separated the aggressive <w>stag</w> from the rest of the herd.",
                            "target_lang_translations": {
                                "ru": "Фермер отделил агрессивного <w>кастрированного быка</w> от остального стада."
                            }
                        },
                        {
                            "text": "Because it was castrated late, the <w>stag</w> retained coarse male characteristics.",
                            "target_lang_translations": {
                                "ru": "Из-за поздней кастрации <w>бык</w> сохранил грубые повадки самца."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Agricultural term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бык или баран, кастрированный в зрелом возрасте либо неправильно оскоплённый."
