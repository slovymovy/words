                "senses": [
                    {
                        "sense_id": "0ae9c060-f9b3-32ae-9abb-76da34ed0ba9",
                        "entry_id": "a225e355-58c3-3173-853e-4b49f97c0d90",
                        "glosses": [
                            "to pull (at something), to finger, to play with, to pinch, to pluck (at)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f173568a-c30b-4cc9-b363-048c0ac52d41",
                                "sense_id": "0ae9c060-f9b3-32ae-9abb-76da34ed0ba9",
                                "text": "Не перестава́я плыть в бескро́вной, ры́бьей улы́бке, он непроизво́льно су́нул одну́ ру́ку в карма́н ку́ртки, друго́й не́рвно, в предчу́вствии кро́ви тереби́л шарф.",
                                "translation": "Viktor Astafyev",
                                "english": "Viktor Astafyev"
                            }
                        ]
                    },
