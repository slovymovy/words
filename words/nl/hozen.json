{
    "word_family": [
        "hoos"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2546bb3c-f8b4-3d55-b64a-a84889e07c4c",
                    "sense_definition": "water uit een boot of kelder scheppen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "water_verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boot lekt, dus er moet veel <w>gehoosd</w> worden.",
                            "target_lang_translations": {
                                "ru": "Лодка протекает, поэтому приходится много <w>вычерпывать</w> воду."
                            }
                        },
                        {
                            "text": "We moesten de hele nacht <w>hozen</w> om de boot drijvend te houden.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось всю ночь <w>вычерпывать</w> воду, чтобы удержать лодку на плаву."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheppen"
                    ],
                    "common_phrases": [
                        "water hozen"
                    ],
                    "target_lang_definitions": {
                        "ru": "вычерпывать воду из лодки или подвала"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычерпывать",
                                "target_lang_sense_clarification": "удалять воду из емкости или судна"
                            },
                            {
                                "target_lang_word": "откачивать",
                                "target_lang_sense_clarification": "удалять воду с помощью насоса или ведра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93fec839-589d-3849-a0df-4e91b73cf9e4",
                    "sense_definition": "zeer hard regenen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het heeft vanmiddag <w>gehoosd</w>, ik ben er kletsnat van geworden!",
                            "target_lang_translations": {
                                "ru": "Днем так <w>лило как из ведра</w>, что я промок до нитки!"
                            }
                        },
                        {
                            "text": "Blijf maar binnen, want het <w>hoost</w> buiten enorm.",
                            "target_lang_translations": {
                                "ru": "Лучше оставайся дома, потому что на улице ужасно <w>льет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stortregenen",
                        "gieten"
                    ],
                    "common_phrases": [
                        "het hoost"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень сильный дождь, ливень"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лить как из ведра",
                                "target_lang_sense_clarification": "идиома для описания очень сильного дождя"
                            },
                            {
                                "target_lang_word": "ливмя лить",
                                "target_lang_sense_clarification": "очень интенсивный, проливной дождь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}