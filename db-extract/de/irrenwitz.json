                ],
                "senses": [
                    {
                        "sense_id": "46740a27-bae6-3692-b0d0-eda8e56c433e",
                        "entry_id": "1316e460-b496-3a25-a01e-d0c0191950a8",
                        "glosses": [
                            "Witz mit einem oder mehreren Geisteskranken als Protagonisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9858e4c-03b8-4991-a530-cb950bbeee64",
                                "sense_id": "46740a27-bae6-3692-b0d0-eda8e56c433e",
                                "text": "„Für zartbesaitete Gemüter schicken wir voraus, daß es uns fernliegt, das Unglück bedauernswerter Geisteskranker zum Gespött zu machen; aber es ist unmöglich, den Irrenwitz zu ignorieren, wenn man auch nur eine einigermaßen vollständige Übersicht über die Vielfalt der Witze geben will.“"
                            },
                            {
                                "example_id": "f500a9cc-9e25-40d2-9c22-85ee3332f3a4",
                                "sense_id": "46740a27-bae6-3692-b0d0-eda8e56c433e",
                                "text": "„Da es von psychiatrischer Seite als unfair empfunden wird, über die eigenen Patienten zu lachen, schlagen die Autoren vor, statt ›Idiotenwitze‹ lieber ›Irrenwitze‹ zu sagen.“"
                            },
                            {
                                "example_id": "4cd83140-5f35-44dc-b757-2f47faa52763",
                                "sense_id": "46740a27-bae6-3692-b0d0-eda8e56c433e",
                                "text": "„Auch der berühmteste Irrenwitz der Fünfzigerjahre beruht auf einem logischen Kurzschluss.“"
                            },
                            {
                                "example_id": "ed9122c2-541e-4d4c-a0a9-476aeb9c354d",
                                "sense_id": "46740a27-bae6-3692-b0d0-eda8e56c433e",
                                "text": "„Drittens sind Irren- und Trottelwitze die einzigen narrensicheren Treffpunkte, an denen sich in Deutschland die Intellektuellen und der Mann aus dem Volke gleichermaßen erheitert begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
