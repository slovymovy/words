            {
                "entry_id": "99d801f6-75a7-3f50-8216-2ef4e8eed274",
                "word": "face-à-main",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4677c155-9b58-4b7d-9793-3f7e4f70d8df",
                        "entry_id": "99d801f6-75a7-3f50-8216-2ef4e8eed274",
                        "tags": [
                            "plural"
                        ],
                        "form": "faces-à-main"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1843401d-dd71-332a-9616-cf12bfd5034b",
                        "entry_id": "99d801f6-75a7-3f50-8216-2ef4e8eed274",
                        "glosses": [
                            "Binocle à manche dont on se sert en le tenant à la main."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "787221fe-91cf-4ca4-ac6d-9f155816c9f7",
                                "sense_id": "1843401d-dd71-332a-9616-cf12bfd5034b",
                                "text": "La comtesse avait horreur des effusions ; elle réfugia sa bienséance derrière un face-à-main."
                            },
                            {
                                "example_id": "e0bf354a-2982-4598-97ec-8a47ec1480da",
                                "sense_id": "1843401d-dd71-332a-9616-cf12bfd5034b",
                                "text": "Au bout d’une semaine, ma mère passa par là, s’arrêta, saisie, regarda de tous ses yeux —un binocle, un face-à-main, des lunettes pour le lointain— et cria d’horreur, en violant du pied toutes les sépultures…"
                            },
                            {
                                "example_id": "3dbe2b7c-1bfe-453e-8e44-b068a9c4e454",
                                "sense_id": "1843401d-dd71-332a-9616-cf12bfd5034b",
                                "text": "Plus de frissonnements de soie, ni de rires hystériques sous les voilettes, ni de gestes charmants et parfumés de jolis bras et de mains fines jouant avec un face-à-main ou même une lorgnette de théâtre."
                            },
                            {
                                "example_id": "d8e89ce6-4158-4a2a-9a9b-96311b3f6c7c",
                                "sense_id": "1843401d-dd71-332a-9616-cf12bfd5034b",
                                "text": "Sa maman lui donna un coup léger de son face-à-main. « Je suis fière de mon petit garçon. »"
                            },
                            {
                                "example_id": "d9e8ada8-6acf-4f32-8507-75b9c3e9ed80",
                                "sense_id": "1843401d-dd71-332a-9616-cf12bfd5034b",
                                "text": "Il faut dire que Maman était distraite avec tout le monde, distraite et vague, toujours un peu décoiffée, tenant d’une main son face-à-main, de l’autre un livre, une large écharpe de fourrure, ou de soie, glissant de ses épaules tombantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05feace7-cbb7-4e20-b75e-55f9bcfa3605",
                        "source_entry_id": "99d801f6-75a7-3f50-8216-2ef4e8eed274",
                        "source_sense_id": "1843401d-dd71-332a-9616-cf12bfd5034b",
                        "target_lang_word": "Lorgnon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lorgnon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                        "entry_id": "6349b85f-3207-3322-a843-32517c00775e",
                                        "glosses": [
                                            "Sehhilfe für ein Auge, die mit einem Stiel vor das Auge gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54488105-0312-4260-ab9d-74515242097f",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "Ich brauche zum Lesen mein Lorgnon."
                                            },
                                            {
                                                "example_id": "575475dc-ee3d-4b18-9f24-51740524efee",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Im abgedunkelten Bibliothekszimmer meines verstorbenen Vaters - in den Kriegsnächten - beschwor er sie in improvisierten Gespensternoveletten, während geisterhaft Rainer Maria Rilke ihm vom Diwan durch sein Lorgnon zusah.“"
                                            },
                                            {
                                                "example_id": "7971a1da-b104-4a12-aeba-9b8bc97c7dcb",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Der Hausherr selbst hatte eine Adlernase und trug das einzige wirkliche Lorgnon, das ich jemals in meinem Leben auf einer Bauernnase gesehen habe.“"
                                            },
                                            {
                                                "example_id": "6630d18d-4587-4991-8617-66152dff46d9",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Fräulein Oppermann hielt sich etwas vor die Augen, das ich nur aus alten Romanen kannte, ein Lorgnon, und musterte mich wie eine aufgespießte Spinne.“"
                                            },
                                            {
                                                "example_id": "8373b173-4b0c-46f4-8a5e-2d36ae25ab61",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Die beiden Burschen konfiszierten ein Lorgnon meiner Großmutter, über dessen Verlust sie bis zum Ende ihres Lebens in den Sechzigerjahren klagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48736852-b740-4d15-a33f-065e16d01cbc",
                        "source_entry_id": "99d801f6-75a7-3f50-8216-2ef4e8eed274",
