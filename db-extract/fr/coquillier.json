                    {
                        "sense_id": "e4c7e2c5-4c09-31ed-a522-a07d9a90130e",
                        "entry_id": "72826480-4051-339c-b22a-2a15cda48d0f",
                        "glosses": [
                            "Collection de coquilles ou le meuble où on les rassemble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380c3bc0-2299-4516-960b-a085d0c0e6ba",
                                "sense_id": "e4c7e2c5-4c09-31ed-a522-a07d9a90130e",
                                "text": "Son Altesse Sérénissime Monseigneur le Prince de Condé possède dans son coquillier la plus belle & la plus grande conque exotique."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b6324ab-a4de-3851-bf9b-1f178fa6474c",
                        "entry_id": "72826480-4051-339c-b22a-2a15cda48d0f",
                        "glosses": [
                            "Bateau de pêche utilisé pour le dragage de la coquille Saint-Jacques."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "c2985f70-7994-4f0a-b7ff-30f23a5c7f36",
                                "sense_id": "5b6324ab-a4de-3851-bf9b-1f178fa6474c",
                                "text": "Et voilà que la perfide Albion pourrait nous empêcher de « draguer » la coquille au large de ses côtes, pile-poil alors que la récolte s’annonce « exceptionnelle » : jamais les cales de nos 200 coquilliers n’ont été aussi pleines."
                            }
                        ]
                    },
                    {
                        "sense_id": "7457e849-1fb7-36f6-8967-5a58ade1a4b3",
                        "entry_id": "72826480-4051-339c-b22a-2a15cda48d0f",
                        "glosses": [
                            "Pécheur de coquille Saint-Jacques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7495d5b4-8c0c-4021-bacb-5cb249b5be0a",
                                "sense_id": "7457e849-1fb7-36f6-8967-5a58ade1a4b3",
                                "text": "Président du Comité local des Pêches de l’Ouest Cotentin, André Piraud est coquillier, pêcheur de coquilles."
                            }
                        ]
                    }
