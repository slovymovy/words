    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7d6ca86-b5c5-3e3b-8004-6bdf60a5c14f",
                    "sense_definition": "To select or enroll people onto a jury or committee to investigate or decide a case.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jury_selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court will <w>empanel</w> a jury next Monday to hear the complex fraud case."
                        },
                        {
                            "text": "Officials decided to <w>empanel</w> a special committee to investigate safety violations across the industry."
                        }
                    ],
                    "synonyms": [
                        "impanel",
                        "enroll"
                    ],
                    "common_phrases": [
                        "empanel a jury",
                        "empanel a grand jury"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61c12715-e81b-3d9f-ba4e-ca308923229c",
                    "sense_definition": "A formal list containing the names of people selected or summoned to serve on a jury.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jury_selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk consulted the official <w>empanel</w> before calling out names in the courtroom."
                        },
                        {
                            "text": "Several names were struck from the <w>empanel</w> due to existing conflicts of interest."
                        }
                    ],
                    "synonyms": [
                        "panel",
                        "roster"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to refer to the jury list itself"
                        }
                    ]
                }
            ]
        }
