                "senses": [
                    {
                        "sense_id": "8cfe675a-1670-356e-9e9b-488e67f5fd6c",
                        "entry_id": "353ee27b-8e2a-3457-a5c4-3d801b2453c3",
                        "glosses": [
                            "Verehrer der Filmkunst und Kenner der Filmgeschichte"
                        ],
                        "tags": [
                            "sehr selten"
                        ],
                        "examples": [
                            {
                                "example_id": "5cdaffb4-f513-4465-a20c-6f1f5734ff8a",
                                "sense_id": "8cfe675a-1670-356e-9e9b-488e67f5fd6c",
                                "text": "„Sie blieben jedoch nicht lange dabei, zum einen weil er eben doch kein so begeisterter Kineast ist, zum anderen weil sie sich durch die Frau in der Gruppe abgelehnt fühlte, was ihm selbst zwar nicht aufgefallen war, andererseits wiederum nichts besagen muss.“"
                            },
                            {
                                "example_id": "a9bf8871-7d27-41da-912d-761c65283c92",
                                "sense_id": "8cfe675a-1670-356e-9e9b-488e67f5fd6c",
                                "text": "„Macbeth (1948), Othello (1953) und Chimes ar Midnight bzw. Falstaff (1965) bekamen zwar vereinzeltes Kritikerlob und gelten bei vielen Kineasten und Forschern heute als Meisterwerke, wurden aber in öffentlichen Kinos kaum bis gar nicht gezeigt.“"
                            },
                            {
                                "example_id": "eff4fc00-7271-40c6-8cb2-ec0c832eb4b9",
                                "sense_id": "8cfe675a-1670-356e-9e9b-488e67f5fd6c",
                                "text": "„Kineasten mögen die Filme oder Handlungsdetails wiedererkennen, Unkundige mögen glauben, der Autor habe die Handlung dieser übrigen Filme erfunden und in den Mund Molinas gelegt, um die motivische Gemeinsamkeit der unterschiedlichen Filme zu bewahren.“"
                            },
                            {
                                "example_id": "bc92f895-14d0-467f-95de-43471f84694d",
                                "sense_id": "8cfe675a-1670-356e-9e9b-488e67f5fd6c",
                                "text": "„Auch Kineasten waren von der innovativen Regie von Tykwer begeistert und der Filmschnitt-Technik mit doppelt-Espresso Adrenalin, die normalerweise Computerspielen und Zeichentrickfilmen vorbehalten bleibt.“"
                            },
                            {
                                "example_id": "0328a1e6-8d97-4363-b81f-b57b7b841910",
                                "sense_id": "8cfe675a-1670-356e-9e9b-488e67f5fd6c",
                                "text": "„Wahrscheinlich war das einer der Gründe, wenn nicht der Grund, weswegen ausgerechnet der Autorenfilmer Fellini bei den leidenschaftlichen und unterhaltungssüchtigen Kinogängern beliebter war als bei den professionellen Kineasten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
