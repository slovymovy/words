                    "sense_id": "14081ebd-b3ec-388c-bf79-8978de11d6d5",
                    "sense_definition": "Sichtbarer Luftraum über der Erde, an dem Sonne, Mond und Sterne erscheinen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "atmosphaere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heute ist der <w>Himmel</w> wolkenlos und wunderschön blau."
                        },
                        {
                            "text": "Im Sommer schlafen wir gerne draußen unter freiem <w>Himmel</w>."
                        }
                    ],
