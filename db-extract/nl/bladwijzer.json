                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„Es lag einfach so zwischen zwei Seiten, wie ein Lesezeichen.“"
                                            },
                                            {
                                                "example_id": "6b394a8b-3f5d-4e77-898e-7c4b12c85660",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„Aus dem Inhalt der Lesezeichen geht zudem unzweifelhaft hervor, dass Steinberg, was auch den späteren Verbleib der Handschrift erklärt, ihr Besitzer gewesen sein muss.“"
                                            },
                                            {
                                                "example_id": "358609cc-cb5c-4784-8906-ac5ca6c14884",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„Neben mir das Tagebuch mit dem Lesezeichen auf dem Nachttisch, genauso, wie ich es neben den Wecker gelegt habe.“"
                                            },
                                            {
                                                "example_id": "d7bf6b67-b28b-475f-8fd9-58807b04480a",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„In diese Schriftstücke waren Hunderte von bunten Lesezeichen geklemmt, die in den Windwellen der Ventilatoren raschelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
