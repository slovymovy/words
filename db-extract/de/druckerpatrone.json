                                        "entry_id": "7ae2b2c3-ff0f-3ea4-a2a2-7edea5151012",
                                        "glosses": [
                                            "A user-replaceable container with one or more ink reservoirs that is designed to fit in the cartridge slot of an inkjet printer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a4a1b9-fec6-4934-9084-2d7168ca1ddb",
                                                "sense_id": "33fd8dea-7981-3d66-97fd-2efe61ef2d80",
                                                "text": "With most bubble-jet printers, the ink cartridge contains the printhead and the ink."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f33bb720-62ab-44f7-814f-155c573a6418",
                        "source_entry_id": "7dcb697a-ccca-35a4-9e69-391d00c5ad36",
                        "source_sense_id": "2de1cc29-dafe-3485-a190-ef75789759cb",
