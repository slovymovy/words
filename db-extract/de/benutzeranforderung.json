                "senses": [
                    {
                        "sense_id": "8180b4b1-51e0-3ce9-b3f4-db7e1de23475",
                        "entry_id": "78fc81a3-aaf6-3241-ad79-9c3d3afa3eb4",
                        "glosses": [
                            "die Anforderung eines Benutzers an ein Gerät oder ein System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c80b52-df1f-4cb7-9442-1e160f4d93c2",
                                "sense_id": "8180b4b1-51e0-3ce9-b3f4-db7e1de23475",
                                "text": "„Zusammenfassend lässt sich feststellen, dass die FASMI-Regeln stärker auf Benutzeranforderungen als auf technische Anforderungen eingehen.“"
                            },
                            {
                                "example_id": "4db155d3-7013-4221-a263-35c160ed3ef4",
                                "sense_id": "8180b4b1-51e0-3ce9-b3f4-db7e1de23475",
                                "text": "„Benutzeranforderungen sind aus Benutzersicht formulierte funktionale Anforderungen und somit auf einem höheren Abstraktionsniveau beschrieben. Nur auf Basis von mehreren Benutzeranforderungen wären Sie allerdings nicht in der Lage, eine hoch qualitative, komplexe und performante mobile App implementieren zu können. Sie benötigen deutlich präzisere Angaben, Informationen und Details. Dazu werden die Benutzeranforderungen zu Systemanforderungen verfeinert, […]“"
                            },
                            {
                                "example_id": "ec30bd74-0174-4dc2-831f-f53a46d27a7e",
                                "sense_id": "8180b4b1-51e0-3ce9-b3f4-db7e1de23475",
                                "text": "„Die Benutzeranforderungen müssen in der Sprache der Benutzer ausgedrückt werden, da ein technisches Hintergrundwissen nicht vorausgesetzt werden kann.“"
                            },
                            {
                                "example_id": "f350c1c3-96e8-4790-8b30-54c84812a95b",
                                "sense_id": "8180b4b1-51e0-3ce9-b3f4-db7e1de23475",
                                "text": "„So können beispielsweise die vom Benutzer direkt erfassten Wünsche bzgl. des Systems zunächst in die Benutzeranforderungen strukturiert abgelegt werden, ohne technische Details zu berücksichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
