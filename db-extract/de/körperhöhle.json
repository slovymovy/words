                "senses": [
                    {
                        "sense_id": "526f96e6-d749-3b00-a3b1-b0ff7cf2e54e",
                        "entry_id": "bbd6a1e8-1be7-3fe6-8df2-432f9d6f6679",
                        "glosses": [
                            "(mit Epithel oder Mesothel ausgekleideter) Hohlraum innerhalb des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1a022a-1e15-4750-b2c4-44c666f37a9b",
                                "sense_id": "526f96e6-d749-3b00-a3b1-b0ff7cf2e54e",
                                "text": "„Wenn sich in einer Körperhöhle Flüssigkeit ansammelt, lässt sich an der Körperoberfläche eine Fluktuation der Flüssigkeit als fortlaufende Bewegung tasten, z. B. bei einem Abszess oder Aszites (Wasserbauch).“"
                            },
                            {
                                "example_id": "e625a674-0b37-49a0-a17a-8c992994aeee",
                                "sense_id": "526f96e6-d749-3b00-a3b1-b0ff7cf2e54e",
                                "text": "„Wissenschaftler stellen jetzt neue Vermutungen an, warum die Spermien bei Säugetieren außerhalb ihrer Körperhöhle produziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
