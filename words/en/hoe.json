                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman caught a <w>hoe</w> while casting his line near the reef.",
                            "target_lang_translations": {
