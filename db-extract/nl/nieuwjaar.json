                        ],
                        "examples": [
                            {
                                "example_id": "a760a775-984f-447a-bbcf-330288c002c2",
                                "sense_id": "cfa79fdc-45e1-3078-8c47-c1491b9a0687",
                                "text": "Het Chinese Nieuwjaar valt niet op 1 januari."
                            },
                            {
                                "example_id": "28ad5b65-77b6-4ca6-898e-648549c07901",
                                "sense_id": "cfa79fdc-45e1-3078-8c47-c1491b9a0687",
                                "text": "Met Nieuwjaar – de belangrijkste feestdag van het jaar – steken Russen ook graag zelf vuurwerk af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
