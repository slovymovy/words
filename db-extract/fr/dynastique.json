        "fr-extract.jsonl": [
            {
                "entry_id": "c7847926-0d10-30e3-b0c0-6eb8b55294be",
                "word": "dynastique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7af0517b-a6db-48c7-926f-94d4a3334925",
                        "entry_id": "c7847926-0d10-30e3-b0c0-6eb8b55294be",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "dynastiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d85f07ed-506c-318a-9fa6-56a7e019c893",
                        "entry_id": "c7847926-0d10-30e3-b0c0-6eb8b55294be",
                        "glosses": [
                            "Relatif à une dynastie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1fcc4f-0b6e-489f-a7a9-6d184daba9e5",
                                "sense_id": "d85f07ed-506c-318a-9fa6-56a7e019c893",
                                "text": "Ce conflit dynastique dégénérerait en guerre européenne. C'est pourquoi Dubois se pose en apôtre de la paix."
                            },
                            {
                                "example_id": "3de7f5f3-41b5-4961-a426-aaa64f042f4c",
                                "sense_id": "d85f07ed-506c-318a-9fa6-56a7e019c893",
                                "text": "L'Union ibérique réalisée sous Philippe ll est l'expression historiographique sous laquelle est désignée l'union dynastique des monarchies espagnole et portugaise de 1580 à 1640."
                            }
                        ]
                    },
                    {
                        "sense_id": "adc6ca97-a43c-3709-9d8c-ad6ef4d269da",
                        "entry_id": "c7847926-0d10-30e3-b0c0-6eb8b55294be",
                        "glosses": [
                            "Qualifia le parti d’opposition qui, dans un parlement, restait attaché au principe d’une dynastie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5eabb78-2908-4fb7-83ae-4792f0460932",
                                "sense_id": "adc6ca97-a43c-3709-9d8c-ad6ef4d269da",
                                "text": "Les partis dynastiques, par leur maladresse et leur mesquinerie, par leur oubli du véritable patriotisme, auront plus fait pour consolider la république en France, que les républicains les plus intelligents et les plus sincères n'auraient pu faire. A la vérité, les chinoiseries des monarchistes fatiguent les esprits qui restent toujours français ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f64c4938-0543-4e30-a272-43ffdcb0a410",
                        "source_entry_id": "c7847926-0d10-30e3-b0c0-6eb8b55294be",
                        "target_lang_word": "dynastisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynastisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70467b3b-c29d-3a05-a156-1adb79b26678",
                                        "entry_id": "f2359f3c-ce1e-3f2e-9e53-494daeedeae1",
                                        "glosses": [
                                            "auf die Dynastie bezogen, zur Dynastie gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1bc0b71-d205-4151-b59f-e52d1dfe6009",
                                                "sense_id": "70467b3b-c29d-3a05-a156-1adb79b26678",
                                                "text": "„Die Entstehung des modernen afghanischen Nationalstaats datiert die afghanische Geschichtsschreibung auf das Jahr 1747, als Ahmad Schah Durrani ein dynastisches Imperium gründete.“"
                                            },
                                            {
                                                "example_id": "442be593-14a4-43b5-be0a-d90b0d98d1b6",
                                                "sense_id": "70467b3b-c29d-3a05-a156-1adb79b26678",
                                                "text": "„Zugleich wurden Konstanze und Gottfried II. miteinander verlobt, um diesen Herrschaftswechsel dynastisch zu legitimieren.“"
                                            },
                                            {
                                                "example_id": "7abbf37b-7e56-447a-a7b8-7f42eeb52264",
                                                "sense_id": "70467b3b-c29d-3a05-a156-1adb79b26678",
                                                "text": "„Die Hindu-Untertanen brachten natürlich sehr viel mehr Verständnis für das «Gottesgnadentum» und das dynastische Charisma der Großmoguln auf.“"
                                            },
                                            {
                                                "example_id": "74222150-9ece-483b-905a-c576abd897cc",
                                                "sense_id": "70467b3b-c29d-3a05-a156-1adb79b26678",
                                                "text": "„So weisen alle Parteiorganisationen dynastische Züge auf und können jeweils mit einem Familienclan assoziiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
