                "senses": [
                    {
                        "sense_id": "cfff1bea-8524-3088-b4d4-c23cc0c284a1",
                        "entry_id": "e80ea835-b6d9-34ef-8bcd-b6f01bb20192",
                        "glosses": [
                            "Grube zur Lagerung von Abfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3703c118-04e8-4331-99a1-ce457e465a16",
                                "sense_id": "cfff1bea-8524-3088-b4d4-c23cc0c284a1",
                                "text": "„Zwischen unzähligen Tonscherben einer Abfallgrube stießen sie auf das Bruchstück eines Täfelchens, das sie in einiges Staunen versetzte: Auf beiden Seiten waren Zeichen der mykenischen Linear B-Schrift zu erkennen, deren bisher älteste Beispiele ungefähr 150 Jahre später entstanden waren.“"
                            },
                            {
                                "example_id": "cb7b9500-943e-4aa8-8cab-88a2dfe7635d",
                                "sense_id": "cfff1bea-8524-3088-b4d4-c23cc0c284a1",
                                "text": "„Die alte Tagebaufurche wurde währenddessen als Abfallgrube benutzt und mit allem verfüllt, was man nicht mehr gebrauchen konnte.“"
                            },
                            {
                                "example_id": "a83b2257-fbe0-4e62-a393-9e0b1a417185",
                                "sense_id": "cfff1bea-8524-3088-b4d4-c23cc0c284a1",
                                "text": "„So fanden sich im Grab eines zwölfjährigen Kindes hochwertige Keramiken und Steinwerkzeuge, während anderswo ein Säugling in einer Abfallgrube lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
