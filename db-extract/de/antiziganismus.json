                "senses": [
                    {
                        "sense_id": "1dad13fe-20e1-3e4f-ae20-945218e460e4",
                        "entry_id": "d5a68e2d-1495-3261-86d2-3472f82435dd",
                        "glosses": [
                            "antigypsyism"
                        ],
                        "tags": [
                            "masculine",
