                "senses": [
                    {
                        "sense_id": "83bae744-9327-3969-9b1b-1c72e2691828",
                        "entry_id": "6d096059-0e46-3426-985c-383f2797fa47",
                        "glosses": [
                            "ktoś stroniący od ludzi, czujący do nich niechęć lub wręcz wrogość"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "114a8b2f-6ec7-45dd-a85b-6a032b1467ef",
                                "sense_id": "83bae744-9327-3969-9b1b-1c72e2691828",
                                "text": "Od tego mizantropa z trzeciego piętra stronią nawet członkowie jego rodziny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
