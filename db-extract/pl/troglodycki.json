                                                "sense_id": "9da08245-00e6-3c26-9580-a2b8fb7d73a1",
                                                "text": "La côte troglodytique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9329d5b1-9741-3052-8623-6942a5337ff5",
                                        "entry_id": "49e2e5b0-3369-389b-b2c8-feb8caaa0415",
                                        "glosses": [
                                            "Qui est creusée dans la roche ou qui utilise une caverne, en parlant d’une habitation, d’une tombe, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b109ad-594e-4944-b434-300de9f6c6f9",
                                                "sense_id": "9329d5b1-9741-3052-8623-6942a5337ff5",
                                                "text": "Quelques-unes de ces tombes troglodytiques renferment, au dire du docteur Leipsius, le corps de plusieurs hauts personnages qui portent le titre singulier de : nourrice mâle d'un prince royal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e83fdc20-73eb-4222-9b71-49c109666e19",
                        "source_entry_id": "9c026842-4b0d-3c8b-a0ac-d5591261deea",
