                                            {
                                                "example_id": "c7a426fd-a36b-408c-b819-c160d5c36719",
                                                "sense_id": "704e268b-f394-30d4-9f7b-34986b3f3d58",
                                                "text": "Research on supporting detrans could enable a variety of interventions designed to help detrans people."
                                            },
                                            {
                                                "example_id": "2524bb32-9345-4fae-9b0a-d055e1d1a501",
                                                "sense_id": "704e268b-f394-30d4-9f7b-34986b3f3d58",
                                                "text": "They [detransitioners] find each other online: on Twitter, where they use the lizard emoji to signal their detrans status, […]"
                                            },
                                            {
                                                "example_id": "f3f88b5c-0e6e-4199-ad34-22a5600797e5",
                                                "sense_id": "704e268b-f394-30d4-9f7b-34986b3f3d58",
                                                "text": "The aim of this study is to analyze the specific needs of detransitioners from online detrans communities and discover to what extent they are being met."
