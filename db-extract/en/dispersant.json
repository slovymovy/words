                        "entry_id": "18f2f183-8d30-3429-9ee4-ccf8045df8ac",
                        "glosses": [
                            "Any substance that is used to prevent settling or clumping of particles suspended in a liquid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beaacf6c-9275-4cab-bc08-13160a1e8d7c",
                                "sense_id": "1dd14934-3af2-3e14-8489-a5de4e22f578",
                                "text": "Since the effectiveness of dispersants is time-critical, the sooner that concurrence can be obtained and the dispersant applied, the more effective such"
                            },
                            {
                                "example_id": "5fc7888f-9203-42b8-afb1-46dff765ea03",
                                "sense_id": "1dd14934-3af2-3e14-8489-a5de4e22f578",
                                "text": "Effects due to the dispersant solvent and surfactants in the water column may be surmised only from laboratory studies"
                            },
                            {
                                "example_id": "da568ad0-e50a-4b43-82e1-9d9f49398a90",
                                "sense_id": "1dd14934-3af2-3e14-8489-a5de4e22f578",
                                "text": "Scientists warn that the dispersed oil, as well as the dispersants themselves, might cause long-term harm to marine life."
                            }
                        ]
                    }
                ],
