                "senses": [
                    {
                        "sense_id": "7ffd8437-9667-3961-beaa-cd337495310b",
                        "entry_id": "c23b132d-018e-34d9-9524-a6d0c7041541",
                        "glosses": [
                            "öffentliche Essensverteilung (gegen Spende), die meist mit gemeinschaftlichem Kochen verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e503085-e80e-40aa-bcb2-bd90a70e1c5a",
                                "sense_id": "7ffd8437-9667-3961-beaa-cd337495310b",
                                "text": "„Alle zwei Wochen gibt es Küfa – offene Küche für alle, Gäste erwünscht.“"
                            },
                            {
                                "example_id": "646cfa0d-382a-4a9c-9853-e0b1f95e2e7c",
                                "sense_id": "7ffd8437-9667-3961-beaa-cd337495310b",
                                "text": "„Im neuen - rund 3.000 Quadratmeter großen - P8 in der Schauenburgstraße 5 im Karlsuher Stadtteil Bulach bietet der Panorama e.V. ab sofort Ateliers und Proberäume und veranstaltet regelmäßig Konzerte, Partys, Ausstellungen, und andere Kulturveranstaltungen. Unter anderem sind auch der Verein Retrogames mit seiner Sammlung alter Konsolen, Spielautomaten und Flipper und das Café Noir - mit der Küfa (Küche für alle) und dem Umsonstladen auf dem Areal angesiedelt.“"
                            },
                            {
                                "example_id": "7deffd6d-8473-4b0a-af33-14183451a2bb",
                                "sense_id": "7ffd8437-9667-3961-beaa-cd337495310b",
                                "text": "„Die Aktivist:innen [sic] organisierten die Besetzung basisdemokratisch mit Küfa, Awarenessteam und täglichen Plena.“"
                            },
                            {
                                "example_id": "55ce431f-6b1e-47cc-b7c9-b8ac9e3ea35c",
                                "sense_id": "7ffd8437-9667-3961-beaa-cd337495310b",
                                "text": "„Anschliessend Küfa und Getränke gegen Spende – Spendenerlös geht an die Initiative «Hilfe für Menschen in Abschiebehaft Büren».“"
                            },
                            {
                                "example_id": "a8612995-e80b-4615-a2d4-e362c8a48b3b",
                                "sense_id": "7ffd8437-9667-3961-beaa-cd337495310b",
                                "text": "„Neben Reggea-Musik, Schnippeln in der Küche und Küfa essen, stehen für Samstagabend noch einige Highlights wie FreeImproJam und Zirkeltraining an. Also einfach bis 22 Uhr vorbeischauen und mitmachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
