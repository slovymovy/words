                        "cross_references": [
                            {
                                "target_word": "bezaansmast",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b2b71635-8604-30f1-bf73-1192e510838f",
                                        "entry_id": "f2faefe8-56a4-3969-bb83-d94d7513b8d9",
                                        "glosses": [
                                            "achterste mast op een klassiek zeilschip, mast waaraan geen dwarsgetuigde zeilen gevoerd worden Een uitzondering is de haringbuis (16-e tot 19-e eeuw), die aan de bezaansmast een dwarsgetuigd zeil voer. Bij het binnenhalen van het net en achter anker liggend werd zo de boot op de wind gehouden. (zie o.a.\\\"Schepen van de Gouden eeuw\\\"onder redactie van R.Daalder en E.Spits)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd2fa1c-90c1-4955-8468-ee9ecf6967e7",
                                                "sense_id": "b2b71635-8604-30f1-bf73-1192e510838f",
                                                "text": "De bezaansmast is meestal korter dan de overige masten van het schip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff31f785-983e-4199-9d1e-4dc8427919e7",
                        "source_entry_id": "e0b6add1-c17c-3721-a8ed-b9add397d6a1",
                        "source_sense_description": "nautical: aftmost mast",
                        "target_lang_word": "artimon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artimon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc19db30-2d80-34a7-b0f7-76b692d934b4",
                                        "entry_id": "026739c0-ce0b-3bf5-806a-efc61dd3789b",
                                        "glosses": [
                                            "Mât de l’arrière, le plus petit d’un grand bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6110978-73eb-4e7d-b984-276c0ed3818b",
                                                "sense_id": "fc19db30-2d80-34a7-b0f7-76b692d934b4",
                                                "text": "Déjà il n’avait plus hors de l’eau que son mât d’artimon, seul resté debout, isolé sur l’eau."
                                            },
                                            {
                                                "example_id": "3d2fd228-ea89-4bfb-9ccd-817bcc532543",
                                                "sense_id": "fc19db30-2d80-34a7-b0f7-76b692d934b4",
                                                "text": "Le roi n'eût jamais souffert qu'un pavillon, autre que le sien, flottât à une corne d’artimon ou au sommet du grand mât."
                                            },
                                            {
                                                "example_id": "3c9cb588-4f56-486f-ab18-d72b4cdb145f",
                                                "sense_id": "fc19db30-2d80-34a7-b0f7-76b692d934b4",
                                                "text": "La galiote est une embarcation moyenne à deux mâts, dont celui d’arrière, l’artimon, est fort réduit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd9142e6-71ff-324e-bcbe-8603d2bcd5ba",
                                        "entry_id": "026739c0-ce0b-3bf5-806a-efc61dd3789b",
                                        "glosses": [
                                            "Voile en forme de trapèze attachée au mât d’artimon, le plus près de la poupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b09edc8f-4cef-4ae3-92b9-57ba02dd952b",
                                                "sense_id": "dd9142e6-71ff-324e-bcbe-8603d2bcd5ba",
                                                "text": "La voile d’artimon, ou simplement l’artimon."
                                            },
                                            {
                                                "example_id": "63521503-2ff6-4e6f-bb05-5745cf205bbe",
                                                "sense_id": "dd9142e6-71ff-324e-bcbe-8603d2bcd5ba",
                                                "text": "Carguer, amurer l’artimon."
                                            },
                                            {
                                                "example_id": "e8b74b5a-a3fb-44b6-8fea-02f888e1c001",
                                                "sense_id": "dd9142e6-71ff-324e-bcbe-8603d2bcd5ba",
                                                "text": "Vergue ou corne d’artimon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
