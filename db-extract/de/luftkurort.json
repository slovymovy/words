                        "entry_id": "1ec382db-c8ff-3ec4-b329-53a684a4c2ba",
                        "glosses": [
                            "Ort, in dem die Luft und das Klima besonders gut sind, so dass ein Aufenthalt dort sich positiv auf die Gesundheit auswirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1bccb9d-ca36-4015-9b8b-7c758e6cd80d",
                                "sense_id": "fe7ec907-e401-32b4-a07d-fdaa8a3fdf31",
                                "text": "Die Meiers fahren zur Erholung seit Jahren in denselben Luftkurort."
                            },
                            {
                                "example_id": "bcc35c6e-a05c-4c98-96bf-32de432a4c7e",
                                "sense_id": "fe7ec907-e401-32b4-a07d-fdaa8a3fdf31",
                                "text": "Weil es ihr in Wirsberg stets ausnehmend gut gefallen hatte, zog Roberta nach ihren Renteneintritt ganzjährig in den Luftkurort."
                            }
                        ],
                        "sense_index_json": "\"1\""
