                        "przekupić świadka"
                    ],
                    "target_lang_definitions": {
                        "ru": "дать кому-либо взятку в обмен на расположение или нечестные действия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкупить",
                                "target_lang_sense_clarification": "дать взятку, склонить к нечестным действиям"
                            },
                            {
                                "target_lang_word": "дать взятку",
                                "target_lang_sense_clarification": "прямое действие по передаче денег за услугу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc787d70-6857-3c9e-9c3b-5f3d73019797",
                    "sense_definition": "aspekt dokonany od czasownika <w>przekupywać</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "korupcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Polityk próbował <w>przekupić</w> swoich oponentów obietnicami stanowisk.",
                            "target_lang_translations": {
