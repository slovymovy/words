                "senses": [
                    {
                        "sense_id": "446a5985-5f24-3ac0-a447-ff6293177944",
                        "entry_id": "4825b31b-ed84-30bb-a672-851f8418b42b",
                        "glosses": [
                            "нар.-поэт. тяжёлая, несчастливая доля, судьба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a1d2a0-82f9-4dfa-a0bc-83793b2a9e2d",
                                "sense_id": "446a5985-5f24-3ac0-a447-ff6293177944",
                                "text": "Чувствовала ли она себя несчастной или нет — про то никто не ведал, так как никто никогда не слыхал от неё ни малейшей жалобы на свою недолю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b9b84b4-4391-415b-ba71-e715a194212b",
                        "source_entry_id": "4825b31b-ed84-30bb-a672-851f8418b42b",
                        "source_sense_id": "446a5985-5f24-3ac0-a447-ff6293177944",
                        "target_lang_word": "Unglück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unglück",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d2f3782-9fbb-31af-a894-ced8229b5d07",
                                        "entry_id": "71512fac-85da-391a-a88e-6d611a41ff79",
                                        "glosses": [
                                            "negatives Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96eeba8a-0270-446e-b822-a97ea2c65b97",
                                                "sense_id": "4d2f3782-9fbb-31af-a894-ced8229b5d07",
                                                "text": "Zu allem Unglück blieb dann auch noch unser Wagen liegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7160a78-c7f0-34c7-a389-f56ac89b8d6f",
                                        "entry_id": "71512fac-85da-391a-a88e-6d611a41ff79",
                                        "glosses": [
                                            "folgenschwerer Vorfall mit einem tragischen Ende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716645e2-5cec-4211-80b2-cec90a448d3d",
                                                "sense_id": "b7160a78-c7f0-34c7-a389-f56ac89b8d6f",
                                                "text": "Bei diesem Unglück gab es viele Verletzte."
                                            },
                                            {
                                                "example_id": "53e12445-f83a-40be-a9ce-aaa7fc1b6796",
                                                "sense_id": "b7160a78-c7f0-34c7-a389-f56ac89b8d6f",
                                                "text": "„Wie die amtlichen Medien am Montag berichteten, könnte es sich bei dem Unglück in der Fabrik des weltgrößten Elektronikherstellers am Freitag um eine Staubexplosion gehandelt haben.“"
                                            },
                                            {
                                                "example_id": "deb948bb-964c-4c77-b73c-60a1ea442e23",
                                                "sense_id": "b7160a78-c7f0-34c7-a389-f56ac89b8d6f",
                                                "text": "„In dieses, in der Perspektive Canettis friedliche und strebsame Kinderleben bricht ganz plötzlich das größte Unglück ein, das ihm die Fortsetzung seiner Kindheit raubt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
