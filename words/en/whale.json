{
    "word_family": [
        "whaler",
        "whaling",
        "whalelike",
        "whalebone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b4a7ad2-b950-3b89-992a-47937e78ba1a",
                    "sense_definition": "Any of various large marine mammals of the order Cetacea, typically excluding dolphins and porpoises.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "marine_mammal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>whale</w> breached the surface of the ocean to breathe through its blowhole.",
                            "target_lang_translations": {
                                "ru": "<w>Кит</w> вынырнул на поверхность океана, чтобы вдохнуть через дыхало."
                            }
                        },
                        {
                            "text": "We went on a boat trip to see a blue <w>whale</w> in its natural habitat.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на лодочную прогулку, чтобы увидеть синего <w>кита</w> в его естественной среде обитания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blue whale",
                        "humpback whale",
                        "killer whale",
                        "whale watching"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из различных крупных морских млекопитающих отряда китообразных, обычно исключая дельфинов и морских свиней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кит",
                                "target_lang_sense_clarification": "морское млекопитающее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "723fc368-1324-37cb-bd7f-201a1d17772e",
                    "sense_definition": "Something or someone that is exceptionally good, impressive, or large in scale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were having a <w>whale</w> of a time playing at the beach all afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети <w>потрясающе</w> проводили время, играя на пляже весь день."
                            }
                        },
                        {
                            "text": "That was a <w>whale</w> of a story you told at dinner last night.",
                            "target_lang_translations": {
                                "ru": "Это была <w>невероятная</w> история, которую ты рассказал вчера за ужином."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whale of a time",
                        "whale of a job"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'a whale of a...'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то или кто-то исключительно хороший, впечатляющий или масштабный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечто потрясающее",
                                "target_lang_sense_clarification": "об исключительном опыте или событии"
                            },
                            {
                                "target_lang_word": "масса",
                                "target_lang_sense_clarification": "о большом количестве удовольствия или впечатлений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f4df547-323d-3355-8db4-dd6a855039c3",
                    "sense_definition": "A gambler or investor who routinely wagers or deals with very large amounts of money.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "big_spender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The casino rolled out the red carpet for the <w>whale</w> who was betting thousands on every hand.",
                            "target_lang_translations": {
                                "ru": "Казино расстелило красную дорожку для <w>крупного игрока</w>, который ставил тысячи на каждую раздачу."
                            }
                        },
                        {
                            "text": "The startup is looking for a <w>whale</w> to provide the necessary venture capital.",
                            "target_lang_translations": {
                                "ru": "Стартап ищет <w>крупного инвестора</w>, чтобы получить необходимый венчурный капитал."
                            }
                        }
                    ],
                    "synonyms": [
                        "high roller"
                    ],
                    "common_phrases": [
                        "casino whale"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in gambling and finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрок или инвестор, который регулярно делает ставки или совершает сделки на очень крупные суммы денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кит",
                                "target_lang_sense_clarification": "крупный игрок или инвестор"
                            },
                            {
                                "target_lang_word": "крупный игрок",
                                "target_lang_sense_clarification": "в казино или бизнесе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3448e53b-6c05-364a-851d-dd91c7bffdf8",
                    "sense_definition": "A very large or overweight person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a total <w>whale</w> and could barely fit into the airplane seat.",
                            "target_lang_translations": {
                                "ru": "Он был настоящей <w>тушей</w> и едва помещался в кресло самолета."
                            }
                        },
                        {
                            "text": "The bully called the boy a <w>whale</w> because of his size.",
                            "target_lang_translations": {
                                "ru": "Задира назвал мальчика <w>жиртрестом</w> из-за его размеров."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory and offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень крупный человек или человек с избыточным весом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туша",
                                "target_lang_sense_clarification": "грубое обозначение полного человека"
                            },
                            {
                                "target_lang_word": "жиртрест",
                                "target_lang_sense_clarification": "оскорбительное прозвище"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68ac6af6-1a1f-34f5-83ba-6c183dc22afd",
                    "sense_definition": "To engage in the activity of hunting whales.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew spent several months at sea to <w>whale</w> in the cold northern waters.",
                            "target_lang_translations": {
                                "ru": "Экипаж провел несколько месяцев в море, чтобы <w>охотиться на китов</w> в холодных северных водах."
                            }
                        },
                        {
                            "text": "Many nations have signed treaties agreeing not to <w>whale</w> for commercial purposes anymore.",
                            "target_lang_translations": {
                                "ru": "Многие страны подписали договоры, соглашаясь больше не <w>заниматься китобойным промыслом</w> в коммерческих целях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go whaling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься деятельностью по охоте на китов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить китов",
                                "target_lang_sense_clarification": "заниматься китобойным промыслом"
                            },
                            {
                                "target_lang_word": "охотиться на китов",
                                "target_lang_sense_clarification": "промысел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                    "sense_definition": "To hit, thrash, or beat someone or something vigorously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry man began to <w>whale</w> on the door with his fists.",
                            "target_lang_translations": {
                                "ru": "Разгневанный мужчина начал <w>молотить</w> по двери кулаками."
                            }
                        },
                        {
                            "text": "He <w>whaled</w> away at the drums with incredible energy during the solo.",
                            "target_lang_translations": {
                                "ru": "Во время соло он с невероятной энергией <w>лупил</w> по барабанам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whale away at",
                        "whale on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'on' or 'away at'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударять, колотить или избивать кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молотить",
                                "target_lang_sense_clarification": "сильно бить по чему-либо"
                            },
                            {
                                "target_lang_word": "лупить",
                                "target_lang_sense_clarification": "энергично ударять"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "71c822ed-4238-328c-9b6c-fac33175f43a",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Whale</w> was the director of several classic horror films in the 1930s.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уэйл</w> был режиссером нескольких классических фильмов ужасов в 1930-х годах."
                            }
                        },
                        {
                            "text": "The <w>Whale</w> family has lived in this village for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Уэйл</w> жила в этой деревне на протяжении многих поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уэйл",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfca310c-62c2-3be7-aa17-48f594f39a27",
                    "sense_definition": "A small village (hamlet) in Cumbria, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The hikers passed through the tiny hamlet of <w>Whale</w> during their trek.",
                            "target_lang_translations": {
                                "ru": "Во время похода туристы прошли через крошечную деревушку <w>Уэйл</w>."
                            }
                        },
                        {
                            "text": "There are only a few houses located in <w>Whale</w> near the river.",
                            "target_lang_translations": {
                                "ru": "В <w>Уэйле</w> у реки расположено всего несколько домов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to Cumbria, England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая деревня (хутор) в Камбрии, Англия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уэйл",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}