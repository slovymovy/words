                ],
                "senses": [
                    {
                        "sense_id": "fcd3df09-dee7-3798-aa22-971bce9d38ca",
                        "entry_id": "b03e111d-6153-367b-98a7-a12ce83e23b4",
                        "glosses": [
                            "прич. от ожесточиться"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "3a2d34ef-273d-4d0d-a10f-65781467bfda",
                                "sense_id": "fcd3df09-dee7-3798-aa22-971bce9d38ca",
                                "text": "Ожесточённый, одинокий сын Та-Кем был откровенен и разговорчив наедине с чутким молодым эллином."
                            }
                        ]
                    },
                    {
                        "sense_id": "5383cabc-c5da-344f-bae2-1d4d0ffb29e8",
                        "entry_id": "b03e111d-6153-367b-98a7-a12ce83e23b4",
                        "glosses": [
                            "перен. отличающийся значительным напором, стойкостью, свирепостью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af204d91-2280-4d93-b2fa-37d82f99c561",
                                "sense_id": "5383cabc-c5da-344f-bae2-1d4d0ffb29e8",
                                "text": "Орлов вёл ожесточённый бой впереди, с такой же храбростью отражая новые атаки"
                            },
                            {
                                "example_id": "b1dde8b3-3173-439e-ae88-f4021db24609",
                                "sense_id": "5383cabc-c5da-344f-bae2-1d4d0ffb29e8",
                                "text": "Относительно двадцати оставшихся голосов шел ожесточённый юридический спор, изложением которого я не буду занимать читателей."
                            }
                        ]
                    }
                ],
