                    },
                    {
                        "translation_id": "5df4b352-a8d4-4066-bef7-cb45d538aac7",
                        "source_entry_id": "44f1ef07-d831-3eae-a0d9-43bcbfa1486e",
                        "source_sense_id": "a4aa85f6-01f6-3fff-8a70-db76141e7143",
                        "target_lang_word": "surmoi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surmoi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f200b7b2-d6d3-3d47-8dd2-047008997f17",
                                        "entry_id": "9dca1d91-de69-36e8-b0bd-587f5e22717a",
                                        "glosses": [
                                            "Concept psychanalytique élaboré par Sigmund Freud, l’une des trois instances de la personnalité, structure morale (conception du bien et du mal) et judiciaire (capacité de récompense ou de punition) de notre psychisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7950ec66-0352-4972-9712-8aaa7d4bcc3f",
                                                "sense_id": "f200b7b2-d6d3-3d47-8dd2-047008997f17",
                                                "text": "Le surmoi découle de la résolution du complexe d’Œdipe : l’enfant assume les interdits du parricide et de l’inceste et s’identifie au parent du même sexe."
                                            },
                                            {
                                                "example_id": "d499b35e-7965-480c-b57f-a8a4583893bb",
                                                "sense_id": "f200b7b2-d6d3-3d47-8dd2-047008997f17",
                                                "text": "Il est connu qu’on oppose, schématiquement, un surmoi précoce pulsionnel, surmoi mis à jour essentiellement par Mélanie Klein, et un surmoi tardif, fait des impératifs culturels et signifié par des commandements : un surmoi lié, nous dit Freud, à la loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4fd7a11-ae88-358f-9358-ec100adfcec7",
                                        "entry_id": "9dca1d91-de69-36e8-b0bd-587f5e22717a",
                                        "glosses": [
                                            "Posture autoritaire caractérisée par la surveillance, le jugement, la culpabilisation voire la condamnation d’un sujet."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c41f1f-58bc-4f75-b60e-d2dda5efa027",
                                                "sense_id": "f4fd7a11-ae88-358f-9358-ec100adfcec7",
                                                "text": "L’ombre de Marx, ou à tout le moins celle de Keynes, plane de nouveau comme un surmoi sur les théodicées libérales."
                                            },
                                            {
                                                "example_id": "5b597544-07c2-455a-81c2-0e147dc46be3",
                                                "sense_id": "f4fd7a11-ae88-358f-9358-ec100adfcec7",
                                                "text": "De là, je pouvais tancer les tièdes sans risquer de subir moi-même les foudres du surmoi révolutionnaire."
                                            },
                                            {
                                                "example_id": "35f3830c-31f4-4809-b66c-d7d505b67ce5",
                                                "sense_id": "f4fd7a11-ae88-358f-9358-ec100adfcec7",
                                                "text": "La gauche radicale joue le rôle de surmoi idéologique des sociétés occidentales : c’est elle qui fixe les paramètres idéologiques du débat public en définissant les concepts qui le structurent et le grand récit qui s’impose aux acteurs politiques et aux mouvements sociaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
