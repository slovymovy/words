                "senses": [
                    {
                        "sense_id": "0b0b9cd9-b6e0-3351-9c6e-542f8636cbc1",
                        "entry_id": "d907685b-ef55-3463-b319-a6ddd76d232e",
                        "glosses": [
                            "Gebäude, in dem künstlerische Aufführungen gezeigt werden, beispielsweise ein Theater/Schauspielhaus, Konzerthaus/Philharmonie oder Opernhaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbb58b06-c96a-42c6-a4b5-21e959c54d48",
                                "sense_id": "0b0b9cd9-b6e0-3351-9c6e-542f8636cbc1",
                                "text": "Das Fillmore West, der Musentempel der Rockmusik von San Francisco, war gerammelt voll."
                            },
                            {
                                "example_id": "91ea661b-524d-4000-aa87-2dbe17cefac2",
                                "sense_id": "0b0b9cd9-b6e0-3351-9c6e-542f8636cbc1",
                                "text": "Nach offiziellen Angaben kostete die Rettung des 150-jährigen [Bolshoj-]Theaters rund 500 Millionen Euro. […] Es stellt sich allerdings die Frage, ob solche Kosten für einen Musentempel noch angemessen sind."
                            },
                            {
                                "example_id": "05070fd4-0e58-4b57-bbc7-9e49e0bf85fd",
                                "sense_id": "0b0b9cd9-b6e0-3351-9c6e-542f8636cbc1",
                                "text": "Ihre Hauptfront weist zwar architektonische Ähnlichkeiten mit der der Pariser Opéra auf; allerdings ist die Library of Congress in Washington D.C. kein Musentempel, sondern eine der wichtigsten Bibliotheken der Welt."
                            },
                            {
                                "example_id": "bc990f7e-76d8-419a-89c3-3a2925023699",
                                "sense_id": "0b0b9cd9-b6e0-3351-9c6e-542f8636cbc1",
                                "text": "[Staatsoper Unter den Linden:] Deren Chefdirigent Daniel Barenboim hatte schon für das letzte und vorletzte Jahr die Wiedereröffnung seines prestigeträchtigen Musentempels versprochen. Vergeblich."
                            },
                            {
                                "example_id": "24396cba-5bfc-46ae-8a0f-032deb4245b7",
                                "sense_id": "0b0b9cd9-b6e0-3351-9c6e-542f8636cbc1",
                                "text": "[Dresdner Semperoper:] Heute ist sie wieder eine der wichtigsten Musiktheaterbühnen Europas. Vielen gilt sie jedoch weniger als weihevoller Musentempel, sondern als eines der attraktiven Touristenziele der Stadt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
