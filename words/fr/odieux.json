                        "un personnage odieux"
                    ]
                },
                {
                    "sense_id": "7b1fa1be-5d37-319b-ac8e-63440ab1b706",
                    "sense_definition": "Qui suscite un profond dégoût, de la haine ou une vive indignation par sa gravité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a qualifié cette agression d'acte absolument <w>odieux</w> envers des personnes vulnérables."
                        },
                        {
                            "text": "Ils ont dénoncé ces manœuvres <w>odieuses</w> menées pour influencer les résultats du vote."
                        }
                    ],
                    "synonyms": [
                        "haïssable",
                        "révoltant"
                    ],
                    "antonyms": [
                        "admirable",
                        "louable"
                    ],
                    "common_phrases": [
                        "un crime odieux",
                        "un chantage odieux"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4b67361-7395-302e-8f07-217ec88cd5e7",
                    "sense_definition": "Caractère ou aspect de ce qui provoque la réprobation, la haine ou le dégoût moral.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "indignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>odieux</w> de sa trahison a choqué l'ensemble de ses anciens associés."
