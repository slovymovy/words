                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a62e53c-022f-4419-8569-7cfffb5d28a5",
                        "source_entry_id": "f9019f34-20ed-39ea-8ed6-00d21c92524b",
                        "source_sense_description": "having the appearance of nature, lifelike, realistic",
                        "target_lang_word": "wirklichkeitsnah",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wirklichkeitsnah",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e53825b8-e736-38a4-8807-a1277f83aa8d",
                                        "entry_id": "01814c1a-2411-3bd8-bba4-453b39cd73d9",
                                        "glosses": [
                                            "die Wirklichkeit, die wahren Gegebenheiten berücksichtigend, wahrnehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02eac9e7-6b55-4869-8975-2e58a948bc38",
                                                "sense_id": "e53825b8-e736-38a4-8807-a1277f83aa8d",
                                                "text": "„Alles nur Schein, der dennoch so wirklichkeitsnah war.“"
                                            },
                                            {
                                                "example_id": "8221fa03-52e4-41e3-ac54-849c82eae0b6",
                                                "sense_id": "e53825b8-e736-38a4-8807-a1277f83aa8d",
                                                "text": "„Dass man sich wirklichkeitsnah wahrnimmt, setzt Selbsterkenntnis voraus.“"
                                            },
                                            {
                                                "example_id": "419e862a-ba70-47f5-9df6-461eb37fcb06",
                                                "sense_id": "e53825b8-e736-38a4-8807-a1277f83aa8d",
                                                "text": "„Operationen könnten nicht mehr wirklichkeitsnah geübt, Personal nicht mehr wirklichkeitsnah geschult und weitergebildet werden.“"
                                            },
                                            {
                                                "example_id": "93cc2a91-4f8f-4f49-a057-a5aec86fe075",
                                                "sense_id": "e53825b8-e736-38a4-8807-a1277f83aa8d",
                                                "text": "„Hier soll die konkrete soziale Situation möglichst eng einbezogen werden und so wirklichkeitsnah wie möglich auf die Entlassung vorbereitet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb14b865-632e-4925-b4e3-1053800e175d",
