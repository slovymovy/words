                                        "sense_id": "2a778eee-ba33-334d-a53a-f40884147cab",
                                        "entry_id": "414f1cae-9ac4-3923-9a03-3f5833d2e56f",
                                        "glosses": [
                                            "One who performs feats of prestidigitation; a sleight-of-hand artist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
