    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "900b07aa-2cf7-36c6-afa5-1e3fe41d3402",
                "word": "umpteenth",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e64c766a-1e7d-319f-aa1e-85a4236f5f9c",
                        "entry_id": "900b07aa-2cf7-36c6-afa5-1e3fe41d3402",
                        "glosses": [
                            "Occurring in a relatively large but unspecified position in a sequence."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b89bb18b-7fce-4812-9ca6-5d3d79d7bcca",
                                "sense_id": "e64c766a-1e7d-319f-aa1e-85a4236f5f9c",
                                "text": "That's the umpteenth time I've had to tell him not to swear in front of the children."
                            },
                            {
                                "example_id": "8c2716bb-3749-445b-af9c-b2e7e12e0547",
                                "sense_id": "e64c766a-1e7d-319f-aa1e-85a4236f5f9c",
                                "text": "For the umpteenth time, I chickened."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5b7c072-9729-4cc8-be24-0cfd7f22d857",
                        "source_entry_id": "900b07aa-2cf7-36c6-afa5-1e3fe41d3402",
                        "source_sense_id": "e64c766a-1e7d-319f-aa1e-85a4236f5f9c",
                        "source_sense_description": "informal: occurring in a relatively large but unspecified position in a series",
                        "target_lang_word": "zoveelste",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoveelste",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ba294405-057d-36be-b9a0-f8d5aff4add9",
                                        "entry_id": "7c115911-1e90-3181-ac9d-3ffcde379acf",
                                        "glosses": [
                                            "in een reeks een onbekende plek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4064015c-aef6-4d59-819b-9b48b6a8eb81",
                                                "sense_id": "ba294405-057d-36be-b9a0-f8d5aff4add9",
                                                "text": "Voor mij was het de zoveelste bevestiging dat we dat Quote-artikel nooit hadden moeten doen."
                                            },
                                            {
                                                "example_id": "db1c01d0-28b8-4393-bd20-22a9a9a97a04",
                                                "sense_id": "ba294405-057d-36be-b9a0-f8d5aff4add9",
                                                "text": "Zijn vakantie duurt enkele weken: hij vertrekt met kerstmis en blijft weg tot de zoveelste januari."
                                            },
                                            {
                                                "example_id": "4fee2861-1af9-4afe-aa90-ba617e281251",
                                                "sense_id": "ba294405-057d-36be-b9a0-f8d5aff4add9",
                                                "text": "Ten slotte zette hij het zoveelste negatieve bedrag onder aan de kolom en sloeg het boek dicht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de81d8fa-9222-3999-8319-0f6f845f294e",
                                        "entry_id": "7c115911-1e90-3181-ac9d-3ffcde379acf",
                                        "glosses": [
                                            "als noemer van een denkbeeldige breuk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da5aa825-dc6f-4ecc-9e3a-623723408886",
                                                "sense_id": "de81d8fa-9222-3999-8319-0f6f845f294e",
                                                "text": "Rovers willen niet dat hun bende al te groot wordt, want ieder krijgt maar een zoveelste deel van de buit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zoveelste",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e2249d41-cf7b-3adf-ae70-0054a3119fe5",
                                        "entry_id": "2a5be5dc-d5b4-316a-904b-d79ed401638f",
                                        "glosses": [
                                            "één uit een lange reeks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de32863-7219-42fe-b747-f5cc5eff464e",
                                                "sense_id": "e2249d41-cf7b-3adf-ae70-0054a3119fe5",
                                                "text": "Dit is de zoveelste keer dat het verkeerd gaat, leer je het dan nooit?"
                                            },
                                            {
                                                "example_id": "99f97b3a-6a00-4f2a-893f-74aa704a1773",
                                                "sense_id": "e2249d41-cf7b-3adf-ae70-0054a3119fe5",
                                                "text": "Dit is alweer het zoveelste deel uit deze geliefde serie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eab97ca5-4f20-435d-8521-6dc322e6ed22",
                        "source_entry_id": "900b07aa-2cf7-36c6-afa5-1e3fe41d3402",
                        "source_sense_id": "e64c766a-1e7d-319f-aa1e-85a4236f5f9c",
                        "source_sense_description": "informal: occurring in a relatively large but unspecified position in a series",
                        "target_lang_word": "énième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "énième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                        "entry_id": "3ec5e3b7-b90a-3098-905e-56feccb67bec",
                                        "glosses": [
                                            "Sérié, mais de position indéterminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c2c8b3e-3f94-4daf-8384-50f5eab19d0a",
                                                "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                                "text": "Une énième AG déterminera une fois encore la suite à donner aux actions."
                                            },
                                            {
                                                "example_id": "d56b1b91-5144-42e2-8b5c-f1ed8842bc48",
                                                "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                                "text": "L’allocution se termine, le candidat se jette dans un énième bain de foule et signe des autographes sur les bons de retard des élèves – cheveux en pétard, sweat-shirts à capuche – qui l’approchent."
                                            },
                                            {
                                                "example_id": "d69f55d3-7b2e-4eba-8a29-af1c2c193fdc",
                                                "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                                "text": "Les canons qui avaient réussi à gravir la pente furent acheminés vers l’arrière-garde. De là, leur précision se révéla diabolique. Un énième tir de barrage frôla les képis des colonnes d’assaillants allongés sur le sol, des boulets allaient herter les barricades avec violence et affleuraient le sommet des monticules, empêchant les embusqués de pouvoir se relever pour répliquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                        "entry_id": "3ec5e3b7-b90a-3098-905e-56feccb67bec",
                                        "glosses": [
                                            "Qui arrive après un grand nombre d'autres éléments de même nature, dans une répétition jugée excessive ou ennuyeuse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fcc316-d77a-4cee-9e98-8809e26b97f3",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Je commençais à m'amuser quand mon supérieur m'interrompit. Il déchira la énième lettre sans même la lire et me dit que mdemoiselle Mori était arrivée."
                                            },
                                            {
                                                "example_id": "68037abb-9908-409a-950b-f3e13d5522e1",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Tell s’apprêtait à se servir le énième café de la journée, lorsqu’il découvrit qu’on avait retiré de la cuisinette la cafetière électrique."
                                            },
                                            {
                                                "example_id": "f2c9bc2c-27b9-4254-be88-4e21e9c399e2",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Je ne vais pas raconter ici pour la énième fois le voyage de Chine comme c’était la mode à l’époque pour les très rares qui le faisaient."
                                            },
                                            {
                                                "example_id": "a7151f2c-faa0-49f6-b9b9-76995e063b9c",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Pour la énième fois, je me fis la réflexion que, depuis un certain temps, je brûlais la chandelle par les deux bouts. En fait, j'étais au bord du surmenage professionnel."
                                            },
                                            {
                                                "example_id": "362d8b6e-13b9-4f6c-a365-4e2c8261fd77",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "A l'hôpital, soigné à la morphine, il en était devenu dépendant, ne pouvait plus s'en passer, l'appelait sa fée grise. « En voulez-vous ? proposa-t-il à Verlaine qui commandait une énième absinthe. Ça vous changera de la fée verte. »"
                                            },
                                            {
                                                "example_id": "1d5c46cd-f556-45bb-adf3-9665918f1d76",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Les dirigeants européens ont eu une semaine chargée. En plus de leur énième sommet de la dernière chance dans le cadre de la crise grecque, ils devaient convenir d’une solution commune aux dizaines de milliers de réfugiés venus s’échouer sur les côtes italiennes et grecques depuis le début de l’année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c351b0d-fdff-38d2-bb9c-d3b548ddc042",
                                        "entry_id": "3ec5e3b7-b90a-3098-905e-56feccb67bec",
                                        "glosses": [
                                            "Correspondant à un ordre indéterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da77aa97-a551-4f9a-9110-53a911a8b14c",
                                                "sense_id": "6c351b0d-fdff-38d2-bb9c-d3b548ddc042",
                                                "text": "Dans des mains expertes, il est cependant possible de réaliser d’autres opérations de type calculs de racines énièmes ou conversion en différentes bases."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "énième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4549b4f5-32fa-3710-b54d-d1bfda82215c",
                                        "entry_id": "be0a1d93-cb40-3d21-9981-09335bee248e",
                                        "glosses": [
                                            "Élément ordinal correspondant à un nombre indéterminé dans une série."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d17ddc77-0ceb-4572-b177-40cc890f8842",
                                                "sense_id": "4549b4f5-32fa-3710-b54d-d1bfda82215c",
                                                "text": "Tu es la énième à me le dire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fe9d4f8-2d2d-4072-8ef5-d032d0816df5",
                        "source_entry_id": "900b07aa-2cf7-36c6-afa5-1e3fe41d3402",
                        "source_sense_id": "e64c766a-1e7d-319f-aa1e-85a4236f5f9c",
                        "source_sense_description": "informal: occurring in a relatively large but unspecified position in a series",
                        "target_lang_word": "ixième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ixième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                                        "entry_id": "6327cabb-17da-3df0-9de7-b01ae920f36a",
                                        "glosses": [
                                            "Qui occupe une place indéterminée dans une suite considérée comme trop longue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e849f31-6c5a-41a8-8250-950ba049d2bd",
                                                "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                                                "text": "Elle n'avait pas envie d'entendre une ixième fois le discours que servait son homme quand on lui disait qu'il jouait avec sa santé. Oh ! Après tout, il fait ce qu'il veut!"
                                            },
                                            {
                                                "example_id": "85371430-53a0-4f9f-8d21-e33d15abc2dd",
                                                "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                                                "text": "Je décide donc d'acheter une voiture, de développer tant bien que mal mon sens de l'orientation, et commence pour moi une ixième série de cours de conduite, jumelée à des pratiques incessantes."
                                            },
                                            {
                                                "example_id": "8aaef42d-c9ff-457d-ae15-4d0e056fab30",
                                                "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                                                "text": "Oh la la, on ne se fera pas dire non, c’est pas vrai!», a dit François Legault en se frottant le nez pour la ixième fois et en donnant un gros coup de pied sur une roche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ixième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                                        "entry_id": "33314275-32c0-3622-9d4b-966f9bbd374f",
                                        "glosses": [
                                            "Élément ordinal correspondant à un nombre indéterminé dans une série."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcb2c43-0030-40db-9b70-a37f1e9727f7",
                                                "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                                                "text": "Tu es la ixième à me le dire."
                                            },
                                            {
                                                "example_id": "c63eaf4e-fdbc-48a5-9b4a-a941beb4aaea",
                                                "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                                                "text": "L’on demande un responsable électrobidule à la caisse ixième de l’ixième issue payante."
                                            },
                                            {
                                                "example_id": "42c32ac0-e1ad-446c-be35-cba8c3af514b",
                                                "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                                                "text": "Dans une interview-portrait à paraître samedi dans Le Figaro-Magazine, le ministre de l’Éducation nationale Xavier Darcos assure : « Je ne serai pas le ixième ministre [de l’Éducation] à céder ! Je serai le premier ministre à tenir bon le cap de la réforme »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
