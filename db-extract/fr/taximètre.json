        "fr-extract.jsonl": [
            {
                "entry_id": "8414419e-d66a-3c84-b3b8-fecf3bcc2c4c",
                "word": "taximètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "11ccb201-9261-4cc1-a584-e24429b7d435",
                        "entry_id": "8414419e-d66a-3c84-b3b8-fecf3bcc2c4c",
                        "tags": [
                            "plural"
                        ],
                        "form": "taximètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d35616e-0a1d-3f2d-bdb2-1a26e6ba2956",
                        "entry_id": "8414419e-d66a-3c84-b3b8-fecf3bcc2c4c",
                        "glosses": [
                            "Compteur qui enregistre le parcours fourni par une voiture de place et indique, d’après cette distance et d’après le temps écoulé, la somme à payer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d1f2c9-c997-4d76-8269-57819cb675e0",
                                "sense_id": "8d35616e-0a1d-3f2d-bdb2-1a26e6ba2956",
                                "text": "Tarif des fiacres à taximètre. — Voit. à deux places, tarif de jour dans Paris et hors de l’enceinte fortifiée (attente ou marche lente) : 75 c. pour 1,200 m. ou pour 9 min. d’occupation, 10 c. en plus pour chaque 400 m. en plus ou 3 min. en plus."
                            },
                            {
                                "example_id": "6cefb683-16e1-421d-8d3c-61090f5de11a",
                                "sense_id": "8d35616e-0a1d-3f2d-bdb2-1a26e6ba2956",
                                "text": "Bercée au tic tac du taximètre, Minne allonge sur le strapontin ses pieds vernis, qui ont si activement erré."
                            }
                        ]
                    },
                    {
                        "sense_id": "dada618f-120d-35df-843c-a3a597bc89fb",
                        "entry_id": "8414419e-d66a-3c84-b3b8-fecf3bcc2c4c",
                        "glosses": [
                            "Fiacre équipé d'un compteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33420f14-6c11-42d6-83aa-f8ccbb7f368a",
                                "sense_id": "dada618f-120d-35df-843c-a3a597bc89fb",
                                "text": "Certains fiacres furent munis d’un compteur qui indiquait le prix de la course ; donc plus de marchandages ! Ils étaient signalés par des lanternes bleutées. On les appelait les taximètres. Enfin, apparurent les automobiles de louage qui prirent le nom de taxis."
                            }
                        ]
                    },
                    {
                        "sense_id": "d28ffef4-2825-321e-8b0e-6a757237315b",
                        "entry_id": "8414419e-d66a-3c84-b3b8-fecf3bcc2c4c",
                        "glosses": [
                            "Taxi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1373bed6-c1ca-4dc3-97b4-b2407a9346ea",
                                "sense_id": "d28ffef4-2825-321e-8b0e-6a757237315b",
                                "text": "Et surtout vous prendrez bien garde dans les rues de la capitale de ne pas vous faire écraser par les taximètres automobiles..."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fca78fe-babc-351f-8e0b-b86b27391e91",
                        "entry_id": "8414419e-d66a-3c84-b3b8-fecf3bcc2c4c",
                        "glosses": [
                            "Instrument dérivé de la boussole et qui indique l'axe d'un navire par rapport à l'axe du méridien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7810e11-c24e-4936-9338-e35baac8d752",
                                "sense_id": "4fca78fe-babc-351f-8e0b-b86b27391e91",
                                "text": "M. Santi a inventé un instrument qu’il nomme taximètre azimutal, qui sert à déterminer toutes les positions de l’axe du navire par rapport au méridien."
                            },
                            {
                                "example_id": "87ebe42b-1424-446b-8030-f222e1526c69",
                                "sense_id": "4fca78fe-babc-351f-8e0b-b86b27391e91",
                                "text": "Sur les grands navires, il y a un taximètre à chaque extrémité de la passerelle ; mais, sur un petit navire, on devra souvent se contenter, en guise de taximètre, d'un compas de relèvement qui aura un cercle gradué …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2398d5f-7a3a-4c5a-91af-53c2386a1a29",
                        "source_entry_id": "8414419e-d66a-3c84-b3b8-fecf3bcc2c4c",
                        "target_lang_word": "Taxameter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taxameter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db6f6b39-052b-3674-b2c2-9ee0e01a1755",
                                        "entry_id": "e1e32d9c-8537-3731-b9c5-a3fd84a65e7d",
                                        "glosses": [
                                            "Gerät, das in einem Taxi den zu entrichtenden Fahrpreis berechnet und anzeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ca88a7-d7ab-477a-ab02-1c43f92dd914",
                                                "sense_id": "db6f6b39-052b-3674-b2c2-9ee0e01a1755",
                                                "text": "Kannst du dich bitte beeilen, der Taxameter läuft."
                                            },
                                            {
                                                "example_id": "d7cd9a9f-1a05-46fc-a087-633c5fcfd415",
                                                "sense_id": "db6f6b39-052b-3674-b2c2-9ee0e01a1755",
                                                "text": "„Ich weiß nicht, wieso das kommt: ich erkenne nichts wieder, obwohl ich doch schon mehrmals in München war. Sendlinger Tor. Bahnhof, den rechtzeitig zu erreichen ich (besonders Doras wegen) Sorge hatte. So sind wir wie eine daraufhin ausgerechnete Feder in genau zwanzig Minuten durch die Stadt geschnurrt, nach dem Taxameter.“"
                                            },
                                            {
                                                "example_id": "cb4d8643-6ad4-4187-b82d-a5b5d8de0fbd",
                                                "sense_id": "db6f6b39-052b-3674-b2c2-9ee0e01a1755",
                                                "text": "„Für die Entfernung vom Bahnhof zum Hotel, vom Hotel zum Bahnhof gibt es ein Maß: den Taxameter. Zwei Mark, drei Mark, vier Mark fünfzig vom Bahnhof entfernt.“"
                                            },
                                            {
                                                "example_id": "a8110f09-f52a-4afb-b2f3-9b31cbeea591",
                                                "sense_id": "db6f6b39-052b-3674-b2c2-9ee0e01a1755",
                                                "text": "„Auf Gronefelds Order: ‚Zum Tunnel, bitte‘, setzte der Droschkenfahrer ohne Rückfrage das Taxameter in Gang und chauffierte den Reporter an Ort und Stelle.“"
                                            },
                                            {
                                                "example_id": "2e0d7f57-f9cc-480d-a128-f95601a219e1",
                                                "sense_id": "db6f6b39-052b-3674-b2c2-9ee0e01a1755",
                                                "text": "„Der Fahrer öffnete sein Fenster, winkte mit der Hand und wechselte vor einem großen Bus auf die rechte Spur. Der Taxameter zeigte noch den gleichen Betrag an.“"
                                            },
                                            {
                                                "example_id": "6426501d-e0fd-4e9d-9ef5-4b844dc31d97",
                                                "sense_id": "db6f6b39-052b-3674-b2c2-9ee0e01a1755",
                                                "text": "„Mitte der 50er-Jahre lernten sich also meine Eltern bei laufendem Taxameter in Istanbul kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "026efbab-5d62-30f1-821e-5b1fe0c34bf5",
                                        "entry_id": "e1e32d9c-8537-3731-b9c5-a3fd84a65e7d",
                                        "glosses": [
                                            "Fahrzeug, das zur entgeltlichen Personenbeförderung dient und gewöhnlich durch einen Fahrer gelenkt wird"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4095829e-c967-4828-992f-7b1ef7dc4f77",
                                                "sense_id": "026efbab-5d62-30f1-821e-5b1fe0c34bf5",
                                                "text": "„Er fuhr mit dem Taxameter so schnell als es ging zur Beratungsstelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
