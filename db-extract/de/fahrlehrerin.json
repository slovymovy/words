                "senses": [
                    {
                        "sense_id": "033a05b4-ca8e-32e5-802f-616e0c63a0d9",
                        "entry_id": "9604d022-a419-3328-8e85-3c97e2ec78b4",
                        "glosses": [
                            "weibliche Person, die jemanden unterstützt, eine Fahrerlaubnis/Führerschein für ein (motorbetriebenes) Fahrzeug zu erlangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34bf1550-d512-4b79-9dfc-60f4253fd597",
                                "sense_id": "033a05b4-ca8e-32e5-802f-616e0c63a0d9",
                                "text": "„Philippi ist selbst auch angehende Fahrlehrerin, allerdings nicht für Straßenbahnen, sondern für Kraftfahrzeuge.“"
                            },
                            {
                                "example_id": "72ac0eb3-6786-4df7-a692-bda15877d97c",
                                "sense_id": "033a05b4-ca8e-32e5-802f-616e0c63a0d9",
                                "text": "„Fahrlehrerin Nina Kandlbinder, 30, erklärt, warum es gar nicht stimmt, dass Frauen nicht Auto fahren können und warum dennoch eine Fahrschule nur für das weibliche Geschlecht notwendig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
