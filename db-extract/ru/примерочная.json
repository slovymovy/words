                ],
                "senses": [
                    {
                        "sense_id": "f1408350-bf37-344d-bce2-19f7f7fbb11e",
                        "entry_id": "acbf0f63-8f60-30e3-b281-0c9119c01802",
                        "glosses": [
                            "помещение в магазине, где покупатель может примерить на себя одежду перед покупкой"
                        ],
                        "tags": [],
