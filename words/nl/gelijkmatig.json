{
    "word_family": [
        "gelijkheid",
        "gelijke",
        "gelijk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eba3a8e1-36a4-37dd-93bb-7b4c5dfdd8c5",
                    "sense_definition": "Zonder grote verschillen of onderbrekingen, met een constante verdeling of snelheid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "constantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto reed met een <w>gelijkmatige</w> snelheid over de snelweg.",
                            "target_lang_translations": {
                                "ru": "Машина ехала по шоссе с <w>равномерной</w> скоростью.",
                                "en": "The car drove down the highway at a <w>steady</w> speed."
                            }
                        },
                        {
                            "text": "Zorg voor een <w>gelijkmatige</w> verdeling van de verf op de muur.",
                            "target_lang_translations": {
                                "ru": "Обеспечьте <w>равномерное</w> распределение краски по стене.",
                                "en": "Ensure an <w>even</w> distribution of the paint on the wall."
                            }
                        }
                    ],
                    "synonyms": [
                        "constant",
                        "stabiel"
                    ],
                    "antonyms": [
                        "ongelijkmatig"
                    ],
                    "common_phrases": [
                        "gelijkmatige verdeling",
                        "gelijkmatige snelheid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без значительных различий или перерывов, с постоянным распределением или скоростью.",
                        "en": "Without large variations or interruptions, with a constant distribution or speed."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "равномерный",
                                "target_lang_sense_clarification": "о распределении, скорости или движении"
                            },
                            {
                                "target_lang_word": "плавный",
                                "target_lang_sense_clarification": "о движении или изменении без резких скачков"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "steady",
                                "target_lang_sense_clarification": "continuous and without sudden changes in pace or rate"
                            },
                            {
                                "target_lang_word": "even",
                                "target_lang_sense_clarification": "uniform and consistent in distribution, pace, or application"
                            },
                            {
                                "target_lang_word": "smooth",
                                "target_lang_sense_clarification": "flowing without jarring irregularities or abrupt shifts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03185176-35b1-3e6f-be7a-206494aa9a52",
                    "sense_definition": "Steeds overal hetzelfde, zonder onregelmatigheden of uitschieters.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "constantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alleen iemand met een <w>gelijkmatig</w> karakter kan <w>gelijkmatig</w> goed presteren.",
                            "target_lang_translations": {
                                "ru": "Только человек с <w>ровным</w> характером может <w>стабильно</w> хорошо работать.",
                                "en": "Only someone with an <w>even</w> temperament can perform <w>consistently</w> well."
                            }
                        },
                        {
                            "text": "De temperatuur in de kas blijft het hele jaar door zeer <w>gelijkmatig</w>.",
                            "target_lang_translations": {
                                "ru": "Температура в теплице остается очень <w>ровной</w> в течение всего года.",
                                "en": "The temperature in the greenhouse remains very <w>steady</w> throughout the year."
                            }
                        }
                    ],
                    "synonyms": [
                        "evenwichtig",
                        "regelmatig"
                    ],
                    "antonyms": [
                        "ongelijkmatig"
                    ],
                    "common_phrases": [
                        "gelijkmatig karakter",
                        "gelijkmatig verdelen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно одинаковый, без неровностей, отклонений или резких перепадов.",
                        "en": "Constantly uniform throughout, without irregularities, extremes, or sharp fluctuations."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ровный",
                                "target_lang_sense_clarification": "о характере, температуре или поверхности"
                            },
                            {
                                "target_lang_word": "стабильный",
                                "target_lang_sense_clarification": "о состоянии, которое не меняется"
                            },
                            {
                                "target_lang_word": "уравновешенный",
                                "target_lang_sense_clarification": "о характере человека"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "even",
                                "target_lang_sense_clarification": "stable, consistent, or well-balanced without wild fluctuations"
                            },
                            {
                                "target_lang_word": "even-tempered",
                                "target_lang_sense_clarification": "calm and emotionally balanced"
                            },
                            {
                                "target_lang_word": "regular",
                                "target_lang_sense_clarification": "consistent and uniform over time"
                            },
                            {
                                "target_lang_word": "steady",
                                "target_lang_sense_clarification": "reliable and unchanging"
                            }
                        ]
                    }
                }
            ]
        }
    ]
