    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b17f01b4-b864-3a18-9812-237e1514a269",
                    "sense_definition": "A sauce, especially a cold one used to flavor salads.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "culinary_sauce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She poured some Italian <w>dressing</w> over her fresh green salad.",
                            "target_lang_translations": {
                                "ru": "Она полила свой свежий зеленый салат итальянской <w>заправкой</w>.",
                                "zh": "她在新鲜的绿色沙拉上淋了一些意大利<w>沙拉酱</w>。"
                            }
                        },
                        {
                            "text": "Would you like the salad <w>dressing</w> on the side or mixed in?",
                            "target_lang_translations": {
                                "ru": "Вы хотите <w>заправку</w> для салата отдельно или смешать сразу?",
                                "zh": "你想要把<w>沙拉酱</w>分开装还是直接拌进去？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "salad dressing",
                        "ranch dressing",
                        "Italian dressing",
                        "French dressing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соус, особенно холодный, используемый для заправки салатов.",
                        "zh": "一种调味汁，通常是冷食，用于给沙拉调味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заправка",
                                "target_lang_sense_clarification": "для салата"
                            },
                            {
                                "target_lang_word": "соус",
                                "target_lang_sense_clarification": "кулинарный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沙拉酱",
                                "target_lang_sense_clarification": "用于沙拉的调味汁"
                            },
                            {
                                "target_lang_word": "调味汁",
                                "target_lang_sense_clarification": "通用的烹饪调味酱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6348edd3-5ae6-3e39-9265-4bdf4e732f6c",
                    "sense_definition": "The activity of putting on clothes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child is learning to handle his own <w>dressing</w> in the morning.",
                            "target_lang_translations": {
                                "ru": "Ребенок учится справляться с <w>одеванием</w> по утрам самостоятельно.",
                                "zh": "孩子正在学习早上自己<w>穿衣</w>。"
                            }
                        },
                        {
                            "text": "She finished her <w>dressing</w> quickly so she would not be late for work.",
                            "target_lang_translations": {
                                "ru": "Она быстро закончила <w>одевание</w>, чтобы не опоздать на работу.",
                                "zh": "她很快就<w>穿好</w>了衣服，以免上班迟到。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "help with dressing",
                        "finish dressing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс надевания одежды.",
                        "zh": "穿衣服的动作或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одевание",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿衣",
                                "target_lang_sense_clarification": "穿衣服的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d879ea5-addb-3ac8-9959-cc870864df62",
                    "sense_definition": "Material applied to a wound to protect it and help it heal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse applied a sterile <w>dressing</w> to the deep cut on his arm.",
                            "target_lang_translations": {
                                "ru": "Медсестра наложила стерильную <w>повязку</w> на глубокий порез на его руке.",
                                "zh": "护士在他手臂的深伤口上贴了一块无菌<w>敷料</w>。"
                            }
                        },
                        {
                            "text": "You need to change the <w>dressing</w> every day to keep the wound clean.",
                            "target_lang_translations": {
                                "ru": "Вам нужно менять <w>повязку</w> каждый день, чтобы рана оставалась чистой.",
                                "zh": "你需要每天更换<w>敷料</w>以保持伤口清洁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sterile dressing",
                        "wound dressing",
                        "change the dressing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, накладываемый на рану для её защиты и содействия заживлению.",
                        "zh": "敷在伤口上以保护伤口并促进愈合的材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повязка",
                                "target_lang_sense_clarification": "медицинская"
                            },
                            {
                                "target_lang_word": "перевязка",
                                "target_lang_sense_clarification": "материал или процедура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敷料",
                                "target_lang_sense_clarification": "医疗用的覆盖材料"
                            },
                            {
                                "target_lang_word": "绷带",
                                "target_lang_sense_clarification": "用于包扎的材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75335880-1342-3c42-bc1c-993c7970bebd",
                    "sense_definition": "A mixture of seasoned ingredients used to stuff poultry or meat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "culinary_stuffing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We always serve turkey with cornbread <w>dressing</w> for the holiday dinner.",
                            "target_lang_translations": {
                                "ru": "Мы всегда подаем индейку с <w>начинкой</w> из кукурузного хлеба на праздничный ужин.",
                                "zh": "节日晚餐时，我们总是用玉米面包<w>填料</w>来搭配火鸡。"
                            }
                        },
                        {
                            "text": "The chef prepared a savory <w>dressing</w> to go inside the roasted chicken.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил пикантную <w>начинку</w>, чтобы нафаршировать жареную курицу.",
                                "zh": "厨师准备了一种美味的<w>填料</w>塞进烤鸡里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forcemeat"
                    ],
                    "common_phrases": [
                        "turkey dressing",
                        "cornbread dressing"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in US English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смесь приправленных ингредиентов, используемая для фаршировки птицы или мяса.",
                        "zh": "一种由调味配料混合而成，用于填充禽类或肉类的馅料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинка",
                                "target_lang_sense_clarification": "для фаршировки"
                            },
                            {
                                "target_lang_word": "фарш",
                                "target_lang_sense_clarification": "кулинарный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "填料",
                                "target_lang_sense_clarification": "用于塞入肉类内部的馅料"
                            },
                            {
                                "target_lang_word": "馅",
                                "target_lang_sense_clarification": "烹饪中的填充物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73067353-b533-3a46-bfd4-8d30d4e55285",
                    "sense_definition": "A severe scolding or reprimand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave him a real <w>dressing</w> for losing the important files.",
                            "target_lang_translations": {
                                "ru": "Менеджер устроил ему настоящий <w>разнос</w> за потерю важных файлов.",
                                "zh": "经理因为他弄丢了重要文件而狠狠地<w>训斥</w>了他一顿。"
                            }
                        },
                        {
                            "text": "He received a public <w>dressing</w> after making such a careless mistake.",
                            "target_lang_translations": {
                                "ru": "Он получил публичный <w>нагоняй</w> после такой небрежной ошибки.",
                                "zh": "他在犯下如此粗心的错误后，受到了公开的<w>责骂</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dressing down",
                        "give a dressing"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Строгий выговор или порицание.",
                        "zh": "严厉的训斥或责备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагоняй",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "взбучка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "выволочка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "训斥",
                                "target_lang_sense_clarification": "严厉的批评"
                            },
                            {
                                "target_lang_word": "责骂",
                                "target_lang_sense_clarification": "口语化的严厉批评"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c65d333-f26b-3c44-8687-029993dcc04a",
                    "sense_definition": "Something added to the soil, such as fertilizer or manure, to improve it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer applied a top <w>dressing</w> of compost to the vegetable patch.",
                            "target_lang_translations": {
                                "ru": "Фермер внес поверхностное <w>удобрение</w> из компоста на грядку с овощами.",
                                "zh": "农民在菜地表面施了一层堆肥作为<w>追肥</w>。"
                            }
                        },
                        {
                            "text": "A spring <w>dressing</w> helps the lawn grow thick and green.",
                            "target_lang_translations": {
                                "ru": "Весенняя <w>подкормка</w> помогает газону расти густым и зеленым.",
                                "zh": "春季的<w>肥料</w>有助于草坪长得浓密翠绿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "top dressing",
                        "soil dressing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, добавляемое в почву, например удобрение или навоз, для её улучшения.",
                        "zh": "添加到土壤中以改善土质的物质，如肥料或粪肥。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удобрение",
                                "target_lang_sense_clarification": "для почвы"
                            },
                            {
                                "target_lang_word": "подкормка",
                                "target_lang_sense_clarification": "растений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肥料",
                                "target_lang_sense_clarification": "用于改善土壤的物质"
                            },
                            {
                                "target_lang_word": "追肥",
                                "target_lang_sense_clarification": "农业中补充的养分"
                            }
                        ]
                    }
                }
            ]
        },
