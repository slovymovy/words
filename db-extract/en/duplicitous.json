                    {
                        "translation_id": "5f0292b1-3778-45a0-9aab-e619934314cd",
                        "source_entry_id": "9f556074-8434-325d-b123-2b30ae34b85a",
                        "source_sense_id": "8fbb2cc1-47b5-33ac-8391-d7ca2befcaaa",
                        "source_sense_description": "given to or marked by deliberate deceptiveness in behavior or speech",
                        "target_lang_word": "heuchlerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heuchlerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                        "entry_id": "62b7d991-e829-3928-a1a4-222f4a2cbe5e",
                                        "glosses": [
                                            "in der Art eines Heuchlers handelnd, unaufrichtig"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b27a2e73-b73a-4273-bec3-e707ec4941da",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Und als er zum König vorgelassen wurde, huldigte er ihm heuchlerisch und brachte das Amt des Hohenpriesters dadurch an sich selber, dass er dem König dreihundert Talente Silber mehr gab als Jason.“"
                                            },
                                            {
                                                "example_id": "41d2e0d3-943b-4db4-8376-c652ef4de64f",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Genauso heuchlerisch ist es, wenn der rechte Rand unserer Gesellschaft für den Weihnachtsbaum in der Kita kämpft, aber die Ramadan-Beleuchtung ablehnt.“"
                                            },
                                            {
                                                "example_id": "66cef11d-3595-4ab0-8cfb-31f821fa06e5",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Der Jurist Steffen Augsberg“ […] „sagte, es gebe ein \"massives Vollzugsdefizit\" zwischen Tierschutz auf dem Papier und der Praxis in der Nutztierhaltung: »Ich kenne kein einziges Rechtsgebiet, in dem so heuchlerisch vorgegangen wird wie im Tierschutz - wo so viel oben drinsteht und so wenig unten ankommt.«“"
                                            },
                                            {
                                                "example_id": "e2a33367-2c28-4a20-9c7c-a912f89fbf18",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Schadenfreude über den Tod von Wilderern ist heuchlerisch.“ […] „Im Jahr 2017 wurden allein in Deutschland 57,9 Millionen Schweine und 3,5 Millionen Rinder geschlachtet, damit wir im Discounter Steaks für 2,99 Euro kaufen können.“"
                                            },
                                            {
                                                "example_id": "8bdfaeeb-0117-413c-9ce5-4e6bb66eb34d",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Ich bin konfessionslos.“ […] „Ich möchte gern noch weitere Kirchen bauen.“ […] „Aber manche Kirchen erwarten, dass man Mitglied einer der großen Konfessionen ist. Da bin ich in einer Zwickmühle. Es wäre heuchlerisch, mich jetzt taufen zu lassen und einer großen Konfession beizutreten, um weitere Kirchen bauen zu dürfen.“"
                                            },
                                            {
                                                "example_id": "37f1b978-08a4-4ceb-bbf6-ba8d37282581",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Es geht in diesem Song um so eine Heuchelei, eine heuchlerische Empathie einer oberen Schicht, die sich halt dadurch kennzeichnet, dass sie halt mehr darüber redet, dass sie Gutes tut, als dass sie wirklich was bewirken will.“"
                                            },
                                            {
                                                "example_id": "8558bbd2-6df5-418a-abbb-4a2edca194ea",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Was haben wir etwa vom Judentum gelernt? Ein Zerrbild zumeist. Die heuchlerischen Pharisäer der Jesus-Geschichten. Der verräterische Judas. Juden - angeblich die Mörder unseres Heilands.“"
                                            },
                                            {
                                                "example_id": "fe77d2c5-4a72-469a-b537-f2952beed4a0",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Die Serben betrachten die westliche Politik als heuchlerisch,“ […]."
                                            },
                                            {
                                                "example_id": "329cd1e7-295e-4294-9cc4-ff5c6e0d9271",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Zu gut passt das rigorose Vorgehen polnischer Grenzschützer in das russische Narrativ vom heuchlerischen Westen, der einerseits Menschenrechte predigt, gleichzeitig jedoch Menschen in Not nicht aufnehmen möchte.“"
                                            },
                                            {
                                                "example_id": "00b8a3dc-b5c1-444f-90d1-19f81e60f07c",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "„Kommentatoren großer arabischer Zeitungen attestieren dem Westen eine heuchlerische Politik.“"
                                            },
                                            {
                                                "example_id": "8369a269-9b19-40da-a9cf-254f75176c64",
                                                "sense_id": "1b7631d2-087f-381f-bd21-5b18ddd35e4a",
                                                "text": "[Radrennsport:] „Am 13.7.1967 starb der Brite Tom Simpson – vollgepumpt mit Amphetaminen und Alkohol – während der Tour am Mont Ventoux. Der jähe Tod des 29-Jährigen zeugt vom damals heuchlerischen öffentlichen Umgang mit Doping.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bbd0bfa-66c5-386c-86df-27c65d725a22",
                                        "entry_id": "62b7d991-e829-3928-a1a4-222f4a2cbe5e",
                                        "glosses": [
                                            "von Heuchelei zeugend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
