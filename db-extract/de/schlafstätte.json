                "senses": [
                    {
                        "sense_id": "fb4757bd-a52c-31fe-9f67-5c1775fac7d3",
                        "entry_id": "e8491845-483b-3400-81ad-28f3d6d51682",
                        "glosses": [
                            "ein Platz, an dem man schlafen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0c77a5-93be-4832-8655-f150e033c42d",
                                "sense_id": "fb4757bd-a52c-31fe-9f67-5c1775fac7d3",
                                "text": "„Mama teilt sich die Schlafstätte mit Frída und Marta, Ola und Micka wohnen in einem anderen Zimmer.“"
                            },
                            {
                                "example_id": "a2340321-4fa8-42aa-8a40-3d0133dc6cf0",
                                "sense_id": "fb4757bd-a52c-31fe-9f67-5c1775fac7d3",
                                "text": "„Pritschen stehen auf Holzbeinen, eine Strohunterlage macht die Schlafstätte zum weichen Himmelsbett.“"
                            },
                            {
                                "example_id": "448f2210-b014-461a-9795-35131c535bc0",
                                "sense_id": "fb4757bd-a52c-31fe-9f67-5c1775fac7d3",
                                "text": "„Grenfeld lag unruhig auf seiner Schalfstätte, die er sich auf dem Sofa eingerichtet hatte.“"
                            },
                            {
                                "example_id": "1ffc6e67-cd39-403e-a296-3b88eb2b9305",
                                "sense_id": "fb4757bd-a52c-31fe-9f67-5c1775fac7d3",
                                "text": "„Die meisten Götzlacker, die es bis hierher geschafft hatten, strebten in ihre neuen Quartiere, mit einer halbwegs bequemen Schlafstätte und einer Waschmöglichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
