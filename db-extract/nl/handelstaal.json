                                                "example_id": "192215cc-ff6b-4f15-88e6-f2948dc5704c",
                                                "sense_id": "4900cc3d-6018-3f51-aa1b-ca8e56c10a56",
                                                "text": "„Die Kaufmannssprache steht zu allen Zeiten stark unter fremden Einflüssen.“"
                                            },
                                            {
                                                "example_id": "82ae8def-c13a-4e78-a3a3-10ed7e5c5fe9",
                                                "sense_id": "4900cc3d-6018-3f51-aa1b-ca8e56c10a56",
                                                "text": "„Die enge Verbindung mit dem italienischen Wirtschaftsgebiet führte dazu, dass die deutschen Kaufmannssprachen im 15. und 16. Jahrhundert sehr viele Wörter aus dem Italienischen entlehnten.“"
                                            }
