                    {
                        "sense_id": "ef0c5559-3c22-3804-8c7f-9cfaaef378e8",
                        "entry_id": "baf0306c-cd70-39b5-992c-86f4088b4196",
                        "glosses": [
                            "Enzyme qui catalyse la réaction biochimique de fermentation alcoolique, en transformant le glucose (ou d’autres sucres) en éthanol et en dioxyde de carbone (appelé aussi gaz carbonique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02bd3cb7-a14c-484d-8c58-518cb081ee88",
                                "sense_id": "ef0c5559-3c22-3804-8c7f-9cfaaef378e8",
                                "text": "Ces auteurs attribuent la formation du noir de seiche et du pigment mélanique des tumeurs du cheval et même de la peau du nègre à l’action des zymases"
                            }
                        ]
                    }
                ],
