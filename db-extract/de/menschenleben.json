                    {
                        "form_id": "b0e93246-2240-4f5d-9e54-b28acf17a29a",
                        "entry_id": "c0aff8f1-2ad6-342b-a203-c7f38e95dfb8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Menschenleben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11c62a50-93a2-3deb-a839-3da957c5650e",
                        "entry_id": "c0aff8f1-2ad6-342b-a203-c7f38e95dfb8",
                        "glosses": [
                            "die Dauer des Lebens eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58d98de-0e2d-4d10-9094-5633116820b3",
                                "sense_id": "11c62a50-93a2-3deb-a839-3da957c5650e",
                                "text": "Ein Menschenleben reicht nicht, um alle Sprachen dieser Welt zu lernen."
                            },
                            {
                                "example_id": "e7140e99-9be5-4dea-844f-62151411a77e",
                                "sense_id": "11c62a50-93a2-3deb-a839-3da957c5650e",
                                "text": "„Letztlich kann der Rufname im Laufe eines Menschenlebens auch gewechselt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1fb48f47-5d1d-3867-8de4-c944d76091cd",
                        "entry_id": "c0aff8f1-2ad6-342b-a203-c7f38e95dfb8",
                        "glosses": [
                            "ein (lebendes) menschliches Individuum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d403a1-c5a4-4162-ba06-d4d7ec5188ae",
                                "sense_id": "1fb48f47-5d1d-3867-8de4-c944d76091cd",
                                "text": "Der Brand kostete 5 Menschenleben."
                            },
                            {
                                "example_id": "beedf9f0-64d1-4681-a907-0d3ae70bc0a6",
                                "sense_id": "1fb48f47-5d1d-3867-8de4-c944d76091cd",
                                "text": "„Über einhundert Jahre war die Geschichte der Bluttransfusionen eine Erfolgsstory: Millionen Menschenleben wurden durch sie gerettet, das Spenden galt lange als selbstverständliche Bürgerpflicht.“"
                            },
                            {
                                "example_id": "111c20a0-9aeb-4bbb-914c-9398ae543b45",
                                "sense_id": "1fb48f47-5d1d-3867-8de4-c944d76091cd",
                                "text": "„Mit Kondomen und besseren Medikamenten werden ganz konkret Menschenleben gerettet.“"
                            },
                            {
                                "example_id": "6149a588-fd65-4650-9ef8-51ccc72a03ef",
                                "sense_id": "1fb48f47-5d1d-3867-8de4-c944d76091cd",
                                "text": "„Es dämmert erneut die Zeit herauf, in der ein Menschenleben für die sich zunehmend radikalisierende Gesellschaft ohne Wert ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "aa6384b3-dabb-3fcf-b1fd-db4106fa8e51",
                        "entry_id": "c0aff8f1-2ad6-342b-a203-c7f38e95dfb8",
                        "glosses": [
                            "die Umstände der menschliche Existenz in seiner Gesamtheit"
                        ],
                        "tags": [
                            "literary",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "dcba24db-b81f-491c-9e7f-8d14a1ed7551",
                                "sense_id": "aa6384b3-dabb-3fcf-b1fd-db4106fa8e51",
                                "text": "Niemand weiß, ob das Menschenleben das 21. Jahrhundert überstehen wird."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
