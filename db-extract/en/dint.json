            {
                "entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
                "word": "dint",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c409ff0d-6b22-446e-940e-289ea7eb9bc0",
                        "entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
                        "tags": [
                            "plural"
                        ],
                        "form": "dints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5dc23a5-b4a2-36b1-a8f8-1359f7e29496",
                        "entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
                        "glosses": [
                            "A blow, stroke, especially dealt in a fight."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b78eebd-53b9-472a-aa74-9874d842b55e",
                                "sense_id": "b5dc23a5-b4a2-36b1-a8f8-1359f7e29496",
                                "text": "Much daunted with that dint, her sence was dazd […]"
                            },
                            {
                                "example_id": "31fba060-9dab-4ef7-a167-0c41d9ed951d",
                                "sense_id": "b5dc23a5-b4a2-36b1-a8f8-1359f7e29496",
                                "text": "Between them cross-bows stood, and engines wrought / To cast a stone, a quarry, or a dart, // From whence, like thunder's dint, or lightnings new, / Against the bulwarks stones and lances flew."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4dc3ed0-8d2d-3ec7-ae3f-d82db3cd58e2",
                        "entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
                        "glosses": [
                            "Force, power; especially in by dint of."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "537c15c0-6c44-45e1-858d-e14aea85ec24",
                                "sense_id": "d4dc3ed0-8d2d-3ec7-ae3f-d82db3cd58e2",
                                "text": "O, now you weep; and, I perceive, you feel / The dint of pity"
                            },
                            {
                                "example_id": "326e5da6-c85e-42b7-8254-da6386b411de",
                                "sense_id": "d4dc3ed0-8d2d-3ec7-ae3f-d82db3cd58e2",
                                "text": "It was by dint of passing strength / That he moved the massy stone at length."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ea09c5a-ee7f-386c-8a09-7298d3ac169e",
                        "entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
                        "glosses": [
                            "The mark left by a blow; an indentation or impression made by violence; a dent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a31f14af-1078-45e3-ab84-07dee2cb9013",
                                "sense_id": "3ea09c5a-ee7f-386c-8a09-7298d3ac169e",
                                "text": "and read the naked shield,[…] Of every dint a sword had beaten in it, / And every scratch a lance had made upon it"
                            },
                            {
                                "example_id": "9f6f2527-21b8-47c5-8855-000de2c91ae8",
                                "sense_id": "3ea09c5a-ee7f-386c-8a09-7298d3ac169e",
                                "text": "His hands had made a dint, and hurt his maid; / Explored her limb by limb, and feared to find / So rude a gripe had left a livid mark behind."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bf3dff4-08fc-4625-a763-80cf0bcb707d",
                        "source_entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
