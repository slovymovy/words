                                    {
                                        "sense_id": "8209832a-02a6-30fb-b3b7-05e725629383",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Constituting a province."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93ba8fb9-0fa3-33ea-9c3c-df51f25e98b1",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Exhibiting the ways or manners of a province; characteristic of the inhabitants of a province."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "902fc7d7-0086-467a-ad10-6664034beb36",
                                                "sense_id": "93ba8fb9-0fa3-33ea-9c3c-df51f25e98b1",
                                                "text": "[…] fond of exhibiting provincial airs and graces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e28b21f-241d-3585-afac-c79141179df1",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Not cosmopolitan; backwoodsy, hick, yokelish, countrified; not polished; rude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db9549b-a3c6-4f1e-b751-fcda89269ba0",
                                                "sense_id": "9e28b21f-241d-3585-afac-c79141179df1",
                                                "text": "That awful little Cedar Whatever is no thriving megalopolis, and you people are so provincial, it's appalling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824c4a41-2ee2-3fde-a98b-fda040092593",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Narrow; illiberal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1403ff0-42f8-378d-9cd6-9d1becaa1c49",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Of or pertaining to an ecclesiastical province, or to the jurisdiction of an archbishop; not ecumenical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7390e78e-1494-490f-b0b8-57a03da86e01",
