                "senses": [
                    {
                        "sense_id": "30e137ab-ba8f-3f97-81ce-6e0b9bc8cb9d",
                        "entry_id": "109a5c97-2dd1-3d93-880c-63fffd68d08b",
                        "glosses": [
                            "To hang out or chill out; to relax."
                        ],
                        "tags": [
                            "Jamaica",
                            "Multicultural-London-English",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ce1edffd-4ec1-41fa-a3b8-631d3d3f2701",
                                "sense_id": "30e137ab-ba8f-3f97-81ce-6e0b9bc8cb9d",
                                "text": "I’m sitting here cotching by the side of the road / Watching the world go by through the eyes of a rogue"
                            },
                            {
                                "example_id": "27cc17de-8408-4e17-84cf-bd9773b221da",
                                "sense_id": "30e137ab-ba8f-3f97-81ce-6e0b9bc8cb9d",
                                "text": "And we don't really need Netflix, I'mma give you something to watch / After we done, bill a spliff and cotch / Pour me a glass of the Henny on the rocks"
                            }
                        ]
                    },
                    {
                        "sense_id": "84a4be6e-6212-3da1-9991-36d36a542de2",
                        "entry_id": "109a5c97-2dd1-3d93-880c-63fffd68d08b",
                        "glosses": [
                            "To prop, lean, rest."
                        ],
                        "tags": [
                            "Jamaica",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "73b7f915-d472-4ad5-b146-c82982a545af",
                                "sense_id": "84a4be6e-6212-3da1-9991-36d36a542de2",
                                "text": "She gestures toward the crème with her chin, an action that she has seen the women in the shop do when they place their orders, their confidence evident in the way they stand, leaning with all their weight on the counter, one leg cotched on the back of the other."
                            }
                        ]
                    }
