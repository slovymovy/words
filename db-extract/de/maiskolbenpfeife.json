                "senses": [
                    {
                        "sense_id": "89d9d82c-e01b-37bf-a576-1c04983a6aa6",
                        "entry_id": "ce2af479-2b71-3516-ab89-08c8b148f7ce",
                        "glosses": [
                            "aus dem Innenteil von Maiskolben hergestellte Tabakpfeife"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6908ee8-8438-485a-8c2e-df2273ffc05a",
                                "sense_id": "89d9d82c-e01b-37bf-a576-1c04983a6aa6",
                                "text": "„Die Männer, die ihre Maiskolbenpfeifen rauchten, beobachteten die künstlichen Blitze und sagten: ›Die Front rückt näher.‹“"
                            },
                            {
                                "example_id": "bc8cb449-9556-4dac-928b-68049e58330b",
                                "sense_id": "89d9d82c-e01b-37bf-a576-1c04983a6aa6",
                                "text": "„Er saß im Heck des Ruderbootes und ließ seine Hand durch das kalte Kielwasser gleiten, während sein Onkel sich in die Riemen legte. Die Füße des Alten in ihren schwarzen Kinderschuhen gegen die Spanten gestemmt. Sein Strohhut. Die Maiskolbenpfeife zwischen seinen Zähnen und am Pfeifenkopf ein dünner, leicht schwingender Sabberfaden.“"
                            },
                            {
                                "example_id": "076a95c7-bd44-4e45-974d-c8e0ebd64a05",
                                "sense_id": "89d9d82c-e01b-37bf-a576-1c04983a6aa6",
                                "text": "„Der Minister seufzte, holte seine Maiskolbenpfeife hervor und stopfte sie aus einer Dose Prince Albert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
