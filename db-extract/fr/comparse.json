                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5441cba7-9f17-39e2-95df-c09769d88e2a",
                                        "entry_id": "7955c81c-ff53-3fbc-a203-b4c8f32f85e6",
                                        "glosses": [
                                            "an einer Straftat Beteiligter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d97e8d-909b-451e-afac-3dbeaeeb376d",
                                                "sense_id": "5441cba7-9f17-39e2-95df-c09769d88e2a",
                                                "text": "Egon Olsen und seine Komplizen Kjeld und Benny haben manches auf dem Kerbholz."
                                            },
                                            {
                                                "example_id": "cf37721a-c1c4-4f80-896e-dc0b8e866ca4",
                                                "sense_id": "5441cba7-9f17-39e2-95df-c09769d88e2a",
                                                "text": "Der Mieter soll der 37-jährige Komplize des Trios gewesen sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ea8cc41-6aaf-4602-a519-1d85373a63ec",
                        "source_entry_id": "2033fe91-0196-3354-be54-1b00615ad949",
                        "target_lang_word": "Komparsin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komparsin",
