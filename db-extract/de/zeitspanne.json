                        ],
                        "form": "die Zeitspannen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                        "entry_id": "c0ff0af9-461d-3a33-8e41-787ef75e65ab",
                        "glosses": [
                            "abgegrenzter, abgeschlossener, genau bestimmter Zeitabschnitt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd5ddca-f81e-4667-970c-fb35d686dcf7",
                                "sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                                "text": "Das ist für eine Zeitspanne von fünf Jahren vorgesehen."
                            },
                            {
                                "example_id": "6c0fe865-ec41-4715-aaeb-e7907227139b",
                                "sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                                "text": "„Die Zeit, die erforderlich ist, um mit dieser Geschwindigkeit dasjenige unserer Milchstraße vergleichbare Sternsystem, das uns im Weltraum am nächsten liegt, zu erreichen (Spiralsystem im Sternbild Andromeda, rund 2 Millionen Lichtjahre entfernt), ist etwa 10mal so lang wie die Zeitspanne, die seit der Entstehung unseres Sonnensystems verflossen ist, nämlich 60 Milliarden Jahre!“"
                            },
                            {
                                "example_id": "e9643dc3-c68d-4ac8-af11-71a4371cb208",
                                "sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                                "text": "„Zwischen beiden Wörtern liegt eine riesige Zeitspanne und die Entwicklung einer ganzen Zivilisation.“"
                            },
                            {
                                "example_id": "0e902163-173a-44f7-94f6-6aab65a71ed8",
                                "sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                                "text": "„Für eine kurze Zeitspanne hat er bereits in Manchester zusammen mit ein paar anderen Jungen – Mädchen waren nicht zugelassen – Religionsunterricht gehabt.“"
                            },
                            {
                                "example_id": "6934bc4d-83cf-4f46-b754-cc33f7ebd3d0",
                                "sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                                "text": "„Die Einnahmen der sächsischen Fürsten aus dem Silberbergbau des Erzgebirges wurden allein für die Zeitspanne von 1535 bis 1545 auf eine Million Gulden geschätzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fba6199d-6b50-4c8d-9d08-64a13cbfcbff",
