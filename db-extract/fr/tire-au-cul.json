                                                "example_id": "9f5f7745-75c6-41cd-a870-f45f7efebde1",
                                                "sense_id": "9d533dbb-83d1-3b19-9177-0f25a1fc6104",
                                                "text": "the shirkers in the family complain when she gets them chopping up wood for a few hours in the woodshed"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc65951c-ecf5-4393-a300-1cf60d3d3de7",
                        "source_entry_id": "bdf9a09b-5b62-3d8d-bb96-2c4cdf98768c",
                        "source_sense_id": "823af6f8-ec3c-3423-985d-ab9c1d7da04a",
                        "target_lang_word": "slacker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slacker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5249557d-46b2-3fb4-9795-05a40cff9d36",
                                        "entry_id": "190a7584-642c-3024-afc1-14cab9793c5f",
                                        "glosses": [
                                            "One who procrastinates or is lazy; one who does not do their fair share or pull their own weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9e4ab7-a36e-4566-a371-7cf52593d099",
                                                "sense_id": "5249557d-46b2-3fb4-9795-05a40cff9d36",
                                                "text": "Some evil fellows said behind his back that Beowulf was white-livered and a slacker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93860269-b96f-355b-aca8-9b3536c0bac3",
                                        "entry_id": "190a7584-642c-3024-afc1-14cab9793c5f",
                                        "glosses": [
                                            "A person lacking a sense of direction in life; an underachiever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d521fea1-c2e8-406d-addd-b0858e0fafba",
                                                "sense_id": "93860269-b96f-355b-aca8-9b3536c0bac3",
                                                "text": "“I don’t think this is a generation of slackers,” said Carl Van Horn, a labor economist at Rutgers. “This image of the kid who goes off and skis in Colorado, I don’t think that’s the correct image. Today’s young people are very focused on trying to work hard and to get ahead.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "463cb007-0dee-3754-8550-c7d17b68a51a",
                                        "entry_id": "190a7584-642c-3024-afc1-14cab9793c5f",
                                        "glosses": [
                                            "A member of a certain 1990s subculture associated with Generation X."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e5e67e-9b5a-41f8-a645-67d181b51237",
                                                "sense_id": "463cb007-0dee-3754-8550-c7d17b68a51a",
                                                "text": "Kevin Smith wrote and directed the slacker hits “Clerks,” “Dogma” and “Chasing Amy,” but lately it is his other life—maintaining six Web sites that he describes as “devoted to my fans and my films”—that seems to consume him."
                                            },
                                            {
                                                "example_id": "99deb778-df7d-4001-b1b9-a5853bc6f005",
                                                "sense_id": "463cb007-0dee-3754-8550-c7d17b68a51a",
                                                "text": "Gen Xers were said to be lazy—“slackers” in the parlance of the time—who didn’t exhibit the straightforward work ethic of their predecessors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff8be0c7-5e46-3732-977b-85d7ca1245c7",
                                        "entry_id": "190a7584-642c-3024-afc1-14cab9793c5f",
                                        "glosses": [
                                            "A person who seeks to avoid military service."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1bfead2-1e13-461e-8740-436688b147dc",
                                                "sense_id": "ff8be0c7-5e46-3732-977b-85d7ca1245c7",
                                                "text": "[S]everal hundred prisoners captured in North Jersey slacker raids last week and sent to this camp are being Inducted into military service today[…]"
                                            },
                                            {
                                                "example_id": "612587d5-7bb2-41ea-9626-5225dff9f398",
                                                "sense_id": "ff8be0c7-5e46-3732-977b-85d7ca1245c7",
                                                "text": "Senator Burton K. Wheeler opened his fight in the Senate today[…], raising the cry of \"slackers\" against deferred workers in Government establishments and industry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61650a52-5a75-39ab-87e1-263db33c24d9",
                                        "entry_id": "190a7584-642c-3024-afc1-14cab9793c5f",
                                        "glosses": [
                                            "A user of the Slackware Linux distribution."
                                        ],
                                        "tags": [
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28efa469-e20b-4c30-9b0d-b218391690f2",
                                                "sense_id": "61650a52-5a75-39ab-87e1-263db33c24d9",
                                                "text": "Hope you become a happy slacker."
                                            },
                                            {
                                                "example_id": "a32268b0-c43b-4c82-84b7-b8f35c6ae23d",
                                                "sense_id": "61650a52-5a75-39ab-87e1-263db33c24d9",
                                                "text": "Any real Slacker would know better than to top-post, AND post a bunch of HTML-crap to boot. You're not worthy."
                                            },
                                            {
                                                "example_id": "dbbb2bed-5f27-4adf-b70a-8f242e7ea9f3",
                                                "sense_id": "61650a52-5a75-39ab-87e1-263db33c24d9",
                                                "text": "I'm a slacker from way back btw"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slacker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "758b2743-8dfb-38fe-8084-4f3e9696eb7b",
