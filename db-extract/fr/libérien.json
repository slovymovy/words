                                "target_senses": [
                                    {
                                        "sense_id": "650755ed-9d01-34fc-9272-9ce1ca738b8c",
                                        "entry_id": "f1e343d4-24b7-38f2-8145-eced62b6d4bb",
                                        "glosses": [
                                            "A person from Liberia or of Liberian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3089137-726f-4706-b52c-2161f9302bba",
                                                "sense_id": "650755ed-9d01-34fc-9272-9ce1ca738b8c",
                                                "text": "Several Liberians voiced their offense over Trump’s comment to Boakai, given the US president’s past remarks on African countries and the colonial legacy left by the US organization in Liberia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Liberian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "404000f7-51c6-32fa-885e-7ba06854c22a",
                                        "entry_id": "f4e9b166-bb58-3996-b1d8-537ca34cc071",
                                        "glosses": [
                                            "Of, from, or pertaining to Liberia or the Liberian people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
