            "senses": [
                {
                    "sense_id": "4400f07d-1d54-3100-8a05-765123c0684b",
                    "sense_definition": "Simple past tense of <w>break</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>broke</w> the vase when she accidentally dropped it on the floor.",
                            "target_lang_translations": {
                                "ru": "Она <w>разбила</w> вазу, когда случайно уронила её на пол.",
                                "zh": "她不小心把花瓶掉在地上，把它<w>打破</w>了。"
                            }
                        },
                        {
                            "text": "My car <w>broke</w> down on the highway, so I had to call for help.",
                            "target_lang_translations": {
                                "ru": "Моя машина <w>сломалась</w> на шоссе, поэтому мне пришлось вызывать помощь.",
                                "zh": "我的车在高速公路上<w>坏了</w>，所以我不得不打电话求助。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола <w>break</w>.",
                        "zh": "动词 break 的过去式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломал",
