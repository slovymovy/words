                ],
                "senses": [
                    {
                        "sense_id": "a514bc4b-659b-3d65-a2c8-21e7a5b25818",
                        "entry_id": "8a3f63a1-702f-3478-a655-50aa48ae1b75",
                        "glosses": [
                            "Espèce minérale du groupe des silicates sous groupe des cyclosilicates composé de formule Be₃Al₂Si₆O₁₈."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf726eb-8822-4f52-a26b-160d5780ee6c",
                                "sense_id": "a514bc4b-659b-3d65-a2c8-21e7a5b25818",
                                "text": "Afin d’en finir avec cette orfèvrerie symbolique, disons encore que […] la sarde évoque les Séraphins, la topaze les Chérubins, le jaspe les Trônes, la chrysolithe les Dominations, le saphir les Vertus, l’onyx les Puissances, le béryl les Principautés, le rubis les Archanges et l’émeraude les Anges."
                            },
                            {
                                "example_id": "3a41b4bc-2c54-489a-ad80-6de2d401bbae",
                                "sense_id": "a514bc4b-659b-3d65-a2c8-21e7a5b25818",
                                "text": "Le béryl vert est l’émeraude tandis que la variété bleutée est l’aigue-marine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85cab14c-a3ad-4796-ac7d-458a690afdad",
                        "source_entry_id": "8a3f63a1-702f-3478-a655-50aa48ae1b75",
