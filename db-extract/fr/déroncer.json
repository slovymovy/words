                "senses": [
                    {
                        "sense_id": "871e6661-c130-3713-9d9a-e4eb11a9f9c6",
                        "entry_id": "7856ffe7-9338-3508-be80-3296bd6cfe96",
                        "glosses": [
                            "Débarrasser des ronces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae93a51-b8fe-4057-9257-63810f32e856",
                                "sense_id": "871e6661-c130-3713-9d9a-e4eb11a9f9c6",
                                "text": "L’appel aux « hôtes », auxquels on confiait ces zones incultes, à charge de les « déroncer, défricher et labourer », aidait à la transformation des rapports sociaux dans les campagnes."
                            },
                            {
                                "example_id": "0fa7e5cc-0ad1-4554-bc9f-5e888455f24f",
                                "sense_id": "871e6661-c130-3713-9d9a-e4eb11a9f9c6",
                                "text": "Et je pioche et déronce et débroussaille."
                            },
                            {
                                "example_id": "22bf8d41-caa8-4d0c-948b-4c5e13395ade",
                                "sense_id": "871e6661-c130-3713-9d9a-e4eb11a9f9c6",
                                "text": "Ouf! j'ai enfin pu faire ce que je voulais dans le terrain, désherber, déroncer, déchardonner et tondre."
                            }
                        ]
                    }
