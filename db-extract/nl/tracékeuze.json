                        "examples": [
                            {
                                "example_id": "bdd4c4fb-cafe-437d-ac2d-382df8a7e6c7",
                                "sense_id": "a2713943-9a05-3e11-bce4-99abf9ddb5fd",
                                "text": "ALMELO - De provincie Overijssel komt met een subsidie van twee ton over de brug voor doortrekken van de fietssnelweg F35 in Almelo. Maar het is allerminst zeker of de gemeente er gebruik van gaat maken. Dat hangt namelijk van de tracékeuze af."
                            },
                            {
                                "example_id": "647a8c05-7361-44bc-a6bb-a456d322a65c",
                                "sense_id": "a2713943-9a05-3e11-bce4-99abf9ddb5fd",
                                "text": "BORNE - Het tracé van de Verbindingsweg om Borne staat vast. De gemeenteraad van Borne stemde dinsdagavond in met een aangepaste versie van de tracékeuze van het college. Een bedrag 50.000 euro wordt gereserveerd voor het onderzoek naar een betere ontsluiting van de Molenkamp en een uitbreiding om Zenderen."
                            }
