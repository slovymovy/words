        "fr-extract.jsonl": [
            {
                "entry_id": "8bb88420-5e94-3fd1-8669-33a537a3bc14",
                "word": "mitten",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "925ed2a6-fee2-36cf-9923-5092e40fbe01",
                        "entry_id": "8bb88420-5e94-3fd1-8669-33a537a3bc14",
                        "glosses": [
                            "Au milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e138bd-7341-4374-931d-b1cbc7f19041",
                                "sense_id": "925ed2a6-fee2-36cf-9923-5092e40fbe01",
                                "text": "Sie stand mitten auf der Straße.",
                                "translation": "Elle était en plein milieu de la rue."
                            },
                            {
                                "example_id": "ffb933ac-bd67-4b5c-8ee5-d1cd1047bc20",
                                "sense_id": "925ed2a6-fee2-36cf-9923-5092e40fbe01",
                                "text": "Mitten in der Nacht hörte ich einen Schrei.",
                                "translation": "Au milieu de la nuit j’ai entendu un cri."
                            },
                            {
                                "example_id": "bc5b3deb-8238-4e08-9859-0855acf65811",
                                "sense_id": "925ed2a6-fee2-36cf-9923-5092e40fbe01",
                                "text": "Die Kugel traf ihn mitten in die Stirn.",
                                "translation": "La balle l’atteignit en plein front."
                            },
                            {
                                "example_id": "12c06e28-6dbb-469b-ac9a-de5976f6fccf",
                                "sense_id": "925ed2a6-fee2-36cf-9923-5092e40fbe01",
                                "text": "Am nächsten Tag, dem 17. April, um acht Uhr, hielt der Concierge den vorbeikommenden Arzt an und beschuldigte geschmacklose Spaßmacher, drei tote Ratten mitten in den Flur gelegt zu haben.",
                                "translation": "Le lendemain 17 avril, à huit heures, le concierge arrêta le docteur au passage et accusa des mauvais plaisants d’avoir déposé trois rats morts au milieu du couloir."
                            },
                            {
                                "example_id": "69590151-3328-46a0-8c36-bdc8f9da709f",
                                "sense_id": "925ed2a6-fee2-36cf-9923-5092e40fbe01",
                                "text": "Als ich Schritte höre, schrecke ich hoch. (...) Wer ist da? Es ist mitten in der Nacht. Warum schlägt mein Hund nicht an?",
                                "translation": "Je sursaute en entendant des pas. (...) Qui est là ? C’est le milieu de la nuit. Pourquoi est-ce que mon chien n’attaque pas ?"
                            },
                            {
                                "example_id": "f1b9c978-99b3-479e-8f4e-f2e504ca0024",
                                "sense_id": "925ed2a6-fee2-36cf-9923-5092e40fbe01",
                                "text": "Er hatte den Alten untersucht und saß jetzt mitten in diesem ärmlichen Esszimmer. Ja, er hatte Angst. Er wusste, dass ihn am nächsten Morgen in ebendieser Vorstadt ein Dutzend über ihren Beulen zusammengekrümmte Kranke erwarten würden.",
                                "translation": "Il avait examiné le vieux et maintenant il était assis au milieu de cette salle à manger misérable. Oui, il avait peur. Il savait que dans le faubourg même une dizaine de malades l’attendraient, le lendemain matin, courbés sur leurs bubons."
                            }
                        ]
                    }
                ],
