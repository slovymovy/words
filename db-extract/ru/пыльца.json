                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8915a108-07df-3b07-ac0b-2949607e70a5",
                                        "entry_id": "bc930704-7420-315f-8a88-08ce2e2f215e",
                                        "glosses": [
                                            "Pollen grains (microspores) produced in the anthers of flowering plants."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689f7cf6-9904-41e9-97d4-14865c731bb9",
                                                "sense_id": "8915a108-07df-3b07-ac0b-2949607e70a5",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68178c3c-2ac9-3998-83ce-532ef1b79253",
                                        "entry_id": "bc930704-7420-315f-8a88-08ce2e2f215e",
                                        "glosses": [
                                            "Fine powder in general, fine flour."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee7aa3da-80d3-43e8-bfb7-1320c6f38235",
                                                "sense_id": "68178c3c-2ac9-3998-83ce-532ef1b79253",
                                                "text": "and ther was good wyne of Gascoyne,[…]as well of pollen, as of other vitailes"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pollen",
