                        "sense_id": "3709141e-4e34-3d9c-97ac-cb047a47e0d2",
                        "entry_id": "495004f3-38c0-359f-807d-4deeebc3ee7d",
                        "glosses": [
                            "barwnie upierzony i żywiący się nektarem najmniejszy z ptaków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16304bc5-2dfe-4e10-ae6c-a3882c83581d",
                                "sense_id": "3709141e-4e34-3d9c-97ac-cb047a47e0d2",
                                "text": "Patrz, jakie piękne, różnobarwne papugi, złotopióre kolibry, przecudowne kwiaty i wspaniała roślinność"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd0a0364-e435-4f6d-91b6-b8855ee0ec9b",
                        "source_entry_id": "495004f3-38c0-359f-807d-4deeebc3ee7d",
                        "source_sense_id": "3709141e-4e34-3d9c-97ac-cb047a47e0d2",
