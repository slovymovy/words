                                            {
                                                "example_id": "22a36253-c81c-48c5-8887-bde976357658",
                                                "sense_id": "791ec5cd-ba42-336d-8e04-c9ee7a956b86",
                                                "text": "— Tu vois, mon maître, tu vois, s’écria-t-il, Jehol ne perdra pas la face à Kaboul – la grande ville, la Cité du Roi."
                                            },
                                            {
                                                "example_id": "d9df58cc-3fe7-4bfc-8cf8-073c9410ca04",
                                                "sense_id": "791ec5cd-ba42-336d-8e04-c9ee7a956b86",
                                                "text": "C'est désormais au Pakistan, ou en Iran, que la fréquentation des sites de téléchargement de films X est le plus assidue. Qui sait quelles bombes mentales s'allument dans les nuits solitaires de Kaboul ou de Karachi ?"
                                            },
                                            {
                                                "example_id": "40e77097-065f-43b3-82fd-d8a5a34b40b2",
                                                "sense_id": "791ec5cd-ba42-336d-8e04-c9ee7a956b86",
                                                "text": "Au matin, Kaboul découvrit que la monarchie appartenait au passé."
                                            }
                                        ]
