                    {
                        "translation_id": "8a228aee-3219-476e-8416-8b15c24f9f62",
                        "source_entry_id": "af24bf86-151a-394e-ba34-26df4a3e64ca",
                        "source_sense_description": "any of various small marine fish in the genus Sprattus",
                        "target_lang_word": "sprat",
