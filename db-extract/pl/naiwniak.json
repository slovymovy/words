                    {
                        "translation_id": "0d017cdd-9859-4955-b842-717eace55713",
                        "source_entry_id": "00ea0cce-cfe7-3d1c-b7d5-b449a9af8019",
                        "source_sense_id": "97d1cd8b-571d-385f-98d5-d7ec6f42fe41",
                        "target_lang_word": "Trottel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trottel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "736e3158-9063-3308-9050-c16422aca6d9",
                                        "entry_id": "ae433b48-4870-3a29-a3c5-e00d1ac4e2da",
                                        "glosses": [
                                            "schwachsinniger Mensch, ein unter Kretinismus leidender Mensch"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9af5b9a-3559-4c27-8bb4-20231cd183a9",
                                                "sense_id": "736e3158-9063-3308-9050-c16422aca6d9",
                                                "text": "Er ist nur ein harmloser Trottel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                        "entry_id": "ae433b48-4870-3a29-a3c5-e00d1ac4e2da",
                                        "glosses": [
                                            "ein nicht sehr kluger oder nur wenig gebildeter, einfältiger Mensch"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4d7f849-8803-44ce-bcad-f49e6100021f",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "Der Trottel kann nicht mal richtig lesen."
                                            },
                                            {
                                                "example_id": "a3db7a22-fb29-41b7-9d79-f44438be8028",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Der Mann meiner Wirtin ist ganz liebenswürdig, aber – so scheint mir – ein Trottel, dessen einzige Fähigkeit darin besteht, sich die Liebe seiner Frau zu erhalten, der er reizende Kinder zeugte.“"
                                            },
                                            {
                                                "example_id": "6b07f80d-0a77-4131-af58-413d13dc0d43",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie kam mir so vernünftig vor. Dabei ist sie ein Trottel.“"
                                            },
                                            {
                                                "example_id": "df0f6513-126f-4917-ade6-b0b7b1b9fa7e",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie ist ein Trottel! Sie hat den Wert eines Fabergé-Eis zerstört!“"
                                            },
                                            {
                                                "example_id": "8eb22c01-f9e9-4093-a144-e91eaa10729b",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie war ein Trottel. Das Schild hing seit ihrem sechsten Lebensjahr dort.“"
                                            },
                                            {
                                                "example_id": "c3feeace-4d3d-47a4-aee7-9805c14b7d39",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie war ein Trottel gewesen, als sie daran geglaubt hatte, dass ein Mann wie er helfen könnte.“"
                                            },
                                            {
                                                "example_id": "60f920ff-fdc0-4dcc-86fd-599be9986392",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Tori hatte recht. Sie war ein Trottel.“"
                                            },
                                            {
                                                "example_id": "b84c66b6-efc6-40c1-8002-00fb1c2d4289",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie ist ein Trottel. Sie glaubt alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e7cd19c5-09c5-300a-a8ca-ff32397e6a5b",
                                        "entry_id": "ae433b48-4870-3a29-a3c5-e00d1ac4e2da",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca0cb8ec-f43c-432a-82b2-6c100adf1a78",
                                                "sense_id": "e7cd19c5-09c5-300a-a8ca-ff32397e6a5b",
                                                "text": "Welcher Trottel hat hier alles verstellt?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
