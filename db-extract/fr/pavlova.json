                            {
                                "target_word": "pavlova",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78392442-efb9-3172-8ba3-cbfc57206f45",
                                        "entry_id": "1ca7bed9-dedc-38b0-8612-722db6094211",
                                        "glosses": [
                                            "A meringue dessert usually topped with fruit and cream."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e185ecec-d7f1-4b07-a73f-ad26124210fa",
                                                "sense_id": "78392442-efb9-3172-8ba3-cbfc57206f45",
                                                "text": "The pavlova — rich in whipped cream and ice-cream — is a wonderful dessert that should appeal to anyone with a sweet tooth."
                                            },
                                            {
                                                "example_id": "d3f63e83-7404-49fb-b354-9ec225cc4f77",
                                                "sense_id": "78392442-efb9-3172-8ba3-cbfc57206f45",
                                                "text": "For a successful pavlova you′ll need a spotlessly clean, dry stainless steel or glass bowl."
                                            },
                                            {
                                                "example_id": "e261eaa5-6783-4086-962a-2b371b2056cb",
                                                "sense_id": "78392442-efb9-3172-8ba3-cbfc57206f45",
                                                "text": "Pavlova, named after the Russian ballerina Anna Pavlova, is still just about the most popular party dessert in Australia."
                                            },
                                            {
                                                "example_id": "c5ff8311-12d4-478e-8795-8808a6f118ac",
                                                "sense_id": "78392442-efb9-3172-8ba3-cbfc57206f45",
                                                "text": "Perhaps you lied in the emergency room about eating an entire pavlova and acted like you didn’t know what was wrong with you? If so, make amends by only ever eating a couple of slices of pavlova in one sitting from now on."
                                            },
                                            {
                                                "example_id": "ff7e431d-fe98-405e-8227-ff5cc063faf2",
                                                "sense_id": "78392442-efb9-3172-8ba3-cbfc57206f45",
                                                "text": "Steal the pavlova if you must, but only an April Fool would deem the lamington a Kiwi import."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
