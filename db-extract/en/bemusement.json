                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "glosses": [
                            "The state of being bemused."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8294f1-a352-4171-8404-102b42a4e04a",
                                "sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                                "text": "Wrex touches his grandfather's armor, his expression… thoughtful, perhaps? Krogan are hard to read. Then he shakes off his bemusement and grips his gun with renewed purpose."
                            },
                            {
                                "example_id": "c2eae0ef-f79d-4104-8ec6-a75ea5d1cb05",
                                "sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                                "text": "The response to this latest scandal has taken a familiar turn, dividing along gender lines. While senior women have condemned it, many of the Financial Times’ (male) readers have expressed unhappy bemusement at finding this article on the front page."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c6d559a-46a9-4c9f-a330-346f35a12a63",
                        "source_entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "source_sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "source_sense_description": "state of being bemused",
                        "target_lang_word": "bezorgdheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezorgdheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                        "entry_id": "a2d4465c-1036-3b27-94f2-71dc6bfb534d",
                                        "glosses": [
                                            "bekommering wegens iets dat al of niet zal of kan gebeuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eacf1f36-0371-40cd-95a5-9f00e16b26e8",
                                                "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                                "text": "Zij had me gevraagd om altijd een extra liter water mee te nemen, zodat ik nooit zonder zou komen. Ik was erg ontroerd door haar bezorgdheid, maar ook door haar praktische advies."
                                            },
                                            {
                                                "example_id": "d9d3f6cb-08bd-48b9-86e9-988b75daf17e",
                                                "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                                "text": "Dat zou hun allemaal plezier doen en het zou Ingeborgs bezorgdheid aan banden leggen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b17584a-6227-459d-9687-1a43a08d4874",
                        "source_entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "source_sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "source_sense_description": "state of being bemused",
                        "target_lang_word": "préoccupation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préoccupation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5f85db0-9209-394b-a2d0-831295c17c23",
                                        "entry_id": "560eef6a-38d0-3f8c-bc72-f7a3b0ea6a9a",
                                        "glosses": [
                                            "Disposition d’un esprit tellement occupé d’un objet qu’il ne peut prêter à un autre qu’une moindre attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a097c83-1d62-4f34-93b2-31e869f82e65",
                                                "sense_id": "a5f85db0-9209-394b-a2d0-831295c17c23",
                                                "text": "A l'âge qu'il avait, le sommeil ne perd jamais ses droits, et, en dépit de ses préoccupations et des inquiétudes du lendemain, il dormit aussi bien que dormit le grand Condé, la veille de la bataille de Rocroy."
                                            },
                                            {
                                                "example_id": "f7ea67b4-7eca-4d34-a808-82b0f8c3c577",
                                                "sense_id": "a5f85db0-9209-394b-a2d0-831295c17c23",
                                                "text": "Sa première préoccupation ce fut de collationner tous les manuscrits du Talmud qu'il put se procurer, afin de s'assurer d'un texte correct."
                                            },
                                            {
                                                "example_id": "f9f8ee96-0a82-4d0c-8fd5-0bf9ffc01a04",
                                                "sense_id": "a5f85db0-9209-394b-a2d0-831295c17c23",
                                                "text": "Nous volions depuis vingt-six heures et demie. Malgré les soucis et les préoccupations et les efforts successifs, nous étions l'un et l'autre d'attaque."
                                            },
                                            {
                                                "example_id": "4aaae367-32f9-4b2a-9253-747aa9ae204f",
                                                "sense_id": "a5f85db0-9209-394b-a2d0-831295c17c23",
                                                "text": "[…] la préoccupation qui, chez les hommes, semble dominer toutes les autres, c’est celle de la vitesse obtenue soit par leurs propres moyens, soit par des instruments, et des appareils de locomotion, au perfectionnement desquels ils appliquent le meilleur de leur ingéniosité et de leurs facultés inventives."
                                            },
                                            {
                                                "example_id": "1feb8a7a-3402-4a81-9ab4-f8c7c45d4975",
                                                "sense_id": "a5f85db0-9209-394b-a2d0-831295c17c23",
                                                "text": "Les comptes nationaux sont une construction sociale, en perpétuelle évolution, reflétant toujours les préoccupations d'une époque. Les chiffres qui en sont issus ne doivent pas être fétichisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cab3db0-3e9a-3025-9c45-7ec1201d5255",
                                        "entry_id": "560eef6a-38d0-3f8c-bc72-f7a3b0ea6a9a",
                                        "glosses": [
                                            "Souci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d5d191-58e7-4835-b46f-0565e5e2ede2",
                                                "sense_id": "0cab3db0-3e9a-3025-9c45-7ec1201d5255",
                                                "text": "Michel-Édouard Leclerc, président du comité stratégique des centres E. Leclerc, est incontournable depuis que les tickets de caisse trônent au premier rang des préoccupations des Français."
                                            },
                                            {
                                                "example_id": "47ed5c87-6e8a-4f7c-937c-cd894f99f873",
                                                "sense_id": "0cab3db0-3e9a-3025-9c45-7ec1201d5255",
                                                "text": "D'un bout à l'autre de l'Islande, il n'est si pauvre habitation qui n'ait son thermomètre : c'est que dans cette froide Terre de glace la température est la préoccupation continuelle des habitants."
                                            },
                                            {
                                                "example_id": "7d0d11c4-f341-4901-a828-95a25fb4eed5",
                                                "sense_id": "0cab3db0-3e9a-3025-9c45-7ec1201d5255",
                                                "text": "Il rejetait délibérément toutes préoccupations étrangères à sa neuve situation."
                                            },
                                            {
                                                "example_id": "607b0699-b06d-43d8-9c47-e7e74b16b818",
                                                "sense_id": "0cab3db0-3e9a-3025-9c45-7ec1201d5255",
                                                "text": "Un cadre réglementaire national complet a été instauré pour répondre aux préoccupations des entreprises et des usagers concernant le pollupostage, c'est-à-dire l'envoi de messages commerciaux non sollicités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f5a50ee-db8d-4abf-8ae3-f51fb7359cd9",
                        "source_entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "source_sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "source_sense_description": "state of being bemused",
                        "target_lang_word": "Verblüffung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verblüffung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                        "entry_id": "fe4f308a-6251-3978-8e8d-63c77bdfbda2",
                                        "glosses": [
                                            "das Verblüfftsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0403c31-c752-48a0-b339-3d001ad4f91f",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Die Verblüffung stand ihm ins Gesicht geschrieben."
                                            },
                                            {
                                                "example_id": "6562d9b7-2fd2-477b-873e-984916cc22cd",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Sie schien die Verblüffung ihres Angestellten nicht zu verstehen."
                                            },
                                            {
                                                "example_id": "b973adfb-e8b1-40b6-b0c3-60953aa0a2e2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Weil er von der Feier bereits wusste, musste er seine Verblüffung vorheucheln."
                                            },
                                            {
                                                "example_id": "158271fb-c364-4b4f-8d91-98b0a9a320f9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Zu ihrer großen Verblüffung stellte sie fest, dass zu diesem Begriff kein Eintrag im Wörterbuch existierte."
                                            },
                                            {
                                                "example_id": "d71fdd03-8cda-4ea1-86d4-0d6479d9eff9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Es fiel mir nicht schwer, ihr Freude zu machen durch eine große Verblüffung über die völlige Auffrischung ihres Haushalts.“"
                                            },
                                            {
                                                "example_id": "ef427031-dff6-46b9-b440-55449c833fd7",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Milde Verblüffung steht in Lampes Gesicht, als er den Digestor gründlich mustert.“"
                                            },
                                            {
                                                "example_id": "41160c7a-85d5-4001-b3d8-11653d15bed2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Eine Minute verging in allgemeiner Verblüffung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a10b265-7106-4f96-b4a5-932caba67c25",
                        "source_entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "source_sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "source_sense_description": "state of being bemused",
                        "target_lang_word": "Verwirrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwirrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65aa5074-2309-3916-9e12-88cfc9d532d0",
                                        "entry_id": "851b257c-172e-3138-9246-0400d78b0497",
                                        "glosses": [
                                            "Mangel an Ordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52f39da5-303e-4fc4-9f9c-46ed13566723",
                                                "sense_id": "65aa5074-2309-3916-9e12-88cfc9d532d0",
                                                "text": "Die Kundgebung endete in einer allgemeinen Verwirrung."
                                            },
                                            {
                                                "example_id": "8db0ed94-6250-4d3a-a7f6-bd729ce02034",
                                                "sense_id": "65aa5074-2309-3916-9e12-88cfc9d532d0",
                                                "text": "„Anfangs herrschte Verwirrung. Später sangen sie, lachten und tanzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                        "entry_id": "851b257c-172e-3138-9246-0400d78b0497",
                                        "glosses": [
                                            "geistige Unklarheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed38e9de-b177-41c3-b629-21a1477ad2d5",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "Manche alten Menschen leiden unter geistiger Verwirrung."
                                            },
                                            {
                                                "example_id": "5dea5e0c-ca8f-4eb3-8201-2e118ecae123",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Seine ehrliche Verwirrung ließ ihn beinahe liebenswert erscheinen, aber sie wußten ja alle, daß er unverbesserlich war und bei nächstbester Gelegenheit wieder genauso loslegen würde.“."
                                            },
                                            {
                                                "example_id": "d5c768cc-7d13-4474-88fc-265e28f11673",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Eine Verwirrung befällt sie, von der sie oft, fast immer befallen wird, wenn sie durch die Enge des Raumes in die Nähe eines schönen Sterblichen geraten ist.“"
                                            },
                                            {
                                                "example_id": "7d91c509-9fb6-4d8f-8700-1db49b3df38c",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Die Gerüchte überschlugen sich, die Verwirrung war komplett.“"
                                            },
                                            {
                                                "example_id": "4be5bef5-c92d-47c4-b517-cf852de1cd25",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Ich konnte ihre Verwirrung aber gut nachvollziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17c367f7-2425-4d11-a366-c27d2a51361c",
                        "source_entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "source_sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "source_sense_description": "state of being bemused",
                        "target_lang_word": "Irritierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irritierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f83579c-8160-36ba-b053-e67f6727a3f4",
                                        "entry_id": "59f5262b-71d9-3ee5-ae4f-34fceab5c0aa",
                                        "glosses": [
                                            "Ablenkung oder Verwirrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b219fb-a561-46fb-a238-690edae61c1f",
                                                "sense_id": "3f83579c-8160-36ba-b053-e67f6727a3f4",
                                                "text": "Solch eine öffentliche Erklärung sorgt doch für mehr Irritierung als für die Klarheit, die wir uns alle wünschen."
                                            },
                                            {
                                                "example_id": "e204b3bb-31b6-459c-a4ec-2dfd8d2d105f",
                                                "sense_id": "3f83579c-8160-36ba-b053-e67f6727a3f4",
                                                "text": "„Auch das im Jahr 1922 entstandene sogenannte große Stilleben in Karlsruhe ist reich an perspektivischen Irritierungen, die sich sowohl auf die Großstruktur als auch auf die Kleinstruktur der Komposition beziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fbf1d169-7bc6-3558-b70e-eded09126702",
                                        "entry_id": "59f5262b-71d9-3ee5-ae4f-34fceab5c0aa",
                                        "glosses": [
                                            "Reizung, Erregung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dbce708-3697-4759-a29a-1fc01abaab7c",
                                                "sense_id": "fbf1d169-7bc6-3558-b70e-eded09126702",
                                                "text": "Die Irritierung hier am Schienenbein wird wieder zurückgehen, wenn Sie weiter auf Kontakt zu synthetischen Stoffen verzichten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71cc6a8f-8453-4453-b189-a4629f539ec4",
                        "source_entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "source_sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "source_sense_description": "state of being bemused",
                        "target_lang_word": "Nachdenklichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64c3e72d-f06a-46b2-8955-ffff2f591f6c",
                        "source_entry_id": "a4dc8f9e-d989-3a3b-9aa9-538c9efa47b7",
                        "source_sense_id": "2b39efee-b70a-3c86-8669-c20efa618ed2",
                        "source_sense_description": "state of being bemused",
                        "target_lang_word": "Verwunderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwunderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                        "entry_id": "5c17dc80-7ead-3fdd-8710-bd4fd5dc3962",
                                        "glosses": [
                                            "das Verwundertsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84fd65df-400e-4c59-a04a-e994d753f90f",
                                                "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                                "text": "Seine Verwunderung über den fehlenden Eintrag im Wörterbuch war groß."
                                            },
                                            {
                                                "example_id": "edde2c73-9a72-4c58-ba97-a29cd2290748",
                                                "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                                "text": "Die Verwunderung stand ihr ins Gesicht geschrieben."
                                            },
                                            {
                                                "example_id": "6abf6857-aba0-4fd1-87b2-f37d5c67d809",
                                                "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                                "text": "Sie las pure Verwunderung aus seinem Gesicht."
                                            },
                                            {
                                                "example_id": "138e1338-42c0-4d31-8cf3-c7360c6f1fbd",
                                                "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                                "text": "„Ich erkenne Verwunderung in den Gesichtern der Menschen um mich herum und freue mich sehr – für Island.“"
                                            },
                                            {
                                                "example_id": "b535bcce-ede7-40d5-8d7b-1413e33adcc0",
                                                "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                                "text": "„Zu meiner Verwunderung bot mir die schändliche Hexe an, sie würde für weitere zwölf Zechinen die Contessa verrückt in mich verliebt machen.“"
                                            },
                                            {
                                                "example_id": "f3720eb6-3959-4fbb-bcf1-d3f4f4ae4180",
                                                "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                                "text": "„Erst auf dem Heimweg kehrte die Verwunderung über Schachs Benehmen zurück.“"
                                            },
                                            {
                                                "example_id": "6aa6eba1-99a5-47fb-93ce-59ac825c4a0c",
                                                "sense_id": "4d0711dd-e8ac-3cff-93e2-5b3d32d8bcc7",
                                                "text": "„Konrad hörte ihnen mit höflicher und belustigter Verwunderung zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
