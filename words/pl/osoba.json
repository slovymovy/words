            "senses": [
                {
                    "sense_id": "b203fc8d-b83b-36c7-8d7b-3fb4e2542639",
                    "sense_definition": "Pojedynczy człowiek, jednostka ludzka.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "czlowiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta <w>osoba</w> czeka na ciebie przy wejściu do biura.",
                            "target_lang_translations": {
                                "ru": "Этот <w>человек</w> ждет тебя у входа в офис.",
                                "en": "That <w>person</w> is waiting for you at the office entrance."
                            }
                        },
                        {
                            "text": "Każda <w>osoba</w> dorosła musi mieć przy sobie ważny dokument tożsamości.",
                            "target_lang_translations": {
                                "ru": "Каждое взрослое <w>лицо</w> должно иметь при себе действующее удостоверение личности.",
                                "en": "Every adult <w>person</w> must carry a valid ID with them."
                            }
                        }
                    ],
                    "synonyms": [
                        "człowiek",
                        "postać"
                    ],
                    "common_phrases": [
                        "dorosła osoba",
                        "obca osoba",
                        "trzecia osoba"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный человек, человеческая единица.",
                        "en": "An individual human being."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "индивидуум"
                            },
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "официальное или конкретное лицо"
                            },
                            {
                                "target_lang_word": "личность",
                                "target_lang_sense_clarification": "человек как носитель индивидуальных свойств"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "person",
                                "target_lang_sense_clarification": "an individual human being"
                            },
                            {
                                "target_lang_word": "individual",
                                "target_lang_sense_clarification": "a single human being as distinct from a group"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c86707cc-0982-36c6-97a9-224d1230a61f",
                    "sense_definition": "Kategoria gramatyczna określająca wykonawcę czynności w stosunku do mówiącego.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W języku polskim czasownik w pierwszej <w>osobie</w> liczby pojedynczej ma końcówkę -m lub -ę.",
                            "target_lang_translations": {
                                "ru": "В польском языке глагол в первом <w>лице</w> единственного числа имеет окончание -m или -ę.",
                                "en": "In the Polish language, a verb in the first <w>person</w> singular has the ending -m or -ę."
                            }
                        },
                        {
                            "text": "Nauczyciel wyjaśnił, jak odmieniać czasowniki przez <w>osoby</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как спрягать глаголы по <w>лицам</w>.",
                                "en": "The teacher explained how to conjugate verbs by <w>persons</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pierwsza osoba",
                        "druga osoba",
                        "trzecia osoba"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "termin gramatyczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматическая категория, определяющая исполнителя действия по отношению к говорящему.",
