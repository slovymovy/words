                        "examples": [
                            {
                                "example_id": "d8ed77b0-a98c-4814-b514-f20c27f74d96",
                                "sense_id": "7df0f098-7138-307a-b217-5b5e8a01e9e4",
                                "text": "„Diese Wiederaufnahme des Handels mit den Europäern lag durchaus in seinem Interesse, und mit neuen Exportgütern konnte der zurückgehende Elfenbeinhandel wettgemacht werden.“"
                            },
                            {
                                "example_id": "0019ed53-a97c-4e44-8b5b-d5ba158878a9",
                                "sense_id": "7df0f098-7138-307a-b217-5b5e8a01e9e4",
                                "text": "„Die East African Railway sollte den reibungslosen Verlauf des lukrativen Elfenbeinhandels von Mombasa bis an den Viktoria-See ermöglichen.“"
                            },
                            {
                                "example_id": "e6317f58-5dc9-4af5-9a3f-0a838123c302",
                                "sense_id": "7df0f098-7138-307a-b217-5b5e8a01e9e4",
                                "text": "„Außerdem wird der Erlös aus dem Elfenbeinhandel ausschließlich in Naturschutzprojekte fließen.“"
                            },
                            {
                                "example_id": "7f2f5375-c5e9-4ae1-8acc-4a58e539c8a1",
                                "sense_id": "7df0f098-7138-307a-b217-5b5e8a01e9e4",
                                "text": "„Diese gigantischen Vorräte bilden einen großen Anreiz, den weltweit verbotenen Elfenbeinhandel wiederaufzunehmen.“"
                            }
                        ],
