                "senses": [
                    {
                        "sense_id": "2aae5726-f62a-3942-8b5f-3acc4ae69270",
                        "entry_id": "91b723ec-54a6-3b17-bea8-fb8f9769418e",
                        "glosses": [
                            "Sorte de tissu imperméabilisé."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "483eb63a-0ae1-4922-9868-93fb5c7e0474",
                                "sense_id": "2aae5726-f62a-3942-8b5f-3acc4ae69270",
                                "text": "A côté de cela on utilise encore un objet de pansement qui empêche les liquides de couler au dehors, tel qu'une étoffe imperméable : mackintosh, feuille do gutta-percha, toiles cirées, etc."
                            },
                            {
                                "example_id": "3092d469-72c0-4701-9f9e-1629080dc86b",
                                "sense_id": "2aae5726-f62a-3942-8b5f-3acc4ae69270",
                                "text": "En campagne, ou peut supprimer le spray, et remplacer le protective, le mackintosh par du papier de soie verni (…)."
                            }
                        ]
                    },
                    {
                        "sense_id": "5413604e-0d7d-3057-bd88-76819ae7e7f5",
                        "entry_id": "91b723ec-54a6-3b17-bea8-fb8f9769418e",
                        "glosses": [
                            "Manteau ou paletot imperméable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3655d9c-8261-42e4-a1db-935131ffa90b",
                                "sense_id": "5413604e-0d7d-3057-bd88-76819ae7e7f5",
                                "text": "Une étroite ceinture de cuir fauve serrait […] le mackintosh."
                            },
                            {
                                "example_id": "51b8fb55-81d6-41a0-906e-24e6bab704b0",
                                "sense_id": "5413604e-0d7d-3057-bd88-76819ae7e7f5",
                                "text": "Il était dans le bureau ; il avait coutume de jeter, en entrant, un coup d’œil […], de pendre son mackintosh à un clou, de se chauffer un instant et d’aller ensuite à ses affaires ; il ne dévia pas de ses habitudes."
                            },
                            {
                                "example_id": "654aa7bf-54cf-4f29-af06-44cca95b463b",
                                "sense_id": "5413604e-0d7d-3057-bd88-76819ae7e7f5",
                                "text": "Pas de malles. Un sac de nuit seulement. Dedans, deux chemises de laine, trois paires de bas. Autant pour vous. Nous achèterons en route. Vous descendrez mon mackintosh et ma couverture de voyage. Ayez de bonnes chaussures."
                            },
                            {
                                "example_id": "d1d5dd87-4a42-46c2-993f-269bc3210d76",
                                "sense_id": "5413604e-0d7d-3057-bd88-76819ae7e7f5",
                                "text": "Par temps pluvieux, le petit cortège surmonté de parapluies s’en va vers l’église en mackintoshs et en galoches luisantes."
                            }
                        ]
                    }
                ],
