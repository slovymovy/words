    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfa91b7f-0418-37ff-a1d0-1df137d06884",
                    "sense_definition": "Copier fidèlement un texte ou consigner par écrit des propos oraux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le greffier doit <w>transcrire</w> fidèlement les déclarations des témoins pendant le procès."
                        },
                        {
                            "text": "Elle a passé plusieurs heures à <w>transcrire</w> l'enregistrement de cette longue interview."
                        }
                    ],
                    "synonyms": [
                        "recopier",
                        "noter"
                    ],
                    "common_phrases": [
                        "transcrire un texte",
                        "transcrire un entretien"
                    ]
                },
                {
                    "sense_id": "67e7a87a-5014-3317-ad7e-1fd1e1b40c90",
                    "sense_definition": "Adapter ou réécrire une œuvre musicale pour un instrument différent de l'original.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pianiste a décidé de <w>transcrire</w> cette symphonie pour deux mains afin de la jouer en récital."
                        },
                        {
                            "text": "Ce compositeur aime <w>transcrire</w> des pièces de guitare pour la harpe."
                        }
                    ],
                    "synonyms": [
                        "adapter",
                        "arranger"
                    ],
                    "common_phrases": [
                        "transcrire pour piano",
                        "transcrire une partition"
                    ]
                },
                {
                    "sense_id": "b864288d-6d03-3af0-8ba5-93287f774ce8",
                    "sense_definition": "Représenter des sons du langage parlé à l'aide d'un système d'écriture ou de notation phonétique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les linguistes utilisent des symboles précis pour <w>transcrire</w> les sons des langues rares."
                        },
                        {
                            "text": "L'étudiant a appris à <w>transcrire</w> ce dialecte oral en utilisant l'alphabet phonétique international."
                        }
                    ],
                    "common_phrases": [
                        "transcrire en phonétique",
                        "transcrire les sons"
                    ]
                },
                {
                    "sense_id": "4914bc9b-59eb-3271-838b-1c144fd72b6a",
                    "sense_definition": "Synthétiser une molécule d'ARN à partir d'une séquence d'ADN matrice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enzyme permet de <w>transcrire</w> le code génétique de l'ADN en molécules d'ARN messager."
                        },
                        {
                            "text": "Dans le noyau cellulaire, la cellule commence à <w>transcrire</w> les gènes nécessaires à la synthèse."
                        }
                    ],
                    "common_phrases": [
                        "transcrire en ARN"
                    ]
                }
            ]
        }
    ]
