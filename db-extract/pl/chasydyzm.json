                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хасидизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53e2d8d9-8f8f-3fd6-8b36-54063c7f37ac",
                                        "entry_id": "ceb5b4e7-34b0-374c-9340-924a18b08d01",
                                        "glosses": [
                                            "религ. течение в иудаизме, возникшее в XVIII веке среди евреев, проживавших на территории современной Западной Украины, как оппозиционное официальной иудейской религии, направленное на ослабление роли раввинов в религиозной жизни верующих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e67002b0-9da9-4a26-9362-72854d4a4177",
                                                "sense_id": "53e2d8d9-8f8f-3fd6-8b36-54063c7f37ac",
                                                "text": "Как лурианская Каббала, так и хасидизм поддерживали эмоциональный аспект религиозной жизни."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
