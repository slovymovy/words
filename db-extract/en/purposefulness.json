                    {
                        "translation_id": "a965ec7a-8802-4f83-85bb-282b040a3869",
                        "source_entry_id": "8e4ec96a-df38-3e72-ad09-76242420361e",
                        "source_sense_id": "85719f6b-9414-3334-aa5a-d80fc4d0f5ca",
