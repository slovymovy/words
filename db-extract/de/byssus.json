                                    {
                                        "sense_id": "f4f90203-6330-3d2f-b6e0-53cafecc7e01",
                                        "entry_id": "925a5cd4-61d2-3a6b-9990-563c1e1e87c5",
                                        "glosses": [
                                            "Chez les espèces de champignons lignicoles et corticoles, ensemble de filaments fins et soyeux organisés en tapis de fixation plus ou moins feutré et rayonnant à partir de la base du pied du champignon."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d92d5e26-b600-3106-9f2c-d07c78557feb",
                                        "entry_id": "925a5cd4-61d2-3a6b-9990-563c1e1e87c5",
                                        "glosses": [
                                            "Touffe de filaments qui permet aux mollusques bivalves de se fixer à un support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8c083a-f91b-4e5e-ac12-6c2b4a023d1d",
                                                "sense_id": "d92d5e26-b600-3106-9f2c-d07c78557feb",
                                                "text": "L’industrie tire encore des fils pour tissus du fond des mers dont le plus remarquable est le tissu fabriqué à l’aide du « byssus » d’un coquillage appelé « Pinna » et qui se rencontre dans la Méditerranée."
                                            },
                                            {
                                                "example_id": "decdd853-d8c7-4605-86ca-3364dd63cf0f",
                                                "sense_id": "d92d5e26-b600-3106-9f2c-d07c78557feb",
                                                "text": "Le byssus est formé de 50 à 100 filaments très fins produits à partir d’un précurseur protéique – une molécule qui donnera une protéine – secrété par la moule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
