        "fr-extract.jsonl": [
            {
                "entry_id": "d9e5e13c-7057-32e9-81ed-e3c60796edec",
                "word": "culturiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "473855ed-d188-44db-8e68-d9027b566b6d",
                        "entry_id": "d9e5e13c-7057-32e9-81ed-e3c60796edec",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "culturistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "409e07e2-77bc-39af-a327-180fa63932aa",
                        "entry_id": "d9e5e13c-7057-32e9-81ed-e3c60796edec",
                        "glosses": [
                            "Sportif qui pratique le culturisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da991844-05b7-447b-b4cc-854db84c7fef",
                                "sense_id": "409e07e2-77bc-39af-a327-180fa63932aa",
                                "text": "Lors des compétitions, les culturistes doivent défiler devant un jury qui évalue leur développement musculaire et attribuent des points."
                            },
                            {
                                "example_id": "349a00b4-6309-4342-949e-8fcf0a182f3a",
                                "sense_id": "409e07e2-77bc-39af-a327-180fa63932aa",
                                "text": "Psychologie du « culturiste » : la culture et donc finalement le culte de ses propres muscles comme remède à l’angoisse d’une certaine solitude. Le salut par le narcissisme. À quoi s’ajoute la fatigue de l’effort répété, assimilable à une ascèse."
                            },
                            {
                                "example_id": "8164696e-c241-42df-9fd5-bc43c0086e33",
                                "sense_id": "409e07e2-77bc-39af-a327-180fa63932aa",
                                "text": "Le culturiste se transforme peu à peu en artiste sculptant son corps tel un artiste avec une statue."
                            },
                            {
                                "example_id": "e1aac948-f248-4a6a-9749-d13cfeb1528b",
                                "sense_id": "409e07e2-77bc-39af-a327-180fa63932aa",
                                "text": "Avec, en prime, une flopée d’additifs comme l’inosinate, un exhausteur de goût généralement obtenu à partir d’une fermentation bactériologique, la maltodextrine, une poudre blanche utilisée par les culturistes pour prendre de la masse musculaire, ou encore le glutamate, qui stimule l’esprit. — (« Bouillon cube : Roule, ma poule ! », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 18)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa0ff6ae-b2eb-44ee-8bcd-16ca849e6285",
                        "source_entry_id": "d9e5e13c-7057-32e9-81ed-e3c60796edec",
                        "source_sense_id": "409e07e2-77bc-39af-a327-180fa63932aa",
                        "target_lang_word": "Bodybuilder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bodybuilder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                        "entry_id": "d367dffc-d21e-3f31-9188-175c5fcca127",
                                        "glosses": [
                                            "Sportler, der die Modellierung des Körpers durch gezielte Muskelübungen, in der Regel unter Verwendung von Fitnessgeräten durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa60c3d0-f20d-4fd1-9e9f-c453f5309eca",
                                                "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                                "text": "„Der amerikanische Fotograf Brian Finke fotografiert seit 2003 für seine Serie \"Most Muscular\" Bodybuilder und Bodybuilder-Wettkämpfe.“"
                                            },
                                            {
                                                "example_id": "783f33a7-daf7-4b9a-a489-507793ee9f19",
                                                "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                                "text": "„Ein Bodybuilder aus Münster ist an der Überdosis eines giftiges Muskelpräparats gestorben.“"
                                            },
                                            {
                                                "example_id": "29e24d47-b8b2-4881-84c5-2101a0201995",
                                                "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                                "text": "„Und wenn ich Pech habe, ist dieser Macker Bodybuilder, gewaltbereit und einen Kopf größer als ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e086dd1-78dd-4f08-bb6d-1d820d2babc3",
                        "source_entry_id": "d9e5e13c-7057-32e9-81ed-e3c60796edec",
                        "source_sense_id": "409e07e2-77bc-39af-a327-180fa63932aa",
                        "target_lang_word": "bodybuilder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bodybuilder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                        "entry_id": "d2487d9f-42f9-32e1-aeff-262e96980ee4",
                                        "glosses": [
                                            "A person who uses diet and exercise to build an aesthetically muscular physique, in order to compete in bodybuilding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b13adf-af12-4e81-94ac-4dc7cf2fb2dd",
                                                "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                                "text": "Physique of powerful bodybuilder (below) is like piece of sculpture. Buffs strive for the well-rounded body, disdain the professional weightlifter, who merely develops a number of very specialized muscles."
                                            },
                                            {
                                                "example_id": "73675f66-0042-42c1-8a9f-77e6692950a7",
                                                "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                                "text": "Because it is necessary for a muscle to rest while it grows and because of the importance of balanced development, most competitive bodybuilders train on a split routine; they work certain parts of the body one day and rest those muscles the next while they work the others, alternating like that six days a week."
                                            },
                                            {
                                                "example_id": "4e981e60-6f7b-4b7b-a5bc-ddd5e7704e89",
                                                "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                                "text": "In the competitions, bodybuilders go through \"mandatories\"—a set of mandatory poses—in the morning, where the judges compare the body parts of the builders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                        "entry_id": "d2487d9f-42f9-32e1-aeff-262e96980ee4",
                                        "glosses": [
                                            "Rare form of body-builder (“one who builds vehicle bodies”)."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e044390-8406-42ea-b012-d68ca1148629",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "COACH BODYBUILDER wanted. Apply omnibus stables, Camberwell."
                                            },
                                            {
                                                "example_id": "b7c63897-cf3f-4374-8c4a-913b2d4435b7",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "COACHMAKERS.—Wanted, three IMPROVERS to the bodymaking, all new work. Greenfield and Callaway, bodybuilders to the trade, Milson’s Steam Works, 121, Liverpool-street."
                                            },
                                            {
                                                "example_id": "4eb86071-8936-4fb7-8330-81d5bd5fd9d6",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, First-class Coachsmith and Bodybuilder.—Apply to M. Bohan, Wellington Coach Factory, Wellington."
                                            },
                                            {
                                                "example_id": "e8545c3b-3746-4026-bfa4-fa0c5d32b866",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, a first-class Wheelwright and Bodybuilder; state where last employed. Apply to A. Gilmore, Tauranga."
                                            },
                                            {
                                                "example_id": "2b10faea-9c0f-4a13-bc45-5f49b5464788",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, BODYBUILDER to repair Cabs. 39 Turner-street. Redfern."
                                            },
                                            {
                                                "example_id": "e2f1e11f-a014-4ced-a49e-0c81c52f4dd9",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, a good Wheelwright and Bodybuilder: a constant job. Apply to M. Bohan, Wellington Coach Factory, Victoria-street."
                                            },
                                            {
                                                "example_id": "3549545e-a9d3-4b15-bd6d-362f251ed7f1",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "BODYBUILDERS.—Ted., Redfern,—Go to shop where you met me with bicycle,—a chance."
                                            },
                                            {
                                                "example_id": "a9339c88-5c6e-42a7-a641-4c9a77aea756",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, first-class BODYBUILDER. Apply W. Brett, Rozelle, Balmain."
                                            },
                                            {
                                                "example_id": "551334ab-859d-467b-88a2-0a7bc24dc136",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "BLACKSMITHS and bodybuilders. Fulton & Walker Co., 20th and Filbert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
