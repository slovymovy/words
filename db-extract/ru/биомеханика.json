                                        "entry_id": "6685ce5a-f709-3afa-bcb3-b25bc6f9a6cc",
                                        "glosses": [
                                            "Relatif à la mécanique des organismes vivants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54583d2-c472-49de-8748-69af0280bc54",
                                                "sense_id": "5a73697b-cc3b-3152-b483-a79ccd539bc8",
                                                "text": "Car « on peut se faire mal en yoga, témoignent Bernadette de Gasquet et Jean-Paul Bouteloup. La lenteur d’exécution des gestes ne suffit pas à se protéger des erreurs biomécaniques »."
                                            }
