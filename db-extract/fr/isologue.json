                                        "glosses": [
                                            "Having similar proportions, similar relations, or similar differences of composition; said specifically of groups or series which differ by a constant difference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128a955f-ac91-4076-afb6-545ad94338a8",
                                                "sense_id": "6d735764-127c-3288-9118-797c654ef396",
                                                "text": "Ethane, ethylene, an acetylene, or their analogous compounds form an isologous series."
                                            }
