                                "target_senses": [
                                    {
                                        "sense_id": "cd8271af-f64e-382d-8871-31fa2b69752d",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "то же, что владелец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bb82fb-8d34-4e82-b606-860487b8ff6d",
                                                "sense_id": "cd8271af-f64e-382d-8871-31fa2b69752d",
                                                "text": "Кто хозяин этой машины?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f154c05-2a1e-3da9-b1a6-0f3e73e4c4b4",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "человек, ведущий хозяйство, занимающийся экономической деятельностью"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dece1c12-42b0-3b79-b5b8-9721339f71c7",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "владелец жилья по отношению к жильцу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ac3d8f-5d30-4101-b479-933856d1ac56",
                                                "sense_id": "dece1c12-42b0-3b79-b5b8-9721339f71c7",
                                                "text": "Без согласия хозяина квартирант не вправе сдавать жилье в поднаем и производить перепланировку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ca1367-3c8d-33b5-b186-9f3b3ef9db31",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "начальник, наниматель или рабовладелец, тот, кто пользуется наёмным или рабским трудом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bf3a1bd-5720-4bcc-92a6-a4ac46b43fb3",
                                                "sense_id": "05ca1367-3c8d-33b5-b186-9f3b3ef9db31",
                                                "text": "Покуда в свете закона эти человеческие существа, наделенные сердцем и способностью чувствовать, не перестанут быть вещами, собственностью того или иного владельца, покуда разорение, какое-нибудь несчастье, промах в делах или смерть доброго хозяина будут обрекать их на горе и непосильный труд, до тех пор вы не найдете в рабстве, даже там, где оно обходится без жестокостей, ни одной хорошей, ни одной хоть сколько-нибудь привлекательной черты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507d60e1-37ee-3f3e-a46e-61abd6634f27",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "глава дома, человек, находящийся у себя дома"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62fa8558-a1b9-38f9-8b47-6636cdaa074c",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "биол. организм, являющийся средой обитания или источником питания для паразитов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e20cc9-1380-4d6c-9214-c3a9774f21d7",
                                                "sense_id": "62fa8558-a1b9-38f9-8b47-6636cdaa074c",
                                                "text": "На эволюционную динамику взаимодействий паразита и хозяина повлияло множество параметров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d82ce2-2f13-3305-919c-2d4b4cea5f8f",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "мн. ч., спорт. спортивная команда, выступающая в своём родном населённом пункте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1447adb0-f7ad-4cf1-b405-a7de80f9f121",
                                                "sense_id": "15d82ce2-2f13-3305-919c-2d4b4cea5f8f",
                                                "text": "На десятой минуте хозяева вели со счётом 1:0."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3fdeefe-d734-3d6a-8f14-ceb12846d157",
                                        "entry_id": "9507f05b-6d79-3ff6-a224-c33f9866f3c4",
                                        "glosses": [
                                            "рег. (Воронежская область) то же, что сом"
                                        ],
