                        "glosses": [
                            "Qualité de ce qui est coriace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd4a9f3-c2a0-4d44-be3d-09b7f7907549",
                                "sense_id": "9b104d61-1ab5-3eb2-ad4d-7baaf28d94a4",
                                "text": "Ils dorment là sous le dôme bleu du ciel avec les étoiles pour veilleuses, à l’abri des punaises et défiant les piqûres des moustiques par la coriacité de leur peau tannée, bronzée aux feux du soleil d’Andalousie, et aussi noire, à coup sûr, que celle des mulâtres les plus foncés."
                            },
                            {
                                "example_id": "532b80a3-0240-402a-9e84-d64eb13c0ff1",
                                "sense_id": "9b104d61-1ab5-3eb2-ad4d-7baaf28d94a4",
                                "text": "Elle met autant de coriacité à entretenir la mémoire du défunt qu'elle n'a jamais aimé, que Philippe met de courage à vivre malgré la désaffection de la femme de sa vie."
                            },
                            {
                                "example_id": "a5d430e5-324d-49a7-b3ec-fd7d425012c6",
                                "sense_id": "9b104d61-1ab5-3eb2-ad4d-7baaf28d94a4",
                                "text": "J'admirais ta coriacité à vouloir te surprime Maurice, je la mettais au rang du panache qui avait coloré ta vie."
                            }
                        ]
                    }
                ],
