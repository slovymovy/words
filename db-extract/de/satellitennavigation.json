                "senses": [
                    {
                        "sense_id": "509ad717-e110-3720-b8a0-ca721cfff1a7",
                        "entry_id": "baaa4525-c3e4-39c8-bee0-666652a4be88",
                        "glosses": [
                            "Verfahren zur Positionsbestimmung mit Hilfe von Satelliten, die Radiosignale ausstrahlen, aus denen ein Empfänger seine Position errechnen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921c06d5-7acf-4fae-a8f7-6398bc9c30b0",
                                "sense_id": "509ad717-e110-3720-b8a0-ca721cfff1a7",
                                "text": "Mit Hilfe der Satellitennavigation ist Hobbysegelei noch einfacher und sicherer geworden."
                            },
                            {
                                "example_id": "eba594ac-231e-4848-9f32-0787604f2725",
                                "sense_id": "509ad717-e110-3720-b8a0-ca721cfff1a7",
                                "text": "„Die Satellitennavigation beruht auf dem Betrieb eines Empfängers, der seine Position aus den Signalen berechnet, die er von mindestens vier Satelliten empfängt.“"
                            },
                            {
                                "example_id": "9d25490e-e811-461a-880b-da743b26e47a",
                                "sense_id": "509ad717-e110-3720-b8a0-ca721cfff1a7",
                                "text": "„Die Fachtagung ist zugleich Auftakt in Hessen für einen weltweiten Wettbewerb, der neue Ideen für Satellitennavigation sucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
