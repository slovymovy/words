                                "example_id": "0ba08b51-f3f5-40cd-9196-57a323be96d9",
                                "sense_id": "79954ac9-7e11-3b19-a64e-7d8cd26cb320",
                                "text": "Test Copy for Specificness / Copy, if possible, should be specific."
                            },
                            {
                                "example_id": "02dc454b-0b29-4da3-9bd5-391477e0edd3",
                                "sense_id": "79954ac9-7e11-3b19-a64e-7d8cd26cb320",
                                "text": "Headlines — Specificness / The headline should be specific. Such generalities as Wisdom, The Truth, Character and Reputation, Easy Economies, or Cheapest and Best have little value for the average reader."
                            },
                            {
                                "example_id": "5a435f76-2099-42df-b821-68c2860ff1e3",
                                "sense_id": "79954ac9-7e11-3b19-a64e-7d8cd26cb320",
                                "text": "To do a naturalistic play you have to respect the specificness of the period, place and social conditions"
                            },
                            {
                                "example_id": "442a860b-0f98-490e-b1b1-b318692dcb38",
                                "sense_id": "79954ac9-7e11-3b19-a64e-7d8cd26cb320",
                                "text": "Definiteness, specificness and genericness"
                            },
                            {
                                "example_id": "b70a6115-c981-47f9-9122-f93c63b1711a",
                                "sense_id": "79954ac9-7e11-3b19-a64e-7d8cd26cb320",
                                "text": "A second problem about taking stories as moral examples is their specificness."
                            }
                        ]
                    }
