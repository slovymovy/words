                "senses": [
                    {
                        "sense_id": "5e385e80-08f0-3e93-ba25-5d5089495923",
                        "entry_id": "35f7bdbc-3e9c-3c24-b2fc-3797ca5fc6b4",
                        "glosses": [
                            "ein Gegenstand der einen hohen materiellen/monetären oder auch emotionalen Wert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76800e47-6f90-4f3e-8e29-e7c9d8a87cf9",
                                "sense_id": "5e385e80-08f0-3e93-ba25-5d5089495923",
                                "text": "Er musste viele seiner Wertgegenstände in einem Pfandhaus zu Geld machen."
                            },
                            {
                                "example_id": "977cfe56-cbec-4345-b113-c4e297d6f1d5",
                                "sense_id": "5e385e80-08f0-3e93-ba25-5d5089495923",
                                "text": "„Die übrigen Ersparnisse und Wertgegenstände mußten auf der Bank auf einem Sperrkonto deponiert werden.“"
                            },
                            {
                                "example_id": "5f8fbe24-ce93-41a6-bbcf-40cd1998d549",
                                "sense_id": "5e385e80-08f0-3e93-ba25-5d5089495923",
                                "text": "„Würde man alte Wege finden und wiedererkennen, vielleicht sogar die Stellen, an denen in letzter Minute der eine oder andere Wertgegenstand vergraben worden war?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
