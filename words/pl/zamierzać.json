{
    "word_family": [
        "zamierzenie",
        "zamierzony"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2628a0f3-03ed-3629-9467-dde14d3a1665",
                    "sense_definition": "mieć w planach wykonanie jakiejś czynności",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intencja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zamierzam</w> jutro jechać do Gdańska.",
                            "target_lang_translations": {
                                "ru": "Я <w>собираюсь</w> завтра поехать в Гданьск.",
                                "en": "I <w>intend</w> to go to Gdańsk tomorrow."
                            }
                        },
                        {
                            "text": "Nie <w>zamierzam</w> się z tobą spierać.",
                            "target_lang_translations": {
                                "ru": "Я не <w>намереваюсь</w> с тобой спорить.",
                                "en": "I don't <w>intend</w> to argue with you."
                            }
                        }
                    ],
                    "synonyms": [
                        "planować",
                        "mieć zamiar"
                    ],
                    "common_phrases": [
                        "zamierzać coś zrobić"
                    ],
                    "target_lang_definitions": {
                        "ru": "иметь в планах совершение какого-либо действия",
                        "en": "to have plans or the intention to perform an action"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намереваться",
                                "target_lang_sense_clarification": "книжный стиль, выражает наличие замысла или плана"
                            },
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "более разговорный вариант, выражает готовность к действию"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "выражает наличие конкретного плана действий"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "intend",
                                "target_lang_sense_clarification": "to have in mind as a purpose or plan"
                            },
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "to intend or have a specific plan to do something"
                            },
                            {
                                "target_lang_word": "be going to",
                                "target_lang_sense_clarification": "informal/common expression of intention or future action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e6d2895-999f-315b-9eb1-767903dce94a",
                    "sense_definition": "przygotowywać się do wykonania rzutu lub uderzenia",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przygotowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawodnik <w>zamierzał</w> się do silnego rzutu piłką.",
                            "target_lang_translations": {
                                "ru": "Спортсмен <w>замахнулся</w> для сильного броска мяча.",
                                "en": "The player <w>wound up</w> for a powerful throw of the ball."
                            }
                        },
                        {
                            "text": "Kiedy <w>zamierzasz</w> się do uderzenia, pamiętaj o odpowiedniej postawie.",
                            "target_lang_translations": {
                                "ru": "Когда <w>замахиваешься</w> для удара, помни о правильной стойке.",
                                "en": "When you <w>wind up</w> to strike, remember proper posture."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zamierzać się do uderzenia"
                    ],
                    "target_lang_definitions": {
                        "ru": "принимать позу или готовиться к совершению броска или удара",
                        "en": "to prepare or poise oneself to throw or strike; to take aim or wind up"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замахиваться",
                                "target_lang_sense_clarification": "поднимать руку или предмет для нанесения удара или броска"
                            },
                            {
                                "target_lang_word": "готовиться к удару",
                                "target_lang_sense_clarification": "общая фраза для подготовки к физическому действию"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "wind up",
                                "target_lang_sense_clarification": "to prepare body/arm movement to throw or hit"
                            },
                            {
                                "target_lang_word": "take aim",
                                "target_lang_sense_clarification": "to poise or prepare to strike or throw"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}