                    "target_lang_definitions": {
                        "ru": "удар ногой, при котором мяч выпускается из рук и выбивается до касания земли",
                        "zh": "一种将球从手中放下并在落地前踢出的踢球方式"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар с рук",
                                "target_lang_sense_clarification": "в футболе или регби"
                            },
                            {
                                "target_lang_word": "пант",
                                "target_lang_sense_clarification": "спортивный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弃踢",
                                "target_lang_sense_clarification": "橄榄球运动中的踢球动作"
                            }
                        ]
                    }
                },
                {
