                        "glosses": [
                            "Personne dont la langue d’usage ou maternelle n’est pas une langue officielle du pays où elle vit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ed5386fd-f4bf-3c8b-91b0-a28e9a0f8a7a",
                        "entry_id": "5c628da4-b27c-3df7-8625-f9c2ce4dd392",
                        "glosses": [
                            "Locuteur natif d’une langue autre que le français et l’anglais."
                        ],
                        "tags": [
                            "Canada",
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "596f6b61-5548-4a81-9228-984a61239d93",
                                "sense_id": "ed5386fd-f4bf-3c8b-91b0-a28e9a0f8a7a",
                                "text": "Selon Statistique Canada, un peu plus de la moitié (51,8 %) des allophones du Québec c’est-à-dire les personnes dont la langue maternelle n’est ni le français ni l’anglais) se déclarent bilingues anglais-français (et donc trilingues), alors que 76,2 % affirment pouvoir soutenir une conversation en français et que 68,2 % d’entre eux ont les mêmes capacités en anglais."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9fd502e-bd8b-30b7-abbe-10093e4c65a5",
                        "entry_id": "5c628da4-b27c-3df7-8625-f9c2ce4dd392",
                        "glosses": [
                            "Locuteur natif d’une langue autre que le français et l’anglais.",
                            "Locuteur natif d’une langue non autochtone qui n’est pas le français ou l’anglais."
                        ],
                        "tags": [
                            "Canada",
                            "Administration",
                            "Québec",
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "48f44505-a426-4a18-a87a-b2a06ac50735",
                                "sense_id": "d9fd502e-bd8b-30b7-abbe-10093e4c65a5",
                                "text": "La formation est presque exclusivement destinée aux anglophones et aux allophones qui doivent apprendre le français."
                            }
                        ]
                    }
                ],
