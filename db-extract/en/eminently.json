                    {
                        "translation_id": "fc223f54-e230-4693-85ae-ffe1b72b7bdb",
                        "source_entry_id": "2c446332-53e6-3bf2-b551-11036ddbfcf7",
                        "source_sense_description": "to a great degree",
                        "target_lang_word": "parfaitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parfaitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "D’une manière parfaite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2127149-882c-4598-a3ee-42b83d236f7a",
                                                "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                                "text": "Comme je vous aime parfaitement, je pense être aimé de vous de la même sorte."
                                            },
                                            {
                                                "example_id": "0d30b822-ccc8-4a66-9b8d-1359b4cdaf74",
                                                "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                                "text": "Cette Alerac est aimable de me regretter comme elle fait ; mais ne me souhaitez jamais rien que vous ; vous êtes pour moi toutes choses, et jamais on n’a été aimée si parfaitement d’une fille bien-aimée que je le suis de vous."
                                            },
                                            {
                                                "example_id": "d7ea1760-281b-4125-b620-9aa92bac4438",
                                                "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                                "text": "Il ne faut rien exagérer, ni dire des cours le mal qui n’y est point : l’on n’y attente rien de pis contre le vrai mérite que de le laisser quelquefois sans récompense ; on ne l’y méprise pas toujours, quand on a pu une fois le discerner ; on l’oublie, et c’est là où l’on sait parfaitement ne faire rien, ou faire très peu de chose, pour ceux que l’on estime beaucoup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8abb294-ec33-39a4-96a4-d3829441ff34",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "D’une manière exacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e0e5b7-a498-4ec1-891e-c6f3ba094801",
                                                "sense_id": "e8abb294-ec33-39a4-96a4-d3829441ff34",
                                                "text": "Paolo m’attend déjà devant les portes tournantes pour la pause-déjeuner. Il a son regard agacé des jours où je ne suis pas parfaitement à l’heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "D’une manière complète ou totale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19befff1-01ef-46f6-8d62-6e10eb241b85",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "En outre, la conception de l’autodéschisteur doit être telle que le blocage des dispositifs d’évacuation par la matière à éliminer soit impossible. Il doit être parfaitement automatique."
                                            },
                                            {
                                                "example_id": "5f5a81d3-76cc-4767-a8a4-46a59fb8e042",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Depuis des mois on savait parfaitement à Paris que la dénonciation par Hitler des accords de Locarno et la remilitarisation de la Rhénanie pouvaient survenir d'un moment à l'autre."
                                            },
                                            {
                                                "example_id": "5a17ba8e-5209-4634-a8fb-44bd290da883",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Le diaspore, de structure analogue (l'aluminium remplaçant le fer), se présente en cristaux lamellaires parfaitement clivables (parfois taillés pour la bijouterie, malgré leur fragilité) donnant des lamelles flexibles, et en agrégats écailleux."
                                            },
                                            {
                                                "example_id": "6104806c-2c35-4439-a422-8fbb82ad8d7b",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Elle [Mme de Longueval] haïssait bien parfaitement notre Montataire."
                                            },
                                            {
                                                "example_id": "53497684-fb11-4d8c-a20a-3f8f2ea63024",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Aussi impossible, lui répliqua l’autre, que d’être parfaitement habile, parfaitement fort, parfaitement puissant, parfaitement heureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c9dcea-8a4a-3556-99c7-97e9c265a59e",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "Oui."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "note": "Se dit comme réponse affirmative, en insistant sur l’affirmation",
                                        "examples": [
                                            {
                                                "example_id": "10ceb3f0-08d4-432e-8c4d-fa2f9c340338",
                                                "sense_id": "d7c9dcea-8a4a-3556-99c7-97e9c265a59e",
                                                "text": "La proposition vous convient-elle ? — Parfaitement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
