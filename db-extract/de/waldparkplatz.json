                "senses": [
                    {
                        "sense_id": "dc35a185-dd26-3b98-a6d0-edc7485819ec",
                        "entry_id": "d884b405-5f6e-3dbf-8d48-82dd8240f990",
                        "glosses": [
                            "ausgewiesene Fläche auf öffentlichem oder privatem Grund zum Abstellen von Fahrzeugen im Wald oder am Waldrand über die Dauer eines Haltevorgangs hinaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c151f6f-c103-4a51-866c-7418a53ff475",
                                "sense_id": "dc35a185-dd26-3b98-a6d0-edc7485819ec",
                                "text": "„Die am Waldparkplatz Häldenmühle sichergestellte 9 mm-Patronenhülse stammte, wie Experten des Landeskriminalamts (LKA) schnell herausfanden, aus einer Lieferung an die Polizei.“"
                            },
                            {
                                "example_id": "c41d27cd-f8ec-4d88-ac71-754c3b4f96f6",
                                "sense_id": "dc35a185-dd26-3b98-a6d0-edc7485819ec",
                                "text": "„Am Wasserfall wendet der Weg und führt auf dem Wasserfallrundweg zum Waldparkplatz Malschbach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
