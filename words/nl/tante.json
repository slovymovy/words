                {
                    "sense_id": "67e1d419-7537-3217-98b3-4731166c355e",
                    "sense_definition": "De zus of schoonzus van iemands vader of moeder.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family_relatives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>tante</w> woont in New York.",
                            "target_lang_translations": {
                                "en": "My <w>aunt</w> lives in New York.",
                                "ru": "Моя <w>тётя</w> живёт в Нью-Йорке.",
                                "pl": "Moja <w>ciocia</w> mieszka w Nowym Jorku.",
                                "de": "Meine <w>Tante</w> wohnt in New York.",
                                "fr": "Ma <w>tante</w> habite à New York.",
                                "it": "Mia <w>zia</w> vive a New York.",
                                "cs": "Moje <w>teta</w> bydlí v New Yorku.",
                                "tr": "Benim <w>teyzem</w> New York'ta yaşıyor.",
                                "es": "Mi <w>tía</w> vive en Nueva York."
                            }
                        },
                        {
                            "text": "Ik ga dit weekend logeren bij mijn <w>tante</w> en oom.",
                            "target_lang_translations": {
                                "en": "I am going to stay with my <w>aunt</w> and uncle this weekend.",
                                "ru": "В эти выходные я буду гостить у моих <w>тёти</w> и дяди.",
                                "pl": "W ten weekend idę przenocować u mojej <w>cioci</w> i wujka.",
                                "de": "Dieses Wochenende gehe ich zu meiner <w>Tante</w> und meinem Onkel zu Besuch.",
                                "fr": "Ce week-end, je vais loger chez ma <w>tante</w> et mon oncle.",
                                "it": "Questo fine settimana vado a stare da mia <w>zia</w> e mio zio.",
                                "cs": "Tento víkend jedu na návštěvu ke své <w>tetě</w> a strýcovi.",
                                "tr": "Bu hafta sonu <w>teyzem</w> ve eniştemde kalacağım.",
                                "es": "Este fin de semana me voy a quedar con mi <w>tía</w> y mi tío."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mijn tante",
                        "tante en oom",
                        "lieve tante"
                    ],
                    "target_lang_definitions": {
                        "en": "The sister or sister-in-law of one's father or mother.",
                        "ru": "Сестра отца или матери, а также жена дяди.",
                        "pl": "Siostra lub bratowa ojca lub matki.",
                        "de": "Die Schwester oder Schwägerin des Vaters oder der Mutter.",
                        "fr": "La sœur ou la belle-sœur du père ou de la mère de quelqu'un.",
                        "it": "La sorella o la cognata del padre o della madre di qualcuno.",
                        "cs": "Sestra nebo švagrová otce nebo matky.",
                        "tr": "Bir kişinin annesinin veya babasının kız kardeşi ya da yengesi.",
                        "es": "La hermana o cuñada del padre o de la madre de una persona."
                    },
