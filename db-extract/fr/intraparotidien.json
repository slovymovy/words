                        "entry_id": "eab158d6-f4e4-386d-9f58-cdc4097521bf",
                        "glosses": [
                            "Qui concerne l’intérieur des glandes parotides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a76d7d24-af22-4ec0-934e-1f4ff11ddbe2",
                                "sense_id": "cbc7fe2f-658f-3858-b44c-ed18fc0ed150",
                                "text": "Diagnostic basé sur l’évolution lente, la mobilité, la dureté véritablment ligneuse : tumeur bénigne, adéno-fibrome, ou chondro-sarcome, ou tout simplement ganglion intraparotidien ?"
                            },
                            {
                                "example_id": "9b089448-3fe2-4ea4-afa7-234dfeda7014",
                                "sense_id": "cbc7fe2f-658f-3858-b44c-ed18fc0ed150",
                                "text": "Dans la loge parotidienne (et à travers la glande), chemine le nerf facial ; il forme dans celle-ci, le plexus intraparotidien qui s’étend du bord supérieur au bord inférieur de la glande, jusqu’à la musculature de la mimique."
                            },
                            {
                                "example_id": "bf1d02a6-6748-4cd8-b82e-833d7bbcb04b",
                                "sense_id": "cbc7fe2f-658f-3858-b44c-ed18fc0ed150",
                                "text": "L’échographie recherche un trajet fistuleux intraparotidien confirmant l’origine des infections itératives."
                            }
                        ]
                    }
