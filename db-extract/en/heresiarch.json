                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16225185-ecc7-4242-95b2-78536c0fb516",
                                                "sense_id": "ae4fd6f1-1ae2-3551-b227-caa2b873f14c",
                                                "text": "Krátce po ustavení komise vystoupil na zasedání německého národa pražský kanovník Jan Náz s absurdními zkazkami o ohavnostech, které v Čechách páchají stoupenci arcikacíře Jana Husa a jež se týkají především svátosti eucharistie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a90ca401-1684-436b-875f-10daa3a4313d",
