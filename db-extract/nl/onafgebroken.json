        "nl-extract.jsonl": [
            {
                "entry_id": "229a5d50-ab3b-394b-b706-9d3fff11854a",
                "word": "onafgebroken",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93b13c6e-544c-30d4-9efe-50aabfa3119a",
                        "entry_id": "229a5d50-ab3b-394b-b706-9d3fff11854a",
                        "glosses": [
                            "zonder te stoppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04bf0be6-050a-4651-9fbc-269d14a8d4d4",
                                "sense_id": "93b13c6e-544c-30d4-9efe-50aabfa3119a",
                                "text": "De jongen was onafgebroken aan het fluiten."
                            },
                            {
                                "example_id": "c96fc738-559f-40e1-9fe2-2a2824ecd6cd",
                                "sense_id": "93b13c6e-544c-30d4-9efe-50aabfa3119a",
                                "text": "Ik zag mijn hoofd als een lege schaal waarin ik elke dag een nieuwe vraag kon plaatsen, om er tijdens het lopen uren onafgebroken over na te denken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c02ae430-114e-44da-a267-0b81f0deed03",
                        "source_entry_id": "229a5d50-ab3b-394b-b706-9d3fff11854a",
                        "source_sense_id": "93b13c6e-544c-30d4-9efe-50aabfa3119a",
                        "target_lang_word": "lasting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                        "entry_id": "bdbcdce8-e26c-3f21-8aff-e1c5143e42c0",
                                        "glosses": [
                                            "Persisting for an extended period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e01a427-8221-4254-ad0a-4d83b746814d",
                                                "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                                "text": "After World War I it was hoped that a lasting peace had been achieved. It hadn’t."
                                            },
                                            {
                                                "example_id": "9d7c5372-935c-435a-b098-f0c99655c365",
                                                "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                                "text": "I was taken to the theatre for the first time when I was six years old, and the experience made a lasting impression on me."
                                            },
                                            {
                                                "example_id": "91ab4dc3-c751-45f3-9c93-244fce18d426",
                                                "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                                "text": "hasty wroth, and heedlesse hazardry\nDoe breede repentaunce late, and lasting infamy."
                                            },
                                            {
                                                "example_id": "870b4762-3597-49fc-8276-d72313fbc6d3",
                                                "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                                "text": "Look ye, Marriage is a lasting thing—if it were for six Months only, I might venture upon thee—but for all days of my Life—mercy upon me […]"
                                            },
                                            {
                                                "example_id": "6caa8ce4-aa8a-48d3-a00d-178de10d5a7f",
                                                "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                                "text": "I knew that nought was lasting, but now even\nChange grows too changeable, without being new:"
                                            },
                                            {
                                                "example_id": "35a7aec0-c56f-4123-82c4-ad31d8a0e5cd",
                                                "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                                "text": "Then his son bought a carven coffin hewn from a great log of fragrant wood which is used to bury the dead in and for nothing else because that wood is as lasting as iron, and more lasting than human bones, and Wang Lung was comforted."
                                            },
                                            {
                                                "example_id": "a319bbfe-0dc6-42a1-a6c1-fcdf97554b0d",
                                                "sense_id": "a163587b-4a9d-39a0-9866-7ef7905e39c2",
                                                "text": "Though they obviously realized that these episodes were part of something wonderful and important and lasting, the writers and producers couldn’t have imagined that 20 years later “Treehouse Of Horror” wouldn’t just survive; it’d thrive as one of the most talked-about and watched episodes of every season of The Simpsons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02bdc3eb-6950-30b2-b5ef-2d589a5aebe0",
                                        "entry_id": "bdbcdce8-e26c-3f21-8aff-e1c5143e42c0",
                                        "glosses": [
                                            "Persisting forever."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e29b1c3-df3e-48fa-b900-acc04c4c1aa7",
                                                "sense_id": "02bdc3eb-6950-30b2-b5ef-2d589a5aebe0",
                                                "text": "I am the cygnet to this pale faint swan,\nWho chants a doleful hymn to his own death,\nAnd from the organ-pipe of frailty sings\nHis soul and body to their lasting rest."
                                            },
                                            {
                                                "example_id": "e14b800e-9b2f-4959-a3fe-d8f2a39b3c5c",
                                                "sense_id": "02bdc3eb-6950-30b2-b5ef-2d589a5aebe0",
                                                "text": "Things that are first must give place, but things that are last, are lasting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lasting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "509c5304-ac6f-34cf-ba54-3c11cb410756",
