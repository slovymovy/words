                        "sense_id": "565b8683-4ce5-3692-813d-14f7f1ef61a5",
                        "entry_id": "16716053-bcd7-3d3b-9965-f97ffcc4cc07",
                        "glosses": [
                            "A net over a river to catch fish."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d59225d2-ff9d-3191-963d-9c8619e1535f",
                        "entry_id": "16716053-bcd7-3d3b-9965-f97ffcc4cc07",
                        "glosses": [
                            "An instrument or device, sometimes of leather, more usually of rope, fitted to a horse's legs to regulate his motions and force him to amble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "877eefc4-18a9-4fa8-8d2d-9ce0a5f54d0f",
                                "sense_id": "d59225d2-ff9d-3191-963d-9c8619e1535f",
                                "text": "The back-band which is fit for no other use but to bear up the side ropes, should, if you tramel all four legs, be made of fine girth-web, and lined with cotton; but if you tramel but one side, then a common tape will serve, taking care that it carries the side ropes in an even line, without either rising or falling: for if it rises it shortens the side-rope, and if it falls there is danger of its entangling."
                            }
                        ]
                    },
                    {
                        "sense_id": "837aed1a-d19d-353b-a70c-45be1a1651a0",
                        "entry_id": "16716053-bcd7-3d3b-9965-f97ffcc4cc07",
                        "glosses": [
                            "Obsolete spelling of trammel."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cf290a2d-704f-46d2-88cc-acfe75e53d9d",
                                "sense_id": "837aed1a-d19d-353b-a70c-45be1a1651a0",
                                "text": "Her golden lockes she roundly did uptye\nIn breaded tramels, that no looser heares\nDid out of order stray about her daintie eares."
                            }
                        ]
                    }
                ],
