{
    "word_family": [
        "wrestler",
        "wrestling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                    "sense_definition": "to fight someone by holding and throwing them to the ground, especially as a sport",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two brothers used to <w>wrestle</w> on the living room carpet every afternoon.",
                            "target_lang_translations": {
                                "ru": "Два брата каждое утро <w>боролись</w> на ковре в гостиной.",
                                "zh": "那两兄弟过去每天下午都会在客厅的地毯上<w>摔跤</w>。"
                            }
                        },
                        {
                            "text": "He decided to <w>wrestle</w> in the local tournament to prove his strength.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>побороться</w> на местном турнире, чтобы доказать свою силу.",
                                "zh": "他决定参加当地的锦标赛进行<w>摔跤</w>，以证明自己的实力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wraxle"
                    ],
                    "common_phrases": [
                        "wrestle a match",
                        "wrestle for fun"
                    ],
                    "target_lang_definitions": {
                        "ru": "бороться с кем-либо, удерживая и повалив на землю, особенно как вид спорта",
                        "zh": "通过抓握并将其摔倒在地来与某人搏斗，通常作为一种体育运动"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "заниматься борьбой как спортом"
                            },
                            {
                                "target_lang_word": "побороться",
                                "target_lang_sense_clarification": "в течение некоторого времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摔跤",
                                "target_lang_sense_clarification": "作为体育运动进行搏斗"
                            },
                            {
                                "target_lang_word": "搏斗",
                                "target_lang_sense_clarification": "指身体上的对抗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2581b958-0710-35d4-aef9-8bcb349ec87c",
                    "sense_definition": "to force someone into a specific position or to the ground by grappling with them",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer managed to <w>wrestle</w> the suspect to the ground before handcuffing him.",
                            "target_lang_translations": {
                                "ru": "Полицейскому удалось <w>повалить</w> подозреваемого на землю, прежде чем надеть на него наручники.",
                                "zh": "警察在给嫌疑人戴上手铐前，成功地将其<w>按倒</w>在地。"
                            }
                        },
                        {
                            "text": "It took three security guards to <w>wrestle</w> the intruder out of the building.",
                            "target_lang_translations": {
                                "ru": "Потребовалось три охранника, чтобы <w>выставить</w> нарушителя из здания.",
                                "zh": "三名保安费了很大劲才把闯入者<w>制服</w>并带出大楼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrestle to the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "силой заставить кого-либо принять определенное положение или повалить на землю в схватке",
                        "zh": "在搏斗中强行将某人按倒在地或使其处于特定位置"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повалить",
                                "target_lang_sense_clarification": "на землю силой"
                            },
                            {
                                "target_lang_word": "скрутить",
                                "target_lang_sense_clarification": "силой удерживать"
                            },
                            {
                                "target_lang_word": "вытолкать",
                                "target_lang_sense_clarification": "силой заставить выйти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按倒",
                                "target_lang_sense_clarification": "强行将人按在地上"
                            },
                            {
                                "target_lang_word": "制服",
                                "target_lang_sense_clarification": "通过武力控制某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                    "sense_definition": "to struggle with a difficult problem, decision, or emotion",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>wrestle</w> with her conscience before deciding whether to tell the truth.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>бороться</w> со своей совестью, прежде чем решить, говорить ли правду.",
                                "zh": "在决定是否说出真相之前，她不得不与自己的良心进行<w>挣扎</w>。"
                            }
                        },
                        {
                            "text": "The committee continues to <w>wrestle</w> with the problem of rising costs.",
                            "target_lang_translations": {
                                "ru": "Комитет продолжает <w>биться</w> над проблемой роста расходов.",
                                "zh": "委员会仍在为成本上升的问题而<w>苦思冥想</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrestle with a problem",
                        "wrestle with a decision",
                        "wrestle with guilt"
                    ],
                    "target_lang_definitions": {
                        "ru": "бороться с трудной проблемой, решением или эмоцией",
                        "zh": "在心理上与困难的问题、决策或情绪进行斗争"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "с трудностями или чувствами"
                            },
                            {
                                "target_lang_word": "мучиться",
                                "target_lang_sense_clarification": "над сложным решением"
                            },
                            {
                                "target_lang_word": "ломать голову",
                                "target_lang_sense_clarification": "над проблемой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挣扎",
                                "target_lang_sense_clarification": "在心理或情感上感到痛苦和纠结"
                            },
                            {
                                "target_lang_word": "苦思冥想",
                                "target_lang_sense_clarification": "指在解决难题时的心理过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dabd59ff-7a42-3ee8-af51-117bd217623b",
                    "sense_definition": "to move or handle a heavy or awkward object with physical effort",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>wrestle</w> the heavy suitcase into the overhead compartment of the plane.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось с трудом <w>запихивать</w> тяжелый чемодан на багажную полку самолета.",
                                "zh": "我费了好大劲才把沉重的行李箱<w>塞进</w>飞机的行李架里。"
                            }
                        },
                        {
                            "text": "They tried to <w>wrestle</w> the sofa through the narrow doorway for over an hour.",
                            "target_lang_translations": {
                                "ru": "Они больше часа пытались <w>протащить</w> диван через узкий дверной проем.",
                                "zh": "他们试着把沙发<w>搬运</w>过狭窄的门口，折腾了一个多小时。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrestle into position"
                    ],
                    "target_lang_definitions": {
                        "ru": "перемещать или управляться с тяжелым или неудобным предметом, прилагая физические усилия",
                        "zh": "费力地搬运或处理沉重、笨拙的物体"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корячиться",
                                "target_lang_sense_clarification": "с тяжелым предметом"
                            },
                            {
                                "target_lang_word": "ворочать",
                                "target_lang_sense_clarification": "тяжелые вещи"
                            },
                            {
                                "target_lang_word": "заталкивать",
                                "target_lang_sense_clarification": "с трудом помещать куда-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "费力搬运",
                                "target_lang_sense_clarification": "指处理沉重物体时的动作"
                            },
                            {
                                "target_lang_word": "塞进",
                                "target_lang_sense_clarification": "费力地将物体放入狭窄空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e761888f-fc24-326a-a727-5f07a383aba8",
                    "sense_definition": "to throw down livestock, such as a calf, for branding or medical treatment",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ranch hands had to <w>wrestle</w> the calves to the ground for their vaccinations.",
                            "target_lang_translations": {
                                "ru": "Работникам ранчо приходилось <w>валить</w> телят на землю для вакцинации.",
                                "zh": "牧场工人必须把小牛<w>摔倒</w>在地，以便给它们接种疫苗。"
                            }
                        },
                        {
                            "text": "It is a difficult task to <w>wrestle</w> a steer during a rodeo event.",
                            "target_lang_translations": {
                                "ru": "Повалить бычка во время родео — <w>задача</w> не из легких.",
                                "zh": "在牛仔竞技表演中，<w>摔倒</w>一头公牛是一项艰巨的任务。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in ranching or rodeo contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "повалить скот (например, теленка) для клеймения или лечения",
                        "zh": "将牲畜（如小牛）摔倒在地，以便进行烙印或医疗处理"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валить",
                                "target_lang_sense_clarification": "животное на землю"
                            },
                            {
                                "target_lang_word": "опрокидывать",
                                "target_lang_sense_clarification": "для фиксации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摔倒",
                                "target_lang_sense_clarification": "指将牲畜按倒在地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55464ae6-1409-3136-9e71-4422598dac27",
                    "sense_definition": "to twist, wriggle, or writhe about",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small creature began to <w>wrestle</w> in his hands, trying to escape his grip.",
                            "target_lang_translations": {
                                "ru": "Маленькое существо начало <w>извиваться</w> в его руках, пытаясь вырваться.",
                                "zh": "那个小生物开始在他手中<w>挣扎</w>，试图逃脱他的控制。"
                            }
                        },
                        {
                            "text": "Vines seemed to <w>wrestle</w> against the side of the old stone castle.",
                            "target_lang_translations": {
                                "ru": "Казалось, виноградные лозы <w>вьются</w> по стене старого каменного замка.",
                                "zh": "藤蔓似乎在古老的石城堡侧面<w>扭动</w>着向上攀爬。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to describe writhing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "извиваться, корчиться или дергаться",
                        "zh": "扭动、挣扎或翻滚"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извиваться",
                                "target_lang_sense_clarification": "пытаясь вырваться"
                            },
                            {
                                "target_lang_word": "корчиться",
                                "target_lang_sense_clarification": "от боли или усилий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挣扎",
                                "target_lang_sense_clarification": "试图摆脱束缚而扭动"
                            },
                            {
                                "target_lang_word": "扭动",
                                "target_lang_sense_clarification": "身体的翻滚或摆动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8ae3dfb-94e9-3bca-aaaf-df2b56cfc02e",
                    "sense_definition": "a physical struggle or fight between people, often as a sport",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_combat_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brief <w>wrestle</w> ended when one boy pinned the other to the grass.",
                            "target_lang_translations": {
                                "ru": "Короткая <w>схватка</w> закончилась, когда один мальчик прижал другого к траве.",
                                "zh": "当一个男孩把另一个按在草地上时，这场短暂的<w>搏斗</w>结束了。"
                            }
                        },
                        {
                            "text": "He was exhausted after a long <w>wrestle</w> with his opponent on the mat.",
                            "target_lang_translations": {
                                "ru": "Он был измотан после долгой <w>борьбы</w> с противником на мате.",
                                "zh": "在垫子上与对手进行了长时间的<w>摔跤</w>后，他精疲力竭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a brief wrestle"
                    ],
                    "target_lang_definitions": {
                        "ru": "физическая схватка или борьба между людьми, часто как вид спорта",
                        "zh": "人与人之间的身体搏斗，通常作为一种体育运动"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "вид спорта или схватка"
                            },
                            {
                                "target_lang_word": "схватка",
                                "target_lang_sense_clarification": "короткий поединок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摔跤",
                                "target_lang_sense_clarification": "指摔跤运动或比赛"
                            },
                            {
                                "target_lang_word": "搏斗",
                                "target_lang_sense_clarification": "指身体上的对抗过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff981406-828d-3443-9b1a-654c777abda3",
                    "sense_definition": "a situation involving competition or a difficult struggle for power or survival",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_struggle_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political <w>wrestle</w> for the leadership position lasted several months.",
                            "target_lang_translations": {
                                "ru": "Политическая <w>борьба</w> за лидерство длилась несколько месяцев.",
                                "zh": "为争夺领导职位的政治<w>斗争</w>持续了几个月。"
                            }
                        },
                        {
                            "text": "The company is currently in a <w>wrestle</w> for life or death against its competitors.",
                            "target_lang_translations": {
                                "ru": "Компания сейчас ведет <w>схватку</w> не на жизнь, а на смерть со своими конкурентами.",
                                "zh": "该公司目前正与竞争对手进行一场生死攸关的<w>较量</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrestle for power",
                        "wrestle for life"
                    ],
                    "target_lang_definitions": {
                        "ru": "ситуация, включающая конкуренцию или трудную борьбу за власть или выживание",
                        "zh": "涉及竞争或为权力、生存而进行的艰难斗争的情况"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "за власть или выживание"
                            },
                            {
                                "target_lang_word": "противостояние",
                                "target_lang_sense_clarification": "между конкурентами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斗争",
                                "target_lang_sense_clarification": "指为目标而进行的竞争"
                            },
                            {
                                "target_lang_word": "较量",
                                "target_lang_sense_clarification": "指双方在实力上的对抗"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}