                "senses": [
                    {
                        "sense_id": "ea955a08-8739-3fc6-b73a-d6a5ea631e72",
                        "entry_id": "221903fb-a6ea-368f-aaab-d5f11c62af1e",
                        "glosses": [
                            "Grand parasol fixe qui a du chaume ou des feuilles de palmiers en lieu de toile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89851dfc-759c-4c69-b9da-62e151c4525f",
                                "sense_id": "ea955a08-8739-3fc6-b73a-d6a5ea631e72",
                                "text": "« Pour donner à la terrasse ce petit je-ne-sais-quoi emprunté aux décors tropicaux, la palapa est tout indiquée. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "08e44178-3dbe-38b0-8f49-73d0a1157186",
                        "entry_id": "221903fb-a6ea-368f-aaab-d5f11c62af1e",
                        "glosses": [
                            "Petite paillote sans mur, au toit de chaume ou de feuilles de palmier que l’on retrouve dans certains pays chauds ; qui fait office de station balnéaire, de resto-bar, etc. sur le bord d’une plage."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f79a91-dee9-45b2-9449-ecac8104442c",
                                "sense_id": "08e44178-3dbe-38b0-8f49-73d0a1157186",
                                "text": "« À l’ombre sous une palapa, un homme est assis à une petite table peinte en bleu, face à la mer. »"
                            },
                            {
                                "example_id": "e307f636-d217-44ec-8a0b-3164ada11dca",
                                "sense_id": "08e44178-3dbe-38b0-8f49-73d0a1157186",
                                "text": "« Et quoi de plus grisant aussi qu’un repas à l'ombre d’un palapa sur la plage, avec le fumet du poisson qui grille à ciel ouvert. »"
                            },
                            {
                                "example_id": "086af06e-3340-4c64-a7c2-e161e8523701",
                                "sense_id": "08e44178-3dbe-38b0-8f49-73d0a1157186",
                                "text": "Efrain est venu le lendemain de la naissance, il a rempli les formulaires de l’état-civil. Avec les jeunes de son groupe, il a décidé de rester dans le pays. Il voudrait monter un restau de palapa sur la plage, avec des hamacs pour les hippies de passage."
                            },
                            {
                                "example_id": "8bedd8c8-97d2-4e8f-9686-de955e9cab1f",
                                "sense_id": "08e44178-3dbe-38b0-8f49-73d0a1157186",
                                "text": "Des palapas mexicaines, cubaines, etc."
                            }
                        ]
                    }
                ],
