                "senses": [
                    {
                        "sense_id": "9f9ba44e-5e13-3427-b505-5c38b5da6eca",
                        "entry_id": "07dc5a04-8edb-3544-b90a-2eb349b2b285",
                        "glosses": [
                            "rechtlich bindende ADV-Vereinbarung zwischen zwei Partnern – kurz für Auftragsdatenverarbeitungsvertrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126bbbd0-96b9-45bb-9628-d97d0191e5c1",
                                "sense_id": "9f9ba44e-5e13-3427-b505-5c38b5da6eca",
                                "text": "„Unter Beachtung von §11 BDSG, §80 SGB X , den landesrechtlichen sowie kirchlichen gesetzlichen Regelungen ergeben sich die in den folgenden Abschnitten dargestellten Anforderungen, die im ADV-Vertrag geregelt werden müssen.“"
                            },
                            {
                                "example_id": "eaa019bd-0760-4dc0-b679-10ff56900f30",
                                "sense_id": "9f9ba44e-5e13-3427-b505-5c38b5da6eca",
                                "text": "„Zur Sicherung und zum Schutz dieser personenbezogenen Daten muss grundsätzlich ein schriftlicher Vertrag zur Auftragsdatenverarbeitung (‚ADV-Vertrag‘ oder ‚Data Processor Agreement‘) zwischen dem Unternehmen und dem beauftragten Dienstleister abgeschlossen werden.“"
                            },
                            {
                                "example_id": "7f8fcc9a-5532-4e2c-b4fa-b40ebbc566b4",
                                "sense_id": "9f9ba44e-5e13-3427-b505-5c38b5da6eca",
                                "text": "„Ein ADV-Vertrag sollte die unter dem Punkt Outsourcing/ADV beschriebenen Informationen erhalten.“"
                            },
                            {
                                "example_id": "754171b0-9646-4e14-88a3-5c1c1a7eafbc",
                                "sense_id": "9f9ba44e-5e13-3427-b505-5c38b5da6eca",
                                "text": "„Mit dem ADV-Vertrag verpflichtet sich die Telekom Deutschland GmbH zur vollständigen Einhaltung der Bestimmungen nach dem Bundesdatenschutzgesetz §11 (BDSG) hinsichtlich Erhebung, Verarbeitung und Nutzung von personenbezogenen Daten.“"
                            },
                            {
                                "example_id": "755d2fc8-8644-4325-b4e6-e5d2cf8685e1",
                                "sense_id": "9f9ba44e-5e13-3427-b505-5c38b5da6eca",
                                "text": "„Bei Vereinbarung zur Auftragsdatenverarbeitung sollte eintragen werden, ob es sich um einen eigenständigen ADV-Vertrag i.S.d. Mustervereinbarung oder eine sonstige, ggf. in einen Dienstleistungsvertrag oder sonstigen Vertrag integrierte Vereinbarung handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
