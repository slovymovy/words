                                        "glosses": [
                                            "Relating to communications"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0a57c8c-789c-46dc-bf3b-359ea66801a3",
                                                "sense_id": "5eb768d8-425c-354d-aa77-ba18df328f3c",
                                                "text": "Too often writing—in the broadest sense—is treated as a communicational medium where the subjects of that communication are constituted prior to the writing, where the objects of that communication are also constituted prior to that writing, and where the task of writing is seen as transparently mediating between already pregiven subjects, pregiven objects, and a preconstituted mise en scène."
                                            }
                                        ]
                                    }
                                ]
                            }
