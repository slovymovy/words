                        "entry_id": "1db0e83d-11bb-36a6-9147-25becd7cc1a5",
                        "glosses": [
                            "Faire en sorte que (quelque chose) ne soit plus considéré comme normal, ou comme une norme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c9c660e-4d55-4dbd-a5f7-002c9ebb3f4e",
                                "sense_id": "633ed685-b545-3340-b69e-30370343ba6a",
                                "text": "En charge du dossier, la ministre de la Santé, Agnès Buzyn, s’est félicitée de ces décisions, visant à dénormaliser la consommation de tabac"
                            }
                        ]
                    },
                    {
                        "sense_id": "991f75b4-7763-3be6-9740-b8cfd0ef9272",
                        "entry_id": "1db0e83d-11bb-36a6-9147-25becd7cc1a5",
                        "glosses": [
                            "Ne plus normaliser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb8eb284-864d-32d1-85bf-19153780bedb",
                        "entry_id": "1db0e83d-11bb-36a6-9147-25becd7cc1a5",
                        "glosses": [
                            "Reformater les données en sortant d'un schéma à la forme normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb26abb-ee6a-4d6e-88db-3b05ca5b74c0",
                                "sense_id": "fb8eb284-864d-32d1-85bf-19153780bedb",
                                "text": "Si malgré tout ça, vos temps de réponse sont inacceptables, vous pouvez essayer de dénormaliser certaines tables."
                            }
                        ]
                    },
