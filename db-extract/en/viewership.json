                    {
                        "translation_id": "cc9770e0-e12a-455c-acef-1617543ff7b5",
                        "source_entry_id": "24bd2082-875d-30dd-86e3-286eccc87708",
                        "source_sense_id": "618c179d-863e-31b5-bad7-59617908d785",
