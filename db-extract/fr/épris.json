                    {
                        "sense_id": "7ecfb6bd-3d7c-3693-b301-9fa72b826729",
                        "entry_id": "290d8bc7-1236-37f1-a8a7-4ee0287ad5c1",
                        "glosses": [
                            "Qui est saisi par un vif sentiment de relation affective, une passion pour quelqu'un ou quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dc5c9d91-024a-4a2c-b5fe-7ce4c9101626",
                                "sense_id": "7ecfb6bd-3d7c-3693-b301-9fa72b826729",
                                "text": "Épris d'absolu, d'indépendance, de justice."
                            },
                            {
                                "example_id": "6985f742-7500-4dd0-9080-bcc4b2b79df8",
                                "sense_id": "7ecfb6bd-3d7c-3693-b301-9fa72b826729",
                                "text": "Eh bien, monseigneur, voulez-vous que je vous la rende plus douce qu'une gazelle, plus éprise qu'une tourterelle aux temps des amours ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caa776a3-fcae-46ee-9248-687902e12947",
                        "source_entry_id": "290d8bc7-1236-37f1-a8a7-4ee0287ad5c1",
                        "source_sense_id": "7ecfb6bd-3d7c-3693-b301-9fa72b826729",
