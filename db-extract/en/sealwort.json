                    {
                        "sense_id": "4f77ad26-4c40-3e01-a18c-13975d260347",
                        "entry_id": "0b11901a-b684-38ec-b941-db6d2fa51f1f",
                        "glosses": [
                            "Synonym of Solomon's seal."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "85b7ba79-b004-454d-b2d6-f810b2e94af7",
                                "sense_id": "4f77ad26-4c40-3e01-a18c-13975d260347",
                                "text": "The main reason for their longevity was digging up sealwort (Polygonatum sibiricum), the rhizome of Chinese atractylodes and the rhizome of large-headed atractylodes (Atractylodes macrocephala) for use as food."
                            },
                            {
                                "example_id": "366d71bb-eb38-4768-a81c-ca1629941fd3",
                                "sense_id": "4f77ad26-4c40-3e01-a18c-13975d260347",
                                "text": "Also, the smaller-sized sealwort, Polygonatum falatum, in contrast with the etororatkip (Polygonatum odoratum var. pluriflorum) of the same genus, is called pon-etororatkip."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce8ddabb-9811-3afa-a678-53372dbf6710",
                        "entry_id": "0b11901a-b684-38ec-b941-db6d2fa51f1f",
                        "glosses": [
                            "A variety of pearlwort, Sagina procumbens"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "931acc72-6573-4ef2-a91f-0b3c42eebc16",
                                "sense_id": "ce8ddabb-9811-3afa-a678-53372dbf6710",
                                "text": "These days most of the relics are fabricated deceitfully, [such as those made from] a hollowed-out rock, the fruit of a sealwort, a fish eye, or remains fashioned by Nepalese, and must be analyzed by scholars."
                            }
                        ]
                    }
