                "senses": [
                    {
                        "sense_id": "0be52fb5-6052-3255-9f21-8ff9dc9c6bb1",
                        "entry_id": "9cca029f-1d07-3abd-8eab-18372cbac8b0",
                        "glosses": [
                            "die Zeit von 1933 bis zum Ende des Zweiten Weltkrieges, als im Deutschen Reich der Nationalsozialismus herrschte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd3e888-9d8d-42ca-9d7b-2ed6fadefc2c",
                                "sense_id": "0be52fb5-6052-3255-9f21-8ff9dc9c6bb1",
                                "text": "Die NS-Zeit ist das dunkelste Kapitel der deutschen Geschichte."
                            },
                            {
                                "example_id": "c0d712ec-249a-4ad5-acb3-a591c0c9dec5",
                                "sense_id": "0be52fb5-6052-3255-9f21-8ff9dc9c6bb1",
                                "text": "„In Deutschland hatte während der NS-Zeit das System privater Eigentumsrechte an den Produktionsmitteln im Prinzip fortbestanden. Die Entrechtung und Enteignung, später die physische Vernichtung der jüdischen Bevölkerungsgruppe bildet die wichtige Ausnahme.“"
                            },
                            {
                                "example_id": "bb87e509-b0f6-4483-8501-73460e32fbae",
                                "sense_id": "0be52fb5-6052-3255-9f21-8ff9dc9c6bb1",
                                "text": "„Er hatte die gesamte NS-Zeit in Deutschland verbracht, hatte im Dörfchen Carwitz in Mecklenburg Landwirtschaft betrieben und in rasendem Tempo Bücher geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
