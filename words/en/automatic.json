{
    "word_family": [
        "automate",
        "automatically",
        "automation",
        "automaton"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "224ba00c-ad20-37b8-9a13-a23b12a548c7",
                    "sense_definition": "Capable of working by itself without being operated by a person.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "machine_operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>automatic</w> doors opened as soon as we approached the hotel entrance.",
                            "target_lang_translations": {
                                "ru": "<w>Автоматические</w> двери открылись, как только мы подошли к входу в отель.",
                                "zh": "我们一靠近酒店入口，<w>自动</w>门就开了。"
                            }
                        },
                        {
                            "text": "This washing machine is fully <w>automatic</w> and very easy to use.",
                            "target_lang_translations": {
                                "ru": "Эта стиральная машина полностью <w>автоматическая</w> и очень проста в использовании.",
                                "zh": "这台洗衣机是全<w>自动</w>的，非常好用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "self-operating",
                        "automated"
                    ],
                    "antonyms": [
                        "manual",
                        "non-automatic"
                    ],
                    "common_phrases": [
                        "automatic door",
                        "fully automatic",
                        "automatic pilot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный работать самостоятельно, без управления человеком.",
                        "zh": "指机器或设备能够独立运作，无需人工操作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автоматический",
                                "target_lang_sense_clarification": "работающий без участия человека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自动",
                                "target_lang_sense_clarification": "指设备或系统无需人工干预即可运行"
                            },
                            {
                                "target_lang_word": "自动化的",
                                "target_lang_sense_clarification": "形容具备自动运行能力的设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45ac2e46-7cb4-3035-8bec-8cc3faf47dda",
                    "sense_definition": "Done without thinking, often as a habit or reflex.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "human_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Breathing is an <w>automatic</w> function of the human body.",
                            "target_lang_translations": {
                                "ru": "Дыхание — это <w>автоматическая</w> функция человеческого организма.",
                                "zh": "呼吸是人体的一种<w>下意识</w>功能。"
                            }
                        },
                        {
                            "text": "He gave an <w>automatic</w> smile when he saw the camera pointed at him.",
                            "target_lang_translations": {
                                "ru": "Он <w>машинально</w> улыбнулся, когда увидел направленную на него камеру.",
                                "zh": "当他看到镜头对着自己时，<w>机械地</w>笑了笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instinctive"
                    ],
                    "antonyms": [
                        "voluntary"
                    ],
                    "common_phrases": [
                        "automatic reaction",
                        "automatic response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершаемый неосознанно, часто по привычке или рефлекторно.",
                        "zh": "指无需思考、下意识或习惯性的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машинальный",
                                "target_lang_sense_clarification": "неосознанный, механический"
                            },
                            {
                                "target_lang_word": "автоматический",
                                "target_lang_sense_clarification": "рефлекторный"
                            },
                            {
                                "target_lang_word": "невольный",
                                "target_lang_sense_clarification": "совершенный без умысла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下意识的",
                                "target_lang_sense_clarification": "指非主观意识控制的反应"
                            },
                            {
                                "target_lang_word": "机械的",
                                "target_lang_sense_clarification": "形容像机器一样缺乏思考的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dc86cba-2603-3117-bb80-da46bfb04a02",
                    "sense_definition": "Certain to happen as a result of a rule, law, or logical process.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic_and_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Speeding in this school zone results in an <w>automatic</w> fine.",
                            "target_lang_translations": {
                                "ru": "Превышение скорости в этой школьной зоне влечет за собой <w>автоматический</w> штраф.",
                                "zh": "在学校区域超速行驶会<w>自动</w>导致罚款。"
                            }
                        },
                        {
                            "text": "Citizenship is <w>automatic</w> for anyone born within the country's borders.",
                            "target_lang_translations": {
                                "ru": "Гражданство предоставляется <w>автоматически</w> любому, кто родился в пределах границ страны.",
                                "zh": "任何出生在该国境内的人都会<w>自动</w>获得公民身份。"
                            }
                        }
                    ],
                    "synonyms": [
                        "perfunctory"
                    ],
                    "common_phrases": [
                        "automatic penalty",
                        "automatic right",
                        "automatic choice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неизбежно следующий за чем-либо в силу правила, закона или логики.",
                        "zh": "指根据规则、法律或逻辑必然发生的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автоматический",
                                "target_lang_sense_clarification": "безусловный, неизбежный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自动的",
                                "target_lang_sense_clarification": "指必然发生的程序性结果"
                            },
                            {
                                "target_lang_word": "必然的",
                                "target_lang_sense_clarification": "强调结果不可避免"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0781dff8-7e98-3498-af73-7b7fb5186103",
                    "sense_definition": "Designed to shoot bullets continuously as long as the trigger is held.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier carried an <w>automatic</w> rifle into the combat zone.",
                            "target_lang_translations": {
                                "ru": "Солдат нес <w>автоматическую</w> винтовку в зону боевых действий.",
                                "zh": "士兵带着一把<w>自动</w>步枪进入了战斗区域。"
                            }
                        },
                        {
                            "text": "Fully <w>automatic</w> weapons are illegal for civilians in many places.",
                            "target_lang_translations": {
                                "ru": "Полностью <w>автоматическое</w> оружие запрещено для гражданских лиц во многих местах.",
                                "zh": "在许多地方，平民持有全<w>自动</w>武器是违法的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "automatic weapon",
                        "automatic rifle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для непрерывной стрельбы при нажатом спусковом крючке.",
                        "zh": "指设计为扣住扳机即可连续射击的武器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автоматический",
                                "target_lang_sense_clarification": "об оружии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自动",
                                "target_lang_sense_clarification": "指武器具备连发功能"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32666884-9de6-31cb-a04c-f4a1f8a70a7b",
                    "sense_definition": "A vehicle that changes gears by itself, or the transmission system that does this.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "machine_operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer driving an <w>automatic</w> in heavy city traffic.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю водить <w>автомат</w> в плотном городском потоке.",
                                "zh": "在拥堵的城市交通中，我更喜欢开<w>自动挡</w>车。"
                            }
                        },
                        {
                            "text": "My new car is an <w>automatic</w>, so I don't need to shift gears manually.",
                            "target_lang_translations": {
                                "ru": "Моя новая машина — <w>автомат</w>, поэтому мне не нужно переключать передачи вручную.",
                                "zh": "我的新车是<w>自动挡</w>的，所以我不需要手动换挡。"
                            }
                        }
                    ],
                    "antonyms": [
                        "manual",
                        "stick shift"
                    ],
                    "common_phrases": [
                        "drive an automatic",
                        "four-speed automatic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль с автоматической коробкой передач или сама эта система.",
                        "zh": "指配备自动变速箱的车辆或该变速系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автомат",
                                "target_lang_sense_clarification": "автоматическая коробка передач (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自动挡",
                                "target_lang_sense_clarification": "指自动变速箱或自动挡汽车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1e61a38-f448-3a84-844d-3fdd77c934d0",
                    "sense_definition": "A pistol that loads itself after firing but requires a trigger pull for each shot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer checked the safety on his <w>automatic</w> before holstering it.",
                            "target_lang_translations": {
                                "ru": "Полицейский проверил предохранитель на своем <w>автоматическом пистолете</w>, прежде чем убрать его в кобуру.",
                                "zh": "警察在把<w>自动手枪</w>放回枪套前检查了保险。"
                            }
                        },
                        {
                            "text": "He kept a small <w>automatic</w> in the drawer for protection.",
                            "target_lang_translations": {
                                "ru": "Он держал маленький <w>автоматический пистолет</w> в ящике стола для защиты.",
                                "zh": "他在抽屉里放了一把小型<w>自动手枪</w>以备防身。"
                            }
                        }
                    ],
                    "common_phrases": [
                        ".45 automatic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пистолет, который перезаряжается сам после выстрела.",
                        "zh": "指一种射击后能自动装填弹药，但每次射击仍需扣动扳机的半自动手枪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автоматический пистолет",
                                "target_lang_sense_clarification": "самозарядное оружие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自动手枪",
                                "target_lang_sense_clarification": "指具备自动装填功能的枪械"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}