            {
                "entry_id": "06f818a2-7b36-3c57-a42f-ad361f75a870",
                "word": "broiling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "afffd090-9a46-46c1-96e4-215d41a6c732",
                        "entry_id": "06f818a2-7b36-3c57-a42f-ad361f75a870",
                        "tags": [
