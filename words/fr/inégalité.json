    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10139449-e381-3be7-b1ee-da26ef5a7532",
                    "sense_definition": "Différence ou disparité injuste dans les conditions de vie, les droits ou les richesses entre des personnes ou des groupes sociaux.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "société",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement cherche à réduire les <w>inégalités</w> sociales dans les grandes villes du pays."
                        },
                        {
                            "text": "Ces <w>inégalités</w> de revenus provoquent de vives discussions au sein de la population."
                        }
                    ],
                    "synonyms": [
                        "disparité",
                        "iniquité"
                    ],
                    "antonyms": [
                        "égalité",
                        "équité"
                    ],
                    "common_phrases": [
                        "inégalités sociales",
                        "inégalités de revenus",
                        "réduction des inégalités"
                    ]
                },
                {
                    "sense_id": "05c8bf00-3925-3912-92df-e861c69d5a9b",
                    "sense_definition": "Défaut ou manque d'égalité, dissemblance de grandeur, de valeur ou de force entre deux choses.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "différence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>inégalité</w> des forces en présence rendait la bataille particulièrement difficile pour les défenseurs."
                        },
                        {
                            "text": "L'<w>inégalité</w> de taille entre les deux frères est frappante depuis l'adolescence."
                        }
                    ],
                    "synonyms": [
                        "différence",
                        "disproportion"
                    ],
                    "antonyms": [
                        "égalité",
                        "similitude"
                    ],
                    "common_phrases": [
                        "inégalité de traitement",
                        "inégalité des forces"
                    ]
                },
                {
                    "sense_id": "da73a014-a4de-3dda-b54e-7fcd3173c7ac",
                    "sense_definition": "Défaut de régularité d'une surface ; aspérité ou dénivellation du terrain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les roues de la bicyclette absorbent mal les <w>inégalités</w> du sol caillouteux."
                        },
                        {
                            "text": "La marche était rendue pénible par les <w>inégalités</w> du terrain montagneux."
                        }
                    ],
                    "synonyms": [
                        "irrégularité",
                        "aspérité",
                        "accident"
                    ],
                    "antonyms": [
                        "régularité",
                        "planéité"
                    ],
                    "common_phrases": [
                        "inégalités du sol",
                        "inégalités du terrain"
                    ]
                },
                {
                    "sense_id": "78d758dd-b2e1-3d71-bab7-dd0666c93042",
                    "sense_definition": "Relation indiquant que deux grandeurs ou expressions ne sont pas égales ou qu'une est plus grande qu'une autre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathématiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cours de géométrie, le professeur démontre une <w>inégalité</w> triangulaire au tableau."
                        },
                        {
                            "text": "Cette formule mathématique s'exprime sous la forme d'une <w>inégalité</w> stricte entre deux valeurs."
                        }
                    ],
                    "antonyms": [
                        "égalité",
                        "équation"
                    ],
                    "common_phrases": [
                        "inégalité stricte",
                        "inégalité triangulaire"
                    ]
                },
                {
                    "sense_id": "690953a5-7af4-3ca5-b7a4-25715579e84a",
                    "sense_definition": "Caractère variable, instable ou capricieux d'une humeur ou d'un comportement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses collègues ont du mal à s'adapter aux <w>inégalités</w> de son humeur changeante."
                        },
                        {
                            "text": "L'<w>inégalité</w> de son caractère rend la vie quotidienne imprévisible pour son entourage."
                        }
                    ],
                    "synonyms": [
                        "inconstance",
                        "instabilité",
                        "variabilité"
                    ],
                    "antonyms": [
                        "constance",
                        "stabilité"
                    ],
                    "common_phrases": [
                        "inégalités d'humeur"
                    ]
                }
            ]
        }
    ]
