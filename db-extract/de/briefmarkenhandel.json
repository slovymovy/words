                    {
                        "sense_id": "d4fd5554-718f-3cae-9ef5-0c3a80e5f12f",
                        "entry_id": "cad88a14-9a01-3510-ba13-bbb56febdc95",
                        "glosses": [
                            "berufsmäßiger Kauf und Verkauf von Postwertzeichen und das entsprechende Geschäftsfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40122574-24e9-4984-b7d9-559ebe1724b1",
                                "sense_id": "d4fd5554-718f-3cae-9ef5-0c3a80e5f12f",
                                "text": "„Da es bereits für den klassischen Briefmarkenhandel genügend Händler gab, spezialisierte er sich auf den Ankauf von großen Markenbeständen aus einzelnen Gebieten, sowie auf den Ankauf von Restbeständen von Postverwaltungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b38ac443-e937-3ac5-90fe-76a494b7e90e",
                        "entry_id": "cad88a14-9a01-3510-ba13-bbb56febdc95",
                        "glosses": [
                            "Betrieb, der mit Postwertzeichen handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf20fb1-868d-4ff0-aec4-1bbd2116a230",
                                "sense_id": "b38ac443-e937-3ac5-90fe-76a494b7e90e",
                                "text": "„Noch im Dezember 1938 übernahmen Schittek und Adam den Briefmarkenhandel des Herrn Goldner und untersagten ihm das Betreten seines Geschäftes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
