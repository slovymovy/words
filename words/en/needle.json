{
    "word_family": [
        "needlework",
        "needlepoint",
        "needless",
        "needler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d37c17eb-280f-3458-af22-35ce37f3eeb6",
                    "sense_definition": "A thin, sharp metal tool used for sewing, medical injections, or knitting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She threaded the <w>needle</w> to fix the button on her shirt.",
                            "target_lang_translations": {
                                "ru": "Она вдела нитку в <w>иголку</w>, чтобы пришить пуговицу к рубашке.",
                                "zh": "她给<w>针</w>穿上线，准备缝好衬衫上的扣子。"
                            }
                        },
                        {
                            "text": "The nurse used a clean <w>needle</w> to give the vaccination.",
                            "target_lang_translations": {
                                "ru": "Медсестра использовала чистую <w>иглу</w> для вакцинации.",
                                "zh": "护士用了一根干净的<w>针</w>进行疫苗接种。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "thread a needle",
                        "knitting needle",
                        "sewing needle",
                        "hypodermic needle",
                        "needle in a haystack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий острый металлический инструмент, используемый для шитья, медицинских инъекций или вязания.",
                        "zh": "一种细长、尖锐的金属工具，用于缝纫、医疗注射或编织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игла́",
                                "target_lang_sense_clarification": "инструмент для шитья или медицинских целей"
                            },
                            {
                                "target_lang_word": "иго́лка",
                                "target_lang_sense_clarification": "разговорный вариант для швейной иглы"
                            },
                            {
                                "target_lang_word": "спи́ца",
                                "target_lang_sense_clarification": "инструмент для вязания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "针",
                                "target_lang_sense_clarification": "用于缝纫或医疗的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4c9ec87-3907-340e-92e4-de9276184c3e",
                    "sense_definition": "A thin pointer on a dial, compass, or gauge that indicates a measurement or direction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indicator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compass <w>needle</w> always points towards the north.",
                            "target_lang_translations": {
                                "ru": "<w>Стрелка</w> компаса всегда указывает на север.",
                                "zh": "指南针的<w>指针</w>总是指向北方。"
                            }
                        },
                        {
                            "text": "We knew we were out of gas when the <w>needle</w> hit empty.",
                            "target_lang_translations": {
                                "ru": "Мы поняли, что бензин закончился, когда <w>стрелка</w> опустилась на ноль.",
                                "zh": "当油表<w>指针</w>指向空位时，我们知道没油了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "compass needle",
                        "magnetic needle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий указатель на циферблате, компасе или измерительном приборе, показывающий значение или направление.",
                        "zh": "仪表、指南针或量表上用于指示数值或方向的细长指针。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стре́лка",
                                "target_lang_sense_clarification": "указатель в приборах или на часах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指针",
                                "target_lang_sense_clarification": "仪表上的指示器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e821f8a-05f3-353f-8433-03d6172945d3",
                    "sense_definition": "A thin, sharp leaf found on coniferous trees like pines and firs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest floor was covered in brown pine <w>needles</w>.",
                            "target_lang_translations": {
                                "ru": "Лесная подстилка была покрыта коричневыми сосновыми <w>иголками</w>.",
                                "zh": "林地上铺满了棕色的<w>松针</w>。"
                            }
                        },
                        {
                            "text": "Be careful not to step on the sharp <w>needles</w> of the Christmas tree.",
                            "target_lang_translations": {
                                "ru": "Осторожно, не наступи на острые <w>иголки</w> новогодней ёлки.",
                                "zh": "小心别踩到圣诞树上尖锐的<w>针叶</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pine needle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий острый лист хвойных деревьев, таких как сосна или ель.",
                        "zh": "松树、冷杉等针叶树上细长尖锐的叶子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвои́нка",
                                "target_lang_sense_clarification": "отдельный лист хвойного дерева"
                            },
                            {
                                "target_lang_word": "игла́",
                                "target_lang_sense_clarification": "используется для описания формы листа"
                            },
                            {
                                "target_lang_word": "хво́я",
                                "target_lang_sense_clarification": "собирательное название хвойной листвы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松针",
                                "target_lang_sense_clarification": "松树的叶子"
                            },
                            {
                                "target_lang_word": "针叶",
                                "target_lang_sense_clarification": "针状的叶子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f845b5f7-79f2-341b-b6b6-5d362163f07f",
                    "sense_definition": "A small point that reads the grooves on a phonograph record to produce sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "audio_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully placed the <w>needle</w> on the vinyl record to start the music.",
                            "target_lang_translations": {
                                "ru": "Он осторожно опустил <w>иглу</w> на виниловую пластинку, чтобы заиграла музыка.",
                                "zh": "他小心翼翼地把<w>唱针</w>放在黑胶唱片上，音乐开始了。"
                            }
                        },
                        {
                            "text": "The sound quality is poor because the <w>needle</w> is worn out.",
                            "target_lang_translations": {
                                "ru": "Качество звука плохое, потому что <w>игла</w> износилась.",
                                "zh": "因为<w>唱针</w>磨损了，所以音质很差。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drop the needle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький наконечник, который считывает звуковые дорожки на виниловой пластинке.",
                        "zh": "唱机上用于读取唱片纹路以产生声音的小尖头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игла́",
                                "target_lang_sense_clarification": "звукоснимающая игла проигрывателя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唱针",
                                "target_lang_sense_clarification": "唱片播放器的部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9241f40e-fd5e-3265-ba4e-fda12e97183f",
                    "sense_definition": "A tall, slender, pointed rock formation or object.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers attempted to scale the granite <w>needle</w>.",
                            "target_lang_translations": {
                                "ru": "Альпинисты попытались взобраться на гранитный <w>пик</w>.",
                                "zh": "登山者试图攀登那座花岗岩<w>尖峰</w>。"
                            }
                        },
                        {
                            "text": "A sharp <w>needle</w> of rock protruded from the cliff face.",
                            "target_lang_translations": {
                                "ru": "Острая каменная <w>игла</w> выступала из скалы.",
                                "zh": "悬崖上突出一块尖锐的岩石<w>尖峰</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое, тонкое, остроконечное скальное образование или объект.",
                        "zh": "高而细的尖锐岩石构造或物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игла́",
                                "target_lang_sense_clarification": "метафорическое название остроконечного объекта"
                            },
                            {
                                "target_lang_word": "шпиль",
                                "target_lang_sense_clarification": "остроконечное завершение здания или скалы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尖峰",
                                "target_lang_sense_clarification": "尖锐的岩石结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4b691b4-2f35-3d4b-bfe7-842bae7414f0",
                    "sense_definition": "A specific text string that is searched for within a larger body of text.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function searches for the <w>needle</w> within the haystack string.",
                            "target_lang_translations": {
                                "ru": "Функция ищет <w>искомую строку</w> внутри основной строки.",
                                "zh": "该函数在长字符串中搜索<w>目标字符串</w>。"
                            }
                        },
                        {
                            "text": "If the <w>needle</w> is not found, the program returns zero.",
                            "target_lang_translations": {
                                "ru": "Если <w>искомая строка</w> не найдена, программа возвращает ноль.",
                                "zh": "如果未找到<w>目标字符串</w>，程序返回零。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная текстовая строка, которую ищут внутри большего объема текста.",
                        "zh": "在较大文本中搜索的特定文本字符串。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искомая строка",
                                "target_lang_sense_clarification": "термин в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标字符串",
                                "target_lang_sense_clarification": "编程术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a8664fd-a12d-3e5c-b42f-5d058a360d6e",
                    "sense_definition": "The death penalty carried out by lethal injection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner feared he would get the <w>needle</w> for his crimes.",
                            "target_lang_translations": {
                                "ru": "Заключенный боялся, что его казнят с помощью <w>смертельной инъекции</w> за его преступления.",
                                "zh": "囚犯担心他会因罪行被执行<w>注射死刑</w>。"
                            }
                        },
                        {
                            "text": "Debate continues over whether the <w>needle</w> is a humane method of execution.",
                            "target_lang_translations": {
                                "ru": "Продолжаются споры о том, является ли <w>смертельная инъекция</w> гуманным методом казни.",
                                "zh": "关于<w>注射死刑</w>是否是一种人道的处决方式，争论仍在继续。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смертная казнь, осуществляемая путем смертельной инъекции.",
                        "zh": "通过注射毒药执行的死刑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертельная инъекция",
                                "target_lang_sense_clarification": "метод казни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注射死刑",
                                "target_lang_sense_clarification": "一种死刑执行方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e45bd4b7-2821-3519-a9a2-11e9ad51c706",
                    "sense_definition": "To annoy, provoke, or criticize someone repeatedly in a teasing manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "provoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>needle</w> his brother about losing the game.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>подкалывать</w> брата из-за проигрыша в игре.",
                                "zh": "他喜欢因为输掉比赛而<w>挖苦</w>他的弟弟。"
                            }
                        },
                        {
                            "text": "Don't let them <w>needle</w> you into saying something you regret.",
                            "target_lang_translations": {
                                "ru": "Не позволяй им <w>задевать</w> тебя, чтобы ты не сказал того, о чем пожалеешь.",
                                "zh": "别让他们<w>挑衅</w>你，让你说出后悔的话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tease",
                        "goad"
                    ],
                    "common_phrases": [
                        "needle someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать, провоцировать или критиковать кого-либо, постоянно поддразнивая.",
                        "zh": "以戏弄的方式反复烦扰、挑衅或批评某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкалывать",
                                "target_lang_sense_clarification": "разговорное: дразнить, иронизировать"
                            },
                            {
                                "target_lang_word": "задевать",
                                "target_lang_sense_clarification": "провоцировать, раздражать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖苦",
                                "target_lang_sense_clarification": "言语上的挑衅"
                            },
                            {
                                "target_lang_word": "挑衅",
                                "target_lang_sense_clarification": "激怒某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4893750-b6e1-3a3d-b53f-f0bcf72f8081",
                    "sense_definition": "To pierce or operate on something using a needle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pierce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon <w>needled</w> the cyst to drain the fluid.",
                            "target_lang_translations": {
                                "ru": "Хирург <w>проколол</w> кисту, чтобы откачать жидкость.",
                                "zh": "外科医生<w>穿刺</w>了囊肿以排出积液。"
                            }
                        },
                        {
                            "text": "Therapists often <w>needle</w> specific points on the hand for pain relief.",
                            "target_lang_translations": {
                                "ru": "Терапевты часто <w>воздействуют иглами</w> на определенные точки на руке для снятия боли.",
                                "zh": "治疗师经常通过对手部特定穴位进行<w>针灸</w>来缓解疼痛。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прокалывать или оперировать что-либо с помощью иглы.",
                        "zh": "用针刺穿或进行手术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокалывать",
                                "target_lang_sense_clarification": "делать прокол иглой"
                            },
                            {
                                "target_lang_word": "иглоукалывание",
                                "target_lang_sense_clarification": "медицинская процедура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿刺",
                                "target_lang_sense_clarification": "医疗上的刺入动作"
                            },
                            {
                                "target_lang_word": "针灸",
                                "target_lang_sense_clarification": "中医治疗手段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ea290bd6-cf41-3f19-be8f-a6a111990cf0",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Needle</w> signed the guest book at the hotel.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Нидл</w> расписался в книге гостей в отеле.",
                                "zh": "尼德尔先生在酒店的访客簿上签了名。"
                            }
                        },
                        {
                            "text": "We are looking for a family named <w>Needle</w> in the directory.",
                            "target_lang_translations": {
                                "ru": "Мы ищем семью по фамилии <w>Нидл</w> в справочнике.",
                                "zh": "我们正在名录中寻找一个姓尼德尔的家庭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нидл",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尼德尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}