                        "entry_id": "eed57cd3-1c6b-390a-9b3a-e06198142b6c",
                        "glosses": [
                            "Faire perdre son caractère de caricature à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "317698ae-1016-4130-ac32-d6aaf019c552",
                                "sense_id": "369d4d17-e90c-3116-a981-508d62fb5cd6",
                                "text": "La troisième étape nous permettra de relativiser et de décaricaturer l’utilisation des couleurs en reliant le comportement observable aux Motivations (cf. chapitre 10) qui le sous-tendent. — (Patrice Fabart, Révélez le manager qui est en vous !, 2008)"
                            },
                            {
                                "example_id": "bda999ee-084d-42f4-8423-d5a9e0430218",
                                "sense_id": "369d4d17-e90c-3116-a981-508d62fb5cd6",
                                "text": "Peut-on efficacement se déprendre de sa propre caricature, se décaricaturer en quelque sorte ? — (Roland Coutanceau, Faut-il être normal ?, 2014)"
                            }
                        ]
                    }
