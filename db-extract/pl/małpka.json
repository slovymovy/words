                    },
                    {
                        "translation_id": "bb8f2d93-7aeb-49c3-af40-d4c8978d2a14",
                        "source_entry_id": "1a76cf9a-05ae-37f5-82c6-4415c5b4d672",
                        "source_sense_id": "cc66b66d-80a3-33e6-8673-8237e4927079",
                        "target_lang_word": "Affe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Affe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c00dec-2283-3372-ab70-1c10135cf54f",
                                        "entry_id": "c5e99b96-fd0f-37c6-87d5-e10277fe5566",
                                        "glosses": [
                                            "Säugetier aus der Unterordnung Anthropoidea in der Ordnung der Primaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a573a85d-a915-4d6d-a994-a30768fedc29",
                                                "sense_id": "c6c00dec-2283-3372-ab70-1c10135cf54f",
                                                "text": "„Im Gegensatz zu den Menschen mögen die ausschließlich im Simien-Gebirge heimischen äthiopischen Steinböcke die schlauen Affen.“"
                                            },
                                            {
                                                "example_id": "0ae01436-c64c-4be6-acba-142aae72d4c1",
                                                "sense_id": "c6c00dec-2283-3372-ab70-1c10135cf54f",
                                                "text": "Affen sind in der Regel Pflanzenfresser."
                                            },
                                            {
                                                "example_id": "b9b784a5-9dde-4867-a28b-5ff512a79295",
                                                "sense_id": "c6c00dec-2283-3372-ab70-1c10135cf54f",
                                                "text": "„Die neuere Systematik teilt die Primaten in vier Unterordnungen: Lemuroidea oder Lemuren, Galagoidea oder Buschbabys und Loris, Tarsioidea oder Gespenstmakis und Simiae oder Affen.“"
                                            },
                                            {
                                                "example_id": "503d3383-5573-43ac-b886-49f524f92e82",
                                                "sense_id": "c6c00dec-2283-3372-ab70-1c10135cf54f",
                                                "text": "„Statt Kamelen sahen wir nun Affen, Esel, Kühe und Pferde.“"
                                            },
                                            {
                                                "example_id": "e88b50a4-bd34-49b2-88bb-6ca8dc4dcc7e",
                                                "sense_id": "c6c00dec-2283-3372-ab70-1c10135cf54f",
                                                "text": "„In einem großen Käfig mit einem Baumstamm darin turnten dort zwei aufgeregte Affen mit langen Schwänzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b386f36a-4fe9-3d70-8036-336004a9da0b",
                                        "entry_id": "c5e99b96-fd0f-37c6-87d5-e10277fe5566",
                                        "glosses": [
                                            "eitler, affektierter Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f09d890-c02a-4553-a634-7a3d367ec72d",
                                                "sense_id": "b386f36a-4fe9-3d70-8036-336004a9da0b",
                                                "text": "Ich versteh' nicht, was du an dem Affen findest."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf0abe6a-7f4f-392e-81a0-3bcca207238a",
                                        "entry_id": "c5e99b96-fd0f-37c6-87d5-e10277fe5566",
                                        "glosses": [
                                            "roher, primitiver, ungeschlachter Mann"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ddeb080-72c9-4372-9842-3b165c85f423",
                                                "sense_id": "cf0abe6a-7f4f-392e-81a0-3bcca207238a",
                                                "text": "Er hat sich wie ein Affe aufgeführt, man kann kaum glauben, dass der gebildet sein soll."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a710123c-ef41-3e03-b233-3b4fd2245d83",
                                        "entry_id": "c5e99b96-fd0f-37c6-87d5-e10277fe5566",
                                        "glosses": [
                                            "ein junges Murmeltier"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e953ea6-b4da-440e-a203-14db0a577d1b",
                                                "sense_id": "a710123c-ef41-3e03-b233-3b4fd2245d83",
                                                "text": "Da sah ich eine Katze mit vier Affen im Bau verschwinden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "263757f6-917c-3a9f-b579-7e77f1d2870b",
                                        "entry_id": "c5e99b96-fd0f-37c6-87d5-e10277fe5566",
                                        "glosses": [
                                            "Felltornister"
                                        ],
                                        "tags": [
                                            "Militärjargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77b0971a-83cf-43fd-aba5-35e0e1bd2e4a",
                                                "sense_id": "263757f6-917c-3a9f-b579-7e77f1d2870b",
                                                "text": "Die Soldaten trugen einen Affen mit sich."
                                            },
                                            {
                                                "example_id": "c26c9241-bb6c-42de-b790-fc13c8f0eda1",
                                                "sense_id": "263757f6-917c-3a9f-b579-7e77f1d2870b",
                                                "text": "„Das ungewohnte Marschieren mit dem schweren Affen kam uns Marinern recht sauer an.“"
                                            },
                                            {
                                                "example_id": "e325959a-9419-4db4-a3b2-e46e848cff3f",
                                                "sense_id": "263757f6-917c-3a9f-b579-7e77f1d2870b",
                                                "text": "„In Halle nahm er seinen Affen und stieg aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "45c3fa18-2212-305a-80d7-8e7fcd602622",
                                        "entry_id": "c5e99b96-fd0f-37c6-87d5-e10277fe5566",
                                        "glosses": [
                                            "ein durch Alkohol verursachter Rauschzustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d382765-6361-42d0-8a21-bdfc66ecf58e",
                                                "sense_id": "45c3fa18-2212-305a-80d7-8e7fcd602622",
                                                "text": "Sie hatte einen mächtigen Affen."
                                            },
                                            {
                                                "example_id": "f08633fd-f23f-43e9-be9e-52666883c3e1",
                                                "sense_id": "45c3fa18-2212-305a-80d7-8e7fcd602622",
                                                "text": "Er trug einen gewaltigen Affen davon."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebe94e13-3f9f-46cc-98a2-197505db7a15",
                        "source_entry_id": "1a76cf9a-05ae-37f5-82c6-4415c5b4d672",
                        "source_sense_id": "cc66b66d-80a3-33e6-8673-8237e4927079",
                        "target_lang_word": "Äffchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äffchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                                        "entry_id": "c62e819d-1c42-3340-bbf6-bcb888792053",
                                        "glosses": [
                                            "kleiner Affe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15806d1-e52e-43c7-b210-fd434fc1daac",
                                                "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                                                "text": "„Ich hab ein Haus, ein kunterbuntes Haus, ein Äffchen und ein Pferd, die schauen dort zum Fenster raus.“ (Pippi-Langstrumpf-Lied)"
                                            },
                                            {
                                                "example_id": "b9ae2fe9-da94-4a75-8ac4-ef664d347073",
                                                "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                                                "text": "„Im nächsten Augenblick schoß ein kleines braunes Äffchen durch den Türspalt, hüpfte schrill kichernd die Stufen hinunter und turnte an Thomas Lieven empor.“"
                                            },
                                            {
                                                "example_id": "21bbf064-1054-41c6-b977-18075636b962",
                                                "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                                                "text": "„Seine Hände spielen mit einer um eine Spule gewickelten Schnur, die mit einem Äffchen verbunden ist, Allegorie und verdoppelnde Verkörperung der ›Narrheit‹ des Kindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54dbb695-f21b-46a2-b831-07310914b82c",
