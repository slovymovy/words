        "fr-extract.jsonl": [
            {
                "entry_id": "92297206-e814-3a6c-8d6d-8b19a94ba176",
                "word": "fumigation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b4166d6-a042-4a51-831d-51d93443dea1",
                        "entry_id": "92297206-e814-3a6c-8d6d-8b19a94ba176",
                        "tags": [
                            "plural"
                        ],
