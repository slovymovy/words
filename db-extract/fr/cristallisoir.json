                "forms": [
                    {
                        "form_id": "736b3cc0-22cb-418f-a4e5-dee9d0fd874f",
                        "entry_id": "9668e4ac-b0b7-3b96-9438-374e4f9223f2",
                        "tags": [
                            "plural"
                        ],
                        "form": "cristallisoirs"
