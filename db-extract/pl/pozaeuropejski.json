                "senses": [
                    {
                        "sense_id": "6f83e579-c644-3def-8006-cf8de8683dc6",
                        "entry_id": "b3c7d7f3-80e6-3365-aa1e-f4dfd0fefd49",
                        "glosses": [
                            "odnoszący się do obszarów lub państw poza Europą, leżący poza Europą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f453279-e0c3-45f4-925d-570e2213e27c",
                                "sense_id": "6f83e579-c644-3def-8006-cf8de8683dc6",
                                "text": "Podział na starożytność, średniowiecze i nowożytność znajduje zastosowanie przede wszystkim w historii Europy, choć jest wykorzystywany także w badaniach nad krajami pozaeuropejskimi, szczególnie w opracowaniach syntetycznych"
                            },
                            {
                                "example_id": "158f3ddb-40e1-42aa-b073-d21e90dd1506",
                                "sense_id": "6f83e579-c644-3def-8006-cf8de8683dc6",
                                "text": "Cesarz zamierza odwiedzić szereg krajów pozaeuropejskich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
