                "senses": [
                    {
                        "sense_id": "3da587e4-c83c-358b-a74c-f31bceded78c",
                        "entry_id": "c81d5555-018b-3cc3-a0cb-d3eb208f03b1",
                        "glosses": [
                            "Die Krümmung und Verwirbelung der Raumzeit ist eine Theorie von Albert Einstein"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "0ec49b8c-940f-4e5d-a310-9cf9c239dee1",
                                "sense_id": "3da587e4-c83c-358b-a74c-f31bceded78c",
                                "text": "„Die Schwerkraft ist nichts weiter als die Krümmung von Raum und Zeit: Mit dieser Theorie hat Albert Einstein vor fast 100 Jahren die Physik revolutioniert. Jetzt hat ein sündhaft teurer Nasa-Satellit die letzten Zweifel ausgeräumt: Krümmung und Verwirbelung der Raumzeit sind real.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fb5f5887-e468-3fc0-96c0-f8eb01bef0b4",
                        "entry_id": "c81d5555-018b-3cc3-a0cb-d3eb208f03b1",
                        "glosses": [
                            "Turbulenzen von Luft, Wasser und Mineralstoffen findet an Hindernissen oder durch Druckveränderung statt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ccd9d7-fd90-4069-a765-fe72e0f932cf",
                                "sense_id": "fb5f5887-e468-3fc0-96c0-f8eb01bef0b4",
                                "text": "„Der Druckverlust wird gleichzeitig ansteigen, da die Verwirbelung der Schichten eine \"Verfestigung\" des Strömungskörpers zur Folge hat. Abbildung 7 zeigt vergleichend die Geschwindigkeitsprofile für die laminare und die turbulente Strömung.“"
                            },
                            {
                                "example_id": "50433656-8ea1-4032-83d7-b512569067dd",
                                "sense_id": "fb5f5887-e468-3fc0-96c0-f8eb01bef0b4",
                                "text": "„Die Verwirbelung nach Victor Schauberger und seinem Sohn Walter ist eins der bekanntesten Verfahren zur Vitalisierung und Umstrukturierung von Leitungswasser auf physikalisch mechanischem Weg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
