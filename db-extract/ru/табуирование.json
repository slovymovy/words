                                "target_senses": [
                                    {
                                        "sense_id": "1a453548-a8f6-333b-9841-875856585dea",
                                        "entry_id": "c01f3bef-8c2f-30b4-ba69-7e13349a72a8",
                                        "glosses": [
                                            "The imposition of a taboo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a60b72-980d-408a-b87a-7e2290944942",
                                                "sense_id": "1a453548-a8f6-333b-9841-875856585dea",
                                                "text": "It is to be desired that in prison and police stations complete lists should be made out of the tabooings upon criminals, especially young prisoners who have not attained full development […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29389785-f236-4fe4-b4b2-02b2a93947d8",
                        "source_entry_id": "cde51209-4e5b-3e42-8875-189ea9d13f11",
                        "source_sense_id": "9f34e1a4-e360-3d3a-a488-b59f5172d1ba",
