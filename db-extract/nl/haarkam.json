                                        "sense_id": "35299faf-9fa7-3211-a874-c2ca25a7af17",
                                        "entry_id": "988f5d2d-b2bd-3d9a-b289-8df12b4e0f95",
                                        "glosses": [
                                            "To roll over, as the top or crest of a wave; to break with a white foam, as waves."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "406e5876-662f-34cb-8caf-3ba0ec6b2dde",
                                        "entry_id": "988f5d2d-b2bd-3d9a-b289-8df12b4e0f95",
                                        "glosses": [
                                            "To turn a vessel parallel to (the track of) (a torpedo) so as to reduce one's size as a target."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03db64a9-2d79-4292-b416-b0448c12f80b",
                                                "sense_id": "406e5876-662f-34cb-8caf-3ba0ec6b2dde",
                                                "text": "The aircraft split up so as to attack from different, preselected bearings, thus confusing the gunners and making it difficult for the ship to comb torpedo tracks."
                                            },
                                            {
                                                "example_id": "f00bb0d2-c1bf-419a-83a3-3e6a256a5a57",
                                                "sense_id": "406e5876-662f-34cb-8caf-3ba0ec6b2dde",
                                                "text": "Sixteen torpedo bombers divided their attention between the two ships. Repulse combed the torpedo wakes and knocked down two of the attackers."
                                            }
                                        ]
