                                            {
                                                "example_id": "7575b360-0471-4544-a531-a338b2988b64",
                                                "sense_id": "da67208a-ec1b-3513-80b7-e6319e4a1a4f",
                                                "text": "Chudobná a nábožná stařena žila osaměle, a jenom služebná jí posluhovala."
                                            }
                                        ]
                                    }
