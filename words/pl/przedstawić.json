{
    "word_family": [
        "przedstawiać",
        "przedstawienie",
        "przedstawiciel",
        "przedstawicielka",
        "przedstawicielstwo"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1774e046-f969-3f7b-a46d-7f7297a00a64",
                    "sense_definition": "zapoznać ze sobą kogoś, podając dane osobowe tej osoby",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zapoznanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas wczorajszego przyjęcia Kasia <w>przedstawiła</w> rodzicom swojego nowego narzeczonego.",
                            "target_lang_translations": {
                                "ru": "Во время вчерашней вечеринки Кася <w>познакомила</w> родителей со своим новым женихом."
                            }
                        },
                        {
                            "text": "Nauczyciel od razu <w>przedstawił</w> nowego ucznia całej klasie.",
                            "target_lang_translations": {
                                "ru": "Учитель сразу <w>представил</w> нового ученика всему классу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przedstawić znajomym",
                        "przedstawić rodzicom"
                    ],
                    "target_lang_definitions": {
                        "ru": "познакомить людей друг с другом, назвав их имена"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "познакомить",
                                "target_lang_sense_clarification": "людей друг с другом"
                            },
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "кого-либо кому-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e9bd7c6-8249-3f0b-8e74-55b5c106eafa",
                    "sense_definition": "powiedzieć komuś, jak się nazywa i kim się jest (zaimkowo: przedstawić się)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zapoznanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszedł do gabinetu dyrektora i grzecznie się <w>przedstawił</w>.",
                            "target_lang_translations": {
                                "ru": "Он вошёл в кабинет директора и вежливо <w>представился</w>."
                            }
                        },
                        {
                            "text": "Zanim zaczniemy oficjalną rozmowę, chciałbym się najpierw <w>przedstawić</w>.",
                            "target_lang_translations": {
                                "ru": "Прежде чем мы начнём официальную беседу, я хотел бы сначала <w>представиться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pokazać się"
                    ],
                    "common_phrases": [
                        "grzecznie się przedstawić"
                    ],
                    "target_lang_definitions": {
                        "ru": "назвать собеседнику своё имя и статус (в форме przedstawić się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представиться",
                                "target_lang_sense_clarification": "назвать своё имя"
                            },
                            {
                                "target_lang_word": "познакомиться",
                                "target_lang_sense_clarification": "назвать себя при встрече"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45a3e006-bdff-37a3-8b94-84cc209ae5e0",
                    "sense_definition": "pokazać coś publicznie, omówić lub poddać pod ocenę innych",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prezentacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dzisiejszym zebraniu dyrektor <w>przedstawił</w> raport finansowy firmy za ubiegły rok.",
                            "target_lang_translations": {
                                "ru": "На сегодняшнем собрании директор <w>представил</w> финансовый отчёт компании за прошлый год."
                            }
                        },
                        {
                            "text": "Nasz zespół wreszcie <w>przedstawił</w> wyniki badań całemu komitetowi naukowemu.",
                            "target_lang_translations": {
                                "ru": "Наша команда наконец <w>представила</w> результаты исследований всему научному комитету."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaprezentować",
                        "pokazać"
                    ],
                    "common_phrases": [
                        "przedstawić raport",
                        "przedstawić wyniki"
                    ],
                    "target_lang_definitions": {
                        "ru": "показать что-либо публично, изложить или вынести на обсуждение и оценку других"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "отчёт, доклад, результаты"
                            },
                            {
                                "target_lang_word": "презентовать",
                                "target_lang_sense_clarification": "продемонстрировать проект или продукт"
                            },
                            {
                                "target_lang_word": "изложить",
                                "target_lang_sense_clarification": "факты или содержание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45804edd-e61b-3383-9439-43d98093ebf8",
                    "sense_definition": "wysunąć wniosek, pomysł lub ofertę do rozpatrzenia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prezentacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierownik <w>przedstawił</w> nową propozycję współpracy obu zainteresowanym stronom.",
                            "target_lang_translations": {
                                "ru": "Руководитель <w>внёс</w> новое предложение о сотрудничестве обеим заинтересованным сторонам."
                            }
                        },
                        {
                            "text": "Architekt szybko <w>przedstawił</w> klientowi wstępny projekt nowoczesnego domu.",
                            "target_lang_translations": {
                                "ru": "Архитектор быстро <w>представил</w> клиенту эскизный проект современного дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaproponować"
                    ],
                    "common_phrases": [
                        "przedstawić propozycję",
                        "przedstawić projekt",
                        "przedstawić ofertę"
                    ],
                    "target_lang_definitions": {
                        "ru": "выдвинуть предложение, идею или оферту на рассмотрение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внести",
                                "target_lang_sense_clarification": "предложение"
                            },
                            {
                                "target_lang_word": "предложить",
                                "target_lang_sense_clarification": "идею или вариант"
                            },
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "проект или предложение на рассмотрение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdda8abb-1209-3242-9593-fcb4b287716e",
                    "sense_definition": "ukazać lub odtworzyć kogoś albo coś w dziele sztuki, literaturze bądź filmie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obrazowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malarz <w>przedstawił</w> scenę bitwy z niezwykłą dbałością o historyczne szczegóły.",
                            "target_lang_translations": {
                                "ru": "Художник <w>изобразил</w> сцену битвы с исключительным вниманием к историческим деталям."
                            }
                        },
                        {
                            "text": "Pisarz w swojej powieści trafnie <w>przedstawił</w> codzienne życie mieszkańców dawnej wsi.",
                            "target_lang_translations": {
                                "ru": "Писатель в своём романе метко <w>показал</w> повседневную жизнь жителей старой деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "pokazać"
                    ],
                    "common_phrases": [
                        "wiernie przedstawić"
                    ],
                    "target_lang_definitions": {
                        "ru": "показать или отобразить кого-либо либо что-либо в произведении искусства, литературе или кино"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобразить",
                                "target_lang_sense_clarification": "в картине, произведении искусства"
                            },
                            {
                                "target_lang_word": "показать",
                                "target_lang_sense_clarification": "в фильме, книге"
                            },
                            {
                                "target_lang_word": "отобразить",
                                "target_lang_sense_clarification": "действительность или события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e33bcb0f-c0e3-3319-b93d-2f314dc68d90",
                    "sense_definition": "stworzyć w myślach obraz jakiejś sytuacji lub rzeczy (zwykle zaimkowo: przedstawić sobie)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obrazowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trudno mi nawet <w>przedstawić</w> sobie ogrom zniszczeń wywołanych przez tę burzę.",
                            "target_lang_translations": {
                                "ru": "Мне трудно даже <w>представить</w> себе масштаб разрушений, вызванных этой бурей."
                            }
                        },
                        {
                            "text": "Spróbuj <w>przedstawić</w> sobie nasze życie za dwadzieścia lat.",
                            "target_lang_translations": {
                                "ru": "Попробуй <w>представить</w> себе нашу жизнь через двадцать лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyobrazić",
                        "zwizualizować"
                    ],
                    "common_phrases": [
                        "przedstawić sobie sytuację"
                    ],
                    "target_lang_definitions": {
                        "ru": "мысленно воспроизвести образ ситуации или предмета (обычно przedstawić sobie)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "себе в мыслях"
                            },
                            {
                                "target_lang_word": "вообразить",
                                "target_lang_sense_clarification": "мысленно воспроизвести"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bf7ca36-79f0-3f3f-b3ab-b83ce0e41ec3",
                    "sense_definition": "oficjalnie zgłosić czyjąś kandydaturę na określone stanowisko lub do nagrody",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nominacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Komisja <w>przedstawiła</w> kandydaturę profesora do prestiżowej nagrody państwowej.",
                            "target_lang_translations": {
                                "ru": "Комиссия <w>выдвинула</w> кандидатуру профессора на соискание престижной государственной премии."
                            }
                        },
                        {
                            "text": "Partia oficjalnie <w>przedstawiła</w> swojego kandydata w zbliżających się wyborach prezydenckich.",
                            "target_lang_translations": {
                                "ru": "Партия официально <w>выдвинула</w> своего кандидата на предстоящих президентских выборах."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaproponować"
                    ],
                    "common_phrases": [
                        "przedstawić kandydata",
                        "przedstawić kandydaturę"
                    ],
                    "target_lang_definitions": {
                        "ru": "официально выдвинуть чью-либо кандидатуру на должность или к награде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдвинуть",
                                "target_lang_sense_clarification": "кандидата или кандидатуру"
                            },
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "к награде или к должности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d324883f-4b4e-39da-ab13-11bed407f3e3",
                    "sense_definition": "występować w czyimś imieniu, działać jako reprezentant",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prawnik <w>przedstawił</w> interesy poszkodowanego klienta przed sądem najwyższej instancji.",
                            "target_lang_translations": {
                                "ru": "Юрист <w>представил</w> интересы пострадавшего клиента в суде высшей инстанции."
                            }
                        },
                        {
                            "text": "Ambasador godnie <w>przedstawił</w> stanowisko całego rządu podczas międzynarodowych obrad.",
                            "target_lang_translations": {
                                "ru": "Посол достойно <w>представил</w> позицию всего правительства в ходе международных переговоров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przedstawić interesy"
                    ],
                    "target_lang_definitions": {
                        "ru": "выступить от чьего-либо имени, действовать в качестве представителя"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "интересы или позицию"
                            },
                            {
                                "target_lang_word": "отстоять",
                                "target_lang_sense_clarification": "интересы стороны в суде"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}