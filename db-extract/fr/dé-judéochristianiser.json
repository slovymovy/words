                "senses": [
                    {
                        "sense_id": "e8e391c0-0151-3670-a1d6-a1e0eb785150",
                        "entry_id": "43f6109e-ab54-3d1c-8674-a0c76cc95b26",
                        "glosses": [
                            "Enlever son caractère judéochrétien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e0e053-a515-4163-91be-972aadefebc3",
                                "sense_id": "e8e391c0-0151-3670-a1d6-a1e0eb785150",
                                "text": "Notre société a oeuvré depuis une bonne centaine d’années pour se dé-judéochristianiser, en surface et en apparence du moins."
                            },
                            {
                                "example_id": "60184ebc-04d2-442f-983f-3c4abdad1116",
                                "sense_id": "e8e391c0-0151-3670-a1d6-a1e0eb785150",
                                "text": "Bref, pour faire court, l’Europe doit se \"dé-judéochristianiser\" pour s’ \"euro-christianiser\" en retrouvant ses racines spirituelles germaniques, celtiques, grecques, romaines, etc."
                            }
                        ]
                    }
