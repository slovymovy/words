                "senses": [
                    {
                        "sense_id": "ea269d7f-f2ef-3fd9-9081-6e7d60c03d8e",
                        "entry_id": "10578cb1-e8c2-3c4e-97cf-9953f428a98f",
                        "glosses": [
                            "наука о человеческом естественном языке как знаковой системе и средстве общения, а также обо всех языках мира, общих законах строения и функционирования человеческого языка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5249c60-2568-40e1-80ff-90d028806568",
                                "sense_id": "ea269d7f-f2ef-3fd9-9081-6e7d60c03d8e",
                                "text": "Большой вклад в изучение славянского этногенеза внесло языкознание."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ab588e8-4fa8-4d14-9f2b-318c7066a156",
                        "source_entry_id": "10578cb1-e8c2-3c4e-97cf-9953f428a98f",
                        "source_sense_id": "ea269d7f-f2ef-3fd9-9081-6e7d60c03d8e",
                        "target_lang_word": "jazykověda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jazykověda",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "00f3db34-2cbe-3a9c-9430-dbe5961cfff9",
                                        "entry_id": "35d73d6f-6ab4-3058-bdce-417694a5e9f1",
                                        "glosses": [
                                            "nauka o jazyku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820b6a9a-bf01-4745-89f6-1f4c77d476ce",
                                                "sense_id": "00f3db34-2cbe-3a9c-9430-dbe5961cfff9",
                                                "text": "Jazykověda se dělí na dvě velká odvětví: mluvnici (gramatiku) a nauku o slovní zásobě (lexikologii)."
                                            },
                                            {
                                                "example_id": "2be23639-6b26-4e62-a8d0-c368a6b0df43",
                                                "sense_id": "00f3db34-2cbe-3a9c-9430-dbe5961cfff9",
                                                "text": "Tehdy nabyly nové podoby také oba obory, jež vždy vlivně zasahovaly do národního i slovesného života, jazykověda a dějezpyt: onu postavil klidný klasik vývojeslovného výkladu Jan Gebauer na široký základ srovnávací, tento naplnil vybroušený mistr detailní kritiky Jaroslav Goll hledisky západoevropskými."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
