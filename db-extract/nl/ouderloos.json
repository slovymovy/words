                        "examples": [
                            {
                                "example_id": "c751b3da-a556-4274-a73f-540065cb2ae3",
                                "sense_id": "902501bc-d7fd-3331-9a3c-8d6b8661fddd",
                                "text": "Een ouderloos weekend was voor de kinderen een reden om een groot feest te houden."
                            },
                            {
                                "example_id": "313b9c7d-a9c6-4a3f-9d40-9f7ddbd28fbe",
                                "sense_id": "902501bc-d7fd-3331-9a3c-8d6b8661fddd",
                                "text": "Nadat ze weer eens naar allerlei culturele hoogtepunten moesten van hun ouders besloten de kinderen voortaan ouderloze vakanties te gaan vieren."
                            }
                        ]
