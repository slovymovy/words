                        "glosses": [
                            "Gruppensexpraktik, bei der mehrere Männer auf eine weitere Person ejakulieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b280cbac-a33d-49ac-aabb-2a57bc91f7a1",
                                "sense_id": "cfbd95f0-6a04-339f-b4c7-048963cacb19",
                                "text": "„Eine typische Szene: Eine Nachrichten-Sprecherin verliest im Fernsehen die News. Ihre Mimik bleibt unbeeindruckt davon, dass ihr mehrere Männer gleichzeitig ins Gesicht ejakulieren – in Japan nennt man diese Sex-Praktik Bukkake.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
