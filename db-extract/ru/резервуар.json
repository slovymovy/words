                                        "entry_id": "c40723e9-37a5-32de-87ab-c9fd5d64f674",
                                        "glosses": [
                                            "Behältnis oder Becken zur Speicherung unter anderem von Flüssigkeiten oder Schüttgütern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "790c2d55-51ab-4cb9-84c2-73f7e0176fed",
                                                "sense_id": "ebb7bc40-67c0-3503-9289-b90dde68195b",
                                                "text": "„Auckland erhält einen großen Teil seines Wassers aus Reservoirs in den Hunua Ranges.“"
                                            }
                                        ],
