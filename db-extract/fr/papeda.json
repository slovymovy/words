                        "entry_id": "9a00bfb9-1cda-3bae-97f2-843826688dc9",
                        "glosses": [
                            "Agrume du sous-genre Papeda du genre Citrus, par exemple le combava."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e6742d7-eefd-448b-83d8-3f849aaebaa8",
                                "sense_id": "14ad16bd-94c6-3e85-befd-aa7b81bd6488",
                                "text": "Appartenant à la famille des rutacées, le genre citrus, né en Sud-Est asiatique, est à l’origine des quatre espèces (mandariniers, pamplemoussiers, cédratiers et un papeda) les plus courantes sur nos étals : orangers, citronniers, limettiers et pomelos."
                            },
                            {
                                "example_id": "130d91b1-1a6a-4959-a91f-31ffdcda1bff",
                                "sense_id": "14ad16bd-94c6-3e85-befd-aa7b81bd6488",
                                "text": "Pomelo à feuille de papeda, le fruit est très juteux et acide, il peut s’utiliser comme un citron, après maturité il devient plus doux et se consomme comme un pomelo"
                            },
                            {
                                "example_id": "d1f970b7-763b-4a3a-b061-1d0003e377fd",
                                "sense_id": "14ad16bd-94c6-3e85-befd-aa7b81bd6488",
                                "text": "Il serait un hybride entre un papeda (Ichang?) et un pamplemousse."
                            },
                            {
                                "example_id": "07ff7a40-4216-44c2-8feb-c19ee38b6f3b",
                                "sense_id": "14ad16bd-94c6-3e85-befd-aa7b81bd6488",
                                "text": "Que sont les papedas ?"
                            }
                        ]
                    }
