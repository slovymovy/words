                "senses": [
                    {
                        "sense_id": "645b1b28-8fb3-399c-8953-d742c0f3a26e",
                        "entry_id": "d821de34-f631-3321-96c0-33d62b5cfde8",
                        "glosses": [
                            "The CGS unit of electric dipole moment, defined as 1 D = 10⁻¹⁸ statcoulomb-centimetre and computable from the SI unit coulomb-metre by multiplying by the factor 3.33564 × 10⁻³⁰."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cde6b92-97d8-4580-91d8-803051831f04",
                                "sense_id": "645b1b28-8fb3-399c-8953-d742c0f3a26e",
                                "text": "The dipole moments of water and the alcohols are about 1.8 debyes. The moments of ethers are smaller, about 1.2 debyes."
                            },
                            {
                                "example_id": "6e3a322b-77e6-41e4-91cb-d987720c2d1f",
                                "sense_id": "645b1b28-8fb3-399c-8953-d742c0f3a26e",
                                "text": "There is considerable transfer of negative charge to the carbon atoms in the pyrrole ring, which give it a high dipole moment ≈ 1.8 Debyes."
                            },
                            {
                                "example_id": "9c9b943b-1668-433a-88fe-214f4b1f23e2",
                                "sense_id": "645b1b28-8fb3-399c-8953-d742c0f3a26e",
                                "text": "The corresponding results obtained here for #92;mu of benzaldehyde range 1.298 Debyes — 1.471 Debyes, where the lower reported experimental value corresponds to the gas phase one of 1.263 Debyes, which is in good correspondence with the #92;mu calculated at MP4 level (1.298 Debyes)."
                            }
                        ]
                    }
                ],
