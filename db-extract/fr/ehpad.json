                        ],
                        "examples": [
                            {
                                "example_id": "a6a1ee4e-7b10-4895-bb67-c5540017fb28",
                                "sense_id": "530cec2f-451a-3295-bfec-154ed33df523",
                                "text": "Des mouvements, initiés par les syndicats, qui cristallisent le ras-le-bol et l’épuisement des personnels de nombre d’établissements de santé, ceux du CHU de Clermont-Ferrand, des Ehpad, etc."
                            },
                            {
                                "example_id": "e929fb44-584e-4379-923e-28273307dd84",
                                "sense_id": "530cec2f-451a-3295-bfec-154ed33df523",
                                "text": "Le Premier Ministre, Édouard Philippe, accompagné de la ministre de la Santé, Agnès Buzyn, s’est rendu dans un Ehpad d’Issy-les-Moulineaux (Hauts-de-Seine) le 25 juillet, au plus fort de la canicule."
                            },
                            {
                                "example_id": "9ef45a1e-c08d-4e90-9052-871f24beb62f",
                                "sense_id": "530cec2f-451a-3295-bfec-154ed33df523",
                                "text": "Avec les Ehpad, les prisons sont un sujet de préoccupation pour le gouvernement qui redoute une explosion des cas de covid-19 derrière les barreaux."
                            }
                        ]
                    }
