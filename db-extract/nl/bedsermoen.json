                        "glosses": [
                            "terechtwijzing die een man van zijn vrouw krijgt als ze samen in bed liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f1996a-e402-4b2f-9f31-24787c6b07d3",
                                "sense_id": "3fedd820-65f5-3ce3-b5ac-ebbfdbfa6025",
                                "text": "Al vier keer bracht hij een verdwijnwoordenboek uit. „Archaïsche woorden die compleet verdwenen zijn uit onze taal. Bedsermoen bijvoorbeeld, dat was de vermaning of terechtwijzing die een vrouw aan haar man gaf als ze samen tussen de lakens lagen."
                            },
                            {
                                "example_id": "efb8ae33-f371-4db9-a2ca-50d588a43002",
                                "sense_id": "3fedd820-65f5-3ce3-b5ac-ebbfdbfa6025",
                                "text": "Bedsermoen: Terechtwijzing van een vrouw aan haar man, terwijl ze samen in bed liggen. Ook wel: ‘gordijnpreek.’: Nadat ik de belofte aan mijn vrouw niet was nagekomen, voorzag ik een bedsermoen."
                            }
                        ]
                    }
