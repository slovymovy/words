                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc6a38d-57a4-460f-8c4d-d943f4e51843",
                                                "sense_id": "e74831a6-81b1-38eb-8040-63ae2851f7fd",
                                                "text": "Eine Erhöhung der Steuer sei allerdings derzeit kein Thema."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "40006662-6da9-3644-8bc3-6b41d8ffbee9",
                                        "entry_id": "563acd5b-4e51-3230-aadf-b7ee939bac32",
                                        "glosses": [
                                            "Anhebung des Ranges oder der sozialen Stellung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f5b12f-2499-4390-b12d-4cc5bf940185",
                                                "sense_id": "40006662-6da9-3644-8bc3-6b41d8ffbee9",
                                                "text": "Nach seiner Erhöhung zum Herzog wurde er förmlich ein anderer Mensch."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0d386b5b-b6a9-35dd-9c79-2dbe9cf28495",
                                        "entry_id": "563acd5b-4e51-3230-aadf-b7ee939bac32",
                                        "glosses": [
                                            "das Heraufsetzen einer Note um einen Halbton"
                                        ],
