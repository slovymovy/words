                    "sense_id": "1f5d8688-2132-386c-a143-6fcf771387a4",
                    "sense_definition": "Неформальное дружеское приветствие, которое говорят при встрече.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Привет</w>, я так рад тебя видеть!",
                            "target_lang_translations": {
                                "en": "<w>Hi</w>, I am so glad to see you!",
                                "zh": "<w>你好</w>，见到你真高兴！",
                                "nl": "<w>Hoi</w>, ik ben zo blij je te zien!",
                                "pl": "<w>Cześć</w>, tak bardzo się cieszę, że cię widzę!",
                                "de": "<w>Hallo</w>, ich freue mich so sehr, dich zu sehen!",
                                "fr": "<w>Salut</w>, je suis tellement content de te voir !",
                                "it": "<w>Ciao</w>, sono così felice di vederti!",
                                "cs": "<w>Ahoj</w>, jsem tak rád, že tě vidím!",
                                "tr": "<w>Selam</w>, seni gördüğüme çok sevindim!",
                                "es": "<w>¡Hola</w>, estoy muy contento de verte!"
                            }
                        },
                        {
                            "text": "<w>Привет</w>, как прошли твои выходные?",
                            "target_lang_translations": {
                                "en": "<w>Hi</w>, how was your weekend?",
                                "zh": "<w>你好</w>，你的周末过得怎么样？",
                                "nl": "<w>Hoi</w>, hoe was je weekend?",
                                "pl": "<w>Cześć</w>, jak minął twój weekend?",
                                "de": "<w>Hallo</w>, wie war dein Wochenende?",
                                "fr": "<w>Salut</w>, comment se sont passés tes week-ends ?",
                                "it": "<w>Ciao</w>, come è andato il tuo fine settimana?",
                                "cs": "<w>Ahoj</w>, jak jsi strávil víkend?",
                                "tr": "<w>Selam</w>, hafta sonun nasıl geçti?",
                                "es": "<w>¡Hola</w>, ¿cómo estuvo tu fin de semana?"
                            }
                        }
                    ],
