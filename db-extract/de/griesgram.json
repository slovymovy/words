                "senses": [
                    {
                        "sense_id": "2f739d38-0985-3d33-a629-4bde966ec81f",
                        "entry_id": "a9088b0e-1a7b-3faa-9b53-a0969047961d",
                        "glosses": [
                            "mürrische, übellaunige, abweisende Person"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d0c5add0-21bf-4422-8c20-6facf6da7c5d",
                                "sense_id": "2f739d38-0985-3d33-a629-4bde966ec81f",
                                "text": "Sei bloß leise im Treppenhaus, sonst fährt dich dieser alte Griesgram aus der zweiten Etage wieder so an wie neulich."
                            },
                            {
                                "example_id": "063ae2b0-a2de-4edc-ac4b-cea74dc1efd0",
                                "sense_id": "2f739d38-0985-3d33-a629-4bde966ec81f",
                                "text": "„Dennoch hat der Mann sich zu einem höllischen Griesgram entwickelt, der den lächerlichsten Spitznamen der Stadt mit sich herumschleppte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "005b7882-f387-48cd-b53b-71d1fe6aff6b",
                        "source_entry_id": "a9088b0e-1a7b-3faa-9b53-a0969047961d",
                        "source_sense_id": "2f739d38-0985-3d33-a629-4bde966ec81f",
                        "source_sense_description": "abwertend: mürrische, übellaunige, abweisende Person",
                        "target_lang_word": "sourpuss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sourpuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea0faec-eb7c-38f2-9b1c-ba3254d4328f",
                                        "entry_id": "0422f44f-3b65-36e1-ba25-3d4b55697c7e",
                                        "glosses": [
                                            "A person who is habitually gloomy, sullen or miserable; a grouch; a scowling person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36395eff-616a-4cb9-8c0c-7184e156fc40",
                                                "sense_id": "9ea0faec-eb7c-38f2-9b1c-ba3254d4328f",
                                                "text": "They butt heads sometimes because Jenna can be pretty selfish and tone-deaf, and Jeordie can be a little bit of a sourpuss."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sourpuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8079d4f-986c-317a-a74a-4f06186810fa",
                                        "entry_id": "277c7f60-d5ec-3048-ae9d-360291f5bf24",
                                        "glosses": [
                                            "To make a gloomy, sullen or miserable facial expression; to scowl."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f4d46ae-91a9-4131-a7e2-64ea3754511d",
                                                "sense_id": "a8079d4f-986c-317a-a74a-4f06186810fa",
                                                "text": "“Oh, stop your sourpussing. We got what you needed.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
