                                                "sense_id": "4f7ab86d-c508-3734-8e68-a84a22c7d278",
                                                "text": "Die meisten Boas stammen aus Südamerika."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41304182-4681-3bfc-85a2-4391f74dda71",
                                        "entry_id": "bdc99f30-d25c-3f42-bc80-031af67bb363",
                                        "glosses": [
