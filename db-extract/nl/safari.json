                "senses": [
                    {
                        "sense_id": "c1d2cd29-5258-38ed-92ae-aa1d9504a80b",
                        "entry_id": "8a1e08b2-9dee-3657-bd35-9214efc436d1",
                        "glosses": [
                            "expeditie in de wildgebieden in Afrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fdedd3d-7c6e-4d02-8081-a402ca06e96e",
                                "sense_id": "c1d2cd29-5258-38ed-92ae-aa1d9504a80b",
                                "text": "We zijn naar Kenia op safari gegaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8bd9b5a-d6cb-4481-b9e2-16ddf72c846d",
                        "source_entry_id": "8a1e08b2-9dee-3657-bd35-9214efc436d1",
                        "source_sense_id": "c1d2cd29-5258-38ed-92ae-aa1d9504a80b",
                        "source_sense_description": "expeditie in de wildgebieden in Afrika",
                        "target_lang_word": "Safari",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Safari",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                        "entry_id": "799aecfc-7ee0-3afa-9ef2-c80d78081604",
                                        "glosses": [
                                            "Reise (durch Afrika), auf der Großwild gejagt oder beobachtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c623171-7342-4eab-bf08-a5e013f0f303",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "Auf einer Safari sollte man Kaffernbüffel, Elefant, Löwe, Leopard und Nashorn – die „Big Five“ – gesehen haben."
                                            },
                                            {
                                                "example_id": "efe39422-942b-477d-9181-df2c57556a43",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "„Er, Robert Wilson, hatte auf Safari immer eine Zweierpritsche dabei, man konnte ja nie wissen, was sich so ergab.“"
                                            },
                                            {
                                                "example_id": "6cf1a4a6-91da-48ac-93b0-bba820eedb43",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "„Nach ihrer ersten Safari war sie wie berauscht.“"
                                            },
                                            {
                                                "example_id": "4ab459b5-3b8f-4a11-afb0-0e33751a0249",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "„Er hat sich auf seiner Safari zum großen Afrikakenner und Helden entwickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b3c77c3-641c-4121-a358-6ec10cd400ce",
                        "source_entry_id": "8a1e08b2-9dee-3657-bd35-9214efc436d1",
                        "source_sense_id": "c1d2cd29-5258-38ed-92ae-aa1d9504a80b",
                        "source_sense_description": "expeditie in de wildgebieden in Afrika",
                        "target_lang_word": "safari",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "safari",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b786bc09-bc91-39c4-8076-306daa1255f0",
                                        "entry_id": "bcfb7cf8-1a0b-3977-b02d-3a09c4764b8f",
                                        "glosses": [
                                            "A trip into any undeveloped area to see, photograph or to hunt wild animals in their own environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3924d7cf-6a28-408f-b896-35d5099f4480",
                                                "sense_id": "b786bc09-bc91-39c4-8076-306daa1255f0",
                                                "text": "We're going on a safari in Kenya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1905258f-95b1-3245-8168-51d7bc5ee088",
                                        "entry_id": "bcfb7cf8-1a0b-3977-b02d-3a09c4764b8f",
                                        "glosses": [
                                            "A caravan going on a safari."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2960f7e-ea6d-333f-9e1f-4bfb337efc28",
                                        "entry_id": "bcfb7cf8-1a0b-3977-b02d-3a09c4764b8f",
                                        "glosses": [
                                            "Any trip for the purpose of discovering something new or acquiring prizes or trophies."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1888f2f5-8f01-4ce4-93c9-9a23b2a486bc",
                                                "sense_id": "a2960f7e-ea6d-333f-9e1f-4bfb337efc28",
                                                "text": "An ardent junker herself, Mrs. Egge tells how to conduct a fascinating junk safari into the attic or antique and secondhand shops and what to do with the trophies you bring home."
                                            },
                                            {
                                                "example_id": "e13555a9-699a-4553-a2ba-b8e63b1b1e60",
                                                "sense_id": "a2960f7e-ea6d-333f-9e1f-4bfb337efc28",
                                                "text": "Come on, boy, move that body/ 'Cause tonight I'm naughty, naughty/ Dance with me like it's my party/ We go wild, we're in safari"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "safari",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23530200-96ae-38b0-9238-d622ba33a8eb",
                                        "entry_id": "50c614bb-d740-3cd6-b187-ea8d315af76c",
                                        "glosses": [
                                            "To take part in a safari."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c15ff499-2262-4aa2-b5b9-ade5f56c01cd",
                        "source_entry_id": "8a1e08b2-9dee-3657-bd35-9214efc436d1",
                        "source_sense_id": "c1d2cd29-5258-38ed-92ae-aa1d9504a80b",
