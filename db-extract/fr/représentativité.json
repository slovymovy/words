                        "examples": [
                            {
                                "example_id": "f2fe5b9f-ba58-45d7-8041-31e8851895b0",
                                "sense_id": "a30880ec-d988-39eb-8e20-e576ea283697",
                                "text": "La représentativité de cet échantillon statistique n’est pas établie."
                            },
                            {
                                "example_id": "93d0be71-0449-4b21-be11-2603e062882c",
                                "sense_id": "a30880ec-d988-39eb-8e20-e576ea283697",
                                "text": "La réforme de la représentativité syndicale est au cœur des changements qui ont affecté les relations professionnelles et le syndicalisme « à la française » depuis les années 2000."
                            }
                        ]
                    }
                ],
