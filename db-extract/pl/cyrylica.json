                                        "sense_id": "8488d555-6e7f-3abe-82b0-c66741ea761d",
                                        "entry_id": "92324c2b-d649-333a-9271-bf6bfc3b00b8",
                                        "glosses": [
                                            "The Cyrillic alphabet or writing system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c63682c-20d0-4067-8272-697a3035c62b",
                                                "sense_id": "8488d555-6e7f-3abe-82b0-c66741ea761d",
                                                "text": "Russian is typically written in Cyrillic."
                                            },
                                            {
                                                "example_id": "ec3002e5-0fae-46f6-839e-71a742a404d0",
                                                "sense_id": "8488d555-6e7f-3abe-82b0-c66741ea761d",
                                                "text": "Hidden behind a Cyrillic veil of mystery, it’s one of the harder languages to master, so much so that even many Russians speak it incorrectly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f96a84e-4fd9-49ce-9fba-800950bd50a4",
