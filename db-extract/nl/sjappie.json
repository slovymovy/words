                                ]
                            },
                            {
                                "target_word": "loafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                        "entry_id": "463ddf5d-0061-3b56-9183-a77c4aa334d7",
                                        "glosses": [
                                            "A wolf, especially a grey or timber wolf."
                                        ],
                                        "tags": [
                                            "Southwestern",
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f347d86b-6dc2-41b9-91ac-0ba500f1f020",
                                                "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                                "text": "The great menace to livestock, other than the continual battle with cold, [...] was the gray wolf. [...] The big loafers came in from everywhere."
                                            },
                                            {
                                                "example_id": "f9b82da8-9827-4f03-b0d3-2b8bfeeacac4",
                                                "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                                "text": "Cowboys had killed “loafers” at five hundred yards away with rifles. [...] Lucille was not like most cowhands and she sets out to capture the \"loafer\" with her lariat."
                                            },
                                            {
                                                "example_id": "c8d33e5c-1970-4bdb-865e-7c1815f5b058",
                                                "sense_id": "aef0e548-f52c-3f74-926e-a92c968086d0",
                                                "text": "By the 1890s loafers had become such a problem that some newly organized counties, as well as certain cattle outfits, paid bounties for their scalps. For a cowboy making a dollar or so a day, wolf-hunting could be lucrative."
                                            }
                                        ]
                                    }
                                ]
                            }
