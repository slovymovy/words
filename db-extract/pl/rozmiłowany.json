                "senses": [
                    {
                        "sense_id": "65be90a9-5537-3267-bb78-e4f59b3bef39",
                        "entry_id": "442ac85a-7b78-3934-a80f-48bba30bff9d",
                        "glosses": [
                            "taki, który wykazuje zamiłowanie do czego, jest zwolennikiem, miłośnikiem czego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "769cf769-c6a5-4b1a-b766-7d048fba6169",
                                "sense_id": "65be90a9-5537-3267-bb78-e4f59b3bef39",
                                "text": "Rozmiłowany od dawna w Tatrach, był jednym z założycieli Towarzystwa Tatrzańskiego, które powstało w Zakopanem w r. 1873 [i członkiem Wydziału aż do śmierci w r. 1883.]"
                            },
                            {
                                "example_id": "0deb7cc5-cd2e-4e74-8629-6eb39b224a63",
                                "sense_id": "65be90a9-5537-3267-bb78-e4f59b3bef39",
                                "text": "Przepędzali większą część dnia na boisku, grając w siatkówkę z kapitanem i innymi przełożonymi, rozmiłowanymi w tym sporcie"
                            },
                            {
                                "example_id": "d28fdfd0-9c8d-477f-9086-0c68d38166f4",
                                "sense_id": "65be90a9-5537-3267-bb78-e4f59b3bef39",
                                "text": "— Żebyś pani wiedziała, z jak dostojnymi osobami będziesz odtąd przestawać, wymienię pani ich tytuły: to jest Andzia,] moja starsza córka, bardzo rozmiłowana w swoim fachu kwiaciarka, prawdziwa artystka w układaniu bukietów, [za które na wystawie ogrodniczej otrzymała medal"
                            },
                            {
                                "example_id": "76f49483-8122-4001-a0ca-659704cefc20",
                                "sense_id": "65be90a9-5537-3267-bb78-e4f59b3bef39",
                                "text": "Rozmiłowany w swojem (sic!) [swoim] powołaniu żołnierskiem (sic!) [żołnierskim], nie chciał się rozstać z mundurem i pałaszem [i dlatego to korzystał ze sposobności, która mu je zatrzymać dozwalała, chociaż w bezczynnem (sic!) [bezczynnym] próżniactwie, jak to mówił nieraz.]"
                            },
                            {
                                "example_id": "41d5ce33-91eb-43fc-9d00-29cfa93417b1",
                                "sense_id": "65be90a9-5537-3267-bb78-e4f59b3bef39",
                                "text": "[Kiedy wówczas każdy, co sięgał po wyższe stopnie, co chciał nabyć znaczenia między swoimi, chętnie puszczał się do Włoch, Francyi (sic!) [Francji][,] i Niemiec, gdzie rad słuchał uczonych wykładów po akademiach, i za towarzystwem sławnych nauką mężów się ubiegał — pan Mikołaj,] rozmiłowany w ziemiańskim żywocie, ani na włos się za granicę nie[ ]wychylił, [raz tylko, jak biograf mówi, wyjechał w księstwo litewskie, i to nie na długo.]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0f38664d-3337-33ce-a3b8-59294e18965c",
                        "entry_id": "442ac85a-7b78-3934-a80f-48bba30bff9d",
                        "glosses": [
                            "taki, który się rozmiłował, rozkochał w kim; rozkochany; też: świadczący o czyimś rozkochaniu"
                        ],
                        "tags": [
                            "dated",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "63f02db3-af65-4168-ae37-fec0311cc2a6",
                                "sense_id": "0f38664d-3337-33ce-a3b8-59294e18965c",
                                "text": "Odsuwając pończoszkę z kolana Pauliny i studiując rozmiłowanymi oczyma zwięzłą i szlachetną strukturę przegubu, ojciec mój mówił: — Jakże pełna uroku i jak szczęśliwa jest forma bytu, którą panie obrały."
                            },
                            {
                                "example_id": "8e12db4f-e87d-4ea4-bc25-81900c3c702e",
                                "sense_id": "0f38664d-3337-33ce-a3b8-59294e18965c",
                                "text": "Mężczyzna uganiający się za kobietami, miłośnik romansów i cudzych żon, rozmiłowany we wszystkich niewiastach[,] nie był zdolny kochać żadnej poważnie i na długo [dłużej]."
                            },
                            {
                                "example_id": "0ba5994a-ef96-4182-ad06-018756cd7e84",
                                "sense_id": "0f38664d-3337-33ce-a3b8-59294e18965c",
                                "text": "Zarumieni się czoło, łzą sperli źrenica, / Wstydliwość drżącą ręką twoje oczy zmruży, / Kiedy spojrzę z lubością nie[ ]tajoną dłużej / Rozmiłowanym okiem w jasne twoje lica."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
