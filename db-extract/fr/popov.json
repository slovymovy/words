                                            {
                                                "example_id": "5af1aa29-bb8f-428e-9c1c-9d1057313442",
                                                "sense_id": "ce74f032-e826-3905-ab45-1d11028c75eb",
                                                "text": "Ivan is yelling curses at his friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857c492e-5ad2-3e67-8ab6-2f4ea75f216e",
                                        "entry_id": "653ac8fb-ebc2-399b-8fec-f209d4e35db3",
                                        "glosses": [
                                            "Russians (collectively, personified)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc9f7f5-f450-4745-a001-22ed3b2fe733",
                                                "sense_id": "857c492e-5ad2-3e67-8ab6-2f4ea75f216e",
                                                "text": "Ivan is planning an attack on our flank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51f780d6-d5f9-33df-bf58-03dcf030fd40",
                                        "entry_id": "653ac8fb-ebc2-399b-8fec-f209d4e35db3",
                                        "glosses": [
                                            "A Soviet."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34c4d8fd-75f8-388e-8190-f9e8b2a8bce9",
                                        "entry_id": "653ac8fb-ebc2-399b-8fec-f209d4e35db3",
                                        "glosses": [
                                            "Soviets (collectively, personified)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6b37916-82aa-4bb8-8086-5f7938bd8a0a",
                                                "sense_id": "34c4d8fd-75f8-388e-8190-f9e8b2a8bce9",
                                                "text": "I’m sure whoever was in charge must have been one of the last of the Fulda Fucktards, you know, those generals who spent their nard-drop years training to defend West Germany from Ivan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c19e72-f183-3aba-8b1c-c78705934b7f",
                                        "entry_id": "653ac8fb-ebc2-399b-8fec-f209d4e35db3",
                                        "glosses": [
                                            "An online troll who promotes views supportive of Russian nationalism or the 2022 invasion of Ukraine; a vatnik."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47366bc-7e12-48cf-80f3-f82d9021a280",
                                                "sense_id": "b2c19e72-f183-3aba-8b1c-c78705934b7f",
                                                "text": "Ivan, stop repeating Kremlin propaganda."
                                            }
                                        ]
                                    }
                                ]
                            },
