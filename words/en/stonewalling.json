{
    "word_family": [
        "stonewall",
        "stonewaller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c6f53d5-d970-3afd-96ef-2fa67304752a",
                    "sense_definition": "present participle of <w>stonewall</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minister was accused of <w>stonewalling</w> when reporters questioned him about the budget.",
                            "target_lang_translations": {
                                "nl": "De minister werd ervan beschuldigd <w>de boot af te houden</w> toen verslaggevers hem ondervroegen over de begroting."
                            }
                        },
                        {
                            "text": "She grew frustrated after spending weeks dealing with officials who were actively <w>stonewalling</w> her inquiries.",
                            "target_lang_translations": {
                                "nl": "Ze raakte gefrustreerd nadat ze wekenlang te maken had met ambtenaren die haar vragen actief <w>tegenwerkten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstructing",
                        "filibustering"
                    ],
                    "antonyms": [
                        "cooperating"
                    ],
                    "target_lang_definitions": {
                        "nl": "tegenwerken, dwarsbomen of weigeren informatie te geven (onvoltooid deelwoord)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tegenwerken",
                                "target_lang_sense_clarification": "obstructie plegen"
                            },
                            {
                                "target_lang_word": "dwarsbomen",
                                "target_lang_sense_clarification": "hinderen of belemmeren"
                            },
                            {
                                "target_lang_word": "de boot afhouden",
                                "target_lang_sense_clarification": "ontwijken of uitstellen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "951f2fb6-299e-31c2-95db-3db6da3739e7",
                    "sense_definition": "The act of refusing to cooperate, communicate, or provide information.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee faced constant <w>stonewalling</w> from the company throughout the investigation.",
                            "target_lang_translations": {
                                "nl": "De commissie stuitte gedurende het hele onderzoek op voortdurende <w>obstructie</w> van het bedrijf."
                            }
                        },
                        {
                            "text": "Such persistent <w>stonewalling</w> makes it impossible for both sides to negotiate a fair agreement.",
                            "target_lang_translations": {
                                "nl": "Dergelijke aanhoudende <w>tegenwerking</w> maakt het voor beide partijen onmogelijk om over een eerlijke overeenkomst te onderhandelen."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstruction",
                        "evasion"
                    ],
                    "antonyms": [
                        "cooperation",
                        "transparency"
                    ],
                    "common_phrases": [
                        "deliberate stonewalling",
                        "accused of stonewalling"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling waarbij men weigert mee te werken, te communiceren of informatie te verstrekken; obstructie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "obstructie",
                                "target_lang_sense_clarification": "het moedwillig tegenwerken of vertragen"
                            },
                            {
                                "target_lang_word": "tegenwerking",
                                "target_lang_sense_clarification": "het weigeren mee te werken"
                            },
                            {
                                "target_lang_word": "vertragingsactie",
                                "target_lang_sense_clarification": "het opzettelijk traineren van een proces"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}