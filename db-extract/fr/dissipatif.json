                "senses": [
                    {
                        "sense_id": "bc6f05c5-a165-3efe-9b5c-e4d355e37e80",
                        "entry_id": "38a75460-b586-3d2b-b1f6-ac893a7016f3",
                        "glosses": [
                            "Relatif à la dissipation de l’énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6ded650-5c79-4662-b7f8-3e38e2765776",
                                "sense_id": "bc6f05c5-a165-3efe-9b5c-e4d355e37e80",
                                "text": "Un système dissipatif (ou structure dissipative) est un système qui évolue dans un environnement avec lequel il échange de l'énergie ou de la matière."
                            },
                            {
                                "example_id": "d40f4ced-fa57-4509-972e-7ac381f185d9",
                                "sense_id": "bc6f05c5-a165-3efe-9b5c-e4d355e37e80",
                                "text": "Le freinage dissipatif permet de récupérer une partie de l'énergie du freinage en la dissipant dans une résistance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86c70a35-3056-48bd-aab6-12d94589df7f",
                        "source_entry_id": "38a75460-b586-3d2b-b1f6-ac893a7016f3",
                        "source_sense_id": "bc6f05c5-a165-3efe-9b5c-e4d355e37e80",
                        "target_lang_word": "dissipativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissipativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "272de41a-d61c-3d33-8709-73abd1082854",
                                        "entry_id": "400dfce1-2b60-3097-af37-a51d1e55b20c",
                                        "glosses": [
                                            "zerstreuend"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8533f95-53d0-4bf5-a2b0-3f33b32e1493",
                                                "sense_id": "272de41a-d61c-3d33-8709-73abd1082854",
                                                "text": "„Ein System im physikalischen oder systemtheoretischen Sinne heißt dissipativ, wenn ihm kontinuierlich Energie entzogen wird.“"
                                            },
                                            {
                                                "example_id": "410ce729-6473-4918-bc18-292ff4be7a24",
                                                "sense_id": "272de41a-d61c-3d33-8709-73abd1082854",
                                                "text": "„[Für einen Physiker] ist das Leben ein sich selbst organisierendes, dissipatives Nichtgleichgewichtssystem.“"
                                            },
                                            {
                                                "example_id": "ffa845bb-8743-444d-847f-8570b9e2a7a4",
                                                "sense_id": "272de41a-d61c-3d33-8709-73abd1082854",
                                                "text": "Dissipative Strukturen befinden sich in einem Fließgleichgewicht."
                                            },
                                            {
                                                "example_id": "e7fe5138-a028-424d-a756-4a8525fc63c2",
                                                "sense_id": "272de41a-d61c-3d33-8709-73abd1082854",
                                                "text": "Um eine vollständige Theorie für den Übergang vom Euler- ins Lagrange-Bild zu erhalten, ist es nötig, die Parameter des Modells aus den äußeren Randbedingungen, wie der Kompressibilität, der Dimension der dissipativsten Strukturen und Ähnlichem, festzulegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
