                ],
                "senses": [
                    {
                        "sense_id": "0561ad25-2a84-382c-91ce-9cc8bb1d21b0",
                        "entry_id": "1e814ad2-5c7e-3cc1-9088-a6ecc6df6b1c",
                        "glosses": [
                            "ein Angehöriger eines Bantu-Volkes in Simbabwe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4525c1-e97a-4f93-9d0a-90b4b2814848",
                                "sense_id": "0561ad25-2a84-382c-91ce-9cc8bb1d21b0",
                                "text": "„Im heutigen Simbabwe stellen die Ndebele zwischen einem Sechstel und einem Fünftel der Bevölkerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d10d6c49-58c3-3055-a444-ea8796cb018d",
                        "entry_id": "1e814ad2-5c7e-3cc1-9088-a6ecc6df6b1c",
                        "glosses": [
                            "ein Angehöriger eines Volkes, das im nordwestlichen Südafrika lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06a02e2-ee80-4f16-9531-b5de9cc94a3c",
                                "sense_id": "d10d6c49-58c3-3055-a444-ea8796cb018d",
                                "text": "„Die Ndebele verstehen sich auf Perlenarbeiten sowie Armreifen aus Kupfer und Messing.“"
                            },
                            {
                                "example_id": "ae06ab96-cc52-4df3-aa4c-a6b5367262a8",
                                "sense_id": "d10d6c49-58c3-3055-a444-ea8796cb018d",
                                "text": "„Die Ndebele pflegen auch ihre eigene Musiktradition, einen choralen Gesang, der von Beinrasseln (amahlwayi) und Schlaghölzern (izikeyi) begleitet wird. Viele Ndebele leben jedoch nicht mehr traditionell.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
