                                "target_senses": [
                                    {
                                        "sense_id": "1d992736-ed96-396c-a830-67efaa10f35f",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "A small piece which breaks off from baked food (such as cake, biscuit or bread)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a677fd20-44f2-476c-9ff7-276ffc51a0b7",
                                                "sense_id": "1d992736-ed96-396c-a830-67efaa10f35f",
                                                "text": "desiring to be fed with the crumbs which fell from the rich man's table"
                                            },
                                            {
                                                "example_id": "429e7723-6981-46a0-b9d8-90f501d166ca",
                                                "sense_id": "1d992736-ed96-396c-a830-67efaa10f35f",
                                                "text": "The pigeons were happily pecking at crumbs of bread on the ground."
                                            },
                                            {
                                                "example_id": "e52d3c73-3cd3-489c-bfd8-32d1d276b8a9",
                                                "sense_id": "1d992736-ed96-396c-a830-67efaa10f35f",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5806f372-5d63-3792-be9b-b2e15fd3c158",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "A small piece of any other solid substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c37616-118b-450c-972f-b1e6e4a5d83e",
                                                "sense_id": "5806f372-5d63-3792-be9b-b2e15fd3c158",
                                                "text": "Then erase any pencil lines with a good, soft eraser, rubbing gently, in only one direction. A dustbrush can be useful in removing any eraser crumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0cb24fa-f7ed-3734-a842-16488bef6106",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "A bit, small amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c3b050-1e13-4daf-bfba-b76f36286508",
                                                "sense_id": "b0cb24fa-f7ed-3734-a842-16488bef6106",
                                                "text": "a crumb of comfort"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47308176-ac50-3865-9b84-558f6c6856d2",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "Ellipsis of crumb rubber."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b29203b-69a6-4d3d-98cc-fdeddbd77313",
                                                "sense_id": "47308176-ac50-3865-9b84-558f6c6856d2",
                                                "text": "Production of rubber granules, or crumb, is well-established in this country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b65da8-27bb-3a1f-84a7-920340e7bea2",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "The soft internal portion of bread, surrounded by crust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e61031fe-ebed-403a-9c3a-0bc64faee89a",
                                                "sense_id": "78b65da8-27bb-3a1f-84a7-920340e7bea2",
                                                "text": "Dust unto dust, what must be, must; / If you can't get crumb, you'd best eat crust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7966c00a-4306-3758-bd7e-f7adc27819c6",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "A mixture of sugar, cocoa and milk, used to make industrial chocolate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ccf757e-dcb0-3563-ab16-3a87b46ed613",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "A nobody; a worthless person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c5e50a-d406-48a7-bd08-50c85108e8d3",
                                                "sense_id": "7ccf757e-dcb0-3563-ab16-3a87b46ed613",
                                                "text": "All Dad can think of is a gift certificate from the Melody Inn? And my crumb of a boyfriend doesn't even show up? This is a birthday?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f97f5fb-bce5-33a7-8c9f-6cf00ace5635",
                                        "entry_id": "fa134f60-bdd8-33bf-88b2-d9b864d8b840",
                                        "glosses": [
                                            "A body louse (Pediculus humanus)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
