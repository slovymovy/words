                "senses": [
                    {
                        "sense_id": "39c0c269-d644-3eb7-8bd5-c30665cf6122",
                        "entry_id": "73cf1bff-701f-366a-befd-dd2ac90bb20c",
                        "glosses": [
                            "eine (meist staatliche) finanzielle Entschädigung, die für das Verschrotten eines Gegenstandes (in der Regel eines Fahrzeuges) geleistet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d8b617-96ea-4991-9178-60747679f1cf",
                                "sense_id": "39c0c269-d644-3eb7-8bd5-c30665cf6122",
                                "text": "„Die Abwrackaktion, durch die Schifffahrtstreibende, die ihr Fahrzeug abwracken und aus dem Markt ausscheiden, eine Abwrackprämie erhalten, wurde […] durch eine Änderung des BSCHVG geschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "676828a9-70e5-33d0-8111-1974ecdb90df",
                        "entry_id": "73cf1bff-701f-366a-befd-dd2ac90bb20c",
                        "glosses": [
                            "eine 2009 verfügbare staatliche Prämie („Umweltprämie“), die unter bestimmten Bedingungen für das Verschrotten eines Kraftfahrzeugs gezahlt wurde"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "8246abeb-7ec9-482d-911e-520303fa9c92",
                                "sense_id": "676828a9-70e5-33d0-8111-1974ecdb90df",
                                "text": "„Mit der Abwrackprämie wollte die Bundesregierung der Autoindustrie zu Hilfe eilen, indem sie die Nachfrage der Bürger nach neuen Fahrzeugen stimuliert.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
