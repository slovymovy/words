                    {
                        "translation_id": "8c7e5b8a-01d0-45f0-9333-ba3aa356175e",
                        "source_entry_id": "46cd002d-dc71-315e-b1e7-521409f9f1bb",
                        "source_sense_id": "068066c6-6b1b-3de4-9cb8-18edb614dd04",
                        "source_sense_description": "Angehöriger eines germanischen Sammelvolkes, das sich vor allem aus Sachsen und Angeln zusammensetzte",
                        "target_lang_word": "англосакс",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "англосакс",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17a77e5e-fdde-3286-8dbf-0721696426ba",
                                        "entry_id": "45d83479-bd2d-3b2f-b6fc-1a1c55e25be8",
                                        "glosses": [
                                            "истор. представитель одного из древних германских народов (англов, саксов и ютов), заселивших Англию в V веке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0828c595-2eda-4a4c-b009-3029d8313e55",
                                                "sense_id": "17a77e5e-fdde-3286-8dbf-0721696426ba",
                                                "text": "Существовал, например, свод добродетелей древнегерманского мира, включавшего норманнов (скандинавов) и англосаксов, характерный для «героического» общества вообще."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a8af8ab-4e10-3c31-8aed-83ee1acddfe0",
                                        "entry_id": "45d83479-bd2d-3b2f-b6fc-1a1c55e25be8",
                                        "glosses": [
                                            "представитель народа, составляющего основное население Англии, и основное население либо его элиту во многих бывших британских владениях || полит. жарг. эти страны, традиционный идеологический противник СССР и России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96be3f8e-bd6b-45ab-a399-ddade850e40a",
                                                "sense_id": "8a8af8ab-4e10-3c31-8aed-83ee1acddfe0",
                                                "text": "Да на самом деле расселение индоевропейцев, начавшееся семь тысяч лет назад, продолжается и в новейшее время: русские заняли Сибирь, англосаксы ― Северную Америку."
                                            },
                                            {
                                                "example_id": "80354d21-3762-4ba8-b49b-79aab235330b",
                                                "sense_id": "8a8af8ab-4e10-3c31-8aed-83ee1acddfe0",
                                                "text": "Поэтому когда я говорю о некоторой сдержанности канадцев, то имею в виду, конечно, англосаксов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
