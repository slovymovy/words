                "senses": [
                    {
                        "sense_id": "09112d8b-a760-31a3-b8bc-868358ef9735",
                        "entry_id": "c9795835-2370-323b-b6b1-38b381e3946f",
                        "glosses": [
                            "nazwa czegoś zbyt słonego, przesolonego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "987d1b94-d179-44a4-ac34-4c66e19fec1f",
                                "sense_id": "09112d8b-a760-31a3-b8bc-868358ef9735",
                                "text": "Moja zupa jarzynowa jest zasolona. Chyba wsypałeś tam miskę soli"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d5026e5-85a0-416d-a9d5-8011e2d14ba3",
                        "source_entry_id": "c9795835-2370-323b-b6b1-38b381e3946f",
                        "source_sense_id": "09112d8b-a760-31a3-b8bc-868358ef9735",
                        "target_lang_word": "salzhaltig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salzhaltig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8360804-8984-3d70-953e-74fa3969a253",
                                        "entry_id": "b75d27f1-b4ec-3845-9d16-d004c520bc03",
                                        "glosses": [
                                            "Salz enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df784b76-c84e-4bff-bacb-670cb4e38532",
                                                "sense_id": "b8360804-8984-3d70-953e-74fa3969a253",
                                                "text": "Gewöhnliche Fische und Mollusken können in stark salzhaltigen Gewässern nicht leben."
                                            },
                                            {
                                                "example_id": "070759bb-b4ab-4808-af43-bdc004537707",
                                                "sense_id": "b8360804-8984-3d70-953e-74fa3969a253",
                                                "text": "„Von den Wasservorräten der Welt sind etwa 97 Prozent salzhaltig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84478475-1049-4d5e-95b3-fa43e3341b2b",
                        "source_entry_id": "c9795835-2370-323b-b6b1-38b381e3946f",
                        "source_sense_id": "09112d8b-a760-31a3-b8bc-868358ef9735",
                        "target_lang_word": "gesalzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gesalzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "110a140f-b8b0-30ad-8baa-98079a48eb79",
                                        "entry_id": "7ba12102-a08b-32fe-9eda-d250df935554",
                                        "glosses": [
                                            "mit Salz versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52fb39e2-8cc2-4b97-a422-d449284813a7",
                                                "sense_id": "110a140f-b8b0-30ad-8baa-98079a48eb79",
                                                "text": "Ich esse gerne gesalzene Erdnüsse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce5ff2b2-eaf5-3383-97b0-1e944138ef07",
                                        "entry_id": "7ba12102-a08b-32fe-9eda-d250df935554",
                                        "glosses": [
                                            "hoch, schwer erschwinglich"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bdd1bf8-4921-4fed-9a27-dcaea4ce01df",
                                                "sense_id": "ce5ff2b2-eaf5-3383-97b0-1e944138ef07",
                                                "text": "Diese gesalzenen Eintrittspreise kann sich nicht jeder leisten. ( Audio⁽ᴵⁿᶠᵒ⁾)"
                                            },
                                            {
                                                "example_id": "9c42e518-791f-43ec-b0a5-6eb6a87caca0",
                                                "sense_id": "ce5ff2b2-eaf5-3383-97b0-1e944138ef07",
                                                "text": "„In dem Laden hier haben sie aber gesalzene Preise.“"
                                            },
                                            {
                                                "example_id": "c801209c-3689-45d2-a27e-bcef45ffe270",
                                                "sense_id": "ce5ff2b2-eaf5-3383-97b0-1e944138ef07",
                                                "text": "„Die Miete für die Räume war gesalzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bb253386-1077-33a7-a89c-a08f4426645d",
                                        "entry_id": "7ba12102-a08b-32fe-9eda-d250df935554",
                                        "glosses": [
                                            "in derbem, scharfem Ton"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b299f153-04c3-4f91-8861-bb0c8501e829",
                                                "sense_id": "bb253386-1077-33a7-a89c-a08f4426645d",
                                                "text": "„Sie würde Willow und Betty finden und ihnen die gesalzenste Strafpredigt ihres Lebens verpassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
