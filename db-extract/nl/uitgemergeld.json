                        "source_sense_id": "28d5eff3-2ca8-32eb-9459-a17b10b9687e",
                        "target_lang_word": "emaciated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emaciated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72617f67-22a0-3c58-9585-daad769f71cb",
                                        "entry_id": "d0081acc-670a-33ea-92ca-f649801b4f23",
                                        "glosses": [
                                            "Thin or haggard, especially from hunger or disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f18df195-8d80-4e1c-8ecc-30118dd2895d",
                                                "sense_id": "72617f67-22a0-3c58-9585-daad769f71cb",
                                                "text": "The emaciated prisoners in the death camps were weak and sickly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "emaciated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00f2fa57-b95a-3295-8f97-bbfc531b69d4",
                                        "entry_id": "30f42faf-c1b6-384a-9fd5-7891ff4d067e",
