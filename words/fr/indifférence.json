                        "accueillir avec indifférence"
                    ]
                },
                {
                    "sense_id": "f3ecc90c-9242-30da-86c8-5bfd795ef872",
                    "sense_definition": "Manque total d'intérêt, d'attention ou de préoccupation pour une chose, une question ou une cause.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jeunes citoyens ont accueilli les résultats du vote avec une profonde <w>indifférence</w>."
                        },
                        {
                            "text": "Le projet de réforme a été rejeté dans l'<w>indifférence</w> la plus totale de la population."
