                                "target_senses": [
                                    {
                                        "sense_id": "557cc6aa-1cfe-379a-b740-be6f08252fe4",
                                        "entry_id": "3e7269cb-45dc-30ac-b1ae-a14fc3066398",
                                        "glosses": [
                                            "Someone who has immigrated into a country by bypassing customs and immigration controls."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f9077f4-0115-4805-9c47-4c4f821b7fb6",
                                                "sense_id": "557cc6aa-1cfe-379a-b740-be6f08252fe4",
                                                "text": "The undergraduate student government at the University of California-Los Angeles (UCLA) unanimously passed a resolution Tuesday calling for the end of the use of the phrase “illegal immigrant,” saying it violates human rights guaranteed by the U.S. Constitution. / “The racially derogatory I-word endangers basic human rights including the presumption of innocence and the right to due process guaranteed under the U.S. Constitution,” the resolution states. / The resolution came in response to undocumented students who had “expressed their concerns and fear with the recent appointment of Janet Napolitano, former US Secretary of Homeland Security,” as the new University of California president."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c3fe9d0-f24a-4395-bc2a-1f308c70e891",
                        "source_entry_id": "08d8b3dc-f8f7-3d2f-807d-9b36d5d30cf7",
                        "source_sense_id": "142ab1bb-897b-3e57-b017-ff41b9b12759",
                        "target_lang_word": "undocumented immigrant",
