                        "examples": [
                            {
                                "example_id": "9a2cde6c-35f3-4dd7-a89e-de65f5f2ff06",
                                "sense_id": "d28fa63b-41b1-3db3-9b00-d872b213f245",
                                "text": "Selon la loi Doubin, le franchiseur est tenu de garantir contractuellement un engagement d’exclusivité ou de quasi-exclusivité à son franchisé."
                            },
                            {
                                "example_id": "0ecf8b4a-0d7c-4373-a600-93a5e555f217",
                                "sense_id": "d28fa63b-41b1-3db3-9b00-d872b213f245",
                                "text": "Tout dépend de l’enseigne sous laquelle l’indépendante décide de s’installer mais dans tous les cas « il faut impérativement bien lire le contrat que la franchiseuse ou le franchiseur propose."
                            }
                        ]
