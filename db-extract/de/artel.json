                "senses": [
                    {
                        "sense_id": "a512bb60-45d1-3e5e-98a6-3bf836ae8f88",
                        "entry_id": "e6027acc-51de-3daf-8757-ac8eee3835b4",
                        "glosses": [
                            "freiwilliger Zusammenschluss von Arbeitern im zaristischen Russland"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "98762dbe-a1db-471f-89ad-b3ffd72babd5",
                                "sense_id": "a512bb60-45d1-3e5e-98a6-3bf836ae8f88",
                                "text": "„Auch die Ausbildung fand innerhalb des Artels statt: Der Schüler erlernte so nur die Arbeiten, die in seinem Artel benötigt wurden, blieb also den Traditionen stark verhaftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa69d60d-ec6b-3367-871d-a4e0369f85d8",
                        "entry_id": "e6027acc-51de-3daf-8757-ac8eee3835b4",
                        "glosses": [
                            "einfache Form der landwirtschaftlichen Kollektivwirtschaft in der Sowjetunion"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fbccc038-d318-43e5-b0bd-cef727535b2d",
                                "sense_id": "aa69d60d-ec6b-3367-871d-a4e0369f85d8",
                                "text": "„Drei Arten von Kollektivbetrieben hatten die Bolschewisten vorgesehen: Toz, Artel und Kommune.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e869bac-8729-47e4-8843-7e6660f9ed0f",
                        "source_entry_id": "e6027acc-51de-3daf-8757-ac8eee3835b4",
                        "source_sense_id": "a512bb60-45d1-3e5e-98a6-3bf836ae8f88",
                        "source_sense_description": "freiwilliger Zusammenschluss von Arbeitern im zaristischen Russland",
                        "target_lang_word": "artel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edad2f3c-7b3b-3e76-98b1-3774f14bb6ee",
                                        "entry_id": "e8cf480f-f073-3de3-970e-43d51a26d19d",
                                        "glosses": [
                                            "A Russian or Soviet craftsmen's collective."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f35005-a09e-43f7-a247-b2602784511e",
                                                "sense_id": "edad2f3c-7b3b-3e76-98b1-3774f14bb6ee",
                                                "text": "This essentially urban lifestyle, modelled on the factory artel, did much to alienate the local peasantry […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca344f08-098f-4cfd-8fad-6f1b72da2cab",
                        "source_entry_id": "e6027acc-51de-3daf-8757-ac8eee3835b4",
                        "source_sense_id": "a512bb60-45d1-3e5e-98a6-3bf836ae8f88",
                        "source_sense_description": "freiwilliger Zusammenschluss von Arbeitern im zaristischen Russland",
                        "target_lang_word": "артель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "артель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "06f9fc68-05b6-3059-a305-db2aa10519f9",
                                        "entry_id": "b19af6d6-941e-36e2-bf13-8b630b6949ed",
                                        "glosses": [
                                            "собир. добровольное, обычно временное, объединение физических лиц для совместной работы на основе общей ответственности, самоуправления и долевого участия в доходах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c42cca8a-825b-48a5-a51e-484d150c5fda",
                                                "sense_id": "06f9fc68-05b6-3059-a305-db2aa10519f9",
                                                "text": "Солеломное орудие состоит только из искривленной с широким лезвием пешни, где при конце дратовища делается костыль, дабы способнее было налягать грудью. Работу свою всегда отправляют артелями: ибо одному отворачивать глыбы невмочь."
                                            },
                                            {
                                                "example_id": "9ca7fd8e-b1b8-42c5-a064-ad86d83e1635",
                                                "sense_id": "06f9fc68-05b6-3059-a305-db2aa10519f9",
                                                "text": "Однажды, впрочем, ещё найден был лежащий за околицей, в канаве, у моста, видно, отставший от проходившей в город артели человек."
                                            },
                                            {
                                                "example_id": "61bc098a-69fe-47ae-a606-0c104738ac80",
                                                "sense_id": "06f9fc68-05b6-3059-a305-db2aa10519f9",
                                                "text": "Шутка ли: уезжает в глухую даль ― кто знает, на сколько времени, на какие дела и тревоги и опасности ― целая артель ответственных работников."
                                            },
                                            {
                                                "example_id": "3c87ffe9-e0ce-47e2-8f12-571e1bcb8233",
                                                "sense_id": "06f9fc68-05b6-3059-a305-db2aa10519f9",
                                                "text": "Несмотря на резкое ухудшение погоды, к выборочному севу приступила сельскохозяйственная артель «Победа», Корсаковского района. Колхоз обслуживает тракторная бригада Корсаковской машинно-тракторной станции."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a93456-1dc6-3682-9921-8cf8d765f18d",
                                        "entry_id": "b19af6d6-941e-36e2-bf13-8b630b6949ed",
                                        "glosses": [
                                            "разг., перен., собир. группа собравшихся или идущих вместе людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dde07399-e1a2-4c72-bba0-bff1d6ecfde5",
                                                "sense_id": "02a93456-1dc6-3682-9921-8cf8d765f18d",
                                                "text": "— Как же артель-то бросаешь? — Анна смотрела на свое отражение в воде и терла красные озябшие руки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
