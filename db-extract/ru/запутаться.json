                        "tags": [
                            "в чём"
                        ],
                        "examples": [
                            {
                                "example_id": "249d7551-d2d7-4ef1-ab39-1a49b54a31e5",
                                "sense_id": "3c21dbe7-c557-37b3-823c-a6a99b61a5e5",
                                "text": "Запутаться в долгах."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f6d8a0e-f764-3c3a-b40a-a45f1cf35456",
                        "entry_id": "a0eaa8cc-cb64-3588-970f-77e5746ab5da",
                        "glosses": [
                            "перен., разг., прийти в запутанное состояние, стать запутанным"
