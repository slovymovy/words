                        ],
                        "form": "płomyki"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa9a9664-ef96-3fbb-bc99-537738fcbe0e",
                        "entry_id": "8b72494c-b24a-3581-b636-94f4a6bc8240",
                        "glosses": [
                            "пламя, огонь, огонек, язычок , (цитата из польской Викитеки Lalka (Prus)/Tom I/I)\\nЗвук примера:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6075e27-541e-45fd-9b54-cbc55a9f1c6e",
                                "sense_id": "aa9a9664-ef96-3fbb-bc99-537738fcbe0e",
                                "text": "Dla osób, posilających się w tej co radca jadłodajni, dla jej właściciela, subjektów i chłopców, przyczyny klęsk mających paść na S. Wokulskiego i jego sklep galanteryjny były tak jasne, jak gazowe płomyki oświetlające zakład.",
                                "translation": "Завсегдатаям ресторации, где утолял свою жажду советник, ее хозяину и половым причины бедствий, которым предстояло обрушиться на С.Вокульского и его галантерейный магазин, казались ясны, как пламя газовых рожков, освещавших зал."
                            }
                        ]
                    },
                    {
                        "sense_id": "d64a050b-b650-3ab5-9d35-cbfa51337317",
                        "entry_id": "8b72494c-b24a-3581-b636-94f4a6bc8240",
                        "glosses": [
                            "перен. искорка (определение ощущения, только появившегося чувства)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08709cd7-8edd-4c28-abc9-87883c941279",
                                "sense_id": "d64a050b-b650-3ab5-9d35-cbfa51337317",
                                "text": "Spoglądał wokoło jasnymi, uciszonymi oczyma. Pilnował w sercu płomyka cichego szczęścia. Już nie zbliżyła się w tych figurach.",
                                "translation": "Он смотрел вокруг светлыми примиренными глазами. Он поддерживал в сердце искорку тихого счастья. Она уже не приблизилась к нему в следующих фигурах танца."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c909cbd-cffd-33a9-9d23-d9d239effc58",
                        "entry_id": "8b72494c-b24a-3581-b636-94f4a6bc8240",
                        "glosses": [
                            "ботан. флокс (растение)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
