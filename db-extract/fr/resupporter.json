                "senses": [
                    {
                        "sense_id": "bb15c0ea-3b63-391b-b136-1cf95b6d82c7",
                        "entry_id": "be526866-a9d4-33fa-95b0-b47b9a37e7f6",
                        "glosses": [
                            "Supporter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9219adf4-4308-4409-9884-c10790845e45",
                                "sense_id": "bb15c0ea-3b63-391b-b136-1cf95b6d82c7",
                                "text": "Suis-je arrivé à la situation voulue pour resupporter... un échec honorable."
                            },
                            {
                                "example_id": "40560c8f-3d81-44ea-a5b0-103f5dc2d075",
                                "sense_id": "bb15c0ea-3b63-391b-b136-1cf95b6d82c7",
                                "text": "Il m'est souvent arrivé dans le commencement de ma pratique, de laisser trois ou quatre jours l'appareil sans le déranger, et toujours il me fallait suspendre quelques jours les machines, beaucoup de souffrance de la part du patient, de peine et de temps pour rendre la souplesse et le mouvement aux parties et les mettre en état de pouvoir resupporter les fers."
                            }
                        ]
                    }
