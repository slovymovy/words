                        "entry_id": "4c220f2f-4a15-3da1-b10f-228587ff2096",
                        "glosses": [
                            "beweging van het verzet, de gezamenlijke mensen die zich verzetten tegen een overheerser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfcfd5fd-f2dc-4aff-8569-cd4a5ba98376",
                                "sense_id": "52c7c390-8f2a-34bd-98d5-d7dac9878c5d",
                                "text": "Een rol in de verzetsbeweging."
                            },
                            {
                                "example_id": "a756e9f9-8e76-413c-bd17-760d9708af50",
                                "sense_id": "52c7c390-8f2a-34bd-98d5-d7dac9878c5d",
                                "text": "'Maar vind je de weg, ik bedoel, iemand moet je toch opvangen en helpen?' Hij verzekerde haar dat dat ook geen probleem was, hij kende het gebied en de leider van de lokale verzetsbeweging, Julien Sorel, was zijn oom en alles zou gesmeerd gaan."
                            },
                            {
                                "example_id": "4d7906d9-1557-48a4-9a11-e772d0c905f2",
                                "sense_id": "52c7c390-8f2a-34bd-98d5-d7dac9878c5d",
                                "text": "In plaats daarvan hadden ze zich aangesloten bij La Résistance, de Franse verzetsbeweging."
                            }
                        ]
                    }
