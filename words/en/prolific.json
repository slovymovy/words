{
    "word_family": [
        "prolifically",
        "prolificness",
        "prolificity",
        "proliferate",
        "proliferation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0969ca59-1ae5-3316-94d8-bc1145a9b8ff",
                    "sense_definition": "Producing a large amount of something, such as creative works, results, or goals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "productive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prolific</w> author published three different novels in a single year.",
                            "target_lang_translations": {
                                "ru": "<w>Плодовитый</w> автор опубликовал три разных романа за один год."
                            }
                        },
                        {
                            "text": "He is known as a <w>prolific</w> songwriter who has written hundreds of hits for various artists.",
                            "target_lang_translations": {
                                "ru": "Он известен как <w>продуктивный</w> автор песен, написавший сотни хитов для различных исполнителей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prolific author",
                        "prolific songwriter",
                        "prolific goalscorer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создающий большое количество чего-либо, например, творческих работ, результатов или голов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодовитый",
                                "target_lang_sense_clarification": "о творчестве или результатах"
                            },
                            {
                                "target_lang_word": "продуктивный",
                                "target_lang_sense_clarification": "эффективный и много производящий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8f925ed-b01d-30eb-9716-2249e134b15a",
                    "sense_definition": "Producing many offspring, much fruit, or abundant vegetation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological_fertility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rabbits are famous for being <w>prolific</w> breeders, often having several litters a year.",
                            "target_lang_translations": {
                                "ru": "Кролики славятся тем, что они очень <w>плодовиты</w> и часто приносят по несколько пометов в год."
                            }
                        },
                        {
                            "text": "The <w>prolific</w> fruit trees in the orchard provided more apples than the village could eat.",
                            "target_lang_translations": {
                                "ru": "<w>Плодоносные</w> фруктовые деревья в саду давали больше яблок, чем могла съесть вся деревня."
                            }
                        }
                    ],
                    "synonyms": [
                        "fertile",
                        "fecund"
                    ],
                    "antonyms": [
                        "barren",
                        "sterile"
                    ],
                    "common_phrases": [
                        "prolific breeder",
                        "prolific species"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производящий многочисленное потомство, много плодов или обильную растительность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодовитый",
                                "target_lang_sense_clarification": "о потомстве"
                            },
                            {
                                "target_lang_word": "плодоносный",
                                "target_lang_sense_clarification": "о растениях"
                            },
                            {
                                "target_lang_word": "урожайный",
                                "target_lang_sense_clarification": "дающий богатый урожай"
                            },
                            {
                                "target_lang_word": "обильный",
                                "target_lang_sense_clarification": "существующий в большом количестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4969917-17e2-3519-8767-16c4542b5d63",
                    "sense_definition": "Describing a flower from which another flower is produced.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanical_anomaly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist identified a <w>prolific</w> flower where a secondary bloom emerged from the center.",
                            "target_lang_translations": {
                                "ru": "Ботаник идентифицировал <w>пролиферирующий</w> цветок, у которого из центра появился вторичный бутон."
                            }
                        },
                        {
                            "text": "In certain rose varieties, a <w>prolific</w> growth pattern can cause a new bud to form inside an existing blossom.",
                            "target_lang_translations": {
                                "ru": "У некоторых сортов роз <w>пролиферирующий</w> тип роста может привести к образованию нового бутона внутри уже существующего цветка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical botanical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает цветок, из которого вырастает другой цветок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролиферирующий",
                                "target_lang_sense_clarification": "ботанический термин для разрастания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}