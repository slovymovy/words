                    {
                        "translation_id": "8d8fb5e6-d861-4621-90d8-6e420040e4cf",
                        "source_entry_id": "463a7a7f-ec2d-33dd-895f-853a6987bc1b",
                        "target_lang_word": "Sarazene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sarazene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6997e8a-3db6-3d8d-9408-ec3bf25f201b",
                                        "entry_id": "b9b2decf-533b-36fa-ab08-d9a95ee78005",
                                        "glosses": [
                                            "Araber, Muslim zur Zeit der Kreuzzüge"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b466f6-fe07-4573-bea7-065665a118fc",
                                                "sense_id": "b6997e8a-3db6-3d8d-9408-ec3bf25f201b",
                                                "text": "Die Panzerreiter waren fast ein Jahrtausend lang ein militärisches Erfolgsmodell gegen Normannen, Sarazenen oder Ungarn und ihre Rüstung ein herausragender Beweis für die technologische Innovationsfähigkeit des Mittelalters."
                                            },
                                            {
                                                "example_id": "f14c4810-b0a9-4636-8ef7-0d8366db3d03",
                                                "sense_id": "b6997e8a-3db6-3d8d-9408-ec3bf25f201b",
                                                "text": "Politisch war sie lange heiß umkämpft: Von den Griechen über die Phönizier, Römer und Sarazenen bis zu den Aragoniern waren alle versessen darauf, Lampedusa in ihren Besitz zu bringen, um von dort aus Afrika zu erobern."
                                            },
                                            {
                                                "example_id": "cece3a4d-2f85-4aee-84e5-7d59662cacb9",
                                                "sense_id": "b6997e8a-3db6-3d8d-9408-ec3bf25f201b",
                                                "text": "Seid Ihr denn ein Jude oder Sarazene, der sich um den Freitag nicht kümmert?"
                                            },
                                            {
                                                "example_id": "d72466c1-3b12-4b13-ace5-307bc7745c0d",
                                                "sense_id": "b6997e8a-3db6-3d8d-9408-ec3bf25f201b",
                                                "text": "Die Ritter traten zurück an den Turm, Bruder Arnfried, der Sarazene, stieg ab und schloß den Alten in seine Arme."
                                            },
                                            {
                                                "example_id": "7ee0f81e-d6da-49c3-9a9c-bab6c72912f8",
                                                "sense_id": "b6997e8a-3db6-3d8d-9408-ec3bf25f201b",
                                                "text": "Dort fiel die Blüte von Belisars Leibwächtern: darunter viele meiner nächsten Waffenfreunde, Alamundarus der Sarazene, Artasines der Perser, Zanter der Armenier, Longinus der Isaurier, […]."
                                            },
                                            {
                                                "example_id": "de071dfc-b278-4b65-b0d5-cfb119c0cd05",
                                                "sense_id": "b6997e8a-3db6-3d8d-9408-ec3bf25f201b",
                                                "text": "„Fränkische Quellen berichten sogar, der unterlegene und von dem Karolinger gedemütigte Herzog habe selbst die Sarazenen um Waffenhilfe gegen die Franken gebeten, aber das ist wohl eher eine verleumderische Verdrehung der Tatsachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5994c7ef-5a60-470d-ab9b-08dee57a0145",
                        "source_entry_id": "463a7a7f-ec2d-33dd-895f-853a6987bc1b",
                        "target_lang_word": "sarrasin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarrasin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67477a4d-b57e-3ab0-9968-1c433b1f1a75",
                                        "entry_id": "f4b5fd38-c1ee-3f62-850e-586372a46258",
                                        "glosses": [
                                            "Relatif aux Sarrasins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445f6d78-b410-4539-b510-ef4b3f40c135",
                                                "sense_id": "67477a4d-b57e-3ab0-9968-1c433b1f1a75",
                                                "text": "Tout l’aspect de ce guerrier, comme celui de sa suite, était sauvage et étrange ; l’habit de ses écuyers était resplendissant, et les serviteurs sarrasins portaient autour de leur cou des colliers d’argent."
                                            },
                                            {
                                                "example_id": "0cdf7f75-8ed0-41db-9377-32f9826a9915",
                                                "sense_id": "67477a4d-b57e-3ab0-9968-1c433b1f1a75",
                                                "text": "Les uns prétendent que l’arc tiers-point existait en Égypte, en Syrie, en Perse ; les autres le considèrent ainsi qu’un dérivé de l’art sarrasin et de l’art arabe ; et rien n’est moins démontré, à coup sûr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "402d4ae9-a8f2-383e-98a3-127352b908ae",
                                        "entry_id": "f4b5fd38-c1ee-3f62-850e-586372a46258",
                                        "glosses": [
                                            "Arabe, oriental, mauresque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f06c79e8-5aac-4d59-81c2-91fd1bc93171",
                                                "sense_id": "402d4ae9-a8f2-383e-98a3-127352b908ae",
                                                "text": "Sur la grève déserte battait, toujours à la même place […], la mer grecque et romaine, la mer ibérique et sarrasine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a39123bf-7993-3617-9fb1-77c5d92a7e99",
                                        "entry_id": "f4b5fd38-c1ee-3f62-850e-586372a46258",
                                        "glosses": [
                                            "Relatif aux Sarrasins, en parlant d’une chose."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3379aef-45d4-41eb-86e7-92c762e905ef",
                                                "sense_id": "a39123bf-7993-3617-9fb1-77c5d92a7e99",
                                                "text": "Herse, tour, colonne, porte, armure sarrasine."
                                            },
                                            {
                                                "example_id": "15c1ac03-540c-44ca-92f1-195277867f76",
                                                "sense_id": "a39123bf-7993-3617-9fb1-77c5d92a7e99",
                                                "text": "N’oublions pas, en passant, le clocher de Salinas, qui a une forme sarrasine assez ragoûtante."
                                            },
                                            {
                                                "example_id": "ebda9973-e2b2-4569-ba41-a4e4cc05f702",
                                                "sense_id": "a39123bf-7993-3617-9fb1-77c5d92a7e99",
                                                "text": "Son père, le voulant réjouir, lui fit cadeau d’une grande épée sarrasine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a289ff8-7fab-354c-b1c3-d0586a2c0d03",
                                        "entry_id": "f4b5fd38-c1ee-3f62-850e-586372a46258",
                                        "glosses": [
                                            "Qui provient des Sarrasins du Moyen Âge ou qui les évoque, en parlant d’une personne, de son aspect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sarrasin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d5fa1a3-1896-3e14-9aa1-fef4a428b72b",
                                        "entry_id": "ca67f30f-58f5-3940-bd26-6dd5d0d9c408",
                                        "glosses": [
                                            "Relatif à Famars, commune du Nord."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sarrasin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbc8c66-f349-3642-951d-f262829eff9e",
                                        "entry_id": "85c82b86-75ba-3ad7-ad90-745e0b9fe44c",
                                        "glosses": [
                                            "Relatif à Saraz, commune du Doubs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sarrasin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed98566-87a7-3e3e-9549-eaf011f3e0fb",
                                        "entry_id": "b94a2d34-be39-307b-8fcb-388f7d11ebbd",
                                        "glosses": [
                                            "Plante herbacée annuelle de la famille des Polygonacées, des régions tempérées à sols pauvres, qui porte de petites graines noires, comestibles et anguleuses, une pseudo-céréale (n’étant pas une graminée)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72388c07-76a7-4919-bd87-44faddc86f6c",
                                                "sense_id": "6ed98566-87a7-3e3e-9549-eaf011f3e0fb",
                                                "text": "On cultive aussi un peu de sarrasin, ou blé noir qui sert au chauffage dans un pays privé de bois, et dont les grains sont donnés en nourriture à la volaille."
                                            },
                                            {
                                                "example_id": "2249f626-eea0-4322-8125-fec6e40b0030",
                                                "sense_id": "6ed98566-87a7-3e3e-9549-eaf011f3e0fb",
                                                "text": "Le sarrasin (Fagopyrum esculentum) est une céréale à croissance rapide qui atteint en 40 jours une hauteur de 1,20 m."
                                            },
                                            {
                                                "example_id": "9a7d0628-ce9b-48ed-bef5-2da7c5e6cddf",
                                                "sense_id": "6ed98566-87a7-3e3e-9549-eaf011f3e0fb",
                                                "text": "En revanche, on en prend, de la graine, et à gogo : lin, chia, chanvre, pavot, sésame, tournesol, courge, sarrasin, fenouil ! Et des baies, d’açaï, de goji ! Et des poudres, guarana, curcuma, thé matcha !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a489e61-5d83-3d00-890a-d93c4ec66d91",
                                        "entry_id": "b94a2d34-be39-307b-8fcb-388f7d11ebbd",
                                        "glosses": [
                                            "Pièce, champ de sarrasin."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bcd7022-333b-4d6e-b42c-5980065343f3",
                                                "sense_id": "0a489e61-5d83-3d00-890a-d93c4ec66d91",
                                                "text": "Un coq faisan marche à grands pas levés au bord d’un sarrasin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a42f1189-c9fb-3c49-9db1-bc1b9a71ab4c",
                                        "entry_id": "b94a2d34-be39-307b-8fcb-388f7d11ebbd",
                                        "glosses": [
                                            "Farine extraite de la graine du sarrasin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a9836f-69c2-429c-9684-1a1e6d329550",
                                                "sense_id": "a42f1189-c9fb-3c49-9db1-bc1b9a71ab4c",
                                                "text": "Oh ! monsieur, nous mangeons des galettes de sarrasin et des bernicles que je détache des rochers."
                                            },
                                            {
                                                "example_id": "6005d4cf-b3b6-4ee1-ba66-295793be2dd6",
                                                "sense_id": "a42f1189-c9fb-3c49-9db1-bc1b9a71ab4c",
                                                "text": "Le sarrasin […] ou blé noir […] est un aliment de premier ordre, ainsi que le démontre la force des populations qui longtemps en ont fait leur principale nourriture (Bretagne, Normandie, Sologne, Russie)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7814526-963b-380b-8f10-e140fdc952a4",
                                        "entry_id": "b94a2d34-be39-307b-8fcb-388f7d11ebbd",
                                        "glosses": [
                                            "Nom vernaculaire donné à plusieurs Polygonacées du genre Eriogonum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe26dfe4-395a-3215-9a15-7637e7a8854a",
                                        "entry_id": "b94a2d34-be39-307b-8fcb-388f7d11ebbd",
                                        "glosses": [
                                            "Ouvrier non syndiqué, ou qui travaille dans une imprimerie mise à l’index ou qui travaille au noir, au-dessous du tarif normal."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "note": "voir aussi les variantes orthographiques",
                                        "examples": [
                                            {
                                                "example_id": "a5afb6e8-2400-49a2-b218-07460f00757b",
                                                "sense_id": "fe26dfe4-395a-3215-9a15-7637e7a8854a",
                                                "text": "On a souvent […] critiqué le rôle des syndicats […]. On leur a reproché leur esprit d’intolérance, leurs persécutions contre les ouvriers indépendants, les sarrasins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f331bec-2124-3acb-be82-02d896fd790d",
                                        "entry_id": "b94a2d34-be39-307b-8fcb-388f7d11ebbd",
                                        "glosses": [
                                            "Tourtia de Tournai rencontré à Bellignies et Bettrechies. Il se présente sous la forme d’un calcaire coquillier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
