                            "północnoeuropejski"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "aa3ef803-5397-4f23-9e9d-28229413dffb",
                                "sense_id": "2bdb2fc8-1abf-3b19-ab56-95db67be5dd3",
                                "text": "Estonia również ostatnio zaczęła wyraźnie przedstawiać się jako kraj nordycki, mając bardzo silne kulturowe, językowe i etniczne związki z Finlandią oraz związki kulturowe ze Szwecją, jednakże nie należy ona jeszcze do Rady Nordyckiej"
                            },
                            {
                                "example_id": "aee5ddb3-76c6-4f7d-927b-0f816acf8f87",
                                "sense_id": "2bdb2fc8-1abf-3b19-ab56-95db67be5dd3",
                                "text": "Kraje nordyckie to trzy kraje skandynawskie (Dania, Norwegia i Szwecja) oraz Islandia i Finlandia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
