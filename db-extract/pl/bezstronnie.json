                                "target_senses": [
                                    {
                                        "sense_id": "64f57067-93f8-30d0-b7ea-492fe41727fa",
                                        "entry_id": "a421a786-3e5a-3d5d-8a5f-63c7f5de6d69",
                                        "glosses": [
                                            "In a disinterested manner; impartially, dispassionately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8768be7e-38de-4971-8a4d-faf3f81eb1fc",
                                                "sense_id": "64f57067-93f8-30d0-b7ea-492fe41727fa",
                                                "text": "Maybe, however, she thinks him simply disinterestedly interested in human virtue but unable to regard it, as so many do, as a guarantee against The Thing – cruel fate which is indifferent to theological distinctions."
                                            }
                                        ]
                                    }
                                ]
