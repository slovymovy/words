                "senses": [
                    {
                        "sense_id": "d580d467-71e8-3350-b9a8-fd76bff8263c",
                        "entry_id": "b6e9731a-8fb2-31ff-99ae-6ae4ce2ef5e3",
                        "glosses": [
                            "The first existence of anything; act or fact of commencing; the beginning."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "148dcacd-2c34-4403-8eaf-f87e45ffc854",
                                "sense_id": "d580d467-71e8-3350-b9a8-fd76bff8263c",
                                "text": "The time of Henry VII nearly coincides with the commencement of what is termed modern history."
                            },
                            {
                                "example_id": "d5b44b94-c545-4033-b231-8be9ee301192",
                                "sense_id": "d580d467-71e8-3350-b9a8-fd76bff8263c",
                                "text": "Yet from the commencement of mining there have been unnoble proprietors of mines, who belonged to the class of merchants."
                            },
                            {
                                "example_id": "d787290b-1d99-4b16-a3a3-5f22ebf873c0",
                                "sense_id": "d580d467-71e8-3350-b9a8-fd76bff8263c",
                                "text": "Commencement of a two-hourly service pattern by GWR marked the return of regular services to Okehampton for the first time since their withdrawal in 1972. There are plans to extend this to hourly."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d888325-560a-3140-afa9-cf1edea8b187",
                        "entry_id": "b6e9731a-8fb2-31ff-99ae-6ae4ce2ef5e3",
                        "glosses": [
                            "The day when degrees are conferred by colleges and universities upon students and others."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "16db0323-5f94-363c-bb2f-d187068621d7",
                        "entry_id": "b6e9731a-8fb2-31ff-99ae-6ae4ce2ef5e3",
                        "glosses": [
                            "A graduation ceremony, from a school, college or university. Sometimes before the actual graduation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bfa69b2-00e9-4481-9719-05281ea7f6fe",
