                    {
                        "sense_id": "248c6c07-63fe-3a00-92d5-b683d74cca47",
                        "entry_id": "d668e490-6a11-373f-ad6e-73be48f291ed",
                        "glosses": [
                            "The front part of a person's foot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3576046d-cbf7-46e2-9248-4f10c29e884e",
                                "sense_id": "248c6c07-63fe-3a00-92d5-b683d74cca47",
                                "text": "I was not even sure I could change it at all, but I was convinced that I had to change my foot plant and land higher on my forefoot, rather than my heel."
                            }
                        ]
                    },
                    {
                        "sense_id": "86607cc3-b37a-30b2-8978-e206522e80ab",
                        "entry_id": "d668e490-6a11-373f-ad6e-73be48f291ed",
                        "glosses": [
                            "A piece of timber terminating the keel at the fore end, connecting it with the lower end of the stem."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec364574-6257-4749-8801-7edb9bcacb3c",
                                "sense_id": "86607cc3-b37a-30b2-8978-e206522e80ab",
                                "text": "I could see the waves boiling white under her forefoot."
                            }
                        ]
                    }
                ],
