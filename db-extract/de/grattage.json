                ],
                "senses": [
                    {
                        "sense_id": "eb67368a-ad8b-3acb-badc-394c2d7b520c",
                        "entry_id": "3df2d4ac-7965-3470-899a-8d20d2ebb90c",
                        "glosses": [
                            "Maltechnik, bei der dick aufgetragene Ölfarben mit einer Klinge oder Spachtel von der Leinwand abgekratzt werden; die Abtragung der Farbe kann von Gegenständen beeinflusst werden, die sich unter der Leinwand durchdrücken"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "7715dfc0-9f72-4183-a34f-a7db29d10ea4",
                                "sense_id": "eb67368a-ad8b-3acb-badc-394c2d7b520c",
                                "text": "In einer technischen Variante, der „Grattage“, malte Max Ernst Gemälde voll drohender Ungeheuer, düsterer Wälder, von schlafenden Städten im Licht des Mondes."
                            },
                            {
                                "example_id": "896464a6-c431-45d3-a1c3-609835c3e3e1",
                                "sense_id": "eb67368a-ad8b-3acb-badc-394c2d7b520c",
                                "text": "Die Techniken Frottage, Grattage und Drip Painting, als Oszillation entwickelt, gehen auf ihn zurück."
                            },
                            {
                                "example_id": "4b2c0fb0-f85c-472f-ab8d-c862bf8e82e6",
                                "sense_id": "eb67368a-ad8b-3acb-badc-394c2d7b520c",
                                "text": "Heute ist die Zeit der schnellen Entscheidungen, Grattage ist eine langwierige Technik."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0653aa53-9e53-4d3f-9c35-7ce288746577",
                        "source_entry_id": "3df2d4ac-7965-3470-899a-8d20d2ebb90c",
                        "source_sense_id": "eb67368a-ad8b-3acb-badc-394c2d7b520c",
                        "source_sense_description": "Maltechnik, bei der dick aufgetragene Ölfarben von der Leinwand abgekratzt werden",
                        "target_lang_word": "grattage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grattage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5353d6e0-d493-3d12-83c2-1c5a7ba4d7d2",
                                        "entry_id": "c19ec18f-7b5f-37c5-9ff8-af1a9b579cc9",
                                        "glosses": [
                                            "The scraping away of granulations (from an ulcer etc.) in order to stimulate healing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cea3bcc2-7cfb-40ce-8354-39b0f2fd603d",
                                                "sense_id": "5353d6e0-d493-3d12-83c2-1c5a7ba4d7d2",
                                                "text": "August 18th.—Operation by \"grattage\" without ether. The pain experienced by the patient was quite severe."
                                            },
                                            {
                                                "example_id": "e4c4e3b2-a8d3-4651-a824-07091cb8d6ba",
                                                "sense_id": "5353d6e0-d493-3d12-83c2-1c5a7ba4d7d2",
                                                "text": "Among those vaccinated by piqûre (sticking) a very small number only contracted the disease, and in these it was mild, while in those vaccinated by grattage it was, in general, severe."
                                            },
                                            {
                                                "example_id": "da46121a-ebcf-4a67-b44c-02084b4c3ba9",
                                                "sense_id": "5353d6e0-d493-3d12-83c2-1c5a7ba4d7d2",
                                                "text": "The results obtained by friction or grattage, by tearing the superficial capillaries, as well as the softer pathologic elements, will cause local depletion and will greatly improve circulation and absorption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39bb91f4-9f57-3d9b-821c-89c8a3b8899d",
                                        "entry_id": "c19ec18f-7b5f-37c5-9ff8-af1a9b579cc9",
                                        "glosses": [
                                            "A technique popularized by Max Ernst involving scraping at dried paint in order to form patterns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1897cd2c-ec2c-447f-b56a-be6a5c8317c8",
                                                "sense_id": "39bb91f4-9f57-3d9b-821c-89c8a3b8899d",
                                                "text": "Automatism in art can arise quite deliberately from manual techniques (such as frottage, grattage and decalcomania in the visual arts, algorithmic or statistical procedures in musical composition, or random verbal collages in poetry) or accidentally from altered states of consciousness (for example, intoxication, hallucination, trance and ecstasy)."
                                            },
                                            {
                                                "example_id": "650f2739-63cd-4a09-8b09-b40697f95377",
                                                "sense_id": "39bb91f4-9f57-3d9b-821c-89c8a3b8899d",
                                                "text": "These same forest images appeared when he adapted his frottage technique to the roughly rubbed and scratched painting techniques of grattage."
                                            },
                                            {
                                                "example_id": "cd74dd9c-18a4-4191-b3bd-a85d08bcfb61",
                                                "sense_id": "39bb91f4-9f57-3d9b-821c-89c8a3b8899d",
                                                "text": "They test the possibilities of collage, frottage, grattage, different methods of painting and printing, but also wordplay—and the mutual imitation and intersection ofthese devices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeb38022-ab49-4368-a7c7-3776e71a9584",
                        "source_entry_id": "3df2d4ac-7965-3470-899a-8d20d2ebb90c",
                        "source_sense_id": "eb67368a-ad8b-3acb-badc-394c2d7b520c",
                        "source_sense_description": "Maltechnik, bei der dick aufgetragene Ölfarben von der Leinwand abgekratzt werden",
                        "target_lang_word": "grattage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grattage",
