                        ]
                    },
                    {
                        "translation_id": "edf65135-4b60-4017-bf76-2ac79ff1da34",
                        "source_entry_id": "dd41445a-5624-3f1f-936a-93b8b476b66e",
                        "source_sense_id": "9a263216-ffd5-3ffd-92f4-e02291ce09ec",
                        "source_sense_description": "aus Weizen gebrautes Bier",
                        "target_lang_word": "bière blanche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bière blanche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6cfefb3-a9a0-389d-8542-c94b1ed78845",
                                        "entry_id": "3344dcde-b9c4-3b50-8d4b-3e60cfa47099",
                                        "glosses": [
                                            "Bière brassée avec une forte proportion de froment, malté ou non."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f21fbcc-2592-41e3-837f-de2469e9fc21",
                                                "sense_id": "c6cfefb3-a9a0-389d-8542-c94b1ed78845",
                                                "text": "Des bières légères. Il faut placer dans cette division la plus grande partie des bières blanches légères et peu colorées, de Paris et des départemens du nord de la France, l’uytzet légère de Wotteren , les petites bières de toute la Belgique, et la plupart des ailes des Anglais : […]."
                                            },
                                            {
                                                "example_id": "9abd443d-328b-4794-b517-7e2cb8f22b89",
                                                "sense_id": "c6cfefb3-a9a0-389d-8542-c94b1ed78845",
                                                "text": "On fait toujours et avec la même drèche un brassin de bière blanche et un brassin de bière brune."
                                            },
                                            {
                                                "example_id": "181190e9-8729-42b7-92f6-f60f983e01f5",
                                                "sense_id": "c6cfefb3-a9a0-389d-8542-c94b1ed78845",
                                                "text": "On y but la bière brune, la bière blanche, la double bière, le lambic, le faro, le pale-ale, le scoth-ale, le porter et le stout, sans oublier la cervoise; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
