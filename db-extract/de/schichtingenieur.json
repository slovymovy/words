                "senses": [
                    {
                        "sense_id": "44fdd7b7-057d-38e9-be4b-45491d4832bb",
                        "entry_id": "041e64a4-191f-3c74-b72b-d7b1e13a9e03",
                        "glosses": [
                            "spezialisierter Ingenieur im Fach- und Sachgebiet des Betriebsingenieurwesens, der seiner Arbeit während einer im Schichtbetrieb organisierten Arbeitszeit nachgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3610eaf5-725e-4694-9c69-a313dbc2b2a4",
                                "sense_id": "44fdd7b7-057d-38e9-be4b-45491d4832bb",
                                "text": "„Während bei einem Baubetrieb an 5 Tagen pro Woche, unabhängig ob 2/2- oder 3/3- Schichtbetrieb, normalerweise ein Schichtingenieur zur Koordination der Arbeiten ausreicht, ist bei jeder Form des 7-Tagebetriebs ein zusätzlicher Schichtingenieur erforderlich.“"
                            },
                            {
                                "example_id": "f0587c49-eb13-4c3e-ad8b-f4216376d389",
                                "sense_id": "44fdd7b7-057d-38e9-be4b-45491d4832bb",
                                "text": "„In diesem Gebäude waren die Werkstätten verschiedener Betriebshandwerker, die Büros der Schichtingenieure und die Hochspannungsschalter untergebracht.“"
                            },
                            {
                                "example_id": "b36ab3b0-4ffb-41b3-8858-28d11c6c6e8e",
                                "sense_id": "44fdd7b7-057d-38e9-be4b-45491d4832bb",
                                "text": "Der Job als Ingenieur im Tunnelbau ist im Schichtsystem organisiert, also gibt es jeweils Schichtingenieure, die den Bau rund um die Uhr bauleitend betreuen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
