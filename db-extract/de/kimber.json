                "senses": [
                    {
                        "sense_id": "4c9b6f5c-d217-3880-b4fa-08c14989da03",
                        "entry_id": "54272bcc-1efd-3390-a54f-f0a724eb92cf",
                        "glosses": [
                            "Angehöriger eines germanischen Volksstamms aus dem heutigen Jütland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d2d44c-f306-40ce-af81-7607c009875b",
                                "sense_id": "4c9b6f5c-d217-3880-b4fa-08c14989da03",
                                "text": "„In die Annalen Roms ist Marius aber wegen seiner spektakulären Siege über die germanischen Kimbern an der Rhônemündung […] und Teutonen in Oberitalien […] eingegangen, wofür ihn die dankbare Bevölkerung als ‚dritten Gründer Roms‘ feierte.“"
                            },
                            {
                                "example_id": "8f8ab041-4236-40f6-a9f0-42cda95b3fa9",
                                "sense_id": "4c9b6f5c-d217-3880-b4fa-08c14989da03",
                                "text": "„Lange hielten Historiker die Kimbern und Teutonen für Unruhestifter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3628d1b0-af4a-4b0e-bcf4-b4190b2f18df",
                        "source_entry_id": "54272bcc-1efd-3390-a54f-f0a724eb92cf",
                        "source_sense_id": "4c9b6f5c-d217-3880-b4fa-08c14989da03",
                        "source_sense_description": "Angehöriger eines germanischen Volksstamms aus dem heutigen Jütland",
                        "target_lang_word": "Cimbrian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cimbrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bd21688-6521-3d1a-b7d6-d08067e6b258",
                                        "entry_id": "283ee4b2-fcb5-3bf6-8079-be2c63c3fe7b",
                                        "glosses": [
                                            "A member of a Germanic people who live in parts of northeast Italy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                        "entry_id": "283ee4b2-fcb5-3bf6-8079-be2c63c3fe7b",
                                        "glosses": [
                                            "A member of the Cimbri, especially when they are considered to have been a Germanic people and to originate from Jutland (the \\\"Cimbrian peninsula\\\")."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e45903-e5ed-4619-bf0d-4da45e93072c",
                                                "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                                "text": "The Teutones settled in Germany and Gaul; the Cimbrians invaded Italy, where they were defeated by Marius."
                                            },
                                            {
                                                "example_id": "4217f338-a10e-4aad-9c94-65804d3343c2",
                                                "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                                "text": "[W]e find mention of the Cimbrians in the Danish or Cimbrian peninsula[. ...] The Cimbrians and Teutons are described as tall and slightly built men [...]"
                                            },
                                            {
                                                "example_id": "e2f22325-2b28-4540-9d65-38bfbd52a3c5",
                                                "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                                "text": "I, however, putting these things aside or leaving them out for a short while, have found it better to begin with the migration of the Cimbrians from their home in their peninsula [Jutland]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cimbrian",
                                "target_lang_code": "en",
