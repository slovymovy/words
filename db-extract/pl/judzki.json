                "senses": [
                    {
                        "sense_id": "901e6afc-e2f2-3368-8db9-615e80b8a4db",
                        "entry_id": "436412ca-1544-3cb3-b7c7-cf03bce6e198",
                        "glosses": [
                            "związany z Judą, dotyczący Judy, pochodzący z Judy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f13247-3ec1-4c42-9d3b-d11bb5d081fa",
                                "sense_id": "901e6afc-e2f2-3368-8db9-615e80b8a4db",
                                "text": "Córka judzka jednak nie zgodziła się na waszą nieprawość."
                            },
                            {
                                "example_id": "fdbccdde-4023-471c-af57-5659b0542cd3",
                                "sense_id": "901e6afc-e2f2-3368-8db9-615e80b8a4db",
                                "text": "Ciągnęła do niego cała judzka kraina oraz wszyscy mieszkańcy Jerozolimy i przyjmowali od niego chrzest w rzece Jordan, wyznając przy tym swe grzechy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
