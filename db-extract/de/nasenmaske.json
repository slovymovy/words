                ],
                "senses": [
                    {
                        "sense_id": "b17c8fdc-0316-3341-8a88-f6bb995292e9",
                        "entry_id": "0381db7a-593d-336d-93a6-9342e4ce5ab1",
                        "glosses": [
                            "die Nase umschließender Aufsatz, durch den Atemluft fließt, gedrückt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225ccada-f84d-47aa-a5d1-9b80bdb692d4",
                                "sense_id": "b17c8fdc-0316-3341-8a88-f6bb995292e9",
                                "text": "„[…] die nichtinvasive Beatmung, bei der die Ankoppelung des Beatmungsgeräts an den Patienten über eine Nasen- oder Mundmaske, eine Gesichtsmaske oder einen Helm geschieht […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3e7d2bf-b6de-34e7-a5a1-cf8fb1c53844",
                        "entry_id": "0381db7a-593d-336d-93a6-9342e4ce5ab1",
                        "glosses": [
                            "die Nase bedeckender Schutz zur Vermeidung von Ansteckung/Kontamination/Schädigung/Vergiftung"
                        ],
                        "tags": [
                            "Hygiene",
                            "meist in der Kombination mit Mundmaske"
                        ],
                        "examples": [
                            {
                                "example_id": "2f96d3db-43dd-4a68-af5a-7c2c5085fd95",
                                "sense_id": "a3e7d2bf-b6de-34e7-a5a1-cf8fb1c53844",
                                "text": "„Eine Mund- und Nasenmaske schützt die Atemwege vor feinem Schleifstaub, der leicht zu Reizhusten führen kann.“"
                            },
                            {
                                "example_id": "c29980e2-4d36-40da-8ef0-ea001e95588c",
                                "sense_id": "a3e7d2bf-b6de-34e7-a5a1-cf8fb1c53844",
                                "text": "„Aus diesen Gründen sollten Schutzmaßnahmen, wie Brille, Mund- und Nasenmaske, Schutzschild, Absauggeräte mit Ableitung nach außen, Maßnahmen gegen den Keimgehalt des Kühlwassers u. ä. getroffen werden.“"
                            },
                            {
                                "example_id": "832b0c39-ebf2-4721-8155-96223eee31fa",
                                "sense_id": "a3e7d2bf-b6de-34e7-a5a1-cf8fb1c53844",
                                "text": "„Wie aus einem Hollywood-Action-Streifen sehen die mit Schutzhelm, Mund- und Nasenmasken vermummten Menschen auf ihren Zweirädern in den grau-blauen Gaswolken aus.“"
                            },
                            {
                                "example_id": "8cbdeffc-e6d4-461a-9561-2eb76fcd9074",
                                "sense_id": "a3e7d2bf-b6de-34e7-a5a1-cf8fb1c53844",
                                "text": "„Bei der Pflege müssen Mund- und Nasenmasken getragen werden, die häufig zu wechseln sind, nicht jedoch, etwa zur Erleichterung in Arbeitspausen, mit den Händen angehoben werden dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
