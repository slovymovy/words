                "senses": [
                    {
                        "sense_id": "eb2ee5b7-7c20-38de-aba1-21132510ca0e",
                        "entry_id": "7acd8bf6-872b-325d-91bb-b1144e21324a",
                        "glosses": [
                            "Statue, hergestellt aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b361392-42aa-4e44-87da-b945d3cf801e",
                                "sense_id": "eb2ee5b7-7c20-38de-aba1-21132510ca0e",
                                "text": "„Silvio Berlusconi mag junge Frauen und legt Wert auf seine Männlichkeit. Eine Marmorstatue vor seinem Regierungspalast hat er deshalb mit einem neuen Penis bestücken lassen.“"
                            },
                            {
                                "example_id": "5aa32e00-32eb-424a-a35a-17f64abb6a20",
                                "sense_id": "eb2ee5b7-7c20-38de-aba1-21132510ca0e",
                                "text": "„Der Garten war verwildert, romantisch und voll von Marmorstatuen wie ein Gedicht Eichendorffs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c365cc7-cac3-412f-a2fa-118bcf2a270f",
                        "source_entry_id": "7acd8bf6-872b-325d-91bb-b1144e21324a",
                        "source_sense_id": "eb2ee5b7-7c20-38de-aba1-21132510ca0e",
