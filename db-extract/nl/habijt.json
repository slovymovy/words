                "senses": [
                    {
                        "sense_id": "c54619df-41db-35e7-8a74-cf357fee135f",
                        "entry_id": "8da7761c-c8f5-3361-aa39-7d5d4a563f73",
                        "glosses": [
                            "pij, lange kleding gedragen door monniken en nonnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c0b47ad-6eb3-4a36-bc19-e1327f638291",
                                "sense_id": "c54619df-41db-35e7-8a74-cf357fee135f",
                                "text": "Meestal is een habijt donkerbruin of zwart gekleurd maar de camaldulenzers hebben een witte pij en worden de witte benedictijnen genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15ba3228-e079-47c3-bb19-15f0c4867d60",
                        "source_entry_id": "8da7761c-c8f5-3361-aa39-7d5d4a563f73",
                        "source_sense_id": "c54619df-41db-35e7-8a74-cf357fee135f",
                        "target_lang_word": "habit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44e338a2-608b-3792-95c3-b9b655168231",
                                        "entry_id": "6d67add3-1ee4-376a-aea1-2f4031db8246",
                                        "glosses": [
                                            "Tout ce qui est fait pour couvrir le corps, excepté le linge, la coiffure et la chaussure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4305c434-5825-4fc9-a025-63f684c35b16",
                                                "sense_id": "44e338a2-608b-3792-95c3-b9b655168231",
                                                "text": "Cette partie, appelée passementerie d’or et d’argent, comprenait les épaulettes, les dragonnes, les aiguillettes, enfin cette immense quantité de choses brillantes qui scintillaient sur les riches uniformes de l’armée française et sur les habits civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380a072a-495a-3157-a151-79fcd9719224",
                                        "entry_id": "6d67add3-1ee4-376a-aea1-2f4031db8246",
                                        "glosses": [
                                            "Les différentes parties des vêtements de dessus des hommes ; costume."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dbe78c8-8eec-4714-b5c5-4bd3833a0f7c",
                                                "sense_id": "380a072a-495a-3157-a151-79fcd9719224",
                                                "text": "Il ôtait son grand habit noisette, remettait sa perruque dans la boîte et tirait de nouveau son bonnet de soie sur ses oreilles, en disant […]"
                                            },
                                            {
                                                "example_id": "5fefa981-724d-4006-82e7-6b84dd051c19",
                                                "sense_id": "380a072a-495a-3157-a151-79fcd9719224",
                                                "text": "« Vous savez si je m’en suis payé des voyages… Eh bien, je puis le dire… en sleeping, en cabine, en télègue, n’importe où et n’importe comment, à sept heures et demie, tous les soirs… en habit ! »"
                                            },
                                            {
                                                "example_id": "9ce2b32b-c027-4cd7-8656-6e7d51e2ecbf",
                                                "sense_id": "380a072a-495a-3157-a151-79fcd9719224",
                                                "text": "Il était dangereux de ne pas avoir d’insignes patriotiques au revers de l’habit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "559fa856-93be-327c-a405-b836897f001b",
                                        "entry_id": "6d67add3-1ee4-376a-aea1-2f4031db8246",
                                        "glosses": [
                                            "Partie de l’habillement de cérémonie qui est ouvert par-devant et qui a des pans par-derrière ; frac."
                                        ],
                                        "tags": [
                                            "especially",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eefd9217-476e-481c-bdaf-82165143a18a",
                                                "sense_id": "559fa856-93be-327c-a405-b836897f001b",
                                                "text": "Bédouin, vêtu d’un pantalon de gendarme, d’un habit rouge, coiffé d’un bicorne et nanti de sa hallebarde de suisse, vint le prendre à son banc, et, de force, le contraignit à se mettre à genoux au milieu de la nef."
                                            },
                                            {
                                                "example_id": "99b87e54-bbb1-4d4c-9a02-5b3a17c4a36c",
                                                "sense_id": "559fa856-93be-327c-a405-b836897f001b",
                                                "text": "Mmes Daudoird et Clara Lemonnier, dont la première portait l’habit noir avec un chic et une aisance qui auraient damé le pion au clubman le plus élégant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19c958e2-4729-358d-a4c6-65cffe459793",
                                        "entry_id": "6d67add3-1ee4-376a-aea1-2f4031db8246",
                                        "glosses": [
                                            "Costume des religieux et des religieuses."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a5ee0f-41a5-43e6-8c85-a97a5c26a56a",
                                                "sense_id": "19c958e2-4729-358d-a4c6-65cffe459793",
                                                "text": "Il n’eut que le temps de réendosser prestement sa soutane et de filer en hâte à la sacristie pour revêtir les habits sacerdotaux."
                                            },
                                            {
                                                "example_id": "df1435f2-03b6-498c-a8e2-1596965495e4",
                                                "sense_id": "19c958e2-4729-358d-a4c6-65cffe459793",
                                                "text": "Moins l’habit et la cornette, c’est une sœur de la charité qui pose des ventouses, des cataplasmes, applique des sinapismes, masse les rhumatisants, ensevelit les morts."
                                            },
                                            {
                                                "example_id": "2b1da325-98f8-4462-878a-56e9fb79d032",
                                                "sense_id": "19c958e2-4729-358d-a4c6-65cffe459793",
                                                "text": "Habit long : La soutane."
                                            },
                                            {
                                                "example_id": "e24128c0-3363-447f-8bf6-971b3b110798",
                                                "sense_id": "19c958e2-4729-358d-a4c6-65cffe459793",
                                                "text": "Habit court : L’habit noir que portaient les ecclésiastiques quand ils n’étaient pas en soutane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec1d7ce2-5a75-37e2-b7dc-cb00496db1df",
                                        "entry_id": "6d67add3-1ee4-376a-aea1-2f4031db8246",
                                        "glosses": [
                                            "Rôle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf3a0780-d7ab-4573-b732-51ddfba44d5a",
                                                "sense_id": "ec1d7ce2-5a75-37e2-b7dc-cb00496db1df",
                                                "text": "Dans son opération de conquête, Macron endosse l’habit du volontariste au parler franc, qui exige que chacun « prenne ses responsabilités »."
                                            },
                                            {
                                                "example_id": "456edb5e-f8ab-4e98-9b0f-fbb3a737373c",
                                                "sense_id": "ec1d7ce2-5a75-37e2-b7dc-cb00496db1df",
                                                "text": "En 2016, son élection était motivée par un tas de raisons, mais principalement par une rébellion populiste contre le système, qui prenait différents habits, soit par le rejet de la mondialisation, du libéralisme, des élites, par une parole sexiste et raciste..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
