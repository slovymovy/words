{
    "word_family": [
        "brittleness",
        "brittly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fae0fa20-559f-3c21-adf6-d5092be8eadc",
                    "sense_definition": "Hard but liable to break or shatter easily when under pressure or impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old plastic had become <w>brittle</w> after years of sitting in the sun.",
                            "target_lang_translations": {
                                "ru": "Старый пластик стал <w>хрупким</w> после многих лет на солнце."
                            }
                        },
                        {
                            "text": "Cast iron is much more <w>brittle</w> than forged iron and can crack if dropped.",
                            "target_lang_translations": {
                                "ru": "Чугун гораздо более <w>ломкий</w>, чем кованое железо, и может треснуть при падении."
                            }
                        }
                    ],
                    "synonyms": [
                        "brickle"
                    ],
                    "antonyms": [
                        "flexible",
                        "tough",
                        "resilient"
                    ],
                    "common_phrases": [
                        "brittle bones",
                        "hard but brittle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый, но легко ломающийся или рассыпающийся при давлении или ударе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "легко разрушающийся"
                            },
                            {
                                "target_lang_word": "ломкий",
                                "target_lang_sense_clarification": "легко ломающийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13ab8902-ff43-35a0-8380-6520dc2ee97f",
                    "sense_definition": "Appearing confident or stable but actually fragile and easily upset or offended.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She maintained a <w>brittle</w> smile throughout the interview despite her obvious nervousness.",
                            "target_lang_translations": {
                                "ru": "Она сохраняла <w>натянутую</w> улыбку на протяжении всего интервью, несмотря на явное волнение."
                            }
                        },
                        {
                            "text": "His <w>brittle</w> personality made it difficult for colleagues to offer any constructive criticism.",
                            "target_lang_translations": {
                                "ru": "Его <w>ранимый</w> характер мешал коллегам высказывать какую-либо конструктивную критику."
                            }
                        }
                    ],
                    "antonyms": [
                        "stable",
                        "relaxed"
                    ],
                    "common_phrases": [
                        "brittle smile",
                        "brittle personality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядящий уверенным или стабильным, но на самом деле хрупкий и легко расстраивающийся или обижающийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натянутый",
                                "target_lang_sense_clarification": "о неестественной улыбке или поведении"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "о душевном состоянии или характере"
                            },
                            {
                                "target_lang_word": "уязвимый",
                                "target_lang_sense_clarification": "легко задеваемый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d0d7a3f-4e62-387d-a20b-fa3ba59d633c",
                    "sense_definition": "Susceptible to catastrophic failure due to a lack of flexibility or redundancy in a system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software architecture was too <w>brittle</w> to handle the new updates.",
                            "target_lang_translations": {
                                "ru": "Архитектура программного обеспечения была слишком <w>негибкой</w>, чтобы справиться с новыми обновлениями."
                            }
                        },
                        {
                            "text": "A <w>brittle</w> system often fails completely when a single minor error occurs.",
                            "target_lang_translations": {
                                "ru": "<w>Хрупкая</w> система часто полностью выходит из строя при возникновении одной незначительной ошибки."
                            }
                        }
                    ],
                    "antonyms": [
                        "robust"
                    ],
                    "common_phrases": [
                        "brittle system"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к катастрофическому сбою из-за отсутствия гибкости или избыточности в системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "негибкий",
                                "target_lang_sense_clarification": "о системе или архитектуре"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "легко выходящий из строя при изменениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c007b0ff-399d-3bdf-925d-60a69c343793",
                    "sense_definition": "Relating to a form of diabetes characterized by dramatic and unpredictable swings in blood sugar levels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Patients with <w>brittle</w> diabetes require very careful monitoring of their insulin levels.",
                            "target_lang_translations": {
                                "ru": "Пациенты с <w>лабильным</w> диабетом нуждаются в очень тщательном контроле уровня инсулина."
                            }
                        },
                        {
                            "text": "Managing <w>brittle</w> blood sugar levels is a constant challenge for the medical team.",
                            "target_lang_translations": {
                                "ru": "Контроль <w>нестабильного</w> уровня сахара в крови является постоянной проблемой для медицинской команды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brittle diabetes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к форме диабета, характеризующейся резкими и непредсказуемыми колебаниями уровня сахара в крови."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лабильный",
                                "target_lang_sense_clarification": "неустойчивый, о течении болезни"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "медицинский термин для нестабильного диабета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96de463c-7e11-364e-b0a9-8cfe2f3c0de9",
                    "sense_definition": "A type of hard candy made from caramelized sugar and nuts, usually broken into flat pieces.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confectionery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a large bag of peanut <w>brittle</w> at the county fair.",
                            "target_lang_translations": {
                                "ru": "Мы купили большой пакет арахисового <w>козинака</w> на ярмарке графства."
                            }
                        },
                        {
                            "text": "The homemade <w>brittle</w> was sweet, crunchy, and full of roasted almonds.",
                            "target_lang_translations": {
                                "ru": "Домашний <w>грильяж</w> был сладким, хрустящим и полным жареного миндаля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peanut brittle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид твердой сладости, приготовленной из карамелизированного сахара и орехов, обычно разломанной на плоские кусочки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "козинак",
                                "target_lang_sense_clarification": "сладость из орехов в карамели или меду"
                            },
                            {
                                "target_lang_word": "грильяж",
                                "target_lang_sense_clarification": "твердая карамель с дроблеными орехами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8168b61c-4d01-3f3c-b27c-c78475577011",
                    "sense_definition": "To become hard and easily broken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paper began to <w>brittle</w> and yellow with extreme age.",
                            "target_lang_translations": {
                                "ru": "От старости бумага начала <w>крошиться</w> и желтеть."
                            }
                        },
                        {
                            "text": "Exposure to the cold caused the rubber seals to <w>brittle</w> over time.",
                            "target_lang_translations": {
                                "ru": "Воздействие холода со временем привело к тому, что резиновые уплотнители <w>стали хрупкими</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться твердым и легко ломающимся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "становиться хрупким",
                                "target_lang_sense_clarification": "приобретать ломкость"
                            },
                            {
                                "target_lang_word": "охрупчиваться",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2eee7f42-6c8c-3e66-903c-add0adc80aa8",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history book mentions a family named <w>Brittle</w> living here in the 1800s.",
                            "target_lang_translations": {
                                "ru": "В книге по местной истории упоминается семья по фамилии <w>Бриттл</w>, жившая здесь в 1800-х годах."
                            }
                        },
                        {
                            "text": "Mr. <w>Brittle</w> was appointed as the new head of the department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бриттл</w> был назначен новым главой отдела."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бриттл",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}