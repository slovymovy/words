                        "glosses": [
                            "Krach boursier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b8abef6-4b7b-4679-82b6-e17cc944bb75",
                                "sense_id": "3a636f50-820b-3826-af3e-d799549511a9",
                                "text": "Sowohl dem Börsencrash 1987 als auch dem Platzen der Dotcom-Blase 1999 ging ein Einbruch des Baltic Dry voraus.",
                                "translation": "Le krach boursier de 1987 et l'éclatement de la bulle dotcom en 1999 ont tous deux été précédés d'une chute du Baltic Dry."
                            },
                            {
                                "example_id": "636d41e1-5de0-4598-b6a4-ae25b08c157c",
                                "sense_id": "3a636f50-820b-3826-af3e-d799549511a9",
                                "text": "\"Kein Präsident vor mir hat je so einen großen und wundervollen Börsencrash verursacht\", verkündete Trump stolz. \"(...) Das haben mir alle meine Berater bestätigt.\"",
                                "translation": "« Aucun président avant moi n’a jamais provoqué un krach boursier aussi important et merveilleux », a fièrement déclaré Trump. « (...) Tous mes conseillers me l’ont confirmé »."
                            }
                        ]
                    }
