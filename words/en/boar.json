                {
                    "sense_id": "c1ab17de-b7d0-33f0-b0bb-2856374b088d",
                    "sense_definition": "A wild pig (Sus scrofa), the wild ancestor of the domesticated pig.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>boar</w> ran quickly through the dense forest.",
                            "target_lang_translations": {
                                "pl": "<w>Dzik</w> szybko przebiegł przez gęsty las."
                            }
                        },
                        {
                            "text": "A large <w>wild</w> <w>boar</w> was spotted near the edge of the village.",
                            "target_lang_translations": {
                                "pl": "W pobliżu skraju wsi zauważono dużego <w>dzika</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wild pig"
                    ],
                    "common_phrases": [
                        "wild boar"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dzik (Sus scrofa), dziki przodek świni domowej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dzik",
                                "target_lang_sense_clarification": "ogólne określenie dzikiego zwierzęcia z rodziny świniowatych"
                            },
                            {
                                "target_lang_word": "odyniec",
                                "target_lang_sense_clarification": "stary, samotnie żyjący samiec dzika"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c24977cc-dfde-3892-b5ae-c25b855c466c",
                    "sense_definition": "An uncastrated male pig.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer kept one <w>boar</w> for breeding purposes.",
                            "target_lang_translations": {
                                "pl": "Rolnik trzymał jednego <w>knura</w> do celów hodowlanych."
                            }
                        },
                        {
                            "text": "The <w>male</w> <w>boar</w> is often more aggressive than the sows.",
                            "target_lang_translations": {
                                "pl": "<w>Knur</w> jest często bardziej agresywny niż lochy."
                            }
                        }
                    ],
                    "antonyms": [
                        "sow"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niekastrowany samiec świni domowej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "knur",
                                "target_lang_sense_clarification": "samiec świni hodowany w celach rozpłodowych"
                            },
                            {
                                "target_lang_word": "kiernoz",
                                "target_lang_sense_clarification": "dawne lub zootechniczne określenie samca świni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ef1dc55-abc2-33e4-bcc5-09feab1fa668",
                    "sense_definition": "A male guinea pig.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeder identified the young <w>boar</w> by its physical characteristics.",
                            "target_lang_translations": {
                                "pl": "Hodowca zidentyfikował młodego <w>samca</w> świnki morskiej po jego cechach fizycznych."
                            }
                        },
                        {
                            "text": "It is important to separate the <w>boar</w> from the female to prevent unwanted litters.",
                            "target_lang_translations": {
                                "pl": "Ważne jest, aby oddzielić <w>samca</w> od samicy, aby zapobiec niechcianym miotom."
                            }
                        }
                    ],
                    "antonyms": [
                        "sow"
                    ],
                    "target_lang_definitions": {
                        "pl": "Samiec świnki morskiej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "samiec świnki morskiej",
                                "target_lang_sense_clarification": "określenie płci świnki morskiej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db471bf-07b4-3012-b9c4-84a1cc56e94a",
                    "sense_definition": "A male bear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large <w>boar</w> patrolled his territory in the mountains.",
