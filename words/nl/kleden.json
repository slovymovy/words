                            },
                            {
                                "target_lang_word": "flatter",
                                "target_lang_sense_clarification": "to make someone look more attractive"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "быть к лицу, подходить по стилю или цвету"
                            },
                            {
                                "target_lang_word": "стройнить",
                                "target_lang_sense_clarification": "делать фигуру визуально более стройной"
                            },
                            {
                                "target_lang_word": "быть к лицу",
                                "target_lang_sense_clarification": "подчеркивать достоинства внешности"
                            }
                        ]
                    }
                }
            ]
        },
