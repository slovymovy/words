{
    "word_family": [
        "fish"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e484df12-3e0d-3601-89a4-5674e1a5d7a8",
                    "sense_definition": "Having the smell, taste, or physical characteristics of a fish.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen had a strong <w>fishy</w> odor after cooking the salmon.",
                            "target_lang_translations": {
                                "zh": "做完三文鱼后，厨房里有一股浓重的<w>鱼腥味</w>。"
                            }
                        },
                        {
                            "text": "This water tastes a bit <w>fishy</w> today.",
                            "target_lang_translations": {
                                "zh": "这水今天喝起来有点<w>腥味</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "piscine"
                    ],
                    "common_phrases": [
                        "fishy smell",
                        "fishy taste"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有鱼的腥味、味道或物理特征。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有鱼腥味的",
                                "target_lang_sense_clarification": "形容带有鱼类特有的腥味。"
                            },
                            {
                                "target_lang_word": "腥的",
                                "target_lang_sense_clarification": "指食物带有腥味。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0693877a-8b2c-3d3c-9a3d-10587550e58d",
                    "sense_definition": "Seeming dishonest, suspicious, or likely to be wrong.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "suspicion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deal sounded too good to be true, so I thought it was <w>fishy</w>.",
                            "target_lang_translations": {
                                "zh": "这笔交易听起来好得不真实，所以我认为它很<w>可疑</w>。"
                            }
                        },
                        {
                            "text": "Something <w>fishy</w> is going on with these financial reports.",
                            "target_lang_translations": {
                                "zh": "这些财务报告里肯定有<w>猫腻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dodgy",
                        "dubious",
                        "iffy",
                        "questionable",
                        "shady",
                        "sketchy"
                    ],
                    "common_phrases": [
                        "something fishy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "看起来不诚实、可疑或可能有问题的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可疑的",
                                "target_lang_sense_clarification": "指事情看起来不正常或有猫腻。"
                            },
                            {
                                "target_lang_word": "有猫腻的",
                                "target_lang_sense_clarification": "口语，指事情背后有不可告人的秘密。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b469167d-cc1a-3a7b-ba83-00a19da1b12b",
                    "sense_definition": "Appearing very feminine and resembling a cisgender woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The performer looked incredibly <w>fishy</w> in that gown.",
                            "target_lang_translations": {
                                "zh": "那位表演者穿着那件礼服看起来非常<w>女性化</w>。"
                            }
                        },
                        {
                            "text": "She spent hours on her makeup to look as <w>fishy</w> as possible.",
                            "target_lang_translations": {
                                "zh": "她花了几个小时化妆，为了让自己看起来尽可能<w>女性化</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used within the drag community."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在变装文化中，指外表看起来非常像顺性别女性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "女性化的",
                                "target_lang_sense_clarification": "指变装表演中外表极度接近女性。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d60010b-3591-33c5-adea-f492be1261b0",
                    "sense_definition": "A small or cute <w>fish</w>.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "diminutive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children watched the colorful <w>fishies</w> swimming in the pond.",
                            "target_lang_translations": {
                                "zh": "孩子们看着池塘里游来游去的彩色<w>小鱼</w>。"
                            }
                        },
                        {
                            "text": "Look at the tiny <w>fishies</w> in the aquarium.",
                            "target_lang_translations": {
                                "zh": "快看鱼缸里那些<w>小鱼</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used by or to children."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "小鱼，通常用于儿语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小鱼",
                                "target_lang_sense_clarification": "指体型较小的鱼。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}