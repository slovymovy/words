                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65274bfb-f18e-43fe-9582-f181f2465bd7",
                                "sense_id": "486ca289-7703-3600-ba55-63f244645ce6",
                                "text": "Nach Dienstschluss zieht er wieder seine Zivilsachen an."
                            },
                            {
                                "example_id": "9334568a-2703-4ab1-b5e7-fe5ea9b6cf8d",
                                "sense_id": "486ca289-7703-3600-ba55-63f244645ce6",
                                "text": "„Die Zivilsachen waren leicht und dünn nach dem schweren Militärzeug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77554e22-3f1e-3106-a190-d0a23da06d3a",
                        "entry_id": "7765ed3a-5fe6-3cf0-b377-94b18c4008dd",
                        "glosses": [
                            "Rechtsstreitigkeit, die dem Zivilrecht unterliegt"
                        ],
                        "tags": [
                            "Jura"
                        ],
                        "examples": [
                            {
                                "example_id": "074fbb5b-8259-4fd6-81c9-93fbedc43f26",
                                "sense_id": "77554e22-3f1e-3106-a190-d0a23da06d3a",
                                "text": "„Zivilsachen mögen sie nicht; sie sitzen immer nur in Strafverhandlungen.“"
                            }
                        ],
