                "senses": [
                    {
                        "sense_id": "e5d83651-39be-3eac-8f92-71177a9cd377",
                        "entry_id": "69915401-77d8-3755-ab8c-bc20553d8b41",
                        "glosses": [
                            "kleiner, verdeckter Raum der Theaterbühne, in dem sich die Souffleuse/der Souffleur während der Vorführung aufhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3d9353-2dbb-4c37-b99e-a190f818999a",
                                "sense_id": "e5d83651-39be-3eac-8f92-71177a9cd377",
                                "text": "„Die war allerdings so eng, daß wir beim Spielen Angst hatten, in den Souffleurkasten zu fallen.“"
                            },
                            {
                                "example_id": "25bcc510-8a66-4073-b8bd-22a86a60ea70",
                                "sense_id": "e5d83651-39be-3eac-8f92-71177a9cd377",
                                "text": "„Als sie damit fertig waren, trat die Dicke im weissen Seidenkleide an den Souffleurkasten heran, und nun gesellte sich zu ihr ein Mann mit dicken Beinen, engen Seidenhosen, einem Federhut und einem Dolch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
