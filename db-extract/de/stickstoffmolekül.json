                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c4e81f-dc7b-43cb-8a8b-7733d3d4b156",
                                "sense_id": "e121d2d2-44d8-3593-a225-a744ebda3f5e",
                                "text": "In einem Stickstoffmolekül liegt eine Dreifachbindung vor."
                            },
                            {
                                "example_id": "a42318b5-0075-46fa-9508-9f388e4bb38a",
                                "sense_id": "e121d2d2-44d8-3593-a225-a744ebda3f5e",
                                "text": "„Nimmt man dagegen an, daß der Bau des Cyanmoleküls c : N – N : c ist, d. h., daß an jedes Atom in dem Stickstoffmoleküle 1 Kohlenstoffatom sich anlagert, so wird man, indem das Stickstoffmolekül sich nicht zersetzt, c : N – N : c = 2c:n = 11,06 Cal. erhalten.“ (1906)"
                            }
                        ],
                        "sense_index_json": "\"1\""
