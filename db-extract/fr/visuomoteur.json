                "senses": [
                    {
                        "sense_id": "2b6058ab-e74d-3de4-bc95-c38449c163c6",
                        "entry_id": "dda95d97-c9ea-3352-a7cb-41f94ce85f97",
                        "glosses": [
                            "Relatif à la vision et aux fonctions motrices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "121ab2f2-27df-4f5f-babd-b17836d04c60",
                                "sense_id": "2b6058ab-e74d-3de4-bc95-c38449c163c6",
                                "text": "Elle permet de renforcer l’efficacité de certains neurones impliqués dans la coordination visuomotrice (lien entre ce que je vois et ce que je fais)."
                            },
                            {
                                "example_id": "50f3ff91-6c55-4e46-a098-c6dca58d4322",
                                "sense_id": "2b6058ab-e74d-3de4-bc95-c38449c163c6",
                                "text": "Pour comprendre le mauvais développement visuomoteur chez les nouveau-nés strabiques durant cette période, il est utile de comprendre le développement de la fusion binoculaire et de la vergence chez les mêmes enfants durant le même intervalle postnatal de 2 à 5 mois."
                            },
                            {
                                "example_id": "0c415806-6685-451e-9c98-3a8a0639bf17",
                                "sense_id": "2b6058ab-e74d-3de4-bc95-c38449c163c6",
                                "text": "C’est le système visuomoteur qui est le plus touché."
                            }
                        ]
                    }
