                ],
                "translations": [
                    {
                        "translation_id": "6654524d-4870-4079-b577-7e883ef75d6e",
                        "source_entry_id": "f4c0f951-e40f-3238-aa7d-9cbaa7a22dc6",
                        "source_sense_description": "informal: ambulance driver",
                        "target_lang_word": "ambulancier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambulancier",
                                "target_lang_code": "fr",
