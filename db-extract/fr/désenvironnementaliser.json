                "senses": [
                    {
                        "sense_id": "99a0e994-635c-3ecd-800f-70d98aa52f25",
                        "entry_id": "22c71449-67b7-35ef-87cf-b288a263d2e6",
                        "glosses": [
                            "Faire perdre son caractère environnemental à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "701c72e8-3f35-4bf1-a18a-0d2295db2716",
                                "sense_id": "99a0e994-635c-3ecd-800f-70d98aa52f25",
                                "text": "Le Brésil, pays hôte de la conférence, laisse parfois entendre qu’il souhaite « désenvironnementaliser » Rio+20 afin de concentrer la conférence sur le développement."
                            },
                            {
                                "example_id": "871cd1f7-66d4-4f40-8dd7-292499550c4e",
                                "sense_id": "99a0e994-635c-3ecd-800f-70d98aa52f25",
                                "text": "La troisième raison pour laquelle notre vigilance est requise est que nous avons des projets individuels une vision désenvironnementalisée : « Unetelle ? Elle a une énergie ! Quoi qu’elle fasse, elle réussira. »."
                            },
                            {
                                "example_id": "08e7f967-9f94-4294-bfe7-334db801d4aa",
                                "sense_id": "99a0e994-635c-3ecd-800f-70d98aa52f25",
                                "text": "Au final, la théorie des germes aura eu pour effet de \"désenvironnementaliser\" la question de la santé humaine."
                            }
                        ]
                    }
                ],
