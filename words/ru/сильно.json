{
    "word_family": [
        "сила",
        "сильный",
        "силить",
        "сильнее",
        "сильнейший"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f99ebc4e-f1b9-32c2-b993-09acbf5027a5",
                    "sense_definition": "С большой физической силой или мощью",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спортсмен <w>сильно</w> ударил по мячу во время игры.",
                            "target_lang_translations": {
                                "en": "The athlete hit the ball <w>hard</w> during the game."
                            }
                        },
                        {
                            "text": "Ветер <w>сильно</w> дул в лицо, мешая идти вперед.",
                            "target_lang_translations": {
                                "en": "The wind blew <w>strongly</w> in my face, making it difficult to walk forward."
                            }
                        }
                    ],
                    "synonyms": [
                        "кре́пко"
                    ],
                    "antonyms": [
                        "слабо"
                    ],
                    "common_phrases": [
                        "сильно ударить",
                        "сильно дуть"
                    ],
                    "target_lang_definitions": {
                        "en": "With great physical force or power."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strongly",
                                "target_lang_sense_clarification": "In a strong or powerful manner."
                            },
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "With great force or intensity."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c969426e-c416-376a-8098-07fc514880d5",
                    "sense_definition": "В значительной мере, в большой степени",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>сильно</w> проголодался после долгой прогулки в лесу.",
                            "target_lang_translations": {
                                "en": "He got <w>very</w> hungry after a long walk in the forest."
                            }
                        },
                        {
                            "text": "Мороз <w>сильно</w> щипал лицо, поэтому пришлось надеть шарф.",
                            "target_lang_translations": {
                                "en": "The frost was biting <w>hard</w> at my face, so I had to put on a scarf."
                            }
                        }
                    ],
                    "synonyms": [
                        "о́чень",
                        "крайне",
                        "изрядно"
                    ],
                    "antonyms": [
                        "мало"
                    ],
                    "common_phrases": [
                        "сильно проголодаться",
                        "сильно щипать"
                    ],
                    "target_lang_definitions": {
                        "en": "To a significant extent or high degree."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "greatly",
                                "target_lang_sense_clarification": "To a great extent or degree."
                            },
                            {
                                "target_lang_word": "very much",
                                "target_lang_sense_clarification": "To a high degree."
                            },
                            {
                                "target_lang_word": "heavily",
                                "target_lang_sense_clarification": "To a considerable degree or extent."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "877c3b81-c7da-3def-ad07-1f2ae2731327",
                    "sense_definition": "Интенсивно, активно, с высокой частотой или скоростью",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Металл <w>сильно</w> испаряется при очень высоких температурах.",
                            "target_lang_translations": {
                                "en": "Metal evaporates <w>intensely</w> at very high temperatures."
                            }
                        },
                        {
                            "text": "Двигатель <w>сильно</w> нагревается во время длительной работы.",
                            "target_lang_translations": {
                                "en": "The engine heats up <w>significantly</w> during prolonged operation."
                            }
                        }
                    ],
                    "synonyms": [
                        "интенси́вно",
                        "акти́вно"
                    ],
                    "common_phrases": [
                        "сильно испаряться",
                        "сильно нагреваться"
                    ],
                    "target_lang_definitions": {
                        "en": "Intensively, actively, or with high frequency/speed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intensely",
                                "target_lang_sense_clarification": "In an extreme or very strong way."
                            },
                            {
                                "target_lang_word": "powerfully",
                                "target_lang_sense_clarification": "In a powerful or vigorous manner."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8019ebe-170c-3806-8cdc-d0219674928f",
                    "sense_definition": "Впечатляюще, убедительно, мастерски",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Актер <w>сильно</w> сыграл свою роль в новом фильме.",
                            "target_lang_translations": {
                                "en": "The actor gave an <w>impressive</w> performance in the new film."
                            }
                        },
                        {
                            "text": "Его аргументы звучали очень <w>сильно</w> и убедительно.",
                            "target_lang_translations": {
                                "en": "His arguments sounded very <w>convincing</w> and persuasive."
                            }
                        }
                    ],
                    "synonyms": [
                        "впечатля́юще",
                        "убеди́тельно"
                    ],
                    "common_phrases": [
                        "сильно сыграть",
                        "звучать сильно"
                    ],
                    "target_lang_definitions": {
                        "en": "Impressively, convincingly, or with great skill."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impressively",
                                "target_lang_sense_clarification": "In a manner that evokes admiration or respect."
                            },
                            {
                                "target_lang_word": "convincingly",
                                "target_lang_sense_clarification": "In a way that makes someone believe something is true."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4099041c-4179-35f0-bc55-184ba631b45d",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>сильный</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его желание победить было <w>сильно</w>.",
                            "target_lang_translations": {
                                "en": "His desire to win was <w>strong</w>."
                            }
                        },
                        {
                            "text": "Влияние этого события на общество было очень <w>сильно</w>.",
                            "target_lang_translations": {
                                "en": "The impact of this event on society was very <w>strong</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective 'strong' (neuter singular)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strong",
                                "target_lang_sense_clarification": "Having great power or influence."
                            }
                        ]
                    }
                }
            ]
        }
    ]
