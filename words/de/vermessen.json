            "senses": [
                {
                    "sense_id": "200a7847-f225-39e8-9ce8-bb8292725a06",
                    "sense_definition": "Von maßloser Selbstüberschätzung oder Überheblichkeit zeugend; anmaßend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "presumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es wäre <w>vermessen</w>, zu glauben, dass wir dieses anspruchsvolle Vorhaben an einem einzigen Tag beenden können."
                        },
                        {
                            "text": "Viele Beobachter hielten seine Forderung nach einem Rücktritt des gesamten Vorstands für völlig <w>vermessen</w>."
                        }
                    ],
                    "common_phrases": [
                        "für vermessen halten",
                        "ein vermessenes Vorhaben"
