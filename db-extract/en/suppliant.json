                "senses": [
                    {
                        "sense_id": "a8d40ca3-5868-34d7-97b5-fbd4898f2913",
                        "entry_id": "7e0a5e1d-0dda-34f6-8b16-bf0bc4ef9077",
                        "glosses": [
                            "Entreating with humility; supplicant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca9e245-4bb2-41f6-ad65-eb19dbed7b7f",
                                "sense_id": "a8d40ca3-5868-34d7-97b5-fbd4898f2913",
                                "text": "to bow and sue for grace with suppliant knee"
                            },
                            {
                                "example_id": "ce0b6386-a455-44ff-8236-3362d2f6e5bc",
                                "sense_id": "a8d40ca3-5868-34d7-97b5-fbd4898f2913",
                                "text": "Some plaques formed part of a mosaic that covered human life with its varied scenes of peace and war. Here we have warriors, the Cretan erect, and his darker-skinned enemy prostrate and suppliant."
                            },
                            {
                                "example_id": "422a3329-8322-4374-9120-687a767596ea",
                                "sense_id": "a8d40ca3-5868-34d7-97b5-fbd4898f2913",
                                "text": "Oedipus, King of my country, you can see our ages who are before your door; some it may be too young for such a journey, and some too old, Priests of Zeus such as I, and these chosen young men; while the rest of the people crowd the market-places with their suppliant branches, for the city stumbles towards death, hardly able to raise up its head"
                            }
                        ]
                    },
                    {
                        "sense_id": "9ca47814-94a7-31c8-8ffb-206237bb98e5",
                        "entry_id": "7e0a5e1d-0dda-34f6-8b16-bf0bc4ef9077",
                        "glosses": [
                            "Supplying; auxiliary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c11359b-16c5-4e36-8fa3-4839f9534757",
                                "sense_id": "9ca47814-94a7-31c8-8ffb-206237bb98e5",
                                "text": "your levy Must be suppliant"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd10bd93-4a08-41bb-a93e-c090ddff356a",
                        "source_entry_id": "7e0a5e1d-0dda-34f6-8b16-bf0bc4ef9077",
                        "source_sense_description": "entreating with humility",
                        "target_lang_word": "suppliant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suppliant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                        "entry_id": "40c4f9d1-7598-3a37-b052-bc9c8ac11bc5",
                                        "glosses": [
                                            "Qui supplie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8888d3-78cf-47d6-bdcc-8c5977200d42",
                                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                                "text": "Il se jeta à ses pieds tout suppliant."
                                            },
                                            {
                                                "example_id": "9c05aa47-c00f-47ec-b1ba-2e894d24c2a2",
                                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                                "text": "Une posture suppliante."
                                            },
                                            {
                                                "example_id": "33b83f64-85dd-45ac-bb35-07f3792e928e",
                                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                                "text": "Il s’est adressé à moi en termes suppliants."
                                            },
                                            {
                                                "example_id": "b1d69fa7-eef7-40ac-a3b5-3400eccf8f44",
                                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                                "text": "Il faut vieillir. Ne pleure pas, ne joins pas des doigts suppliants, ne te révolte pas il faut vieillir. Répète-toi cette parole, non comme un cri de désespoir, mais comme le rappel d’un départ nécessaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suppliant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a7c765-c8af-3776-b81a-10ed18c6f07d",
                                        "entry_id": "65d38555-ba6b-3321-a3ab-664b2c03d432",
                                        "glosses": [
                                            "Celui qui supplie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45d6c0c-7352-4446-ac56-f90a6aaf06c3",
                                                "sense_id": "a5a7c765-c8af-3776-b81a-10ed18c6f07d",
                                                "text": "Autrefois à Avignon il suffisoit de s'adresser à un bulliste, ou d'écrire à un ami qui lui exposoit, sans nommer le suppliant, le cas dont il s'agissoit ; et ce bulliste procuroit le bref de la pénitencerie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suppliant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0108530a-f66f-3540-aab6-0ff334cde895",
                                        "entry_id": "6a7fb6a0-d1ad-3963-b812-c0a2270af4f6",
                                        "glosses": [
                                            "Participe présent de supplier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6e5bdfd-47b1-4444-934a-14fe048894bd",
                                                "sense_id": "0108530a-f66f-3540-aab6-0ff334cde895",
                                                "text": "Leurs voix devenaient tremblantes, ils auraient tendu les bras, pleurant, suppliant qu’on les sauvât de cette abondance, de ce pain à bon marché qui menaçait le pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
