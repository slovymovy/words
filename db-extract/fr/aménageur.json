                        "sense_id": "4f870524-00fa-32e6-881d-b92eb2a708d8",
                        "entry_id": "9db57d10-2a19-35f7-b376-debe4e49b0a6",
                        "glosses": [
                            "Homme en charge de l'aménagement, d'une cuisine par exemple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725ad344-dc5d-4003-ab82-c094af95dbe5",
                                "sense_id": "4f870524-00fa-32e6-881d-b92eb2a708d8",
                                "text": "Un aménageur de cuisine."
                            },
                            {
                                "example_id": "8311adb1-acca-43f6-8ba8-cf73ca3d93d6",
                                "sense_id": "4f870524-00fa-32e6-881d-b92eb2a708d8",
                                "text": "S'appuyant aussi sur des plans, des croquis et des schémas explicatifs reproduits au fil des chapitres, les auteurs décrivent minutieusement les prouesses tactiques de ces constructions, les conditions de vie des troglodytes, les dispositifs liés à l'éclairage, à la ventilation, à l'art de la défense et les dilemmes techniques rencontrés par les aménageurs."
                            },
                            {
                                "example_id": "b3c27816-6e5a-4d7d-b542-d3f884afbe26",
                                "sense_id": "4f870524-00fa-32e6-881d-b92eb2a708d8",
                                "text": "Au total, les aménageurs prévoient l’équivalent de dix-huit terrains de foot de surface de bâtiments à construire."
                            }
                        ]
                    }
