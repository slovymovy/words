{
    "word_family": [
        "deponieren",
        "Deponie",
        "Deponierung"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e20843f1-009b-3323-8ca4-b25de7ecd271",
                    "sense_definition": "Ort, Raum oder Gebäude zur geschützten Aufbewahrung und Lagerung von Gegenständen, Waren oder Vorräten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Arbeiter bringen die gelieferten Waren sofort in das sichere <w>Depot</w>."
                        },
                        {
                            "text": "Wegen des großen Streiks sind alle Kisten im zentralen <w>Depot</w> geblieben."
                        }
                    ],
                    "synonyms": [
                        "Lager",
                        "Lagerort",
                        "Lagerraum",
                        "Speicher"
                    ],
                    "common_phrases": [
                        "im Depot lagern"
                    ]
                },
                {
                    "sense_id": "f36eb442-6e76-33eb-b73a-1fa4e5f30a25",
                    "sense_definition": "Spezielles Konto bei einer Bank oder einem Broker zur Verwahrung und Verwaltung von Wertpapieren wie Aktien oder Fonds",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat beschlossen, ein neues <w>Depot</w> für seine Aktien und Anleihen zu eröffnen."
                        },
                        {
                            "text": "Wegen der fallenden Kurse an der Börse verlor sein <w>Depot</w> stark an Wert."
                        }
                    ],
                    "common_phrases": [
                        "ein Depot eröffnen",
                        "Aktien im Depot"
                    ]
                },
                {
                    "sense_id": "3c27d157-59f9-307c-beb9-bc4f0757147f",
                    "sense_definition": "Halle oder Betriebshof zum Abstellen, Warten und Reparieren von öffentlichen Verkehrsmitteln wie Bussen oder Straßenbahnen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "traffic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kurz vor Mitternacht kehren die letzten Busse der Linie in das <w>Depot</w> zurück."
                        },
                        {
                            "text": "Die Straßenbahn steht zur dringenden Reparatur und Inspektion im städtischen <w>Depot</w>."
                        }
                    ],
                    "synonyms": [
                        "Bahnbetriebswerk",
                        "Betriebshof",
                        "Wagenhalle"
                    ],
                    "common_phrases": [
                        "ins Depot fahren"
                    ]
                },
                {
                    "sense_id": "f62c7c23-8e9e-3f44-b444-bc53131d88f7",
                    "sense_definition": "Geldbetrag, der als Sicherheit für geliehene Gegenstände oder Mehrwegflaschen hinterlegt wird",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deposit_fee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für diese Glasflasche müssen Kunden beim Kauf zwei Franken <w>Depot</w> bezahlen."
                        },
                        {
                            "text": "Sobald Sie das geliehene Geschirr unbeschädigt zurückgeben, erhalten Sie das bezahlte <w>Depot</w> wieder."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "schweizerisch"
                        }
                    ],
                    "synonyms": [
                        "Pfand",
                        "Kaution"
                    ]
                },
                {
                    "sense_id": "e19122bd-c3cc-3c81-b587-389ee70dfc62",
                    "sense_definition": "Fester Rückstand oder Bodensatz, der sich bei länger lagernden Weinen am Boden der Flasche absetzt",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Sommelier dekantierte den alten Rotwein vorsichtig, damit das bittere <w>Depot</w> in der Flasche blieb."
                        },
                        {
                            "text": "Nach zwanzig Jahren Reifezeit hat sich am Flaschenboden ein feines <w>Depot</w> gebildet."
                        }
                    ],
                    "synonyms": [
                        "Bodensatz"
                    ],
                    "common_phrases": [
                        "ein Depot bilden"
                    ]
                }
            ]
        }
    ]
}