                    "frequency": "Middle",
                    "semantic_group_id": "hodowla",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ogrodnik z pasją <w>rozmnaża</w> rzadkie odmiany róż w swojej szklarni.",
                            "target_lang_translations": {
                                "en": "The gardener passionately <w>propagates</w> rare rose varieties in his greenhouse."
                            }
                        },
                        {
                            "text": "Naukowcy w laboratorium próbują skutecznie <w>rozmnażać</w> zagrożone wyginięciem płazy.",
                            "target_lang_translations": {
                                "en": "Scientists in the laboratory are trying to successfully <w>breed</w> endangered amphibians."
                            }
                        }
                    ],
                    "synonyms": [
