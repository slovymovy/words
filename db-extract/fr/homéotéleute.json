                ],
                "senses": [
                    {
                        "sense_id": "cadd7f97-db73-3aab-a9cb-4808b3fed8b2",
                        "entry_id": "f405d766-8693-39e2-9849-cb4964647fa1",
                        "glosses": [
                            "Figure de style qui consiste en la répétition d’une ou de plusieurs syllabes finales homophones, soit de mots, de vers ou de phrase."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "0621b502-65f9-402c-a630-0947c177873c",
                                "sense_id": "cadd7f97-db73-3aab-a9cb-4808b3fed8b2",
                                "text": "L’homéotéleute, par des termes ou sons répétés créant un tout phonique cohérent, vise à produire un effet de mise en relief des sentiments ou une harmonie imitative."
                            },
                            {
                                "example_id": "84944eb7-170c-461a-b022-490b439478a2",
                                "sense_id": "cadd7f97-db73-3aab-a9cb-4808b3fed8b2",
                                "text": "Accumulation de terminaisons diminutives, désignées techniquement par le mot savant homéotéleutes, qu’imitera plaisamment Raymond Queneau dans une des pages les plus réussies de ses Exercices de style : Homéotéleutes « Un jour de canicule sur un véhicule où je circule, gesticule un funambule au bulbe minuscule » — (François Rigolot, Poésie et Renaissance, Seuil, 2002)"
                            },
                            {
                                "example_id": "c71b59bd-c6e2-406d-9ed0-d5949d7ccd6d",
                                "sense_id": "cadd7f97-db73-3aab-a9cb-4808b3fed8b2",
                                "text": "Les rimes et les assonances sont des homéotéleutes."
                            }
                        ]
                    }
                ],
