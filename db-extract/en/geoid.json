                        "source_sense_id": "7ce7cfc5-a6aa-350a-b128-ed799099d0ea",
                        "source_sense_description": "surface of constant gravitational potential at zero elevation",
                        "target_lang_word": "géoïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géoïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6912c782-14da-3e2a-9ff4-88f1d1bb3148",
                                        "entry_id": "c9d594d8-6eda-32c1-ac82-ba1cc17c1ba8",
                                        "glosses": [
                                            "Représentation de la surface terrestre plus précise que l’approximation sphérique ou ellipsoïdale, qui correspond à une équipotentielle dans le champ de gravité terrestre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf66de51-c644-433b-a1b9-ae27ea932b08",
                                                "sense_id": "6912c782-14da-3e2a-9ff4-88f1d1bb3148",
                                                "text": "[…], c'est que la Terre n'a pas vraiment la forme d'un ellipsoïde. Ses renflements l’apparentent plutôt à une pomme de terre. Il serait malséant de la baptiser ainsi : aussi appellerons-nous géoïde la figure schématique dont elle se rapproche le plus."
                                            },
                                            {
                                                "example_id": "a085761e-c190-4273-ba4b-85debb2ea260",
                                                "sense_id": "6912c782-14da-3e2a-9ff4-88f1d1bb3148",
                                                "text": "Le géoïde joue un rôle crucial de référentiel pour les mesures précises de la circulation océanique, du changement du niveau de la mer ainsi que pour une meilleure compréhension des processus en cours à l'intérieur même de la Terre (La Terre, foyer de l'humanité, est surnommée la planète bleue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5168006a-467e-3478-b830-2122ac131b85",
                                        "entry_id": "c9d594d8-6eda-32c1-ac82-ba1cc17c1ba8",
                                        "glosses": [
                                            "Surface de niveau du champ de pesanteur terrestre, prolongeant sous les terres émergées la surface moyenne des océans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3630684-1390-305f-9798-cec848f513d1",
                                        "entry_id": "c9d594d8-6eda-32c1-ac82-ba1cc17c1ba8",
                                        "glosses": [
                                            "Surface de niveau définie à partir d’un modèle mathématique de la pesanteur terrestre, choisie pour être convenablement voisine du géoïde réel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
