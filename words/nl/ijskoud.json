{
    "word_family": [
        "ijs",
        "koud",
        "ijskast",
        "ijspegel",
        "koude",
        "verkoudheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9108c24e-245b-3b5f-94e0-b41edd17133d",
                    "sense_definition": "Met de temperatuur van ijs, of zo koud als ijs aanvoelt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temperatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was bang om in het <w>ijskoude</w> water te vallen.",
                            "target_lang_translations": {
                                "en": "He was afraid of falling into the <w>ice-cold</w> water."
                            }
                        },
                        {
                            "text": "Na de lange wandeling door de sneeuw dronken we een glas <w>ijskoud</w> water.",
                            "target_lang_translations": {
                                "en": "After the long walk through the snow, we drank a glass of <w>ice-cold</w> water."
                            }
                        }
                    ],
                    "synonyms": [
                        "steenkoud",
                        "doodkoud",
                        "inkoud",
                        "stervenskoud"
                    ],
                    "antonyms": [
                        "bloedheet",
                        "kokendheet"
                    ],
                    "common_phrases": [
                        "ijskoud water",
                        "ijskoude wind"
                    ],
                    "target_lang_definitions": {
                        "en": "Having the temperature of ice, or feeling as cold as ice."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ice-cold",
                                "target_lang_sense_clarification": "extremely cold temperature"
                            },
                            {
                                "target_lang_word": "icy",
                                "target_lang_sense_clarification": "resembling or containing ice"
                            },
                            {
                                "target_lang_word": "freezing",
                                "target_lang_sense_clarification": "at or below the freezing point"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d331cbd2-87a5-3996-869b-bc812f316d5b",
                    "sense_definition": "Met een zeer lage temperatuur; bijzonder kil of vriezend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>ijskoude</w> nacht en ik werd meerdere malen bibberend wakker.",
                            "target_lang_translations": {
                                "en": "It was a <w>bitterly cold</w> night and I woke up shivering several times."
                            }
                        },
                        {
                            "text": "In het laboratorium wordt dit experiment uitgevoerd met <w>ijskoud</w> gas.",
                            "target_lang_translations": {
                                "en": "In the laboratory, this experiment is carried out with <w>frigid</w> gas."
                            }
                        }
                    ],
                    "synonyms": [
                        "steenkoud",
                        "inkoud"
                    ],
                    "antonyms": [
                        "snikheet"
                    ],
                    "common_phrases": [
                        "ijskoude nacht",
                        "ijskoud gas"
                    ],
                    "target_lang_definitions": {
                        "en": "Having a very low temperature; particularly chilly or freezing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bitterly cold",
                                "target_lang_sense_clarification": "intensely and painfully cold"
                            },
                            {
                                "target_lang_word": "frigid",
                                "target_lang_sense_clarification": "very cold in temperature"
                            },
                            {
                                "target_lang_word": "freezing cold",
                                "target_lang_sense_clarification": "extremely low temperature"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "682072ae-81bc-368d-8ea7-a267ddcfcac4",
                    "sense_definition": "Onverstoorbaar en zonder enig medegevoel of emotie; geheel rustig onder spanning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks de enorme druk bleef de verdachte er <w>ijskoud</w> onder.",
                            "target_lang_translations": {
                                "en": "Despite the enormous pressure, the suspect remained <w>unfazed</w>."
                            }
                        },
                        {
                            "text": "Hij keek me aan met een <w>ijskoude</w> blik die me rillingen bezorgde.",
                            "target_lang_translations": {
                                "en": "He looked at me with an <w>icy</w> stare that gave me chills."
                            }
                        }
                    ],
                    "antonyms": [
                        "hartelijk",
                        "warm"
                    ],
                    "common_phrases": [
                        "ijskoude blik",
                        "ijskoud blijven"
                    ],
                    "target_lang_definitions": {
                        "en": "Imperturbable and without any sympathy or emotion; completely calm under pressure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stone-cold",
                                "target_lang_sense_clarification": "showing no emotion or reaction"
                            },
                            {
                                "target_lang_word": "icy",
                                "target_lang_sense_clarification": "unfriendly or hostile in manner"
                            },
                            {
                                "target_lang_word": "cold-blooded",
                                "target_lang_sense_clarification": "without feeling or mercy"
                            },
                            {
                                "target_lang_word": "unfazed",
                                "target_lang_sense_clarification": "remaining calm and undisturbed"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}