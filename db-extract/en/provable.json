                                    {
                                        "sense_id": "f22ddf78-76d1-30c6-b59d-3de274d33d6c",
                                        "entry_id": "7e3d9844-fc0a-3839-8eaf-8271efe1ccbd",
                                        "glosses": [
                                            "mit Hilfe von Belegen nachweisbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c7079c-be75-4caf-b6bb-ea1767d8f006",
                                                "sense_id": "f22ddf78-76d1-30c6-b59d-3de274d33d6c",
                                                "text": "„Dass Handys, Smartphones oder Festplatten teurer würden, seien Horrormeldungen der Internetoffensive, die nicht belegbar seien, zumal der Handel die Vergütungen bereits bisher einpreise und kassiere.“"
                                            },
                                            {
                                                "example_id": "83983fba-9660-4139-906f-66402dfd1dde",
                                                "sense_id": "f22ddf78-76d1-30c6-b59d-3de274d33d6c",
                                                "text": "„Belegbar sind schriftliche Nachweise aus Mesopotamien, einem Gebiet, das sich im heutigen Irak und teilweise Syrien befand, in dem Moment, wo die ersten Schriftzeichen entstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb84de19-278e-4544-84c2-0a71577a19b9",
                        "source_entry_id": "2b8d41d7-6b9a-3e87-a2c1-3f24d3206c8f",
                        "source_sense_id": "53c7ef6a-126f-31b3-9ee6-c85af2fd73ad",
                        "source_sense_description": "of a statement or hypothesis, that can be proven",
                        "target_lang_word": "beweisbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beweisbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "406d8a14-34bf-372d-9578-973b807386e8",
                                        "entry_id": "679bf7ea-690f-32cc-bf3c-9ffe4ce60ec4",
                                        "glosses": [
                                            "sich mit Fakten, Belegen und/oder Schlussfolgerungen beweisen, begründen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f135aab-de71-4246-bb34-a3ce4dcb66dc",
                                                "sense_id": "406d8a14-34bf-372d-9578-973b807386e8",
                                                "text": "„Eine große Skepsis hegt Father Brown gegen Menschen, die nur wissenschaftlich beweisbare Tatsachen als wahr gelten lassen.“"
                                            },
                                            {
                                                "example_id": "c34d3458-5ee3-40c4-91b8-f818994f1602",
                                                "sense_id": "406d8a14-34bf-372d-9578-973b807386e8",
                                                "text": "„Teils befangen, teils patzig sagt er zum Beispiel: ‚Meine Welt besteht doch nicht nur aus beweisbaren Fakten, meine Welt besteht auch aus Annahmen, aus Eventualitäten, die sich mir aufdrängen, so sehr aufdrängen, dass ich dann von ihnen ausgehe, dass von ihnen mein Verhalten bestimmt wird. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "551bbc72-de54-46b0-987a-5daf4519eb65",
                        "source_entry_id": "2b8d41d7-6b9a-3e87-a2c1-3f24d3206c8f",
                        "source_sense_id": "53c7ef6a-126f-31b3-9ee6-c85af2fd73ad",
                        "source_sense_description": "of a statement or hypothesis, that can be proven",
                        "target_lang_word": "nachweislich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachweislich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63791b3d-be9e-3cb8-bf99-8fd56ad004f1",
                                        "entry_id": "f246c9c0-ece6-360c-b077-d9f72bfd77ba",
                                        "glosses": [
                                            "beweisbar; so beschaffen, dass der Beweis erbracht worden ist oder jederzeit erbracht werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9466b3e0-b161-4e37-886e-0525badeaa06",
                                                "sense_id": "63791b3d-be9e-3cb8-bf99-8fd56ad004f1",
                                                "text": "Der Beklagte hat den Raum nachweislich betreten, da dort sowohl seine Fingerabdrücke als auch signifikante genetische Spuren von ihm gefunden wurden."
                                            },
                                            {
                                                "example_id": "95511709-16b9-44bf-8e47-62d38c1f4099",
                                                "sense_id": "63791b3d-be9e-3cb8-bf99-8fd56ad004f1",
                                                "text": "„Für wie selbstsüchtig man den Menschen auch halten mag, es gibt nachweislich einige Grundlagen seines Wesens, die dazu führen, dass er sich für das Schicksal anderer interessiert, deren Glück ihm notwendig erscheint, obwohl er nichts davon hat außer dem Vergnügen, es zu sehen.“ - Adam Smith, Die Theorie der ethischen Gefühle"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
