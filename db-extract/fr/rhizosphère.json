        "fr-extract.jsonl": [
            {
                "entry_id": "e6235ca0-7883-3823-8cfd-cda4475429be",
                "word": "rhizosphère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "61143ef4-e3b1-44b1-b8d9-e7f9376939d9",
                        "entry_id": "e6235ca0-7883-3823-8cfd-cda4475429be",
                        "tags": [
                            "plural"
                        ],
                        "form": "rhizosphères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6903873-6e38-3b26-bb30-bcb5e1a2b92a",
                        "entry_id": "e6235ca0-7883-3823-8cfd-cda4475429be",
                        "glosses": [
                            "Région du sol formée et influencée par les racines et les micro-organismes associés, qui peut être affectée par le tassement, l’ennoiement, la salinisation, l’eutrophisation ou la pollution du sol, ou encore par des phénomènes d’aridification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183fe6f6-f9ee-4f14-b756-0e9e66039493",
                                "sense_id": "a6903873-6e38-3b26-bb30-bcb5e1a2b92a",
                                "text": "La rhizosphère est une zone d’intense activité microbiologique et biochimique en raison de l’exsudation de nutriments organiques et minéraux par les plantes."
                            },
                            {
                                "example_id": "2a6a76f3-145e-42c5-9530-92ac8ade0c27",
                                "sense_id": "a6903873-6e38-3b26-bb30-bcb5e1a2b92a",
                                "text": "Comme une force cachée qui vous élance pour vous stimuler encore : à l'évidence qu’il n’y aura plus de futur, le passé s’amplifie, ses racines grossissent, tout en moi est rhizosphère, les couleurs se cristallisent sur chaque strate, la moindre image touche à son absolu, le cœur bat crescendo."
                            },
                            {
                                "example_id": "8f4aa18b-5ebc-4e53-88fb-22cd4a31bc22",
                                "sense_id": "a6903873-6e38-3b26-bb30-bcb5e1a2b92a",
                                "text": "Les organismes vivants de la rhizosphère jouent un rôle dans la dissolution de près de 30 % du calcaire du substrat."
                            }
                        ]
                    }
                ],
