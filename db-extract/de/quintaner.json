                "senses": [
                    {
                        "sense_id": "31fdbf08-c367-3498-acd3-5b4eba311746",
                        "entry_id": "a1b18039-4798-3d07-8d2f-247a2605a6c3",
                        "glosses": [
                            "Schüler, der in der Quinta ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00fde2a3-faf7-49d9-be50-31e1ca8f7905",
                                "sense_id": "31fdbf08-c367-3498-acd3-5b4eba311746",
                                "text": "„Immerhin waren sie keine Sextaner oder Quintaner mehr, sondern Tertianer, zwei Jahre vor dem Einjährigen.“"
                            },
                            {
                                "example_id": "0120c89b-50c8-4f4c-a4e9-26c94e7ef447",
                                "sense_id": "31fdbf08-c367-3498-acd3-5b4eba311746",
                                "text": "„Nur noch Ludwig, der Quintaner, besuchte die Höhere Schule - unverdrossen, jeden Morgen von Lea mit einem frischen Hemd versehen, fuhr er mit dem Rad zum Realgymnasium Averhoffstraßen auf der Uhlenhorst.“"
                            },
                            {
                                "example_id": "68d7b9ed-5c1b-4d84-94e5-1d3963238ef2",
                                "sense_id": "31fdbf08-c367-3498-acd3-5b4eba311746",
                                "text": "„Bruder Bernhard, das Nesthäkchen, der Quintaner, verkroch sich geradezu hinter der Mutter - dieser schmähliche Petzer!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
