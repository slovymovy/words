                "senses": [
                    {
                        "sense_id": "f5f439da-8754-3143-b87d-36411fc4ea77",
                        "entry_id": "b3d5ee99-39d4-37e9-86b2-67b37ad0be59",
                        "glosses": [
                            "Fahrt mit einer Kutsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7611e0-71da-46ea-849a-dcb1b9c7b214",
                                "sense_id": "f5f439da-8754-3143-b87d-36411fc4ea77",
                                "text": "„Sein Schlüsselerlebnis dürfte eine recht gewagte Kutschfahrt zu einem Gefecht bei Neapel gewesen sein, das sich Engländer und Franzosen liefern.“"
                            },
                            {
                                "example_id": "c546075d-e3b2-467d-b734-1ffe0b6e5272",
                                "sense_id": "f5f439da-8754-3143-b87d-36411fc4ea77",
                                "text": "„Auf einer Kutschfahrt nach Tiefurt muss Wieland ihm detailliert ausgestellt haben, was ihm an seinen Produkten missfällt und woran er noch zu arbeiten habe.“"
                            },
                            {
                                "example_id": "bd6b05c3-0466-4375-941f-4d60360727a2",
                                "sense_id": "f5f439da-8754-3143-b87d-36411fc4ea77",
                                "text": "„Jede Abwesenheit Ribbentrops nutzte von Lehndorff, um Mitverschwörer wie Henning von Tresckow und Helmuth James Graf von Moltke zu empfangen, mit denen er auf Kutschfahrten und Spaziergängen den Anschlag auf den Diktator und den Sturz des Regimes plante.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
