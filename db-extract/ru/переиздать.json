                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d57142f-10e5-47c3-b77b-52f877e9da88",
                        "source_entry_id": "1abf5329-6d93-3e1d-ae3d-28564def55db",
                        "source_sense_id": "aa5a167b-e0e3-31e4-8243-f91b6d85a2e5",
                        "target_lang_word": "republish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "republish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c152aee-955f-3963-beac-242c1e57a38d",
                                        "entry_id": "b00863c2-f837-3c17-9d92-df4e1a5aee9c",
                                        "glosses": [
                                            "To publish once again; to print and distribute copies of a work that has previously been printed and distributed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb0cc35-ecc1-4dfe-8884-f31cae1eee7e",
                                                "sense_id": "0c152aee-955f-3963-beac-242c1e57a38d",
                                                "text": "To remove a custom thumbnail and use the Aquafadas DPS automatically generated thumbnail of the article, click the Delete button and republish or repreview the article or project."
                                            },
                                            {
                                                "example_id": "b5e9cac6-f31f-42b0-996c-5f829fd87d57",
                                                "sense_id": "0c152aee-955f-3963-beac-242c1e57a38d",
                                                "text": "There may be no taboo greater in Germany than to republish Adolf Hitler's manifesto, \"Mein Kampf.\" But historians in Munich are breaking it."
                                            },
                                            {
                                                "example_id": "35fd59eb-b381-4f67-a10a-2b964b12ee33",
                                                "sense_id": "0c152aee-955f-3963-beac-242c1e57a38d",
                                                "text": "While American Herald Tribune pays some contributors like King for original content, it also republishes articles from elsewhere and then lists the people who wrote those articles as contributors to its site."
                                            },
                                            {
                                                "example_id": "200a5bcb-4362-4fe8-ba0b-ebf61ba16da4",
                                                "sense_id": "0c152aee-955f-3963-beac-242c1e57a38d",
                                                "text": "The New York Post also temporarily took down and then revised and republished an article about the Fox reporter’s exchange with White House Press Secretary Jen Psaki on Monday."
                                            },
                                            {
                                                "example_id": "f4f3177b-aee4-4d75-ab17-90ce01bcb306",
                                                "sense_id": "0c152aee-955f-3963-beac-242c1e57a38d",
                                                "text": "And in both cases, a man named Rob Monster – an outspoken born-again Christian and the CEO of a tech company called Epik – made pointed restorations, republishing much of the New Zealand content and putting Gab back online. All in the name, he said, of free speech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1a93deb-c0ba-4f92-9dc7-f4481d312337",
                        "source_entry_id": "1abf5329-6d93-3e1d-ae3d-28564def55db",
                        "source_sense_id": "aa5a167b-e0e3-31e4-8243-f91b6d85a2e5",
                        "target_lang_word": "reprint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                                        "entry_id": "9a739f39-60b4-3210-ba8d-111d016bdcc6",
                                        "glosses": [
                                            "A book, pamphlet or other printed matter that has been published once before but is now being released again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "745d2a71-63e9-4ea1-8914-2e6e0e969696",
                                                "sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                                                "text": "The reprint is much less expensive than a first edition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2177de-d791-3393-99be-0d9cae382e79",
                                        "entry_id": "90c0121b-1c8a-3477-b171-024026e7d6c4",
                                        "glosses": [
                                            "To print (something) that has been published in print before."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2db2772-b998-44c1-ad6e-29ed51f7aef1",
                                                "sense_id": "0a2177de-d791-3393-99be-0d9cae382e79",
                                                "text": "The novel was printed with an appendix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea623e80-06ee-39bf-a981-bd55f1055006",
                                        "entry_id": "90c0121b-1c8a-3477-b171-024026e7d6c4",
                                        "glosses": [
                                            "To renew the impression of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781083eb-9bab-4aa9-beda-8a2c9aca468e",
                                                "sense_id": "ea623e80-06ee-39bf-a981-bd55f1055006",
                                                "text": "The whole business of our redemption is […] to reprint God's image upon the soul."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "458f6471-d3c2-4835-9e95-8bd5442eaef3",
                        "source_entry_id": "1abf5329-6d93-3e1d-ae3d-28564def55db",
                        "source_sense_id": "aa5a167b-e0e3-31e4-8243-f91b6d85a2e5",
                        "target_lang_word": "reissue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reissue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4da317e-1773-32fe-a032-e8be31f68d7d",
                                        "entry_id": "0469a2c9-b67e-328e-8fd8-458dadb75bdd",
                                        "glosses": [
                                            "To issue again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a6b672-169a-44b7-8536-61f2dea1df7d",
                                                "sense_id": "e4da317e-1773-32fe-a032-e8be31f68d7d",
                                                "text": "Many of his numerous recordings have been re-digitized, enhanced and re-issued to a grateful public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8012f2d-ed80-31d1-939a-e1cb5d1fa552",
                                        "entry_id": "0469a2c9-b67e-328e-8fd8-458dadb75bdd",
                                        "glosses": [
                                            "To reprint a series of postage stamps from old plates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b985e76b-d15c-303b-915f-d65cf2a0dbd2",
                                        "entry_id": "0469a2c9-b67e-328e-8fd8-458dadb75bdd",
                                        "glosses": [
                                            "In patent law: to permit a patent with ministerial errors to be corrected and enforced for the remainder of the original term of the patent."
