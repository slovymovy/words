                        "examples": [
                            {
                                "example_id": "9c8c447b-f233-4ba3-a5a3-7ee7d23af40a",
                                "sense_id": "1dc7514a-64f2-3846-bf49-611d0a0dae5d",
                                "text": "De ondertitel van de door Rob Sijmons geschreven uitgave luidt: ”Feiten en mythen over ons voedsel”. Daar staat het kleine boekje dus vol mee. Een voorbeeld: „De plantaardige vleesvervangers in de supermarkt zijn onnatuurlijker dan de baklap uit de bio-industrie; maar hoe erg is dat?”"
                            },
                            {
                                "example_id": "ccd69293-5300-4281-b93a-eb4890e04bd3",
                                "sense_id": "1dc7514a-64f2-3846-bf49-611d0a0dae5d",
                                "text": "Dunne ronde plakjes snijden met een zeer scherp mes van de aubergine op de plaats waar ze het dikst is. Deze plakjes op een geoliede bakplaat of baklap plaatsen. Kruiden met peper en zout, en besprenkelen met enkele druppeltjes olijfolie."
                            }
                        ]
                    }
