                                                "example_id": "3673df85-f087-44bd-983d-4571b3145547",
                                                "sense_id": "efe0e1b5-cf77-3c30-873d-7ccb65193116",
                                                "text": "'The human bean,' the Giant went on, 'is coming in dillions of different flavours. […]"
                                            },
                                            {
                                                "example_id": "35f36517-75a2-4184-95c4-9e6658467190",
                                                "sense_id": "efe0e1b5-cf77-3c30-873d-7ccb65193116",
                                                "text": "He'd been sitting in the car for a dillion years waiting for his mother to find her glasses."
                                            },
                                            {
                                                "example_id": "bce7a73b-89d6-4b6c-ac02-c44489d558a7",
                                                "sense_id": "efe0e1b5-cf77-3c30-873d-7ccb65193116",
                                                "text": "You have like a dillion books here, probably nobody would have even looked at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98ad5cc7-f641-4781-b056-fcaed9a7bfc4",
                        "source_entry_id": "746e45a7-d49c-300f-88d2-44f903099d2d",
                        "source_sense_id": "fc133a25-2bf6-3a01-b9ad-a2fa23ee770e",
                        "target_lang_word": "gazillion",
