                "senses": [
                    {
                        "sense_id": "ab26ddb5-8bac-38f7-aa75-241f8f4c6c40",
                        "entry_id": "2158cd52-af71-37da-a788-b96cf6e82813",
                        "glosses": [
                            "aktives oder passives Eindringen von Viren in einen Organismus, das Infiziertwerden/Sichanstecken eines Organismus mit einem Virus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5160cfa-d4b0-4b63-8f02-fc66d8abadbc",
                                "sense_id": "ab26ddb5-8bac-38f7-aa75-241f8f4c6c40",
                                "text": "Ich sah ein Mädchen, das eine Gesichtsmaske trägt, um eine Virusinfektion zu vermeiden und die Ausbreitung der Krankheit zu verhindern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0292596-0b60-3ad8-91f3-eda09ebddd02",
                        "entry_id": "2158cd52-af71-37da-a788-b96cf6e82813",
                        "glosses": [
                            "Infektionskrankheit, die durch ein Virus verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3e5c485-00ce-40dc-947f-fce5e934e93d",
                                "sense_id": "c0292596-0b60-3ad8-91f3-eda09ebddd02",
                                "text": "„Die Hepatitis C ist eine Virusinfektion, von der viele Betroffene in Deutschland gar nicht wissen, dass sie infiziert sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1dd0cd4f-2d72-3894-9412-6785a0ed67a3",
                        "entry_id": "2158cd52-af71-37da-a788-b96cf6e82813",
                        "glosses": [
                            "Infiziertwerden eines Computers mit einem Computervirus, Schadsoftware"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "823c407c-2279-49b8-9697-6f73f7dcd6cf",
                                "sense_id": "1dd0cd4f-2d72-3894-9412-6785a0ed67a3",
                                "text": "„Es gibt eine Reihe von Hinweisen, die für eine Virusinfektion [eines PCs] typisch sind.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
