                ],
                "senses": [
                    {
                        "sense_id": "737e9aaa-1d14-3c9d-9c74-9265a74fbde5",
                        "entry_id": "eefbc82d-12d0-3d07-8820-ac3d33ddcf1d",
                        "glosses": [
                            "Peignoir, vêtement que l’on met en sortant du bain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8811635c-1c88-454b-bd18-70d2dad6cf5a",
                                "sense_id": "737e9aaa-1d14-3c9d-9c74-9265a74fbde5",
                                "text": "Nach dem Baden zieh ich mir immer meinen Bademantel an, setze mich auf den Balkon und lese ein Buch.",
                                "translation": "Après un bain, j’enfile toujours mon peignoir, je m’installe sur le balcon et lis un livre."
                            },
                            {
                                "example_id": "f5fe5bb2-c3bb-432c-8bd6-1bbaedef07ab",
                                "sense_id": "737e9aaa-1d14-3c9d-9c74-9265a74fbde5",
                                "text": "Ken öffnet im Bademantel und seufzt, als er die Pizzaschachtel in den Händen des Boten sieht. Aber bevor er auch nur ein Wort sagen kann, fällt die leere Schachtel zu Boden, und Blake rammt ihm die Läufe zweier Elektroschocker auf die Brust.",
                                "translation": "Ken ouvre, en peignoir, soupire en voyant le carton à pizza dans les mains du livreur. Mais avant qu’il ait le temps de dire un mot, le carton vide tombe, et Blake écrase sur sa poitrine l’embout de deux matraques électriques."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
