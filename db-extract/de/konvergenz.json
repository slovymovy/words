                    {
                        "sense_id": "daaad251-fbfb-39e8-9ffc-3bd5c3ac20ca",
                        "entry_id": "5d423fd5-07e1-3f4a-8a41-2cd2e6905a5a",
                        "glosses": [
                            "das Sich-Aufeinander-zu-Entwickeln von zwei oder mehreren divergierenden Ausgangszuständen auf einen gemeinsamen Endzustand hin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0c4699-caa1-42f3-9b78-54888022de8d",
                                "sense_id": "daaad251-fbfb-39e8-9ffc-3bd5c3ac20ca",
                                "text": "Man kann eine Konvergenz der Medien Internet und Fernsehen feststellen, was sich nicht zuletzt in der Vielzahl an Livestream Angeboten widerspiegelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cb0b80df-1086-38a9-894d-c597e4fa804c",
                        "entry_id": "5d423fd5-07e1-3f4a-8a41-2cd2e6905a5a",
                        "glosses": [
                            "eine unabhängige, aber ähnliche Entwicklung von Körpermerkmalen bei verschiedenen Arten aufgrund ähnlicher Bedingungen im Verlaufe der Evolution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62f24a8-33fc-47fd-82df-9b860a5e39b4",
                                "sense_id": "cb0b80df-1086-38a9-894d-c597e4fa804c",
                                "text": "Die in ihrem Aufbau sehr ähnlichen Augen der Wirbeltiere und der Tintenfische ist auf eine Konvergenz zurückzuführen, anatomisch erkennbar an der Lage der Netzhaut."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "69d375dc-571d-320c-93f8-9b9a6b1ef46c",
                        "entry_id": "5d423fd5-07e1-3f4a-8a41-2cd2e6905a5a",
                        "glosses": [
                            "eine bestimmte Stellung der Augen, bei der sich die Blicklinien unmittelbar vor den Augen schneiden"
                        ],
                        "tags": [
                            "Sinnesphysiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c752d25e-c6c0-435e-aebd-cf9f1318b2ce",
                                "sense_id": "69d375dc-571d-320c-93f8-9b9a6b1ef46c",
                                "text": "Die Konvergenz ist dadurch verursacht, dass sich die beiden Pupillen der Augen in Richtung Nase bewegen müssen, wenn sie ein nahe liegendes Objekt betrachten wollen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ad159a3e-24e3-3ed4-8db0-76696941e319",
