                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95e0e3e-0d47-4c07-ac16-ed4953ae12b4",
                                "sense_id": "bd5324c7-cb7f-381f-8734-60d78eee6056",
                                "text": "Het bijdehante meisje haalde allemaal goede punten voor haar proefwerken."
                            },
                            {
                                "example_id": "57d101fb-4e43-42f1-936d-9fc04fb7aec5",
                                "sense_id": "bd5324c7-cb7f-381f-8734-60d78eee6056",
                                "text": "Ik ben slechts een gesjeesde studente kunstgeschiedenis die precies op het verkeerde moment de bijdehante psychologe uit wil hangen."
                            }
                        ]
                    },
                    {
                        "sense_id": "604fdb7f-b308-3f03-b332-6b3938ae9c8a",
                        "entry_id": "0ab8a80a-148f-3337-a167-9a26e1a94590",
                        "glosses": [
                            "brutaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99859033-8948-4baf-8758-880ef4a86147",
                                "sense_id": "604fdb7f-b308-3f03-b332-6b3938ae9c8a",
                                "text": "De bijdehante jongen had zijn weerwoord gelijk klaar."
                            }
                        ]
                    }
