                                        "sense_id": "84232d5b-8562-3456-8372-93f7751f381a",
                                        "entry_id": "1ab00d4e-450f-38fd-ad25-b0c973492237",
                                        "glosses": [
                                            "vertikale Entfernung der einzelnen Zeilen voneinander in einem geschriebenen/gedruckten Text"
                                        ],
                                        "tags": [
                                            "Typografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c48031-87f9-4e5a-9fa1-fd2b6ba8f8d3",
                                                "sense_id": "84232d5b-8562-3456-8372-93f7751f381a",
                                                "text": "Jens druckte die ersten Entwürfe seiner Magisterarbeit immer mit großem Zeilenabstand aus, damit er bequem handschriftliche Korrekturen und Ergänzungen einfügen konnte."
                                            },
                                            {
                                                "example_id": "9f13431a-1a2c-48ae-9067-ab8631beef8e",
                                                "sense_id": "84232d5b-8562-3456-8372-93f7751f381a",
                                                "text": "„Ihre Geschichte passte leicht auf eine DIN-A₄-Seite, mit großer Schrift und doppeltem Zeilenabstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
