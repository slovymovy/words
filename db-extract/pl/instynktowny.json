                                        "glosses": [
                                            "Driven by impulse, spontaneous and without thinking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258010f8-1439-4a66-a09f-02ddf173f7a3",
                                                "sense_id": "5276f37c-5569-33d9-9af1-584fa31b77b6",
                                                "text": "When approached by a stranger, Jared clenched his fists in an instinctive manner."
                                            }
