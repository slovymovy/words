                        "entry_id": "a3400422-ef03-32f8-8d08-3de30fdb4f70",
                        "glosses": [
                            "Femme ayant des origines d’Inde, généralement du Tamil Nadu ou du Kerala."
                        ],
                        "tags": [
                            "La Réunion"
                        ],
                        "examples": [
                            {
                                "example_id": "04db674c-9ad1-429c-aa8a-2b305403179f",
                                "sense_id": "936a8f0c-5b92-343a-ab35-751a8d735dbb",
                                "text": "C’est une malbaraise, une descendante de ces familles indiennes arrivées sur l’île au siècle dernier."
                            },
                            {
                                "example_id": "eac49177-aa22-48ef-9203-63dcac709c70",
                                "sense_id": "936a8f0c-5b92-343a-ab35-751a8d735dbb",
                                "text": "Pendant des heures, il regardait sur internet ces beaux visages métissés, « cafrine de feu », peux dorées par le soleil des tropiques, « malbaraises » aux yeux noirs, créoles rousse aux « codindes » ensoleillées."
                            }
                        ]
                    }
