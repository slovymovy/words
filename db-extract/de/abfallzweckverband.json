                "senses": [
                    {
                        "sense_id": "908fc0fe-a1a8-39b8-8957-395984f5f219",
                        "entry_id": "f01f5ddc-1e80-3e17-ba71-ef0e016904b8",
                        "glosses": [
                            "Verband speziell zum Zweck der Abfallentsorgung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1705dd0d-d9b5-46dc-853d-5bf2536ce474",
                                "sense_id": "908fc0fe-a1a8-39b8-8957-395984f5f219",
                                "text": "„Der im brandenburgischen Teltow-Fläming tätige Südbrandenburgische Abfallzweckverband setzt auf ein System, bei dem Küchenabfälle im Restmüll bleiben und mit ihm zusammen getrocknet, zerkleinert und sortiert werden.“"
                            },
                            {
                                "example_id": "4883ad63-dc99-47d8-accf-15e398d81170",
                                "sense_id": "908fc0fe-a1a8-39b8-8957-395984f5f219",
                                "text": "„Zunehmend zum Haushaltsmüll kämen laut Ministerium in den letzten Jahren auch asbesthaltige Baustoffe, verunreinigte Gemische aus Bau- und Abbruchabfällen und Dachpappen dazu. […] Vor allem die berlinnahen Landkreise, kreisfreien Städte und Abfallzweckverbände hätten mit diesen Problemen zu kämpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
