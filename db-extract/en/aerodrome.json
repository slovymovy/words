                                    {
                                        "sense_id": "89f368f6-2311-328d-96a2-f73e5b6367f8",
                                        "entry_id": "78165be2-67aa-3a7d-91b0-0c2be5fb35a6",
                                        "glosses": [
                                            "een terrein waar vliegtuigen kunnen landen en opstijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11045bdc-d074-442e-84a5-b488dade43e4",
                                                "sense_id": "89f368f6-2311-328d-96a2-f73e5b6367f8",
                                                "text": "Dit vliegveld is onlangs aangelegd om de slechte bereikbaarheid van deze regio te verbeteren."
                                            },
                                            {
                                                "example_id": "88bb231c-51f3-4e7d-89db-be742b3e822c",
                                                "sense_id": "89f368f6-2311-328d-96a2-f73e5b6367f8",
                                                "text": "Vandaag wordt bij verschillende Nederlandse vliegvelden gedemonstreerd door mensen die vinden dat de overlast en de vervuiling door de luchtvaart de spuigaten uit loopt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e2bf71-102a-4de2-a19b-35783763e569",
                        "source_entry_id": "a213c6ab-cc4d-349f-ab85-9a130084be40",
