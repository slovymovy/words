                                        "sense_id": "611d3c7d-38b4-37f2-a618-7c5cf9b4a4c8",
                                        "entry_id": "6b42abdf-7d17-3faf-81b5-46f56ef3b4e9",
                                        "glosses": [
                                            "Fear or hatred of cissexuality or cisgenderism, or of cis individuals."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0582e501-ca4b-4024-bf0f-f7472ad87e5c",
                                                "sense_id": "611d3c7d-38b4-37f2-a618-7c5cf9b4a4c8",
                                                "text": "One could then speak of 'cisphobia' or 'heterophobia', claiming adequate protection for cisgender and straight persons."
                                            },
                                            {
                                                "example_id": "c68ee05e-41f4-47be-a242-0147c0dfc7c6",
                                                "sense_id": "611d3c7d-38b4-37f2-a618-7c5cf9b4a4c8",
                                                "text": "Piers Morgan has claimed to be the “victim of cisphobia” after several members of the transgender community blasted his ignorance on Twitter."
                                            },
                                            {
                                                "example_id": "4067377e-fb96-4827-8e3a-a50661b1b35a",
                                                "sense_id": "611d3c7d-38b4-37f2-a618-7c5cf9b4a4c8",
                                                "text": "Most of the time this leads to white boys screaming about cisphobia and reverse racism, but that's the post when everyone just ignores them and lets them wallow in their ignorance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
