                "senses": [
                    {
                        "sense_id": "c8f0afb1-9dfe-3309-bfac-70172ed53253",
                        "entry_id": "5ffedf86-44cf-363e-9cfd-cb1d08bd5b34",
                        "glosses": [
                            "Kriegsschiff, das unter anderem der Aufklärung und Sicherung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a402043e-0a74-4eb5-b4c6-4a148d2500a2",
                                "sense_id": "c8f0afb1-9dfe-3309-bfac-70172ed53253",
                                "text": "„Wir ließen das Vorpostenboot, das keinen Namen, sondern nur eine Nummer trug, das einen verlorenen, zumindest aber hoffnungslosen Eindruck machte, auf uns wirken.“"
                            },
                            {
                                "example_id": "67a73e93-51f2-4ead-80a9-0c5394b6237a",
                                "sense_id": "c8f0afb1-9dfe-3309-bfac-70172ed53253",
                                "text": "„Der auf dem Vorpostenboot in dieser Nacht zufällig diensttuende Flotillenarzt fühlte den matten Pulsschlag des Säuglings, begann mit Belebungsübungen, wagte eine Kampferspritze und ließ nicht nach, bis das Kind, ein Junge, die Augen aufschlug.“"
                            },
                            {
                                "example_id": "52c6fd68-d713-498c-9789-4d6564f02886",
                                "sense_id": "c8f0afb1-9dfe-3309-bfac-70172ed53253",
                                "text": "„Mein erstes Seekommando war auf einem Vorpostenboot, dem »Seebär«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
