                "senses": [
                    {
                        "sense_id": "7589772c-bd9e-30d7-9c5d-5f59baacf369",
                        "entry_id": "a2805a16-afae-3067-8095-963b49fca6f7",
                        "glosses": [
                            "Branche de l’écologie qui étudie l’effet de radio-isotopes sur l’environnement ou étudie un cycle naturel grâce à des traceurs radio-isotopiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f3f6aa-ec06-4427-8831-2d322adb3e2a",
                                "sense_id": "7589772c-bd9e-30d7-9c5d-5f59baacf369",
                                "text": "La radioécologie peut intéresser les chercheurs fondamentaux, qui utilisent les radionucléides comme traceurs des cycles biogéochimiques."
                            },
                            {
                                "example_id": "f73d670a-ea1d-4cd0-b60d-d37c68effb80",
                                "sense_id": "7589772c-bd9e-30d7-9c5d-5f59baacf369",
                                "text": "La radioécologie est l’étude du comportement des radionucléides dans l’ensemble de la biosphère ou dans tel ou tel écosystème particulier: petit vivier expérimental, serre ou écosystème artificiel de 10 000 hectares - grandes exploitation en altitude moyenne d’élevage de moutons ou de culture de céréales."
                            }
                        ]
                    }
