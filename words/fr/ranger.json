    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b83a736-660b-3cf6-8c65-b9e0245e728a",
                    "sense_definition": "Mettre en ordre un lieu ou les objets qui s'y trouvent.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants doivent <w>ranger</w> leur chambre avant de sortir jouer."
                        },
                        {
                            "text": "Il passe toujours une heure à <w>ranger</w> son bureau le vendredi soir."
                        }
                    ],
                    "synonyms": [
                        "ordonner"
                    ],
                    "antonyms": [
                        "déranger"
                    ],
                    "common_phrases": [
                        "ranger sa chambre",
                        "ranger son bureau"
                    ]
                },
                {
                    "sense_id": "e39d81a5-8987-322b-b9fd-938a042bd71a",
                    "sense_definition": "Remettre ou placer un objet à l'endroit qui lui est réservé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>ranger</w> les assiettes propres dans le placard de la cuisine."
                        },
                        {
                            "text": "Après chaque cours, elle <w>range</w> ses cahiers dans son sac à dos."
