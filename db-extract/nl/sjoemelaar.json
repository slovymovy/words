            {
                "entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                "word": "sjoemelaar",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "73077fe9-3f01-477e-85bc-93d70f12538f",
                        "entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                        "tags": [
                            "plural"
                        ],
                        "form": "sjoemelaars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
                        "entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                        "glosses": [
                            "iemand die oneerlijk is, iemand die fraudeert (zonder dat dit overduidelijk is)"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "302db4c0-5ead-4459-9dc8-b7359705db76",
                                "sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
                                "text": "Het is ook om die reden dat ik sta te trappelen om u opnieuw te helpen bij het opsporen en het voor draaiende camera’s ontmaskeren van fraudeurs en andere sjoemelaars."
                            },
                            {
                                "example_id": "c1da7844-51f7-42c2-813d-c5c740650ced",
                                "sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
                                "text": "Het is weer tijd voor de aangifte inkomstenbelasting. Staatssecretaris Wiebes zei dat sjoemelaars weinig kans maken, omdat De Belastingdienst ‘goed oplet’. Maar een dikke meerderheid van de stellingdeelnemers (71 procent) gelooft dat niet."
                            },
                            {
                                "example_id": "9ac9acfb-722d-4b5a-8fbd-3c699cb6a474",
                                "sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
                                "text": "Ter voorkoming dat het anti-Europees sentiment zodanig groeit, dat een uiteenvallen niet te voorkomen is, verzoek ik ons parlement zich sterk te maken voor een strenge controle en sjoemelaars te verwijderen uit het EP. Geef populisten geen kans."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3b611c2-3007-35fc-99d9-d34dd72643ff",
                        "entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                        "glosses": [
                            "valsspeler bij het kaarten"
                        ],
                        "tags": [
                            "obsolete",
                            "vernacular"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b08da67e-0e12-4d1a-aec3-b7034c457f73",
                        "source_entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                        "source_sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
