                    {
                        "sense_id": "8b96c037-2279-3d5d-bc87-4ca8c5280e5e",
                        "entry_id": "39dbf663-fd0d-3c14-a547-ec3bbd05df47",
                        "glosses": [
                            "A blow with the side of something, such as the side of car that is changing lanes incautiously."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8d5beb74-d298-311a-aec9-d978d361c351",
                        "entry_id": "39dbf663-fd0d-3c14-a547-ec3bbd05df47",
                        "glosses": [
                            "A catty or sarcastic remark."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "824df6e0-91d1-4f50-b4c3-f086c704844e",
                                "sense_id": "8d5beb74-d298-311a-aec9-d978d361c351",
                                "text": "Calvin Harris's number-ten hit Acceptable in the 80s is both a wry sideswipe and a celebration of the scene;[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49d63625-8acb-44c4-acd0-b081e0ec2167",
                        "source_entry_id": "39dbf663-fd0d-3c14-a547-ec3bbd05df47",
                        "source_sense_description": "a sarcastic remark",
                        "target_lang_word": "Seitenhieb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seitenhieb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "457d9df1-0b58-3d07-b380-4e882a659687",
                                        "entry_id": "24c7ed87-3e20-3641-8111-021777be51ca",
                                        "glosses": [
                                            "jemandem seitlich versetzter Schlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb4babe-0d6a-4f2d-bd8b-a69d9a8d939f",
                                                "sense_id": "457d9df1-0b58-3d07-b380-4e882a659687",
                                                "text": "„Er parierte die Stöße mit seinem langen Korbdegen oder wich ihnen mit wunderbarer Behendigkeit aus, führte auch zwischendurch einmal einen Seitenhieb auf seine Gegner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05c020f1-c24d-3b5f-8baf-79cd0d97638b",
                                        "entry_id": "24c7ed87-3e20-3641-8111-021777be51ca",
                                        "glosses": [
                                            "Kritik, spöttische Bemerkung, die nicht Hauptinhalt der Äußerung ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73be0de8-9eb4-41b8-a070-70788491064e",
                                                "sense_id": "05c020f1-c24d-3b5f-8baf-79cd0d97638b",
                                                "text": "„Einen Seitenhieb auf die Schwesterpartei konnte sich Huber nicht verkneifen und beklagte, es habe keinen Rückenwind aus der Bundespolitik gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
