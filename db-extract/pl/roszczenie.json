                        "target_lang_word": "Anspruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anspruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0265d9e-aea8-3a1c-82e5-b5b49033f656",
                                        "entry_id": "be3aa2a6-b499-3901-9d30-7e793180265b",
                                        "glosses": [
                                            "berechtigte Forderung an etwas oder jemanden: Forderung, Erwartung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa209d9-a7f6-41ab-9b83-5904dd9e0aa5",
                                                "sense_id": "a0265d9e-aea8-3a1c-82e5-b5b49033f656",
                                                "text": "Als Chef stellte er allerhöchste Ansprüche an sich selbst und an seine Mitarbeiter."
                                            },
                                            {
                                                "example_id": "3cd196ba-a33f-4d26-ad9c-a74eee394369",
                                                "sense_id": "a0265d9e-aea8-3a1c-82e5-b5b49033f656",
                                                "text": "Er konnte dem an ihn gestellten Anspruch zu keiner Zeit gerecht werden."
                                            },
                                            {
                                                "example_id": "d85151d2-1cee-41ca-b8f9-d595b5c09654",
                                                "sense_id": "a0265d9e-aea8-3a1c-82e5-b5b49033f656",
                                                "text": "Mein Beruf nimmt mich zur Zeit vollkommen in Anspruch."
                                            },
                                            {
                                                "example_id": "15380254-7b68-42b9-8230-587686c0878b",
                                                "sense_id": "a0265d9e-aea8-3a1c-82e5-b5b49033f656",
                                                "text": "Er nahm ihre Menschenfreundlichkeit und Hilfsbereitschaft über Gebühr in Anspruch."
                                            },
                                            {
                                                "example_id": "b11c4a46-ef9b-43e3-a9d8-4b2221193187",
                                                "sense_id": "a0265d9e-aea8-3a1c-82e5-b5b49033f656",
                                                "text": "„Man soll nicht zu große Ansprüche an Ärzte stellen, ist einer schlau, hat er bald das Abrakadabra der guten alten weisen Frauen begriffen, und an Stelle von roten Schutzbändchen und magischen Sprüchlein liefert er das Seinige.“"
                                            },
                                            {
                                                "example_id": "d1cd9de0-5a49-411d-a4f0-ce6e1cff6903",
                                                "sense_id": "a0265d9e-aea8-3a1c-82e5-b5b49033f656",
                                                "text": "„Das Deltafliegen stellt besonders hohe Ansprüche an die körperliche Leistungsfähigkeit, die physisch-technische Kompetenz, die Geländebeurteilung, das Erspüren von Aufwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb1c4ddd-b287-3341-8ea8-633d53994c8c",
                                        "entry_id": "be3aa2a6-b499-3901-9d30-7e793180265b",
                                        "glosses": [
                                            "Recht, etwas zu tun, zu erhalten und Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d75b01-245e-4a08-b24e-4d32d0427701",
                                                "sense_id": "cb1c4ddd-b287-3341-8ea8-633d53994c8c",
                                                "text": "Für diesen Sondereinsatz hat er einen Anspruch auf Zeitausgleich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
