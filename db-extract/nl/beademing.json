                        "glosses": [
                            "het proces waarbij mensen die niet voldoende zelfstandig kunnen ademen, lucht krijgen uit een externe bron (mond-op-mond of via een machine), kunstmatige beademing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d2862b-92da-4380-ab75-682a5aa256ae",
                                "sense_id": "4ae6e207-f682-35cc-9c2e-a6aba71b7ad3",
                                "text": "Ze zijn direct met beademing en hartmassage begonnen."
                            },
                            {
                                "example_id": "49601e43-c6eb-4592-baba-d6bb6970ce36",
                                "sense_id": "4ae6e207-f682-35cc-9c2e-a6aba71b7ad3",
                                "text": "Tussen de bedrijven door trok hij zich terug in zijn werkkamer, las en herlas Salma's nagelaten testament, terwijl hij met toegeknepen ogen aan een sigaret zoog alsof hij aan de beademing zat."
                            }
                        ]
                    }
                ],
