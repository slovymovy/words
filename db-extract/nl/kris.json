                        "examples": [
                            {
                                "example_id": "ad6f8593-68c4-4102-bd2f-191c4bdea8d9",
                                "sense_id": "c7c1fb20-8978-3e90-b05b-236628cec23a",
                                "text": "De kris geldt als een van de heiligdommen (pusaka) van een familie, clan, dynastie of een koninkrijk. Deze krissen worden van vader op zoon doorgegeven."
                            },
                            {
                                "example_id": "dd83d0db-2b43-456b-83e0-9dc08006e708",
                                "sense_id": "c7c1fb20-8978-3e90-b05b-236628cec23a",
                                "text": "Daàr zièt hij op den grond het al zwartige rood, en hij schrikt, hij voelt zich ijskoud, en hij loopt met het lampje om, om niet over een kris te loopen, een mooi sierwapen, dat papa gisteren van den Regent heeft cadeau gekregen!"
                            }
                        ]
                    }
