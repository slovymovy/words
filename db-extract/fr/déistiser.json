                "senses": [
                    {
                        "sense_id": "d119d60f-c9d5-3220-8275-db1bb3ab8afb",
                        "entry_id": "ad7f1691-735d-3baf-b906-5e0a2e75ce11",
                        "glosses": [
                            "Donner un caractère déiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c8f70b-fae5-46e8-9758-90ae756a12a2",
                                "sense_id": "d119d60f-c9d5-3220-8275-db1bb3ab8afb",
                                "text": "Nous avons cru un moment que Lassay pouvait nous mettre sur la piste de l’auteur de ce manuscrit clandestin, voire même qu’il avait pu autrefois l’écrire et n’en confier à l’imprimé qu’une sorte d’abrégé « déistisé » par le travail de l’âge ou la prudence."
                            },
                            {
                                "example_id": "2c2badb9-b34e-409f-b53b-db2f95262bdd",
                                "sense_id": "d119d60f-c9d5-3220-8275-db1bb3ab8afb",
                                "text": "Des influences des grands thèmes des Puritains de son temps, mais humanistisées et déistisées."
                            },
                            {
                                "example_id": "750397c7-8b57-4022-939b-34a1322ad831",
                                "sense_id": "d119d60f-c9d5-3220-8275-db1bb3ab8afb",
                                "text": "C'est un déiste christianisé. Ou un chrétien déistisé."
                            }
                        ]
                    }
                ],
