                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3445b638-ea3d-44a8-afcb-fe9d2e0b893b",
                                "sense_id": "d21613ad-9f5e-3716-b607-f155863bdb0c",
                                "text": "Want als alle andere hulpmiddelen tekortschieten, als God een volk of een kerk niet geheel verlaten wil, dan wijst Hij ons dit gestadig aan als de enige weg tot de behoudenis daarvan (Jeremia 31:31-33; Ezechiël 11:17-19; 36:25-27)."
                            },
                            {
                                "example_id": "6fae8a13-c47b-478a-bd05-bfd5e4959206",
                                "sense_id": "d21613ad-9f5e-3716-b607-f155863bdb0c",
                                "text": "Hij hoorde wel het geloei en het gereutel van de offerdieren, maar had er zelf nooit iets van gezien. Zo zijn wij van nature blind voor de weg der behoudenis.”"
                            }
                        ]
                    }
