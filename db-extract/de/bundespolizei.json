                ],
                "senses": [
                    {
                        "sense_id": "6d535e32-1058-3c6b-9e5c-a18c769bff76",
                        "entry_id": "93549a6a-e2bf-354f-96f3-c63fa53af9fa",
                        "glosses": [
                            "zentrale Polizei in der Trägerschaft und Verantwortung eines föderalen Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96f27b22-546c-46f6-9559-fb2d1d6c1733",
                                "sense_id": "6d535e32-1058-3c6b-9e5c-a18c769bff76",
                                "text": "Die Bundespolizei ist dem Innenminister der Bundesrepublik Deutschland untergeordnet."
                            },
                            {
                                "example_id": "5999afde-4c54-4da9-95d2-ecff45f9fecb",
                                "sense_id": "6d535e32-1058-3c6b-9e5c-a18c769bff76",
                                "text": "„Weil die örtliche Polizei in den Mord an Dutzenden Studenten verstrickt sein soll, haben Armee und Bundespolizei die Kontrolle in der Stadt Iguala im Süden Mexikos übernommen.“"
                            },
                            {
                                "example_id": "c4b6eecc-221b-4156-88d1-9efd0d80dabb",
                                "sense_id": "6d535e32-1058-3c6b-9e5c-a18c769bff76",
                                "text": "„Das GG gestattet die Errichtung von Bundespolizeien nur für bestimmte Aufgaben: […]“"
                            },
                            {
                                "example_id": "c3d041a7-5015-44d1-8cf9-8be372549797",
                                "sense_id": "6d535e32-1058-3c6b-9e5c-a18c769bff76",
                                "text": "„Ab 30 Grad darf auf die Schirmmütze verzichtet werden, so hat es der Präsident der Bundespolizei bestimmt.“"
                            },
                            {
                                "example_id": "b9b2d3fa-c8d9-4885-88bd-820380ee9611",
                                "sense_id": "6d535e32-1058-3c6b-9e5c-a18c769bff76",
                                "text": "„Die Suche ist aber erfolgreich; nicht zuletzt durch den Einsatz der Bundespolizei, von der einige Männer die unmittelbare Zone an der Zonengrenze von ihrer BGS- oder auch DDR-Zeit her recht gut kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
