                                                "sense_id": "01fff30d-c5d2-3bf3-ba34-7c2d669b72af",
                                                "text": "Der kleine Bock hatte seine Stangen verloren."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "f92d6ce0-e284-31bd-a8e3-102892017d91",
