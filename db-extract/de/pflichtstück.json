                "senses": [
                    {
                        "sense_id": "fdcbda2f-5e80-3ea2-b3e5-41c62ccb68ae",
                        "entry_id": "c73d093d-3fed-3c6a-adba-2da11fa9a60c",
                        "glosses": [
                            "von Büchern, Zeitschriften etc. ein Exemplar, das aufgrund gesetzlicher oder sonstiger Vorschriften vom Verlag, Drucker, Verleger, Autor an öffentliche Bibliotheken abzuliefern ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e71b84b-21ea-47c4-8406-4b76674d91df",
                                "sense_id": "fdcbda2f-5e80-3ea2-b3e5-41c62ccb68ae",
                                "text": "„Das Pflichtstück ist in vollständigem, einwandfreiem und unbenutztem Zustand, in handelsüblicher Einbandart, Tasche, Kassette oder im handelsüblichen Schuber abzuliefern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ae69aae2-e54c-3943-a39e-b05aae45c1ce",
                        "entry_id": "c73d093d-3fed-3c6a-adba-2da11fa9a60c",
                        "glosses": [
                            "eine musikalische, künstlerische Darbietung in einem Wettbewerb, die dargeboten werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3acbc941-4d42-44a0-b933-76c1c078f73c",
                                "sense_id": "ae69aae2-e54c-3943-a39e-b05aae45c1ce",
                                "text": "„Wer den ersten Durchgang mit dem üblichen Pflichtstück aller Cellisten, natürlich dem schwierigsten Haydn D-Dur-Konzert souverän meistert und die Sympathie des Orchesters genießt, kommt weiter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
