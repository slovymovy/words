                        "glosses": [
                            "Schleier oder Mantel, den die Statue der Göttin Tanit in Karthago trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37001e05-0e11-4b55-a88d-4d422ab75c12",
                                "sense_id": "b3c7c82c-2e9f-3f53-8cf9-2649e55e9138",
                                "text": "« Cela passait comme un manteau sous le visage de l’idole, et remontant étalé sur le mur, s’accrochait par les angles, tout à la fois bleuâtre comme la nuit, jaune comme l’aurore, pourpre comme le soleil, nombreux, diaphane, étincelant, léger. C’était là le manteau de la Déesse, le zaïmph saint que l’on ne pouvait voir. »"
                            }
                        ],
