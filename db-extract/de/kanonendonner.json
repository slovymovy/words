                    {
                        "sense_id": "858f069e-a807-3506-b756-5683fbf167ca",
                        "entry_id": "05c8c623-7600-3bed-b792-027db39b44ff",
                        "glosses": [
                            "Schusslärm von Kanonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7180109a-d0f6-4608-bdf6-e3b5fb9e34be",
                                "sense_id": "858f069e-a807-3506-b756-5683fbf167ca",
                                "text": "„Aus dem ununterbrochenen Kanonendonner konnte Martinez für Augenblicke Stimmen heraushören, aber dann waren sie wieder darin untergetaucht.“"
                            },
                            {
                                "example_id": "95b9293e-cf0c-4b9d-a1a2-ffefd33fe38e",
                                "sense_id": "858f069e-a807-3506-b756-5683fbf167ca",
                                "text": "„Er glaubte, einen kurzen dumpfen Schlag zu hören, der wie weit entfernter Kanonendonner klang.“"
                            },
                            {
                                "example_id": "03d2264b-8c2a-4f2c-b37c-c34b6bf1942a",
                                "sense_id": "858f069e-a807-3506-b756-5683fbf167ca",
                                "text": "„Der Kanonendonner wurde immer hörbarer.“"
                            },
                            {
                                "example_id": "02198422-6241-419c-9be7-d2fda2e5ee9e",
                                "sense_id": "858f069e-a807-3506-b756-5683fbf167ca",
                                "text": "„Da liegt die alte Frau, die Gosse ist ihr Sarg, der Kanonendonner ihr Grabgeläute, eine Reihe gefühlverlorener Menschen ihr Trauergefolge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
