                "senses": [
                    {
                        "sense_id": "5631d88f-6f3b-3aad-9f52-941ad8df8d6b",
                        "entry_id": "a01be8f4-7dbf-33f0-8834-ce8ce7507f60",
                        "glosses": [
                            "Bestand an Personal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ead8ef-900c-430b-85fe-3c8d3cd8a1fb",
                                "sense_id": "5631d88f-6f3b-3aad-9f52-941ad8df8d6b",
                                "text": "Die Umstrukturierung des Unternehmens soll keine Auswirkung auf den Personalbestand haben."
                            }
                        ],
