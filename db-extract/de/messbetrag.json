                "senses": [
                    {
                        "sense_id": "b8f102c4-4f3e-3047-ba3d-00d0b9ac9f85",
                        "entry_id": "2e4430e0-2319-38fb-8edb-63f0e33af227",
                        "glosses": [
                            "Rechengröße zur Ermittlung von Steuern und Ähnlichem"
                        ],
                        "tags": [
                            "Steuerrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "dce3b0f2-ff4c-4e30-949e-f7069bf8475f",
                                "sense_id": "b8f102c4-4f3e-3047-ba3d-00d0b9ac9f85",
                                "text": "„Um die Steuer zu berechnen, die Betriebe zahlen müssen, wird der Hebesatz mit einem bundeseinheitlichen Messbetrag multipliziert und durch 100 geteilt.“"
                            },
                            {
                                "example_id": "e1d060c7-26b6-40a7-b5e0-bc3b9307bb1f",
                                "sense_id": "b8f102c4-4f3e-3047-ba3d-00d0b9ac9f85",
                                "text": "„Fehlt ein früherer Meßbetrag für das Grundstück (wirtschaftliche Einheit), bestimmt sich das Ausmaß der Steuerbefreiung nach dem Verhältnis, in dem der sich nach der begünstigten Bauführung ergebende Meßbetrag zu jenem Meßbetragsteil steht, der dem gemäß § 53 Abs 2 des Bewertungsgesetzes 1955, BGBl Nr 148, in der Fassung des Gesetzes BGBl Nr 681/1994 gekürzten Bodenwert im Einheitswert- und Grundsteuermeßbescheid entspricht.“"
                            },
                            {
                                "example_id": "c8b854c2-cd78-4e0a-be67-72d76348dade",
                                "sense_id": "b8f102c4-4f3e-3047-ba3d-00d0b9ac9f85",
                                "text": "„Der Messbetrag ist von den Tarifvertragsparteien mit 4 € festgesetzt worden und ebenfalls statisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
