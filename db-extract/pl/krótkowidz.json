                ],
                "senses": [
                    {
                        "sense_id": "c05a0f13-ca7a-3903-9513-0daa1561e6e9",
                        "entry_id": "8ff2876e-f3c6-3192-922a-d9692af9f31e",
                        "glosses": [
                            "osoba źle, nieostro widząca obiekty będące daleko; krótkowzroczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b7132b-29ef-446d-90a0-e44159969127",
                                "sense_id": "c05a0f13-ca7a-3903-9513-0daa1561e6e9",
                                "text": "Piotrek był krótkowidzem i często nie widział piłek idących z daleka, ale za to z bliska… Imponował refleksem, skocznością i potrafił bronić w nieprawdopodobnych wręcz sytuacjach strzały z bliskiej odległości"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44d06452-11c8-4101-b67b-c266e2e66ff6",
                        "source_entry_id": "8ff2876e-f3c6-3192-922a-d9692af9f31e",
                        "source_sense_id": "c05a0f13-ca7a-3903-9513-0daa1561e6e9",
                        "target_lang_word": "myopic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myopic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                                        "entry_id": "5b1584b6-3359-3bdc-81ca-9442a39f8667",
                                        "glosses": [
                                            "Near-sighted; unable to see distant objects unaided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f46eec8-043a-468f-ae4e-946ef2626d18",
                                                "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                                                "text": "Corrective lenses compensate for the excessive positive diopters of the myopic eye."
                                            },
                                            {
                                                "example_id": "872e84b0-ec23-40fe-ad0f-f2569ebd4d07",
                                                "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                                                "text": "A stronger prescription for myopic night drivers is often needed."
                                            },
                                            {
                                                "example_id": "10b1f329-92ec-4632-a9f0-e64c12ba7b1e",
                                                "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                                                "text": "She yanked the paper from her motherʼs hands, bringing it very close to her myopic eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f6a25b-1914-3b9b-951d-d7bf372467d6",
                                        "entry_id": "5b1584b6-3359-3bdc-81ca-9442a39f8667",
                                        "glosses": [
                                            "Shortsighted; improvident."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d436a8b-1f15-4990-9fca-b7b0b2408e2c",
                                                "sense_id": "f8f6a25b-1914-3b9b-951d-d7bf372467d6",
                                                "text": "The real problem, he insists, is the myopic mentality that has failed to address climate change to date. The rich world’s indifference to the despoliation of the environment in pursuit of short-term economic gain is rooted in a wider problem."
                                            },
                                            {
                                                "example_id": "41ffab55-3e97-485b-b28f-e35b2904be36",
                                                "sense_id": "f8f6a25b-1914-3b9b-951d-d7bf372467d6",
                                                "text": "His postwar roles, full of myopic obsession, stalkerish derangement, and a desire for vengeance, don't seem like ground Hanks is willing to cover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a34f902b-62fa-35c3-bcb2-e45e81fe2b8b",
                                        "entry_id": "5b1584b6-3359-3bdc-81ca-9442a39f8667",
                                        "glosses": [
                                            "Narrow-minded."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "370de97d-b684-46a2-8f74-7965de364455",
                                                "sense_id": "a34f902b-62fa-35c3-bcb2-e45e81fe2b8b",
                                                "text": "Scientific advances can draw us outside of our myopic comfort zone."
                                            },
                                            {
                                                "example_id": "7c7ef5d8-506d-4210-96b1-3c39c15e9025",
                                                "sense_id": "a34f902b-62fa-35c3-bcb2-e45e81fe2b8b",
                                                "text": "Will you come testify in the court of myopic opinion / Or will you settle for oblivion?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "myopic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "946f17a9-30ff-34d8-9798-d2fcc5951b9d",
                                        "entry_id": "57e0bb68-ecda-3fdf-99c6-ec44f89e2837",
                                        "glosses": [
                                            "A short-sighted individual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2063bbd-fbcf-4804-84ea-973ea3982995",
                                                "sense_id": "946f17a9-30ff-34d8-9798-d2fcc5951b9d",
                                                "text": "The offbeat little girls of “Playdate,” whose mothers stumble through parenthood, are not the first characters to feel like cultural descendants of Salinger’s children, those savants, myopics, guileless nose pickers and practicing belchers who seem to glow on the page, highlighting the shallowness of the adults."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6fb4177-3791-4396-af17-1e940c33f49b",
                        "source_entry_id": "8ff2876e-f3c6-3192-922a-d9692af9f31e",
                        "source_sense_id": "c05a0f13-ca7a-3903-9513-0daa1561e6e9",
                        "target_lang_word": "myope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                        "entry_id": "7abf80ee-3751-3beb-b2dc-c8ed84506e47",
                                        "glosses": [
                                            "Qui a la vue fort courte et qui ne peut voir clairement les objets éloignés sans le secours d’un verre concave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8319f1a2-3b7b-4a3c-8c04-c7925fe4ac00",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "La myiodopsie que le malade éprouve depuis quelques années a probablement été causée par l'action de trop rapprocher les objets pendant le travail, lorsque déjà la presbytie commençait à se développer, tandis que notre confrère se croyait encore myope."
                                            },
                                            {
                                                "example_id": "0dbd8fd5-8a0d-4173-820a-a18be756cd4b",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "Ainsi, par exemple, l’œil myope d’une dyoptrie se trouve adapté à l’état de repos pour un objet placé à un mètre ; c’est à cette distance que se trouve son remotum."
                                            },
                                            {
                                                "example_id": "1f016bd0-628a-4f13-b3bb-14d54af1e93f",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "Avec un mouvement fébrile de la tête, comme en ont les myopes dans leurs instants d’émotion, sans doute pour secouer le brouillard qui obscurcit leurs yeux, M. Hyacinthe se lève."
                                            },
                                            {
                                                "example_id": "d83670c0-ea7f-4582-9be1-f85f3dc64f49",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "Cependant, une vaste étude rapportée par la BBC suggère que la proportion d'enfants myopes aurait largement augmenté depuis la pandémie de Covid-19, notamment en raison de l'augmentation du temps d'écran induit par les confinements. Aujourd'hui, plus d'un enfant sur trois serait myope dans le monde, avec des différences massives entre les régions. La recherche, publiée dans le British Journal of Ophtalmology, est plutôt alarmante: la myopie ne cesse d'augmenter et devrait affecter encore des millions d'enfants supplémentaires d'ici à 2050, pour atteindre un enfant sur deux. Pour l'instant, les taux les plus élevés se trouvent tous en Asie, avec 85% d'enfants myopes au Japon, 73% en Corée du Sud et plus de 40% en Russie ou en Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21cd40c5-3180-333f-b74b-24ebead53c8a",
                                        "entry_id": "7abf80ee-3751-3beb-b2dc-c8ed84506e47",
                                        "glosses": [
                                            "Étroit d’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327c1395-7bd6-4f9b-971e-80dc5a5736d8",
                                                "sense_id": "21cd40c5-3180-333f-b74b-24ebead53c8a",
                                                "text": "Ainsi, rien de plus myope que le point de vue de Plékhanov, repris par tous les opportunistes, et selon lequel il ne fallait pas pas entreprendre cette grève inopportune, « il ne fallait pas prendre les armes ». Au contraire, il fallait prendre les armes de façon plus résolue, plus énergique et dans un esprit plus offensif ; […]."
                                            },
                                            {
                                                "example_id": "b77b016a-4631-4e0a-b634-e95e934f1b89",
                                                "sense_id": "21cd40c5-3180-333f-b74b-24ebead53c8a",
                                                "text": "Vous êtes myope des yeux, myope du cœur et myope du cul !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "myope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58ae7495-ac8d-312d-b860-e32ee75368f2",
                                        "entry_id": "587d392a-7f58-39b8-8573-ca1b78f02988",
                                        "glosses": [
                                            "Celui, celle qui a la vue fort courte et qui ne peut voir les objets éloignés sans le secours d’un verre concave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8d7bcd-6f6c-4870-9aaa-e63621a477f2",
                                                "sense_id": "58ae7495-ac8d-312d-b860-e32ee75368f2",
                                                "text": "Un lorgnon, des lunettes de myope."
                                            },
                                            {
                                                "example_id": "c3db59a6-1313-45c9-97de-d2709eca7b25",
                                                "sense_id": "58ae7495-ac8d-312d-b860-e32ee75368f2",
                                                "text": "L’homme sursauta, se frotta les yeux ; instinctivement, d’un geste de myope, il prit dans son gilet de grosses lunettes rondes cerclées d’or."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf56b26-8d25-4785-8960-cb4c88842eba",
                        "source_entry_id": "8ff2876e-f3c6-3192-922a-d9692af9f31e",
                        "source_sense_id": "c05a0f13-ca7a-3903-9513-0daa1561e6e9",
                        "target_lang_word": "miope",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
