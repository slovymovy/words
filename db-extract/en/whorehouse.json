        "de-extract.jsonl": [
            {
                "entry_id": "fa679333-b0a7-3227-8e2e-df7008708c8b",
                "word": "whorehouse",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b11214a9-bfe8-31dc-b59c-d63543290021",
                        "entry_id": "fa679333-b0a7-3227-8e2e-df7008708c8b",
                        "glosses": [
                            "Bordell, Freudenhaus, Puff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6de665e-395d-4306-beee-bdbe8a31969a",
                                "sense_id": "b11214a9-bfe8-31dc-b59c-d63543290021",
                                "text": "He cringed at the thought of going to a whorehouse and knew that even if they found it, he wasn't going in."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "666e6169-7748-4fa0-94b5-d0e5a068f78f",
                        "source_entry_id": "fa679333-b0a7-3227-8e2e-df7008708c8b",
                        "source_sense_id": "b11214a9-bfe8-31dc-b59c-d63543290021",
                        "source_sense_description": "Bordell, Freudenhaus, Puff",
                        "target_lang_word": "Bordell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bordell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                        "entry_id": "170a0032-c752-328a-92c7-c118fa9cd33a",
                                        "glosses": [
                                            "Gebäude, in dem (meist) Frauen sexuelle Dienstleistungen gegen Entgelt anbieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f53f59b2-fcc5-47e5-be61-f032f287bd7d",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "Mein Mann würde nie in ein Bordell gehen!"
                                            },
                                            {
                                                "example_id": "d5e10ad1-bda1-4bf4-a282-a9cf00b11f18",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Es gab noch ein einziges Bordell, um ein einziges weibliches Wesen herum.“"
                                            },
                                            {
                                                "example_id": "be6e3d55-acf7-4514-8d42-6816d3891f09",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Am Heiligabend lockt ein gewisser Mister Dick, ein Nachbar, sie mit einer Lüge in ein Bordell, wo er sie mit Hilfe der Puffmutter vergewaltigt.“"
                                            },
                                            {
                                                "example_id": "54caaff9-2b52-4fe6-b122-a10a3ce96b96",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Die abendliche Fahrt von Versmold nach Werther hat einen gewissen subkulturellen Reiz, weil auf dem Weg immerhin drei Bordelle rotes Licht ins Dunkel bringen.“"
                                            },
                                            {
                                                "example_id": "ccc19dda-435a-4350-91a2-827947516d66",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Die Suche nach ihm in Bordellen und sonstigen, der Militärpolizei bekannten Absteigen blieb erfolglos; dem Boot fehlte der Kapitän.“"
                                            },
                                            {
                                                "example_id": "45d83d2f-1239-4899-a61c-0a8b9e59a962",
                                                "sense_id": "a4b02846-d99a-3b46-b82e-bc0dfbeb0015",
                                                "text": "„Als junger Mann hatte er einmal einen Kapitän im Bordell auslösen müssen, dem hatten sie die Hosen ausgzogen, weil er nicht bezahlen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a75dadd0-abdc-4d21-9282-26696c9ae141",
                        "source_entry_id": "fa679333-b0a7-3227-8e2e-df7008708c8b",
                        "source_sense_id": "b11214a9-bfe8-31dc-b59c-d63543290021",
                        "source_sense_description": "Bordell, Freudenhaus, Puff",
                        "target_lang_word": "Freudenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freudenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8205dea-0eeb-3a90-8cd8-4d1a7af58370",
                                        "entry_id": "211f661d-f830-3529-a7c8-e997e46cde1b",
                                        "glosses": [
                                            "Gebäude, in welchem sexuelle Dienstleistungen gegen Bezahlung angeboten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921d98b2-5b45-457c-b399-3e92dec5bf2f",
                                                "sense_id": "b8205dea-0eeb-3a90-8cd8-4d1a7af58370",
                                                "text": "In St. Pauli gibt es viele Freudenhäuser."
                                            },
                                            {
                                                "example_id": "4b7521f7-c633-4d02-b36a-966a35b4e4da",
                                                "sense_id": "b8205dea-0eeb-3a90-8cd8-4d1a7af58370",
                                                "text": "„Es soll nehmlich für die patres conscripti [Senatoren] des Congresses ein Hurenhaus, welches die Deutschen Gelehrten ein Freudenhaus zu nennen belieben, angelegt werden.“"
                                            },
                                            {
                                                "example_id": "bcc2848e-39f8-4d9b-829c-9cb67c84ba0f",
                                                "sense_id": "b8205dea-0eeb-3a90-8cd8-4d1a7af58370",
                                                "text": "„Am Nachmittag war dienstfrei, und ich wollte mir ein Freudenhaus ansehen, in der Erwartung, es werde irgendeinen orientalischen Charakter haben.“"
                                            },
                                            {
                                                "example_id": "a695b40f-c4f5-4f07-85da-b2910f5efd31",
                                                "sense_id": "b8205dea-0eeb-3a90-8cd8-4d1a7af58370",
                                                "text": "„Einer der Besitzer dieser drei Freudenhäuser witterte eine Chance zum Geldverdienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f58f2d8-bdf6-4f0b-b5b3-f20b04c165f6",
                        "source_entry_id": "fa679333-b0a7-3227-8e2e-df7008708c8b",
                        "source_sense_id": "b11214a9-bfe8-31dc-b59c-d63543290021",
                        "source_sense_description": "Bordell, Freudenhaus, Puff",
                        "target_lang_word": "Puff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "304eb9c9-13e9-35a1-88e7-5a75cf136968",
                                        "entry_id": "8b3ea074-083b-314f-9a84-cbbe8ae2f030",
                                        "glosses": [
                                            "ein leichter, harmloser Schlag"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8e46c0-846b-496a-8692-861786959b6c",
                                                "sense_id": "304eb9c9-13e9-35a1-88e7-5a75cf136968",
                                                "text": "Er gab ihr einen kleinen Puff in den Bauch."
                                            },
                                            {
                                                "example_id": "f8d7e447-3e91-49ca-a1ba-b0b3d5915ec4",
                                                "sense_id": "304eb9c9-13e9-35a1-88e7-5a75cf136968",
                                                "text": "„Er gibt ihr einen Puff.“"
                                            },
                                            {
                                                "example_id": "93e0ff44-7ac9-4b73-9908-caf6af337efc",
                                                "sense_id": "304eb9c9-13e9-35a1-88e7-5a75cf136968",
                                                "text": "„Aber der Oberst gibt den Decken wortlos einen Puff und schickt sich an, zu gehen.“"
                                            },
                                            {
                                                "example_id": "3c01fe34-36f8-4a0b-b512-b71f7903a3a9",
                                                "sense_id": "304eb9c9-13e9-35a1-88e7-5a75cf136968",
                                                "text": "„In den unbeschädigten Stadtteilen stieg friedlich weiter der Rauch aus den Schornsteinen auf; der Fluß spiegelte wie früher die Wolken, und die Puffs der Flak säumten den Himmel, als sei er ein harmloses Kissen, dessen Nähte überall barsten und grauweiße Baumwollflocken ausstießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Puff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "083707ad-f5f8-3765-b0d7-879dab839bef",
                                        "entry_id": "7ebb646e-6f08-3405-85b1-ff47d9f62d81",
                                        "glosses": [
                                            "Anschwellung eines Abschnittes eines Chromosoms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1878ec0a-9bd8-4368-8244-d9ad23413805",
                                                "sense_id": "083707ad-f5f8-3765-b0d7-879dab839bef",
                                                "text": "„Solche Regionen bezeichnet man als Puff, besonders große Puffs bezeichnet man als Balbiani-Ring, nach ihrem Entdecker Édouard-Gérard Balbiani (1823-1899).“"
                                            },
                                            {
                                                "example_id": "c106d870-7e4e-489b-9d29-42c6a4ad84e9",
                                                "sense_id": "083707ad-f5f8-3765-b0d7-879dab839bef",
                                                "text": "„BR2 = Balbiani-Ring 2 (großer Puff)“"
                                            },
                                            {
                                                "example_id": "8581b6c3-8925-43f3-8eca-15fd6f7b9262",
                                                "sense_id": "083707ad-f5f8-3765-b0d7-879dab839bef",
                                                "text": "„Der Nucleolus entspricht strukturell einem besonders großen Puff.“"
                                            },
                                            {
                                                "example_id": "35872ca5-17a9-4a09-83a0-9a250d185eff",
                                                "sense_id": "083707ad-f5f8-3765-b0d7-879dab839bef",
                                                "text": "„Der Nukleolus erweist sich als ein spezieller Puff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Puff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f506c90-1200-36e8-aead-5b2652908881",
                                        "entry_id": "4afb0281-89c0-3ef0-8ce5-28ee62db2452",
                                        "glosses": [
                                            "Gebäude, in dem (meist) Frauen sexuelle Dienstleistungen anbieten; Bordell"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a33bb2-dc09-466b-a2e2-e4cedb5c03e2",
                                                "sense_id": "9f506c90-1200-36e8-aead-5b2652908881",
                                                "text": "Frau zu ihrem Mann: „Du warst doch nicht schon wieder in diesem dreckigen Puff?“"
                                            },
                                            {
                                                "example_id": "c6437eb8-fadb-4bdd-b873-b5a3dce0c375",
                                                "sense_id": "9f506c90-1200-36e8-aead-5b2652908881",
                                                "text": "„Da ließen sich Gäste und Aussteller nicht lumpen, da seien die Puffs knüppeldickevoll mit Männern aus der Autobranche.“"
                                            },
                                            {
                                                "example_id": "ace4f8a8-642e-4242-8729-8a1c1e7edb64",
                                                "sense_id": "9f506c90-1200-36e8-aead-5b2652908881",
                                                "text": "„Sein Schädel leuchtet im Halbdunkel des Raumes wie die rote Laterne eines Puffs.“"
                                            },
                                            {
                                                "example_id": "693a8055-6abd-47a2-a041-8111dbe1272c",
                                                "sense_id": "9f506c90-1200-36e8-aead-5b2652908881",
                                                "text": "„Darum kann ich im Puff keinen Spaß haben.“"
                                            },
                                            {
                                                "example_id": "55fbf0d8-7a80-4433-9d62-974d8632afd6",
                                                "sense_id": "9f506c90-1200-36e8-aead-5b2652908881",
                                                "text": "„So ging ich – kein anderer Notausgang schien verfügbar – ins bekannteste Puff der Großstadt, in der ich damals lebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Puff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43004b8c-44ca-3bc1-b97a-e50b83969985",
                                        "entry_id": "371902a7-3c3a-3d79-84ea-97b1e06821f7",
