                        "source_sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                        "target_lang_word": "опрометчиво",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "опрометчиво",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                                        "entry_id": "71136c3a-75e9-3a12-8acd-e83eeb8aca93",
                                        "glosses": [
                                            "наречие к опрометчивый; поспешно, необдуманно, без должной осмотрительности"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93bbcd8-0e31-410a-bf9b-6ca50b050df3",
                                                "sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                                                "text": "Вижу сам, что, может быть, весьма и весьма поступил опрометчиво, пренебрегая общественным голосом…"
                                            },
                                            {
                                                "example_id": "5cf03ee4-89fb-40d7-b319-c749a6b8d15d",
                                                "sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                                                "text": "Это было ужасно опрометчиво ― самому, добровольно забраться в логово врага."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c108046-43b8-4ea3-8c80-99b459759a51",
                        "source_entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                        "source_sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                        "target_lang_word": "необдуманно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "необдуманно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "990bc07e-1882-3f49-8d74-663bc228cb55",
                                        "entry_id": "fff73538-6612-35e9-8936-a99bd62cc804",
                                        "glosses": [
                                            "не будучи результатом серьезных размышлений, предварительного обдумывания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24309575-62e1-42e9-9e3d-43986b51d912",
                                                "sense_id": "990bc07e-1882-3f49-8d74-663bc228cb55",
                                                "text": "Потом он сказал, чтобы я поразмыслила хорошенько об его предложениях, что ему весьма будет неприятно, если я такой важный шаг сделаю необдуманно, прибавил, что необдуманность и увлечение губят юность неопытную, но что он чрезвычайно желает с моей стороны благоприятного ответа, что, наконец, в противном случае, он принужден будет жениться в Москве на купчихе, потому что, говорит он, я присягнул негодяя племянника лишить наследства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
