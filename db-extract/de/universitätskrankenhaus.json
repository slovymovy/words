                "senses": [
                    {
                        "sense_id": "344a5d9c-9bc5-35b3-9093-c8ffdccb7f66",
                        "entry_id": "d9da31a4-914f-32e4-b602-2a0bed755a56",
                        "glosses": [
                            "zu einer Universität gehörendes Krankenhaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90fe83b-1329-48ff-ad12-a5cfb1c4ba5b",
                                "sense_id": "344a5d9c-9bc5-35b3-9093-c8ffdccb7f66",
                                "text": "„Gilman suchte trotz seines Fiebers keinen Arzt auf; er wusste, er würde die Zwischenprüfungen nicht bestehen, falls man ihn ins Universitätskrankenhaus einweisen würde, wo er doch jede Minute zum Pauken benötigte.“"
                            },
                            {
                                "example_id": "e5c55282-35a8-4496-a29a-b6045a13f8fa",
                                "sense_id": "344a5d9c-9bc5-35b3-9093-c8ffdccb7f66",
                                "text": "„McAllister und Bowman hatten im Nordosten eine Schlägerei aufgenommen, und ein paar Stunden später hatte Bowman erfahren, dass sein Schussopfer von vor drei Nächten im Universitätskrankenhaus das Zeitliche gesegnet hatte.“"
                            },
                            {
                                "example_id": "de4f3be1-4fd9-4f15-8b03-eed64f39d7a6",
                                "sense_id": "344a5d9c-9bc5-35b3-9093-c8ffdccb7f66",
                                "text": "„›Mama hat ihn ins Universitätskrankenhaus gebracht.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
