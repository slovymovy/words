                    {
                        "translation_id": "87642253-802b-48c5-9a43-8e9fb5619902",
                        "source_entry_id": "d1c65953-3e85-37c7-910f-ef811e57396f",
                        "source_sense_id": "e8a83e50-4249-3b00-8430-4e2bdf488b1f",
                        "target_lang_word": "верху́шка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "верху́шка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f605b18c-7cc5-3444-8ea5-95dca8199500",
                                        "entry_id": "729c8691-1b38-374d-84e3-bc0479089e0b",
                                        "glosses": [
                                            "верхняя часть чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3afbece1-a925-455d-bb4d-dc23aef60a36",
                                                "sense_id": "f605b18c-7cc5-3444-8ea5-95dca8199500",
                                                "text": "Облака стояли неподвижно, точно зацепились за верхушки высоких, старых сосен."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2773b9d-5d8a-3126-8f32-d366baa63c13",
                                        "entry_id": "729c8691-1b38-374d-84e3-bc0479089e0b",
                                        "glosses": [
                                            "перен., разг. группа людей, занимающих высшее, начальственное положение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99ffb0b9-9a92-4d14-b6d6-c31bf1cd567d",
                                                "sense_id": "e2773b9d-5d8a-3126-8f32-d366baa63c13",
                                                "text": "Наши оппоненты указывают, что евреи, напротив, бедны, повсеместно даже бедны, а в России особенно, что только самая верхушка евреев богата, банкиры и цари бирж, а из остальных евреев чуть ли не десять десятых их — буквально нищие, мечутся из-за куска хлеба, предлагают куртаж, ищут где бы урвать копейку на хлеб."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
