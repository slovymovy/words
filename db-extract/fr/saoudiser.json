                "senses": [
                    {
                        "sense_id": "5b0ce9fd-c897-36e9-b09f-a778145f87c9",
                        "entry_id": "78f2ad9c-e5c4-3cfd-90e2-64b8c2f09c8b",
                        "glosses": [
                            "Donner un caractère saoudien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a2e6ad8-9b46-4081-a937-2a2fba4b99af",
                                "sense_id": "5b0ce9fd-c897-36e9-b09f-a778145f87c9",
                                "text": "Au lieu de « wahabiser » l’Etat, c’est plutôt le pouvoir politique qui va « saoudiser » les religieux wahhabites."
                            },
                            {
                                "example_id": "fcd0ff3b-2603-4a44-9bb7-071516ba15d4",
                                "sense_id": "5b0ce9fd-c897-36e9-b09f-a778145f87c9",
                                "text": "En effet, le prince héritier Abdallah veut « saoudiser » son pays, desserrer l’étau américain et ouvrir le marché pétrolier à d’autres partenaires, notamment néerlandais et britanniques."
                            }
                        ]
                    }
