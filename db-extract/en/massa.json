                        ],
                        "examples": [
                            {
                                "example_id": "9e751530-2f08-4ce3-a53c-7619319b5fce",
                                "sense_id": "28d5ebf6-3c27-39e2-bb31-6d26278d4f72",
                                "text": "\"All well, Massa Challenger, all well!\" he cried. \"Me stay here. No fear. You always find me when you want.\" His honest black face, and the immense view before us, which carried us half-way back to the affluent of the Amazon, helped us to remember that we really were upon this earth in the twentieth century, and had not by some magic been conveyed to some raw planet in its earliest and wildest state."
                            }
