                                        "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                                        "entry_id": "08643415-be24-39ca-9a41-bf843469a455",
                                        "glosses": [
                                            "Wasser, das ein Fluss mit sich führt, das er enthält oder das aus ihm stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b1bd6e-7fe6-49c3-b929-5e2bc62a75e0",
                                                "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                                                "text": "Flusswasser wird häufig zur Trinkwassergewinnung benutzt."
                                            },
                                            {
                                                "example_id": "06dc0ab2-65e9-434f-a1aa-1c50e9cf6d59",
                                                "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                                                "text": "„Im Grand Canyon hat sich Flusswasser durch 1,6 km starkes Gestein seinen Weg nach unten gebahnt - der tiefste Einschnitt, der auf der Welt sichtbar ist.“"
                                            },
                                            {
                                                "example_id": "45cb0b4b-956a-4c24-8fef-2b66629909d2",
                                                "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                                                "text": "„So ist das Flusswasser in den letzten Jahrzehnten zu einer umkämpften Ressource geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "780768a1-8a40-4e45-8602-da4b3361982b",
                        "source_entry_id": "6c7c5e54-bb4f-3d4b-99e2-b522c32fb1e4",
