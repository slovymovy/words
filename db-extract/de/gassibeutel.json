                "senses": [
                    {
                        "sense_id": "c5509d10-26c5-37bd-bd72-ba492800f481",
                        "entry_id": "8da2f2b2-7f7d-3163-9293-4aaf10f56a3f",
                        "glosses": [
                            "(Plastik-)Beutel zum Aufsammeln und Aufbewahren des Tierkots beim Gassigehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51df8aa6-e20f-499c-9e95-d9edfa2acd47",
                                "sense_id": "c5509d10-26c5-37bd-bd72-ba492800f481",
                                "text": "„Angesichts einer zunehmenden Zahl von Hunden in der Stadt fordert die CDU mehr umzäunte Hundewiesen und Gassibeutel für Hamburg.“"
                            },
                            {
                                "example_id": "c892dc8d-f872-42e9-8203-8fa4fe97fd21",
                                "sense_id": "c5509d10-26c5-37bd-bd72-ba492800f481",
                                "text": "„Wobei die vielen Gassibeutel, die sich häufig ebenfalls am Ufer finden, von anderen Dreckspatzen stammten, ergänzt Gregor Baumert, der als Isarranger die Aktion begleitet.“"
                            },
                            {
                                "example_id": "6c53b965-340a-43b9-9d75-69e80575ed9a",
                                "sense_id": "c5509d10-26c5-37bd-bd72-ba492800f481",
                                "text": "„Verzweifelt bemühen sich die Berliner Stadtreinigungsbetriebe (BSR) um Aufklärung, verteilen Flyer und kostenlose Gassibeutel.“"
                            },
                            {
                                "example_id": "737b304c-cc8b-4525-a95c-13325fef6378",
                                "sense_id": "c5509d10-26c5-37bd-bd72-ba492800f481",
                                "text": "„Sackerl fürs Gackerl – seit Jahren sind Gassibeutel die wichtigste Maßnahme im Kampf gegen den Hundekot auf Gehwegen, Spielplätzen und Parkanlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
