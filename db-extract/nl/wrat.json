                                    },
                                    {
                                        "sense_id": "d9e57dd4-9aa1-3107-bf7c-f962abf0492e",
                                        "entry_id": "b2880be6-4c8c-39ac-b3c7-b3bae177d524",
                                        "glosses": [
                                            "Defecto de poca importancia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df3bc364-4349-4a54-a3e7-c5cca9684e2c",
                                                "sense_id": "d9e57dd4-9aa1-3107-bf7c-f962abf0492e",
                                                "text": "Yo temí que le saliesen verrugas a mi vestido de muselina y por eso lo pagué con un cheque."
