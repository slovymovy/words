                "senses": [
                    {
                        "sense_id": "d01b5f63-bb46-3ac9-8987-3e13735fe6f5",
                        "entry_id": "a0cf7bf8-2c50-32bc-8bc9-1e3ed5f4daf3",
                        "glosses": [
                            "een document dat de politie de opdracht geeft een verdachte of veroordelde aan te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11174da-1dd3-45b8-adef-6c4a56cd8edb",
                                "sense_id": "d01b5f63-bb46-3ac9-8987-3e13735fe6f5",
                                "text": "Er werd een arrestatiebevel tegen hem uitgevaardigd."
                            },
                            {
                                "example_id": "57b4268f-ba7f-4610-ae55-54828a412bbf",
                                "sense_id": "d01b5f63-bb46-3ac9-8987-3e13735fe6f5",
                                "text": "Internationaal Strafhof in Den Haag vaardigt arrestatiebevel uit tegen Poetin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54d0a196-7dbc-4009-be5e-03ce00b7372e",
                        "source_entry_id": "a0cf7bf8-2c50-32bc-8bc9-1e3ed5f4daf3",
                        "source_sense_id": "d01b5f63-bb46-3ac9-8987-3e13735fe6f5",
                        "source_sense_description": "document",
                        "target_lang_word": "Haftbefehl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haftbefehl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09239df0-f9a6-3b63-bb47-813fca4446a4",
                                        "entry_id": "08e4d215-baf0-39f6-8e39-952d75be8b84",
                                        "glosses": [
                                            "verbindliche Anweisung, eine bestimmte Person in Haft zu nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eadf7909-1206-4f92-ad52-2917b8c78722",
                                                "sense_id": "09239df0-f9a6-3b63-bb47-813fca4446a4",
                                                "text": "Gegen ihn lag schon seit Monaten ein Haftbefehl vor."
                                            },
                                            {
                                                "example_id": "324b12f9-800f-4bea-8549-af9d3cff8d2a",
                                                "sense_id": "09239df0-f9a6-3b63-bb47-813fca4446a4",
                                                "text": "„Gegen die Finkelsteins lag kein Haftbefehl vor – wenigstens damals noch nicht, im Jahre 1936.“"
                                            },
                                            {
                                                "example_id": "d5783af6-8a3e-491d-80b1-2b483fb45d21",
                                                "sense_id": "09239df0-f9a6-3b63-bb47-813fca4446a4",
                                                "text": "„Ich werde morgen einen Haftbefehl gegen ihn erwirken.“"
                                            },
                                            {
                                                "example_id": "0dc979a6-f444-41e5-a76d-bf9222201b99",
                                                "sense_id": "09239df0-f9a6-3b63-bb47-813fca4446a4",
                                                "text": "„Einen Haftbefehl, zum Beispiel gegen Wladimir Putin könnte Khan nicht selbst ausstellen. Er bräuchte dafür wiederum die Zustimmung der IStGH-Vorprüfungskammer.“"
                                            },
                                            {
                                                "example_id": "5edfb9fc-9097-4c43-abeb-623ed8f0e9c2",
                                                "sense_id": "09239df0-f9a6-3b63-bb47-813fca4446a4",
                                                "text": "„Der Haftbefehl wird just in dem Augenblick vollstreckt, als das Kaiserreich zusammengebrochen ist, als Klabund Deutschland in den Wirren der bayerischen Räterepublik besucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
