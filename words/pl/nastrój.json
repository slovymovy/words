                    "sense_id": "697ee477-18ab-3dbb-bc06-9a347cee6df3",
                    "sense_definition": "Utrzymujący się przez pewien czas stan psychiczny, samopoczucie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mood_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo deszczowej pogody mam dziś wspaniały <w>nastrój</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на дождливую погоду, у меня сегодня прекрасное <w>настроение</w>.",
                                "en": "Despite the rainy weather, I'm in a great <w>mood</w> today.",
                                "nl": "Ondanks het regenachtige weer ben ik vandaag in een geweldige <w>stemming</w>.",
                                "de": "Trotz des regnerischen Wetters habe ich heute eine wunderbare <w>Laune</w>.",
                                "fr": "Malgré le temps pluvieux, je suis d'excellente <w>humeur</w> aujourd'hui.",
                                "it": "Nonostante il tempo piovoso, oggi sono di ottimo <w>umore</w>.",
                                "cs": "Navzdory deštivému počasí mám dnes skvělou <w>náladu</w>.",
                                "tr": "Yağmurlu havaya rağmen bugün harika bir <w>ruh halindeyim</w>.",
                                "es": "A pesar del tiempo lluvioso, hoy tengo un maravilloso <w>estado de ánimo</w>.",
                                "zh": "尽管下着雨，我今天<w>心情</w>还是好极了。"
                            }
                        },
                        {
                            "text": "Jego ponury <w>nastrój</w> zepsuł atmosferę przy obiedzie.",
                            "target_lang_translations": {
                                "ru": "Его мрачное <w>настроение</w> испортило атмосферу за обедом.",
                                "en": "His gloomy <w>mood</w> ruined the atmosphere at dinner.",
                                "nl": "Zijn sombere <w>humeur</w> verpestte de sfeer tijdens het diner.",
                                "de": "Seine düstere <w>Stimmung</w> verdarb die Atmosphäre beim Mittagessen.",
                                "fr": "Sa sombre <w>humeur</w> a gâché l'ambiance pendant le déjeuner.",
                                "it": "Il suo <w>umore</w> cupo ha rovinato l'atmosfera a pranzo.",
                                "cs": "Jeho ponurá <w>nálada</w> pokazila atmosféru při obědě.",
                                "tr": "Onun kasvetli <w>ruhhali</w> akşam yemeğindeki ortamı bozdu.",
                                "es": "Su mal <w>humor</w> arruinó el ambiente durante la comida.",
                                "zh": "他沉闷的<w>情绪</w>破坏了用餐时的气氛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humor"
