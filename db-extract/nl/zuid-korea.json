                    {
                        "sense_id": "3f4fc773-3ef1-379e-8a58-4f7fd253ba5f",
                        "entry_id": "f74b6db8-da45-32a2-abb4-4d45de51f640",
                        "glosses": [
                            "land in Oost-Azië, het zuidelijk deel van het schiereiland Korea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2839c2e8-bb34-41e0-9a4e-d8fdf2a14c36",
                                "sense_id": "3f4fc773-3ef1-379e-8a58-4f7fd253ba5f",
                                "text": "In Zuid-Korea groeien planten die bij het klimaat passen."
                            },
                            {
                                "example_id": "5e93e2c1-156b-4e2c-9dcc-4d2fbe69439c",
                                "sense_id": "3f4fc773-3ef1-379e-8a58-4f7fd253ba5f",
                                "text": "Het land is in werkelijkheid boeiender dan het Zuid-Korea uit de reisgids."
                            }
                        ]
                    },
                    {
                        "sense_id": "b11a2177-6d12-3049-a61d-a10ab255219d",
                        "entry_id": "f74b6db8-da45-32a2-abb4-4d45de51f640",
                        "glosses": [
                            "de soevereine 'Republiek Korea' (Koreaans in hangul: 대한민국, in hanja: 大韓民國, Tae Han Min Kuk) die het onder 1. genoemde gebied omvat; in figuurlijke betekenis ook: zij die als vertegenwoordigers van dit land optreden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18c45b7-8bef-4c58-bd3b-7bd1e49186aa",
                                "sense_id": "b11a2177-6d12-3049-a61d-a10ab255219d",
                                "text": "Zuid-Korea is lid van de Verenigde Naties."
                            },
                            {
                                "example_id": "f2924157-eae5-43a5-897d-d42c6fae8507",
                                "sense_id": "b11a2177-6d12-3049-a61d-a10ab255219d",
                                "text": "Het Zuid-Korea van twee jaar geleden was een zeer sterk elftal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce8fbcff-270f-4431-8b10-27e4b47a027a",
