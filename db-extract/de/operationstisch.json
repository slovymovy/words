                "senses": [
                    {
                        "sense_id": "db332fc9-cbb5-31f5-b4d3-04a6334b0f06",
                        "entry_id": "f45e77f7-6f51-3c5a-9ef3-7afdbf6c5f33",
                        "glosses": [
                            "Vorrichtung im Operationssaal, auf der die Patienten, die operiert werden, während der Operation liegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3df43155-44e8-4387-b6b2-628775aeb3b3",
                                "sense_id": "db332fc9-cbb5-31f5-b4d3-04a6334b0f06",
                                "text": "„Das Stuttgarter Landgericht urteilt über einen Hochstapler, der es mit Hauptschulabschluss bis an den Operationstisch schaffte.“"
                            },
                            {
                                "example_id": "b09029c9-bf22-4d1a-ae87-371be3f5e89e",
                                "sense_id": "db332fc9-cbb5-31f5-b4d3-04a6334b0f06",
                                "text": "„Ein Patient wird mit einer akuten Blinddarmentzündung in die Klinik eingeliefert und liegt bereits auf dem Operationstisch.“"
                            },
                            {
                                "example_id": "08d737c9-664a-4ff0-9409-ff60a7fdfbae",
                                "sense_id": "db332fc9-cbb5-31f5-b4d3-04a6334b0f06",
                                "text": "„Zu humaner Verständigung zwischen Anfängern kommt es an einem Operationstisch.“"
                            },
                            {
                                "example_id": "9196a80f-c0ea-4d42-b9e3-01ada50b4a1e",
                                "sense_id": "db332fc9-cbb5-31f5-b4d3-04a6334b0f06",
                                "text": "„Der Kellner liegt auf dem Operationstisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
