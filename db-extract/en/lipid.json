        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3cee02e9-f514-38a4-a05f-defef0d82581",
                "word": "lipid",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7a664cc6-e48d-42a8-9dd2-c325a7e7a1ae",
                        "entry_id": "3cee02e9-f514-38a4-a05f-defef0d82581",
                        "tags": [
                            "plural"
                        ],
                        "form": "lipids"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c513be0-0154-31fa-86f3-3e71c0e1e578",
                        "entry_id": "3cee02e9-f514-38a4-a05f-defef0d82581",
                        "glosses": [
                            "Any of a group of organic compounds including the fats, oils, waxes, sterols, and triglycerides. Lipids are characterized by being insoluble in water, and account for most of the fat present in the human body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d400b284-eab0-41bf-87ce-90c991a106fc",
                                "sense_id": "7c513be0-0154-31fa-86f3-3e71c0e1e578",
                                "text": "Without lipids your body eats your fat and then your muscles, and the brain is pure fat and the heart is a muscle. You become a feedback loop, and then you fall over."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05e2b37c-7d1d-407a-a6f0-fe8daf6e8ef9",
                        "source_entry_id": "3cee02e9-f514-38a4-a05f-defef0d82581",
