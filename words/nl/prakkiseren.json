                    "sense_definition": "Langdurig en op een zorgelijke manier nadenken over iets, vaak zonder tot een oplossing te komen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het heeft geen zin om te <w>prakkiseren</w> over wat er gisteren is misgegaan.",
                            "target_lang_translations": {
                                "en": "There is no point in <w>brooding</w> over what went wrong yesterday."
                            }
                        },
                        {
                            "text": "De huisarts adviseerde hem om minder te <w>prakkiseren</w> en meer te ontspannen.",
                            "target_lang_translations": {
                                "en": "The GP advised him to <w>worry</w> less and relax more."
                            }
                        }
                    ],
                    "synonyms": [
                        "piekeren",
                        "kniezen",
                        "tobben"
                    ],
                    "common_phrases": [
                        "zitten te prakkiseren",
                        "minder prakkiseren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vooral in informele spreektaal gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To think deeply and at length about something in a worried or anxious way, often without finding a solution."
                    },
                    "translations": {
                        "en": [
                            {
