                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fungus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large fungal <w>conk</w> protruded from the side of the decaying birch.",
                            "target_lang_translations": {
                                "it": "Un grosso <w>fungo a mensola</w> spuntava dal fianco della betulla in decomposizione."
                            }
