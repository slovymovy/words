                        "target_lang_word": "badiner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "badiner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abef1d91-aa43-3f30-a809-9d5938877868",
                                        "entry_id": "a4d9e7e8-9139-3b91-9942-37778e825549",
                                        "glosses": [
                                            "Plaisanter, prendre quelque chose à la légère, parler ou écrire d’une manière enjouée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b99cac-3b60-4e3b-8984-68c9defc7b23",
                                                "sense_id": "abef1d91-aa43-3f30-a809-9d5938877868",
                                                "text": "Sénèque a décrit en badinant l'Apothéose de l'Empereur Claude."
                                            },
                                            {
                                                "example_id": "a57aa0d1-93f2-41e4-94ef-670148220dcf",
                                                "sense_id": "abef1d91-aa43-3f30-a809-9d5938877868",
                                                "text": "Galamment, il lui baisa la main et badina un instant avec gentillesse."
                                            },
                                            {
                                                "example_id": "e235d4a4-0a1d-4309-937e-f5fe1d2229a1",
                                                "sense_id": "abef1d91-aa43-3f30-a809-9d5938877868",
                                                "text": "Je n’étais pas en humeur de badiner. Je devais corriger, d’urgence, une version latine sur les taux abusifs des usuriers."
                                            },
                                            {
                                                "example_id": "b06ccbf1-b3ee-464e-b97f-f53251d6ec0f",
                                                "sense_id": "abef1d91-aa43-3f30-a809-9d5938877868",
                                                "text": "Québec sévit davantage en ce qui concerne les rassemblements. Les rencontres clandestines pourraient coûter jusqu’à 6000 $ par personne. On ne badine plus !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "274327ed-b507-3323-8a37-cf38047fb027",
                                        "entry_id": "a4d9e7e8-9139-3b91-9942-37778e825549",
                                        "glosses": [
                                            "Pour un cheval, jouer avec son mors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676f9547-7cb5-41bf-b9df-855142ce6d3a",
                                                "sense_id": "274327ed-b507-3323-8a37-cf38047fb027",
                                                "text": "Ce cheval badine avec son mors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91dfbfe0-2bd8-32b5-abec-73a845b6d764",
                                        "entry_id": "a4d9e7e8-9139-3b91-9942-37778e825549",
                                        "glosses": [
                                            "Voltiger, s’agiter au moindre vent, pour des parures légères, des ornements ajustés."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99b837d1-a7ce-41b8-8fce-ad9c0d5a3d02",
                                                "sense_id": "91dfbfe0-2bd8-32b5-abec-73a845b6d764",
                                                "text": "Un fichu de point d’Angleterre retombait sur les épaules en badinant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f76bf2b-18ef-31ef-8815-dc227bc4e445",
                                        "entry_id": "a4d9e7e8-9139-3b91-9942-37778e825549",
                                        "glosses": [
                                            "Badiner quelqu'un : le railler en badinant."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba40652b-1e17-42e2-8039-46ec87ee531d",
                                                "sense_id": "9f76bf2b-18ef-31ef-8815-dc227bc4e445",
                                                "text": "Ils devraient être arrivés. C’est badiner la magistrature municipale !"
                                            },
                                            {
                                                "example_id": "dc276d3f-394d-425c-9aa7-cf4c16eeeea3",
                                                "sense_id": "9f76bf2b-18ef-31ef-8815-dc227bc4e445",
                                                "text": "C'est qu'on le badine ! De tels originaux sont si divertissants !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
