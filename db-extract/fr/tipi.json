                        "tags": [
                            "plural"
                        ],
                        "form": "tipis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b86fa74a-3a42-3b49-bf3c-c46679db2931",
                        "entry_id": "5650c8b9-e134-3c0e-a6a9-8f29bb95ea00",
                        "glosses": [
                            "Tente conique traditionnelle des Amérindiens des Grandes Plaines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfba7854-294d-4dd3-b075-87182a16d56c",
                                "sense_id": "b86fa74a-3a42-3b49-bf3c-c46679db2931",
                                "text": "Il convient de distinguer l'authentique tipi, spécifique des Plaines, fait de peaux tannées et cousues ensemble, d'un tipi plus fruste, où les peaux ne sont pas cousues ; la cohésion de l'ensemble est assurée par des poteaux extérieurs, inclinés contre la paroi de la tente."
                            },
                            {
                                "example_id": "8930cb89-19cb-4f29-be06-0a71c6945eab",
                                "sense_id": "b86fa74a-3a42-3b49-bf3c-c46679db2931",
                                "text": "Avez-vous une âme de pionnier ? Si oui, vous disposez de chariots bâchés tels que vous en avez vu dans les westerns, lesquels nous montrent également des tipis."
                            }
                        ]
                    },
                    {
                        "sense_id": "921b2881-cb39-3476-a75a-29856b49c78c",
                        "entry_id": "5650c8b9-e134-3c0e-a6a9-8f29bb95ea00",
                        "glosses": [
                            "Tente de fortune qui ressemble plus ou moins aux tentes amérindiennes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8ddc9a3d-231c-4fbf-9d37-e54007f36cb2",
                                "sense_id": "921b2881-cb39-3476-a75a-29856b49c78c",
                                "text": "De plus le tipi était minuscule : seul un enfant aurait pu loger dedans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0a44b89-02da-4013-9284-e82fd713bccb",
                        "source_entry_id": "5650c8b9-e134-3c0e-a6a9-8f29bb95ea00",
                        "target_lang_word": "Tipi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tipi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a34bada4-ca8c-3f1c-a9c7-92181ccbe5d0",
                                        "entry_id": "6ca0b2f1-b0a9-310d-b1aa-a1e657455300",
                                        "glosses": [
                                            "kegelförmiges, spitzes und aus Stangen gebautes Zelt der nordamerikanischen Prärieindianer, das mit Leder, Rinde, Matten oder Fellen bedeckt wird oder stoffbespannt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df5c4daa-4680-477c-8c51-2c61ae40b504",
                                                "sense_id": "a34bada4-ca8c-3f1c-a9c7-92181ccbe5d0",
                                                "text": "Im Museum ist ein detailgetreues Tipi ausgestellt, das man begehen kann."
                                            },
                                            {
                                                "example_id": "dbba9b0e-222c-4d50-b61f-21e8b2b32ff5",
                                                "sense_id": "a34bada4-ca8c-3f1c-a9c7-92181ccbe5d0",
                                                "text": "Xaver schreibt derzeit eine Abhandlung über die Bauweise und Benutzung der Tipis bei den Nakota."
                                            },
                                            {
                                                "example_id": "7dcf6d72-a032-4a6c-bfce-8a39b18075ed",
                                                "sense_id": "a34bada4-ca8c-3f1c-a9c7-92181ccbe5d0",
                                                "text": "„Die traditionellen Hütten waren nur Show, wie die Tipis, die Prärie-Indianer für Touristen aufstellten; in den Bretterbuden lebten die San wirklich.“"
                                            },
                                            {
                                                "example_id": "c628a153-6b6c-409f-a765-1d71f26e248a",
                                                "sense_id": "a34bada4-ca8c-3f1c-a9c7-92181ccbe5d0",
                                                "text": "„Mitten im Wohnzimmer hat sie aus einem Laken, einem Stuhl und einem Besen ein schiefes Tipi errichtet.“"
                                            },
                                            {
                                                "example_id": "7d6ebb8f-16cc-4388-afe9-289e92e83087",
                                                "sense_id": "a34bada4-ca8c-3f1c-a9c7-92181ccbe5d0",
                                                "text": "„Seine Aquarelle und Zeichnungen zeigen Federschmuck, Tipis, Indigene auf Pferden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
