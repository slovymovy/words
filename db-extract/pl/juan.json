                        "examples": [
                            {
                                "example_id": "4a1238a1-72d1-43e0-b6be-e8d1c2c6e18e",
                                "sense_id": "89abbd7a-f2e7-3e6e-8c36-9a762946533e",
                                "text": "Ten hotel jest bardzo drogi, za noc płaci się trzy tysiące juanów."
