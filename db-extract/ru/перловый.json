                "senses": [
                    {
                        "sense_id": "fbe35b83-59b4-3495-a6d3-f4967d1c772f",
                        "entry_id": "291d2e08-1d63-343c-b6ef-012372c05764",
                        "glosses": [
                            "pearl barley"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "8b89647d-2634-41dd-92a2-d5d7ad120e89",
                                "sense_id": "fbe35b83-59b4-3495-a6d3-f4967d1c772f",
                                "text": "Промы́тую перло́вую крупу́ засы́пать в кипя́щую во́ду и вари́ть 10—12 мину́т."
                            }
                        ]
                    },
                    {
                        "sense_id": "f486eae5-1998-3468-a112-495bd6467696",
                        "entry_id": "291d2e08-1d63-343c-b6ef-012372c05764",
                        "glosses": [
                            "pearl"
                        ],
                        "tags": [
                            "obsolete",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "a66b0154-053a-4c6c-9c8f-1117b4d0f631",
                                "sense_id": "f486eae5-1998-3468-a112-495bd6467696",
                                "text": "В жи́лках рук её пухо́вых,\nКак эфи́р, струи́лась кровь;\nМе́жду роз, зубо́в перло́вых,\nУсмеха́лася любо́вь.",
                                "translation": "Gavrila Derzhavin",
                                "english": "Gavrila Derzhavin"
                            }
                        ]
                    }
