                        "entry_id": "584cf5de-e91d-3597-9655-17fd94475b51",
                        "glosses": [
                            "Lehrling, der eine Ausbildung zum Schreiner absolviert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ffcf620-e4ec-4896-8d53-2c671fb6f76a",
                                "sense_id": "8899b0a8-8ed9-3491-8ce3-ff2fcd42b7a5",
                                "text": "„Ein Schreinerlehrling soll versucht haben, einen Ableger der rechtsextremen Atomwaffen Division zu gründen, um Anschläge zu begehen.“"
                            },
                            {
                                "example_id": "fdffb93c-77cf-44ac-a179-af0cb4674a53",
                                "sense_id": "8899b0a8-8ed9-3491-8ce3-ff2fcd42b7a5",
                                "text": "„Der Schreinerlehrling Len hat einen Traum. Er ist 16, lernt gerade die ersten Handgriffe seines Handwerks – und hat doch schon Grosses vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
