                ],
                "senses": [
                    {
                        "sense_id": "829690fe-cba3-3284-90dc-b8f56569c18a",
                        "entry_id": "0fb41d4f-bfae-39dc-bd46-8ff4a458c5f4",
                        "glosses": [
                            "Landschaft zwischen Gundelsheim im Norden und Ludwigsburg im Süden im nördlichen Zentrum Baden-Württembergs, Deutschland"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "ea4a372b-4280-42e3-b965-f117bd782f7a",
                                "sense_id": "829690fe-cba3-3284-90dc-b8f56569c18a",
                                "text": "„In Baden-Württemberg ist die Pflanze vor allem in den Regionen Oberrhein, am Bodensee und im Neckarbecken zu finden.“"
                            },
                            {
                                "example_id": "8cd3abf3-0932-4554-8b27-9eb3b670a21f",
                                "sense_id": "829690fe-cba3-3284-90dc-b8f56569c18a",
                                "text": "„Die Projektkulisse im Ländle erstreckt sich über die Gäulandschaften und das Neckarbecken von Tübingen bis Heilbronn.“"
                            },
                            {
                                "example_id": "bda17835-65c0-46ba-a511-70d760de2326",
                                "sense_id": "829690fe-cba3-3284-90dc-b8f56569c18a",
                                "text": "„Großflächig von Löss und Lösslehm bedeckte, waldarme Gäuplatten sowie tief in den Oberen Muschelkalk eingeschnittene Flusstäler sind die wichtigsten Landschaftselemente des Neckarbeckens.“"
                            },
                            {
                                "example_id": "a6a6fd4a-c444-47b6-bf56-40ca0acbb253",
                                "sense_id": "829690fe-cba3-3284-90dc-b8f56569c18a",
                                "text": "„Das östliche Neckarbecken stellt den Übergang vom Neckartal zu den Schwäbisch-Fränkischen-Waldbergen dar.“"
                            },
                            {
                                "example_id": "bd0ee8b9-7fcb-4f92-83bc-ec7cae6118c2",
                                "sense_id": "829690fe-cba3-3284-90dc-b8f56569c18a",
                                "text": "„Auch das Neckarbecken war bereits 1830 eine reine Ackerlandschaft und der Wald war weitestgehend – bis auf die Übergangsgebiete zu den anderen Naturräumen – gerodet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
