                        "entry_id": "c6c44a37-1abc-391c-9a19-0b65012859da",
                        "glosses": [
                            "Relatif aux jaïnas et au jaïnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e23dfb5e-0257-42e5-84e8-ac628f33e8fa",
                                "sense_id": "e115dbb1-11ef-3b84-8720-2865c8d1192e",
                                "text": "La philosophie jaïne."
                            },
                            {
                                "example_id": "609c53c9-a832-4e6e-8605-c871f29c431e",
                                "sense_id": "e115dbb1-11ef-3b84-8720-2865c8d1192e",
                                "text": "Si les cinq grottes jaïnes n’ont pas la vigueur artistique et les ambitieuses dimensions des plus beaux temples hindous, elles se distinguent par leurs sculptures exceptionnellement détaillées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
