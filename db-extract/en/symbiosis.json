                                    {
                                        "sense_id": "0b1f348c-57af-3ad5-af86-64c32de0533f",
                                        "entry_id": "dbb68b4d-955c-3eb3-8906-5be242666658",
                                        "glosses": [
                                            "het samenleven van twee ongelijksoortige organismen op of in elkaar tot wederzijds voordeel"
                                        ],
