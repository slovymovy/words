                    {
                        "sense_id": "14fd1651-529d-3baf-b665-a4eee855ab79",
                        "entry_id": "de43b581-2928-3a6a-a517-a02c5d84f14b",
                        "glosses": [
                            "A male member of the House of Representatives."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b0a0c1-bd13-44b4-8aab-ebcdaa253fb3",
                                "sense_id": "14fd1651-529d-3baf-b665-a4eee855ab79",
                                "text": "There was a stampede as the congressmen jumped the banister in their hastes to be the first to sign away their souls."
                            },
                            {
                                "example_id": "9eaf1379-6732-4599-a968-783c7f8961cc",
                                "sense_id": "14fd1651-529d-3baf-b665-a4eee855ab79",
                                "text": "Two US congressmen on Tuesday made an unannounced visit to Afghanistan as the US races to evacuate as many people as possible from the country in the remaining days of the US military presence there, taking Democratic leadership by surprise and drawing swift criticism."
                            },
                            {
                                "example_id": "0f54362e-a789-48cf-8b52-f59b2cfcea51",
                                "sense_id": "14fd1651-529d-3baf-b665-a4eee855ab79",
                                "text": "For strained metaphor this has not been equaled since a bloviant congressman began his eulogy upon Senator Vance with the words […]"
                            },
                            {
                                "example_id": "9ffcfe8a-5ed4-4514-86c5-2026b534a02e",
                                "sense_id": "14fd1651-529d-3baf-b665-a4eee855ab79",
                                "text": "The committee’s investigation into Gaetz began in 2021 but was put on hold while a separate, yearslong federal sex-trafficking investigation into the former congressman was underway."
                            }
                        ]
                    }
