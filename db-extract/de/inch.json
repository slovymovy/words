                    {
                        "sense_id": "e5a248b9-916e-3278-aea7-09b18ea03290",
                        "entry_id": "cef6a283-0b76-3860-af4d-d55b400ba276",
                        "glosses": [
                            "entspricht 2,54 Zentimeter"
                        ],
                        "tags": [
