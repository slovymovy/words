                                "target_senses": [
                                    {
                                        "sense_id": "8994654b-07a0-321f-8bbd-8cb5ca8d7e7a",
                                        "entry_id": "aeb526ca-452a-3eb8-bc59-198247699954",
                                        "glosses": [
                                            "управляющий в коммерческой организации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47bba2b1-2a2a-4851-9d39-0ff6ba445c69",
                                                "sense_id": "8994654b-07a0-321f-8bbd-8cb5ca8d7e7a",
                                                "text": "Менеджер, который не привёл фирму к процветанию, держит в руках не акции, а пустые бумажки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd94aa1d-3df9-3257-b35c-de41247aef10",
                                        "entry_id": "aeb526ca-452a-3eb8-bc59-198247699954",
                                        "glosses": [
                                            "руководитель среднего звена в компании, на предприятии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90cdb3e6-c206-4ad0-96fe-66e2fb72a9df",
                                                "sense_id": "dd94aa1d-3df9-3257-b35c-de41247aef10",
                                                "text": "Перед менеджером проекта была поставлена цель ― достичь определённого планового количества посетителей сайта в день."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19aca261-1536-391e-a0c5-cee0b1586b61",
                                        "entry_id": "aeb526ca-452a-3eb8-bc59-198247699954",
                                        "glosses": [
                                            "управляющий делами спортсмена, артиста и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "352534c0-40ae-4bb9-9c73-c1cc87ab8284",
                                                "sense_id": "19aca261-1536-391e-a0c5-cee0b1586b61",
                                                "text": "У всех крупных музыкантов есть свои менеджеры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e95c91f1-7374-3d4e-8857-e3ca6be59c6e",
                                        "entry_id": "aeb526ca-452a-3eb8-bc59-198247699954",
                                        "glosses": [
                                            "комп., неодуш. управляющая программа или система"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85f75da7-90ad-477e-8ab4-8d3d67c90154",
                                                "sense_id": "e95c91f1-7374-3d4e-8857-e3ca6be59c6e",
                                                "text": "Менеджер печати позволяет, например, просматривать очереди заданий, приостанавливать и возобновлять их выполнение, перенаправлять на другие принтеры."
                                            }
                                        ]
                                    }
                                ]
                            }
