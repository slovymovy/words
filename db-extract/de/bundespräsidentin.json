                "senses": [
                    {
                        "sense_id": "4bd90df6-9162-33fe-9e54-929998a36235",
                        "entry_id": "2d6793ce-2a55-351c-9213-15c09687265d",
                        "glosses": [
                            "weibliches Staatsoberhaupt einer Bundesrepublik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d7f60bd-3007-4c60-a170-c517f69382c7",
                                "sense_id": "4bd90df6-9162-33fe-9e54-929998a36235",
                                "text": "„Eine Bundespräsidentin Schavan hätte die politische Erzählung in Deutschland bereichert und dramatisiert, neben der CDU-Chefin und möglichen Kanzlerkandidatin Angela Merkel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6dcf857-ea69-3e76-a749-71b6b0f32b52",
                        "entry_id": "2d6793ce-2a55-351c-9213-15c09687265d",
                        "glosses": [
                            "die Vorsitzende des Schweizerischen Bundesrates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23769310-2cf7-4310-8d0a-103409f191a9",
                                "sense_id": "c6dcf857-ea69-3e76-a749-71b6b0f32b52",
                                "text": "„Der Bundesrat unterstützt das von der Bundespräsidentin geäusserte Anliegen, dass sich die Parlamentarierinnen und Parlamentarier stärker für das Landesinteresse und nicht nur für parteiliche Interessen engagieren.“"
                            },
                            {
                                "example_id": "de13172a-079b-4a9a-95c2-b7d6a0198242",
                                "sense_id": "c6dcf857-ea69-3e76-a749-71b6b0f32b52",
                                "text": "„Ruth Dreifuss war im Jahre 1999 die erste weibliche Bundespräsidentin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
