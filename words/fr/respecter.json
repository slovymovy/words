        "irrespectueusement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5bf785c2-21a6-39fb-bed1-0ed50d0d6179",
                    "sense_definition": "Éprouver ou manifester de la considération, de la déférence ou de l'estime envers quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants apprennent très tôt à <w>respecter</w> leurs parents et leurs professeurs."
                        },
                        {
                            "text": "Ce professeur calme et juste sait se faire <w>respecter</w> de tous ses étudiants."
                        }
                    ],
                    "synonyms": [
                        "honorer"
                    ],
                    "antonyms": [
                        "mépriser"
                    ],
                    "common_phrases": [
                        "respecter les aînés",
                        "se faire respecter"
                    ]
                },
                {
                    "sense_id": "2fd56969-28b1-3adf-aad3-f20ffa5c9488",
                    "sense_definition": "Se conformer scrupuleusement à une loi, une consigne, un accord ou une contrainte horaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conformite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les automobilistes doivent <w>respecter</w> les règles du code de la route."
                        },
                        {
                            "text": "Nous devons terminer ce travail rapidement pour <w>respecter</w> les délais imposés."
                        }
                    ],
                    "common_phrases": [
                        "respecter les règles",
                        "respecter la loi",
                        "respecter les délais"
                    ]
                },
                {
                    "sense_id": "31d67e72-62d8-34e0-86db-97c3c42f96e1",
                    "sense_definition": "Avoir le souci de sa propre dignité et agir en conformité avec ses principes moraux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse de mentir pour réussir car il tient avant tout à se <w>respecter</w>."
                        },
                        {
                            "text": "Une personne qui se <w>respecte</w> ne tolère pas les insultes répétées."
                        }
                    ],
                    "common_phrases": [
                        "se respecter soi-même"
                    ]
                },
                {
                    "sense_id": "0f27fc7e-77d3-3013-9178-6c7722075831",
                    "sense_definition": "Ne pas porter atteinte à quelque chose, s'abstenir de le détruire ou de le dégrader.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conformite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs veillent toujours à <w>respecter</w> la nature et à ramasser leurs déchets."
                        },
                        {
                            "text": "Le traité exigeait des troupes qu'elles <w>respectent</w> les édifices historiques de la ville."
                        }
                    ],
                    "common_phrases": [
                        "respecter la nature",
                        "respecter l'environnement"
                    ]
                },
                {
                    "sense_id": "c30973d1-cff3-3bcf-b91d-54d4df7d9e31",
                    "sense_definition": "Être digne de ce nom, se montrer à la hauteur de son statut ou de sa réputation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout bon restaurant qui se <w>respecte</w> propose des produits frais et de saison."
                        },
                        {
                            "text": "Aucun cuisinier qui se <w>respecte</w> n'utiliserait de tels ingrédients industriels."
                        }
                    ],
                    "common_phrases": [
                        "qui se respecte"
                    ]
                }
            ]
        }
    ]
}