                        "entry_id": "f7545295-61bf-350a-a0d5-6eec96192af8",
                        "glosses": [
                            "Coupe ronde sans pied en forme d’assiette utilisée pour le culte ou les rituels. Elle présente en général une saillie en son centre, représentant l’ombilic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca43222-2ba3-4e9f-84ea-874010be6c8e",
                                "sense_id": "24e0e0f4-6769-3f93-a237-e2be9f4bbcce",
                                "text": "Un pocillateur debout, vêtu d’une tunique succincte, couronné de laurier et chaussé de bottines, tient une phiale et une corne d’abondance surmontée d’un croissant."
                            },
                            {
                                "example_id": "4a32cd19-600a-43d0-8270-4d973596484b",
                                "sense_id": "24e0e0f4-6769-3f93-a237-e2be9f4bbcce",
                                "text": "Le katholikon - église principale - est au centre, entouré d’ossuaires ou de phiales, destinées aux ablutions et aux baptêmes."
                            }
                        ]
                    },
