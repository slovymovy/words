                                                "example_id": "292addd8-781d-42cf-8399-fc98c46d3cce",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Herr Schafgarbe wollte uns kein Interview geben."
