                    "frequency": "Low",
                    "semantic_group_id": "aehnlichkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ihrer ruhigen und geduldigen Art <w>kommt</w> sie ganz ihrem Großvater <w>nach</w>."
