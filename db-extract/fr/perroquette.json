                "forms": [
                    {
                        "form_id": "107047d3-ac7b-4a23-aa8f-3584aaded970",
                        "entry_id": "dfbd3be7-8718-38f6-a365-8930ea40f76d",
                        "tags": [
                            "plural"
                        ],
                        "form": "perroquettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "962e856d-c8ac-383f-abe9-73dc4f3a6725",
                        "entry_id": "dfbd3be7-8718-38f6-a365-8930ea40f76d",
                        "glosses": [
                            "Perroquet femelle."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a18aa108-dd2c-4fe8-993e-18d2a5c9e556",
                                "sense_id": "962e856d-c8ac-383f-abe9-73dc4f3a6725",
                                "text": "J’ai entendu dire, affirme un chasseur, qu’il arrive parfois qu’un hibou puisse féconder les œufs d’une « perroquette »…"
                            },
                            {
                                "example_id": "eabca028-67e4-4976-8ff7-b564f930b5ed",
                                "sense_id": "962e856d-c8ac-383f-abe9-73dc4f3a6725",
                                "text": "Voilà, mon père, au couvent, nous avons adopté une perroquette abandonnée par une fille de mauvaise vie, et qui ne sait dire qu’une seule phrase épouvantable : « Je suis une pute, veux-tu t’amuser ? »"
                            },
                            {
                                "example_id": "c637a56b-0736-4d38-9c6e-cdce3a1d2349",
                                "sense_id": "962e856d-c8ac-383f-abe9-73dc4f3a6725",
                                "text": "Non, oncle Marcelin. Olbius est une… perroquette de Nouvelle-Calédonie. – Une perroquette ? C’t’oiseau au bec qui parle ?"
                            }
                        ]
                    }
                ],
