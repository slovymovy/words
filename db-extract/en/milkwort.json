                                        "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                                        "entry_id": "100135f3-23ff-3722-a99f-7b0121de78d6",
                                        "glosses": [
                                            "Plante annuelle ou vivace, dicotylédone, herbacée, parfois ligneuse selon les espèces, et dont les fleurs ont trois pétales inégaux soudés entre eux par leur base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2588b1fa-154e-47c8-9d56-efb4ebb6cce1",
                                                "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                                                "text": "Comme il fait beau, comme rien ne presse, (...) nous revenons à pied, flânant le long de la route entre les haies hautes où fleurissent les polygalas, bleus et rose vineux."
                                            },
                                            {
                                                "example_id": "be7944da-9384-4815-9285-af11856237d7",
                                                "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                                                "text": "Le polygale du calcaire (Polygala calcarea) est une petite plante herbacée vivace de la famille des Polygalacées."
                                            },
                                            {
                                                "example_id": "8f392b09-ffdb-4d43-b297-2c2d1b810274",
                                                "sense_id": "30d2d370-ae86-3b78-98e0-f878280c9358",
                                                "text": "La plus curieuse est le polygale faux-buis, Polygala chamaebuxus (du grec chamaï, nain, et de buxus, buis), sous-arbrisseau aux fleurs ailées, blanches, jaunes et rouges, dont les petites feuilles coriaces rappellent celles du buis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d039f12b-9604-4927-84bc-e4369bb6366c",
                        "source_entry_id": "84d115c3-2dbc-3c9e-b6a5-403215e4c888",
