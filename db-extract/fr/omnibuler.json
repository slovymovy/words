                ],
                "senses": [
                    {
                        "sense_id": "9f2b4a6b-9a6f-3835-99c5-0f28a8ed7f5a",
                        "entry_id": "607637e3-9685-3842-a269-a18e09b60185",
                        "glosses": [
                            "Variante (relativement fréquente, entre autres au Sénégal) d’obnubiler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8a6130-e15c-4afe-b26d-ad53ad8fd20a",
                                "sense_id": "9f2b4a6b-9a6f-3835-99c5-0f28a8ed7f5a",
                                "text": "Slouma était devenu tellement obsédé par l’argent et omnibulé par ses rêves que tout son être se paralysa."
                            },
                            {
                                "example_id": "3a03fef8-20ac-40aa-9b9f-c1015f6ab5a9",
                                "sense_id": "9f2b4a6b-9a6f-3835-99c5-0f28a8ed7f5a",
                                "text": "Pourtant, s’omnibuler sur le creuset français aurait pour effet de laisser passer une grande chance."
                            },
                            {
                                "example_id": "5d6c9f02-c238-4d01-8fcf-5050bdb5094e",
                                "sense_id": "9f2b4a6b-9a6f-3835-99c5-0f28a8ed7f5a",
                                "text": "Le carnaval d’une laideur fardée l’omnibule."
                            },
                            {
                                "example_id": "3a1e18b8-ab41-44a8-9a93-ba6f6cdcff5d",
                                "sense_id": "9f2b4a6b-9a6f-3835-99c5-0f28a8ed7f5a",
                                "text": "Il faut préciser à François Hollande qu’on dit “obnubiler” et non “omnibuler”… Les candidats et la langue française, quel désastre…"
                            }
                        ]
                    }
                ],
