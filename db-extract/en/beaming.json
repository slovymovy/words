                                "example_id": "d3419a89-b587-45de-96ff-685bb580dfb1",
                                "sense_id": "6f6a0348-25ad-39d8-9953-fd2cf473fc27",
                                "text": "The honest Captain, with his Heart's Delight in the house, and Susan tending her, was a beaming and a happy man. As the days flew by, he grew more beaming and more happy, every day."
                            },
                            {
                                "example_id": "5703ebcc-b0eb-4340-bec1-7642af212f88",
                                "sense_id": "6f6a0348-25ad-39d8-9953-fd2cf473fc27",
                                "text": "The beaming smile of David Brooks, proudly wearing his yellow Euro 2020 jersey and a bucket hat, instantly raised the spirits of those on the pitch who spotted the 25-year-old's frantic waving."
                            }
                        ]
                    }
                ],
