                {
                    "sense_id": "9a297aab-b45d-3714-92d7-9fb019b20de2",
                    "sense_definition": "jemanden an empfindlichen Körperstellen sanft berühren, sodass ein Reflex ausgelöst wird und die Person lachen muss",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beruehren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Kinder lachen laut, weil die Eltern sie sanft am Bauch <w>kitzeln</w>."
                        },
                        {
                            "text": "Hör bitte auf, mich an den Füßen zu <w>kitzeln</w>, denn ich halte das kaum aus."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "an den Füßen kitzeln"
                    ]
                },
                {
                    "sense_id": "d3e689ed-5bd4-3ee5-aaf4-adeae3ba1aea",
                    "sense_definition": "an einer Stelle des Körpers einen leichten Reiz verspüren oder erzeugen, der kribbelt oder juckt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "empfindung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der feine Blütenstaub beginnt sofort unangenehm in der Nase zu <w>kitzeln</w>."
                        },
                        {
                            "text": "Die Grashalme <w>kitzeln</w> an meinen nackten Beinen, während ich durch die Wiese laufe."
                        }
                    ],
                    "synonyms": [
                        "jucken",
                        "prickeln"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "in der Nase kitzeln"
                    ]
                },
                {
                    "sense_id": "7643cbb4-0fd4-3537-a9a8-b70af5f674b4",
                    "sense_definition": "jemanden reizen oder verlocken, eine bestimmte Handlung auszuführen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reizen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es <w>kitzelt</w> mich schon lange, das alte Geheimnis endlich aufzudecken."
                        },
                        {
                            "text": "Das verlockende Angebot sollte die Neugier der Kunden <w>kitzeln</w>."
                        }
                    ],
