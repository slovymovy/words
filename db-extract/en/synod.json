            {
                "entry_id": "663e8b43-fd60-34c5-bfdd-ed32a27e495f",
                "word": "synod",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a117c290-33bc-49dd-b5b4-35e0b1cacb41",
                        "entry_id": "663e8b43-fd60-34c5-bfdd-ed32a27e495f",
