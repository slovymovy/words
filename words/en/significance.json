                                "target_lang_sense_clarification": "важность, весомость"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bedeutung",
                                "target_lang_sense_clarification": "Relevanz oder Wichtigkeit einer Sache"
                            },
                            {
                                "target_lang_word": "Signifikanz",
                                "target_lang_sense_clarification": "Bedeutsamkeit oder Tragweite"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a30bd58-5833-33b5-9cb1-70882f2d3657",
                    "sense_definition": "The meaning to be found in words or events.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She failed to grasp the true <w>significance</w> of his gesture.",
                            "target_lang_translations": {
                                "ru": "Она не смогла уловить истинный <w>смысл</w> его жеста.",
                                "de": "Sie konnte die wahre <w>Bedeutung</w> seiner Geste nicht erfassen."
                            }
                        },
                        {
                            "text": "It took me a while to understand the full <w>significance</w> of what he had said.",
                            "target_lang_translations": {
                                "ru": "Мне потребовалось время, чтобы понять полный <w>смысл</w> того, что он сказал.",
                                "de": "Ich brauchte eine Weile, um die volle <w>Bedeutung</w> dessen zu verstehen, was er gesagt hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "import"
                    ],
                    "common_phrases": [
                        "grasp the significance",
                        "full significance",
                        "significance of"
                    ],
                    "target_lang_definitions": {
