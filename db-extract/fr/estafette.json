                                                "sense_id": "5b697250-86bc-3d30-8ad9-bdb10c4904d4",
                                                "text": "We'll have the contract couriered to you."
                                            },
                                            {
                                                "example_id": "f2e4d187-9787-4f90-bf63-08bf056008e0",
