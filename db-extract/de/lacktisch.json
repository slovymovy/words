                "senses": [
                    {
                        "sense_id": "8dc88e15-2e47-3315-b802-64d797d5549d",
                        "entry_id": "b08860a1-e67f-3340-858e-d7ce5941a85a",
                        "glosses": [
                            "Tisch mit glatter, glänzender Oberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b184f0-871d-4517-b8e3-f9a4b713d351",
                                "sense_id": "8dc88e15-2e47-3315-b802-64d797d5549d",
                                "text": "„Es läuft englische Popmusik, die beigefarbenen Ledersessel, die dunklen Lacktische und die Spiegel an der Wand bringen westlichen Lebensstil nach Kars.“"
                            },
                            {
                                "example_id": "2544e7e5-3660-42d6-894c-739d9a20846a",
                                "sense_id": "8dc88e15-2e47-3315-b802-64d797d5549d",
                                "text": "„1913 stellte sie ihre Lackschirme und Lacktische erstmals im Salon des Artistes Décorateurs aus.“"
                            },
                            {
                                "example_id": "828445c3-8a40-47a1-9815-80e339b6e394",
                                "sense_id": "8dc88e15-2e47-3315-b802-64d797d5549d",
                                "text": "„Peter Jablonski gingen die Ideen nicht aus. Er habe weiter auf Hochwertigkeit gesetzt, bot aber 2008 erstmals in der Firmengeschichte auch moderne Möbel wie etwa Lacktische an, die industriell gefertigt wurden.“"
                            },
                            {
                                "example_id": "d5b9a5cb-e19a-4992-8afa-76126f64f655",
                                "sense_id": "8dc88e15-2e47-3315-b802-64d797d5549d",
                                "text": "„In seinem Restaurant »MangoMango« kommt die Sauce fast unscheinbar in kleinen Schälchen auf die roten Lacktische, auf denen gelbe Fische schwimmen.“"
                            },
                            {
                                "example_id": "e5c2a2a8-838b-40bf-8b70-bcadbe4c4cf1",
                                "sense_id": "8dc88e15-2e47-3315-b802-64d797d5549d",
                                "text": "„– originale 60er-Jahre-Sessel, die in Fünferformation kunstvoll so um runde Lacktische arrangiert sind, dass sie das Muster einer Pflaumenblüte ergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
