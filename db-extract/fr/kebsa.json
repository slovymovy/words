                "senses": [
                    {
                        "sense_id": "50823ddc-9df3-3300-baf4-d49a3868fec4",
                        "entry_id": "084d9593-3943-3741-89ae-c9a93ef185d7",
                        "glosses": [
                            "Mets traditionnel d’Arabie saoudite, du Yémen et du reste du Moyen Orient, à base de riz et de viande de mouton ou de poulet, et d’un mélange d’épices particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44744686-e1b8-4cee-93ab-ab59c46ccb31",
                                "sense_id": "50823ddc-9df3-3300-baf4-d49a3868fec4",
                                "text": "Le kebsa (kabsa ou kabseh) est un grand classique de la cuisine orientale, il est originaire d’Arabie."
                            },
                            {
                                "example_id": "40df6974-2db8-4439-9119-8a982446b117",
                                "sense_id": "50823ddc-9df3-3300-baf4-d49a3868fec4",
                                "text": "Au déjeuner - le repas principal de la journée pour les Saoudiens - laissez-vous tenter par un leben, une sorte de yaourt ou testez le typique kebsa, à base de riz, d’épices et de viande."
                            },
                            {
                                "example_id": "84a1b1ae-6e58-432a-8e18-a3ae844c046e",
                                "sense_id": "50823ddc-9df3-3300-baf4-d49a3868fec4",
                                "text": "Extrêmement populaire auprès des clients locaux, ce restaurant traditionnel est bien connu pour ses grandes assiettes. Ici, la cuisine est une combinaison de recettes moyen-orientales, dont la plupart sont des spécialités régionales: kebsas, viandes grillées et soupes sont parmi les préférés de la clientèle."
                            }
                        ]
                    }
