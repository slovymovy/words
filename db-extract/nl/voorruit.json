                        "entry_id": "6b170c55-b7e6-30ec-afd8-49f90d857ccd",
                        "glosses": [
                            "glazen vlak aan de voorkant van een voertuig dat zorgt voor zicht op de weg en bescherming tegen weer en wind"
                        ],
                        "tags": [
                            "autotechniek"
                        ],
                        "examples": [
                            {
                                "example_id": "b9393559-10b9-4148-905d-390cc8d54122",
                                "sense_id": "b23dde45-dcf2-3f0b-911f-a4461fdcb842",
                                "text": "Door steenslag zat er een barst in de voorruit van de auto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c61c915-827b-4eb7-8db0-d9e0d08e0cbb",
                        "source_entry_id": "6b170c55-b7e6-30ec-afd8-49f90d857ccd",
                        "source_sense_id": "b23dde45-dcf2-3f0b-911f-a4461fdcb842",
                        "source_sense_description": "glazen vlak aan de voorkant van een voertuig dat zorgt voor zicht op de weg en bescherming tegen weer en wind",
                        "target_lang_word": "Windschutzscheibe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windschutzscheibe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                        "entry_id": "3b0eae5d-964d-37d9-8b70-18ba89cbcf80",
                                        "glosses": [
                                            "Flachglas, das dem Führer eines Fahrzeuges die Sicht nach vorne ermöglicht und ihn vor Wind, Wetter und Partikeln im Luftstrom schützt"
                                        ],
                                        "tags": [
                                            "Fahrzeugtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d728acc3-85bb-4949-89a7-395745086423",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "Die Windschutzscheibe wird mit warmer Luft angeströmt, damit sie nicht beschlägt."
                                            },
                                            {
                                                "example_id": "5bd299e3-276b-407f-b92b-40a28c2fc99b",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "Weil ein Stein auf die Windschutzscheibe gefallen ist, hat sie jetzt ein kleines Loch."
                                            },
                                            {
                                                "example_id": "ca63a003-54cc-4f93-aea7-2de5c04077ba",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "Zum Glück können Windschutzscheiben nicht zerbrechen, sonst hätten wir jetzt ganz viele Scherben im Auto."
                                            },
                                            {
                                                "example_id": "2f3f13df-1efc-4c14-baa4-b039afdbc5dd",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Bald klebten an meiner Windschutzscheibe innen mehr Mücken als tote Insekten vorne an meinem Kühlergrill.“"
                                            },
                                            {
                                                "example_id": "3bb671b2-77a3-4cf3-808d-dbffe91a7958",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Schneeflocken strömen den Scheinwerfern entgegen, platzen auf dem Glas der Windschutzscheibe.“"
                                            },
                                            {
                                                "example_id": "055902a3-0d6a-478a-9b72-941f4d0c6f90",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Ich sprach den Satz aus – und hätte ihn am liebsten gleich wieder weggewischt, so wie das Kondenswasser, das die Windschutzscheibe von innen beschlug.“"
                                            },
                                            {
                                                "example_id": "2aad76e9-e923-41ee-b189-c5742d1ebb53",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Als er fertig war, blickte er durch die Windschutzscheibe zu Anse hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce941ed1-eb62-4b9f-8b2f-246a70f9dae4",
                        "source_entry_id": "6b170c55-b7e6-30ec-afd8-49f90d857ccd",
                        "source_sense_id": "b23dde45-dcf2-3f0b-911f-a4461fdcb842",
                        "source_sense_description": "glazen vlak aan de voorkant van een voertuig dat zorgt voor zicht op de weg en bescherming tegen weer en wind",
                        "target_lang_word": "Frontscheibe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frontscheibe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3db440f-61f3-35ca-ab8f-aba491b94417",
                                        "entry_id": "20a32fc8-9bca-33d4-a35f-d94c6b491f9d",
                                        "glosses": [
                                            "Scheibe, die dem Führer eines Fahrzeuges die Sicht nach vorne ermöglicht und ihn vor Wind, Wetter und Partikeln im Luftstrom schützt"
                                        ],
                                        "tags": [
                                            "Fahrzeugtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "988c7eeb-1a8b-42b5-b114-15669307c7fc",
                                                "sense_id": "f3db440f-61f3-35ca-ab8f-aba491b94417",
                                                "text": "Die Frontscheibe war so verschmutzt, dass ich die Fahrbahn nicht mehr richtig sehen konnte."
                                            },
                                            {
                                                "example_id": "efe3f09b-dccc-4747-ab8a-43a705e96c72",
                                                "sense_id": "f3db440f-61f3-35ca-ab8f-aba491b94417",
                                                "text": "„Im Auto sitzend, das Gesicht nah an der Frontscheibe, tuckerte ich durch den Schnee.“"
                                            },
                                            {
                                                "example_id": "7093634e-8f7f-49c3-98ca-813a6fb1fc58",
                                                "sense_id": "f3db440f-61f3-35ca-ab8f-aba491b94417",
                                                "text": "„Transitvisa sind besorgt, an der Frontscheibe ist eine Kamera angebracht, die die Fahrt aufzeichnen wird.“"
                                            },
                                            {
                                                "example_id": "95d53952-4e66-4371-af4c-ac619af65ab5",
                                                "sense_id": "f3db440f-61f3-35ca-ab8f-aba491b94417",
                                                "text": "„Selbst, so meine Tochter, als sie ihn in der Luft in die Frontscheibe krachen sah, habe sie nicht glauben können, dass es tatsächlich passierte.“"
                                            },
                                            {
                                                "example_id": "b732f3a7-89cd-4088-b4d7-54a63a39e338",
                                                "sense_id": "f3db440f-61f3-35ca-ab8f-aba491b94417",
                                                "text": "„Bei einem Abschlag am 17. Loch passiert es: Der Ball fliegt über den Platz hinaus, durchschlägt die Frontscheibe eines Kleinwagens, der daraufhin ins Schleudern kommt und einen Schulbus rammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa9c22da-7100-48cb-b663-9a2328dd056e",
                        "source_entry_id": "6b170c55-b7e6-30ec-afd8-49f90d857ccd",
                        "source_sense_id": "b23dde45-dcf2-3f0b-911f-a4461fdcb842",
