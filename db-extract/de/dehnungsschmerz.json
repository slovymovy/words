                "senses": [
                    {
                        "sense_id": "41cf1a8d-d8bf-36e9-9284-6498e3a8270d",
                        "entry_id": "76b12b44-8776-3288-877b-aa3815fc4572",
                        "glosses": [
                            "Schmerz, der beim Dehnen auftritt (wenn über die normale Elastizitätsgrenze hinaus gedehnt wird)"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "88a69600-1757-4f26-bab0-3714e3d11d5d",
                                "sense_id": "41cf1a8d-d8bf-36e9-9284-6498e3a8270d",
                                "text": "„Dehnübungen für die Unterarmmuskulatur, den Bizeps und die Brustmuskulatur werden einmal täglich eine Minute lang mit minimalem Dehnungsschmerz durchgeführt.“"
                            },
                            {
                                "example_id": "07636250-3972-416f-8e9c-206009b083e1",
                                "sense_id": "41cf1a8d-d8bf-36e9-9284-6498e3a8270d",
                                "text": "„Wenn es jemanden gibt, der die Dehnungsschmerzen der CSU während der Operation Söder am eigenen Leib erfahren hat, dann ist es die frühere Umweltministerin und heutige Landtagsabgeordnete Ulrike Scharf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
