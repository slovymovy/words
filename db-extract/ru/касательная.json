                                    {
                                        "sense_id": "b0ea85ed-dd25-31c2-9f18-99202b8cad6a",
                                        "entry_id": "470ebe8e-064c-3fbc-920f-103476bcbcd2",
                                        "glosses": [
                                            "Gerade, die eine Kurve in einem Punkt berührt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e53c75-d7a5-44d3-9bb1-46d9a0534e8e",
                                                "sense_id": "b0ea85ed-dd25-31c2-9f18-99202b8cad6a",
                                                "text": "„Eine Gerade ist genau dann Sekante eines gegebenen Kreises, wenn der Abstand des Kreismittelpunkts von der Geraden kleiner ist als der Radius des Kreises. Bei gleichem Abstand und Radius wäre es eine Tangente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d92fc9c-0f0e-3dab-b26c-35fdde5cc0aa",
                                        "entry_id": "470ebe8e-064c-3fbc-920f-103476bcbcd2",
                                        "glosses": [
                                            "Straße, die dicht an einem Gebiet vorbeiführt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b18dfe-a870-4d6f-82d6-6928313514e3",
                                                "sense_id": "6d92fc9c-0f0e-3dab-b26c-35fdde5cc0aa",
                                                "text": "„Die Nürnberger Straße ist eine vierspurige Straße in Dresden. Sie ist ein Teilstück der südlichen Tangente des Dresdner Hauptstraßennetzes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
