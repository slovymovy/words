                    },
                    {
                        "form_id": "29accecb-d6e8-4452-a2f3-566a89df6f5a",
                        "entry_id": "c0a222f7-a1b2-3082-9d90-0893f8d4a54c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zeitachsen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "107b495c-14f8-3cab-861c-84b36d21f3ea",
                        "entry_id": "c0a222f7-a1b2-3082-9d90-0893f8d4a54c",
                        "glosses": [
                            "gerade Linie in einer Grafik zur Darstellung des zeitlichen Verlaufes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14fa51c-5b99-4d00-849a-a36db76882e5",
                                "sense_id": "107b495c-14f8-3cab-861c-84b36d21f3ea",
                                "text": "Man kann sich eine Zeitachse als eine Folge von Zeitstellen vorstellen, z.B. Stunden, Tage, Wochen oder Monate. Man spricht dann von einer diskreten Zeitachse, und zur numerischen Repräsentation können natürliche Zahlen verwendet werden."
                            },
                            {
                                "example_id": "1bc80c7c-8c4d-4d81-9dcf-1a014d9a02e5",
                                "sense_id": "107b495c-14f8-3cab-861c-84b36d21f3ea",
                                "text": "Hierzu wird eine bauteilspezifische Zeitachse eingeführt, die es ermöglicht, den gesamten Herstellungsprozess und die lückenlose Betriebs- und Belastungsgeschichte abzubilden."
                            },
                            {
                                "example_id": "9e743ed9-dc1b-4bee-90ed-09374055cc97",
                                "sense_id": "107b495c-14f8-3cab-861c-84b36d21f3ea",
                                "text": "Die Zeitachse kann unterschiedlich skaliert und belegt sein und widerspiegelt nicht unbedingt die tatsächlichen zeitabhängigen Veränderungen einer Datenmenge."
                            },
                            {
                                "example_id": "7c0a4406-dfcd-4f47-9b20-bd013b796a91",
                                "sense_id": "107b495c-14f8-3cab-861c-84b36d21f3ea",
                                "text": "Die Zeitachse kann Ihnen mehr Einzelheiten liefern, wenn Sie einen oder mehrere Sammel- oder Teilvorgänge hinzufügen."
                            },
                            {
                                "example_id": "3ecfa128-f2b9-4909-8c33-4b49d1d5078c",
                                "sense_id": "107b495c-14f8-3cab-861c-84b36d21f3ea",
                                "text": "In der Zeitachse können Sie Vorgänge verdichtet darstellen, ausdrucken und die Grafik in andere Anwendungsprogramme wie Powerpoint oder in eine E-Mail kopieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e0ac7d8-dc87-3289-bcea-9b845109b242",
                        "entry_id": "c0a222f7-a1b2-3082-9d90-0893f8d4a54c",
                        "glosses": [
                            "der zeitliche Verlauf"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "806ef856-d326-4db2-b659-5eceeec8a3b4",
                                "sense_id": "0e0ac7d8-dc87-3289-bcea-9b845109b242",
                                "text": "Uns erscheint es als selbstverständlich, entlang einer linearen Zeitachse Vergangenes zu erinnern und Zukünftiges zu erwarten."
                            },
                            {
                                "example_id": "cc858c89-b4f7-49ee-a2b5-658cc34a543e",
                                "sense_id": "0e0ac7d8-dc87-3289-bcea-9b845109b242",
                                "text": "\"Nicht in der Sache, aber auf der Zeitachse\" müsse man Griechenland und anderen reformwilligen Ländern entgegenkommen."
                            },
                            {
                                "example_id": "51b1303f-069e-4959-8113-36f3c7118285",
                                "sense_id": "0e0ac7d8-dc87-3289-bcea-9b845109b242",
                                "text": "Ein weiterer kritischer Faktor ist die Zeitachse, besonders dann, wenn sie durch eine \"Deadline\" begrenzt wird."
                            },
                            {
                                "example_id": "c92aba26-36e1-410d-8703-74878d6e2757",
                                "sense_id": "0e0ac7d8-dc87-3289-bcea-9b845109b242",
                                "text": "Wir neigen zu der Vorstellung, dass sich Ressourcen entlang der Zeitachse verschieben lassen."
                            },
                            {
                                "example_id": "62ad6146-c7cc-4241-98b9-784360178325",
                                "sense_id": "0e0ac7d8-dc87-3289-bcea-9b845109b242",
                                "text": "Es gibt in der Ökonomie keine Zeitachse im klassischen Sinn."
                            },
                            {
                                "example_id": "0d072c60-56b8-4518-b8fb-be24cec0b1cf",
                                "sense_id": "0e0ac7d8-dc87-3289-bcea-9b845109b242",
                                "text": "Die Weine variieren in drei Dimensionen: lokal nach Gebiet, Ortschaft und Chateau, sowie nach der Qualität und, drittens, auf der Zeitachse."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
