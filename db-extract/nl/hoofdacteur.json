                        "entry_id": "c8626b7f-28e3-3e22-9325-e9c83c6c336d",
                        "glosses": [
                            "degene die voor een bepaalde ontwikkeling veel belangrijker is dan andere betrokkenen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
