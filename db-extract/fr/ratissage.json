                "senses": [
                    {
                        "sense_id": "d18a4676-6982-37ff-9925-833723bc2ad1",
                        "entry_id": "afa923a9-b3f4-3d15-873b-398e4ff66c34",
                        "glosses": [
                            "Action de ratisser : utilisation d'un râteau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad7a760-203a-4a73-b17f-ba5f863a8afd",
                                "sense_id": "d18a4676-6982-37ff-9925-833723bc2ad1",
                                "text": "Le ratissage d’une allée."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b441340-8019-3917-8ffc-87fafac9132a",
                        "entry_id": "afa923a9-b3f4-3d15-873b-398e4ff66c34",
                        "glosses": [
                            "Quadrillage d'une zone à la recherche de quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5f1c1c3c-2a09-4f81-8cbb-33663f17dcbc",
                                "sense_id": "0b441340-8019-3917-8ffc-87fafac9132a",
                                "text": "Fille et femme protestèrent de leur innocence. Gwen proposa une opération ratissage dans le bureau, sachant combien son père avait la main égareuse ces temps derniers."
                            },
                            {
                                "example_id": "a20c928c-e5b7-4708-b508-0fd85346628a",
                                "sense_id": "0b441340-8019-3917-8ffc-87fafac9132a",
                                "text": "Informés de la situation, l’agent Stéphane Fortin et le sergent Jean-Michel Juteau de la Régie intermunicipale de police Richelieu-Saint-Laurent se rendent à cet endroit pour commencer un ratissage."
                            },
                            {
                                "example_id": "f67da713-35a6-4eb6-ba22-f7660ddd8ebc",
                                "sense_id": "0b441340-8019-3917-8ffc-87fafac9132a",
                                "text": "Quarante-deux mafiosi ont néanmoins réussi à prendre la fuite, mais les « ratissages » continuent dans l’Aspromonte (la montagne du sud calabrais, faisant office de « maquis ») et il est probable que la liste des inculpés va s’allonger."
                            }
                        ]
                    },
                    {
                        "sense_id": "f404756f-a991-32c7-9408-f143a6ee8589",
                        "entry_id": "afa923a9-b3f4-3d15-873b-398e4ff66c34",
                        "glosses": [
                            "Visite détaillée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0eccea59-4c8b-4c02-90ea-4b9ae65c6ebf",
                                "sense_id": "f404756f-a991-32c7-9408-f143a6ee8589",
                                "text": "Nos longues vacances se partageaient entre marches forcées complètement folles, ratissages systématiques d’un pays, d’une province, d’une ville, et studieuses heures ou journées de lecture."
                            }
                        ]
                    },
                    {
                        "sense_id": "082e33d0-fbf1-38b5-906c-420f408b0331",
                        "entry_id": "afa923a9-b3f4-3d15-873b-398e4ff66c34",
                        "glosses": [
                            "Action consistant, lors d’une mêlée ouverte, à se disputer le ballon avec les pieds."
                        ],
                        "tags": [],
                        "examples": []
                    }
