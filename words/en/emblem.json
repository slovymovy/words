                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A silver falcon was chosen as the central <w>emblem</w> on the knight's shield."
                        },
                        {
                            "text": "The heraldic <w>emblem</w> was carefully painted onto the surface of the coat of arms."
                        }
                    ],
                    "common_phrases": [
                        "heraldic emblem"
                    ]
                },
                {
                    "sense_id": "e860f494-8d1f-37fd-8984-0b09a29973c2",
                    "sense_definition": "Inlaid work, mosaic, or an ornamental design inserted into a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique table featured an intricate <w>emblem</w> carved from polished ivory."
                        },
                        {
                            "text": "Colored stones were used to form a rich decorative <w>emblem</w> across the floor."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical usage for inlay or mosaic work."
