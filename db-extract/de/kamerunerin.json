                "senses": [
                    {
                        "sense_id": "03744441-d7ee-3854-8621-8b4f11d228c7",
                        "entry_id": "c04211ee-2dc5-335f-a875-d3a0c1c48acb",
                        "glosses": [
                            "Staatsbürgerin von Kamerun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480e7bd2-2bd3-4aa3-997d-cab8687e2912",
                                "sense_id": "03744441-d7ee-3854-8621-8b4f11d228c7",
                                "text": "„Dass Kameruner und Kamerunerinnen Europäer und Europäerinnen vor Gericht anklagen konnten, hatte dennoch das Potential, die Fundamente der kolonialen Ordnung zu erschüttern.“"
                            },
                            {
                                "example_id": "70e42240-c2b2-4286-b269-51ae1609ab81",
                                "sense_id": "03744441-d7ee-3854-8621-8b4f11d228c7",
                                "text": "„Es zeichnet sich einerseits in der Wahrnehmung der Kamerunerin beziehungsweise des Kameruners als ›edle Wilde‹ eine positive Wertung ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b32b6dcc-fa29-4522-a052-956f83b12358",
                        "source_entry_id": "c04211ee-2dc5-335f-a875-d3a0c1c48acb",
                        "source_sense_id": "03744441-d7ee-3854-8621-8b4f11d228c7",
                        "source_sense_description": "Staatsbürgerin von Kamerun",
                        "target_lang_word": "Cameroonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cameroonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59eceb23-2496-3c12-8363-80642e84af0c",
                                        "entry_id": "c7f1ff11-73a9-3729-a642-c8f22b2e4084",
                                        "glosses": [
                                            "Of, from, or pertaining to Cameroon, the Cameroonian people or the Cameroonian language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e8bc54-d91a-4384-89a8-0f71006d0acf",
                                                "sense_id": "59eceb23-2496-3c12-8363-80642e84af0c",
                                                "text": "In January, Boko Haram struck Fotokol, a Cameroonian town separated by only a bridge from Gambarou, Nigeria, a stronghold of the Islamist extremists. The attackers killed more than 400 people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cameroonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5ad23c-18cb-3e6e-9228-81ac4ead61f3",
                                        "entry_id": "502d3443-a753-38a8-9212-6cad96db67a1",
                                        "glosses": [
                                            "A person from Cameroon or of Cameroonian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41304a70-f59d-4d20-b313-fde892a0fa02",
                                                "sense_id": "9e5ad23c-18cb-3e6e-9228-81ac4ead61f3",
                                                "text": "Nouma said he believes “most of the worst attacks we have suffered” were carried out by Cameroonians fighting for Boko Haram."
                                            },
                                            {
                                                "example_id": "b2bfc62d-3b57-418e-9e60-630122bd5225",
                                                "sense_id": "9e5ad23c-18cb-3e6e-9228-81ac4ead61f3",
                                                "text": "Cameroonian Jean Mboulé was born in France but when he applied for a visa in 2022 alongside his wife using similar documents, his application was rejected but hers was not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
