                        ],
                        "examples": [
                            {
                                "example_id": "8122a69b-2088-4c4e-837a-7624e635f1de",
                                "sense_id": "84c73731-36de-3618-bb98-03581a5a831c",
                                "text": "Les logistes, eux aussi, percevaient un éphodion qui s'élevait à 60 drachmes par tête. Dans l'état actuel de nos connaissances, les logistes déliens sont les seuls auditeurs des comptes à avoir touché une indemnité de ce type."
                            }
                        ]
                    }
