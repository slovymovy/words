                                            {
                                                "example_id": "e388e36f-d7c9-4b9a-9e23-f501a4e56904",
                                                "sense_id": "e3fb96e5-4c8d-3b14-b6e6-15cc1114eea3",
                                                "text": "Рассвирепел начальник, решил ― чернуха, вранье, значит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a843c81e-6293-3d51-85f3-88ab2cf9ca0c",
                                        "entry_id": "6f750248-2480-3941-b2ec-88314d607713",
                                        "glosses": [
                                            "собир., разг. тёмные, негативные стороны жизни, быта, проникнутые обречённостью и беспросветностью, сопровождающиеся сценами жестокости и насилия, а также показ таких мрачных, неприглядных сторон жизни, быта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01d2820-1cac-4b95-9bef-83629623bbcb",
                                                "sense_id": "a843c81e-6293-3d51-85f3-88ab2cf9ca0c",
                                                "text": "Желание поставить добрую, милую, ироничную комедию было своего рода реакцией на обилие фильмов с чернухой, ругательствами, сексуальной разнузданностью, грязью внешней и внутренней, а главное, картин бессердечных."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "черну́ха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "939630bf-93d9-3819-a99f-77fd70ba1870",
                                        "entry_id": "d8c447a4-d619-328a-bc7f-eb7628f89e0d",
