                    "target_lang_definitions": {
                        "ru": "Большая кухонная плита с несколькими конфорками и духовками.",
                        "tr": "Birden fazla ocağı ve fırını bulunan büyük mutfak kuzinesi veya ocağı.",
                        "zh": "带有多个炉头和烤箱的大型烹饪灶具。"
                    },
                    "translations": {
