                        "examples": [
                            {
                                "example_id": "52c7d201-163b-4d5b-9f71-19dd56191da4",
                                "sense_id": "d48993d9-9939-3874-b0b9-40e2b7a3a802",
                                "text": "Il ne le prit pas, il l’engloutit. Puis, une fois le volume bien approfondi dans sa poche, il resta sans bouger, sans parler, la tête penchée sur l’épaule, essuyant ses lunettes d’un air attendri."
                            }
                        ]
