                "senses": [
                    {
                        "sense_id": "592387c3-65fd-38bc-b971-24d016d8628c",
                        "entry_id": "cda246f6-3b96-3f0a-a898-2496df0edb8a",
                        "glosses": [
                            "onbeleefd, onbeschoft en onwellevend (door het ontbreken van een goede opvoeding)"
                        ],
                        "tags": [
                            "van een persoon"
                        ],
                        "examples": [
                            {
                                "example_id": "fb8f94f5-f863-419d-8c87-9b180117dc58",
                                "sense_id": "592387c3-65fd-38bc-b971-24d016d8628c",
                                "text": "Maar aan de muren deden we niets en toen we later weer verhuisden en we nog een keer ons hoofd om de hoek van de deur staken om er zeker van te zijn dat we niets hadden vergeten, zagen we meteen dat de kamer volledig gerenoveerd zou moeten worden door professionele werklui die zich hoofdschuddend zouden afvragen wat voor verwend, onopgevoed kind deze vierkante meters had bewoond."
                            },
                            {
                                "example_id": "f8a16873-3805-4803-8a95-57ea3a7a490b",
                                "sense_id": "592387c3-65fd-38bc-b971-24d016d8628c",
                                "text": "Welkom in het jeugdrecht, waar Jeltes opkomt voor de belangen van kinderen. Hoe moeilijk, irritant of onopgevoed ze ook zijn. „Je stáát voor ze, ook voor de schoffies, ook voor de gewetenlozen. Zij hebben ook niet zelf voor hun leven gekozen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a5ee71a-c2ec-48c8-a159-8999045a1c8e",
                        "source_entry_id": "cda246f6-3b96-3f0a-a898-2496df0edb8a",
                        "source_sense_id": "592387c3-65fd-38bc-b971-24d016d8628c",
                        "source_sense_description": "onbeleefd, onbeschoft en onwellevend",
                        "target_lang_word": "unmannerly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmannerly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                        "entry_id": "63ecfc93-fd8b-3f7b-9968-09eb28f19a57",
                                        "glosses": [
                                            "Not mannerly (“polite; having good manners”)."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24d5ce2a-f639-4e7b-8697-576e732fcb89",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "[T]he Dogge nuſling his noſe vnder the necke of the Deare, the Wolfe glad to let the Lambe lye vpon hym to kéepe him warme, the Lyon ſuffering the Aſſe to caſt hys legge ouer him: preferring one honeſt vnmannerly friende, before a number of croutching picke-thankes."
                                            },
                                            {
                                                "example_id": "a0bef933-ea37-45a3-a284-ab278a8ca445",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "I humbly do entreat your Highneſſe pardon, / My haſt made me vnmannerly."
                                            },
                                            {
                                                "example_id": "54dda195-7f79-4196-8193-1edf3b8ba684",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "He calmly rebuked my uncle for his unmannerly behaviour, which he ſaid he would excuſe on account of his education: he told him he had been very kind to the boy, whom he had kept at ſchool ſeven or eight years, although he was informed he made no progreſs in his learning; […]"
                                            },
                                            {
                                                "example_id": "c79b6988-1a37-4ef9-b704-9d2b15081d32",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "Halloa! whew! there goes my tarpaulin overboard; Lord, Lord, that the winds that come from heaven should be so unmannerly! This is a nasty night, lad."
                                            },
                                            {
                                                "example_id": "f0cb4846-16a5-48eb-8f10-9562a5a435a3",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "‘What have I earned for all that work,’ I said, / ‘For all that I have done at my own charge? / The daily spite of this unmannerly town, / Where who has served the most is most defamed, / The reputation of his lifetime lost / Between the night and morning. [...’]"
                                            },
                                            {
                                                "example_id": "dbc84e84-59c8-4abc-b514-dce9fc599d8c",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "If modern Javanese table manners are still nearly the same as those prevailing in 14th-century Majapahit, finishing the plates was considered unmannerly and an indication of greed. The partly emptied plates were given to the servants to finish."
                                            },
                                            {
                                                "example_id": "1fff618c-fa37-4924-a1fa-a206b5ee1a76",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "The Analects [of Confucius] dramatize in the famous scorned image of the unmannerly old man that virtue is not coterminous with age, but it would be \"misleading to suppose … that one's moral growth can significantly surpass one's physical maturation.\""
                                            },
                                            {
                                                "example_id": "ad3170e6-8ebc-4f6d-8cf2-358243a08f99",
                                                "sense_id": "16db9b38-2e98-34ee-a957-ee81baf7d6d2",
                                                "text": "So you will allow me to be insulted by an unmannerly bastard in your home?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unmannerly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "665c2e42-22d0-3e7c-8c97-f5536dd0321f",
                                        "entry_id": "efdbebb1-10fa-3948-aa46-c1e27b15c2b7",
                                        "glosses": [
                                            "In a way that is not mannerly; discourteously, rudely."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7011d54d-9de9-432d-868e-a3bd70f6f2bb",
                                                "sense_id": "665c2e42-22d0-3e7c-8c97-f5536dd0321f",
                                                "text": "[T]here the Murtherers, / Steep’d in the Colours of their Trade; their Daggers / Vnmannerly breech'd with gore: [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
