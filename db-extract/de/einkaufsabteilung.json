                ],
                "senses": [
                    {
                        "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                        "entry_id": "3150fe2f-5725-3167-8778-d08c1daec435",
                        "glosses": [
                            "Einheit in einer Organisation (=Abteilung), die für den Erwerb der von der Organisation (beispielsweise einem Unternehmen, einer staatlichen Behörde) benötigten Materialien, Maschinen und Dienstleistungen zuständig ist; die Einkaufsabteilung hat dabei die Aufgabe, die Waren/Dienstleistungen in der benötigten Menge und Qualität zum günstigsten Preis termingerecht zu beschaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6958d5d0-d3ed-4142-ae10-86b6f484fd79",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "Herr Müller ist der Leiter unserer Einkaufsabteilung."
                            },
                            {
                                "example_id": "c7b06cf3-46fa-4468-92b4-1bbc1dad0a9d",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "In der Einkaufsabteilung arbeiten sechs Mitarbeiter."
                            },
                            {
                                "example_id": "2809a2ca-b67a-4232-a785-65ac834cda7a",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "Die Einkaufsabteilung ist von morgens 7 Uhr bis nachmittags 18 Uhr besetzt."
                            },
                            {
                                "example_id": "39649984-0b95-48a8-9031-b32844bf07d3",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "Wir haben die Zuständigkeit in der Einkaufsabteilung nach Warengruppen organisiert."
                            },
                            {
                                "example_id": "8ac8cf04-2237-43e4-93d2-6eeaedb88b15",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "Die Mitarbeiter von Einkaufsabteilungen sind immanent gefährdet durch Korruption und Schmiergeldzahlungen."
                            },
                            {
                                "example_id": "d89c0300-50c1-40c3-aeac-a22faea336ac",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "Die Einkaufsabteilungen der deutschen Lebensmitteleinzelhändler sind berüchtigt für den Druck, den sie auf ihre Lieferanten ausüben."
                            },
                            {
                                "example_id": "f29df8d4-e181-44ad-860e-4031b748f176",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "„»Wir haben unsere Einkaufsabteilung abgekoppelt von allen bestellenden Bereichen.«“"
                            },
                            {
                                "example_id": "7465aae1-4629-491e-a56b-d8bcb82f5435",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "Ein weiterer, in den USA beschäftigter Mitarbeiter der Einkaufsabteilung von BMW hatte über mehrere Jahre hinweg von Faurecia bis zu 500.000 € Schmiergeld angenommen und dafür den französischen Zulieferer bei der Auftragsvergabe bevorzugt."
                            },
                            {
                                "example_id": "18aed748-333e-45d5-bc4e-caaf56bbae79",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "[Halloren aus Halle/Saale:] „Auch nach der Wende blieb er Chef der Einkaufsabteilung, doch mit dem Werk ging es bergab.“"
                            },
                            {
                                "example_id": "4bda5747-30f5-4cea-8046-51351bcb3d00",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "„Der Familienbetrieb mit etwa 130 Mitarbeitern hat im vergangenen Jahr seine Einkaufsabteilung aufgestockt.“"
                            },
                            {
                                "example_id": "8d1ad382-2a82-41b4-a0b1-5ce75ccf10c0",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "„Die aktuellen Produktionsprobleme bei Volkswagen sind für ihn vor allem auf das Versagen der Einkaufsabteilung des Wolfsburger Konzerns zurückzuführen.“"
                            },
                            {
                                "example_id": "c81c739d-84e6-48b2-bfca-6d1e4bb37d90",
                                "sense_id": "6914561e-2b97-32a4-adf3-3a83dfdcf9e1",
                                "text": "„Fachabteilungen, die direkt einkaufen, nutzen die zur Verfügung stehenden Beschaffungsinstrumente und Einkaufshebel in geringerem Maß als die Einkaufsabteilung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
