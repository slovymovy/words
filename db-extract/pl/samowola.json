                        "sense_id": "4512059b-7723-397f-97e5-5049c97b9b47",
                        "entry_id": "9be61260-1b50-36a1-89e9-f7e5b19ff7f4",
                        "glosses": [
                            "postępowanie jedynie według własnej woli, bez liczenia się z innymi czy lekceważąc prawo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794f4f83-a42c-4727-922f-da2e1f6027d5",
                                "sense_id": "4512059b-7723-397f-97e5-5049c97b9b47",
                                "text": "Zobacz, jak poprzez samowolę polskiej szlachty nasz kraj przechodził w niebyt."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
