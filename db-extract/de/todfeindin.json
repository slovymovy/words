                "senses": [
                    {
                        "sense_id": "21963039-559d-3f19-bac2-20a74fa149f3",
                        "entry_id": "bfc46b2c-5d73-3405-86c8-8e215598659d",
                        "glosses": [
                            "unversöhnliche Feindin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76a7b004-1353-4791-a288-f3ce459a731c",
                                "sense_id": "21963039-559d-3f19-bac2-20a74fa149f3",
                                "text": "Sie hatte Marita vor den anderen bloßgestellt und sich damit eine neue Todfeindin gemacht, das war ihr klar."
                            },
                            {
                                "example_id": "f13a1912-f072-42ea-85cc-c6c5631cef5f",
                                "sense_id": "21963039-559d-3f19-bac2-20a74fa149f3",
                                "text": "„Und ausgerechnet diese Frau, die er seit der Heirat der Tochter Renée unausgesetzt enttäuscht, geärgert und entsetzt hatte, die ihm bei alldem schon längst nicht mehr gewogen sein konnte – diese so mächtige und einflußreiche Präsidentin macht der leichtsinnige Marquis zu seiner Todfeindin durch die Verführung ihrer noch unverheirateten Tochter Anne-Prospère.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
