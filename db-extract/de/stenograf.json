                        "source_sense_id": "f97e4c46-da89-36da-8e67-e0b79f6c6522",
                        "source_sense_description": "Person, die die Stenografie, die Kurzschrift beherrscht",
                        "target_lang_word": "stenographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stenographer",
