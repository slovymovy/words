                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4f3a17-860f-3e0d-8e06-a3ce597efcbf",
                                        "entry_id": "435587a9-7332-3d63-aeaa-92bfaa2549d1",
                                        "glosses": [
                                            "unterste Hülle der Atmosphäre eines Sterns (besonders der Sonne), die das sichtbare Licht abstrahlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74845285-3b89-470c-ba6d-5273ff1db32b",
                                                "sense_id": "fe4f3a17-860f-3e0d-8e06-a3ce597efcbf",
                                                "text": "Die Sonne hat ein relativ kühle Fotosphäre von 5700 K und eine mehrere Millionen Kelvin heissen Korona."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "875d1248-8f48-48c4-a11b-0039bcdf086a",
                        "source_entry_id": "9238edce-2196-396d-b1a6-4a75202f8741",
                        "source_sense_id": "d104f8b0-bec3-30ec-8602-25bcb3e4944e",
                        "target_lang_word": "Photosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Photosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                        "entry_id": "769a75ae-af93-3330-962d-8c9a6a5341db",
                                        "glosses": [
                                            "Licht- und Wärmestrahlung aussendende Schicht einer Sternatmosphäre. Für den mit optischen Hilfsmitteln ausgestatteten Beobachter stellt die Photosphäre die sichtbare Sternoberfläche dar."
                                        ],
                                        "tags": [
                                            "Astrophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f306080-bf47-4dc3-b6b4-12d0c452e541",
                                                "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                                "text": "„Das kontinuierliche Spektrum einer Photosphäre ist in allererster Näherung das eines schwarzen Strahlers mit der sogenannten Effektiven Temperatur des Sterns, das allerdings sowohl durch kontinuierliche Absorption, zum Beispiel des neutralen Wasserstoffatoms, sowie durch die Linienabsorption der Spektrallinien modifiziert wird.“"
                                            },
                                            {
                                                "example_id": "77096ca5-57bb-4109-9761-1b0c2a917f54",
                                                "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                                "text": "„Die Photosphäre erscheint weitgehend gleichmäßig hell, lediglich unterbrochen durch Sonnenflecken und Flares.“"
                                            },
                                            {
                                                "example_id": "1e308823-d114-488a-a7e5-78c661f9ee8d",
                                                "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                                "text": "„Über der Photosphäre erstrecken sich die Chromosphäre (Dicke: 5000 km; Temperatur: bis 20000 °C) und die Korona (Temperatur: bis 2 Mio. °C), die die Sonnenatmosphäre bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44fbda4d-4411-4bc1-a9bf-82a7b8ab564c",
                        "source_entry_id": "9238edce-2196-396d-b1a6-4a75202f8741",
                        "source_sense_id": "d104f8b0-bec3-30ec-8602-25bcb3e4944e",
                        "target_lang_word": "fotosfeer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fotosfeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f5c9789-2c1c-3562-ab7f-7168b87ce836",
                                        "entry_id": "56f927f5-e59e-39fb-b14d-2b19ed7593ca",
                                        "glosses": [
                                            "lichtgevende buitenkant van een ster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22133f50-ca2f-4261-b268-03bb769b2ffa",
                                                "sense_id": "6f5c9789-2c1c-3562-ab7f-7168b87ce836",
                                                "text": "Sterren als Polaris pulseren omdat er ergens ver onder hun oppervlak een (gas)laag zit die instabiel is. In het centrum van de ster is bijna al het gas geïoniseerd: alle atomen hebben er hun elektronen verloren. Aan de buitenkant van de ster, de fotosfeer, is het gas niet geïoniseerd. Ergens tussen die twee uitersten in ligt een overgangslaag, waarin de gassen slechts voor een deel zijn geïoniseerd."
                                            },
                                            {
                                                "example_id": "36104a86-a79d-4902-9223-96414aa8e03e",
                                                "sense_id": "6f5c9789-2c1c-3562-ab7f-7168b87ce836",
                                                "text": "De chromosfeer is de laag die de overgang vormt tussen het zichtbare zonsoppervlak (de fotosfeer, die een temperatuur van 6000 graden heeft) en de voor het oog niet zichtbare, maar zeer uitgebreide corona."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
