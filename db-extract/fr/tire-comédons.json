                        "glosses": [
                            "Outil servant à l’extraction mécanique des comédons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee499431-16ca-4a47-a8d4-93deb27d0d27",
                                "sense_id": "d69d5bd4-4ce7-38f3-acd1-309330eab27b",
                                "text": "Je commence par passer mes mains sur mon visage pour repérer les zones d’imperfections. J’utilise ensuite un tire-comédons pour extirper les points noirs, puis je m’attaque au bouton et au grain de ma peau. Je gratte, j’exfolie et pour terminer je désinfecte."
                            },
                            {
                                "example_id": "b57466af-5536-4ff8-8e49-87ab7d561b11",
                                "sense_id": "d69d5bd4-4ce7-38f3-acd1-309330eab27b",
                                "text": "Il existe des outils faciles d’utilisation contre les points noirs, comme le tire-comédons qui, d’une simple pression, extrait le point noir de votre peau sans la martyriser."
                            }
                        ]
                    }
