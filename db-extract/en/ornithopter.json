                    {
                        "translation_id": "8a75589d-893c-4402-acb2-09df2f0150ad",
                        "source_entry_id": "46ae3e0c-2f4e-3943-85bb-0438dacf08c5",
                        "source_sense_id": "38b6397f-9330-309a-86ab-8d789177c015",
                        "source_sense_description": "aircraft that flaps its wings",
                        "target_lang_word": "ornithoptère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithoptère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e90ef11-c70b-36fa-ad8f-b508574ed2c8",
                                        "entry_id": "a20436de-38ea-3a33-a265-3503a62a1aab",
                                        "glosses": [
                                            "Aéroplane dont la sustentation est assurée par des battements d’ailes suivant le principe du vol des oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a31f272-4ef9-4433-b897-866f6d96ffa9",
                                                "sense_id": "9e90ef11-c70b-36fa-ad8f-b508574ed2c8",
                                                "text": "Deuxièmement, les inventeurs croient que l’ornithoptère permettra l’essor sur place."
                                            },
                                            {
                                                "example_id": "58f2e456-03d8-4dc7-9a9e-872dfbd4817e",
                                                "sense_id": "9e90ef11-c70b-36fa-ad8f-b508574ed2c8",
                                                "text": "Et lorsque d’autre part, il poursuivait avec autant de persévérance que d’ingéniosité ses études sur le vol des oiseaux, c’était dans le but d’en appliquer le délicat mécanisme à un ornithoptère qui le reproduirait aussi exactement que possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ead760b-023b-3dd7-babd-8bd468dd075c",
                                        "entry_id": "a20436de-38ea-3a33-a265-3503a62a1aab",
                                        "glosses": [
                                            "Genre de grand papillon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d17764ae-8622-4045-8fa5-543f98e2e8f4",
                        "source_entry_id": "46ae3e0c-2f4e-3943-85bb-0438dacf08c5",
                        "source_sense_id": "38b6397f-9330-309a-86ab-8d789177c015",
                        "source_sense_description": "aircraft that flaps its wings",
                        "target_lang_word": "Ornithopter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ornithopter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d01ffd6-c7cb-35fb-bb28-efeb22c45358",
                                        "entry_id": "e441516b-3111-3fee-bb15-a665e78efa48",
                                        "glosses": [
                                            "Luftfahrzeug, bei dem der Vortrieb durch Bewegen der Tragflächen erzeugt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8476106-6bff-4573-9541-ca80bed9164d",
                                                "sense_id": "5d01ffd6-c7cb-35fb-bb28-efeb22c45358",
                                                "text": "„Es sei der erste Ornithopter - ein Fluggerät, das durch Bewegung der Tragflächen Vortrieb erzeugt -, der ohne Regelung und aerodynamische Stabilisierung etwa durch Segelflächen auskomme, berichten Leif Ristroph und Stephen Childress von der Universität New York im \"Journal of the Royal Society Interface\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
