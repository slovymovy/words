                                        "entry_id": "1b2c999d-2373-3fdf-891c-ee104076efca",
                                        "glosses": [
                                            "A method used to begin or resume play in basketball. Two opposing players attempt to gain control of the ball after it is tossed up into the air in between them by an official."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90f505f-379e-4e7f-b7d4-a756d8b4a115",
                                                "sense_id": "01d46e3d-5fe6-3e39-9b5b-db905d625580",
                                                "text": "After any dead ball, play shall be resumed by a jump ball, a throw-in or by placing the ball at the disposal of a free-thrower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "721dba0c-0dd5-35f3-ac9f-d65d6b6bbe5f",
                                        "entry_id": "1b2c999d-2373-3fdf-891c-ee104076efca",
                                        "glosses": [
                                            "Metaphor for a contest too close to call."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cda8ee27-365e-49a2-b8f5-5f7dcd42a52c",
                                                "sense_id": "721dba0c-0dd5-35f3-ac9f-d65d6b6bbe5f",
                                                "text": "The morning after Election Day, the Oregon governor's race is still a jump ball, but ex-NBA player Chris Dudley is clinging to a slim lead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6bb196a-b886-3921-ae71-84b4db5da4ef",
