                    "frequency": "High",
                    "semantic_group_id": "gezelligheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is hier erg <w>knus</w> met al die kaarsjes aan. ",
                            "target_lang_translations": {
