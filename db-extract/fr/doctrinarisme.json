                        "sense_id": "2f404336-1fb0-3dd1-89d6-60bbc8f30b23",
                        "entry_id": "70aa09f5-5354-330d-809e-585594cadb89",
                        "glosses": [
                            "Système politique des doctrinaires, adeptes dʼune monarchie constitutionnelle durant la Restauration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b00e55-1d98-47bf-a369-8cc0fca0f615",
                                "sense_id": "2f404336-1fb0-3dd1-89d6-60bbc8f30b23",
                                "text": "Le doctrinarisme, en revanche, tenait lieu de doctrine de gouvernement et semblait traduire à merveille les aspirations les plus secrètes de la bourgeoisie montante du règne de Louis-Philippe."
                            }
                        ]
                    },
                    {
                        "sense_id": "003a8f63-a7c1-3304-a3e5-626f122afae9",
                        "entry_id": "70aa09f5-5354-330d-809e-585594cadb89",
                        "glosses": [
                            "Attitude conciliatrice et modérée comparable à celle des doctrinaires de la Restauration."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5d20f114-8f86-3734-84d7-e0ddd76a64d9",
                        "entry_id": "70aa09f5-5354-330d-809e-585594cadb89",
                        "glosses": [
                            "Volonté de diffuser une doctrine particulière et efforts pour l’imposer à autrui, en politique, religion, économie, ou autres domaines intellectuels ou spirituels."
                        ],
                        "tags": [],
                        "examples": []
                    }
