                        "sense_id": "f94ae1b2-4fb9-3ffe-816a-0f5d043a37d6",
                        "entry_id": "89d55bd6-e4d1-35f1-9d4c-306ec1e70157",
                        "glosses": [
                            "Petite ferme, maison de campagne."
