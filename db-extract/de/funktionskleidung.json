                "senses": [
                    {
                        "sense_id": "c3cb2aab-ecd0-359a-976a-ecb61056b367",
                        "entry_id": "6dbb1d18-5cf6-3eff-8471-7652f4ccbb6c",
                        "glosses": [
                            "spezielle Outdoorkleidung aus modernen (atmungsaktiven) Materialien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "083c90c7-0c66-4245-b0bc-5969ad5db561",
                                "sense_id": "c3cb2aab-ecd0-359a-976a-ecb61056b367",
                                "text": "„Bei Funktionskleidung aus synthetischen Fasern, wie sie besonders im Sport häufig eingesetzt werden, können Weichspüler die Oberfläche der Kleidung verschließen. Der Abtransport des Schweißes vom Körper nach außen ist dadurch nicht mehr gewährleistet.“"
                            },
                            {
                                "example_id": "fbcbf1d8-f1b1-4406-88df-671b9468a323",
                                "sense_id": "c3cb2aab-ecd0-359a-976a-ecb61056b367",
                                "text": "„Als Einzige trägt sie keine Funktionskleidung, sondern Mode, die Münchner anziehen, wenn sie im Winter auf Terrassen vor Restaurants sitzen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
