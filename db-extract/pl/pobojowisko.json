                    }
                ],
                "senses": [
                    {
                        "sense_id": "56c67f9e-f4af-39e0-854e-af278295a4a7",
                        "entry_id": "28181f1e-e47a-3be9-bd8d-eefc1d1220f7",
                        "glosses": [
                            "Feld, auf dem ein oder mehrere Kämpfe stattgefunden haben; Schlachtfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66367cb5-6f54-4959-bd7b-5e900854db13",
                                "sense_id": "56c67f9e-f4af-39e0-854e-af278295a4a7",
                                "text": "„Ziemia była de nomine Rzeczypospolitej, ale pustynna, na której pastwisk Rzeczpospolita Tatarom pozwalała, wszakże, gdy kozacy często bronili, więc to pastwisko było i pobojowiskiem zarazem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d6cb4428-343b-342d-9550-7721168cc36b",
                        "entry_id": "28181f1e-e47a-3be9-bd8d-eefc1d1220f7",
                        "glosses": [
                            "Ort, an dem große Unordnung oder Zerstörung herrscht; Schlachtfeld"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a4d735-7e78-41ae-9dc7-cb1b7f335778",
                        "source_entry_id": "28181f1e-e47a-3be9-bd8d-eefc1d1220f7",
                        "source_sense_id": "56c67f9e-f4af-39e0-854e-af278295a4a7",
                        "source_sense_description": "Militär: Feld, auf dem ein oder mehrere Kämpfe stattgefunden haben; Schlachtfeld",
                        "target_lang_word": "Schlachtfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachtfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                        "entry_id": "b9baa161-9233-36d1-a645-8a22540ae8f8",
                                        "glosses": [
                                            "Gebiet, in dem ein Kampf beziehungsweise eine Schlacht stattgefunden hat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564930f4-49c3-44e2-a33f-83d46f26016b",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "Das Schlachtfeld ist mit Blut getränkt."
                                            },
                                            {
                                                "example_id": "7a95df55-a3e8-4130-8726-fa28de313dc3",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Schon Napoleon umging die Festungen und suchte den Kampf auf dem Schlachtfeld mit dem gegnerischen Führer.“"
                                            },
                                            {
                                                "example_id": "b43a5199-65f3-4e84-8ef9-72de64131a6f",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "Dort erzählten sie sich ihre Erinnerungen an die Schlachtfelder, von denen ihre Familien nichts hören wollten.“"
                                            },
                                            {
                                                "example_id": "9bcaa8af-85d8-497e-af5c-9806bc6cb4ad",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Er erinnerte sich daran, daß der Brief vom Herbst 1938, in dem er seinem Vater einen Besuch der flandrischen Schlachtfelder geschildert hatte, sein letzter Brief nach Frankfurt gewesen war.“"
                                            },
                                            {
                                                "example_id": "2cd50de0-aa6d-45b5-bf52-ffb11ab9a340",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Wir sehen die Abbildungen der Schlachtfelder hinter dem Heer.“"
                                            },
                                            {
                                                "example_id": "8719cb85-a687-45e0-b9c4-e5f26588d3af",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Die Initiative auf dem Schlachtfeld ist vollständig auf die russische Armee übergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66056d9d-d574-4d0f-99b4-d6bf1c6bab7a",
                        "source_entry_id": "28181f1e-e47a-3be9-bd8d-eefc1d1220f7",
                        "source_sense_id": "d6cb4428-343b-342d-9550-7721168cc36b",
                        "source_sense_description": "übertragen: Ort, an dem große Unordnung oder Zerstörung herrscht; Schlachtfeld",
                        "target_lang_word": "Schlachtfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachtfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                        "entry_id": "b9baa161-9233-36d1-a645-8a22540ae8f8",
                                        "glosses": [
                                            "Gebiet, in dem ein Kampf beziehungsweise eine Schlacht stattgefunden hat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564930f4-49c3-44e2-a33f-83d46f26016b",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "Das Schlachtfeld ist mit Blut getränkt."
                                            },
                                            {
                                                "example_id": "7a95df55-a3e8-4130-8726-fa28de313dc3",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Schon Napoleon umging die Festungen und suchte den Kampf auf dem Schlachtfeld mit dem gegnerischen Führer.“"
                                            },
                                            {
                                                "example_id": "b43a5199-65f3-4e84-8ef9-72de64131a6f",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "Dort erzählten sie sich ihre Erinnerungen an die Schlachtfelder, von denen ihre Familien nichts hören wollten.“"
                                            },
                                            {
                                                "example_id": "9bcaa8af-85d8-497e-af5c-9806bc6cb4ad",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Er erinnerte sich daran, daß der Brief vom Herbst 1938, in dem er seinem Vater einen Besuch der flandrischen Schlachtfelder geschildert hatte, sein letzter Brief nach Frankfurt gewesen war.“"
                                            },
                                            {
                                                "example_id": "2cd50de0-aa6d-45b5-bf52-ffb11ab9a340",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Wir sehen die Abbildungen der Schlachtfelder hinter dem Heer.“"
                                            },
                                            {
                                                "example_id": "8719cb85-a687-45e0-b9c4-e5f26588d3af",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Die Initiative auf dem Schlachtfeld ist vollständig auf die russische Armee übergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
