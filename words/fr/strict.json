                {
                    "sense_id": "9cfeb312-36b6-34a0-ba0a-3aa8a8bf98a1",
                    "sense_definition": "En mathématiques, qui exclut formellement le cas d'égalité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a rappelé la définition d'une inégalité <w>stricte</w> en cours d'algèbre.",
                            "target_lang_translations": {
                                "en": "The teacher recalled the definition of a <w>strict</w> inequality in the algebra lesson.",
                                "ru": "Учитель напомнил определение <w>строгого</w> неравенства на уроке алгебры.",
                                "de": "Der Lehrer rief im Algebraunterricht die Definition einer <w>strikten</w> Ungleichung in Erinnerung.",
                                "es": "El profesor recordó la definición de una desigualdad <w>estricta</w> en la clase de álgebra.",
                                "zh": "老师在代数课上回顾了<w>严格</w>不等式的定义。"
                            }
                        },
                        {
                            "text": "Cette fonction vérifie une croissance <w>stricte</w> sur tout son ensemble de définition.",
                            "target_lang_translations": {
                                "en": "This function is <w>strictly</w> increasing over its entire domain.",
                                "ru": "Эта функция <w>строго</w> возрастает на всей области определения.",
                                "de": "Diese Funktion ist auf ihrem gesamten Definitionsbereich <w>streng</w> monoton wachsend.",
                                "es": "Esta función cumple un crecimiento <w>estricto</w> en todo su dominio de definición.",
                                "zh": "该函数在其整个定义域内<w>严格</w>递增。"
                            }
                        }
                    ],
                    "antonyms": [
                        "large"
                    ],
                    "common_phrases": [
                        "inégalité stricte",
                        "croissance stricte"
                    ],
                    "target_lang_definitions": {
                        "en": "In mathematics, formally excluding the case of equality.",
                        "ru": "В математике: формально исключающий случай равенства.",
                        "de": "In der Mathematik: schließt den Fall der Gleichheit ausdrücklich aus.",
                        "es": "En matemáticas, que excluye expresamente el caso de igualdad.",
                        "zh": "数学中，明确排除相等情况的。"
                    },
