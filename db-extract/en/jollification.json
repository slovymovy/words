                        "sense_id": "084cde2a-f324-3df7-b496-95e2f2bb8c34",
                        "entry_id": "17fac06e-3a32-383e-a704-35b6ee1d9f1c",
                        "glosses": [
                            "A merrymaking; noisy festivity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "60683722-6bda-4bcf-b954-5f8950e96f0e",
                                "sense_id": "084cde2a-f324-3df7-b496-95e2f2bb8c34",
                                "text": "I shall go down with you on Wednesday in time for the jollification on Thursday. I always enjoy that day; they are such nice, friendly people, those good Hollingford ladies."
                            },
                            {
                                "example_id": "cd7ce05d-9ea0-42ce-aa21-db2edcf4b635",
                                "sense_id": "084cde2a-f324-3df7-b496-95e2f2bb8c34",
                                "text": "1872, Sheridan Le Fanu, “Mr. Justice Harbottle,” Chapter 2, in In a Glass Darkly,\n[…] old Judge Harbottle had arranged one of his dubious jollifications, such as might well make the hair of godly men's heads stand upright for that night."
                            },
                            {
                                "example_id": "282e3fe8-e084-4224-8fec-c5d2db715c82",
                                "sense_id": "084cde2a-f324-3df7-b496-95e2f2bb8c34",
                                "text": "[…] the streams would run with wine instead of water and the whole forest would give itself up to jollification for weeks on end."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
