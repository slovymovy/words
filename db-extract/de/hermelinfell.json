                "senses": [
                    {
                        "sense_id": "812cbf9c-08a5-331f-80bf-784fc1b1367f",
                        "entry_id": "f076366f-e211-3d61-bdaa-6d4a228ac14b",
                        "glosses": [
                            "(abgezogenes) Fell eines Hermelins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75e3b61-f694-4433-8d04-8949156d9b30",
                                "sense_id": "812cbf9c-08a5-331f-80bf-784fc1b1367f",
                                "text": "„Vermeer zeigt uns eine kostbar gekleidete junge Dame, sie trägt eine Atlasjacke aus gelber Seide, die mit Kragen und Bordüre aus Hermelinfell verziert ist.“"
                            },
                            {
                                "example_id": "fdd2b331-4328-444a-820a-265096ada197",
                                "sense_id": "812cbf9c-08a5-331f-80bf-784fc1b1367f",
                                "text": "„Jacopo Sannazaro spielt dagegen in seinem Sonett La veste, signor mio, che in foco accesa das Hermelin (›quel leggiadro e candido armellino‹) losgelöst von der Frage weiblicher Keuschheit auf seine Funktion als Wappentier (›l'alta impresa‹) auf dem Gewand des Widmungsträgers an und erinnert damit zugleich daran, daß jahrhundertelang das Tragen des Hermelinfells nur höchsten Würdenträgern vorbehalten blieb.“"
                            },
                            {
                                "example_id": "6d0ee8a4-0319-4095-a89d-b4a32b497d1f",
                                "sense_id": "812cbf9c-08a5-331f-80bf-784fc1b1367f",
                                "text": "„Der Handel mit Gebrauchs- und Luxusgütern läßt sich nur schlaglichtartig erhellen. Daß im 6. Jahrhundert die Onoguren am Schwarzen Meer Hermelinfelle lieferten, berichtet Jordanes.“"
                            },
                            {
                                "example_id": "e5011230-4938-415f-b291-7f7b836f1618",
                                "sense_id": "812cbf9c-08a5-331f-80bf-784fc1b1367f",
                                "text": "„Als Anfang des 19. Jahrhunderts die Verarbeitung von Hermelinfellen verboten wurde, brauchte man Ersatz. Man fand ihn im ›Polnischen Kaninchen‹, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
