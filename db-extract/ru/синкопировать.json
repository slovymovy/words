                                    {
                                        "sense_id": "868b99d0-156b-31f1-8774-2668155d35db",
                                        "entry_id": "e73ef87d-0ce0-3f24-abe0-0b5db3335a1d",
                                        "glosses": [
                                            "Faire une syncope, s’évanouir, produire un son proche de la syncope témoignant la surprise."
                                        ],
                                        "tags": [],
