    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a51348d-5aea-3c21-bc05-c81bc0f1191b",
                    "sense_definition": "Image, dessin, gravure ou photographie qui accompagne et éclaire le texte d'un livre, d'un article ou d'un document.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce livre pour enfants contient une très belle <w>illustration</w> en couleur à chaque page."
                        },
                        {
                            "text": "L'artiste a réalisé une <w>illustration</w> originale pour la couverture du nouveau roman."
                        }
                    ],
                    "synonyms": [
                        "enluminure",
                        "vignette"
                    ],
                    "common_phrases": [
                        "illustrations en couleur",
                        "illustrations en noir et blanc",
                        "livre avec illustrations"
                    ]
                },
                {
                    "sense_id": "996e0298-06ad-3b18-b9ef-b18af64bf324",
                    "sense_definition": "Exemple concret, fait ou cas particulier qui sert à expliquer, rendre plus clair ou prouver une idée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exemple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette réussite économique est une parfaite <w>illustration</w> de l'efficacité de la nouvelle stratégie."
                        },
                        {
                            "text": "Le professeur a choisi cette anecdote comme <w>illustration</w> pour appuyer son raisonnement."
                        }
                    ],
                    "common_phrases": [
                        "bonne illustration",
                        "parfaite illustration",
                        "à titre d'illustration"
                    ]
                },
                {
                    "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                    "sense_definition": "Fait d'acquérir de la renommée, éclat apporté à un nom, à une famille ou à une époque.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gloire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses nombreuses découvertes scientifiques contribuèrent à l'<w>illustration</w> de son pays dans le monde entier."
                        },
                        {
                            "text": "Cette ancienne lignée aristocratique a perdu de son <w>illustration</w> au fil des siècles."
                        }
                    ],
                    "common_phrases": [
                        "acquérir de l'illustration"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens de gloire ou renommée"
                        }
                    ]
                },
                {
                    "sense_id": "474edd31-c15c-356e-a896-aaa8c93935b7",
                    "sense_definition": "Personne remarquable, célèbre ou hautement estimée dans un domaine particulier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gloire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La réception officielle réunissait toutes les grandes <w>illustrations</w> de la littérature contemporaine."
                        },
                        {
                            "text": "Ce scientifique modeste refusait d'être traité comme l'une des <w>illustrations</w> de son siècle."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "pour désigner une personne célèbre"
                        }
                    ]
                }
            ]
        }
