                ],
                "senses": [
                    {
                        "sense_id": "fbc5cc91-bff9-3421-b144-19b54987e13a",
                        "entry_id": "6acfeb61-6f2a-3aa4-a326-44980562459e",
                        "glosses": [
                            "preiswertes Angebot; Kauf, der aufgrund einer günstigen Gelegenheit beziehungsweise eines günstigen Angebots oder dergleichen abgeschlossen wurde"
                        ],
                        "tags": [
                            "ostösterreichisch"
                        ],
                        "examples": [
                            {
                                "example_id": "22ad2586-91a3-43d6-ac92-03af79b37c27",
                                "sense_id": "fbc5cc91-bff9-3421-b144-19b54987e13a",
                                "text": "„Der deutsche Händler Mühlbauer bekam Wind von der heißen Ware und schlug zu: 48.000Euro, eine Mezzie.“"
                            },
                            {
                                "example_id": "5f7fff3b-446d-4965-b142-9c4af6b8abd3",
                                "sense_id": "fbc5cc91-bff9-3421-b144-19b54987e13a",
                                "text": "„Sie begrüßen den „fairen Preis“, Immofinanz-Aktionär Fries spricht gar von einer „Mezzie“.[…]Der Deal selbst sei „eine Mezzie“, sagt Fries.“"
                            },
                            {
                                "example_id": "aa6c30c4-953d-40fc-b764-fb8994eb671a",
                                "sense_id": "fbc5cc91-bff9-3421-b144-19b54987e13a",
                                "text": "„Wenn rund fünf Millionen Euro in der Formel 1 so etwas wie eine Mezzie darstellen, dann hat sie jeden Bezug zur Realität verloren .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed69e52d-755d-4931-b276-e98293e22175",
                        "source_entry_id": "6acfeb61-6f2a-3aa4-a326-44980562459e",
                        "source_sense_id": "fbc5cc91-bff9-3421-b144-19b54987e13a",
                        "target_lang_word": "bargain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bargain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5159916-06ee-3916-9a58-42545abeb68a",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "An agreement between parties concerning the sale of property; or a contract by which one party binds themself to transfer the right to some property for a consideration, and the other party binds themself to receive the property and pay the consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3824b91a-93fb-47f8-9310-aaad9549c37e",
                                                "sense_id": "e5159916-06ee-3916-9a58-42545abeb68a",
                                                "text": "A contract is a bargain that is legally binding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ee9a47-2447-322e-b4a4-3abfe68c4149",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "An agreement or stipulation; mutual pledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f727c8d8-b18a-422f-b5d2-b1df12f3f962",
                                                "sense_id": "d4ee9a47-2447-322e-b4a4-3abfe68c4149",
                                                "text": "[…]And when your honors mean to solemnize\n The bargain of your faith, I do beseech you,\n Even at that time I may be married too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef394636-2cd8-3c49-b025-a5a47b403185",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "An item purchased for significantly less than the usual, or recommended, price"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "A gainful transaction; an advantageous purchase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19137c3d-b6d5-4510-8ec5-2f68c85c351b",
                                                "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                                "text": "to buy (something) at a bargain"
                                            },
                                            {
                                                "example_id": "7a5e8175-17fc-405d-aaf2-b35efbfb4a23",
                                                "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                                "text": "At that price, it’s not just a bargain, it’s a steal."
                                            },
                                            {
                                                "example_id": "238c43cc-3775-445a-8214-a9cdc909b98c",
                                                "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                                "text": "Thus the red damask curtains which now shut out the fog-laden, drizzling atmosphere of the Marylebone Road, had cost a mere song, and yet they might have been warranted to last another thirty years. A great bargain also had been the excellent Axminster carpet which covered the floor;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b6a9cd-30fa-3370-945b-2cd095577492",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "The thing stipulated or purchased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e6e0e1-85ae-4ac2-8765-5660748dea75",
                                                "sense_id": "58b6a9cd-30fa-3370-945b-2cd095577492",
                                                "text": "If he say so, may his pernicious soul Rot half a grain a day! He lies to th' heart. She was too fond of her most filthy bargain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bargain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d377837-3e88-39aa-97fb-58d1f5e1dfd6",
                                        "entry_id": "14aca7b0-63e4-33db-b94a-b5354c834d89",
                                        "glosses": [
                                            "To make a bargain; to make a deal or contract for the exchange of property or services; to negotiate; to haggle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da597b22-5a04-4483-9b22-2a4c7bf1900a",
                                                "sense_id": "2d377837-3e88-39aa-97fb-58d1f5e1dfd6",
                                                "text": "They had to bargain for a few minutes to get a decent price for the rug."
                                            },
                                            {
                                                "example_id": "70729c0b-a679-4af9-8f62-f53fd8e2f2d2",
                                                "sense_id": "2d377837-3e88-39aa-97fb-58d1f5e1dfd6",
                                                "text": "So worthless peasants bargain for their wives.\nUnited we bargain, divided we beg"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d2bc31e-7e07-3508-abc3-461133b079d3",
                                        "entry_id": "14aca7b0-63e4-33db-b94a-b5354c834d89",
                                        "glosses": [
                                            "To transfer for a consideration; to barter; to trade"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1225c9de-a89f-4016-9358-a60e1c1fb01a",
                        "source_entry_id": "6acfeb61-6f2a-3aa4-a326-44980562459e",
                        "source_sense_id": "fbc5cc91-bff9-3421-b144-19b54987e13a",
                        "target_lang_word": "bon marché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bon marché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9bef6ba-827f-39c9-ade6-ae5f2fa43089",
                                        "entry_id": "a6ca024c-1e2c-35a3-a7cc-f0fd5a8f79b8",
                                        "glosses": [
                                            "Dont le prix, à l’instar de la valeur, est faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47de7044-d995-4502-9f7d-de29569df728",
                                                "sense_id": "d9bef6ba-827f-39c9-ade6-ae5f2fa43089",
                                                "text": "La vie est si bon marché ! Le litre de vin, très pur et très capiteux, coûte à présent deux sous ; il ne coûtera qu’un sou dans un mois !"
                                            },
                                            {
                                                "example_id": "b08115fd-bb32-4ec6-bc4c-7f3c93b89304",
                                                "sense_id": "d9bef6ba-827f-39c9-ade6-ae5f2fa43089",
                                                "text": "Nous devons attirer ici l’attention sur l’essence de mirbane ou nitrobenzine qui a la même odeur que l’essence d’amandes amères et qui pour cette raison s’est trouvée employée pour parfumer des savons bon marché."
                                            },
                                            {
                                                "example_id": "ea30050a-14c5-4a14-933a-2b20b065737d",
                                                "sense_id": "d9bef6ba-827f-39c9-ade6-ae5f2fa43089",
                                                "text": "La margarine est initialement un dérivé animal, développé en France sous le Second Empire pour fournir aux pauvres une graisse bon marché."
                                            },
                                            {
                                                "example_id": "986b845f-00b9-4d60-8a43-74369a068181",
                                                "sense_id": "d9bef6ba-827f-39c9-ade6-ae5f2fa43089",
                                                "text": "On passe chez le Pakos pour acheter de la bière et du vin bon marché. Personne n'a l’âge légal pour ça, mais Terry et Gent ont l'air d'avoir vingt-cinq ans, alors aucun problème pour se faire servir."
                                            },
                                            {
                                                "example_id": "8f2db3aa-796d-47f5-b582-9371ae8dc195",
                                                "sense_id": "d9bef6ba-827f-39c9-ade6-ae5f2fa43089",
                                                "text": "Manu a pris le train jusque chez sa mère, partie en vacances avec son nouvel amant. Encore un représentant lamentable et grande gueule. Beau gosse qui pue l'après-rasage bon marché, sûrement violent quand il a bu. Avec la vie qu'il a et la connasse qu'il tire, il ne doit pas avoir l'alcool très gai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d828af4-1c61-379b-a395-f3252554397a",
                                        "entry_id": "a6ca024c-1e2c-35a3-a7cc-f0fd5a8f79b8",
                                        "glosses": [
                                            "Dont le prix n’est pas élevé par rapport à sa valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b184ad-a71f-478e-89b2-2903b7153305",
                                                "sense_id": "5d828af4-1c61-379b-a395-f3252554397a",
                                                "text": "Ces lampes sont vraiment bon marché."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bon marché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f05130c-4fdb-3194-9c63-0359e8c45a01",
                                        "entry_id": "7487d034-4212-3db0-be70-9aa902c5a489",
                                        "glosses": [
                                            "Qualité de ce qui est peu coûteux ou d’un bon rapport qualité-prix."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b261d9f-b9fd-4a1a-8194-e2ab3021e056",
                                                "sense_id": "1f05130c-4fdb-3194-9c63-0359e8c45a01",
                                                "text": "Aussi, elle acheta pour sa chambre une paire de rideaux jaunes à larges raies, dont M. Lheureux lui avait vanté le bon marché."
                                            },
                                            {
                                                "example_id": "e0729f27-b593-4151-ab9d-b206ae83f4c2",
                                                "sense_id": "1f05130c-4fdb-3194-9c63-0359e8c45a01",
                                                "text": "Ce dernier conservera toujours sa valeur pour la culture intensive ; les scories Thomas, grâce au bon marché de leur acide phosphorique, doivent servir seulement à l'amélioration des grandes étendues des sols de minime valeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b07903b6-cb48-4609-91ed-28a42c18edf0",
                        "source_entry_id": "6acfeb61-6f2a-3aa4-a326-44980562459e",
                        "source_sense_id": "fbc5cc91-bff9-3421-b144-19b54987e13a",
                        "target_lang_word": "occasion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occasion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0cd7f64-23fd-3e1e-9ea1-11b2b0094548",
                                        "entry_id": "3daee5ea-ea70-366c-ab55-6b59e84b1dc5",
                                        "glosses": [
                                            "Rencontre, conjoncture ou concours fortuit et éphémère de circonstances qui favorise temporairement une entreprise, un dessein, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff70891b-0551-48d8-92dd-9cefca9e901e",
                                                "sense_id": "c0cd7f64-23fd-3e1e-9ea1-11b2b0094548",
                                                "text": "Il régnait, en fait, depuis la maladie de son père (1179) et n’avait négligé aucune occasion d’affirmer son autorité, en prenant le contrepied des décisions paternelles."
                                            },
                                            {
                                                "example_id": "023dd5aa-f63e-473a-a7db-5c9828ac2acb",
                                                "sense_id": "c0cd7f64-23fd-3e1e-9ea1-11b2b0094548",
                                                "text": "Quelques hommes seulement prirent part aux obsèques et peu de femmes même, de celles qui profitent de toutes les occasions pour sortir leurs vêtements noirs, leurs toquets de crêpe et qui aiment renifler l’odeur de l’encens."
                                            },
                                            {
                                                "example_id": "0f6986da-92b0-4cf9-8d19-2c78f83ee196",
                                                "sense_id": "c0cd7f64-23fd-3e1e-9ea1-11b2b0094548",
                                                "text": "Il lui représenta donc charitablement qu’il aurait grand tort de ne pas profiter de l’occasion qui lui était offerte pour faire marcher un salaud de richard qui jetait sans scrupules le déshonneur et la misère dans les familles pauvres, mais honorables."
                                            },
                                            {
                                                "example_id": "0b8c9f0f-b81d-403b-ba1c-ff09acd428df",
                                                "sense_id": "c0cd7f64-23fd-3e1e-9ea1-11b2b0094548",
                                                "text": "[…] dans le cas où une circulaire modifie le contenu de circulaires applicables, il y a lieu de privilégier la solution consistant à abroger ces dernières et réécrire l’ensemble du dispositif plutôt que de laisser au lecteur la charge d’en assurer la combinaison. Cette méthode est l’occasion de vérifier l’actualité du contenu des circulaires applicables dans le domaine considéré."
                                            },
                                            {
                                                "example_id": "ade27430-bde4-46c4-b27d-bbc94854bdf8",
                                                "sense_id": "c0cd7f64-23fd-3e1e-9ea1-11b2b0094548",
                                                "text": "À la première occasion, j'aurais été chercher des armes, prêt à bondir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef505b5-9da9-308c-a7c0-cc798411d9cb",
                                        "entry_id": "3daee5ea-ea70-366c-ab55-6b59e84b1dc5",
                                        "glosses": [
                                            "Ce qui donne lieu à une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5cba7e8-b528-4dc5-a710-41a0e9668299",
                                                "sense_id": "6ef505b5-9da9-308c-a7c0-cc798411d9cb",
                                                "text": "Et pourquoi cela, Madame ? demanda Charles IX en fixant sur sa mère son œil vitreux qui, dans certaines occasions, devenait si pénétrant."
                                            },
                                            {
                                                "example_id": "58d6c84f-1530-4cae-b91f-a7b763518c3f",
                                                "sense_id": "6ef505b5-9da9-308c-a7c0-cc798411d9cb",
                                                "text": "A la bride et au mors arabe on ajoute, aux grandes occasions, une large bande frontale ornée de franges et un gros gland pendant au cou du cheval."
                                            },
                                            {
                                                "example_id": "83e47c80-e213-480d-bf26-d9eb2bd884d7",
                                                "sense_id": "6ef505b5-9da9-308c-a7c0-cc798411d9cb",
                                                "text": "Le cadeau ou objet publicitaire de faible valeur est largement utilisé en de nombreuses occasions.[…]. Les classiques sont les stylos à bille, les briquets, les calendriers, les porte-clefs, les sacs, les pochettes d’allumettes, les cartes à jouer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1db37f1-4863-35c1-8722-9b437e034058",
                                        "entry_id": "3daee5ea-ea70-366c-ab55-6b59e84b1dc5",
                                        "glosses": [
                                            "Objet d’un prix moins élevé que celui des objets de même espèce, soit parce qu’il a déjà servi, soit pour toute autre raison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14223496-5bee-49aa-9c6b-4ec5d9a6dd34",
                                                "sense_id": "c1db37f1-4863-35c1-8722-9b437e034058",
                                                "text": "Suzanne, en minaudant, me parle d’un manteau de fourrure, véritable occasion pour cet hiver et qu’il ne faudrait pas laisser passer !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
