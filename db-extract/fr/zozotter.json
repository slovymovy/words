                        "glosses": [
                            "Orthographe ancienne, parfois encore rencontrée, de zozoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "074550cf-389f-4567-a711-79c68a703af2",
                                "sense_id": "5ff6a0f3-03e2-3d96-92d6-03f7b90274fc",
                                "text": "Il zozotte, dit Popaul, propre à croquer le ridicule de tout un chacun."
                            },
                            {
                                "example_id": "dbe504c1-1a54-4f65-9e3a-123ebe14c18a",
                                "sense_id": "5ff6a0f3-03e2-3d96-92d6-03f7b90274fc",
                                "text": "Il avait comme signe particulier de se mettre à zozotter quand il était énervé ou quand on le fixait dans les yeux."
                            }
