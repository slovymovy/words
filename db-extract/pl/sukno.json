                    },
                    {
                        "translation_id": "6de88b79-da09-4486-b453-992d28e6d92f",
                        "source_entry_id": "33dcb7a4-7c6f-31e4-80d3-e9eb077a2c75",
                        "source_sense_id": "0006ecd8-249e-3dbf-9458-ccfd493de472",
                        "target_lang_word": "Tuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f85269a-744c-3d7e-8968-7bed6ed51453",
                                        "entry_id": "24c1fc54-37af-375d-9ab5-f35f72e8248d",
                                        "glosses": [
                                            "Textilie aus diversen Materialien (Wort wird oft ohne bestimmten Artikel benutzt)"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd92c59e-43cf-4bd9-b1df-1792d0646f39",
                                                "sense_id": "1f85269a-744c-3d7e-8968-7bed6ed51453",
                                                "text": "Für einen Anzug ist eine ganze Menge Tuch nötig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0d35b6b-1ef9-34e7-85d9-2fef495acbb6",
                                        "entry_id": "24c1fc54-37af-375d-9ab5-f35f72e8248d",
                                        "glosses": [
                                            "einzelnes, oft viereckiges Stück Gewebe, das für unterschiedliche Zwecke gedacht ist"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3daf69-5448-466c-9b14-d2e95e7e3b08",
                                                "sense_id": "c0d35b6b-1ef9-34e7-85d9-2fef495acbb6",
                                                "text": "„Sie konzentriert sich, sie zieht mir das Tuch tiefer ins Gesicht, klemmt eine Haarsträhne hinter mein Ohr, lockert den Knoten am Hals.“"
                                            },
                                            {
                                                "example_id": "ca6e138d-9ad8-4573-a6f8-873a86fe2933",
                                                "sense_id": "c0d35b6b-1ef9-34e7-85d9-2fef495acbb6",
                                                "text": "Am besten wischt man die Fenster mit einem trockenen Tuch nach."
                                            },
                                            {
                                                "example_id": "164de509-22cf-4a13-a348-ed2e93d52086",
                                                "sense_id": "c0d35b6b-1ef9-34e7-85d9-2fef495acbb6",
                                                "text": "„Zehn Nächte lang hatte Kuschalka mit heiligem Eifer an dem Tuch gewebt.“"
                                            },
                                            {
                                                "example_id": "89b50651-1ada-4da9-a720-c3d1347c729a",
                                                "sense_id": "c0d35b6b-1ef9-34e7-85d9-2fef495acbb6",
                                                "text": "„Er nahm das Tuch ab, mit dem sie zugedeckt war, und dabei gab die Harfe einen misstönenden Klang von sich.“"
                                            },
                                            {
                                                "example_id": "aec089f6-3318-48c3-be4f-78de39bc6d43",
                                                "sense_id": "c0d35b6b-1ef9-34e7-85d9-2fef495acbb6",
                                                "text": "„Sie steckte die Hand unter ihr Brustmieder und zog einen Speziestaler herau, der sorgfältig in ein Tuch eingewickelt war, und zeigte ihn der Schaffnerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00bc78eb-25ad-4217-80b4-8674977a5b36",
                        "source_entry_id": "33dcb7a4-7c6f-31e4-80d3-e9eb077a2c75",
                        "source_sense_id": "0006ecd8-249e-3dbf-9458-ccfd493de472",
                        "target_lang_word": "сукно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сукно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4fed0cb4-c67c-3d16-90b9-1d0841d71a67",
                                        "entry_id": "d1003b0b-14ef-3383-95c5-5a7fd37f58e7",
                                        "glosses": [
                                            "плотная шерстяная, полушерстяная или хлопчатобумажная ворсистая ткань, на поверхности которой волокна столь сбиты, что полностью закрывают промежутки между нитями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3923f674-5864-4b10-9e9a-c7c878af525b",
                                                "sense_id": "4fed0cb4-c67c-3d16-90b9-1d0841d71a67",
                                                "text": "На солдате была синеватая, фабричного сукна шинель, ранца и кивера не было, голова была повязана, и через плечо была надета французская зарядная сумка."
                                            },
                                            {
                                                "example_id": "df456238-00d8-4809-a4e4-466c57fb7112",
                                                "sense_id": "4fed0cb4-c67c-3d16-90b9-1d0841d71a67",
                                                "text": "Разумеем два самых основных, массовых вида тканей: из льняной пряжи холст, и из шерстяной пряжи сукно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9740c9c8-3d60-3a0b-a785-f0f42165887c",
                                        "entry_id": "d1003b0b-14ef-3383-95c5-5a7fd37f58e7",
                                        "glosses": [
                                            "о покрытом тканью письменном, карточном или бильярдном столе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca1ce89-1fa7-48ff-bf08-76626e86280a",
                                                "sense_id": "9740c9c8-3d60-3a0b-a785-f0f42165887c",
                                                "text": "Карты быстро и легко перелетали на зелени, ложились на сукно и собирались в хрустящие веера в руках игроков."
                                            },
                                            {
                                                "example_id": "3ce52090-2143-4d52-ac55-108bc842800d",
                                                "sense_id": "9740c9c8-3d60-3a0b-a785-f0f42165887c",
                                                "text": "Но вот положат наш бюллетень на зеленое сукно во Львовской и Ужгородской области, пролистает его начальство, усмехнется."
                                            },
                                            {
                                                "example_id": "8931064c-6b93-4215-82d4-30e573aeeebf",
                                                "sense_id": "9740c9c8-3d60-3a0b-a785-f0f42165887c",
                                                "text": "― Розыгрыш, ― скомандовал деловито, сбивая шары на сукне в треугольник, а по бокам выставляя два битка ― для определения очередности игроков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
