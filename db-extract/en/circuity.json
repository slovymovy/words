                "forms": [
                    {
                        "form_id": "6d6bccc9-63b3-4d8e-a21f-c6adb7bd0386",
                        "entry_id": "9439b05f-dce8-3b54-bed3-773e5c7197c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "circuities"
