                "senses": [
                    {
                        "sense_id": "13b43efb-bdbd-3ded-a0b0-f05807ecfdfd",
                        "entry_id": "447b2d54-932e-3020-9878-397ef69c4193",
                        "glosses": [
                            "De la nature de l’athérome ; relatif à l’athérome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd78f824-753d-4f47-b736-467434126e01",
                                "sense_id": "13b43efb-bdbd-3ded-a0b0-f05807ecfdfd",
                                "text": "Cependant cet effet anti-athéromateux ne serait efficace à moyen ou long terme qu’à condition de ne pas dépasser 1 ou 2 verres de vin ou équivalent par jour."
                            },
                            {
                                "example_id": "756f384f-e656-4175-9737-8524f5306cda",
                                "sense_id": "13b43efb-bdbd-3ded-a0b0-f05807ecfdfd",
                                "text": "Cette dissolution intellectuelle à pour cause une atrophie qui envahit peu à peu l’écorce du cerveau, puis la substance blanche, produisant une dégénérescence graisseuse et athéromateuse des cellules, des tubes et des capillaires de la substance nerveuse."
                            },
                            {
                                "example_id": "970c005b-d7f1-4ece-9c4f-ce56778351a4",
                                "sense_id": "13b43efb-bdbd-3ded-a0b0-f05807ecfdfd",
                                "text": "Une autopsie a permis de révéler que l’instructeur était décédé d’une insuffisance cardiaque aiguë possiblement causée par une maladie athéromateuse diffuse."
                            }
                        ]
                    }
                ],
