{
    "word_family": [
        "ébranlement",
        "inébranlable",
        "inébranlablement",
        "branler",
        "branle",
        "branlement",
        "branlant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bae169a1-08cc-3730-a9c1-d1600e8b1de2",
                    "sense_definition": "Affaiblir la fermeté, les convictions ou la tranquillité d'esprit de quelqu'un, ou déstabiliser une institution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible nouvelle a profondément <w>ébranlé</w> toute la famille pendant plusieurs semaines."
                        },
                        {
                            "text": "Les arguments solides de son adversaire ont fini par <w>ébranler</w> ses convictions politiques."
                        }
                    ],
                    "synonyms": [
                        "déstabiliser",
                        "perturber",
                        "fragiliser",
                        "bouleverser"
                    ],
                    "antonyms": [
                        "renforcer",
                        "rassurer",
                        "consolider"
                    ],
                    "common_phrases": [
                        "ébranler la confiance",
                        "ébranler les certitudes"
                    ]
                },
                {
                    "sense_id": "cc588cb6-51d9-3a26-a301-419ff3034627",
                    "sense_definition": "Secouer avec force un objet ou une structure au point d'en menacer l'équilibre ou la solidité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tremblement de terre a <w>ébranlé</w> les fondations de plusieurs maisons anciennes de la ville."
                        },
                        {
                            "text": "Une violente déflagration a suffi pour <w>ébranler</w> les murs de l'entrepôt voisin."
                        }
                    ],
                    "synonyms": [
                        "secouer",
                        "faire trembler"
                    ],
                    "antonyms": [
                        "stabiliser",
                        "affermir"
                    ],
                    "common_phrases": [
                        "ébranler les fondations",
                        "ébranler les murs"
                    ]
                },
                {
                    "sense_id": "12a9ef3c-01f8-339b-98b0-5b0fd709f070",
                    "sense_definition": "Commencer à se déplacer ou se mettre en mouvement, en parlant d'un véhicule, d'une troupe ou d'un convoi.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train s'<w>ébranle</w> lentement au signal sonore du chef de gare avant de prendre de la vitesse."
                        },
                        {
                            "text": "Après une courte pause au bord du chemin, le cortège s'<w>ébranla</w> de nouveau vers le château."
                        }
                    ],
                    "synonyms": [
                        "démarrer",
                        "partir"
                    ],
                    "antonyms": [
                        "s'arrêter",
                        "s'immobiliser"
                    ],
                    "common_phrases": [
                        "le train s'ébranle",
                        "le cortège s'ébranle"
                    ]
                }
            ]
        }
    ]
}