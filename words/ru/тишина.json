            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7ead663-2531-31b3-ad27-0bf0864dcc89",
                    "sense_definition": "Отсутствие звуков, шума.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В библиотеке всегда должна быть полная <w>тишина</w>.",
                            "target_lang_translations": {
                                "en": "There must always be complete <w>silence</w> in the library.",
                                "de": "In der Bibliothek muss immer absolute <w>Stille</w> herrschen."
                            }
                        },
                        {
                            "text": "Мы сидели в лесу и наслаждались звуками природы, нарушающими <w>тишину</w>.",
                            "target_lang_translations": {
                                "en": "We sat in the forest and enjoyed the sounds of nature breaking the <w>silence</w>.",
                                "de": "Wir saßen im Wald und genossen die Geräusche der Natur, die die <w>Stille</w> unterbrachen."
                            }
                        }
                    ],
                    "synonyms": [
                        "беззвучие",
                        "покой",
                        "безмолвие"
                    ],
                    "antonyms": [
                        "шум"
                    ],
                    "common_phrases": [
                        "полная тишина",
                        "гробовая тишина",
                        "нарушить тишину",
                        "в тишине"
                    ],
                    "target_lang_definitions": {
                        "en": "The complete absence of sound or noise.",
                        "de": "Die vollständige Abwesenheit von Geräuschen oder Lärm."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silence",
                                "target_lang_sense_clarification": "absence of any sound"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "state of little or no sound"
                            },
                            {
                                "target_lang_word": "stillness",
                                "target_lang_sense_clarification": "absence of movement and sound"
                            },
                            {
                                "target_lang_word": "hush",
                                "target_lang_sense_clarification": "a sudden or expectant silence"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stille",
                                "target_lang_sense_clarification": "Abwesenheit von akustischen Signalen"
                            },
                            {
                                "target_lang_word": "Ruhe",
                                "target_lang_sense_clarification": "Zustand ohne störende Geräusche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "229c8411-5f60-32c9-b61e-1cbe47f13428",
                    "sense_definition": "Отсутствие разговоров; молчание.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель попросил класс соблюдать <w>тишину</w> во время контрольной работы.",
                            "target_lang_translations": {
                                "en": "The teacher asked the class to observe <w>silence</w> during the test.",
                                "de": "Der Lehrer bat die Klasse, während der Klassenarbeit <w>Ruhe</w> zu bewahren."
                            }
                        },
                        {
                            "text": "После его неожиданного вопроса в комнате повисла неловкая <w>тишина</w>.",
                            "target_lang_translations": {
                                "en": "After his unexpected question, an awkward <w>silence</w> hung in the room.",
                                "de": "Nach seiner unerwarteten Frage trat im Raum peinliches <w>Schweigen</w> ein."
                            }
                        }
                    ],
                    "synonyms": [
                        "молчание",
                        "безмолвие"
                    ],
                    "common_phrases": [
                        "соблюдать тишину",
                        "минута тишины",
                        "требовать тишины"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of refraining from speaking; an absence of conversation.",
                        "de": "Das Unterlassen von Sprechen; das Fehlen von Unterhaltung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silence",
                                "target_lang_sense_clarification": "refraining from speech"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "absence of talking"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schweigen",
                                "target_lang_sense_clarification": "Nicht-Sprechen"
                            },
                            {
                                "target_lang_word": "Stille",
                                "target_lang_sense_clarification": "Fehlen von Gespräch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9267aadd-6c0f-3b35-8736-4d3ac1c3ab89",
                    "sense_definition": "Душевное спокойствие, умиротворение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Только вдали от городской суеты он наконец обрёл душевную <w>тишину</w>.",
                            "target_lang_translations": {
                                "en": "Only far from the city bustle did he finally find inner <w>peace</w>.",
                                "de": "Nur fernab der städtischen Hektik fand er endlich innere <w>Ruhe</w>."
                            }
                        },
                        {
                            "text": "Ей нравилась эта деревенская <w>тишина</w> и размеренный образ жизни.",
                            "target_lang_translations": {
                                "en": "She liked this rural <w>quiet</w> and the measured lifestyle.",
                                "de": "Sie mochte diese dörfliche <w>Ruhe</w> und den gemächlichen Lebensstil."
                            }
                        }
                    ],
                    "synonyms": [
                        "тишь"
                    ],
                    "common_phrases": [
                        "душевная тишина",
                        "тишина и покой"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of mental calm, tranquility, or peace of mind.",
                        "de": "Ein Zustand geistiger Gelassenheit, innerer Frieden oder Ausgeglichenheit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peace",
                                "target_lang_sense_clarification": "freedom from oppressive thoughts or emotions"
                            },
                            {
                                "target_lang_word": "tranquility",
                                "target_lang_sense_clarification": "state of being calm and peaceful"
                            },
                            {
                                "target_lang_word": "calm",
                                "target_lang_sense_clarification": "peacefulness"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "peaceful environment"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ruhe",
                                "target_lang_sense_clarification": "innerer Frieden und Gelassenheit"
                            },
                            {
                                "target_lang_word": "Frieden",
                                "target_lang_sense_clarification": "Zustand der inneren Einkehr"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35d0a07a-ea00-3df2-8e04-f910c073fa29",
                    "sense_definition": "Отсутствие вражды, ссор, столкновений или боевых действий.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Жители надеются, что мир и <w>тишина</w> вернутся в их дома навсегда.",
                            "target_lang_translations": {
                                "en": "Residents hope that peace and <w>quiet</w> will return to their homes forever.",
                                "de": "Die Bewohner hoffen, dass Frieden und <w>Ruhe</w> für immer in ihre Häuser zurückkehren."
                            }
                        },
                        {
                            "text": "Это было лишь временное затишье, и скоро <w>тишина</w> сменилась новыми спорами.",
                            "target_lang_translations": {
                                "en": "It was only a temporary lull, and soon the <w>calm</w> was replaced by new disputes.",
                                "de": "Es war nur eine vorübergehende Flaute, und bald wurde die <w>Ruhe</w> von neuen Streitigkeiten abgelöst."
                            }
                        }
                    ],
                    "synonyms": [
                        "зати́шье"
                    ],
                    "common_phrases": [
                        "мир и тишина"
                    ],
                    "target_lang_definitions": {
                        "en": "Freedom from war, conflict, or civil disturbance.",
                        "de": "Freiheit von Krieg, Konflikten oder zivilen Unruhen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peace",
                                "target_lang_sense_clarification": "freedom from war or conflict"
                            },
                            {
                                "target_lang_word": "calm",
                                "target_lang_sense_clarification": "absence of disturbance or fighting"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "absence of trouble or turmoil"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Frieden",
                                "target_lang_sense_clarification": "Abwesenheit von Krieg oder Konflikt"
                            },
                            {
                                "target_lang_word": "Ruhe",
                                "target_lang_sense_clarification": "Abwesenheit von Unruhe oder Streit"
                            }
                        ]
                    }
                }
            ]
        },
