                ],
                "senses": [
                    {
                        "sense_id": "26399586-8de3-3c1a-b206-e8ae8a90c7e9",
                        "entry_id": "fc2333f9-fc9b-3e94-83e9-e50418d5a89e",
                        "glosses": [
                            "einem Insekt ähnelnd, wie ein Insekt aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6989bb0-7045-4153-b4c4-c48a1234aeec",
                                "sense_id": "26399586-8de3-3c1a-b206-e8ae8a90c7e9",
                                "text": "„Der insektenartige Helm war vollgepfropft mit Kameras, Scannern und Sensoren.“"
                            },
                            {
                                "example_id": "f34868e3-f17b-414c-b3c8-e90d49be42fb",
                                "sense_id": "26399586-8de3-3c1a-b206-e8ae8a90c7e9",
                                "text": "„Holden und Prescott kümmerten sich um ihre jeweiligen Forschungen, Van Damm und der Professor füllten Notizbücher mit Ziffern und Daten über die insektenartigen Kreaturen.“"
                            },
                            {
                                "example_id": "5958abc7-6bda-4fa2-9cde-a26adca3effc",
                                "sense_id": "26399586-8de3-3c1a-b206-e8ae8a90c7e9",
                                "text": "„Der insektenartige Chor der Drohnen ist nur noch schwach zu hören und dennoch beunruhigend.“"
                            },
                            {
                                "example_id": "1d9bdd34-9192-47fd-8a6a-40613d2ea17e",
                                "sense_id": "26399586-8de3-3c1a-b206-e8ae8a90c7e9",
                                "text": "„Seine großen insektenartigen Augen blinzeln zu Zecke herauf, und es öffnet sein klebriges Mundloch, um zu quieken und zu knurren.“"
                            },
                            {
                                "example_id": "94bda2be-d405-4305-a544-bb4ac9e9ac91",
                                "sense_id": "26399586-8de3-3c1a-b206-e8ae8a90c7e9",
                                "text": "„Mit ihren Fangzähnen durchbissen sie die Kampfrüstungen und injizierten ein Gift, das das Gewebe absterben ließ und in Minuten zum Tod führte. Insektenartige Kreaturen, die die Größe von Kindern hatten und aus Drüsen im Kopf konzentrierte Schwefelsäure verspritzten.“"
                            }
