                ],
                "senses": [
                    {
                        "sense_id": "042d143d-33a3-3775-90cc-2ba1f24a983c",
                        "entry_id": "7f5d8507-c853-39b3-8252-04cd474d4f2e",
                        "glosses": [
                            "gleichmäßige Struktur der Moleküle in einem kristallinen Stoff"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "168c0164-b07b-4dbf-a089-c77ba013af23",
                                "sense_id": "042d143d-33a3-3775-90cc-2ba1f24a983c",
                                "text": "„Das Kristallgitter besteht aus der räumlichen Aneinanderreihung vieler gleicher Gitterzellen (Elementarzellen).“"
                            },
                            {
                                "example_id": "80d0f7b8-bc9c-4212-89ad-db9e86a55d48",
                                "sense_id": "042d143d-33a3-3775-90cc-2ba1f24a983c",
                                "text": "[…] „Beim Lösen eines Salzes muss zunächst die Gitterenergie aufgewendet werden, um die Anziehungskräfte zwischen den Ionen im Kristallgitter zu überwinden und die Ionen voneinander zu trennen.“"
                            },
                            {
                                "example_id": "f0f9004e-7bc8-4681-9927-fbe1f1f3242a",
                                "sense_id": "042d143d-33a3-3775-90cc-2ba1f24a983c",
                                "text": "„Manche Ionen binden ihre Hydrathülle so fest, dass beim Auskristallisieren des Salzes ein Teil der Wasser-Moleküle in das Kristallgitter eingebaut wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
