            "senses": [
                {
                    "sense_id": "f675fc09-cbf8-3593-baa8-065663f5aa91",
                    "sense_definition": "Qui existe en grand nombre ou se présente sous des aspects nombreux et variés.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diversite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a présenté de <w>multiples</w> excuses pour justifier son retard à cette réunion importante."
                        },
                        {
                            "text": "Le professeur a posé une série de questions à choix <w>multiple</w> pour évaluer les élèves."
                        }
                    ],
                    "common_phrases": [
