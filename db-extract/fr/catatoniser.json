                "senses": [
                    {
                        "sense_id": "f794d629-807b-3594-95b2-3b5119698bef",
                        "entry_id": "9fe7a0c4-14c2-33eb-abe3-8538b774ec1a",
                        "glosses": [
                            "Donner un caractère catatonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4607fde-6094-4383-a5a3-7cf2916bb7bd",
                                "sense_id": "f794d629-807b-3594-95b2-3b5119698bef",
                                "text": "Par vos médicaments trépassés. Qui vont me catatoniser."
                            },
                            {
                                "example_id": "c0f55491-3ffc-46c5-85d1-8b22dc3da636",
                                "sense_id": "f794d629-807b-3594-95b2-3b5119698bef",
                                "text": "Et comme il ne peut s’épanouir, il va se recroqueviller, se centrer sur luimême, se catatoniser et mourir."
                            },
                            {
                                "example_id": "70ab1ecc-50d9-45ef-b7d7-bd579ad5f156",
                                "sense_id": "f794d629-807b-3594-95b2-3b5119698bef",
                                "text": "On a vu 499 Libéraux se catatoniser devant une résolution courageuse, ne crachons pas sur des dizaines de milliers d’électeurs qui ont l’intelligence de finalement exprimer leur mécontentement."
                            }
                        ]
                    }
