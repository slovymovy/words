                    {
                        "sense_id": "2830cf69-040c-343c-8f44-d38d55c1368b",
                        "entry_id": "6cbf24ea-f4d6-39da-a52e-db46820c45ce",
                        "glosses": [
                            "Hilfsmittel, um etwas zu entzünden, einen Verbrennungsvorgang in Gang zu setzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480fef53-0b41-4e16-a825-3ea609725f7d",
                                "sense_id": "2830cf69-040c-343c-8f44-d38d55c1368b",
                                "text": "„Aus einem Lager der Nationalen Volksarmee in der Nähe von Jena wurden Spreng- und Zündmittel entwendet, aus der Waffenkammer eines Grenzregiments in Berlin verschwanden 4 Pistolen und 13 Magazine.“"
                            },
                            {
                                "example_id": "f58f6fc5-a1fd-4b23-aad1-c218ebbfe3f9",
                                "sense_id": "2830cf69-040c-343c-8f44-d38d55c1368b",
                                "text": "„Während der Tatortabsuche stellten die Ermittler an zwei in der Nähe abgestellten Fahrzeugen noch nicht angestecktes Zündmittel fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
