    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "962cef64-3e40-3580-8d95-4edcad2766f9",
                    "sense_definition": "Cesser de tenir un objet ou une personne avec les mains ; laisser aller.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a eu très peur et il a immédiatement <w>lâché</w> la poignée de la porte."
                        },
                        {
                            "text": "Fais attention avec cette assiette chaude, ne la <w>lâche</w> surtout pas !"
                        }
                    ],
                    "common_phrases": [
                        "ne rien lâcher",
                        "lâcher prise"
                    ]
                },
                {
                    "sense_id": "aa639c13-c0f9-3a82-b65e-06b433e0936e",
                    "sense_definition": "Cesser de soutenir ou d'épauler quelqu'un dans une épreuve ; abandonner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses collègues l'ont <w>lâché</w> au pire moment du projet important."
                        },
                        {
                            "text": "Je promets de ne jamais te <w>lâcher</w> face à ces difficultés imprévues."
                        }
                    ],
                    "common_phrases": [
                        "lâcher en plein vol"
