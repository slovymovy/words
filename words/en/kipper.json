                },
                {
                    "sense_id": "8b1c88c0-ca4c-3374-9ec8-c2a737d061c1",
                    "sense_definition": "A child or young person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "child",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A lively little <w>kipper</w> came running down the lane chasing a dog.",
                            "target_lang_translations": {
                                "ru": "Бойкий маленький <w>сорванец</w> бежал по переулку, гоняясь за собакой."
