    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ace403e7-be43-3e09-890a-cd4e1b919751",
                    "sense_definition": "Of great size or extent; large.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elephants are <w>big</w> animals and they eat a lot of food every day.",
                            "target_lang_translations": {
                                "ru": "Слоны — <w>большие</w> животные, и они едят много пищи каждый день."
                            }
                        },
                        {
                            "text": "The <w>big</w> house at the end of the street has many rooms.",
                            "target_lang_translations": {
                                "ru": "<w>Большой</w> дом в конце улицы имеет много комнат."
                            }
                        }
                    ],
                    "synonyms": [
                        "large",
                        "great",
                        "huge",
                        "massive",
                        "sizeable"
                    ],
                    "antonyms": [
                        "small",
                        "little",
                        "tiny"
                    ],
                    "common_phrases": [
                        "big house",
                        "big animal",
                        "big city"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большого размера или протяженности; крупный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "большой",
                                "target_lang_sense_clarification": "о размере"
                            },
                            {
                                "target_lang_word": "крупный",
                                "target_lang_sense_clarification": "о величине или масштабе"
                            },
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "очень большой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72b82048-ee18-3b96-ace2-13319aba735a",
                    "sense_definition": "Adult or older; often used by or about children.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kids should get help from <w>big</w> people if they want to use the kitchen.",
                            "target_lang_translations": {
                                "ru": "Детям стоит просить помощи у <w>взрослых</w>, если они хотят воспользоваться кухней."
                            }
                        },
                        {
                            "text": "She did it all on her own like a <w>big</w> girl.",
                            "target_lang_translations": {
                                "ru": "Она сделала всё сама, как <w>большая</w> девочка."
                            }
                        }
                    ],
                    "synonyms": [
                        "adult",
                        "grown-up",
                        "mature"
                    ],
                    "antonyms": [
                        "little",
                        "young"
                    ],
                    "common_phrases": [
                        "big boy",
                        "big girl",
                        "big brother",
                        "big sister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослый или старший; часто используется детьми или по отношению к детям."
                    },
                    "translations": {
