                "forms": [],
                "senses": [
                    {
                        "sense_id": "47b1826e-7502-3276-b535-d1d22b45ac6c",
                        "entry_id": "692ef2b4-c161-3e6f-824e-93335ce66266",
                        "glosses": [
                            "indyjski pszenny placek, rodzaj chleba"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80ebace5-825e-4836-9fe7-ca5c05aea29c",
                                "sense_id": "47b1826e-7502-3276-b535-d1d22b45ac6c",
                                "text": "Następnie dostajemy ryż i gotowane warzywa oraz tradycyjne indyjskie pieczywo – ćapati (…). Te drugie to bardzo smaczne, chrupiące wafle z ostrymi przyprawami"
                            },
                            {
                                "example_id": "122e681d-c80d-49ac-b8cc-a17de44b3a0e",
                                "sense_id": "47b1826e-7502-3276-b535-d1d22b45ac6c",
                                "text": "Samin uczy Maxa ugniatać ćapati i piec je na rozgrzanej płycie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0be1ce44-57d0-48ed-8ced-e6ef6e273e32",
                        "source_entry_id": "692ef2b4-c161-3e6f-824e-93335ce66266",
                        "source_sense_id": "47b1826e-7502-3276-b535-d1d22b45ac6c",
                        "target_lang_word": "chapati",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapati",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa10e29b-4d90-36e0-bff3-018b23543a20",
                                        "entry_id": "fd74e73d-aa6b-3a42-8312-1a7d2fba651b",
                                        "glosses": [
                                            "A flat, unleavened bread from northern India and Pakistan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f6ac83-adb8-48e1-a30a-a528d4a5877b",
                                                "sense_id": "aa10e29b-4d90-36e0-bff3-018b23543a20",
                                                "text": "Princess Jeeta fed me dozens of the hot kebabs I loved, which I coated with mango chutney and wrapped in chapati."
                                            },
                                            {
                                                "example_id": "720c33af-29aa-49c3-8c8d-29524589a6a2",
                                                "sense_id": "aa10e29b-4d90-36e0-bff3-018b23543a20",
                                                "text": "Purvi breaks her chapati into small pieces and scatters them around her plate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddf40cf0-ca01-4f5b-88ff-93f7a5c977f7",
                        "source_entry_id": "692ef2b4-c161-3e6f-824e-93335ce66266",
                        "source_sense_id": "47b1826e-7502-3276-b535-d1d22b45ac6c",
                        "target_lang_word": "chapati",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapati",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb90136-7853-3d16-a031-d40237bf7071",
                                        "entry_id": "859e1393-a84e-3699-9016-345b9e365c65",
                                        "glosses": [
                                            "Sorte de pain traditionnel de l’Inde élaboré sans levain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8fd60e-c2e9-4b5d-a9d3-0579a2129112",
                                                "sense_id": "5fb90136-7853-3d16-a031-d40237bf7071",
                                                "text": "Le chapati roulé en boulettes et frit comme des pommes de terre gonfle beaucoup."
                                            },
                                            {
                                                "example_id": "fd1a6f01-b48d-4724-932b-eacc3af7136c",
                                                "sense_id": "5fb90136-7853-3d16-a031-d40237bf7071",
                                                "text": "Au comptoir, qu’ils soient servis dans une assiette, un sachet, ou vendus à la pièce, les mets coûtent entre quatre et cinq roupies, hormis la chapati à une roupie ou la portion de masale bhat (riz épicé agrémenté de petits pois, de pommes de terre et de cacahuètes), à 10 roupies."
                                            },
                                            {
                                                "example_id": "5e89cba0-c508-45a4-8427-b995c2afc355",
                                                "sense_id": "5fb90136-7853-3d16-a031-d40237bf7071",
                                                "text": "Je me suis offert ses services, une fois n'est pas coutume, pour une heure en apesanteur, pétri ayurvédiquement telle une chapati avant le tandour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e52ea024-6cb0-40a1-a43b-6125863e04a7",
                        "source_entry_id": "692ef2b4-c161-3e6f-824e-93335ce66266",
                        "source_sense_id": "47b1826e-7502-3276-b535-d1d22b45ac6c",
