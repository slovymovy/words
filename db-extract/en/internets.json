                            {
                                "example_id": "067fb4e5-15cf-4af1-8e9c-b9fadb731bcb",
                                "sense_id": "ea0a5768-5905-303c-86ca-3b7a18d3f783",
                                "text": "I can't find this word in my print dictionary; let me go look it up on the internets."
                            },
                            {
                                "example_id": "fff808f0-0dcb-4f73-9b9a-d48fee64966f",
                                "sense_id": "ea0a5768-5905-303c-86ca-3b7a18d3f783",
                                "text": "I hear there's rumors on the internets that we're going to have a draft."
                            },
                            {
                                "example_id": "62a10cf1-f431-4259-a69e-8f16ae11dc92",
                                "sense_id": "ea0a5768-5905-303c-86ca-3b7a18d3f783",
                                "text": "Indeed, coming on the heels of a party leader who speaks of \"the Internets\" and \"the Google,\" it's a disturbing trend that GOP leaders seem so disconnected from the technologies that are changing the way most Americans live]"
                            },
                            {
                                "example_id": "749b3200-6070-4dcc-8efe-05e936dcda42",
                                "sense_id": "ea0a5768-5905-303c-86ca-3b7a18d3f783",
                                "text": "However, the phrasing of the internets meme is now largely outdated."
                            }
                        ]
                    }
