                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Latem często spacerujemy <w>nocą</w> po plaży.",
                            "target_lang_translations": {
                                "ru": "Летом мы часто гуляем <w>ночью</w> по пляжу.",
                                "en": "In the summer we often walk along the beach <w>at night</w>.",
                                "nl": "In de zomer wandelen we vaak <w>'s nachts</w> over het strand.",
                                "de": "Im Sommer spazieren wir oft <w>nachts</w> am Strand entlang.",
                                "fr": "En été, nous nous promenons souvent sur la plage <w>la nuit</w>.",
                                "it": "D'estate passeggiamo spesso sulla spiaggia <w>di notte</w>.",
                                "cs": "V létě se často procházíme po pláži <w>v noci</w>.",
                                "tr": "Yazın sık sık sahilde <w>gece</w> yürüyüş yaparız.",
                                "es": "En verano a menudo paseamos <w>de noche</w> por la playa.",
                                "zh": "夏天我们经常<w>在夜里</w>沿着海滩散步。"
                            }
                        },
                        {
                            "text": "<w>Nocą</w> wszystkie koty wydają się czarne.",
                            "target_lang_translations": {
                                "ru": "<w>Ночью</w> все кошки кажутся чёрными.",
                                "en": "<w>At night</w> all cats seem black.",
                                "nl": "<w>'s Nachts</w> lijken alle katten zwart.",
                                "de": "<w>Nachts</w> sind alle Katzen grau.",
                                "fr": "<w>La nuit</w>, tous les chats sont gris.",
                                "it": "<w>Di notte</w> tutti i gatti sembrano neri.",
                                "cs": "<w>V noci</w> je každá kočka černá.",
                                "tr": "<w>Geceleyin</w> bütün kediler siyah görünür.",
                                "es": "<w>De noche</w> todos los gatos son pardos.",
                                "zh": "<w>在夜里</w>所有的猫看起来都是黑色的。"
                            }
                        }
