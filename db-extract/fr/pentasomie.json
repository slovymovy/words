                        "entry_id": "00276d51-6a6a-34f0-a566-ef1d7e1b15a5",
                        "glosses": [
                            "Anomalie génétique caractérisée par la présence d'un chromosome en cinq exemplaires."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "c05ac808-1a9e-4fda-8d04-dd4ddc956cd0",
                                "sense_id": "ce79e179-8a02-3c31-9d70-cdfe596f3b0a",
                                "text": "La pentasomie X est une anomalie du chromosome sexuel X, due à la présence de trois chromosomes X surnuméraires chez des femmes (49,XXXXX au lieu de 46,XX)."
                            },
                            {
                                "example_id": "c9311747-8d21-4e7e-9ef1-0a731aa89ee0",
                                "sense_id": "ce79e179-8a02-3c31-9d70-cdfe596f3b0a",
                                "text": "Le matériel chromosomique supplémentaire peut également être présent en 5 (pentasomie) ou 6 (hexasomie) exemplaires, voire plus, soit 3 ou 4 fragments supplémentaires."
                            }
                        ]
                    }
                ],
