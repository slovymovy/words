                "senses": [
                    {
                        "sense_id": "832d4002-711c-35ab-b3be-e93318c4aa48",
                        "entry_id": "fdd5afc4-72a6-34d3-a010-4eb2c9a2ab6d",
                        "glosses": [
                            "Fähigkeit, ein Spiel zu gestalten, sinnvoll zu einem Spiel beizutragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1cddd11-95bf-4c78-af97-8d2de4ca3f47",
                                "sense_id": "832d4002-711c-35ab-b3be-e93318c4aa48",
                                "text": "„Das Spielvermögen ist ein eigenwertiges Lernziel des Sportunterrichts und das Spielen eine sinnvolle Tätigkeit für sich.“"
                            },
                            {
                                "example_id": "2df6005f-af43-4372-8ba2-a31af12e33a3",
                                "sense_id": "832d4002-711c-35ab-b3be-e93318c4aa48",
                                "text": "„Ist diese materielle Fülle, dieses Übermaß von Angeboten in der Lage, Spielfreude und Spielvermögen von Kindern und Jugendlichen anzuregen und zu entfalten?“"
                            },
                            {
                                "example_id": "b328b44f-3851-49c1-a824-6191d33c9d77",
                                "sense_id": "832d4002-711c-35ab-b3be-e93318c4aa48",
                                "text": "„Schüttler hat zum idealen Zeitpunkt das Spielvermögen wiedergefunden, das ihn 2003 unter die besten zehn Spieler der Welt katapultiert hatte.“"
                            },
                            {
                                "example_id": "96f6d6fb-9107-4bd4-8d2c-72ff0df2186f",
                                "sense_id": "832d4002-711c-35ab-b3be-e93318c4aa48",
                                "text": "„Milde Sozialkritik, gepaart mit gediegenem Spielvermögen und Sinn fürs alltägliche Melodram sind die Essenzen ihres Stils, der an Soulgrößen wie Marvin Gaye und Aretha Franklin geschult ist.“"
                            },
                            {
                                "example_id": "286b1bcd-dad0-474e-9160-07a1fc97843f",
                                "sense_id": "832d4002-711c-35ab-b3be-e93318c4aa48",
                                "text": "„Trotz der fundierten Kenntnis und erstaunlichen Beherrschung im Spielvermögen erscheint manches zu beiläufig angelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
