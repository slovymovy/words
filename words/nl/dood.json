                        {
                            "text": "Soms <w>dood</w> ik de insecten in de tuin met gif.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>kill</w> the insects in the garden with poison.",
                                "ru": "Иногда я <w>убиваю</w> насекомых в саду ядом."
                            }
                        }
                    ],
                    "common_phrases": [
