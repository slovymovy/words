                "senses": [
                    {
                        "sense_id": "11b8d72b-6083-3a78-8af7-6fd81e35e623",
                        "entry_id": "b1fda2cc-414a-3efe-882e-fe87db424397",
                        "glosses": [
                            "T-Shirt"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cfce6157-596b-4bb2-9370-f550fa2d356d",
                                "sense_id": "11b8d72b-6083-3a78-8af7-6fd81e35e623",
                                "text": "In dem Leiberl und kurzem Hoserl muss ihm doch kalt sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "592b86dc-068a-35d8-a1ca-df4cf8f63a8d",
                        "entry_id": "b1fda2cc-414a-3efe-882e-fe87db424397",
                        "glosses": [
                            "Trikot"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "935ca681-d148-4872-86e7-936401a8c9cc",
                                "sense_id": "592b86dc-068a-35d8-a1ca-df4cf8f63a8d",
                                "text": "Die Sponsorenlogos auf den neuen Leiberln sind seit dem ersten Waschen total schirch."
                            },
                            {
                                "example_id": "3d0624ab-fc6c-472a-9d9e-b5f4ac623ecb",
                                "sense_id": "592b86dc-068a-35d8-a1ca-df4cf8f63a8d",
                                "text": "übertragen: „Selbst bei klassischen Ministerterminen wie dem EU-Außenministerrat zuletzt in Sofia hatte sie kein Leiberl: EU-Außenkommissarin Federica Mogherini, die mit Kurz sehr gut ist, wollte die neue Kollegin dort partout nicht zum Vieraugengespräch treffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ce355f7d-409c-3781-80af-93ce7ab9d187",
                        "entry_id": "b1fda2cc-414a-3efe-882e-fe87db424397",
                        "glosses": [
                            "Unterhemd"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "06276b34-6ebe-4fc1-8866-f0480102d491",
                                "sense_id": "ce355f7d-409c-3781-80af-93ce7ab9d187",
                                "text": "Jetzt zieh noch ein Leiberl unters Hemd an, damit dein Bauch nicht so durchscheint."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
