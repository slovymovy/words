                                        "entry_id": "f3f34030-5a1c-38c8-8309-cd81621d5ea8",
                                        "glosses": [
                                            "vorzeitige Detonation eines Geschosses (noch vor dem Verlassen des Geschützes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44887a33-379f-48c6-87f4-5b85b44f2d29",
                                                "sense_id": "1c5cfa0c-90b8-3cc8-90fd-e1f9eb7c577b",
                                                "text": "„Häufigste Ursache für Rohrkrepierer sind heißgeschossene Rohre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f83857e8-b050-3226-9c3d-a648c7c17130",
                                        "entry_id": "f3f34030-5a1c-38c8-8309-cd81621d5ea8",
                                        "glosses": [
                                            "eine zunächst aussichtsreiche Sache, die sich später als Reinfall entpuppt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e76b1ad-edad-4b0e-9a6b-b6d08a1f18bc",
                                                "sense_id": "f83857e8-b050-3226-9c3d-a648c7c17130",
                                                "text": "„Viele als ‚Wunderwaffen‘ angepriesene neue Medikamente entpuppen sich als Rohrkrepierer, wenn nach fünf bis zehn Jahren Langzeitstudien vorliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c1aef12-5e9b-47b7-84ba-5fcd32cb0624",
                        "source_entry_id": "3e9f7f68-7c54-3baf-9abd-0027d4caedc3",
                        "source_sense_id": "0a1c9c0c-1a99-3abc-bdbd-a04b921b7df0",
