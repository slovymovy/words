                "senses": [
                    {
                        "sense_id": "9fcd7704-d55f-37d9-982b-741ed008fae6",
                        "entry_id": "fb18764c-7e87-3a1c-af9d-0b40bf82e94c",
                        "glosses": [
                            "Donner un caractère alternatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16dc01cb-e8bd-46ff-b82e-eb916abe1dd9",
                                "sense_id": "9fcd7704-d55f-37d9-982b-741ed008fae6",
                                "text": "si elle ressemble a ses parents elle va alternatiser le monde et déclencher une vraie prise de conscience!"
                            },
                            {
                                "example_id": "3a7bae1e-2387-4317-97e3-5d02e888facc",
                                "sense_id": "9fcd7704-d55f-37d9-982b-741ed008fae6",
                                "text": "Faut que j'ondule, que je transforme, que j'alternatise ? Ou que je n'alimente qu'une lampe de poche?"
                            },
                            {
                                "example_id": "68353d02-d938-4caa-90ae-7271a0d7fee7",
                                "sense_id": "9fcd7704-d55f-37d9-982b-741ed008fae6",
                                "text": "C'est vrai qu'à partir du moment ou il est \"alternatisé\" la jauge peut prendre la place de l'ampèremetre."
                            }
                        ]
                    }
