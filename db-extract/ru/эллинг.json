                        "source_sense_description": "сооружение для постройки, хранения и ремонта дирижаблей и аэростатов",
                        "target_lang_word": "shed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85f1678f-d4ee-3fb9-bf02-3bdbe58b0cf1",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To part, separate or divide."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d2e9e5-66c7-4365-8b4c-99ab051dc6ff",
                                                "sense_id": "85f1678f-d4ee-3fb9-bf02-3bdbe58b0cf1",
                                                "text": "to shed something in two"
                                            },
                                            {
                                                "example_id": "bc2cdae1-8b27-4c59-b7d4-44edd7e16327",
                                                "sense_id": "85f1678f-d4ee-3fb9-bf02-3bdbe58b0cf1",
                                                "text": "to shed the sheep from the lambs"
                                            },
                                            {
                                                "example_id": "990b199e-35e5-49af-80ce-17fcee047eca",
                                                "sense_id": "85f1678f-d4ee-3fb9-bf02-3bdbe58b0cf1",
                                                "text": "A metal comb shed her golden hair."
                                            },
                                            {
                                                "example_id": "35dc9bad-d274-4412-9908-e62ed3379ad2",
                                                "sense_id": "85f1678f-d4ee-3fb9-bf02-3bdbe58b0cf1",
                                                "text": "We are shed with each other by an enormous distance."
                                            },
                                            {
                                                "example_id": "f1b926ba-2143-4e3d-8a5a-c55708cd8f5c",
                                                "sense_id": "85f1678f-d4ee-3fb9-bf02-3bdbe58b0cf1",
                                                "text": "1635, \"Sermon on Philippians III, 7, 8\", in Select Practical Writings of David Dickson (1845), Volume 1, page 166 Internet Archive\nLest […] ye shed with God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beab3fb3-13ef-39be-9323-a9d738a6944f",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To part with, separate from, leave off; cast off, cast, let fall, be divested of."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f630f18a-c5ec-40c5-ba62-288c1fa01275",
                                                "sense_id": "beab3fb3-13ef-39be-9323-a9d738a6944f",
                                                "text": "You must shed your fear of the unknown before you can proceed."
                                            },
                                            {
                                                "example_id": "456579d9-ff39-4801-9037-9af96b20b16f",
                                                "sense_id": "beab3fb3-13ef-39be-9323-a9d738a6944f",
                                                "text": "When we found the snake, it was in the process of shedding its skin."
                                            },
                                            {
                                                "example_id": "16c79510-a341-4317-a08e-543dee29261f",
                                                "sense_id": "beab3fb3-13ef-39be-9323-a9d738a6944f",
                                                "text": "White oats are apt to shed most as they lie, and black as they stand."
                                            },
                                            {
                                                "example_id": "eb10cbf7-c7f4-4d18-b19d-9ab8ff4e8f82",
                                                "sense_id": "beab3fb3-13ef-39be-9323-a9d738a6944f",
                                                "text": "She called on all the marathoners to go to Staten Island to help with the clean-up effort and to bring the clothes they would have shed at the start to shelters or other places where displaced people were in need."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ca9c22-63cd-3d18-b5e1-7f8a020f3053",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To pour; to make flow."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebba90cb-b838-4f2f-9d4a-98a3ad343472",
                                                "sense_id": "e8ca9c22-63cd-3d18-b5e1-7f8a020f3053",
                                                "text": "Did Romeo's hand shed Tybalt's blood?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c53b770-3a50-3438-b860-85c3abac527e",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To allow to flow or fall."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a7e6971-c50c-45f7-b819-ff2a814cc673",
                                                "sense_id": "3c53b770-3a50-3438-b860-85c3abac527e",
                                                "text": "I didn't shed many tears when he left me."
                                            },
                                            {
                                                "example_id": "5e4100b8-46a4-430d-8ee0-c8f727be50dc",
                                                "sense_id": "3c53b770-3a50-3438-b860-85c3abac527e",
                                                "text": "A tarpaulin sheds water."
                                            },
                                            {
                                                "example_id": "fab8db82-411c-4670-ad24-1ab83004263f",
                                                "sense_id": "3c53b770-3a50-3438-b860-85c3abac527e",
                                                "text": "The crash occurred in a steep-sided cutting lined with self-seeded deciduous trees that were shedding their leaves, following unusually heavy rain and high winds in the 12 hours beforehand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5da035a-35d4-33b1-bb84-8444c25654dc",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To radiate, cast, give off (light)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d15b08-c6fb-4105-ba51-7da247fce309",
                                                "sense_id": "b5da035a-35d4-33b1-bb84-8444c25654dc",
                                                "text": "to shed light on"
                                            },
                                            {
                                                "example_id": "4aaba909-e9db-4754-85c8-737b702dabb5",
                                                "sense_id": "b5da035a-35d4-33b1-bb84-8444c25654dc",
                                                "text": "Can you shed any light on this problem?"
                                            },
                                            {
                                                "example_id": "65d1e3af-8a9b-419b-b189-3b741c5b7424",
                                                "sense_id": "b5da035a-35d4-33b1-bb84-8444c25654dc",
                                                "text": "What tho’ the moon—the white moon\nShed all the splendour of her noon,\nHer smile is chilly—and her beam,\nIn that time of dreariness, will seem\n(So like you gather in your breath)\nA portrait taken after death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b2c62e9-8a54-35d9-829b-2f17d82f49cb",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To pour forth, give off, impart."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5df87ad5-8823-469f-8b48-49b0165d6572",
                                                "sense_id": "3b2c62e9-8a54-35d9-829b-2f17d82f49cb",
                                                "text": "Sence now that he by the right honde of god exalted is, and hath receaved off the father the promys off the holy goost, he hath sheed forthe that which ye nowe se and heare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2911e516-7292-3879-b6c2-a3bc74fe62ed",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To fall in drops; to pour."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27afbb5c-c615-3ea3-8ade-1a29124a5953",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To sprinkle; to intersperse; to cover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fe00d5-a75b-4283-9ca4-3d6f9acd11e6",
                                                "sense_id": "27afbb5c-c615-3ea3-8ade-1a29124a5953",
                                                "text": "Her hair […] is shed with gray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a15d195b-1d1f-339e-a375-9668e71bb48a",
                                        "entry_id": "3e004f15-000c-3916-a49c-7526d0e80447",
                                        "glosses": [
                                            "To divide, as the warp threads, so as to form a shed, or passageway, for the shuttle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
