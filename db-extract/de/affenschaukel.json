                "senses": [
                    {
                        "sense_id": "9189ed98-ce93-30f7-ba46-b4c2ecdd18f1",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "auszeichnende Schnur an einer militärischen Uniform (insbesondere die Schützenschnur der Nationalen Volksarmee)"
                        ],
                        "tags": [
                            "humorous",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dd11fb1e-e98a-4464-8b97-4a3b14fb3dda",
                                "sense_id": "9189ed98-ce93-30f7-ba46-b4c2ecdd18f1",
                                "text": "„Selbst die ‚Affenschaukel‘, jenes auffällige, geflochtene Seil zwischen Schulterstücken und Knopfleiste, war ‚Made in GDR‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e79141a2-3d61-31e4-b2d4-d3feebf20fff",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "zu beiden Seiten des Kopfes schlingenförmig herabhängender Zopf"
                        ],
                        "tags": [
                            "Haarmode"
                        ],
                        "examples": [
                            {
                                "example_id": "71667056-c7e4-4981-b59f-1cd1fbf12413",
                                "sense_id": "e79141a2-3d61-31e4-b2d4-d3feebf20fff",
                                "text": "„Und dann ging es los. Die Jungen der Quarta zogen vom Leder, als sie erfuhren, dass nach den Ferien ein Mädchen in ihre Klasse gehen sollte. ‚Mädels hänseln, petzen und heulen‘ ist das einhellige Urteil der bisherigen Herren der Quarta. Und als die blonde Hannelore – so heißt die ‚Neue‘ – kommt, werden ihr Zöpfe als Affenschaukeln bezeichnet. Doch Hannelore ist den rauen Umgang gewohnt, sie hat zwei Brüder zu Hause.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f567bebe-98dc-3efb-989d-2340fd1dff43",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "eine auf Volksfesten und Jahrmärkten anzutreffende Überschlagsschaukel"
                        ],
                        "tags": [
                            "Unterhaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "db94c491-88a6-4ec6-be6b-f7bc9e116c6b",
                                "sense_id": "f567bebe-98dc-3efb-989d-2340fd1dff43",
                                "text": "„‹Enterprise›, Geisterbahn oder Affenschaukel fehlen auch dieses Jahr nicht auf dem Chilbiplatz. ‹Superlooping heisst die Affenschaukel eigentlich›, sagt Peter Schwenk, der zusammen mit seinem Chef noch eine weitere Affenschaukel und ein Piratenschiff auf- und abbaut.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ba0ddbd2-58df-3da9-9bef-6ee88e515a53",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "das Aufhängen einer Person an einer Stange"
                        ],
                        "tags": [
                            "Foltermethode"
                        ],
                        "examples": [
                            {
                                "example_id": "83ec7917-1ed7-4fe5-8918-1f1789797c30",
                                "sense_id": "ba0ddbd2-58df-3da9-9bef-6ee88e515a53",
                                "text": "„Die brachialsten Folterungen, die Kurnaz erdulden musste, Elektroschocks und fünf Tage Affenschaukel, werden visuell ausgespart.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "be159f0f-9255-330a-b8a5-b819277aa937",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "frei an der Decke vom Stromanschluss zur Lampe führende Lampenleitung; flexible (hängende) Kabelverbindung zu einer Tür"
                        ],
                        "tags": [
                            "Elektroinstallation"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f06d99-66fe-4973-919c-b08cb06adab2",
                                "sense_id": "be159f0f-9255-330a-b8a5-b819277aa937",
                                "text": "Nach der Renovierung unseres Wohnzimmers möchte ich diese Affenschaukel an der Decke nicht mehr sehen!"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "0b4da218-c3de-3699-a631-a5137aae4a9a",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "sukkulente Pflanze mit bis zu einem Meter herabhängenden, vollständig mit kleinen sich überlappenden, runden Blättern bewachsenen Trieben, die häufig als Zimmerpflanze Verwendung findet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684b9a4f-213f-4ca0-b5bc-f3afac88a6d7",
                                "sense_id": "0b4da218-c3de-3699-a631-a5137aae4a9a",
                                "text": "„Lässt die Affenschaukel (Sedum morganianum) die Blätter rieseln, ist eine unsanfte Behandlung schuld.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "e1502f24-e2d1-3123-85b3-b1611732b3e3",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "die Bindetechnik des Pfadfindertuches"
                        ],
                        "tags": [
                            "Pfadfindertum"
                        ],
                        "examples": [
                            {
                                "example_id": "28c5017c-e9a4-460a-bd30-b06fa151e81e",
                                "sense_id": "e1502f24-e2d1-3123-85b3-b1611732b3e3",
                                "text": "„Weltweit wird das Halstuch von nahezu allen Pfadfinderverbänden im Kragen getragen, also zwischen Hals und Hemd. In Deutschland tragen es einige Verbände bzw. Gruppen unter dem Kragen (ähnlich einer Krawatte). […] Andere Gruppen legen Wert auf eine Trageweise, bei der das Halstuch unter dem Kragen mit einem Halstuchknoten zusammengehalten wird, und lehnen die sogenannte ‚Affenschaukel‘, bei der das Halstuch erst ganz unten an Spitzen zusammengeknotet ist, als unpfadfinderisch ab, weil sie ursprünglich vom Wandervogel stammt.“"
                            }
                        ],
                        "sense_index_json": "\"7\""
                    },
                    {
                        "sense_id": "fc74823a-c874-34e8-aefe-b05a70a8406d",
                        "entry_id": "c27b5e1f-b00e-31d6-b899-a55497e63987",
                        "glosses": [
                            "das @-Zeichen (At-Zeichen) als grundlegender Bestandteil von Mail-Adressen und als Symbol für das Internet"
                        ],
                        "tags": [
                            "Netzwerktechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "7e12d3ac-6f6c-46e7-a9b3-421ced6434e8",
                                "sense_id": "fc74823a-c874-34e8-aefe-b05a70a8406d",
                                "text": "Auch deine Mail-Adresse enthält eine Affenschaukel!"
                            }
                        ],
                        "sense_index_json": "\"8\""
                    }
