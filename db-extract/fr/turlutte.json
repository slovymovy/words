                    {
                        "translation_id": "cdc7c67d-7d20-4a28-a0e6-1d7abe9ddad5",
                        "source_entry_id": "fdc25f79-4ee6-3409-9584-f883da99023a",
                        "source_sense_id": "7a4d8c76-3e70-3b19-ae7c-c8611ba8c467",
                        "source_sense_description": "Fischfang: Jig",
                        "target_lang_word": "jig",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b29f48a-3a32-3a7a-b074-8e6ce065f586",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "A light, brisk musical movement; a gigue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57e00070-f7ac-30c6-ac97-4db5b71543eb",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "A lively dance in 6/8 (double jig), 9/8 (slip jig) or 12/8 (single jig) time; a tune suitable for such a dance. By extension, a lively traditional tune in any of these time signatures. Unqualified, the term is usually taken to refer to a double (6/8) jig."
                                        ],
                                        "tags": [
                                            "Irish",
                                            "traditional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04516dd9-843d-41bb-8d16-bae4178d7475",
                                                "sense_id": "57e00070-f7ac-30c6-ac97-4db5b71543eb",
                                                "text": "They danced a jig."
                                            },
                                            {
                                                "example_id": "30681695-0437-4acc-9d1c-cc0a88dcf00d",
                                                "sense_id": "57e00070-f7ac-30c6-ac97-4db5b71543eb",
                                                "text": "Soon Marshall is doing an elaborate foot-to-foot jig, and then they're all bounding around. Shoulder dips. Yee-ha faces. It's an impromptu hoedown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9b896f-39cd-3c4d-a380-083506b30c80",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "A dance performed by one or sometimes two individual dancers, as opposed to a dance performed by a set or team."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4c793d4-e711-344c-8669-d8568002421e",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "A type of lure consisting of a hook molded into a weight, usually with a bright or colorful body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa67e0c-7aaa-423f-9eb8-75a71494cf64",
                                                "sense_id": "b4c793d4-e711-344c-8669-d8568002421e",
                                                "text": "They were waked out of their bunks one black night by yells of \"Squid O!\" from Salters, and for an hour and a half every soul aboard hung over his squid-jig—a piece of lead painted red and armed at the lower end with a circle of pins bent backward like half-opened umbrella ribs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c7b2044-2cb7-38b8-a10c-a96a7280d8cf",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "A device in manufacturing, woodworking, or other creative endeavors for controlling the location, path of movement, or both of either a workpiece or the tool that is operating upon it. Subsets of this general class include machining jigs, woodworking jigs, welders' jigs, jewelers' jigs, and many others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73bac7a5-525c-438e-9de3-2ad006bd37d7",
                                                "sense_id": "5c7b2044-2cb7-38b8-a10c-a96a7280d8cf",
                                                "text": "Cutting circles out of pinewood is best done with a compass-style jig."
                                            },
                                            {
                                                "example_id": "db7211d4-3f66-4bf7-8a39-2384ccb31833",
                                                "sense_id": "5c7b2044-2cb7-38b8-a10c-a96a7280d8cf",
                                                "text": "The bodywork employs, where possible, the same constructional methods as for the standard B.R. coaching stock, in order to utilise existing jigs and press tools."
                                            },
                                            {
                                                "example_id": "c99ce150-78c7-4e28-bf42-117339bf3287",
                                                "sense_id": "5c7b2044-2cb7-38b8-a10c-a96a7280d8cf",
                                                "text": "The craze for realism now led the toy manufacturers to try to make their models from still secret plans for the new cars. Should a car firm scrap its plans and jigs, the toy firm had to follow suit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b3f659c-d994-327e-adb2-debe1448fdd9",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "An apparatus or machine for jigging ore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "393a5a40-4744-3888-9aed-79716d791aea",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "A light, humorous piece of writing, especially in rhyme; a farce in verse; a ballad."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61288b91-2bba-41c6-b0c6-6c812b3e77d2",
                                                "sense_id": "393a5a40-4744-3888-9aed-79716d791aea",
                                                "text": "A jig shall be clapped at, and every rhyme / Praised and applauded by a clamorous chime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d288663-03a7-31f0-83d4-c10c2b35ee9d",
                                        "entry_id": "4a5c11d1-89b9-3fdd-a7b2-af23d38bdd36",
                                        "glosses": [
                                            "A trick; a prank."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97e065a7-5950-4bb1-b56f-0166768a2a56",
                                                "sense_id": "5d288663-03a7-31f0-83d4-c10c2b35ee9d",
                                                "text": "This Innovation? Is't not a fine Jigg? / A precious cunning in the late Protector / To shuffle a new Prince into the State."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "764605b4-429d-30aa-ae9c-d58918f97225",
                                        "entry_id": "5a031a80-56c6-3a70-8ff1-9a1e903e41fa",
                                        "glosses": [
                                            "To move briskly, especially as a dance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9303bc82-465c-4220-b187-6b488c0c00c8",
                                                "sense_id": "764605b4-429d-30aa-ae9c-d58918f97225",
                                                "text": "The guests were jigging around on the dance floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6277532e-e479-3568-b50d-5ad3288816fe",
                                        "entry_id": "5a031a80-56c6-3a70-8ff1-9a1e903e41fa",
                                        "glosses": [
                                            "To move with a skip or rhythm; to move with vibrations or jerks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f982723e-6e3d-4d6f-b3ed-92aaa67eeda5",
                                                "sense_id": "6277532e-e479-3568-b50d-5ad3288816fe",
                                                "text": "[…]and the fin would jig off slowly, as if it were looking for nothing at all."
                                            },
                                            {
                                                "example_id": "f8a5121a-452e-481f-b0d3-3a627904e7c9",
                                                "sense_id": "6277532e-e479-3568-b50d-5ad3288816fe",
                                                "text": "the candle-flame stretched itself tall, and began jigging up and down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d9d9932-2707-3aff-be45-0bef3a1c1ce5",
                                        "entry_id": "5a031a80-56c6-3a70-8ff1-9a1e903e41fa",
                                        "glosses": [
                                            "To fish with a jig."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61d7e843-f688-38d2-9d24-76a506f1f59c",
                                        "entry_id": "5a031a80-56c6-3a70-8ff1-9a1e903e41fa",
                                        "glosses": [
                                            "To sing to the tune of a jig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba134b5-3fbe-4253-afc1-3f82af3c3afe",
                                                "sense_id": "61d7e843-f688-38d2-9d24-76a506f1f59c",
                                                "text": "No, my complete master, but to jig off a tune at the tongue’s end, canary to it with your feet, humor it with turning up your eyelids,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45f7e7ef-876e-31a3-9980-d7e1603be4f2",
                                        "entry_id": "5a031a80-56c6-3a70-8ff1-9a1e903e41fa",
                                        "glosses": [
                                            "To trick or cheat; to cajole; to delude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8328fda7-af98-40d2-9af6-0a94a469f702",
                                                "sense_id": "45f7e7ef-876e-31a3-9980-d7e1603be4f2",
                                                "text": "Make thy moan to ballad singers and rhymers ; they'll jig out thy wretchedness and abominations to new tunes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d2f365-04f8-3c94-b00c-dd5c638757ad",
                                        "entry_id": "5a031a80-56c6-3a70-8ff1-9a1e903e41fa",
                                        "glosses": [
                                            "To sort or separate, as ore in a jigger or sieve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd41c479-4e59-390e-b1bb-bd015cd95ad7",
                                        "entry_id": "5a031a80-56c6-3a70-8ff1-9a1e903e41fa",
                                        "glosses": [
                                            "To cut or form, as a piece of metal, in a jigging machine."
                                        ],
