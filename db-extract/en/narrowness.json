                "word": "narrowness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eb9165bf-de3e-4ef3-b93c-9bbd67ddb9f9",
                        "entry_id": "65c5e052-d315-3b8f-a020-a9b50f9298c4",
                        "tags": [
                            "plural"
                        ],
