                "senses": [
                    {
                        "sense_id": "dc6b93d8-32e5-36b3-8385-3c31cf2ad3f6",
                        "entry_id": "20013e36-1da0-3f16-92c1-0adab2ac736b",
                        "glosses": [
                            "Angehöriger eines keltischen Stammes in Gallien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ec5d69-7975-42c3-9f82-a41e1e3815b3",
                                "sense_id": "dc6b93d8-32e5-36b3-8385-3c31cf2ad3f6",
                                "text": "Asterix ist wohl der bekannteste Gallier."
                            },
                            {
                                "example_id": "a52c5dd6-72bc-4028-b029-28e956fd4529",
                                "sense_id": "dc6b93d8-32e5-36b3-8385-3c31cf2ad3f6",
                                "text": "„Für die Gallier war dies eine klare Verletzung der Neutralität, zu der die römische Delegation eigentlich verpflichtet gewesen wäre.“"
                            },
                            {
                                "example_id": "e2faa4af-082b-4fcd-946d-f18051f93cdd",
                                "sense_id": "dc6b93d8-32e5-36b3-8385-3c31cf2ad3f6",
                                "text": "„So wissen wir von Caesar, daß bei den Galliern einmal im Jahr die Druiden einen geweihten Ort aufsuchten, um Gericht zu halten, und daß an diesen Orten auch Menschen geopfert wurden.“"
                            },
                            {
                                "example_id": "ed2ba528-226c-4c66-86d7-facb81e110f6",
                                "sense_id": "dc6b93d8-32e5-36b3-8385-3c31cf2ad3f6",
                                "text": "„Auch die Gallier kannten eine unterirdische Totenwelt.“"
                            },
                            {
                                "example_id": "37e3e0f9-c1e6-4cac-bc5f-7b56816f5e12",
                                "sense_id": "dc6b93d8-32e5-36b3-8385-3c31cf2ad3f6",
                                "text": "„Polybios erwähnt nicht das hohe Lösegeld, das die Römer für den Abzug der Gallier zahlen müssen, wie Livius berichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d53738a4-bd42-4409-acd0-9107a202bc5a",
                        "source_entry_id": "20013e36-1da0-3f16-92c1-0adab2ac736b",
                        "source_sense_id": "dc6b93d8-32e5-36b3-8385-3c31cf2ad3f6",
