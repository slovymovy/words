                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f330357f-037e-38b0-92cd-abb9e4ff5a7a",
                                        "entry_id": "d2676caa-06b0-3e8e-b062-9b8e4507a86b",
                                        "glosses": [
                                            "A city in Alabama."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6fc6a47-59d1-4a32-933e-ca138282cbb8",
                                                "sense_id": "f330357f-037e-38b0-92cd-abb9e4ff5a7a",
                                                "text": "In 1891, he settled in tiny Clio, Alabama, a hamlet of 13 families founded after the Civil War without the antebellum pretensions of nearby Eufala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d67c278-c64c-39d4-9802-50ce3002cf5b",
                                        "entry_id": "d2676caa-06b0-3e8e-b062-9b8e4507a86b",
                                        "glosses": [
                                            "A city in Iowa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "592a2e47-9934-3ed0-be76-789a24eac586",
                                        "entry_id": "d2676caa-06b0-3e8e-b062-9b8e4507a86b",
                                        "glosses": [
                                            "A city in Michigan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "758ed93f-017b-3f3d-a1e8-b1716bdbd0ed",
                                        "entry_id": "d2676caa-06b0-3e8e-b062-9b8e4507a86b",
                                        "glosses": [
                                            "A town in South Carolina."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad1380ad-24e6-38ae-8d6d-5cee464ffeee",
                                        "entry_id": "d2676caa-06b0-3e8e-b062-9b8e4507a86b",
                                        "glosses": [
                                            "A census-designated place in Plumas County, California, United States."
                                        ],
                                        "tags": [],
