                ],
                "senses": [
                    {
                        "sense_id": "9cd5fd6a-9567-3028-960a-120995b9b786",
                        "entry_id": "7ea028b7-fb3c-3d0c-b767-3642168be3bd",
                        "glosses": [
                            "auf einer landwirtschaftlichen Fläche liegender oder von dort entfernter Stein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15cbd94a-2d9d-45f4-b6b0-ac9516fe0b32",
                                "sense_id": "9cd5fd6a-9567-3028-960a-120995b9b786",
                                "text": "„Da lagen Feldsteine umher, und diese Wiese fiel nach vorn ab.“"
                            },
                            {
                                "example_id": "dcbca104-c8ab-448c-833b-7ed55287a88c",
                                "sense_id": "9cd5fd6a-9567-3028-960a-120995b9b786",
                                "text": "„Er trat gegen einen Feldstein, und ich nahm mir vor, Staszek zu sagen, daß wir ihm Hosen kaufen müßten.“"
                            },
                            {
                                "example_id": "1308d745-12e6-4f0f-b5b1-638eaf8971ba",
                                "sense_id": "9cd5fd6a-9567-3028-960a-120995b9b786",
                                "text": "„Wie früher, empfand Robert und schämte sich für seinen Vater, dem er am liebsten einen Feldstein in den Schlund gedrückt hätte.“"
                            },
                            {
                                "example_id": "5b9d1500-91d3-4ec4-a004-1f7eb2784588",
                                "sense_id": "9cd5fd6a-9567-3028-960a-120995b9b786",
                                "text": "„Die Scheune war gewölbt wie eine Kathedrale mit Bögen aus Ziegeln, die auf Mauern aus Feldsteinen ruhten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
