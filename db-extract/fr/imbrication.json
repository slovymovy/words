                ],
                "senses": [
                    {
                        "sense_id": "112bc2b5-94b4-3f4f-b6d2-b8306e6cd029",
                        "entry_id": "d352857f-0c2d-32e0-b679-d02f1cbd2a40",
                        "glosses": [
                            "Action d’imbriquer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e6e11c-8202-4acd-8422-87fa5c3a1056",
                                "sense_id": "112bc2b5-94b4-3f4f-b6d2-b8306e6cd029",
                                "text": "Le dernier étage, mansardé, avait comme revêtement, entre chaque croisée, une savante imbrication d’ardoises ; au second, ces revêtements étaient en chêne simulant des écailles."
                            },
                            {
                                "example_id": "49b76a5b-da3b-4123-a16c-2bb38f80d901",
                                "sense_id": "112bc2b5-94b4-3f4f-b6d2-b8306e6cd029",
                                "text": "C’est comme un long-métrage mais sur scène, une imbrication totale de la danse, du théâtre et du cinéma."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00c0d6c5-0cfe-440a-8e47-fecad6d6f8f3",
                        "source_entry_id": "d352857f-0c2d-32e0-b679-d02f1cbd2a40",
                        "source_sense_id": "112bc2b5-94b4-3f4f-b6d2-b8306e6cd029",
                        "target_lang_word": "imbrication",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbrication",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a22065e-37a2-31c1-8b7e-f7684d384745",
                                        "entry_id": "2670be3a-86dc-3f05-927b-25fd652c7b84",
                                        "glosses": [
                                            "A set of tiles or shingles that overlap like the scales of a fish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54fcc7c4-96e8-3e69-9ead-cf2467409f23",
                                        "entry_id": "2670be3a-86dc-3f05-927b-25fd652c7b84",
                                        "glosses": [
                                            "Overlapping of layers of tissue in wound closure or in correctional or reconstructive surgery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edac2e3d-b2da-44e1-a4a2-2a251e30ef43",
                                                "sense_id": "54fcc7c4-96e8-3e69-9ead-cf2467409f23",
                                                "text": "SMAS flaps or SMASectomies are considered imbrications in this chapter. SMAS tightening is probably a more accurate description with 'open' SMAS techniques referring to imbrication and 'closed' SMAS techniques referring to plication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74ff969-e901-3e8a-b811-89a9f0a604d4",
                                        "entry_id": "2670be3a-86dc-3f05-927b-25fd652c7b84",
                                        "glosses": [
                                            "A sedimentary deposition in which small, flat stones are tiled in the same direction so that they overlap."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619758a4-6022-4c6f-9b77-053558f94b98",
                                                "sense_id": "f74ff969-e901-3e8a-b811-89a9f0a604d4",
                                                "text": "The Archean basement beyond and beneath the northwest flanks of the turbidite basins constitutes the cratonic foreland against which northwest-directed tectonic imbrication is thought to have occurred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdff8fc9-2126-3268-a504-99b946d45d65",
                                        "entry_id": "2670be3a-86dc-3f05-927b-25fd652c7b84",
                                        "glosses": [
                                            "A phenomenon occurring in many Bantu languages in which morphemes interweave in certain morphophonological conditions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638ac04d-aab9-434c-a91b-9218a8d2ab89",
                                                "sense_id": "bdff8fc9-2126-3268-a504-99b946d45d65",
                                                "text": "The Kiyaka perfective, applicative, and causative suffixes display an unusual type of infixation known in the Bantu literature as “imbrication” (see e.g. the discussion of imbrication in Tiene in chapters 4 and 6)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "374d5b14-295c-390c-b5ce-63dd4c186965",
                                        "entry_id": "2670be3a-86dc-3f05-927b-25fd652c7b84",
                                        "glosses": [
                                            "The use of relative positioning, often by varying amounts of indentation, to define hierarchical relationships between elements of code."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10a7ae1-60f4-4645-878e-ef7996d2d92d",
                                                "sense_id": "374d5b14-295c-390c-b5ce-63dd4c186965",
                                                "text": "Only a subset of YAML is used: sequences are only expected to contain scalars and mappings are only expected to contain a scalar or a mapping, but with only one level of imbrication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
