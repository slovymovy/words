                        "source_entry_id": "1c37b585-56ed-3a4d-b486-257752d99b3a",
                        "source_sense_id": "d1d4f289-11f5-3bf0-a549-2a9e8a9c3d0b",
                        "source_sense_description": "Maßnahme, durch die ein Konflikt unterdrückt oder behoben wird, und Ergebnis dieser Maßnahme",
                        "target_lang_word": "pacification",
                        "target_lang_code": "fr",
