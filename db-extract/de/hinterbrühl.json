                ],
                "senses": [
                    {
                        "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                        "entry_id": "2f86c3e0-b1d0-3982-8a37-48d45d4baa3b",
                        "glosses": [
                            "niederösterreichische Marktgemeinde südwestlich von Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa60ee56-cac0-42b3-8e75-dcb1a4df803b",
                                "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                                "text": "Im Westen führt eine Straßenverbindung durch die Vorderbrühl, die früher ein eigener Ort war, in die Hinterbrühl."
                            },
                            {
                                "example_id": "da48f9ea-a7f6-4d80-bf6e-1b98c325599a",
                                "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                                "text": "Im Jahr 1957 gründete Hermann Gmeiner in der niederösterreichischen Gemeinde Hinterbrühl das SOS-Kinderdorf Hinterbrühl."
                            },
                            {
                                "example_id": "0e0460f3-995e-4e58-88b0-59fe772f6e15",
                                "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                                "text": "Hinterbrühls Seegrotte ist ein einmaliges Naturschauspiel."
                            },
                            {
                                "example_id": "526b0a52-ae78-428f-9e55-90b61035027a",
                                "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                                "text": "Die Marktgemeinde Hinterbrühl veranstaltet einen Fotowettbewerb unter dem Motto „Schönste Ortsbilder Hinterbrühls“."
                            },
                            {
                                "example_id": "f7e0aef8-4d77-46b2-a4d7-eed5ca56eb9b",
                                "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                                "text": "Es habe gelegentlich in der Hinterbrühl Senkungen gegeben, die auf darunterliegende Hohlräume hinweisen, aber lediglich kleinere Fälle."
                            },
                            {
                                "example_id": "ee6f7a52-1643-4b3f-9436-937bcc1e11af",
                                "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                                "text": "Insgesamt stehen dir in der Region Hinterbrühl 55 abwechslungsreiche Wanderungen zur Auswahl."
                            },
                            {
                                "example_id": "f3349317-5c6e-4874-95ed-0f06307f943b",
                                "sense_id": "028798dc-1543-3e8a-bc7b-689aa4618f44",
                                "text": "„Der Haupttheil des Hinterbrühls liegt am Abhange des Halterkogels an den Ufern des Medlinger- oder Altbaches, etwas tiefer im Thale.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
