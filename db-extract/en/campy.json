                "senses": [
                    {
                        "sense_id": "4b4ecf2f-cc49-34a9-a5c3-abc39f10e7c0",
                        "entry_id": "fef646ea-fc04-3a4a-9998-f13595b23f28",
                        "glosses": [
                            "Characterized by camp or kitsch, especially when deliberate or intentional."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a19827-66de-4a6c-9f98-94dcd7f23548",
                                "sense_id": "4b4ecf2f-cc49-34a9-a5c3-abc39f10e7c0",
                                "text": "Stu liked to watch campy B-movie horror flicks from the 1950s, not because they scared him, but because he found them funny."
                            },
                            {
                                "example_id": "349f988d-2014-4c21-8b3e-eb3354ac3230",
                                "sense_id": "4b4ecf2f-cc49-34a9-a5c3-abc39f10e7c0",
                                "text": "It no longer worked, culturally or financially, to be either snooty or campy about lowbrow culture; at the same time its mediation of highbrow culture no longer counted for much either."
                            },
                            {
                                "example_id": "726d0ba6-b4a7-43fd-9f57-7fad944cfb44",
                                "sense_id": "4b4ecf2f-cc49-34a9-a5c3-abc39f10e7c0",
                                "text": "A campy science-fiction/horror musical whose characters include the cross-dressing mad scientist Dr. Frank-N-Furter, it had been developing a following for its Friday and Saturday midnight showings for several months."
                            },
                            {
                                "example_id": "f43dd0ff-abd8-4c55-ab77-f993b702cbb1",
                                "sense_id": "4b4ecf2f-cc49-34a9-a5c3-abc39f10e7c0",
                                "text": "A campy fairy-tale spoof that sidesteps the bio-musical formula to focus on a cast of disillusioned Disney princesses and storybook protagonists, “Once Upon a One More Time” is the latest in a long line of jukebox musicals that have plumbed the catalogs of acts including Frankie Valli and the Four Seasons, Michael Jackson, Tina Turner and the Temptations in pursuit of box office gold."
                            }
                        ]
                    }
