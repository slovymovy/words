                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Glossematik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbcc3a90-f2fe-3be2-ad6d-f0de06694378",
                        "entry_id": "addd9021-1b2a-3956-b11a-535ec1f85fb4",
                        "glosses": [
                            "Bezeichnung für eine sprachtheoretische Strömung der Kopenhagener Linguistenschule, deren bekannteste Vertreter Louis Hjelmslev und Hans Jørgen Uldall waren."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "831e4acd-bdc5-4c53-b61c-e85d63d3ae2e",
                                "sense_id": "fbcc3a90-f2fe-3be2-ad6d-f0de06694378",
                                "text": "Die Glossematik war einer der Versuche, eine neue Sprachtheorie zu entwickeln."
                            },
                            {
                                "example_id": "a31c3ad2-aee5-4ed6-8695-8281d695f8de",
                                "sense_id": "fbcc3a90-f2fe-3be2-ad6d-f0de06694378",
                                "text": "„Da sich die Glossematik nach dem Willen ihrer Schöpfer nur mit der Form, nicht mit der Substanz, zu befassen hat, ergeben sich als Arbeitsgebiete die Ausdrucksform, für die die sog. Kenematik und die Inhaltsform, für die die sog. Plerematik zuständig ist.“"
                            },
                            {
                                "example_id": "890dfb59-cd31-4eb8-a43f-f6a7e2542379",
                                "sense_id": "fbcc3a90-f2fe-3be2-ad6d-f0de06694378",
                                "text": "„Der Begriff der Glossematik schließt folglich nicht nur die Beachtung der Form unter Vernachlässigung der Substanz ein, sondern auch die Tatsache, daß diese linguistische Form eine Form des Inhalts und des Ausdrucks ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
