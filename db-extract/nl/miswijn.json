                        "entry_id": "ef737b00-a7c1-3144-bd83-558ae2c75817",
                        "glosses": [
                            "sacramental wine (any (white) wine, approved/made for sacramental use in Catholic, Orthodox and some other liturgies)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "c8f4b1de-3b40-45db-b206-54f74147fc6c",
                                "sense_id": "33c7a109-c8f4-3e4c-83a5-a2017c3dd6e5",
                                "text": "Tijdens de mis wordt er gebruik gemaakt van miswijn voor het sacrament.",
                                "translation": "During the mass, sacramental wine is used for the sacrament.",
                                "english": "During the mass, sacramental wine is used for the sacrament."
                            },
                            {
                                "example_id": "ed5c4255-3590-40ac-b547-abc89931a549",
                                "sense_id": "33c7a109-c8f4-3e4c-83a5-a2017c3dd6e5",
                                "text": "De priester schonk een kleine hoeveelheid miswijn in de kelk.",
                                "translation": "The priest poured a small amount of sacramental wine into the chalice.",
                                "english": "The priest poured a small amount of sacramental wine into the chalice."
                            },
                            {
                                "example_id": "7d9f456f-b29d-4a5c-9e3e-d8486fd47d54",
                                "sense_id": "33c7a109-c8f4-3e4c-83a5-a2017c3dd6e5",
                                "text": "De kerk bewaart een speciale voorraad miswijn voor religieuze ceremonies.",
                                "translation": "The church keeps a special supply of sacramental wine for religious ceremonies.",
                                "english": "The church keeps a special supply of sacramental wine for religious ceremonies."
                            }
                        ]
                    }
