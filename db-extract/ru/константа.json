                "senses": [
                    {
                        "sense_id": "80f7a888-8b4f-3cce-9de5-b4d271eb2b78",
                        "entry_id": "43a353e8-3850-3702-89a5-5205bff276c1",
                        "glosses": [
                            "матем., физ. постоянная, не изменяющаяся величина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b4b5b7-1cd7-491d-8360-2273f3c14e67",
                                "sense_id": "80f7a888-8b4f-3cce-9de5-b4d271eb2b78",
                                "text": "Согласно идее Сахарова, гравитационная константа ― результат микроскопической структуры вакуума."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec9e8216-2816-4d6f-8380-814871f214da",
                        "source_entry_id": "43a353e8-3850-3702-89a5-5205bff276c1",
                        "source_sense_id": "80f7a888-8b4f-3cce-9de5-b4d271eb2b78",
                        "target_lang_word": "constant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5822dd71-b6b7-386d-8b46-9e4c27f410ea",
                                        "entry_id": "155ea877-0ec5-382b-8786-c1368bc90833",
                                        "glosses": [
                                            "Unchanged through time or space; permanent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2a34431-abc5-3afa-a974-21921cbc565b",
                                        "entry_id": "155ea877-0ec5-382b-8786-c1368bc90833",
                                        "glosses": [
                                            "Consistently recurring over time; persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fd8428-d52d-4485-962c-da883de54d1f",
                                                "sense_id": "a2a34431-abc5-3afa-a974-21921cbc565b",
                                                "text": "The constant pinging of electronic devices is driving many people to the end of their tether. Electronic devices not only overload the senses and invade leisure time. They feed on themselves: the more people tweet the more they are rewarded with followers and retweets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c50e209e-337f-3093-9a55-fe278d5601f5",
                                        "entry_id": "155ea877-0ec5-382b-8786-c1368bc90833",
                                        "glosses": [
                                            "Steady in purpose, action, feeling, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289d2c5a-8a61-4a82-9e5a-11f7949d4a82",
                                                "sense_id": "c50e209e-337f-3093-9a55-fe278d5601f5",
                                                "text": "Both loving one fair maid, they yet remained constant friends.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "33c0cbda-262a-4a84-ba19-43426ee7e631",
                                                "sense_id": "c50e209e-337f-3093-9a55-fe278d5601f5",
                                                "text": "I am constant to my purposes."
                                            },
                                            {
                                                "example_id": "515a3245-41ec-4fc6-9200-6e58a7186544",
                                                "sense_id": "c50e209e-337f-3093-9a55-fe278d5601f5",
                                                "text": "His gifts, his constant courtship, nothing gained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24cbcd5-f836-3b87-920e-2a3fa2d839d8",
                                        "entry_id": "155ea877-0ec5-382b-8786-c1368bc90833",
                                        "glosses": [
                                            "Firm; solid; not fluid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16528870-e562-46b3-8fe0-df4b499b7711",
                                                "sense_id": "e24cbcd5-f836-3b87-920e-2a3fa2d839d8",
                                                "text": "If […] you mix them, you may turn these two fluid liquors into a constant body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb68c5a4-c524-3308-93ca-a5c6203c239c",
                                        "entry_id": "155ea877-0ec5-382b-8786-c1368bc90833",
                                        "glosses": [
                                            "Consistent; logical."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51219468-97b1-48a9-835b-b08513beda45",
                                                "sense_id": "fb68c5a4-c524-3308-93ca-a5c6203c239c",
                                                "text": "I am no more mad than you are: make the trial of it with any constant question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3584fa47-0454-3559-81c4-e340dfe9f00d",
                                        "entry_id": "155ea877-0ec5-382b-8786-c1368bc90833",
                                        "glosses": [
                                            "Bounded above by a constant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca632ebe-6366-468c-b5e9-d2afe502e9fe",
                                                "sense_id": "3584fa47-0454-3559-81c4-e340dfe9f00d",
                                                "text": "constant time   constant space"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40501959-9115-31ac-9923-715da297eb1c",
                                        "entry_id": "808612ab-00bd-3807-a0a3-7d67f239a2d8",
                                        "glosses": [
                                            "That which is permanent or invariable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2ec50bb-6a80-3010-9c73-019ba7a57b81",
                                        "entry_id": "808612ab-00bd-3807-a0a3-7d67f239a2d8",
                                        "glosses": [
                                            "A quantity that remains at a fixed value throughout a given discussion or operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d44b3af-c1cb-458e-a517-de1444bae0d1",
                                                "sense_id": "a2ec50bb-6a80-3010-9c73-019ba7a57b81",
                                                "text": "We also establish that constants are local extremizers of the Tomas-Stein adjoint restriction inequality as well as of another inequality appearing in the program.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d9a528-5bc1-38c0-9b59-064bac38ab03",
                                        "entry_id": "808612ab-00bd-3807-a0a3-7d67f239a2d8",
                                        "glosses": [
                                            "Any property of an experiment, determined numerically, that does not change under given circumstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415d50b0-4323-498c-8891-6b3d08199427",
                                                "sense_id": "59d9a528-5bc1-38c0-9b59-064bac38ab03",
                                                "text": "Based on their acid dissociation constants (pKa), seleneous^([sic]) acid (H2SeO3) and selenic acid (H2SeO4) are anionic under common environmental conditions [48], e.g., as selenite (SeO32−) and selenate (SeO42−)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6b4e26b-d9f9-3a15-89f9-427d11e1e086",
                                        "entry_id": "808612ab-00bd-3807-a0a3-7d67f239a2d8",
                                        "glosses": [
                                            "An identifier that is bound to an invariant value; a fixed value given a name to aid in readability of source code."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
