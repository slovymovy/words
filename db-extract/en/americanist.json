                    {
                        "sense_id": "c3b6d30f-0dfb-3374-93df-20fd22f87670",
                        "entry_id": "8bc778f2-271e-3885-a16f-350fccf41040",
                        "glosses": [
                            "Somebody who favors the values of the USA."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf5b6f02-518d-44a5-9621-8f87bbf61105",
                                "sense_id": "c3b6d30f-0dfb-3374-93df-20fd22f87670",
                                "text": "He’s [JD Vance] creating a fake position—that Americanists should be built on nothing but fealty to the Declaration of Independence—in order to argue his real position: that Americanists should have nothing to do with the ideals and the Declaration of Independence."
                            }
                        ]
                    },
