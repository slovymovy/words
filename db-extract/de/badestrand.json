                "senses": [
                    {
                        "sense_id": "9050a5fa-f4f5-3a5e-93fb-985abeba2132",
                        "entry_id": "2ecd5fa1-62b5-32df-8c51-fe17152195ff",
                        "glosses": [
                            "Strand, an dem man baden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b610fb90-790f-4925-835f-262be3f78704",
                                "sense_id": "9050a5fa-f4f5-3a5e-93fb-985abeba2132",
                                "text": "Im Urlaub habe ich die meiste Zeit am Badestrand verbracht."
                            },
                            {
                                "example_id": "e1250036-76d8-40ba-a0c7-b1c9e7ebdd35",
                                "sense_id": "9050a5fa-f4f5-3a5e-93fb-985abeba2132",
                                "text": "„Sie setzten sich in eine schattige Ecke der Terrasse, mit Blick auf den Badestrand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e951bf7c-faf6-4add-92b0-9541fc740c57",
                        "source_entry_id": "2ecd5fa1-62b5-32df-8c51-fe17152195ff",
                        "source_sense_id": "9050a5fa-f4f5-3a5e-93fb-985abeba2132",
                        "source_sense_description": "Strand, an dem man baden kann",
                        "target_lang_word": "bathing beach",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "117e5bef-6eb6-4ae4-9810-2f08cf7b81bb",
                        "source_entry_id": "2ecd5fa1-62b5-32df-8c51-fe17152195ff",
                        "source_sense_id": "9050a5fa-f4f5-3a5e-93fb-985abeba2132",
                        "source_sense_description": "Strand, an dem man baden kann",
                        "target_lang_word": "plage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e475c380-175b-3ed1-a253-5791b4d4daf2",
                                        "entry_id": "e4dbb024-7a51-3722-b4bd-7aa09250755c",
                                        "glosses": [
                                            "Étendue de sable ou de galets bordant un plan d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e785a9f-168f-4737-bad3-1a2efe51d7ad",
                                                "sense_id": "e475c380-175b-3ed1-a253-5791b4d4daf2",
                                                "text": "Sur une plage de sable noir volcanique, des brisants déferlaient avec bruit."
                                            },
                                            {
                                                "example_id": "588d3b41-0cf9-41ca-bbca-8ddc55c1d848",
                                                "sense_id": "e475c380-175b-3ed1-a253-5791b4d4daf2",
                                                "text": "À partir du mois de juin, la plage, aujourd’hui disparue, se couvrait de tentes pour la saison des bains de mer."
                                            },
                                            {
                                                "example_id": "a3e5db9d-c8da-4d56-9b52-24426d5b564c",
                                                "sense_id": "e475c380-175b-3ed1-a253-5791b4d4daf2",
                                                "text": "La plage microtidale d’Agay, située sur la commune de Saint-Raphaël (83), présente une forme en arc de cercle sur un kilomètre."
                                            },
                                            {
                                                "example_id": "a83bace2-2c3a-44a5-9b66-7fc04eefcb3c",
                                                "sense_id": "e475c380-175b-3ed1-a253-5791b4d4daf2",
                                                "text": "La littérature scientifique sur la sécurité des plages (« beach safety » en anglais) attribue souvent ces accidents à une méconnaissance par les baigneurs des risques qu’ils courent, lesquels seraient, a priori, sous-estimés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d34e5c-6892-3ee1-8d23-9e28e39faae2",
                                        "entry_id": "e4dbb024-7a51-3722-b4bd-7aa09250755c",
                                        "glosses": [
                                            "Chacun des morceaux enregistrés sur un disque vinyle ou un CD."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eee656a-f1b6-4c6e-9994-dd71eb2e9f48",
                                                "sense_id": "b8d34e5c-6892-3ee1-8d23-9e28e39faae2",
                                                "text": "Les plages des disques étaient séparée par des intervalles silencieux et se repéraient par un aspect plus sombre."
                                            },
                                            {
                                                "example_id": "2e9b5da0-5fc7-42be-aac5-5cdf4e4aec08",
                                                "sense_id": "b8d34e5c-6892-3ee1-8d23-9e28e39faae2",
                                                "text": "Il enregistrera avec Dizzy Gillespie, Max Roach, Fats Navarro ou Milt Jackson des plages qui attestent de son désir de moderniser son phrasé, d’ouvrir ses horizons et d’apprendre de cette nouvelle génération ce que l’ancienne ne peut plus lui apporter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b5ddb1-2aec-3e46-9a29-3730e245ef89",
                                        "entry_id": "e4dbb024-7a51-3722-b4bd-7aa09250755c",
                                        "glosses": [
                                            "Partie plane située à l’arrière d’une voiture et couvrant la malle arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90869059-877a-47b1-8dda-060a5b6e7e1c",
                                                "sense_id": "39b5ddb1-2aec-3e46-9a29-3730e245ef89",
                                                "text": "Plage arrière de voiture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6528c8d4-9662-3167-856e-18822c3fc497",
                                        "entry_id": "e4dbb024-7a51-3722-b4bd-7aa09250755c",
                                        "glosses": [
                                            "Zone sur un circuit dédiée aux contacts et aux autres types d’interconnexion électrique (brasure, câblage filaire, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2366378a-b5a9-4337-b601-1a817588818d",
                                                "sense_id": "6528c8d4-9662-3167-856e-18822c3fc497",
                                                "text": "Un motif de plage d’accueil de composant monté en surface sur le circuit imprimé doit être soigneusement étudié, afin d’éviter d’importants problèmes lors de l’opération de soudage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1917adb3-28c0-3853-9f38-a9c48d8c22d1",
                                        "entry_id": "e4dbb024-7a51-3722-b4bd-7aa09250755c",
                                        "glosses": [
                                            "Partie d’un tout constituant un sous-ensemble cohérent et contigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdb7e904-1841-4ae6-943b-3df37db2901e",
                                                "sense_id": "1917adb3-28c0-3853-9f38-a9c48d8c22d1",
                                                "text": "Une plage de valeurs."
                                            },
                                            {
                                                "example_id": "b138fce7-51c4-4830-bd62-5e70034aae44",
                                                "sense_id": "1917adb3-28c0-3853-9f38-a9c48d8c22d1",
                                                "text": "Il est souvent présent pendant cette plage horaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b161b2-f989-3541-906f-026cf6840680",
                                        "entry_id": "e4dbb024-7a51-3722-b4bd-7aa09250755c",
                                        "glosses": [
                                            "Groupe d’adresses IP consécutives."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dc714e8-1260-4bce-9d44-c00316ca1b22",
                                                "sense_id": "72b161b2-f989-3541-906f-026cf6840680",
                                                "text": "La première, 10.0.0.0/8 (voir encadré page 130), est une plage de classe A (contenant 2²⁴ adresses IP)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552ac798-419c-384a-aaf5-9cc880a214e9",
                                        "entry_id": "e4dbb024-7a51-3722-b4bd-7aa09250755c",
                                        "glosses": [
                                            "Dans un tableur, objet correspondant à un ensemble de cellules, formant une zone rectangulaire d’une feuille de calcul."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "note": "Il existe aussi des plages 3D ayant une extension sur plusieurs feuilles de calcul d’un même classeur",
                                        "examples": [
                                            {
                                                "example_id": "e20ec65a-48e0-4a7e-8214-7449d876271c",
                                                "sense_id": "552ac798-419c-384a-aaf5-9cc880a214e9",
                                                "text": "Simplifiez vos formules avec des plages nommées pour améliorer la lisibilité."
                                            }
                                        ]
                                    }
                                ]
                            },
