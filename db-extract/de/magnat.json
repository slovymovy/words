                        ],
                        "form": "den Magnaten"
                    },
                    {
                        "form_id": "8f5d68fa-cbe2-4afb-b848-dde3cdd2c181",
                        "entry_id": "3dfc38ec-1c34-3313-b23a-95c0a4c7164a",
