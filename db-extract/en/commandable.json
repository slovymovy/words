                                                "example_id": "9059aa08-7e0b-47d5-8ebc-4bb1dea9c7d5",
                                                "sense_id": "bcc671ee-0915-35ef-91de-d8bf9e101ec2",
                                                "text": "[Jusqu'au 31 août 2020] le dvd « Un livre, un pouce, un film » est commandable pour seulement 4 euros !!!"
                                            },
                                            {
                                                "example_id": "ada4e94b-b6c5-4219-af84-4337eddd8b51",
                                                "sense_id": "bcc671ee-0915-35ef-91de-d8bf9e101ec2",
                                                "text": "Deux modes automatiques sont disponibles (Normal ou Sport), plus un mode manuel commandable depuis le levier ou les petites palettes en aluminium solidaires du volant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b49fe4d-3083-3e68-8a4f-89834c7f58f6",
                                        "entry_id": "d66a90a8-86cd-3dda-af50-b3c053c507f3",
                                        "glosses": [
                                            "Se dit d’un système qui est tel qu’il existe toujours une manière de l’amener d’un état à un autre en un temps fini."
                                        ],
