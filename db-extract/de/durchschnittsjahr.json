                    {
                        "sense_id": "29fe4da0-7fd2-3466-aec0-621e688e374d",
                        "entry_id": "efe88258-99c6-3b69-b5a6-db448051048e",
                        "glosses": [
                            "Jahr, in dem durchschnittliche Werte erreicht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d050b95-8f4a-4834-9919-9302cc78cd76",
                                "sense_id": "29fe4da0-7fd2-3466-aec0-621e688e374d",
                                "text": "„Der ‚Falter‘ berichtet bezüglich der Coin-Studie über Berechnungen für die Stadt Wien, wonach rund um die Jahrhundertmitte im Durchschnittsjahr geschätzt 300 Wiener aufgrund der Hitze sterben werden.“"
                            },
                            {
                                "example_id": "2b63c53b-8918-4b88-b10b-55fe06a9c2e6",
                                "sense_id": "29fe4da0-7fd2-3466-aec0-621e688e374d",
                                "text": "„In einem Durchschnittsjahr vor Einführung des Freizügigkeitsabkommens waren es schweizweit knapp 4000 gewesen.“"
                            },
                            {
                                "example_id": "3a3001ab-99a2-4888-8627-c875e6e681ae",
                                "sense_id": "29fe4da0-7fd2-3466-aec0-621e688e374d",
                                "text": "„Laut ADAC war 2017 in NRW ein Durchschnittsjahr ohne große Kälte- oder Hitzewellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
