                    {
                        "sense_id": "83ea4a5a-f2cf-3c6e-8f9c-1670bbc4488b",
                        "entry_id": "30448f7c-41f0-340a-a0d5-e6390c65d03e",
                        "glosses": [
                            "synthetisch hergestellte Substanz aus der Stoffgruppe der Phenylethylamine"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4b744926-9632-4ff3-8d6f-c24635110206",
                                "sense_id": "83ea4a5a-f2cf-3c6e-8f9c-1670bbc4488b",
                                "text": "„Die Polizei behauptet, dass 70 Prozent Ihres Einkommens aus dem Verkauf von Speed stammt.“"
                            },
                            {
                                "example_id": "841ca0ce-7b71-4c7a-b768-89b81be43619",
                                "sense_id": "83ea4a5a-f2cf-3c6e-8f9c-1670bbc4488b",
                                "text": "„Victor sprang wie ein Boxer auf Speed von einem Bein aufs andere.“"
                            },
                            {
                                "example_id": "256406fb-169c-49b8-a99f-99d55405cdaf",
                                "sense_id": "83ea4a5a-f2cf-3c6e-8f9c-1670bbc4488b",
                                "text": "„Sie war erhitzt von dem Speed, das sie und Willard vorhin eingeworfen hatten, und ein dünner Schweißfilm bedeckte ihre Oberlippe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d2724b2-aa67-47fa-b531-64e1776475e0",
                        "source_entry_id": "30448f7c-41f0-340a-a0d5-e6390c65d03e",
