                "senses": [
                    {
                        "sense_id": "4cabbbb9-53d8-32b8-8202-143b1c2c7056",
                        "entry_id": "1062f19e-653b-3802-af55-d3c35508a563",
                        "glosses": [
                            "Euphorbia pulcherrima een plant uit de wolfsmelkfamilie (Euphorbiaceae). De soort komt van oorsprong voor in Mexico maar wordt veel gekweekt om de sierwaarde. Hij wordt in de gematigde streken, waaronder de Benelux, voornamelijk gekocht voor de kerstmis"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "492bd124-8580-39f2-9ee9-959bdeeed7ca",
                        "entry_id": "1062f19e-653b-3802-af55-d3c35508a563",
                        "glosses": [
                            "een versiering of decoratie in de vorm van een ster, zoals die rond de Kerstdagen opgehangen of neergezet wordt"
                        ],
                        "tags": [
                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "5058e209-f106-4d88-98db-be4efe279749",
                                "sense_id": "492bd124-8580-39f2-9ee9-959bdeeed7ca",
                                "text": "Een typische Surinaamse kunstuiting is vooral de kerstster, die rond het Kerstfeest 'n sieraad in onze huizen is en het bewijs levert van vruchtbare vrijetijdsbesteding en kunstzinnige handenarbeid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22c79521-131f-4b26-a2d1-e2b47cb9f1be",
                        "source_entry_id": "1062f19e-653b-3802-af55-d3c35508a563",
                        "target_lang_word": "Weihnachtsstern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weihnachtsstern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8896682-9ba8-32c5-9090-40290d1fc59f",
                                        "entry_id": "0eb5b75a-824e-31de-a973-2b409fad9b68",
                                        "glosses": [
                                            "ein weihnachtliches Symbol; für den Stern von Bethlehem"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e44689c-f635-487a-95f4-40720c822a46",
                                                "sense_id": "c8896682-9ba8-32c5-9090-40290d1fc59f",
                                                "text": "An der Krippe ist oben der Weihnachtsstern angebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "187ffcad-a691-3c53-b588-a685db4ab440",
                                        "entry_id": "0eb5b75a-824e-31de-a973-2b409fad9b68",
                                        "glosses": [
                                            "Pflanze der Gattung Wolfsmilch mit auffälligen, intensiv gefärbten Hochblättern, die sternförmig angeordnet sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e82bfff-0fb7-4106-b57c-80de7ba431fa",
                                                "sense_id": "187ffcad-a691-3c53-b588-a685db4ab440",
                                                "text": "Weihnachtssterne mag ich am liebsten im klassischen Rot."
                                            },
                                            {
                                                "example_id": "1abe314e-df3b-4ff1-9ffe-8996dc4a0404",
                                                "sense_id": "187ffcad-a691-3c53-b588-a685db4ab440",
                                                "text": "„Sie ließ den Laden in Julies Händen, eilte im schon dämmrigen Nachmittagslicht zum Jardin du Luxembourg und kaufte bei Louisa einen hübschen Weihnachtsstern, dann nahm sie wegen der Kälte ein Taxi zum Père Lachaise, obwohl sie sonst mit der Metro fuhr, um Geld zu sparen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ba7bdbe6-a386-30dd-aee1-9eb2492c88b8",
                                        "entry_id": "0eb5b75a-824e-31de-a973-2b409fad9b68",
                                        "glosses": [
                                            "gebastelte Sterne, zum Beispiel aus Stroh, buntem Papier oder Goldfolie, die zur Weihnachtsdekoration benutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200d4a0e-b8f8-48cc-a246-d97f3106690a",
                                                "sense_id": "ba7bdbe6-a386-30dd-aee1-9eb2492c88b8",
                                                "text": "Die Kleinen haben heute im Kindergarten Weihnachtssterne gebastelt."
                                            },
                                            {
                                                "example_id": "5303203e-558f-40c5-850a-b7daff800268",
                                                "sense_id": "ba7bdbe6-a386-30dd-aee1-9eb2492c88b8",
                                                "text": "„Später traf ich auf Daníel, der in seinem zerlöcherten Unterhemd in der Küche saß und unter dem Weihnachtsstern rauchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dc44363-ad49-49fa-9f27-32467145de69",
