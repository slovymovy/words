                ],
                "senses": [
                    {
                        "sense_id": "53100af9-c766-34e1-9f85-534f2dc50da2",
                        "entry_id": "df320493-d435-3453-b56f-41f1158e6e61",
                        "glosses": [
                            "Not wholesome; unfavorable to health; unhealthful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89017f04-28ee-4056-8727-e4fd8d819756",
                                "sense_id": "53100af9-c766-34e1-9f85-534f2dc50da2",
                                "text": "unwholesome air, or food"
                            },
                            {
                                "example_id": "e1ee448f-5cf8-4857-b159-caba8d35e4b9",
                                "sense_id": "53100af9-c766-34e1-9f85-534f2dc50da2",
                                "text": "Caliban: As wicked dewe, as ere my mother bruſh'd / With Rauens feather from vnwholeſome Fen / Drop on you both : A Southweſt blow on yee, / And bliſter you all ore."
                            },
                            {
                                "example_id": "ee2fb2da-d4c3-4d2a-becf-d93db12ad639",
                                "sense_id": "53100af9-c766-34e1-9f85-534f2dc50da2",
                                "text": "Alas! he mastered not his destiny: I have said before, his ashes are in yonder urn. A few unwholesome dews on a summer night were mightier than all his science."
                            }
                        ]
                    },
                    {
                        "sense_id": "d48550be-46f0-3463-955a-429642ed50ba",
                        "entry_id": "df320493-d435-3453-b56f-41f1158e6e61",
                        "glosses": [
                            "Not sound; tainted; defective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a0e58ad-3470-43a3-aa81-0de4bd58af60",
                                "sense_id": "d48550be-46f0-3463-955a-429642ed50ba",
                                "text": "There was something indefinably unwholesome about him. Something lean and snakelike."
                            }
                        ]
                    },
                    {
                        "sense_id": "e792cf71-6e5f-30de-8cbb-5ba9c0c96575",
                        "entry_id": "df320493-d435-3453-b56f-41f1158e6e61",
                        "glosses": [
                            "Indicating unsound health; characteristic of or suggesting an unsound condition, physical or mental; repulsive; offensive."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "608f6115-0ca9-4459-ad73-8a04401371f2",
                        "source_entry_id": "df320493-d435-3453-b56f-41f1158e6e61",
                        "source_sense_description": "not wholesome",
                        "target_lang_word": "malsain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malsain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c426f33b-3f5d-3d70-beac-db09489b8d9f",
                                        "entry_id": "29583a33-5f11-378f-bb45-087fedfdc460",
                                        "glosses": [
                                            "Qui n’est pas sain, qui a en soi le germe de quelque maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a1d666-3ae4-4f5e-8fcd-5192621a33c5",
                                                "sense_id": "c426f33b-3f5d-3d70-beac-db09489b8d9f",
                                                "text": "Il a l’apparence malsaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d045d7fb-1aea-34bc-8f7e-49de8aaf4396",
                                        "entry_id": "29583a33-5f11-378f-bb45-087fedfdc460",
                                        "glosses": [
                                            "Qui est tourné vers les choses mauvaises, déraisonnables ; qui se complaît dans les mauvaises mœurs."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5abcc970-d290-4296-81ed-dcfb0e188f76",
                                                "sense_id": "d045d7fb-1aea-34bc-8f7e-49de8aaf4396",
                                                "text": "J'avais beau me faire honte : plus que la honte, un goût malsain me retenait parmi ces êtres dont j'écoutais de loin les appels, les gémissements. […] ils me parvenaient sans ensemble mais souvent si fervents qu'ils réveillaient en moi d'inavouables appétits."
                                            },
                                            {
                                                "example_id": "64106486-4f9f-4a48-9d9c-bb7b8deb57eb",
                                                "sense_id": "d045d7fb-1aea-34bc-8f7e-49de8aaf4396",
                                                "text": "À quoi servent les faits divers ? […]. En règle générale, à faire du très mauvais journalisme, caressant le lecteur dans ses pulsions malsaines quitte à pulvériser les lignes jaunes du métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62300f15-0c99-3229-84b6-ff65004bfba5",
                                        "entry_id": "29583a33-5f11-378f-bb45-087fedfdc460",
                                        "glosses": [
                                            "Nuisible à la santé physique ou morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b9b2701-07ef-4318-a2ef-2337a2a209f7",
                                                "sense_id": "62300f15-0c99-3229-84b6-ff65004bfba5",
                                                "text": "Or, nous devons tout essayer pour maintenir peuplés ces plateaux de sol ingrat et non chercher à éloigner la population, l'obligeant à vivre dans des usines malsaines."
                                            },
                                            {
                                                "example_id": "5469e990-6f6c-46dd-8240-f0a66f0c5abb",
                                                "sense_id": "62300f15-0c99-3229-84b6-ff65004bfba5",
                                                "text": "Les eaux de ce pays-là sont malsaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e23e141e-a15e-3fc4-a816-e373e033175f",
                                        "entry_id": "29583a33-5f11-378f-bb45-087fedfdc460",
                                        "glosses": [
                                            "Qui est caractérisé par sa négativité morbide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517de9aa-e5f4-4604-a46f-eacc320a9756",
                                                "sense_id": "e23e141e-a15e-3fc4-a816-e373e033175f",
                                                "text": "Un climat malsain règne dans la chambre des communes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dcb5e6e-65ae-46d6-ac6d-473b9499ff83",
                        "source_entry_id": "df320493-d435-3453-b56f-41f1158e6e61",
                        "source_sense_description": "not wholesome",
                        "target_lang_word": "nocif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nocif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0227647-1313-3b8e-8b4b-22cb8940f719",
                                        "entry_id": "4bbafae6-104d-3cf9-8bf5-9e472b77aa41",
                                        "glosses": [
                                            "Qui est nuisible, qui a des effets malfaisants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd67c70-a1a0-4d14-a2d7-b3c15b702fa8",
                                                "sense_id": "d0227647-1313-3b8e-8b4b-22cb8940f719",
                                                "text": "Cependant, réalisée dans de mauvaises conditions, la combustion du bois émet des polluants néfastes pour la santé, tels que furanes, benzènes, dioxines, composés organiques volatils (COV)… ainsi que des particules fines nocives."
                                            },
                                            {
                                                "example_id": "5e8f9ded-76f4-4bab-8f82-390ff9e92d4f",
                                                "sense_id": "d0227647-1313-3b8e-8b4b-22cb8940f719",
                                                "text": "Cet outil de protection, malgré une consommation d’énergie non négligeable (5,5 milliards de KWh annuel), demeure bien moins nocif et chronophage que la suppression manuelle du spam."
                                            },
                                            {
                                                "example_id": "cd4d83a6-8115-40a6-829f-6cda0a4ed373",
                                                "sense_id": "d0227647-1313-3b8e-8b4b-22cb8940f719",
                                                "text": "Ce dernier avait noté un \"lien frappant\" entre les hospitalisations en urgence d’Ella et les pics enregistrés de dioxyde d'azote (NO2) et de particules en suspension, les polluants les plus nocifs, à proximité de son domicile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "285b3f10-714c-4a08-8735-1a2f243f95e4",
                        "source_entry_id": "df320493-d435-3453-b56f-41f1158e6e61",
                        "source_sense_description": "not wholesome",
                        "target_lang_word": "insalubre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insalubre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                        "entry_id": "b5aad689-b491-3a21-be18-019693a1f4ed",
                                        "glosses": [
                                            "Qualifie les lieux où la santé est en danger par suite de mauvaises conditions environnantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d55e180-5f86-4f56-a4ac-b31caf4580ee",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "Du devoir pour les municipalités d'assainir les quartiers insalubres des villes manufacturières."
                                            },
                                            {
                                                "example_id": "153888c6-ace7-428f-8b25-753d0f86e832",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "Pour peu que les baigneurs se plaignent et que l’on bouche les riveaux, les prairies de Nauzan et de Bernezac redeviendront des marais insalubres."
                                            },
                                            {
                                                "example_id": "3f565daa-52c9-439c-9f47-a67fa8bd3112",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "[…] les fenêtres des chambres peuvent à peine être entrouvertes et c’est ainsi que, faute d’aération, un tel établissement est insalubre pour une asthmatique invétérée comme Pep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31413781-0bec-49a2-a7a4-9333eeba23a8",
