                "senses": [
                    {
                        "sense_id": "1945f57c-0177-3867-9eca-1bfe568304fd",
                        "entry_id": "873d4a0a-2f3c-3233-9bfe-514d9e00baba",
                        "glosses": [
                            "Dokumente, Papiere, Beweise zur Anbahnung einer Geschäftsbeziehung"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "e5d7a24a-1ffc-4e6d-8e0e-fd2d3e6147bc",
                                "sense_id": "1945f57c-0177-3867-9eca-1bfe568304fd",
                                "text": "„Gut formulierte und optisch ansprechende Bewerbungsunterlagen können einen potentiellen Arbeitgeber davon überzeugen, dass Sie in den engsten Kreis der geeigneten Bewerber für seine freie Stelle gehören.“"
                            },
                            {
                                "example_id": "7b847065-161e-497b-8197-426eebe38d5f",
                                "sense_id": "1945f57c-0177-3867-9eca-1bfe568304fd",
                                "text": "„Die Bewerbungsunterlagen sind der Türöffner zum Job – sofern sie überzeugend, fehlerfrei und vollständig sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
