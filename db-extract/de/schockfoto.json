                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e90ab029-1901-4523-bd43-d5b41f72ed2d",
                                "sense_id": "d0d38816-47af-3b69-8389-544ed59afb59",
                                "text": "„Mit Schockfotos auf Zigarettenpackungen wird Großbritannien als erstes Land in Europa Raucher vor den Gefahren des blauen Dunstes warnen.“"
                            },
                            {
                                "example_id": "5fd8dada-d747-4058-8d9a-a528959ef436",
                                "sense_id": "d0d38816-47af-3b69-8389-544ed59afb59",
                                "text": "„Und die Stadt Wien überall Verbotsschilder aufgestellt hat (\"Wer Tauben füttert, füttert Ratten\"), auf denen sogar ein Schockfoto drauf ist von einer mutierten Taube, die durch nicht artgerechtes Futter bereits einen Rattenkopf ausgebildet hat.“"
                            }
                        ],
