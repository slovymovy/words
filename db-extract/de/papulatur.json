                ],
                "senses": [
                    {
                        "sense_id": "7b273169-adde-3202-addc-4ec410d4c824",
                        "entry_id": "ed31306e-a407-3508-8c76-7901c88163cc",
                        "glosses": [
                            "Körperöffnung in der unteren Hälfte des Gesichts, die zur Nahrungsaufnahme und (vor allem zur) Lauterzeugung fähig ist (Mund)"
                        ],
                        "tags": [
                            "derogatory",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "d8475d91-9fb6-451d-b843-3e5f45242569",
                                "sense_id": "7b273169-adde-3202-addc-4ec410d4c824",
                                "text": "„Schnell lernte ich, dass gute Noten und eine gute Papulatur ein Ausweg aus dem Dilemma waren.“"
                            },
                            {
                                "example_id": "36972dae-2509-4d57-be91-b8bb4570ff57",
                                "sense_id": "7b273169-adde-3202-addc-4ec410d4c824",
                                "text": "„Während man allerdings nach dem Genuss beispielsweise eines wohlbestreuten Schnittlauchbutterbrotes Konversationen für ein Weilchen mit dezent abgewandtem Kopf und kontrollierter Atmung führen sollte, um sein Gegenüber nicht in die Ohnmacht zu treiben, stinkt man nach Allium-tuberosum-Orgien so gut wie nicht aus der Papulatur.“"
                            },
                            {
                                "example_id": "3c6da5a9-3470-469b-a403-35527655e27b",
                                "sense_id": "7b273169-adde-3202-addc-4ec410d4c824",
                                "text": "„Redet erstens ununterbrochen Stumpfsinn und bringt zweitens dabei seine offenbar von Geburt an mit unzureichenden Scharnieren ausgestattete Papulatur nicht auf.“"
                            },
                            {
                                "example_id": "492e36b2-5bee-4763-8dec-c51b08e69a28",
                                "sense_id": "7b273169-adde-3202-addc-4ec410d4c824",
                                "text": "„Die Trompeter bliesen, daß ihnen schier die Papulatur barst, der Nebel zerriß vor dem Ungestüm.“"
                            },
                            {
                                "example_id": "9bf2ad8e-fbc0-425d-a603-3cc7f76bc3b9",
                                "sense_id": "7b273169-adde-3202-addc-4ec410d4c824",
                                "text": "„Das Schloss ruft meinen anderen Rad-Kollegen in Erinnerung, dass seine adeligen Vorfahren in dieser Gegend vor 400 Jahren etwa 12 Mühlen besessen hätten. Vom Adel ist bis auf die Papulatur nichts geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
