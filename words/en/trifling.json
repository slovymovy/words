{
    "word_family": [
        "trifle",
        "trifler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bcaa1063-568f-3e11-acd1-e7f5dc5438ee",
                    "sense_definition": "Having little value or importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unimportant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent hours arguing over a <w>trifling</w> detail in the contract.",
                            "target_lang_translations": {
                                "tr": "Sözleşmedeki <w>önemsiz</w> bir ayrıntı yüzünden saatlerce tartıştılar."
                            }
                        },
                        {
                            "text": "He sold his old collection for a <w>trifling</w> sum of money.",
                            "target_lang_translations": {
                                "tr": "Eski koleksiyonunu <w>cüzi</w> bir miktar paraya sattı."
                            }
                        }
                    ],
                    "synonyms": [
                        "trivial",
                        "insignificant",
                        "paltry",
                        "minor"
                    ],
                    "common_phrases": [
                        "trifling sum"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok az değeri veya önemi olan; kayda değmez."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "önemsiz",
                                "target_lang_sense_clarification": "değer veya etki bakımından az"
                            },
                            {
                                "target_lang_word": "ufak tefek",
                                "target_lang_sense_clarification": "küçük, değersiz detaylar veya miktarlar için"
                            },
                            {
                                "target_lang_word": "cüzi",
                                "target_lang_sense_clarification": "para veya miktar için çok az olan"
                            },
                            {
                                "target_lang_word": "ıvır zıvır",
                                "target_lang_sense_clarification": "kayda değer olmayan şeyler için sıfat olarak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "696aabf2-372d-3d0c-8e78-a37edae668fb",
                    "sense_definition": "Lacking seriousness or purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unimportant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was tired of his <w>trifling</w> attitude toward important deadlines.",
                            "target_lang_translations": {
                                "tr": "Müdür, onun önemli teslim tarihlerine karşı sergilediği <w>gayriciddi</w> tutumdan bıkmıştı."
                            }
                        },
                        {
                            "text": "She found his constant jokes and <w>trifling</w> behavior quite annoying during the meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantı boyunca adamın sürekli yaptığı şakaları ve <w>havai</w> davranışlarını oldukça sinir bozucu buldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "frivolous",
                        "idle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ciddiyetten veya amaçtan yoksun; havai, gayriciddi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gayriciddi",
                                "target_lang_sense_clarification": "tutum veya davranış bakımından"
                            },
                            {
                                "target_lang_word": "havai",
                                "target_lang_sense_clarification": "ciddi olmayan, boş"
                            },
                            {
                                "target_lang_word": "laubali",
                                "target_lang_sense_clarification": "saygısız veya ciddiyetsiz davranışlar için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7723ae3f-219b-3772-a4bf-db9162a951e7",
                    "sense_definition": "Lazy, unreliable, or of poor character.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unimportant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>trifling</w> person who never keeps his promises to his friends.",
                            "target_lang_translations": {
                                "tr": "O, arkadaşlarına verdiği sözleri asla tutmayan <w>işe yaramaz</w> biridir."
                            }
                        },
                        {
                            "text": "She finally decided to leave her <w>trifling</w> boyfriend after years of disappointment.",
                            "target_lang_translations": {
                                "tr": "Yıllar süren hayal kırıklığının ardından nihayet <w>beş para etmez</w> erkek arkadaşından ayrılmaya karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "worthless",
                        "lazy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in African American Vernacular English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tembel, güvenilmez veya karaktersiz (argo/halk ağzı)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "işe yaramaz",
                                "target_lang_sense_clarification": "tembel veya güvenilmez kişi"
                            },
                            {
                                "target_lang_word": "beş para etmez",
                                "target_lang_sense_clarification": "karaktersiz veya güvenilmez kimse"
                            },
                            {
                                "target_lang_word": "güvenilmez",
                                "target_lang_sense_clarification": "sözünde durmayan kişi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec09dc5a-1b05-35c1-ba59-b2f2d82b6045",
                    "sense_definition": "The act of behaving in a frivolous or unimportant manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unimportant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor dismissed the student's constant <w>triflings</w> as a waste of academic time.",
                            "target_lang_translations": {
                                "tr": "Profesör, öğrencinin sürekli yaptığı <w>ciddiyetsizlikleri</w> akademik zaman kaybı olarak görüp dikkate almadı."
                            }
                        },
                        {
                            "text": "He grew tired of the endless <w>triflings</w> that distracted everyone from the main goal.",
                            "target_lang_translations": {
                                "tr": "Herkesin dikkatini asıl hedeften uzaklaştıran bu bitmek bilmeyen <w>boş işlerden</w> usanmıştı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ciddiyetsiz, boş veya önemsiz şeylerle vakit geçirme eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boş işler",
                                "target_lang_sense_clarification": "zaman kaybı sayılan anlamsız uğraşlar"
                            },
                            {
                                "target_lang_word": "ıvır zıvır",
                                "target_lang_sense_clarification": "önemsiz, lüzumsuz şeyler veya davranışlar"
                            },
                            {
                                "target_lang_word": "ciddiyetsizlik",
                                "target_lang_sense_clarification": "havai davranış veya tutum"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}