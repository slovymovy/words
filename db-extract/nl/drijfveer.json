                "senses": [
                    {
                        "sense_id": "d4bd2b48-4015-352e-82c1-c67c6b67b15c",
                        "entry_id": "2998cf0c-ffa4-38fc-bc29-7deb5beb2d4e",
                        "glosses": [
                            "een veer die onder spanning gezet de energie levert voor de beweging van een mechaniek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acbdda6e-5af0-4acd-9c22-a59866f3b27c",
                                "sense_id": "d4bd2b48-4015-352e-82c1-c67c6b67b15c",
                                "text": "In een automatisch horloge wordt de drijfveer opgewonden door de beweging van de drager."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba4046c4-140c-34e7-b95f-adbf513f78c3",
                        "entry_id": "2998cf0c-ffa4-38fc-bc29-7deb5beb2d4e",
                        "glosses": [
                            "overdrachtelijk dat wat iemand beweegt, de achterliggende redenen van iemands handelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db52e95-2c90-424e-90aa-e7b44b37ce34",
                                "sense_id": "ba4046c4-140c-34e7-b95f-adbf513f78c3",
                                "text": "De drijfveren voor zijn gedrag zijn mij niet helemaal duidelijk."
                            },
                            {
                                "example_id": "556bfce4-4eee-465b-a7be-1dcf30442154",
                                "sense_id": "ba4046c4-140c-34e7-b95f-adbf513f78c3",
                                "text": "Iets minder dan een kwart van de volwassen Nederlanders rookt. Eenderde van hen ondernam in 2016 een serieuze stoppoging, zo blijkt uit cijfers van het CBS, het RIVM en het Trimbos Instituut. Meestal waren zorgen om de eigen gezondheid of die van kinderen de drijfveer om te stoppen."
                            }
                        ]
                    }
