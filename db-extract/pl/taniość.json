                                            {
                                                "example_id": "94c7f99c-f89d-42b4-9db7-20315b0d7572",
                                                "sense_id": "8a412a5e-57ab-3209-ba0f-0066138b9f5d",
                                                "text": "你不能這麼便宜了他。"
                                            },
                                            {
                                                "example_id": "81876d2e-2f16-4780-b441-26fe2f80e151",
                                                "sense_id": "8a412a5e-57ab-3209-ba0f-0066138b9f5d",
                                                "text": "你不能这么便宜了他。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "便宜",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ff04af-18ba-3c15-b6e6-2672775e5ee2",
                                        "entry_id": "f95c84f6-9996-3879-b525-3d108d03f225",
                                        "glosses": [
                                            "有利益/好處的（通常用於不公平的獲得）"
