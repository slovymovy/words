                    {
                        "translation_id": "4a49680c-bb92-4040-9178-d49608ca655b",
                        "source_entry_id": "6551dc15-19c6-32ea-87f2-d01202cd0420",
                        "source_sense_id": "b4316239-683a-3717-ba13-80b147d39a1d",
                        "source_sense_description": "een oppascentrum voor kinderen",
                        "target_lang_word": "crèche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crèche",
