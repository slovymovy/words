                        "glosses": [
                            "Dirty with faeces or other impurities"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f9662f4-d35e-430d-b26d-fe1af8c40d02",
                                "sense_id": "cde72cea-4cbd-3817-88e2-3797c2d97a58",
                                "text": "At this time in history the streets of London were as foul, feculent and disease-ridden as a series of interconnected dunghills, twice as dangerous as a battlefield, and as infrequently maintained as the lower cells of an asylum dungeon."
                            }
                        ]
                    }
