                                "target_senses": [
                                    {
                                        "sense_id": "ae3a542a-435e-3a64-bbc7-3be8ff9c3ec8",
                                        "entry_id": "11cbc1c8-964d-381d-91a3-953d21ca4a8a",
                                        "glosses": [
                                            "techniek waarmee een afbeelding in een plat vlak diepte of verschillende beelden lijkt weer te geven als je er onder uiteenlopende hoeken naar kijkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b61e79-cb63-4487-8860-971ae0a3ba1f",
                                                "sense_id": "ae3a542a-435e-3a64-bbc7-3be8ff9c3ec8",
                                                "text": "Het projecteren van 3D-voorwerpen op schermen of het maken van een 3D-visualisatie in de lucht kan al op verschillende manieren. Bij bijvoorbeeld klassieke holografie wordt het verstrooide laserlicht van een voorwerp op een fotografische plaat geprojecteerd, die achteraf met de laser zichtbaar wordt gemaakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "174efbe1-3c0a-3249-b304-d5b55e7f14c1",
                                        "entry_id": "11cbc1c8-964d-381d-91a3-953d21ca4a8a",
                                        "glosses": [
                                            "opname waarbij een beeld ook in de diepte is vastgelegd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4529a864-b1b7-478a-8c45-9f233f2c6256",
                                                "sense_id": "174efbe1-3c0a-3249-b304-d5b55e7f14c1",
                                                "text": "Holografieën wekken bij de juiste lichtinval de illusie van een driedimensionale ruimte. De grootste holografie heeft een afmeting van 2 vierkante meter en toont een schedel van een sauriër, een voorwereldse hagedis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
