                                ]
                            },
                            {
                                "target_word": "smug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b987c4aa-0e1b-398b-9cdd-b0402933a7d2",
                                        "entry_id": "868e4231-0314-3e9a-809a-59adc330a2e8",
                                        "glosses": [
                                            "The smuggling trade."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08af56a-0bf9-4899-8662-08d0353cf0d9",
                                                "sense_id": "b987c4aa-0e1b-398b-9cdd-b0402933a7d2",
                                                "text": "Have not they some term by which they distinguish the illicit trade? — They usually call it the Smug-pigeon."
                                            },
                                            {
                                                "example_id": "1c4a0062-10c6-482c-ab62-5f2ed11040ed",
                                                "sense_id": "b987c4aa-0e1b-398b-9cdd-b0402933a7d2",
                                                "text": "The smug-boats have been called centipedes by the Europeans, on account of the great number of oars, with which, like legs, they walk the water."
                                            }
                                        ]
                                    }
                                ]
