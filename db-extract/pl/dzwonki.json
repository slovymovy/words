                                "target_senses": [
                                    {
                                        "sense_id": "dc3edef8-a765-39f7-bd5a-55c1b58e074d",
                                        "entry_id": "d6cd06b2-9134-341e-809a-97544f997df6",
                                        "glosses": [
                                            "Schlaginstrument, das aus unterschiedlich großen Metallplatten aufgebaut ist und mit zwei Schlägeln gespielt wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eebdbc4-db9b-4b11-962c-269baa69e500",
                                                "sense_id": "dc3edef8-a765-39f7-bd5a-55c1b58e074d",
                                                "text": "Frank spielt ein Lied auf dem Glockenspiel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6702b7f-83ed-3bc6-974d-baba2383ec68",
                                        "entry_id": "d6cd06b2-9134-341e-809a-97544f997df6",
                                        "glosses": [
                                            "ein Ensemble aufeinander abgestimmter Glocken, die oft im öffentlichen Raum angebracht sind und in der Regel mechanisch zu festgelegten Zeitpunkten zum Klingen gebracht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c47bb45-69f4-4e68-8c65-b61a8aae554e",
                                                "sense_id": "f6702b7f-83ed-3bc6-974d-baba2383ec68",
                                                "text": "Das Glockenspiel am Münchener Neuen Rathaus erklingt dreimal täglich."
                                            },
                                            {
                                                "example_id": "87a0b7ad-8549-4266-8a03-b814f7eb3abe",
                                                "sense_id": "f6702b7f-83ed-3bc6-974d-baba2383ec68",
                                                "text": "„Während der Zug sich um das Rechteck bewegte, erklang vom Turm der nahen Kirche St. Marien ein Glockenspiel mit siebenhundertundzwanzig Variationen.“"
                                            },
                                            {
                                                "example_id": "a877c7ce-90d5-49c2-b76b-2e32420ee931",
                                                "sense_id": "f6702b7f-83ed-3bc6-974d-baba2383ec68",
                                                "text": "„Dem Glockenspiel vom Rathaus hörte sie lange zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "16d76e68-cda0-3f66-9935-58462112c8a9",
                                        "entry_id": "d6cd06b2-9134-341e-809a-97544f997df6",
                                        "glosses": [
                                            "Schlaginstrument mit 25 bis 27 waagerecht angeordneten Metallplatten, das in Marschkapellen verwendet wird und mit einem Schlägel gespielt wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
