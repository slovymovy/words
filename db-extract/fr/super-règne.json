                        "entry_id": "6f7501ad-de13-3db8-802a-76279f77ea2b",
                        "glosses": [
                            "Niveau de classification scientifique des êtres vivants se situant au-dessus des règnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7793202d-7691-4238-a3b1-12a6047e7b35",
                                "sense_id": "14c3d63a-1d84-3d98-ad9b-acec3310bcf9",
                                "text": "Les champignons appartiennent, avec les protistes (organismes unicellulaires), les végétaux et les animaux, au super-règne des Eucaryotes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
