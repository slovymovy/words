                "senses": [
                    {
                        "sense_id": "310a2d31-0749-355e-9c56-65c05fe0d793",
                        "entry_id": "08c5f135-e5a2-32aa-8164-ec342d4f2cc5",
                        "glosses": [
                            "Abfallstoff aus der Lederproduktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87c583d-cf4e-4ae0-a1b1-f939f2ed3e7f",
                                "sense_id": "310a2d31-0749-355e-9c56-65c05fe0d793",
                                "text": "„Ökologisches Leder wird hergestellt, indem Abfallleder, Reste und Abfallleder zerkleinert und dann eine bestimmte Menge Klebstoff hinzugefügt und dann mit Kunststofffolie verklebt werden.“"
                            },
                            {
                                "example_id": "c0689543-db97-4a31-b242-825f84dfc049",
                                "sense_id": "310a2d31-0749-355e-9c56-65c05fe0d793",
                                "text": "„Aufgrund dessen können Abfallleder zahlenmässig schlecht gefasst werden; es ist aber eine riesige Menge, wenn man sich vor Augen führt, dass allein in Deutschland im Jahr 2011 ca. 8 Mio m² (2006 ca. 14 Mio. m²) zugerichtetes Leder produziert wurden, wovon sich ein Grossteil wahrscheinlich längst auf Müllhalden befindet.“"
                            },
                            {
                                "example_id": "6918adeb-45f6-45be-8798-dc965757dcec",
                                "sense_id": "310a2d31-0749-355e-9c56-65c05fe0d793",
                                "text": "„Das Leder von den Flanken und Hufen ist hartes Abfallleder.“"
                            },
                            {
                                "example_id": "d4f7ccad-46ad-415d-a6d3-659b99434535",
                                "sense_id": "310a2d31-0749-355e-9c56-65c05fe0d793",
                                "text": "„Dieser nach dem Maßleisten gefertigte preiswerte Probeschuh (aus Abfallleder mit geklebtem Boden) wird von dem Kunden eine Zeit lang getragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
