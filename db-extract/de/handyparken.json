                "senses": [
                    {
                        "sense_id": "a2041791-1330-3708-a245-4d7ca58aa9de",
                        "entry_id": "cbd39cdf-21af-3f6d-9e1f-1e8ac04746f8",
                        "glosses": [
                            "Nutzung einer Parkfläche, deren Gebühr über das Handy bezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4404320d-f7fe-48fa-bd70-ff8205d50b1d",
                                "sense_id": "a2041791-1330-3708-a245-4d7ca58aa9de",
                                "text": "„Mit dem neuen Handyparken verprellt die Stadt Deidesheim nicht nur viele Wanderer, sondern schadet auch ihrem Image.“"
                            },
                            {
                                "example_id": "ceee5d1b-102f-471b-a0f0-cb0129ceb134",
                                "sense_id": "a2041791-1330-3708-a245-4d7ca58aa9de",
                                "text": "„Gelsenkirchen hat es diesen Monat als letzte der drei Städte in unserem Sendegebiet ermöglicht - das Handyparken.“"
                            },
                            {
                                "example_id": "6e07c026-0338-49eb-9465-c76f189275a4",
                                "sense_id": "a2041791-1330-3708-a245-4d7ca58aa9de",
                                "text": "„An den Parkscheinautomaten sei die jeweilige Parkzone des Handyparkens angelegt, man könne somit auch einen digitalen Parkschein lösen, wenn dieser in der App nicht erkennbar ist.“"
                            },
                            {
                                "example_id": "e4018fca-8185-43e1-9094-a507fed16121",
                                "sense_id": "a2041791-1330-3708-a245-4d7ca58aa9de",
                                "text": "„Der Verwaltungsausschuss Schwetzingen berät am Mittwoch, 5. November, über die Einführung des Handyparkens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
