                        "glosses": [
                            "Chefin eines bestimmten Aufgaben- oder Themengebietes (Ressorts)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cfffd32-e327-414b-9cb0-1323c6525951",
                                "sense_id": "8654f588-3e7f-311d-b12b-1798f76e4b4e",
                                "text": "„Die Vorsitzende der Justizministerkonferenz, Mecklenburg-Vorpommerns Ressortchefin Uta-Maria Kuder (CDU), hatte am Mittwoch einen Vorstoß für einen Führerscheinentzug ihres nordrhein-westfälischen Kollegen unterstützt.“"
                            },
                            {
                                "example_id": "4e4ed687-f202-4c1e-8e73-33e8669efaf2",
                                "sense_id": "8654f588-3e7f-311d-b12b-1798f76e4b4e",
                                "text": "„Die Opposition hat nun ihr Votum abgegeben – und der früheren Ressortchefin schwere Vorwürfe gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
