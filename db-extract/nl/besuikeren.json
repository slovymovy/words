                                        "entry_id": "b83d6cbb-d0c1-3bc3-a89e-32bfc595bcf8",
                                        "glosses": [
                                            "To supplement (a composition) with additional instruments, especially strings."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccc9abf4-6b67-4d6e-8150-3eed5ad967db",
                                                "sense_id": "a9c18622-1764-38cb-93a5-4bdc3d362149",
                                                "text": "In most popular music the bowed strings usually play long, sustained, sweeping parts, and are sometimes added to a vocal track later in a process known as sweetening."
                                            },
                                            {
                                                "example_id": "d604aefe-593d-4de6-8f31-9bbe63dec7e9",
                                                "sense_id": "a9c18622-1764-38cb-93a5-4bdc3d362149",
                                                "text": "Rather than employ strings to “sweeten” the songs, Motown's arrangements used strings as a timbral layer, in conjunction with syncopated horn lines, for a fuller sound; […]"
                                            }
                                        ]
