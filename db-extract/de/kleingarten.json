                "senses": [
                    {
                        "sense_id": "b57cf531-c420-3933-ba90-ec01c73f3220",
                        "entry_id": "48561a24-1baa-33de-89ee-12249e309a92",
                        "glosses": [
                            "vergleichsweise kleiner Garten, der nicht direkt bei der Wohnung/dem Haus liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "748fcbd0-189b-44f3-a471-7bd13c1c2e5b",
                                "sense_id": "b57cf531-c420-3933-ba90-ec01c73f3220",
                                "text": "„Einem Hobbygärtner waren zwei Dinge aufgefallen, die sich in seinem Kleingarten verändert hatten.“"
                            },
                            {
                                "example_id": "be97b0ab-2940-460f-b7f8-9c991afec151",
                                "sense_id": "b57cf531-c420-3933-ba90-ec01c73f3220",
                                "text": "„Im Februar 1916 kam eine Zentralstelle für den Gemüseanbau in Kleingärten hinzu - ein weiteres Feld, das dringend der Regelung bedurfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "add1df7c-765e-4f0c-bf91-21df5c9d42cd",
                        "source_entry_id": "48561a24-1baa-33de-89ee-12249e309a92",
                        "source_sense_id": "b57cf531-c420-3933-ba90-ec01c73f3220",
                        "source_sense_description": "vergleichsweise kleiner Garten, der nicht direkt bei der Wohnung/dem Haus liegt",
                        "target_lang_word": "jardin ouvrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jardin ouvrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca336e9-4d1f-3061-b464-3f9df27340fa",
                                        "entry_id": "bedc9466-45da-31e1-b0d0-2d405ac88948",
                                        "glosses": [
                                            "Jardin mis à la disposition des citadins pour qu’ils puissent cultiver fleurs, fruits et légumes, surtout s’ils habitent en appartement."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8865118d-6fe3-43e1-8c9c-96d056009c7d",
                                                "sense_id": "0ca336e9-4d1f-3061-b464-3f9df27340fa",
                                                "text": "Ses « jardins ouvriers », détestés du patronat, n’ont pas pour seul but d’offrir au salarié des villes un peu plus d’air pur, une aide alimentaire contre la cherté de la vie, mais une sorte de réhabilitation par le contact avec le sol."
                                            },
                                            {
                                                "example_id": "3bd71baf-4b89-4e85-a657-38ce7bbc4729",
                                                "sense_id": "0ca336e9-4d1f-3061-b464-3f9df27340fa",
                                                "text": "Pantin. Les usines. Les jardins ouvriers."
                                            },
                                            {
                                                "example_id": "cbdbb529-a045-4977-9553-bc416f8503a5",
                                                "sense_id": "0ca336e9-4d1f-3061-b464-3f9df27340fa",
                                                "text": "Les jardins ouvriers naissent avec la Révolution industrielle, d’abord en Angleterre dès 1819, puis vers 1830, en Allemagne dans la région de Kiel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
