                            {
                                "example_id": "3474c42d-fb53-4a26-b82a-c9e3862fe6a8",
                                "sense_id": "fe195cd2-f9ed-3990-b967-2ce21efea328",
                                "text": "Стояли тяжёлые июльские жары."
                            }
                        ]
                    },
                    {
                        "sense_id": "71209daa-c451-3968-a836-18a9cebcaa1e",
