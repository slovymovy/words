                        "examples": [
                            {
                                "example_id": "b1314e7e-f073-4fdf-9562-0c29457a1e3f",
                                "sense_id": "a1d5e031-8da1-3b87-93eb-23d6b37bda7b",
                                "text": "Für den Versand muss ein Aufgeld bezahlt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5810c59f-ca79-3c93-967f-7cf495afc642",
                        "entry_id": "1594c277-e519-3b96-a777-d39b11950538",
                        "glosses": [
                            "Preis eines Wertpapiers, einer Münze oder Banknote abzüglich Nennwert, wird meist als prozentualer Anteil des Nennwerts angegeben"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "c79b24f8-6242-424b-9f54-0735f68a1d44",
                                "sense_id": "5810c59f-ca79-3c93-967f-7cf495afc642",
                                "text": "Wenn der Nennwert 70 € und das Aufgeld 10 % beträgt, liegt der Preis bei 77 €."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
