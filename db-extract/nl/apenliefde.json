                                "sense_id": "9c72e496-7671-31ca-98d3-e56093945eb4",
                                "text": "Jubilee was de kiem van de onvoorwaardelijke apenliefde die zijn eigenaar wereldberoemd heeft gemaakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c9a686d-4f25-3721-96f7-a8ed72520e27",
                        "entry_id": "85ec48d5-a2ec-36a6-85a9-e5e62d2cec93",
                        "glosses": [
                            "overdreven genegenheid en enthousiasme, vooral van ouders voor en over hun kinderen"
                        ],
