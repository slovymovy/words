                "word": "functionary",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3907d5b9-361c-4bd6-be4f-fe796673bc04",
                        "entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
                        "tags": [
                            "plural"
                        ],
                        "form": "functionaries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a89a1dd-b5d5-325c-ab73-024a7df6858a",
                        "entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
                        "glosses": [
                            "A person employed as an official in a bureaucracy (usually corporate or governmental) who holds limited authority and primarily serves to carry out a simple function for which discretion is minimal or not required."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3689da1a-a876-4d25-82a8-222d411781ca",
                                "sense_id": "1a89a1dd-b5d5-325c-ab73-024a7df6858a",
                                "text": "Near-synonyms: bureaucrat; official; officer; administrator; apparatchik"
                            },
                            {
                                "example_id": "1a574453-bf54-43e7-b64f-d23b5f0356f1",
                                "sense_id": "1a89a1dd-b5d5-325c-ab73-024a7df6858a",
                                "text": "Consciences are for politicians, Bernard! We are humble functionaries whose duty it is to implement the commands of our democratically elected representatives."
                            }
                        ]
                    },
                    {
                        "sense_id": "591b5356-3e74-3693-83c2-17c4cb9b1e73",
                        "entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
                        "glosses": [
                            "Such a person who is petty, pedantic, short-sighted, uncaring, or counterproductive; sometimes also with implication of being amoral or corrupt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f4923fa-3ea5-4e34-b3c2-03ef96bcca42",
                                "sense_id": "591b5356-3e74-3693-83c2-17c4cb9b1e73",
                                "text": "Near-synonyms: bureaucrat, apparatchik; paper-pusher; bean counter"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9cdd615-4784-4463-8a16-43ce1dfedbd4",
                        "source_entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
                        "source_sense_description": "a person employed as an official in a bureaucracy",
                        "target_lang_word": "functionaris",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "functionaris",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7f0e30-6c70-3750-9796-1e2961cc8ad3",
                                        "entry_id": "4e28f84c-8b79-3e86-854b-b3a7caf3e64d",
                                        "glosses": [
                                            "iemand die een (openbare) functie vervult"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "787b9789-567a-413c-bf80-53cd65f9746e",
                                                "sense_id": "eb7f0e30-6c70-3750-9796-1e2961cc8ad3",
                                                "text": "Het vertrek van een reeks hooggeplaatste functionarissen werd op 5 juli ingeluid door minister van Financiën Rishi Sunak en gezondheidsminister Sajid Javid. Het tweetal uitte bij hun vertrek felle kritiek op Johnson. Ze schreven in een verklaring dat de overheid geen \"goed, competent en serieus werk\" verricht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21f19682-628f-3bca-90ca-f627713f6480",
                                        "entry_id": "4e28f84c-8b79-3e86-854b-b3a7caf3e64d",
                                        "glosses": [
                                            "ambtenaar in overheidsdienst"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e8a5df-8255-40ce-9c33-03dda33b3658",
                                                "sense_id": "21f19682-628f-3bca-90ca-f627713f6480",
                                                "text": "Hij was de eerste hoge Amerikaanse functionaris die het land na de verkiezingen bezocht."
                                            },
                                            {
                                                "example_id": "890d7ca4-c34f-47af-a73d-f564193f3c14",
                                                "sense_id": "21f19682-628f-3bca-90ca-f627713f6480",
                                                "text": "Dit maakte een functionaris van het ministerie van Justitie gisteren bekend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37e093d2-04cc-4d0b-8509-fa83ffbd671d",
                        "source_entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
                        "source_sense_description": "a person employed as an official in a bureaucracy",
                        "target_lang_word": "fonctionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fonctionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                        "entry_id": "e5df9337-531f-347f-bc26-f21578e37951",
                                        "glosses": [
                                            "Celui, celle qui remplit une fonction de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd6a698-bd1b-46b9-809f-d86170dbb7ca",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Qu’est-ce que la vertu ? Au sens où l’entend son restaurateur, c’est sans doute la probité et le désintéressement, c’est ce genre d’intégrité qui rend un fonctionnaire ou un mandataire inaccessible à toutes les tentations, à toutes les corruptions […]."
                                            },
                                            {
                                                "example_id": "fe7b753e-9e64-4f8f-8c96-2949441a4352",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Mais en lui-même, il savait bien qu’il suffit de quelques fonctionnaires ignorants et brutaux pour rendre la France haïssable aux yeux de pauvres villageois illettrés et obscurs."
                                            },
                                            {
                                                "example_id": "b9e0387f-92fd-405f-8fc8-bc472d507f39",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Les anciens impôts basés sur le Koran sont supprimés et remplacés par des contributions nouvelles qui seront recueillies par des fonctionnaires spéciaux, au lieu de l’être par les caïds."
                                            },
                                            {
                                                "example_id": "b3d59d22-6a9f-457d-976a-30f902e3bc13",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Les paroles trébuchèrent, et il eut l’air étrangement déplacé, presque risible, cet appel aux sentiments d’un fonctionnaire, quand les fonctions ne peuvent être remplies qu’objectivement."
                                            },
                                            {
                                                "example_id": "13aa8cb1-a811-4b7d-bbdc-4e74b9312076",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Un polytechnicien, à leurs yeux, c’était quelqu’un. Mais mon sexe leur interdisait de si hautes ambitions et mon père me destina prudemment à l’administration : cependant il détestait les fonctionnaires, ces budgétivores, et c’est avec ressentiment qu’il me disait : « Toi au moins, tu auras une retraite ! »"
                                            },
                                            {
                                                "example_id": "d7826348-c571-4964-909d-19e4f5b020d8",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Le fonctionnaire de la police nationale est loyal envers les institutions républicaines. Il est intègre et impartial ; il ne se départit de sa dignité en aucune circonstance."
                                            },
                                            {
                                                "example_id": "3a65e13d-d0fa-4f44-8161-34209eaf3fc7",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Quelques très rares Annamites frayaient avec les Français. Un fonctionnaire annamitophile était en principe condamné à ne jamais « avancer ». Nous étions, du fait de la condition de ma mère, au dernier échelon de l'échelle des fonctionnaires."
                                            },
                                            {
                                                "example_id": "308994c9-0ee2-4927-8fa6-735c9a3a3cde",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Le moyen classique pour inciter à l’augmentation des salaires, c’est de toucher au smic et au point d’indice des fonctionnaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c9b820-551f-3ac8-b6ed-a4a6baf2da5b",
                                        "entry_id": "e5df9337-531f-347f-bc26-f21578e37951",
                                        "glosses": [
                                            "Personne lente à l’ouvrage, fainéante, rechignant au travail ; employé d’administration rêche et peu avenant."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d49bd9-11a7-4af1-8ec3-80b483be0713",
                                                "sense_id": "32c9b820-551f-3ac8-b6ed-a4a6baf2da5b",
                                                "text": "Celui-là ? Un vrai fonctionnaire, il n’avance que quand je le regarde !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8be36549-5589-47eb-b58e-769f37f10c81",
                        "source_entry_id": "d6e12c3c-cb6d-382f-a0e9-8d2859343ab7",
