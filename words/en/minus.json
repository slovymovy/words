            "senses": [
                {
                    "sense_id": "7feb543a-ed71-3ca5-95d6-cf51b8f1e404",
                    "sense_definition": "To perform the mathematical operation of subtraction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>minused</w> the expenses from the total revenue to find the profit.",
                            "target_lang_translations": {
                                "ru": "Он <w>вычел</w> расходы из общей выручки, чтобы найти прибыль.",
                                "zh": "他从总收入中<w>减去</w>开支以计算利润。"
                            }
                        },
                        {
                            "text": "Try <w>minussing</w> the smaller number from the larger one.",
                            "target_lang_translations": {
                                "ru": "Попробуй <w>отнять</w> меньшее число из большего.",
                                "zh": "试着从大数中<w>减去</w>小数。"
                            }
                        }
