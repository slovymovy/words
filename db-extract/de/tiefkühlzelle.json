                ],
                "senses": [
                    {
                        "sense_id": "003981d7-1b4c-3a52-b580-e0b564dda3f5",
                        "entry_id": "a06f0c21-e23f-3b99-91ef-03c674d8f339",
                        "glosses": [
                            "abgeteilter, gut isolierter Raum mit Zugangstür und Tiefkühltechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91135ae2-b019-489f-b6bb-6658d6a03ea1",
                                "sense_id": "003981d7-1b4c-3a52-b580-e0b564dda3f5",
                                "text": "„Kühl-und Tiefkühlzellen mit oder ohne Boden, einflügelige oder zweiflügelige Drehtüren, Schiebetüren und Glastüren sind einige der verfügbaren Optionen.“"
                            },
                            {
                                "example_id": "90ca65cb-268b-4852-acd4-9c966e16f288",
                                "sense_id": "003981d7-1b4c-3a52-b580-e0b564dda3f5",
                                "text": "Tiefkühlzellen haben eine sehr gute Isolierung, sind begehbar und verfügen über eine regelbare Tiefkühltechnik, die eine Zellentemperatur von −25 °C dauerhaft garantiert."
                            },
                            {
                                "example_id": "35b9cc0c-9a10-4c83-8708-68ac69203c0a",
                                "sense_id": "003981d7-1b4c-3a52-b580-e0b564dda3f5",
                                "text": "„Im Gegensatz zu Tiefkühlschränken oder anderen Kühlgeräten in dieser Größenordnung sind Tiefkühlzellen begehbar und bieten maximalen Stauraum, der vor allem in der Gastronomie gefragt ist.“"
                            },
                            {
                                "example_id": "4bb2ad4a-f335-458c-a43b-65220798b959",
                                "sense_id": "003981d7-1b4c-3a52-b580-e0b564dda3f5",
                                "text": "„Viessmann Kühlzellen und Tiefkühlzellen haben sich durch multifunktionelle Kühlung und hervorragende Qualitätsmerkmale für den gewerblichen und industriellen Bereich weltweit bewährt.“"
                            },
                            {
                                "example_id": "9409720c-e87e-4c8a-8b30-25d3bc96c246",
                                "sense_id": "003981d7-1b4c-3a52-b580-e0b564dda3f5",
                                "text": "„Bei der Montage von einer Tiefkühlzelle oder einem Tiefkühlraum sollten Sie auf jeden Fall darauf achten, daß eine sogenannte Unterlüftung stattfindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
