                "senses": [
                    {
                        "sense_id": "9248a07c-5229-34af-879a-533d5ca668eb",
                        "entry_id": "707052e9-85b1-33a1-ae41-7ad0d0b6f6e1",
                        "glosses": [
                            "Interagir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9eaecd-ae75-4892-b94c-f97849c2dbf8",
                                "sense_id": "9248a07c-5229-34af-879a-533d5ca668eb",
                                "text": "A chaque navigation sur Localité ou Sites, réinteragir avec la base de donnée et recharger les données détails."
                            },
                            {
                                "example_id": "65b2212b-515e-4b2d-b3ab-fe66e037b96f",
                                "sense_id": "9248a07c-5229-34af-879a-533d5ca668eb",
                                "text": "Ainsi peut s'expliquer le paradoxe du chat de Schrödinger [2] : on y fait intervenir la fonction d'onde d'un objet macroscopique qu'il est impossible d'empêcher de réinteragir."
                            },
                            {
                                "example_id": "e272e95a-434c-4fb8-9f0c-e1555df4f0e8",
                                "sense_id": "9248a07c-5229-34af-879a-533d5ca668eb",
                                "text": "Une fois que la requête est finie, nous retirons ce \"token : OCCUPE\" et nous pouvons réinteragir avec. (corrections : Uen en Une, requète en requête, pouvosn en pouvons)"
                            }
                        ]
                    }
