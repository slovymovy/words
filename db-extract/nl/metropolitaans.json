                "senses": [
                    {
                        "sense_id": "796bc3b6-ee1d-3b12-a06f-e9f97485ac5c",
                        "entry_id": "0212c477-6bc0-369f-82b8-69380fe2caaf",
                        "glosses": [
                            "betrekking hebbend op een aartsbisschop (metropolitaan of metropoliet)"
                        ],
                        "tags": [
                            "katholiek"
                        ],
                        "examples": [
                            {
                                "example_id": "86752029-4abf-4523-ab84-d76af1889483",
                                "sense_id": "796bc3b6-ee1d-3b12-a06f-e9f97485ac5c",
                                "text": "Waar het kapittel van Mechelen tot dan een collegiaal kapittel was, werd het nu een metropolitaans kapittel."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdd9d53e-7fdc-38cf-b210-0bdfa923e9e2",
                        "entry_id": "0212c477-6bc0-369f-82b8-69380fe2caaf",
                        "glosses": [
                            "met de eigenschappen van een stad die het middelpunt van groot omliggend land of gebied is of een uitgestrekt verstedelijkt gebied; kenmerkend voor een wereldstad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a12d97-bda1-4298-9474-4faebbf684d6",
                                "sense_id": "bdd9d53e-7fdc-38cf-b210-0bdfa923e9e2",
                                "text": "Wij zijn ons er niet voldoende van bewust dat de Randstad met zijn uitlopers naar Brabant en het oosten en Zuid-Limburg qua dichtheid en economische betekenis naar internationale maatstaven een metropolitaans gebied is."
                            }
                        ]
                    },
                    {
                        "sense_id": "4676ac6d-f5d6-3555-85c7-e02d7bc5ccc2",
                        "entry_id": "0212c477-6bc0-369f-82b8-69380fe2caaf",
                        "glosses": [
                            "partitief van de stellende trap van metropolitaans"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fa9c40ec-391f-49db-b945-a426d9f7f242",
                                "sense_id": "4676ac6d-f5d6-3555-85c7-e02d7bc5ccc2",
                                "text": "Bovendien zou een zweeftram Amsterdam, provinciestad met een kleinsteedse metro, iets waarlijk metropolitaans hebben gegeven."
                            }
                        ]
                    }
