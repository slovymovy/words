                                "sense_id": "0ecb434d-5f14-3ed4-b9ad-b1ab0d377d03",
                                "text": "Hij sloeg daarna een veel barsere toon aan."
                            },
                            {
                                "example_id": "ec7c3444-f3d8-4326-be80-7cb7549aaa52",
                                "sense_id": "0ecb434d-5f14-3ed4-b9ad-b1ab0d377d03",
                                "text": "De politieagent sprak op een barse toon de baldadige jongens toe."
                            },
                            {
                                "example_id": "fd904282-01dd-4491-8b33-651ad83a066e",
                                "sense_id": "0ecb434d-5f14-3ed4-b9ad-b1ab0d377d03",
                                "text": "‘De afgedwongen herverdeling van de rijkdom,’ zei Harold op barse toon."
                            }
                        ]
