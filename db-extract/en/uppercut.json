                                "target_senses": [
                                    {
                                        "sense_id": "4f7518e7-9963-315d-bee2-03e82969e54d",
                                        "entry_id": "b0a74220-953b-354d-9d96-4e3008c850bb",
                                        "glosses": [
                                            "een korte, harde opwaartse slag tegen de kin van de tegenstander bij boksen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70400aaf-d857-405e-9b0a-fdbed7059dc8",
                                                "sense_id": "4f7518e7-9963-315d-bee2-03e82969e54d",
                                                "text": "Manny Pacquiao heeft met een knockout regerend wereldkampioen in het WBA, de Argentijn Lucas Matthysse, verslagen. De 39-jarige Filipijnse bokslegende deed dat in Kuala Lumpur waar hij in de zevende ronde een beslissende uppercut uitdeelde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8473f37e-5124-32fb-ab65-4351bcf288ef",
                                        "entry_id": "b0a74220-953b-354d-9d96-4e3008c850bb",
                                        "glosses": [
                                            "een harde beslissende slag in een gevecht"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "553f620d-bf0e-452c-b5b6-df1358c30fbc",
                                                "sense_id": "8473f37e-5124-32fb-ab65-4351bcf288ef",
                                                "text": "Het moge inmiddels duidelijk zijn: de campagne van 2008 die in het teken stond van 'hope' en 'change' met de veel geïmiteerde slogan 'Yes we can', is ingeruild voor een keiharde campagne waarin het moddergooien niet geschuwd wordt. Het is afwachten wie de volgende uppercut weet uit te delen. Voorlopig staat Obama er twee voor op Romney."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e23b033-a688-4272-b16b-1d8ac8603655",
                        "source_entry_id": "ef9f8018-6ed0-3042-a7f5-8b7a3f6549f7",
                        "source_sense_description": "in boxing",
                        "target_lang_word": "uppercut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uppercut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "816235b2-1836-3912-9cbc-f77d732bdfcd",
                                        "entry_id": "22ae3506-965f-3a4a-b4df-14c06362c0ef",
                                        "glosses": [
                                            "Coup de poing réalisé de bas en haut, et délivré le plus souvent à mi-distance avec le bras semi-fléchi, dans un combat de boxe ou une rixe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "061532f6-7670-4990-b644-343a5a825bfa",
                                                "sense_id": "816235b2-1836-3912-9cbc-f77d732bdfcd",
                                                "text": "[…] mais quand Habib, rendu furieux par un uppercut qui faillit l’envoyer à terre, se ressaisit et fonça bestialement sur l’homme au beau visage, le combat prit une allure saisissante."
                                            },
                                            {
                                                "example_id": "ddd6e03e-be0e-4a1f-8678-6f70143f84d7",
                                                "sense_id": "816235b2-1836-3912-9cbc-f77d732bdfcd",
                                                "text": "Il avait ramassé notamment deux droites assez violentes, un uppercut qui l'avait fait vaciller."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00bac5e3-2a0e-4049-8a71-d02df20963a5",
                        "source_entry_id": "ef9f8018-6ed0-3042-a7f5-8b7a3f6549f7",
