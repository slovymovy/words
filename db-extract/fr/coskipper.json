                "senses": [
                    {
                        "sense_id": "10133872-d120-3db6-96ce-de58d44f3aaa",
                        "entry_id": "17f87cca-1c7a-399d-ad3c-07b689c2b8a9",
                        "glosses": [
                            "Skipper (un bateau) avec quelqu’un d’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5606471b-2eaa-4170-a567-77874df83c81",
                                "sense_id": "10133872-d120-3db6-96ce-de58d44f3aaa",
                                "text": "Puis avec Thomas Philippe il coskippe 33 Export, plan Briand whitbread 81-82 qui sera ensuite skippé par Lionel Péan sous le nom d’Esprit d’Equipe en 1985-86."
                            },
                            {
                                "example_id": "fe0f3367-61d5-454a-a779-6c4a0da54bb6",
                                "sense_id": "10133872-d120-3db6-96ce-de58d44f3aaa",
                                "text": "Le maxi-trimaran Spindrift 2, coskippé par le Français Yann Guichard et la Suissesse Dona Bertarelli, a remporté mardi soir la Transat (en équipage) Québec-Saint-Malo en temps réel, battant par la même occasion le record de l’épreuve."
                            },
                            {
                                "example_id": "ef3221ac-6a0d-41e5-81db-bbd9306ce30b",
                                "sense_id": "10133872-d120-3db6-96ce-de58d44f3aaa",
                                "text": "Sur la deuxième marche du podium provisoire, SAP Extreme Sailing Team, coskippée par Jes Gram-Hansen et Rasmus Kostner, réalise sa meilleure performance sur le circuit à ce jour."
                            }
                        ]
                    }
