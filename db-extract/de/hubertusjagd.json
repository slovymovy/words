                "senses": [
                    {
                        "sense_id": "cd3b758e-470c-3d3e-ad5a-c95d1fabc3c0",
                        "entry_id": "48280632-2c0c-39f9-8bd0-5b054012402a",
                        "glosses": [
                            "Jagd am Hubertustag (3. November) im Gedenken an den heiligen Hubertus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436a5529-214d-40d2-967e-e43f52432dbc",
                                "sense_id": "cd3b758e-470c-3d3e-ad5a-c95d1fabc3c0",
                                "text": "„Am 3. November gedenkt die Jägerschaft dem heiligen Hubertus – dem Schutzpatron der Jagd. Traditionell finden alljährlich große Hubertusjagden und -messen statt.“"
                            },
                            {
                                "example_id": "f82fca4b-4b0c-4c94-8b9b-3eecb19786fb",
                                "sense_id": "cd3b758e-470c-3d3e-ad5a-c95d1fabc3c0",
                                "text": "„Er hatte der letzten Hubertusjagd als Zuschauer beigewohnt und war bei dieser Gelegenheit in die Nähe hoher und höchster Herrschaften gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
