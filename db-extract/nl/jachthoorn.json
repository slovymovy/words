                    {
                        "translation_id": "f3410126-576b-4ca0-8105-62952bc5cac2",
                        "source_entry_id": "0ebe8450-6532-385a-8a17-ed4764d2b222",
                        "source_sense_id": "a6b454e4-95f3-3e77-be5b-9de981536720",
                        "source_sense_description": "een hoorn als signaalinstrument op de jacht",
                        "target_lang_word": "Jagdhorn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jagdhorn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                                        "entry_id": "6c9546ae-adea-3175-ab44-295fec45aa0e",
                                        "glosses": [
                                            "Signalhorn aus Horn, Holz oder Metall, das während der Jagd eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3994e19e-78e3-4c19-90b2-4c586255dab4",
                                                "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                                                "text": "Der Jäger trug eine Jagdtasche und ein Jagdhorn um seine Schulter."
                                            },
                                            {
                                                "example_id": "49e0d5e1-2880-453c-8ce9-97635470eb6c",
                                                "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                                                "text": "Im Wald erschallen die Jagdhörner."
                                            },
                                            {
                                                "example_id": "0dfe64f6-3e59-4438-a870-7cca49f8ee2b",
                                                "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                                                "text": "„Nun erschallen Jagdhörner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "186033b5-dfc7-3e35-806d-9ce0514ec37c",
                                        "entry_id": "6c9546ae-adea-3175-ab44-295fec45aa0e",
                                        "glosses": [
                                            "Blasinstrument, das dem Waldhorn ähnelt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ffc0b2-ca75-4dc2-8178-c6bb1310cc73",
                                                "sense_id": "186033b5-dfc7-3e35-806d-9ce0514ec37c",
                                                "text": "„Und wo Hoffmann in einem Brief an Hippel die Flöten, Klarinetten und Jagdhörner erwähnt, die in der Silvesternacht vom Turm herabschallen, ist es wiederum ihr Echo, das ihn über die Jahre hinweg erreicht, die ihn von der Kindheit trennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a67872b0-d3b0-4b1e-a3c1-9c534f7ac35f",
