                    {
                        "sense_id": "bb6df01e-6399-37ed-ba86-c121dec953e2",
                        "entry_id": "521311e4-4874-3370-98ff-a7cf0d1d25b5",
                        "glosses": [
                            "Rückgang der Geburtenrate ab Mitte des 20. Jahrhunderts in vielen Industrienationen, der der Erfindung der Antibabypille zugeschrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b3a41f-df29-450a-89d9-2b9a1c844757",
                                "sense_id": "bb6df01e-6399-37ed-ba86-c121dec953e2",
                                "text": "Ob der Pillenknick wirklich nur der Antibabypille zuzuschreiben ist, ist umstritten."
                            },
                            {
                                "example_id": "ccbb7153-fc1a-41dc-b5a0-b0ab0143713c",
                                "sense_id": "bb6df01e-6399-37ed-ba86-c121dec953e2",
                                "text": "„Nein, ich bin kein Babyboomer, ich kam erst nach dem Pillenknick auf die Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28ef9f31-fda0-4542-a32f-de9005a8960c",
                        "source_entry_id": "521311e4-4874-3370-98ff-a7cf0d1d25b5",
                        "source_sense_id": "bb6df01e-6399-37ed-ba86-c121dec953e2",
                        "target_lang_word": "baby bust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baby bust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf4d223-f55a-353f-8c1c-9b07e9934021",
                                        "entry_id": "f7090891-f807-3397-a608-a94d4919861a",
                                        "glosses": [
                                            "A decrease in the birthrate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7102ba28-adbd-4c9c-afcd-c7bfba7345a9",
                                                "sense_id": "4bf4d223-f55a-353f-8c1c-9b07e9934021",
                                                "text": "By contrast, when today’s 18-to-29-year-old group was born, the baby boom was fading into the so-called baby bust, with its precipitous decline in the U.S. birthrate."
                                            },
                                            {
                                                "example_id": "160afa18-209f-425a-92de-b1d2bcba8d6a",
                                                "sense_id": "4bf4d223-f55a-353f-8c1c-9b07e9934021",
                                                "text": "But the real societal challenge of a Covid baby bust will be a smaller work force, which portends lower economic productivity and fewer workers to contribute to the tax base."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
