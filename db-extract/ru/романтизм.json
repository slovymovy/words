                        ]
                    },
                    {
                        "translation_id": "37826fc8-c692-4244-991c-89b10875603e",
                        "source_entry_id": "a69a058e-84a4-35c8-9e3f-2b995da6ed3d",
                        "target_lang_word": "romanticismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romanticismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "b07f3f2a-3349-3be4-ba7f-6bc0907ee202",
                                        "entry_id": "a39ca17b-6989-30b7-9e7b-d77ab30b72e6",
                                        "glosses": [
                                            "tendenza artistica e letteraria nata in Germania alla fine del diciottesimo secolo e poi diffusa nel resto d'Europa all'inizio del secolo successivo, contraddistinta dall'esaltazione dell'immaginazione, dei sentimenti e dei valori sociali e morali associati al medioevo, in contrapposizione col razionalismo e l'esaltazione dell'antichità classica"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "795f8734-b86b-4f6d-a65a-1799c0318843",
                                                "sense_id": "b07f3f2a-3349-3be4-ba7f-6bc0907ee202",
                                                "text": "parte del romanticismo riconosceva un aspetto metafisico della natura"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "772e2088-65ea-3fbe-a722-b699537503ce",
                                        "entry_id": "a39ca17b-6989-30b7-9e7b-d77ab30b72e6",
                                        "glosses": [
                                            "insieme di atteggiamenti dominati da sentimenti, passioni e sogni"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cb6ec05-4577-4984-9d53-50f511bb4888",
                        "source_entry_id": "a69a058e-84a4-35c8-9e3f-2b995da6ed3d",
                        "target_lang_word": "Romantik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romantik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cedca3e9-253a-3410-a065-696050538492",
                                        "entry_id": "0eb8c6c9-fc10-321d-9b38-42409bd1a407",
                                        "glosses": [
                                            "geistige Epoche vom Ende des 18. bis Mitte des 19. Jahrhunderts, die im Gegensatz zur Aufklärung und zur Klassik stand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa0fe0e-8abe-437e-b4c1-ebdf91332c96",
                                                "sense_id": "cedca3e9-253a-3410-a065-696050538492",
                                                "text": "Die Flucht in die schöne Natur ist ein Hauptbestandteil der Romantik."
                                            },
                                            {
                                                "example_id": "375bddba-de8b-466e-8006-2c19f488e1b0",
                                                "sense_id": "cedca3e9-253a-3410-a065-696050538492",
                                                "text": "„Es kam - viel später - die Zeit der Romantik und forderte auch von der Mosel ihr Teil.“"
                                            },
                                            {
                                                "example_id": "f77b7e8b-a6c0-4a7d-9023-afc9fc94facb",
                                                "sense_id": "cedca3e9-253a-3410-a065-696050538492",
                                                "text": "„Damit hat Brentano ein Grundmotiv der Romantik für seine Bildbetrachtung herangezogen.“"
                                            },
                                            {
                                                "example_id": "d421c18d-4575-4aef-a79a-08be6befd204",
                                                "sense_id": "cedca3e9-253a-3410-a065-696050538492",
                                                "text": "„Außerdem ist er ohne Respekt und liberal, während die deutsche Romantik sonst im großen und ganzen reaktionär ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5944cee7-40e3-39a2-ae4f-31291ecb8322",
                                        "entry_id": "0eb8c6c9-fc10-321d-9b38-42409bd1a407",
                                        "glosses": [
                                            "etwas, das den Menschen mit Liebe erfüllt (vergleiche romantisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "798dde56-5516-49dc-a072-c912d619e9be",
                                                "sense_id": "5944cee7-40e3-39a2-ae4f-31291ecb8322",
                                                "text": "Die Romantik dieses Sternenhimmels lässt mein Herz höher schlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6895bb8-2cbe-4b2e-bbc6-69222944d2bc",
                        "source_entry_id": "a69a058e-84a4-35c8-9e3f-2b995da6ed3d",
                        "target_lang_word": "romantyzm",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romantyzm",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ffcf3528-0983-39a4-8171-f4fe312d79de",
                                        "entry_id": "cab9b52c-cdc4-3afc-9a07-89f9ff404f1c",
                                        "glosses": [
                                            "epoka w historii sztuki i literatury, trwająca od lat 90. XVIII wieku do lat 40. XIX wieku, charakteryzująca się zainteresowaniem sferą indywidualnych uczuć, kulturą ludową i historią, zaprzeczająca racjonalizmowi, głosząca swobodę twórczą i odrzucająca sztywne kanony klasycyzmu"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63ef1fcd-e590-4979-a308-ae4014119fa1",
                        "source_entry_id": "a69a058e-84a4-35c8-9e3f-2b995da6ed3d",
                        "target_lang_word": "romantisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romantisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10eb52fa-1613-37bd-ac33-4db602f5a906",
                                        "entry_id": "4f8d9b40-55aa-3024-9d3a-49b9f5d00568",
                                        "glosses": [
                                            "Mouvement artistique, philosophique et littéraire européen de la fin du XVIIIᵉ et de la première moitié du XIXᵉ qui réagissait contre l'idéal esthétique et les règles du classicisme et contre la raison universaliste des Lumières en privilégiant l'imagination et la sensibilité dans la création."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c88976-46aa-4ac6-8de3-77d3edbc7d6a",
                                                "sense_id": "10eb52fa-1613-37bd-ac33-4db602f5a906",
                                                "text": "Le romantisme, tant de fois mal défini, n’est, à tout prendre, et c’est sa définition réelle, que le libéralisme en littérature."
                                            },
                                            {
                                                "example_id": "ad21e9c5-8190-4d94-9665-8509ff3bba87",
                                                "sense_id": "10eb52fa-1613-37bd-ac33-4db602f5a906",
                                                "text": "Je dois dire que par romantisme, j’entends bien moins cette poussée lyrique du début de l’autre siècle, qu’un grand mouvement de dénaturalisation du langage, entrepris par la jeune école des Hugo, Musset, Dumas père, et dont les promesses se sont accomplies avec le surréalisme et ses héritiers."
                                            },
                                            {
                                                "example_id": "f6254812-f3d8-448f-a51b-9646672701e5",
                                                "sense_id": "10eb52fa-1613-37bd-ac33-4db602f5a906",
                                                "text": "Que le romantisme français, viscéralement antibourgeois, ait largement recruté dans les milieux d’inspiration monarchiste (Chateaubriand, Balzac, Hugo, etc.) et qu’il ait pu en même temps remettre le Moyen Âge au goût du jour (par exemple Notre-Dame de Paris, 1831) ne sont ainsi certainement pas une coïncidence."
                                            },
                                            {
                                                "example_id": "d1c9697f-9bb8-4e93-b672-f44d41039d96",
                                                "sense_id": "10eb52fa-1613-37bd-ac33-4db602f5a906",
                                                "text": "Ce dévoiement, c’est celui du patriotisme allemand, révolutionnaire et antidynastique dans son principe, au profit de l’Ancien Régime allemand et européen et de sa « restauration » par le biais de l’idéologie médiévisante du romantisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68f205b7-1670-3ea4-8507-01b37de7ff8f",
                                        "entry_id": "4f8d9b40-55aa-3024-9d3a-49b9f5d00568",
                                        "glosses": [
                                            "Ensemble des manières de sentir et de s’exprimer propres aux romantiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8788f8f1-39e6-41a9-b03b-111e5389c259",
                                                "sense_id": "68f205b7-1670-3ea4-8507-01b37de7ff8f",
                                                "text": "Le rythme intime du romantisme allemand, la diastole et la systole de son cœur, c’est l’enthousiasme et la tristesse métaphysique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ab822a-c293-3625-8433-f2db216ef0d5",
                                        "entry_id": "4f8d9b40-55aa-3024-9d3a-49b9f5d00568",
                                        "glosses": [
                                            "Tendance à se laisser aller, à exprimer ses sentiments personnels, surtout dans le domaine amoureux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe74762-afd6-4bb8-abd7-1ad15842ed21",
                                                "sense_id": "29ab822a-c293-3625-8433-f2db216ef0d5",
                                                "text": "La distance au lyrisme, qui est une forme de distance au romantisme, tient à la pudeur des jeunes, leur difficulté à exprimer leurs émotions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
