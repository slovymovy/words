                        "entry_id": "a40c107c-a46b-36d2-a88e-78f7461f7e9a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Wortkargheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe0066ea-9dfc-34e7-b634-2f90818410b5",
                        "entry_id": "a40c107c-a46b-36d2-a88e-78f7461f7e9a",
                        "glosses": [
                            "Eigenschaft einer Person, nur wenig Worte zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042f15b0-b2e2-45aa-a005-0b7b16082207",
                                "sense_id": "fe0066ea-9dfc-34e7-b634-2f90818410b5",
                                "text": "„Damals war sie seine Wortkargheit noch nicht so gewohnt gewesen wie heute, grade heute, da sie sie gewohnt war, schien sie ihr völlig unerträglich.“"
                            },
                            {
                                "example_id": "e4206b3f-f027-4b44-a20f-3e7b7aac1a86",
                                "sense_id": "fe0066ea-9dfc-34e7-b634-2f90818410b5",
                                "text": "„Liegt die Wortkargheitin seinem Charakter?“"
                            },
                            {
                                "example_id": "e1522932-be49-42a8-9f0d-61e30dd6a470",
                                "sense_id": "fe0066ea-9dfc-34e7-b634-2f90818410b5",
                                "text": "„Glücklich schritt Fred Asbert mit ihr durch die Straßen, enthielt sie in begreiflichem Stolz weder seiner Verwandtschaft noch seinen Freunden vor, ja zeigte sich plötzlich sogar imstande, mehrere Sätze fließend hintereinander auszusprechen, während er sonst doch die Wortkargheit in Person war.“"
                            },
                            {
                                "example_id": "a424e0ab-9281-4f09-8ba5-3319c8fc096a",
                                "sense_id": "fe0066ea-9dfc-34e7-b634-2f90818410b5",
                                "text": "„Ebenso wie die Sparsamkeit ihre regionalen und ethnischen Witzprototypen gesucht und gefunden hat, gilt dies auch für die Wortkargheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
