                ],
                "senses": [
                    {
                        "sense_id": "d1904ad1-c88e-3963-abcb-5f625fa5c3ff",
                        "entry_id": "fbdd66d3-2ddb-31c7-b098-5d0b64c66bf2",
                        "glosses": [
                            "The act of using something."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b690b09f-564d-4471-8a53-77e87ff2d022",
                                "sense_id": "d1904ad1-c88e-3963-abcb-5f625fa5c3ff",
                                "text": "The merchandise trains of the future will be able to pace the average day and night express without significant loss of track utilisation, but where quadruple track does not exist it may be necessary to seek alternative routes for the slower-moving coal and heavy mineral traffic."
                            }
                        ]
                    },
                    {
                        "sense_id": "633c6f13-846b-35cc-9b58-545df0737d8d",
                        "entry_id": "fbdd66d3-2ddb-31c7-b098-5d0b64c66bf2",
                        "glosses": [
                            "The manner in which something is used."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5d7e7c96-c5e7-3eb3-bcc9-e08a3d331fd8",
                        "entry_id": "fbdd66d3-2ddb-31c7-b098-5d0b64c66bf2",
                        "glosses": [
                            "The state of being used."
                        ],
                        "tags": [
                            "UK",
