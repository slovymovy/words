{
    "word_family": [
        "starer",
        "staringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6807b04b-e914-3ed2-9fdf-7308a8ed4357",
                    "sense_definition": "To look at someone or something for a long time with eyes wide open, often without blinking.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is rude to <w>stare</w> at people in public.",
                            "target_lang_translations": {
                                "ru": "Невежливо <w>пялиться</w> на людей в общественных местах.",
                                "zh": "在公共场合<w>盯着</w>别人看是不礼貌的。"
                            }
                        },
                        {
                            "text": "She sat by the window and <w>stared</w> at the falling rain.",
                            "target_lang_translations": {
                                "ru": "Она сидела у окна и <w>смотрела</w> на падающий дождь.",
                                "zh": "她坐在窗边，<w>凝视</w>着窗外飘落的雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gaze"
                    ],
                    "common_phrases": [
                        "stare at",
                        "stare into space",
                        "stare in disbelief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смотреть на кого-то или что-то в течение длительного времени широко открытыми глазами, часто не моргая.",
                        "zh": "长时间睁大眼睛注视某人或某物，通常不眨眼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "при́стально смотре́ть",
                                "target_lang_sense_clarification": "нейтральное выражение, описывающее действие"
                            },
                            {
                                "target_lang_word": "уста́виться",
                                "target_lang_sense_clarification": "разговорное, означает зафиксировать взгляд на чем-то"
                            },
                            {
                                "target_lang_word": "пя́литься",
                                "target_lang_sense_clarification": "просторечное, часто с оттенком грубости или неодобрения"
                            },
                            {
                                "target_lang_word": "глазе́ть",
                                "target_lang_sense_clarification": "разговорное, смотреть из праздного любопытства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盯着看",
                                "target_lang_sense_clarification": "长时间注视某人或某物"
                            },
                            {
                                "target_lang_word": "凝视",
                                "target_lang_sense_clarification": "专注地看，较为正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9320220-8da3-362c-b658-5ab6d651af9b",
                    "sense_definition": "To force or influence someone to do something or feel a certain way by looking at them intensely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher managed to <w>stare</w> the noisy students into silence.",
                            "target_lang_translations": {
                                "ru": "Учителю удалось <w>взглядом заставить</w> шумных учеников замолчать.",
                                "zh": "老师用目光<w>逼迫</w>吵闹的学生安静了下来。"
                            }
                        },
                        {
                            "text": "He tried to <w>stare</w> down his opponent before the match began.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>переглядеть</w> своего противника перед началом матча.",
                                "zh": "比赛开始前，他试图用眼神<w>压倒</w>对手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stare down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить или повлиять на кого-то сделать что-то или почувствовать себя определенным образом, пристально глядя на него.",
                        "zh": "通过强烈的目光注视，迫使某人做某事或产生某种感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смуща́ть взгля́дом",
                                "target_lang_sense_clarification": "приводить в замешательство пристальным взглядом"
                            },
                            {
                                "target_lang_word": "дави́ть взгля́дом",
                                "target_lang_sense_clarification": "оказывать психологическое давление через зрительный контакт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用目光逼迫",
                                "target_lang_sense_clarification": "通过眼神施加压力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd949a05-e663-3163-917d-a68826546ba7",
                    "sense_definition": "To be very obvious, noticeable, or conspicuous, often due to brightness or boldness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The solution to the problem <w>stared</w> him in the face.",
                            "target_lang_translations": {
                                "ru": "Решение проблемы <w>было прямо перед</w> его носом.",
                                "zh": "问题的解决方法就<w>摆在</w>他面前。"
                            }
                        },
                        {
                            "text": "The bright red wallpaper <w>stared</w> from the walls of the old house.",
                            "target_lang_translations": {
                                "ru": "Ярко-красные обои <w>бросались в глаза</w> со стен старого дома.",
                                "zh": "老房子墙上那鲜红的壁纸格外<w>扎眼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stare in the face"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in literary contexts or specific idioms"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть очень очевидным, заметным или бросающимся в глаза.",
                        "zh": "非常明显、引人注目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "броса́ться в глаза́",
                                "target_lang_sense_clarification": "быть очень заметным"
                            },
                            {
                                "target_lang_word": "мая́чить перед глаза́ми",
                                "target_lang_sense_clarification": "быть назойливо заметным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显而易见",
                                "target_lang_sense_clarification": "非常明显"
                            },
                            {
                                "target_lang_word": "扎眼",
                                "target_lang_sense_clarification": "因颜色或外观过于突出而引人注意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ed3451c-23e6-3bfd-8a12-89e04293ab22",
                    "sense_definition": "To stand up stiffly or bristle; used primarily of hair or feathers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fear made the hair on the back of his neck <w>stare</w>.",
                            "target_lang_translations": {
                                "ru": "От страха волосы у него на затылке <w>встали дыбом</w>.",
                                "zh": "恐惧让他脖子后面的汗毛都<w>竖起</w>来了。"
                            }
                        },
                        {
                            "text": "The cat's coat began to <w>stare</w> as it spotted the dog.",
                            "target_lang_translations": {
                                "ru": "Шерсть кошки начала <w>топорщиться</w>, когда она заметила собаку.",
                                "zh": "猫看到狗时，身上的毛开始<w>竖起</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стоять дыбом или топорщиться (преимущественно о волосах или перьях).",
                        "zh": "指毛发或羽毛因恐惧或寒冷而竖起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стоя́ть ды́бом",
                                "target_lang_sense_clarification": "о волосах или шерсти при испуге или холоде"
                            },
                            {
                                "target_lang_word": "топо́рщиться",
                                "target_lang_sense_clarification": "торчать в разные стороны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竖起",
                                "target_lang_sense_clarification": "指毛发直立"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b81c09c1-afcd-3e03-9b3a-19ba86d4b4ff",
                    "sense_definition": "A long, fixed look with eyes wide open.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a cold <w>stare</w> across the room.",
                            "target_lang_translations": {
                                "ru": "Она одарила его холодным <w>взглядом</w> через всю комнату.",
                                "zh": "她隔着房间给了他一个冷冰冰的<w>凝视</w>。"
                            }
                        },
                        {
                            "text": "His blank <w>stare</w> suggested he was not listening to a word I said.",
                            "target_lang_translations": {
                                "ru": "Его пустой <w>взгляд</w> говорил о том, что он не слушал ни слова из того, что я сказал.",
                                "zh": "他那呆滞的<w>凝视</w>表明他根本没听我说话。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blank stare",
                        "cold stare",
                        "icy stare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долгий, неподвижный взгляд широко открытыми глазами.",
                        "zh": "长时间睁大眼睛的注视。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "при́стальный взгляд",
                                "target_lang_sense_clarification": "внимательный, неотрывный взгляд"
                            },
                            {
                                "target_lang_word": "взор",
                                "target_lang_sense_clarification": "книжное/поэтическое слово для обозначения взгляда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凝视",
                                "target_lang_sense_clarification": "长时间的注视"
                            },
                            {
                                "target_lang_word": "盯着看",
                                "target_lang_sense_clarification": "直勾勾的注视"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a241e5cd-4e07-3379-8141-7d6c9942f315",
                    "sense_definition": "A starling (a type of bird).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer chased the <w>stare</w> away from his crops.",
                            "target_lang_translations": {
                                "ru": "Фермер прогнал <w>скворца</w> от своего урожая.",
                                "zh": "农夫把<w>椋鸟</w>从庄稼地里赶走了。"
                            }
                        },
                        {
                            "text": "We spotted a lone <w>stare</w> perched on the fence.",
                            "target_lang_translations": {
                                "ru": "Мы заметили одинокого <w>скворца</w>, сидящего на заборе.",
                                "zh": "我们发现一只孤零零的<w>椋鸟</w>停在栅栏上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "common starling",
                        "European starling"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скворец (вид птиц).",
                        "zh": "一种鸟类，即椋鸟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скворе́ц",
                                "target_lang_sense_clarification": "название птицы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "椋鸟",
                                "target_lang_sense_clarification": "鸟类名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d21a5d0e-4291-3726-9742-2bdd26b36e57",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Stare</w> was known for his contributions to nutrition science.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Стэйр</w> был известен своим вкладом в науку о питании.",
                                "zh": "<w>斯泰尔</w>先生以其对营养学的贡献而闻名。"
                            }
                        },
                        {
                            "text": "We met a conductor named Ward <w>Stare</w> at the concert.",
                            "target_lang_translations": {
                                "ru": "На концерте мы встретили дирижера по имени Уорд <w>Стэйр</w>.",
                                "zh": "我们在音乐会上遇到了一位名叫沃德·<w>斯泰尔</w>的指挥家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стэйр",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯泰尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9396144-4adf-38da-8303-d581a072e8a8",
                    "sense_definition": "A village or settlement in Poland or Ukraine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Stare</w> during their trip to Poland.",
                            "target_lang_translations": {
                                "ru": "Во время поездки в Польшу они посетили небольшую деревню <w>Старе</w>.",
                                "zh": "他们在波兰旅行期间参观了<w>斯塔雷</w>小村庄。"
                            }
                        },
                        {
                            "text": "The map showed a route passing through <w>Stare</w>.",
                            "target_lang_translations": {
                                "ru": "Карта показывала маршрут, проходящий через <w>Старе</w>.",
                                "zh": "地图显示了一条经过<w>斯塔雷</w>的路线。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня или поселение в Польше или Украине.",
                        "zh": "波兰或乌克兰的村庄或定居点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ста́ре",
                                "target_lang_sense_clarification": "географическое название"
                            },
                            {
                                "target_lang_word": "Ста́рое",
                                "target_lang_sense_clarification": "вариант названия населенного пункта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯塔雷",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}