                ],
                "senses": [
                    {
                        "sense_id": "bf5e1999-8d30-3229-806c-98d18616e52d",
                        "entry_id": "bb42aeeb-85a7-3721-bfcf-1ef48c17cbe2",
                        "glosses": [
                            "weibliche Person, die Reisende betreut und informiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70c7804-9241-40c1-a5de-1e99e30f0c5c",
                                "sense_id": "bf5e1999-8d30-3229-806c-98d18616e52d",
                                "text": "Die Reiseführerin war sehr kompetent und stets hilfsbereit."
                            },
                            {
                                "example_id": "5ae8ee3e-cffc-4763-afc9-af0c31aef2a9",
                                "sense_id": "bf5e1999-8d30-3229-806c-98d18616e52d",
                                "text": "„Eine neue Reiseführerin, ein Mädchen in Weiß und Rot, hielt ein Mikrophon in der Hand und begann zu reden.“"
                            },
                            {
                                "example_id": "6e8493ae-f8ec-4448-87d1-0a6ef745c7c0",
                                "sense_id": "bf5e1999-8d30-3229-806c-98d18616e52d",
                                "text": "„Die Reiseführerin verabschiedet uns.“"
                            },
                            {
                                "example_id": "8e5995b6-610c-45e8-a1df-22ec445a9153",
                                "sense_id": "bf5e1999-8d30-3229-806c-98d18616e52d",
                                "text": "„Innen in der »Porta Nigra« wanderten Reisegruppen herum, und jede Gruppe folgte einer Reiseführerin oder einem Reiseführer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
