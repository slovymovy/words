                ],
                "senses": [
                    {
                        "sense_id": "f6bd9ec5-9c3f-38d6-8cd8-3b02347960dd",
                        "entry_id": "f85921c6-cda6-32ea-934f-b2f7f1d3f828",
                        "glosses": [
                            "weibliche Person, die zuviel Gewicht, Bauchumfang, Körperfett oder einen zu hohen BMI hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c287fb7c-ee34-407f-a6b5-aa71a49f04cd",
                                "sense_id": "f6bd9ec5-9c3f-38d6-8cd8-3b02347960dd",
                                "text": "Die Übergewichtige sollte abnehmen."
                            },
                            {
                                "example_id": "dff8a935-7e89-4e19-8818-b6899ab1f8f4",
                                "sense_id": "f6bd9ec5-9c3f-38d6-8cd8-3b02347960dd",
                                "text": "„Die Übergewichtige kann die Finger nicht von der Schokolade lassen.“"
                            },
                            {
                                "example_id": "41b17a30-2435-4d96-ad32-f49bd8efef50",
                                "sense_id": "f6bd9ec5-9c3f-38d6-8cd8-3b02347960dd",
                                "text": "„So orderte eine 43-jährige Hausfrau aus Konstanz den angeblichen Schlankmacher für 40 Euro über das Auktionshaus Ebay. Nach ersten Beschwerden fragte die Übergewichtige in einem Internet-Forum nach.“"
                            },
                            {
                                "example_id": "1a73cb21-09d1-4f1b-83f2-2efa52ca970a",
                                "sense_id": "f6bd9ec5-9c3f-38d6-8cd8-3b02347960dd",
                                "text": "„Eine Alternative zur weitestgehenden Vergleichbarkeit des verwendetem Materials hinsichtlich des Geschlechts wäre die ausdrückliche Fokussierung auf weibliche Übergewichtige im Selbstbericht, wobei dadurch Konfundierung des Stereotyps Übergewicht mit dem Stereotyp Frauen unauflösbar gewesen wäre.“"
                            },
                            {
                                "example_id": "6f7f856e-4f3f-4e6e-9858-158174143681",
                                "sense_id": "f6bd9ec5-9c3f-38d6-8cd8-3b02347960dd",
                                "text": "„Die Übergewichtige hat mittlerweile einen Verein gegründet, der sich gegen den ihrer Meinung nach herrschenden \"Gewichtsterror\" in unserer Gesellschaft wehrt.“"
                            },
                            {
                                "example_id": "a8b5088b-df71-4a88-9124-823996ddf88e",
                                "sense_id": "f6bd9ec5-9c3f-38d6-8cd8-3b02347960dd",
                                "text": "„Sie äußerte immer wieder verachtende Sätze gegen die Übergewichtige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
