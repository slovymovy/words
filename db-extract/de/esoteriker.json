                ],
                "senses": [
                    {
                        "sense_id": "d2db41b7-980e-3ca2-b275-669f94e24f18",
                        "entry_id": "834a7c3a-a2d4-3f8f-adb0-503556b822b1",
                        "glosses": [
                            "Person, die bestimmten spiritistischen Lehren anhängt oder diese praktiziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75dafde-de73-4151-b538-33ac2c2e70ba",
                                "sense_id": "d2db41b7-980e-3ca2-b275-669f94e24f18",
                                "text": "„Unter anderem mit Verweisen auf die Quantenphysik dürfen Esoteriker in dem Film behaupten, Menschen könnten sich von \"feinstofflicher Energie\" ernähren. Gemeint ist Licht, Lebensenergie, Qi, Prana - jedenfalls keine feste Nahrung.“"
                            },
                            {
                                "example_id": "f1258cb9-ef7e-47ad-9d8b-e9adf29c1630",
                                "sense_id": "d2db41b7-980e-3ca2-b275-669f94e24f18",
                                "text": "„Da der Esoteriker alles gleich gewichten muss, alle Gegensätze als gleichwertig ansieht und alles gleich-gültig betrachten soll, kann er keine ehrlichen Entscheidungen treffen.“"
                            },
                            {
                                "example_id": "07963499-c91f-4a55-9fca-3c1380f49c51",
                                "sense_id": "d2db41b7-980e-3ca2-b275-669f94e24f18",
                                "text": "„Selbst Esoteriker sind von diesem Berg überzeugt.“"
                            },
                            {
                                "example_id": "7d88bf50-67fe-4754-9123-b46807e41c39",
                                "sense_id": "d2db41b7-980e-3ca2-b275-669f94e24f18",
                                "text": "„Im Übrigen war der Esoteriker Schönerer ein leidenschaftlicher Verehrer der Hohenzollern, was die meisten Bürger Altösterreichs mit Kopfschütteln zur Kenntnis nahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0552b04-3bc0-36a8-8547-11e0fe046563",
                        "entry_id": "834a7c3a-a2d4-3f8f-adb0-503556b822b1",
                        "glosses": [
                            "Person, die über Geheimwissen verfügt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "11b9c052-37d2-47e1-b144-16af51c6dc3c",
                                "sense_id": "a0552b04-3bc0-36a8-8547-11e0fe046563",
                                "text": "Eingeweihte Mitglieder der Illuminaten sind ob ihres Wissens Esoteriker."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53583348-1705-4d34-9168-e1b537f94029",
                        "source_entry_id": "834a7c3a-a2d4-3f8f-adb0-503556b822b1",
                        "source_sense_id": "d2db41b7-980e-3ca2-b275-669f94e24f18",
                        "source_sense_description": "Person, die bestimmten spiritistischen Lehren anhängt oder diese praktiziert",
                        "target_lang_word": "esoteric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esoteric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99e73a4c-dcfe-313e-bd08-67c6bea2e0ce",
                                        "entry_id": "7d118933-e5d7-3d9a-bb28-461e3ad5faf1",
                                        "glosses": [
                                            "Intended for or likely to be understood by only a small number of people with a specialized knowledge or interest, or an enlightened inner circle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d302c73c-f349-4eaa-abfc-05c8f1be0668",
                                                "sense_id": "99e73a4c-dcfe-313e-bd08-67c6bea2e0ce",
                                                "text": "The writing in this manual is very esoteric; I’d need a degree in engineering just to understand it!"
                                            },
                                            {
                                                "example_id": "e94cea55-b73f-4808-ae12-f23e81ef9c7a",
                                                "sense_id": "99e73a4c-dcfe-313e-bd08-67c6bea2e0ce",
                                                "text": "In this situation Hitler availed himself of a time-honored device-the use of esoteric language. In all periods of history, when government or society has put limits on public discussion, those who wish to circumvent censorship resort to the use of esoteric language. Exoterically understood, the text is unexceptionable, but to the insiders who know how to interpret the words, the message is revolutionary and dangerous to the status quo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "903f0db0-0427-3bd5-b68a-c1fc42275cf5",
                                        "entry_id": "7d118933-e5d7-3d9a-bb28-461e3ad5faf1",
                                        "glosses": [
                                            "Having to do with concepts that are highly theoretical and without obvious practical application; often with mystical or religious connotations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc81c0e-bb6b-4500-8caf-e615a4fc614f",
                                                "sense_id": "903f0db0-0427-3bd5-b68a-c1fc42275cf5",
                                                "text": "When he spoke to me of esoteric mysteries I wanted to say to him,\"Don't give me that spiritual hokum, friend!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e8b2cec-8637-347b-986f-71a846d98164",
                                        "entry_id": "7d118933-e5d7-3d9a-bb28-461e3ad5faf1",
                                        "glosses": [
                                            "Confidential; private."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0231512-dc3d-4fda-a97c-044a5cae2dd6",
                                                "sense_id": "2e8b2cec-8637-347b-986f-71a846d98164",
                                                "text": "an esoteric purpose"
                                            },
                                            {
                                                "example_id": "4a2c596c-77f0-4472-b17a-48ecbb03e694",
                                                "sense_id": "2e8b2cec-8637-347b-986f-71a846d98164",
                                                "text": "an esoteric meeting"
                                            }
                                        ]
                                    }
                                ]
                            },
