                        "glosses": [
                            "Ligature faite avec du fil à voile sur l'extrémité d'un cordage afin d'éviter que les torons se détorsadent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af91a426-4467-4bc5-919c-f045fe26c13a",
                                "sense_id": "81c56c1a-7f7e-363b-b3c9-eeeced0ebc9c",
                                "text": "Commencer par faire une ganse, enrouler le fil autour du cordage et de la ganse de manière bien serrée, bien jointives et à la proximité de la ganse, passer le fil à l'intérieur, tirer l'autre extrémité afin d'avoir le croisement des deux bouts à l'intérieur de la surliure, couper au ras."
                            }
                        ]
                    }
