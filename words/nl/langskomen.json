                            },
                            {
                                "target_lang_word": "come by",
                                "target_lang_sense_clarification": "to move past a certain point"
                            },
                            {
                                "target_lang_word": "go past",
                                "target_lang_sense_clarification": "to move past something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проходить мимо",
                                "target_lang_sense_clarification": "двигаться мимо пешком"
                            },
                            {
                                "target_lang_word": "проезжать мимо",
                                "target_lang_sense_clarification": "двигаться мимо на транспорте"
                            },
                            {
                                "target_lang_word": "промелькнуть",
                                "target_lang_sense_clarification": "быстро пронестись мимо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3892e841-6dc5-384b-a262-49ffedac9111",
                    "sense_definition": "voor een korte tijd zichtbaar, hoorbaar of merkbaar zijn in een stroom van informatie of gebeurtenissen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Verschillende vormen van nepnieuws <w>komen</w> vaak <w>langs</w> op sociale media.",
                            "target_lang_translations": {
                                "en": "Different forms of fake news often <w>come up</w> on social media.",
                                "ru": "В социальных сетях часто <w>встречаются</w> различные формы фейковых новостей."
                            }
                        },
                        {
                            "text": "Tijdens de vergadering <w>kwamen</w> er veel interessante ideeën <w>langs</w>.",
                            "target_lang_translations": {
                                "en": "During the meeting, many interesting ideas <w>were mentioned</w>.",
                                "ru": "Во время собрания <w>прозвучало</w> много интересных идей."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschijnen",
                        "de revue passeren"
                    ],
                    "common_phrases": [
                        "vaak langskomen",
                        "in het nieuws langskomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be visible, audible, or noticeable for a short time in a stream of information or events.",
                        "ru": "Быть видимым, слышимым или заметным в течение короткого времени в потоке информации или событий."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come up",
                                "target_lang_sense_clarification": "to appear or be mentioned in a sequence"
                            },
                            {
                                "target_lang_word": "pass by",
                                "target_lang_sense_clarification": "to appear briefly in a feed or stream"
                            },
                            {
                                "target_lang_word": "crop up",
                                "target_lang_sense_clarification": "to appear unexpectedly in a flow of information"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мелькать",
                                "target_lang_sense_clarification": "часто появляться в поле зрения или в ленте"
                            },
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "попадаться в потоке информации"
                            },
                            {
                                "target_lang_word": "проскакивать",
                                "target_lang_sense_clarification": "быстро появляться и исчезать в обсуждении или ленте"
                            },
                            {
                                "target_lang_word": "упоминаться",
                                "target_lang_sense_clarification": "быть озвученным среди прочего"
                            }
                        ]
                    }
                }
            ]
        }
