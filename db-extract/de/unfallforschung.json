                        "sense_id": "495baa8f-737c-3bc2-a72a-15b7b6d22f08",
                        "entry_id": "8ce90eee-0d68-3e31-bd8b-14f20a26a9a5",
                        "glosses": [
                            "Disziplin zur Erforschung von Unfallursachen und -folgen"
