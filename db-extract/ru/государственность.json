                        "target_lang_word": "statehood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statehood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b7f735-f87e-3dfc-8921-7227b5553249",
                                        "entry_id": "7f2c328e-1115-34a0-a01b-93194b6ff36d",
                                        "glosses": [
                                            "The property of being a state, an autonomous subdivision of a federal country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa9ef35-377b-4767-8aef-f6619837609e",
                                                "sense_id": "f9b7f735-f87e-3dfc-8921-7227b5553249",
                                                "text": "Alaska didn't attain statehood until 1959, when it became the 49th state of the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e53c0e-36f7-3d41-82eb-da58e0540b17",
                                        "entry_id": "7f2c328e-1115-34a0-a01b-93194b6ff36d",
                                        "glosses": [
                                            "The condition of being a country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8786e3b-2190-4616-800d-6eaa2edf45af",
                                                "sense_id": "d5e53c0e-36f7-3d41-82eb-da58e0540b17",
                                                "text": "Medvedev cited these supposed “Western analysts” in order to propagate Russia’s colonial fantasy: envisioning Ukraine’s territory reduced to just the Kyiv region, while the remainder of Ukraine would be divided among Russia, Poland, Romania, and Hungary. Such a narrative recalls Putin’s February 2022 speech questioning Ukraine’s statehood and accompanies intensifying Russian calls to expand its “special military operation” to realize its imperial map."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69961867-656e-404b-8fe4-2f418599fc23",
                        "source_entry_id": "09d3de13-a420-35ee-be20-437c4b497a32",
                        "target_lang_word": "Staatswesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatswesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "641e8e44-8326-3e25-b18f-9615cdc8d524",
                                        "entry_id": "82fb1f97-7927-3f32-a3a9-e811f8aebaf9",
                                        "glosses": [
                                            "Staat als Gemeinwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79a1d169-adba-4e08-992b-fc5b56fcce33",
                                                "sense_id": "641e8e44-8326-3e25-b18f-9615cdc8d524",
                                                "text": "Es ist ein demokratisches Staatswesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
