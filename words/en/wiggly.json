{
    "word_family": [
        "wiggle",
        "wiggler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4acad7e-1f04-3b4d-9980-43d0410d7cdf",
                    "sense_definition": "Constantly moving, especially with small, undirected movements.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not easy to get a diaper onto a <w>wiggly</w> little baby.",
                            "target_lang_translations": {
                                "ru": "Нелегко надеть подгузник на <w>вертлявого</w> малыша."
                            }
                        },
                        {
                            "text": "The <w>wiggly</w> puppy would not sit still for the photo.",
                            "target_lang_translations": {
                                "ru": "<w>Непоседливый</w> щенок никак не хотел сидеть смирно для фотографии."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidgety",
                        "squirmy"
                    ],
                    "common_phrases": [
                        "wiggly baby",
                        "wiggly puppy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно находящийся в движении, особенно совершающий мелкие, беспорядочные движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непоседливый",
                                "target_lang_sense_clarification": "о человеке или животном, который не может усидеть на месте"
                            },
                            {
                                "target_lang_word": "вертлявый",
                                "target_lang_sense_clarification": "о том, кто постоянно крутится и совершает мелкие движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "807b110a-a81c-38b8-8415-5aeef1fbae4c",
                    "sense_definition": "Of a line: made up of many curves.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child drew a <w>wiggly</w> line across the page.",
                            "target_lang_translations": {
                                "ru": "Ребенок нарисовал <w>волнистую</w> линию поперек страницы."
                            }
                        },
                        {
                            "text": "Follow the <w>wiggly</w> path through the forest to reach the lake.",
                            "target_lang_translations": {
                                "ru": "Идите по <w>извилистой</w> тропинке через лес, чтобы добраться до озера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wiggly line",
                        "wiggly path"
                    ],
                    "target_lang_definitions": {
                        "ru": "О линии: состоящий из множества изгибов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волнистый",
                                "target_lang_sense_clarification": "имеющий форму волн или изгибов"
                            },
                            {
                                "target_lang_word": "извилистый",
                                "target_lang_sense_clarification": "имеющий много поворотов и изгибов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}