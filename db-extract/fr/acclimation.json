                        "glosses": [
                            "Acclimatation."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "56d4586b-ae8b-4136-8e37-46a135318730",
                                "sense_id": "94837baf-36c3-37b4-90aa-f0be60085dd4",
                                "text": "Mes expériences de gentlewoman-farmer étaient bornées au nord par l’acclimation d'un bac de géraniums sur mon balcon de Montmartre, et au sud par la tonte à ras d'une pelouse."
                            },
                            {
                                "example_id": "8b3d50b1-da10-44ca-9ab9-f7dcb91885d1",
                                "sense_id": "94837baf-36c3-37b4-90aa-f0be60085dd4",
                                "text": "Il ne s'occupera ni de chameaux ni de grues, et consacrera tous ses loisirs à l’acclimation des biches."
                            },
                            {
                                "example_id": "3d9a6ea7-78f6-4e19-88bb-6e813b1b588c",
                                "sense_id": "94837baf-36c3-37b4-90aa-f0be60085dd4",
                                "text": "On a beaucoup parlé de l’artemia salina, petit crustacé que Schmankewitsch aurait amené, par acclimation à l'eau douce, à devenir un branchiopus."
                            }
                        ]
                    }
