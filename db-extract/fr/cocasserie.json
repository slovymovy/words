                                    },
                                    {
                                        "sense_id": "1630bdb1-f946-3555-8678-9fb0880883b7",
                                        "entry_id": "ea33ad13-ddd9-3dcd-a662-a84e99b48637",
                                        "glosses": [
                                            "Something funny; a quirky or amusing statement, mannerism, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb0e6f0d-177e-46b8-8a25-896041ed0120",
                                                "sense_id": "1630bdb1-f946-3555-8678-9fb0880883b7",
                                                "text": "He, Cardew, had sat at home, accepting readymade conclusions, the shallow funninesses of imbeciles and clowns..."
                                            },
                                            {
                                                "example_id": "c31cece0-d350-4ac0-bdcd-588eec8bcb52",
                                                "sense_id": "1630bdb1-f946-3555-8678-9fb0880883b7",
                                                "text": "Gone were the human funninesses and kindnesses of the London gutter child..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
