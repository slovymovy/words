                                "target_senses": [
                                    {
                                        "sense_id": "797e242f-6e35-3727-9a82-7152bcbd1d2a",
                                        "entry_id": "e80929fd-c374-32cf-bf30-f39076ec3755",
                                        "glosses": [
                                            "Of, pertaining to, or in the style of expressionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94b6e13-3405-4e17-8806-a7a3222b7d69",
                                                "sense_id": "797e242f-6e35-3727-9a82-7152bcbd1d2a",
                                                "text": "“It’s this snaggletoothed, little bird-footed homunculus caricature,” Bourneuf said. “Many artists at this time were trying to make new altarpieces. Klee tended to take a very skeptical distance from the sort of grandiose projects of many of his expressionist peers, so I think it’s actually kind of mocking those hopes.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "expressionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd306c32-bbe7-385d-a0e3-20f54f8b0033",
                                        "entry_id": "d60dd5c2-05f2-377b-bf4f-8750e5adb4a7",
                                        "glosses": [
                                            "A painter who paints in this style."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c36ace01-546b-4196-a4ec-d121d1958f49",
                        "source_entry_id": "7aad4986-4307-376c-ae7d-9a601411d8e7",
                        "source_sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                        "source_sense_description": "Vertreter des Expressionismus",
                        "target_lang_word": "expressionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expressionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                        "entry_id": "5aac7e84-231d-3478-bdaa-4711f08c4fc0",
                                        "glosses": [
                                            "Adepte de l'expressionnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f19132-57a6-42fa-b6c1-c7ca74c577da",
                                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                                "text": "Otto Dix est un expressionniste allemand."
                                            },
                                            {
                                                "example_id": "dff99563-b23d-4ecd-ba37-c20a30e155c7",
                                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                                "text": "Paul Klee n’était pas à proprement parler un expressionniste typique."
                                            },
                                            {
                                                "example_id": "1fdaf16d-beb2-488d-9c9a-d8a936714553",
                                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                                "text": "… il revient avec le coffret de thuya où il garde, avec son carnet de la Caisse Populaire et ses polices d'assurances\n (vie, feu, vol), les dessins de Laïnou. Elle les lui donne à mesure ; de toute façon ils sont sans valeur ; les critiques l'ont classée expressionniste abstraite, ça fait que tout ce qu'elle fait qui ressemble à de quoi ne vaut pas 5 cennes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "expressionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70be29b1-7769-3f5e-9c46-7e11b08577ca",
                                        "entry_id": "e51f121b-2602-301f-97a9-f30e3224c375",
                                        "glosses": [
                                            "Relatif à, relevant de l'expressionnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b55f02-6326-40a5-801d-a9decda606dd",
                                                "sense_id": "70be29b1-7769-3f5e-9c46-7e11b08577ca",
                                                "text": "Otto Dix est un peintre expressionniste."
                                            }
                                        ]
                                    }
                                ]
