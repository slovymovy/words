    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bd783248-7952-3c03-9efa-e4082f988627",
                    "sense_definition": "met een doffe, donkergrijze kleur die niet helder is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was de <w>grauwe</w> Hollandse luchten zat en vertrok naar het zonnige zuiden.",
                            "target_lang_translations": {
                                "en": "He was tired of the <w>gray</w> Dutch skies and left for the sunny south."
                            }
                        },
                        {
                            "text": "De oude muren van het kasteel zagen er <w>grauw</w> en verwaarloosd uit.",
                            "target_lang_translations": {
                                "en": "The old walls of the castle looked <w>drab</w> and neglected."
                            }
                        }
                    ],
                    "synonyms": [
                        "grijs"
                    ],
                    "antonyms": [
                        "kleurrijk",
                        "helder"
                    ],
                    "common_phrases": [
                        "grauwe lucht",
                        "grauw weer"
                    ],
                    "target_lang_definitions": {
                        "en": "having a dull, dark gray color that is not bright"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gray",
                                "target_lang_sense_clarification": "dull or dark color"
                            },
                            {
                                "target_lang_word": "drab",
                                "target_lang_sense_clarification": "lacking brightness or interest"
                            },
                            {
                                "target_lang_word": "ashen",
                                "target_lang_sense_clarification": "pale gray color"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20cae05c-8896-3892-89bc-8d45cef37e95",
                    "sense_definition": "somber, vreugdeloos of deprimerend van aard",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het leven in de industriestad voelde voor hem als een <w>grauwe</w> sleur.",
                            "target_lang_translations": {
                                "en": "Life in the industrial city felt like a <w>bleak</w> routine to him."
                            }
                        },
                        {
                            "text": "Zonder muziek en kleur bleef het een <w>grauw</w> bestaan voor de bewoners.",
                            "target_lang_translations": {
                                "en": "Without music and color, it remained a <w>drab</w> existence for the residents."
                            }
                        }
                    ],
                    "antonyms": [
                        "vrolijk",
                        "levendig"
                    ],
                    "common_phrases": [
                        "grauwe sleur",
                        "grauw bestaan"
                    ],
                    "target_lang_definitions": {
                        "en": "gloomy, joyless, or depressing in nature"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bleak",
                                "target_lang_sense_clarification": "depressing and dreary"
                            },
                            {
                                "target_lang_word": "drab",
                                "target_lang_sense_clarification": "uninteresting and dull"
                            },
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "lacking hope or happiness"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b5458b5-2b9f-3660-892a-1f3965e0809e",
                    "sense_definition": "de kleur grijs of een doffe grijstint",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>grauw</w> van de ochtendmist hing zwaar boven de velden.",
                            "target_lang_translations": {
                                "en": "The <w>grayness</w> of the morning mist hung heavy over the fields."
                            }
                        },
                        {
                            "text": "Zij koos voor een schilderij waarin het <w>grauw</w> de boventoon voerde.",
                            "target_lang_translations": {
                                "en": "She chose a painting in which <w>gray</w> was the dominant color."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the color gray or a dull shade of gray"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grayness",
                                "target_lang_sense_clarification": "the state of being gray"
                            },
                            {
                                "target_lang_word": "gray",
                                "target_lang_sense_clarification": "the color itself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4861913b-a272-3d25-b01e-0e8f08140a3d",
                    "sense_definition": "het gewone volk, vaak op een neerbuigende manier bedoeld",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mensen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De adel keek in die tijd vaak neer op het gemene <w>grauw</w>.",
                            "target_lang_translations": {
                                "en": "The nobility in those days often looked down on the common <w>rabble</w>."
                            }
                        },
                        {
                            "text": "Het opstandige <w>grauw</w> verzamelde zich op het centrale plein van de stad.",
                            "target_lang_translations": {
                                "en": "The rebellious <w>mob</w> gathered in the city's central square."
                            }
                        }
                    ],
                    "synonyms": [
                        "grijs"
                    ],
                    "antonyms": [
                        "adel",
                        "elite"
                    ],
                    "common_phrases": [
                        "het gemene grauw"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the common people, often used in a derogatory way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rabble",
                                "target_lang_sense_clarification": "disorderly crowd of people"
                            },
                            {
                                "target_lang_word": "the masses",
                                "target_lang_sense_clarification": "the ordinary people"
                            },
                            {
                                "target_lang_word": "mob",
                                "target_lang_sense_clarification": "a large, unruly group"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba5be5e0-b016-36ae-8855-29e0ae90c3bc",
                    "sense_definition": "een kort, nors of snauwend geluid",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een korte <w>grauw</w> liet de hond weten dat hij niet gestoord wilde worden.",
                            "target_lang_translations": {
                                "en": "With a short <w>snarl</w>, the dog let it be known that he did not want to be disturbed."
                            }
                        },
                        {
                            "text": "De oude man gaf een <w>grauw</w> als antwoord op de vriendelijke vraag.",
                            "target_lang_translations": {
                                "en": "The old man gave a <w>snap</w> in response to the friendly question."
                            }
                        }
                    ],
                    "synonyms": [
                        "grijs"
                    ],
                    "target_lang_definitions": {
                        "en": "a short, gruff, or snapping sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snarl",
                                "target_lang_sense_clarification": "an aggressive growl"
                            },
                            {
                                "target_lang_word": "snap",
                                "target_lang_sense_clarification": "a sudden, sharp remark"
                            },
                            {
                                "target_lang_word": "growl",
                                "target_lang_sense_clarification": "a low, guttural sound"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ded5cc2-8a3a-3f87-a533-e4b6273d099c",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>grauwen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>grauw</w> tegen iedereen die mij 's ochtends te vroeg wakker maakt.",
                            "target_lang_translations": {
                                "en": "I <w>snap</w> at anyone who wakes me up too early in the morning."
                            }
                        },
                        {
                            "text": "Als ik boos ben, <w>grauw</w> ik soms onbedoeld tegen mijn vrienden.",
                            "target_lang_translations": {
                                "en": "When I am angry, I sometimes unintentionally <w>snarl</w> at my friends."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'to snarl' or 'to snap'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snarl",
                                "target_lang_sense_clarification": "to speak in an angry way"
                            },
                            {
                                "target_lang_word": "snap",
                                "target_lang_sense_clarification": "to speak sharply or irritably"
                            }
                        ]
                    }
                }
            ]
        }
    ]
