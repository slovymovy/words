                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86ef0b4c-c073-3147-9414-261076d5c6c6",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "The degree of strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13aec7c2-015f-4fd3-88da-69f86b583568",
                                                "sense_id": "86ef0b4c-c073-3147-9414-261076d5c6c6",
                                                "text": "The painting’s dislocated, unformed features are the very opposite of the hard, painted dolls of the other portrait, and, where they are dead and ready to topple, this unknown man’s eyes are full of intensity and life."
                                            },
                                            {
                                                "example_id": "1d57223b-d307-4e11-9239-c32ed2bed263",
                                                "sense_id": "86ef0b4c-c073-3147-9414-261076d5c6c6",
                                                "text": "Fagus sylvatica (European beech) and Acer saccharum (sugar maple, from North America) are very tolerant of deep shade, while Betula spp. (birches) and Populus spp. (poplars) grow best under high light intensities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a48922e-cfc0-3622-9d30-9cee38d5e227",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "Time-averaged energy flux (the ratio of average power to the area through which the power \\\"flows\\\"); irradiance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b0e0e0a-7435-31e6-ab3a-3511d5c5d2a3",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "Can mean any of radiant intensity, luminous intensity or irradiance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b164af60-d79c-3e0b-bd92-a349c629d964",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "Synonym of radiance."
                                        ],
