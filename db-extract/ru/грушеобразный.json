                        "source_entry_id": "3c354daa-f018-3344-8b4a-d5447a0c2f2f",
                        "source_sense_id": "e3bb4481-faa8-3ec2-8805-488071126ea1",
                        "target_lang_word": "piriforme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piriforme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf1610d-9420-36b4-821d-0c928592b57f",
                                        "entry_id": "4dd0918f-a440-3b16-806e-54d631611490",
                                        "glosses": [
                                            "Qui est en forme de poire."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fba9948-5827-48fe-825f-f35d1ec57fec",
                                                "sense_id": "6cf1610d-9420-36b4-821d-0c928592b57f",
                                                "text": "C’était un homme sec, dont le crâne chauve par-devant, garni de cheveux rares par derrière, avait une conformation piriforme."
                                            },
                                            {
                                                "example_id": "58425abc-f7da-4759-8f28-750f40cce81f",
                                                "sense_id": "6cf1610d-9420-36b4-821d-0c928592b57f",
                                                "text": "Ce n’est guère que vers le dixième jour qu’on voit s’élever de la partie inférieure du canal intestinal une petite vésicule piriforme que nous avons nommée allantoïde […]"
                                            },
                                            {
                                                "example_id": "37b83457-4fad-4f0a-8406-1919d2ee7498",
                                                "sense_id": "6cf1610d-9420-36b4-821d-0c928592b57f",
                                                "text": "Elle avait une tête piriforme, des joues qui ballottaient, dégonflées, un nez fastueux et tombant bas […]"
                                            },
                                            {
                                                "example_id": "8864a801-64c5-4766-815e-79b01b9e46d6",
                                                "sense_id": "6cf1610d-9420-36b4-821d-0c928592b57f",
                                                "text": "Il alla prendre l’Ubu électrique sur un rayon ; l’Ubu électrique soutenait de son bras-nageoire un parapluie de soie rouge qui formait abat-jour et une tête piriforme qui distribuait la lumière à travers de gros yeux loufoques."
                                            },
                                            {
                                                "example_id": "fceb530a-b6da-4ad7-a11b-45d2f4ea3098",
                                                "sense_id": "6cf1610d-9420-36b4-821d-0c928592b57f",
                                                "text": "Quérolle, qui rêvassait encore au lit, descend en ajustant ses bretelles. C’est un poussah piriforme ; la tête est petite et pointue ; le menton semble s’être fondu dans le cou, le cou avoir coulé dans les épaules, et le torse s’élargir jusqu’au fond du pantalon. S’il s’asseyait à terre, rien ne pourrait le renverser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
