                "senses": [
                    {
                        "sense_id": "01ea6d1f-93ef-39ba-a415-87dd4fe4183b",
                        "entry_id": "c719f97d-50e8-3555-a0dd-a1c89dbbc908",
                        "glosses": [
                            "Wirtschaftszweig, der sich mit der Herstellung und dem Vertrieb von Filmen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36727f08-2274-4f18-8f58-2c4ee8172b85",
                                "sense_id": "01ea6d1f-93ef-39ba-a415-87dd4fe4183b",
                                "text": "Als Zentrum der US-amerikanischen Filmindustrie gilt der Stadtteil Hollywood in Los Angeles."
                            },
                            {
                                "example_id": "bdb79ef6-9f23-4682-af29-755b1a5c90b4",
                                "sense_id": "01ea6d1f-93ef-39ba-a415-87dd4fe4183b",
                                "text": "„Die zeitgenössische Filmindustrie hat ein genaues Gespür für diesen Zusammenhang.“"
                            },
                            {
                                "example_id": "c2e81b57-0414-4e34-8777-3516762e4f7c",
                                "sense_id": "01ea6d1f-93ef-39ba-a415-87dd4fe4183b",
                                "text": "„Es ist der Filmindustrie gelungen, in ihre jahrzehntelangen Bemühungen um die sinnliche Entwicklung der Menschheit nunmehr auch die Nase mit einzubeziehen.“"
                            },
                            {
                                "example_id": "87608fdf-44b5-4e45-90c3-05934b1b748e",
                                "sense_id": "01ea6d1f-93ef-39ba-a415-87dd4fe4183b",
                                "text": "„Die Anfänge der jiddischen Filmindustrie fallen noch in die Stummfilmzeit.“"
                            },
                            {
                                "example_id": "0310653f-5808-4c72-969d-9d2f3130263b",
                                "sense_id": "01ea6d1f-93ef-39ba-a415-87dd4fe4183b",
                                "text": "„Mr. Erich Pommer hat mehrere detaillierte Berichte über die wirtschaftliche und organisaorische Seite seiner Bemühungen, in Deutschland eine arbeitsfähige Filmindustrie aufzubauen, eingereicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
