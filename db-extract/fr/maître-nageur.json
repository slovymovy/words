                                "target_senses": [
                                    {
                                        "sense_id": "0c76c8ee-243e-3edc-8381-ce230d3e8c18",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A lifesaver: a rescuer, usually an expert swimmer, employed to save swimmers in trouble or near drowning at a body of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A bodyguard or unit of bodyguards, a guard of someone's (especially a king's) life or person."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0595e318-06a4-43da-8c7e-1ba4f9099bc6",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "\"The people's love is the king's lifeguard.\""
                                            },
                                            {
                                                "example_id": "efe2831a-c8a5-4896-bbf4-005a86ccafaa",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "[I]n the reserve were the king's lifeguard, commanded by the earl of Lindsey, and prince Rupert's regiment of foot[.]"
                                            },
                                            {
                                                "example_id": "34672baa-0850-41fe-a068-5e36c6550e47",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "Constantine the Great is known to have raised the five scholae of horsemen who formed the actual lifeguard of the prince, and followed his person whenever he went out to war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1c2ef37-8306-3c4a-9599-ded01ed3e974",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A sturdy metal bracket fixed in front of each of the leading wheels of a train to deflect small objects away from the wheels to prevent derailment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b787a09c-6730-4f6f-a6c9-2e8cc6d2cee3",
                                                "sense_id": "d1c2ef37-8306-3c4a-9599-ded01ed3e974",
                                                "text": "It also looked at what effect stronger lifeguards might have had. They protect the leading wheels from small obstacles and in modern trains have coped with hitting landslip debris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
