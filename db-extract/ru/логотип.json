                        "cross_references": [
                            {
                                "target_word": "logo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "51f60c41-dcf9-3643-85cf-ecc3ef566424",
                                        "entry_id": "a0670cfd-1a70-38ed-bc7d-9ca90c36ffb4",
                                        "glosses": [
                                            "rappresentazione grafica che identifica un prodotto, un servizio, un'azienda o un'organizzazione, tipicamente è costituito da un simbolo o da una particolare rappresentazione di un nome (o acronimo) con l'uso di un'impressione precisa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9a15e9-e75b-4ed6-9d03-8c735d3f2030",
                                                "sense_id": "51f60c41-dcf9-3643-85cf-ecc3ef566424",
                                                "text": "i loghi della società in oggetto hanno un carattere distintivo"
                                            },
                                            {
                                                "example_id": "ecfee743-97e4-4594-9929-579e1a7cdd4f",
                                                "sense_id": "51f60c41-dcf9-3643-85cf-ecc3ef566424",
                                                "text": "La Sua Carta di credito è accettata in milioni di esercizi convenzionati in Italia e nel mondo. Il logo riportato sulla sua carta ne indica il circuito di accettazione."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ed3eda-7b9d-3bbf-8c0b-24e77b4de4c3",
                                        "entry_id": "a0670cfd-1a70-38ed-bc7d-9ca90c36ffb4",
                                        "glosses": [
                                            "abbreviazione di logotipo"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8efe9bd6-4dbe-3184-bc38-02dea586a2d2",
                                        "entry_id": "a0670cfd-1a70-38ed-bc7d-9ca90c36ffb4",
                                        "glosses": [
                                            "secondo le leggi precipue, è un simbolo esemplificativo, con disegno e/o lettere astratti, di fantasia, realistici, spesso cucito e/o come sorta di emblema su vestiti appunto con marchio specifico, su scarpe, borse, orologi e gioielli, oggettistica in genere ma anche per alimentari, per le istituzioni di Stato ed associazioni private, nei mass media ovvero anche per cinema, televisione, internet e/o nella tecnologia, quindi per società con mercato nel commercio, persino con satira o umorismo in merito o addirittura come proclami di libertà, pace, ecc finanche nello sport ed in medicina così come nello studio in generale (libri, edizioni particolari, università, ecc), negli stessi prodotti artistici e dunque nei motori ed altro; è quanto contribuisce in modo cospicuo al benessere di un brand"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "623acf00-1ea9-4d07-81e7-b1a027a36fc6",
                                                "sense_id": "8efe9bd6-4dbe-3184-bc38-02dea586a2d2",
                                                "text": "la maggior parte dei loghi è cucita con filo di seta"
                                            }
                                        ]
                                    }
                                ]
                            }
