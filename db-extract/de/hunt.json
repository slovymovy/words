                    }
                ],
                "senses": [
                    {
                        "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                        "entry_id": "19de924c-dbb2-3bcd-ba7b-c7c502beb0e7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94020aa6-8507-4df0-9474-055638301564",
                                "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                                "text": "Frau Hunt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "edb1708f-d599-472c-bd07-eb4d0f41eb05",
                                "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                                "text": "Herr Hunt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "45c5ec5d-5139-4178-9013-61d7f4f5d757",
                                "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                                "text": "Die Hunts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "dab03823-5606-4367-a421-f8b71271c352",
                                "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                                "text": "Der Hunt trägt nie die Schals, die die Hunt ihm strickt."
                            },
                            {
                                "example_id": "554b88c9-9039-4528-a0fc-2dbc472a4b71",
                                "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hunt kommt, geht der Herr Hunt.“"
                            },
                            {
                                "example_id": "fffd25e5-8912-4934-9048-fd8a33c1edac",
                                "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                                "text": "Hunt kommt und geht."
                            },
                            {
                                "example_id": "4816a831-c566-459d-b808-8222b6b932a4",
                                "sense_id": "51de802a-3bb6-35e8-869c-7e79a5a50226",
                                "text": "Hunts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
