                "senses": [
                    {
                        "sense_id": "07c9f74c-0dcc-39fc-abd0-38843aa04a79",
                        "entry_id": "b9298865-d48c-32e7-9d31-eaba525c1ca9",
                        "glosses": [
                            "Action de marteler, de frapper avec un marteau ou un maillet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9ebf68-bd1a-4f92-ad7a-1913da56ece9",
                                "sense_id": "07c9f74c-0dcc-39fc-abd0-38843aa04a79",
                                "text": "Objet rehaussé d'or par martèlement, le martèlement du métal sur l'enclume."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5f3f962-c5a8-36cb-a11c-83d8b523a605",
                        "entry_id": "b9298865-d48c-32e7-9d31-eaba525c1ca9",
                        "glosses": [
                            "Bruit cadencé rappelant celui des coups de marteau."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "314548fe-e105-4648-b6fe-5217122e6079",
                                "sense_id": "e5f3f962-c5a8-36cb-a11c-83d8b523a605",
                                "text": "A cet instant, dans le passage, d'autres voix s'élevèrent, accompagnées d'un martèlement de pas précipités."
                            },
                            {
                                "example_id": "fba664f5-8a8b-4ad7-9e49-2f7209581736",
                                "sense_id": "e5f3f962-c5a8-36cb-a11c-83d8b523a605",
                                "text": "La fin ressemblait plus à un épuisement qu'à un arrêt — un diminuendo où le martèlement du rythme se changea en un chuchotement qui se prolongea bien au-delà du vrai silence où il finit par se fondre."
                            },
                            {
                                "example_id": "05220993-66d3-4031-82c0-c46125749366",
                                "sense_id": "e5f3f962-c5a8-36cb-a11c-83d8b523a605",
                                "text": "Seule sur scène, rythmant son chant du martèlement de ses mains sur une calebasse, ou bien accompagnée seulement d’un percussionniste et d’un accordéon : Nathalie Natiembé redonne vie au maloya, ce chant de la Réunion qui est de la poésie chantée."
                            }
                        ]
                    },
                    {
                        "sense_id": "2802322e-5f90-31f4-b8c9-2982741ab350",
                        "entry_id": "b9298865-d48c-32e7-9d31-eaba525c1ca9",
                        "glosses": [
                            "Action de répéter avec insistance mots, messages, paroles etc. → voir matraquage"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ad7bce74-1f7e-41dc-bdf0-24ad2edaccae",
                                "sense_id": "2802322e-5f90-31f4-b8c9-2982741ab350",
                                "text": "Martèlement médiatique, martèlement publicitaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fb5591a-0594-4c0c-a25d-c43527e729a0",
                        "source_entry_id": "b9298865-d48c-32e7-9d31-eaba525c1ca9",
                        "source_sense_description": "Action de marteler, de frapper avec un marteau ou un maillet.",
                        "target_lang_word": "Hämmern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämmern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                        "entry_id": "8fee665d-b517-386e-9c74-b5715a20a892",
                                        "glosses": [
                                            "hämmerndes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513e890c-aded-4904-95a5-e3945ef60691",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Derweil säuseln die Motoren wieder leiser und das Hämmern der Rotoren wird gemächlicher.“"
                                            },
                                            {
                                                "example_id": "7806ba47-1a22-4d79-b914-e889d340cf58",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Aus dem Klopfen wurde ein Hämmern, und dann trat jemand gegen die Tür.“"
                                            },
                                            {
                                                "example_id": "b3b26322-3c61-447f-a6c0-8aa97411f85a",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Vom Flur dröhnt lautes Hämmern herein.“"
                                            },
                                            {
                                                "example_id": "297b411a-e284-4b6a-b502-adced539f1d2",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Das Hämmern gegen die Wand hatte aufgehört, aber Kurtz hörte weiterhin die Rufe der Nachbarn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
