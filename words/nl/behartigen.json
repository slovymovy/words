            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1f9289e-c067-35cd-994d-53627bf52c2e",
                    "sense_definition": "zorg dragen voor of opkomen voor de belangen van iemand of iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belangenbehartiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>behartigde</w> de belangen van haar minderjarige zoon tijdens de rechtszaak.",
                            "target_lang_translations": {
                                "en": "She <w>looked after</w> the interests of her minor son during the lawsuit."
                            }
                        },
                        {
                            "text": "Onze organisatie probeert de belangen van alle werknemers zo goed mogelijk te <w>behartigen</w>.",
                            "target_lang_translations": {
                                "en": "Our organization tries to <w>represent</w> the interests of all employees as well as possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzorgen"
                    ],
                    "common_phrases": [
                        "belangen behartigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to look after or stand up for the interests of someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to look after",
                                "target_lang_sense_clarification": "interests or welfare"
                            },
                            {
                                "target_lang_word": "to represent",
                                "target_lang_sense_clarification": "interests in a formal context"
                            },
                            {
                                "target_lang_word": "to promote",
                                "target_lang_sense_clarification": "interests or causes"
                            },
                            {
                                "target_lang_word": "to safeguard",
                                "target_lang_sense_clarification": "protecting interests"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec26cc64-7f79-3349-8e58-9eb2993611a6",
                    "sense_definition": "zich actief inzetten voor een bepaalde zaak of taak",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belangenbehartiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat zal uw zaak met de grootste zorg <w>behartigen</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer will <w>handle</w> your case with the greatest care."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat iemand deze taak serieus gaat <w>behartigen</w>.",
                            "target_lang_translations": {
                                "en": "It is important that someone starts to <w>attend to</w> this task seriously."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een zaak behartigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to actively commit oneself to a specific case, task, or matter"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to handle",
                                "target_lang_sense_clarification": "a case or task"
                            },
                            {
                                "target_lang_word": "to attend to",
                                "target_lang_sense_clarification": "a matter or duty"
                            },
                            {
                                "target_lang_word": "to take care of",
                                "target_lang_sense_clarification": "a specific responsibility"
                            }
                        ]
                    }
                }
            ]
        }
