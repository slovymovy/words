                                "target_senses": [
                                    {
                                        "sense_id": "a23f7b6c-4f05-3269-bea9-a4a709f52304",
                                        "entry_id": "5eb6a4d0-182e-3cf2-9e6c-403e8d024063",
                                        "glosses": [
                                            "Ville biblique citée dans la Genèse (15–18) et qui aurait été située au sud de la mer Morte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2393cd43-1f94-447d-bbcf-4a849795c15b",
                                                "sense_id": "a23f7b6c-4f05-3269-bea9-a4a709f52304",
                                                "text": "Et il aboutissait enfin, au crépuscule, à ce Paris Gomorrhe, à ce Paris Sodome, s’allumant pour la nuit, pour les abominations de cette nuit complice, dont la cendre fine, peu à peu, noyait l’océan des toitures."
                                            },
                                            {
                                                "example_id": "10e8d92f-7d50-4b2a-a9a7-52d1e5cde1a8",
                                                "sense_id": "a23f7b6c-4f05-3269-bea9-a4a709f52304",
                                                "text": "Sodome est la ville du Secret, et Gomorrhe est la ville de la Rébellion."
                                            },
                                            {
                                                "example_id": "fb4d40bc-06ad-4732-bd78-7843f9da0a6a",
                                                "sense_id": "a23f7b6c-4f05-3269-bea9-a4a709f52304",
                                                "text": "Le cygne devient une des images fin-de-siècle violemment ironiques de la faillite de l’éros romantique, triomphe malgré lui du désir narcissique transposé, sadicisé, ange violé de Sodome que nul Dieu ne venge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
