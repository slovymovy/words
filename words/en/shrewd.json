                            {
                                "target_lang_word": "niegodziwy",
                                "target_lang_sense_clarification": "o postępku lub wieściach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f058d742-99e4-3f6c-a287-2d3ebd26b722",
                    "sense_definition": "Portending or boding ill; ominous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds were a <w>shrewd</w> sign of the violent storm that was to come.",
                            "target_lang_translations": {
                                "pl": "Ciemne chmury były <w>złowrogim</w> znakiem nadchodzącej gwałtownej burzy."
                            }
                        },
                        {
                            "text": "She had a <w>shrewd</w> feeling that their journey would end in disaster.",
                            "target_lang_translations": {
                                "pl": "Miała <w>złowieszcze</w> przeczucie, że ich podróż zakończy się katastrofą."
                            }
                        }
