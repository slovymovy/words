                                                "example_id": "ce4e5205-327b-4da5-af53-39c1ddfbf3c8",
                                                "sense_id": "b261db1f-ceb2-3762-8e3f-69bf41f9a43c",
                                                "text": "„Daher wurde er festgenommen, ohne Rücksicht auf seine Immunität.“"
                                            },
