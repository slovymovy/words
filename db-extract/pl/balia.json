                    {
                        "translation_id": "047ef812-1625-45a7-998e-9c1977ae7e99",
                        "source_entry_id": "6b61d09a-11c6-3098-bb6e-d7c6514f8715",
                        "source_sense_id": "46115452-9b5e-3c58-bb8f-d5575c22adbf",
                        "target_lang_word": "cuvier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuvier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce85d03-0739-333f-812e-799cf53fb0c1",
                                        "entry_id": "175202b2-4d43-30ed-b805-4433a227052a",
                                        "glosses": [
                                            "Cuve où l’on fait la lessive, où l’on prend son bain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed6758d-6e27-413c-ae78-5cc76cf2030a",
                                                "sense_id": "0ce85d03-0739-333f-812e-799cf53fb0c1",
                                                "text": "Le linge sera trempé pièce à pièce dans la lessive de cendres, ou dans la solution de potasse ; on l’exprimera légèrement et on le déposera à mesure dans le cuvier, en l’étendant de manière qu’il y ait le moins de vide possible, pour que l’eau qui sera jetée dessus ne puisse pas se frayer des routes par lesquelles elle s’écoulerait trop promptement, et qu’elle soit forcée de traverser toute la masse."
                                            },
                                            {
                                                "example_id": "e672b4bc-8bb7-4fe9-a2af-5faeec6353bd",
                                                "sense_id": "0ce85d03-0739-333f-812e-799cf53fb0c1",
                                                "text": "Elle l’avait mené à gauche, près de la cuisine, dans une pièce qui servait de buanderie. Un cuvier y était plein d’eau savonneuse, pendant que le linge, jeté sur des barres de bois, ruisselait."
                                            },
                                            {
                                                "example_id": "18d8faf2-e5ea-43f2-9256-8088e47da6c4",
                                                "sense_id": "0ce85d03-0739-333f-812e-799cf53fb0c1",
                                                "text": "Un cuvier de terre, haut comme un enfant de dix ans, barbotait sur un petit feu."
                                            },
                                            {
                                                "example_id": "b185f788-0006-429c-b2f8-aa0363fc7b74",
                                                "sense_id": "0ce85d03-0739-333f-812e-799cf53fb0c1",
                                                "text": "Les sept Démons qu’enfin vous vîntes châtier,\nEn des cruches de plomb qui corrodent leurs bouches,\nPuisent des pleurs bouillants au fond d’un noir cuvier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff127253-4eb9-4b84-adb1-851757ed3c7f",
                        "source_entry_id": "6b61d09a-11c6-3098-bb6e-d7c6514f8715",
                        "source_sense_id": "46115452-9b5e-3c58-bb8f-d5575c22adbf",
