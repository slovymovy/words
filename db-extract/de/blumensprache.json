                ],
                "senses": [
                    {
                        "sense_id": "e07bfd9e-f394-30a9-aeca-42e27135fb53",
                        "entry_id": "dae111ec-658c-32d2-a752-3696b3009711",
                        "glosses": [
                            "nonverbale Kommunikation durch Wahl bestimmter Blumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d255b7a-2784-4d12-9d41-46b5977c4b07",
                                "sense_id": "e07bfd9e-f394-30a9-aeca-42e27135fb53",
                                "text": "„Ich rätselte, was mein Vater mir damit sagen wollte, der als Botaniker sonst die Blumensprache nur in Form von lateinischen Arten- und Gattungsnamen beherschte, die er wie Zaubersprüche vor sich hin murmelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6fa3e1d-0d00-4dab-8347-c24397426647",
                        "source_entry_id": "dae111ec-658c-32d2-a752-3696b3009711",
                        "source_sense_id": "e07bfd9e-f394-30a9-aeca-42e27135fb53",
                        "source_sense_description": "nonverbale Kommunikation mit Blumen",
                        "target_lang_word": "language of flowers",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "language of flowers",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cac901b-cac1-3c8b-a58c-fd9b154aa3a3",
                                        "entry_id": "6057ace9-890f-36ed-8eca-168318a440c6",
                                        "glosses": [
                                            "Secret communication through the use of flowers; floriography."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a252d3b5-b389-49e2-a9de-1758f9d0ae50",
                                                "sense_id": "4cac901b-cac1-3c8b-a58c-fd9b154aa3a3",
                                                "text": "Perhaps she just looked first into the bouquet, to see whether there was a billet-doux hidden among the flowers; but there was no letter. \"Do they talk the language of flowers at Boggley Wollah, Sedley?\" asked Osborne, laughing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "486b20e8-b474-4311-a115-03a027c73d1e",
                        "source_entry_id": "dae111ec-658c-32d2-a752-3696b3009711",
                        "source_sense_id": "e07bfd9e-f394-30a9-aeca-42e27135fb53",
                        "source_sense_description": "nonverbale Kommunikation mit Blumen",
                        "target_lang_word": "floriography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floriography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                        "entry_id": "740adeff-9850-32b0-89d6-5b5d0447c82b",
                                        "glosses": [
                                            "Communication through the use of flowers, with different types of flowers having particular symbolic meanings."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52d2cac5-eaff-4da9-b180-103a2e9faa19",
                                                "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                                "text": "Floriography is a science that requires but little study. Some flowers almost bear written upon their upturned faces the thoughts of which they are living representatives."
                                            },
                                            {
                                                "example_id": "d57efa41-ee08-42ec-8b74-8f024c03d3e4",
                                                "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                                "text": "Time was, the author assures us, \"when no gallant knight or gentle dame could aspire to good breeding unless perfectly conversant with floriography.\""
                                            },
                                            {
                                                "example_id": "56fcae25-7bdd-455d-870e-a14932aa92e0",
                                                "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                                "text": "Victorians also gloried in \"floriography\", or written alphabets of flowers that assigned each flower a certain quality, such as friendship, hope, or gratitude."
                                            },
                                            {
                                                "example_id": "92392b9a-6272-4f0f-827f-c544803bba12",
                                                "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                                "text": "Floriography became popular in Victorian times when strict etiquette didn't allow women to express their feelings freely. So they did it coyly, using the silent language of flowers to express their sentiments to their admirers, and vice versa."
                                            },
                                            {
                                                "example_id": "aaac0b80-598d-413d-ade6-bd7e9ba74297",
                                                "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                                "text": "Just as many cultures help create the global economy, so do countless floriographies manifest peribology."
                                            },
                                            {
                                                "example_id": "65ff2c7d-3d2e-472c-9483-6ece7bdc7d6b",
                                                "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                                "text": "Floriography was popular in Victorian times. Bouquets called tussy-mussies were sent as coded messages, allowing the sender to express feelings that couldn't be spoken aloud. You could say almost anything with flowers, in the right combination."
                                            },
                                            {
                                                "example_id": "dbf80d9b-1f81-4f1d-b21a-54b366a0ebb2",
                                                "sense_id": "b37536fd-0eea-3cc1-a6d8-404c682e14ae",
                                                "text": "Hundreds of flowers were assigned meanings in floriographies of the day. A yellow carnation signified disappointment or rejection, hibiscus meant consumed by love, elderflower symbolized zeal, lavender stood for love and violet indicated modesty or virtue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fde77c5d-c6a6-4f29-969e-18b87d72b35a",
                        "source_entry_id": "dae111ec-658c-32d2-a752-3696b3009711",
                        "source_sense_id": "e07bfd9e-f394-30a9-aeca-42e27135fb53",
                        "source_sense_description": "nonverbale Kommunikation mit Blumen",
                        "target_lang_word": "langage des fleurs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langage des fleurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db8b1274-fbed-34b1-a92a-6192de435f96",
                                        "entry_id": "bf9abad9-3fd1-3f1b-a520-6e60a8b86951",
                                        "glosses": [
                                            "Langage symbolique dans lequel les fleurs, soit isolées, soit assemblées suivant un certain choix, servent à exprimer une pensée, un sentiment secret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb14f811-b703-4e22-a5a7-5f742c45178e",
                                                "sense_id": "db8b1274-fbed-34b1-a92a-6192de435f96",
                                                "text": "Le langage des fleurs tombe en désuétude, mais il ne tient qu'à nous de le faire perdurer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
