                        "form": "dem Einfallsreichtum"
                    },
                    {
                        "form_id": "7ec9f4f6-5507-4f08-8377-d367956996ac",
                        "entry_id": "cecfbfaf-8f59-3ce2-a52c-df636974b75b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Einfallsreichtum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                        "entry_id": "cecfbfaf-8f59-3ce2-a52c-df636974b75b",
                        "glosses": [
                            "Vorhandensein vieler Einfälle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "844a60da-80cd-4b87-b078-b6bc87b2a92a",
                                "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                "text": "„Nur wird fantasievoller und witziger geschimpft - und man hat den Eindruck, dem Einfallsreichtum der Schimpfenden sind keine Grenzen gesetzt.“"
                            },
                            {
                                "example_id": "80e67d5a-65d7-481b-9bc1-70e41380840f",
                                "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                "text": "„Was sie auszeichnete, war einzig ein gewisser Einfallsreichtum an Verwahrlosung, der sich bis auf die Straßen und in die Hinterhöfe fortsetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe5c92ba-6698-472b-99b6-85a75388c1c8",
                        "source_entry_id": "cecfbfaf-8f59-3ce2-a52c-df636974b75b",
                        "source_sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                        "source_sense_description": "Vorhandensein vieler Einfälle",
                        "target_lang_word": "resourcefulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resourcefulness",
