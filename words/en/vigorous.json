    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87c4171c-41e2-3718-8550-d35ebc344036",
                    "sense_definition": "Physically strong, healthy, and active.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete performed a <w>vigorous</w> workout at the gym this morning.",
                            "target_lang_translations": {
                                "zh": "这位运动员今天早上在健身房进行了一次<w>精力充沛的</w>锻炼。"
                            }
                        },
                        {
                            "text": "She gave the floor a <w>vigorous</w> scrub to remove the stubborn stains.",
                            "target_lang_translations": {
                                "zh": "她<w>用力地</w>擦洗地板，以去除顽固的污渍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "energetic",
                        "robust",
                        "sturdy"
                    ],
                    "antonyms": [
                        "weak",
                        "feeble"
                    ],
                    "common_phrases": [
                        "vigorous exercise",
                        "vigorous activity"
                    ],
                    "target_lang_definitions": {
                        "zh": "身体强壮、健康且充满活力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "精力充沛的",
                                "target_lang_sense_clarification": "形容人或状态充满活力。"
                            },
                            {
                                "target_lang_word": "强健的",
                                "target_lang_sense_clarification": "形容身体素质好。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c928cd98-1a25-3522-bc31-2cf2151f85db",
                    "sense_definition": "Characterized by forceful, energetic, or intense mental effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor led a <w>vigorous</w> debate about the future of modern technology.",
                            "target_lang_translations": {
                                "zh": "教授主持了一场关于现代科技未来的<w>激烈</w>辩论。"
                            }
                        },
                        {
                            "text": "He launched a <w>vigorous</w> defense of his controversial political ideas.",
                            "target_lang_translations": {
                                "zh": "他对他那些有争议的政治观点进行了<w>强有力</w>的辩护。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forceful",
                        "spirited",
                        "intense"
                    ],
                    "antonyms": [
                        "passive",
                        "lethargic"
                    ],
                    "common_phrases": [
                        "vigorous debate",
                        "vigorous defense"
                    ],
                    "target_lang_definitions": {
                        "zh": "以强有力、充满活力或激烈的精神投入为特征。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "激烈的",
                                "target_lang_sense_clarification": "形容辩论或讨论非常深入且有力度。"
                            },
                            {
                                "target_lang_word": "强有力的",
                                "target_lang_sense_clarification": "形容行动或辩护具有说服力和气势。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1390eeef-24c6-3b86-90a7-72e6d6ed895e",
                    "sense_definition": "Growing or developing quickly and healthily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden is full of <w>vigorous</w> shrubs that need regular pruning.",
                            "target_lang_translations": {
                                "zh": "花园里种满了需要定期修剪的<w>茁壮</w>灌木。"
                            }
                        },
                        {
                            "text": "These plants show <w>vigorous</w> growth despite the lack of direct sunlight.",
                            "target_lang_translations": {
                                "zh": "尽管缺乏直射阳光，这些植物依然<w>茁壮</w>生长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thriving",
                        "flourishing"
                    ],
                    "antonyms": [
                        "stunted"
                    ],
                    "common_phrases": [
                        "vigorous growth"
                    ],
                    "target_lang_definitions": {
