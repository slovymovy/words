                    "frequency": "High",
                    "semantic_group_id": "action de couper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>coupe</w> le pain avec un grand couteau."
                        },
                        {
                            "text": "Maman <w>coupe</w> les carottes pour préparer la soupe."
                        },
                        {
                            "text": "Nous <w>coupons</w> le gâteau en morceaux égaux pour tout le monde."
                        }
                    ],
                    "synonyms": [
                        "trancher"
                    ],
                    "common_phrases": [
                        "couper en morceaux",
                        "couper en deux",
                        "couper une tranche"
                    ]
                },
                {
