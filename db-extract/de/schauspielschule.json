                ],
                "senses": [
                    {
                        "sense_id": "4de79289-292c-3ef4-a351-044ec7dc915f",
                        "entry_id": "d653a48f-3885-3953-97e1-a203e1edd1cc",
                        "glosses": [
                            "Bildungseinrichtung, in der Schauspieler ausgebildet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f3debe-08b4-4e51-8292-60aef46592fc",
                                "sense_id": "4de79289-292c-3ef4-a351-044ec7dc915f",
                                "text": "„Er arbeitete erst als Sargtischler, schaffte es aber, bei einer Schauspielschule angenommen zu werden.“"
                            },
                            {
                                "example_id": "faff6e5d-044c-4585-86cf-4a99296cf9f8",
                                "sense_id": "4de79289-292c-3ef4-a351-044ec7dc915f",
                                "text": "„Nachdem er auf seine Fragen nach ihrer Zukunft nur ein vages Schulterzucken zur Antwort erhalten hatte, bot er ihr beim Tanz einfach an, sie am nächsten Tag zu der Schauspielschule mitzunehmen, die er sei kurzem besuchte.“"
                            },
                            {
                                "example_id": "3012a4de-69ec-40fc-b6ca-6cf54d341c1e",
                                "sense_id": "4de79289-292c-3ef4-a351-044ec7dc915f",
                                "text": "„Ich hatte eine besonders positive Erfahrung beim Besuch einer professionellen Schauspielschule in Schönbrunn, des Max-Reinhardt-Seminars, wie sie früher hieß, die heute aber unter völlig neuer Leitung arbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
