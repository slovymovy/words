                "senses": [
                    {
                        "sense_id": "66994772-4ded-375d-8280-4b3d1844a7ad",
                        "entry_id": "8631cbdc-22e4-316d-b315-b85203719ff0",
                        "glosses": [
                            "The property of two or more appearances of being of the selfsame underlying object; sameness as regards self or identity; identity; identicality."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "00829e95-afb5-46fd-8f5b-6ab3963b0f49",
                                "sense_id": "66994772-4ded-375d-8280-4b3d1844a7ad",
                                "text": "There is no doubt about the selfsameness of the morning Sun with the evening Sun."
                            },
                            {
                                "example_id": "0aa4a533-ef6b-4922-a183-e7b05674d69c",
                                "sense_id": "66994772-4ded-375d-8280-4b3d1844a7ad",
                                "text": "Now the first condition of the possibility of my guiltiness, or of my becoming a subject for moral imputation, is my self-sameness; I must be throughout one identical person."
                            }
                        ]
                    }
                ],
