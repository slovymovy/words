    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8ceb189-3011-3436-a3e8-0d19975ab503",
                    "sense_definition": "Operated, controlled, or occupied by a person or crew.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The space agency is planning a <w>manned</w> mission to Mars within the next decade.",
                            "target_lang_translations": {
                                "ru": "Космическое агентство планирует <w>пилотируемую</w> миссию на Марс в течение следующего десятилетия."
                            }
                        },
                        {
                            "text": "The security gate is a <w>manned</w> station where guards check every vehicle entering the facility.",
                            "target_lang_translations": {
                                "ru": "Ворота безопасности — это <w>обслуживаемый</w> пост, где охранники проверяют каждое транспортное средство, въезжающее на объект."
                            }
                        }
                    ],
                    "synonyms": [
                        "crewed",
                        "piloted",
                        "staffed"
                    ],
                    "antonyms": [
                        "unmanned",
                        "uncrewed"
                    ],
                    "common_phrases": [
                        "manned mission",
                        "manned flight",
                        "manned station"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управляемый, контролируемый или занятый человеком или экипажем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилотируемый",
                                "target_lang_sense_clarification": "о космических аппаратах или самолетах"
                            },
                            {
                                "target_lang_word": "обитаемый",
                                "target_lang_sense_clarification": "о станциях или модулях"
                            },
                            {
                                "target_lang_word": "обслуживаемый персоналом",
                                "target_lang_sense_clarification": "о постах или контрольных пунктах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ce36fcf-6d46-335d-a3a2-6e3bcd1c6323",
                    "sense_definition": "The past tense and past participle of <w>man</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "past_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors <w>manned</w> the lifeboats as soon as the alarm sounded throughout the ship.",
                            "target_lang_translations": {
                                "ru": "Матросы <w>заняли места</w> в спасательных шлюпках, как только по всему кораблю прозвучал сигнал тревоги."
                            }
                        },
                        {
                            "text": "Volunteers <w>manned</w> the phones all night to raise money for the local charity.",
                            "target_lang_translations": {
                                "ru": "Волонтеры всю ночь <w>дежурили</w> на телефонах, чтобы собрать деньги для местной благотворительной организации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "manned the phones",
                        "manned the booth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени глагола «man» (укомплектовывать людьми, занимать пост)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укомплектовали",
                                "target_lang_sense_clarification": "заняли рабочие места или посты"
                            },
                            {
                                "target_lang_word": "дежурили",
                                "target_lang_sense_clarification": "находились на посту или у телефона"
                            }
                        ]
                    }
                }
            ]
        }
