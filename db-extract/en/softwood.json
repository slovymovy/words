                    {
                        "translation_id": "741327f7-73f1-465a-866b-46912a17ad63",
                        "source_entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                        "source_sense_description": "commercial timber in general",
                        "target_lang_word": "Holz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e6258c-f31c-34ba-b0b1-311e786701bf",
                                        "entry_id": "ddd0c2ca-11ca-3c80-a1e0-c6c93a29e1d4",
                                        "glosses": [
                                            "aus Zellulose und Lignin bestehende Masse eines Baumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a017da86-4a7b-47e3-8be4-f1996e282cce",
                                                "sense_id": "e0e6258c-f31c-34ba-b0b1-311e786701bf",
                                                "text": "Das Holz ist morsch."
                                            },
                                            {
                                                "example_id": "80be386c-08b6-4bc6-b78d-a1430200fe99",
                                                "sense_id": "e0e6258c-f31c-34ba-b0b1-311e786701bf",
                                                "text": "„Neue Wälder liefern mehr Holz.“"
                                            },
                                            {
                                                "example_id": "a862ec5f-f06b-493e-914e-381c377411da",
                                                "sense_id": "e0e6258c-f31c-34ba-b0b1-311e786701bf",
                                                "text": "„Seit Jahrtausenden nutzten die Menschen eine Vielzahl von Energiequellen: Sie verbrannten organische Materialien wie Holz und machten Naturgewalten wie Wind- und Wasserkraft nutzbar.“"
                                            },
                                            {
                                                "example_id": "a0edbb07-a5df-4552-9a95-7df64f2f78f8",
                                                "sense_id": "e0e6258c-f31c-34ba-b0b1-311e786701bf",
                                                "text": "„Es war mal ein Eierbecher,",
                                                "translation": "anders als die Andern halt“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51ab7214-de62-387f-ae0d-87c0befe7ce2",
                                        "entry_id": "ddd0c2ca-11ca-3c80-a1e0-c6c93a29e1d4",
                                        "glosses": [
                                            "kleiner Wald"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "645c896f-5d27-4445-b06e-2b883e1330ce",
                                                "sense_id": "51ab7214-de62-387f-ae0d-87c0befe7ce2",
                                                "text": "Das Haus im Holz liegt inmitten wunderschönster Natur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bbafae36-087a-393f-9c80-7c797619b9b4",
                                        "entry_id": "ddd0c2ca-11ca-3c80-a1e0-c6c93a29e1d4",
                                        "glosses": [
                                            "(Wesens)Art, Konstitution"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3296e83e-2c64-41dd-9bbe-7de99c1486e9",
                                                "sense_id": "bbafae36-087a-393f-9c80-7c797619b9b4",
                                                "text": "Danas neuer Verlobter ist schon aus dem rechten Holz geschnitzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e9d8dbe0-eefa-33f9-b89e-01cf18cbf80d",
                                        "entry_id": "ddd0c2ca-11ca-3c80-a1e0-c6c93a29e1d4",
                                        "glosses": [
                                            "Gesamtheit der Holzblasinstrumente im Orchester"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6edcf58-6f39-43eb-9e74-ba21ad5b45c7",
                                                "sense_id": "e9d8dbe0-eefa-33f9-b89e-01cf18cbf80d",
                                                "text": "Der zweite Satz der Suite wird vom Holz dominiert."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Holz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8296a5e-b4ed-3c40-8b33-5c9568eb5158",
                                        "entry_id": "36a4ecca-f2d3-37e8-9a0f-17aacf29c162",
                                        "glosses": [
                                            "Bezeichnung für einen Kegel"
                                        ],
                                        "tags": [
                                            "Kegelsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ca897b-0a9a-43dd-b566-ff10619928e1",
                                                "sense_id": "a8296a5e-b4ed-3c40-8b33-5c9568eb5158",
                                                "text": "„Damit der Spieler deshalb nicht mit Absicht einen Pudel (d.h. in die Rinne neben der Bahn) wirft, muss er solange werfen, bis er mindestens ein Holz getroffen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a440bf3-adcc-380c-a4a4-437e56e0a41c",
                                        "entry_id": "36a4ecca-f2d3-37e8-9a0f-17aacf29c162",
                                        "glosses": [
                                            "Bezeichnung für einen früher aus Holz gefertigten Golfschläger"
                                        ],
                                        "tags": [
                                            "Golfsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7158d54c-a1dc-435f-86de-71c6bd635bd0",
                                                "sense_id": "4a440bf3-adcc-380c-a4a4-437e56e0a41c",
                                                "text": "Wir führen alle Hölzer, die Sie zum Golfspielen brauchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Holz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50994f3a-690b-322c-9e8f-e79951def3a7",
                                        "entry_id": "4bd75ed6-6e64-3a8a-8843-a90bfb591a3e",
