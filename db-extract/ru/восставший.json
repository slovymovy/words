                "senses": [
                    {
                        "sense_id": "7460c46b-f4b5-36fc-af06-7b451039e95b",
                        "entry_id": "499a0d79-a973-3b1a-b57f-2c0a19d7e5cf",
                        "glosses": [
                            "действ. прич. прош. вр. от восстать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "8312aa27-a092-49f7-a814-9ecb8f5d2a89",
                                "sense_id": "7460c46b-f4b5-36fc-af06-7b451039e95b",
                                "text": "Ангел восставший, отвергающий прощение, жаждущий любви, но любви не принимающий ― суть Диавол."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2616c15e-51d4-408f-84e3-49c659a72733",
                        "source_entry_id": "499a0d79-a973-3b1a-b57f-2c0a19d7e5cf",
                        "source_sense_id": "7460c46b-f4b5-36fc-af06-7b451039e95b",
                        "target_lang_word": "rebel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25891337-b37b-3e99-bfe3-15d4d0b74b9e",
                                        "entry_id": "118f1483-cbb3-3f0d-951b-72fb535cdda6",
                                        "glosses": [
                                            "A person who resists an established authority, often violently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e51d2e5-2e4d-4f3c-8d78-2228b3adb803",
                                                "sense_id": "25891337-b37b-3e99-bfe3-15d4d0b74b9e",
                                                "text": "My little sister is such a rebel - coming home late, piercing her ears, and refusing to do any of her chores."
                                            },
                                            {
                                                "example_id": "c2ad80ea-37a3-41df-bce6-1dab58c41e71",
                                                "sense_id": "25891337-b37b-3e99-bfe3-15d4d0b74b9e",
                                                "text": "A group of rebels defied the general's orders and split off from the main army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4962e93-8bca-3b56-a373-0e8dcae94f8a",
                                        "entry_id": "118f1483-cbb3-3f0d-951b-72fb535cdda6",
                                        "glosses": [
