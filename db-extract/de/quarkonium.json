                ],
                "senses": [
                    {
                        "sense_id": "5db501c1-896d-3984-a8fe-7b1b2dc2c2de",
                        "entry_id": "e05abeed-8788-3ec4-b024-28c02785aed4",
                        "glosses": [
                            "gebundener Zustand zwischen einem Quark und seinem Antiquark"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e085ef-575a-42d2-83e1-7f02ba86dc40",
                                "sense_id": "5db501c1-896d-3984-a8fe-7b1b2dc2c2de",
                                "text": "„In der modernen Theorie der Elementarteilchen, der Quantenchromodynamik QCD ([…]) werden gebundene Systeme aus einem Quark und Antiquark als Quarkonium bezeichnet.“"
                            },
                            {
                                "example_id": "89466387-7fcf-4730-b9c6-b42c2fe2c83d",
                                "sense_id": "5db501c1-896d-3984-a8fe-7b1b2dc2c2de",
                                "text": "„Relativ zu den Massen sind die Niveauabstände und die Hyperfeinaufspaltungen viel grösser beim Quarkonium als beim Positronium.“"
                            },
                            {
                                "example_id": "c583ac58-d410-43ee-8692-5be9c93ba117",
                                "sense_id": "5db501c1-896d-3984-a8fe-7b1b2dc2c2de",
                                "text": "„Um ein möglichst genaues Bild der Quark-Antiquark-Wechselwirkung zu erhalten, sind die Zerfälle schwerer Quarkonia sehr genau untersucht worden.“"
                            },
                            {
                                "example_id": "47b9c5cd-cc5b-42bc-a330-d6b4d50357f9",
                                "sense_id": "5db501c1-896d-3984-a8fe-7b1b2dc2c2de",
                                "text": "„Die Masse des Quarks tritt in Quarkonia nur bei Spin-Spin-Aufspaltung in Erscheinung.“"
                            },
                            {
                                "example_id": "822af306-2fbe-420b-8599-94a4d02b0b89",
                                "sense_id": "5db501c1-896d-3984-a8fe-7b1b2dc2c2de",
                                "text": "„Atome aus Quark und Antiquark der gleichen Sort nennen wir Quarkonium.“"
                            },
                            {
                                "example_id": "e41b34b9-159e-4134-adfd-1076e1566c38",
                                "sense_id": "5db501c1-896d-3984-a8fe-7b1b2dc2c2de",
                                "text": "„Eine weitere Konsequenz war die Voraussage einer besonderen Art von Quarkonium: dem Charmonium, einem gebundenen Zustand aus einem Charm- und Charm-Antiquark.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
