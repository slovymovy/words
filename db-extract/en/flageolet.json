                                        "glosses": [
                                            "sehr hohe flötenartige Töne der Saiteninstrumente von geheimnisvoll zartem Klangcharakter, die bei leichtem Berühren der gedämpften Saiten an den Schwingungsknotenpunkten entstehen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9ec8223-8c52-4a10-9652-41241af4fd54",
                                                "sense_id": "43e527ac-4368-3fd2-98ce-8c5f2c739c33",
                                                "text": "„Das Flageolett wird seit Mitte des 18. Jh. angewendet. Durch Paganini wurde es virtuos entwickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3c407e13-3141-3d56-8c6e-ca06d5f87a87",
