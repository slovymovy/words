{
    "word_family": [
        "ругать",
        "ругань",
        "ругательство"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63d9f425-67c8-3499-b1bc-81362faee4a0",
                    "sense_definition": "Ссориться с кем-либо, вести разговор на повышенных тонах с взаимными упрёками.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мои соседи постоянно <w>ругаются</w> из-за громкой музыки.",
                            "target_lang_translations": {
                                "en": "My neighbors constantly <w>argue</w> because of the loud music.",
                                "tr": "Komşularım yüksek sesli müzik yüzünden sürekli <w>kavga ediyorlar</w>."
                            }
                        },
                        {
                            "text": "Мы с братом часто <w>ругались</w> в детстве, но сейчас дружим.",
                            "target_lang_translations": {
                                "en": "My brother and I often <w>fought</w> in childhood, but now we are friends.",
                                "tr": "Erkek kardeşimle çocukken sık sık <w>tartışırdık</w> ama şimdi aramız iyi."
                            }
                        }
                    ],
                    "synonyms": [
                        "ссориться",
                        "браниться",
                        "скандалить"
                    ],
                    "antonyms": [
                        "мириться"
                    ],
                    "common_phrases": [
                        "постоянно ругаться",
                        "ругаться с мужем",
                        "ругаться из-за пустяков"
                    ],
                    "target_lang_definitions": {
                        "en": "To quarrel with someone, to have a heated conversation with mutual reproaches.",
                        "tr": "Biriyle kavga etmek, karşılıklı sitemlerle yüksek sesle tartışmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "argue",
                                "target_lang_sense_clarification": "to speak angrily to someone because of disagreement"
                            },
                            {
                                "target_lang_word": "quarrel",
                                "target_lang_sense_clarification": "to have an angry argument or disagreement"
                            },
                            {
                                "target_lang_word": "fight",
                                "target_lang_sense_clarification": "verbal conflict"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kavga etmek",
                                "target_lang_sense_clarification": "biriyle sözlü olarak tartışmak veya çekişmek"
                            },
                            {
                                "target_lang_word": "tartışmak",
                                "target_lang_sense_clarification": "karşılıklı olarak sert bir şekilde fikir ayrılığı yaşamak"
                            },
                            {
                                "target_lang_word": "atışmak",
                                "target_lang_sense_clarification": "karşılıklı laf dalaşına girmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f54de520-b4d6-3032-a9b0-bf433a510a0b",
                    "sense_definition": "Произносить грубые, оскорбительные или нецензурные слова.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда строитель ударил палец молотком, он начал громко <w>ругаться</w>.",
                            "target_lang_translations": {
                                "en": "When the builder hit his finger with a hammer, he started to <w>swear</w> loudly.",
                                "tr": "İnşaat işçisi çekici parmağına vurunca yüksek sesle <w>küfretmeye</w> başladı."
                            }
                        },
                        {
                            "text": "В приличном обществе не принято <w>ругаться</w> плохими словами.",
                            "target_lang_translations": {
                                "en": "In polite society, it is not customary to <w>swear</w> using bad words.",
                                "tr": "Kibar bir toplumda kötü sözlerle <w>küfretmek</w> hoş karşılanmaz."
                            }
                        }
                    ],
                    "synonyms": [
                        "браниться",
                        "нецензурно выражаться"
                    ],
                    "common_phrases": [
                        "громко ругаться",
                        "перестань ругаться",
                        "грязно ругаться"
                    ],
                    "target_lang_definitions": {
                        "en": "To utter rude, offensive, or obscene words.",
                        "tr": "Kaba, kırıcı veya küfürlü sözler söylemek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swear",
                                "target_lang_sense_clarification": "to use offensive language"
                            },
                            {
                                "target_lang_word": "curse",
                                "target_lang_sense_clarification": "to use bad words"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "küfretmek",
                                "target_lang_sense_clarification": "kötü ve argo kelimeler kullanmak"
                            },
                            {
                                "target_lang_word": "kötü söz söylemek",
                                "target_lang_sense_clarification": "kaba ve kırıcı konuşmak"
                            },
                            {
                                "target_lang_word": "küfürlü konuşmak",
                                "target_lang_sense_clarification": "argo ve küfür içeren ifadeler kullanmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b80cc023-8e93-3c66-a1f2-9b18d0f8ac2e",
                    "sense_definition": "Выражать гнев или недовольство чьим-либо поведением, делать выговор.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама будет сильно <w>ругаться</w>, если увидит беспорядок в моей комнате.",
                            "target_lang_translations": {
                                "en": "Mom will <w>scold</w> me severely if she sees the mess in my room.",
                                "tr": "Odamdaki dağınıklığı görürse annem çok <w>kızacak</w>."
                            }
                        },
                        {
                            "text": "Начальник <w>ругался</w> на сотрудников за постоянные опоздания.",
                            "target_lang_translations": {
                                "en": "The boss <w>told off</w> the employees for constant lateness.",
                                "tr": "Müdür, sürekli geç kaldıkları için çalışanlara <w>kızıyordu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "упрекать",
                        "ругать"
                    ],
                    "antonyms": [
                        "хвалить"
                    ],
                    "common_phrases": [
                        "мама будет ругаться",
                        "начальник ругается",
                        "ругаться на детей"
                    ],
                    "target_lang_definitions": {
                        "en": "To express anger or dissatisfaction with someone's behavior, to reprimand.",
                        "tr": "Birinin davranışına öfke veya memnuniyetsizlik göstermek, azarlamak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scold",
                                "target_lang_sense_clarification": "to reprimand someone for bad behavior"
                            },
                            {
                                "target_lang_word": "tell off",
                                "target_lang_sense_clarification": "to speak angrily to someone because they did something wrong"
                            },
                            {
                                "target_lang_word": "yell at",
                                "target_lang_sense_clarification": "to shout in anger"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kızmak",
                                "target_lang_sense_clarification": "birinin davranışına öfkelenip tepki göstermek"
                            },
                            {
                                "target_lang_word": "azarlamak",
                                "target_lang_sense_clarification": "birine yaptığı bir hatadan dolayı sert sözler söylemek"
                            },
                            {
                                "target_lang_word": "söylenmek",
                                "target_lang_sense_clarification": "memnuniyetsizliğini yüksek sesle dile getirmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}