                                            },
                                            {
                                                "example_id": "d98c210c-4ff5-4dd4-a970-72020a7b5247",
                                                "sense_id": "93493b7a-a17a-30a0-bdc2-c1118172ecb2",
                                                "text": "„Eineinhalb Tage wurde ich vermessen und gewogen, an einen Elektrokardiografen angeschlossen, zu Röntgenaufnahmen und Kniebeugen aufgefordert, mit Elektroden übersät.“"
                                            },
                                            {
                                                "example_id": "ed236f0a-c90b-4d0d-8e0f-3ac586bdb5f1",
                                                "sense_id": "93493b7a-a17a-30a0-bdc2-c1118172ecb2",
                                                "text": "„Nachmittags gelang es ihr, eine junge Assistenzschwester im Operationsraum zu überreden, ihr die letzten Röntgenaufnahmen zu zeigen, die von ihr gemacht worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
