                                "target_senses": [
                                    {
                                        "sense_id": "75d74d40-4a8c-32ef-8076-0b347b2d0b0e",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "The top or cover of a container."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6678c4ad-74bc-3ff8-b871-eaccb1c0562c",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "A cap or hat."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3addb513-7915-4e53-bf1e-a3ca5ab37e11",
                                                "sense_id": "6678c4ad-74bc-3ff8-b871-eaccb1c0562c",
                                                "text": "“Yes, sir, if that was the language of love, I'll eat my hat,” said the blood relation, alluding, I took it, to the beastly straw contraption in which she does her gardening, concerning which I can only say that it is almost as foul as Uncle Tom's Sherlock Holmes deerstalker, which has frightened more crows than any other lid in Worcestershire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ddd67c-e298-30a9-8b0d-70747108eb82",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "One ounce of cannabis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "975947c4-6466-367a-8180-5a279a4f7d86",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "A bodyboard or bodyboarder."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150206b2-e2fe-4484-8091-01237e0aed89",
                                                "sense_id": "975947c4-6466-367a-8180-5a279a4f7d86",
                                                "text": "Mal rider, shortboard or lid everyone surfs like a kook sometimes."
                                            },
                                            {
                                                "example_id": "615eec6a-7cd8-4a85-9722-aeac29f51996",
                                                "sense_id": "975947c4-6466-367a-8180-5a279a4f7d86",
                                                "text": "the rest of us managed to dodge out of control lid riders"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e990b550-2d73-3b02-9065-533d5e639ffa",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "An operculum or other lid-like cover."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02d9b25f-8d52-3abe-9797-c3352062f274",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "A motorcyclist's crash helmet."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67c3dbcb-dfe0-321b-9384-86c7681b82ee",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "In amateur radio, an incompetent operator."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39cbd98c-0c29-3588-9198-337f9c853549",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "Clipping of eyelid."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2325960d-6788-4f83-b7d0-0bbda89f7b6a",
                                                "sense_id": "39cbd98c-0c29-3588-9198-337f9c853549",
                                                "text": "But he suddenly started up, and, closing his eyes, placed his fingers upon the lids, as though he sought to imprison within his brain some curious dream from which he feared he might awake."
                                            },
                                            {
                                                "example_id": "a3babb2b-b727-4c75-bab7-3dc643f6923b",
                                                "sense_id": "39cbd98c-0c29-3588-9198-337f9c853549",
                                                "text": "Long after his cigar burnt bitter, he sat with eyes fixed on the blaze. When the flames at last began to flicker and subside, his lids fluttered, then drooped ; but he had lost all reckoning of time when he opened them again to find Miss Erroll in furs and ball-gown kneeling on the hearth[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9928c4f5-b304-33d3-b7ed-210175627be2",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "A hermetically sealed top piece on a microchip such as the integrated heat spreader on a CPU."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9de729d6-90fe-3470-b1c6-90edb1dbeab8",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "A restraint or control, as when \\\"putting a lid\\\" on something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b10e497e-1698-4c11-9d87-36153244d069",
                                                "sense_id": "9de729d6-90fe-3470-b1c6-90edb1dbeab8",
                                                "text": "Basically he says that there is a lid on my organization and on my future, and that lid is me. I am the problem with my company and you are the problem with your company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f04781ac-f26b-3436-b96e-a8c14a9a8f61",
                                        "entry_id": "e4bbb305-7a36-31d5-b069-6aade51c7adb",
                                        "glosses": [
                                            "A kid (from the rhyming slang bin lid)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
