                        "glosses": [
                            "S’enfanter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a667a5-ab6c-4667-b11f-3d9f6624be52",
                                "sense_id": "14ce5f82-3fb4-3120-8a04-431584f22b5b",
                                "text": "On a parfois l'impression, soulignait une québécoise d'origine vietnamienne, que « chacun doit s'auto-enfanter, s'auto-éduquer, s'inventer sans mémoire, sans conscience historique »."
                            },
                            {
                                "example_id": "3150ad6b-583e-46ba-b5b7-dc619ad05cd3",
                                "sense_id": "14ce5f82-3fb4-3120-8a04-431584f22b5b",
                                "text": "Une autre mode pop-psychologique exalte cet autre mythe aussi illusoire, celui de s'auto-enfanter soi-même, sans aucune filiation."
                            }
                        ]
