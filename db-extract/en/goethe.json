                                        "glosses": [
                                            "Nom de famille, essentiellement connu par l’homme de lettres allemand Johann Wolfgang von Goethe (1749-1832)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef4646c3-ed32-43c0-a686-af09958d3b78",
                                                "sense_id": "bc1ebd1d-2381-392e-a770-6c47d727bf89",
                                                "text": "Mais cette sonate née d’un songe luciférien, qui serait immortalisé par Goethe, avait le génie de certaines forces du mal."
                                            }
                                        ]
                                    }
                                ]
                            }
