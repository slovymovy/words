                        "examples": [
                            {
                                "example_id": "d9dfa5d0-6979-4958-ad06-295d5fc63a5c",
                                "sense_id": "7c214292-30e2-314f-a9e6-6ae43037fd62",
                                "text": "The house is hers'd about with a black wood, Which nods with many a heavy-headed tree: Each flower's a pregnant poison, try'd and good; Each herb a plague."
                            },
                            {
                                "example_id": "d73aba32-f7ba-4075-9ee9-2edae20737fb",
                                "sense_id": "7c214292-30e2-314f-a9e6-6ae43037fd62",
                                "text": "The Grecians spritefully drew from the darts the corse, And hers'd it, bearing it to fleet."
                            },
                            {
                                "example_id": "6f574d09-de08-432d-8145-2c1c4e4a488f",
                                "sense_id": "7c214292-30e2-314f-a9e6-6ae43037fd62",
                                "text": "I would my daughter were dead at my foot, and the jewels in her ear. O, would she were hers'd at my foot, and the ducats in her coffin."
                            }
                        ]
                    }
