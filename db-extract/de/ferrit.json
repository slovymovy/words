                "senses": [
                    {
                        "sense_id": "83fdcf94-efda-3cfc-9abb-94375fe8af49",
                        "entry_id": "43ffa88a-f9e5-35e7-889e-3580fe72bc0c",
                        "glosses": [
                            "metallografische Bezeichnung für reines Eisen mit einer kubisch-raumzentrierten Kristallstruktur"
                        ],
                        "tags": [
                            "Metallkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "69068703-8d27-4faa-93ec-7df4da2e5db2",
                                "sense_id": "83fdcf94-efda-3cfc-9abb-94375fe8af49",
                                "text": "Chrom, Silizium, Molybdän, Vanadium, Titan und Aluminium begünstigen die Entstehung des Ferrits und werden deshalb als Ferritbildner bezeichnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfa6d70f-4744-3962-896b-52448c4cb986",
                        "entry_id": "43ffa88a-f9e5-35e7-889e-3580fe72bc0c",
                        "glosses": [
                            "ferrimagnetischer keramischer Werkstoff aus Eisenoxid, z. B. Hämatit oder Magnetit, und weiteren Metalloxiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d25e10f-5ebb-429e-9827-4cc1d0b5781d",
                                "sense_id": "cfa6d70f-4744-3962-896b-52448c4cb986",
                                "text": "„Hartmagnetische Ferrite werden als kostengünstiger Dauermagnet eingesetzt.“"
                            },
                            {
                                "example_id": "a1aad64b-6680-44a6-aabc-386fe4ac4993",
                                "sense_id": "cfa6d70f-4744-3962-896b-52448c4cb986",
                                "text": "„Weichmagnetische Ferrite werden in der Elektrotechnik als Ferritkerne in Transformatoren in Schaltnetzteilen und in Spulen eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
