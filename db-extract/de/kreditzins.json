                "senses": [
                    {
                        "sense_id": "da3f4bb7-d6e4-3d5b-99e1-26735f66704b",
                        "entry_id": "38e848d6-67e9-3584-b5f9-e84aef8e49d2",
                        "glosses": [
                            "der vom Schuldner für die Gewährung eines Kredits zu bezahlende Zins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bd6a9b-52b3-4745-8fa8-1bc1de8b2cc2",
                                "sense_id": "da3f4bb7-d6e4-3d5b-99e1-26735f66704b",
                                "text": "„Wer schon vor längerem einen Kredit aufgenommen und keinen fixen Kreditzins vereinbart hat, spart sich durch niedrigere Leitzinsen Geld.“"
                            },
                            {
                                "example_id": "b3773265-a6cb-4702-bbf8-24a45fb3f0b8",
                                "sense_id": "da3f4bb7-d6e4-3d5b-99e1-26735f66704b",
                                "text": "„Wenn die EZB Staatsanleihen aufkauft, dann drückt sie am Finanzmarkt den Kreditzins für Euro-Staaten und subventioniert damit indirekt die Staatshaushalte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
