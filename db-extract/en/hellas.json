                        "glosses": [
                            "Greece; (specifically) Ancient Greece."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15871426-1bdc-4289-a20a-8589966d3d09",
                                "sense_id": "d95ff1a6-a65f-3435-933b-715d475a245e",
                                "text": "Modern Greece would not be Byzantium reborn. Rather, it was an imagined nation conjured up from ancient Hellas."
                            }
                        ]
                    }
