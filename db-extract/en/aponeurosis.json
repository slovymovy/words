                                "target_senses": [
                                    {
                                        "sense_id": "7d62cff6-eb48-39ee-9bee-320dd1ba4ba1",
                                        "entry_id": "971cde42-dd68-3f47-9ab2-8b493ed1cf43",
                                        "glosses": [
                                            "Membrana blanca, brillante, tendinosa, de fibras cruzadas, con que suelen terminar o empalmarse los músculos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67668b07-03ca-4511-982e-cb503e101eed",
                                                "sense_id": "7d62cff6-eb48-39ee-9bee-320dd1ba4ba1",
                                                "text": "«Los músculos rectos abdominales están alojados en vainas fibrosas, fuertes, conformadas por las aponeurosis de inserción de los músculos oblicuo, externo e interno del abdomen y también participa el músculo transverso del abdomen (m. transversus abdominis)»."
                                            },
                                            {
                                                "example_id": "6cadd3bd-65e5-4ab9-8a91-1d1cc1a18723",
                                                "sense_id": "7d62cff6-eb48-39ee-9bee-320dd1ba4ba1",
                                                "text": "«El músculo se origina por una delgada aponeurosis y se relaciona superficialmente con el serrato dorsal caudal y el oblicuo del abdomen; profundamente con el transverso del abdomen»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
