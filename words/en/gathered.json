{
    "word_family": [
        "gathering",
        "gatherer",
        "ingathering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3275e904-7a99-3b35-a11d-250ce05f8480",
                    "sense_definition": "simple past and past participle of <w>gather</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whole family <w>gathered</w> together for the holiday dinner.",
                            "target_lang_translations": {
                                "ru": "Вся семья <w>собралась</w> вместе на праздничный ужин.",
                                "fr": "Toute la famille s'est <w>rassemblée</w> pour le dîner de fête."
                            }
                        },
                        {
                            "text": "Dark clouds <w>gathered</w> in the sky before the storm started.",
                            "target_lang_translations": {
                                "ru": "Темные тучи <w>сгустились</w> на небе перед началом грозы.",
                                "fr": "Des nuages sombres se sont <w>accumulés</w> dans le ciel avant que l'orage n'éclate."
                            }
                        }
                    ],
                    "synonyms": [
                        "collected",
                        "assembled",
                        "accumulated"
                    ],
                    "antonyms": [
                        "scattered",
                        "dispersed"
                    ],
                    "common_phrases": [
                        "gathered together",
                        "gathered around",
                        "gathered up",
                        "gathered dust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола gather (собирать, собираться)",
                        "fr": "Passé composé ou participe passé du verbe gather (rassembler, se réunir, collecter)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрался",
                                "target_lang_sense_clarification": "о людях или группах (встретиться вместе)"
                            },
                            {
                                "target_lang_word": "сгустился",
                                "target_lang_sense_clarification": "о тучах, темноте или атмосфере"
                            },
                            {
                                "target_lang_word": "собрал",
                                "target_lang_sense_clarification": "о предметах, информации или урожае"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rassemblé",
                                "target_lang_sense_clarification": "pour des personnes ou des objets réunis en un lieu"
                            },
                            {
                                "target_lang_word": "réuni",
                                "target_lang_sense_clarification": "pour des personnes qui se retrouvent ensemble"
                            },
                            {
                                "target_lang_word": "accumulé",
                                "target_lang_sense_clarification": "pour des choses qui s'entassent ou s'épaississent"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e088008-6ac6-323e-8eab-b4a3a745d30f",
                    "sense_definition": "focused, centered, or achieving a state of shared spiritual unity",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt calm and <w>gathered</w> before giving her speech.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя спокойной и <w>собранной</w> перед выступлением.",
                                "fr": "Elle se sentait calme et <w>concentrée</w> avant de faire son discours."
                            }
                        },
                        {
                            "text": "The group sat in a <w>gathered</w> silence, feeling deeply connected.",
                            "target_lang_translations": {
                                "ru": "Группа сидела в <w>сосредоточенном</w> молчании, чувствуя глубокую связь.",
                                "fr": "Le groupe était assis dans un silence <w>recueilli</w>, se sentant profondément lié."
                            }
                        }
                    ],
                    "synonyms": [
                        "focused",
                        "centered",
                        "composed"
                    ],
                    "antonyms": [
                        "distracted",
                        "scattered"
                    ],
                    "common_phrases": [
                        "gathered meeting",
                        "gathered silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосредоточенный, сфокусированный или достигший состояния духовного единства",
                        "fr": "Se dit d'une personne calme, concentrée et en pleine possession de ses moyens"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собранный",
                                "target_lang_sense_clarification": "сфокусированный, организованный (о человеке)"
                            },
                            {
                                "target_lang_word": "сосредоточенный",
                                "target_lang_sense_clarification": "о внимании или тишине"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "concentré",
                                "target_lang_sense_clarification": "qui fait preuve d'une grande attention"
                            },
                            {
                                "target_lang_word": "posé",
                                "target_lang_sense_clarification": "qui est calme et maître de soi"
                            },
                            {
                                "target_lang_word": "recueilli",
                                "target_lang_sense_clarification": "qui est dans un état de calme intérieur profond"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}