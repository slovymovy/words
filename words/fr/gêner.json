{
    "word_family": [
        "gêne",
        "gênant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c62fd1f-3cd1-32d1-b06e-26494b0bb82f",
                    "sense_definition": "Déranger quelqu'un ou faire obstacle au mouvement de quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "entrave_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pardonnez-moi, est-ce que ma valise vous <w>gêne</w> dans le couloir ?"
                        },
                        {
                            "text": "Cette veste est trop petite et me <w>gêne</w> pour conduire."
                        }
                    ],
                    "synonyms": [
                        "déranger",
                        "incommoder"
                    ],
                    "common_phrases": [
                        "gêner la circulation",
                        "gêner le passage"
                    ]
                },
                {
                    "sense_id": "83e5786b-c209-3012-b163-db02607e573f",
                    "sense_definition": "Mettre quelqu'un mal à l'aise ou dans l'embarras.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "embarras_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa question indiscrète a semblé le <w>gêner</w> devant ses collègues de travail."
                        },
                        {
                            "text": "Ne me regarde pas comme ça pendant que je parle, cela me <w>gêne</w>."
                        }
                    ],
                    "synonyms": [
                        "embarrasser",
                        "intimider"
                    ],
                    "antonyms": [
                        "rassurer"
                    ],
                    "common_phrases": [
                        "sans vouloir gêner"
                    ]
                },
                {
                    "sense_id": "e28dfd2e-0020-36eb-a785-ddab4cd984f2",
                    "sense_definition": "Se contraindre ou hésiter à agir librement par politesse ou par timidité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "embarras_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faites comme chez vous et surtout ne vous <w>gênez</w> pas."
                        },
                        {
                            "text": "Il ne s'est pas <w>gêné</w> pour dire franchement tout ce qu'il pensait."
                        }
                    ],
                    "synonyms": [
                        "se contraindre",
                        "hésiter"
                    ],
                    "common_phrases": [
                        "ne pas se gêner"
                    ]
                },
                {
                    "sense_id": "1406bea0-c306-3631-92e8-49de44d06ebb",
                    "sense_definition": "Faire obstacle à une action, à des projets ou au bon déroulement de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entrave_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le manque de financement risque de fortement <w>gêner</w> les travaux de rénovation."
                        },
                        {
                            "text": "Cette décision imprévue vient <w>gêner</w> l'avancement de toutes nos recherches scientifiques."
                        }
                    ],
                    "synonyms": [
                        "entraver",
                        "freiner",
                        "bloquer"
                    ],
                    "antonyms": [
                        "favoriser",
                        "aider"
                    ],
                    "common_phrases": [
                        "gêner le développement"
                    ]
                },
                {
                    "sense_id": "c06d40de-a16c-3ab8-b93b-fe09d2517302",
                    "sense_definition": "Mettre dans une situation financière difficile, causer une pénurie d'argent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette importante dépense médicale risque de le <w>gêner</w> pour plusieurs mois."
                        },
                        {
                            "text": "Il est financièrement un peu <w>gêné</w> depuis qu'il a quitté son ancien emploi."
                        }
                    ],
                    "common_phrases": [
                        "être gêné financièrement"
                    ]
                }
            ]
        }
    ]
}