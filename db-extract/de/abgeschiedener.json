                "senses": [
                    {
                        "sense_id": "2d3bf859-1f19-3e60-895b-980ff07d604b",
                        "entry_id": "740a63a9-91e7-3bb4-a6d5-17cc177d3d77",
                        "glosses": [
                            "(kürzlich) verstorbene (männliche) Person"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "0323ebb6-0717-4286-a72a-e050e12a11b1",
                                "sense_id": "2d3bf859-1f19-3e60-895b-980ff07d604b",
                                "text": "„Die betrunkene Frau erkannte den Tod im Antlitz des Abgeschiedenen nicht.“"
                            },
                            {
                                "example_id": "4e9d5abd-d7c5-45b2-ba6e-7f7c44f52f0b",
                                "sense_id": "2d3bf859-1f19-3e60-895b-980ff07d604b",
                                "text": "„Wir wollen es also nicht versäumen, den Abgeschiedenen Hilfe zu leisten und für sie Gebete darzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbbc8d67-eb35-4678-9dad-bda412854a99",
                        "source_entry_id": "740a63a9-91e7-3bb4-a6d5-17cc177d3d77",
                        "source_sense_id": "2d3bf859-1f19-3e60-895b-980ff07d604b",
