                        ],
                        "examples": [
                            {
                                "example_id": "0bacf401-2116-480b-acf9-564ce4dcd41c",
                                "sense_id": "8913993e-b77f-3b26-a7aa-31d2bcc7fcb0",
                                "text": "When days and years proclaim you’re old —\n A dottle, cripple, gouty fellow,\nThen for support you can lay hold\n O’ the upright of your umberella."
                            }
                        ]
