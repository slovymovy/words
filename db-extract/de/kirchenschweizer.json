                                "target_senses": [
                                    {
                                        "sense_id": "f8f6b0d6-ece4-3520-94f8-7654f58879de",
                                        "entry_id": "d4e7c19d-ac95-328f-99f5-57e997ac2ca9",
                                        "glosses": [
                                            "Relatif à la Suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb03878-3cc6-43b3-82e8-9d0d80f43435",
                                                "sense_id": "f8f6b0d6-ece4-3520-94f8-7654f58879de",
                                                "text": "En 1995, Michel Mayor et Didier Queloz, deux astrophysiciens suisses, présentent au monde Bellérophon, nom officiel « 51 Pegasi b »."
                                            },
                                            {
                                                "example_id": "b1099d40-97b4-49f8-af18-b879be149d4c",
                                                "sense_id": "f8f6b0d6-ece4-3520-94f8-7654f58879de",
                                                "text": "Les vaches de race hollandaise et flamande sont plus sensibles que les vaches suisses aux effets de l'inoculation."
                                            },
                                            {
                                                "example_id": "a59c77fc-4333-4929-a1ba-d734dddb933d",
                                                "sense_id": "f8f6b0d6-ece4-3520-94f8-7654f58879de",
                                                "text": "La garde suisse, corps de troupe formé de soldats suisses, organisé en régiment par Louis XIII et faisant partie de la Maison du roi jusqu'à la fin du règne de Louis XVI ; corps de troupe formé de soldats suisses défendant jadis les États pontificaux et affecté aujourd'hui à la garde du Vatican."
                                            },
                                            {
                                                "example_id": "a321ac13-38fe-4385-9615-6fd531656421",
                                                "sense_id": "f8f6b0d6-ece4-3520-94f8-7654f58879de",
                                                "text": "Un garde suisse, soldat de ce corps de troupe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08fc7f5c-f5c9-3de0-aedc-a7288c5c84fc",
                                        "entry_id": "6b74e6e5-6932-3cbc-b3c7-6fb5b7fde191",
                                        "glosses": [
                                            "Domestique à qui était confiée la garde de la porte d’une maison ; concierge."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a8e3bc-d389-4a72-a099-dcc5d56b0f93",
                                                "sense_id": "08fc7f5c-f5c9-3de0-aedc-a7288c5c84fc",
                                                "text": "Par politesse envers la foule incroyable et insolite qui remplissait la rue, le suisse du palais Crescenzi avait placé une douzaine de torches dans ces mains de fer que l’on voit sortir des murs de face des palais bâtis au Moyen Âge."
                                            },
                                            {
                                                "example_id": "31b720f0-5dc6-458e-8b81-95e2a81a59cc",
                                                "sense_id": "08fc7f5c-f5c9-3de0-aedc-a7288c5c84fc",
                                                "text": "Quand le juge vit la porte cochère s’ouvrant devant le cabriolet de son neveu, il examina par un rapide coup d’œil la loge, le suisse, la cour, les écuries."
                                            },
                                            {
                                                "example_id": "d1c910c6-7cb7-4da3-8f19-78c6686580af",
                                                "sense_id": "08fc7f5c-f5c9-3de0-aedc-a7288c5c84fc",
                                                "text": "Elle trouva, en haut du perron, un gros suisse et un petit chien."
                                            },
                                            {
                                                "example_id": "a976fd63-aed8-46f8-b59d-decce2a5c463",
                                                "sense_id": "08fc7f5c-f5c9-3de0-aedc-a7288c5c84fc",
                                                "text": "Un énorme suisse, habillé comme à l’église, frappait les dalles de sa canne au passage de chaque arrivant."
                                            },
                                            {
                                                "example_id": "e5ae92ff-b8a3-48ab-b314-2476273ea6b5",
                                                "sense_id": "08fc7f5c-f5c9-3de0-aedc-a7288c5c84fc",
                                                "text": "Je ris en songeant aux policiers sévères, aux suisses galonnés, à toute cette mise en scène de respectabilité étalée à cinquante mètres de là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01cd85df-d2e8-307c-8776-9f3c27086222",
                                        "entry_id": "6b74e6e5-6932-3cbc-b3c7-6fb5b7fde191",
                                        "glosses": [
                                            "Celui qui est chargé de la police d’une église, qui précède le clergé dans les processions, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c9f8cc-1168-4044-803c-914e1f105b82",
                                                "sense_id": "01cd85df-d2e8-307c-8776-9f3c27086222",
                                                "text": "Bien qu’il n’eût pas la stature majestueuse d’un suisse de paroisse riche, ce porte-hallebarde était robuste. Il vous prit notre Gestas par les épaules et vous le jeta dehors."
                                            },
                                            {
                                                "example_id": "1af1b279-4202-4abc-a3f8-aadf9bf9b932",
                                                "sense_id": "01cd85df-d2e8-307c-8776-9f3c27086222",
                                                "text": "Bédouin, vêtu d’un pantalon de gendarme, d’un habit rouge, coiffé d’un bicorne et nanti de sa hallebarde de suisse, vint le prendre à son banc, et, de force, le contraignit à se mettre à genoux au milieu de la nef."
                                            },
                                            {
                                                "example_id": "f9c2af34-677f-40ec-b54f-ea4c011f1a4f",
                                                "sense_id": "01cd85df-d2e8-307c-8776-9f3c27086222",
                                                "text": "Après la messe, vers huit heures, la procession se mit en route. Il y avait en tête le suisse, le bedeau et un premier groupe de solides enfants de chœur qui devaient se relayer pour porter la croix dorée ornée de pierreries."
                                            },
                                            {
                                                "example_id": "25cbbbd7-a34c-4712-8432-978064dc3a01",
                                                "sense_id": "01cd85df-d2e8-307c-8776-9f3c27086222",
                                                "text": "30 janvier 43 – Ce que j’aime dans les mariages, ce sont les suisses à bi- ou tricornes, à mollets de fer dans des bas de soie, qui en inclinant la tête vous permettent de vous asseoir et vous ordonnent de vous lever."
                                            },
                                            {
                                                "example_id": "acdce7b8-c180-46f4-9f1c-1ebfce1a2cf5",
                                                "sense_id": "01cd85df-d2e8-307c-8776-9f3c27086222",
                                                "text": "Il fit semblant de ne pas remarquer le keffieh bleu qui encapuchonnait la tête de Jeannot façon Yasser Arafat, et les invita à le suivre dans un recoin de la salle de restaurant, en se déplaçant comme un suisse de cathédrale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34037ef3-2c89-3ffa-bd74-f545b1f959e7",
                                        "entry_id": "6b74e6e5-6932-3cbc-b3c7-6fb5b7fde191",
                                        "glosses": [
                                            "Garde de certaines institutions, dans certains pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a36df2c9-ba54-4f0c-9434-22e2b467af98",
                                                "sense_id": "34037ef3-2c89-3ffa-bd74-f545b1f959e7",
                                                "text": "« Qui est-ce là ? » cria le suisse de garde au guichet de la poterne du Louvre."
                                            },
                                            {
                                                "example_id": "f08cc76b-63cd-4ec7-afa3-8150803c9020",
                                                "sense_id": "34037ef3-2c89-3ffa-bd74-f545b1f959e7",
                                                "text": "De nombreuses patrouilles de Suisses sortirent avec des flambeaux ; on distinguait ces soldats à leur étrange uniforme. Ils portaient le bras droit rayé de bleu et de rouge, et le bas de soie de leur jambe droite était rouge ; le côté gauche rayé de bleu, rouge et blanc, et le bas blanc et rouge."
                                            },
                                            {
                                                "example_id": "03a7e97b-7d12-423f-a54a-e8b0cd2c0564",
                                                "sense_id": "34037ef3-2c89-3ffa-bd74-f545b1f959e7",
                                                "text": "La garnison se composait de trente-deux Suisses et de quatre-vingt-deux invalides. La Bastille n’était-elle pas imprenable?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f60869dc-4fb8-3d8d-abdc-266c73a4507b",
                                        "entry_id": "6b74e6e5-6932-3cbc-b3c7-6fb5b7fde191",
                                        "glosses": [
                                            "Tamia, genre d’écureuil au pelage rayé."
                                        ],
                                        "tags": [
                                            "Glirologie",
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72aca605-5a91-4cf3-9342-266d0278f0a6",
                                                "sense_id": "f60869dc-4fb8-3d8d-abdc-266c73a4507b",
                                                "text": "Un suisse a un terrier, alors qu’un écureuil a un nid dans un arbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad1c2a9-2c47-38d2-8826-d55c31e035c1",
                                        "entry_id": "6b74e6e5-6932-3cbc-b3c7-6fb5b7fde191",
                                        "glosses": [
                                            "Pâtisserie faite en pâte sablée ou brisée et ayant la forme d'un garde suisse, traditionnellement préparée pour la période des Rameaux."
                                        ],
                                        "tags": [
                                            "Ardèche",
                                            "Alpes du Sud"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b0f4f7e-7d19-445e-809d-523a577a8404",
                                                "sense_id": "2ad1c2a9-2c47-38d2-8826-d55c31e035c1",
                                                "text": "Enfin à Tournon pendant le Carême et jusqu'à Pâques les boulangers et certains pâtissiers vendent des suisses. Les meilleurs sont faits en pâte brisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
