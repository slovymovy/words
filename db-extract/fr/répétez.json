                                                "sense_id": "61bd19c9-404f-331f-b0cb-45fcaf2257e1",
                                                "text": "Bravo Actual, I say again: Eight foot mobiles moving east, over."
                                            },
                                            {
                                                "example_id": "662e5fb7-18bd-4fd7-bdeb-69d1ea741f8a",
                                                "sense_id": "61bd19c9-404f-331f-b0cb-45fcaf2257e1",
                                                "text": "Bravo Six, say again, over."
                                            }
