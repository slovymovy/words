            "senses": [
                {
                    "sense_id": "960b9093-ed85-3f67-bdf2-1ceb90468fc4",
                    "sense_definition": "Coudre de nouveau ce qui est décousu, déchiré ou détaché.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a pris du fil et une aiguille pour <w>recoudre</w> un bouton tombé de sa veste."
                        },
                        {
                            "text": "Avant de porter ce pantalon troué, il faut absolument le <w>recoudre</w> proprement."
                        }
                    ],
                    "synonyms": [
                        "raccommoder",
                        "repriser"
                    ],
                    "antonyms": [
                        "découdre",
                        "déchirer"
                    ],
                    "common_phrases": [
                        "recoudre un bouton",
                        "recoudre un accroc"
                    ]
                },
                {
                    "sense_id": "fee22066-6136-3d63-9f6b-41aa15519272",
                    "sense_definition": "Refermer les lèvres d'une plaie ou d'une incision chirurgicale par des points de suture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a dû lui faire plusieurs points de suture pour <w>recoudre</w> la plaie au front."
                        },
                        {
                            "text": "Le chirurgien <w>recoud</w> l'incision après une intervention qui a duré deux heures."
                        }
                    ],
                    "synonyms": [
                        "suturer"
                    ],
                    "common_phrases": [
                        "recoudre une plaie",
                        "recoudre une blessure"
                    ]
                },
                {
                    "sense_id": "4e775de7-01a7-3809-aefc-73b926fbec0a",
                    "sense_definition": "Rassembler, relier ou reconstituer métaphoriquement des éléments brisés ou dispersés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain s'efforce de <w>recoudre</w> ses souvenirs épars pour reconstituer son enfance oubliée."
                        },
                        {
                            "text": "Malgré leurs efforts pour <w>recoudre</w> les liens familiaux abîmés, la rancœur persistait."
                        }
                    ],
                    "synonyms": [
                        "rapiécer",
                        "raccommoder",
                        "reconstituer"
                    ],
                    "common_phrases": [
                        "recoudre des souvenirs",
                        "recoudre le passé"
                    ]
                }
            ]
        }
    ]
