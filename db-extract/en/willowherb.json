                ],
                "senses": [
                    {
                        "sense_id": "2641ab3e-fc70-3f53-b40e-26a5781eeeac",
                        "entry_id": "f4e46491-3e4a-31ae-bd05-90e0f6371690",
                        "glosses": [
                            "Any of several flowering plants, mostly in the genus Epilobium of the family Onagraceae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f41daf6-00c4-490d-ba77-39c9514a1b59",
                                "sense_id": "2641ab3e-fc70-3f53-b40e-26a5781eeeac",
                                "text": "Never had they noticed the roses so vivid, the willow-herb so riotous, the meadow-sweet so odorous and pervading."
                            },
                            {
                                "example_id": "10b45a0d-9080-4c96-a417-a0cb0de059ea",
                                "sense_id": "2641ab3e-fc70-3f53-b40e-26a5781eeeac",
                                "text": "And willows, willow-herb, and grass, / And meadowsweet, and haycocks dry, / No whit less still and lonely fair / Than the high cloudlets in the sky."
                            },
                            {
                                "example_id": "8c2a1c9e-2e64-4c0d-8368-b046d621c05a",
                                "sense_id": "2641ab3e-fc70-3f53-b40e-26a5781eeeac",
                                "text": "Their flowers range from the rather formal blossoming of outer London to the wilder flowering of the country, where willow-herb and broom, traveller's joy and campion, go rioting over the chalky banks of the Metropolitan Line."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e76ffb8-9f6f-4de5-82ed-1394d54bba7f",
                        "source_entry_id": "f4e46491-3e4a-31ae-bd05-90e0f6371690",
                        "source_sense_id": "2641ab3e-fc70-3f53-b40e-26a5781eeeac",
