                        "entry_id": "f7906346-442c-38a8-9ec7-54d6806a8b99",
                        "glosses": [
                            "een organisatiewijze of regel in taakverdeling tussen 'hogere' en 'lagere' openbare overheden. Het houdt in algemene zin in dat hogere instanties niet iets moeten doen wat door lagere instanties kan worden afgehandeld."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7dd342b-fe65-44b5-aaa3-f7a3bbd448d3",
                                "sense_id": "b0089f89-1cbb-37b2-91c0-d4f8c63d7c0f",
                                "text": "het subsidiariteitsbeginsel houdt b.v. in dat de Europese Gemeenschap alleen die activiteiten controleert die niet door de lidstaten zelf kunnen worden gecontroleerd"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb1c5945-e230-4660-bb81-f71416efe7b8",
