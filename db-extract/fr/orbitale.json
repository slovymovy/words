                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70017529-66e5-49ce-bfe8-9ff7b3363826",
                                                "sense_id": "d1c3e832-d1d5-3a90-a4c4-2bf67482b489",
                                                "text": "As with most power tools, orbitals can be divided into light and heavy-duty categories."
