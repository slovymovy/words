                        "entry_id": "c4f34c02-8e36-383c-865c-dbd4666c1290",
                        "glosses": [
                            "Fußboden, der aus dicht zusammengefügten kleinen Holzrechtecken besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205c15c7-c0d3-42f4-b567-1f9ec9055d5b",
                                "sense_id": "2164803a-a8e0-3ab9-a486-71ab0cbeed30",
                                "text": "„Es hatte einen Parkettboden und war mit einem Bett, einem Sofa, einem Schreibtisch und einem Waschtisch ausgestattet.“"
                            },
                            {
                                "example_id": "949bdb23-9b2c-48fd-87ad-b3cd44320750",
                                "sense_id": "2164803a-a8e0-3ab9-a486-71ab0cbeed30",
                                "text": "„Unter der Dachschräge befand sich ein langer Schrank, und der alte Parkettboden war von Umzugskartons übersät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
