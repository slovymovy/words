                        "glosses": [
                            "Religion, Mythologie, Theismus: ein Gott, der die Existenz von allem (insbesondere der Welt , dem Menschen, etc.) hervorgebracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b4ef2e6-39ac-4261-83e5-68554e7eb47e",
                                "sense_id": "c6cca858-e368-3a3e-9929-67df0db2bfa5",
                                "text": "Juden, Christen und Moslems glauben an einen Schöpfergott."
                            },
                            {
                                "example_id": "2b39d4b6-d16e-4ba8-a79f-4655b6f33b7f",
                                "sense_id": "c6cca858-e368-3a3e-9929-67df0db2bfa5",
                                "text": "„An der Spitze steht der Oba, der Abkömmling des Schöpfergottes Oduduwa und irdischer Vertreter der Ahnen der Königsdynastie.“"
                            }
                        ],
