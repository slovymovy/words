                                    {
                                        "sense_id": "f9ab4b5a-4f8c-3321-be0d-92677343497f",
                                        "entry_id": "09a0594b-8093-3b5d-ab6d-28a77f3bbca6",
                                        "glosses": [
                                            "Something very large, or larger than usual; a whopper."
                                        ],
