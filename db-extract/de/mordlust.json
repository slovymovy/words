                                "example_id": "930eef47-99eb-48ad-9ddb-a4b8d2b21c93",
                                "sense_id": "1b9598f9-ae5c-320d-bf21-f8193d30ba56",
                                "text": "„Dazu kamen die Herzlosigkeit, Zerstörungswut und Mordlust der Sieger im Siegesrausch, im Blutrausch oder einfach im Rausch.“"
                            },
                            {
                                "example_id": "7796ca13-b566-4e5c-8328-464cb7cc253a",
                                "sense_id": "1b9598f9-ae5c-320d-bf21-f8193d30ba56",
                                "text": "„Mordlust im funkelnden Auge, standen sie mit aufgepflanzten Bajonetten; kein Laut entfuhr ihnen.“"
                            }
                        ],
