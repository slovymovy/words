                ],
                "senses": [
                    {
                        "sense_id": "497594fd-30f0-3be3-8761-05b1fa3882d6",
                        "entry_id": "94d11534-c413-368c-a23a-cceb93d3d301",
                        "glosses": [
                            "in einem Spiel von der gegnerischen Mannschaft erzieltes Tor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4a68e6-370d-4632-adc2-18e13b742f9c",
                                "sense_id": "497594fd-30f0-3be3-8761-05b1fa3882d6",
                                "text": "„Dank einer starken Abwehrleistung ließ Mailand in Barcelona selbst in Unterzahl nur ein Gegentor zu und rettete den Vorsprung aus dem Hinspiel über die Zeit.“"
                            },
                            {
                                "example_id": "debfb20c-6c8f-47cd-99d5-1dd88abdf4b8",
                                "sense_id": "497594fd-30f0-3be3-8761-05b1fa3882d6",
                                "text": "„‚Er allein war nicht schuld am Gegentor, da sehe ich eine Kettenreaktion‘, befand Löw …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9be5ede-8aa6-3de8-990b-40518d0e33eb",
                        "entry_id": "94d11534-c413-368c-a23a-cceb93d3d301",
                        "glosses": [
                            "die in einer Saison erhaltenen Tore"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe68771b-2966-4b71-a185-bb960e43a9c8",
                                "sense_id": "a9be5ede-8aa6-3de8-990b-40518d0e33eb",
                                "text": "„Auch Borussia Dortmund fing sich neun Gegentore vom Punkt – bei neun Versuchen wohlgemerkt.“"
                            },
                            {
                                "example_id": "cdb19c7b-6514-4ba9-bf79-adea0dbecee0",
                                "sense_id": "a9be5ede-8aa6-3de8-990b-40518d0e33eb",
                                "text": "„Das Duo bedankte sich dann auch für das Vertrauen damit, dass es nur 28 Gegentore zuließ.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
