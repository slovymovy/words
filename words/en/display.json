{
    "word_family": [
        "displayable",
        "displayer",
        "redisplay"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b057ee93-5792-3b50-b486-ef2744ad9997",
                    "sense_definition": "to show something clearly or conspicuously so that it can be seen by others",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum will <w>display</w> the ancient artifacts in the main hall.",
                            "target_lang_translations": {
                                "ru": "Музей будет <w>выставлять</w> древние артефакты в главном зале."
                            }
                        },
                        {
                            "text": "The shop window is used to <w>display</w> merchandise to attract customers.",
                            "target_lang_translations": {
                                "ru": "Витрина магазина используется для того, чтобы <w>выставлять</w> товары для привлечения покупателей."
                            }
                        }
                    ],
                    "antonyms": [
                        "hide",
                        "conceal"
                    ],
                    "common_phrases": [
                        "display merchandise",
                        "display talent"
                    ],
                    "target_lang_definitions": {
                        "ru": "показывать что-либо открыто или наглядно, чтобы это могли увидеть другие; проявлять определенное качество, чувство или навык",
                        "tr": "Başkalarının görebilmesi için bir şeyi açıkça veya göze çarpacak şekilde sergilemek; belirli bir niteliği, duyguyu veya beceriyi göstermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "помещать для обозрения"
                            },
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "делать видимым или проявлять"
                            },
                            {
                                "target_lang_word": "демонстрировать",
                                "target_lang_sense_clarification": "наглядно показывать"
                            },
                            {
                                "target_lang_word": "проявлять",
                                "target_lang_sense_clarification": "обнаруживать чувства или качества"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sergilemek",
                                "target_lang_sense_clarification": "görünür kılmak veya göstermek"
                            },
                            {
                                "target_lang_word": "göstermek",
                                "target_lang_sense_clarification": "açığa vurmak, belli etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b057ee93-5792-3b50-b486-ef2744ad9997",
                    "sense_definition": "to manifest or demonstrate a particular quality, feeling, or skill",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete continued to <w>display</w> courage despite her recent injury.",
                            "target_lang_translations": {
                                "ru": "Спортсменка продолжала <w>проявлять</w> мужество, несмотря на недавнюю травму.",
                                "tr": "Sporcu, son sakatlığına rağmen cesaret <w>göstermeye</w> devam etti."
                            }
                        },
                        {
                            "text": "He did not <w>display</w> emotion even when he heard the bad news.",
                            "target_lang_translations": {
                                "ru": "Он не <w>показал</w> никаких эмоций, даже когда услышал плохие новости.",
                                "tr": "Kötü haberi aldığında bile hiçbir duygu <w>belli etmedi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "display emotion",
                        "display courage",
                        "display symptoms"
                    ],
                    "target_lang_definitions": {
                        "ru": "показывать что-либо открыто или наглядно, чтобы это могли увидеть другие; проявлять определенное качество, чувство или навык",
                        "tr": "Başkalarının görebilmesi için bir şeyi açıkça veya göze çarpacak şekilde sergilemek; belirli bir niteliği, duyguyu veya beceriyi göstermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "помещать для обозрения"
                            },
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "делать видимым или проявлять"
                            },
                            {
                                "target_lang_word": "демонстрировать",
                                "target_lang_sense_clarification": "наглядно показывать"
                            },
                            {
                                "target_lang_word": "проявлять",
                                "target_lang_sense_clarification": "обнаруживать чувства или качества"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sergilemek",
                                "target_lang_sense_clarification": "görünür kılmak veya göstermek"
                            },
                            {
                                "target_lang_word": "göstermek",
                                "target_lang_sense_clarification": "açığa vurmak, belli etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a78874-72dd-318b-b5c6-0355d071d746",
                    "sense_definition": "to spread out or unfurl something so that it is fully visible",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peacock began to <w>display</w> its feathers in a magnificent fan.",
                            "target_lang_translations": {
                                "ru": "Павлин начал <w>распускать</w> свои перья великолепным веером.",
                                "tr": "Tavus kuşu tüylerini muhteşem bir yelpaze gibi <w>açmaya</w> başladı."
                            }
                        },
                        {
                            "text": "The bird will <w>display</w> plumage to attract a mate during the spring.",
                            "target_lang_translations": {
                                "ru": "Птица будет <w>демонстрировать</w> оперение, чтобы привлечь партнера весной.",
                                "tr": "Kuş, ilkbaharda bir eş çekmek için tüylerini <w>sergileyecektir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "splay"
                    ],
                    "common_phrases": [
                        "display plumage",
                        "display feathers"
                    ],
                    "target_lang_definitions": {
                        "ru": "расправлять или раскрывать что-либо так, чтобы оно стало полностью видимым",
                        "tr": "Bir şeyi tam olarak görünecek şekilde yaymak veya açmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распускать",
                                "target_lang_sense_clarification": "о хвосте или перьях"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "делать видимым"
                            },
                            {
                                "target_lang_word": "демонстрировать",
                                "target_lang_sense_clarification": "показывать во всей красе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açmak",
                                "target_lang_sense_clarification": "tüy veya kanat yaymak"
                            },
                            {
                                "target_lang_word": "sergilemek",
                                "target_lang_sense_clarification": "gözler önüne sermek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9dfa5478-6e0e-342e-90c0-6042cba89cae",
                    "sense_definition": "an electronic screen used to present visual information, text, or graphics",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laptop has a high-resolution <w>display</w> that makes images look very sharp.",
                            "target_lang_translations": {
                                "ru": "У ноутбука <w>дисплей</w> с высоким разрешением, благодаря которому изображения выглядят очень четкими.",
                                "tr": "Dizüstü bilgisayar, görüntülerin çok keskin görünmesini sağlayan yüksek çözünürlüklü bir <w>ekrana</w> sahiptir."
                            }
                        },
                        {
                            "text": "A digital <w>display</w> on the dashboard shows the current speed of the car.",
                            "target_lang_translations": {
                                "ru": "Цифровой <w>экран</w> на приборной панели показывает текущую скорость автомобиля.",
                                "tr": "Gösterge panelindeki dijital <w>ekran</w> arabanın mevcut hızını gösterir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital display",
                        "liquid-crystal display",
                        "visual display"
                    ],
                    "target_lang_definitions": {
                        "ru": "электронный экран, используемый для представления визуальной информации, текста или графики",
                        "tr": "Görsel bilgileri, metinleri veya grafikleri sunmak için kullanılan elektronik ekran."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисплей",
                                "target_lang_sense_clarification": "электронное устройство"
                            },
                            {
                                "target_lang_word": "экран",
                                "target_lang_sense_clarification": "поверхность для вывода изображения"
                            },
                            {
                                "target_lang_word": "монитор",
                                "target_lang_sense_clarification": "устройство визуального отображения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ekran",
                                "target_lang_sense_clarification": "görüntü yüzeyi"
                            },
                            {
                                "target_lang_word": "gösterge",
                                "target_lang_sense_clarification": "dijital panel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "717b72f5-6053-3a15-8356-5dd8ce46d17c",
                    "sense_definition": "a public performance, show, or spectacle intended to entertain or inform",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city organized a spectacular fireworks <w>display</w> for the New Year celebration.",
                            "target_lang_translations": {
                                "ru": "Город организовал впечатляющее <w>шоу</w> фейерверков на празднование Нового года.",
                                "tr": "Şehir, Yılbaşı kutlaması için muhteşem bir havai fişek <w>gösterisi</w> düzenledi."
                            }
                        },
                        {
                            "text": "The acrobatic <w>display</w> left the entire audience in awe.",
                            "target_lang_translations": {
                                "ru": "Акробатическое <w>представление</w> привело в восторг всех зрителей.",
                                "tr": "Akrobasi <w>gösterisi</w> tüm seyircileri hayran bıraktı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fireworks display",
                        "acrobatic display",
                        "public display"
                    ],
                    "target_lang_definitions": {
                        "ru": "публичное выступление, шоу или зрелище, предназначенное для развлечения или информирования",
                        "tr": "Eğlendirmek veya bilgilendirmek amacıyla yapılan halka açık gösteri veya sunum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шоу",
                                "target_lang_sense_clarification": "зрелищное действо"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "спектакль или зрелище"
                            },
                            {
                                "target_lang_word": "показ",
                                "target_lang_sense_clarification": "демонстрация чего-либо"
                            },
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "предмет наблюдения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gösteri",
                                "target_lang_sense_clarification": "etkinlik veya şov"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d98fb6e-6fbd-3a18-8d8e-85b65319fe82",
                    "sense_definition": "a collection of objects or information arranged for people to look at",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher put the students' artwork on a wall <w>display</w> in the hallway.",
                            "target_lang_translations": {
                                "ru": "Учитель разместил работы учеников на настенном <w>стенде</w> в коридоре.",
                                "tr": "Öğretmen, öğrencilerin sanat çalışmalarını koridordaki bir duvar <w>sergisine</w> koydu."
                            }
                        },
                        {
                            "text": "The museum's latest <w>display</w> features paintings from the Renaissance.",
                            "target_lang_translations": {
                                "ru": "Последняя <w>экспозиция</w> музея включает картины эпохи Возрождения.",
                                "tr": "Müzenin son <w>sergisi</w> Rönesans dönemine ait tabloları içeriyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wall display",
                        "museum display",
                        "window display"
                    ],
                    "target_lang_definitions": {
                        "ru": "коллекция объектов или информации, расположенная для осмотра людьми",
                        "tr": "İnsanların incelemesi için düzenlenmiş nesneler veya bilgiler koleksiyonu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспозиция",
                                "target_lang_sense_clarification": "выставка предметов"
                            },
                            {
                                "target_lang_word": "выставка",
                                "target_lang_sense_clarification": "собрание экспонатов"
                            },
                            {
                                "target_lang_word": "стенд",
                                "target_lang_sense_clarification": "место для размещения информации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sergi",
                                "target_lang_sense_clarification": "stend veya teşhir alanı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f72c2e0a-b8f9-330e-b741-73f3203077cb",
                    "sense_definition": "a structure or stand used in a shop to present goods for sale",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store used a cardboard <w>display</w> to promote the new brand of cereal.",
                            "target_lang_translations": {
                                "ru": "Магазин использовал картонную <w>стойку</w> для продвижения новой марки хлопьев.",
                                "tr": "Mağaza, yeni mısır gevreği markasını tanıtmak için karton bir <w>stant</w> kullandı."
                            }
                        },
                        {
                            "text": "The promotional <w>display</w> was placed right at the entrance of the supermarket.",
                            "target_lang_translations": {
                                "ru": "Рекламный <w>стенд</w> был установлен прямо у входа в супермаркет.",
                                "tr": "Promosyon <w>standı</w> süpermarketin tam girişine yerleştirildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "cardboard display"
                    ],
                    "common_phrases": [
                        "promotional display",
                        "point-of-sale display"
                    ],
                    "target_lang_definitions": {
                        "ru": "конструкция или стойка в магазине, используемая для презентации товаров на продажу",
                        "tr": "Bir mağazada satılık malları sunmak için kullanılan yapı veya stant."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "витрина",
                                "target_lang_sense_clarification": "место для показа товаров"
                            },
                            {
                                "target_lang_word": "стойка",
                                "target_lang_sense_clarification": "торговое оборудование"
                            },
                            {
                                "target_lang_word": "стенд",
                                "target_lang_sense_clarification": "рекламная конструкция"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "stant",
                                "target_lang_sense_clarification": "ürün sergileme ünitesi"
                            },
                            {
                                "target_lang_word": "vitrin",
                                "target_lang_sense_clarification": "teşhir alanı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
