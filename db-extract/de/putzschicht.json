                        "entry_id": "8bdce1c7-b9d2-3410-8ceb-1395eacee724",
                        "glosses": [
                            "als Belag auf Wänden oder Decken aufgetragene Schicht aus Wasser, Sand und Bindemitteln (wie etwa Gips oder Mörtel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496f336a-ee3d-466d-9291-0977b3195afa",
                                "sense_id": "df36ae2a-30f0-38fb-956b-f881bdd9fcfa",
                                "text": "„Diese werden auch als einschalig bezeichnet, wenn sie Massegesetz mit einer Putzschicht ausgeführt werden.“"
                            },
                            {
                                "example_id": "4b095bce-5f6e-47a9-8ed4-51310351422e",
                                "sense_id": "df36ae2a-30f0-38fb-956b-f881bdd9fcfa",
                                "text": "„Dickere Putzschichten als vom Hersteller zugelassen führen zu Schwindrissen beim Austrocknen.“"
                            },
                            {
                                "example_id": "0ecfd502-9a55-430e-921c-ab8f15b634d2",
                                "sense_id": "df36ae2a-30f0-38fb-956b-f881bdd9fcfa",
                                "text": "„Es soll ein Wandtyp mit Sichtmauerwerk außen und einer dünnen weißen Putzschicht innen werden.“"
                            },
                            {
                                "example_id": "73a6590a-a281-4a34-94e2-1977dcfadd2e",
                                "sense_id": "df36ae2a-30f0-38fb-956b-f881bdd9fcfa",
                                "text": "„Die Abbildung rechts zeigt die Absprengungsfläche des Ziegels und unten die Putzschicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
