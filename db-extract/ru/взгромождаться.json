                                        "sense_id": "addda15f-7c88-363c-8018-1ee977d93eae",
                                        "entry_id": "41f5e738-779a-3dcf-8238-5b0bc5e8257f",
                                        "glosses": [
                                            "A position that is secure and advantageous, especially one which is prominent or elevated."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d004621-67f8-4632-ac77-943d7a092031",
                                                "sense_id": "addda15f-7c88-363c-8018-1ee977d93eae",
                                                "text": "Last year, Eighth Grade found poignancy and humor in its eponymous time period: that purgatorial perch between childhood and adulthood."
                                            },
                                            {
                                                "example_id": "a00a6e59-89b0-43ca-982f-d522f4021357",
                                                "sense_id": "addda15f-7c88-363c-8018-1ee977d93eae",
                                                "text": "[W]inning Wimbledon at just 19 years, earning her rightful place on the perch as world number one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd9275d-034d-3f53-bdf6-ef44006b5169",
                                        "entry_id": "41f5e738-779a-3dcf-8238-5b0bc5e8257f",
                                        "glosses": [
                                            "A position that is overly elevated or haughty."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99210f80-0ffd-40fb-ba00-2e30a68d93f6",
                                                "sense_id": "bfd9275d-034d-3f53-bdf6-ef44006b5169",
                                                "text": "You may thanke me, (Lady) / I haue taken you off your mellancholly pearch, / Boare you vpon my fiſt, and ſhew'd you game, / And let you flie at it: I pray the kiſſe me, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "393af45d-43e5-3dcc-aa5d-dfa5a1326489",
                                        "entry_id": "41f5e738-779a-3dcf-8238-5b0bc5e8257f",
                                        "glosses": [
                                            "A linear measure of 5+¹⁄₂ yards, equal to a rod, a pole or ¹⁄₄ chain; the related square measure."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b8b1a0e-3fc4-3949-a12c-f37e69c4a3b0",
                                        "entry_id": "41f5e738-779a-3dcf-8238-5b0bc5e8257f",
                                        "glosses": [
                                            "A cubic measure of stonework equal to 16.6 × 1.5 × 1 feet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "278989ea-d7af-31b2-9753-88a70a987a8e",
                                        "entry_id": "41f5e738-779a-3dcf-8238-5b0bc5e8257f",
                                        "glosses": [
                                            "A frame used to examine cloth."
