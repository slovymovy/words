                "senses": [
                    {
                        "sense_id": "544f2d5a-3fb5-3e22-8869-bf7cef132a71",
                        "entry_id": "26daebbf-f2ad-32ac-8932-4461855a1979",
                        "glosses": [
                            "A traditional Dai spicy and sour paste-like side dish made by combining vegetables, herbs and spices in a mortar and pestle."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b8f3a5a2-2832-47e6-82fe-44b850d0df91",
                                "sense_id": "544f2d5a-3fb5-3e22-8869-bf7cef132a71",
                                "text": "Nanpie, the name in local Dai dialect for a sauce-like dish made with fresh ingredients and spices, is one such creation."
                            },
                            {
                                "example_id": "c394f48f-dfc1-421d-9c5d-58d600047256",
                                "sense_id": "544f2d5a-3fb5-3e22-8869-bf7cef132a71",
                                "text": "Indulge in the delightful flavors of Chinese cuisine with our Nanpie recipe."
                            },
                            {
                                "example_id": "b4362203-21c8-469e-95e1-63548113995c",
                                "sense_id": "544f2d5a-3fb5-3e22-8869-bf7cef132a71",
                                "text": "Nanpie or nanmi is a spicy and sour Dai dipping sauce that is prepared using a mortar and pestle — the ingredients are crushed until they turn into a mash."
                            }
                        ]
                    }
                ],
