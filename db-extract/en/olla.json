                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96cbf8e-ff12-43ba-9523-b9b93a68b089",
                                "sense_id": "662bce61-624b-38d2-8bd2-7ba4945eee3f",
                                "text": "On top of the counter were three clay jars or ollas. Two of them were empty but the third was covered with the tin lid from a lardpail and the lid was notched to accommodate the handle of an enameled tin dipper."
                            }
                        ]
                    },
