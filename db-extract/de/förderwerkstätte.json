                ],
                "senses": [
                    {
                        "sense_id": "f517975e-b301-31f0-accb-8638e0952de3",
                        "entry_id": "fead6423-cb59-3651-bf98-bb50a23169ce",
                        "glosses": [
                            "Arbeitsstätte für Menschen mit Behinderungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f72925-aa6f-4251-a07d-f2a1eda717b9",
                                "sense_id": "f517975e-b301-31f0-accb-8638e0952de3",
                                "text": "„Allerdings steht die Förderwerkstätte vor einem ganz anderen Problem: Es fehlen Betreuer in den Wohnheimen, ‚die darauf ausgelegt sind, dass die Bewohner an Werktagen arbeiten‘.“"
                            },
                            {
                                "example_id": "d8eb460c-f197-4494-a006-90185bbc8139",
                                "sense_id": "f517975e-b301-31f0-accb-8638e0952de3",
                                "text": "„Damit er am Montag rechtzeitig zur Arbeit in einer Förderwerkstätte kommt, muss er am Sonntagabend mit S 5 und U 6 zurück ins Wohnpflegeheim fahren.“"
                            },
                            {
                                "example_id": "b199fdcf-3a65-4e82-8d70-1e4e550d7bd7",
                                "sense_id": "f517975e-b301-31f0-accb-8638e0952de3",
                                "text": "„Eine gewisse Brisanz bekommt die altersbedingte Differenzierung insbesondere im Bereich der Förderwerkstätten, wo das Renteneintrittsalter weitestgehend den Beendigungszeitpunkt der Eingliederungsmaßnahme bestimmt.“"
                            },
                            {
                                "example_id": "ba7da78d-5854-4f0f-81a7-b4ef143ffd31",
                                "sense_id": "f517975e-b301-31f0-accb-8638e0952de3",
                                "text": "„Unterstützende Faktoren könnten Angebote systematischer Lernförderung sein, z. B. eine Systematisierung problemorientierten Förderunterrichts im Sinne von Förderwerkstätten (vgl. u.a. Mölle, 1996).“"
                            },
                            {
                                "example_id": "27425a0b-70b9-4270-b9fd-4983494c4766",
                                "sense_id": "f517975e-b301-31f0-accb-8638e0952de3",
                                "text": "„Neben den Einrichtungen (Heime, Tagesstätten, Förderwerkstätten, Wohnangebote) hat sie vor allem auch offene Angebote für Behinderte und ihre Angehörigen entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
