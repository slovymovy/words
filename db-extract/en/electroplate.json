                    {
                        "translation_id": "83f7627c-e546-4b58-8240-592cd235ad58",
                        "source_entry_id": "2b841e31-e2b5-3c12-8c9d-4e91fe270002",
                        "source_sense_id": "91ae3b24-37ab-3c3e-b54b-bdcc4ddc9bf7",
                        "source_sense_description": "to coat an object with a thin layer of metal using electrolysis",
                        "target_lang_word": "plaquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4d75ba-3e56-3e74-8d27-7f99312b0c14",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Appliquer une chose sur une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "706883e5-f2a3-4d20-8f6e-b77a9563399c",
                                                "sense_id": "6d4d75ba-3e56-3e74-8d27-7f99312b0c14",
                                                "text": "Modeste plaquait chaque fil de coton avec une perfection à désespérer des brodeuses."
                                            },
                                            {
                                                "example_id": "be6e4e88-0b2b-46af-843c-99ebb0fd43c2",
                                                "sense_id": "6d4d75ba-3e56-3e74-8d27-7f99312b0c14",
                                                "text": "Pendant les intervalles de calme, il regardait avec de grandes pitiés sa face convulsionnée, son corps amaigri, sur lequel les jupes plaquaient, pareilles à un linceul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d11ec2b-612b-3a12-b70f-0e7811d2e533",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Recouvrir d’or ou d’argent laminé des bijoux, de la vaisselle de cuivre ou de tout autre métal."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e80160b-1d0b-4f3d-963f-4a8a171076bd",
                                                "sense_id": "3d11ec2b-612b-3a12-b70f-0e7811d2e533",
                                                "text": "Plaquer des bijoux, de la vaisselle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1857b3a9-5a9f-3842-8f00-cbd987c26dda",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Coller une plaque de bois précieux sur un bois commun ou un bois aggloméré."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca180e22-e8dd-3dd2-ab42-442fc2ad731b",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Coller un élément décoratif métallique sur du bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d799ee-73b8-4533-be91-9f553f160f4c",
                                                "sense_id": "ca180e22-e8dd-3dd2-ab42-442fc2ad731b",
                                                "text": "C’était une chambre de ce temps-là, — une chambre de l’Empire, parquetée en point de Hongrie, sans tapis, où le bronze plaquait partout le merisier, d’abord en tête de sphinx aux quatre coins du lit, et en pattes de lion sous ses quatre pieds, puis, sur tous les tiroirs de la commode et du secrétaire, en camées de faces de lion, avec des anneaux de cuivre pendant de leurs gueules verdâtres, et par lesquels on les tirait quand on voulait les ouvrir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84a7272-2c1c-374b-a4ea-6fbd54b689be",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Joindre deux choses qui ne vont pas ensemble."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f15fefb-3aa3-4b98-ac09-d7093ef952f0",
                                                "sense_id": "e84a7272-2c1c-374b-a4ea-6fbd54b689be",
                                                "text": "Je trouve que la musique est plaquée sur le texte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bb2376d-43cb-38e1-a66b-e23c080c9587",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Abandonner ; quitter ; laisser tomber."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e78ae59f-3b9c-4103-ba27-05dfa3211d5f",
                                                "sense_id": "1bb2376d-43cb-38e1-a66b-e23c080c9587",
                                                "text": "— Je plaque Machin. Il parle de me décoller. Je lui ai dit : Oh ! là, là, mon petit ! T’as jamais cassé trois pattes à un canard."
                                            },
                                            {
                                                "example_id": "4dbfb7e8-4e4b-4104-9ef9-ab23f2fc8be5",
                                                "sense_id": "1bb2376d-43cb-38e1-a66b-e23c080c9587",
                                                "text": "Après quelques coucheries clandestines, Geneviève plaqua sans ménagements son artiste, qui déclara, du reste, en avoir sa claque."
                                            },
                                            {
                                                "example_id": "af7fa609-0ac0-4d2e-8c9b-427b347998a5",
                                                "sense_id": "1bb2376d-43cb-38e1-a66b-e23c080c9587",
                                                "text": "« Au fond, se dit Daniel, si j’étais un type bien, je plaquerais mes études et je chercherais une situation, n’importe laquelle ! »"
                                            },
                                            {
                                                "example_id": "4787dfdb-a084-431f-b8ed-52b7508fdefe",
                                                "sense_id": "1bb2376d-43cb-38e1-a66b-e23c080c9587",
                                                "text": "Un ancien petit ami doté d'une bite XXL lui avait fait mal et elle l’avait plaqué comme on lâche sa cuillère lorsque l’alarme d’incendie se met à hurler."
                                            },
                                            {
                                                "example_id": "abd37828-8a84-4f4c-869d-c1128c862fc0",
                                                "sense_id": "1bb2376d-43cb-38e1-a66b-e23c080c9587",
                                                "text": "Bien sûr que j'ai déjà eu des copains, […]. Mon dernier mec, je l’ai plaqué il y a 15 jours, parce qu'il était un peu trop jeune pour moi, niveau sexuel !"
                                            },
                                            {
                                                "example_id": "52e43aeb-f8b6-40d4-91ca-e710e19693d5",
                                                "sense_id": "1bb2376d-43cb-38e1-a66b-e23c080c9587",
                                                "text": "J'ai plaqué mon chêne\nComme un saligaud\nMon copain le chêne\nMon alter ego."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58dbd3e1-818d-3fdc-bc18-9d1089dacd0a",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Faire tomber l'adversaire porteur du ballon."
                                        ],
                                        "tags": [
                                            "Football canadien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b0aa7a-21ef-4f93-bbcd-7b810876458c",
                                                "sense_id": "58dbd3e1-818d-3fdc-bc18-9d1089dacd0a",
                                                "text": "Il s'est fait plaquer sèchement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b09b22b-5bfb-31d3-9b7a-0d6da08bf97d",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Faire tomber l'adversaire et le maintenir le dos au sol."
                                        ],
                                        "tags": [
                                            "Lutte et catch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76297573-6463-40c6-a902-349848b13213",
                                                "sense_id": "4b09b22b-5bfb-31d3-9b7a-0d6da08bf97d",
                                                "text": "— Faire mine de rien, surtout faire mine de rien, […]. Mais essayez donc de faire mine de rien quand un type vous empoigne et vous plaque au mur avec plus de force qu'un taureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d38b68-cfe7-3c99-a302-d53c6e2b75ba",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Les aplatir."
                                        ],
                                        "tags": [
                                            "En parlant des cheveux"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f74e4a0-0941-3027-bdc1-67da7e57facc",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Frapper du même coup les notes qui constituent un accord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d55ccd1c-6667-42f3-a51d-92c1b7a04778",
                                                "sense_id": "7f74e4a0-0941-3027-bdc1-67da7e57facc",
                                                "text": "Le pianiste plaqua des accords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4143a6-3308-3046-b816-6b82e96aa21a",
                                        "entry_id": "e263b529-1b32-34bf-b2ee-5dd4d7793ec6",
                                        "glosses": [
                                            "Se serrer étroitement, s'aplatir."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "319c1ee5-8579-4662-8a99-0c378b30d004",
                                                "sense_id": "8c4143a6-3308-3046-b816-6b82e96aa21a",
                                                "text": "Se plaquer au sol, se plaquer contre quelqu'un."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
