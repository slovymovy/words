                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e416cff-4887-4868-aee6-9b6ba6954fc9",
                                                "sense_id": "d2f03afa-7578-3e6b-a6d9-ed88fd1a0fb9",
                                                "text": "Wydelegowani politrucy, agitatorzy i lektorzy prowadzą z ludnością rozmowy uświadamiające"
                                            }
                                        ],
