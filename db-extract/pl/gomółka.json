                    {
                        "sense_id": "ec6498a8-efc0-3bd4-8f98-2ef652a616a2",
                        "entry_id": "f93dd98a-17a3-3cff-8c9d-629028c4e715",
                        "glosses": [
                            "okrągła lub wielokątna szybka oprawiana w ołów w dawnych oknach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab6b760d-f16d-459f-ac14-047130b70d95",
                                "sense_id": "ec6498a8-efc0-3bd4-8f98-2ef652a616a2",
                                "text": "Gomółki miały w środku zgrubienie zwane pępkiem."
                            }
                        ],
