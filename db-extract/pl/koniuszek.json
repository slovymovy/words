                "senses": [
                    {
                        "sense_id": "ad9c5c62-9143-39f9-a33f-f5a342307d92",
                        "entry_id": "84e5ab71-66a2-3eb9-ac98-2e67bcc64e3e",
                        "glosses": [
                            "najdalej wysunięty punkt czegoś, sam koniec, czubek"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0ac402e5-482b-4b8a-ab24-a887e97050f9",
                                "sense_id": "ad9c5c62-9143-39f9-a33f-f5a342307d92",
                                "text": "Słoik leżał na najwyższej półce i ledwo dosięgnąłem go koniuszkami palców."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdde1a11-3a3f-4b42-b177-06e080e5b054",
                        "source_entry_id": "84e5ab71-66a2-3eb9-ac98-2e67bcc64e3e",
                        "source_sense_id": "ad9c5c62-9143-39f9-a33f-f5a342307d92",
                        "target_lang_word": "кончик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кончик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "150a24d6-430e-3a4e-b526-632716d963ed",
                                        "entry_id": "038bf4d4-b223-35b7-9e13-6f3debde7829",
                                        "glosses": [
                                            "разг. острый или суженный конец чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b614b5-edcc-40e5-bccf-4f83c8264230",
                                                "sense_id": "150a24d6-430e-3a4e-b526-632716d963ed",
                                                "text": "Лицо у него было бледно, но дышало душевным просветлением; на губах играла блаженная улыбка; глаза смотрели ласково, как бы всепрощающе; кончик носа, вследствие молитвенного угобжения, слегка покраснел."
                                            },
                                            {
                                                "example_id": "632478ab-9ff3-443b-b968-1afbc3d4c7fe",
                                                "sense_id": "150a24d6-430e-3a4e-b526-632716d963ed",
                                                "text": "Намерение было серьёзное: она вынула из кармана беленький батистовый платочек и взяла его за кончик, в правую ручку, чтобы махать им в пляске."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab7465fc-9180-3fe4-91a9-e0f64a5933a5",
                                        "entry_id": "038bf4d4-b223-35b7-9e13-6f3debde7829",
                                        "glosses": [
                                            "уменьш. к конец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181e648c-9063-4f36-8487-180ed4e6298a",
                                                "sense_id": "ab7465fc-9180-3fe4-91a9-e0f64a5933a5",
                                                "text": "Желая с матушкой проводить хотя кончик единственной в году недели и по обряду христиан с ней похристосоваться до истечения оной, я исполнил долг сей в субботу и заключил Святую неделю в родительском доме."
                                            },
                                            {
                                                "example_id": "635e8e0f-76b3-4c8d-8fbd-1c480b210d05",
                                                "sense_id": "ab7465fc-9180-3fe4-91a9-e0f64a5933a5",
                                                "text": "Потом, держа за кончик нитки, всю эту низку опускают в посуду, где вываренный виноградный сок загустел, как мёд."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91bf57a7-9e5d-4735-b872-1a7feb85159d",
                        "source_entry_id": "84e5ab71-66a2-3eb9-ac98-2e67bcc64e3e",
                        "source_sense_id": "ad9c5c62-9143-39f9-a33f-f5a342307d92",
