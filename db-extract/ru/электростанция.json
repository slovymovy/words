                        ]
                    },
                    {
                        "translation_id": "31255230-1c8c-43a3-928b-627116c5ad81",
                        "source_entry_id": "37aa56b9-69ad-3907-8ec6-edfc416c9da2",
                        "source_sense_id": "fb0adcaa-f8cd-390e-b7f7-c1ba467ef644",
                        "target_lang_word": "Elektrizitätswerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektrizitätswerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1637e2-6433-3e12-904a-4f0d6aee5c06",
                                        "entry_id": "d7dca5ab-6a1b-369b-918a-0d368d071546",
                                        "glosses": [
                                            "eine technische Anlage, in der elektrische Energie gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc47e35f-52c6-4a1f-909c-88ed7bec4637",
                                                "sense_id": "3d1637e2-6433-3e12-904a-4f0d6aee5c06",
                                                "text": "Häufig sind Elektrizitätswerke Bestandteil von Stadtwerken."
                                            },
                                            {
                                                "example_id": "9ac54cc7-4122-4c02-9769-560b7070a85d",
                                                "sense_id": "3d1637e2-6433-3e12-904a-4f0d6aee5c06",
                                                "text": "Das Elektrizitätswerk Aach versorgt die drei Gemeinden Aach, Eigeltingen und Volkertshausen mit elektrischer Energie."
                                            },
                                            {
                                                "example_id": "35c7fe16-4d93-4b3e-843e-8b3ac3760144",
                                                "sense_id": "3d1637e2-6433-3e12-904a-4f0d6aee5c06",
                                                "text": "„1920 sollte ein Elektrizitätswerk die Energie aus den Kaskaden nehmen, um Strom für Reykjavík zu liefern, auf Kosten dieses atemberaubenden Naturwunders.“"
                                            },
                                            {
                                                "example_id": "d1c49e4e-da35-4332-920b-ff71c3235fc9",
                                                "sense_id": "3d1637e2-6433-3e12-904a-4f0d6aee5c06",
                                                "text": "„Falls jemand doch noch eines versteckt hielte, bliebe es stumm, weil die Elektrizitätswerke keinen Strom mehr liefern oder die Überlandleitungen zerstört sind.“"
                                            },
                                            {
                                                "example_id": "7c7ce58e-8521-464a-b1d3-9ee8a2a2d1a4",
                                                "sense_id": "3d1637e2-6433-3e12-904a-4f0d6aee5c06",
                                                "text": "„Die Gruppe war deshalb so gefährlich, weil sie in einem praktisch unkontrollierbaren Gebiet voller wichtiger Eisenbahnlinien, Straßen und Elektrizitätswerke operierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5d4a01e-bccf-4658-a4dd-f330ac5d14ad",
                        "source_entry_id": "37aa56b9-69ad-3907-8ec6-edfc416c9da2",
                        "source_sense_id": "fb0adcaa-f8cd-390e-b7f7-c1ba467ef644",
