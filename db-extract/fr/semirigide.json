                    {
                        "sense_id": "e64fb637-b92b-33dc-a36f-83d1bf836daa",
                        "entry_id": "0c51c1e1-854e-3ffa-9333-6a6d1ab0be4f",
                        "glosses": [
                            "Se dit d'une molécule dont la surface d'énergie potentielle avec un minimum bien défini correspond à une structure stable de la molécule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47f55fd-71ee-4122-a303-f4f40820d001",
                                "sense_id": "e64fb637-b92b-33dc-a36f-83d1bf836daa",
                                "text": "Les seuls mouvements (quantiques) qu'une molécule semirigide effectue sont des petites vibrations internes autour de sa géométrie d'équilibre ainsi que les translations et rotations d'ensemble."
                            }
                        ]
                    },
