                                "target_senses": [
                                    {
                                        "sense_id": "c4ab873c-79ec-34f6-b6d7-247c85ba4b22",
                                        "entry_id": "5dfdeabc-11e0-3f2b-990c-7721d3139734",
                                        "glosses": [
                                            "Of, or relating to education."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd599a07-3cae-4d31-9c82-27556e3b186c",
                                                "sense_id": "c4ab873c-79ec-34f6-b6d7-247c85ba4b22",
                                                "text": "A school is an educational establishment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebff96ef-6be4-3e52-9de8-9d8f76d5325f",
                                        "entry_id": "5dfdeabc-11e0-3f2b-990c-7721d3139734",
                                        "glosses": [
                                            "Instructive, or helping to educate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f027334-b8be-45f9-ac8a-c2e182d1bac0",
                                                "sense_id": "ebff96ef-6be4-3e52-9de8-9d8f76d5325f",
                                                "text": "They were shown an educational film about VD."
                                            },
                                            {
                                                "example_id": "96eecaae-17da-4386-957c-46f3798a6933",
                                                "sense_id": "ebff96ef-6be4-3e52-9de8-9d8f76d5325f",
                                                "text": "I can't see the educational value of going on a field trip to the clothes factory."
                                            },
                                            {
                                                "example_id": "1d93c8db-0aac-4110-874f-aa2e4dd25781",
                                                "sense_id": "ebff96ef-6be4-3e52-9de8-9d8f76d5325f",
                                                "text": "Imagine a testless educational system up through the fifth grade. What effect would that have on children's later performance, or on our ability to prescribe individualized educational programs for them?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "educational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d98adff-f0c7-375f-92c9-f88ecf37b407",
                                        "entry_id": "e5835f56-3695-36ce-a11c-837a71bd5b41",
                                        "glosses": [
                                            "A free (or low cost) trip for travel consultants, provided by a travel operator or airline as a means of promoting their service. A fam trip"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aed481f4-6e90-3e4c-84c7-510053fa5340",
                                        "entry_id": "e5835f56-3695-36ce-a11c-837a71bd5b41",
                                        "glosses": [
                                            "An educational seminar, workshop, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b493c79c-cedc-4263-8eeb-94f363fea0fc",
                                                "sense_id": "aed481f4-6e90-3e4c-84c7-510053fa5340",
                                                "text": "Groups such as the Union of Young Communists, the Cuban Women's Federation, the Artists and Writers Union (UNEAC) and others have held internal and public educationals on the issue of homosexuality, using a recently produced video GAY CUBA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b30a535f-e582-4052-b578-6355150ff19d",
                        "source_entry_id": "07c676c0-ebbc-3c45-994b-2a89588c4275",
