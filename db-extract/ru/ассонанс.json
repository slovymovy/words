                                            {
                                                "example_id": "af665185-a8c3-4c6f-a8b6-0698ce0c3e84",
                                                "sense_id": "5ad0f96d-2ca8-3482-9f2b-e415f22a5004",
                                                "text": "Tus ideas tienen asonancia con las de este autor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ca574fe0-4c1d-3a53-8fd4-ac568cff9c80",
                                        "entry_id": "36f852e1-1e17-3325-894e-e365748127d7",
                                        "glosses": [
                                            "Coincidencia de vocales entre dos palabras a partir de la sílaba acentuada, sin que sean iguales las consonantes. Las vocales no acentuadas de los diptongos pueden ser diferentes. En palabras esdrújulas la penúltima sílaba también puede variar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afabd8ce-67fb-4e24-8641-8fb3ccc5af34",
                                                "sense_id": "ca574fe0-4c1d-3a53-8fd4-ac568cff9c80",
                                                "text": "Hay asonancia entre \"cálido\" y \"áspero\", y entre \"bueno\" y \"quiero\"."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c467ff67-0590-3004-a53d-a3cb75ba9509",
                                        "entry_id": "36f852e1-1e17-3325-894e-e365748127d7",
                                        "glosses": [
                                            "Emplear, dentro de una secuencia deliberada, palabras que tienen coincidencias sonoras en la sílaba final."
                                        ],
                                        "tags": [
                                            "Retórica"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
