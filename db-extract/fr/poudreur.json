                        "glosses": [
                            "Qui poudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67732ca3-6a3a-42a5-97b2-d0a0eca17387",
                                "sense_id": "2cd662fd-feb3-3d97-938c-c7599049b1e2",
                                "text": "Le talc, poudre fine et légère, s'applique en touche finale après le bain ou la douche. (…) Flacon poudreur : 20 F."
                            },
                            {
                                "example_id": "e2c48b52-3af0-4e2e-90da-7d78859efd45",
                                "sense_id": "2cd662fd-feb3-3d97-938c-c7599049b1e2",
                                "text": "Le charme du Talc au Magnolia ou à l'Orange de Molton Brown, aux odeurs délicates, dans « boîte-poudreuse » en carton."
                            }
                        ]
                    }
                ],
                "translations": [
