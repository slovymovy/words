                "senses": [
                    {
                        "sense_id": "74a4113e-f0f2-32ce-a6c3-5ce609abe74c",
                        "entry_id": "93935510-5cb2-3efb-9ef5-0e43b522dc1c",
                        "glosses": [
                            "to jump (up, onto, out of), to leap (on, into, onto), to get up quickly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2665c4c9-dabe-43be-8338-c570fbd32f98",
                                "sense_id": "74a4113e-f0f2-32ce-a6c3-5ce609abe74c",
                                "text": "вска́кивать на́ ноги",
                                "translation": "to leap / spring to one's feet",
                                "english": "to leap / spring to one's feet"
                            },
                            {
                                "example_id": "a7078e34-8cfa-4b53-afa2-4418b88fa96c",
                                "sense_id": "74a4113e-f0f2-32ce-a6c3-5ce609abe74c",
                                "text": "вска́кивать с посте́ли",
                                "translation": "to jump out of bed",
                                "english": "to jump out of bed"
                            },
                            {
                                "example_id": "5785da6b-84d8-4dc3-90a0-72dfbb854486",
                                "sense_id": "74a4113e-f0f2-32ce-a6c3-5ce609abe74c",
                                "text": "Мужчи́ны вска́кивали со сту́льев и бежа́ли отнима́ть у слуг блю́да, что́бы с необыкнове́нною ло́вкостию предложи́ть их да́мам.",
                                "translation": "The gentlemen jumped up from their chairs and ran to take the dishes from the servants to offer them with rare adroitness to the ladies.",
                                "english": "The gentlemen jumped up from their chairs and ran to take the dishes from the servants to offer them with rare adroitness to the ladies."
                            }
                        ]
                    },
                    {
                        "sense_id": "29e2f673-cc31-3067-a827-2d098ce1e4b1",
                        "entry_id": "93935510-5cb2-3efb-9ef5-0e43b522dc1c",
                        "glosses": [
                            "to rise, to swell (up), to come up (e.g. a pimple on the face, a bump on the head)"
                        ],
