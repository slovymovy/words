                        "sense_id": "73f88973-ca6a-3390-9ebe-5ff583e2fbcb",
                        "entry_id": "5176f035-8e4c-33d6-8990-1acc8103ea79",
                        "glosses": [
                            "содержащий гротеск или являющийся гротеском"
                        ],
