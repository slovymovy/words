{
    "word_family": [
        "slush",
        "slushiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ab2afc61-ee37-3e0e-b70d-e3df5f48e106",
                    "sense_definition": "Covered with or consisting of melting snow or ice mixed with dirt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slush_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sidewalk was covered in cold, <w>slushy</w> snow after the morning storm.",
                            "target_lang_translations": {
                                "it": "Il marciapiede era coperto di neve fredda e <w>fangosa</w> dopo il temporale del mattino."
                            }
                        },
                        {
                            "text": "She wore waterproof boots to walk through the <w>slushy</w> streets.",
                            "target_lang_translations": {
                                "it": "Indossava stivali impermeabili per camminare attraverso le strade <w>piene di fanghiglia</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slushy snow",
                        "slushy streets"
                    ],
                    "target_lang_definitions": {
                        "it": "Coperto da o costituito da neve o ghiaccio che si scioglie, spesso mista a fango."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fangoso",
                                "target_lang_sense_clarification": "di neve mista a fango o melma"
                            },
                            {
                                "target_lang_word": "pieno di fanghiglia",
                                "target_lang_sense_clarification": "coperto da neve mista ad acqua"
                            },
                            {
                                "target_lang_word": "melmoso",
                                "target_lang_sense_clarification": "dall'aspetto di melma acquosa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d49c0d0-de27-3dfd-a745-fad9f5b310e0",
                    "sense_definition": "Having a thick, semi-liquid consistency resembling melting ice or wet mud.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "slush_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crushed ice melted quickly into a <w>slushy</w> liquid in the summer heat.",
                            "target_lang_translations": {
                                "it": "Il ghiaccio tritato si è sciolto rapidamente in un liquido <w>melmoso</w> con il caldo estivo."
                            }
                        },
                        {
                            "text": "Stir the mixture continuously until it reaches a thick, <w>slushy</w> consistency.",
                            "target_lang_translations": {
                                "it": "Mescola continuamente il composto finché non raggiunge una consistenza densa e <w>poltacea</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slushy consistency",
                        "slushy mixture"
                    ],
                    "target_lang_definitions": {
                        "it": "Di consistenza densa e semiliquida, simile a ghiaccio tritato o fango bagnato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "poltaceo",
                                "target_lang_sense_clarification": "ridotto a poltiglia"
                            },
                            {
                                "target_lang_word": "melmoso",
                                "target_lang_sense_clarification": "denso e semiliquido"
                            },
                            {
                                "target_lang_word": "semiliquido",
                                "target_lang_sense_clarification": "consistenza parzialmente fluida"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08dd8256-afda-38df-85f3-474480a77e4d",
                    "sense_definition": "Excessively emotional, romantic, or sentimental in an exaggerated way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He usually avoids watching <w>slushy</w> romantic movies with predictable endings.",
                            "target_lang_translations": {
                                "it": "Di solito evita di guardare film romantici <w>sdolcinati</w> dal finale prevedibile."
                            }
                        },
                        {
                            "text": "The card was filled with rather <w>slushy</w> poetry about eternal devotion.",
                            "target_lang_translations": {
                                "it": "Il biglietto era pieno di poesie piuttosto <w>melense</w> sull'eterna devozione."
                            }
                        }
                    ],
                    "synonyms": [
                        "maudlin",
                        "mushy",
                        "sappy",
                        "sentimental"
                    ],
                    "antonyms": [
                        "unsentimental"
                    ],
                    "common_phrases": [
                        "slushy romance"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal or slightly derogatory when applied to media or feelings"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Eccessivamente sentimentale, sdolcinato o romantico in modo esagerato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sdolcinato",
                                "target_lang_sense_clarification": "eccessivamente mieloso o romantico"
                            },
                            {
                                "target_lang_word": "melenso",
                                "target_lang_sense_clarification": "stucchevole ed eccessivamente emotivo"
                            },
                            {
                                "target_lang_word": "stucchevole",
                                "target_lang_sense_clarification": "che disgusta per eccesso di dolcezza"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c3b91b9-67d2-3fa8-96e1-e7f262c297c7",
                    "sense_definition": "Alternative form of <w>slushie</w> (a flavoured frozen beverage made from finely crushed ice).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children bought a cherry <w>slushy</w> to cool down at the amusement park.",
                            "target_lang_translations": {
                                "it": "I bambini hanno comprato una <w>granita</w> alla ciliegia per rinfrescarsi al parco divertimenti."
                            }
                        },
                        {
                            "text": "Drinking a cold <w>slushy</w> too fast can easily give you a headache.",
                            "target_lang_translations": {
                                "it": "Bere una <w>granita</w> fredda troppo in fretta può facilmente farti venire il mal di testa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Bevanda fredda e aromatizzata a base di ghiaccio finemente tritato; granita."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "granita",
                                "target_lang_sense_clarification": "bevanda a base di ghiaccio tritato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c84b701b-5af0-3252-abda-8fa9415c1dfc",
                    "sense_definition": "A ship's cook.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kitchen_worker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors often complained about the meals prepared by the ship's <w>slushy</w>.",
                            "target_lang_translations": {
                                "it": "I marinai si lamentavano spesso dei pasti preparati dal <w>cuoco di bordo</w>."
                            }
                        },
                        {
                            "text": "Before dawn, the <w>slushy</w> was already busy preparing breakfast for the entire crew.",
                            "target_lang_translations": {
                                "it": "Prima dell'alba, il <w>cuoco di bordo</w> era già occupato a preparare la colazione per l'intero equipaggio."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "nautical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Il cuoco di bordo su una nave (termine marinaresco e gergale)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "cuoco di bordo",
                                "target_lang_sense_clarification": "cuoco su una nave"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cd31689-a63d-3fcb-9c51-f84b93cad98a",
                    "sense_definition": "An assistant or kitchen helper.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kitchen_worker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began his culinary career working as a humble <w>slushy</w> in a restaurant kitchen.",
                            "target_lang_translations": {
                                "it": "Ha iniziato la sua carriera culinaria lavorando come umile <w>sguattero</w> nella cucina di un ristorante."
                            }
                        },
                        {
                            "text": "The head chef ordered the <w>slushy</w> to peel fifty pounds of potatoes.",
                            "target_lang_translations": {
                                "it": "Lo chef capo ha ordinato allo <w>sguattero</w> di sbucciare cinquanta libbre di patate."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated informal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Assistente o aiutante di cucina (termine gergale e desueto)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sguattero",
                                "target_lang_sense_clarification": "aiutante di cucina addetto a compiti umili"
                            },
                            {
                                "target_lang_word": "aiuto cuoco",
                                "target_lang_sense_clarification": "assistente in cucina"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}