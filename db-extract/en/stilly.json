                        "sense_id": "b7da1155-73ab-38cb-bca7-27fde7bc4665",
                        "entry_id": "c3f66131-0faa-370c-b942-e9997eb2f2a5",
                        "glosses": [
                            "silent; calm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d09377-94b5-4236-93d3-e288ba4a37c9",
                                "sense_id": "b7da1155-73ab-38cb-bca7-27fde7bc4665",
                                "text": "The stilly murmur of the distant Sea\nTells us of silence."
                            },
                            {
                                "example_id": "17de0fa8-b5e8-4dc6-bc38-5d6d7aa4ad70",
                                "sense_id": "b7da1155-73ab-38cb-bca7-27fde7bc4665",
                                "text": "The dead--in holy, stilly peace, the sacred dead repose, Afar from earth's turmoil and grief, and all of sick'ning woes; From racking pain, and withering pride, and avarice's care, Secure they rest in solitude, unaw'd by sin or snare."
                            },
                            {
                                "example_id": "a4aa916e-405a-4d16-85d9-1feffeb9f2c9",
                                "sense_id": "b7da1155-73ab-38cb-bca7-27fde7bc4665",
                                "text": "Long was the darkness, Lonely and stilly."
                            },
                            {
                                "example_id": "37dd9a20-2303-4858-870a-aa2574a8a0b3",
                                "sense_id": "b7da1155-73ab-38cb-bca7-27fde7bc4665",
                                "text": "Crickets sang of nights in the stilly cabins, and in the sunshine mosquitoes crept from out hollow logs […]."
                            },
                            {
                                "example_id": "ab172319-7ffe-4944-8f59-63c6dccaa07f",
                                "sense_id": "b7da1155-73ab-38cb-bca7-27fde7bc4665",
                                "text": "[…] Marjorie used Central to call as many of her neighbors that were also on the exchange as she could, telling them of the disaster which had fallen like a lightning-stroke out of a clear sky, knowing that each call would produce overlapping ripples, like pebbles tossed rapidly into a stilly pond."
                            }
                        ]
                    }
