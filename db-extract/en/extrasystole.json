                    {
                        "sense_id": "8d864bac-3482-35f9-8f0c-95184d0a7ffe",
                        "entry_id": "c1f5c699-0067-3ace-9145-1cc131c2e7d1",
                        "glosses": [
                            "A premature contraction of the heart, producing an interruption or irregularity in heartbeat rhythm, associated with heart disease or the use of some pharmaceuticals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10631868-ded4-4479-a2a4-345aff7482fc",
                                "sense_id": "8d864bac-3482-35f9-8f0c-95184d0a7ffe",
                                "text": "An extrasystole originating at the rhythmic centre is thus followed by a returning cycle of natural length."
                            },
                            {
                                "example_id": "500ba19b-613d-4686-b7bf-da578605736e",
                                "sense_id": "8d864bac-3482-35f9-8f0c-95184d0a7ffe",
                                "text": "A 30-year-old woman, with no heart disease, was referred to our center with a history of rare episodes of sustained tachycardia and frequent feeling of extrasystoles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48dc3622-4cbf-4682-a537-a1765afa1bf8",
                        "source_entry_id": "c1f5c699-0067-3ace-9145-1cc131c2e7d1",
                        "source_sense_id": "8d864bac-3482-35f9-8f0c-95184d0a7ffe",
                        "source_sense_description": "premature contraction of the heart",
                        "target_lang_word": "Extrasystole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Extrasystole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81db44ca-fb57-39cd-8eff-324473c204b0",
                                        "entry_id": "c64fb413-dbd8-3a24-bd2e-e3906dffe5a8",
                                        "glosses": [
                                            "Zusammenziehung des Herzens, die außerhalb des normalen Herzrhythmus auftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc29e1f-df0f-492a-90d7-3e4332306e91",
                                                "sense_id": "81db44ca-fb57-39cd-8eff-324473c204b0",
                                                "text": "„Auch wenn Extrasystolen (oft als Herzstolpern spürbar) meist völlig ungefährlich sind, können die Beschwerden so stark werden, dass dennoch eine Behandlung sinnvoll ist.“"
                                            },
                                            {
                                                "example_id": "5f524960-9a78-4aa0-9541-5f778925694f",
                                                "sense_id": "81db44ca-fb57-39cd-8eff-324473c204b0",
                                                "text": "„Auch wenn das Herzjagen mit unregelmäßiger Schlagfolge verbunden ist oder gelegentlich extra Herzschläge auftreten, die Extrasystolen, dann sind diese Störungen vielleicht lästig aber meist ohne ernsthafte Bedeutung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
