                                        "examples": [
                                            {
                                                "example_id": "c5083c4f-9d3e-444e-8fb1-bed058da0634",
                                                "sense_id": "e356f6a6-fbda-3973-a5ab-3b378a09df79",
                                                "text": "Spülmaschinen werden in vielen Bereichen verwendet."
                                            },
                                            {
                                                "example_id": "191d3717-ce53-4722-8b17-a02e73accca7",
                                                "sense_id": "e356f6a6-fbda-3973-a5ab-3b378a09df79",
                                                "text": "„Wenn die Spülmaschine lief, setzte Mama sich ins Wohnzimmer und blätterte im Stern, bevor die Hausarbeit wieder losging.“"
                                            },
                                            {
                                                "example_id": "19b7652d-2d4d-4adc-bc7a-81b4752a73b9",
                                                "sense_id": "e356f6a6-fbda-3973-a5ab-3b378a09df79",
                                                "text": "„Die Pizzakartons lagen auf dem Küchentisch, Legosteine im Wohnzimmer, und er hatte noch immer nicht die Spülmaschine ausgeräumt, sodass sich in der Spüle das dreckige Geschirr stapelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "430e4601-ba1c-4ba7-8b2f-945f39edfd43",
                        "source_entry_id": "884c9050-3de1-3eda-a968-da9330ba4ca4",
                        "source_sense_id": "8a1b6b8e-8da2-3a04-bc16-b2c4e31c0b7e",
                        "target_lang_word": "Geschirrspüler",
