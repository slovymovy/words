                "senses": [
                    {
                        "sense_id": "1550980d-0088-34a8-b233-e21f270c3420",
                        "entry_id": "09942ff3-f713-3ed8-b332-43b2b9f632bf",
                        "glosses": [
                            "Pôle technologique : site urbain sur lequel sont réunies des activités de technologie de pointe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de53ff4-a75f-402b-87de-b6795d82206a",
                                "sense_id": "1550980d-0088-34a8-b233-e21f270c3420",
                                "text": "L'expérience tunisienne relève d'une logique interventionniste à travers laquelle l’État, dans le cadre de sa politique industrielle, assure le financement et l'encadrement de la technopole d'Ariana."
                            },
                            {
                                "example_id": "56b4c7f2-a758-478a-bba2-5f4935bb2a63",
                                "sense_id": "1550980d-0088-34a8-b233-e21f270c3420",
                                "text": "Le territoire devient technopole non plus en raison de la présence a priori d'une ressource, d'une activité ou d'un marché, mais parce qu'il noue entre ces éléments des échanges en ressources immatérielles."
                            },
                            {
                                "example_id": "3917f945-d3d1-4cf3-b058-b6755a5268b9",
                                "sense_id": "1550980d-0088-34a8-b233-e21f270c3420",
                                "text": "Le 17 avril à Savoie Technolac, sera inaugurée l’extension de la pépinière d’entreprises du technopôle dédiée au solaire."
                            }
                        ]
                    }
                ],
