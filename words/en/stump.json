{
    "word_family": [
        "stumper",
        "stumpy",
        "unstumpable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cad84e29-af96-3469-8305-b9ecdc182a98",
                    "sense_definition": "the bottom part of a tree left in the ground after the rest has fallen or been cut down",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "remains",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lumberjack sat down on a large <w>stump</w> to rest after a long day of work.",
                            "target_lang_translations": {
                                "ru": "Лесоруб присел на большой <w>пень</w>, чтобы отдохнуть после долгого рабочего дня."
                            }
                        },
                        {
                            "text": "We had to dig around the old <w>stump</w> to remove it from the garden.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось обкопать старый <w>пенёк</w>, чтобы убрать его из сада."
                            }
                        }
                    ],
                    "synonyms": [],
                    "target_lang_definitions": {
                        "ru": "нижняя часть дерева, оставшаяся в земле после того, как остальная часть упала или была срублена"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пень",
                                "target_lang_sense_clarification": "остаток срубленного дерева"
                            },
                            {
                                "target_lang_word": "пенёк",
                                "target_lang_sense_clarification": "небольшой пень"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c0f575f-9102-3580-abf2-e97ac9dff881",
                    "sense_definition": "one of the three vertical wooden posts that form the wicket in the game of cricket",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cricket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fast bowler managed to hit the off <w>stump</w> and knock it out of the ground.",
                            "target_lang_translations": {
                                "ru": "Боулеру удалось попасть в крайний <w>столбик</w> и выбить его из земли."
                            }
                        },
                        {
                            "text": "The batsman stood guard in front of the <w>stump</w> to protect his wicket.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен замер перед <w>столбиком</w>, защищая свою калитку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "один из трех вертикальных деревянных столбиков, образующих калитку в крикете"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столбик",
                                "target_lang_sense_clarification": "в крикетной калитке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7bb596d-adb0-366a-9365-ac2a107460fe",
                    "sense_definition": "a place or occasion used for political speeches and electioneering",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate spent the entire month on the <w>stump</w> trying to win over undecided voters.",
                            "target_lang_translations": {
                                "ru": "Кандидат провел целый месяц на <w>трибуне</w>, пытаясь привлечь на свою сторону неопределившихся избирателей."
                            }
                        },
                        {
                            "text": "He is very effective on the <w>stump</w> because he speaks with such passion.",
                            "target_lang_translations": {
                                "ru": "Он очень эффективен в <w>агитации</w>, потому что говорит с такой страстью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the stump"
                    ],
                    "target_lang_definitions": {
                        "ru": "место или повод для политических выступлений и предвыборной агитации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трибуна",
                                "target_lang_sense_clarification": "для политических речей"
                            },
                            {
                                "target_lang_word": "агитационная площадка",
                                "target_lang_sense_clarification": "место выступления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1187aa0-a3e9-3834-a31d-7f76d1898f1d",
                    "sense_definition": "a tool made of rolled paper used by artists to smudge or blend charcoal or pencil drawings",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "art_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a paper <w>stump</w> to create a soft shadow on the portrait.",
                            "target_lang_translations": {
                                "ru": "Она использовала бумажную <w>растушёвку</w>, чтобы создать мягкую тень на портрете."
                            }
                        },
                        {
                            "text": "A clean <w>stump</w> is essential for blending light areas without adding dark residue.",
                            "target_lang_translations": {
                                "ru": "Чистый <w>торшон</w> необходим для растушевки светлых участков без добавления темных пятен."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "инструмент из скрученной бумаги, используемый художниками для растушевки рисунков углем или карандашом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растушёвка",
                                "target_lang_sense_clarification": "бумажный инструмент художника"
                            },
                            {
                                "target_lang_word": "торшон",
                                "target_lang_sense_clarification": "инструмент для растушевки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ffc6c88-d915-3736-835f-14f7f6279d46",
                    "sense_definition": "a person's leg",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is time to stir your <w>stumps</w> and get some exercise this morning.",
                            "target_lang_translations": {
                                "ru": "Пора бы уже размять свои <w>копыта</w> и сделать зарядку этим утром."
                            }
                        },
                        {
                            "text": "He moved his heavy <w>stumps</w> slowly across the room toward the chair.",
                            "target_lang_translations": {
                                "ru": "Он медленно передвигал свои тяжелые <w>ходули</w> через комнату к креслу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stir one's stumps"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нога человека (разговорное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копыта",
                                "target_lang_sense_clarification": "шутливо о ногах"
                            },
                            {
                                "target_lang_word": "ходули",
                                "target_lang_sense_clarification": "разговорно о ногах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf4c7dae-fde7-3212-b12e-3335790600ba",
                    "sense_definition": "to baffle or confuse someone so much that they cannot find an answer or solution",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult math problem completely <w>stumped</w> the entire class.",
                            "target_lang_translations": {
                                "ru": "Сложная математическая задача полностью <w>озадачила</w> весь класс."
                            }
                        },
                        {
                            "text": "I was <w>stumped</w> by the riddle and had to ask for a hint.",
                            "target_lang_translations": {
                                "ru": "Загадка <w>поставила меня в тупик</w>, и мне пришлось просить подсказку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "поставить в тупик или запутать кого-либо так сильно, что он не может найти ответ или решение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озадачить",
                                "target_lang_sense_clarification": "поставить в тупик"
                            },
                            {
                                "target_lang_word": "поставить в тупик",
                                "target_lang_sense_clarification": "сбить с толку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0422073b-2887-3a25-875f-76a11addf719",
                    "sense_definition": "to walk with heavy, noisy, or clumsy steps",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>stump</w> around the house in his heavy boots, waking everyone up.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>топать</w> по дому в своих тяжелых сапогах, разбудив всех."
                            }
                        },
                        {
                            "text": "The angry man <w>stumped</w> out of the room without saying a word.",
                            "target_lang_translations": {
                                "ru": "Рассерженный мужчина <w>выковылял</w> из комнаты, не сказав ни слова."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ходить тяжелыми, шумными или неуклюжими шагами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топать",
                                "target_lang_sense_clarification": "тяжело шагать"
                            },
                            {
                                "target_lang_word": "ковылять",
                                "target_lang_sense_clarification": "неуклюже идти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b72918c-cc56-36fb-a7cc-feebd3bfc5d7",
                    "sense_definition": "to travel around an area making political speeches during an election campaign",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator will <w>stump</w> for the new candidate throughout the rural districts.",
                            "target_lang_translations": {
                                "ru": "Сенатор будет <w>агитировать</w> за нового кандидата во всех сельских округах."
                            }
                        },
                        {
                            "text": "They have been <w>stumping</w> for environmental reform for several months now.",
                            "target_lang_translations": {
                                "ru": "Они уже несколько месяцев <w>выступают</w> за экологическую реформу."
                            }
                        }
                    ],
                    "synonyms": [
                        "campaign"
                    ],
                    "common_phrases": [
                        "stump for"
                    ],
                    "target_lang_definitions": {
                        "ru": "ездить по региону с политическими речами во время избирательной кампании"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агитировать",
                                "target_lang_sense_clarification": "выступать с речами"
                            },
                            {
                                "target_lang_word": "проводить кампанию",
                                "target_lang_sense_clarification": "ездить с выступлениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "923a5916-4851-38ab-a760-5cd20c38b4b9",
                    "sense_definition": "to dismiss a batsman in cricket by touching the wicket with the ball while the batsman is out of their ground",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wicket-keeper was quick enough to <w>stump</w> the batsman before he could return.",
                            "target_lang_translations": {
                                "ru": "Викет-кипер сработал достаточно быстро, чтобы <w>выбить</w> бэтсмена до того, как тот успел вернуться."
                            }
                        },
                        {
                            "text": "He was <w>stumped</w> for a duck in the very first over of the match.",
                            "target_lang_translations": {
                                "ru": "Его <w>вывели из игры</w> с нулевым счетом в самом первом овере матча."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вывести бэтсмена из игры в крикете, коснувшись калитки мячом, пока бэтсмен находится вне зоны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбить",
                                "target_lang_sense_clarification": "бэтсмена в крикете"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c52a655a-3c00-3449-83de-dc30b21a3d92",
                    "sense_definition": "a <w>surname</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after a prominent citizen named Arthur <w>Stump</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь выдающегося гражданина по имени Артур <w>Стамп</w>."
