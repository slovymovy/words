                    },
                    {
                        "form_id": "caaa9d25-9faa-450f-aa19-6437b0223b58",
                        "entry_id": "4ce33d92-baf0-3298-b1f4-9b8417935af1",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Tristesse"
                    },
                    {
                        "form_id": "9839fdff-c9c3-4c1a-8614-3db2623e8251",
                        "entry_id": "4ce33d92-baf0-3298-b1f4-9b8417935af1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tristessen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                        "entry_id": "4ce33d92-baf0-3298-b1f4-9b8417935af1",
                        "glosses": [
                            "Gefühl der Traurigkeit, der Trübseligkeit, des Jammers oder der Ödnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0602ee7-c0b5-40ce-9e12-6bcc03e1125f",
                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                "text": "Sein Dasein ist an biederer Tristesse wohl gemeinhin nicht zu überbieten."
                            },
                            {
                                "example_id": "d55f4376-d549-445c-9c7e-dcd78ffc7ab3",
                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                "text": "„Das waren Lieder, die die Tristesse des Alltags mit so etwas wie Taumel der Sinne beantworteten.“"
                            },
                            {
                                "example_id": "0a50d6f7-e52a-43bc-b7af-9dc2487f9ed2",
                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                "text": "„Egal, wie viel Licht in die Straße fiel, die Tristesse blieb, eine Tristesse, die nur noch zunehmen würde.“"
                            },
                            {
                                "example_id": "fab8b04e-cd77-4dec-85f7-8ce8b39ef07e",
                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                "text": "„Diese Tristesse mache auch sie depressiv.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                        "entry_id": "4ce33d92-baf0-3298-b1f4-9b8417935af1",
                        "glosses": [
                            "ästhetischer Eindruck der Langeweile, Geistlosigkeit oder Mangel an Abwechslung beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d022087-8f86-46aa-832a-2b050da7e978",
                                "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                                "text": "Die minimalen bis monotonen Stücke sind durch eine große immanente Tristesse gekennzeichnet."
                            },
                            {
                                "example_id": "0fa127c0-c1da-4f7f-bef4-2ec77540a7d5",
                                "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                                "text": "„Um der Tristesse zu entgehen, nimmt sie Kontakt zu einheimischen Frauen auf, interessiert sich für ihr Handwerk, lernt ihre Sprachen, sammelt ihre Geschichten und Märchen, reist mehrmals durch Kaschmir.“"
                            },
                            {
                                "example_id": "7ab7f95a-b1f3-4694-917b-c5f0e1be281a",
                                "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                                "text": "„Franc ließ sich von der Dunkelheit und der Tristesse des Ortes wenig beeindrucken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64977081-de9f-4d56-8818-8c60ef90fe87",
                        "source_entry_id": "4ce33d92-baf0-3298-b1f4-9b8417935af1",
                        "source_sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                        "source_sense_description": "Gefühl der Traurigkeit, der Trübseligkeit, des Jammers oder der Ödnis",
                        "target_lang_word": "tristesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tristesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                        "entry_id": "f9aec385-bd99-3c30-a65c-0d73371e340e",
                                        "glosses": [
                                            "Affliction, état de dépression morale causé par quelque événement fâcheux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca78f747-8d1a-4d63-a6e1-9dbfd7315433",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "Il est tombé dans une grande tristesse."
                                            },
                                            {
                                                "example_id": "b72e908a-6b22-4dee-b6c0-07994932a5bf",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "La tristesse est finalement l'expression douloureuse du manque."
                                            },
                                            {
                                                "example_id": "1b9694f6-716a-4901-8caf-4fec13cecc04",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "[…] : légère, étourdie, folle même, elle riait de tout, ne s’intéressait à rien; confondait la tristesse avec l’humeur, et ne voyait dans une personne affligée qu’une personne ennuyeuse."
                                            },
                                            {
                                                "example_id": "d556e306-01dd-4ca1-afa0-129498964192",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "Avril est de retour,\nLa première des roses,\nDe ses lèvres mi-closes,\nRit au premier beau jour,\nLa terre bienheureuse\nS’ouvre et s’épanouit,\nTout aime, tout sourit,\nHélas ! j’ai dans le cœur une tristesse affreuse."
                                            },
                                            {
                                                "example_id": "b2c6a75c-a192-4ba3-9aa4-25fedb7114c8",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "La physionomie de la Renaude prit une expression de gravité et de tristesse profonde."
                                            },
                                            {
                                                "example_id": "1466562f-cffb-497d-8fc3-d685b10573dc",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "C'est l’absence de sublime qui fait peur à Renan ; comme tous les vieillards en leurs jours de tristesse, il pense à son enfance […]."
                                            },
                                            {
                                                "example_id": "b2e9a6f2-dae2-433c-9539-de86d793384b",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "Sur ce sentiment inconnu dont l'ennui, la douceur m'obsèdent, j'hésite à apposer le nom, le beau nom grave de tristesse."
                                            },
                                            {
                                                "example_id": "f58ee159-8afd-4779-9aa7-5f0f9c91a5c9",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "Et cette tristesse semblait emporter avec elle la chose à laquelle il tenait plus que tout au monde, son énergie vitale."
                                            },
                                            {
                                                "example_id": "3f7053bf-901d-4460-9405-a967ba9c569f",
                                                "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                                                "text": "Je l'ai vu dans des squares avoir des tristesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f836ec3a-a019-3178-af34-cc1e217bd6a9",
                                        "entry_id": "f9aec385-bd99-3c30-a65c-0d73371e340e",
                                        "glosses": [
                                            "Mélancolie de tempérament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2acb515a-3cde-4166-987e-8866eaade404",
                                                "sense_id": "f836ec3a-a019-3178-af34-cc1e217bd6a9",
                                                "text": "Karl s’arrêta de nouveau un instant pour examiner cette étrange tristesse, plus étrange encore chez l’hôte lui-même, qui semblait avoir donné aux autres toute la joie et n’avoir gardé que les soucis, […]."
                                            },
                                            {
                                                "example_id": "7f60ec31-f7b0-4cf3-a524-864fc3a390f6",
                                                "sense_id": "f836ec3a-a019-3178-af34-cc1e217bd6a9",
                                                "text": "Yasmina avait bien remarqué la tristesse et l’inquiétude croissante de son Mabrouk, […]."
                                            },
                                            {
                                                "example_id": "8525b07c-2966-40b1-a02a-d74bd69f4c99",
                                                "sense_id": "f836ec3a-a019-3178-af34-cc1e217bd6a9",
                                                "text": "C’est un homme qui est né avec un fond de tristesse."
                                            },
                                            {
                                                "example_id": "ef5aa82e-b2af-4e44-83e3-cff52f029d35",
                                                "sense_id": "f836ec3a-a019-3178-af34-cc1e217bd6a9",
                                                "text": "La tristesse est naturellement répandue sur son visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ab71d35-c9bd-3755-8aed-a5b5ca69f95d",
                                        "entry_id": "f9aec385-bd99-3c30-a65c-0d73371e340e",
                                        "glosses": [
                                            "Ambiance où se marque de l’affliction, de la mélancolie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bce90e7-2156-48c8-9535-36411fd8acc6",
                                                "sense_id": "7ab71d35-c9bd-3755-8aed-a5b5ca69f95d",
                                                "text": "Le dîner, la soirée a été d’une grande tristesse à la suite de cette nouvelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7670c4ea-e295-3c5a-83be-4add7a74c074",
                                        "entry_id": "f9aec385-bd99-3c30-a65c-0d73371e340e",
                                        "glosses": [
                                            "Aspect d’une chose qui nous met dans un état d’affliction ou de mélancolie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35bda5a-e8be-432d-8c78-753aa3b1e910",
                                                "sense_id": "7670c4ea-e295-3c5a-83be-4add7a74c074",
                                                "text": "Cet avis mortuaire, avec son laconisme, me parut d’une indicible tristesse et m’imposa la vision d’un de ces mornes corbillards qui, parfois, traversent Paris à vive allure sans personne derrière eux."
                                            },
                                            {
                                                "example_id": "f1266adf-d650-4d55-bffa-8b1be3d0411b",
                                                "sense_id": "7670c4ea-e295-3c5a-83be-4add7a74c074",
                                                "text": "Ce paysage est d’une tristesse pénétrante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
