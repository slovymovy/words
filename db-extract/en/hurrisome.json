                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebb32f6-8fbd-4005-bc01-e422d553e0a7",
                                "sense_id": "b3e7e9a1-9e40-3111-9f6b-9af6f1c5bb39",
                                "text": "Don't be hurrisome or you'll pay for it with a broken head."
                            },
                            {
                                "example_id": "c5ba5f07-fdc2-454e-9d35-819244ae398a",
                                "sense_id": "b3e7e9a1-9e40-3111-9f6b-9af6f1c5bb39",
                                "text": "Although the brisket was excellent, Elbert seemed a tad hurrisome to conclude the meal so she would stop talking."
                            },
                            {
                                "example_id": "4dddd64a-158f-480b-a5a8-2db3e5ac5d42",
                                "sense_id": "b3e7e9a1-9e40-3111-9f6b-9af6f1c5bb39",
                                "text": "The murderer of Marcia's husband stripped off rubber gloves, thrust gloves and envelope deeply away, then fled in a stroll northward toward an exit different from the place of entry ... to a hurrisome eye just another foolhardy New Yorker defying the statistics of Central Park's nighttime crime."
                            },
                            {
                                "example_id": "9d2b73f4-59fa-4c09-92f2-90553a075b22",
                                "sense_id": "b3e7e9a1-9e40-3111-9f6b-9af6f1c5bb39",
                                "text": "Levashev shrugged; the shrug said that Americans were a hurrisome people."
                            }
