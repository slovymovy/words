                "senses": [
                    {
                        "sense_id": "879b1860-d38e-3855-beff-31d2e67d4312",
                        "entry_id": "d195d362-ae7a-3cfd-8434-ea748190db59",
                        "glosses": [
                            "Lésiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab00ca8-045d-4986-8908-96f9aecaef25",
                                "sense_id": "879b1860-d38e-3855-beff-31d2e67d4312",
                                "text": "Faut pourtant du blé pour faire du pain. Si tout le monde se met à rétrillonner comme vous, le gouvernement sera bien planté…"
                            },
                            {
                                "example_id": "cd52635d-6b67-440e-ac1e-d08b07bf7807",
                                "sense_id": "879b1860-d38e-3855-beff-31d2e67d4312",
                                "text": "C’est que, au jour d’aujourd'hui, avec les prix de misère que le négoce nous donne pour nos récoltes, si les engrais n’ont pas une action visible, claire comme le jour, on doute, on rétrillonne, on serre les cordons de la bourse et on s’en passe."
                            }
                        ]
                    }
