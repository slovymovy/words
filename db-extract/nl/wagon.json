                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a993eec-aeb2-3cfa-8381-4ce81f7dff34",
                                        "entry_id": "906a4360-afdb-3e5f-b9da-02c9fbd83328",
                                        "glosses": [
                                            "A stroller; a baby carriage."
                                        ],
                                        "tags": [
                                            "British",
