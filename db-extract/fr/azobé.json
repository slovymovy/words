                "senses": [
                    {
                        "sense_id": "72682c68-6cb3-3cdb-bebe-bc8584d5334e",
                        "entry_id": "62bdd789-ff49-30ec-9c14-60483abbcf33",
                        "glosses": [
                            "Non usuel de Lophira alata, arbre d'Afrique équatoriale d'un genre monospécifique de la famille des Ochnaceae (Ochnacées), au bois dur et dense, imputrescible et d’hygrophobe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30744ac0-e0d8-4fd8-b495-3415bd6f5aa1",
                                "sense_id": "72682c68-6cb3-3cdb-bebe-bc8584d5334e",
                                "text": "… puis ayant repéré non loin de là un azobé qui dispensait une ombre pauvre, il s'y dirigea, Ferral sur ses talons."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9dc8a16-83dc-34ca-a23b-32ddc511eace",
                        "entry_id": "62bdd789-ff49-30ec-9c14-60483abbcf33",
                        "glosses": [
                            "Bois de cet arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0fff106-38e3-4430-8921-980f2d992a97",
                                "sense_id": "b9dc8a16-83dc-34ca-a23b-32ddc511eace",
                                "text": "Le sol est constitué de caillebotis en bois exotique, habituellement l’azobé, qui offre d’excellentes qualités de résistance à l’usure et à l’humidité."
                            },
                            {
                                "example_id": "d0de3f6a-24d3-4372-960e-457c14112a39",
                                "sense_id": "b9dc8a16-83dc-34ca-a23b-32ddc511eace",
                                "text": "Votre passerelle\nLéopold Sédar Senghor\nVotre passerelle d’azobé\npoète\nremplace\nle pont effondré\nen métal ?\nen marbre ?\ncommémorant Napoléon\n- pas son tonton le grand —\net ses campagnes"
                            }
                        ]
                    }
