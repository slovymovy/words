                        "examples": [
                            {
                                "example_id": "da05f58a-ceef-4e3c-8be9-55bd595db824",
                                "sense_id": "ce08bb9c-d7f5-316b-a55b-d1db0b6d1d86",
                                "text": "Das Scheunendach hat bei dem nächtlichen Sturm Schaden genommen."
                            },
                            {
                                "example_id": "eb9b06a2-6127-4e37-9640-793305d1f084",
                                "sense_id": "ce08bb9c-d7f5-316b-a55b-d1db0b6d1d86",
                                "text": "„Für knapp 300.000 Euro wurde unter dem Scheunendach eine 80 Quadratmeter große Wohneinheit mit kleinem überdachtem Atrium errichtet, die mit Luftwärmepumpe, kontrollierter Wohnraumbelüftung und Bauteilaktivierung energietechnisch auf modernstem Stand ist – und auch gestalterisch überzeugt.“"
                            }
                        ],
