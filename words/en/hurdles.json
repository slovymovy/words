                                "target_lang_word": "de familie Hurdle",
                                "target_lang_sense_clarification": "familieaanduiding"
                            },
                            {
                                "target_lang_word": "Hurdles",
                                "target_lang_sense_clarification": "meervoud van de achternaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
