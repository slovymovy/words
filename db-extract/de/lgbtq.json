                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33c05eee-74a7-40f6-81d4-d229402332b6",
                                                "sense_id": "347112a5-1f88-3636-9f73-b447e222929a",
                                                "text": "HRC said the October 10 primetime event, airing live on the eve of National Coming Out Day, will feature the largest ever audience for a Democratic presidential town hall devoted to LGBTQ issues."
                                            },
                                            {
                                                "example_id": "9f01b3fe-957c-4880-88ae-828d7f7ceee0",
                                                "sense_id": "347112a5-1f88-3636-9f73-b447e222929a",
                                                "text": "Portions of the ruling reflected the court’s culturally conservative roots, stating that because marriage is only for reproduction, LGBTQ relationships are unnatural because they cannot produce children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66cd91da-0f3a-3629-812c-5849098d0db0",
                                        "entry_id": "4c79af52-473d-3c40-9582-cf440373e6a4",
                                        "glosses": [
                                            "Initialism of lesbian, gay, bisexual, transgender, questioning."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc1becaa-9f39-4f91-83e1-2fa9ddee9214",
                                                "sense_id": "66cd91da-0f3a-3629-812c-5849098d0db0",
                                                "text": "They represent the “Q,” questioning, part of the LGBTQ acronym. How do such individuals deal with their uncertainty about their sexual orientation?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "LGBTQ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea3f0f4f-b57d-3930-8cb4-85f8f669a332",
                                        "entry_id": "ef0675e3-7ae8-3181-8fc2-d57a807eed19",
                                        "glosses": [
                                            "A person who is lesbian, gay, bisexual, transgender, or queer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976d7e61-7fb9-4598-92b6-c8f49c32d1ca",
                                                "sense_id": "ea3f0f4f-b57d-3930-8cb4-85f8f669a332",
                                                "text": "This confirms the claim that the internet is not an entirely safe space, and while blogs offer LGBTQs the opportunity to express their views freely and anonymously, they grant this possibility to haters and homophobes, too […]"
                                            },
                                            {
                                                "example_id": "d3d700fb-b3ad-42fe-aac8-56169686ba41",
                                                "sense_id": "ea3f0f4f-b57d-3930-8cb4-85f8f669a332",
                                                "text": "Now, for example, he is moving forward with his intention to remove all LGBTQs from the military and to ban any further recruiting of LGBTQs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc5fb439-86dc-41b2-8f88-170812a5abe9",
                        "source_entry_id": "8a356cac-4275-3c4d-a26d-09e714751049",
