                        "glosses": [
                            "Phascolarctos cinereus buideldier uit de familie van de koala's die leeft in het oosten van Australië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a10ebf-c519-43e9-8207-a43fb5f3fbb4",
                                "sense_id": "bde06ba7-f160-3347-a9a8-eb867db96120",
                                "text": "De fotowebsite blokkeert de zoekresultaten overigens niet. Gebruikers kunnen na de waarschuwing klikken op 'Berichten Weergeven', om zich vervolgens alsnog te vergapen aan selfies met koalabeertjes."
                            },
                            {
                                "example_id": "fd02565f-9752-4c5f-8982-18f7add7e9b6",
                                "sense_id": "bde06ba7-f160-3347-a9a8-eb867db96120",
                                "text": "Het totaal van de door Dick Bruna gepubliceerde kinderboekjes is blijven steken op 123. Bekende hoofdpersoontjes zijn het varken betje big, de beren boris en barbara en het hondje snuffie. Een nieuwere creatie was het koalabeertje Ko."
                            }
