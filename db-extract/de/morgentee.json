                                    {
                                        "sense_id": "baee0f7a-9861-3ff4-8a70-fc245e80b3ac",
                                        "entry_id": "20455354-015c-39a5-bcb1-d7afcdd55763",
                                        "glosses": [
                                            "A small meal or snack eaten between breakfast and lunch; a period of time set aside for this purpose, taken as a break from schoolwork, work, a conference, etc."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d6ab6d-2291-47a7-b63d-531b223c9f7a",
                                                "sense_id": "baee0f7a-9861-3ff4-8a70-fc245e80b3ac",
                                                "text": "1993 December, AUUGN: AUUG Inc. Newsletter, Volume 14, Number 6, page 53,\nThursday usually opens with a keynote session prior to morning tea and then breaks to stream sessions before and after lunch. […] The only thing it doesn′t include is breakfast, and many delegates just wait for our scrumptious morning teas anyway."
                                            },
                                            {
                                                "example_id": "fa9906c0-db66-485c-b9b1-a76a638db797",
                                                "sense_id": "baee0f7a-9861-3ff4-8a70-fc245e80b3ac",
                                                "text": "2000, Maggie Alderson, Pants On Fire, Penguin Books Australia, unnumbered page,\n‘You know what this means, don′t you?’ said Maxine, smiling broadly.\n‘No?’ I wondered if I had to pack up my office straight away.\n‘You have to buy morning tea.’\n‘What?’\n‘Morning tea. A cake. A big cake for all of us. […] ’"
                                            },
                                            {
                                                "example_id": "bc4462d1-36f8-479c-b693-431fa10d011b",
                                                "sense_id": "baee0f7a-9861-3ff4-8a70-fc245e80b3ac",
                                                "text": "2004, Coralie Mathews, Healthy Children: A Guide For Child Care, 2nd Edition, Elsevier, Australia, page 187,\nHe rushes in every day, greeting the staff and other children, and is busy with a variety of activities until morning tea time. He helps pack up the tables that are needed for morning tea and wipes them over before going to wash his hands. Morning tea comes on a trolley and Almeido happily places platters of fresh and dried fruit and individual bowls on each table."
                                            }
