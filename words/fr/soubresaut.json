            "senses": [
                {
                    "sense_id": "70bbc0db-d001-39ed-9bdc-755a0fc63438",
                    "sense_definition": "Secousse ou saut brusque et inattendu imprimé à un corps ou à un véhicule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille voiture avançait péniblement avec de violents <w>soubresauts</w> sur le chemin de terre caillouteux."
                        },
                        {
                            "text": "L'avion a traversé une zone de turbulences, provoquant un <w>soubresaut</w> qui a effrayé les passagers."
                        }
                    ],
                    "synonyms": [
                        "secousse",
                        "cahot",
                        "saccade"
                    ],
                    "common_phrases": [
                        "avancer par soubresauts",
                        "les soubresauts de la route"
                    ]
                },
                {
                    "sense_id": "df5409da-3d83-3866-9af2-624e4c191111",
                    "sense_definition": "Tressaillement nerveux involontaire du corps provoqué par la surprise, la douleur ou une vive émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit inattendu de la porte qui claquait lui a arraché un <w>soubresaut</w> de surprise."
                        },
                        {
                            "text": "Plongé dans un demi-sommeil agité, il fut tiré de sa torpeur par un brusque <w>soubresaut</w> musculaire."
                        }
                    ],
                    "synonyms": [
                        "sursaut",
                        "tressaillement",
                        "spasme"
                    ],
                    "common_phrases": [
                        "avoir un soubresaut",
                        "les derniers soubresauts"
                    ]
                },
                {
                    "sense_id": "72542976-d3bd-3a3c-a194-17372ced5bf9",
                    "sense_definition": "Changement soudain, crise passagère ou regain temporaire d'agitation dans une situation politique ou sociale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'économie du pays a connu de nombreux <w>soubresauts</w> avant de retrouver une véritable stabilité financière."
                        },
                        {
                            "text": "Malgré les <w>soubresauts</w> politiques récents, le gouvernement a maintenu ses réformes prioritaires."
                        }
                    ],
                    "synonyms": [
                        "secousse",
                        "convulsion",
                        "remous"
                    ],
                    "antonyms": [
                        "stabilité",
                        "calme"
                    ],
                    "common_phrases": [
                        "les soubresauts de l'histoire",
                        "les soubresauts de la politique"
                    ]
                },
                {
                    "sense_id": "190118db-ce55-3291-8ac8-341bf3875e2e",
                    "sense_definition": "Saut vertical exécuté à pieds joints en retombant dans la même position au sol.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "danse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur de danse a demandé aux élèves d'enchaîner une série de <w>soubresauts</w> au centre."
                        },
                        {
                            "text": "La danseuse a exécuté un <w>soubresaut</w> impeccable en conservant les pieds bien serrés à la réception."
                        }
                    ],
                    "synonyms": [
                        "saut"
                    ]
                }
            ]
        }
