                                "target_senses": [
                                    {
                                        "sense_id": "51e931b3-47ab-3954-ad1d-9862513c36ed",
                                        "entry_id": "cdace3e4-7a4a-3c4d-be8c-763e2c3bd659",
                                        "glosses": [
                                            "Eigenschaft, am Leben zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6771db-68e3-479e-b918-56ea33f339a9",
                                                "sense_id": "51e931b3-47ab-3954-ad1d-9862513c36ed",
                                                "text": "„Auch ihre Mutter sprühte vor Lebendigkeit, las Bücher, lud Professoren, Politiker und Schauspieler ein und servierte ihnen üppige Mahle im Schein der Kerzen, während angeregt über Bücher und Geschehnisse in der Welt diskutiert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72d7a8f0-acb4-3aae-983d-4cdfb0b06485",
                                        "entry_id": "cdace3e4-7a4a-3c4d-be8c-763e2c3bd659",
                                        "glosses": [
                                            "Eigenschaft, lebhaft/munter zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24dab38-69f3-4cb1-a5bb-98569d397e3f",
                                                "sense_id": "72d7a8f0-acb4-3aae-983d-4cdfb0b06485",
                                                "text": "„Ihre Bewegungen zeigten viel natürlichen Anstand und eine gewisse Lebendigkeit, die jedoch vollkommen innerhalb der Schranken mädchenhafter Züchtigkeit verblieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
