                ],
                "senses": [
                    {
                        "sense_id": "8cc7baf7-ce26-33b3-9746-4c088d5897f8",
                        "entry_id": "de439136-16db-3b2a-a2a7-7806ab20d35a",
                        "glosses": [
                            "Mécanicien."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c64cddb6-730c-438e-8223-08525703d8b6",
                                "sense_id": "8cc7baf7-ce26-33b3-9746-4c088d5897f8",
                                "text": "Plus vite, mécano, nous ne faisons que du 115…"
                            },
                            {
                                "example_id": "680af327-591f-4ba5-b997-4cacd088becf",
                                "sense_id": "8cc7baf7-ce26-33b3-9746-4c088d5897f8",
                                "text": "Vu que c’est la voiture de mon oncle, ce serait quand même plus prudent que je l’emmène chez un mécano."
                            },
                            {
                                "example_id": "0f0e55a4-d6d2-4eac-b10b-526b58b84bad",
                                "sense_id": "8cc7baf7-ce26-33b3-9746-4c088d5897f8",
                                "text": "Il faut que je passe voir le mécano pour qu’il regarde mon moteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc80999f-ab7b-47e4-b865-55c9ee969a7b",
                        "source_entry_id": "de439136-16db-3b2a-a2a7-7806ab20d35a",
                        "source_sense_id": "8cc7baf7-ce26-33b3-9746-4c088d5897f8",
                        "target_lang_word": "grease monkey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grease monkey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca35b051-66cb-3156-8706-dfaa3f169459",
                                        "entry_id": "989bc7ca-f9bb-3ede-b923-55d719e7918b",
                                        "glosses": [
                                            "A mechanic, often with the specific connotation of an automobile mechanic."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a720e5-f3b4-4a9d-8777-40244bb77128",
                                                "sense_id": "ca35b051-66cb-3156-8706-dfaa3f169459",
                                                "text": "If you appear like a tramp or grease-monkey how can you expect to meet the people who are able to support your business."
                                            },
                                            {
                                                "example_id": "c6857800-75a5-45c2-8154-f447bd94e826",
                                                "sense_id": "ca35b051-66cb-3156-8706-dfaa3f169459",
                                                "text": "Maybe some other \"grease monkey,\" as I call mechanics, will correct me."
                                            },
                                            {
                                                "example_id": "c49c723c-562d-435c-b149-917bbd009177",
                                                "sense_id": "ca35b051-66cb-3156-8706-dfaa3f169459",
                                                "text": "Brother W.M. Hillery resigned from his job as grease monkey and is working for Armour and Company, but as we understand he is just itching to get with the old bunch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
