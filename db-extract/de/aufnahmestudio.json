                "senses": [
                    {
                        "sense_id": "e29a2291-a345-3ec2-b05c-a191d72760ed",
                        "entry_id": "9ccf804c-35be-3edf-8e41-87597468f91a",
                        "glosses": [
                            "Raum oder Gebäude, in dem meist Tonaufnahmen (beispielsweise Hörspiele, Musikstücke), aber auch Filmaufnahmen (beispielsweise Fernsehsendungen, Videos) produziert (=aufgenommen, geschnitten) werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb006cd7-2b7e-4743-9f95-7e36df5d1f99",
                                "sense_id": "e29a2291-a345-3ec2-b05c-a191d72760ed",
                                "text": "„Fast jeder hat mittlerweile ein komplettes Aufnahmestudio in der Hosentasche. Egal ob Video, Radiobeitrag oder Blogposting mit Text und Bild: Mit einem Smartphone, kaum schwerer als eine Tafel Schokolade, können unterschiedliche multimediale Produkte hergestellt werden.“"
                            },
                            {
                                "example_id": "aa037e4d-e615-4976-a0c1-5a3f65648c86",
                                "sense_id": "e29a2291-a345-3ec2-b05c-a191d72760ed",
                                "text": "„Mit dem Cellisten Yo-Yo Ma und der Geigerin Hilary Hahn sind wieder zwei Weltstars ins Aufnahmestudio gegangen, um Bach aufzunehmen.“"
                            },
                            {
                                "example_id": "e8be2f55-c02e-4141-9db9-f6d11ba08a75",
                                "sense_id": "e29a2291-a345-3ec2-b05c-a191d72760ed",
                                "text": "„Weil das Aufnahmestudio hinter der Glasscheibe nicht mehr benötigt wurde, gab es Platz für den Einbau eines Fernsehstudios.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
