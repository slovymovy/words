                                        "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                        "entry_id": "c0b97dbd-405d-3568-9a62-96bf95c75aa7",
                                        "glosses": [
                                            "Someone who denies that global climate change is real or, if real, that it is due to human activities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bcb7ea-64a9-4486-ad91-8f36f280806c",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "\"Climate deniers fall into the same camp as people who still don't believe we landed on the moon,\" Gore's spokeswoman told Politico a few days ago."
                                            },
                                            {
                                                "example_id": "4363280e-41fc-47db-94b6-7fc7b752095b",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "In a question and answer session following a public lecture, the prominent (and genuinely sceptical) climate scientist Chris Rapley was vociferously challenged by a climate denier in the audience."
                                            },
                                            {
                                                "example_id": "5293ff4b-bb32-4253-ab4d-834f0a859557",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "Money is still the main answer: Almost all prominent climate deniers are on the fossil-fuel take."
                                            },
                                            {
                                                "example_id": "a036eb18-7519-4b14-aa77-c51a6fbf4fe0",
                                                "sense_id": "88cfee0a-d742-350c-99da-561ca1b850d1",
                                                "text": "President Trump unfortunately is a climate denier."
                                            }
                                        ]
                                    }
