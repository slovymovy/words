        "pl-extract.jsonl": [
            {
                "entry_id": "4be70ee4-8dcb-316f-a65b-9fa7e1241c1c",
                "word": "samopas",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1dc44203-7352-39c2-abf5-92d0d1f7238a",
                        "entry_id": "4be70ee4-8dcb-316f-a65b-9fa7e1241c1c",
                        "glosses": [
                            "bez opieki, bez kontroli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d10b68f-6e45-44cf-a83a-899fc64ad804",
                                "sense_id": "1dc44203-7352-39c2-abf5-92d0d1f7238a",
                                "text": "Rodzice na cały dzień puszczają dzieci samopas, a potem dziwią się, gdy dochodzi do tragedii."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fdb15602-206b-3ed9-a259-02f5d8d0c2d1",
                        "entry_id": "4be70ee4-8dcb-316f-a65b-9fa7e1241c1c",
                        "glosses": [
                            "w pojedynkę, samotnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcfe5c4c-6fd8-4d13-8876-17e97e5e04e9",
                                "sense_id": "fdb15602-206b-3ed9-a259-02f5d8d0c2d1",
                                "text": "Wybrałem się samopas na spacer po uzdrowisku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f9896c6-4eb1-442b-bb79-2bdb38e05837",
                        "source_entry_id": "4be70ee4-8dcb-316f-a65b-9fa7e1241c1c",
                        "source_sense_id": "fdb15602-206b-3ed9-a259-02f5d8d0c2d1",
                        "target_lang_word": "в одиночку",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "в одиночку",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ca9ff6dd-de23-326c-a934-dfb5dd785888",
                                        "entry_id": "a76ab755-0e6a-37c1-8523-9d31c2ef61a8",
                                        "glosses": [
                                            "без участия других; один"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2d0b25-9876-45ea-8167-07b6a985e49c",
                                                "sense_id": "ca9ff6dd-de23-326c-a934-dfb5dd785888",
                                                "text": "Эта песня пелась у нас часто, но не хором, а в одиночку."
                                            },
                                            {
                                                "example_id": "40cf0d45-7c2b-496f-96ce-1de6ea87f7dd",
                                                "sense_id": "ca9ff6dd-de23-326c-a934-dfb5dd785888",
                                                "text": "«Авось» молодости, тайное желание изведать своё счастие, испытать свои силы в одиночку, без чьего бы то ни было покровительства — одолели наконец."
                                            },
                                            {
                                                "example_id": "00195ef0-2569-4e74-808d-16f819884e85",
                                                "sense_id": "ca9ff6dd-de23-326c-a934-dfb5dd785888",
                                                "text": "— Вот мне и не хотелось умереть так, в одиночку, в молчанку, не сказав никому: «Я всё потеряла… и я умираю… Посмотрите!»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e6f8ee-dbfe-3c3a-a524-a01fab5acd3d",
                                        "entry_id": "a76ab755-0e6a-37c1-8523-9d31c2ef61a8",
                                        "glosses": [
                                            "перен. собственными силами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf89ce9-7981-4b28-afa0-d6f0f9730929",
                                                "sense_id": "11e6f8ee-dbfe-3c3a-a524-a01fab5acd3d",
                                                "text": "Карай был старый и уродливый, бурдастый кобель, известный тем, что он в одиночку бирал матёрого волка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
