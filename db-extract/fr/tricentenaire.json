                    {
                        "sense_id": "0795a872-8e11-3afb-8a23-02106c2993ea",
                        "entry_id": "0a5abb04-4890-30d6-b2c9-1e7708b632d6",
                        "glosses": [
                            "Qui a accompli sa trois-centième année."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a7446d-9630-49e7-ab54-926040fb7e8e",
                                "sense_id": "0795a872-8e11-3afb-8a23-02106c2993ea",
                                "text": "Vous devriez vivre à Fontainebleau, monter et descendre trois fois par jour avec une immense traîne les escaliers que François Iᵉʳ a construits. En vous voyant, les carpes tricentenaires de l’étang se transformeront en animaux à sang chaud. Dans sa frayeur, Miss France mettra au monde des jumeaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "69310229-71c1-33a8-89a9-06b83e2afa9e",
                        "entry_id": "0a5abb04-4890-30d6-b2c9-1e7708b632d6",
                        "glosses": [
                            "Qui remonte à trois-cents ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e28dbd-3b82-449e-b4f1-52bea10e4f7e",
                                "sense_id": "69310229-71c1-33a8-89a9-06b83e2afa9e",
                                "text": "Cette bataille tricentenaire est encore visible par nombre de vestiges..."
                            }
                        ]
                    }
