                ],
                "senses": [
                    {
                        "sense_id": "8d91fc53-4c99-35f3-bff7-ea8863f97c8d",
                        "entry_id": "5073f354-6962-3c12-97e4-e17d8c7e1aa7",
                        "glosses": [
                            "Rente, die eine Witwe erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7002ebb9-e0aa-40dc-8359-a2a4018844e8",
                                "sense_id": "8d91fc53-4c99-35f3-bff7-ea8863f97c8d",
                                "text": "„Ist der Ehegatte vor seinem 60. Geburtstag verstorben, wird die Witwenrente um einen Abschlag in Höhe von 10,8 Prozent gekürzt.“"
                            },
                            {
                                "example_id": "38f2290f-4601-449c-af67-defaa559e80a",
                                "sense_id": "8d91fc53-4c99-35f3-bff7-ea8863f97c8d",
                                "text": "„Der Staat unterstützte den guten Schüler, seine Mutter und seine drei Geschwister nur mit einer kümmerlichen Witwenrente.“"
                            },
                            {
                                "example_id": "7f16d566-7c48-4cac-b97d-1332d72d041a",
                                "sense_id": "8d91fc53-4c99-35f3-bff7-ea8863f97c8d",
                                "text": "„Mit der kleinen Witwenrente und dem Verkauf auf dem Wochenmarkt kommt sie jetzt gerade so über die Runden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
