            {
                "entry_id": "611c9fff-c08e-3d0e-b02e-2cb2ea46ebc8",
                "word": "begum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4a4482c7-1857-4e82-b589-8d0df47e9336",
                        "entry_id": "611c9fff-c08e-3d0e-b02e-2cb2ea46ebc8",
                        "tags": [
                            "plural"
                        ],
                        "form": "begums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a648d35c-f2e2-31e2-bb3b-29d5f38a8841",
                        "entry_id": "611c9fff-c08e-3d0e-b02e-2cb2ea46ebc8",
                        "glosses": [
                            "a high-ranking Muslim woman, especially in South Asia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b28e16-b9ae-4ae2-b128-f3475ae4dd42",
                                "sense_id": "a648d35c-f2e2-31e2-bb3b-29d5f38a8841",
                                "text": "He went to India with his capital, and there, according to a wild legend in our family, he was once seen riding on an elephant, in company with a Baboon; but I think it must have been a Baboo—or a Begum."
                            },
                            {
                                "example_id": "ab4b2d21-6aa9-4fe3-af74-2232b7cd0d4c",
                                "sense_id": "a648d35c-f2e2-31e2-bb3b-29d5f38a8841",
                                "text": "She was the daughter of an English officer, who having fallen in love with an Indian Begum gave up home, country, and friends, and married her."
                            },
                            {
                                "example_id": "544957d4-4e1d-4c82-abdf-8747910ec3a7",
                                "sense_id": "a648d35c-f2e2-31e2-bb3b-29d5f38a8841",
                                "text": "toxic politics dominated by the bitter infighting of the “battling begums” (the widow and daughter of former presidents, who lead the two main parties)."
                            }
                        ]
                    },
                    {
                        "sense_id": "391953ae-59aa-3627-8593-39929603b758",
                        "entry_id": "611c9fff-c08e-3d0e-b02e-2cb2ea46ebc8",
                        "glosses": [
                            "the form of address for such a woman"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f5be1eb-75bc-4632-9c42-54f32f1bbe8b",
                                "sense_id": "391953ae-59aa-3627-8593-39929603b758",
                                "text": "It was a known fact that an envoy from an Indian Prince, a Colonel Altamont, the Nawaub of Lucknow’s prime favourite, an extraordinary man, who had, it was said, embraced Mahometanism, and undergone a thousand wild and perilous adventures was at present in this country, trying to negotiate with the Begum Clavering, the sale of the Nawaub’s celebrated nose-ring diamond, ‘the light of the Dewan.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55d8362b-3591-46f8-b12e-4ca00a8b6153",
                        "source_entry_id": "611c9fff-c08e-3d0e-b02e-2cb2ea46ebc8",
                        "source_sense_description": "a high ranking woman",
                        "target_lang_word": "Begum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "195ccb39-880e-3fe8-b74c-932bd253acc5",
                                        "entry_id": "06164e71-f765-3f4d-9f49-b40268e664cc",
                                        "glosses": [
                                            "Titel indischer Fürstinnen"
                                        ],
