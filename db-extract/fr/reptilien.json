                        "tags": [
                            "plural"
                        ],
                        "form": "reptiliens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c766e78-3112-3e2b-9054-eba2a67af8ac",
                        "entry_id": "a100fe22-4449-3fdf-86e3-53800fdd425d",
                        "glosses": [
                            "Créature extraterrestre bipède malveillante capable de se travestir en être humain pour tromper et abuser ces derniers."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "988df043-784a-4c3c-8a1c-9eef2729bc62",
                                "sense_id": "2c766e78-3112-3e2b-9054-eba2a67af8ac",
                                "text": "Toute personnalité éminente perçue comme appartenant à l’élite se verra tôt ou tard accusée, de préférence dans une vidéo focalisée sur de menus détails, d’être un reptilien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d5b0060-3e7c-4b7d-9712-7c0c75a3ec9e",
                        "source_entry_id": "a100fe22-4449-3fdf-86e3-53800fdd425d",
                        "source_sense_id": "2c766e78-3112-3e2b-9054-eba2a67af8ac",
                        "target_lang_word": "reptilian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reptilian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3765ff8d-87de-3dc5-8903-9775cfb5bc99",
                                        "entry_id": "e8e5978d-d6b3-3018-9c12-16626f924f8d",
                                        "glosses": [
                                            "Of or relating to the members of the class Reptilia (reptiles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e150e0-b9ea-4d13-bb69-51014121a8c9",
                                                "sense_id": "3765ff8d-87de-3dc5-8903-9775cfb5bc99",
                                                "text": "The Mesozoic represents that time on Earth when life flourished, but when such life was primarily reptilian, before the Age of Mammals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc06fea3-491b-3d35-87b7-c858e2a2500a",
                                        "entry_id": "e8e5978d-d6b3-3018-9c12-16626f924f8d",
                                        "glosses": [
                                            "Reptilelike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec6c8c6a-dae4-4b9a-9234-a3d1aa1a008a",
                                                "sense_id": "dc06fea3-491b-3d35-87b7-c858e2a2500a",
                                                "text": "It is filled with blazing fires and half-human, half-animal beasts, with spiked reptilian tails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68ae0e25-1df1-3633-98f0-82b5013d9004",
                                        "entry_id": "e8e5978d-d6b3-3018-9c12-16626f924f8d",
                                        "glosses": [
                                            "Unthinking, low, base, contemptible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53f54aa2-dbcc-3dca-9fd6-aeddfd61ab88",
                                        "entry_id": "e8e5978d-d6b3-3018-9c12-16626f924f8d",
                                        "glosses": [
                                            "Cold-blooded, treacherous, unavoidably selfish and hostile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "reptilian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7601130-1b17-3728-8e50-f3ccbf8d32e0",
                                        "entry_id": "1ae4a573-58bf-33a2-ae78-ee408ab16005",
                                        "glosses": [
                                            "A reptilian animal: a reptile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "173c6d57-7a4a-3ae7-b208-805bd1ff5add",
                                        "entry_id": "1ae4a573-58bf-33a2-ae78-ee408ab16005",
                                        "glosses": [
                                            "A reptilian person, especially (ethnic slur) a Jew."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d9c337d-737d-395d-adda-603d8a5f03da",
                                        "entry_id": "1ae4a573-58bf-33a2-ae78-ee408ab16005",
                                        "glosses": [
                                            "A reptilian alien, especially (ufology, often capitalized) of a shapeshifting race alleged to secretly control the world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0011abea-6b6f-4c1d-905c-554f02067712",
                                                "sense_id": "3d9c337d-737d-395d-adda-603d8a5f03da",
                                                "text": "More evolved than the Grays or Reptilians, the Humanoids seem to feel some sort of kinship with humans and are likely to be kind.[…] Some researchers believe the Grays are merely preparing the way for a full-scale invasion of Reptilian aliens."
                                            },
                                            {
                                                "example_id": "b5ff7ef9-ecdb-4470-b88d-9769b52afd36",
                                                "sense_id": "3d9c337d-737d-395d-adda-603d8a5f03da",
                                                "text": "Such powerful human families would descend upon the reptilians themselves and they would be willing to do just anything to retain their power."
                                            },
                                            {
                                                "example_id": "c61ac581-3f71-4863-9d1b-40e208e633f0",
                                                "sense_id": "3d9c337d-737d-395d-adda-603d8a5f03da",
                                                "text": "The reptilians are the creation of the Carians."
                                            },
                                            {
                                                "example_id": "1c8774ae-c9dc-415f-9f3e-52913452f972",
                                                "sense_id": "3d9c337d-737d-395d-adda-603d8a5f03da",
                                                "text": "Reptilians generally are envisioned as half snake, half human, and they are thought to have come from the Alpha Draconian star system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
