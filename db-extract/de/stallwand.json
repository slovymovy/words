                        "examples": [
                            {
                                "example_id": "b5c0a02d-03df-4646-8f15-66cc245f9acf",
                                "sense_id": "9d3d97e2-8f22-3db0-aa5a-4631c9724e61",
                                "text": "„Der Mann war gerade dabei gewesen, ein großes schwarzes Pferd, das er mit seinem Halfter an einem Eisenring in der Stallwand festgemacht hatte, mit einer Bürste zu striegeln.“"
                            },
                            {
                                "example_id": "2f74d24c-d05a-478c-8be9-13630d8d44fa",
                                "sense_id": "9d3d97e2-8f22-3db0-aa5a-4631c9724e61",
                                "text": "„Die beiden Jungen und die Männer an der Stallwand ließen kein Auge von Margrét und dem Stier, und jeder dachte sich sein Teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
