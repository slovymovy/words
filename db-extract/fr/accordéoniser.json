                ],
                "senses": [
                    {
                        "sense_id": "acf7d13c-26ef-3b2f-88f1-4f9f9929e3ac",
                        "entry_id": "e6f9940a-ce79-3b69-a8b5-b0adf365193e",
                        "glosses": [
                            "jouer, interpréter à l'accordéon, transposer pour l'accordéon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c308c6-81a2-410c-a5b4-ed971c30d664",
                                "sense_id": "acf7d13c-26ef-3b2f-88f1-4f9f9929e3ac",
                                "text": "Fierté immense d'avoir réussi à accordéoniser ce petit hommage à la Bretagne d'Alan Stivell en compagnie de notre sublime Nolwenn Leroy."
                            }
                        ]
                    },
                    {
                        "sense_id": "13add178-19ee-3d8a-9f2e-2f13a619332a",
                        "entry_id": "e6f9940a-ce79-3b69-a8b5-b0adf365193e",
                        "glosses": [
                            "Plier en zig-zag, accordéoner."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "83504c91-1f6d-475f-a6ac-b3e67533a66e",
                                "sense_id": "13add178-19ee-3d8a-9f2e-2f13a619332a",
                                "text": "Rose récupéra le bavoir papillote et entreprit de l’accordéoniser pendant que le garçon lui servait une nouvelle flûte."
                            },
                            {
                                "example_id": "4d666c3b-6d74-4b64-aeb4-b889bdd02c43",
                                "sense_id": "13add178-19ee-3d8a-9f2e-2f13a619332a",
                                "text": "P'tain, la vieille, décontracte-toi ! J'ai l'impression d'me taper une pierre tombale, s'emporte le premier de ces malotrus qui vient de s'accordéoniser' le bigoudi, pourtant bien vaillant."
                            }
                        ]
                    }
