                "senses": [
                    {
                        "sense_id": "8e4a9dfe-b377-3ce0-b7d3-a5d3a435f19b",
                        "entry_id": "2a3eefbd-a58e-3ed5-b534-5ae880ced2c5",
                        "glosses": [
                            "embryonale Fehlbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c52aa14-5058-4dc2-b6c1-bc93ce28f160",
                                "sense_id": "8e4a9dfe-b377-3ce0-b7d3-a5d3a435f19b",
                                "text": "„Außerdem beobachteten die Autoren eine Dysembryoplasie mit Gliederung im Binde-, Muskel- und Epithelsystem, wobei überhaupt keine normale Struktur nachweisbar war.“"
                            },
                            {
                                "example_id": "cb5cf947-31a9-4bae-8332-e33f4bb1a574",
                                "sense_id": "8e4a9dfe-b377-3ce0-b7d3-a5d3a435f19b",
                                "text": "„Nach GALY besteht die wesentliche Veränderung in einer Disharmomie zwischen dem Wachstum der Bronchien und der Entwicklung der Alveolen, „die Lunge erzeuge Bronchien dort, wo sie Alveolen erzeugen sollte“ (HUTINEL). Auch eine Dysembryoplasie im Sinne einer Hamartie (Hamartoeystom JAEGER, STOERK) muß in Betracht gezogen werden.“"
                            },
                            {
                                "example_id": "b431db07-07ae-426e-b62d-62873f4ae270",
                                "sense_id": "8e4a9dfe-b377-3ce0-b7d3-a5d3a435f19b",
                                "text": "„Die Entstehung dieser Thyreoidosen wird auf eine Dysembryoplasie oder Verschleppung zurückgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
