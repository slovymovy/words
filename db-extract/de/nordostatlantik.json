                "senses": [
                    {
                        "sense_id": "afd6b838-925d-3eea-afa4-5cad99615224",
                        "entry_id": "c9da7d52-fb74-39e9-84e5-b3866d28d17c",
                        "glosses": [
                            "nicht genau definierter nordöstlicher Teil des Atlantischen Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d05ba3eb-fd29-41d8-9971-1f03a6170390",
                                "sense_id": "afd6b838-925d-3eea-afa4-5cad99615224",
                                "text": "„Der Sula-Rücken auf dem Trondheim-Schelf gehört zu den imposantesten Korallenriffgebieten im Nordostatlantik.“"
                            },
                            {
                                "example_id": "08cc6be1-137a-4992-8443-e06d056d1cea",
                                "sense_id": "afd6b838-925d-3eea-afa4-5cad99615224",
                                "text": "„Auf Beschluss der Oslo-Kommission wurde die Verklappung von Abfällen im Konventionsgebiet des Nordostatlantik ab 1990 erheblich reduziert.“"
                            },
                            {
                                "example_id": "a352198c-e84a-458b-9e69-77c6a0a3f65f",
                                "sense_id": "afd6b838-925d-3eea-afa4-5cad99615224",
                                "text": "„Gerne werden diese Auseinandersetzungen im Nordostatlantik unter dem Begriff ‚Kabeljaukriege‘ zusammengefasst.“"
                            },
                            {
                                "example_id": "79f99568-b2a3-4070-b2a3-a6939dc80c4e",
                                "sense_id": "afd6b838-925d-3eea-afa4-5cad99615224",
                                "text": "„Er ist im Nordostatlantik weit verbreitet und kommt in der Nordsee, im Mittelmeer, im Schwarzen Meer und an der afrikanischen Küste bis zum mauretanischen Cape Blanc vor.“"
                            },
                            {
                                "example_id": "9ecb118e-6607-43de-bbf1-a7efcc27ee46",
                                "sense_id": "afd6b838-925d-3eea-afa4-5cad99615224",
                                "text": "„Ungeachtet der nach wie vor kritischen Lage im Mittelmeer und im Schwarzen Meer haben sich die Fischbestände im Nordostatlantik (einschließlich Nord- und Ostsee) seit 2003 erholt und bis 2017 um insgesamt 36 Prozent zugenommen.“"
                            },
                            {
                                "example_id": "7de9c409-c717-450b-8a7a-526a29546200",
                                "sense_id": "afd6b838-925d-3eea-afa4-5cad99615224",
                                "text": "„Solche umfassendere Konventionen wurden für den Nordostatlantik und die europäischen Randmeere, für den Persischen Golf, die Karibik, die zentral- und westafrikanischen Küstengewässer sowie den Süd- und Südostpazifik geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
