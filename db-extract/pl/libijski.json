                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c927c33e-565e-4a1e-bd12-2d6fff4ff315",
                                "sense_id": "1de21730-6843-3438-ae54-d232fb82e0e3",
                                "text": "Inwestycja libijska jest jednak nieco kłopotliwa, bo Libia jest obłożona sankcjami ONZ"
