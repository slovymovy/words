                                "target_senses": [
                                    {
                                        "sense_id": "39491eab-7633-353d-8b16-eec6e9f054cf",
                                        "entry_id": "580831c8-78f8-3f39-9d55-4134c6061e62",
                                        "glosses": [
                                            "The wife of a viscount."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31757f88-893e-364e-96f6-1d26bb38b66b",
                                        "entry_id": "580831c8-78f8-3f39-9d55-4134c6061e62",
                                        "glosses": [
                                            "A woman holding the rank of viscount in her own right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4cfb3c-2b56-4eb9-a306-acc497c71600",
                                                "sense_id": "31757f88-893e-364e-96f6-1d26bb38b66b",
                                                "text": "Before his own elevation to an earldom, Disraeli's wife was created Viscountess Beaconsfield by Queen Victoria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8d85567-0e3f-4117-aa40-95bea57ddbc3",
                        "source_entry_id": "105ced9c-2e93-312e-a856-fee550fe9bf7",
                        "source_sense_id": "20195cea-d1af-3f62-b561-68a3888f290e",
                        "target_lang_word": "vicomtesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vicomtesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb954f7f-8eda-3c91-a3f3-64bc2c57595d",
                                        "entry_id": "549146b2-20b1-3af4-9a1e-3508a43e70b8",
                                        "glosses": [
                                            "Épouse ou veuve d’un vicomte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5a61ec2-f5c5-44d4-81aa-564bc37f384e",
                                                "sense_id": "eb954f7f-8eda-3c91-a3f3-64bc2c57595d",
                                                "text": "Camille et la marquise entrèrent dans Guérande avec la vicomtesse de Kergarouët et sa fille, au grand étonnement de toute la ville ébahie ; elles laissèrent leurs compagnes de voyage à l’entrée de la ruelle du Guénic, où peu s’en fallut qu’il ne se formât un attroupement."
                                            },
                                            {
                                                "example_id": "5f1516a0-7259-40f3-aa4a-b6c032c78238",
                                                "sense_id": "eb954f7f-8eda-3c91-a3f3-64bc2c57595d",
                                                "text": "Ah ! maudite vie de garçon ! Sans mes déportements, ma Célestine serait aujourd’hui la vicomtesse Popinot !"
                                            },
                                            {
                                                "example_id": "31b9e8e9-c1fa-4711-a5b8-c860fd1ea073",
                                                "sense_id": "eb954f7f-8eda-3c91-a3f3-64bc2c57595d",
                                                "text": "Dans les mains du chasseur ébloui de tant de générosité, la vicomtesse de Pleurmatin vidait son porte-or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a55212-de98-314d-88ec-3c577cbee694",
                                        "entry_id": "549146b2-20b1-3af4-9a1e-3508a43e70b8",
                                        "glosses": [
                                            "Femme détenant une vicomté."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
