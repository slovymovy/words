                ],
                "senses": [
                    {
                        "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                        "entry_id": "b6260f4c-cc5c-301d-a104-aaaf891524cf",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beab3ac9-5e62-4924-8a30-0747e65d2df7",
                                "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                                "text": "Frau Hackenberger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "11dfe3e5-5a71-4634-a1b3-f7992a58c27a",
                                "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                                "text": "Herr Hackenberger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6d3a4f7a-f219-441f-af4b-c950e01dbce0",
                                "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                                "text": "Die Hackenbergers fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "f56576f6-570f-49a8-bfb0-ad2c1ad11ea5",
                                "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                                "text": "Der Hackenberger trägt nie die Pullover, die die Hackenberger ihm strickt."
                            },
                            {
                                "example_id": "ce167a4f-1365-41b1-8fcf-11c869c19ed4",
                                "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hackenberger kommt, geht der Herr Hackenberger.“"
                            },
                            {
                                "example_id": "6da49331-f3dc-4ea8-adc8-76238fb3a65f",
                                "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                                "text": "Hackenberger kommt und geht."
                            },
                            {
                                "example_id": "60f857ef-f64a-46ec-9261-a20378548dd8",
                                "sense_id": "e162d2e1-77c2-3914-bab5-215c1f90738c",
                                "text": "Hackenbergers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
