                                "sense_id": "33ccba3e-9b50-3aec-9b4f-68374602c087",
                                "text": "Finalement que l'équitation perde le côté animal au sens propre pour s'humaniser et se \"nunuchiser\" à outrance."
                            },
                            {
                                "example_id": "ff1176f8-a48d-4db7-80c4-f1e7626f4e22",
                                "sense_id": "33ccba3e-9b50-3aec-9b4f-68374602c087",
                                "text": "Elle peut vite vous nunuchiser ou vous transformer en lady fanée."
                            },
                            {
                                "example_id": "159faf08-88a1-421b-9bb3-d22fead51a91",
                                "sense_id": "33ccba3e-9b50-3aec-9b4f-68374602c087",
                                "text": "Cette custo révèle toute sa grâce sans la nunuchiser, je trouve."
                            }
                        ]
                    }
