                                "target_lang_word": "leave ajar",
                                "target_lang_sense_clarification": "to keep a door or window slightly open"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8249224e-7283-38dd-8812-1f1bf4dd8f60",
                    "sense_definition": "de tweede persoon enkelvoud tegenwoordige tijd van <w>kieren</w> in vragende vorm",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kier</w> je het raam altijd als je gaat slapen voor wat extra ventilatie?",
                            "target_lang_translations": {
                                "en": "Do you always <w>crack</w> the window when you go to sleep for some extra ventilation?"
                            }
                        },
                        {
                            "text": "Waarom <w>kier</w> je de deur als je weet dat het buiten zo hard waait?",
                            "target_lang_translations": {
                                "en": "Why do you <w>leave</w> the door <w>ajar</w> when you know it's so windy outside?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present inversion"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the second-person singular present tense of the verb 'kieren' in its inverted (question) form"
                    },
                    "translations": {
                        "en": [
