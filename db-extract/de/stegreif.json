                            {
                                "example_id": "6b56ef37-3bd5-46ec-9acb-5e0794a25187",
                                "sense_id": "e84a95f4-6850-3379-baa5-94f49ac19c9f",
                                "text": "aus dem Stegreif",
                                "translation": "extemporaneously",
                                "english": "extemporaneously"
                            },
                            {
                                "example_id": "31fdacf9-c624-4e1a-94a1-9c22011cfc01",
                                "sense_id": "e84a95f4-6850-3379-baa5-94f49ac19c9f",
                                "text": "Ich hatte meine Aufzeichnungen vergessen und musste mir aus dem Stegreif etwas überlegen.",
                                "translation": "I'd forgotten to take my notes and had to make something up by improvisation.",
                                "english": "I'd forgotten to take my notes and had to make something up by improvisation."
                            },
                            {
                                "example_id": "a1ec2250-8896-4b40-9d54-4c14b9a4e837",
                                "sense_id": "e84a95f4-6850-3379-baa5-94f49ac19c9f",
                                "text": "Das Gedicht ist eine Stegreif-Schöpfung.",
                                "translation": "The poem is an impromptu composition.",
                                "english": "The poem is an impromptu composition."
                            }
                        ]
