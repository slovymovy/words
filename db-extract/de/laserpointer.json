                        "entry_id": "3ea6154e-e1a7-3dff-b03c-0ef3b686a37b",
                        "glosses": [
                            "kompaktes, längliches Gerät, das mittels einer Laserdiode einen Lichtpunkt erzeugen kann und vor allem bei Präsentationen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00e3c69-f50e-40e8-99fc-83af0b6ce0b7",
                                "sense_id": "c0bb8acf-fae4-3842-8ae6-db1da6166165",
                                "text": "Zur Präsentation stehen Ihnen Laserpointer, Zeigestäbe, Animationen und die eigenen Hände zur Verfügung."
                            },
                            {
                                "example_id": "85d84e67-d961-40dc-b28a-dfd2e9ee7fbb",
                                "sense_id": "c0bb8acf-fae4-3842-8ae6-db1da6166165",
                                "text": "Mit einem Laserpointer in ein Cockpit zu leuchten gilt als gefährlicher Eingriff in den Flugverkehr und wird mit einer Freiheitsstrafe geahndet."
                            }
                        ],
                        "sense_index_json": "\"1\""
