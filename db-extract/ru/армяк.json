                        "target_lang_word": "armiak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4fec68c7-df29-48fc-90e7-2aaa7aeda6e4",
                        "source_entry_id": "0e06b749-ce81-3237-90fb-4b5fe356760d",
                        "source_sense_id": "0565bfff-ffd5-3be3-8e7d-53bb45060514",
