                "translations": [
                    {
                        "translation_id": "dd3ea8e8-daa1-4796-9fb8-5936ec1d6e08",
                        "source_entry_id": "0aef6b07-5e07-3fbf-a7d4-d1517bc71595",
                        "target_lang_word": "fetter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fetter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b13d6d7-1b73-37a3-93d2-e372c2d513b6",
                                        "entry_id": "0e56745b-5a45-3309-ba3c-857f57d02c11",
                                        "glosses": [
                                            "A chain or similar object used to bind a person or animal – often by its legs (usually in plural)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                        "entry_id": "0e56745b-5a45-3309-ba3c-857f57d02c11",
                                        "glosses": [
                                            "Anything that restricts or restrains."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea8c4ab-5f99-435e-9bd7-0155ef8f23df",
                                                "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                                "text": "Passion's too fierce to be in fetters bound."
                                            },
                                            {
                                                "example_id": "0834c8b8-948f-43aa-a28a-43a62d3ca2b0",
                                                "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                                "text": "He looks upon study as an odious fetter; his time is spent in the open air, climbing the hills or rowing on the lake."
                                            },
                                            {
                                                "example_id": "933fc386-e47f-4cd5-b002-f25dfb5a90ef",
                                                "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                                "text": "That was the turning-point of my life. I broke my fetters, and I fought a hard fight for a new career …"
                                            }
