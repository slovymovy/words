                                                "example_id": "fa2c5fcb-b828-4f7b-87ba-7249fe5c8630",
                                                "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                                "text": "Bei Geldwäsche handelt es sich eindeutig um ein grenzüberschreitendes Problem."
                                            },
