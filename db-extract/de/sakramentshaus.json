                "senses": [
                    {
                        "sense_id": "a7c8d733-2191-3e4b-90a1-246691147aac",
                        "entry_id": "bdf4d946-05df-381f-a4bd-49ed05084eac",
                        "glosses": [
                            "eine Kleinarchitektur innerhalb eines Kirchengebäudes; Schrank, der zur Aufbewahrung des gewandelten Hostien dient, eine Art großer Tabernakel"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "e74dc9e4-3b6e-450b-bea9-517b89de9ffd",
                                "sense_id": "a7c8d733-2191-3e4b-90a1-246691147aac",
                                "text": "Das Zweite Vatikanische Konzil (1962–65) ließ den Gebrauch des Sakramentshauses wieder zu."
                            },
                            {
                                "example_id": "930d3679-3162-42dc-8735-4a158d1c2737",
                                "sense_id": "a7c8d733-2191-3e4b-90a1-246691147aac",
                                "text": "„Seine Hauptwerke sind: das Sakramentshaus der Lorenzkirche in Nürnberg, das Sebaldusgrab, das Rathaus in Braunschweig, das Chor des Augsburger Doms, Partie aus dem Dom in Magdeburg, das Brauttor der Sebalduskirche in Nürnberg, aus dem Münster in Ulm, Ausgang zum Rathaus in Görlitz, aus dem Dom in Halberstadt und Inneres der Frauenkirche in München.“"
                            }
                        ],
