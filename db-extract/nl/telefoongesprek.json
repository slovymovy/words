                            {
                                "example_id": "8a5d41d9-a9cd-4822-aeb6-053ab0aa52f2",
                                "sense_id": "d51ebf86-15a7-3f66-a605-4c99b7483224",
                                "text": "Toen rukte ze zich los en ging een kort telefoongesprek voeren, waar ik niets van verstond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbf498cf-b771-4410-bd7f-046c15efc8f6",
                        "source_entry_id": "ed621289-00ff-33b1-8426-18cf07b4c97d",
                        "source_sense_id": "d51ebf86-15a7-3f66-a605-4c99b7483224",
                        "target_lang_word": "Telefongespräch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Telefongespräch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "507e65ea-23c3-3ab4-b664-1295b9bb370a",
                                        "entry_id": "93b389ce-db5c-358d-8a55-9a91d59521ed",
                                        "glosses": [
                                            "Telekommunikation, Telefonie: Unterhaltung über einen Telefonapparat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef51462c-eb57-44ac-aa88-5e46ce248cf7",
                                                "sense_id": "507e65ea-23c3-3ab4-b664-1295b9bb370a",
                                                "text": "„Am Tag darauf wurde dieses Telefongespräch zu einer Geschichte, die Alma ihren Kolleginnen in der Pelzbearbeitung erzählte.“"
                                            },
                                            {
                                                "example_id": "6a36db49-8170-4520-a999-534efea2ea5f",
                                                "sense_id": "507e65ea-23c3-3ab4-b664-1295b9bb370a",
                                                "text": "„Lorenzo hatte in einem langen Telefongespräch mit Marcello viel darüber erfahren, was Marie anscheinend von den Drogengeschäften, der Geldwäsche und dem oft nicht legalen Handel mit Autos wusste.“"
                                            },
                                            {
                                                "example_id": "ce50e016-f2bd-4949-856b-ed7c2c90c80d",
                                                "sense_id": "507e65ea-23c3-3ab4-b664-1295b9bb370a",
                                                "text": "„Nach dem Telefongespräch mit Fried hatte er den neunten April eingekreist, und die Tage rasten unaufhaltsam auf diese Markierung zu.“"
                                            },
                                            {
                                                "example_id": "6ec975ef-4229-4461-b261-37ae0f50d00e",
                                                "sense_id": "507e65ea-23c3-3ab4-b664-1295b9bb370a",
                                                "text": "„Deine Telefongespräche dauern nur 30 Sekunden.“"
                                            },
                                            {
                                                "example_id": "6a345561-8be7-451c-92e8-b285fb7f1c7b",
                                                "sense_id": "507e65ea-23c3-3ab4-b664-1295b9bb370a",
                                                "text": "„Er ließ sich vom Besitzer Kleingeld geben, führte ein Telefongespräch, tankte voll, ging hinein und bezahlte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
