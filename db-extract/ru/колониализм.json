                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca9c6788-5ba9-37c5-9da2-4c8a7ddfa47d",
                                        "entry_id": "8e0536c1-cfa0-3d0a-a171-7da2ab6a9cd3",
                                        "glosses": [
                                            "La ideología o doctrina que promueve el colonialismo₁."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "47f07292-58d8-3682-90b6-7fd67bbce764",
                                        "entry_id": "8e0536c1-cfa0-3d0a-a171-7da2ab6a9cd3",
                                        "glosses": [
                                            "Influencia o dominación de un país por otro más poderoso de una forma violenta, a través de una invasión militar, o sutil, sin que intervenga la fuerza. Los motivos pueden ser poder riqueza o dominio. Esta dominación puede ser política, militar, informativa, cultural, económica o étnica."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5deb777-6aec-4b18-8272-c0e365b5ab29",
                        "source_entry_id": "17742f91-f5c1-35b8-88e1-844b4d0f0198",
                        "source_sense_id": "cca4cc0a-2ce4-377d-b19b-e087264184d2",
                        "target_lang_word": "colonialismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonialismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "8aded51d-3456-3b61-b6f8-fe50fdb0c151",
                                        "entry_id": "4dc242e2-0835-33f6-b217-b695515887de",
                                        "glosses": [
                                            "tendenza di uno stato ad estendersi al di fuori dei propri confini, per poter accedere più facilmente alle risorse di altri territori ed assoggettarne le popolazioni"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1157db-5d4c-4b79-a864-863a56d7a11c",
                                                "sense_id": "8aded51d-3456-3b61-b6f8-fe50fdb0c151",
                                                "text": "Cecil Rhodes fu il padre del colonialismo africano"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f164466-3d4a-415c-9d5f-daf856c62c0a",
                        "source_entry_id": "17742f91-f5c1-35b8-88e1-844b4d0f0198",
                        "source_sense_id": "cca4cc0a-2ce4-377d-b19b-e087264184d2",
                        "target_lang_word": "Kolonialismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolonialismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56c1792d-7fd5-3440-ad4a-a550eb72edf9",
                                        "entry_id": "8540bd58-6555-3bfe-b219-099457b8f22f",
                                        "glosses": [
                                            "Politik zum Erwerb oder Erhalt von Kolonien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd065c63-0ecc-4537-a8c3-89286c84346e",
                                                "sense_id": "56c1792d-7fd5-3440-ad4a-a550eb72edf9",
                                                "text": "Der langjährige Kolonialismus führte zur Ausbeutung der Kolonien."
                                            },
                                            {
                                                "example_id": "d086e24c-0d0b-4d03-aaf8-f2c138057020",
                                                "sense_id": "56c1792d-7fd5-3440-ad4a-a550eb72edf9",
                                                "text": "„Die Vorboten des Kolonialismus in Afrika waren Forscher, Abenteurer, Missionare und Händler.“"
                                            },
                                            {
                                                "example_id": "033b9835-6d83-4340-81ec-411d9c92708a",
                                                "sense_id": "56c1792d-7fd5-3440-ad4a-a550eb72edf9",
                                                "text": "„Der damals wichtigste karibische Zuckerlieferant hatte sich vom Joch des Kolonialismus befreit.“"
                                            },
                                            {
                                                "example_id": "e84d62ef-187a-4a5a-b738-e9e0f080a0aa",
                                                "sense_id": "56c1792d-7fd5-3440-ad4a-a550eb72edf9",
                                                "text": "„Die These, dass der Kolonialismus als Export europäischer Produktionsweisen und Denkmuster nach überseeischen Gebieten in sich eine rückwirkende Kraft beinhaltet, wird hier anhand der emanzipatorischen Funktion der Kolonialmigranten sowohl in Deutschland als auch in der eigenen Heimat bestätigt.“"
                                            },
                                            {
                                                "example_id": "9302ae6a-0519-448d-8bbc-83385ef2eb69",
                                                "sense_id": "56c1792d-7fd5-3440-ad4a-a550eb72edf9",
                                                "text": "„Tatsächlich ging man in der Geschichtsforschung lange davon aus, dass der Kolonialismus von oben über Deutschland gekommen sei.“"
                                            },
                                            {
                                                "example_id": "5514b6ef-3081-4722-9836-8484baa81ba4",
                                                "sense_id": "56c1792d-7fd5-3440-ad4a-a550eb72edf9",
                                                "text": "„Blickt man auf Mugabes Lebensweg, so wird darin die Geschichte des Kolonialismus sichtbar, seine Gewaltherrschaft ist dessen unmittelbare Fortsetzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
