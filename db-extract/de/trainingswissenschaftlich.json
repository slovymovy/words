                "senses": [
                    {
                        "sense_id": "f3860c81-b5ce-318e-94a4-14efb839890b",
                        "entry_id": "809e73cd-f6ab-3a15-9c7a-dea8674f193a",
                        "glosses": [
                            "die Trainingswissenschaft betreffend; in der Art der Trainingswissenschaft vorgehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24267282-edd2-4e4e-8f37-8df262cf6b9b",
                                "sense_id": "f3860c81-b5ce-318e-94a4-14efb839890b",
                                "text": "„Mit taktischer Feinarbeit und trainingswissenschaftlichem Fleiß hat er Hoffnungsträgern den Erfolg ermöglicht, den sie jetzt ausleben.“"
                            },
                            {
                                "example_id": "9ba5d18f-703d-45eb-aa32-654f6c9f7a11",
                                "sense_id": "f3860c81-b5ce-318e-94a4-14efb839890b",
                                "text": "„In den neuen Räumlichkeiten befindet sich ein modernes Zentrum für trainingswissenschaftliche Leistungsdiagnostik.“"
                            },
                            {
                                "example_id": "4deccc70-8cae-42c6-b216-f875dbe9c222",
                                "sense_id": "f3860c81-b5ce-318e-94a4-14efb839890b",
                                "text": "„Kern der Ausbildung ist die Vermittlung neuester medizinischer Kenntnisse und trainingswissenschaftlicher Erkenntnisse zur Vermeidung gesundheitlicher Risiken während des Trainings.“"
