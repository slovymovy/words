                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db5dd9b9-3894-3677-93df-c6b66aec3e58",
                                        "entry_id": "32e356cd-9242-3eb4-a9ab-05e68a93c6fe",
                                        "glosses": [
