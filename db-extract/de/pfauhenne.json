                    {
                        "sense_id": "d24d672f-c4e0-38b7-bde0-fb732d543f7e",
                        "entry_id": "ab2109cf-61b7-3c90-9950-95e417201db5",
                        "glosses": [
                            "weiblicher Pfau"
                        ],
