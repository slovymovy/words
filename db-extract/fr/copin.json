                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c585f93b-f815-48df-a4d2-b3ba58dee16b",
                                "sense_id": "f11b4476-abdb-3c67-9263-bb0839940a87",
                                "text": "Redevenu pour le poète le copin du collège, l’avoué pensait avec raison que son camarade laisserait échapper, dans un temps donné, le secret de la retraite de David."
                            },
                            {
                                "example_id": "d7ea91a7-1992-4109-971e-9994abad1dde",
                                "sense_id": "f11b4476-abdb-3c67-9263-bb0839940a87",
                                "text": "Il devait de l’argent à ce copin."
                            },
                            {
                                "example_id": "0b7fea68-e6b1-437d-8925-73bb1f9e0604",
                                "sense_id": "f11b4476-abdb-3c67-9263-bb0839940a87",
                                "text": "Tiens, le lobby du cinémas ne serait pas copin avec la liberté de la presse."
                            }
                        ]
                    }
