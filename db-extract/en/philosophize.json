                        "sense_id": "b1f35d40-531e-305a-aec7-a6cd61a2e912",
                        "entry_id": "3c618fb9-540e-3f7f-8ba4-8b3c914d1522",
                        "glosses": [
                            "To ponder or reason out philosophically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b05657-d48d-41bc-a20b-b5c002583fc9",
                                "sense_id": "b1f35d40-531e-305a-aec7-a6cd61a2e912",
                                "text": "The popular influence of the scientific specialist begins to rival that of the philosopher only when he ceases to be a specialist and commences to philosophize about the progress of his subject—and usually only after he has been taken up by the intellectuals for reasons which have little to do with his scientific eminence."
                            }
                        ]
                    }
                ],
