                    {
                        "translation_id": "ebb688ec-a111-4838-a6d4-72cc43314486",
                        "source_entry_id": "03685094-2286-33b1-badd-cfe6eda71739",
                        "source_sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                        "source_sense_description": "Linguistik: die kleinste bedeutungsunterscheidende sprachliche Einheit (Langue)",
                        "target_lang_word": "phoneme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phoneme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "602f4e10-6353-3c72-9870-0f86d87cf99a",
                                        "entry_id": "484ac76d-4cf5-34c8-9ab1-bbee43bbacab",
                                        "glosses": [
                                            "An indivisible unit of sound in a given language. A phoneme is an abstraction of the physical speech sounds (phones) and may encompass several different phones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc5c275-1579-4dd5-b6f6-0abefa2422da",
                                                "sense_id": "602f4e10-6353-3c72-9870-0f86d87cf99a",
                                                "text": "It is crucial for the phoneme structure of Finnish — traditionally /d/ has not been included in the Finnish phonotax, but it fulfils the criteria of a phoneme (Karlsson, 1983: 66-7)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67f1264c-a511-422c-9b1e-232ae80fbd50",
                        "source_entry_id": "03685094-2286-33b1-badd-cfe6eda71739",
                        "source_sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                        "source_sense_description": "Linguistik: die kleinste bedeutungsunterscheidende sprachliche Einheit (Langue)",
                        "target_lang_word": "phonème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phonème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27f8eb99-1b96-3839-9816-0d83890aaee9",
                                        "entry_id": "4061134f-9c0a-360f-8b50-01e70e7b894c",
                                        "glosses": [
                                            "Unité distinctive de prononciation dans une langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cba0d55-b72b-4021-b7cd-8ec4aab7eaa3",
                                                "sense_id": "27f8eb99-1b96-3839-9816-0d83890aaee9",
                                                "text": "Deux sons sont des phonèmes si, dans un mot, la substitution de l’un par l’autre entraîne un changement de sens : exemple dans « chat » et « rat », le son « ch » est le phonème \\ʃ\\ et le son « r » est le phonème \\ʁ\\."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89383af0-7cb8-33cc-9224-523c60765f82",
                                        "entry_id": "4061134f-9c0a-360f-8b50-01e70e7b894c",
                                        "glosses": [
                                            "Désigne, pour Carl Wernicke, les hallucinations auditives durant lesquelles le sujet entend des mots."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f63c9aba-78cb-4561-bdd9-776e18f2986c",
                                                "sense_id": "89383af0-7cb8-33cc-9224-523c60765f82",
                                                "text": "… une acception de phonème en pathologie qui se définit comme une « Hallucination auditive dans laquelle le sujet entend des voix» (les spécialistes que j'ai consultés ignorent pourtant cet emploi, dont le professeur Réné Tissot me dit qu'il est attesté sans indication de source dans l'édition de 1972 du dictionnaire de médecine …)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
