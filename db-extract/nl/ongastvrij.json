                "senses": [
                    {
                        "sense_id": "6409a65e-d120-3dab-86e1-e45e5e7dce72",
                        "entry_id": "f8f7fbcf-70c7-3889-8bd6-525d9b24d52d",
                        "glosses": [
                            "van een persoon dat deze niet geneigd is om gasten vriendelijk te ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9ed118-9630-4bfd-b015-2d5c730fec13",
                                "sense_id": "6409a65e-d120-3dab-86e1-e45e5e7dce72",
                                "text": "Ik hoop dat u niet zo ongastvrij zult zijn om me op dit tijdstip buiten de deur te zetten."
                            },
                            {
                                "example_id": "4194d625-5542-45a2-be01-b98271e4be90",
                                "sense_id": "6409a65e-d120-3dab-86e1-e45e5e7dce72",
                                "text": "Een aanzienlijk kleinere groep mensen vindt dat de Nederlandse houding tegenover vluchtelingen ongastvrij en is daar boos over."
                            }
                        ]
                    },
                    {
                        "sense_id": "31dc5110-2a78-3adf-9b79-5fcc912c8235",
                        "entry_id": "f8f7fbcf-70c7-3889-8bd6-525d9b24d52d",
                        "glosses": [
                            "van een gebied dat het onherbergzaam en onveilig is"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "338d4497-c238-4662-914d-a5f3574b3402",
                        "source_entry_id": "f8f7fbcf-70c7-3889-8bd6-525d9b24d52d",
                        "source_sense_id": "6409a65e-d120-3dab-86e1-e45e5e7dce72",
