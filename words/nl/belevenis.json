                {
                    "sense_id": "b63c3b0a-d564-339a-b8c9-297d436dff31",
                    "sense_definition": "een gedenkwaardige ervaring of een spannend avontuur dat indruk maakt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ervaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bezoek aan de historische stad Jeruzalem was voor de hele familie een <w>belevenis</w>.",
                            "target_lang_translations": {
                                "en": "The visit to the historic city of Jerusalem was an <w>experience</w> for the whole family."
                            }
                        },
                        {
                            "text": "Onze vakantie in de bergen was een unieke <w>belevenis</w> die we nooit zullen vergeten.",
                            "target_lang_translations": {
                                "en": "Our holiday in the mountains was a unique <w>experience</w> that we will never forget."
                            }
                        }
                    ],
                    "synonyms": [
                        "ervaring",
                        "avontuur"
                    ],
                    "common_phrases": [
                        "unieke belevenis",
                        "hele belevenis"
                    ],
                    "target_lang_definitions": {
                        "en": "a memorable experience or an exciting adventure that makes an impression"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "experience",
                                "target_lang_sense_clarification": "a memorable event"
                            },
                            {
                                "target_lang_word": "adventure",
                                "target_lang_sense_clarification": "an exciting or unusual experience"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc8caa71-ebfb-3b55-b25f-9e15d4ea9889",
                    "sense_definition": "de manier waarop iemand iets persoonlijk waarneemt of voelt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ervaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In haar <w>belevenis</w> waren de langsvarende boten immens groot en de golven reusachtig.",
                            "target_lang_translations": {
                                "en": "In her <w>perception</w>, the passing boats were immense and the waves were giant."
                            }
                        },
                        {
                            "text": "De persoonlijke <w>belevenis</w> van de getuige week sterk af van wat er op de camerabeelden te zien was.",
                            "target_lang_translations": {
                                "en": "The witness's personal <w>experience</w> differed greatly from what could be seen on the camera footage."
                            }
                        }
                    ],
                    "synonyms": [
                        "beleving",
                        "ervaring"
                    ],
                    "common_phrases": [
                        "persoonlijke belevenis"
                    ],
                    "target_lang_definitions": {
