                "senses": [
                    {
                        "sense_id": "e2aa7bd9-f8a0-3136-b186-f0fc04dde0f3",
                        "entry_id": "15b25dde-3ebf-3164-bdd5-a42271584ede",
                        "glosses": [
                            "неол., жарг. платная автодорога"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31bc0362-3381-4373-b0d5-e7c7c2b2f3e1",
                                "sense_id": "e2aa7bd9-f8a0-3136-b186-f0fc04dde0f3",
                                "text": "Ехал недавно из Москвы в Крым по платке, как-то разочаровался."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1f07497-5c6c-4ce4-97f0-e731885327ed",
                        "source_entry_id": "15b25dde-3ebf-3164-bdd5-a42271584ede",
                        "source_sense_id": "e2aa7bd9-f8a0-3136-b186-f0fc04dde0f3",
                        "target_lang_word": "turnpike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turnpike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beb2a5d4-3f2d-332f-b7c0-9865df7f707a",
                                        "entry_id": "4393699a-59f5-3daf-b537-eb89e8be86a8",
                                        "glosses": [
                                            "A frame consisting of two bars crossing each other at right angles and turning on a post or pin, to hinder the passage of animals, but admitting a person to pass between the arms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65f9e9f-f382-4a8f-8063-0905ba3b73d5",
                                                "sense_id": "beb2a5d4-3f2d-332f-b7c0-9865df7f707a",
                                                "text": "1626, Ben Jonson, The Staple of News, Act III, Scene 1, Yale Studies in English Vol. 28, New York: Henry Holt, 1905, p. 58,\nI moue vpon my axell, like a turne-pike, / Fit my face to the parties, and become / Straight one of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "091f0e13-5298-3075-bcd0-fdbaace075aa",
                                        "entry_id": "4393699a-59f5-3daf-b537-eb89e8be86a8",
                                        "glosses": [
                                            "A gate or bar set across a road to stop carriages, animals, and sometimes people, until a toll is paid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc276f4f-c5b0-4126-868c-d72a9c366bd5",
                                                "sense_id": "091f0e13-5298-3075-bcd0-fdbaace075aa",
                                                "text": "1722, Daniel Defoe, A Journal of the Plague Year, London: E. Nutt et al., pp. 9-10,\n[…] it was rumour’d that an order of the Government was to be issued out, to place Turn-pikes and Barriers on the Road, to prevent Peoples travelling;"
                                            },
                                            {
                                                "example_id": "253fa861-9d53-4cf4-ad4d-71afca58b583",
                                                "sense_id": "091f0e13-5298-3075-bcd0-fdbaace075aa",
                                                "text": "[…] Pope Pelagius, then Bishop of Rome […] thereupon assum'd the Power of opening and shutting Heaven's Gates; and he afterwards setting a Price or Toll upon the Entrance, as we do here at passing a Turn-pike […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa01320-76a1-3b16-9589-cfd8d9fca152",
                                        "entry_id": "4393699a-59f5-3daf-b537-eb89e8be86a8",
                                        "glosses": [
                                            "A winding stairway."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a88db570-8107-4cdd-9c70-cdc1262c06e6",
                                                "sense_id": "3fa01320-76a1-3b16-9589-cfd8d9fca152",
                                                "text": "Ramsay stabbed Ruthven accordingly and James lending his assistance they thrust the wounded man down the turnpike by which Ramsay had ascended Voices and steps were now heard advancing upwards and Ramsay knowing the accents called out to sir Thomas Erskine to come up the turnpike stair even to the head Sir Thomas Erskine was accompanied by sir Hugh Harris the king's physician a lame man and unfit for fighting Near the bottom of the turnpike sir Thomas Erskine in his ascent met Ruthven bleeding in the face and neck and called out Fie strike I this is the traitor l on which Alexander Ruthven was run through the body having only breath remaining to say Alas I had no blame of it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1b137c7-3b6b-30ed-946b-136d7fd740fa",
                                        "entry_id": "4393699a-59f5-3daf-b537-eb89e8be86a8",
                                        "glosses": [
                                            "A beam filled with spikes to obstruct passage; a cheval de frise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4588502-6849-35c9-93cd-7baf01d1de75",
                                        "entry_id": "4393699a-59f5-3daf-b537-eb89e8be86a8",
                                        "glosses": [
                                            "A toll road, especially a toll expressway."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a34a84b-df97-42e2-be37-a7eb90f82944",
                                                "sense_id": "e4588502-6849-35c9-93cd-7baf01d1de75",
                                                "text": "Eleven Pair of Mills ſtand within Four Miles of the Place, which bring a great Trade to it: But the Road is by this means ſo continually torn, that it is one of the worſt Turnpikes about London."
                                            },
                                            {
                                                "example_id": "f04d2565-ccef-4fd4-bcdd-bdd1730ecde6",
                                                "sense_id": "e4588502-6849-35c9-93cd-7baf01d1de75",
                                                "text": "[T]here is a bundle of pawnbrokers' duplicates, those turnpike tickets on the road of poverty ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db19f3f5-693d-306e-81cd-fd0066b339fc",
                                        "entry_id": "4393699a-59f5-3daf-b537-eb89e8be86a8",
                                        "glosses": [
                                            "A trajectory on a finite time interval that satisfies an optimality criterion which is associated with a cost function."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d178bb3d-7fff-4b77-9662-bbcaa822ae58",
                                                "sense_id": "db19f3f5-693d-306e-81cd-fd0066b339fc",
                                                "text": "In the monograph we discuss a number of results concerning turnpike properties in the calculus of variations and optimal control which were obtained by the author in the last ten years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turnpike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b0d6902-c384-3b5a-b03a-b549728b0590",
                                        "entry_id": "9878261f-f5d2-3572-a2ab-c571dbe4ade8",
                                        "glosses": [
                                            "To form (a road, etc.) in the manner of a turnpike road, or into a rounded form, as the path of a road."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
