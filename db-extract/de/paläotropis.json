                ],
                "senses": [
                    {
                        "sense_id": "d96e2d89-915b-3529-845a-bfb43b75d14b",
                        "entry_id": "9396d1fc-b12e-3ac0-8a65-b8bf6163de45",
                        "glosses": [
                            "eine biogeographische Region, die die tropischen und subtropischen Gebiete der Alten Welt, also fast ganz Afrika, Indien und Südostasien umfasst"
                        ],
                        "tags": [
                            "Biogeografie"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3041b5-0b7b-4435-90af-a44166f63b59",
                                "sense_id": "d96e2d89-915b-3529-845a-bfb43b75d14b",
                                "text": "„Die Paläotropis wird in drei Regionen unterteilt: die Aethiopis, die Madegassis und die Orientalis.“"
                            },
                            {
                                "example_id": "31d5138b-c8fb-46ab-aeb8-1894eb99e543",
                                "sense_id": "d96e2d89-915b-3529-845a-bfb43b75d14b",
                                "text": "„In der gesamten Paläotropis und in Australien vertreten die Agamen (Agamidae) die Leguane (Iguanidae).“"
                            },
                            {
                                "example_id": "c64fcd19-ea44-4006-90d6-37609a9f0930",
                                "sense_id": "d96e2d89-915b-3529-845a-bfb43b75d14b",
                                "text": "„Zur Paläotropis gehören die inner- und randtropischen Gebiete der Alten Welt.“"
                            },
                            {
                                "example_id": "9c0e4828-fb08-4976-91e2-569ada88d196",
                                "sense_id": "d96e2d89-915b-3529-845a-bfb43b75d14b",
                                "text": "„Paläotropis und Neotropis haben pantropische Familien wie die Palmaceen (Palmengewächse) gemeinsam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
