                ],
                "senses": [
                    {
                        "sense_id": "e8c7d085-c746-3c85-8e46-4a65d70ff950",
                        "entry_id": "362fb30c-605e-3f7f-b994-31eb940c2ad6",
                        "glosses": [
                            "ungeordneter Haufen nutzlos( geworden)-er Objekte"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "6a2465f1-a4fd-4353-9833-ce7ce2a52bf2",
                                "sense_id": "e8c7d085-c746-3c85-8e46-4a65d70ff950",
                                "text": "„Das Ganze hat etwas von seiner naiven Unschuld verloren durch exzessiven Souvenirverkauf mit exotischen Muscheln und anderem Prüddel.“"
                            },
                            {
                                "example_id": "358f8361-6fc3-4146-a103-15c954983b0c",
                                "sense_id": "e8c7d085-c746-3c85-8e46-4a65d70ff950",
                                "text": "„Der Feuergott sollte sich den ganzen Prüddel schnappen, den er in der Kanalisation angehäuft hatte, und umziehen, damit der Rattenkönig ihn nicht finden konnte – und mich natürlich auch nicht, denn ich käme ja mit.“"
                            },
                            {
                                "example_id": "6f051ffa-02c3-4c80-95dc-a205a895b153",
                                "sense_id": "e8c7d085-c746-3c85-8e46-4a65d70ff950",
                                "text": "„Weiteren sonstigen Prüddel legte er auf dem sandigen Boden neben dem Fahrzeug ab.“"
                            },
                            {
                                "example_id": "9b11f84a-0df6-441a-a9a8-d029195f64bf",
                                "sense_id": "e8c7d085-c746-3c85-8e46-4a65d70ff950",
                                "text": "„Wir haben unser Materiallager aufgeräumt und dabei zahlreiche Sachen gefunden, die bei uns bloß Staub ansetzen. Wir sind aber sicher: Das ist nicht alles nur Prüddel, der entsorgt werden kann.“"
                            },
                            {
                                "example_id": "a031c307-9814-420f-949f-d00ec4df9d30",
                                "sense_id": "e8c7d085-c746-3c85-8e46-4a65d70ff950",
                                "text": "„Tonnenweise hatten Kinder und Eltern vor allem Spielzeug und Kinderkleidung [für den Flohmarkt] angeschleppt […]. Aber auch viel Prüddel stand auf der großen Wiese […] zum Verkauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
