                                        "sense_id": "161c5267-3646-3731-8c44-bd17bded17a3",
                                        "entry_id": "56cc100a-aac2-37e9-a990-988780aacee2",
                                        "glosses": [
                                            "die krankhaft übersteigerte sexuelle Motivation und Aktivität einer Frau"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d59f4a-c2d4-40a2-b1b5-8efc4a117d21",
                                                "sense_id": "161c5267-3646-3731-8c44-bd17bded17a3",
                                                "text": "Die Nymphomanie tritt häufig als Symptom im Rahmen von Persönlichkeitsstörungen auf und kann auch auf sexuelle Missbräuche im Kindes- und Jugendalter hinweisen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d21f2e00-a748-4bf1-a0cb-116496f0d2a1",
                        "source_entry_id": "8d915087-be26-3487-a292-314f3da2adb6",
                        "source_sense_id": "c2cbb628-d339-3a02-91df-656371ae9f57",
                        "target_lang_word": "Mannstollheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mannstollheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ab6a8e-6dee-3e5f-b57f-96141490f196",
                                        "entry_id": "ded984ec-9682-37c5-94ec-73cbd3e46df2",
                                        "glosses": [
                                            "ein übersteigerter Geschlechtstrieb zu Männern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8e1f43-9c4c-4b15-b968-54f2a8cfbf89",
                                                "sense_id": "b8ab6a8e-6dee-3e5f-b57f-96141490f196",
                                                "text": "Die Mannstollheit der Frau kann auf einer Erkrankung der Eierstöcke beruhen."
                                            },
                                            {
                                                "example_id": "b03cb461-babd-4881-8d3a-9f2140cb4675",
                                                "sense_id": "b8ab6a8e-6dee-3e5f-b57f-96141490f196",
                                                "text": "„Ich erblickte dort auch die wegen ihrer Mannstollheit berüchtigte Herzogin von Villadarias.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7727026-b338-4c9b-b215-55e5b6f8c934",
                        "source_entry_id": "8d915087-be26-3487-a292-314f3da2adb6",
                        "source_sense_id": "c2cbb628-d339-3a02-91df-656371ae9f57",
                        "target_lang_word": "nimfomania",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nimfomania",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2615ffb8-692b-3134-95b5-40ec6ace9adc",
                                        "entry_id": "298e282b-ea0b-30b7-af28-59d68e6e94cd",
                                        "glosses": [
                                            "chorobliwie wzmożony popęd płciowy u kobiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29907bb7-f289-422c-84a5-b8b7f1d6b54b",
                                                "sense_id": "2615ffb8-692b-3134-95b5-40ec6ace9adc",
                                                "text": "Nimfomania połączona z poszukiwaniem nowych partnerów i podejmowaniem współżycia w każdej, nawet nie sprzyjającej temu okoliczności, bywa wyrazem zakłócenia kontroli impulsów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efc13bd3-e4e0-4602-9f82-708fcf0e2da8",
                        "source_entry_id": "8d915087-be26-3487-a292-314f3da2adb6",
                        "source_sense_id": "c2cbb628-d339-3a02-91df-656371ae9f57",
                        "target_lang_word": "nymphomanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nymphomanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deeb487a-a4e8-3c59-9662-d21ebbab7039",
                                        "entry_id": "05ee4ff9-c895-39c7-bd81-4dafd3fd4590",
                                        "glosses": [
                                            "Amplification pathologique des besoins sexuels chez la femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636f57de-0b9d-425f-8117-95937219bdab",
                                                "sense_id": "deeb487a-a4e8-3c59-9662-d21ebbab7039",
                                                "text": "Le mariage seul guérit la nymphomanie, sur-tout quand elle a pris sa source dans une violente passion pour l'objet qu'il est enfin permis de posséder."
                                            },
                                            {
                                                "example_id": "08dc08c6-c7b4-4ef9-a166-95c6dda65588",
                                                "sense_id": "deeb487a-a4e8-3c59-9662-d21ebbab7039",
                                                "text": "La nymphomanie, maladie étonnante par la simplicité de sa cause, qui pour l'ordinaire est l'inflammation lente des ovaires et de la matrice ; maladie dégradante par ses effets, qui transforment la fille la plus timide en une bacchante."
                                            },
                                            {
                                                "example_id": "fdbf544f-b090-4389-8cdc-fbe27dc5e64a",
                                                "sense_id": "deeb487a-a4e8-3c59-9662-d21ebbab7039",
                                                "text": "Hormis les cas – rares – de nymphomanie suraiguë, et ceux – moins rares – d’intérêt, les femmes ne couchent pas avec les hommes sans éprouver à tout le moins pour eux un « petit quelque chose » qui peut aller jusqu’au paroxysme de l’amour mais passe par maints degrés, camaraderie, gentillesse, tendresse, affection, tous sentiments capables de tiédeur aux yeux d’une jalousie perspicace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
