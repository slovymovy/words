                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a5cf4fc-2683-4335-abdb-3b206a6da8de",
                        "entry_id": "0f2a22b1-4dc9-3adc-8821-0ace00b55bb9",
                        "tags": [
