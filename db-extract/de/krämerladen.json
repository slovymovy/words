                "senses": [
                    {
                        "sense_id": "c5f6417c-8ea0-348e-9457-c1f0cd107719",
                        "entry_id": "4c66b0e1-9bf4-3b24-9668-0c2b6d249f21",
                        "glosses": [
                            "Geschäft, das allerlei Waren des täglichen Bedarfs führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f6dcb5-29bf-4aaa-bf7a-f8265b0363ac",
                                "sense_id": "c5f6417c-8ea0-348e-9457-c1f0cd107719",
                                "text": "„Sie hielt vor einem Krämerladen, der an der Ecke jenes Feldwegs einsam in die Landschaft gebaut war.“"
                            },
                            {
                                "example_id": "d0d2e373-8c61-4868-811c-310c4a1c9eda",
                                "sense_id": "c5f6417c-8ea0-348e-9457-c1f0cd107719",
                                "text": "„Nur die zweite Gruppe vor dem Krämerladen hielt ernst beisammen.“"
                            },
                            {
                                "example_id": "1b95c52c-27a2-400f-ad74-00d4921e5887",
                                "sense_id": "c5f6417c-8ea0-348e-9457-c1f0cd107719",
                                "text": "„Der Vater hatte einen Krämerladen und wohnte mit seiner Familie in der dazu gehörenden Wohnung.“"
                            },
                            {
                                "example_id": "d13df1fe-e4f0-48c5-ae6c-f3a284204037",
                                "sense_id": "c5f6417c-8ea0-348e-9457-c1f0cd107719",
                                "text": "„In einem Krämerladen hatte Thomas verschiedene Kleinigkeiten entdeckt, die er unbedingt benötigte: getrocknete Pilze, Korinthen, Rosinen, ein Stück Orangeat und ein Stück Zitronat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26f2c60e-c6d9-4d55-bc2f-76b7318ed866",
                        "source_entry_id": "4c66b0e1-9bf4-3b24-9668-0c2b6d249f21",
                        "source_sense_id": "c5f6417c-8ea0-348e-9457-c1f0cd107719",
                        "source_sense_description": "Geschäft, das allerlei Waren des täglichen Bedarfs führt",
                        "target_lang_word": "bazar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bazar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aaa46c1-3a0b-3420-987d-b92143839c98",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Marché public, lieu destiné au commerce en Orient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1f3fd5-fc8e-4eff-a9d3-9c343094da6c",
                                                "sense_id": "8aaa46c1-3a0b-3420-987d-b92143839c98",
                                                "text": "À présent voici les bazars avec les mille produits de la Perse, de la Chine, de la Turquie, de la Sibérie, de la Mongolie."
                                            },
                                            {
                                                "example_id": "52342277-8cf3-4876-a88c-9f958ab38ce6",
                                                "sense_id": "8aaa46c1-3a0b-3420-987d-b92143839c98",
                                                "text": "Bazar et vacarme sont le même mot. Le mot persan bazar s’analyse en wescar. Le mot arménien vacarme se décompose en wahacarana. L’un et l’autre disent la rue marchande (mot à mot « l’endroit où on marche pour acheter », la ville)."
                                            },
                                            {
                                                "example_id": "7d3913d7-8722-4811-ac58-4fad9e994034",
                                                "sense_id": "8aaa46c1-3a0b-3420-987d-b92143839c98",
                                                "text": "Je voudrais être un des deux cèdres bleus, dont les branches, la nuit, servent d’asile aux nuées de colombes et, le jour, abritent les petits bazars bruyants sous leurs ombrages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e7ebb8e-268a-33bf-a339-3570926c2ce3",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Lieu couvert où sont réunis des marchands tenant des boutiques d’étoffes, de meubles, de bijouterie, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "415f82bf-92e3-4ab3-81b2-9d67ded28758",
                                                "sense_id": "0e7ebb8e-268a-33bf-a339-3570926c2ce3",
                                                "text": "— Quant aux pauvres filles sans dot, elles deviennent folles, elles meurent ; pour elles aucune pitié ! La beauté, les vertus ne sont pas des valeurs dans votre bazar humain et vous nommez Société ce repaire d’égoïsme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd00462d-fe65-3c58-8ec4-fea8f3da52ef",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Vaste magasin où se vendent au détail des marchandises diverses, généralement à bas prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d38b80e7-c1c4-46e5-bf46-b695f9d89e50",
                                                "sense_id": "cd00462d-fe65-3c58-8ec4-fea8f3da52ef",
                                                "text": "Un Petit Dunkerque est une sorte de bazar de fines porcelaines et de curiosités artistiques, de charmantes et délicates inutilités , qui en font un bric-à-brac fashionable."
                                            },
                                            {
                                                "example_id": "5f5abb7d-efcb-4e81-8b46-f46956b26421",
                                                "sense_id": "cd00462d-fe65-3c58-8ec4-fea8f3da52ef",
                                                "text": "Et ce cube énorme, ce colossal bazar leur bouchait le ciel."
                                            },
                                            {
                                                "example_id": "1edfbc48-6d7a-4ed1-8e6d-4e486d41a32b",
                                                "sense_id": "cd00462d-fe65-3c58-8ec4-fea8f3da52ef",
                                                "text": "Le matériel est plus onéreux pour la pêche de la crevette grise et les pêches au filet, car il ne faut pas hésiter à investir dans un équipement résistant en évitant les vagues imitations vendues dans les bazars de plage, qui rendront l'âme dès votre première sortie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4dc854f-c669-310a-8fd8-cf48f228db61",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Fourbi, grand désordre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "137dc6e4-4786-409e-af7c-aa68b00fb610",
                                                "sense_id": "b4dc854f-c669-310a-8fd8-cf48f228db61",
                                                "text": "Quel bazar !"
                                            },
                                            {
                                                "example_id": "93a13a18-7abf-49a8-8045-e9d42af4bd8e",
                                                "sense_id": "b4dc854f-c669-310a-8fd8-cf48f228db61",
                                                "text": "Les oignons de l’Église, ça devait être, sans doute, pour le général, les sacristies sentant le moisi, les nonciatures, les pastorales d'ensemble, et tout notre bazar extérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9f5fa5-a42d-3c20-a499-e71fc9de8d9f",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Ensemble d’objets et de matériels divers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8187941-7e86-4d3a-9887-2ab200545f36",
                                                "sense_id": "2f9f5fa5-a42d-3c20-a499-e71fc9de8d9f",
                                                "text": "Ma foi ! comme il fallait qu’on revienne à côté pour récupérer notre matériel, échafaudage, draperies, tout le bazar, j’ai dit à mon collègue : « Ça tombe bien, on va le raccompagner, ça fera toujours moins ballot que de s’en retourner à vide. » Et on l’a collé dans le fourgon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a4fa6c-d573-3d5f-a257-86fa121aeef8",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Lycée."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b5f209-4cfe-455a-9b47-670e5d6dd916",
                                                "sense_id": "78a4fa6c-d573-3d5f-a257-86fa121aeef8",
                                                "text": "Sécher le bazar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aa07082-c49d-39fa-99e9-e7b96106c1b1",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Sorte de lit mobile pour les douaniers en embuscade."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58aea65f-1afa-4d34-9d47-ab087ab35b40",
                                                "sense_id": "8aa07082-c49d-39fa-99e9-e7b96106c1b1",
                                                "text": "Vers la fin de ce siècle, la brigade d’embuscade était composée de deux hommes : alors que l’un surveillait, l’autre se reposait sur un lit d’embuscade, appelé aussi “bazar”, et qui lui appartenait !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "696ed566-e474-35f9-bc30-d253c5f8aec8",
                                        "entry_id": "9b266b4e-626a-3e51-86de-194d2035736f",
                                        "glosses": [
                                            "Sexe de l’homme ou de la femme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a91a5b-48b1-4395-918d-fbb423a80676",
                                                "sense_id": "696ed566-e474-35f9-bc30-d253c5f8aec8",
                                                "text": "On les trouve répandus dans l’herbe parmi les litrons vides, bourrés à mort, la vieille les quilles grandes ouvertes, comme une porte de grange, elle a pas de culotte, tu vois son bazar jusqu’au fond, noir dégueulasse, t’as peur."
                                            },
                                            {
                                                "example_id": "bda597d0-452e-40e8-bc9f-7cbbae42c6ef",
                                                "sense_id": "696ed566-e474-35f9-bc30-d253c5f8aec8",
                                                "text": "« Vous avez bien nettoyé vot’ p’tit bazar Ivo ? »"
                                            },
                                            {
                                                "example_id": "f6d64756-d2a0-43cd-a8fe-80310294f595",
                                                "sense_id": "696ed566-e474-35f9-bc30-d253c5f8aec8",
                                                "text": "...il a demandé à faire sa toilette, eh bien vous me croirez ou non, mais pour quelqu’un qui vient de la ville il a fait ça dans l’arrière-cour du café, torse nu, à l’eau froide et que je lave les bras… Et le bazar en même temps. Comme un Américain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a9dcd8d-5c6b-42fe-a93f-e61ba2102f80",
