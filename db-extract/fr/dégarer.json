                                "example_id": "529b9c0b-61b6-4044-995c-ce3c147af3e0",
                                "sense_id": "821267eb-bfef-3f03-80a9-45a9ddc38178",
                                "text": "Le SER envoie automatiquement ses commandes aux éléments suivants : - aux Pilotage Automatiques (PA) des trains des ordres de régulation à savoir des temps de retenues (TR) en station et des Vitesses de Régulation (VR) pour éviter l'effet accordéon, - aux dispositifs de manoeuvres d'aiguillages pour garer ou dégarer les trains, (...)"
                            },
                            {
                                "example_id": "a22fe5e5-62ff-4367-b6e6-2e99b9ccc5c6",
                                "sense_id": "821267eb-bfef-3f03-80a9-45a9ddc38178",
                                "text": "Dégarer une triplette de BB afin d'assurer la continuité du Toulouse Canfranc,"
                            }
                        ]
                    },
                    {
                        "sense_id": "357f5dda-59a5-3422-804f-8caade543b69",
                        "entry_id": "aa3c3537-ed90-3943-9420-96028bb05df2",
                        "glosses": [
                            "Faire quitter son stationnement à un véhicule quelconque"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
