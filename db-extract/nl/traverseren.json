                                        "glosses": [
                                            "Lying across; being in a direction across something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e95afa68-b565-4984-9304-730e976fb370",
                                                "sense_id": "892d1c50-60f5-3d0b-953c-536f3d360315",
                                                "text": "paths cut with traverse trenches"
                                            },
                                            {
                                                "example_id": "5f30cdc5-8d14-40ea-886c-ea486802121a",
                                                "sense_id": "892d1c50-60f5-3d0b-953c-536f3d360315",
                                                "text": "Oak […] being strong in all positions, may be better trusted in cross and traverse work."
                                            },
                                            {
                                                "example_id": "2923d267-92b8-428a-9b3f-4fc23947b8ad",
                                                "sense_id": "892d1c50-60f5-3d0b-953c-536f3d360315",
