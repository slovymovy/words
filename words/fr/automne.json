                    "frequency": "High",
                    "semantic_group_id": "saison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les feuilles des arbres changent de couleur en <w>automne</w>."
                        },
                        {
                            "text": "Nous aimons faire de longues promenades dans la forêt au début de l'<w>automne</w>."
                        }
                    ],
                    "common_phrases": [
