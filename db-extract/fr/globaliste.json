                ],
                "senses": [
                    {
                        "sense_id": "1ab596d1-7c59-353a-a659-a7b2c18a65a0",
                        "entry_id": "3391d7dc-e57a-3742-9aa6-f4605af7aebf",
                        "glosses": [
                            "Relatif au globalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47dcd57f-0f9f-4531-8252-d2abd8649395",
                                "sense_id": "1ab596d1-7c59-353a-a659-a7b2c18a65a0",
                                "text": "La psychologie globaliste ou holistique…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41d903d6-269c-41c9-b92f-b508ec56f2d5",
                        "source_entry_id": "3391d7dc-e57a-3742-9aa6-f4605af7aebf",
                        "source_sense_id": "1ab596d1-7c59-353a-a659-a7b2c18a65a0",
                        "target_lang_word": "globalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "globalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1787163a-af0a-3b5f-abba-b45a4439378d",
                                        "entry_id": "72a9902d-9c80-30b9-a529-725797de4653",
                                        "glosses": [
                                            "Of or pertaining to globalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630e7b5f-13e1-4b49-b0d8-8bd20405136b",
                                                "sense_id": "1787163a-af0a-3b5f-abba-b45a4439378d",
                                                "text": "From a globalist point of view, talk of threats to a local culture or identity can look like bigotry and even racism: what reason could there be for excluding people when we are all part of a welcoming, global culture?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "globalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2f322d-1ed8-3165-ad1c-bdbbbff6aa05",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "An advocate of globalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443ed4e3-b161-4ac8-9652-a5af031f1ee5",
                                                "sense_id": "ff2f322d-1ed8-3165-ad1c-bdbbbff6aa05",
                                                "text": "You are either a globalist or a nationalist; one cannot be both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac10689-276e-3222-8309-dac97137dd35",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "A Jew, implying that Jews are more loyal to a global conspiracy than the country which they live in."
                                        ],
                                        "tags": [
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "633820b4-4140-3ddc-8482-b1336cdd79c6",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "One who believes that Adolf Hitler intended to extend the Third Reich beyond the continent of Europe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed36aad2-638b-3cc3-a501-c6b1aaa39dd9",
                                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                                        "glosses": [
                                            "One who believes international events are primarily caused by conflicts between great powers."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d3f0148-2645-43c6-abfc-bda93f66c06f",
                                                "sense_id": "ed36aad2-638b-3cc3-a501-c6b1aaa39dd9",
                                                "text": "\"Globalists\" tend to view international issues in terms of US-Soviet rivalry, while \"regionalists\" see them more often as manifestations of local rivalries and problems."
                                            },
                                            {
                                                "example_id": "456cdc63-eb79-4ad1-a15f-187d8d7afeed",
                                                "sense_id": "ed36aad2-638b-3cc3-a501-c6b1aaa39dd9",
                                                "text": "The authors suggest that the globalist emphasis among policymakers has increased during the Reagan administration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
