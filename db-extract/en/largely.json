                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cc9069c-ec17-4aae-ade2-90d9a826a1d3",
                                                "sense_id": "baf90bfb-13bf-367b-9f61-98d093f82ac3",
                                                "text": "Le village était jonché de corps. Des corps de femmes pour la plupart, mais aussi d’enfants."
                                            },
                                            {
                                                "example_id": "d43cb3fd-36b8-4ed0-a2e0-bcc965387b82",
                                                "sense_id": "baf90bfb-13bf-367b-9f61-98d093f82ac3",
                                                "text": "Les gens de ce pays-là sont pour la plupart indolents."
                                            },
                                            {
                                                "example_id": "727df3f9-a263-4a82-8584-1987db6402d1",
                                                "sense_id": "baf90bfb-13bf-367b-9f61-98d093f82ac3",
                                                "text": "Mes meubles sont pour la plupart anciens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38068b4d-8a65-3975-9605-b937781801b2",
                                        "entry_id": "0d32a581-3b87-3181-a121-eeff5a2b0926",
                                        "glosses": [
                                            "Il s’emploie quelquefois absolument, sans la préposition « pour »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd629fc-763d-496b-a874-baea5c47c532",
                                                "sense_id": "38068b4d-8a65-3975-9605-b937781801b2",
                                                "text": "Les hommes sont la plupart intéressés."
                                            },
                                            {
