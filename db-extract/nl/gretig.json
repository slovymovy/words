                    {
                        "sense_id": "69c6950b-aaaa-32cc-bbae-b5c76f48f541",
                        "entry_id": "84ed5336-c24f-3741-9b3c-ed617e157499",
                        "glosses": [
                            "reikhalzend uitziend naar iets, gespitst op iets, happig op iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5443b67-c1bd-414a-9e39-9829713a6579",
                                "sense_id": "69c6950b-aaaa-32cc-bbae-b5c76f48f541",
                                "text": "Zijn gretige reactie hierop verbaasde velen."
                            },
                            {
                                "example_id": "24875fb7-a395-4858-91bd-9a3f8e5b3331",
                                "sense_id": "69c6950b-aaaa-32cc-bbae-b5c76f48f541",
                                "text": "Goud- en zilverprijzen, schilderijen als betaalmiddel, de slordigheid van sommige inpakkers die zijn handelswaar vanuit Batavia verschepen - Maren geniet veel meer van haar broers nieuwtjes dan van de haring en trekt de woorden gretig uit zijn mond."
                            }
                        ]
                    }
                ],
