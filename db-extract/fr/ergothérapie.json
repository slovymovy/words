                        "cross_references": []
                    },
                    {
                        "translation_id": "40494a59-dc67-465b-897f-834860483f7f",
                        "source_entry_id": "40a47b96-78c3-3552-a89f-2f604ca9cf49",
                        "source_sense_id": "8e050e34-4cd7-3827-8981-f0189fe6bd8b",
