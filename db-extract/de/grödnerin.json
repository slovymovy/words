                "senses": [
                    {
                        "sense_id": "97de9c84-88f7-364d-9cb1-851e26695d57",
                        "entry_id": "fc8db830-4265-3bc4-910c-b68a468f9378",
                        "glosses": [
                            "weibliche Person, die in Gröden (Südtirol) lebt oder aus Gröden stammt"
                        ],
                        "tags": [
                            "Personenbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "2532186c-a346-4436-b5af-dcfb150fa640",
                                "sense_id": "97de9c84-88f7-364d-9cb1-851e26695d57",
                                "text": "„‚Sie ist eine Grödnerin‘ hört man oft von Stadt- und Landleuten mit einem Ausdruck sagen, als enthalte dieses Wort alles, was sich von Treue, Ehrenhaftigkeit und löblichem Wesen einer Hausfrau berichten läßt.“"
                            },
                            {
                                "example_id": "9e0b7d32-08ee-4d24-9f0c-43c927bf7a18",
                                "sense_id": "97de9c84-88f7-364d-9cb1-851e26695d57",
                                "text": "„Ganz Gröden freut sich riesig über die kürzlich gewonnene Bronze-Medaille der Grödnerin Nadia Delago, in der Königsdisziplin \"Abfahrt\", bei den Olympischen Winterspielen in Beijing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
