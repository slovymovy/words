                        "examples": [
                            {
                                "example_id": "13804dd4-39ec-4f71-b606-2cce64bcad61",
                                "sense_id": "e6d20909-ff53-3cb8-a19c-d2c4c7b79358",
                                "text": "Die Stadt Anklam liegt an der Peene."
                            },
                            {
                                "example_id": "6b5f46d7-f766-4c43-a379-473c04aa5d0a",
                                "sense_id": "e6d20909-ff53-3cb8-a19c-d2c4c7b79358",
                                "text": "Der Flugpionier Otto Lilienthal wurden in Anklam geboren."
                            },
                            {
                                "example_id": "7055c61f-929d-4a55-b9b2-a39f2ec6ad64",
                                "sense_id": "e6d20909-ff53-3cb8-a19c-d2c4c7b79358",
                                "text": "Ich bin in Anklam geboren."
                            },
                            {
                                "example_id": "b78e5f9c-42ce-4e6c-813c-aa370337ce45",
                                "sense_id": "e6d20909-ff53-3cb8-a19c-d2c4c7b79358",
                                "text": "Ich habe in Anklam meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "f4325f01-e097-414e-b7e1-3d1e901e6824",
                                "sense_id": "e6d20909-ff53-3cb8-a19c-d2c4c7b79358",
                                "text": "Nach Anklam führen viele Wege."
                            }
                        ],
