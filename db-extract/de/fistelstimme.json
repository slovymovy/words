                "senses": [
                    {
                        "sense_id": "aba4787e-4e55-3186-b75a-14ac11212064",
                        "entry_id": "c55ef0d3-3ed3-3401-b15c-b86dea016644",
                        "glosses": [
                            "hohe Männerstimmlage ohne Brustresonanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fff3c97-ea78-4987-8942-a5d996d1d1fa",
                                "sense_id": "aba4787e-4e55-3186-b75a-14ac11212064",
                                "text": "„Trotz der Fistelstimme wirkte er keinen Zentimeter kleiner.“"
                            },
                            {
                                "example_id": "d8dba5d8-763d-4c6e-a794-03859be76380",
                                "sense_id": "aba4787e-4e55-3186-b75a-14ac11212064",
                                "text": "„Er mochte die Fistelstimme nicht.“"
                            },
                            {
                                "example_id": "8b2b0674-77c9-42eb-8351-43e0709a2096",
                                "sense_id": "aba4787e-4e55-3186-b75a-14ac11212064",
                                "text": "„Zwei oder drei Stunden später fiel mir eine junge Frau im Domino auf, die von mehreren Maskierten umgeben war und mit Fistelstimme pariserisch wie auf dem Opernball sprach.“"
                            }
                        ],
