                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calculation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2498731-c7d5-38ff-8258-9861b6ef5696",
                                        "entry_id": "f24cdf28-6011-3810-872a-cc919677f8a2",
                                        "glosses": [
                                            "The act or process of calculating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b00326ab-ab63-3fb9-8338-63f46da34b91",
                                        "entry_id": "f24cdf28-6011-3810-872a-cc919677f8a2",
                                        "glosses": [
                                            "The result of calculating."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564b1db0-1264-4b29-9e46-598cbb2d15fd",
                                                "sense_id": "b00326ab-ab63-3fb9-8338-63f46da34b91",
                                                "text": "As a check on these calculations we note that the total probability for 0, 1, 2, or 3 successes must be one since there are no other possibilities."
                                            },
                                            {
                                                "example_id": "ec934c90-549e-4a5d-9f07-b02333da5cbe",
                                                "sense_id": "b00326ab-ab63-3fb9-8338-63f46da34b91",
                                                "text": "Some of the most beautiful and thus appealing physical theories, including quantum electrodynamics and quantum gravity, have been dogged for decades by infinities that erupt when theorists try to prod their calculations into new domains. Getting rid of these nagging infinities has probably occupied far more effort than was spent in originating the theories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b084e45a-ed25-3560-82b8-ea9245a0a9d0",
                                        "entry_id": "f24cdf28-6011-3810-872a-cc919677f8a2",
                                        "glosses": [
                                            "Reckoning, estimate."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea7f7abf-639a-4401-874a-1db2b61812c4",
                                                "sense_id": "b084e45a-ed25-3560-82b8-ea9245a0a9d0",
                                                "text": "By my calculation, we should be there by midnight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df418771-1119-3eeb-b188-74145f6ac712",
                                        "entry_id": "f24cdf28-6011-3810-872a-cc919677f8a2",
                                        "glosses": [
                                            "An expectation based on circumstances."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e698b06-e470-3009-b843-3e2620a95121",
                                        "entry_id": "f24cdf28-6011-3810-872a-cc919677f8a2",
                                        "glosses": [
                                            "The act or process of imagining sequences of potential moves and responses without actually moving the pieces."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76476cad-01a6-4d09-ab5e-2a3ee11550ac",
                        "source_entry_id": "ed486826-2047-37fe-aee9-07732f305d9f",
                        "source_sense_id": "8b520b67-f282-3b57-8cde-94378c5ac6ad",
                        "source_sense_description": "berekening",
                        "target_lang_word": "calcul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calcul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed05a259-f2dd-3283-ab30-0ecdf9599878",
                                        "entry_id": "31a14d61-957e-3350-9a43-44acc7e3625e",
                                        "glosses": [
                                            "Opération, ensemble d'opérations que l’on effectue sur des nombres ou des grandeurs mathématiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6f4acca-08e5-47fc-adf2-129e8476fce1",
                                                "sense_id": "ed05a259-f2dd-3283-ab30-0ecdf9599878",
                                                "text": "Un reporter qui ne précise pas, c’est un géomètre qui néglige de pousser ses calculs jusqu’à la dixième décimale."
                                            },
                                            {
                                                "example_id": "290c8b34-3eb8-4bcd-aca3-a318067abaf9",
                                                "sense_id": "ed05a259-f2dd-3283-ab30-0ecdf9599878",
                                                "text": "Douce soirée où l’on pouvait encore croire — à la rigueur, le calcul des probabilités cédant à une chance inouïe — qu’il n’y aurait pas de morts pendant la guerre."
                                            },
                                            {
                                                "example_id": "389c6c5f-399d-47c1-8094-d48652bb0f88",
                                                "sense_id": "ed05a259-f2dd-3283-ab30-0ecdf9599878",
                                                "text": "Il n'y a pas lieu de rechercher en ce cas, des procédés de calcul spéciaux pour l'application de ces formules si simples."
                                            },
                                            {
                                                "example_id": "e3b1fd60-a485-48f2-a65f-a12d96bf51a7",
                                                "sense_id": "ed05a259-f2dd-3283-ab30-0ecdf9599878",
                                                "text": "Mais alors il devenait inutile de calculer l’hendécagone. Et ce n'est pas là un polygone d’un calcul aisé comme le triangle et le carré dont Ptolémée a fait mention en hors-d’œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fd660c-1a4b-35c2-8596-d0eecab682b7",
                                        "entry_id": "31a14d61-957e-3350-9a43-44acc7e3625e",
                                        "glosses": [
                                            "Estimation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5604073f-44ff-4caa-bea2-5be6416b10d0",
                                                "sense_id": "89fd660c-1a4b-35c2-8596-d0eecab682b7",
                                                "text": "C'est l’annaliste L. Calpurnius Pison (suivi par Denys) qui, à la suite de calculs chronologiques, faisait de Tarquin l’Ancien l’aïeul de Lucius."
                                            },
                                            {
                                                "example_id": "5ef3a3a0-ef73-4c09-b57e-c177865b85b2",
                                                "sense_id": "89fd660c-1a4b-35c2-8596-d0eecab682b7",
                                                "text": "Le capotier de Lyon, vendeur ambulant, a fait quelques calculs à partir du nombre de préservatifs qu’il écoule chaque année auprès des prostituées. Il avance le chiffre invérifiable d’un million de passes par an sur la région lyonnaise."
                                            },
                                            {
                                                "example_id": "fa499831-2d11-45dd-8862-bce2ba91a14a",
                                                "sense_id": "89fd660c-1a4b-35c2-8596-d0eecab682b7",
                                                "text": "D’après mes calculs, il doit être arrivé à destination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "682e021c-760c-32da-ade1-61b54c6c9f67",
                                        "entry_id": "31a14d61-957e-3350-9a43-44acc7e3625e",
                                        "glosses": [
                                            "Arithmétique."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6832dd57-bd9c-4201-b2fe-8ee7cd116c9d",
                                                "sense_id": "682e021c-760c-32da-ade1-61b54c6c9f67",
                                                "text": "À l’école, on lui avait enseigné, avec le calcul, les éléments du dessin, et il en savait assez pour se débrouiller en géométrie."
                                            },
                                            {
                                                "example_id": "6d0f0434-4794-4223-8386-2f083e1f9208",
                                                "sense_id": "682e021c-760c-32da-ade1-61b54c6c9f67",
                                                "text": "La journée commença par une leçon de calcul, science dont je n’avais pas le goût, mais le respect, car maman y faisait chaque jour des invocations soucieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362fb4dd-1f55-313c-a72f-686f5cf35afb",
                                        "entry_id": "31a14d61-957e-3350-9a43-44acc7e3625e",
                                        "glosses": [
                                            "Moyens que l’on combine, mesures que l’on prépare pour le succès de quelque affaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24fb1b5d-d306-4f2e-8aa1-c21f1ea7ef95",
                                                "sense_id": "362fb4dd-1f55-313c-a72f-686f5cf35afb",
                                                "text": "Il lui était doux de les avoir auprès de lui, mais il désirait que leur attitude n’offusquât en rien le nouvel esprit qui se manifestait en France, et entendait leur imposer la simplicité qu'il s’imposait à lui-même par goût autant que par calcul."
                                            },
                                            {
                                                "example_id": "94eff91e-ffb1-4dcd-89c1-9923cb351030",
                                                "sense_id": "362fb4dd-1f55-313c-a72f-686f5cf35afb",
                                                "text": "Restait Adélaïde. Pour rien au monde, Pierre ne voulait continuer à demeurer avec elle. Elle le compromettait. C’était par elle qu’il aurait désiré commencer. Mais il se trouvait pris entre deux alternatives fort embarrassantes : la garder, et alors recevoir les éclaboussures de sa honte, s’attacher au pied un boulet qui arrêterait l’élan de son ambition ; la chasser, et à coup sûr se faire montrer au doigt comme un mauvais fils, ce qui aurait dérangé ses calculs de bonhomie."
                                            },
                                            {
                                                "example_id": "2ded5d7a-a198-4a6a-a2c4-a3385107b28a",
                                                "sense_id": "362fb4dd-1f55-313c-a72f-686f5cf35afb",
                                                "text": "Sa froideur a, pour moi, tant d’attraits, qu’elle me brûle et me glace. J’ai beau savoir qu’au fond de ce regard, tout est calcul et complaisance, où qu’il m’entraîne, je le suivrai."
                                            },
                                            {
                                                "example_id": "53e760a4-aeac-40c9-b3e5-ad98d828336b",
                                                "sense_id": "362fb4dd-1f55-313c-a72f-686f5cf35afb",
                                                "text": "Cela n’entre pas dans mes calculs. — Les calculs de l’intérêt, de l’ambition. — Sa finesse a déjoué tous leurs calculs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b82b81f-e46b-3491-995c-595323fb0f48",
                                        "entry_id": "31a14d61-957e-3350-9a43-44acc7e3625e",
                                        "glosses": [
                                            "Cas de lithiase urinaire avec diverses espèces de concrétions pierreuses (pierres) qui se forment dans le corps de l’homme et des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27549d27-f5f1-40fb-9604-18acde7730d0",
                                                "sense_id": "6b82b81f-e46b-3491-995c-595323fb0f48",
                                                "text": "Calculs biliaires et urinaires."
                                            },
                                            {
                                                "example_id": "284e0512-fcba-4679-8634-d19634ad5d1e",
                                                "sense_id": "6b82b81f-e46b-3491-995c-595323fb0f48",
                                                "text": "Autour des gens debout, un cordon de fantassins, l’arme au pied.\nDerrière les fantassins, la foule amorphe.\nAu plus obscur de la foule amorphe, Bénin, Broudier, Huchon, Omer, comme un calcul dans un rognon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
