                "senses": [
                    {
                        "sense_id": "5a5378db-ccaf-3d10-8613-9e59b2652890",
                        "entry_id": "4f64c74c-3b7e-3af4-8654-ab2bfb6fda58",
                        "glosses": [
                            "to behave in the French manner; to speak French"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "917eb0cd-d4e8-475a-915d-df5381d1118f",
                                "sense_id": "5a5378db-ccaf-3d10-8613-9e59b2652890",
                                "text": "«Эге́, — ду́маю, — опя́ть показа́лся, да ещё и францу́зить на́чал... Ну, я лу́чше кого́-нибудь подожду́, оди́н по ле́стнице не пойду́».",
                                "translation": "“Aha,” I think, “he’s shown up again, and what’s more he’s speaking French … Well, I’d better wait for somebody, I won’t go downstairs alone.”",
                                "english": "“Aha,” I think, “he’s shown up again, and what’s more he’s speaking French … Well, I’d better wait for somebody, I won’t go downstairs alone.”"
                            }
                        ]
                    }
