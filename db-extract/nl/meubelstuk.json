                                            {
                                                "example_id": "135f9293-5ecb-466a-b430-6db274d2b058",
                                                "sense_id": "26e80f42-3621-3cac-8baf-99932c8f7b4b",
                                                "text": "Wir brauchen mal wieder neue Möbel."
                                            },
                                            {
                                                "example_id": "5a657bd3-7731-4312-a949-a5dc5d03af33",
                                                "sense_id": "26e80f42-3621-3cac-8baf-99932c8f7b4b",
                                                "text": "„Die Möbel waren modern, bis auf einen kleinen Barocktisch, der wie ein Prinz zwischen Sklaven stand.“"
                                            },
                                            {
                                                "example_id": "afa49671-7929-493f-bc3f-743c9dbf5c71",
                                                "sense_id": "26e80f42-3621-3cac-8baf-99932c8f7b4b",
                                                "text": "„Die Büros waren mit Möbeln aus hellem Birkenholz eingerichtet.“"
                                            }
                                        ],
