                                "target_senses": [
                                    {
                                        "sense_id": "d0c88558-25a3-31c9-9b87-ee60ba1dddce",
                                        "entry_id": "d6e1e9ee-2172-374b-90d3-885f7bfb606f",
                                        "glosses": [
                                            "The antiparticle of the proton, having a negative electric charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f25d0a-f828-44ca-9ec4-e8352fe69b55",
                                                "sense_id": "d0c88558-25a3-31c9-9b87-ee60ba1dddce",
                                                "text": "There were also particles no one had predicted that just appeared. Five of them […, i]n order of increasing modernity, […] are the neutrino, the pi meson, the antiproton, the quark and the Higgs boson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13a94f52-ba6a-4f00-b740-d5dc0832681d",
                        "source_entry_id": "6ac07c0b-70fc-3247-8611-1d32c76139e3",
                        "source_sense_id": "0f72880f-56af-3318-ab52-8beb45240064",
                        "target_lang_word": "antiproton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiproton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f77626-b950-37d1-b309-54028db95df4",
                                        "entry_id": "18727991-d42e-36f2-8fd7-7287a7e0019a",
                                        "glosses": [
                                            "Antiparticule du proton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f24fa976-e914-447a-8a74-842597bc60c5",
                                                "sense_id": "e9f77626-b950-37d1-b309-54028db95df4",
                                                "text": "Une réaction particulièrement importante d’un point de vue fondamental a consisté à produire un antiproton."
                                            },
                                            {
                                                "example_id": "91c7b01a-30e3-462f-ab89-f5963a78d35a",
                                                "sense_id": "e9f77626-b950-37d1-b309-54028db95df4",
                                                "text": "Dans un tube métallique où régnait un vide lunaire circulaient en sens inverse et à des vitesses folles deux faisceaux de particules, l’un de protons, l’autre d’antiprotons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
