                ],
                "senses": [
                    {
                        "sense_id": "70eb729a-5b48-33fe-83fa-7caac8a414ad",
                        "entry_id": "106e60a6-1b6e-3f7d-b0d9-cc2a58bb4436",
                        "glosses": [
                            "Kunstform, bei der Massenmedien einbezogen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a481551-52c8-4047-8a9d-68bc8fdab12f",
                                "sense_id": "70eb729a-5b48-33fe-83fa-7caac8a414ad",
                                "text": "„In ihren Arbeiten der Werkgruppe ‚Erweitertes Kino‘ wurde die Filmwirklichkeit in die reale Welt erweitert: Sie beschritten konzeptuelles Neuland und gelten heute als Pionierarbeiten der Medienkunst.“"
                            },
                            {
                                "example_id": "4be0e2a0-c94d-4b97-abed-4a9bf37ccb83",
                                "sense_id": "70eb729a-5b48-33fe-83fa-7caac8a414ad",
                                "text": "„Dass die Bilder ihrer jüngsten Serie auch noch bunte Karikaturen sind, macht die Reflektion über Medienkunst und Malerei als Tauschobjekt nur noch um so amüsanter.“"
                            },
                            {
                                "example_id": "d22354f3-3b7a-4e9c-80d4-c3967c1bda7c",
                                "sense_id": "70eb729a-5b48-33fe-83fa-7caac8a414ad",
                                "text": "„Die Spezialistin für Medienkunst genießt in der bayerischen Landeshauptstadt über die Parteigrenzen hinweg hohes Ansehen.“"
                            },
                            {
                                "example_id": "017e9063-787d-4333-a408-06ab4a448caa",
                                "sense_id": "70eb729a-5b48-33fe-83fa-7caac8a414ad",
                                "text": "„Die Netzkunst steht vor den Toren der Kunsttempel, die sich wahrscheinlich erst dann öffnen werden, wenn auch diese Kunstform technologisch überholt ist und der Hype der Medienkunst sich wieder auf ein anderes Terrain verlagert hat.“"
                            },
                            {
                                "example_id": "1cb9282a-9033-4595-ace1-5749305fa39f",
                                "sense_id": "70eb729a-5b48-33fe-83fa-7caac8a414ad",
                                "text": "„In den letzten 15 Jahren seines Lebens war die Medienkunst sein Schaffensschwerpunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
