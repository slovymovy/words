                "senses": [
                    {
                        "sense_id": "7a6106c0-4e34-3673-89c5-4984290ed081",
                        "entry_id": "193f402f-74fa-330e-83de-aa1162584dce",
                        "glosses": [
                            "устар., высок. прич. от мястись; испытывающий постоянное сильное беспокойство, не находящий себе покоя"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "bf77703b-5822-46c1-a3d6-e0a7e8e233ba",
                                "sense_id": "7a6106c0-4e34-3673-89c5-4984290ed081",
                                "text": "Есть святыня, есть сила на дне мятущейся души."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0ba7951-b688-4126-b9e6-08aae16229b2",
                        "source_entry_id": "193f402f-74fa-330e-83de-aa1162584dce",
                        "source_sense_id": "7a6106c0-4e34-3673-89c5-4984290ed081",
                        "target_lang_word": "restless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "496cd451-f0a7-3593-9d3f-c82038cc9fb0",
                                        "entry_id": "fb85a748-9eb1-3131-ba30-b0cc3c6adfee",
                                        "glosses": [
                                            "Not allowing or affording rest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e372e332-9623-46e0-914f-dd947ebfaf7d",
                                                "sense_id": "496cd451-f0a7-3593-9d3f-c82038cc9fb0",
                                                "text": "The night before his wedding was a restless one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7483e5b0-6ce6-3020-8212-1e677bccee88",
                                        "entry_id": "fb85a748-9eb1-3131-ba30-b0cc3c6adfee",
                                        "glosses": [
                                            "Without rest; unable to be still or quiet; uneasy; continually moving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efd1b557-d024-4ae4-99dc-0a7b2faafd44",
                                                "sense_id": "7483e5b0-6ce6-3020-8212-1e677bccee88",
                                                "text": "He was a restless child."
                                            },
                                            {
                                                "example_id": "c2e39ee1-143b-4bbe-ba37-1d9723629bbc",
                                                "sense_id": "7483e5b0-6ce6-3020-8212-1e677bccee88",
                                                "text": "She sat, restless and nervous, and tried to concentrate."
                                            },
                                            {
                                                "example_id": "183058ff-e99c-4c91-bae8-a2dfba6f2780",
                                                "sense_id": "7483e5b0-6ce6-3020-8212-1e677bccee88",
                                                "text": "If that is the case, she recommends getting up, walking around the house and doing some stretches to ease the restless feeling before trying again to get to sleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65ff9920-b4a9-3a5c-808d-797a13f60b0b",
                                        "entry_id": "fb85a748-9eb1-3131-ba30-b0cc3c6adfee",
                                        "glosses": [
                                            "Not satisfied to be at rest or in peace; averse to repose; eager for change; discontented."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46fd35d-4c43-4d4e-a033-a882105a8256",
                                                "sense_id": "65ff9920-b4a9-3a5c-808d-797a13f60b0b",
                                                "text": "A restless ambition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27849222-274e-3d60-b556-602d4688da07",
                                        "entry_id": "fb85a748-9eb1-3131-ba30-b0cc3c6adfee",
                                        "glosses": [
                                            "Deprived of rest or sleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec51cffc-3eb2-4bcd-83a6-d39675b457c0",
                                                "sense_id": "27849222-274e-3d60-b556-602d4688da07",
                                                "text": "They remained restless, sitting by the window the entire night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
