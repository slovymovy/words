{
    "word_family": [
        "schuwheid",
        "schuwen",
        "mensenschuw",
        "lichtschuw"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a485c07-506d-3a76-8415-b09fa7670666",
                    "sense_definition": "geneigd om mensen te vermijden of te vluchten bij nadering",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De reeën in dit bos zijn erg <w>schuw</w> en rennen snel weg als ze iemand horen.",
                            "target_lang_translations": {
                                "de": "Die Rehe in diesem Wald sind sehr <w>scheu</w> und rennen schnell weg, wenn sie jemanden hören."
                            }
                        },
                        {
                            "text": "Die zwerfkat is bijzonder <w>schuw</w> en laat zich door niemand aaien.",
                            "target_lang_translations": {
                                "de": "Diese streunende Katze ist besonders <w>scheu</w> und lässt sich von niemandem streicheln."
                            }
                        }
                    ],
                    "antonyms": [
                        "tam"
                    ],
                    "common_phrases": [
                        "schuw dier",
                        "schuwe dieren"
                    ],
                    "target_lang_definitions": {
                        "de": "dazu neigend, Menschen zu meiden oder bei Annäherung zu fliehen (insbesondere von Tieren)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "scheu",
                                "target_lang_sense_clarification": "von Tieren, die Menschen meiden"
                            },
                            {
                                "target_lang_word": "schreckhaft",
                                "target_lang_sense_clarification": "leicht aufschreckend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc938e49-41e3-32ce-9d65-8fb52a70bad9",
                    "sense_definition": "verlegen, terughoudend in het contact met andere mensen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe jongetje in de klas keek met een <w>schuwe</w> blik om zich heen.",
                            "target_lang_translations": {
                                "de": "Der neue Junge in der Klasse sah sich mit einem <w>schüchternen</w> Blick um."
                            }
                        },
                        {
                            "text": "Zij is van nature wat <w>schuw</w> op drukke feestjes.",
                            "target_lang_translations": {
                                "de": "Sie ist von Natur aus etwas <w>zurückhaltend</w> auf vollen Partys."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedeesd",
                        "beschroomd",
                        "bleu",
                        "schuchter",
                        "timide",
                        "verlegen"
                    ],
                    "antonyms": [
                        "vrijpostig",
                        "zelfverzekerd"
                    ],
                    "common_phrases": [
                        "schuwe blik",
                        "schuw glimlachen"
                    ],
                    "target_lang_definitions": {
                        "de": "schüchtern, zurückhaltend im Umgang mit anderen Menschen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schüchtern",
                                "target_lang_sense_clarification": "unsicher oder gehemmt im Umgang mit anderen"
                            },
                            {
                                "target_lang_word": "scheu",
                                "target_lang_sense_clarification": "zurückhaltend, menschenscheu"
                            },
                            {
                                "target_lang_word": "zaghaft",
                                "target_lang_sense_clarification": "vorsichtig und zögerlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27528dc3-a8d0-38f9-889a-932b9a1bf2c0",
                    "sense_definition": "afkerig van of geneigd om bepaalde dingen te vermijden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze politicus is allerminst <w>schuw</w> voor een stevig inhoudelijk debat.",
                            "target_lang_translations": {
                                "de": "Dieser Politiker ist keineswegs <w>abgeneigt</w>, eine harte inhaltliche Debatte zu führen."
                            }
                        },
                        {
                            "text": "Hij toonde zich niet <w>schuw</w> om harde maatregelen te nemen.",
                            "target_lang_translations": {
                                "de": "Er <w>scheute sich</w> nicht davor, harte Maßnahmen zu ergreifen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schuw voor"
                    ],
                    "target_lang_definitions": {
                        "de": "etwas abgeneigt sein oder dazu neigen, bestimmte Dinge zu meiden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abgeneigt",
                                "target_lang_sense_clarification": "nicht bereit oder zögernd"
                            },
                            {
                                "target_lang_word": "scheuen",
                                "target_lang_sense_clarification": "als Adjektiv bzw. Verbkonstruktion 'nicht scheuen'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "099fdc31-fdca-386f-b219-316f10e5ab0a",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>schuwen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoord_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schuw</w> geen enkele uitdaging in mijn nieuwe baan.",
                            "target_lang_translations": {
                                "de": "Ich <w>scheue</w> keine einzige Herausforderung in meiner neuen Stelle."
                            }
                        },
                        {
                            "text": "In dit moeilijke dossier <w>schuw</w> ik de confrontatie met het bestuur niet.",
                            "target_lang_translations": {
                                "de": "In dieser schwierigen Angelegenheit <w>scheue</w> ich die Konfrontation mit dem Vorstand nicht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geen moeite schuwen"
                    ],
                    "target_lang_definitions": {
                        "de": "erste Person Singular Präsens von 'schuwen' (scheuen, meiden)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "scheue",
                                "target_lang_sense_clarification": "1. Person Singular von scheuen"
                            },
                            {
                                "target_lang_word": "meide",
                                "target_lang_sense_clarification": "1. Person Singular von meiden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e7360d9-d732-37fc-b26a-72d04c5e82cf",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd inversie van <w>schuwen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoord_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schuw</w> je het risico om nu zelfstandig ondernemer te worden?",
                            "target_lang_translations": {
                                "de": "<w>Scheust</w> du das Risiko, dich jetzt selbstständig zu machen?"
                            }
                        },
                        {
                            "text": "Waarom <w>schuw</w> je het gesprek over deze lastige kwestie?",
                            "target_lang_translations": {
                                "de": "Warum <w>meidest</w> du das Gespräch über dieses heikle Thema?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "zweite Person Singular Präsens (Inversion) von 'schuwen' (scheuen, meiden)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "scheust",
                                "target_lang_sense_clarification": "2. Person Singular von scheuen"
                            },
                            {
                                "target_lang_word": "meidest",
                                "target_lang_sense_clarification": "2. Person Singular von meiden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a6b9631-54ea-3ad2-94ba-ae154b6d26be",
                    "sense_definition": "gebiedende wijs van <w>schuwen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoord_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schuw</w> het slechte gezelschap en kies je vrienden met verstand.",
                            "target_lang_translations": {
                                "de": "<w>Meide</w> schlechte Gesellschaft und wähle deine Freunde mit Bedacht."
                            }
                        },
                        {
                            "text": "<w>Schuw</w> de waarheid niet, ook al is die soms pijnlijk om te horen.",
                            "target_lang_translations": {
                                "de": "<w>Scheue</w> die Wahrheit nicht, auch wenn sie manchmal schmerzhaft zu hören ist."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Imperativ Singular von 'schuwen' (scheuen, meiden)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "scheue",
                                "target_lang_sense_clarification": "Befehlsform von scheuen"
                            },
                            {
                                "target_lang_word": "meide",
                                "target_lang_sense_clarification": "Befehlsform von meiden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}