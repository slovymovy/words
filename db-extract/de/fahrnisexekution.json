                ],
                "senses": [
                    {
                        "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                        "entry_id": "9a5c2c07-d070-3dd2-b0bd-a9f9cbf6258c",
                        "glosses": [
                            "Pfändung beweglicher Güter"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "80af9c51-0492-4c54-a033-5e7772a380dd",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Bedenklich erscheint neben der weiterhin hohen Zahl an Fahrnisexekutionen (1130) vor allem der Anstieg bei den Lohnpfändungen auf 372 pro Jahr.“"
                            },
                            {
                                "example_id": "2c33b207-4cb5-40a7-8b02-eaac558040b0",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Der Gerichtsvollzieher soll nun im Rahmen einer Fahrnisexekution den „Kuckuck“ auf Computer und Schreibtische des Landesgerichts Ried kleben, auch eine Pfändung der Gerichtskassa ist laut Anwalt vorgesehen.“"
                            },
                            {
                                "example_id": "9c580f18-2f0b-4081-a69c-8bd6318cba87",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Bereits unter Justizminister Nikolaus Michalek wurde 1995 die Fahrnisexekution novelliert.“"
                            },
                            {
                                "example_id": "19b75233-010c-424f-8a5a-0303fd3ca5c3",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Die offensichtlich rechtlich nicht schlecht beratene Würstelstand-Betreiberin konterte, dass eine so genannte Fahrnisexekution erst sechs Monate nach Ablauf des letzten erfolglosen Exekutionsversuches zulässig sei.“"
                            },
                            {
                                "example_id": "824c32cf-e2d9-41dd-a45a-ef3e420fc566",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Der ‚Einführungserlass des Bundesministeriums für Justiz zur Reform der Fahrnisexekution‘ vom 05.12.03 ist ein interner Behördenakt organisationsrechtlicher Art und keine generelle Norm; dieser ‚Erlass‘ stellt somit auch keine der Prüfung nach Art. 139 B-VG unterliegende Verordnung dar.“"
                            },
                            {
                                "example_id": "d656de6d-803b-4e49-9289-b5bbb4b21dfb",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Wenige Wochen nachdem eine 43-jährige Wienerin ihre Stelle als Gerichtsvollzieherin angetreten hatte, begann sie, Geldbeträge abzuzweigen, die sie im Zuge von Fahrnisexekutionen oder Vollstreckungen kassiert hatte.“"
                            },
                            {
                                "example_id": "c2f1b8a5-d793-4a9b-8b6b-4c0c0d00f8b7",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Mit 1. März ist die Exekutionsordnungs-Novelle 2008 (EO-Nov) großteils in Kraft getreten. Neben verfahrensrechtlichen Verbesserungen bei Liegenschaftsexekutionen, bringt sie vor allem Neuerungen bei der Fahrnisexekution.“"
                            },
                            {
                                "example_id": "8d0cb933-cff7-4aaa-b63a-3edd4d58de14",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Dazu kamen im Vorjahr 930.787 Fahrnisexekutionen, 4231 pro Tag.“"
                            },
                            {
                                "example_id": "6c6b3698-d71b-43a4-a97a-f88c93003593",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Bonetti kritisiert hier vor allem Fahrnisexekutionen, in deren Rahmen z. B. ‚die Versteigerung eines alten Fernsehers weniger bringt, als das ganze Prozedere kostet‘.“"
                            },
                            {
                                "example_id": "4e7f339c-2848-4ed9-967f-8ff5528f38be",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Bei der Pfändung von Gegenständen („Fahrnisexekution“) wird das bewegliche Vermögen, das nicht zur einfachen Lebensführung benötigt wird, gepfändet und verwertet.“"
                            },
                            {
                                "example_id": "73b3b1a3-24da-4b3d-8261-620b0fe12991",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Bei einer Fahrnisexekution beauftragt das Gericht einen Gerichtsvollzieher um Zahlungen zu kassieren.“"
                            },
                            {
                                "example_id": "705773a7-d640-472e-b80a-75f636527ec0",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Im Vorjahr wurden vor Gericht auch 818.607 sogenannte Fahrnisexekutionen beantragt.“"
                            },
                            {
                                "example_id": "778bd537-a725-45d1-b249-2cd319ca6c9e",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Ist eine Fahrnisexekution beantragt worden, dann beauftragt das Gericht den Gerichtsvollzieher mit der Betreibung der Forderung.“"
                            },
                            {
                                "example_id": "1dccedf1-4a73-4bdf-878d-ae0812888170",
                                "sense_id": "e52afd06-94ae-35bd-9ed7-4a4096e3e6da",
                                "text": "„Für alle in einem Verfahren und bei der Fahrnisexekution auch für alle nach einem Vollzugsauftrag auf Grund eines Antrags auf neuerlichen Vollzug oder auf neuerliche Versteigerung vorgenommenen Handlungen richtet sich die Vergütung nach dem höchsten vorgesehenen Betrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
