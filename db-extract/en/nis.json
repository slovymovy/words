                    {
                        "sense_id": "1ed2c223-1481-3846-a164-a008abeb761d",
                        "entry_id": "5146a7c4-7540-3f2d-a038-837de5caf452",
                        "glosses": [
                            "A nix; a hobgoblin, especially one that resides in a farm house."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac0e833-959a-4c9c-9e60-f74bd184c1e6",
                                "sense_id": "1ed2c223-1481-3846-a164-a008abeb761d",
                                "text": "No farm-house goes on well without there is a Nis in it, and well is it for the maids and the men when they are in favour with him."
                            },
                            {
                                "example_id": "430b48f4-a37f-41bd-95df-a3c5589952ec",
                                "sense_id": "1ed2c223-1481-3846-a164-a008abeb761d",
                                "text": "The people of the Feroes call the Nisses or Brownies Niagruisar, and describe them as little creatures with red caps on their beads, that bring luck to any place where they take up their abode."
                            }
                        ]
                    }
                ],
