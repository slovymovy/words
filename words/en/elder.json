{
    "word_family": [
        "elderly",
        "eldest",
        "eldership"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "447ca576-1919-37d0-8c41-80f1687d04c2",
                    "sense_definition": "One who is older than another; an older person deserving respect.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "age_seniority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many cultures, it is customary to stand when an <w>elder</w> enters the room.",
                            "target_lang_translations": {
                                "ru": "Во многих культурах принято вставать, когда в комнату входит <w>старший</w>.",
                                "zh": "在许多文化中，<w>长者</w>进屋时起立是一种惯例。"
                            }
                        },
                        {
                            "text": "You should listen to your <w>elders</w> because they have more life experience.",
                            "target_lang_translations": {
                                "ru": "Тебе следует слушать <w>старших</w>, потому что у них больше жизненного опыта.",
                                "zh": "你应该听听<w>长辈</w>的话，因为他们的人生经验更丰富。"
                            }
                        }
                    ],
                    "synonyms": [
                        "senior",
                        "old person"
                    ],
                    "common_phrases": [
                        "respect your elders",
                        "listen to your elders"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который старше других; пожилой человек, заслуживающий уважения.",
                        "zh": "比他人年长、值得尊敬的人；长辈或长者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ста́рший",
                                "target_lang_sense_clarification": "человек старшего возраста"
                            },
                            {
                                "target_lang_word": "пожило́й челове́к",
                                "target_lang_sense_clarification": "человек преклонного возраста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长者",
                                "target_lang_sense_clarification": "受尊敬的年长者"
                            },
                            {
                                "target_lang_word": "长辈",
                                "target_lang_sense_clarification": "家中或群体中的年长者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                    "sense_definition": "A senior member of a tribe or community, often respected as an authority figure and advisor.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "age_seniority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village <w>elder</w> was asked to settle the dispute between the two families.",
                            "target_lang_translations": {
                                "ru": "Деревенского <w>старейшину</w> попросили разрешить спор между двумя семьями.",
                                "zh": "村里的<w>长老</w>被请来调解这两家之间的纠纷。"
                            }
                        },
                        {
                            "text": "Tribal <w>elders</w> gathered to discuss the future of the community.",
                            "target_lang_translations": {
                                "ru": "<w>Старейшины</w> племени собрались, чтобы обсудить будущее общины.",
                                "zh": "部落<w>长老</w>聚在一起讨论社群的未来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "senior"
                    ],
                    "common_phrases": [
                        "village elder",
                        "tribal elder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Старший член племени или общины, часто уважаемый как авторитетная фигура и советник.",
                        "zh": "部落或社区中的资深成员，常被尊为权威人物和顾问。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старе́йшина",
                                "target_lang_sense_clarification": "глава рода или общины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长老",
                                "target_lang_sense_clarification": "部落、村落或社区中受尊敬的资深成员"
                            },
                            {
                                "target_lang_word": "族中长老",
                                "target_lang_sense_clarification": "强调族群内部的资深身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e49c610-e8ed-39d1-85c5-a14ba932d15b",
                    "sense_definition": "An officer or official in a church, often having teaching, administrative, or missionary responsibilities.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was ordained as an <w>elder</w> in the local church last Sunday.",
                            "target_lang_translations": {
                                "ru": "В прошлое воскресенье он был рукоположен в <w>старейшины</w> в местной церкви.",
                                "zh": "上周日，他在当地教会被按立为<w>长老</w>。"
                            }
                        },
                        {
                            "text": "The church <w>elder</w> visited the sick members of the congregation.",
                            "target_lang_translations": {
                                "ru": "Церковный <w>старейшина</w> навестил больных членов прихода.",
                                "zh": "教会的<w>长老</w>探望了会众中生病的成员。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "church elder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо в церкви, часто выполняющее учительские, административные или миссионерские обязанности.",
                        "zh": "教会中的职员或负责人，常承担教导、行政或传教职责。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старе́йшина",
                                "target_lang_sense_clarification": "церковный сан"
                            },
                            {
                                "target_lang_word": "пресви́тер",
                                "target_lang_sense_clarification": "священнослужитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长老",
                                "target_lang_sense_clarification": "教会中的职分名称"
                            },
                            {
                                "target_lang_word": "长老职",
                                "target_lang_sense_clarification": "基督教语境中的正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92388f1d-8cad-323b-a6fc-5f7a925b966c",
                    "sense_definition": "A small tree or shrub of the genus Sambucus, having white flowers and dark berries.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We collected flowers from the <w>elder</w> to make a sweet cordial.",
                            "target_lang_translations": {
                                "ru": "Мы собрали цветы <w>бузины</w>, чтобы приготовить сладкий напиток.",
                                "zh": "我们采了<w>接骨木</w>的花来做一种香甜的饮料。"
                            }
                        },
                        {
                            "text": "The <w>elder</w> tree at the bottom of the garden is full of berries this year.",
                            "target_lang_translations": {
                                "ru": "Дерево <w>бузины</w> в конце сада в этом году полно ягод.",
                                "zh": "花园尽头那棵<w>接骨木</w>今年结满了浆果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "black elder"
                    ],
                    "common_phrases": [
                        "elder flower",
                        "elder berry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое дерево или кустарник рода Sambucus с белыми цветами и темными ягодами.",
                        "zh": "接骨木属的一种小乔木或灌木，开白花，结深色浆果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бузина́",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接骨木",
                                "target_lang_sense_clarification": "一种开白花、结深色浆果的植物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a288f54a-dcb4-399c-b2fc-9853b5001c31",
                    "sense_definition": "A cow's udder, especially when used as food.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional dish was made using boiled <w>elder</w>.",
                            "target_lang_translations": {
                                "ru": "Традиционное блюдо было приготовлено из вареного <w>вымени</w>.",
                                "zh": "这道传统菜是用煮过的<w>牛乳房</w>做的。"
                            }
                        },
                        {
                            "text": "He had never eaten <w>elder</w> before and was hesitant to try it.",
                            "target_lang_translations": {
                                "ru": "Он никогда раньше не ел <w>вымя</w> и не решался его попробовать.",
                                "zh": "他以前从未吃过<w>牛乳房</w>，所以不太敢尝试。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коровье вымя, особенно употребляемое в пищу.",
                        "zh": "母牛的乳房，尤指作为食物时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́мя",
                                "target_lang_sense_clarification": "орган животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牛乳房",
                                "target_lang_sense_clarification": "尤指作为食材时"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                    "sense_definition": "The comparative form of <w>old</w>: greater in age or seniority; born earlier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "age_seniority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>elder</w> brother has always looked out for me.",
                            "target_lang_translations": {
                                "ru": "Мой <w>старший</w> брат всегда присматривал за мной.",
                                "zh": "我那位<w>年长的</w>哥哥一直都很照顾我。"
                            }
                        },
                        {
                            "text": "She is the <w>elder</w> of the two sisters by three years.",
                            "target_lang_translations": {
                                "ru": "Она <w>старшая</w> из двух сестер на три года.",
                                "zh": "她是两姐妹中<w>年长的</w>那个，大三岁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "older"
                    ],
                    "common_phrases": [
                        "elder brother",
                        "elder sister",
                        "elder statesman"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative of old"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень от old: старше по возрасту или положению; родившийся раньше.",
                        "zh": "较老的比较级形式：年龄或资历更高的；出生更早的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ста́рший",
                                "target_lang_sense_clarification": "сравнительная степень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "年长的",
                                "target_lang_sense_clarification": "年龄或资历更大"
                            },
                            {
                                "target_lang_word": "较年长的",
                                "target_lang_sense_clarification": "比较意义更明确"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7e1c5cb7-95d9-3412-9a36-4d3f61dfe8d8",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Elder</w> signed the documents at the bank.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Элдер</w> подписал документы в банке.",
                                "zh": "<w>埃尔德</w>先生在银行签署了文件。"
                            }
                        },
                        {
                            "text": "We are going to visit the <w>Elder</w> family this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы собираемся навестить семью <w>Элдер</w> в эти выходные.",
                                "zh": "我们这个周末要去拜访<w>埃尔德</w>一家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Э́лдер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "埃尔德",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ddcd2e85-68e3-3d5b-a2c7-9b154bacf584",
                    "sense_definition": "To admonish or reprove for improper conduct, specifically within a Quaker meeting context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>eldered</w> for speaking out of turn during the worship.",
                            "target_lang_translations": {
                                "ru": "Его <w>отчитали</w> за то, что он заговорил не в свою очередь во время богослужения.",
                                "zh": "他因在礼拜时擅自发言而被<w>训诫</w>了。"
                            }
                        },
                        {
                            "text": "The committee decided to <w>elder</w> the member regarding his recent behavior.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>наставить</w> члена общины относительно его недавнего поведения.",
                                "zh": "委员会决定就他最近的行为<w>训诫</w>那位成员。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Quaker terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать наставление или выговор за неподобающее поведение, особенно в контексте собрания квакеров.",
                        "zh": "因行为不当而加以劝诫或申斥，尤指在贵格会聚会语境中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наставля́ть",
                                "target_lang_sense_clarification": "поучать"
                            },
                            {
                                "target_lang_word": "отчи́тывать",
                                "target_lang_sense_clarification": "делать выговор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "训诫",
                                "target_lang_sense_clarification": "正式地加以劝诫或规劝"
                            },
                            {
                                "target_lang_word": "责诫",
                                "target_lang_sense_clarification": "因行为不当而加以责备"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}