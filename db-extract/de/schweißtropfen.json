                ],
                "senses": [
                    {
                        "sense_id": "8fc6ea77-8c93-394b-a99a-8878074cccc5",
                        "entry_id": "6aebdc54-9758-3e74-a453-976fd5e32683",
                        "glosses": [
                            "Tropfen von Schweiß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17740e31-84f9-4c6a-b9d8-96552ec3494b",
                                "sense_id": "8fc6ea77-8c93-394b-a99a-8878074cccc5",
                                "text": "„Ein Ring kleiner Schweißtropfen umkränzte seinen kahlen Schädel.“"
                            },
                            {
                                "example_id": "d22cc02c-3170-43d7-8ca7-b0c8ee9759be",
                                "sense_id": "8fc6ea77-8c93-394b-a99a-8878074cccc5",
                                "text": "„Fanny hob den Blick, nahm die Brille ab und schaute Helena prüfend an, während ihr ein Schweißtropfen von der Oberlippe lief.“"
                            },
                            {
                                "example_id": "ebccd618-e6a0-40cc-a35d-ddb551c9923a",
                                "sense_id": "8fc6ea77-8c93-394b-a99a-8878074cccc5",
                                "text": "„In seinem Kinnbart hängen Schweißtropfen.“"
                            },
                            {
                                "example_id": "8957bb0f-bde5-4c7b-a699-5e352fd8a349",
                                "sense_id": "8fc6ea77-8c93-394b-a99a-8878074cccc5",
                                "text": "„Auf seiner faltigen Stirn bildeten sich Schweißtropfen, die er mit einem seidenen Tuch abwischte.“"
                            },
                            {
                                "example_id": "1aa3266b-401f-4767-bfda-11c2bfb2a0d3",
                                "sense_id": "8fc6ea77-8c93-394b-a99a-8878074cccc5",
                                "text": "„Seine dicke Zunge fuhr über die Lippen und leckte einen Schweißtropfen aus dem Mundwinkel ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
