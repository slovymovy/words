                "word": "comminution",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2fcea3ab-58b7-4827-ac7b-12b7f107482a",
                        "entry_id": "6cfea6b0-6fec-34cb-8e9d-440f7c02d717",
