                        "translation_id": "3be6527c-b219-4a9a-8f42-f7464e33e084",
                        "source_entry_id": "c253f4b1-43da-3003-b2e3-91d51f476d2f",
                        "source_sense_id": "83753b13-3f1d-37cf-b3af-3b2d089a9c0f",
                        "target_lang_word": "naturalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naturalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4acccb-89e9-3f06-86ab-62340001564d",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "A natural philosopher; a scientist."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20930853-6da9-47e1-811d-19d044b77144",
                                                "sense_id": "dc4acccb-89e9-3f06-86ab-62340001564d",
                                                "text": "It has also been asserted, by some naturalists, that men do not attain their full growth and strength till thirty; but that women arrive at maturity by twenty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619d5a92-42d9-34cc-8ba2-4094716a172d",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "A person who believes in or advocates the tenets of philosophical or methodological naturalism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "accede3c-58a7-383c-a11a-8bdd34ce480a",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "An expert in natural history or the study of plants and animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a0402e-9fbe-472e-a4fe-6f9ddb78568c",
                                                "sense_id": "accede3c-58a7-383c-a11a-8bdd34ce480a",
                                                "text": "I will leave off all my childish fooleries and diversions, and set about studying with such a rage, that when you come back next year, you may find the tongue I have now in my mouth more forky than that of some serpents mentioned by Pliny the naturalist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b06c82d9-2dac-36cd-a9a2-5fbafb3590e9",
                                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                                        "glosses": [
                                            "A creative artist who attempts to faithfully represent nature; an adherent of artistic naturalism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "naturalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                        "entry_id": "77ce6525-138f-39de-87c9-cfc1207ca96e",
                                        "glosses": [
                                            "Synonym of naturalistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a1a24f-2dfc-4812-afe4-d81617f629e3",
                                                "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                                "text": "Trinity received “Birds of America” in 1900 as a gift from Dr. Gordon Russell, a physician and alumnus who was a collector of ornithological and naturalist art."
                                            },
                                            {
                                                "example_id": "5943a702-bf4b-428b-b9a9-48a4d8d666d1",
                                                "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                                "text": "Its author – Henry Handel Richardson was the nom de plume of Ethel Florence Lindesay Richardson – had indeed read, and on occasion translated, these great European writers and they provided the naturalist style and intellectual inquiry resonant in all her fiction. […] The honesty and authorial detachment that is so remarkable in her work – she is one of the least obtrusive, least judgmental of all the great naturalist writers – seems to come from a distance, almost as though the particularly acute insight of the adult writer could only be seen through the filter of childhood experience."
                                            },
                                            {
                                                "example_id": "0a5d7838-31cb-4bae-96f2-35e0a926de22",
                                                "sense_id": "c625d9d7-96b6-3d88-b688-4f5882d61c12",
                                                "text": "The restaurant feels of-the-moment Los Angeles in its naturalist beauty (plants breathe life into the minimalist space) and its wide-open creativity, though much of Bost’s culinary background is steeped in grand French traditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
