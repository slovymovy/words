                        "examples": [
                            {
                                "example_id": "48f5c4f1-c72c-44c4-954b-931f4a9dfdf6",
                                "sense_id": "ad3102bb-3b3d-3724-bb42-819d7923c9a8",
                                "text": "Bij de koffie zetten we een koffiekannetje voor wie er melk in zijn koffie wil hebben."
                            },
                            {
                                "example_id": "637ff95d-16fa-43d0-a758-659851dffbb6",
                                "sense_id": "ad3102bb-3b3d-3724-bb42-819d7923c9a8",
                                "text": "Doe het matchapoeder in een kop en giet er het gekookte water op. Klop met een bamboetheeklopper tot het schuimt. Schuim de melk zo stijf mogelijk op, zoals je voor een cappuccino doet. Laat de melk na het kloppen ‘inklinken’: beweeg de melkkan snel rond en zet hem met een paar forse klappen op het aanrecht."
                            }
