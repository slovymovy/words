                                "target_lang_sense_clarification": "moral or social standing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04dd8bb9-4397-386f-81e0-945b39daf732",
                    "sense_definition": "een hoge maatschappelijke positie of ambt waaraan veel eer en aanzien verbonden is",
