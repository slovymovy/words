                    {
                        "translation_id": "4ca2b34a-66ab-4721-b211-89bfb292b6d4",
                        "source_entry_id": "f0b7d5dd-70e4-354b-a2e3-628afc6ccea6",
                        "source_sense_id": "067d5395-7a7a-321c-bc29-df5b50e8a314",
                        "source_sense_description": "een beoefenaar van de taalkunde",
                        "target_lang_word": "Linguist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linguist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                        "entry_id": "a7e81d4d-eb57-3212-8dad-4beb7c7d8108",
                                        "glosses": [
                                            "Person, die sich wissenschaftlich mit Sprache befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21630e5b-c31c-40ea-b0d8-9e0dc142c455",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "Die meisten Beiträge im Wiktionary werden nicht von Linguisten, sondern von Laien verfasst."
                                            },
                                            {
                                                "example_id": "65866a4b-a17e-4c33-8b12-c2de02529076",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Keine andere Sprache, haben Linguisten festgestellt, vermittelt im Schnitt mehr Sinn pro Buchstabe als das Finnische.“"
                                            },
                                            {
                                                "example_id": "39785dd7-556f-4b4a-996c-46e2aacc6293",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Linguisten sind darauf angewiesen, viele Vergleichsmöglichkeiten zu haben.“"
                                            },
                                            {
                                                "example_id": "d275de13-ffe4-4226-92df-15df3d09666f",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Alarmiert von Studien, die einen erschreckenden Verfall der Orthografie bei deutschen Schülern offenbaren, warnen Linguisten und Didaktiker, Pädagogen und Hirnforscher: Vor allem Risikokinder, die in einer spracharmen Umgebung oder mit Deutsch als zweiter Sprache aufwachsen, lernen so möglicherweise niemals richtig schreiben.“"
                                            },
                                            {
                                                "example_id": "041f2e25-61ca-4709-a6a6-50f7f38dad30",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Linguistinnen und Linguisten verfügen idealerweise über vielfältige sprachliche Register und Stile, die es ihnen ermöglichen, fachliche Inhalte adressatengerecht zu kommunizieren, und sie wissen, welche Form welchem Adressatenkreis gegenüber angemessen ist.“"
                                            },
                                            {
                                                "example_id": "f8d86db1-98ce-412b-92be-44e107d214ec",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Die Linguisten haben herausgefunden, welche Sprachen miteinander verwandt sind und nach welchen Gesetzmäßigkeiten sich Aussprache und Grammatik im Lauf der Zeit verändert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8af7851-247d-4b97-a916-eae90a6ace12",
                        "source_entry_id": "f0b7d5dd-70e4-354b-a2e3-628afc6ccea6",
                        "source_sense_id": "067d5395-7a7a-321c-bc29-df5b50e8a314",
                        "source_sense_description": "een beoefenaar van de taalkunde",
                        "target_lang_word": "Sprachwissenschaftler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachwissenschaftler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c4ad6e9-b7ba-3f84-b6e8-88dbd70243d0",
                                        "entry_id": "5f3dba1d-ada4-3fbb-a00f-4598656a7898",
                                        "glosses": [
                                            "Person, die sich wissenschaftlich mit Sprache/Sprachen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd6d34cc-b575-4c26-9fa4-421573aeb437",
                                                "sense_id": "5c4ad6e9-b7ba-3f84-b6e8-88dbd70243d0",
                                                "text": "„Der Sprachwissenschaftler hat gegenüber dem Alltagssprecher in einem zweiten Sozialisationsprozeß das Regel-, Normensystem und die Fachsprache eines Forschungsprogramms erworben und verfügt über zwei Reflexionsmöglichkeiten von Sprechhandlungen.“"
                                            },
                                            {
                                                "example_id": "f2456ff9-d936-4bca-a0bc-c67c6ac244f7",
                                                "sense_id": "5c4ad6e9-b7ba-3f84-b6e8-88dbd70243d0",
                                                "text": "„Vielmehr geht es um die Tatsache, daß Mitarbeiter eines Lehrstuhls für deutsche Philologie der TH Aachen, also Sprachwissenschaftler, diese Auskunftsstelle für sprachliche Probleme betreiben.“"
                                            },
                                            {
                                                "example_id": "85efa00c-6899-4596-bccf-b45675573c66",
                                                "sense_id": "5c4ad6e9-b7ba-3f84-b6e8-88dbd70243d0",
                                                "text": "„Unter dem Motto »Text: Strukturen und Verarbeitung« treffen sich auf der größten linguistischen Konferenz im deutschsprachigen Raum mehr als 500 Sprachwissenschaftler aus aller Welt.“"
                                            },
                                            {
                                                "example_id": "6a8bb1be-d6fd-4a99-8ab2-7e32f3207850",
                                                "sense_id": "5c4ad6e9-b7ba-3f84-b6e8-88dbd70243d0",
                                                "text": "„Man nimmt es an - das ist das Grundpostulat der sowjetischen Sprachwissenschaftler -, aber genetisch lässt sich das nicht beweisen.“"
                                            },
                                            {
                                                "example_id": "125ca0bf-c755-4f2a-b9ef-93942dd557db",
                                                "sense_id": "5c4ad6e9-b7ba-3f84-b6e8-88dbd70243d0",
                                                "text": "„Auf einem ganz anderen Weg versuchen Sprachwissenschaftler, Licht in die Vergangenheit zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f06a487-aaaf-4f7b-8913-009bc5961811",
                        "source_entry_id": "f0b7d5dd-70e4-354b-a2e3-628afc6ccea6",
