                                    {
                                        "sense_id": "8b2fd94c-81a8-37ce-ae02-b489c653b46c",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "An evil creature, the objectification of a hostile and destructive force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1134d47-bcd3-3585-bc08-7e49f404d434",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A fictional image of a man, usually red or orange in skin color; with a set of horns on his head, a pointed goatee and a long tail and carrying a pitchfork; that represents evil and portrayed to children in an effort to discourage bad behavior."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39683b03-37b8-3c35-b8ee-dbf01fbe1653",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "The bad part of the conscience; the opposite to the angel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8440a4-070b-4831-8210-cdc903ee7113",
                                                "sense_id": "39683b03-37b8-3c35-b8ee-dbf01fbe1653",
                                                "text": "The devil in me wants to let him suffer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7f933d9-ccde-3178-b37f-e489c7909eab",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A wicked or naughty person, or one who harbors reckless, spirited energy, especially in a mischievous way; usually said of a young child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef5666c-30d9-4112-a23b-ebdb441f8156",
                                                "sense_id": "d7f933d9-ccde-3178-b37f-e489c7909eab",
                                                "text": "Those two kids are devils in a toy store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b086e32c-3894-33b9-b4b9-41bbf1b20332",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A thing that is awkward or difficult to understand or do."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ed2f2db-6e00-4995-b1a6-98e208523d78",
                                                "sense_id": "b086e32c-3894-33b9-b4b9-41bbf1b20332",
                                                "text": "That math problem was a devil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d153552c-bc61-394d-aabe-d302ef071937",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "Hell."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e98319-bb46-4075-bb93-eb4a7386780d",
                                                "sense_id": "d153552c-bc61-394d-aabe-d302ef071937",
                                                "text": "What in the devil is that?"
                                            },
                                            {
                                                "example_id": "29c27562-eac4-44ba-a3c6-bbabcfa2debb",
                                                "sense_id": "d153552c-bc61-394d-aabe-d302ef071937",
                                                "text": "What the devil is that?"
                                            },
                                            {
                                                "example_id": "eff9ffd4-f001-472c-bd83-4be962403392",
                                                "sense_id": "d153552c-bc61-394d-aabe-d302ef071937",
                                                "text": "She is having a devil of a time fixing it."
                                            },
                                            {
                                                "example_id": "2ae108f0-e3ed-4f1b-93f6-cea8c80a4b48",
                                                "sense_id": "d153552c-bc61-394d-aabe-d302ef071937",
                                                "text": "You can go to the devil for all I care."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "239d40c6-e6fc-3d85-8f33-07f741990ea3",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A person, especially a man; used to express a particular opinion of him, usually in the phrases poor devil and lucky devil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e644f82-7f32-3510-8e83-f1d1fcb130b1",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A printer's assistant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58746e3a-b615-44ef-8c27-98dd219e7f52",
                                                "sense_id": "6e644f82-7f32-3510-8e83-f1d1fcb130b1",
                                                "text": "For he will not leave his listener to dwell upon sorrow when the print office beckons and he can show you what a good little devil he became."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fee90ea-f41a-3115-8d13-0ec76254753d",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A poltergeist that haunts printing works."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "238aff64-5c63-3489-9daf-fccf1351c296",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A dust devil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e0a41f-68ac-4c27-a870-c8692dbba63f",
                                                "sense_id": "238aff64-5c63-3489-9daf-fccf1351c296",
                                                "text": "The formation of tornados and water-spouts is very probably identical with that of dust-storms and \"devils,\" viz., a sudden disturbance of the vertical equilibrium of the atmosphere, where by an upward rush of air is generated, which rapidly becomes spiral."
                                            },
                                            {
                                                "example_id": "c15dc6c5-d239-4e3c-a544-bf11716d7154",
                                                "sense_id": "238aff64-5c63-3489-9daf-fccf1351c296",
                                                "text": "There are few sights more appalling than a sandstorm in the desert, the \"Zauba'ah\" as the Arabs call it. Devils, or pillars of sand, vertical and inclined, measuring a thousand feet high[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f0d068-9cbf-3c74-b34d-00699f2e6c97",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A barren, unproductive and unused area."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "957dcc26-62e3-4c12-a3f7-48f97c632ad7",
                                                "sense_id": "71f0d068-9cbf-3c74-b34d-00699f2e6c97",
                                                "text": "devil strip"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be32a1ed-5e1d-3f4a-9890-e80413a58e73",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A dish, as a bone with the meat, broiled and excessively peppered; a grill with Cayenne pepper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a129c7e-6c83-488b-abc2-225855c71eb6",
                                                "sense_id": "be32a1ed-5e1d-3f4a-9890-e80413a58e73",
                                                "text": "Men and women busy in baking, broiling, roasting oysters, and preparing devils on the gridiron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61bb9104-65d6-3b06-b390-988bd033b062",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A machine for tearing or cutting rags, cotton, etc., as used in the production of mungo or shoddy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313fcf76-c6cc-4aad-8e8c-583cf9ca5758",
                                                "sense_id": "61bb9104-65d6-3b06-b390-988bd033b062",
                                                "text": "The woollen things are torn to pieces by a machine having spiked rollers (termed a devil), cleansed, and the fibre spun with a certain proportion of new wool, the yarn being afterwards woven into the full-bodied but flimsy fabric termed shoddy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f58928-8075-3855-b925-52f2ef5d7f37",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "A Tasmanian devil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6388cb0b-4038-42b4-a809-712192595817",
                                                "sense_id": "c6f58928-8075-3855-b925-52f2ef5d7f37",
                                                "text": "He removes his food, water, and torch from the pack and then pushes it to the far end of the tent – no devil is going to rip his pack apart tonight."
                                            },
                                            {
                                                "example_id": "43cd1868-69e8-4964-83a1-426842a1439b",
                                                "sense_id": "c6f58928-8075-3855-b925-52f2ef5d7f37",
                                                "text": "In the 1800s, for example, workers at a wool company were scared that the devils would attack their sheep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e0cfcc4-8f4e-3ace-82c6-29a8aafde1f0",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "An endurance event where riders who fall behind are periodically eliminated."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7501891-a791-35b3-b33c-389e6ca4aa07",
                                        "entry_id": "6da9dd30-bf5b-3e6c-9758-57a6efad6344",
                                        "glosses": [
                                            "Ellipsis of devil seam (“the seam between garboard strake and the keel, on wooden boats”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
