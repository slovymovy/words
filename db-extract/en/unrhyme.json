                "senses": [
                    {
                        "sense_id": "85c96c73-d37c-39c8-905d-5aeb405a9182",
                        "entry_id": "1dedc7de-1ecb-3741-9847-562c968c4893",
                        "glosses": [
                            "To remove the rhyme or expected rhyme from."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b791f3-650d-4552-8b5a-33a8bd688ced",
                                "sense_id": "85c96c73-d37c-39c8-905d-5aeb405a9182",
                                "text": "a class of hackwriters arose whose job was to unrhyme the verse chronicles of the trouvere and to render them in the common speech of the day"
                            },
                            {
                                "example_id": "510cd3f9-2275-4e13-b167-4afffd1e441a",
                                "sense_id": "85c96c73-d37c-39c8-905d-5aeb405a9182",
                                "text": "He half-rhymes \"one\" and \"groan,\" clearly unrhymes \"still\" with \"days,\" and seems unconcerned that the second \"Shiloh\" has no rhyming mate."
                            },
                            {
                                "example_id": "ba97095d-e2c2-4409-be5d-a72120e47c4c",
                                "sense_id": "85c96c73-d37c-39c8-905d-5aeb405a9182",
                                "text": "\"Unrhyming\" — translating from verse to prose — while common in late medieval France, was relatively rare in England: coincidentally, the Gilte Legende unrhymes its verse sources"
                            }
                        ]
                    }
