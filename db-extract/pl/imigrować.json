                    {
                        "translation_id": "a21afba6-c4e4-4a3c-993b-8c8117bd00e1",
                        "source_entry_id": "980dc69d-f323-3650-9187-fdbbe7e1b2fb",
                        "source_sense_id": "a499855c-0afc-3e39-bc17-956011ceaa89",
