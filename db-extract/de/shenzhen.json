                "senses": [
                    {
                        "sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
                        "entry_id": "dfdfefb2-f17f-3369-aacb-b5386a5e8655",
                        "glosses": [
                            "Stadt in der chinesischen Provinz Guangdong"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f236f1-7789-4327-8342-1ffd42bbeac2",
                                "sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
                                "text": "„»Der Bereich in Shenzhen, in dem ich mich am meisten aufhalte, ist wahrscheinlich die Huaqiangbei-Straße.«“"
                            },
                            {
                                "example_id": "7dbf11c7-4fee-454c-bfb0-487592c9d153",
                                "sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
                                "text": "„In Shenzhen werden seit 2007 bereits 100 Prozent des öffentlichen Personentransfers elektrisch durchgeführt. Damit ist die Stadt weltweit Vorreiter.“"
                            },
                            {
                                "example_id": "1ee36d6c-1099-416d-abed-a08c69674515",
                                "sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
                                "text": "„In Industriegebieten, wie z.B. nordöstlich des Flughafens von Shenzen, steht eine Vielzahl Werkhallen, in denen für den Weltmarkt produziert wird.“"
                            },
                            {
                                "example_id": "e0ffc12f-501e-4588-b8a4-a6f8c0eff6c2",
                                "sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
                                "text": "„Die Stadt Shenzhen veränderte sich in dieser Zeit rasant.“"
                            },
                            {
                                "example_id": "e116a846-69af-498b-b24a-991fffbfd774",
                                "sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
                                "text": "„»Shenzhen hat heute nur noch wenig mit der Stadt zu tun, in die ich damals gekommen bin.«“"
                            },
                            {
                                "example_id": "f82f2f11-7fa8-4bae-b9ff-8cdbb62dd0b3",
                                "sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
                                "text": "„Aus den ehemaligen Fischerorten mit wenigen Tausend Einwohnern wurden in wenigen Jahrzehnten Millionenstädte wie Shenzhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9fee984-e063-4491-86fd-8395bba120f5",
                        "source_entry_id": "dfdfefb2-f17f-3369-aacb-b5386a5e8655",
                        "source_sense_id": "571b371d-0f9b-3b34-8af9-4a1d6e97ec78",
