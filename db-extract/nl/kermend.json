        "nl-extract.jsonl": [
            {
                "entry_id": "57b8bda3-cc94-301d-818c-0ccacb575279",
                "word": "kermend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "74fa08c5-4866-317e-ba8b-b8bc1f25d331",
                        "entry_id": "57b8bda3-cc94-301d-818c-0ccacb575279",
                        "glosses": [
                            "bezig met zachtjes te huilen als teken van pijn en verdriet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5368f645-7fb0-4925-b4ce-84aaa4827dd1",
                                "sense_id": "74fa08c5-4866-317e-ba8b-b8bc1f25d331",
                                "text": "De minuscule tinnen figuurtjes lijken na 10 draaidagen en vele weken montage ineens reusachtige strijdende soldaten en de kermende gewonden zijn levensecht."
                            },
                            {
                                "example_id": "4ab121a9-fa4e-483e-91b9-6aa72c2f396b",
                                "sense_id": "74fa08c5-4866-317e-ba8b-b8bc1f25d331",
                                "text": "Tijdens zijn mislukte actie ging het alarm af in de supermarkt waar vooral veel sterke drank wordt verkocht. Op het moment dat de politie 's avonds laat in de winkel arriveerde, bungelde de kermende man nog steeds met zijn benen in de lucht. Het duurde, aldus de politie van Krasnoyarsk, geruime tijd om de inbreker uit zijn benaderde positie te bevrijden."
                            },
                            {
                                "example_id": "d24c9978-50ae-4dd5-b8e1-e3da2613e9af",
                                "sense_id": "74fa08c5-4866-317e-ba8b-b8bc1f25d331",
                                "text": "Een paar weken later, in de halve finale van het EK tegen gastland West-Duitsland beukt hij, na een te korte terugspeelbal van Ronald Koeman, tegenstander Frank Mill onder de zoden. Om de kermende Mill vervolgens toe te schreeuwen: 'Ich hoffe das du fokking stirbst'."
                            }
                        ]
                    }
