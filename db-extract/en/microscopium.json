                                        "entry_id": "c571272b-c270-3f84-937d-73a6d8a804d1",
                                        "glosses": [
                                            "Constellation du ciel austral, bordée par le Capricorne, le Sagittaire, l’Indien, la Grue et le Poisson austral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29507c8-89c5-461e-93ad-05eb88ee2952",
                                                "sense_id": "18949211-54bc-3ba1-b028-e4bee89131f8",
                                                "text": "Voici donc ces nouvelles constellations suivant l’ordre des ascensions droites, & telles que M. de la Caille les rapporte dans les Mémoires de 1752 […] XIII. Le Microscope, pour servir à l’Histoire Naturelle ; c’est un tuyau placé au dessus d’une boëte quarrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a03a9d4c-f526-4bad-834b-dbe25e891367",
                        "source_entry_id": "3b7e87eb-c233-39a1-bc6f-3bb2b28088b0",
                        "source_sense_id": "a15887a2-200c-3b6a-92bc-d8f2a9273026",
                        "source_sense_description": "faint constellation of the southern spring sky",
                        "target_lang_word": "Mikroskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mikroskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                        "entry_id": "5eb00eae-b5ce-3120-9180-c88534692f2a",
                                        "glosses": [
                                            "Instrument zur vergrößerten Betrachtung kleiner Objekte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61247884-762b-4dbb-99e8-bda83fe101d3",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "Wir betrachteten die geschnittenen Zwiebelschale unter dem Mikroskop."
                                            },
                                            {
                                                "example_id": "27d781cd-e62f-4175-b94c-9597f8a83820",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Volker hatte ein Mikroskop gekriegt, als Trostpflaster, weil er nachher doch lieber mit uns in Jever gewesen wäre.“"
                                            },
                                            {
                                                "example_id": "4048e6bb-1cc1-48b0-9b00-0d46f2e83b77",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Unter dem Mikroskop zeigen sich dabei sogar kleine Gefäße, durch die Saurierherzen einst das Blut pumpten.“"
                                            },
                                            {
                                                "example_id": "17d1c2d5-e167-4b20-a23c-9eb3ae2e6361",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Er packte das Mikroskop beiseite.“"
                                            },
                                            {
                                                "example_id": "5baf8327-8450-49bf-b640-c2fb7d872728",
                                                "sense_id": "54908e0a-d560-3be9-8f2f-21e1d3a5fae2",
                                                "text": "„Den ganzen Tag verbrachte er nun, über das Mikroskop gebeugt, in den großen aus Daressalam entliehenen Landvermesserzelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
