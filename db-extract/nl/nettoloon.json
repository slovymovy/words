                                "example_id": "02059190-24f6-4dc1-b781-f8136f00a42a",
                                "sense_id": "102d112e-7714-3e8b-b407-0cb96fbc0f37",
                                "text": "Het nettoloon neemt licht toe deze maand. Deze stijging echter is alweer tenietgedaan door de lastenverzwaringen, meent Peter de Quaak."
                            },
                            {
                                "example_id": "db0710a9-bcbc-4276-a535-5a4a2adad716",
                                "sense_id": "102d112e-7714-3e8b-b407-0cb96fbc0f37",
                                "text": "Wie een straks een blik werpt op het al dan niet gestegen nettoloon, doet er goed aan het loonstrookje te controleren."
                            }
                        ]
                    }
