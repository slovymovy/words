                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4490a51a-5c37-4f16-8364-9acf5e54942b",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Jetzt bringen wir mal Schwung in den Laden."
                                            },
                                            {
                                                "example_id": "3f6f86c5-9b90-4972-b402-19e80fd17faa",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Mit Schwung ins Neue Jahr!"
                                            },
                                            {
                                                "example_id": "3a0bb2d1-6348-4267-9d84-528827a179b0",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Ich fühle mich schlapp und ohne jeden Schwung."
                                            },
                                            {
                                                "example_id": "b66d9b36-5526-41ef-8bbb-167960eedcf2",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Der Einzelhandel ist im Januar noch ohne Schwung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8afbc030-d5de-356e-831f-4adecac88f0f",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "eine große Anzahl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f744bd-38b1-44d3-8f20-4c4bd0c6e188",
                                                "sense_id": "8afbc030-d5de-356e-831f-4adecac88f0f",
                                                "text": "Und dann haben sie auch recht schnell einen ganzen Schwung Kinder gekriegt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62811cb9-160b-4145-af7e-e56f94b647da",
                        "source_entry_id": "2114cf69-6d9f-34cf-83e1-9e186bc094a4",
                        "source_sense_id": "0cce501a-3ae9-3cb7-a5cd-e23c25e18228",
                        "source_sense_description": "eine lebendige und aufregende Qualität oder ein lebendiger Stil",
                        "target_lang_word": "Pep",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pep",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                        "entry_id": "84470901-25bb-3c77-8a26-764ee8d4bc8a",
                                        "glosses": [
                                            "begeisternder, ansteckender Schwung; Besonderheit, durch die etwas interessant und aufregend wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fddbfb-a551-4b06-9168-4f2c900ab543",
                                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                                "text": "Das Musical war so fad, es hatte überhaupt keinen Pep."
                                            },
                                            {
                                                "example_id": "0a1a5655-c6f1-41f8-af7c-d1c82a93f5e0",
                                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                                "text": "„Wer 20000 Euro mit etwas mehr Pep anlegen will, kommt an der Börse nicht vorbei.“"
                                            },
                                            {
                                                "example_id": "5db9d3b6-0a19-44c6-b4ef-b8aa6324c566",
                                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                                "text": "„Da gehört Pep in die Sache!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3adb7712-ffe5-3e40-96b1-b94ff181b00b",
                                        "entry_id": "84470901-25bb-3c77-8a26-764ee8d4bc8a",
                                        "glosses": [
                                            "synthetisch hergestelltes Mittel, das das zentrale Nervensystem anregt und das als Droge verwendet wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db57a3bf-7a3d-4bf2-ba6a-294a01801692",
                                                "sense_id": "3adb7712-ffe5-3e40-96b1-b94ff181b00b",
                                                "text": "„Pep ist das neue Ecstasy.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3bb9638-7737-43cd-8c70-1eb87393a92c",
                        "source_entry_id": "2114cf69-6d9f-34cf-83e1-9e186bc094a4",
                        "source_sense_id": "662980c0-b062-3256-a324-a738af66fc60",
                        "source_sense_description": "Eigenschaft, die eine Person auszeichnet, umgangssprachlich: Ausstrahlung, Glamour",
                        "target_lang_word": "Ausstrahlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausstrahlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb692bd1-246c-3da9-a699-32f716edfd53",
                                        "entry_id": "14a3087e-fc9a-3b7b-b20a-01a1c750a50f",
                                        "glosses": [
                                            "die Übertragung einer Radio- oder Fernsehsendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15f35e68-6262-4c48-86ad-2b06d8026078",
                                                "sense_id": "fb692bd1-246c-3da9-a699-32f716edfd53",
                                                "text": "Die erneute Ausstrahlung der Talkshow wollen Politiker verhindern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fce70eb5-1e56-3fb8-bd6d-d95060678bdb",
                                        "entry_id": "14a3087e-fc9a-3b7b-b20a-01a1c750a50f",
                                        "glosses": [
                                            "eine bestimmte Wirkung, die eine Person durch seine Persönlichkeit ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55aa7ab6-e747-45cd-b681-25ace592bc56",
                                                "sense_id": "fce70eb5-1e56-3fb8-bd6d-d95060678bdb",
                                                "text": "Für eine positive Ausstrahlung ist vor allem ein selbstsicheres und überzeugendes Auftreten wichtig."
                                            },
                                            {
                                                "example_id": "f4d3c1c2-808f-4956-a968-7754482bde2e",
                                                "sense_id": "fce70eb5-1e56-3fb8-bd6d-d95060678bdb",
                                                "text": "„Mit ihrer Zahlenberauschtheit von Daten und Fakten konnte sich die Geographie bald an die Spitze der positivistischen Disziplinen setzen, zumindest was deren kulturelle Ausstrahlung anging.“"
                                            },
                                            {
                                                "example_id": "1a787147-da46-4ab6-8980-b4c9ac2fe4db",
                                                "sense_id": "fce70eb5-1e56-3fb8-bd6d-d95060678bdb",
                                                "text": "„Und ich fand, dass sie eine besondere Ausstrahlung hatten.“"
                                            },
                                            {
                                                "example_id": "73d31dd1-e29f-4c2b-a626-50aab396c95a",
                                                "sense_id": "fce70eb5-1e56-3fb8-bd6d-d95060678bdb",
                                                "text": "„Der sensible Gipfelsammler erlebt bisweilen das, was der Religiöse befürchtet, eine Profanisierung, eine Entweihung des heiligen Berges, den Verlust der Unberührtheit und damit der magischen Ausstrahlung.\""
                                            },
                                            {
                                                "example_id": "1aadd0f5-11be-4a2d-bb07-d69460fbdb55",
                                                "sense_id": "fce70eb5-1e56-3fb8-bd6d-d95060678bdb",
                                                "text": "„Aber es ist eben nicht nur Kant, der die enorme geistige Ausstrahlung Königsbergs auf das deutsche Geistesleben repräsentiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd5843af-526f-4ca5-b6b8-515ba52526e3",
                        "source_entry_id": "2114cf69-6d9f-34cf-83e1-9e186bc094a4",
                        "source_sense_id": "662980c0-b062-3256-a324-a738af66fc60",
                        "source_sense_description": "Eigenschaft, die eine Person auszeichnet, umgangssprachlich: Ausstrahlung, Glamour",
                        "target_lang_word": "Glamour",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glamour",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e288f4-8498-3c68-8a19-2c4f9adb7142",
                                        "entry_id": "34eb7a4b-57fc-3704-ac66-0230e37e1503",
                                        "glosses": [
                                            "luxuriöse/prunkvolle Aufmachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87494044-0ef8-443a-9b70-e7badc747702",
                                                "sense_id": "e1e288f4-8498-3c68-8a19-2c4f9adb7142",
                                                "text": "„Es muss aber nicht immer der absolute Glamour sein, der die Frauen an den Royals dieser Welt fasziniert, gerade der Gegensatz von offensichtlicher Märchenwelt und durchaus bürgerlichen Problemen fasziniert.“"
                                            },
                                            {
                                                "example_id": "76819e60-e7be-4fdd-999c-bc4dcc9622ab",
                                                "sense_id": "e1e288f4-8498-3c68-8a19-2c4f9adb7142",
                                                "text": "„Der Schriftsteller wiederum traf auf eine Frau, die seinen Idealen nur zu sehr entsprach: schlank, von außergewöhnlicher Schönheit und umstrahlt vom Glamour, dem er schon immer erlegen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
