                "senses": [
                    {
                        "sense_id": "07cf353b-cd77-3189-8908-9b2cdd1d1586",
                        "entry_id": "9153b284-f1ef-3690-b9bc-e151e6da4834",
                        "glosses": [
                            "называть, именовать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73caceea-96d4-4ce1-b4f3-0914db4c5268",
                                "sense_id": "07cf353b-cd77-3189-8908-9b2cdd1d1586",
                                "text": "Этот Лебядкин, какой-то заезжий, оказался потом лицом весьма подозрительным и вовсе даже не был отставным штабс-капитаном, как сам титуловал себя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75f3c816-0684-49ac-b8ec-3212a587c407",
                        "source_entry_id": "9153b284-f1ef-3690-b9bc-e151e6da4834",
                        "source_sense_id": "07cf353b-cd77-3189-8908-9b2cdd1d1586",
                        "target_lang_word": "titulieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "titulieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d70ca1b-6916-39d2-81f6-49ba6efd1166",
                                        "entry_id": "15c6bc83-2a0b-32b1-8b2f-c7ff1e9b1bfb",
                                        "glosses": [
                                            "etwas, insbesondere einem Kunstwerk, Buch oder Aufsatz einen Titel geben, mit einer Überschrift versehen"
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b0d8e0-6b39-4f1f-86be-00d41284fcf2",
                                                "sense_id": "3d70ca1b-6916-39d2-81f6-49ba6efd1166",
                                                "text": "„‚Überleg Dir doch das Glaubensbekenntnis etwas‘, hatte Engels schon am 24. November 1847 aus Paris geschrieben, ‚ich glaube, wir tun am besten, wir lassen die Katechismusform weg und titulieren das Ding: Kommunistisches Manifest. […]‘“"
                                            },
                                            {
                                                "example_id": "ab82fe98-4008-47dd-b02b-5e54fb12aeef",
                                                "sense_id": "3d70ca1b-6916-39d2-81f6-49ba6efd1166",
                                                "text": "„Denn Hieronymus tituliert das Buch mit den Worten ‚threni idest lamentationes ieremiae prophetae‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5affcce-d852-360c-b9a8-9f1773c7122d",
                                        "entry_id": "15c6bc83-2a0b-32b1-8b2f-c7ff1e9b1bfb",
                                        "glosses": [
                                            "jemanden mit seinem Titel anreden"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f5579db-0c5a-495c-88d8-c8cdfe3edd5c",
                                                "sense_id": "c5affcce-d852-360c-b9a8-9f1773c7122d",
                                                "text": "Dass Máxima als Königin tituliert wird, bedeutet nicht, dass sie die mit dem Königsamt verbundenen Befugnisse und Verantwortlichkeiten hätte."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "b6cacae2-d264-326f-b241-141dca25e3ba",
                                        "entry_id": "15c6bc83-2a0b-32b1-8b2f-c7ff1e9b1bfb",
                                        "glosses": [
                                            "jemanden mit einem negativen Begriff bezeichnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6988a774-6bef-4e06-a640-a085a04aace1",
                                                "sense_id": "b6cacae2-d264-326f-b241-141dca25e3ba",
                                                "text": "Im Sommer 1931 begann Dönhoff das Studium der Volkswirtschaft in Königsberg und wechselte zum Wintersemester an die Universität Frankfurt am Main, wo sie wegen ihrer Sympathie für die Linken als „Rote Gräfin“ tituliert wurde."
                                            },
                                            {
                                                "example_id": "5cecf62c-b0a2-4725-98b6-c016b002836c",
                                                "sense_id": "b6cacae2-d264-326f-b241-141dca25e3ba",
                                                "text": "Was Erdoğan aber jetzt sagte, nämlich den Gründer der türkischen Republik als Säufer zu titulieren, das treibt auch die Kemalisten und Nationalisten auf die Straße, …"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "e7e54bc1-3712-31cf-a40e-ba493f44fea7",
                                        "entry_id": "15c6bc83-2a0b-32b1-8b2f-c7ff1e9b1bfb",
                                        "glosses": [
                                            "einen (Zahlungs-)Anspruch gerichtlich oder notariell und rechtsverbindlich feststellen"
                                        ],
                                        "tags": [
                                            "Jura"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4fca9f4-0e4c-4dc0-a350-80012b305f13",
                                                "sense_id": "e7e54bc1-3712-31cf-a40e-ba493f44fea7",
                                                "text": "„Dagegen erscheint eine verschuldensunabhängige Haftung immer dann unangemessen, wenn der zu sichernde Anspruch bereits gerichtlich tituliert ist.“"
                                            },
                                            {
                                                "example_id": "cad46b3a-a029-454f-a7cc-0636a352ceb5",
                                                "sense_id": "e7e54bc1-3712-31cf-a40e-ba493f44fea7",
                                                "text": "„Behörden titulieren ihre Bescheide selbst (Dienstsiegel) und können diese nach Fristsetzung selbst vollstrecken.“"
                                            },
                                            {
                                                "example_id": "409d4ec2-ee40-46f7-af5c-5b7a1554b66a",
                                                "sense_id": "e7e54bc1-3712-31cf-a40e-ba493f44fea7",
                                                "text": "„Beim zuständigen Jugendamt kann ein Anspruch auf Kindesunterhalt kostenfrei tituliert werden, Ehegattenunterhalt muss vom Notar tituliert werden.“"
                                            },
                                            {
                                                "example_id": "fdf59d3c-b976-46ea-98d6-1ad1c2f33ec7",
                                                "sense_id": "e7e54bc1-3712-31cf-a40e-ba493f44fea7",
                                                "text": "„Diese Pflicht wird in dem Bescheid tituliert, ist aber nicht vollstreckbar, weil dazu zunächst die Entscheidung des Amtes zur Regelung offener Vermögensfragen ergehen muß.“"
                                            },
                                            {
                                                "example_id": "8ba6a618-55d5-4fd7-9188-34e293244bd2",
                                                "sense_id": "e7e54bc1-3712-31cf-a40e-ba493f44fea7",
                                                "text": "„Abhängig von der Kooperationsbereitschaft des Schuldners bieten sich verschiedene Möglichkeiten an, einen Anspruch zu titulieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b17b5b7-6d41-4613-8482-4bf1cb5d19a7",
