                "senses": [
                    {
                        "sense_id": "10c046d5-453f-34f5-b4ac-2720c85320df",
                        "entry_id": "44a0f4bf-64ac-3d5c-9602-ba27e21d6368",
                        "glosses": [
                            "weibliche Person, die nicht in einer Schule oder Universität eingeschrieben ist und freiwillig an Lehrveranstaltungen oder Unterrichtsstunden teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "750c00db-b86a-4814-b666-a332a8fa4202",
                                "sense_id": "10c046d5-453f-34f5-b4ac-2720c85320df",
                                "text": "Sie hat sich als Gasthörerin an der Hochschule eingetragen."
                            },
                            {
                                "example_id": "51c08df0-a49b-4a91-8f73-a2c9ee839a81",
                                "sense_id": "10c046d5-453f-34f5-b4ac-2720c85320df",
                                "text": "„Die Politikerin habe sich nicht qualifiziert, den Namen der Hochschule in ihrem Lebenslauf zu nennen, weil sie lediglich Gasthörerin war.“"
                            },
                            {
                                "example_id": "0d03d528-1573-40e8-a177-98f73a3c2307",
                                "sense_id": "10c046d5-453f-34f5-b4ac-2720c85320df",
                                "text": "„Den Besuch der Universitäten erkämpften sich Frauen schließlich ebenfalls über die Pädagogikausbildung: Als ab 1896 die ersten Frauen in deutschen Hörsälen als Gasthörerinnen zugelassen wurden, waren diese fast ausnahmslos Lehrerinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
