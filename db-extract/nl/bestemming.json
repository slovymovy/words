                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d3d8a62-7df8-47e1-8cd5-5097d8e67a60",
                                                "sense_id": "af6b4e32-3255-3d18-b223-9ab5fbd5ff35",
                                                "text": "Er hat gegen die Bestimmungen in der Satzung verstoßen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cbf371ae-9c4c-355e-a53e-ef51f643f611",
                                        "entry_id": "fe356a54-8abc-3e51-81b6-207ddd6f3c45",
                                        "glosses": [
