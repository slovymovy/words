                    {
                        "translation_id": "f26a3066-80fb-463c-bb2b-5989f87163b1",
                        "source_entry_id": "f77eba5e-1848-3f14-b326-8ddc29d8ce27",
                        "source_sense_id": "1226516c-7254-35e4-8b18-088ccfc61843",
                        "target_lang_word": "sensatez",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensatez",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "80131673-2ec2-3f4f-b3c2-70cad6195658",
                                        "entry_id": "05d461d5-97bd-3bda-a03c-964ba23a57f0",
                                        "glosses": [
                                            "Buen juicio, cordura, prudencia o capacidad de sopesar las consecuencias antes de actuar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2213250-8154-4790-80b2-24fa20f2be2a",
                                                "sense_id": "80131673-2ec2-3f4f-b3c2-70cad6195658",
                                                "text": "Juntas y confundidas nuestras voluntades, la mía se complacerá en la obediencia, sabiendo como sé que el clarísimo entendimiento de mi señora madre ha de imponerme actos y resoluciones de innegable sensatez."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d332182e-fca6-4054-a808-82ee82b1cb02",
                        "source_entry_id": "f77eba5e-1848-3f14-b326-8ddc29d8ce27",
                        "source_sense_id": "1226516c-7254-35e4-8b18-088ccfc61843",
