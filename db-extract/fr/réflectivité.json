                                        "entry_id": "9311449c-2303-3f98-899b-f4556f876b42",
                                        "glosses": [
                                            "To cast (beams of light) on something."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5993dcf1-acfa-456c-bfb3-9d995ffd8eff",
                                                "sense_id": "207362cb-6c57-3b68-a950-f578c1cb68db",
                                                "text": "The ſpring is hindered by your ſmoothering hoſt,\nFor neither rain can fall vpon the earth,\nNor Sun reflexe his vertuous beames thereon.\nThe ground is mantled with ſuch multitudes."
