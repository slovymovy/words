                        "sense_id": "51f42927-8edc-3b12-bff9-dcc7adcf3319",
                        "entry_id": "a6462834-21ff-30a6-8734-6a7ad8cf676c",
                        "glosses": [
                            "volgens of over de voorschriften waarmee het openbaar bestuur werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff2cb647-f2e2-4c45-9fb0-b1e1648c4f9c",
                                "sense_id": "51f42927-8edc-3b12-bff9-dcc7adcf3319",
                                "text": "We willen noch biechtvader zijn, noch gendarme. Een biechtvader geeft absolutie en dat doen we niet. Als we vaststellen dat er strafrechtelijke of administratiefrechtelijke inbreuken gebeurd zijn, zullen we meteen optreden en zonder aarzeling de nodige maatregelen nemen."
                            },
                            {
                                "example_id": "6748af88-8060-408d-b60c-700fe9bab931",
                                "sense_id": "51f42927-8edc-3b12-bff9-dcc7adcf3319",
                                "text": "Gaat het bedrijf niet in op deze ingebrekestelling, dan zal Demir binnen de Vlaamse regering het gesprek aangaan en overwegen om procedures in te stellen om de multinational strafrechtelijk, burgerrechtelijk en/of administratiefrechtelijk te laten vervolgen, klinkt het verder."
                            }
                        ]
                    }
