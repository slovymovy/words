                "senses": [
                    {
                        "sense_id": "ea97d502-84fc-3c72-a51a-cb1185a0c62d",
                        "entry_id": "2b2fca86-9ed6-3097-96dd-eaa78fb3c8ff",
                        "glosses": [
                            "Faire perdre à quelqu’un les manières bourgeoises."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d075620a-cbca-421b-b9ba-c33feaf1cb8b",
                                "sense_id": "ea97d502-84fc-3c72-a51a-cb1185a0c62d",
                                "text": "Il est vrai que je n’ai pas mon pareil pour débourgeoiser un enfant de famille."
                            },
                            {
                                "example_id": "5299e964-c26a-4ead-b4ef-e2e860f66d95",
                                "sense_id": "ea97d502-84fc-3c72-a51a-cb1185a0c62d",
                                "text": "L’un sert à définir l’autre, à le nettoyer de toute méprise, le dégager de toute équivoque, à le « débourgeoiser », à le désadultérer ; l’art c’est l'artifice, l’artificiel c’est l’antinaturel, — le surnaturel, — donc l’humain conscient et volontaire."
                            },
                            {
                                "example_id": "43025749-2c05-4ef9-bb06-b9a8855678f6",
                                "sense_id": "ea97d502-84fc-3c72-a51a-cb1185a0c62d",
                                "text": "Ghéon lui-même, qui a voué sa vie à débourgeoiser et à décabotiner le théâtre, voyait un signe des temps dans ce retour du théâtre à ses origines, né et grandi dans les cadres officiels de la Sorbonne."
                            },
                            {
                                "example_id": "3163ecb9-9b98-4766-b611-8cbb4cad95c6",
                                "sense_id": "ea97d502-84fc-3c72-a51a-cb1185a0c62d",
                                "text": "—Nous sommes des Rezeau débourgeoisés qui n'ont aucune envie de réintégrer la caste. D'accord ?"
                            }
                        ]
                    }
                ],
