                            {
                                "example_id": "b3695ab9-fb8b-44db-8c31-034c4d6df4d9",
                                "sense_id": "db84e4b9-72f8-3793-8ce4-d5e555117c63",
                                "text": "In het geval van racistische kreten weten de beleidsbepalers precies uit welke clubhoek die dan komen. Men kan niet meer naar elkaars supporters wijzen."
                            },
                            {
                                "example_id": "effa06dc-b41d-4408-b802-e47f25e8e912",
                                "sense_id": "db84e4b9-72f8-3793-8ce4-d5e555117c63",
                                "text": "„Vis begint aan de kop te stinken, heb ik ooit geleerd. Een metafoor die aangeeft dat alle ellende in een bedrijf aan de top begint.” Directeur Paul van der Kraan is in zijn ogen een boekhouder, maar geen bestuurder. Over Ted van Leeuwen zegt Jager: „De technisch directeur is meer geschikt als spelersmakelaar, maar ongeschikt als beleidsbepaler.”"
                            }
                        ]
                    }
