                                "target_senses": [
                                    {
                                        "sense_id": "d2291a26-0ffb-3540-889f-9fa6588287b5",
                                        "entry_id": "532b53af-a44e-3ee3-8204-0a629400ede0",
                                        "glosses": [
                                            "To decorate."
