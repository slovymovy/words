                    },
                    {
                        "translation_id": "8da1fac5-71eb-43e1-9c7c-e440d3a473a6",
                        "source_entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                        "source_sense_description": "hot toddy",
                        "target_lang_word": "grog",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grog",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                        "entry_id": "ccf2f37a-bde4-387e-a5cc-5e6d4d101578",
                                        "glosses": [
                                            "Boisson chaude à base d’eau et de rhum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66383af3-2dda-4acc-90f1-4593c7373d3a",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "Les grogs brûlants ne furent pas épargnés, et le brave sergent Long put en prendre sa part."
                                            },
                                            {
                                                "example_id": "903212f0-743a-4dac-b713-e3782f89da7c",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "elle posa ... un plateau devant Clémence, qui se mit à préparer posément son grog, versant l’eau chaude sur le citron, qu’elle écrasait à coups de cuiller, sucrant, mettant le rhum en consultant le carafon, pour ne pas dépasser le petit verre réglementaire."
                                            },
                                            {
                                                "example_id": "2073cd2d-1273-4ad5-a503-3f30483d46b3",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "– Ça ne te ferait rien de prendre un grog au mois de juin ? C’est une bonne boisson de vaincu, en toutes saisons."
                                            },
                                            {
                                                "example_id": "c32ad67a-c3b0-451f-b606-65c1d56da2eb",
                                                "sense_id": "95291cb2-e94e-3161-993d-006743b1eab3",
                                                "text": "Tout en parlant, mon compagnon s’était approché du comptoir, où je le rejoignis, et l’on nous servit nos grogs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ae49937-3b7a-4e5d-9b28-58ca9292a1d7",
                        "source_entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                        "source_sense_description": "hot toddy",
                        "target_lang_word": "Grog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                                        "entry_id": "2cec4138-e960-3f3b-a0aa-df2ab2d813d9",
                                        "glosses": [
                                            "heißes Getränk aus Rum (auch Weinbrand oder Arrak) mit Wasser und Zucker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054d2767-d370-4eb2-b317-1dae97b44275",
                                                "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                                                "text": "„Aus der Leutnantskabine kam der Duft von Grog.“"
                                            },
                                            {
                                                "example_id": "3de935ef-0372-4879-836f-0fdf2de3d041",
                                                "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                                                "text": "„Ich war vollauf damit beschäftigt, Ben mit einem steifen Grog wieder auf die Beine zu bringen und Mrs. Hawkins ein Beruhigungsmittel zu verabfolgen.“"
                                            },
                                            {
                                                "example_id": "f2f26e3d-6f96-419b-96f8-47a12b88bdad",
                                                "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                                                "text": "„Eine Weile hatte ich sehr ernste und abgeklärte Gedanken, doch meine neuen Schiffskameraden, von denen einige tatsächlich alte Kameraden von anderen Seglern waren, konnten mich mit Grog aufmuntern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
