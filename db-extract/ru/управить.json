                    }
                ],
                "senses": [
                    {
                        "sense_id": "31d8e1fc-06dd-37c3-b9e7-5a054083266c",
                        "entry_id": "d1cb43c3-6001-37df-80a9-87964ec4e573",
                        "glosses": [
                            "устар. диал. осуществлять, выполнять какую-либо работу, справляться с каким-либо делом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b905749-7423-45c2-ba18-6979effbeffe",
                                "sense_id": "31d8e1fc-06dd-37c3-b9e7-5a054083266c",
                                "text": "У нас и своя есть работа, // Дай бог нам управить её!"
                            },
                            {
                                "example_id": "39eb8347-bf2c-4a4f-8127-14730bf17c43",
                                "sense_id": "31d8e1fc-06dd-37c3-b9e7-5a054083266c",
                                "text": "Ты овсеца бы савраске дала, // В лето один он управил, сердечный, // Пашни четыре тягла."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f824217-0a69-3fa0-bbd1-4017acd55ad5",
                        "entry_id": "d1cb43c3-6001-37df-80a9-87964ec4e573",
                        "glosses": [
                            "устар. диал. осуществлять уход, присмотр за кем-либо, приводить кого-либо в порядок, обхаживать кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "835dc64a-3b95-4641-a0e7-69e3c4e3fd3e",
                                "sense_id": "9f824217-0a69-3fa0-bbd1-4017acd55ad5",
                                "text": "Мужики вышли на двор управить на ночь скотину."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fd78aa3-9782-4082-8bca-236b516dbbbe",
                        "source_entry_id": "d1cb43c3-6001-37df-80a9-87964ec4e573",
