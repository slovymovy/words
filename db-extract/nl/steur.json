                        "source_entry_id": "f94d89ce-647b-37e4-ab6f-e5c30cab0713",
                        "source_sense_id": "77916b5f-41e8-37c3-8f77-fa109f7b7123",
                        "source_sense_description": "bepaald soort anadrome vis, Acipenser sturio",
                        "target_lang_word": "jesiotr",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jesiotr",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ac5347d6-d5a6-3344-8ad2-6e4ab4a8003f",
                                        "entry_id": "7f0cc933-6823-3316-b9a2-9cdd28333de0",
                                        "glosses": [
                                            "Acipenser Linnaeus, duża ryba wędrowna o wydłużonej głowie i szorstkiej, pokrytej płytkami kostnymi skórze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bce0d69-8701-4897-90cc-fc455fe5ee4e",
                                                "sense_id": "ac5347d6-d5a6-3344-8ad2-6e4ab4a8003f",
                                                "text": "Ja myślę, bez urazy jaśnie pana, że prędzej w pańskiej sadzawce zdybalibyśmy jesiotra aniżeli jedną sturublówkę w okolicy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "fc7cc926-f6a1-30a5-aeea-38279ec79393",
                                        "entry_id": "7f0cc933-6823-3316-b9a2-9cdd28333de0",
                                        "glosses": [
                                            "mięso lub potrawa z jesiotra (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f66fbce-468b-45a8-a855-82999baa0177",
                                                "sense_id": "fc7cc926-f6a1-30a5-aeea-38279ec79393",
                                                "text": "Dziś na obiad jest jesiotr w śmietanie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68ccfe17-447a-4a3a-aaa3-5983bbd1e83e",
                        "source_entry_id": "f94d89ce-647b-37e4-ab6f-e5c30cab0713",
                        "source_sense_id": "77916b5f-41e8-37c3-8f77-fa109f7b7123",
                        "source_sense_description": "bepaald soort anadrome vis, Acipenser sturio",
                        "target_lang_word": "осётр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "осётр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb13f65-e4d2-3a00-be30-1df63d9713c1",
                                        "entry_id": "6fde3f6e-8d35-31d1-a671-c39aa02b3a69",
                                        "glosses": [
                                            "ихтиол. крупная промысловая рыба семейства осетровых, ценная своим мясом и икрой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bc6113-898a-4205-86b5-3446f77d8e95",
                                                "sense_id": "7fb13f65-e4d2-3a00-be30-1df63d9713c1",
                                                "text": "У осетра хлопаются жабры, шевелятся вьюнами обвислые щупы-усы, смотрит он мутнеющим, пьяным взором укоризненно: что, дескать, с вами сделаешь? попался — ешьте, на то я и рыба."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546bacb3-90bd-3e19-bdb6-b1aa4014e43f",
                                        "entry_id": "6fde3f6e-8d35-31d1-a671-c39aa02b3a69",
                                        "glosses": [
                                            "мясо такой рыбы, употребляемое в пищу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820cda87-baf7-4812-a143-55d3be61c46b",
                                                "sense_id": "546bacb3-90bd-3e19-bdb6-b1aa4014e43f",
                                                "text": "Если зимой вернётся, вывалит среди избы из мешка мёрзло стучащих муксунов; если летом — просунув пальцы в трубой вытянутый рыбий рот, прёт через плечо матёрого осетра и с хрястом бросает его тоже среди избы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eedf6739-73e2-3381-9602-639395ad1b23",
                                        "entry_id": "6fde3f6e-8d35-31d1-a671-c39aa02b3a69",
                                        "glosses": [
                                            "кулин. кушанье, приготовленное из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11098892-3244-4e12-8206-62c714c72449",
                                                "sense_id": "eedf6739-73e2-3381-9602-639395ad1b23",
                                                "text": "Жихарь ещё подумал, слазил в заспинный мешок, сжевал чуть не половину осетра и принял решение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11ba87a8-4d99-3b31-b6f9-709294ed42bc",
                                        "entry_id": "6fde3f6e-8d35-31d1-a671-c39aa02b3a69",
                                        "glosses": [
                                            "разг. важное лицо, персона, особа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a71e5d2-a779-48d8-bc68-4c640afabb1f",
                                                "sense_id": "11ba87a8-4d99-3b31-b6f9-709294ed42bc",
                                                "text": "Вот Никита и пришёл за мной, чтобы я в «Дрезден» к ним завернул ублаготворить ихних гостей. Опять-таки моя глупость была: пошёл. Ну, прихожу это в номер и даже диву дался — таких два осетра, что даже попревосходнее галанцев настоящих будут. Как два дубовых корабельных бруса… ей-богу!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
