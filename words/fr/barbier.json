                        }
                    ]
                },
                {
                    "sense_id": "f95685b3-d1ac-3358-ac56-f228a6d61928",
                    "sense_definition": "Poisson marin osseux aux couleurs éclatantes, appartenant à la famille des serranidés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ichtyologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En plongeant près des rochers méditerranéens, nous avons observé un banc de <w>barbiers</w> rougeoyants."
                        },
                        {
                            "text": "Ce petit <w>barbier</w> se distingue nettement par sa nageoire dorsale très développée."
                        }
                    ]
                },
                {
                    "sense_id": "2bcdbeb7-517a-3123-9ed8-51758289cf13",
                    "sense_definition": "Petit poisson marin muni d'un disque ventral adhésif lui permettant de se fixer aux roches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ichtyologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>barbier</w> s'accroche solidement à la paroi rocheuse pour résister au courant marin."
                        },
                        {
                            "text": "Le biologiste marin étudiait ce <w>barbier</w> fixé sous une pierre à marée basse."
