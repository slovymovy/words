                        {
                            "text": "He needs to touch <w>grass</w> and reconnect with reality.",
                            "target_lang_translations": {
                                "ru": "Ему нужно потрогать <w>траву</w> и вернуться в реальность.",
                                "zh": "他需要去接触一下<w>现实</w>，重新回归正常生活。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "touch grass"
