                "translations": [
                    {
                        "translation_id": "2dbadda0-152a-4047-8901-b582875db946",
                        "source_entry_id": "485f639a-7984-3e03-9583-e76b018a9d68",
                        "source_sense_id": "d4222647-f6fb-3c30-a44e-56636017976c",
                        "source_sense_description": "Katholizismus: fähig, das Amt eines Papstes zu übernehmen; als Papst wählbar",
                        "target_lang_word": "papstfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papstfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed12919f-d579-39e6-af15-ee385d688950",
                                        "entry_id": "adeb9f34-6d83-3629-9307-71c7d24e61ad",
                                        "glosses": [
                                            "fähig, das Amt eines Papstes zu übernehmen; als Papst wählbar"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ff89a9-2dc4-43ab-853f-91944e713d0c",
                                                "sense_id": "ed12919f-d579-39e6-af15-ee385d688950",
                                                "text": "„Wer ist \"papabile\", also \"papstfähig\"?“"
                                            },
                                            {
                                                "example_id": "1329dad6-d218-4f2e-b7a5-3cdcee16721b",
                                                "sense_id": "ed12919f-d579-39e6-af15-ee385d688950",
                                                "text": "„Als \"papabile\" - \"papstfähig\" - gilt neben anderen der Nigerianer John Onaiyekan (links).“"
                                            },
                                            {
                                                "example_id": "d7fb701d-9a11-482d-bf2b-8a5f0f7aa2cc",
                                                "sense_id": "ed12919f-d579-39e6-af15-ee385d688950",
                                                "text": "„Doch Martini, der bis vor vier Jahren noch als „papabile“, papstfähig, galt, leidet an der Parkinson-Krankheit.“"
                                            },
                                            {
                                                "example_id": "ff2e38e0-e479-44b6-af77-68827a59865e",
                                                "sense_id": "ed12919f-d579-39e6-af15-ee385d688950",
                                                "text": "„Als \"papabile\" - papstfähig - gelten Kardinäle, denen die Führung der Kirche und eine Mehrheit zugetraut werden.“"
                                            },
                                            {
                                                "example_id": "d609c3d4-e3fa-431a-9977-b82b91d91770",
                                                "sense_id": "ed12919f-d579-39e6-af15-ee385d688950",
                                                "text": "Dennoch hat unter katholischen Amtsträgern in Rom in aller Stille eine kritische Sichtung papstfähiger Kandidaten begonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98a43a31-bb9f-41ca-89dd-fb8f908f3224",
                        "source_entry_id": "485f639a-7984-3e03-9583-e76b018a9d68",
