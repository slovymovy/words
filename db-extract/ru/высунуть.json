                        "entry_id": "5681312b-5ba1-395c-85c9-268e51e9148a",
                        "glosses": [
                            "to put out, to stick out, to thrust out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c6f6054-7900-4c96-88cb-149acd8eddfc",
                                "sense_id": "55fa2b9b-d2e4-3001-952f-0732a2386f9c",
                                "text": "вы́сунуть язы́к",
                                "translation": "to put/stick one's tongue out",
                                "english": "to put/stick one's tongue out"
                            },
                            {
                                "example_id": "84eeb4ac-f31e-4648-91d0-39912b29b90a",
                                "sense_id": "55fa2b9b-d2e4-3001-952f-0732a2386f9c",
                                "text": "нельзя́ но́су вы́сунуть (из до́му)",
                                "translation": "you can't even stick your nose out (of the house); you can't even show your face outside",
                                "english": "you can't even stick your nose out (of the house); you can't even show your face outside"
                            },
                            {
                                "example_id": "932b888d-988d-412e-997c-6eaa004b0529",
                                "sense_id": "55fa2b9b-d2e4-3001-952f-0732a2386f9c",
                                "text": "вы́сунув/вы́суня язы́к (о́чень бы́стро)",
                                "translation": "like mad; like a bat out of hell; with one's tongue hanging out",
                                "english": "like mad; like a bat out of hell; with one's tongue hanging out"
                            }
                        ]
                    }
                ],
