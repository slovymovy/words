                ],
                "senses": [
                    {
                        "sense_id": "fa316491-734e-30d6-b7a6-58141868970e",
                        "entry_id": "0d361f68-e093-3f45-8de5-c8f95696dcf4",
                        "glosses": [
                            "weibliche Person, die den Kriegsdienst verweigert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09ad023d-797d-4f0c-bb08-83c47cf974cd",
                                "sense_id": "fa316491-734e-30d6-b7a6-58141868970e",
                                "text": "„Wer aus Gewissensgründen unter Berufung auf das Grundrecht der Kriegsdienstverweigerung im Sinne des Artikels 4 Abs. 3 Satz 1 des Grundgesetzes den Kriegsdienst mit der Waffe verweigert, wird nach den Vorschriften dieses Gesetzes als Kriegsdienstverweigerin oder Kriegsdienstverweigerer anerkannt.“"
                            },
                            {
                                "example_id": "601417f8-f139-433c-a804-87871276f335",
                                "sense_id": "fa316491-734e-30d6-b7a6-58141868970e",
                                "text": "„Gegen Ende des Krieges begegnete er zum ersten Mal Kathleen Lonsdale, eine Kristallographin und Kriegsdienstverweigerin, die ins Gefängnis kam, weil sie sich weigerte, sich für den Kriegsdienst zu registrieren oder eine Strafe zu zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
