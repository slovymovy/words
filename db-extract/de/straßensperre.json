                        "entry_id": "fdb67396-61ac-3da8-b84a-2297c29e0c60",
                        "glosses": [
                            "Hindernis, das auf einer Straße aufgestellt wird und somit die Durchfahrt oder den Durchgang verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bbd8495-1720-44ec-939d-ac4481804e47",
                                "sense_id": "6b7b12ad-2aa2-3106-b41c-b8c221359916",
                                "text": "Die Polizei hat Straßensperren errichtet."
                            },
                            {
                                "example_id": "1f8f0197-c773-4d2b-9068-f18c2757e90c",
                                "sense_id": "6b7b12ad-2aa2-3106-b41c-b8c221359916",
                                "text": "„Von Jagow hatte seine kompletten Einsatzkräfte an wichtige Kreuzungen beordert und Straßensperren errichten lassen, um das Demonstrationsverbot durchzusetzen.“"
                            }
                        ],
