            "pos": "verb",
            "senses": [
                {
                    "sense_id": "729fea11-2f61-3e38-ad38-6aead965974d",
                    "sense_definition": "het verwijderen van stof van een oppervlak om het schoon te maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb vanmorgen alle oude boeken in de kast <w>afgestoft</w>.",
                            "target_lang_translations": {
                                "en": "I <w>dusted</w> all the old books in the cupboard this morning."
                            }
                        },
                        {
                            "text": "Vergeet niet om de meubels <w>af te stoffen</w> voordat de gasten vanavond aankomen.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>dust</w> the furniture before the guests arrive tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontstoffen",
                        "schoonmaken"
                    ],
                    "common_phrases": [
                        "meubels afstoffen",
                        "de kast afstoffen"
                    ],
                    "target_lang_definitions": {
                        "en": "removing dust from a surface to clean it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dust",
                                "target_lang_sense_clarification": "to remove dust from surfaces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea2f5951-9a70-3b5b-9763-7019fb2ffd79",
                    "sense_definition": "iets dat lange tijd niet is gebruikt of beoefend weer tevoorschijn halen of opfrissen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opfrissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet mijn kennis <w>afstoffen</w> van de Franse taal voor mijn vakantie naar Parijs.",
                            "target_lang_translations": {
                                "en": "I need to <w>brush up on</w> my knowledge of the French language for my holiday to Paris."
                            }
                        },
                        {
                            "text": "Na jaren van stilte besloot hij zijn oude plannen <w>af te stoffen</w> en een bedrijf te beginnen.",
                            "target_lang_translations": {
                                "en": "After years of silence, he decided to <w>dust off</w> his old plans and start a business."
                            }
                        }
                    ],
                    "synonyms": [
                        "opfrissen",
                        "actualiseren",
                        "revitaliseren"
                    ],
                    "antonyms": [
                        "vergeten",
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "kennis afstoffen",
                        "plannen afstoffen",
                        "vaardigheden afstoffen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak figuurlijk gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "bringing something back into use or refreshing a skill after a long period of inactivity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dust off",
                                "target_lang_sense_clarification": "to bring something back into use"
                            },
                            {
                                "target_lang_word": "brush up on",
                                "target_lang_sense_clarification": "to refresh knowledge or skills"
                            },
                            {
                                "target_lang_word": "revive",
                                "target_lang_sense_clarification": "to bring back an old plan or idea"
                            }
                        ]
                    }
                }
            ]
        }
    ]
