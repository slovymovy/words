                "senses": [
                    {
                        "sense_id": "728cda46-622a-318e-8dc3-7a8d578d9804",
                        "entry_id": "601917d9-23fc-3ec1-9f30-a990a0dc3973",
                        "glosses": [
                            "Brücke über den Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44eff6e0-607a-45ad-92b7-3b934ef232ef",
                                "sense_id": "728cda46-622a-318e-8dc3-7a8d578d9804",
                                "text": "„Er wollte zu ihr gehen, und als er immer schneller durch die nachtdunklen, verlassenen Straßen Orschas gegen die Dnjeprbrücke ging, wurde seine Sehnsucht immer größer und brennender, bis er schließlich beinahe lief.“"
                            },
                            {
                                "example_id": "5dd910ca-0d5e-4f7a-a2f4-8806b81b3cf9",
                                "sense_id": "728cda46-622a-318e-8dc3-7a8d578d9804",
                                "text": "„Schon sehen wir die beiden südlichen Dnjeprbrücken von Kiew, und schließlich taucht auch der Turm der Zitadelle auf.“"
                            },
                            {
                                "example_id": "51df1053-72b9-4a49-b809-b3bff62fe7b4",
                                "sense_id": "728cda46-622a-318e-8dc3-7a8d578d9804",
                                "text": "„Der Präsident des Handelszu ergreifen, um den Bau der Dnjeprbrücke, die nur zur Hälfte amts erklärte, seine Wege und Maßnahmen zu Erkundigungen fertig ist, zu beschleunigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
