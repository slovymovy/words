                "senses": [
                    {
                        "sense_id": "90d3469a-1e88-39a3-ba3d-372c71e10f5c",
                        "entry_id": "f63c1104-2e2d-38b4-b631-9b39acaadefe",
                        "glosses": [
                            "свойство по значению прилагательного строгий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a6925e5-83c5-4e11-a98a-11b3c0c832d5",
                                "sense_id": "90d3469a-1e88-39a3-ba3d-372c71e10f5c",
                                "text": "Но эти строгости со временем: стали послабляться и забываться."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ef98c66-83b2-302e-8431-08eb12d76f13",
                        "entry_id": "f63c1104-2e2d-38b4-b631-9b39acaadefe",
                        "glosses": [
                            "строгий поступок, строгое высказывание и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03d23642-a05a-42fe-a3c0-1f09e679c6cd",
                        "source_entry_id": "f63c1104-2e2d-38b4-b631-9b39acaadefe",
                        "target_lang_word": "Strenge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43f833d1-d0d8-38d0-ac57-8e5116a22bb4",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "harte, kompromisslose Auslegung von Regeln oder Moralvorstellungen"
                                        ],
                                        "tags": [
                                            "Geisteshaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32ff772-3db4-44ef-8999-98179c513453",
                                                "sense_id": "43f833d1-d0d8-38d0-ac57-8e5116a22bb4",
                                                "text": "Nie verstand sie die Strenge ihre Vaters, wenn sie ausserhalb des elterlichen Grundstücks spielen wollte."
                                            },
                                            {
                                                "example_id": "684cbaa7-6b39-4e59-a456-76b671aff81b",
                                                "sense_id": "43f833d1-d0d8-38d0-ac57-8e5116a22bb4",
                                                "text": "„Aber diese Strenge halte ich nicht lange aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9dfa5a1-1cf0-3bfd-9402-fad4ad6504da",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "exakte Gestaltung ohne Schnörkel"
                                        ],
                                        "tags": [
                                            "von einem Stil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c31cee5-0c95-4e5b-878b-061e60f4b611",
                                                "sense_id": "c9dfa5a1-1cf0-3bfd-9402-fad4ad6504da",
                                                "text": "Die brutalistische Architektur zeichnet sich durch ihre Strenge aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ca78439-1f94-331f-a554-977a12716746",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "unangenehme Intensität"
                                        ],
                                        "tags": [
                                            "von einem Geruch oder Geschmack"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a7deec-8b27-4e12-add9-ae49899c70f8",
                                                "sense_id": "4ca78439-1f94-331f-a554-977a12716746",
                                                "text": "An meinem ersten Tag als Tatortreiniger hielt ich die Strenge des Geruchs in der Wohnung der Toten kaum aus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6a3ddda9-204a-35d7-8b86-8e0be0c29700",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "unangenehme, harte Bedingungen"
                                        ],
                                        "tags": [
                                            "von einem Zeitabschnitt oder einer Jahreszeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac94171-d90c-4c83-8a0a-30dbe903a384",
                                                "sense_id": "6a3ddda9-204a-35d7-8b86-8e0be0c29700",
                                                "text": "Der Strenge des Winters hatten die Jungen der Fähe nur wenig entgegenzusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
