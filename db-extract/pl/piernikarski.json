                "senses": [
                    {
                        "sense_id": "8667c47f-633a-37be-813e-1ef279956833",
                        "entry_id": "7959fd6f-de0a-3f3f-b0c3-cf1e807d3989",
                        "glosses": [
                            "od piernikarz lub piernikarstwo"
