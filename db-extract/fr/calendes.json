        "fr-extract.jsonl": [
            {
                "entry_id": "f6c3bf3c-3015-3aea-a7d2-4e8650f14d55",
                "word": "calendes",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f054880-4d8b-3e28-acce-8826e15d3236",
                        "entry_id": "f6c3bf3c-3015-3aea-a7d2-4e8650f14d55",
                        "glosses": [
                            "Le premier jour de chaque mois dans le calendrier romain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e816ef-ba6c-45fe-be63-833f8a5da82d",
                                "sense_id": "4f054880-4d8b-3e28-acce-8826e15d3236",
                                "text": "Néron naquit à Antium, neuf mois après la mort de Tibère, dix-huit jours avant les calendes de janvier, précisément au lever du soleil, en sort qu’il fut frappé de ses rayons presque avant la terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d6f98f3-9f2e-33bd-857e-6d6b184a32c4",
                        "entry_id": "f6c3bf3c-3015-3aea-a7d2-4e8650f14d55",
                        "glosses": [
                            "Assemblée de curés convoqués par leur évêque."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00c0b5db-b55a-4854-8e4f-3b68479b5e76",
                        "source_entry_id": "f6c3bf3c-3015-3aea-a7d2-4e8650f14d55",
                        "target_lang_word": "Kalenden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a929299c-88d0-4198-979b-69c26767caac",
                        "source_entry_id": "f6c3bf3c-3015-3aea-a7d2-4e8650f14d55",
                        "target_lang_word": "calends",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calends",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                        "entry_id": "5615abce-e0a0-3cb3-9ed8-07eb98e7e375",
                                        "glosses": [
                                            "Often with initial capital: the first day of a month."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc16758-130c-49f1-ae9e-a5f557c626d7",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "The third day before the calends of February is 30 January, the third calends of March is 27 or 28 February, and the third of the calends of May is 29 April."
                                            },
                                            {
                                                "example_id": "1fd13059-04e6-429e-b39b-9a2cfbcaf821",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "The Roman Month its ſeveral days divides / By reckoning backwards, Calends, Nones, and Ides."
                                            },
                                            {
                                                "example_id": "c2cd87f8-5141-44d4-8094-8f73cfdb4bec",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "Now by the ſame Rule, if there was a very Ancient Folkmote in the Neighbouring Kingdom of France upon every Kalends of May, then perhaps King Arthur borrowed from them; and it is good to look upon our Kalends, becauſe it is poſſible they may give Light to Ours."
                                            },
                                            {
                                                "example_id": "ac9974e5-90da-48fc-8e10-2711ffe1f7ef",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "The Poſt of ſwift-foot Time / Hath now at length begun / The Calends of our middle Age, / Our bloſſoms they are gone."
                                            },
                                            {
                                                "example_id": "31733e96-9a9e-42d6-847f-49dcd72253d3",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "The Romans did not, as we do, count the days of the month in a regular numerical succession, but reckoned them with reference to three principal points of time—the Calends, the Nones, and Ides. The first day of every month was entitled its Calends. […] The Calends were originally the day of the new moon, which received its name from the fact that on that day the Pontifex addressed the moon in presence of the people, in the words \"Calo te, Jana Novella,\" \"I call upon thee, new moon,\" which was repeated as many times as intimated to his hearers the number of days before the arrival of the Nones."
                                            },
                                            {
                                                "example_id": "3a0f7598-7516-4a25-87da-f466b08101b9",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "Let it not be lawful to use wicked observations of the calends, and to keep the gentiles' holy-days, nor to deck houses with bays or green boughs; for all this is an heathenish observation."
                                            },
                                            {
                                                "example_id": "e08ea2f0-9f60-4474-9811-ce4e2e958d4f",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "Among the ancient Romans it was an annual institution for every family to give a banquet, to which only near relatives were bidden. On this occasion family feuds were healed, and all envy, hatred, and malice, laid aside; as an emblem of restored harmony, gifts were interchanged. This ceremony took place during the festival known as Carisia, held in honour of the goddess Concord, and was celebrated during the eight days preceding the Calends of March (February 22 to March 1)."
                                            },
                                            {
                                                "example_id": "b20dd47b-d340-4aaf-868d-181fc243a7a5",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "If January calends be summerly gay, / 'Twill be winterly weather till the calend of May."
                                            },
                                            {
                                                "example_id": "5f077e09-5a94-4f63-9d71-eee2b740a4a8",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "Blockheads, friends of my heart and liver, cousins of my tripe, are you ignorant that this symposium is as authentic as any of those tales of the Greek Calends, which you swallow and digest so easily,[…]?"
                                            },
                                            {
                                                "example_id": "43b1e2c6-9f9c-4f27-b56a-b31c1cf6d5f5",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "My book with Professor [John Ronald Reuel] Tolkien – any book in collaboration with that great but dilatory and unmethodical man – is dated, I fear, to appear on the Greek Kalends!"
                                            },
                                            {
                                                "example_id": "05740f01-d7dc-46e5-ada4-0ea34f2213cc",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "The interesting thing about these ceremonies is that they must have originated in a period when the Romans were using true lunar months based on the observation of the crescent moon. The Kalends then would have been the day after the evening on which the crescent had been first sighted, the Nones would have been the first day when the moon was at the first quarter […] In the calendar of the late Republic the lunar months have disappeared and the days have been fixed into a rigid pattern."
                                            },
                                            {
                                                "example_id": "340afff7-c9f4-4091-b517-bd4819c2d80f",
                                                "sense_id": "3b25b9ba-70fd-393c-a324-b6e1d441dbc1",
                                                "text": "[March, May, Quintilis, and October] also have their Nones on the seventh, as Numa [Pompilius] ordained, because Julius Caesar changed nothing about them. As for January, Sextilis, and December, they still have their Nones on the fifth, though they began to have thirty-one days after Caesar added two days to each, and it is nineteen days from their Ides to the following Kalends, because in adding the two days Caesar did not want to insert them before either the Nones or the Ides, lest an unprecedented postponement mar religious observance associated with the Nones or Ides themselves, which have a fixed date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca969320-9c51-3ea2-9a35-1cf8c18be9ca",
                                        "entry_id": "5615abce-e0a0-3cb3-9ed8-07eb98e7e375",
                                        "glosses": [
                                            "Often with initial capital: the first day of a month.",
                                            "The first day of a month of the Roman calendar."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "702f5812-8ea8-3186-bf1e-14c14205a7e2",
                                        "entry_id": "5615abce-e0a0-3cb3-9ed8-07eb98e7e375",
                                        "glosses": [
                                            "A day for settling debts and other accounts."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62911b0d-6c1f-4325-b10b-25367e49b6f0",
                                                "sense_id": "702f5812-8ea8-3186-bf1e-14c14205a7e2",
                                                "text": "To expedite theſe knots were worthy a learned and memorable Synod; while our enemies expect to ſee the expectation of the Church tir'd out with dependencies and independencies how they will compound, and in what Calends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d194155-1b7a-36bc-a785-ebf9038e6212",
                                        "entry_id": "5615abce-e0a0-3cb3-9ed8-07eb98e7e375",
                                        "glosses": [
                                            "Synonym of Rosh Hodesh (“the Jewish festival of the new moon, which begins the months of the Hebrew calendar”)."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "broadly",
                                            "obsolete",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "803fed00-9164-4e20-810d-8e3284e1baeb",
                                                "sense_id": "9d194155-1b7a-36bc-a785-ebf9038e6212",
                                                "text": "The feasts of the Israelites were the Sabbath; the first day of each month, called in our translations calends, or new-moon; the three great feasts of the passover, pentecost, and tabernacles, instituted in memory of the three greatest blessings they received from God, […]"
                                            },
                                            {
                                                "example_id": "f8272031-e852-4d6d-b280-5dc700e0d2c7",
                                                "sense_id": "9d194155-1b7a-36bc-a785-ebf9038e6212",
                                                "text": "חֹדֶשׁ m. […] the new moon, the day of the new moon, the calends of a lunar month which was a festival of the ancient Hebrews, Num[bers] 29:6; 1 Sam[uel] 20:5; 18:24; Ex[odus] 19:1, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c4ab1a-3551-3c28-92f6-fb64c319f962",
                                        "entry_id": "5615abce-e0a0-3cb3-9ed8-07eb98e7e375",
                                        "glosses": [
                                            "Synonym of calendar; (figurative) an account, a record."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accf2ff4-0123-47fc-b36b-dd4e67301109",
                                                "sense_id": "f5c4ab1a-3551-3c28-92f6-fb64c319f962",
                                                "text": "[N]ow doth [John] Oldcastle shine: / Him for a Saint within your Kalends hold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa6b03d-f9cf-3102-8538-9a11e2906483",
                                        "entry_id": "5615abce-e0a0-3cb3-9ed8-07eb98e7e375",
                                        "glosses": [
                                            "The first day of something; a beginning."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22f6d98-e305-4011-af17-ff21f707fd0c",
                                                "sense_id": "daa6b03d-f9cf-3102-8538-9a11e2906483",
                                                "text": "Whoever shall sell a calf or a yearling, let him be answerable against the scab from the calends of winter until the Feast of Patrick."
                                            }
                                        ]
                                    }
                                ]
                            },
