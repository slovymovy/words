                ],
                "translations": [
                    {
                        "translation_id": "06a4daf0-ca2c-4980-9737-59403ee988ab",
                        "source_entry_id": "2f0590a1-93a1-3f0f-9024-2f8cda9026de",
                        "source_sense_id": "3a5ebadb-178c-3dba-9493-377465a62c38",
                        "source_sense_description": "großes, asiatisches Wildrind",
                        "target_lang_word": "gaur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba69eba1-4b6c-3fd1-b792-472f7a4e1a3b",
                                        "entry_id": "0a07552f-6e46-3567-98dd-f3e20ef69d68",
                                        "glosses": [
                                            "An Asian species of wild bovine (Bos gaurus), of large size and an untamable disposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f34191-0715-4cb4-8745-6919b63e5475",
                                                "sense_id": "ba69eba1-4b6c-3fd1-b792-472f7a4e1a3b",
                                                "text": "[…] I am sure that the American bison is the grandest of them all. His only rivals for the kingship are the Indian bison, or gaur (Bos gaurus), of Southern India, and the aurochs, or European bison, both of which really surpass him in height, if not in actual balk also."
                                            },
                                            {
                                                "example_id": "739da83d-9416-4aa5-822e-28429b53738a",
                                                "sense_id": "ba69eba1-4b6c-3fd1-b792-472f7a4e1a3b",
                                                "text": "Of the other ruminants the ox, buffalo, yak, goat, sheep and a few others are domestic animals, while the bison and the gaur, or so-called Indian bison, and a large number of wild goats and sheep have been neglected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f6055e7-7c36-41a7-a65f-24acf4cee2b9",
                        "source_entry_id": "2f0590a1-93a1-3f0f-9024-2f8cda9026de",
                        "source_sense_id": "3a5ebadb-178c-3dba-9493-377465a62c38",
                        "source_sense_description": "großes, asiatisches Wildrind",
                        "target_lang_word": "gaur",
