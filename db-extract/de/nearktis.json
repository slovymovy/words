                                            {
                                                "example_id": "3ebc4584-9ac9-4722-8354-befff4191116",
                                                "sense_id": "26205b11-b703-333a-bb59-250906b0ccc0",
                                                "text": "Présence en France et en Corse d’un Hétéroptère néarctique, Belonochilus numenius (Say, 1831)"
                                            }
