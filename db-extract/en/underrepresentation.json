                        "glosses": [
                            "Insufficient or disproportionately low representation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2d1c4e18-9b27-4d14-b0a4-e6dda126e7f1",
                                "sense_id": "08def920-c173-39ff-a80b-d3268a714585",
                                "text": "We are concerned about the underrepresentation of minorities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d31e5a4-6cce-4428-ab9a-c036732817d9",
