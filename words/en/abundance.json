                    "sense_id": "5bd2f830-cd48-3107-9cd1-887ab296bcb1",
                    "sense_definition": "A very large quantity of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
