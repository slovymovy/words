                ],
                "senses": [
                    {
                        "sense_id": "7fa4e313-eb65-32dd-b129-e1eb580421b5",
                        "entry_id": "dc4285e6-c56f-3ba1-a3b2-a0b316620285",
                        "glosses": [
                            "The governor or commander of a Spanish or Portuguese fortress or prison."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "cda6ccc6-4103-48e3-82d5-22addc72d8b5",
                                "sense_id": "7fa4e313-eb65-32dd-b129-e1eb580421b5",
                                "text": "Soon after Mr. Petticrew arrived at Gibraltar, he came to Tetuan in his majeſty's ſhip Seahorſe, to acquaint the alcaide that he had orders from the king of Great Britain,[…]."
                            },
                            {
                                "example_id": "e0f6bab7-a7d5-48eb-b05a-9e8da9a78e6e",
                                "sense_id": "7fa4e313-eb65-32dd-b129-e1eb580421b5",
                                "text": "1810, John Joseph Stockdale (editor and publisher), The History of the Inquisitions, extract published in 1810, The Literary Panorama, and National Register, Volume 8, page 219,\nIt was, above all, to the alcaide and the guards of the prisoners that he studied to recommend himself."
                            },
                            {
                                "example_id": "9a1e159e-6eaa-4eb3-b7b8-e89d6ddcf101",
                                "sense_id": "7fa4e313-eb65-32dd-b129-e1eb580421b5",
                                "text": "The municipal bodies were charged regularly to inspect the prisons; to watch over the conduct of the alcaides, and the inferior officers; and to propose to the government such measures as they judged to be best conducive to humanity and sound policy."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ad1c4f8-f068-3f2a-95b0-c2880e7ae7ae",
                        "entry_id": "dc4285e6-c56f-3ba1-a3b2-a0b316620285",
                        "glosses": [
                            "A caid."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87259d6f-ebc9-45ba-ad89-86e445550b5e",
                        "source_entry_id": "dc4285e6-c56f-3ba1-a3b2-a0b316620285",
                        "source_sense_description": "governor or commander of a Spanish or Portuguese fortress",
                        "target_lang_word": "alcade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43372382-074b-3b8f-a77c-8d8f0bf8d7dc",
                                        "entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                                        "glosses": [
                                            "Juge ou magistrat d’Espagne, dont l’attribut distinctif est une longue batte blanche."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d177dccc-6631-4c7a-a603-0009aab71578",
                                                "sense_id": "43372382-074b-3b8f-a77c-8d8f0bf8d7dc",
                                                "text": "DON CARLOS. Je te fais alcade du palais."
                                            },
                                            {
                                                "example_id": "ae0c025b-c763-4bfe-836f-e525151f87f5",
                                                "sense_id": "43372382-074b-3b8f-a77c-8d8f0bf8d7dc",
                                                "text": "Nous y rencontrâmes quelques alcades des environs, dont la physionomie eût paru suspecte au coin d’un bois, et qui auraient bien fait de se demander leurs papiers à eux-mêmes avant de se laisser circuler librement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c7e549-d60e-34f9-88e7-7e0cf01aff2d",
                                        "entry_id": "95ae10c7-f90f-38c5-83b0-013ef9e40934",
                                        "glosses": [
                                            "Maire en Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a2280bc-06f6-4c13-ba9e-99e3ac2716d0",
                                                "sense_id": "26c7e549-d60e-34f9-88e7-7e0cf01aff2d",
                                                "text": "L’on a vu des taureaux de muchas piernas (de beaucoup de jambes), comme on les appelle techniquement, franchir la seconde enceinte, comme en fait foi une gravure de la Tauromaquia de Goya, le célèbre auteur des Caprices, gravure qui représente la mort de l’alcade' de Torrezon, misérablement embroché par un taureau sauteur."
                                            },
                                            {
                                                "example_id": "204018f2-3708-4145-94e3-0cba1bd8ad4e",
                                                "sense_id": "26c7e549-d60e-34f9-88e7-7e0cf01aff2d",
                                                "text": "Mais, sire, nous étions mariés devant l‘alcade et devant le prêtre. Elle a juré sur l’Évangile…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
