                        "entry_id": "b2782e10-bc64-3697-9d63-4a8637ed3554",
                        "glosses": [
                            "A small cup, usually with a handle, commonly used for drinking tea; normally sits in a saucer as part of a tea set."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e254c79f-f4aa-43b1-bdd1-b831f18bd581",
                                "sense_id": "fe9d102f-1b09-36c5-82bd-b1ef986b6a4c",
                                "text": "\"There isn't wind enough to capsize a tea-cup in a gutter,\" said Rasmus, and shifted his chew of tobacco with a little black chalk pipe, while he looked around him on all sides."
                            }
                        ]
                    },
