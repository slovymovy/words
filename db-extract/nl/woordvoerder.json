                    },
                    {
                        "form_id": "611d5786-c4a2-4cc8-a233-86fbedf4ef75",
                        "entry_id": "576328ff-9a58-3974-8cc0-b47e88d5a045",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "woordvoerdertjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                        "entry_id": "576328ff-9a58-3974-8cc0-b47e88d5a045",
                        "glosses": [
                            "een persoon die namens anderen spreekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de61873b-d256-4015-a10c-6a929d48781d",
                                "sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                                "text": "De woordvoerder ontweek de aanvallende vraag."
                            },
                            {
                                "example_id": "58f311df-4eea-40c3-abf0-328218619f4a",
                                "sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                                "text": "Voor de rest van de grootschalige openluchtschermen is geen alternatief, wat het Arenapark tot de enige keuze maakt. 'Maar er kunnen zo'n 55.000 tot 60.000 mensen op het terrein. Ik neem aan dat dat genoeg is,' zegt een woordvoerder van de gemeente."
                            },
                            {
                                "example_id": "abdea170-e77a-47ce-a582-357b099b412b",
                                "sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                                "text": "Een woordvoerder van de luchtvaartmaatschappij zei op zaterdag: ,,Alle passagiers kregen een diner. De passagiers die niet meer meekonden, werden voorzien van vervoer en hotelaccommodatie en zullen op de volgende beschikbare vlucht worden gezet. PIA betreurt het ongemak dat haar passagiers als gevolg van dit incident is overkomen.”"
                            },
                            {
                                "example_id": "d93af7c2-c5fd-4be7-9832-3ff81fbb300a",
                                "sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                                "text": "De fabrikant van het kunsthart heeft bij de Inspectie Gezondheidszorg en Jeugd een melding gemaakt van het overlijden van de patiënt, zo bevestigt de inspectie na berichtgeving van het EO-programma Dit is de Kwestie. De ontwikkelaar van het kunsthart is het Franse biomedische bedrijf Carmat. Het gaat om een verplichte melding, aldus de inspectie. Over de inhoudelijke behandeling wil een woordvoerder niets zeggen."
                            },
                            {
                                "example_id": "2d3356fd-acff-4144-8355-361b73d1a976",
                                "sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                                "text": "De ANWB zegt dat \"het klopt wat de rechter doet\", maar hoe dat in de praktijk voelt, is volgens een woordvoerder een andere zaak. \"Volgens de belastingwetgeving moet je betalen voor het parkeren, maar als er nog veel tijd over is op je kaartje voelt dat niet goed.\" De ANWB wil dan ook dat er zo snel mogelijk wordt overgegaan op een systeem van betalen voor de daadwerkelijke parkeertijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce4a0356-2821-4613-8b10-aa0be023be0c",
                        "source_entry_id": "576328ff-9a58-3974-8cc0-b47e88d5a045",
                        "source_sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                        "source_sense_description": "persoon",
                        "target_lang_word": "Sprecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Person, die spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fccede1-d511-4d7a-8e3e-520abe006be7",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "Der Sprecher dieser Sprachaufnahme hat eine besonders angenehme Stimme."
                                            },
                                            {
                                                "example_id": "b820af6e-7935-4ab6-b86e-c5ce62dfd533",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "„Der Wunsch vieler Schreiber und Sprecher nach Normierung und damit Orientierung muss als wichtiges Bedürfnis wahrgenommen und akzeptiert werden.“"
                                            },
                                            {
                                                "example_id": "c6dbc163-a1d5-46b5-b08f-630a3b2ef3ea",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "„Es gibt zahlreiche weitere Demonstrationsbeispiele, die uns gute Einblicke in die Unsicherheiten von Sprecherinnen und Sprechern vermitteln.“"
                                            },
                                            {
                                                "example_id": "a8cae3a4-7bec-45a7-8e40-49321075854e",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "„Die Fähigkeit des Sprechers, über die Regeln der Sprache nachzudenken und somit seine eigene Sprache wie auch die der anderen zu beurteilen, hat in der linguistischen Theoriebildung methodologisch eine wichtige Rolle gespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3338322f-7c81-366d-a6d0-0ec0d1875495",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Person, die beauftragt ist, für andere zu sprechen/Person, die gewählt ist, um für einen Vorstand oder andere Gremien zu sprechen; Amt oder Ehrenamt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3aa9f9-3150-4aed-a06e-1d2f8c5cff79",
                                                "sense_id": "3338322f-7c81-366d-a6d0-0ec0d1875495",
                                                "text": "Wir haben Hans zu unserem Sprecher bestimmt."
                                            },
                                            {
                                                "example_id": "5697f2a6-a1a3-4305-8cae-e996d823aeb2",
                                                "sense_id": "3338322f-7c81-366d-a6d0-0ec0d1875495",
                                                "text": "Da Walter nun schon in Berlin wohnt, kann er auch Sprecher in einem Ministerium werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e1c3a0ea-0d8e-30c7-bf41-bdf4ab388a7e",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Ansager/Kommentator/Erzähler/Moderator bei Rundfunk, Film, Fernsehen, Internetproduktionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3661a6a9-44e0-40f6-8460-cff293e52f88",
                                                "sense_id": "e1c3a0ea-0d8e-30c7-bf41-bdf4ab388a7e",
                                                "text": "Der Sprecher hat sich ein paar Mal versprochen, da er mehrere Nachtschichten hinter sich hat und nicht konzentriert genug ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Person, die in der Lage ist, eine bestimmte Sprache zu sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0c1a9e-679d-408c-8f93-0ef5b7081bea",
                                                "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                                "text": "Er ist ein hervorragender Sprecher des Französischen."
                                            },
                                            {
                                                "example_id": "46e48422-1fdb-4b59-b18a-1b8f7699ea36",
                                                "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                                "text": "Wie viele Sprecher hat eigentlich das Armenische?"
                                            },
                                            {
                                                "example_id": "fff9fc33-4c6d-4ca6-bb85-70e86722a352",
                                                "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                                "text": "„So ist grundsätzlich die Rolle der Sprache für die Identität ihrer Sprecherinnen und Sprecher kaum zu überschätzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "865827fc-a49f-4215-8a2b-adc62f2f2fd1",
                        "source_entry_id": "576328ff-9a58-3974-8cc0-b47e88d5a045",
                        "source_sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                        "source_sense_description": "persoon",
                        "target_lang_word": "Pressesprecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pressesprecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "812eda17-7203-3e27-bd9d-150d788d1cd9",
                                        "entry_id": "00237b6c-c4a4-3072-a524-1f406665c10c",
                                        "glosses": [
                                            "Zuständiger einer Organisation, einer Firma, eines Unternehmen, einer Behörde oder Ähnlichem, der die Aufgabe hat, die Sichtweise seines Arbeitgebers in der Öffentlichkeit (zum Beispiel gegenüber den Medien) zu vertreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ae62ec-f12a-4324-be80-5a3523925003",
                                                "sense_id": "812eda17-7203-3e27-bd9d-150d788d1cd9",
                                                "text": "Der Pressesprecher verweigerte, im Namen seiner Firma, jede Auskunft."
                                            },
                                            {
                                                "example_id": "41d43617-57eb-42b8-ba1f-5e896f3b1d57",
                                                "sense_id": "812eda17-7203-3e27-bd9d-150d788d1cd9",
                                                "text": "Die Pressesprecher der jeweiligen Behörde gaben eine Pressekonferenz."
                                            },
                                            {
                                                "example_id": "604cf5c4-1816-410d-9f4e-3b04d0158576",
                                                "sense_id": "812eda17-7203-3e27-bd9d-150d788d1cd9",
                                                "text": "„Auf der anderen Seite bereiten sich der Interviewpartner und sein Pressesprecher oder andere Berater auf das Gespräch vor.“"
                                            },
                                            {
                                                "example_id": "597a38a9-a638-49fd-a3ec-2d1bcce9cfbc",
                                                "sense_id": "812eda17-7203-3e27-bd9d-150d788d1cd9",
                                                "text": "„Papens Pressesprecher Herbert von Bose, Nationalist, aber kein Nazi, wird in seinem Büro von SS-Männern erschossen, man spricht von einem Unfall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cadb5d4d-2732-445b-b29d-ead57b9aaa96",
                        "source_entry_id": "576328ff-9a58-3974-8cc0-b47e88d5a045",
                        "source_sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                        "source_sense_description": "persoon",
                        "target_lang_word": "Wortführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7f1943-a8b2-3b84-af23-c9f69c918459",
                                        "entry_id": "6a210fa8-65e1-3663-84ba-0913324d101e",
                                        "glosses": [
                                            "jemand, der im Namen einer Gruppe spricht, verhandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8586cdf-45d1-4946-95c4-55c482b21182",
                                                "sense_id": "6f7f1943-a8b2-3b84-af23-c9f69c918459",
                                                "text": "„Hannu Haverinnen, der Wortführer, ist einer der Kläger und hat kein Zutrauen in die Vernunft der Konzerne.“"
                                            },
                                            {
                                                "example_id": "d53d5c41-5655-4074-9372-3083d2de3e06",
                                                "sense_id": "6f7f1943-a8b2-3b84-af23-c9f69c918459",
                                                "text": "„Dieses Denkmuster wird auch von intellektuellen Wortführern der Islamkritik bestätigt - obwohl sie sich als Verteidiger liberaler Werte verstehen.“"
                                            },
                                            {
                                                "example_id": "3b2b97de-bf08-48e2-8d93-9d63ccee990a",
                                                "sense_id": "6f7f1943-a8b2-3b84-af23-c9f69c918459",
                                                "text": "„Es war schwer zu sagen, ob er der ältere war, doch war er jedenfalls der Wortführer.“"
                                            },
                                            {
                                                "example_id": "7ba9cc70-b7dc-4796-bf2c-9c86623753c6",
                                                "sense_id": "6f7f1943-a8b2-3b84-af23-c9f69c918459",
                                                "text": "„Lumumba lernt Joseph Kasavubu kennen, den späteren Präsidenten und wichtigsten Wortführer der kleinen schwarzen politischen Klasse.“"
                                            },
                                            {
                                                "example_id": "a81bb38d-78db-49b3-af0d-94fbc63e212e",
                                                "sense_id": "6f7f1943-a8b2-3b84-af23-c9f69c918459",
                                                "text": "„So erging es Surendranath Banerjee, der dann zum bedeutendsten Wortführer des frühen indischen Nationalismus wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "014deb54-75db-4d8b-bbca-1e937a054d1e",
                        "source_entry_id": "576328ff-9a58-3974-8cc0-b47e88d5a045",
                        "source_sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                        "source_sense_description": "persoon",
                        "target_lang_word": "spokesperson",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spokesperson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0e42cc-50c4-3445-9abc-fbe54674268f",
                                        "entry_id": "97add15c-d80f-3041-910f-d70cf90b64cf",
                                        "glosses": [
                                            "A person who acts as the voice of another person or a group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b239f591-a174-4c5b-8c4d-90824406cbf4",
                                                "sense_id": "bc0e42cc-50c4-3445-9abc-fbe54674268f",
                                                "text": "News subsidies thus include making spokespersons available, producing press releases or staging pseudo-events designed to suit the media's production needs and attract the media's attention […]"
                                            },
                                            {
                                                "example_id": "6271bbf3-fb62-4c2e-8348-72bdaf84effc",
                                                "sense_id": "bc0e42cc-50c4-3445-9abc-fbe54674268f",
                                                "text": "Biden and his spokespeople have proudly touted his signature COVID relief bill as a major stimulus for policing in a national context already characterized by globally unparalleled police spending."
                                            },
                                            {
                                                "example_id": "ddcd8df0-3b0e-44b8-9925-ff46549954a3",
                                                "sense_id": "bc0e42cc-50c4-3445-9abc-fbe54674268f",
                                                "text": "A Police Scotland spokesperson said: “We were made aware of concern for a group of three hillwalkers who had not returned from the Aonach Eagach ridge in Glen Coe shortly after 9.05pm on Saturday 5 August."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24b625fb-aac0-4e8e-8030-c1246cf840f2",
                        "source_entry_id": "576328ff-9a58-3974-8cc0-b47e88d5a045",
                        "source_sense_id": "dd1beb14-869b-33fc-add1-9ff57c5090ab",
                        "source_sense_description": "persoon",
                        "target_lang_word": "porte-parole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porte-parole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                        "entry_id": "5ebff3e2-3c36-3d15-a64b-d9484e7f1025",
                                        "glosses": [
                                            "Celui qui porte la parole, les revendications, les doléances, pour une assemblée, pour une compagnie, pour une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7fbecb-bead-482e-aa11-8145497eaffc",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "Si Dris Ben-Aâlem, le caïd el-mechouar, gouverneur de la cour, commandant de la garde chérifienne, porte-parole du Sultan, était un mulâtre gigantesque à voix stentorienne."
                                            },
                                            {
                                                "example_id": "d036dcd9-5f04-44c6-b5aa-7b2ecc05bd41",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "Cette mécanique que Buridan enseignait rue du Fouarre, aux environs de 1350, pénétra dans l’Italie de la Renaissance, par l’entremise de Jules César Scaliger, qui en fut le porte-parole."
                                            },
                                            {
                                                "example_id": "3e1ff634-f800-4d74-aca2-27132957b170",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "Fils d’une humble famille du Rethélois, ce paysan devait atteindre aux plus hautes fonctions, représenter la pensée de la France et de la « chrestienté », et, devant le monde, être leur porte-parole."
                                            },
                                            {
                                                "example_id": "cd2ea883-550c-4a45-a751-dacfdbde06ed",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "« Nous disposons de politiques strictes en matière de commentaires et retirons proactivement les commentaires qui enfreignent ces règles », indique un porte-parole d’Amazon."
                                            },
                                            {
                                                "example_id": "eaa23927-6ea3-4b98-9f55-51cf7a93c9c6",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "« Je suis scandalisé de voir qu’on fait subir à des enfants victimes ce qu’on n’oserait pas faire subir à des victimes adultes », dénonce Emmanuel Garot, un des porte-parole de la fédération de parents Peep."
                                            },
                                            {
                                                "example_id": "a3917fd8-b8ec-49bb-a67d-0ca1a8c7d58c",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "Les résultats montrent, de façon générale, que les porte-paroles patronaux et syndicaux adhèrent à des valeurs différentes en ce qui a trait à la négociation et à son dénouement."
                                            },
                                            {
                                                "example_id": "81ebe6b7-a569-4215-9385-94ad752826d6",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "Dès la création de la DICoD, en 1999, la rédaction des « éléments de langage » est en effet réalisée systématiquement par les membres du Bureau porte-parole, (...), pour la préparation de chaque point-presse hebdomadaire coordonné par le Délégué porte-parole du ministère. Le format des « éléments de langage » est en l’occurrence précisément établi et répond à des critères de structuration et d’écriture, qui les rendent d’ailleurs reproductibles par différents agents : « une ou plusieurs citations en constituent le chapeau introductif, encadré et/ou en caractères gras (...), puis le propos est décliné en différents points, à la manière d’un plan détaillé »."
                                            },
                                            {
                                                "example_id": "a5aa946d-8463-423b-a956-eef9810ae9a4",
                                                "sense_id": "15f04fea-fecc-3a42-8342-2be6fd597d18",
                                                "text": "Le lendemain, on apprenait par l’agence allemande DPA qu’elle avait été hospitalisée pendant une semaine, alors que ses porte-parole n’avaient jamais évoqué cette situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b62081d-cbec-33c9-9011-07446e0c8abb",
                                        "entry_id": "5ebff3e2-3c36-3d15-a64b-d9484e7f1025",
                                        "glosses": [
                                            "Objet qui exprime une réalité plus vaste que lui-même, liée à un peuple ou une époque."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c3a6bd-4147-4f1a-9680-9c817835f846",
                                                "sense_id": "8b62081d-cbec-33c9-9011-07446e0c8abb",
                                                "text": "Chaque objet découvert dans la tombe devient alors porte-parole de son temps et offre l'opportunité de compenser le silence des sources textuelles."
                                            }
                                        ]
                                    }
                                ]
                            },
