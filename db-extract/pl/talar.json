                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "121a10b5-afc3-355f-a59d-4fc55ebacab2",
                                        "entry_id": "1c22ce2e-34b2-3545-8928-5ea32821b292",
                                        "glosses": [
                                            "истор. название крупной серебряной монеты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73396430-3086-40c1-aa0a-f0535278f7b1",
                                                "sense_id": "121a10b5-afc3-355f-a59d-4fc55ebacab2",
                                                "text": "А давали нам за всякую убитую яныческу голову по золотому червонному, а за полковниковы головы давали по сту талеров."
                                            },
                                            {
                                                "example_id": "c78c5c60-2d74-44a2-8b35-108674ce6a7e",
                                                "sense_id": "121a10b5-afc3-355f-a59d-4fc55ebacab2",
                                                "text": "Везде слышишь немецкий язык — где-где русский, — и везде требуют не рублей, а талеров."
                                            }
                                        ]
                                    }
                                ]
                            },
