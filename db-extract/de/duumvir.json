                "senses": [
                    {
                        "sense_id": "8f7260d1-0081-3a2b-804e-096dc5466c3e",
                        "entry_id": "60609420-5047-380d-a4fd-c4593ac5bee8",
                        "glosses": [
                            "Beamter einer aus zwei Verwaltungsbeamten bestehenden Behörde im Römischen Reich"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fd57d4a7-b2d9-4509-9da7-9c3c5e8841fc",
                                "sense_id": "8f7260d1-0081-3a2b-804e-096dc5466c3e",
                                "text": "„Viator, der Duumvir möchte dich sprechen!“"
                            },
                            {
                                "example_id": "bc6ee11a-7d9a-4929-977f-fd7c5e05d6cb",
                                "sense_id": "8f7260d1-0081-3a2b-804e-096dc5466c3e",
                                "text": "„Auch waren immer weniger Bürger bereit, die Ämter eines Duumvir (Verwaltungschef) oder Decurio (Ratsherr) zu übernehmen, weil deren Leistungen aus eigener Tasche bezahlt werden mussten.“"
                            },
                            {
                                "example_id": "e4c23d07-5b61-4033-b644-7ced87d35118",
                                "sense_id": "8f7260d1-0081-3a2b-804e-096dc5466c3e",
                                "text": "„Der Duumvir war verärgert über Verwüstungen in seinem Besitz in der Vorstadt (offenbar waren die Goten dort einquartiert) und verweigerte den Aufschub und die Bezahlung des Reisegeldes.“"
                            },
                            {
                                "example_id": "b03547c2-485f-4880-9ad8-d91d37f69f2a",
                                "sense_id": "8f7260d1-0081-3a2b-804e-096dc5466c3e",
                                "text": "„Die Duumvirn hatten zwar ein eigenes Amtsgebäude, doch war selbst dort im allgemeinen die Öffentlichkeit nicht ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9ed409e-2845-3999-b26b-30d3556f5611",
                        "entry_id": "60609420-5047-380d-a4fd-c4593ac5bee8",
                        "glosses": [
                            "Verwaltungsbehörde im Römischen Reich, die aus zwei Beamten bestand und in Munizipien und Kolonien die oberste örtliche Behörde war"
                        ],
