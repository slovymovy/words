                "senses": [
                    {
                        "sense_id": "4139b691-d03b-3a4e-9604-3e4a2e1def74",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "физ. мультиплет из 8 квантовых состояний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b4db31-9ae7-4391-844e-8f344c20218e",
                                "sense_id": "4139b691-d03b-3a4e-9604-3e4a2e1def74",
                                "text": "В магнитном поле происходит расщепление вырожденного спинового октета."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b467301-24f3-3983-be0f-4a21d36074ca",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "физ., хим. мультиплет из 8 близких спектральных линий, появляющихся в результате расщепления одной линии"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5d851fa2-fbcd-30db-96b3-11ebcbecc116",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "физ. мультиплет из 8 элементарных частиц с близкими свойствами, переходящих друг в друга при определённых преобразованиях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1906c81-62b8-465f-b7e8-9c3beff93379",
                                "sense_id": "5d851fa2-fbcd-30db-96b3-11ebcbecc116",
                                "text": "Октет барионов состоит из частиц, имеющих близкие массы."
                            },
                            {
                                "example_id": "2e1bebf0-9600-4f5b-9e55-adeb885d8deb",
                                "sense_id": "5d851fa2-fbcd-30db-96b3-11ebcbecc116",
                                "text": "Цветовое взаимодействие переносится октетом векторных калибровочных бозонов, получивших название глюонов."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cf35496-f693-3daf-81b0-b918314837aa",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "хим. восьмиэлектронная атомная оболочка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76462c0-9e31-4909-a8c5-c34987db3dfd",
                                "sense_id": "1cf35496-f693-3daf-81b0-b918314837aa",
                                "text": "Правило октета."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfab22fe-3fca-3cb6-bf6a-e81d6451814e",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "филол. первые восемь строк сонета"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f404aaa1-dd45-36d7-bee8-36db40c45518",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "комп. группа из 8 бит или (редко) из 3 бит"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4423c709-fbff-4085-a4b8-3351e6c59a92",
                                "sense_id": "f404aaa1-dd45-36d7-bee8-36db40c45518",
                                "text": "IP-адрес состоит из четырёх октетов."
                            }
                        ]
                    },
                    {
                        "sense_id": "cab62afe-4b97-36d3-bf2c-d1963a3e57c9",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "муз. ансамбль из восьми исполнителей с самостоятельной партией у каждого из них"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1f75a322-7d39-3ddb-8fa5-0de312b64029",
                        "entry_id": "9802a66f-2de2-3ac7-83e3-82b8b54190a4",
                        "glosses": [
                            "муз. произведение, написанное для октета [7]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "190b3944-5f5c-41c5-b4cc-a7da8ad27d11",
                                "sense_id": "1f75a322-7d39-3ddb-8fa5-0de312b64029",
                                "text": "В следующем году он написал два октета для духовых инструментов."
                            }
                        ]
                    }
                ],
