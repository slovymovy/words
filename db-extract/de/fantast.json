                "senses": [
                    {
                        "sense_id": "bcea56c7-1d42-3189-a1e8-cef252c0891f",
                        "entry_id": "ae944b87-87e8-38b0-a491-5cfab6f56009",
                        "glosses": [
                            "Träumer, Schwärmer, Mensch mit überspannten Ideen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27ee0850-a2ee-49c0-86ba-ab8094598883",
                                "sense_id": "bcea56c7-1d42-3189-a1e8-cef252c0891f",
                                "text": "„Als überforderte Fantasten verirren und verlieren sie sich in einem Raum aus Imaginationen: Der fiktive Wert des Geldes trifft auf die narrative Fiktion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60f20df2-c364-490e-88e3-68a44e7fc03f",
                        "source_entry_id": "ae944b87-87e8-38b0-a491-5cfab6f56009",
                        "source_sense_id": "bcea56c7-1d42-3189-a1e8-cef252c0891f",
                        "source_sense_description": "Träumer, Schwärmer, Mensch mit überspannten Ideen",
                        "target_lang_word": "fantasist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantasist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d6c20ea-452a-3f5b-aef0-9433813531f8",
                                        "entry_id": "0195ee9d-f52d-30c6-90bd-170b7dadcb2c",
                                        "glosses": [
                                            "One who creates fantasies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599efe8c-2faa-472a-b9db-53767d1dff05",
                                                "sense_id": "4d6c20ea-452a-3f5b-aef0-9433813531f8",
                                                "text": "2008 Oct 31 James Bond fantasist jailed by James Sturcke and agencies in The Guardian.co.uk\nA fantasist was beginning a two-year stint behind bars today for conning police into thinking he was a James Bond-style secret agent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1d4ac04-4099-39b9-a9bb-6c7a10e50bf3",
                                        "entry_id": "0195ee9d-f52d-30c6-90bd-170b7dadcb2c",
                                        "glosses": [
                                            "One living in a fantasy world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f50a3fa-277d-4b85-91b0-c59be28eff49",
                                                "sense_id": "d1d4ac04-4099-39b9-a9bb-6c7a10e50bf3",
                                                "text": "I resurrect this piece as antidote, I hope, to the gripping lies of a cinematic fantasist who suffers delusions of reality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcefbb6b-f1ae-3e34-b3a6-6a519109f878",
                                        "entry_id": "0195ee9d-f52d-30c6-90bd-170b7dadcb2c",
                                        "glosses": [
                                            "A writer who writes in the fantasy style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec6d063-4344-48fc-b75f-60c82d293ec9",
                                                "sense_id": "bcefbb6b-f1ae-3e34-b3a6-6a519109f878",
                                                "text": "\"Like the other fantasists dealt with in this volume, Rossetti used fantasy to subvert and undermine traditionalist notions, in this instance notions of male power and female submissiveness.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ce5e54-0472-4e4a-8075-f9e92a0bada6",
                        "source_entry_id": "ae944b87-87e8-38b0-a491-5cfab6f56009",
                        "source_sense_id": "bcea56c7-1d42-3189-a1e8-cef252c0891f",
                        "source_sense_description": "Träumer, Schwärmer, Mensch mit überspannten Ideen",
                        "target_lang_word": "dreamer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreamer",
