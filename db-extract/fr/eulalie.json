                "senses": [
                    {
                        "sense_id": "07cb7223-e80d-36dc-b09a-07bbecfcfc7a",
                        "entry_id": "457268f6-ddfd-3bcd-a9ba-298f1e8180a4",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0843bd92-b417-4c50-b613-74f1b6d21273",
                                "sense_id": "07cb7223-e80d-36dc-b09a-07bbecfcfc7a",
                                "text": "Eulalie Chantegreil, mariée au méger Rébufat, était une grande diablesse noire et volontaire qui gouvernait au logis."
                            },
                            {
                                "example_id": "3d0cc5c4-0970-4243-bc42-29f897745642",
                                "sense_id": "07cb7223-e80d-36dc-b09a-07bbecfcfc7a",
                                "text": "C’est à quoi Eulalie excellait. Ma tante pouvait lui dire vingt fois en une minute : « C’est la fin, ma pauvre Eulalie », vingt fois Eulalie répondait : « Connaissant votre maladie comme vous la connaissez, madame Octave, vous irez à cent ans, comme me disait hier encore Mme Sazerin. »"
                            }
                        ]
                    }
                ],
