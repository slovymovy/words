                },
                {
                    "sense_id": "400edab4-4d12-3b51-bd23-231d457c1f96",
                    "sense_definition": "A technical rehearsal in theater or performance arts where lighting, sound, and scene changes are practiced.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors were exhausted after a long day of <w>tech</w> before opening night.",
                            "target_lang_translations": {
                                "ru": "Актеры были измотаны после долгого дня <w>технических репетиций</w> перед премьерой.",
                                "zh": "在首演前经过一整天的<w>技术排练</w>，演员们都精疲力竭。"
                            }
                        },
                        {
                            "text": "We need to finish <w>tech</w> by this evening so we can have a full dress rehearsal tomorrow.",
                            "target_lang_translations": {
                                "ru": "Нам нужно закончить <w>технический прогон</w> к вечеру, чтобы завтра провести генеральную репетицию.",
                                "zh": "我们今晚必须完成<w>技术合成</w>，这样明天才能进行全装彩排。"
                            }
