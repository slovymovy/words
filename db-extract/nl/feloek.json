                    },
                    {
                        "translation_id": "6d7c323d-0141-41e0-be92-b9ae08892613",
                        "source_entry_id": "c2b9a5f3-8cbb-3d22-840e-a03fdff98f7d",
                        "source_sense_id": "d27f922c-3b30-30ff-a7b1-2b9e5bc81f4d",
                        "source_sense_description": "een zeilschip",
                        "target_lang_word": "felucca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "felucca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4d70fc-6efa-3cde-9a8b-86a43e818dfa",
                                        "entry_id": "22c85de6-7f85-3359-8433-e0e77181a533",
                                        "glosses": [
                                            "A traditional wooden shallow-draught sailing boat used in the Mediterranean and along the Nile in Egypt, its rig consisting of one or two lateen sails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8989dd-b64b-4c7c-aae4-b40d0d47e6f7",
                                                "sense_id": "7c4d70fc-6efa-3cde-9a8b-86a43e818dfa",
                                                "text": "\"We are very fortunate, Senhora,\" said Alvarez, as soon as they were in the street; \"there is a felucca on the point of sailing to Naples—I have secured a passage, but we must not lose a minute.\""
                                            },
                                            {
                                                "example_id": "cc9c0bca-3afc-42a8-96c8-668e3f491bad",
                                                "sense_id": "7c4d70fc-6efa-3cde-9a8b-86a43e818dfa",
                                                "text": "Shipping of every sort, from passenger liners to ferry steamers, tramps to tugs and trailing barges, feluccas to speedboats and yachts, from warships to caiques, chugs, hoots, glides or churns its way in all directions."
                                            },
                                            {
                                                "example_id": "1f40a5a6-eb0e-48d6-80c7-1632804c99a9",
                                                "sense_id": "7c4d70fc-6efa-3cde-9a8b-86a43e818dfa",
                                                "text": "\"The ghostly feluccas passing along the canal are crewed by ghouls with wrapped heads.\" Lawrence Durrell, Justine"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fe1d583-8c38-47ed-8116-8954ee161c49",
                        "source_entry_id": "c2b9a5f3-8cbb-3d22-840e-a03fdff98f7d",
                        "source_sense_id": "d27f922c-3b30-30ff-a7b1-2b9e5bc81f4d",
                        "source_sense_description": "een zeilschip",
                        "target_lang_word": "felouque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "felouque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                        "entry_id": "1a4de054-d30d-39c8-aa1a-24624b31c3c6",
                                        "glosses": [
                                            "Sorte de petit bâtiment léger, long et étroit, à voiles et à rames, et qui était principalement en usage dans la Méditerranée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "931a9317-3994-4fe3-93f9-43cbcfeb5473",
                                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                                "text": "Je n’aperçus en arrivant que trois ou quatre felouques grecques, et je perdis tout espoir de retrouver mon navire autrichien."
                                            },
                                            {
                                                "example_id": "0fed1a6b-c25a-4c60-ad41-7dec3f2e4689",
                                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                                "text": "Enfin, il parvint à un tel degré de maladie que, pour le mettre au lit, il fallait le manœuvrer comme une felouque entrant dans un chenal dangereux."
                                            },
                                            {
                                                "example_id": "7706263f-f560-416a-8cbb-c09b23bb70eb",
                                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                                "text": "Puis on fit venir de petites unités du Levant, frégates latines et felouques."
                                            },
                                            {
                                                "example_id": "cebf60d3-d117-40f0-89c3-37b1fa3a3a0d",
                                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                                "text": "Ce sont ces bâtiments qui enlèvent les barques et les felouques qui vont terre à terre, et font souvent des prises considérables et un grand nombre d’esclaves, […]."
                                            },
                                            {
                                                "example_id": "7b95d13f-4afe-4263-9473-064d133c516a",
                                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                                "text": "La Valette a caché plus d’une vingtaine de felouques tout le long de la côte, à l’usage de ses messagers pour la Sicile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
