                        "sense_id": "eecb7f0a-7442-3f59-b662-b563bc2956ee",
                        "entry_id": "2355c539-fbca-3b09-b75f-86be59897d44",
                        "glosses": [
                            "A declaration or official announcement."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b0a6a1d6-bccf-32dc-a5e9-8bdd47679eb3",
                        "entry_id": "2355c539-fbca-3b09-b75f-86be59897d44",
                        "glosses": [
                            "The decree made by Roman emperors which fixed the property tax for the next fifteen years."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
