        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b5d07618-2bf6-348f-93fe-a1dcf9e73c56",
                    "sense_definition": "The Fifth Amendment to the United States Constitution, which protects against self-incrimination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "law",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The witness decided to plead the <w>Fifth</w> rather than answer the question.",
                            "target_lang_translations": {
                                "ru": "Свидетель решил сослаться на <w>Пятую поправку</w>, вместо того чтобы отвечать на вопрос.",
                                "zh": "证人决定援引<w>第五修正案</w>，而不是回答这个问题。"
                            }
                        },
                        {
                            "text": "He invoked the <w>Fifth</w> during the trial to avoid testifying against himself.",
                            "target_lang_translations": {
                                "ru": "Он воспользовался <w>Пятой поправкой</w> во время суда, чтобы не свидетельствовать против себя.",
                                "zh": "他在审判期间援引了<w>第五修正案</w>，以避免自证其罪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plead the Fifth",
                        "take the Fifth"
