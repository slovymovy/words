                                "example_id": "e8b0ede3-f90b-4a03-afcc-ab9ac8a066c4",
                                "sense_id": "8fcef4d1-f828-3c33-a139-b6d044a6a7e6",
                                "text": "„Vom 3. Jahrhundert v. Chr. bis zum 1. Jahrhundert v. Chr. bestand beim heutigen Manching ein keltisches Oppidum, das in seiner Blütezeit das bedeutendste Handelszentrum Mitteleuropas darstellte.“"
                            },
                            {
                                "example_id": "851ac31d-5635-4e93-962b-41b72aa7756d",
                                "sense_id": "8fcef4d1-f828-3c33-a139-b6d044a6a7e6",
                                "text": "„Bei Ausgrabungen in Manching stießen Archäologen auf das winzige Knöchelchen eines Fisches.“"
                            }
