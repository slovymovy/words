                "senses": [
                    {
                        "sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                        "entry_id": "39cfaa06-c0f5-3c84-97d5-9e80f30d4956",
                        "glosses": [
                            "Leuchter (Gestell), der mit Kerzen bestückt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d424016b-8a64-45f7-8680-8c11df46dbd9",
                                "sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                                "text": "„Hier war ein Tisch gedeckt: sechs Kerzenleuchter - zwei aus Silber und vier aus Messing -, zwei Chaless, bedeckt mit einem gestickten Tuch, ein Chalemesser mit Perlmuttgriff, eine Karaffe und ein alter, zerbeulter Kidduschbecher.“"
                            },
                            {
                                "example_id": "be76191f-2c23-4698-82e4-020e2cff2908",
                                "sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                                "text": "„Er kommt langsam näher, in der linken Hand den Kerzenleuchter mit drei flackernden Kerzen.“"
                            },
                            {
                                "example_id": "9b358ab1-9b9b-4a1a-bd62-be8388489bed",
                                "sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                                "text": "„Eine Kanne Wein freilich stellte ihm Leonhard, der Roberts Vorliebe erkannt hatte, allabendlich mit dem frisch geputzten Kerzenleuchter bereit.“"
                            },
                            {
                                "example_id": "3b36bd15-9835-410b-829e-8c32e7bf7a99",
                                "sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                                "text": "„Ich stand im Wohnzimmer und sah zu, wie die Stylistin Kerzenleuchter und Zierkissen auf den leeren Flächen verteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7a4ec12-ab13-45c4-9963-e224c6adf228",
                        "source_entry_id": "39cfaa06-c0f5-3c84-97d5-9e80f30d4956",
                        "source_sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                        "source_sense_description": "Leuchter (Gestell), der mit Kerzen bestückt werden kann",
                        "target_lang_word": "chandelier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chandelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                        "entry_id": "010881bb-3429-3aa4-a223-e4c52bc7e4a8",
                                        "glosses": [
                                            "Ustensile servant de support à des chandelles ou à des bougies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5e167e-7291-42d4-85c5-01dbda7bb646",
                                                "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                                "text": "L’homme revint vers la porte, semblant pressé de refouler ces intrus trop curieux, et dédaigneux de ses richesses : des adonis marmoréens, des chandeliers, des meubles."
                                            },
                                            {
                                                "example_id": "e5e84d81-6d0a-419a-bda0-b328bc220d36",
                                                "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                                "text": "Deux bougies de cire jaune se répandaient en nappe sur les chandeliers de cuivre et chauffaient encore l'atmosphère de leur vapeur épaisse."
                                            },
                                            {
                                                "example_id": "6b172f84-115c-4d87-9ebc-24150c5294ff",
                                                "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                                "text": "Sylvius Hog, à la clarté de son chandelier de terre, relisait attentivement les lignes écrites au dos du billet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77480b6-6d6f-3aee-bb68-afe08b80d454",
                                        "entry_id": "010881bb-3429-3aa4-a223-e4c52bc7e4a8",
                                        "glosses": [
                                            "Troisième personne sur qui deux amoureux illicites font porter les soupçons pour ne pas être inquiétés. Syn. : paravent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8ba5fb-fdac-4b48-bdfe-7ca3020677a3",
                                                "sense_id": "a77480b6-6d6f-3aee-bb68-afe08b80d454",
                                                "text": "Comme il fallait absolument, pour leur propre tranquillité, détourner l'attention des courtisans, ils cherchèrent quelqu'un – quelqu'une plutôt – qui pourrait servir de chandelier. Ce chandelier qu'un certain Alfred de Musset mettra un jour si joliment en scène. Les amoureux passèrent en revue celles qui auraient l'honneur d'attirer l'attention – fictive – de Louis. Madame se méfiait – avec juste raison – d'un trop séduisant « chandelier ». Elle connaissait déjà bien le tempérament infiniment inflammable de son beau-frère, et elle ne voulait pas qu'un simple badinage pût devenir – qui sait? – quelque chose de plus sérieux.\nAprès avoir éliminé les dames ou filles d'honneur trop âgées, trop vilaines – ou trop jolies au goût de Madame – trois d'entre elles restent en lice …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chandelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7613fe75-c9eb-3d43-b7c8-ea1f4cf140d9",
                                        "entry_id": "54c37089-31cb-3ccf-a335-87f854a17186",
                                        "glosses": [
                                            "Artisan qui fabrique et vend des chandelles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fbd753f-11be-4319-9932-8fbed3508dc8",
                        "source_entry_id": "39cfaa06-c0f5-3c84-97d5-9e80f30d4956",
                        "source_sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                        "source_sense_description": "Leuchter (Gestell), der mit Kerzen bestückt werden kann",
                        "target_lang_word": "bougeoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bougeoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7045cd5b-4536-3dbd-96f1-ec0986f0b4cb",
                                        "entry_id": "03729fdb-e76d-3724-aa4a-8a4976fdad3e",
                                        "glosses": [
                                            "Chandelier bas, sans fût, se présentant comme une bobèche fixée sur un pied en forme de coupe et comportant une prise pour son transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543225b3-194e-486a-a5df-a3cb5b137f93",
                                                "sense_id": "7045cd5b-4536-3dbd-96f1-ec0986f0b4cb",
                                                "text": "À minuit, lorsqu’elle prit le bougeoir de sa mère pour l’accompagner à sa chambre, Mme de La Mole s’arrêta sur l’escalier pour faire un éloge complet de Julien."
                                            },
                                            {
                                                "example_id": "cfd80bc8-d866-44da-9124-0fe8b0050ac4",
                                                "sense_id": "7045cd5b-4536-3dbd-96f1-ec0986f0b4cb",
                                                "text": "Des bougeoirs entouraient un Jean-Marie prisonnier d’un cadre en peluche rouge souriant dans son uniforme de chasseur à pied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36411404-730c-424b-b3d6-dce2aa3c1d8b",
                        "source_entry_id": "39cfaa06-c0f5-3c84-97d5-9e80f30d4956",
                        "source_sense_id": "c209da37-d7fd-3805-885d-294120645eca",
                        "source_sense_description": "Leuchter (Gestell), der mit Kerzen bestückt werden kann",
                        "target_lang_word": "candélabre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candélabre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "184e1040-c2c4-3e60-bdf9-3c83bff68040",
                                        "entry_id": "9ee59477-aa99-3781-9f34-fea729b64713",
                                        "glosses": [
                                            "Support à plusieurs branches, garnies de bougies de cire, de becs de gaz ou d’ampoules électriques ou tout autre foyer de lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4fbf90-6898-4b40-8030-6dcc046a0f89",
                                                "sense_id": "184e1040-c2c4-3e60-bdf9-3c83bff68040",
                                                "text": "La marquise alluma les candélabres, respira le parfum des fleurs."
                                            },
                                            {
                                                "example_id": "713fdfc6-a236-4a00-9aa1-1af298d2032d",
                                                "sense_id": "184e1040-c2c4-3e60-bdf9-3c83bff68040",
                                                "text": "Quatre candélabres d’argent, supportant de grands cierges de cire, éclairaient cet appartement."
                                            },
                                            {
                                                "example_id": "a9153dd1-d0a1-4c00-8066-5f8615f55f72",
                                                "sense_id": "184e1040-c2c4-3e60-bdf9-3c83bff68040",
                                                "text": "[…] le roi de Navarre, escorté de deux pages qui portaient huit flambeaux de cire jaune sur deux candélabres, apparut souriant sur le seuil de la chambre."
                                            },
                                            {
                                                "example_id": "04b37ba8-b345-40d8-96e3-b8d2617bf2ab",
                                                "sense_id": "184e1040-c2c4-3e60-bdf9-3c83bff68040",
                                                "text": "De gros flambeaux de cire blanche brûlaient dans les candélabres en forme de bras d’or qui sortaient des tapisseries encadrées et fleurdelisées dont le mur était garni."
                                            },
                                            {
                                                "example_id": "42b21d1f-a1e1-42ed-90cf-2c11aea89717",
                                                "sense_id": "184e1040-c2c4-3e60-bdf9-3c83bff68040",
                                                "text": "L’immense salle était éclairée violemment par douze candélabres de bronze supportant chacun douze flambeaux de cire."
                                            },
                                            {
                                                "example_id": "e660f159-822c-4a0a-9131-2e62adae6c08",
                                                "sense_id": "184e1040-c2c4-3e60-bdf9-3c83bff68040",
                                                "text": "J'étais alors d'une candeur stupéfiante et d'une délicatesse de sentiment si raffinée que, pour recevoir galamment une « femme mariée » qui me venait voir, j'avais allumé toutes les bougies de mes deux candélabres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56369d1d-ddd0-35e2-b6b2-ca50eb28db1d",
                                        "entry_id": "9ee59477-aa99-3781-9f34-fea729b64713",
                                        "glosses": [
                                            "Couronnement en forme de balustre qui figure une torchère."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4997b776-ab91-3add-984e-cbe8161138b5",
                                        "entry_id": "9ee59477-aa99-3781-9f34-fea729b64713",
                                        "glosses": [
                                            "Motif, souvent végétal, qui orne des pilastres ou des pied-droits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
