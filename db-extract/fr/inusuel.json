                ],
                "senses": [
                    {
                        "sense_id": "ad54112c-de9f-3373-b67f-44d944b59ad7",
                        "entry_id": "8df7b1f9-858d-3c4f-9b92-c52d42908feb",
                        "glosses": [
                            "Inhabituel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "682ceca2-f5e2-4aab-a898-95a817c82712",
                                "sense_id": "ad54112c-de9f-3373-b67f-44d944b59ad7",
                                "text": "Les simulateurs des constructeurs savent reproduire les manœuvres inusuelles (avion extrêmement cabré ou piqué) pour entraîner les pilotes à s’en sortir."
                            },
                            {
                                "example_id": "bf7b9b57-5b2e-445c-a1c7-00c62f025e6b",
                                "sense_id": "ad54112c-de9f-3373-b67f-44d944b59ad7",
                                "text": "[…] quand les projets sont grands, complexes, inusuels."
                            },
                            {
                                "example_id": "f763190e-da23-4f8b-8f2d-7080fa7e8b8b",
                                "sense_id": "ad54112c-de9f-3373-b67f-44d944b59ad7",
                                "text": "Quand donc le phénomène de poésie musicale se produit-il ? Quand l’oreille perçoit un objet sonore inusuel, absolument distinct, et du langage musical, […] et du langage des choses."
                            },
                            {
                                "example_id": "a5ffe9e3-ebd9-4296-a9b9-fac072c56441",
                                "sense_id": "ad54112c-de9f-3373-b67f-44d944b59ad7",
                                "text": "On se mettait à fréquenter assidûment des lieux inusuels, Casino, les rayons alimentaires de Prisu et des Nouvelles Galeries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d489d2e-e2bc-457b-b220-093dacc25dfe",
                        "source_entry_id": "8df7b1f9-858d-3c4f-9b92-c52d42908feb",
                        "source_sense_id": "ad54112c-de9f-3373-b67f-44d944b59ad7",
                        "target_lang_word": "ungebräuchlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungebräuchlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4950d1e8-682f-37db-aa28-fc6829e79ff1",
                                        "entry_id": "a62d51dc-0e59-38a6-bcb5-b79a437cf654",
                                        "glosses": [
                                            "nicht üblich; so, dass es nicht gebraucht/benutzt/verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3376ae-be20-44e4-97d3-2fd039cead61",
                                                "sense_id": "4950d1e8-682f-37db-aa28-fc6829e79ff1",
                                                "text": "Sie verwendet einen ungebräuchlichen Ausdruck."
                                            },
                                            {
                                                "example_id": "07e21b4a-7c2c-4dd4-853b-142f528c44d0",
                                                "sense_id": "4950d1e8-682f-37db-aa28-fc6829e79ff1",
                                                "text": "Dieses Wort ist ungebräuchlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74867d0d-ba43-4ef4-b0a1-48ced779f8ca",
                        "source_entry_id": "8df7b1f9-858d-3c4f-9b92-c52d42908feb",
                        "source_sense_id": "ad54112c-de9f-3373-b67f-44d944b59ad7",
                        "target_lang_word": "ungewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                        "entry_id": "d558a056-9765-32fb-abcf-008daa80df73",
                                        "glosses": [
                                            "nicht gewöhnlich, nicht der Gewohnheit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddf01c-63b6-4531-acc4-ab87866ab722",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Ungewöhnliche Zeiten erfordern ungewöhnliches Handeln."
                                            },
                                            {
                                                "example_id": "8ee19457-0104-4db1-ba7b-f1bf4d5cf5ad",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "94b0dd82-a208-4b55-91a6-beb7480c5d26",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Am ungewöhnlichsten jedoch war ihre Art zu laufen."
                                            },
                                            {
                                                "example_id": "6b05cb6a-5499-45eb-9df7-7e1b876bc456",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Wie reagiert die Psyche des Straßenbahnkondukteurs auf ein Douceur von ungewöhnlichem Ausmaße, das zum Beispiel mehr als dreimal so groß ist als der Fahrpreis und siebenmal so groß als das Normaltrinkgeld!“"
                                            },
                                            {
                                                "example_id": "74dbb13f-c556-49ce-a05a-1667ff695ef4",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Auf einer Pressekonferenz erklärte der US-Präsident [Donald Trump], dass er ein Treffen mit dem kanadischen Premierminister Justin Trudeau […] ausgeschlagen habe. Ungewöhnlich ist, dass ein amtierender Präsident dies öffentlich sagt. Besonders ungewöhnlich ist, dass Kanada gar nicht um das Treffen gebeten hatte. Dies teilte Trudeaus Sprecherin im Anschluss mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
