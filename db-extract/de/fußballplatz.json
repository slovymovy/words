                ],
                "senses": [
                    {
                        "sense_id": "a862cbfd-c7bb-347a-b968-a67d6287b5c2",
                        "entry_id": "01690450-572e-3f46-9138-9a64e26fe315",
                        "glosses": [
                            "Spielfeld für das Fußballspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a050a0-32b7-4213-b7f5-9ae9a6b30063",
                                "sense_id": "a862cbfd-c7bb-347a-b968-a67d6287b5c2",
                                "text": "Vor dem Turnier wurde der Rasen des Fußballplatzes gemäht."
                            },
                            {
                                "example_id": "a602fe0f-0b2a-4c89-8a75-e83f721a9d17",
                                "sense_id": "a862cbfd-c7bb-347a-b968-a67d6287b5c2",
                                "text": "„Der Campingplatz (Wohnmobilstellplätze und Zelte) erstreckt sich auf dem alten Fußballplatz östlich des Ortes.“"
                            },
                            {
                                "example_id": "48268105-239b-4178-9315-f2a4c912b520",
                                "sense_id": "a862cbfd-c7bb-347a-b968-a67d6287b5c2",
                                "text": "„Mein Vater und Ditti schickten mich bereits kurz nach meiner Ankunft in den Feldafinger Kindergarten, der in Baracken am alten Fußballplatz des Dorfes untergebracht war.“"
                            },
                            {
                                "example_id": "407bd1b0-b776-4ba2-b3df-1b1da91a8726",
                                "sense_id": "a862cbfd-c7bb-347a-b968-a67d6287b5c2",
                                "text": "„Künftig werden Schiedsrichter das Kampfgeschehen auf Fußballplätzen per Bildschirm verfolgen und in dringenden Fällen mittels Lautsprecher eingreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
