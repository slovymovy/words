    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "426e8b8d-314c-38ed-b74d-0fb953f1442d",
                    "sense_definition": "een vrolijk of tevreden gevoel hebben, vaak voor een kortere periode",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen zijn erg <w>blij</w> omdat ze vandaag een cadeautje krijgen.",
                            "target_lang_translations": {
                                "en": "The children are very <w>happy</w> because they are getting a present today.",
                                "ru": "Дети очень <w>рады</w>, потому что сегодня они получат подарок."
                            }
                        },
                        {
                            "text": "Ik ben <w>blij</w> met mijn nieuwe fiets.",
                            "target_lang_translations": {
                                "en": "I am <w>happy</w> with my new bicycle.",
                                "ru": "Я <w>доволен</w> своим новым велосипедом."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrolijk",
                        "tevreden",
                        "verheugd",
                        "gelukkig",
                        "opgewekt"
                    ],
                    "antonyms": [
                        "chagrijnig",
                        "bedrukt",
                        "somber"
                    ],
                    "common_phrases": [
