                ],
                "senses": [
                    {
                        "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                        "entry_id": "0f8498a3-9005-3a19-8e86-7a9a833cdd84",
                        "glosses": [
                            "prozentualer Anteil der Kinder und Jugendlichen unter 18 Jahren, die in Haushalten aufwachsen, deren Einkommen 50 % oder 60 % des durchschnittlichen Nettoeinkommens unterschreitet;\\n prozentualer Anteil der Kinder und Jugendlichen unter 18 Jahren, die einen gesetzlichen Anspruch auf Sozialleistungen (nach dem SGB II) haben"
                        ],
                        "tags": [
                            "Gesellschaft",
                            "in Deutschland"
                        ],
                        "examples": [
                            {
                                "example_id": "c9c1a561-1ec8-43eb-8f98-3de8c0cc20ef",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„2021 lag die Kinderarmutsquote in der Hauptstadt bei 23,3 Prozent, bundesweit waren es 20,8 Prozent.“"
                            },
                            {
                                "example_id": "b961d187-c436-4687-b43d-3b5ce33ba43e",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "[Schlagzeile:] „Nur Stadtstaaten haben höhere Kinderarmutsquote als das Saarland“"
                            },
                            {
                                "example_id": "6ec8166b-473c-40e9-af1b-155269222664",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Die Kinderarmutsquote in Halle ist besonders hoch.“"
                            },
                            {
                                "example_id": "6371f323-1275-466d-b4a2-32067949880a",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Die Stadt hat die höchste Kinderarmutsquote von ganz Thüringen: 22 Prozent.“"
                            },
                            {
                                "example_id": "a5c31e78-df33-43f0-bb3b-1cd43cad260d",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Der Armutsbericht der Sozialverbände 2016 zeigt, dass die Armutsquote mit 20 Prozent und die Kinderarmutsquote im Ruhrgebiet mit 19 Prozent deutlich über dem Bundesdurchschnitt liegt.“"
                            },
                            {
                                "example_id": "cac7eed5-f6d8-483c-9821-fbbbfe65d66b",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Die Kinderarmut in Deutschland nimmt einer Studie zufolge zu. Die Kinderarmutsquote stieg im Jahr 2015 im Vergleich zum Vorjahr um 0,7 Prozentpunkte auf 19,7 Prozent,“ […]."
                            },
                            {
                                "example_id": "ff0c7ba8-fa04-4aa8-8036-16c0fbb542da",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Im Mai 2011 wies die Journalistin Maike Rademaker darauf hin, dass das DIW die Kinderarmutsquote stillschweigend korrigiert hatte.“"
                            },
                            {
                                "example_id": "9f269e6e-11a8-49f6-8d6c-1ca9f65b62a6",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Beim Vergleich der Kinderarmutsquoten verschiedener Staaten muss bedacht werden, dass die Armutsgrenze vom Wohlstand des betreffenden Staates abhängt.“"
                            },
                            {
                                "example_id": "a957bf7d-7234-4a81-8e80-bac331bfa4f7",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Der WZB-Forscher Marcel Helbig hat“ […] „erstmals die Kinderarmutsquoten für die Einzugsgebiete aller Grundschulen in Deutschland berechnet.“"
                            },
                            {
                                "example_id": "a7bcfe40-ac36-4129-91e1-358b326cd0b8",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Die Region Subsahara-Afrika weist die weltweit höchste Kinderarmutsquote auf.“"
                            },
                            {
                                "example_id": "5cc371d5-e6ef-41f5-af3e-7c3a82098068",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "Die Regionen \"Ostasien und Pazifik\" sowie \"Europa und Zentralasien\" haben mit jeweils 5,9 Prozent die geringsten Kinderarmutsquoten."
                            },
                            {
                                "example_id": "997d6523-7de4-4c39-91e9-0346e2bc691b",
                                "sense_id": "4330882b-0893-3fc3-bd0c-aa22bddbf9ad",
                                "text": "„Im Jahr 2018 waren in der EU 23 Millionen Kinder, d. h. jedes vierte Kind, von Armut oder sozialer Ausgrenzung bedroht. Allerdings variieren die Kinderarmutsquoten zwischen den Mitgliedstaaten erheblich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
