    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e710670c-232e-32bd-8cad-de49123a117b",
                    "sense_definition": "Een pootloos reptiel met een lang, schubbig lichaam dat behoort tot de onderorde Serpentes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de dierentuin zagen we een gevaarlijke <w>slang</w> achter het glas liggen.",
                            "target_lang_translations": {
                                "en": "At the zoo, we saw a dangerous <w>snake</w> lying behind the glass."
                            }
                        },
                        {
                            "text": "Pas op voor de <w>giftige</w> <w>slang</w> die zich in het hoge gras verbergt.",
                            "target_lang_translations": {
                                "en": "Watch out for the <w>poisonous</w> <w>snake</w> hiding in the tall grass."
                            }
                        }
                    ],
                    "synonyms": [
                        "serpent"
                    ],
                    "common_phrases": [
                        "giftige slang",
                        "gevaarlijke slang"
                    ],
                    "target_lang_definitions": {
                        "en": "A legless reptile with a long, scaly body belonging to the suborder Serpentes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snake",
                                "target_lang_sense_clarification": "general term for the reptile"
                            },
                            {
                                "target_lang_word": "serpent",
                                "target_lang_sense_clarification": "literary or formal term for a snake"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d218399-c93e-3ab5-b24c-30231189242f",
                    "sense_definition": "Een buigzame buis die wordt gebruikt voor het verplaatsen van vloeistoffen of gassen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik gebruik de <w>slang</w> om de planten in de tuin water te geven.",
                            "target_lang_translations": {
                                "en": "I use the <w>hose</w> to water the plants in the garden."
                            }
                        },
                        {
                            "text": "De brandweer sloot de <w>slang</w> aan op de waterkraan om de brand te blussen.",
                            "target_lang_translations": {
                                "en": "The fire department connected the <w>hose</w> to the water tap to extinguish the fire."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slang aansluiten",
                        "lange slang"
                    ],
                    "target_lang_definitions": {
                        "en": "A flexible tube used for moving liquids or gases."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hose",
                                "target_lang_sense_clarification": "flexible tube for water or gas"
                            },
                            {
                                "target_lang_word": "tube",
                                "target_lang_sense_clarification": "general flexible piping"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0763f4e0-0f04-31f1-bcaa-936c82f5fcf8",
                    "sense_definition": "Informele taal of woorden die specifiek zijn voor een bepaalde sociale groep of subcultuur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het taalgebruik van monteurs zit vol met vaak onbegrijpelijk <w>slang</w>.",
                            "target_lang_translations": {
                                "en": "The language used by mechanics is full of often incomprehensible <w>slang</w>."
                            }
                        },
                        {
                            "text": "Jongeren gebruiken vaak hun eigen <w>slang</w> die hun ouders niet begrijpen.",
                            "target_lang_translations": {
                                "en": "Young people often use their own <w>slang</w> that their parents do not understand."
                            }
                        }
                    ],
                    "synonyms": [
                        "groepstaal"
                    ],
                    "common_phrases": [
                        "onbegrijpelijk slang"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Informal language or words specific to a particular social group or subculture."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slang",
                                "target_lang_sense_clarification": "informal group language"
                            },
                            {
                                "target_lang_word": "jargon",
                                "target_lang_sense_clarification": "specialized language of a profession"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "135be6ea-4720-3018-8230-24a15d089929",
                    "sense_definition": "Een sterrenbeeld aan de noordelijke hemelkoepel, gelegen nabij de dierenriem.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomie",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Met een goede telescoop kun je het sterrenbeeld <w>Slang</w> aan de nachthemel vinden.",
                            "target_lang_translations": {
                                "en": "With a good telescope, you can find the constellation <w>Serpens</w> in the night sky."
                            }
                        },
                        {
                            "text": "De <w>Slang</w> is het enige sterrenbeeld dat uit twee niet-aaneengesloten delen bestaat.",
                            "target_lang_translations": {
                                "en": "<w>Serpens</w> is the only constellation that consists of two non-contiguous parts."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ser",
                        "Serp"
                    ],
                    "target_lang_definitions": {
                        "en": "A constellation in the northern celestial hemisphere, located near the zodiac."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Serpens",
                                "target_lang_sense_clarification": "astronomical name of the constellation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}