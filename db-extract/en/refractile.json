                        "glosses": [
                            "Able to refract, refractive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be7775e-0bd8-49e0-90f9-6d04599b2e50",
                                "sense_id": "f9c62b64-e845-3b36-a548-848e8fa9cf83",
                                "text": "As the colony increases, the granular character becomes more marked, until it seems to be made up of highly refractile granules, like a mass of particles of glass."
                            },
                            {
                                "example_id": "67e43f2b-c6e5-46ce-81fa-e7485822f846",
                                "sense_id": "f9c62b64-e845-3b36-a548-848e8fa9cf83",
                                "text": "Stained bacilli, when examined with the polarising microscope, often show a doubly refractile cell wall (e. g., B. tuberculosis and B. anthracis)."
                            },
                            {
                                "example_id": "cc419a9d-37a3-41f9-882e-015a9be35e74",
                                "sense_id": "f9c62b64-e845-3b36-a548-848e8fa9cf83",
                                "text": "The number of refractile, ovoid spores was determined by phase-contrast microscopy using a hemocytometer."
                            },
                            {
                                "example_id": "6ab99281-79e2-4640-8170-e1bb4c0369b0",
                                "sense_id": "f9c62b64-e845-3b36-a548-848e8fa9cf83",
                                "text": "He watched daily through the microscope for characteristic signs of viral infection, and eventually saw what he later described as a “peculiar rounding of scattered cells with refractile bodies in the cytoplasm and nucleus.”"
                            }
                        ]
                    }
