                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Художник мастерски передал <w>игру</w> света и тени на полотне.",
                            "target_lang_translations": {
                                "en": "The artist masterfully conveyed the <w>play</w> of light and shadow on the canvas.",
