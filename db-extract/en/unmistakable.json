                    {
                        "translation_id": "edf9c153-868a-4728-be72-c3436b8dca4c",
                        "source_entry_id": "155363c4-a599-3968-801a-9ca6c7d8a1bd",
                        "source_sense_id": "c68a5432-a8ae-3f7e-a5c2-ecb9e0d21b60",
                        "source_sense_description": "unique, such that it cannot be mistaken for something else",
                        "target_lang_word": "unverkennbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
