                        "entry_id": "7c8dc84d-03a6-3e4e-9757-16c93a9e7a09",
                        "glosses": [
                            "zachęcanie kogoś do walki przez okrzyki, śpiewy itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc8e7b45-4e2b-4b6f-b6d0-9e5524ad5bc7",
                                "sense_id": "519f0d28-3516-33ec-abe0-8dce7ba32ec5",
                                "text": "Doping kibiców był dla niemieckich piłkarzy zbyt słabą podnietą wobec przewagi drużyny z Mediolanu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2214f43b-4761-3d70-97cd-363568ec0be4",
                        "entry_id": "7c8dc84d-03a6-3e4e-9757-16c93a9e7a09",
                        "glosses": [
                            "zwiększanie swoich możliwości fizycznych przez stosowanie substancji nielegalnych lub dozwolonych, ale w zbyt dużej ilości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca5b1a0-27ef-48eb-bb36-6db626562ddf",
                                "sense_id": "2214f43b-4761-3d70-97cd-363568ec0be4",
                                "text": "Ten kolarz został zawieszony na okres sześciu miesięcy za doping wydolnościowy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "413471ea-25c2-32e9-b850-324d220d928d",
                        "entry_id": "7c8dc84d-03a6-3e4e-9757-16c93a9e7a09",
                        "glosses": [
                            "środek farmakologiczny przyjmowany w celu zwiększenia wydolności organizmu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ac5b00f7-42ca-440b-a663-d7a1290816e7",
                                "sense_id": "413471ea-25c2-32e9-b850-324d220d928d",
                                "text": "Inwestowanie w chemiczny doping mózgu nie jest pozbawione ryzyka - i na dłuższą metę się nie opłaca."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
