                "senses": [
                    {
                        "sense_id": "d7bb46c6-62a9-3fbe-8ce5-df7aaee2783e",
                        "entry_id": "73908fea-4df8-3102-8822-e69cb7a0d9a4",
                        "glosses": [
                            "Anzahl der Veränderungen im Erbgut (Mutationen) in Bezug zur Anzahl der Zellteilungen oder in Bezug auf eine Generation"
                        ],
                        "tags": [
                            "Genetik",
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4ae1f421-09be-471e-9498-867d9aaca713",
                                "sense_id": "d7bb46c6-62a9-3fbe-8ce5-df7aaee2783e",
                                "text": "„Beim Menschen wird eine hohe Mutationsrate von 4,2 Aminosäure ändernden Mutationen pro diploidem Genom pro Generation angenommen.“"
                            },
                            {
                                "example_id": "94fb2c34-5906-4172-bd0e-b82de315e44e",
                                "sense_id": "d7bb46c6-62a9-3fbe-8ce5-df7aaee2783e",
                                "text": "Eine hohe Mutationsrate erleichtert es dem Virus, sich an veränderte Umstände, wie zum Beispiel umfassende Impfungen, anzupassen."
                            },
                            {
                                "example_id": "df9a1b92-7f49-4e62-92a9-a552f0e2250a",
                                "sense_id": "d7bb46c6-62a9-3fbe-8ce5-df7aaee2783e",
                                "text": "„Mathematisch lässt sich zeigen, dass es für geringe Mutationsraten optimal ist, wenn die Fitness exponentiell ansteigt. Wenn die Mutationsraten sehr hoch sind, dann ist der Prozess schneller, wenn die Fitness nur im letzten Schritt stark ansteigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
