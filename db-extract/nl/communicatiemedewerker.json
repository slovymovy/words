                            {
                                "example_id": "79dab387-88f2-4dbb-9385-d9dd0fcb4457",
                                "sense_id": "0ea3baa7-fa7c-3f2d-93b9-9e2906ae83d2",
                                "text": "In de begeleidende mail verzoekt Bureau Communicatie van de UvA de facultaire communicatiemedewerkers om na te gaan of de mensen op de lijst betrokken zijn bij de organisatie van de bachelordag van vorige zaterdag. Ook wil de UvA dat de faculteiten „een inschatting maken hoe groot de kans is dat dat 'gedoe' oplevert en dat terugkoppelen”, meldt Folia op de website."
                            },
                            {
                                "example_id": "e55e2724-1002-4753-97c7-466a6599e303",
                                "sense_id": "0ea3baa7-fa7c-3f2d-93b9-9e2906ae83d2",
                                "text": "Die vatten Rogier's boodschap overigens sportief op: ‘Het is wel een heel duidelijk gemeentewapen inderdaad. Ik vind hem goed gelukt!’, reageert een communicatiemedewerker via Twitter."
                            },
                            {
                                "example_id": "58eed09a-6675-43e0-baec-b127e4b762c4",
                                "sense_id": "0ea3baa7-fa7c-3f2d-93b9-9e2906ae83d2",
                                "text": "Volgens de arts van het Witte Huis is Trump met zeker twee mensen in contact geweest die besmet zijn met het virus. Een daarvan was een communicatiemedewerker van de Braziliaanse president Jair Bolsonaro."
                            }
                        ]
