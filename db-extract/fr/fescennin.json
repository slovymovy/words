                                        "sense_id": "14a5af55-1e97-3ca6-a35d-13d45e33d273",
                                        "entry_id": "0bb1ff4e-0035-3b81-b940-acc9bdbbfb7d",
                                        "glosses": [
                                            "Of or pertaining to the ancient Etruscan town of Fescennia"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b4ebf15-fdb6-3a75-bedb-55c0b9e8a6c6",
                                        "entry_id": "0bb1ff4e-0035-3b81-b940-acc9bdbbfb7d",
                                        "glosses": [
                                            "obscene or scurrilous"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abfbd773-7eaa-4066-b415-160b521004bd",
                                                "sense_id": "8b4ebf15-fdb6-3a75-bedb-55c0b9e8a6c6",
                                                "text": "At this hour the seat was as in a theatre, but the words of the actors were of a nature somewhat too Fescennine for the public."
                                            },
                                            {
                                                "example_id": "321738c1-1b41-4140-beae-7cd70f97a3c4",
                                                "sense_id": "8b4ebf15-fdb6-3a75-bedb-55c0b9e8a6c6",
                                                "text": "And when Freudian fiction becomes – as it has become in America – but an inviting wall on which to scribble Fescennine filth – that, too, is another matter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5022c0cb-7902-4ce9-962b-2859b8fabc05",
                        "source_entry_id": "1fee7e5e-e16c-37bb-b89c-7068296869a0",
                        "source_sense_id": "8945a431-0602-300b-8c6f-fd861ba479fd",
                        "target_lang_word": "fescennine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fescennine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d37919bd-8e91-3396-b219-e4a1b802d9e0",
                                        "entry_id": "694c3774-88e8-33d2-ab2b-45f4d6737572",
                                        "glosses": [
                                            "Obscene or scurrilous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886ea4eb-8f33-4fc6-838b-364b6cc059d8",
                                                "sense_id": "d37919bd-8e91-3396-b219-e4a1b802d9e0",
                                                "text": "[T]he frolicsome company had begun to practise the ancient and now forgotten pastime of High Jinks. This game was played in several different ways. Most frequently the dice were thrown by the company, and those upon whom the lot fell were obliged to assume and maintain, for a time, a certain fictitious character, or to repeat a certain number of fescennine verses in a particular order."
                                            },
                                            {
                                                "example_id": "ee0e224f-7e1b-4a2c-b8a9-22ca65e1ff8e",
                                                "sense_id": "d37919bd-8e91-3396-b219-e4a1b802d9e0",
                                                "text": "As the poet decorously shows his desire to consummate the marriage, he retains the fescennine element without being crude."
                                            },
                                            {
                                                "example_id": "d617b7cf-d236-4977-bd1f-6875df3c19cc",
                                                "sense_id": "d37919bd-8e91-3396-b219-e4a1b802d9e0",
                                                "text": "The conventional complaint over the delay in the proceedings is voiced by the poet in […] [this] series of questions which include fescennine teasing of the bridal couple"
                                            },
                                            {
                                                "example_id": "b31cd2de-0b1c-459f-9fe5-16eda3d4cf53",
                                                "sense_id": "d37919bd-8e91-3396-b219-e4a1b802d9e0",
                                                "text": "For instance, I admit that this book is anacreontic, paphian, and sometimes even fescennine […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
