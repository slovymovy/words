                {
                    "sense_id": "3059f41b-5869-3085-955b-27314f3baf61",
                    "sense_definition": "Een aanbod of uitnodiging beleefd weigeren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quinten besloot om te <w>bedanken</w> voor de aangeboden baan.",
                            "target_lang_translations": {
                                "ru": "Квинтен решил <w>отказаться</w> от предложенной работы.",
                                "en": "Quinten decided to <w>decline</w> the offered job.",
                                "it": "Quinten ha deciso di <w>rifiutare</w> il lavoro offerto.",
                                "pl": "Quinten postanowił <w>odmówić</w> przyjęcia oferowanej pracy.",
                                "de": "Quinten beschloss, das Stellenangebot <w>abzulehnen</w>.",
                                "fr": "Quinten a décidé de <w>décliner</w> l'offre d'emploi.",
                                "cs": "Quinten se rozhodl nabízenou práci <w>odmítnout</w>.",
                                "tr": "Quinten, teklif edilen işi <w>reddetmeye</w> karar verdi.",
                                "es": "Quinten decidió <w>rechazar</w> el trabajo ofrecido.",
                                "zh": "昆汀决定<w>婉拒</w>这份提供的工作。"
                            }
                        },
                        {
                            "text": "Voor dat risicovolle avontuur <w>bedank</w> ik liever.",
                            "target_lang_translations": {
                                "ru": "От этого рискованного приключения я лучше <w>откажусь</w>.",
                                "en": "I would rather <w>pass</w> on that risky adventure.",
                                "it": "Per quell'avventura rischiosa preferisco <w>declinare</w>.",
                                "pl": "Wolę <w>odmówić</w> udziału w tej ryzykownej przygodzie.",
                                "de": "Bei diesem riskanten Abenteuer <w>lehne</w> ich lieber <w>dankend ab</w>.",
                                "fr": "Pour cette aventure risquée, je préfère <w>refuser</w>.",
                                "cs": "Tomuto riskantnímu dobrodružství raději <w>poděkuji</w>.",
                                "tr": "O riskli macera için <w>teşekkür etmemeyi</w> tercih ederim.",
                                "es": "Prefiero <w>declinare</w> esa arriesgada aventura.",
                                "zh": "对于那场充满风险的冒险，我还是<w>谢绝</w>了。"
                            }
                        }
