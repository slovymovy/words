                                        "glosses": [
                                            "A dismissal of employees from their jobs because of tightened budgetary constraints or work shortage (not due to poor performance or misconduct)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
