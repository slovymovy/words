                        "examples": [
                            {
                                "example_id": "1698de6d-6e4e-4ea7-ac1a-cee76821fd94",
                                "sense_id": "ce7466c9-86ba-33a7-a3a8-cb0606120fab",
                                "text": "De winnaar wordt traditiegetrouw bekend gemaakt tijdens een galadiner in het Amstel Hotel in Amsterdam. Nieuwsuur zendt de prijsuitreiking live uit op maandag 8 mei 2017."
                            },
                            {
                                "example_id": "dff0d9be-9183-4416-9b4a-a1f70efd8764",
                                "sense_id": "ce7466c9-86ba-33a7-a3a8-cb0606120fab",
                                "text": "Het idee komt van priester Ángel García Rodríguez, in Spanje beter bekend als Padre Ángel. Hij is de oprichter van de liefdadigheidsorganisatie Boodschappers van de Vrede en zet zich vaker in voor daklozen. Zo organiseerde hij vorig jaar op kerstavond een galadiner voor tweehonderd daklozen in het stadhuis van Madrid en regelde hij voor de armste Madrilenen gratis wifi en een app om virtueel te biechten."
                            }
                        ]
