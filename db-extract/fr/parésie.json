                        "glosses": [
                            "Perte partielle des capacités motrices d’une partie du corps (limitation de mouvement, diminution de la force musculaire), parfois transitoire sur un ou plusieurs muscles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f0570a-cef2-4b5f-9d0f-29f13e223216",
                                "sense_id": "b63980ca-e077-3959-be7a-6e0607962165",
                                "text": "Le premier est qu’en cas de parésie du muscle grand oblique, il y a une augmentation du désalignement vertical dans le champ d’action du grand oblique c’est-à-dire dans le regard vers le bas."
                            }
                        ]
                    }
