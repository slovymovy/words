{
    "word_family": [
        "order",
        "orderly",
        "disorder",
        "ordering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a49ab436-3260-3cab-aaa7-91539a2371ea",
                    "sense_definition": "To place items in a new sequence or arrangement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The librarian decided to <w>reorder</w> the shelves to make the books easier to find.",
                            "target_lang_translations": {
                                "zh": "图书管理员决定<w>重新排列</w>书架，以便更容易找到书。"
                            }
                        },
                        {
                            "text": "You should <w>reorder</w> these files so that the most recent documents are at the top.",
                            "target_lang_translations": {
                                "zh": "你应该<w>重新排列</w>这些文件，把最新的文档放在最上面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rearrange",
                        "reorganize"
                    ],
                    "common_phrases": [
                        "reorder files",
                        "reorder items"
                    ],
                    "target_lang_definitions": {
                        "zh": "将物品按新的顺序或排列方式放置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重新排列",
                                "target_lang_sense_clarification": "指改变物品或数据的顺序。"
                            },
                            {
                                "target_lang_word": "重新整理",
                                "target_lang_sense_clarification": "指对事物进行重新组织或归类。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "471bd359-c52a-3cb7-b348-fe0ecfed0eb3",
                    "sense_definition": "To purchase or request a product again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "purchase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>reorder</w> printer paper because we are running out of stock.",
                            "target_lang_translations": {
                                "zh": "我们需要<w>再次订购</w>打印纸，因为库存快用完了。"
                            }
                        },
                        {
                            "text": "The restaurant had to <w>reorder</w> fresh ingredients after a very busy weekend.",
                            "target_lang_translations": {
                                "zh": "在非常忙碌的周末过后，这家餐厅不得不<w>再次订购</w>新鲜食材。"
                            }
                        }
                    ],
                    "synonyms": [
                        "restock",
                        "replenish"
                    ],
                    "common_phrases": [
                        "reorder supplies",
                        "reorder stock"
                    ],
                    "target_lang_definitions": {
                        "zh": "再次购买或请求提供某种产品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "再次订购",
                                "target_lang_sense_clarification": "指对已购买过的商品进行补货。"
                            },
                            {
                                "target_lang_word": "补货",
                                "target_lang_sense_clarification": "指补充库存。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca086764-2994-32e2-921e-11053c176cf7",
                    "sense_definition": "To issue an instruction or command to someone again.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge <w>reordered</w> the witness to answer the question clearly.",
                            "target_lang_translations": {
                                "zh": "法官<w>再次命令</w>证人清楚地回答问题。"
                            }
                        },
                        {
                            "text": "The manager <w>reordered</w> the staff to finish the project by the end of the day.",
                            "target_lang_translations": {
                                "zh": "经理<w>再次命令</w>员工在今天结束前完成项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reinstruct",
                        "recommand"
                    ],
                    "target_lang_definitions": {
                        "zh": "再次向某人发出指令或命令。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "再次命令",
                                "target_lang_sense_clarification": "指重复下达指令。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce827b0a-4f21-3914-9dbd-fa4a9346465f",
                    "sense_definition": "The act of arranging something in a new sequence or the act of purchasing something again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system automatically generates a <w>reorder</w> when inventory levels drop below ten units.",
                            "target_lang_translations": {
                                "zh": "当库存水平降至十个单位以下时，系统会自动生成一份<w>再次订购</w>请求。"
                            }
                        },
                        {
                            "text": "A quick <w>reorder</w> of the data helped the team identify the error in the report.",
                            "target_lang_translations": {
                                "zh": "对数据进行快速<w>重新排列</w>，帮助团队找出了报告中的错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stock reorder",
                        "automatic reorder"
                    ],
                    "target_lang_definitions": {
                        "zh": "以新顺序排列某事物的行为，或再次购买某事物的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重新排列",
                                "target_lang_sense_clarification": "指排列动作的名词化。"
                            },
                            {
                                "target_lang_word": "再次订购",
                                "target_lang_sense_clarification": "指补货动作的名词化。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}