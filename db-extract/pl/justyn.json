                            {
                                "example_id": "6fac02b4-6700-46d3-97ac-324e6c18d079",
                                "sense_id": "35e5159c-2b18-3233-ae39-ecde935ff158",
                                "text": "Nikt nie powiedział Justynowi o przylocie Kingi."
                            },
                            {
                                "example_id": "a0d5a628-b56b-4332-a322-40cae5b84e62",
