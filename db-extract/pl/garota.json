                    {
                        "translation_id": "a490ec55-8b8f-4680-9732-10bda7e90d6e",
                        "source_entry_id": "a4e023f0-c599-380e-a6fa-34b40402584f",
                        "source_sense_id": "fbf833f8-7763-3e5d-8be9-dfecb8b03c69",
