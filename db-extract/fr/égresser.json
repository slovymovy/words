                "senses": [
                    {
                        "sense_id": "69dcf418-6dc6-3d0e-a31d-c227ec167dec",
                        "entry_id": "add5ab92-3e95-3641-b9fb-37b334200215",
                        "glosses": [
                            "Se rapprocher du trou laissé par la dent opposée absente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87fbbb4f-b162-4c5b-b999-10ee99d4acd2",
                                "sense_id": "69dcf418-6dc6-3d0e-a31d-c227ec167dec",
                                "text": "La dent antagoniste à la dent perdue s'égresse, l'harmonie des courbes occlusales est altérée."
                            },
                            {
                                "example_id": "7fe05ad2-b19e-4ef1-bd99-9fcbbf4d5d6e",
                                "sense_id": "69dcf418-6dc6-3d0e-a31d-c227ec167dec",
                                "text": "L'objectif est de faire égresser la dent."
                            },
                            {
                                "example_id": "75031955-38dd-418e-a5f6-1a43f5fc627a",
                                "sense_id": "69dcf418-6dc6-3d0e-a31d-c227ec167dec",
                                "text": "Si la deuxième prémolaire du bas est manquante, la molaire du haut n'a plus du tout d'appui et s'égresse vers le bas."
                            }
                        ]
                    }
