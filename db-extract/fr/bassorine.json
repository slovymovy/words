                        "entry_id": "bed52fb0-bde6-365e-b2a8-853fffac0f15",
                        "glosses": [
                            "Substance blanche qui compose 70 % de la gomme adragante, ainsi que la majeure partie des gommes végétales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "130a1b1c-e36e-4e25-973d-0fc0766d00e6",
                                "sense_id": "63138b11-5d1b-3f49-b67b-a4228f76ed87",
                                "text": "De même que chez la gomme adragante, la partie insoluble est ici constituée de bassorine."
                            },
                            {
                                "example_id": "040bbf17-8493-4f10-8ad4-271f37b9ea65",
                                "sense_id": "63138b11-5d1b-3f49-b67b-a4228f76ed87",
                                "text": "La tapisserie parviflore des murs disparaissait sous une multitude de trésors à quatre sous : une citole aux cordes éclatées, des fleurs séchées sous verre, fixés à la bassorine, des fétiches des Iles, des cartes postales allemandes encadrées, des coquillages marins."
                            }
                        ]
                    }
