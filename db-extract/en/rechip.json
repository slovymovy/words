                        "glosses": [
                            "To chip again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9af9707d-049a-4ad7-94b2-a273675df29b",
                                "sense_id": "a91d0fe1-42a1-3352-a9ce-4f5a6e9f8546",
                                "text": "Many times was it necessary to rechip the blade, and thus resharpen it, before he had cut down through the thick hide and blubber and thus into the firm muscles where the steel harpoon head was firmly embedded; but at last he drew it forth."
                            },
                            {
                                "example_id": "ef7c2de9-8da8-475e-8a4c-318c4f365004",
                                "sense_id": "a91d0fe1-42a1-3352-a9ce-4f5a6e9f8546",
                                "text": "The necessity for sandblasting a concrete area after chipping is questionable. If contamination of a chipped area does occur and cannot be cleaned by an air-water blast it is better to rechip the area […]"
                            }
                        ]
                    }
