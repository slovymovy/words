                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He was born in <w>Friendship</w>, Arkansas, a small town in Hot Spring County.",
                            "target_lang_translations": {
                                "ru": "Он родился во <w>Френдшипе</w>, штат Арканзас, небольшом городке в округе Хот-Спринг.",
                                "zh": "他出生在阿肯色州热泉县的一个小镇——<w>弗伦德希普</w>。"
                            }
                        },
                        {
                            "text": "The village of <w>Friendship</w> serves as the county seat of Adams County, Wisconsin.",
                            "target_lang_translations": {
                                "ru": "Деревня <w>Френдшип</w> является административным центром округа Адамс, штат Висконсин.",
                                "zh": "威斯康星州亚当斯县的县治位于<w>弗伦德希普</w>村。"
                            }
                        }
                    ],
                    "traits": [
