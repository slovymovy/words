                        "entry_id": "edf10fd6-9aa0-34df-a414-2ae18a5819e4",
                        "glosses": [
                            "A First Nation group based on the west coast of Vancouver Island in British Columbia, Canada, from the area around Tofino Inlet, Kennedy Lake and the Esowista Peninsula."
                        ],
                        "tags": [
                            "plural",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "f03a698d-0bc3-469d-a090-b5e44e7b6dc8",
                                "sense_id": "0d12c1ea-19f4-3e23-baf7-2d2006bc105a",
                                "text": "The Tla-o-qui-aht (Clayoquot) First Nation, located in the souther end of Clayoquot Sound, took shape from an alliance of smaller groups, many originally living around Kennedy Lake. The word “Tla-o-qui-aht” translates as “people of different tribes” and also as “people of Clayoqua (Tla-o-qua),” an area of the Kennedy Lake system. Their traditional territory covers the land around Kennedy Lake and Kennedy River, as well as Tofino Inlet, Esowista Peninsula, the islands offshore, and Mears Island."
                            }
                        ]
                    }
