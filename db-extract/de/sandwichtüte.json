                        "examples": [
                            {
                                "example_id": "49ae2113-4532-4b96-881c-543bdcf598f1",
                                "sense_id": "47ef459e-5e82-30f7-8a69-9a96bb5c1c27",
                                "text": "„Tyler fängt an, Sandwichtüten mit gefrorenem weißem Zeug herauszuziehen und in den Ausguss zu werfen.“"
                            },
                            {
                                "example_id": "574b3545-d9f9-4abd-be1d-0a46df13293f",
                                "sense_id": "47ef459e-5e82-30f7-8a69-9a96bb5c1c27",
                                "text": "„Hier hatten sie noch nicht einmal ihre Haut, als sie an mit Abfall verunzierten Flussufern zwischen den Außenbordmotorölflaschen und Sandwichtüten lagen, die zu dem landesüblichen Dreck gehören.“"
                            }
                        ],
