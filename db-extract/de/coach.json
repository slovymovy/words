                "senses": [
                    {
                        "sense_id": "d3c78c61-b3a9-3313-b609-4f284ab269ca",
                        "entry_id": "b45d34ff-3ab0-3fae-9001-6521fb2fc772",
                        "glosses": [
                            "jemand, der eine Person oder Mannschaft trainiert und betreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65751b4c-55fd-4482-87cb-7f8d9129d6f4",
                                "sense_id": "d3c78c61-b3a9-3313-b609-4f284ab269ca",
                                "text": "„Als Shiffrin im Teenageralter zur US-Mannschaft stieß, übte sie zeitweise allein mit ihren Coaches – man wollte die anderen Frauen nicht zu sehr frustrieren.“"
                            },
                            {
                                "example_id": "068d5e21-99c6-430e-8fc3-43fa393ad82d",
                                "sense_id": "d3c78c61-b3a9-3313-b609-4f284ab269ca",
                                "text": "„Dabei wirkte der Coach der Ukraine jedoch nicht wie ein Trainer, dessen Team eben gegen einen der Turnierfavoriten verloren hat, auch wenn der den Beweis dafür dessen [sic] in diversen Phasen des Spiels schuldig geblieben war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
