        "fr-extract.jsonl": [
            {
                "entry_id": "03c6660c-3dd6-3dfb-a003-f899152432f0",
                "word": "pleutre",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cb7f3684-ffe2-4601-a6c5-03eea72ab7cd",
                        "entry_id": "03c6660c-3dd6-3dfb-a003-f899152432f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "pleutres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90f7589f-cce6-3495-b7db-9e0eb21743f6",
                        "entry_id": "03c6660c-3dd6-3dfb-a003-f899152432f0",
                        "glosses": [
                            "Peureux, lâche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f40d597-d98c-4bae-b120-8091d666ecb9",
                                "sense_id": "90f7589f-cce6-3495-b7db-9e0eb21743f6",
                                "text": "Semblable à beaucoup de ces entrepreneurs dopés à l’hyper-croissance, Cyborg génère par atavisme, mimétisme cupide, conviction idiote ou crainte pleutre, un comportement déviant auprès de ses plus proches cadres."
                            },
                            {
                                "example_id": "6cfb365c-456a-4399-96a8-5e291704dc55",
                                "sense_id": "90f7589f-cce6-3495-b7db-9e0eb21743f6",
                                "text": "Honte à vous, les libraires ! Honte à vous de vous être écrasés ainsi ! Honte à vous d’avoir été aussi pleutres !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1067e1f-00bd-4a1c-9cb6-96bc401f0312",
                        "source_entry_id": "03c6660c-3dd6-3dfb-a003-f899152432f0",
                        "source_sense_id": "90f7589f-cce6-3495-b7db-9e0eb21743f6",
                        "target_lang_word": "cowardly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cowardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c85455b5-3158-3f95-ae3e-fc88b1c93de3",
                                        "entry_id": "ac59e5c2-0ded-3ad4-95c6-bb68c0bd6848",
                                        "glosses": [
                                            "Showing cowardice; lacking in courage; weakly fearful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae137751-3617-4f19-b9fe-11ee23580820",
                                                "sense_id": "c85455b5-3158-3f95-ae3e-fc88b1c93de3",
                                                "text": "The cowardly rascals that ran from the battle."
                                            },
                                            {
                                                "example_id": "ddaff0a6-0504-4d53-9939-7e89f8a6c64c",
                                                "sense_id": "c85455b5-3158-3f95-ae3e-fc88b1c93de3",
                                                "text": "1780, Edmund Burke, speech at The Guildhall, in Bristol\nThe cowardly rashness of those who dare not look danger in the face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cowardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                        "entry_id": "ba759829-1f4a-3315-98a4-6b1caba8ee5a",
                                        "glosses": [
                                            "In the manner of a coward, cowardlily."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfd65c9-cc09-49ff-9333-140e933209f9",
                                                "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                                "text": "We will not ſteale vpon him cowardly,\nBut giue him warning and more warriours."
                                            },
                                            {
                                                "example_id": "4fe1b856-ab93-4dbe-a0ff-2cf77a105ef1",
                                                "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                                "text": "I love to follow them, but not so cowardly, as my life remaine thereby in subjection."
                                            },
                                            {
                                                "example_id": "d2de41cf-ca12-4e83-9fdb-8e19815a91cf",
                                                "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                                "text": "[…] men who cowardly and hypocritically subscribe orthodox creeds, whilst they teach a different kind of doctrine!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "973d5055-a324-438d-8f20-4001b44da518",
                        "source_entry_id": "03c6660c-3dd6-3dfb-a003-f899152432f0",
                        "source_sense_id": "90f7589f-cce6-3495-b7db-9e0eb21743f6",
