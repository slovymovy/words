                {
                    "sense_id": "6f34261d-2aba-3e2a-8547-2aa17d9ca867",
                    "sense_definition": "Zwei oder mehr Gegenstände, Fahrzeuge oder elektronische Geräte fest oder technisch miteinander verbinden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verbinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Fahrer <w>koppelte</w> den großen Anhänger vorsichtig an den Traktor."
                        },
                        {
                            "text": "Sie müssen das neue Smartphone über Bluetooth mit den Lautsprechern <w>koppeln</w>."
                        }
                    ],
                    "antonyms": [
                        "lösen",
                        "trennen"
                    ],
                    "common_phrases": [
