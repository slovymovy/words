                "senses": [
                    {
                        "sense_id": "a2ce2ee4-084f-399f-bbdc-f8c72731eca3",
                        "entry_id": "09d88f25-a9bc-3f02-a532-8099a4e3523c",
                        "glosses": [
                            "skaliertes Hilfsmittel, das zur Bestimmung der blauen Farbe des Himmels dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60e2c2a7-8281-46cd-a657-5693704460f3",
                                "sense_id": "a2ce2ee4-084f-399f-bbdc-f8c72731eca3",
                                "text": "„Es gab sogar ein Zyanometer, um die Himmelsbläue zu messen, das der Dichter Byron satirisch aufs Korn nahm.“"
                            },
                            {
                                "example_id": "b72f1855-a3a3-4320-b1bc-500b9b39157d",
                                "sense_id": "a2ce2ee4-084f-399f-bbdc-f8c72731eca3",
                                "text": "„Einer dieser Vorzüge sind die klaren, reinen Himmel, die so leuchten wie der dieses Hochtals, wo das Blau oft genug vierundzwanzig Grad auf dem Zyanometer von de Saussure erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
