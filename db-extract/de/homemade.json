                ],
                "senses": [
                    {
                        "sense_id": "f9b22d1a-08e2-375f-babc-56d500a8ee57",
                        "entry_id": "d846949a-e9da-3e12-accb-4fdfec0675b0",
                        "glosses": [
                            "von der betreffenden Person oder Firma selbst gefertigt/produziert, nicht von jemand anderem gemacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eb9ac57-150d-47ab-a7b5-5aa27727af71",
                                "sense_id": "f9b22d1a-08e2-375f-babc-56d500a8ee57",
                                "text": "„Das ist ziemlich lukrativ, weil man es leicht als ‚homemade‘ verkaufen kann.“"
                            },
                            {
                                "example_id": "4b54643c-0efe-4110-929f-9ab3ac5241a4",
                                "sense_id": "f9b22d1a-08e2-375f-babc-56d500a8ee57",
                                "text": "„Die Laberl homemade, das leicht süßliche Brioche aber einen Tick zu weich.“"
                            },
                            {
                                "example_id": "22bac446-6e77-457b-8caf-df80a2744c01",
                                "sense_id": "f9b22d1a-08e2-375f-babc-56d500a8ee57",
                                "text": "„Die Deli-, Cheese- oder vegetarischen Burger können entweder direkt im Lokal mit homemade Eistee an Tischen aus regionalem Holz verzehrt oder verpackt in recyclebaren Materialien mitgenommen werden.“"
                            },
                            {
                                "example_id": "ed2de1d1-9e11-4fd0-869f-4701e2379bce",
                                "sense_id": "f9b22d1a-08e2-375f-babc-56d500a8ee57",
                                "text": "„Das ist vielleicht der Reiz des Ganzen: Es schmeckt goddamn homemade, aber es sind immer ein, zwei ungewöhnliche Spezialzutaten untergemischt.“"
                            },
                            {
                                "example_id": "87cc7982-5670-419c-afc3-9aa4c71b32d9",
                                "sense_id": "f9b22d1a-08e2-375f-babc-56d500a8ee57",
                                "text": "„Das Beste, was die US-amerikanische Küche, zu bieten hat, wird aufgefahren: »homemade Hamburger & Fries«, »Pulled Pork & Coleslaw«, also gezupfte Schweineschulter mit Krautsalat, und auch Vegetarisches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
