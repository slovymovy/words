                "translations": [
                    {
                        "translation_id": "6f2cd03c-37fc-4214-ad45-be3c969557fa",
                        "source_entry_id": "b874850e-bf08-30b7-abd5-0536d9501b8c",
                        "source_sense_id": "1292839f-3cae-3a57-a3e1-5db2e3967da1",
                        "target_lang_word": "rustle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A soft crackling sound similar to the movement of dry leaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af3ee78-5880-4a76-a3d1-e7b51f4ef070",
                                                "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                                "text": "He heard the silken rustle of a dressing-gown being drawn on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeeac5c-9345-320e-9f70-819a801bb7bb",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A movement producing such a sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To move (something) with a soft crackling sound."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd03a0fb-4128-4447-8a6f-9488e2ff46f5",
                                                "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                                "text": "The next day at three o'clock we were again at the door, and the footmen as before; we heard the silk dress rustle, and the lady came down the steps and in an imperious voice, she said, \"York, you must put those horses' heads higher, they are not fit to be seen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To make or obtain in a lively, energetic way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982d36d9-73ef-4d3e-9abb-6dd2ce90d938",
                                                "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                                "text": "When at last the lumber was piled again in its rightful place, and the boxes of food had been returned to the shelter from which they had been stolen, the two friends rustled a meal, and then set off on horseback […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb0de50-dfb9-3308-9d43-ff3a9af9c952",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To steal (cattle or other livestock)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9eee8d1a-81ab-4b0d-b0ff-1844c24865df",
                        "source_entry_id": "b874850e-bf08-30b7-abd5-0536d9501b8c",
                        "source_sense_id": "1292839f-3cae-3a57-a3e1-5db2e3967da1",
                        "target_lang_word": "whisper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whisper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07fe07f0-51d7-3cec-8cb5-26c994e2a9bd",
                                        "entry_id": "0b1f1743-d8c6-3972-9919-df2509bc8e8b",
                                        "glosses": [
                                            "The act of speaking in a quiet voice, especially without vibration of the vocal cords."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6206e6a4-d55a-420e-b931-ca5b6d11b267",
                                                "sense_id": "07fe07f0-51d7-3cec-8cb5-26c994e2a9bd",
                                                "text": "I spoke in a near whisper."
                                            },
                                            {
                                                "example_id": "96a81ba2-7774-49e8-8b1d-6386d7d62dfc",
                                                "sense_id": "07fe07f0-51d7-3cec-8cb5-26c994e2a9bd",
                                                "text": "\"Now, look here, Jim Hawkins,\" he said, in a steady whisper, that was no more than audible."
                                            },
                                            {
                                                "example_id": "392a9099-da93-460e-a1eb-c2b30e6243dd",
                                                "sense_id": "07fe07f0-51d7-3cec-8cb5-26c994e2a9bd",
                                                "text": "You know love is everything you say / A whisper, a word / Promises you give"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838fb551-742e-3637-bc47-2537c96d99bc",
                                        "entry_id": "0b1f1743-d8c6-3972-9919-df2509bc8e8b",
                                        "glosses": [
                                            "A rumor."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b96a252a-11d0-48f4-8fe1-0086167bdbf8",
                                                "sense_id": "838fb551-742e-3637-bc47-2537c96d99bc",
                                                "text": "There are whispers of rebellion all around."
                                            },
                                            {
                                                "example_id": "08e7de7f-9fc7-4c66-bd7f-3bcdbc8c06a4",
                                                "sense_id": "838fb551-742e-3637-bc47-2537c96d99bc",
                                                "text": "Time can never mend / The careless whispers of a good friend"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e13dc0f-c3b6-31ca-9127-aad00bf03730",
                                        "entry_id": "0b1f1743-d8c6-3972-9919-df2509bc8e8b",
                                        "glosses": [
                                            "A faint trace or hint (of something)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2a9e813-2c8c-45e9-bb10-dd97a05b4c34",
                                                "sense_id": "5e13dc0f-c3b6-31ca-9127-aad00bf03730",
                                                "text": "The soup had just a whisper of basil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c303987c-7658-3994-b7b4-777b2981176a",
                                        "entry_id": "0b1f1743-d8c6-3972-9919-df2509bc8e8b",
                                        "glosses": [
                                            "A low rustling sound, like that of the wind in leaves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e94b6788-7747-3302-b2d0-01601358332c",
                                        "entry_id": "0b1f1743-d8c6-3972-9919-df2509bc8e8b",
                                        "glosses": [
                                            "A private message to an individual in a chat room."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71771e4e-dceb-4da6-be63-f231735208b2",
                                                "sense_id": "e94b6788-7747-3302-b2d0-01601358332c",
                                                "text": "The invisibility of private interactions in the form of whispers resolved an ethical concern in the research but reduced our ability to gauge the volume of interaction […]"
                                            },
                                            {
                                                "example_id": "53e38022-3f72-4304-be5e-2023079a0a9a",
                                                "sense_id": "e94b6788-7747-3302-b2d0-01601358332c",
                                                "text": "Anyone logged in to the chat room can click on an individual name, highlighting it, and send a message — a whisper — that will be seen only by the selected person."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whisper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3320db69-169a-328b-8485-40a72c1027b2",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To speak softly or under one's breath, so as to be heard only by one near at hand; to utter words without sonant breath; to talk without that vibration of the vocal cords which gives sonorous, or vocal, sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c825df-8eef-4468-b1ea-1f0868674135",
                                                "sense_id": "3320db69-169a-328b-8485-40a72c1027b2",
                                                "text": "I can hear them whisper as we pass by\nIt's a bad sign, bad sign"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "222453e5-f9f5-339c-b796-dcef941a596a",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To say (something) softly or under one's breath, so as to be heard only by one near at hand; to utter (something) without sonant breath, without that vibration of the vocal cords which gives sonorous, or vocal, sound."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f004f7-e157-4248-88b7-4f56edc6549f",
                                                "sense_id": "222453e5-f9f5-339c-b796-dcef941a596a",
                                                "text": "Whether he whispered sweet nothings to her in Stengelese is not known, but he did call her \"the best catch I ever made in my career.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c737e62-0be6-380a-8fa8-7080234cbaed",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To mention privately and confidentially, or in a whisper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332d4c1a-70db-4770-8dd4-9adf982e4d29",
                                                "sense_id": "6c737e62-0be6-380a-8fa8-7080234cbaed",
                                                "text": "They might buzz and whisper it one to another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "281dcaf0-92f8-312c-90e1-67163da4eb8c",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To make a low, sibilant sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2edc1863-05a4-4e6b-a3c5-ec6551def29c",
                                                "sense_id": "281dcaf0-92f8-312c-90e1-67163da4eb8c",
                                                "text": "the hollow, whispering breeze"
                                            },
                                            {
                                                "example_id": "ef1226be-6119-4841-82ec-aec951c222d0",
                                                "sense_id": "281dcaf0-92f8-312c-90e1-67163da4eb8c",
                                                "text": "[…] hear thy laurel whisper sweet\nAbout the ledges of the hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bee5f4b-7f7f-3ce7-a21b-981a9a49cb50",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To speak with suspicion or timorous caution; to converse in whispers, as in secret plotting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14f559f0-b7b6-45b1-882d-32361fd8ef4b",
                                                "sense_id": "0bee5f4b-7f7f-3ce7-a21b-981a9a49cb50",
                                                "text": "All that hate me whisper together against me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfdbabe8-12ac-38c4-b262-761fafbe36ea",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To address in a whisper, or low voice."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66bc0640-160c-4b88-8214-9b5b3c1a3f04",
                                                "sense_id": "dfdbabe8-12ac-38c4-b262-761fafbe36ea",
                                                "text": "and whisper one another in the ear"
                                            },
                                            {
                                                "example_id": "8fc059b8-08f8-4873-9f71-b51540a8bef8",
                                                "sense_id": "dfdbabe8-12ac-38c4-b262-761fafbe36ea",
                                                "text": "where gentlest breezes whisper souls distressed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c30e92a4-9ddd-321e-a81c-535e0156d9d1",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To prompt secretly or cautiously; to inform privately."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a92c2f34-5de4-44a9-b484-05118d48430f",
                                                "sense_id": "c30e92a4-9ddd-321e-a81c-535e0156d9d1",
                                                "text": "He came to whisper Wolsey."
                                            },
                                            {
                                                "example_id": "d988024e-b3ce-4e29-85e1-266da939fdaf",
                                                "sense_id": "c30e92a4-9ddd-321e-a81c-535e0156d9d1",
                                                "text": "[A] simple youth whispered me that he was an Illuminé, and carried on an intercourse with the invisible world."
