                    "sense_id": "6449cd4b-85ef-3b51-9a76-35d904bc77e3",
                    "sense_definition": "Niet hetzelfde zijn; afwijken van iets of iemand anders.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijzen kunnen per winkel sterk <w>verschillen</w>.",
                            "target_lang_translations": {
                                "en": "Prices can <w>vary</w> greatly per shop.",
                                "ru": "Цены могут сильно <w>различаться</w> в зависимости от магазина.",
                                "fr": "Les prix peuvent fortement <w>varier</w> d'un magasin à l'autre.",
                                "it": "I prezzi possono <w>variare</w> notevolmente da negozio a negozio."
                            }
                        },
                        {
                            "text": "Mijn mening <w>verschilt</w> op dit punt van die van jou.",
                            "target_lang_translations": {
                                "en": "My opinion <w>differs</w> from yours on this point.",
                                "ru": "Мое мнение по этому вопросу <w>отличается</w> от твоего.",
                                "fr": "Mon opinion <w>diffère</w> de la tienne sur ce point.",
                                "it": "La mia opinione su questo punto <w>differisce</w> dalla tua."
                            }
                        },
                        {
                            "text": "De twee versies <w>verschilden</w> maar op een paar plaatsen.",
                            "target_lang_translations": {
                                "en": "The two versions <w>differed</w> in only a few places.",
                                "ru": "Две версии <w>отличались</w> лишь в нескольких местах.",
                                "fr": "Les deux versions ne <w>différaient</w> que sur quelques points.",
                                "it": "Le due versioni <w>differivano</w> solo in pochi punti."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwijken",
                        "uiteenlopen",
                        "variëren"
                    ],
                    "antonyms": [
                        "overeenkomen",
                        "lijken"
                    ],
                    "common_phrases": [
                        "van mening verschillen",
                        "van elkaar verschillen",
                        "sterk verschillen"
                    ],
                    "target_lang_definitions": {
                        "en": "To not be the same; to deviate from something or someone else.",
                        "ru": "Не быть одинаковым; отличаться от чего-то или кого-то другого.",
                        "fr": "Ne pas être identique ; être différent de quelque chose ou de quelqu'un d'autre.",
                        "it": "Non essere identico; deviare da qualcosa o qualcuno."
                    },
