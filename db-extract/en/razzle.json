                        "examples": [
                            {
                                "example_id": "ce7f4232-4e98-4416-9dec-b634c989219f",
                                "sense_id": "35d2d6ef-64b7-3657-9e6e-c538b661c41f",
                                "text": "My sister had the good sense to keep mum about our babysitter's stories, but I was so razzled by hopes of meeting with these aliens and learning their world-saving secrets that I blabbed about the possibility to my mother, who quickly wormed the entire chronicle from me."
                            },
                            {
                                "example_id": "79ccd7e4-edc1-461a-9610-7a770303a9b6",
                                "sense_id": "35d2d6ef-64b7-3657-9e6e-c538b661c41f",
                                "text": "\"We got razzled,\" said Wizards center Brendan Haywood, inventing a word on a night when he did little else. \"It's the playoffs. You've got to play.\""
                            }
                        ]
                    }
