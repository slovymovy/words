                                        "glosses": [
                                            "Eigenschaft, nachlässig/schlampig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ae7dbd-437f-40e6-9d78-49159e3f0d63",
                                                "sense_id": "ccd1ee3b-d0c4-34a9-ae9f-caecba11a4d8",
