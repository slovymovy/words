                        "examples": [
                            {
                                "example_id": "0824e2df-90ad-435a-b7b1-15524c790d14",
                                "sense_id": "4717a7c3-6bac-3d52-b693-30ff10d6f33f",
                                "text": "On the night of the 4th of February , Ailie wrote to her cousin elect—\n“This is the maddest, merriest Sunday which any one of these, your five solemncholy English friends have ever spent. […]"
                            },
                            {
                                "example_id": "9aeb7d3f-f78e-471b-8ae9-6588a56529f1",
                                "sense_id": "4717a7c3-6bac-3d52-b693-30ff10d6f33f",
                                "text": "I wouldna deny it in front of such a number of sharp-eyed solemncholy gentlemen. I flung the stone that dropped Mr Crawford."
                            }
                        ]
                    }
                ],
