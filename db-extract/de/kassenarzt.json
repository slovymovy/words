                "senses": [
                    {
                        "sense_id": "2046938d-7c58-3b1a-91e1-47b243368e33",
                        "entry_id": "4f4a56da-d0f9-322f-9e95-e7b47d55aeb5",
                        "glosses": [
                            "Mediziner, der Mitglieder einer (in Deutschland „gesetzlichen“) Krankenversicherung behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b47947-863b-4b21-8b59-aff01f0024d4",
                                "sense_id": "2046938d-7c58-3b1a-91e1-47b243368e33",
                                "text": "„In zahlreichen Bundesländern wurde in diesem Jahr festgelegt, welcher Kassenarzt welchen Betrag verdienen darf.“"
                            },
                            {
                                "example_id": "5e0c1291-c93f-4df7-99e2-48e74df9423e",
                                "sense_id": "2046938d-7c58-3b1a-91e1-47b243368e33",
                                "text": "„Zwischen Kassenärzten und der Politik bahnt sich ein neuer Streit über die Höhe der ärztlichen Vergütung an.“"
                            },
                            {
                                "example_id": "2e5bc8df-22c6-42ca-9f15-16e9629a4e71",
                                "sense_id": "2046938d-7c58-3b1a-91e1-47b243368e33",
                                "text": "„Einem gewissenhaften Kassenarzt war es geglückt, einen geizigen Schrotthändler, der aus dem letzten Loch gepfiffen hatte, noch mal auf die Beine zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
