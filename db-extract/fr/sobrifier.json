                        "sense_id": "ca654eaa-7206-3dec-bc89-2ac842aff227",
                        "entry_id": "926d2610-2c37-3005-adaa-6bd0d900cceb",
                        "glosses": [
                            "Rendre sobre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78486f0-c56a-4274-962e-c4d1cee28539",
                                "sense_id": "ca654eaa-7206-3dec-bc89-2ac842aff227",
                                "text": "Je pense qu'il faut absolument le \"sobrifier\" par une tenue noire assez simple, mais j'ai quelques doutes."
                            },
                            {
                                "example_id": "d0fe74a0-890a-4dba-a5a5-e492a644049b",
                                "sense_id": "ca654eaa-7206-3dec-bc89-2ac842aff227",
                                "text": "Je vais essayer de sobrifier un peu et de mettre de la couleur."
                            },
                            {
                                "example_id": "73ee46e4-646c-49be-8464-540975cdf014",
                                "sense_id": "ca654eaa-7206-3dec-bc89-2ac842aff227",
                                "text": "Mais avec vos commentaires, constructifs, il est possible que je le « sobrifie » (du verbe sobrifier, premier groupe) un peu plus."
                            }
                        ]
                    }
                ],
