                        "target_lang_word": "ungläubig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungläubig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a37164-4c28-3803-b026-304d5caa227c",
                                        "entry_id": "72b8eefe-c9bc-341d-9bf3-cb39bf03142c",
                                        "glosses": [
                                            "etwas nicht für wahr haltend, seine Bedenken habend, seine Zweifel ausdrückend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eadee0b9-1404-495b-9006-fa6fd87ff329",
                                                "sense_id": "f0a37164-4c28-3803-b026-304d5caa227c",
                                                "text": "Sie schaute mich ungläubig an."
                                            },
                                            {
                                                "example_id": "65c9a658-a48c-4bd3-ae3d-34a830417fdc",
                                                "sense_id": "f0a37164-4c28-3803-b026-304d5caa227c",
                                                "text": "Ungläubig fragte er nach: Wieso? Wieso sollte sie ausgerechnet heute abreisen?"
                                            },
                                            {
                                                "example_id": "adc2caac-bd13-4fc7-a3fd-1d53bf02d215",
                                                "sense_id": "f0a37164-4c28-3803-b026-304d5caa227c",
                                                "text": "„Sie steht auf der großen Freilichtbühne und schaut etwas ungläubig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f85796eb-db59-3642-ad69-85405b207849",
                                        "entry_id": "72b8eefe-c9bc-341d-9bf3-cb39bf03142c",
                                        "glosses": [
                                            "keine religiöse Anschauung vertretend, nicht an Gott oder Götter glaubend, an eine andere als die eigene oder vorherrschende Religion glaubend"
                                        ],
                                        "tags": [
                                            "Theologie",
                                            "oftmals auch aus der Sichtweise einer speziellen Religion heraus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f444348c-a124-4130-b306-786dce5309bf",
                                                "sense_id": "f85796eb-db59-3642-ad69-85405b207849",
                                                "text": "Er verlor seinen Glauben an Gott und wurde ungläubig."
                                            },
                                            {
                                                "example_id": "089f94cf-ab96-4a97-9b58-f8eb83d5aa3b",
                                                "sense_id": "f85796eb-db59-3642-ad69-85405b207849",
                                                "text": "Ungläubig sind diejenigen, die sagen: ›Gott ist Christus, der Sohn der Maria‹."
                                            },
                                            {
                                                "example_id": "8e3a6f16-76e5-42a7-82e7-2caed2ea0f1a",
                                                "sense_id": "f85796eb-db59-3642-ad69-85405b207849",
                                                "text": "Ungläubig ist, wer trotz hinreichender Gründe dennoch nicht glaubt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
