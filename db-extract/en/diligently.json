                                            "unermüdlich, arbeitsam, strebsam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8737322b-007c-4254-bbae-ae4aca6eb490",
                                                "sense_id": "a1dfdd23-f30f-381d-aeff-051f1363a52c",
                                                "text": "Ein fleißiger Mitarbeiter wird auch bald befördert."
                                            },
                                            {
                                                "example_id": "8a2b612c-e462-4e11-ab74-69f063fd6df6",
                                                "sense_id": "a1dfdd23-f30f-381d-aeff-051f1363a52c",
                                                "text": "Er war ein fleißiger Besucher der Veranstaltung."
                                            },
                                            {
                                                "example_id": "8898b7b0-e327-42cc-a040-aea13f7d072d",
                                                "sense_id": "a1dfdd23-f30f-381d-aeff-051f1363a52c",
                                                "text": "„Sie ist jetzt 40 Jahre alt und lebt in einer Pflegeeinrichtung auf dem Land, wo sie einmal am Tag fleißig den Ziegenstall ausmistet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
