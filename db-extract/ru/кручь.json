                    {
                        "translation_id": "4f2bd525-7ae8-42e2-8250-7b99a72c6c18",
                        "source_entry_id": "3464df3d-7226-3f3c-bb3e-751a2f346db7",
                        "source_sense_id": "8347d49c-f1a1-3222-8944-c8c06db79347",
                        "target_lang_word": "escarpement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escarpement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76d3debe-dce5-3dde-91c5-18a8b6b35bbb",
                                        "entry_id": "fb9ec6d6-0835-3c19-9a4f-883388a819ae",
                                        "glosses": [
                                            "Pente raide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40a8dbe-b965-4ec7-8da6-c838d9d129a5",
                                                "sense_id": "76d3debe-dce5-3dde-91c5-18a8b6b35bbb",
                                                "text": "Sur l’escarpement voisin de la verticale, croissent dans les fentes ou les petits replats ménagés par la cassure géométrique de la roche […]"
                                            },
                                            {
                                                "example_id": "1dc93193-27ce-4500-a494-9d4bd0f73e37",
                                                "sense_id": "76d3debe-dce5-3dde-91c5-18a8b6b35bbb",
                                                "text": "La route nationale de Nîmes à Mende m’amène à Anduze, un chef-lieu de canton de l’arrondissement d’Alès, encaissé entre les escarpements dont la base se verdit d’oliviers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb551e41-43a1-35e0-8523-c6dcbebe7881",
                                        "entry_id": "fb9ec6d6-0835-3c19-9a4f-883388a819ae",
                                        "glosses": [
                                            "État de ce qui est escarpé, pente raide."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f8d749-d860-4cda-9c3f-96ef7afe91e3",
                                                "sense_id": "cb551e41-43a1-35e0-8523-c6dcbebe7881",
                                                "text": "L’escarpement de la côte empêche d’aborder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de823c85-dddd-46b6-9a2e-2da391c4f58e",
                        "source_entry_id": "3464df3d-7226-3f3c-bb3e-751a2f346db7",
                        "source_sense_id": "8347d49c-f1a1-3222-8944-c8c06db79347",
                        "target_lang_word": "à-pic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à-pic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                        "entry_id": "22615cd0-e9a4-37d2-b20f-178ea7e794a5",
                                        "glosses": [
                                            "Endroit d’une montagne dont la pente est très escarpée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ded33da-1978-4cd2-8acc-44ce17ca7352",
                                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                                "text": "[…] nous avons pu encore admirer les falaises de la côte Nord ; découpées en architectures fantastiques, elles se dressent parfois en à-pics de 600 mètres de hauteur."
                                            },
                                            {
                                                "example_id": "8264d0f4-ecc3-4ba7-81b3-faa9ea82a0a1",
                                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                                "text": "On trouve en Bretagne des anatifes cramponnés en colonies serrées au bas des à-pics rocheux sans cesse battus par les vagues."
                                            },
                                            {
                                                "example_id": "55fe912c-374e-4d89-85e7-67f724069642",
                                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                                "text": "En quittant les hautes terres de Tulancingo et en progressant vers le nord et l’est, on traverse la forêt sclérophylle pour aboutir dans une zone de montagnes escarpées où l’affleurement du Jurassique se traduit par une succession d'à-pics vertigineux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "à-pic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a6fe1e-21aa-3ba0-851c-2930dc3a303a",
                                        "entry_id": "2ac4d947-0098-3db5-bf1f-8919981596de",
                                        "glosses": [
                                            "Verticalement, perpendiculairement"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dcad236-4ede-40ee-8083-7dab0b212e40",
                        "source_entry_id": "3464df3d-7226-3f3c-bb3e-751a2f346db7",
                        "source_sense_id": "8347d49c-f1a1-3222-8944-c8c06db79347",
                        "target_lang_word": "falaise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c13f181-36e2-3452-901e-7afd2808478d",
                                        "entry_id": "a5b074ef-0d5d-319d-8d8a-83bd6018abb0",
                                        "glosses": [
                                            "Masse de terres et de rochers en escarpement au bord de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83881dc-033e-4c6f-92d5-30035d19df1b",
                                                "sense_id": "6c13f181-36e2-3452-901e-7afd2808478d",
                                                "text": "Dyrholar est une toute petite ville qui se blottit entre les falaises, au sud de l’Islande."
                                            },
                                            {
                                                "example_id": "943c56d6-368b-4eaa-9e33-d28fd301d5a8",
                                                "sense_id": "6c13f181-36e2-3452-901e-7afd2808478d",
                                                "text": "Sans être coupée à pic, la colline finit assez brusquement en falaise."
                                            },
                                            {
                                                "example_id": "63b4c48a-7aed-48f1-9d19-adfd17b6cab6",
                                                "sense_id": "6c13f181-36e2-3452-901e-7afd2808478d",
                                                "text": "Par-dessus l’autre bord du navire, j’aperçus, vivement éclairée par l’incendie, la falaise abrupte qui descend vers Lübeck."
                                            },
                                            {
                                                "example_id": "1a48db76-9160-438d-addb-befa182f3ac8",
                                                "sense_id": "6c13f181-36e2-3452-901e-7afd2808478d",
                                                "text": "Les oiseaux innombrables nichent dans les falaises escarpées, et effarés par la sirène des navires, s’envolent en nuages bruyants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1be13f6a-80df-35c5-8016-184975bafa61",
                                        "entry_id": "a5b074ef-0d5d-319d-8d8a-83bd6018abb0",
                                        "glosses": [
                                            "Abrupt."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af83c55-0f25-4bca-8ab4-af6966da7cf5",
                                                "sense_id": "1be13f6a-80df-35c5-8016-184975bafa61",
                                                "text": "Le fleuve qui nous entraînait, coulait entre de hautes falaises, au bout desquelles on apercevait le soleil couchant."
                                            },
                                            {
                                                "example_id": "11028aa1-cb7e-4262-b50e-6dc36a6f7fa5",
                                                "sense_id": "1be13f6a-80df-35c5-8016-184975bafa61",
                                                "text": "[…]: c’étaient de hautes falaises rocheuses, des cascades et de larges fleuves bouillonnants et désolés, des bouquets d’arbres et des fourrés de plus en plus rabougris."
                                            },
                                            {
                                                "example_id": "8aef9aa2-135c-4da9-8e6f-c4119e3a431d",
                                                "sense_id": "1be13f6a-80df-35c5-8016-184975bafa61",
                                                "text": "L’admirable Calvignac, en équilibre au bord de sa falaise, n’a plus que 386 habitants après en avoir compté, en 1789, 900 ; […]."
                                            },
                                            {
                                                "example_id": "fdc3d9f3-74c1-442f-b078-4341fb5959fb",
                                                "sense_id": "1be13f6a-80df-35c5-8016-184975bafa61",
                                                "text": "[…], il regardait au bas de la falaise la Morava tenter avec peine de faire pénétrer ses eaux vertes dans les flots boueux du Danube, […]."
                                            },
                                            {
                                                "example_id": "4f40b063-9b94-4b8f-af98-0fb535201a52",
                                                "sense_id": "1be13f6a-80df-35c5-8016-184975bafa61",
                                                "text": "Quand éclata la masse, Alexis était debout sur la falaise, et, riant, montrait le bois qui se culbutait dans la rivière comme les glaces dans le bouscueil du printemps."
                                            }
                                        ]
                                    }
                                ]
                            },
