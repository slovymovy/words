                        "sense_id": "6b312a9d-1cf5-3c02-a1cf-2eb6f1f39c18",
                        "entry_id": "e1770e3f-fb97-3982-83d1-25666bc87de0",
                        "glosses": [
                            "Caractéristique du temps précédant la chute d'Adam et Ève, en religion chrétienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de2263be-6f84-42f9-baed-b0ec48d2d361",
                                "sense_id": "6b312a9d-1cf5-3c02-a1cf-2eb6f1f39c18",
                                "text": "Le geste de l'être revient donc pour pour Jaurès à sa nécessaire dissémination dans le monde — ce que, mutatis mutandis, les monothéismes appellent la Chute — et à son nécessaire rassemblement dans une perfection absolue, \"supérieure\" en quelque sorte à la perfection statique prélapsaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74225cb6-910d-4ff2-be64-bbaed9742b68",
                        "source_entry_id": "e1770e3f-fb97-3982-83d1-25666bc87de0",
                        "source_sense_id": "6b312a9d-1cf5-3c02-a1cf-2eb6f1f39c18",
                        "target_lang_word": "prelapsarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prelapsarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "060b5264-cc2f-39a1-9fdf-794b3f27f3cd",
                                        "entry_id": "c307cd44-290a-38fe-a79b-27d4addf6c7b",
                                        "glosses": [
                                            "Of, or relating to the period of innocence before the Fall of man; innocent, unspoiled."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3601b3-1f58-4caa-935f-30fd3e6aaa0d",
                                                "sense_id": "060b5264-cc2f-39a1-9fdf-794b3f27f3cd",
                                                "text": "It is the prelapsarian Polynesia of free love, noble savagery, Kon Tiki rafting and Easter Island statuary, not the Levi’s-wearing, Toyota-driving, pédalo-pushing, efflorescent-cocktails-in-a-split-coconut-serving pseudo-paradise that awaits latter-day travellers."
                                            },
                                            {
                                                "example_id": "7891c8c6-23db-480b-8cb7-01efa7593855",
                                                "sense_id": "060b5264-cc2f-39a1-9fdf-794b3f27f3cd",
                                                "text": "Ideally, individual stories and God's plan share the same final goal, namely, returning to a prelapsarian state of perfect communication with God."
                                            },
                                            {
                                                "example_id": "1111f613-170c-46d2-a6a2-760582870126",
                                                "sense_id": "060b5264-cc2f-39a1-9fdf-794b3f27f3cd",
                                                "text": "Back in those ancient, prelapsarian days, \"girl-on-girl\" hadn’t even been invented yet."
                                            },
                                            {
                                                "example_id": "f4d0715f-b034-41c5-b770-9e3c58fafb61",
                                                "sense_id": "060b5264-cc2f-39a1-9fdf-794b3f27f3cd",
                                                "text": "Can you really turn a few keyboards outside London's landmarks into the equivalent of a pub honky-tonk for a good old knees-up; a 50s living room where the family would gather around the piano every evening, in some prelapsarian vision of the olden days […]?"
                                            },
                                            {
                                                "example_id": "7ee3e58b-a0e9-4c37-8068-11237f75571b",
                                                "sense_id": "060b5264-cc2f-39a1-9fdf-794b3f27f3cd",
                                                "text": "Conservative think-tanks have the same dream of return to a prelapsarian innocence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
