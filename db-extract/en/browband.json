                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a1b05a-fcf8-4c77-b634-47eea7cb9ec5",
                                "sense_id": "381411ab-038c-33df-8e53-d543d01baea7",
                                "text": "Diana monkeys are generally black or dark grey, but have a white throat, crescent-shaped browband, ruff and beard."
                            }
