                "senses": [
                    {
                        "sense_id": "c956db47-9219-3324-b99f-66fe435d32fc",
                        "entry_id": "1d3935f7-6d48-3955-907b-083b8b2eb379",
                        "glosses": [
                            "eine Maßnahme zur Behandlung von physischen, psychischen oder sozialen Beschwerden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdda2a6-4720-4704-98f6-81edc335968a",
                                "sense_id": "c956db47-9219-3324-b99f-66fe435d32fc",
                                "text": "„Denn obwohl […] die Spiele in manchen Situationen eine genuin therapeutische Wirkung entfaltet haben, faktisch Spieltherapie gewesen sind, muß der Lehrer gewarnt werden, auf eigene Faust die Grenze von implizit therapeutischen Spielen zur intentionalen Spieltherapie zu überschreiten.“"
                            },
                            {
                                "example_id": "5c3d5ba4-5565-499e-a564-6258fe489a44",
                                "sense_id": "c956db47-9219-3324-b99f-66fe435d32fc",
                                "text": "„Die Spieltherapie ist das typische Verfahren der Kinderpsychotherapie.“"
                            },
                            {
                                "example_id": "6bf4b407-eb47-446e-8f19-f17aecdfb8ed",
                                "sense_id": "c956db47-9219-3324-b99f-66fe435d32fc",
                                "text": "„Dieser schon klassisch zu nennende Bericht Freuds findet gewissermaßen seine Fortsetzung in der von Anna Freud und Melanie Klein entwickelten Spieltherapie.“"
                            },
                            {
                                "example_id": "aa8bd525-17e5-409d-8728-d40e088a22d6",
                                "sense_id": "c956db47-9219-3324-b99f-66fe435d32fc",
                                "text": "„Da er seine Therapiespiele oft ins Freie verlegt und mit einem Spaziergang verbindet, sind es meist ungeformte und physiognomisch vielgestaltige Gegenstände oder Gewächse der Natur, mit denen das Spiel anfängt.“"
                            },
                            {
                                "example_id": "49c9ac58-1589-4282-87c2-a255ee17569e",
                                "sense_id": "c956db47-9219-3324-b99f-66fe435d32fc",
                                "text": "„Dieser Aspekt wird vor allem in der Spieltherapie zur Integration traumatischer Erfahrungen in das Bewußtsein der Kinder genutzt.“"
                            },
                            {
                                "example_id": "01a5627b-9512-4186-b0ed-d1f729bc973c",
                                "sense_id": "c956db47-9219-3324-b99f-66fe435d32fc",
                                "text": "„Spieltherapie hat hier aber nur eine Chance, wenn Einsichtsfähigkeit (Intelligenz), Leidensdruck und Wandlungsbereitschaft vorhanden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
