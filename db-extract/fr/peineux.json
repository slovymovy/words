                        "glosses": [
                            "Pénible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "badd8365-0433-4335-a0bc-b196ced5076b",
                                "sense_id": "39543bbb-e146-3325-967d-701440e48086",
                                "text": "Comme Pizarre, au seuil des hautes terres du Mexique, trace sur le sable, du bout de son bâton, la ligne qui sépare la vie facile de la peineuse, puis se retourne vers ses compagnons, ainsi le génie de l’Afrique s’arrête et mesure la terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "055aba80-fde5-36e8-872e-225c1dce8570",
                        "entry_id": "3e1bba5a-bf65-3e10-b01b-0fd00891b6dd",
                        "glosses": [
                            "De la Passion."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9ddeae43-66db-406f-a24b-3bfe3f4b3114",
                                "sense_id": "055aba80-fde5-36e8-872e-225c1dce8570",
                                "text": "Semaine peineuse, semaine de Pâques."
                            },
                            {
                                "example_id": "127b7abd-0701-47f2-ac92-7e72c24565cb",
                                "sense_id": "055aba80-fde5-36e8-872e-225c1dce8570",
                                "text": "Je voudrais bien vous écrire des nouvelles ; mais cette semaine peineuse les a étonnées."
                            }
                        ]
