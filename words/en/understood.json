                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please have the report on my desk by noon. — <w>Understood</w>, I will do it right away.",
                            "target_lang_translations": {
