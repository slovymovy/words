                        "sense_id": "1e8e2193-4f76-312d-93f7-1f2319225de3",
                        "entry_id": "cf9502ca-d7cf-3bf0-bb3b-8ce5cb8c7bf2",
                        "glosses": [
                            "подвергнув что-либо мочению с целью изменять его свойства или качества (делать менее солёным, жёстким и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53f96e35-c421-4d8b-9bcc-c7132f9d97e9",
                                "sense_id": "1e8e2193-4f76-312d-93f7-1f2319225de3",
                                "text": "Витрувий рекомендует комья лучшего сорта извести задолго до употребления в дело вымачивать, чтобы она успела перегаситься."
                            }
                        ]
                    }
                ],
