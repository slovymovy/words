                "senses": [
                    {
                        "sense_id": "80e500ee-bc46-355b-be71-d894cc8832f1",
                        "entry_id": "35ad1927-0a70-3151-969b-c137698f355c",
                        "glosses": [
                            "Not forbidden by formal or informal rules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58be40d1-0d3b-4eeb-a5c3-04ed6b80d033",
                                "sense_id": "80e500ee-bc46-355b-be71-d894cc8832f1",
                                "text": "Undated, Pope Honorius III Solet Annuere (anonymous translator),\nLet it not be in any way licit to anyone among men to infringe this page of our confirmation, or to contravene it with rash daring."
                            },
                            {
                                "example_id": "1e9977ee-3d81-4a11-92bb-abb824a1121c",
                                "sense_id": "80e500ee-bc46-355b-be71-d894cc8832f1",
                                "text": "You seem to have been very much offended because your father talks a little sculduddery after dinner, which it is perfectly licit for him to do, […]"
                            },
                            {
                                "example_id": "cd681f91-631a-420b-8cbd-a4420337adad",
                                "sense_id": "80e500ee-bc46-355b-be71-d894cc8832f1",
                                "text": "[T]he vanity of efforts to deter humanity from following this licit and highly profitable mobility, clearly indicate the limits of their [leaders'] power."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ece728a-5fc3-3f15-8db3-931a24e37b12",
                        "entry_id": "35ad1927-0a70-3151-969b-c137698f355c",
                        "glosses": [
                            "Explicitly established or constituted by law."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de33e4ad-9982-456e-90c5-7da47657b16d",
                                "sense_id": "4ece728a-5fc3-3f15-8db3-931a24e37b12",
                                "text": "The contract validly made and consummated is dissolved by death alone. However, the Church must determine what is required for a valid and licit marriage contract."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d68e0939-0060-4dbf-bf8f-d0661faeb2f8",
