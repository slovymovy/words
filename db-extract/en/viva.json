                        "examples": [
                            {
                                "example_id": "48b3c1e3-27f7-4935-a632-aecb8f20faa4",
                                "sense_id": "f921ba56-7da3-3673-bd49-30a0f34a43f6",
                                "text": "My doctoral thesis was vivaed three years before the publication of the revised and expanded edition of Richard H. Popkin's work..."
                            },
                            {
                                "example_id": "c21db483-77f0-4326-a8e0-351cde695501",
                                "sense_id": "f921ba56-7da3-3673-bd49-30a0f34a43f6",
                                "text": "I was vivaed by Charles Cannan, who was then a Fellow of Trinity..."
                            },
                            {
                                "example_id": "5a9c2291-5ba6-426a-a29a-f92a78b671fd",
                                "sense_id": "f921ba56-7da3-3673-bd49-30a0f34a43f6",
                                "text": "Throughout his life, he took college responsibilities seriously, he came to All Souls whenever possible on weekends, he vivaed or interviewed candidates..."
                            }
                        ]
