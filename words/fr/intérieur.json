            "senses": [
                {
                    "sense_id": "66d58746-4b2d-3b4b-b7f0-e9f3d31bc605",
                    "sense_definition": "Partie située au-dedans d'un espace, d'un lieu ou d'un objet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait froid dehors alors nous préférons rester à l'<w>intérieur</w>."
                        },
                        {
                            "text": "Les enfants ont rangé tous leurs jouets à l'<w>intérieur</w> du coffre en bois."
                        }
                    ],
                    "antonyms": [
                        "extérieur",
                        "dehors"
                    ],
                    "common_phrases": [
