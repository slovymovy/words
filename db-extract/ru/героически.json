                    {
                        "translation_id": "e4c4cb5d-a0b9-4a50-b6e2-63ff3916c9d8",
                        "source_entry_id": "ebb351b1-69f8-3883-8e3a-f05308c6643f",
                        "source_sense_id": "9c838d4a-4c6e-3618-82c3-50d2b0459ecc",
                        "target_lang_word": "héroïquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "héroïquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e9c657-3e74-3b87-9551-8680775dcd75",
                                        "entry_id": "d0d054b8-3383-3aef-ba2e-4b2885ca6927",
                                        "glosses": [
                                            "D’une manière héroïque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfab9eca-e1b4-45f0-ba99-39677df73016",
                                                "sense_id": "f4e9c657-3e74-3b87-9551-8680775dcd75",
                                                "text": "Toute l'histoire classique est dominée par la guerre conçue héroï­quement ; les institutions des républiques grecques eurent, à l'origine, pour base l'organisation d'armées de citoyens ; […]."
                                            },
                                            {
                                                "example_id": "4bf8fdb8-b75a-41e5-b2b1-f607824c3f21",
                                                "sense_id": "f4e9c657-3e74-3b87-9551-8680775dcd75",
                                                "text": "Eufrosinia raisonne comme Ivan, comme Staline. On dira qu'elle s'affaire cupidement pour elle et pour son parentage quand Ivan et Staline se dépensent héroïquement pour la nation. La fin justifie les moyens mais ce ne sont pas les mêmes fins."
                                            },
                                            {
                                                "example_id": "13774d82-4808-4a7f-9d5d-6d933881dfc9",
                                                "sense_id": "f4e9c657-3e74-3b87-9551-8680775dcd75",
                                                "text": "Elle accomplit son humanité profonde, qui est de lutter héroïquement contre le monde, d’affronter héroïquement une mort qui finira par le terrasser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
