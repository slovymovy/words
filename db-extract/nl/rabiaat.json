                        "cross_references": [
                            {
                                "target_word": "féroce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb3badda-7e2c-3e37-9aa4-a5f19ccd6bc3",
                                        "entry_id": "1e3abc51-ae00-3240-b814-e9c99b6c9a66",
                                        "glosses": [
                                            "Qui est cruel par instinct, en parlant des bêtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be5875b2-fdc0-403c-8e4d-a34dbb20a8d4",
                                                "sense_id": "eb3badda-7e2c-3e37-9aa4-a5f19ccd6bc3",
                                                "text": "On exposait les martyrs aux bêtes féroces."
                                            },
                                            {
                                                "example_id": "65b614c5-dade-4116-9cc1-11af7f490abd",
                                                "sense_id": "eb3badda-7e2c-3e37-9aa4-a5f19ccd6bc3",
                                                "text": "Les lions, les tigres sont des animaux féroces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc3c79f-3b33-3905-a157-23608941f76f",
                                        "entry_id": "1e3abc51-ae00-3240-b814-e9c99b6c9a66",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26c3bbad-a8f3-4d15-b7c1-db8ef82bf2f0",
                                                "sense_id": "3bc3c79f-3b33-3905-a157-23608941f76f",
                                                "text": "C’est une bête féroce : Se dit d’un homme brutal et cruel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3d49c1d-79d5-396a-b223-59de19af7f63",
                                        "entry_id": "1e3abc51-ae00-3240-b814-e9c99b6c9a66",
                                        "glosses": [
                                            "Qui est porté à la cruauté, en parlant des hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbcb03bb-d6be-40a2-863f-c31c089e2679",
                                                "sense_id": "b3d49c1d-79d5-396a-b223-59de19af7f63",
                                                "text": "Un despote féroce."
                                            },
                                            {
                                                "example_id": "cd570f7c-438b-4db5-ac5a-4223dd306adc",
                                                "sense_id": "b3d49c1d-79d5-396a-b223-59de19af7f63",
                                                "text": "Une peuplade féroce."
                                            },
                                            {
                                                "example_id": "57369682-dcd2-4c1b-b801-f6a4567261b8",
                                                "sense_id": "b3d49c1d-79d5-396a-b223-59de19af7f63",
                                                "text": "Cœur féroce."
                                            },
                                            {
                                                "example_id": "aa160ccf-a221-434b-906b-e038501b0d3e",
                                                "sense_id": "b3d49c1d-79d5-396a-b223-59de19af7f63",
                                                "text": "Caractère féroce."
                                            },
                                            {
                                                "example_id": "04a77d7a-a39a-40f6-868b-e525598bbb8d",
                                                "sense_id": "b3d49c1d-79d5-396a-b223-59de19af7f63",
                                                "text": "Humeur féroce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3786f14-fb27-32fb-8571-f9faec3061f9",
                                        "entry_id": "1e3abc51-ae00-3240-b814-e9c99b6c9a66",
                                        "glosses": [
                                            "Qualifie ces sentiments ou ces attitudes cruels."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec2d368e-5145-4dea-9892-25e71fb0842b",
                                                "sense_id": "a3786f14-fb27-32fb-8571-f9faec3061f9",
                                                "text": "Je ne pus réussir à attraper un seul requin […]. Et cependant, lorsque je tuais l'un d'entre eux avec ma carabine sprinfield, c'était aussitôt une bataille féroce autour du festin cannibale."
                                            },
                                            {
                                                "example_id": "edf7c45b-3dcb-4a31-ac5d-1d93e7138996",
                                                "sense_id": "a3786f14-fb27-32fb-8571-f9faec3061f9",
                                                "text": "Un regard féroce."
                                            },
                                            {
                                                "example_id": "de7d5c47-9186-4181-bd37-5af1f1f56f87",
                                                "sense_id": "a3786f14-fb27-32fb-8571-f9faec3061f9",
                                                "text": "Un air féroce."
                                            },
                                            {
                                                "example_id": "c30a0a66-3c36-499d-b3d3-564a5b64c173",
                                                "sense_id": "a3786f14-fb27-32fb-8571-f9faec3061f9",
                                                "text": "Des mœurs féroces."
                                            },
                                            {
                                                "example_id": "edc31a71-77e4-4d10-85f8-fa3ede060f57",
                                                "sense_id": "a3786f14-fb27-32fb-8571-f9faec3061f9",
                                                "text": "Une joie féroce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
