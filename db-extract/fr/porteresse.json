                        "glosses": [
                            "Ouvrière qui amassait le sel en mulon."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5bad203d-a9ad-4f6e-b8e0-aff08ea70155",
                                "sense_id": "7c36660d-d22a-3f4b-842a-75d181df68b7",
                                "text": "Pour son travail de porteresse de sel, elle remonte sa jupe avec un troussis (ceinture de coton tressé) et pose un coussinet (la torche) sur sa tête."
                            },
                            {
                                "example_id": "3bb1eb7b-6cbf-4f40-83cd-c9fa963a9dbe",
                                "sense_id": "7c36660d-d22a-3f4b-842a-75d181df68b7",
                                "text": "Elles ont en outre le sel blanc (environ 80 kilogrammes par œillets) qui représente une somme à peu près égale. C'est donc 160 environ qui sont l'unité ordinaire, soit 80 francs par porteresse."
                            }
                        ]
                    }
