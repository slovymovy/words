                                    {
                                        "sense_id": "caa00f9a-2dd6-30ac-b1f2-d62783d78715",
                                        "entry_id": "eed6b3a7-5bd9-3cd4-8134-6954f18e8929",
                                        "glosses": [
                                            "Variante orthographique de barcarole, chanson des gondoliers de Venise."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3540885c-b193-37d1-9f2a-efe9e7692c76",
                                        "entry_id": "eed6b3a7-5bd9-3cd4-8134-6954f18e8929",
                                        "glosses": [
                                            "Variante orthographique de barcarole, air de musique où l’on imite la coupe et le rythme de ces chansons."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8154dfcd-b103-46ed-b6e0-4b6cd52ce6b8",
                                                "sense_id": "3540885c-b193-37d1-9f2a-efe9e7692c76",
                                                "text": "Et les Assis, genoux aux dents, verts pianistes,\nLes dix doigts sous leur siège aux rumeurs de tambour,\nS'écoutent clapoter des barcarolles tristes,\nEt leurs caboches vont dans des roulis d'amour."
                                            },
                                            {
                                                "example_id": "7367c756-61b3-4d7d-b3a6-5dbfd59cc824",
                                                "sense_id": "3540885c-b193-37d1-9f2a-efe9e7692c76",
                                                "text": "Une musique résonne, une sorte de barcarolle sentimentale, et partout sur son passage vacillent des lampes d’ambiance colorées, y compris dans l’eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
