                        "examples": [
                            {
                                "example_id": "32105048-cd31-4001-967f-5b4c6a5165cd",
                                "sense_id": "f7bdfd05-4a28-3b88-b19d-3a9947f54eaf",
                                "text": "[…] Elena qui ne parlait jamais, pour respecter son image de sphinge."
                            },
                            {
                                "example_id": "759416e5-ef98-4f77-bd80-7123ec0155cc",
                                "sense_id": "f7bdfd05-4a28-3b88-b19d-3a9947f54eaf",
                                "text": "[…] Christel est méprisante, c’est une princesse, lointaine, une sphinge. Mais je ne veux pas vous en dégoûter, mon cher Gérard."
                            },
                            {
                                "example_id": "446de3c8-fcd2-4f07-ba52-d102d04f84cc",
                                "sense_id": "f7bdfd05-4a28-3b88-b19d-3a9947f54eaf",
                                "text": "Mésomédès de Crète, mon musicien favori, accompagna sur l’orgue hydraulique la récitation de son poème de La Sphinge œuvre inquiétante, sinueuse, fuyante comme le sable au vent."
                            }
                        ]
                    }
