                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La perte soudaine de son meilleur ami l'a complètement <w>dévasté</w>."
                        },
                        {
                            "text": "Cette terrible nouvelle risque de <w>dévaster</w> toute la famille."
