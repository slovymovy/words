            {
                "entry_id": "185c9814-1627-3abe-81b2-a7bf93585055",
                "word": "bibliovore",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0860de9d-43ac-4b2c-a2ef-9ba0962ef03c",
                        "entry_id": "185c9814-1627-3abe-81b2-a7bf93585055",
                        "tags": [
                            "plural"
                        ],
                        "form": "bibliovores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8cc01ad-8b48-336a-b794-6c7e54911f43",
                        "entry_id": "185c9814-1627-3abe-81b2-a7bf93585055",
                        "glosses": [
                            "loving books, bibliophilic"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c701781e-e976-4f65-bc19-ddc93a500bc4",
                                "sense_id": "a8cc01ad-8b48-336a-b794-6c7e54911f43",
                                "text": "Ces sensations me semblent assez humaines pour que je m’aventure à en faire part à des lecteurs bibliophiles ou bibliovores, qui pensent que rien de ce qui touche le livre ne doit leur être étranger."
                            },
                            {
                                "example_id": "5aa1621a-7b05-4f4b-905a-44252ff93084",
                                "sense_id": "a8cc01ad-8b48-336a-b794-6c7e54911f43",
                                "text": "« Flagrante delicto. » Scènes de rats bibliovores."
                            },
                            {
                                "example_id": "7f1bcebc-d77d-4f4f-837d-240e3d276fda",
                                "sense_id": "a8cc01ad-8b48-336a-b794-6c7e54911f43",
                                "text": "J’émis un sifflement admiratif tout en me disant que si ses livres avaient eu autant de succès je serais sûrement tombé dessus en bouquinant pour mon neveu bibliovore."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c38a4b54-d6b3-3754-8f7b-76e72ca31b13",
                "word": "bibliovore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc637654-0e17-49cb-9e09-2c8b87e60e17",
                        "entry_id": "c38a4b54-d6b3-3754-8f7b-76e72ca31b13",
                        "tags": [
