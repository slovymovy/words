                    },
                    {
                        "translation_id": "b4d7c3b5-ba7b-48e8-b52b-1aec65372190",
                        "source_entry_id": "9328f034-f03b-3483-9222-277fa082d984",
                        "source_sense_description": "the terminal through which electric current passes",
                        "target_lang_word": "électrode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électrode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf92be4-99a3-3aec-9a66-aab912d72151",
                                        "entry_id": "b11497b4-10a8-3f5e-8c60-d8537b09cad5",
                                        "glosses": [
                                            "Conducteur métallique qui amène le courant électrique dans les liquides et dans les gaz raréfiés."
                                        ],
                                        "tags": [
                                            "Électrochimie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095657b0-c315-4e5b-a01e-b8d5c8ccb283",
                                                "sense_id": "2bf92be4-99a3-3aec-9a66-aab912d72151",
                                                "text": "Ja..., toujours souriant, agita d'abord devant mes yeux les pinces qui terminaient les électrodes. Des petites pinces d'acier brillant, allongées et dentelées. Des pinces « crocodiles », disent les ouvriers des lignes téléphoniques qui les utilisent."
                                            },
                                            {
                                                "example_id": "5a99e927-d767-4997-b3c1-2e79232dc545",
                                                "sense_id": "2bf92be4-99a3-3aec-9a66-aab912d72151",
                                                "text": "Les bougies comportant deux électrodes séparées par un espacement de 0,5 à 1 mm environ ; l'étincelle jaillit entre les électrodes pour une tension de 12 000 à 40000 V."
                                            },
                                            {
                                                "example_id": "bfd62bcd-e3c3-4ed8-89e3-858e8508f309",
                                                "sense_id": "2bf92be4-99a3-3aec-9a66-aab912d72151",
                                                "text": "L'équipe du NIN a développé un implant constitué de 1024 électrodes, qu'ils ont relié au cortex visuel de deux singes voyants pour projeter des formes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "296d256b-f14c-49b4-aca9-dd383a4514ea",
                        "source_entry_id": "9328f034-f03b-3483-9222-277fa082d984",
