                        "glosses": [
                            "Écraser encore une fois des pièces de métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1ee717-6d2b-4ca8-a4fe-24cf1aa7d4aa",
                                "sense_id": "6ad9f0f8-4ca1-31a1-8e6f-48010459e3b1",
                                "text": "Les pièces de cuvelage en tôle ont dû être essayées, presque toutes, deux et même trois fois, malgré tout le soin que l’on avait pris de bien remater les joints et les rivets."
                            }
