                "senses": [
                    {
                        "sense_id": "98e68abd-e7fd-384e-b69f-b1731de27b52",
                        "entry_id": "59cca252-7e32-3084-b5e8-e445075da98c",
                        "glosses": [
                            "Traiter de façon cruelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099093a9-772f-41d3-8708-b47082d227a3",
                                "sense_id": "98e68abd-e7fd-384e-b69f-b1731de27b52",
                                "text": "Je les aime cruelles; mais je ne veux pas qu’elles me cruélisent longuement."
                            },
                            {
                                "example_id": "596218d6-8cdd-4f6f-97b7-29fa6337f6a0",
                                "sense_id": "98e68abd-e7fd-384e-b69f-b1731de27b52",
                                "text": "L’écriture, à un haut degré d’élaboration littéraire, décape, exacerbe, « cruélise » l’expérience en la détachant de cette vérité–là pour une autre, problématique ou expérimentale (sujette à expérimentation) plutôt qu’établie, interrogative au–delà et peut–être différemment de ce que l’expérience donne à l’état brut."
                            }
                        ]
                    }
                ],
