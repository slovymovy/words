                "senses": [
                    {
                        "sense_id": "21f13432-81dc-36c7-855a-38f82d396219",
                        "entry_id": "d496b4df-94f0-320c-a93b-d03df6644a69",
                        "glosses": [
                            "das Hartmachen; Hartwerden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52732ac0-a580-40cc-a92b-f8e00cd4ef40",
                                "sense_id": "21f13432-81dc-36c7-855a-38f82d396219",
                                "text": "„Bevor Diamantstaub zum Shampoobestandteil aufstieg, kam er vor allem bei der Härtung von Bohrköpfen, als Schneidwerkzeug und Schleifmittel zum Einsatz.“"
                            },
                            {
                                "example_id": "14d61b96-bf94-4602-86d1-c1c65437b14d",
                                "sense_id": "21f13432-81dc-36c7-855a-38f82d396219",
                                "text": "„Die Beschaffenheit des Stahles, welcher der doppelten Härtung unterzogen werden soll, muß selbstverständlich von der ins Auge gefaßten Verwendung abhängig sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
