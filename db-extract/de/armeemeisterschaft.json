                ],
                "senses": [
                    {
                        "sense_id": "d9ea8cbf-cf3a-3868-a7dc-49ffb7f5759d",
                        "entry_id": "0d75f69d-0e4a-33a5-a85d-546393bd7bd6",
                        "glosses": [
                            "sportlicher Wettkampf, bei dem Armeeangehörige gegeneinander antreten"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "436ca868-f6aa-410d-a34c-485e3b9d1d0f",
                                "sense_id": "d9ea8cbf-cf3a-3868-a7dc-49ffb7f5759d",
                                "text": "„In der Sowjetunion nahm Kalinitschew an Armeemeisterschaften teil, sowie (bis 1982 regelmäßig) an der Moskauer Stadtmeisterschaft und gelegentlichen Turnieren.“"
                            },
                            {
                                "example_id": "0af5b40e-5d0f-4b89-914f-bd7ccafa53c4",
                                "sense_id": "d9ea8cbf-cf3a-3868-a7dc-49ffb7f5759d",
                                "text": "„Während seines Grundwehrdienstes erkämpfte Dieter in der Sportart Judo bei den Armeemeisterschaften einen hervorragenden 2. Platz.“"
                            },
                            {
                                "example_id": "56420492-5365-498f-88c9-0b46ede15d30",
                                "sense_id": "d9ea8cbf-cf3a-3868-a7dc-49ffb7f5759d",
                                "text": "„Beide arbeiten beruflich bei der Swissair, und sie wollen an diesem Sommertag ein individuelles Training absolvieren, das gleichzeitig als Vorbereitung für die Armeemeisterschaft der Fliegertruppen dient.“"
                            },
                            {
                                "example_id": "dd3e673d-012a-46ac-b287-d65002302708",
                                "sense_id": "d9ea8cbf-cf3a-3868-a7dc-49ffb7f5759d",
                                "text": "„‚Ich habe mir immer vorgenommen, diese Familie wieder aufzuspüren, und eine Einladung zur Schweizer Armeemeisterschaft im Skilauf war dann vor zehn Jahren der Anstoß dazu.“"
                            },
                            {
                                "example_id": "edee646e-046e-4462-a5e2-96bcd42c7c04",
                                "sense_id": "d9ea8cbf-cf3a-3868-a7dc-49ffb7f5759d",
                                "text": "„Armeemeisterschaften blieben eine freiwillige ausserdienstliche Tätigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
