                                "target_senses": [
                                    {
                                        "sense_id": "1b1af71a-837d-3348-9b70-51a93c257a66",
                                        "entry_id": "71a430e1-89d5-36a5-9103-d9ee3a403968",
                                        "glosses": [
                                            "Elektrode, an der eine Oxidationsreaktion stattfindet"
                                        ],
                                        "tags": [
                                            "Elektrochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b067c45-5977-40f1-9601-718249ef3523",
                                                "sense_id": "1b1af71a-837d-3348-9b70-51a93c257a66",
                                                "text": "In der Chemie, insbesondere der Elektrochemie, ist eine Anode die Elektrode, an der eine Oxidationsreaktion stattfindet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20d38b89-a5d2-37a3-8ac6-034e15cd2e1b",
                                        "entry_id": "71a430e1-89d5-36a5-9103-d9ee3a403968",
                                        "glosses": [
                                            "Elektrode, die Elektronen aufnimmt, die von der Kathode abgegeben werden; Gegenpol zur Kathode"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a9ee03-4835-404a-ac32-74474e8b26d6",
                                                "sense_id": "20d38b89-a5d2-37a3-8ac6-034e15cd2e1b",
                                                "text": "In früheren Jahren wurde die Anode einer Röntgenröhre auch als Antikathode bezeichnet."
                                            },
                                            {
                                                "example_id": "0cfa6336-5bcb-4188-83b3-08ee59eaadac",
                                                "sense_id": "20d38b89-a5d2-37a3-8ac6-034e15cd2e1b",
                                                "text": "Eine Diode hat zwei Anschlüsse: Anode und Kathode."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
