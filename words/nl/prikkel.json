    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1138920a-b8a8-394c-91f6-0f3439106dc1",
                    "sense_definition": "Een signaal of gebeurtenis die een reactie oproept in het zenuwstelsel of een organisme.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stimulatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hersenen verwerken elke seconde een enorme hoeveelheid aan externe <w>prikkels</w>.",
                            "target_lang_translations": {
                                "en": "The brain processes a huge amount of external <w>stimuli</w> every second."
                            }
                        },
                        {
                            "text": "Sommige kinderen zijn erg gevoelig voor een <w>prikkel</w> uit hun omgeving.",
                            "target_lang_translations": {
                                "en": "Some children are very sensitive to a <w>stimulus</w> from their environment."
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulus",
                        "impuls"
                    ],
                    "common_phrases": [
                        "externe prikkel",
                        "gevoelig voor prikkels"
                    ],
                    "target_lang_definitions": {
                        "en": "A signal or event that evokes a response in the nervous system or an organism."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stimulus",
                                "target_lang_sense_clarification": "biological or psychological trigger"
                            },
                            {
                                "target_lang_word": "impulse",
                                "target_lang_sense_clarification": "nerve signal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b55117ff-6ef7-3662-b62d-21b9fc27ee42",
                    "sense_definition": "Iets dat iemand aanzet of motiveert om een bepaalde actie te ondernemen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motivatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe bonusregeling diende als een extra <w>prikkel</w> om de verkoopcijfers te verhogen.",
                            "target_lang_translations": {
                                "en": "The new bonus scheme served as an extra <w>incentive</w> to increase sales figures."
                            }
                        },
                        {
                            "text": "Zonder de juiste financiële <w>prikkel</w> zullen bedrijven niet snel investeren in duurzaamheid.",
                            "target_lang_translations": {
                                "en": "Without the right financial <w>incentive</w>, companies will not quickly invest in sustainability."
                            }
                        }
                    ],
                    "synonyms": [
                        "aansporing",
                        "incentive",
                        "motivatie",
                        "stimulans"
                    ],
                    "common_phrases": [
                        "financiële prikkel",
                        "extra prikkel"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that encourages or motivates someone to take a specific action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incentive",
                                "target_lang_sense_clarification": "motivation for action"
                            },
                            {
                                "target_lang_word": "stimulus",
                                "target_lang_sense_clarification": "economic or motivational boost"
                            },
                            {
                                "target_lang_word": "impetus",
                                "target_lang_sense_clarification": "driving force"
                            },
                            {
                                "target_lang_word": "spur",
                                "target_lang_sense_clarification": "encouragement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57b4c00a-6fbc-3969-a358-8383a047b96f",
                    "sense_definition": "Scherpe uitsteeksels aan planten of voorwerpen die een stekend gevoel veroorzaken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke objecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op dat je niet met je blote handen in de <w>prikkels</w> van die struik grijpt.",
                            "target_lang_translations": {
                                "en": "Be careful not to grab the <w>prickles</w> of that bush with your bare hands."
                            }
                        },
                        {
                            "text": "De hond jankte toen hij met zijn poot in de scherpe <w>prikkels</w> van de cactus stapte.",
                            "target_lang_translations": {
                                "en": "The dog yelped when he stepped into the sharp <w>spines</w> of the cactus with his paw."
                            }
                        }
                    ],
                    "synonyms": [
                        "stekels",
                        "doornen"
                    ],
                    "common_phrases": [
                        "in de prikkels zitten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak in meervoud gebruikt voor doornen of stekels"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Sharp protrusions on plants or objects that cause a stinging sensation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prickles",
                                "target_lang_sense_clarification": "sharp points on plants"
                            },
                            {
                                "target_lang_word": "thorns",
                                "target_lang_sense_clarification": "sharp plant parts"
                            },
                            {
                                "target_lang_word": "spines",
                                "target_lang_sense_clarification": "sharp needles on cacti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df661793-f055-3e50-b495-2164d85ba4b8",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>prikkelen</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>prikkel</w> de nieuwsgierigheid van mijn leerlingen door raadsels te vertellen.",
                            "target_lang_translations": {
                                "en": "I <w>stimulate</w> my students' curiosity by telling riddles."
                            }
                        },
                        {
                            "text": "Soms <w>prikkel</w> ik mijn huid per ongeluk met deze scherpe pen.",
                            "target_lang_translations": {
                                "en": "Sometimes I accidentally <w>prick</w> my skin with this sharp pen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'prikkelen' (to stimulate/prick)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stimulate",
                                "target_lang_sense_clarification": "to excite or arouse"
                            },
                            {
                                "target_lang_word": "prick",
                                "target_lang_sense_clarification": "to pierce slightly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05bcff3b-9425-3259-bac5-2a7ac9bd27af",
                    "sense_definition": "Gebiedende wijs van <w>prikkelen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Prikkel</w> je zintuigen tijdens een wandeling door dit prachtige bloemenpark.",
                            "target_lang_translations": {
                                "en": "<w>Stimulate</w> your senses during a walk through this beautiful flower park."
                            }
                        },
                        {
                            "text": "<w>Prikkel</w> de fantasie van de kinderen door samen een verhaal te verzinnen.",
                            "target_lang_translations": {
                                "en": "<w>Spark</w> the children's imagination by making up a story together."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative mood of 'prikkelen' (to stimulate/arouse)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stimulate",
                                "target_lang_sense_clarification": "command to excite"
                            },
                            {
                                "target_lang_word": "arouse",
                                "target_lang_sense_clarification": "command to awaken interest"
                            }
                        ]
                    }
                }
            ]
        }
