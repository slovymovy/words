                "senses": [
                    {
                        "sense_id": "70d078d6-be0e-3434-9e58-dd261107fb1e",
                        "entry_id": "c63434f9-f0c0-33e3-8757-9a086eb49614",
                        "glosses": [
                            "sprachliche Formen, die in der Gegenwartssprache nicht verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d81ba38-e254-4ff6-b70c-ae94df874b4b",
                                "sense_id": "70d078d6-be0e-3434-9e58-dd261107fb1e",
                                "text": "„Cherubim (1988) fasst den Begriff der »Sprachfossilien« etwas weiter.“"
                            },
                            {
                                "example_id": "7c443247-f03e-42b5-838c-4958c9f39a8b",
                                "sense_id": "70d078d6-be0e-3434-9e58-dd261107fb1e",
                                "text": "Archaismen sind Ausdrücke, die zwar dabei sind zu veralten, aber immer noch verwendet werden; Sprachfossilien werden nicht mehr verwendet und tauchen noch in Inschriften oder Zitaten auf."
                            },
                            {
                                "example_id": "ee2e4add-8a44-4952-951f-df5860f6a813",
                                "sense_id": "70d078d6-be0e-3434-9e58-dd261107fb1e",
                                "text": "In Focus Online werden Familiennamen als »Lebendige Sprachfossilien« thematisiert."
                            },
                            {
                                "example_id": "4654fd63-657a-4d61-a38e-6e44d85960ff",
                                "sense_id": "70d078d6-be0e-3434-9e58-dd261107fb1e",
                                "text": "„Für die Sprachforscher sind Namen \"konservierte Sprache\", Sprachfossilien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
