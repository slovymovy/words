                "entry_id": "946fb539-baa0-3656-aae2-f36fe2ffbf76",
                "word": "сполна",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "caa41ea3-2c59-3f31-b8c2-5fbd938fbc36",
                        "entry_id": "946fb539-baa0-3656-aae2-f36fe2ffbf76",
                        "glosses": [
                            "полностью, целиком"
                        ],
                        "tags": [
                            "(преимущ. о денежных расчетах)"
                        ],
                        "examples": [
                            {
                                "example_id": "d778eb4c-acab-48c6-a8fc-49b0faeae25a",
                                "sense_id": "caa41ea3-2c59-3f31-b8c2-5fbd938fbc36",
                                "text": "Получить деньги сполна."
                            },
                            {
                                "example_id": "11bd6d4a-9be6-42d0-9259-472823095c40",
                                "sense_id": "caa41ea3-2c59-3f31-b8c2-5fbd938fbc36",
                                "text": "Заплатить долг сполна."
                            },
                            {
                                "example_id": "9e580baf-0c35-4dfc-8c1d-ed99f0b4e0cf",
                                "sense_id": "caa41ea3-2c59-3f31-b8c2-5fbd938fbc36",
                                "text": "Оброк сполна ты получишь вскоре."
                            },
                            {
                                "example_id": "5f24509b-2998-43f5-8ea8-aac6a02dd1a2",
                                "sense_id": "caa41ea3-2c59-3f31-b8c2-5fbd938fbc36",
                                "text": "Моё-то он сполна отдаст по-приятельски."
                            },
                            {
                                "example_id": "d45ed390-c4ba-4e84-8f97-9a314ef9b5b7",
                                "sense_id": "caa41ea3-2c59-3f31-b8c2-5fbd938fbc36",
                                "text": "Твоё имение сполна в казну поступит войсковую."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edaa0746-67c9-413d-8bc3-41e3f1258c87",
                        "source_entry_id": "946fb539-baa0-3656-aae2-f36fe2ffbf76",
                        "source_sense_id": "caa41ea3-2c59-3f31-b8c2-5fbd938fbc36",
                        "target_lang_word": "completely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "completely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "In a complete manner; thoroughly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef0e07a-86f1-4c4b-b8ea-dd67121cec32",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Please completely fill in the box for your answer, using a number 2 pencil."
                                            },
                                            {
                                                "example_id": "bc5853fb-b049-4275-b1c1-b1490997c41b",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "I will have completely finished my degree by next July, when my thesis has been properly edited."
                                            },
                                            {
                                                "example_id": "d43b1f8e-e132-46b0-8d56-f64952f8e530",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "It should not have been omitted that previous to completely stripping the body of the leviathan, he was beheaded."
                                            },
                                            {
                                                "example_id": "c3c37d13-9a2d-47c4-a772-ceb61c44a5bd",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "She completely abandoned her Tuesdays at home, and did not return the visits of those who had called upon her."
                                            },
                                            {
                                                "example_id": "fa3892a0-d491-4f94-a747-371556908c5e",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Lieutenant (junior grade) KERRY immediately maneuvered his craft through several strafing runs which completely silenced the enemy."
                                            },
                                            {
                                                "example_id": "17a3b433-3441-46b0-84e9-784d726ef42a",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "To the fullest extent or degree; totally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59585da3-49e8-4d49-8f1c-d93feb4eb04b",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "He is completely mad."
                                            },
                                            {
                                                "example_id": "3b0f2f43-1c7d-47fa-8130-7d1202d6bddd",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town. I was completely mystified at such an unusual proceeding."
                                            },
                                            {
                                                "example_id": "42630122-febf-46fe-af3e-0d94e0c8b1d7",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "Our future may lie beyond our vision, but it is not completely beyond our control."
                                            },
                                            {
                                                "example_id": "f9ba36d2-d4c2-47e3-a0f1-dd6ae8191e76",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "1975, Helen Schucman, A Course in Miracles/Workbook for Students, Lesson 75: The light has come,\nKeep a completely open mind, washed of all past ideas and clean of every concept you have made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fed13402-4335-44e2-8e11-e586cf494d74",
                        "source_entry_id": "946fb539-baa0-3656-aae2-f36fe2ffbf76",
