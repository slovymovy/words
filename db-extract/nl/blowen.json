                    {
                        "sense_id": "13b593e2-90a4-3a6f-8155-5b7241b2ab48",
                        "entry_id": "367bf120-e0b6-3203-963a-0a0a80b5b58d",
                        "glosses": [
                            "een joint roken"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "4367f4f6-3935-4c77-b2fd-c47e217ec32d",
                                "sense_id": "13b593e2-90a4-3a6f-8155-5b7241b2ab48",
                                "text": "Hij blowt om de door multiple sclerose veroorzaakte pijn te verlichten."
                            },
                            {
                                "example_id": "02a1ac5a-2d1f-4bbc-9fac-ba080c66215c",
                                "sense_id": "13b593e2-90a4-3a6f-8155-5b7241b2ab48",
                                "text": "Door het vele blowen trok de groep ook een aantal vervelende types aan en splitste men zich steeds vaker in kleine groepjes af, waardoor ik me minder op mijn gemak voelde."
                            },
                            {
                                "example_id": "cb3d48ec-ecb7-47fb-a15f-12c6a96d6332",
                                "sense_id": "13b593e2-90a4-3a6f-8155-5b7241b2ab48",
                                "text": "Er werd opvallend veel geblowd op de PCT. Vooral de Amerikanen waren er gek op, wellicht als protest tegen de strenge war on drugs."
                            }
                        ]
                    },
