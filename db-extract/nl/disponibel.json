                                "target_senses": [
                                    {
                                        "sense_id": "660b2261-9576-36d8-9238-decc0ea11914",
                                        "entry_id": "364a84b0-1e0d-3361-a20c-225b35e37cf2",
                                        "glosses": [
                                            "Not occupied; empty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "040d9b9f-1314-47c4-8088-57ba87de6838",
                                                "sense_id": "660b2261-9576-36d8-9238-decc0ea11914",
                                                "text": "a vacant room"
                                            },
                                            {
                                                "example_id": "3f5254bd-4a64-4d8e-8875-a320c8eb845c",
                                                "sense_id": "660b2261-9576-36d8-9238-decc0ea11914",
                                                "text": "a vacant consulate"
                                            },
                                            {
                                                "example_id": "37d58b50-ee7c-4703-9285-d1505266619e",
                                                "sense_id": "660b2261-9576-36d8-9238-decc0ea11914",
                                                "text": "Below and to rearward circles the Tweed, silver grey on a dark brown field. Beside its low banks no tourists linger, vacant hangs the quivering bridge; down the narrow lanes no carriages come pressing over a succession of waving hills[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1484be18-cfe0-3250-bd65-5cb74f1edcda",
                                        "entry_id": "364a84b0-1e0d-3361-a20c-225b35e37cf2",
                                        "glosses": [
                                            "Not present; absent."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39615946-6a40-4713-a72f-8426d0f579c4",
                                                "sense_id": "1484be18-cfe0-3250-bd65-5cb74f1edcda",
                                                "text": "And Pierre felt that never, never would he be able to embrace Isabel with the mere brotherly embrace; while the thought of any other caress, which took hold of any domesticness, was entirely vacant from his uncontaminated soul, for it had never consciously intruded there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ec50425-4622-30ef-b609-785979c05039",
                                        "entry_id": "364a84b0-1e0d-3361-a20c-225b35e37cf2",
                                        "glosses": [
                                            "Blank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f544d923-ae8e-4b30-8276-30a08433de93",
                                                "sense_id": "4ec50425-4622-30ef-b609-785979c05039",
                                                "text": "a vacant page"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13a51f57-bc2c-3c3d-b703-4abf59d76e3d",
                                        "entry_id": "364a84b0-1e0d-3361-a20c-225b35e37cf2",
                                        "glosses": [
                                            "Showing no intelligence or interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9462cb1f-5373-4683-9d22-29684781bf1f",
                                                "sense_id": "13a51f57-bc2c-3c3d-b703-4abf59d76e3d",
                                                "text": "a vacant stare"
                                            },
                                            {
                                                "example_id": "f98b14ef-3a4f-4eba-b391-6d70727c1d21",
