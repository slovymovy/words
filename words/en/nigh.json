    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "40f5ecec-68dd-3701-a41f-1e5f8824d10c",
                    "sense_definition": "Almost; nearly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The task was <w>nigh</w> impossible, but they managed to complete it on time.",
                            "target_lang_translations": {
                                "pl": "Zadanie było <w>niemal</w> niemożliwe, ale udało im się je ukończyć na czas.",
                                "ru": "Задача была <w>почти</w> невыполнимой, но они сумели завершить её вовремя."
                            }
                        },
                        {
                            "text": "After walking for hours in the heat, we were <w>nigh</w> exhausted.",
                            "target_lang_translations": {
                                "pl": "Po wielogodzinnym marszu w upale byliśmy <w>prawie</w> wycieńczeni.",
                                "ru": "После многочасовой ходьбы по жаре мы были <w>чуть ли не</w> без сил."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nigh impossible",
                        "well nigh"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary or archaic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Prawie; niemalże.",
                        "ru": "Почти; едва ли не."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "blisko",
                                "target_lang_sense_clarification": "niemal, prawie"
                            },
                            {
                                "target_lang_word": "niemal",
                                "target_lang_sense_clarification": "prawie całkowicie"
                            },
                            {
                                "target_lang_word": "prawie",
                                "target_lang_sense_clarification": "o krok od jakiegoś stanu"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "почти",
                                "target_lang_sense_clarification": "без малого, едва ли не"
                            },
                            {
                                "target_lang_word": "чуть ли не",
                                "target_lang_sense_clarification": "очень близко к какому-либо состоянию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bca29375-2ce4-3ba5-9917-1f492638c69e",
                    "sense_definition": "Near; close by in space or time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers whispered that the end of the world was <w>nigh</w>.",
                            "target_lang_translations": {
                                "pl": "Wieśniacy szeptali, że koniec świata jest <w>bliski</w>.",
                                "ru": "Жители деревни шептались о том, что конец света <w>близок</w>."
                            }
                        },
                        {
                            "text": "With winter drawing <w>nigh</w>, the animals began storing food for the cold months.",
                            "target_lang_translations": {
                                "pl": "Wobec nadchodzącej <w>rychło</w> zimy, zwierzęta zaczęły gromadzić zapasy na mroźne miesiące.",
                                "ru": "С наступлением <w>близящейся</w> зимы животные принялись запасать еду на холодные месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "close",
                        "near"
                    ],
                    "antonyms": [
                        "far",
                        "distant"
                    ],
                    "common_phrases": [
                        "drawing nigh",
                        "end is nigh"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily poetic or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bliski; niedaleki w przestrzeni lub czasie.",
                        "ru": "Близкий по времени или расстоянию."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bliski",
                                "target_lang_sense_clarification": "niedaleki w czasie lub przestrzeni"
                            },
                            {
                                "target_lang_word": "rychły",
                                "target_lang_sense_clarification": "mający nastąpić wkrótce"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "близкий",
                                "target_lang_sense_clarification": "находящийся рядом или скорый по времени"
                            },
                            {
                                "target_lang_word": "ближний",
                                "target_lang_sense_clarification": "находящийся неподалеку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f27658b8-27c9-32c5-877d-2bcfbc9b45b9",
                    "sense_definition": "Closely allied by nature, relationship, or circumstances; intimate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They felt <w>nigh</w> bound to one another by their shared hardships.",
                            "target_lang_translations": {
                                "pl": "Czuli się ze sobą <w>blisko</w> związani przez wspólnie dzielone trudy.",
                                "ru": "Они чувствовали себя <w>тесно</w> связанными друг с другом общими невзгодами."
                            }
                        },
                        {
                            "text": "Though separated by oceans, their spirits remained <w>nigh</w> in purpose.",
                            "target_lang_translations": {
                                "pl": "Choć dzieliły ich oceany, ich duchy pozostały <w>bliskie</w> sobie w dążeniach.",
                                "ru": "Хотя их разделяли океаны, по духу и целям они оставались <w>близки</w>."
                            }
                        }
