                    }
                ],
                "translations": [
                    {
                        "translation_id": "b32f9bbb-7d58-4592-91ea-7b40bcc2c8a0",
                        "source_entry_id": "4cdda25f-1d43-313c-9ef4-e11a8b93ce35",
                        "source_sense_id": "24cea73a-3e98-305a-95c3-6b3d66445268",
                        "source_sense_description": "umgangssprachlich: Art und Weise zu sprechen; Sprechweise",
                        "target_lang_word": "parlance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parlance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d863b95-fd95-3ca7-9324-6519683c61b5",
                                        "entry_id": "540f43cd-3bde-3f0d-a8f0-d04ab2effd64",
                                        "glosses": [
                                            "A certain way of speaking, of using words; especially that associated with a particular job or interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9693612-d9e9-4a0c-a5d0-44bbd775739b",
                                                "sense_id": "9d863b95-fd95-3ca7-9324-6519683c61b5",
                                                "text": "To my childish fancy, it had seemed an imaginary flag-staff, or, in rustic parlance, the \"liberty pole\" of some former generation […]"
                                            },
                                            {
                                                "example_id": "1c5e3a85-0ac7-4561-8e4b-36f594acd8c7",
                                                "sense_id": "9d863b95-fd95-3ca7-9324-6519683c61b5",
                                                "text": "We approach the contest, still known in the common parlance of the country, as \"the first Pennimite War.\""
                                            },
                                            {
                                                "example_id": "9647f0c0-dfdc-491f-b97e-1df2e109c668",
                                                "sense_id": "9d863b95-fd95-3ca7-9324-6519683c61b5",
                                                "text": "The tourist's impression of the country to-day is that of a transported Holland, in which the official language is Dutch and the parlance of the people is \"taki-taki.\""
                                            },
                                            {
                                                "example_id": "613e3d9b-297f-4537-94b3-a4bb17949948",
                                                "sense_id": "9d863b95-fd95-3ca7-9324-6519683c61b5",
                                                "text": "At first she \"ran a temperature\" in American parlance, and I could not resist the exquisite caloricity of unexpected delights—Venus febriculosa—though it was a very languid Lolita that moaned and coughed and shivered in my embrace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70647026-0f97-3fa0-a7e7-5c76a6b46179",
                                        "entry_id": "540f43cd-3bde-3f0d-a8f0-d04ab2effd64",
                                        "glosses": [
                                            "Of a word, the quality of being lexicalized; especially as jargon or slang."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d223a43-5bfd-4619-9339-3d3eeee520db",
                                                "sense_id": "70647026-0f97-3fa0-a7e7-5c76a6b46179",
                                                "text": "Its use at a variety of levels, including the individual and organisational level, make it a varied term that has parlance in organisational development, performance management and talent management."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e484dd6-2610-36fb-9e18-4925893a25c7",
                                        "entry_id": "540f43cd-3bde-3f0d-a8f0-d04ab2effd64",
                                        "glosses": [
                                            "Speech, discussion or debate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22246295-33de-4f10-8a0f-63d826344a7e",
                                                "sense_id": "7e484dd6-2610-36fb-9e18-4925893a25c7",
                                                "text": "And without further parlance they fought, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e8c5bc7-8a3c-4f49-a0fb-420397151a08",
                        "source_entry_id": "4cdda25f-1d43-313c-9ef4-e11a8b93ce35",
                        "source_sense_id": "8e134286-1e11-3f8e-9f10-3fc16fead8ea",
                        "source_sense_description": "Linguistik: gesprochene Sprache, mündliche Form der Sprache",
                        "target_lang_word": "speech",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbacfd17-f57a-3048-a8c0-e55a612c4140",
                                        "entry_id": "f1d3a700-8521-34bd-a1e0-d44f44ae095d",
                                        "glosses": [
                                            "The ability to speak; the faculty of uttering words or articulate sounds and vocalizations to communicate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4395ebdd-1710-4d4f-a0d5-271d39a0b156",
                                                "sense_id": "cbacfd17-f57a-3048-a8c0-e55a612c4140",
                                                "text": "He had a bad speech impediment."
                                            },
                                            {
                                                "example_id": "4083a225-f40b-4743-9a46-4b756615b9e8",
                                                "sense_id": "cbacfd17-f57a-3048-a8c0-e55a612c4140",
                                                "text": "After the accident she lost her speech."
                                            },
                                            {
                                                "example_id": "cea88c94-b37b-4eda-92a0-64c777e82efb",
                                                "sense_id": "cbacfd17-f57a-3048-a8c0-e55a612c4140",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion[…] such talk had been distressingly out of place."
                                            },
                                            {
                                                "example_id": "2df9afdc-68f7-4231-8c5e-7845333ac343",
                                                "sense_id": "cbacfd17-f57a-3048-a8c0-e55a612c4140",
                                                "text": "I was at liberty to attend to Wilbert, who I could see desired speech with me. […] As far as Bobbie and I were concerned, silence reigned, this novel twist in the scenario having wiped speech from our lips, as the expression is, but Phyllis continued vocal. […] For perhaps a quarter of a minute after he had passed from the scene the aged relative stood struggling for utterance. At the end of this period she found speech. “Of all the damn silly fatheaded things!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad9b6de-7f2c-3527-a70c-f19f07c55dbc",
                                        "entry_id": "f1d3a700-8521-34bd-a1e0-d44f44ae095d",
                                        "glosses": [
                                            "The act of speaking, a certain style of it."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8741e9dd-c7de-49d6-b537-cc36d2d9f1ff",
                                                "sense_id": "0ad9b6de-7f2c-3527-a70c-f19f07c55dbc",
                                                "text": "It was hard to hear his speech over the noise."
                                            },
                                            {
                                                "example_id": "7ab194c4-2031-41ce-a3a5-b6ebf988f944",
                                                "sense_id": "0ad9b6de-7f2c-3527-a70c-f19f07c55dbc",
                                                "text": "Her speech was soft and lilting."
                                            },
                                            {
                                                "example_id": "4cc12b5b-7fa4-4fb7-9a14-c6c54994fc83",
                                                "sense_id": "0ad9b6de-7f2c-3527-a70c-f19f07c55dbc",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese, a silvery metal, began to totter, slur their speech and behave like someone inebriated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf13836-dd85-3821-adc8-9e104d30ec7d",
                                        "entry_id": "f1d3a700-8521-34bd-a1e0-d44f44ae095d",
                                        "glosses": [
                                            "A formal session of speaking, especially a long oral message given publicly by one person."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28db4fd8-b95a-410e-904e-876d4087264d",
                                                "sense_id": "0bf13836-dd85-3821-adc8-9e104d30ec7d",
                                                "text": "The constant design of both these orators, in all their speeches, was to drive some one particular point."
                                            },
                                            {
                                                "example_id": "253bc6c2-0b6e-4e98-b570-90ded60451cc",
                                                "sense_id": "0bf13836-dd85-3821-adc8-9e104d30ec7d",
                                                "text": "The candidate made some ambitious promises in his campaign speech."
                                            },
                                            {
                                                "example_id": "547177b7-fc5f-49ca-b6eb-8c3164a84933",
                                                "sense_id": "0bf13836-dd85-3821-adc8-9e104d30ec7d",
                                                "text": "He's going to present the prizes at Market Snodsbury Grammar School. We've been caught short as usual, and somebody has got to make a speech on ideals and the great world outside to those blasted boys, so he fits in nicely. I believe he's a very fine speaker. His only trouble is that he's stymied unless he has his speech with him and can read it. Calls it referring to his notes. […] “So that's why he's been going about looking like a dead fish. I suppose Roberta broke the engagement?” “In a speech lasting five minutes without a pause for breath.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3f624d-c24d-35a7-abb3-362f13fd1eed",
                                        "entry_id": "f1d3a700-8521-34bd-a1e0-d44f44ae095d",
                                        "glosses": [
                                            "A dialect, vernacular, or (dated) a language."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18390f54-1440-4bf7-a87f-dc2187939728",
                                                "sense_id": "9c3f624d-c24d-35a7-abb3-362f13fd1eed",
                                                "text": "For thou art not sent to a people of a strange speech, and of an hard language, but to the house of Israel."
                                            },
                                            {
                                                "example_id": "634c43c3-c6b3-4a0b-9110-0d6caca92e34",
                                                "sense_id": "9c3f624d-c24d-35a7-abb3-362f13fd1eed",
                                                "text": "The speche of Englande is a base speche to other noble speches, as Italion, Castylion, and Frenche; howbeit the speche of Englande of late dayes is amended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca0d1f3e-64af-3272-bc7e-b10fdc10c78e",
                                        "entry_id": "f1d3a700-8521-34bd-a1e0-d44f44ae095d",
                                        "glosses": [
                                            "Language used orally, rather than in writing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e80b95-24bf-4993-a4d4-74b27da116e1",
                                                "sense_id": "ca0d1f3e-64af-3272-bc7e-b10fdc10c78e",
                                                "text": "This word is mostly used in speech."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43fcd27c-bf13-358c-8a72-bc63beb6fee5",
                                        "entry_id": "f1d3a700-8521-34bd-a1e0-d44f44ae095d",
                                        "glosses": [
                                            "An utterance that is quoted; see direct speech, reported speech"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "290cd6ed-86ba-3027-b04e-67b28108eec2",
                                        "entry_id": "f1d3a700-8521-34bd-a1e0-d44f44ae095d",
                                        "glosses": [
                                            "Public talk, news, gossip, rumour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3e452e-59e2-4946-ad35-d98074592c45",
                                                "sense_id": "290cd6ed-86ba-3027-b04e-67b28108eec2",
                                                "text": "The duke[…]did of me demand / What was the speech among the Londoners / Concerning the French journey."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "speech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92b3fd7b-e264-38b4-ac6d-36a56d9b2e87",
                                        "entry_id": "b08334ed-8b01-314a-9041-8d8f540723dc",
                                        "glosses": [
                                            "To make a speech; to harangue."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58c828a-f8df-4a24-98bb-26751047d3a3",
                                                "sense_id": "92b3fd7b-e264-38b4-ac6d-36a56d9b2e87",
                                                "text": "I'll speech against peace while Dismal's my name, / And be a true whig, while I'm Not-in-game."
                                            },
                                            {
                                                "example_id": "c23f3a2b-7f19-4502-97b3-5294db43f620",
                                                "sense_id": "92b3fd7b-e264-38b4-ac6d-36a56d9b2e87",
                                                "text": "So to Speeching he did go, / And like a Man of Senſe, / He certainly ſaid Ay or No,"
                                            },
                                            {
                                                "example_id": "db6c8bb3-f14e-480f-8072-81c50fffb1fe",
                                                "sense_id": "92b3fd7b-e264-38b4-ac6d-36a56d9b2e87",
                                                "text": "\"He wasn't one to make himself big,\" said Mr. Jones. \"But he had something that drew the people when he was speeching... When he came down we all used to shout 'Lloyd George am byth!' You know, 'Lloyd George forever!' That was just how we felt.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
