                            {
                                "example_id": "a0b5f821-3c1d-428d-b32d-81729b9d314d",
                                "sense_id": "24d5d220-d507-30b2-9d11-ff56971b5e69",
                                "text": "De dieven moeten in de mast klimmen om het koper te bemachtigen. De bliksemafleider die tussen twee masten loopt moet op grote hoogte worden los geknipt. Per keer wordt zo ongeveer 250 meter koperdraad gestolen."
                            },
                            {
                                "example_id": "954fac45-6390-48df-9186-90d6e5284902",
                                "sense_id": "24d5d220-d507-30b2-9d11-ff56971b5e69",
                                "text": "De brand ontstond in de plaats Cobb. Een koperdraad in de aansluiting van het bubbelbad is te heet geworden waardoor het vuur ontstond, blijkt uit een onderzoek van de brandweer."
                            }
                        ]
                    },
