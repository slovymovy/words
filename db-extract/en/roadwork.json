                    },
                    {
                        "sense_id": "442b7e5c-6554-37ee-9726-78982303ae8a",
                        "entry_id": "41f32c33-2ef0-36bd-8675-e53bb54cbdb3",
                        "glosses": [
                            "The taking of a band on the road to perform music in different locations."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dae86201-3efa-4e23-b5c2-6678b8d64ac8",
                                "sense_id": "442b7e5c-6554-37ee-9726-78982303ae8a",
                                "text": "[…] the Beatles had resigned from roadwork in the summer of '66 (much like Brian Wilson)—their tour ending, appropriately enough, in the hippie utopia of San Francisco—and turned Abbey Road Studios into their very own musical sandbox […]"
                            }
                        ]
                    }
