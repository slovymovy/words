                    },
                    {
                        "translation_id": "38a67d27-4536-4d81-bea3-6a4c0e447527",
                        "source_entry_id": "81903d9c-c115-34b8-9aeb-77d941b679d9",
                        "source_sense_id": "2aad24ae-8f03-3291-9b00-b2e39120bcba",
