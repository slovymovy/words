{
    "word_family": [
        "rebut",
        "rebutant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8a9979a-5b85-3fba-9c13-296eb120661d",
                    "sense_definition": "Décourager quelqu'un par l'ampleur de l'effort exigé, l'ennui ou les difficultés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decourager",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La longueur de ce roman complexe risque de <w>rebuter</w> les jeunes lecteurs."
                        },
                        {
                            "text": "Malgré les nombreux échecs initiaux, elle ne s'est pas laissé <w>rebuter</w> par la tâche."
                        }
                    ],
                    "synonyms": [
                        "décourager",
                        "démotiver"
                    ],
                    "antonyms": [
                        "encourager",
                        "motiver",
                        "stimuler"
                    ],
                    "common_phrases": [
                        "se laisser rebuter"
                    ]
                },
                {
                    "sense_id": "80228630-822a-3d8a-8cd6-f3333299b232",
                    "sense_definition": "Déplaire fortement, inspirer une aversion ou de la répugnance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repugner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son odeur très forte et son aspect étrange <w>rebutent</w> souvent les clients du marché."
                        },
                        {
                            "text": "Cette manière d'aborder les gens avec agressivité finit par <w>rebuter</w> tout son entourage."
                        }
                    ],
                    "synonyms": [
                        "dégoûter",
                        "déplaire",
                        "repousser"
                    ],
                    "antonyms": [
                        "attirer",
                        "séduire",
                        "plaire"
                    ]
                },
                {
                    "sense_id": "22a4821a-452f-3d36-a2f1-41e2c9bb8578",
                    "sense_definition": "Repousser ou rejeter quelqu'un ou une demande avec rudesse et froideur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rejeter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a froidement <w>rebuté</w> le mendiant qui sollicitait un emploi."
                        },
                        {
                            "text": "Elle craignait de faire une démarche directe de peur qu'on ne la <w>rebute</w> aussitôt."
                        }
                    ],
                    "synonyms": [
                        "éconduire",
                        "rejeter",
                        "repousser"
                    ],
                    "antonyms": [
                        "accueillir",
                        "recevoir"
                    ],
                    "common_phrases": [
                        "rebuter une demande"
                    ]
                },
                {
                    "sense_id": "69c6ef32-8bff-3e93-923b-88b0d4786417",
                    "sense_definition": "Mettre au rebut une pièce ou un produit jugé non conforme ou défectueux lors de la fabrication.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "industrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrôleur de qualité a décidé de <w>rebuter</w> toute la série présentant des fissures."
                        },
                        {
                            "text": "L'usine cherche à réduire les coûts en évitant de <w>rebuter</w> des pièces trop facilement réparables."
                        }
                    ],
                    "synonyms": [
                        "éliminer",
                        "rejeter"
                    ],
                    "antonyms": [
                        "valider",
                        "conserver"
                    ],
                    "common_phrases": [
                        "rebuter des pièces",
                        "rebuter un lot"
                    ]
                }
            ]
        }
    ]
}