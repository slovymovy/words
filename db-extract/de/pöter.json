                "senses": [
                    {
                        "sense_id": "7028a626-cd81-3c1f-9b01-4c9a16d5a5cb",
                        "entry_id": "af68f0be-0ca8-3431-ba19-adff727aa5d6",
                        "glosses": [
                            "das menschliche Gesäß"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "28aa00f5-ea44-46a1-9878-3408b3e04784",
                                "sense_id": "7028a626-cd81-3c1f-9b01-4c9a16d5a5cb",
                                "text": "Musstest du meinen ganzen Schreibtisch mit deinem Pöter abräumen?"
                            },
                            {
                                "example_id": "58d079fb-441d-4945-a384-cabaa57176d5",
                                "sense_id": "7028a626-cd81-3c1f-9b01-4c9a16d5a5cb",
                                "text": "„Wir mußten stehen, und ich sah nur die Pöter von fremden Leuten vor mir.“"
                            },
                            {
                                "example_id": "cb010238-c783-49cb-a076-6226dce8aeb7",
                                "sense_id": "7028a626-cd81-3c1f-9b01-4c9a16d5a5cb",
                                "text": "„Es gibt niedliche Pöter, Es gibt friedliche Pöter, Es gibt ziemlich unterschiedlich appetitliche Pöter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
