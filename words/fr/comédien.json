                                "target_lang_sense_clarification": "скрывает истинные намерения"
                            },
                            {
                                "target_lang_word": "актёр",
                                "target_lang_sense_clarification": "перен., неискренний человек"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Heuchler",
                                "target_lang_sense_clarification": "verbirgt wahre Absichten"
                            },
                            {
                                "target_lang_word": "Komödiant",
                                "target_lang_sense_clarification": "abwertend, vorgetäuschte Gefühle"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "farsante",
                                "target_lang_sense_clarification": "engaña con emociones fingidas"
                            },
                            {
                                "target_lang_word": "comediante",
                                "target_lang_sense_clarification": "coloquial, figurado, aparenta sentimientos"
                            },
                            {
                                "target_lang_word": "fingidor",
                                "target_lang_sense_clarification": "registro culto, sentimientos fingidos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演员",
                                "target_lang_sense_clarification": "比喻，假装感情"
                            },
                            {
                                "target_lang_word": "伪君子",
                                "target_lang_sense_clarification": "掩饰真实意图"
                            }
                        ]
                    }
                }
